compliance,regulatory_accreditation,compliance_regulatory_submission,external_audit_flag,external_audit_flag,External Audit Flag,BOOLEAN,,,,,transactional_data,"Indicates whether this submission is subject to external audit or validation by the regulatory agency or third-party auditor. True = subject to external audit, False = not subject to external audit.",
compliance,regulatory_accreditation,compliance_regulatory_submission,modified_timestamp,modified_timestamp,Record Modified Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when this regulatory submission record was last updated or modified.,
compliance,regulatory_accreditation,compliance_regulatory_submission,notes,notes,Submission Notes,STRING,,,,,transactional_data,"Free-text field for additional comments, context, or internal notes related to the regulatory submission, including special circumstances, challenges, or follow-up actions.",
compliance,regulatory_accreditation,compliance_regulatory_submission,penalty_amount,penalty_amount,Penalty Amount,"DECIMAL(15,2)",,,,,transactional_data,"Monetary penalty assessed by the regulatory agency for late, incomplete, or non-compliant submission, in US dollars.",
compliance,regulatory_accreditation,compliance_regulatory_submission,penalty_currency_code,penalty_currency_code,Penalty Currency Code,STRING,,,,^[A-Z]{3}$,transactional_data,"Three-letter ISO 4217 currency code for the penalty amount (e.g., USD for US dollars).",
compliance,regulatory_accreditation,compliance_regulatory_submission,receiving_agency,receiving_agency,Receiving Agency,STRING,,,,,transactional_data,"Name of the government agency, accrediting body, or regulatory authority receiving the submission (e.g., CMS, State Department of Health, OSHA, OCR, Joint Commission, CDC).",
compliance,regulatory_accreditation,compliance_regulatory_submission,receiving_agency_code,receiving_agency_code,Receiving Agency Code,STRING,,,,,transactional_data,"Standardized code or abbreviation for the receiving regulatory agency (e.g., CMS, OCR, OSHA, TJC, CDC).",
compliance,regulatory_accreditation,compliance_regulatory_submission,rejection_date,rejection_date,Rejection Date,DATE,,,,,transactional_data,"Date on which the receiving agency rejected the submission due to errors, incompleteness, or non-compliance.",
compliance,regulatory_accreditation,compliance_regulatory_submission,rejection_reason,rejection_reason,Rejection Reason,STRING,,,,,transactional_data,Explanation or code provided by the receiving agency describing why the submission was rejected.,
compliance,regulatory_accreditation,compliance_regulatory_submission,reporting_period_end_date,reporting_period_end_date,Reporting Period End Date,DATE,,,,,transactional_data,End date of the time period covered by the regulatory submission.,
compliance,regulatory_accreditation,compliance_regulatory_submission,reporting_period_start_date,reporting_period_start_date,Reporting Period Start Date,DATE,,,,,transactional_data,"Start date of the time period covered by the regulatory submission (e.g., calendar quarter, fiscal year, annual period).",
compliance,regulatory_accreditation,compliance_regulatory_submission,resubmission_required_flag,resubmission_required_flag,Resubmission Required Flag,BOOLEAN,,,,,transactional_data,"Indicates whether the submission must be corrected and resubmitted. True = resubmission required, False = no resubmission required.",
compliance,regulatory_accreditation,compliance_regulatory_submission,risk_level,risk_level,Risk Level,STRING,,,,CRITICAL|HIGH|MEDIUM|LOW,transactional_data,"Assessment of the compliance risk associated with this submission, including potential penalties for non-compliance or late filing.",
compliance,regulatory_accreditation,compliance_regulatory_submission,submission_date,submission_date,Submission Date,DATE,,,,,transactional_data,Date on which the regulatory submission was filed or transmitted to the receiving agency.,
compliance,regulatory_accreditation,compliance_regulatory_submission,submission_document_title,submission_document_title,,STRING,,,"pii_phi,pii_pii,pii_sensitive",,transactional_data,description,
compliance,regulatory_accreditation,compliance_regulatory_submission,submission_format,submission_format,Submission Format,STRING,,,,,transactional_data,"Data format or file type of the regulatory submission. XML = Extensible Markup Language, JSON = JavaScript Object Notation, CSV = comma-separated values, PDF = Portable Document Format, HL7_V2 = Health Level Seven Version 2 message, FHIR = Fast Healthcare Interoperability Resources. [ENUM-REF-CANDIDATE: XML|JSON|CSV|PDF|HL7_V2|FHIR|PAPER|OTHER — 8 candidates stripped; promote to reference product]",
compliance,regulatory_accreditation,compliance_regulatory_submission,submission_method,submission_method,Submission Method,STRING,,,,,transactional_data,"Method or channel used to transmit the regulatory submission. ELECTRONIC_PORTAL = web-based agency portal, EMAIL = email transmission, FAX = facsimile, MAIL = postal mail, API = application programming interface, HL7_INTERFACE = Health Level Seven (HL7) electronic interface, SFTP = secure file transfer protocol. [ENUM-REF-CANDIDATE: ELECTRONIC_PORTAL|EMAIL|FAX|MAIL|API|HL7_INTERFACE|SFTP|OTHER — 8 candidates stripped; promote to reference product]",
compliance,regulatory_accreditation,compliance_regulatory_submission,submission_number,submission_number,Submission Number,STRING,,,,,transactional_data,"Business identifier or tracking number assigned to the regulatory submission, often used for external reference and correspondence with regulatory agencies.",
compliance,regulatory_accreditation,compliance_regulatory_submission,submission_priority,submission_priority,Submission Priority,STRING,,,,CRITICAL|HIGH|MEDIUM|LOW,transactional_data,"Priority level assigned to the regulatory submission based on urgency, risk, or regulatory importance. CRITICAL = immediate action required, HIGH = high importance, MEDIUM = standard priority, LOW = routine submission.",
compliance,regulatory_accreditation,compliance_regulatory_submission,submission_status,submission_status,Submission Status,STRING,,,,,transactional_data,"Current lifecycle status of the regulatory submission. DRAFT = being prepared, PENDING_REVIEW = awaiting internal approval, SUBMITTED = sent to regulatory agency, ACKNOWLEDGED = receipt confirmed by agency, ACCEPTED = approved by agency, REJECTED = not accepted by agency, RESUBMITTED = corrected and resubmitted after rejection, WITHDRAWN = submission cancelled. [ENUM-REF-CANDIDATE: DRAFT|PENDING_REVIEW|SUBMITTED|ACKNOWLEDGED|ACCEPTED|REJECTED|RESUBMITTED|WITHDRAWN — 8 candidates stripped; promote to reference product]",
compliance,regulatory_accreditation,compliance_regulatory_submission,submission_timestamp,submission_timestamp,Submission Timestamp,TIMESTAMP,,,,,transactional_data,"Precise date and time when the regulatory submission was transmitted to the receiving agency, including time zone.",
compliance,regulatory_accreditation,compliance_regulatory_submission,submission_type,submission_type,Submission Type,STRING,,,,,transactional_data,"Category of regulatory submission. CMS_IQR = Centers for Medicare and Medicaid Services (CMS) Inpatient Quality Reporting, CMS_OQR = CMS Outpatient Quality Reporting, CMS_IPFQR = CMS Inpatient Psychiatric Facility Quality Reporting, STATE_LICENSURE = State health department facility licensure reports, OSHA_300 = Occupational Safety and Health Administration (OSHA) Log of Work-Related Injuries and Illnesses, OSHA_300A = OSHA Annual Summary, OCR_BREACH = Office for Civil Rights (OCR) breach notification under HIPAA, OIG_SELF_DISCLOSURE = Office of Inspector General (OIG) self-disclosure of potential fraud or abuse, JOINT_COMMISSION_PPR = Joint Commission Periodic Performance Review, CDC_NHSN_HAI = Centers for Disease Control and Prevention (CDC) National Healthcare Safety Network (NHSN) Healthcare-Associated Infection (HAI) reporting. [ENUM-REF-CANDIDATE: CMS_IQR|CMS_OQR|CMS_IPFQR|STATE_LICENSURE|OSHA_300|OSHA_300A|OCR_BREACH|OIG_SELF_DISCLOSURE|JOINT_COMMISSION_PPR|CDC_NHSN_HAI|OTHER — 11 candidates stripped; promote to reference product]",
compliance,regulatory_accreditation,compliance_regulatory_submission,submitting_entity_name,submitting_entity_name,Submitting Entity Name,STRING,,,,,transactional_data,Legal or business name of the healthcare facility or organizational unit submitting the report.,
compliance,regulatory_accreditation,compliance_regulatory_submission,submitting_entity_npi,submitting_entity_npi,Submitting Entity National Provider Identifier (NPI),STRING,,,,^[0-9]{10}$,transactional_data,"Ten-digit National Provider Identifier (NPI) of the submitting healthcare organization, as assigned by CMS.",
compliance,regulatory_accreditation,osha_exposure_incident,osha_exposure_incident_id,osha_exposure_incident_id,Occupational Safety and Health Administration (OSHA) Exposure Incident Identifier,BIGINT,Y,,,,transactional_data,Unique identifier for the occupational exposure incident record. Primary key for the OSHA exposure incident entity.,
compliance,regulatory_accreditation,osha_exposure_incident,care_site_id,care_site_id,Facility Identifier,BIGINT,,facility.care_site.care_site_id,,,transactional_data,Reference to the healthcare facility where the exposure incident occurred. Required for multi-facility OSHA reporting and facility-level safety benchmarking.,
compliance,regulatory_accreditation,osha_exposure_incident,mpi_record_id,mpi_record_id,Source Patient Identifier,BIGINT,,patient.mpi_record.mpi_record_id,,,transactional_data,"Reference to the patient who was the source of the exposure, if applicable. Required for source patient testing and post-exposure prophylaxis decision-making.",
compliance,regulatory_accreditation,osha_exposure_incident,ndc_drug_id,ndc_drug_id,Ndc Drug Id (Foreign Key),BIGINT,,reference.ndc_drug.ndc_drug_id,,,transactional_data,"Foreign key linking to reference.ndc_drug. Business justification: Exposure incidents involving post-exposure prophylaxis (PEP) or vaccines must document the specific NDC codes administered for workers compensation claims, OSHA recordkeeping, and pharmacy billing re",
compliance,regulatory_accreditation,osha_exposure_incident,osha_employee_id,osha_employee_id,Exposed Employee Identifier,BIGINT,,workforce.employee.employee_id,"dbx_confidential,dbx_pii,pii_phi,pii_pii,pii_sensitive",,transactional_data,Reference to the healthcare worker who experienced the occupational exposure incident.,
compliance,regulatory_accreditation,osha_exposure_incident,osha_safety_program_id,osha_safety_program_id,Osha Safety Program Id (Foreign Key),BIGINT,,compliance.osha_safety_program.osha_safety_program_id,,,transactional_data,"Foreign key linking to compliance.osha_safety_program. Business justification: OSHA exposure incidents are tracked under specific OSHA safety programs (e.g., Bloodborne Pathogen Exposure Control Plan). Each incident should link to the safety program it falls under for aggregatio",
compliance,regulatory_accreditation,osha_exposure_incident,parent_osha_exposure_incident_id,parent_osha_exposure_incident_id,Related Osha Exposure Incident Id,BIGINT,,compliance.osha_exposure_incident.osha_exposure_incident_id,dbx_self_ref_fk,,transactional_data,Self-referencing FK on osha_exposure_incident (related_osha_exposure_incident_id),
compliance,regulatory_accreditation,osha_exposure_incident,procedure_event_id,procedure_event_id,Procedure Event Id (Foreign Key),BIGINT,,clinical.procedure_event.procedure_event_id,,,transactional_data,Foreign key linking to clinical.procedure_event. Business justification: Sharps injuries and exposure incidents often occur during specific surgical or invasive procedures. Root cause analysis and OSHA reporting require linking exposure incidents to the procedural context ,
compliance,regulatory_accreditation,osha_exposure_incident,scheduling_appointment_id,scheduling_appointment_id,Scheduling Appointment Id (Foreign Key),BIGINT,,scheduling.scheduling_appointment.scheduling_appointment_id,,,transactional_data,"Foreign key linking to scheduling.scheduling_appointment. Business justification: Exposure incidents often occur during scheduled patient encounters providing context for root cause analysis, procedure identification, and prevention planning. Real incident investigation requirement",
compliance,regulatory_accreditation,osha_exposure_incident,tertiary_employee_id,tertiary_employee_id,Investigating Officer Identifier,BIGINT,,workforce.employee.employee_id,"dbx_confidential,dbx_pii,pii_phi,pii_pii,pii_sensitive",,transactional_data,Reference to the employee health or safety officer responsible for investigating the exposure incident and completing required documentation.,
compliance,regulatory_accreditation,osha_exposure_incident,baseline_testing_completed_flag,baseline_testing_completed_flag,Baseline Testing Completed Flag,BOOLEAN,,,,,transactional_data,Indicates whether baseline bloodborne pathogen testing was completed for the exposed employee immediately following the exposure. Required to establish pre-exposure status.,
compliance,regulatory_accreditation,osha_exposure_incident,corrective_actions_implemented,corrective_actions_implemented,Corrective Actions Implemented,STRING,,,,,transactional_data,"Description of corrective actions implemented to prevent recurrence of similar exposure incidents. May include process changes, equipment changes, or additional training.",
compliance,regulatory_accreditation,osha_exposure_incident,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when the exposure incident record was first created in the system. Audit trail for data governance and compliance verification.,
compliance,regulatory_accreditation,osha_exposure_incident,days_away_from_work,days_away_from_work,Days Away From Work,INT,,,,,transactional_data,Number of calendar days the exposed employee was unable to work as a result of the exposure incident. Required for OSHA 300 log column entries.,
compliance,regulatory_accreditation,osha_exposure_incident,days_of_job_transfer_restriction,days_of_job_transfer_restriction,Days of Job Transfer or Restriction,INT,,,,,transactional_data,Number of calendar days the exposed employee was on restricted work activity or job transfer as a result of the exposure. Required for OSHA 300 log column entries.,
compliance,regulatory_accreditation,osha_exposure_incident,exposed_employee_department,exposed_employee_department,Exposed Employee Department,STRING,,,,,transactional_data,Department or unit where the exposed employee was working at the time of the incident. Critical for departmental safety metrics and targeted training.,
compliance,regulatory_accreditation,osha_exposure_incident,exposed_employee_job_title,exposed_employee_job_title,Exposed Employee Job Title,STRING,,,,,transactional_data,Job title or role of the exposed employee at the time of the incident. Used for risk analysis and prevention planning by occupational category.,
compliance,regulatory_accreditation,osha_exposure_incident,exposure_route,exposure_route,Exposure Route,STRING,,,,percutaneous|mucous_membrane|non_intact_skin|inhalation|ingestion|other,transactional_data,"Route by which the exposure occurred. Percutaneous (needlestick, sharps injury) and mucous membrane exposures have different post-exposure prophylaxis protocols.",
compliance,regulatory_accreditation,osha_exposure_incident,exposure_type,exposure_type,Exposure Type,STRING,,,,bloodborne_pathogen|chemical|respiratory|radiation|biological_non_bloodborne|other,transactional_data,Primary category of occupational exposure. Bloodborne pathogen exposures are the most common in healthcare and trigger specific OSHA Bloodborne Pathogens Standard requirements.,
compliance,regulatory_accreditation,osha_exposure_incident,follow_up_completed_flag,follow_up_completed_flag,Follow-Up Completed Flag,BOOLEAN,,,,,transactional_data,Indicates whether all required follow-up testing and medical evaluations have been completed for the exposed employee. Used to track compliance with post-exposure protocols.,
compliance,regulatory_accreditation,osha_exposure_incident,follow_up_testing_schedule,follow_up_testing_schedule,Follow-Up Testing Schedule,STRING,,,,,transactional_data,"Scheduled follow-up testing timeline for the exposed employee (e.g., 6 weeks, 3 months, 6 months post-exposure). Protocol varies by exposure type and source patient status.",
compliance,regulatory_accreditation,osha_exposure_incident,incident_date,incident_date,Incident Date,DATE,,,,,transactional_data,Date when the occupational exposure incident occurred. Used to determine OSHA recordability and reporting deadlines.,
compliance,regulatory_accreditation,osha_exposure_incident,incident_location,incident_location,Incident Location,STRING,,,,,transactional_data,"Specific location within the healthcare facility where the exposure occurred (e.g., Emergency Department Room 3, Operating Room 5, Patient Room 412). Used for environmental risk assessment.",
compliance,regulatory_accreditation,osha_exposure_incident,incident_number,incident_number,Incident Number,STRING,,,,,transactional_data,Business identifier assigned to the exposure incident for tracking and reporting purposes. Used in OSHA 300 log and internal incident management systems.,
compliance,regulatory_accreditation,osha_exposure_incident,incident_resolution_date,incident_resolution_date,Incident Resolution Date,DATE,,,,,transactional_data,Date when the exposure incident case was closed and all follow-up activities completed. Used for case closure tracking and outcome analysis.,
compliance,regulatory_accreditation,osha_exposure_incident,incident_status,incident_status,Incident Status,STRING,,,,open|under_investigation|follow_up_in_progress|closed|pending_review,transactional_data,"Current status of the exposure incident case management. Tracks the incident through investigation, follow-up care, and final resolution.",
compliance,regulatory_accreditation,osha_exposure_incident,incident_time,incident_time,Incident Time,TIMESTAMP,,,,,transactional_data,"Precise date and time when the exposure incident occurred. Used for shift analysis, staffing pattern review, and post-exposure prophylaxis timing calculations.",
compliance,regulatory_accreditation,osha_exposure_incident,investigation_notes,investigation_notes,Investigation Notes,STRING,,,,,transactional_data,"Detailed narrative of the incident investigation findings, including circumstances leading to the exposure, witness statements, and contributing factors. Used for root cause analysis and prevention planning.",
compliance,regulatory_accreditation,osha_exposure_incident,modified_timestamp,modified_timestamp,Record Modified Timestamp,TIMESTAMP,,,,,transactional_data,"Date and time when the exposure incident record was last modified. Audit trail for tracking updates to incident details, status changes, and follow-up documentation.",
compliance,regulatory_accreditation,osha_exposure_incident,osha_recordable_determination_date,osha_recordable_determination_date,Occupational Safety and Health Administration (OSHA) Recordable Determination Date,DATE,,,,,transactional_data,Date when the OSHA recordability determination was made. Must be within 7 calendar days of receiving information that a recordable injury or illness has occurred.,
compliance,regulatory_accreditation,osha_exposure_incident,osha_recordable_flag,osha_recordable_flag,Occupational Safety and Health Administration (OSHA) Recordable Flag,BOOLEAN,,,,,transactional_data,"Indicates whether the exposure incident meets OSHA criteria for recordability on the OSHA 300 log. Recordability determination based on whether the incident resulted in medical treatment beyond first aid, days away from work, or job transfer/restriction.",
compliance,regulatory_accreditation,osha_exposure_incident,pep_initiated_flag,pep_initiated_flag,Post-Exposure Prophylaxis (PEP) Initiated Flag,BOOLEAN,,,,,transactional_data,Indicates whether post-exposure prophylaxis treatment was initiated for the exposed employee. Required for OSHA compliance and employee health tracking.,
compliance,regulatory_accreditation,osha_exposure_incident,pep_start_timestamp,pep_start_timestamp,Post-Exposure Prophylaxis (PEP) Start Timestamp,TIMESTAMP,,,,,transactional_data,"Date and time when post-exposure prophylaxis was initiated. Timing is critical for PEP effectiveness, particularly for HIV exposure (ideally within 2 hours, no later than 72 hours).",
compliance,regulatory_accreditation,osha_exposure_incident,pep_type,pep_type,Post-Exposure Prophylaxis (PEP) Type,STRING,,,,,transactional_data,"Type of post-exposure prophylaxis administered (e.g., HIV PEP antiretroviral therapy, Hepatitis B immune globulin, Hepatitis B vaccination). Free text to accommodate multiple concurrent treatments.",
compliance,regulatory_accreditation,osha_exposure_incident,procedure_being_performed,procedure_being_performed,Procedure Being Performed,STRING,,,,,transactional_data,Clinical procedure or task being performed when the exposure occurred. Used for procedural risk analysis and targeted training interventions.,
compliance,regulatory_accreditation,osha_exposure_incident,reported_timestamp,reported_timestamp,Reported Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when the exposure incident was first reported to management or employee health. Used to track reporting timeliness and compliance with immediate reporting requirements.,
compliance,regulatory_accreditation,osha_exposure_incident,root_cause_analysis_completed_flag,root_cause_analysis_completed_flag,Root Cause Analysis Completed Flag,BOOLEAN,,,,,transactional_data,Indicates whether a formal root cause analysis was conducted for the exposure incident. Required for serious incidents and used to drive systemic safety improvements.,
compliance,regulatory_accreditation,osha_exposure_incident,safety_engineered_device_flag,safety_engineered_device_flag,Safety Engineered Device Flag,BOOLEAN,,,,,transactional_data,Indicates whether the device involved had safety-engineered sharps injury protection features. Critical for evaluating effectiveness of safety device adoption.,
compliance,regulatory_accreditation,osha_exposure_incident,sharps_device_brand,sharps_device_brand,Sharps Device Brand,STRING,,,,,transactional_data,Manufacturer and brand name of the sharp device involved. Used for product safety evaluation and vendor performance tracking.,
compliance,regulatory_accreditation,osha_exposure_incident,sharps_device_type,sharps_device_type,Sharps Device Type,STRING,,,,,transactional_data,"Type of sharp device involved in the exposure (e.g., hollow-bore needle, suture needle, scalpel, lancet). Required for OSHA Sharps Injury Log and device evaluation.",
compliance,regulatory_accreditation,osha_exposure_incident,source_patient_hbv_status,source_patient_hbv_status,Source Patient Hepatitis B Virus (HBV) Status,STRING,,,"dbx_pii_health,dbx_restricted,pii_phi,pii_pii,pii_sensitive",positive|negative|unknown|declined,transactional_data,Hepatitis B test result for the source patient. Protected health information. Determines need for Hepatitis B immune globulin and vaccination for exposed employee.,
compliance,regulatory_accreditation,osha_exposure_incident,source_patient_hcv_status,source_patient_hcv_status,Source Patient Hepatitis C Virus (HCV) Status,STRING,,,"dbx_pii_health,dbx_restricted,pii_phi,pii_pii,pii_sensitive",positive|negative|unknown|declined,transactional_data,Hepatitis C test result for the source patient. Protected health information. Determines baseline and follow-up testing protocol for exposed employee.,
compliance,regulatory_accreditation,osha_exposure_incident,source_patient_hiv_status,source_patient_hiv_status,Source Patient Human Immunodeficiency Virus (HIV) Status,STRING,,,"dbx_pii_health,dbx_restricted,pii_phi,pii_pii,pii_sensitive",positive|negative|unknown|declined,transactional_data,HIV test result for the source patient. Protected health information. Critical for determining post-exposure prophylaxis regimen for the exposed employee.,
compliance,regulatory_accreditation,osha_exposure_incident,source_patient_known_flag,source_patient_known_flag,Source Patient Known Flag,BOOLEAN,,,,,transactional_data,Indicates whether the source patient could be identified. Unknown source exposures require different post-exposure prophylaxis risk assessment.,
compliance,regulatory_accreditation,osha_exposure_incident,source_patient_tested_flag,source_patient_tested_flag,Source Patient Tested Flag,BOOLEAN,,,,,transactional_data,"Indicates whether the source patient was tested for bloodborne pathogens (HIV, Hepatitis B, Hepatitis C) following the exposure incident.",
compliance,regulatory_accreditation,osha_exposure_incident,workers_comp_claim_filed_flag,workers_comp_claim_filed_flag,Workers Compensation Claim Filed Flag,BOOLEAN,,,,,transactional_data,Indicates whether a workers compensation claim was filed for the exposure incident. Links occupational health incident to workers compensation case management.,
compliance,regulatory_accreditation,osha_exposure_incident,workers_comp_claim_number,workers_comp_claim_number,Workers Compensation Claim Number,STRING,,,,,transactional_data,"Workers compensation claim number associated with the exposure incident, if a claim was filed. Used for cross-referencing with workers compensation system.",
compliance,regulatory_accreditation,osha_safety_program,osha_safety_program_id,osha_safety_program_id,Occupational Safety and Health Administration (OSHA) Safety Program ID,BIGINT,Y,,,,master_data,Unique identifier for the OSHA safety program record. Primary key.,
compliance,regulatory_accreditation,osha_safety_program,cost_center_id,cost_center_id,Cost Center Id (Foreign Key),BIGINT,,finance.cost_center.cost_center_id,,,master_data,"Foreign key linking to finance.cost_center. Business justification: Safety programs are owned by specific departments (typically EHS or Risk Management) and require budget allocation for implementation, training, and equipment. Cost center link enables budget tracking",
compliance,regulatory_accreditation,osha_safety_program,employee_id,employee_id,Safety Program Owner Employee ID,BIGINT,,workforce.employee.employee_id,"dbx_confidential,dbx_pii,pii_phi,pii_pii,pii_sensitive",,master_data,Identifier of the employee designated as the program owner or coordinator responsible for program implementation and compliance.,
compliance,regulatory_accreditation,osha_safety_program,parent_osha_safety_program_id,parent_osha_safety_program_id,Parent Osha Safety Program Id,BIGINT,,compliance.osha_safety_program.osha_safety_program_id,dbx_self_ref_fk,,master_data,Self-referencing FK on osha_safety_program (parent_osha_safety_program_id),
compliance,regulatory_accreditation,osha_safety_program,training_id,training_id,Training Course ID,BIGINT,,compliance.training.training_id,,,master_data,"Identifier of the training course associated with this safety program, linking to the learning management system.",
compliance,regulatory_accreditation,osha_safety_program,approval_authority,approval_authority,Safety Program Approval Authority,STRING,,,,,master_data,"The role or title of the individual or committee authorized to approve the safety program (e.g., Chief Medical Officer, Safety Committee, Board of Directors).",
compliance,regulatory_accreditation,osha_safety_program,approval_date,approval_date,Safety Program Approval Date,DATE,,,,,master_data,The date when the safety program was formally approved by the designated authority.,
compliance,regulatory_accreditation,osha_safety_program,attestation_frequency_months,attestation_frequency_months,Attestation Frequency Months,INT,,,,,master_data,The frequency in months at which attestation must be completed for this safety program. Null if attestation is one-time or not required.,
compliance,regulatory_accreditation,osha_safety_program,attestation_required_flag,attestation_required_flag,Attestation Required Flag,BOOLEAN,,,,,master_data,Indicates whether employees or managers must formally attest to compliance with this safety program (True) or not (False).,
compliance,regulatory_accreditation,osha_safety_program,corrective_action_required_flag,corrective_action_required_flag,Corrective Action Required Flag,BOOLEAN,,,,,master_data,Indicates whether corrective actions are required to address deficiencies identified in the most recent audit (True) or not (False).,
compliance,regulatory_accreditation,osha_safety_program,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,master_data,The timestamp when this safety program record was first created in the system.,
compliance,regulatory_accreditation,osha_safety_program,document_location_url,document_location_url,Safety Program Document Location Uniform Resource Locator (URL),STRING,,,,,master_data,The URL or file path where the official safety program document is stored and accessible to authorized personnel.,
compliance,regulatory_accreditation,osha_safety_program,effective_date,effective_date,Safety Program Effective Date,DATE,,,,,master_data,The date when the safety program became or will become operational and enforceable within the organization.,
compliance,regulatory_accreditation,osha_safety_program,enforcement_mechanism,enforcement_mechanism,Enforcement Mechanism,STRING,,,,,master_data,"Description of how compliance with this safety program is monitored and enforced (e.g., audits, inspections, incident investigations, self-assessments).",
compliance,regulatory_accreditation,osha_safety_program,expiration_date,expiration_date,Safety Program Expiration Date,DATE,,,,,master_data,"The date when the safety program is scheduled to expire or be retired, if applicable. Null for ongoing programs.",
compliance,regulatory_accreditation,osha_safety_program,external_audit_scope_flag,external_audit_scope_flag,External Audit Scope Flag,BOOLEAN,,,,,master_data,Indicates whether this safety program is within the scope of external regulatory audits or inspections (True) or only subject to internal review (False).,
compliance,regulatory_accreditation,osha_safety_program,finding_count,finding_count,Audit Finding Count,INT,,,,,master_data,The number of audit findings or deficiencies identified during the most recent audit of this safety program.,
compliance,regulatory_accreditation,osha_safety_program,keywords,keywords,Safety Program Keywords,STRING,,,,,master_data,"Comma-separated list of keywords or tags for search and categorization of the safety program (e.g., PPE, exposure, hazmat, ergonomics).",
compliance,regulatory_accreditation,osha_safety_program,last_audit_date,last_audit_date,Last Audit Date,DATE,,,,,master_data,The most recent date when an internal or external audit was conducted to assess compliance with this safety program.,
compliance,regulatory_accreditation,osha_safety_program,last_audit_result,last_audit_result,Last Audit Result,STRING,,,,compliant|non_compliant|partially_compliant|not_audited,master_data,"The outcome of the most recent audit of this safety program, indicating the level of compliance found.",
compliance,regulatory_accreditation,osha_safety_program,last_review_date,last_review_date,Safety Program Last Review Date,DATE,,,,,master_data,"The most recent date when the safety program was formally reviewed for compliance, effectiveness, and currency.",
