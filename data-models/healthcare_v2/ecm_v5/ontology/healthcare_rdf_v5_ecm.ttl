    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:behavioralHealthPsychiatricAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Psychiatric Assessment Status' ;
    rdfs:comment 'Current lifecycle status of the assessment.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comorbidConditions rdf:type rdf:Property ;
