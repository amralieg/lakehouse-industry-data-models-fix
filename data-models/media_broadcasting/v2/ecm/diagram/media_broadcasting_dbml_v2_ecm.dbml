  total_carriage_fee_amount decimal(18,2) [note: 'Total carriage fee amount invoiced after all adjustments, credits, and escalations. | Column total_carriage_fee_amount (DECIMAL(18,2)) in billing.billing_carriage_fee_invoice']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.billing_carriage_fee_invoice']
  updated_timestamp timestamp [note: 'Timestamp when this invoice record was last modified in the billing system. | Column updated_timestamp (TIMESTAMP) in billing.billing_carriage_fee_invoice']

  Note: 'Invoice issued to MVPDs and vMVPDs for channel carriage fees under retransmission consent or must-carry agreements. Captures MVPD operator name, channel lineup, subscriber count basis, per-subscriber fee rate, total carriage fee amount, billing period, contractual escalation clause applied, blackout adjustment credits, and SAP posting reference. Distinct from subscription invoices due to B2B wholesale billing mechanics and regulatory retransmission consent framework. | Unity Catalog table: media_broadcasting_ecm.billing.billing_carriage_fee_invoice'
}

Table billing.syndication_license_fee {
