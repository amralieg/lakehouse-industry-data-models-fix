ind:csrVariant rdf:type rdf:Property ;
    rdfs:label 'Csr Variant' ;
    rdfs:comment 'The Cost Sharing Reduction (CSR) variant code indicating the level of cost-sharing assistance (01-06).' ;
    rdfs:domain ind:UnitedHealthCare ;
