    rdfs:label 'Attestation Signed Flag' ;
    rdfs:comment 'Indicates whether the provider has signed the required attestation statements.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disclosureFormReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Disclosure Form Received Flag' ;
    rdfs:comment 'Indicates whether the provider disclosure form has been received.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disclosureFormDate rdf:type rdf:Property ;
    rdfs:label 'Disclosure Form Date' ;
    rdfs:comment 'Date when the provider disclosure form was received.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adverseActionDisclosedFlag rdf:type rdf:Property ;
    rdfs:label 'Adverse Action Disclosed Flag' ;
    rdfs:comment 'Indicates whether the provider disclosed any adverse actions on their application.' ;
