ind:improvementPlanId rdf:type rdf:Property ;
    rdfs:label 'Improvement Plan Id' ;
    rdfs:comment 'Identifier for the quality improvement program or initiative associated with the measure.' ;
    rdfs:domain ind:UnitedHealthCare ;
