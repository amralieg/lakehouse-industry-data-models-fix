    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:objectionSummary rdf:type rdf:Property ;
    rdfs:label 'Objection Summary' ;
    rdfs:comment 'Summary of objections, deficiencies, or issues raised by the regulatory agency during review.' ;
