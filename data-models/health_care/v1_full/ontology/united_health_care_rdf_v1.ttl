    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Last Updated Date' ;
    rdfs:comment 'Date when the measure specification was last revised or updated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationLogicUrl rdf:type rdf:Property ;
    rdfs:label 'Calculation Logic Url' ;
    rdfs:comment 'URL or file path to detailed technical documentation describing the measure calculation algorithm and business rules.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditRequired rdf:type rdf:Property ;
    rdfs:label 'Audit Required' ;
    rdfs:comment 'Indicates whether this measure is subject to external audit or validation by NCQA, CMS, or other oversight bodies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
