    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlDocumentationLink rdf:type rdf:Property ;
    rdfs:label 'Control Documentation Link' ;
    rdfs:comment 'URL or file path to the detailed control documentation, procedures, and supporting materials.' ;
    rdfs:domain ind:AuditControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segregationOfDutiesIndicator rdf:type rdf:Property ;
    rdfs:label 'Segregation Of Duties Indicator' ;
