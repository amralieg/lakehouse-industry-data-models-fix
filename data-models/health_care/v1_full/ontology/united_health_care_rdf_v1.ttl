    rdfs:comment 'Comma-separated list of related filing numbers that are associated with or dependent on this filing.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateChangeJustification rdf:type rdf:Property ;
    rdfs:label 'Rate Change Justification' ;
    rdfs:comment 'Detailed justification or rationale for the proposed rate change, including actuarial basis and supporting data.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialCertificationFlag rdf:type rdf:Property ;
