ind:oopMaxFamily rdf:type rdf:Property ;
    rdfs:label 'Oop Max Family' ;
    rdfs:comment 'The maximum Out of Pocket (OOP) amount the family will collectively pay in a plan year, after which the plan pays 100% of covered services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayUrgentCare rdf:type rdf:Property ;
    rdfs:label 'Copay Urgent Care' ;
    rdfs:comment 'The fixed copayment amount the member pays for urgent care visits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsuranceRate rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Rate' ;
    rdfs:comment 'The percentage of covered expenses the member is responsible for paying after the deductible is met.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hsaContributionEmployer rdf:type rdf:Property ;
    rdfs:label 'Hsa Contribution Employer' ;
    rdfs:comment 'The amount the employer contributes to the member\'s Health Savings Account (HSA).' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hraEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Hra Eligible Indicator' ;
    rdfs:comment 'Indicates whether this coverage includes a Health Reimbursement Arrangement (HRA).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fsaEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Fsa Eligible Indicator' ;
    rdfs:comment 'Indicates whether this coverage is eligible for a Flexible Spending Account (FSA).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumEmployeeContribution rdf:type rdf:Property ;
    rdfs:label 'Premium Employee Contribution' ;
    rdfs:comment 'The portion of the premium paid by the employee.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumEmployerContribution rdf:type rdf:Property ;
    rdfs:label 'Premium Employer Contribution' ;
    rdfs:comment 'The portion of the premium paid by the employer.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumSubsidyAmount rdf:type rdf:Property ;
