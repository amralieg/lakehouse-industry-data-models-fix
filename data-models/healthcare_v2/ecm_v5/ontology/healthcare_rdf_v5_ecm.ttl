    rdfs:comment 'Mode of delivery for the assessment.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentOutcome rdf:type rdf:Property ;
    rdfs:label 'Assessment Outcome' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentSource rdf:type rdf:Property ;
    rdfs:label 'Assessment Source' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentVersion rdf:type rdf:Property ;
    rdfs:label 'Assessment Version' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditAction rdf:type rdf:Property ;
