ind:idCardCoordination rdf:type rdf:Property ;
    rdfs:label 'Id Card Coordination' ;
    rdfs:comment 'Rule defining whether parent and child products share a single member ID card or require separate cards.' ;
    rdfs:domain ind:Hierarchy ;
