    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentSource rdf:type rdf:Property ;
    rdfs:label 'Enrollment Source' ;
    rdfs:comment 'The source or channel through which the member enrolled in coverage (e.g., employer, marketplace, broker, direct).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentMethod rdf:type rdf:Property ;
    rdfs:label 'Enrollment Method' ;
    rdfs:comment 'The method used to complete the enrollment (e.g., online, phone, paper application, in-person).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoAssignmentIndicator rdf:type rdf:Property ;
