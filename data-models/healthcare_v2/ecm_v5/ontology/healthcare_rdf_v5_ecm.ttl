ind:followUpSchedulingAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Follow Up Scheduling Appointment Id' ;
    rdfs:comment 'Foreign key linking to scheduling.scheduling_appointment. Business justification: CMS readmission reduction programs require tracking whether post-acute care plans have confirmed follow-up appointments scheduled. Care coordinators use this link to verify care transition compliance ' ;
    rdfs:domain ind:PostAcuteCarePlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SchedulingAppointment .

ind:careGoals rdf:type rdf:Property ;
    rdfs:label 'Care Goals' ;
    rdfs:comment 'Narrative description of the clinical and functional goals for the patient during post-acute care.' ;
    rdfs:domain ind:PostAcuteCarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careTeam rdf:type rdf:Property ;
    rdfs:label 'Care Team' ;
    rdfs:comment 'Comma-separated list of provider identifiers or names participating in the care plan.' ;
    rdfs:domain ind:PostAcuteCarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRetentionPolicy rdf:type rdf:Property ;
    rdfs:label 'Compliance Retention Policy' ;
    rdfs:comment 'Retention policy applied to the care plan record for compliance (e.g., HIPAA 7-year retention).' ;
    rdfs:domain ind:PostAcuteCarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRetentionEndDate rdf:type rdf:Property ;
    rdfs:label 'Data Retention End Date' ;
    rdfs:comment 'Calculated date when the record must be archived or purged according to the retention policy.' ;
    rdfs:domain ind:PostAcuteCarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dischargeCriteria rdf:type rdf:Property ;
