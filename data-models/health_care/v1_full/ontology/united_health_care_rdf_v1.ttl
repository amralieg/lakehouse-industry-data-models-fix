ind:clinicalGuidelineReference rdf:type rdf:Property ;
    rdfs:label 'Clinical Guideline Reference' ;
    rdfs:comment 'Reference to the clinical practice guideline, evidence-based protocol, or medical necessity criteria that supports this intervention type. May include guideline name and version.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vbcProgramAlignment rdf:type rdf:Property ;
    rdfs:label 'Vbc Program Alignment' ;
    rdfs:comment 'Identifies value-based care programs or alternative payment models that this intervention type supports. May reference specific ACO or PCMH initiatives.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccRelevance rdf:type rdf:Property ;
    rdfs:label 'Hcc Relevance' ;
    rdfs:comment 'Indicates whether this intervention type is relevant for HCC risk adjustment documentation and coding. Identifies specific HCC categories if applicable.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
