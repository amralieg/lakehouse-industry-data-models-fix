Table workforce.employee {
  employee_id varchar [pk, note: 'Unique identifier for the employee record. Primary key for the employee entity. This is the system-generated surrogate key used across all internal systems to reference this employee. | Column employee_id (BIGINT) in workforce.employee']
  manager_employee_id varchar [note: 'Reference to the employee record of this employee\'s direct manager. Used for organizational hierarchy, reporting relationships, and approval workflows. Null for CEO or top-level executives. | Column manager_employee_id (BIGINT) in workforce.employee']
  org_unit_id varchar [note: 'Reference to the organizational department where the employee is assigned. Used for organizational reporting, budget allocation, and workforce planning. | Column org_unit_id (BIGINT) in workforce.employee']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.employee']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.employee']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.employee']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.employee']
  created_timestamp timestamp [note: 'Timestamp when this employee record was first created in the system. Used for audit trails, data lineage, and record lifecycle tracking. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column created_timestamp (TIMESTAMP) in workforce.employee']
  date_of_birth date [note: 'Employee\'s date of birth. Used for age verification, benefits eligibility, retirement planning, and compliance with labor laws. Format: yyyy-MM-dd. | Column date_of_birth (DATE) in workforce.employee']
  emergency_contact_name varchar [note: 'Full name of the person to be contacted in case of employee emergency. Critical for workplace safety and incident response. | Column emergency_contact_name (STRING) in workforce.employee']
  emergency_contact_phone varchar [note: 'Phone number of the emergency contact. Primary method for reaching emergency contact in case of workplace incident or employee emergency. | Column emergency_contact_phone (STRING) in workforce.employee']
  emergency_contact_relationship varchar [note: 'Relationship of the emergency contact to the employee (e.g., spouse, parent, sibling, friend). Provides context for emergency communications. | Column emergency_contact_relationship (STRING) in workforce.employee']
  employee_number varchar [note: 'Business-assigned unique employee number used for HR operations, payroll, and external reporting. Format: two-letter prefix followed by six digits (e.g., MB123456). | Column employee_number (STRING) in workforce.employee']
  employment_status varchar [note: 'Current lifecycle status of the employee\'s relationship with Media Broadcasting. Active indicates currently working; other statuses indicate various non-working states. | Column employment_status (STRING) in workforce.employee']
  employment_type varchar [note: 'Classification of the employee\'s employment arrangement. Determines benefits eligibility, work schedule expectations, and contract terms. | Column employment_type (STRING) in workforce.employee']
  gender varchar [note: 'Employee\'s self-identified gender. Used for diversity reporting, benefits administration, and compliance with equal employment opportunity regulations. | Column gender (STRING) in workforce.employee']
  hire_date date [note: 'Date the employee officially started employment with Media Broadcasting. Used for seniority calculations, benefits eligibility, anniversary recognition, and tenure reporting. Format: yyyy-MM-dd. | Column hire_date (DATE) in workforce.employee']
  home_address_line1 varchar [note: 'First line of the employee\'s residential address (street number and name). Used for payroll tax calculations, benefits administration, and emergency contact. | Column home_address_line1 (STRING) in workforce.employee']
  home_address_line2 varchar [note: 'Second line of the employee\'s residential address (apartment, suite, unit number). Optional field. Used for accurate mail delivery and address verification. | Column home_address_line2 (STRING) in workforce.employee']
  home_city varchar [note: 'City or municipality of the employee\'s residential address. Used for payroll tax calculations, benefits administration, and geographic workforce analytics. | Column home_city (STRING) in workforce.employee']
  home_country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code of the employee\'s residential address (e.g., USA, GBR, CAN). Used for international payroll, tax compliance, and global workforce analytics. | Column home_country_code (STRING) in workforce.employee']
  home_postal_code varchar [note: 'Postal code or ZIP code of the employee\'s residential address. Used for payroll tax calculations, benefits administration, and mail delivery. | Column home_postal_code (STRING) in workforce.employee']
  home_state_province varchar [note: 'State, province, or region of the employee\'s residential address. Used for payroll tax withholding, benefits eligibility, and regional workforce reporting. | Column home_state_province (STRING) in workforce.employee']
  hr_system_code varchar [note: 'Unique identifier for this employee in the source HR system (SAP S/4HANA HR). Used for system integration, data reconciliation, and cross-system reference. | Column hr_system_code (STRING) in workforce.employee']
  job_level varchar [note: 'Hierarchical level of the employee\'s position within the organization. Used for compensation benchmarking, career pathing, and organizational structure analysis. [ENUM-REF-CANDIDATE: Entry|Associate|Mid|Senior|Lead|Manager|Director|VP|SVP|C-Level — 10 candidates stripped; promote to reference product] | Column job_level (STRING) in workforce.employee']
  job_title varchar [note: 'Official job title assigned to the employee. Reflects the employee\'s role, level, and function within the organization. Used for organizational charts, job postings, and career progression tracking. | Column job_title (STRING) in workforce.employee']
  legal_first_name varchar [note: 'Employee\'s legal first name as it appears on government-issued identification documents. Used for payroll, tax reporting, and official HR records. | Column legal_first_name (STRING) in workforce.employee']
  legal_last_name varchar [note: 'Employee\'s legal last name (surname/family name) as it appears on government-issued identification documents. Used for payroll, tax reporting, and official HR records. | Column legal_last_name (STRING) in workforce.employee']
  legal_middle_name varchar [note: 'Employee\'s legal middle name or initial as it appears on government-issued identification documents. May be null if not applicable. | Column legal_middle_name (STRING) in workforce.employee']
  national_id_number varchar [note: 'Government-issued national identification number (e.g., Social Security Number in USA, National Insurance Number in UK). Used for tax reporting, payroll, and legal compliance. Format varies by jurisdiction. | Column national_id_number (STRING) in workforce.employee']
  nationality varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code representing the employee\'s citizenship or nationality. Used for work authorization verification, international assignment eligibility, and diversity reporting. | Column nationality (STRING) in workforce.employee']
  personal_email varchar [note: 'Employee\'s personal email address. Used for emergency communications, benefits notifications, and post-employment correspondence. Must be kept current. | Column personal_email (STRING) in workforce.employee']
  personal_phone varchar [note: 'Employee\'s personal mobile or home phone number. Used for emergency contact, urgent work communications, and HR notifications. | Column personal_phone (STRING) in workforce.employee']
  preferred_name varchar [note: 'Name the employee prefers to be called in day-to-day work interactions. May differ from legal name. Used in email signatures, internal directories, and workplace communications. | Column preferred_name (STRING) in workforce.employee']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.employee']
  termination_date date [note: 'Date the employee\'s employment ended. Null for active employees. Used for final payroll processing, benefits termination, and workforce analytics. Format: yyyy-MM-dd. | Column termination_date (DATE) in workforce.employee']
  termination_reason varchar [note: 'Classification of the reason for employment termination. Used for turnover analysis, exit interview tracking, and workforce planning. Null for active employees. | Column termination_reason (STRING) in workforce.employee']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.employee']
  updated_timestamp timestamp [note: 'Timestamp when this employee record was last modified. Used for audit trails, change tracking, and data synchronization. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column updated_timestamp (TIMESTAMP) in workforce.employee']
  work_authorization_expiry_date date [note: 'Date when the employee\'s work authorization (visa, permit) expires. Null for citizens and permanent residents. Used for compliance tracking and renewal planning. Format: yyyy-MM-dd. | Column work_authorization_expiry_date (DATE) in workforce.employee']
  work_authorization_status varchar [note: 'Current status of the employee\'s legal authorization to work in the country where they are employed. Critical for compliance with immigration and labor laws. | Column work_authorization_status (STRING) in workforce.employee']
  work_email varchar [note: 'Corporate email address assigned to the employee for business communications. Primary contact method for internal and external work-related correspondence. | Column work_email (STRING) in workforce.employee']
  work_phone varchar [note: 'Corporate phone number assigned to the employee. May be desk phone, mobile, or extension. Used for business communications and internal directory. | Column work_phone (STRING) in workforce.employee']

  Note: 'Master identity record for every internal employee at Media Broadcasting — full-time, part-time, and fixed-term staff. Captures legal name, employee number, national ID, date of birth, gender, employment type, hire date, termination date, employment status, work location, home address, personal email, work email, work phone, emergency contact, nationality, visa/work authorization status, and HR system identifier. This is the SSOT for internal workforce identity — distinct from the talent domain which manages on-screen/off-screen creative talent under contract. | Unity Catalog table: media_broadcasting_ecm.workforce.employee'
}

Table workforce.org_unit {
  org_unit_id varchar [pk, note: 'Unique identifier for the organizational unit. Primary key for the org_unit product. | Column org_unit_id (BIGINT) in workforce.org_unit']
  parent_org_unit_id varchar [note: 'Reference to the parent organizational unit in the hierarchy. Enables traversal of the organizational tree structure from child to parent. Null for top-level units. | Column parent_org_unit_id (BIGINT) in workforce.org_unit']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.org_unit']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.org_unit']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.org_unit']
  budget_amount decimal(18,2) [note: 'Annual operating budget allocated to this organizational unit for expense management and financial planning. | Column budget_amount (DECIMAL(18,2)) in workforce.org_unit']
  budget_currency_code varchar [note: 'ISO 4217 three-letter currency code for the budget amount, supporting multi-currency operations. | Column budget_currency_code (STRING) in workforce.org_unit']
  business_area varchar [note: 'High-level business function or operational domain that this organizational unit supports within the media broadcasting enterprise. [ENUM-REF-CANDIDATE: broadcast_operations|content_production|digital_platforms|advertising_sales|news|sports|engineering|technology|corporate_services|finance|human_resources — 11 candidates stripped; promote to reference product] | Column business_area (STRING) in workforce.org_unit']
  company_code varchar [note: 'Legal entity or company code in the financial system to which this organizational unit belongs for statutory reporting and consolidation. | Column company_code (STRING) in workforce.org_unit']
  contact_email varchar [note: 'Primary email address for contacting this organizational unit for business inquiries, escalations, or administrative matters. | Column contact_email (STRING) in workforce.org_unit']
  contact_phone varchar [note: 'Primary phone number for contacting this organizational unit for business or operational purposes. | Column contact_phone (STRING) in workforce.org_unit']
  cost_center_code varchar [note: 'Financial cost center identifier associated with this organizational unit for expense tracking, budget allocation, and financial reporting in the general ledger. | Column cost_center_code (STRING) in workforce.org_unit']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.org_unit']
  created_timestamp timestamp [note: 'Timestamp when this organizational unit record was first created in the system. | Column created_timestamp (TIMESTAMP) in workforce.org_unit']
  effective_end_date date [note: 'Date when this organizational unit ceased or will cease operations. Null for currently active units with no planned closure. | Column effective_end_date (DATE) in workforce.org_unit']
  effective_start_date date [note: 'Date when this organizational unit became or will become operational and active within the enterprise structure. | Column effective_start_date (DATE) in workforce.org_unit']
  functional_area varchar [note: 'Specific functional specialization or operational focus of the organizational unit, providing granular classification beyond business area. | Column functional_area (STRING) in workforce.org_unit']
  head_count_actual varchar [note: 'Current actual number of employees assigned to this organizational unit, used for variance analysis against budget. | Column head_count_actual (INT) in workforce.org_unit']
  head_count_budget varchar [note: 'Approved budgeted number of full-time equivalent employees allocated to this organizational unit for workforce planning and cost management. | Column head_count_budget (INT) in workforce.org_unit']
  hierarchy_level varchar [note: 'Numeric depth of this organizational unit in the enterprise hierarchy tree, with 1 representing top-level divisions and increasing numbers for deeper nesting. | Column hierarchy_level (INT) in workforce.org_unit']
  hierarchy_path varchar [note: 'Materialized path representation of the organizational units position in the hierarchy, typically a delimited string of ancestor unit codes for efficient tree traversal. | Column hierarchy_path (STRING) in workforce.org_unit']
  is_broadcast_operations boolean [note: 'Flag indicating whether this organizational unit is directly involved in broadcast playout, transmission, or on-air operations. | Column is_broadcast_operations (BOOLEAN) in workforce.org_unit']
  is_content_production boolean [note: 'Flag indicating whether this organizational unit is engaged in content creation, production, or post-production activities. | Column is_content_production (BOOLEAN) in workforce.org_unit']
  is_revenue_generating boolean [note: 'Flag indicating whether this organizational unit directly generates revenue through advertising sales, subscription services, or content licensing. | Column is_revenue_generating (BOOLEAN) in workforce.org_unit']
  legal_entity_name varchar [note: 'Name of the legal entity or subsidiary under which this organizational unit operates for regulatory and compliance purposes. | Column legal_entity_name (STRING) in workforce.org_unit']
  manager_employee_id varchar [note: 'Reference to the employee who serves as the head or manager of this organizational unit, responsible for its operations and performance. | Column manager_employee_id (BIGINT) in workforce.org_unit']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this organizational unit record, supporting audit trail and change tracking. | Column modified_by_user (STRING) in workforce.org_unit']
  modified_timestamp timestamp [note: 'Timestamp when this organizational unit record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in workforce.org_unit']
  operating_hours varchar [note: 'Standard operating hours or shift pattern for this organizational unit, relevant for broadcast operations, production schedules, and workforce planning. | Column operating_hours (STRING) in workforce.org_unit']
  operational_status varchar [note: 'Current operational state of the organizational unit indicating whether it is actively functioning, temporarily suspended, planned for future activation, or permanently closed. | Column operational_status (STRING) in workforce.org_unit']
  org_unit_description varchar [note: 'Detailed description of the organizational units purpose, responsibilities, and scope of operations within the media broadcasting enterprise. | Column org_unit_description (STRING) in workforce.org_unit']
  profit_center_code varchar [note: 'Profit center identifier for units that are managed as revenue-generating or P&L-responsible entities within the enterprise. | Column profit_center_code (STRING) in workforce.org_unit']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.org_unit']
  time_zone varchar [note: 'IANA time zone identifier for the primary operating location of this organizational unit, used for scheduling and time-sensitive operations. | Column time_zone (STRING) in workforce.org_unit']
  union_affiliation varchar [note: 'Name of labor union or collective bargaining unit that represents employees in this organizational unit, if applicable. | Column union_affiliation (STRING) in workforce.org_unit']
  unit_code varchar [note: 'Business identifier code for the organizational unit used in financial systems, reporting, and internal references. Typically alphanumeric and unique across the enterprise. | Column unit_code (STRING) in workforce.org_unit']
  unit_name varchar [note: 'Full official name of the organizational unit as used in corporate communications, org charts, and HR systems. | Column unit_name (STRING) in workforce.org_unit']
  unit_short_name varchar [note: 'Abbreviated or short name of the organizational unit for display in constrained UI contexts, reports, and dashboards. | Column unit_short_name (STRING) in workforce.org_unit']
  unit_type varchar [note: 'Classification of the organizational unit indicating its hierarchical level and functional role within the enterprise structure. | Column unit_type (STRING) in workforce.org_unit']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.org_unit']

  Note: 'Master record for every organizational unit within Media Broadcasting — divisions, departments, sub-departments, cost centers, and functional teams. Captures unit code, unit name, unit type (division/department/team), parent unit reference for hierarchy traversal, effective date, head count budget, physical location, and operational status. Supports org chart rendering, headcount reporting, and cost allocation across broadcast operations, production, technology, and corporate functions. | Unity Catalog table: media_broadcasting_ecm.workforce.org_unit'
}

Table workforce.job_profile {
  job_profile_id varchar [pk, note: 'Unique identifier for the job profile. Primary key for the job profile reference catalog. | Column job_profile_id (BIGINT) in workforce.job_profile']
  org_unit_id varchar [note: 'Foreign key reference to the primary department or organizational unit where this job profile is typically assigned. Used for organizational structure reporting and headcount planning. | Column org_unit_id (BIGINT) in workforce.job_profile']
  parent_job_profile_id varchar [note: 'Self-referencing FK on job_profile (parent_job_profile_id) | Column parent_job_profile_id (BIGINT) in workforce.job_profile']
  primary_reports_to_job_profile_id varchar [note: 'Foreign key reference to the job profile of the direct supervisor or manager for this role. Establishes reporting hierarchy and organizational structure. | Column reports_to_job_profile_id (BIGINT) in workforce.job_profile']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.job_profile']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.job_profile']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.job_profile']
  bonus_eligible_flag boolean [note: 'Indicates whether this role is eligible for annual performance bonuses or incentive compensation. Used for total rewards planning and compensation design. | Column bonus_eligible_flag (BOOLEAN) in workforce.job_profile']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.job_profile']
  created_timestamp timestamp [note: 'Timestamp when this job profile record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in workforce.job_profile']
  eeo_job_category varchar [note: 'Standard EEO-1 job category used for federal equal employment opportunity reporting to the EEOC. Required for compliance with Title VII of the Civil Rights Act. [ENUM-REF-CANDIDATE: executive_senior_level_officials_and_managers|first_mid_level_officials_and_managers|professionals|technicians|sales_workers|administrative_support_workers|craft_workers|operatives|laborers_and_helpers|service_workers — 10 candidates stripped; promote to reference product] | Column eeo_job_category (STRING) in workforce.job_profile']
  effective_end_date date [note: 'Date when this job profile version was superseded or retired. Null for currently active profiles. Supports temporal tracking and historical analysis. | Column effective_end_date (DATE) in workforce.job_profile']
  effective_start_date date [note: 'Date when this job profile version became effective and available for use in hiring, workforce planning, and HR operations. | Column effective_start_date (DATE) in workforce.job_profile']
  equity_eligible_flag boolean [note: 'Indicates whether this role is eligible for equity compensation such as stock options, restricted stock units (RSUs), or employee stock purchase plans (ESPP). | Column equity_eligible_flag (BOOLEAN) in workforce.job_profile']
  flsa_classification varchar [note: 'Classification under the Fair Labor Standards Act determining overtime eligibility. Exempt employees are salaried and not eligible for overtime; non-exempt employees are eligible for overtime pay. | Column flsa_classification (STRING) in workforce.job_profile']
  grade_band varchar [note: 'Compensation grade or pay band assigned to this job profile. Links to salary range tables and determines eligibility for benefits, bonuses, and equity compensation. | Column grade_band (STRING) in workforce.job_profile']
  job_code varchar [note: 'Standardized alphanumeric code uniquely identifying this job profile within the organization\'s job taxonomy. Used for HR systems integration, payroll processing, and workforce planning. | Column job_code (STRING) in workforce.job_profile']
  job_description varchar [note: 'Comprehensive narrative describing the role\'s purpose, key responsibilities, deliverables, and scope of work. Used for recruitment, performance management, and role clarity. | Column job_description (STRING) in workforce.job_profile']
  job_family varchar [note: 'Broad occupational grouping that clusters related roles sharing similar skill sets and career progression paths. Used for talent development, succession planning, and compensation benchmarking. [ENUM-REF-CANDIDATE: engineering|production|content|advertising|distribution|technology|finance|legal|human_resources|operations — 10 candidates stripped; promote to reference product] | Column job_family (STRING) in workforce.job_profile']
  job_level varchar [note: 'Hierarchical level or seniority grade within the organization\'s career framework. Determines scope of responsibility, decision-making authority, and compensation band eligibility. [ENUM-REF-CANDIDATE: entry|intermediate|senior|lead|principal|manager|director|vice_president|executive — 9 candidates stripped; promote to reference product] | Column job_level (STRING) in workforce.job_profile']
  job_profile_status varchar [note: 'Current lifecycle status of this job profile. Active profiles are available for hiring and workforce planning; inactive or obsolete profiles are retained for historical reference only. | Column job_profile_status (STRING) in workforce.job_profile']
  job_title varchar [note: 'Official job title as it appears on employment contracts, business cards, and organizational charts. Examples: Broadcast Engineer, News Producer, Content Scheduler, Ad Traffic Coordinator, Studio Director. | Column job_title (STRING) in workforce.job_profile']
  last_modified_timestamp timestamp [note: 'Timestamp when this job profile record was last updated. Used for change tracking and audit compliance. | Column last_modified_timestamp (TIMESTAMP) in workforce.job_profile']
  minimum_education_level varchar [note: 'Minimum educational qualification required for this role. Used for candidate screening and workforce planning. | Column minimum_education_level (STRING) in workforce.job_profile']
  minimum_years_experience varchar [note: 'Minimum number of years of relevant professional experience required for this role. Used for candidate qualification and talent acquisition. | Column minimum_years_experience (INT) in workforce.job_profile']
  physical_demands varchar [note: 'Description of physical requirements and working conditions for this role. Examples: ability to lift 50 lbs, prolonged standing, work in outdoor weather conditions, operate heavy equipment. Required for ADA compliance and workplace safety. | Column physical_demands (STRING) in workforce.job_profile']
  preferred_skills varchar [note: 'Comma-separated list of additional skills that are desirable but not mandatory. Used to identify high-potential candidates and development opportunities. | Column preferred_skills (STRING) in workforce.job_profile']
  remote_work_eligible_flag boolean [note: 'Indicates whether this role is eligible for remote or hybrid work arrangements. Used for workforce planning, real estate optimization, and talent attraction. | Column remote_work_eligible_flag (BOOLEAN) in workforce.job_profile']
  required_certifications varchar [note: 'Comma-separated list of professional certifications, licenses, or credentials required or preferred for this role. Examples: FCC General Radiotelephone Operator License, Certified Broadcast Networking Technician (CBNT), Society of Broadcast Engineers (SBE) Certification. | Column required_certifications (STRING) in workforce.job_profile']
  required_skills varchar [note: 'Comma-separated list of technical, functional, and soft skills required for successful performance in this role. Examples: video editing, broadcast automation systems, Adobe Premiere, Final Cut Pro, project management, stakeholder communication. | Column required_skills (STRING) in workforce.job_profile']
  salary_band_maximum decimal(15,2) [note: 'Maximum annual base salary for this job profile in USD. Represents the ceiling for this role\'s compensation range. | Column salary_band_maximum (DECIMAL(15,2)) in workforce.job_profile']
  salary_band_midpoint decimal(15,2) [note: 'Midpoint or target annual base salary for this job profile in USD. Represents the market-competitive rate for fully competent performance. | Column salary_band_midpoint (DECIMAL(15,2)) in workforce.job_profile']
  salary_band_minimum decimal(15,2) [note: 'Minimum annual base salary for this job profile in USD. Used for compensation planning, budgeting, and pay equity analysis. | Column salary_band_minimum (DECIMAL(15,2)) in workforce.job_profile']
  salary_currency_code varchar [note: 'Three-letter ISO 4217 currency code for salary band amounts. Supports multi-currency compensation structures for global operations. | Column salary_currency_code (STRING) in workforce.job_profile']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.job_profile']
  travel_requirement_percentage varchar [note: 'Expected percentage of work time requiring business travel. Used for candidate expectations, expense budgeting, and work-life balance planning. | Column travel_requirement_percentage (INT) in workforce.job_profile']
  union_eligible_flag boolean [note: 'Indicates whether this role is eligible for union membership or collective bargaining representation. Critical for labor relations, contract negotiations, and compliance with National Labor Relations Act (NLRA). | Column union_eligible_flag (BOOLEAN) in workforce.job_profile']
  union_name varchar [note: 'Name of the labor union or collective bargaining unit representing this role, if applicable. Examples: International Brotherhood of Electrical Workers (IBEW), National Association of Broadcast Employees and Technicians (NABET-CWA), Writers Guild of America (WGA). | Column union_name (STRING) in workforce.job_profile']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.job_profile']
  version_number varchar [note: 'Sequential version number for this job profile. Incremented with each revision to support change management and historical tracking. | Column version_number (INT) in workforce.job_profile']
  work_schedule_type varchar [note: 'Typical work schedule pattern for this role. Critical for broadcast operations requiring 24/7 coverage and shift-based staffing. | Column work_schedule_type (STRING) in workforce.job_profile']

  Note: 'Reference catalog of all standardized job profiles and role definitions used across Media Broadcasting — broadcast engineer, news producer, content scheduler, ad traffic coordinator, studio director, etc. Captures job code, job title, job family, job level/grade band, FLSA classification (exempt/non-exempt), EEO job category, minimum qualifications, required certifications, salary band reference, and whether the role is union-eligible. Serves as the authoritative job taxonomy for workforce planning, compensation benchmarking, and talent acquisition. | Unity Catalog table: media_broadcasting_ecm.workforce.job_profile'
}

Table workforce.position {
  position_id varchar [pk, note: 'Unique identifier for the approved headcount position within Media Broadcasting\'s organizational structure. Primary key. | Column position_id (BIGINT) in workforce.position']
  assigned_channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Positions like "ESPN2 Scheduler" or "Fox Sports Traffic Coordinator" are often channel-specific. Workforce planning and job descriptions in broadcasting are tied to specific channel operations for res | Column assigned_channel_id (BIGINT) in scheduling.position']
  cost_center_id varchar [note: 'Reference to the cost center that bears the budget for this position. Used for financial planning, headcount cost allocation, and budget tracking. | Column cost_center_id (BIGINT) in finance.position']
  incumbent_employee_id varchar [note: 'Reference to the employee currently occupying this position. Null if the position is vacant. Enables tracking of position-to-person assignments and vacancy analysis. | Column incumbent_employee_id (BIGINT) in workforce.position']
  job_profile_id varchar [note: 'Reference to the standardized job profile that defines the role\'s responsibilities, competencies, and requirements. Links to the job catalog maintained by HR. | Column job_profile_id (BIGINT) in workforce.position']
  org_unit_id varchar [note: 'Reference to the organizational unit (department, division, or team) to which this position is assigned. Enables hierarchical workforce reporting and cost center allocation. | Column org_unit_id (BIGINT) in workforce.position']
  reports_to_position_id varchar [note: 'Reference to the supervisory position to which this position reports. Enables construction of organizational reporting hierarchies and span-of-control analysis. | Column reports_to_position_id (BIGINT) in workforce.position']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.position']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.position']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.position']
  approval_date date [note: 'The date on which the position was officially approved for funding by the budget committee or executive leadership. Used for budget cycle tracking and headcount authorization audit. | Column approval_date (DATE) in workforce.position']
  budget_status varchar [note: 'Budget approval status for the position: approved (funded and authorized), frozen (temporarily unfunded), pending (awaiting budget committee review), or rejected (not authorized for funding). | Column budget_status (STRING) in workforce.position']
  budgeted_annual_salary decimal(15,2) [note: 'The annual salary amount budgeted for this position in the organization\'s financial plan. Used for headcount cost forecasting and budget variance analysis. Business-confidential. | Column budgeted_annual_salary (DECIMAL(15,2)) in workforce.position']
  business_justification varchar [note: 'Narrative explanation of the business need and strategic rationale for creating or maintaining this position. Used for budget approval and workforce planning documentation. | Column business_justification (STRING) in workforce.position']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.position']
  created_date date [note: 'The date on which this position record was first created in the HR system. Used for audit trail and position history tracking. | Column created_date (DATE) in workforce.position']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the budgeted salary (e.g., USD, GBP, EUR). Enables multi-currency workforce cost reporting for global operations. | Column currency_code (STRING) in workforce.position']
  effective_end_date date [note: 'The date on which this position record expires or is retired. Null for open-ended positions. Used for temporal workforce planning and position lifecycle tracking. | Column effective_end_date (DATE) in workforce.position']
  effective_start_date date [note: 'The date on which this position record becomes effective and the position is officially available for assignment. Used for temporal workforce planning and historical analysis. | Column effective_start_date (DATE) in workforce.position']
  employment_type varchar [note: 'Classification of the position based on working hours and schedule: full-time (standard hours), part-time (reduced hours), casual (irregular hours), or on-call (as-needed). | Column employment_type (STRING) in workforce.position']
  fte_allocation decimal(5,2) [note: 'The full-time equivalent allocation for this position, expressed as a decimal (e.g., 1.00 for full-time, 0.50 for half-time). Used for headcount budgeting and workforce capacity planning. | Column fte_allocation (DECIMAL(5,2)) in workforce.position']
  is_exempt boolean [note: 'Boolean flag indicating whether the position is exempt from overtime pay requirements under the Fair Labor Standards Act (FLSA). True if exempt (salaried professional/managerial), False if non-exempt (hourly/overtime-eligible). | Column is_exempt (BOOLEAN) in workforce.position']
  is_remote_eligible boolean [note: 'Boolean flag indicating whether the position is eligible for remote or hybrid work arrangements. True if remote work is permitted, False if on-site presence is required. | Column is_remote_eligible (BOOLEAN) in workforce.position']
  is_union_position boolean [note: 'Boolean flag indicating whether this position is covered by a collective bargaining agreement. True if union-represented, False otherwise. Used for labor cost modeling and contract compliance. | Column is_union_position (BOOLEAN) in workforce.position']
  job_family varchar [note: 'Broad occupational category to which the position belongs (e.g., Engineering, Content Production, Sales, Finance, IT). Used for workforce segmentation and career path planning. | Column job_family (STRING) in workforce.position']
  job_level varchar [note: 'Hierarchical level or grade of the position within the organization\'s job architecture (e.g., Entry, Mid, Senior, Manager, Director, Executive). Used for compensation benchmarking and career progression. | Column job_level (STRING) in workforce.position']
  last_modified_date date [note: 'The date on which this position record was most recently updated. Used for change tracking and data quality monitoring. | Column last_modified_date (DATE) in workforce.position']
  position_code varchar [note: 'Externally-known unique business identifier for the position, used in HR systems, budget planning, and workforce reporting. Typically alphanumeric code assigned by HR. | Column position_code (STRING) in workforce.position']
  position_description varchar [note: 'Detailed narrative description of the position\'s purpose, key responsibilities, and scope. Used for job postings, performance management, and organizational documentation. | Column position_description (STRING) in workforce.position']
  position_status varchar [note: 'Current lifecycle status of the position: active (approved and available), vacant (approved but unfilled), filled (occupied by employee), frozen (temporarily suspended), obsolete (retired), or pending-approval (awaiting budget authorization). | Column position_status (STRING) in workforce.position']
  position_type varchar [note: 'Classification of the position based on employment duration and nature: permanent (ongoing), temporary (fixed-term), contract (external contractor slot), seasonal (recurring short-term), project-based (tied to specific initiative), or internship. | Column position_type (STRING) in workforce.position']
  preferred_qualifications varchar [note: 'Summary of the desired (but not mandatory) education, certifications, experience, and skills that would enhance candidate suitability. Used for recruitment and candidate ranking. | Column preferred_qualifications (STRING) in workforce.position']
  required_qualifications varchar [note: 'Summary of the minimum education, certifications, experience, and skills required for the position. Used for recruitment screening and candidate evaluation. | Column required_qualifications (STRING) in workforce.position']
  requires_security_clearance boolean [note: 'Boolean flag indicating whether the position requires a security clearance or background check due to access to sensitive content, facilities, or systems. True if clearance required, False otherwise. | Column requires_security_clearance (BOOLEAN) in workforce.position']
  salary_grade varchar [note: 'Compensation grade or band assigned to the position, defining the salary range. Used for pay equity analysis and budget planning. Business-confidential. | Column salary_grade (STRING) in workforce.position']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.position']
  title varchar [note: 'Official job title for the position as it appears in organizational charts, job postings, and HR records (e.g., Senior Broadcast Engineer, Content Producer, Ad Sales Manager). | Column title (STRING) in workforce.position']
  union_affiliation varchar [note: 'Name of the labor union or collective bargaining unit to which this position belongs, if applicable (e.g., IATSE, SAG-AFTRA, NABET-CWA). Null for non-union positions. Used for labor relations and contract compliance. | Column union_affiliation (STRING) in workforce.position']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.position']
  vacancy_posted_date date [note: 'The date on which the position was posted as a job opening for recruitment. Null if the position has never been vacant or posted. Used for time-to-fill analysis and recruitment metrics. | Column vacancy_posted_date (DATE) in workforce.position']

  Note: 'Master record for each approved headcount position within Media Broadcasting\'s organizational structure. A position is a budgeted slot within an org unit that may be filled or vacant. Captures position code, position title, org unit, job profile reference, FTE allocation, position type (permanent/temporary/contract), budget status (approved/frozen), filled/vacant status, incumbent employee reference, and effective date range. Enables workforce planning, vacancy tracking, and headcount budget control distinct from the individual employee record. | Unity Catalog table: media_broadcasting_ecm.workforce.position'
}

Table workforce.employment_record {
  employment_record_id varchar [pk, note: 'Unique identifier for each distinct employment engagement or assignment. Primary key for the employment record. | Column employment_record_id (BIGINT) in workforce.employment_record']
  job_profile_id varchar [note: 'Reference to the job profile or job classification that defines the role, responsibilities, and competencies for this employment engagement. | Column job_profile_id (BIGINT) in workforce.employment_record']
  org_unit_id varchar [note: 'Reference to the organizational unit (department, division, or business unit) where the employee is assigned during this employment period. | Column org_unit_id (BIGINT) in workforce.employment_record']
  position_id varchar [note: 'Reference to the specific position held in this employment engagement. Links to the position master record. | Column position_id (BIGINT) in workforce.employment_record']
  previous_employment_record_id varchar [note: 'Self-referencing FK on employment_record (previous_employment_record_id) | Column previous_employment_record_id (BIGINT) in workforce.employment_record']
  primary_employment_employee_id varchar [note: 'Reference to the employee who holds this employment record. Links to the employee master record. | Column primary_employment_employee_id (BIGINT) in workforce.employment_record']
  work_location_id varchar [note: 'Reference to the primary physical work location (office, studio, broadcast facility) where the employee is based during this employment period. | Column work_location_id (BIGINT) in production.employment_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.employment_record']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.employment_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.employment_record']
  action_effective_timestamp timestamp [note: 'The precise date and time when the employment action became effective in the HR system. Used for audit trails and compliance reporting. | Column action_effective_timestamp (TIMESTAMP) in workforce.employment_record']
  action_processed_by varchar [note: 'The HR administrator or system user who processed and recorded this employment action. Used for audit trails and accountability. | Column action_processed_by (STRING) in workforce.employment_record']
  contract_end_date date [note: 'The scheduled end date of the employment contract for fixed-term or project-based engagements. Nullable for permanent or at-will contracts. | Column contract_end_date (DATE) in workforce.employment_record']
  contract_type varchar [note: 'The type of employment contract governing this employment engagement. Indicates whether the contract is permanent, fixed-term, project-based, at-will, or governed by a union agreement. | Column contract_type (STRING) in workforce.employment_record']
  cost_center_code varchar [note: 'The cost center to which this employees compensation and benefits are charged during this employment period. Used for financial accounting and budget allocation. | Column cost_center_code (STRING) in workforce.employment_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.employment_record']
  data_source_system varchar [note: 'The source system or application from which this employment record originated. Typically references SAP S/4HANA HR or other HR management systems. | Column data_source_system (STRING) in workforce.employment_record']
  effective_end_date date [note: 'The date when this employment engagement or assignment officially ends. Nullable for ongoing employment. Marks the conclusion of this specific employment period. | Column effective_end_date (DATE) in workforce.employment_record']
  effective_start_date date [note: 'The date when this employment engagement or assignment officially begins. Marks the start of the employment period for this specific position and organizational assignment. | Column effective_start_date (DATE) in workforce.employment_record']
  employee_group varchar [note: 'High-level classification of the employee type (e.g., active employees, retirees, external workers). Used for payroll processing and benefits eligibility determination. | Column employee_group (STRING) in workforce.employment_record']
  employee_subgroup varchar [note: 'Detailed classification within the employee group (e.g., salaried, hourly, union, non-union). Determines specific payroll rules and time management policies. | Column employee_subgroup (STRING) in workforce.employment_record']
  employment_action_reason varchar [note: 'Detailed reason or justification for the employment action. Provides context for why the hire, transfer, promotion, or other action occurred. | Column employment_action_reason (STRING) in workforce.employment_record']
  employment_action_type varchar [note: 'The type of employment action that created this employment record. Indicates whether this is an initial hire, internal transfer, promotion, demotion, secondment, or rehire event. | Column employment_action_type (STRING) in workforce.employment_record']
  employment_status varchar [note: 'Current lifecycle status of this employment record at the time of the action. Indicates whether the employment engagement is active, inactive, suspended, terminated, or on leave. | Column employment_status (STRING) in workforce.employment_record']
  employment_type varchar [note: 'Classification of the employment engagement by work arrangement. Indicates whether the employee is full-time, part-time, contract, temporary, seasonal, or intern. | Column employment_type (STRING) in workforce.employment_record']
  fte_percentage decimal(5,2) [note: 'The full-time equivalency percentage for this employment engagement. Represents the proportion of a full-time workload, expressed as a percentage (e.g., 100.00 for full-time, 50.00 for half-time). | Column fte_percentage (DECIMAL(5,2)) in workforce.employment_record']
  notice_period_days varchar [note: 'The number of days of notice required for termination of this employment engagement, as specified in the employment contract or applicable labor law. | Column notice_period_days (INT) in workforce.employment_record']
  pay_grade varchar [note: 'The pay grade or salary band assigned to this employment engagement. Determines compensation range and benefits eligibility. | Column pay_grade (STRING) in workforce.employment_record']
  pay_scale_area varchar [note: 'Geographic or organizational area that determines the applicable pay scale. Used for regional compensation adjustments and cost-of-living considerations. | Column pay_scale_area (STRING) in workforce.employment_record']
  pay_scale_type varchar [note: 'The type of pay scale or compensation structure applied to this employment engagement. May reference union agreements, executive compensation plans, or standard salary structures. | Column pay_scale_type (STRING) in workforce.employment_record']
  personnel_area varchar [note: 'The personnel area representing the geographic or administrative grouping for HR administration. Used for payroll processing, benefits administration, and compliance reporting. | Column personnel_area (STRING) in workforce.employment_record']
  personnel_subarea varchar [note: 'Subdivision of the personnel area providing finer-grained administrative grouping. Used for location-specific HR policies and time management rules. | Column personnel_subarea (STRING) in workforce.employment_record']
  probation_end_date date [note: 'The date when the probationary period for this employment engagement ends. Nullable if no probation period applies or if the employee has already completed probation. | Column probation_end_date (DATE) in workforce.employment_record']
  record_active_flag boolean [note: 'Indicates whether this employment record is currently active and valid. Used for filtering current vs historical employment engagements in reporting and analytics. | Column record_active_flag (BOOLEAN) in workforce.employment_record']
  record_created_timestamp timestamp [note: 'The date and time when this employment record was first created in the HR system. Used for audit trails and data lineage tracking. | Column record_created_timestamp (TIMESTAMP) in workforce.employment_record']
  record_updated_timestamp timestamp [note: 'The date and time when this employment record was last modified in the HR system. Used for audit trails and change tracking. | Column record_updated_timestamp (TIMESTAMP) in workforce.employment_record']
  remote_work_eligible_flag boolean [note: 'Indicates whether the employee is eligible for remote or work-from-home arrangements during this employment period. Reflects organizational policy and role requirements. | Column remote_work_eligible_flag (BOOLEAN) in workforce.employment_record']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.employment_record']
  union_code varchar [note: 'Code identifying the specific labor union to which the employee belongs, if applicable. References collective bargaining agreements and union-specific policies. | Column union_code (STRING) in workforce.employment_record']
  union_membership_flag boolean [note: 'Indicates whether the employee is a member of a labor union during this employment period. Used for collective bargaining agreement compliance and benefits administration. | Column union_membership_flag (BOOLEAN) in workforce.employment_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.employment_record']
  weekly_hours decimal(5,2) [note: 'The standard number of hours per week the employee is contracted to work during this employment period. Used for full-time equivalency calculations. | Column weekly_hours (DECIMAL(5,2)) in workforce.employment_record']
  work_schedule_code varchar [note: 'Code representing the work schedule pattern assigned to the employee during this employment period. Defines working hours, shift patterns, and time allocation. | Column work_schedule_code (STRING) in workforce.employment_record']
  work_schedule_description varchar [note: 'Human-readable description of the work schedule. Provides details about working hours, shift patterns, or flexible work arrangements. | Column work_schedule_description (STRING) in workforce.employment_record']

  Note: 'Transactional record capturing each distinct employment engagement or assignment for an employee — covering initial hire, internal transfers, promotions, demotions, secondments, and rehires. Each row represents a single employment period with a specific position, org unit, job profile, employment type, and manager. Captures effective start date, effective end date, employment action type, action reason, reporting manager, work schedule, work location, and employment status at time of action. Forms the complete employment history timeline for each employee. | Unity Catalog table: media_broadcasting_ecm.workforce.employment_record'
}

Table workforce.compensation_plan {
  compensation_plan_id varchar [pk, note: 'Unique identifier for the compensation plan record. Primary key for the compensation plan entity. | Column compensation_plan_id (BIGINT) in workforce.compensation_plan']
  employee_id varchar [note: 'Reference to the employee assigned to this compensation plan. Links to the employee master record in the workforce domain. | Column employee_id (BIGINT) in workforce.compensation_plan']
  job_profile_id varchar [note: 'Reference to the job profile or position that this compensation plan is associated with. Used when the plan is defined at the job level rather than individual employee level. | Column job_profile_id (BIGINT) in workforce.compensation_plan']
  org_unit_id varchar [note: 'Reference to the department or organizational unit where this compensation plan applies. Used for departmental compensation structures. | Column org_unit_id (BIGINT) in workforce.compensation_plan']
  superseded_compensation_plan_id varchar [note: 'Self-referencing FK on compensation_plan (superseded_compensation_plan_id) | Column superseded_compensation_plan_id (BIGINT) in workforce.compensation_plan']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.compensation_plan']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.compensation_plan']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.compensation_plan']
  approval_date date [note: 'Date when the compensation plan was approved by authorized personnel. | Column approval_date (DATE) in workforce.compensation_plan']
  approval_status varchar [note: 'Approval workflow status for the compensation plan: pending (awaiting approval), approved (authorized for use), or rejected (not approved). | Column approval_status (STRING) in workforce.compensation_plan']
  approved_by varchar [note: 'Name or identifier of the HR manager or executive who approved this compensation plan. | Column approved_by (STRING) in workforce.compensation_plan']
  base_salary_amount decimal(15,2) [note: 'Annual base salary amount for salaried employees. Null for hourly or commission-only plans. | Column base_salary_amount (DECIMAL(15,2)) in workforce.compensation_plan']
  bonus_eligible boolean [note: 'Indicates whether the employee under this plan is eligible for performance bonuses, annual bonuses, or incentive compensation. | Column bonus_eligible (BOOLEAN) in workforce.compensation_plan']
  commission_rate_percent decimal(5,2) [note: 'Commission percentage applied to sales or revenue for commission-based compensation plans. Null if commission not applicable. | Column commission_rate_percent (DECIMAL(5,2)) in workforce.compensation_plan']
  cost_center_code varchar [note: 'Cost center code for financial accounting and payroll expense allocation. Links compensation costs to organizational budget units. | Column cost_center_code (STRING) in workforce.compensation_plan']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.compensation_plan']
  created_timestamp timestamp [note: 'Timestamp when this compensation plan record was first created in the system. | Column created_timestamp (TIMESTAMP) in workforce.compensation_plan']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for compensation amounts (e.g., USD, GBP, EUR). | Column currency_code (STRING) in workforce.compensation_plan']
  effective_end_date date [note: 'Date when this compensation plan expires or is superseded by a new plan. Null for open-ended plans currently in effect. | Column effective_end_date (DATE) in workforce.compensation_plan']
  effective_start_date date [note: 'Date when this compensation plan becomes effective and active for the employee or job profile. | Column effective_start_date (DATE) in workforce.compensation_plan']
  flsa_classification varchar [note: 'FLSA classification determining overtime eligibility: exempt (not eligible for overtime) or non-exempt (eligible for overtime pay). | Column flsa_classification (STRING) in workforce.compensation_plan']
  hourly_rate decimal(10,2) [note: 'Hourly wage rate for hourly employees. Null for salaried or commission-only plans. | Column hourly_rate (DECIMAL(10,2)) in workforce.compensation_plan']
  last_modified_timestamp timestamp [note: 'Timestamp when this compensation plan record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in workforce.compensation_plan']
  modified_by varchar [note: 'User identifier or name of the person who last modified this compensation plan record. | Column modified_by (STRING) in workforce.compensation_plan']
  notes varchar [note: 'Free-text notes or comments about the compensation plan, including special terms, conditions, or historical context. | Column notes (STRING) in workforce.compensation_plan']
  overtime_eligible boolean [note: 'Indicates whether the employee under this plan is eligible for overtime pay under Fair Labor Standards Act (FLSA) or equivalent regulations. True for non-exempt employees, False for exempt. | Column overtime_eligible (BOOLEAN) in workforce.compensation_plan']
  overtime_rate_multiplier decimal(4,2) [note: 'Multiplier applied to base hourly rate for overtime hours (e.g., 1.5 for time-and-a-half, 2.0 for double-time). Null if overtime not applicable. | Column overtime_rate_multiplier (DECIMAL(4,2)) in workforce.compensation_plan']
  pay_frequency varchar [note: 'Frequency at which compensation is paid to the employee: weekly (52 times/year), bi-weekly (26 times/year), semi-monthly (24 times/year), or monthly (12 times/year). | Column pay_frequency (STRING) in workforce.compensation_plan']
  pay_grade varchar [note: 'Pay grade or band assigned to this compensation plan within the organization\'s compensation structure (e.g., \'Grade 5\', \'Band C\', \'Level 3\'). | Column pay_grade (STRING) in workforce.compensation_plan']
  pay_step varchar [note: 'Step or increment within the pay grade, typically representing progression based on tenure or performance (e.g., \'Step 1\', \'Step 2\'). | Column pay_step (STRING) in workforce.compensation_plan']
  plan_code varchar [note: 'Business identifier code for the compensation plan. Externally-known unique code used in HR systems and payroll processing. | Column plan_code (STRING) in workforce.compensation_plan']
  plan_name varchar [note: 'Human-readable name of the compensation plan (e.g., \'Senior Producer Salary Plan\', \'Broadcast Engineer Hourly Plan\'). | Column plan_name (STRING) in workforce.compensation_plan']
  plan_status varchar [note: 'Current lifecycle status of the compensation plan: draft (being designed), active (in effect), suspended (temporarily paused), terminated (ended), or superseded (replaced by newer plan). | Column plan_status (STRING) in workforce.compensation_plan']
  plan_type varchar [note: 'Type of compensation structure: salary (fixed annual), hourly (paid per hour worked), commission (performance-based), hybrid (combination), or contract (fixed-term agreement). | Column plan_type (STRING) in workforce.compensation_plan']
  shift_differential_eligible boolean [note: 'Indicates whether the employee is eligible for shift differential pay for working non-standard hours (evening, night, weekend shifts). | Column shift_differential_eligible (BOOLEAN) in workforce.compensation_plan']
  shift_differential_rate decimal(10,2) [note: 'Additional hourly rate or percentage added for shift differential pay. Null if shift differential not applicable. | Column shift_differential_rate (DECIMAL(10,2)) in workforce.compensation_plan']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.compensation_plan']
  standard_hours_per_week decimal(5,2) [note: 'Standard number of hours per week expected under this compensation plan (e.g., 40.00 for full-time, 20.00 for part-time). | Column standard_hours_per_week (DECIMAL(5,2)) in workforce.compensation_plan']
  target_bonus_percent decimal(5,2) [note: 'Target bonus as a percentage of base salary for bonus-eligible employees. Represents the expected bonus at 100% performance achievement. | Column target_bonus_percent (DECIMAL(5,2)) in workforce.compensation_plan']
  union_code varchar [note: 'Code identifying the labor union or collective bargaining unit governing this compensation plan (e.g., IATSE, SAG-AFTRA, NABET-CWA). Null if non-union. | Column union_code (STRING) in workforce.compensation_plan']
  union_scale_applicable boolean [note: 'Indicates whether this compensation plan is subject to union scale rates and collective bargaining agreement terms. | Column union_scale_applicable (BOOLEAN) in workforce.compensation_plan']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.compensation_plan']
  work_schedule_type varchar [note: 'Type of work schedule associated with this compensation plan: full-time (standard 40 hours/week), part-time (less than full-time), seasonal (recurring periods), temporary (fixed duration), or on-call (as-needed). | Column work_schedule_type (STRING) in workforce.compensation_plan']

  Note: 'Master record defining the compensation structure and pay plan assigned to an employee or job profile at Media Broadcasting. Captures pay plan type (salary/hourly/commission), base salary or hourly rate, pay frequency (weekly/bi-weekly/monthly), currency, effective date, pay grade, step within grade, overtime eligibility, shift differential eligibility, and union scale applicability. Distinct from talent compensation structures in the talent domain — this covers internal staff payroll compensation only. | Unity Catalog table: media_broadcasting_ecm.workforce.compensation_plan'
}

Table workforce.payroll_record {
  payroll_record_id varchar [pk, note: 'Unique identifier for each payroll processing event. Primary key for the payroll record entity. | Column payroll_record_id (BIGINT) in workforce.payroll_record']
  adjusted_payroll_record_id varchar [note: 'Self-referencing FK on payroll_record (adjusted_payroll_record_id) | Column adjusted_payroll_record_id (BIGINT) in workforce.payroll_record']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Payroll expense allocation to cost centers is fundamental to media broadcasting financial operations. Enables departmental cost tracking for production units, broadcast operations, news divisions, and | Column cost_center_id (BIGINT) in finance.payroll_record']
  employee_id varchar [note: 'Reference to the employee receiving this payroll payment. Links to the employee master record in the workforce domain. | Column employee_id (BIGINT) in workforce.payroll_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.payroll_record']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.payroll_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.payroll_record']
  bank_account_number varchar [note: 'Reference to the employee bank account used for direct deposit payment. Null if payment method is not direct deposit. | Column bank_account_number (BIGINT) in workforce.payroll_record']
  bonus_pay decimal(15,2) [note: 'Discretionary or performance-based bonus payments included in this payroll cycle. | Column bonus_pay (DECIMAL(15,2)) in workforce.payroll_record']
  check_number varchar [note: 'Physical check number if payment method is check. Null for direct deposit or other payment methods. | Column check_number (STRING) in workforce.payroll_record']
  commission_pay decimal(15,2) [note: 'Sales commission earnings included in this payroll payment, typically for sales or revenue-generating roles. | Column commission_pay (DECIMAL(15,2)) in workforce.payroll_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.payroll_record']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this record. Typically USD for Media Broadcasting operations. | Column currency_code (STRING) in workforce.payroll_record']
  dental_insurance_deduction decimal(15,2) [note: 'Employee portion of dental insurance premium deducted from payroll. | Column dental_insurance_deduction (DECIMAL(15,2)) in workforce.payroll_record']
  double_time_hours decimal(10,2) [note: 'Total number of hours worked that qualify for double-time premium pay, typically for holidays or excessive overtime. | Column double_time_hours (DECIMAL(10,2)) in workforce.payroll_record']
  federal_income_tax decimal(15,2) [note: 'Amount withheld for federal income tax based on employee W-4 elections and IRS tax tables. | Column federal_income_tax (DECIMAL(15,2)) in workforce.payroll_record']
  fsa_deduction decimal(15,2) [note: 'Pre-tax contribution to Flexible Spending Account for healthcare or dependent care expenses. | Column fsa_deduction (DECIMAL(15,2)) in workforce.payroll_record']
  garnishment_deduction decimal(15,2) [note: 'Court-ordered or legally mandated wage garnishment for child support, tax levies, or other obligations. | Column garnishment_deduction (DECIMAL(15,2)) in workforce.payroll_record']
  gross_pay decimal(15,2) [note: 'Total earnings before any deductions or withholdings. Sum of all pay components for the period. | Column gross_pay (DECIMAL(15,2)) in workforce.payroll_record']
  health_insurance_deduction decimal(15,2) [note: 'Employee portion of health insurance premium deducted from payroll. | Column health_insurance_deduction (DECIMAL(15,2)) in workforce.payroll_record']
  hsa_deduction decimal(15,2) [note: 'Pre-tax contribution to Health Savings Account for qualified medical expenses. | Column hsa_deduction (DECIMAL(15,2)) in workforce.payroll_record']
  local_income_tax decimal(15,2) [note: 'Amount withheld for local or municipal income tax where applicable. | Column local_income_tax (DECIMAL(15,2)) in workforce.payroll_record']
  medicare_tax decimal(15,2) [note: 'Employee portion of Medicare tax withheld under the Federal Insurance Contributions Act (FICA). | Column medicare_tax (DECIMAL(15,2)) in workforce.payroll_record']
  net_pay decimal(15,2) [note: 'Take-home pay after all deductions and withholdings. The amount actually disbursed to the employee. | Column net_pay (DECIMAL(15,2)) in workforce.payroll_record']
  other_deductions decimal(15,2) [note: 'Miscellaneous voluntary or involuntary deductions not categorized elsewhere. | Column other_deductions (DECIMAL(15,2)) in workforce.payroll_record']
  other_earnings decimal(15,2) [note: 'Miscellaneous additional earnings not categorized as regular, overtime, bonus, or commission pay. | Column other_earnings (DECIMAL(15,2)) in workforce.payroll_record']
  overtime_hours decimal(10,2) [note: 'Total number of hours worked beyond the standard work schedule that qualify for overtime premium pay. | Column overtime_hours (DECIMAL(10,2)) in workforce.payroll_record']
  overtime_pay decimal(15,2) [note: 'Additional earnings from overtime hours worked, typically calculated at 1.5x the regular rate. | Column overtime_pay (DECIMAL(15,2)) in workforce.payroll_record']
  pay_frequency varchar [note: 'The recurring schedule on which the employee is paid. Determines the cadence of payroll processing for this employee. | Column pay_frequency (STRING) in workforce.payroll_record']
  pay_period_end_date date [note: 'The last day of the work period covered by this payroll payment. Defines the end of the earnings period. | Column pay_period_end_date (DATE) in workforce.payroll_record']
  pay_period_start_date date [note: 'The first day of the work period covered by this payroll payment. Defines the beginning of the earnings period. | Column pay_period_start_date (DATE) in workforce.payroll_record']
  payment_date date [note: 'The date on which the net pay is disbursed to the employee. The actual payment delivery date. | Column payment_date (DATE) in workforce.payroll_record']
  payment_method varchar [note: 'The method by which net pay is delivered to the employee. | Column payment_method (STRING) in workforce.payroll_record']
  payroll_run_date date [note: 'The date on which the payroll calculations were executed and this record was generated. | Column payroll_run_date (DATE) in workforce.payroll_record']
  payroll_status varchar [note: 'Current processing status of this payroll record in its lifecycle from calculation through payment. | Column payroll_status (STRING) in workforce.payroll_record']
  pto_hours decimal(10,2) [note: 'Number of paid time off hours used during this pay period, including vacation, sick leave, and personal days. | Column pto_hours (DECIMAL(10,2)) in workforce.payroll_record']
  regular_hours decimal(10,2) [note: 'Total number of standard work hours performed during the pay period at the base rate of pay. | Column regular_hours (DECIMAL(10,2)) in workforce.payroll_record']
  regular_pay decimal(15,2) [note: 'Earnings from regular hours worked at the base hourly or salary rate. Excludes overtime and other premium pay. | Column regular_pay (DECIMAL(15,2)) in workforce.payroll_record']
  retirement_401k_deduction decimal(15,2) [note: 'Employee pre-tax or Roth contribution to 401(k) retirement savings plan. | Column retirement_401k_deduction (DECIMAL(15,2)) in workforce.payroll_record']
  social_security_tax decimal(15,2) [note: 'Employee portion of Social Security tax withheld under the Federal Insurance Contributions Act (FICA). | Column social_security_tax (DECIMAL(15,2)) in workforce.payroll_record']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.payroll_record']
  state_income_tax decimal(15,2) [note: 'Amount withheld for state income tax based on state tax regulations and employee elections. | Column state_income_tax (DECIMAL(15,2)) in workforce.payroll_record']
  total_deductions decimal(15,2) [note: 'Sum of all tax withholdings and voluntary deductions subtracted from gross pay. | Column total_deductions (DECIMAL(15,2)) in workforce.payroll_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.payroll_record']
  vision_insurance_deduction decimal(15,2) [note: 'Employee portion of vision insurance premium deducted from payroll. | Column vision_insurance_deduction (DECIMAL(15,2)) in workforce.payroll_record']

  Note: 'Transactional record of each payroll processing event for an employee covering a specific pay period. Captures pay period start and end dates, gross pay, federal/state/local tax withholdings, FICA contributions, voluntary deductions (401k, health insurance, FSA), net pay, payment method (direct deposit/check), bank account reference, payroll run date, and payroll status. Serves as the authoritative payroll ledger for each employee pay cycle — feeds finance domain for payroll expense posting. | Unity Catalog table: media_broadcasting_ecm.workforce.payroll_record'
}

Table workforce.benefit_enrollment {
  benefit_enrollment_id varchar [pk, note: 'Unique identifier for the benefit enrollment record. Primary key for this entity. | Column benefit_enrollment_id (BIGINT) in workforce.benefit_enrollment']
  benefit_plan_id varchar [note: 'Reference to the specific benefit plan in which the employee is enrolling. Links to the benefit plan master record. | Column benefit_plan_id (BIGINT) in workforce.benefit_enrollment']
  employee_id varchar [note: 'Reference to the employee who is enrolling in the benefit plan. Links to the employee master record in the workforce domain. | Column employee_id (BIGINT) in workforce.benefit_enrollment']
  superseded_benefit_enrollment_id varchar [note: 'Self-referencing FK on benefit_enrollment (superseded_benefit_enrollment_id) | Column superseded_benefit_enrollment_id (BIGINT) in workforce.benefit_enrollment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.benefit_enrollment']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.benefit_enrollment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.benefit_enrollment']
  annual_election_amount decimal(15,2) [note: 'For FSA, HSA, or other contribution-based plans, the total annual amount the employee elected to contribute for the plan year. Expressed in USD. Nullable for non-contribution plans. | Column annual_election_amount (DECIMAL(15,2)) in workforce.benefit_enrollment']
  carrier_name varchar [note: 'The name of the insurance carrier or benefits provider administering this plan (e.g., Blue Cross Blue Shield, Aetna, Fidelity, Vanguard). Used for vendor management and claims coordination. | Column carrier_name (STRING) in workforce.benefit_enrollment']
  contingent_beneficiary_name varchar [note: 'The full legal name of the contingent (secondary) beneficiary who receives benefits if the primary beneficiary is deceased or unable to receive benefits. Nullable if no contingent beneficiary designated. | Column contingent_beneficiary_name (STRING) in workforce.benefit_enrollment']
  contingent_beneficiary_relationship varchar [note: 'The relationship of the contingent beneficiary to the employee. [ENUM-REF-CANDIDATE: spouse|child|parent|sibling|domestic_partner|other_relative|friend|estate|trust|other — 10 candidates stripped; promote to reference product] | Column contingent_beneficiary_relationship (STRING) in workforce.benefit_enrollment']
  coverage_amount decimal(15,2) [note: 'For life insurance and disability plans, the face value or benefit amount of the coverage (e.g., $100,000 life insurance, 60% salary replacement for disability). Expressed in USD or as a percentage. Nullable for non-insurance benefits. | Column coverage_amount (DECIMAL(15,2)) in workforce.benefit_enrollment']
  coverage_tier varchar [note: 'The level of coverage selected by the employee, determining who is covered under the benefit plan (employee only, employee plus spouse, employee plus children, full family, or employee plus domestic partner). | Column coverage_tier (STRING) in workforce.benefit_enrollment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.benefit_enrollment']
  created_timestamp timestamp [note: 'The timestamp when this benefit enrollment record was first created in the system. Used for audit trail and data lineage. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column created_timestamp (TIMESTAMP) in workforce.benefit_enrollment']
  data_source_system varchar [note: 'The name of the source system from which this enrollment record originated (e.g., SAP S/4HANA HR, Workday, ADP, Benefits Administration Portal). Used for data lineage and reconciliation. | Column data_source_system (STRING) in workforce.benefit_enrollment']
  effective_date date [note: 'The date on which the benefit coverage begins and becomes active. This may differ from enrollment_date due to waiting periods or plan year start dates. | Column effective_date (DATE) in workforce.benefit_enrollment']
  employee_contribution_amount decimal(15,2) [note: 'The monetary amount that the employee contributes per pay period toward the benefit premium or plan cost. Expressed in USD. For retirement plans, this may represent the employee deferral percentage converted to dollar amount. | Column employee_contribution_amount (DECIMAL(15,2)) in workforce.benefit_enrollment']
  employee_contribution_frequency varchar [note: 'The frequency at which the employee contribution is deducted from payroll or paid by the employee. | Column employee_contribution_frequency (STRING) in workforce.benefit_enrollment']
  employer_contribution_amount decimal(15,2) [note: 'The monetary amount that the employer contributes per pay period toward the benefit premium or plan cost. Expressed in USD. For retirement plans, this may include employer match or profit-sharing contributions. | Column employer_contribution_amount (DECIMAL(15,2)) in workforce.benefit_enrollment']
  employer_contribution_frequency varchar [note: 'The frequency at which the employer contribution is made toward the benefit plan. | Column employer_contribution_frequency (STRING) in workforce.benefit_enrollment']
  enrollment_confirmation_number varchar [note: 'A confirmation or transaction number provided by the benefits administration system or carrier when the enrollment is processed. Used for audit trail and employee inquiries. | Column enrollment_confirmation_number (STRING) in workforce.benefit_enrollment']
  enrollment_date date [note: 'The date on which the employee submitted or completed the benefit enrollment election. This is the transaction date when the enrollment decision was made. | Column enrollment_date (DATE) in workforce.benefit_enrollment']
  enrollment_number varchar [note: 'Human-readable business identifier for the benefit enrollment, typically used in HR systems and employee communications. Format: BEN-YYYYNNNN where YYYY is year and NNNN is sequence. | Column enrollment_number (STRING) in workforce.benefit_enrollment']
  enrollment_source varchar [note: 'The triggering event or process that allowed this enrollment to occur. New hire indicates initial employment enrollment; open enrollment indicates annual election period; qualifying life event (QLE) indicates mid-year change due to marriage, birth, etc.; plan change indicates employee-initiated modification; rehire indicates return to employment. | Column enrollment_source (STRING) in workforce.benefit_enrollment']
  enrollment_status varchar [note: 'Current lifecycle status of the benefit enrollment. Pending indicates awaiting approval or effective date; active indicates currently in force; terminated indicates coverage has ended; suspended indicates temporary hold; cancelled indicates enrollment was voided before becoming active; waived indicates employee declined coverage. | Column enrollment_status (STRING) in workforce.benefit_enrollment']
  evidence_of_insurability_required boolean [note: 'Boolean flag indicating whether the employee must provide medical evidence of insurability (health questionnaire, medical exam) to qualify for this coverage level. Typically required for supplemental life insurance above guaranteed issue amounts. | Column evidence_of_insurability_required (BOOLEAN) in workforce.benefit_enrollment']
  evidence_of_insurability_status varchar [note: 'If evidence_of_insurability_required is true, this field tracks the status of the EOI submission and approval process. Not_required indicates no EOI needed; pending indicates awaiting carrier review; approved indicates coverage granted; denied indicates coverage declined; incomplete indicates additional information needed. | Column evidence_of_insurability_status (STRING) in workforce.benefit_enrollment']
  modified_timestamp timestamp [note: 'The timestamp when this benefit enrollment record was last modified in the system. Used for audit trail and change tracking. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column modified_timestamp (TIMESTAMP) in workforce.benefit_enrollment']
  plan_name varchar [note: 'The marketing or display name of the benefit plan as presented to employees (e.g., \'Premium Health PPO\', \'Basic Dental Plan\', \'401k Traditional\'). | Column plan_name (STRING) in workforce.benefit_enrollment']
  plan_type varchar [note: 'Category of benefit plan. Includes health insurance (medical/dental/vision), life insurance, disability insurance, retirement plans (401k/pension), flexible spending accounts (FSA), health savings accounts (HSA), commuter benefits, employee assistance programs (EAP), and supplemental coverage. [ENUM-REF-CANDIDATE: medical|dental|vision|life_insurance|disability_insurance|retirement_401k|retirement_pension|fsa|hsa|commuter_benefits|employee_assistance_program|supplemental_life|critical_illness|accident_insurance — 14 candidates stripped; promote to reference product] | Column plan_type (STRING) in workforce.benefit_enrollment']
  plan_year varchar [note: 'The calendar or fiscal year for which this enrollment is effective. Used to track enrollments across annual benefit cycles and open enrollment periods. Format: YYYY. | Column plan_year (INT) in workforce.benefit_enrollment']
  policy_number varchar [note: 'The carriers policy or group number under which this enrollment is covered. Used for claims processing and carrier coordination. Confidential business information. | Column policy_number (STRING) in workforce.benefit_enrollment']
  primary_beneficiary_name varchar [note: 'The full legal name of the primary beneficiary designated to receive benefits in the event of the employees death. Applicable primarily to life insurance and retirement plans. Nullable if no beneficiary designated. | Column primary_beneficiary_name (STRING) in workforce.benefit_enrollment']
  primary_beneficiary_percentage decimal(5,2) [note: 'The percentage of benefits allocated to the primary beneficiary. Typically 100 for single beneficiary or split among multiple. Value range 0.00 to 100.00. | Column primary_beneficiary_percentage (DECIMAL(5,2)) in workforce.benefit_enrollment']
  primary_beneficiary_relationship varchar [note: 'The relationship of the primary beneficiary to the employee. Used for compliance and verification purposes. [ENUM-REF-CANDIDATE: spouse|child|parent|sibling|domestic_partner|other_relative|friend|estate|trust|other — 10 candidates stripped; promote to reference product] | Column primary_beneficiary_relationship (STRING) in workforce.benefit_enrollment']
  qualifying_event_date date [note: 'The date on which the qualifying life event occurred (e.g., marriage date, birth date, loss of coverage date). Nullable for non-QLE enrollments. Used to validate enrollment timing compliance. | Column qualifying_event_date (DATE) in workforce.benefit_enrollment']
  qualifying_event_type varchar [note: 'If enrollment_source is qualifying_life_event, this field specifies the type of life event that triggered the mid-year enrollment change. Nullable for non-QLE enrollments. [ENUM-REF-CANDIDATE: marriage|divorce|birth|adoption|death_of_dependent|loss_of_coverage|employment_status_change|dependent_age_limit|other — 9 candidates stripped; promote to reference product] | Column qualifying_event_type (STRING) in workforce.benefit_enrollment']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.benefit_enrollment']
  termination_date date [note: 'The date on which the benefit coverage ends. Nullable for active enrollments. Populated when employee terminates employment, changes plans, or reaches plan end date. | Column termination_date (DATE) in workforce.benefit_enrollment']
  tobacco_user_flag boolean [note: 'Boolean flag indicating whether the employee declared tobacco use during enrollment. Used for premium rating and wellness program eligibility. Protected health information under HIPAA. | Column tobacco_user_flag (BOOLEAN) in workforce.benefit_enrollment']
  total_premium_amount decimal(15,2) [note: 'The total cost of the benefit plan per pay period, representing the sum of employee and employer contributions. Expressed in USD. Used for financial reporting and cost analysis. | Column total_premium_amount (DECIMAL(15,2)) in workforce.benefit_enrollment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.benefit_enrollment']
  waiver_reason varchar [note: 'If enrollment_status is waived, this field captures the reason the employee declined coverage (e.g., covered under spouses plan, Medicare eligible, cost concerns). Free-text field for HR documentation. Nullable for non-waived enrollments. | Column waiver_reason (STRING) in workforce.benefit_enrollment']
  wellness_program_participant_flag boolean [note: 'Boolean flag indicating whether the employee is participating in employer-sponsored wellness programs that may affect premium rates or provide incentives. | Column wellness_program_participant_flag (BOOLEAN) in workforce.benefit_enrollment']

  Note: 'Transactional record of an employee\'s enrollment in a specific benefit plan — health insurance (medical/dental/vision), life insurance, disability insurance, 401k/pension, FSA/HSA, commuter benefits, or employee assistance programs. Captures plan name, plan type, coverage tier (employee only/employee+spouse/family), enrollment date, effective date, termination date, employee contribution amount, employer contribution amount, beneficiary designations, and enrollment source (open enrollment/qualifying life event/new hire). | Unity Catalog table: media_broadcasting_ecm.workforce.benefit_enrollment'
}

Table workforce.leave_request {
  leave_request_id varchar [pk, note: 'Unique identifier for the leave request. Primary key for the leave request transaction. | Column leave_request_id (BIGINT) in workforce.leave_request']
  org_unit_id varchar [note: 'Identifier of the department where the employee works at the time of the leave request. Used for departmental leave analytics and staffing impact analysis. | Column org_unit_id (BIGINT) in workforce.leave_request']
  original_leave_request_id varchar [note: 'Self-referencing FK on leave_request (original_leave_request_id) | Column original_leave_request_id (BIGINT) in workforce.leave_request']
  primary_leave_employee_id varchar [note: 'Identifier of the employee submitting the leave request. Links to the employee master record in the workforce domain. | Column primary_leave_employee_id (BIGINT) in workforce.leave_request']
  tertiary_leave_substitute_employee_id varchar [note: 'Identifier of the employee designated to cover the absent employee\'s responsibilities during the leave period. Null if no formal substitute assigned. | Column tertiary_leave_substitute_employee_id (BIGINT) in workforce.leave_request']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.leave_request']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.leave_request']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.leave_request']
  actual_days_taken decimal(5,2) [note: 'Actual number of leave days taken, calculated from time and attendance records. Used for leave balance deduction and payroll processing. | Column actual_days_taken (DECIMAL(5,2)) in workforce.leave_request']
  actual_end_date date [note: 'Actual last date the employee was absent on approved leave. May differ from requested end date if employee returned early or extended leave. | Column actual_end_date (DATE) in workforce.leave_request']
  actual_hours_taken decimal(6,2) [note: 'Actual number of leave hours taken, calculated from time and attendance records. Used for hourly leave balance deduction and payroll processing. | Column actual_hours_taken (DECIMAL(6,2)) in workforce.leave_request']
  actual_start_date date [note: 'Actual first date the employee was absent on approved leave. May differ from requested start date if employee returned early or extended leave. | Column actual_start_date (DATE) in workforce.leave_request']
  approval_date date [note: 'Date when the approving manager made the approval or denial decision. Null if request is still pending. | Column approval_date (DATE) in workforce.leave_request']
  approval_status varchar [note: 'Current lifecycle status of the leave request: pending (awaiting manager review), approved (manager approved), denied (manager rejected), cancelled (approved but later cancelled by manager), withdrawn (employee withdrew before approval decision). | Column approval_status (STRING) in workforce.leave_request']
  approval_timestamp timestamp [note: 'Precise timestamp when the approving manager made the approval or denial decision, including time zone. Used for audit trail and SLA tracking. | Column approval_timestamp (TIMESTAMP) in workforce.leave_request']
  comments varchar [note: 'Free-text comments or notes provided by the employee when submitting the leave request, such as reason for leave or special circumstances. | Column comments (STRING) in workforce.leave_request']
  cost_center_code varchar [note: 'Cost center code to which the employee\'s time is charged. Used for financial reporting and labor cost allocation during leave periods. | Column cost_center_code (STRING) in workforce.leave_request']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.leave_request']
  created_timestamp timestamp [note: 'Timestamp when this leave request record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in workforce.leave_request']
  denial_reason varchar [note: 'Free-text explanation provided by the manager when denying a leave request. Null if request was approved or is still pending. | Column denial_reason (STRING) in workforce.leave_request']
  denial_reason_code varchar [note: 'Standardized categorical reason for denial: staffing_shortage (inadequate coverage), blackout_period (restricted dates such as sweeps or upfront periods), insufficient_notice (did not meet advance notice policy), policy_violation (does not meet eligibility or usage rules), other (see denial_reason for details). | Column denial_reason_code (STRING) in workforce.leave_request']
  fmla_certification_date date [note: 'Date when FMLA medical certification was received and approved by HR. Null for non-FMLA leave or if certification not yet approved. | Column fmla_certification_date (DATE) in workforce.leave_request']
  fmla_certification_status varchar [note: 'Status of required medical certification for FMLA leave: not_required (non-FMLA leave), pending (certification requested but not yet received), received (certification submitted by employee), approved (HR approved certification), insufficient (certification does not meet requirements). | Column fmla_certification_status (STRING) in workforce.leave_request']
  fmla_protected_flag boolean [note: 'Indicates whether this leave request is protected under the Family and Medical Leave Act. True if FMLA-eligible and certified. | Column fmla_protected_flag (BOOLEAN) in workforce.leave_request']
  intermittent_leave_flag boolean [note: 'Indicates whether this is an intermittent leave request (multiple non-consecutive absences for the same condition) rather than a continuous block of leave. Common for FMLA medical treatment schedules. | Column intermittent_leave_flag (BOOLEAN) in workforce.leave_request']
  last_modified_timestamp timestamp [note: 'Timestamp when this leave request record was last updated in the system. Tracks changes to approval status, actual dates, or other fields. | Column last_modified_timestamp (TIMESTAMP) in workforce.leave_request']
  leave_balance_after decimal(6,2) [note: 'Employee\'s remaining leave balance in days or hours after this request was approved and taken. Used for leave accrual and entitlement tracking. | Column leave_balance_after (DECIMAL(6,2)) in workforce.leave_request']
  leave_balance_before decimal(6,2) [note: 'Employee\'s available leave balance in days or hours before this request was approved and taken. Snapshot for audit and balance tracking. | Column leave_balance_before (DECIMAL(6,2)) in workforce.leave_request']
  leave_subtype varchar [note: 'Optional granular classification within the leave type, such as maternity vs paternity under parental leave, or continuous vs intermittent under FMLA. | Column leave_subtype (STRING) in workforce.leave_request']
  leave_type varchar [note: 'Category of leave being requested: vacation (paid time off), sick (illness or medical appointments), FMLA (Family and Medical Leave Act protected leave), parental (maternity/paternity/adoption), bereavement (death of family member), jury_duty (civic duty), military (military service), unpaid (leave without pay). | Column leave_type (STRING) in workforce.leave_request']
  manager_comments varchar [note: 'Free-text comments or notes provided by the approving manager when reviewing the leave request, such as approval conditions or coverage arrangements. | Column manager_comments (STRING) in workforce.leave_request']
  paid_leave_flag boolean [note: 'Indicates whether this leave is paid (employee receives regular compensation) or unpaid (no compensation during absence). Drives payroll deduction calculations. | Column paid_leave_flag (BOOLEAN) in workforce.leave_request']
  payroll_period varchar [note: 'Payroll period (YYYY-MM format) in which this leave was processed for compensation adjustments. Used to reconcile leave with payroll cycles. | Column payroll_period (STRING) in workforce.leave_request']
  payroll_processed_flag boolean [note: 'Indicates whether this leave request has been processed by payroll for deductions or adjustments. True once payroll cycle has incorporated the leave. | Column payroll_processed_flag (BOOLEAN) in workforce.leave_request']
  reduced_schedule_flag boolean [note: 'Indicates whether this leave request involves a reduced work schedule (working fewer hours per day or days per week) rather than full-day absences. Common for FMLA return-to-work transitions. | Column reduced_schedule_flag (BOOLEAN) in workforce.leave_request']
  request_date date [note: 'Date when the employee submitted the leave request. Represents the principal business event timestamp for this transaction. | Column request_date (DATE) in workforce.leave_request']
  request_number varchar [note: 'Human-readable business identifier for the leave request, typically formatted as LR-YYYYNNNN for external reference and tracking. | Column request_number (STRING) in workforce.leave_request']
  requested_end_date date [note: 'Last date of the requested leave period. Employee intends to return to work the following business day. | Column requested_end_date (DATE) in workforce.leave_request']
  requested_start_date date [note: 'First date of the requested leave period. Employee intends to be absent starting this date. | Column requested_start_date (DATE) in workforce.leave_request']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.leave_request']
  total_days_requested decimal(5,2) [note: 'Total number of leave days requested, calculated as business days between start and end dates. May include fractional days for partial-day leave. | Column total_days_requested (DECIMAL(5,2)) in workforce.leave_request']
  total_hours_requested decimal(6,2) [note: 'Total number of leave hours requested, used for hourly leave tracking and partial-day absences. Supports intermittent FMLA leave measured in hours. | Column total_hours_requested (DECIMAL(6,2)) in workforce.leave_request']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.leave_request']

  Note: 'Transactional record of each employee leave request submitted at Media Broadcasting — vacation, sick leave, FMLA, parental leave, bereavement, jury duty, military leave, and unpaid leave. Captures request date, leave type, requested start date, requested end date, total days requested, approval status, approving manager, approval date, denial reason if applicable, FMLA certification status, intermittent leave flag, and actual leave taken dates. Feeds time and attendance systems and payroll deduction calculations. | Unity Catalog table: media_broadcasting_ecm.workforce.leave_request'
}

Table workforce.leave_balance {
  leave_balance_id varchar [pk, note: 'Unique identifier for the leave balance record. Primary key. | Column leave_balance_id (BIGINT) in workforce.leave_balance']
  employee_id varchar [note: 'Identifier of the employee to whom this leave balance belongs. Links to the employee master record in the workforce domain. | Column employee_id (BIGINT) in workforce.leave_balance']
  prior_leave_balance_id varchar [note: 'Self-referencing FK on leave_balance (prior_leave_balance_id) | Column prior_leave_balance_id (BIGINT) in workforce.leave_balance']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.leave_balance']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.leave_balance']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.leave_balance']
  accrual_cap decimal(10,2) [note: 'Maximum leave balance that can be accrued for this leave type per Media Broadcasting policy. Once reached, no further accrual occurs until balance drops below cap. | Column accrual_cap (DECIMAL(10,2)) in workforce.leave_balance']
  accrual_period_end_date date [note: 'End date of the current accrual period. Balances may reset, roll over, or be forfeited at this boundary per policy. | Column accrual_period_end_date (DATE) in workforce.leave_balance']
  accrual_period_start_date date [note: 'Start date of the current accrual period (e.g., calendar year, fiscal year, or anniversary year depending on Media Broadcasting policy). | Column accrual_period_start_date (DATE) in workforce.leave_balance']
  accrual_rate decimal(10,4) [note: 'Rate at which leave accrues per pay period or per hour worked, based on employee tenure and policy tier. Expressed in hours or days per unit time. | Column accrual_rate (DECIMAL(10,4)) in workforce.leave_balance']
  accrued_current_period decimal(10,2) [note: 'Total leave hours or days accrued during the current period based on accrual rate and service time. Updated each pay period by payroll system. | Column accrued_current_period (DECIMAL(10,2)) in workforce.leave_balance']
  adjusted_balance decimal(10,2) [note: 'Manual adjustments to the leave balance (positive or negative) made by HR for corrections, policy exceptions, or one-time grants. Includes adjustment reason in notes. | Column adjusted_balance (DECIMAL(10,2)) in workforce.leave_balance']
  available_balance decimal(10,2) [note: 'Current available leave balance that the employee can request. Calculated as: opening_balance + accrued_current_period - used_current_period + adjusted_balance - pending_requests. | Column available_balance (DECIMAL(10,2)) in workforce.leave_balance']
  balance_as_of_date date [note: 'The date as of which this leave balance snapshot is accurate. Typically updated at the end of each pay period or after a leave transaction. | Column balance_as_of_date (DATE) in workforce.leave_balance']
  carried_over_balance decimal(10,2) [note: 'Leave balance carried forward from the prior accrual period. Subject to carryover caps per Media Broadcasting policy (e.g., maximum 40 hours vacation carryover). | Column carried_over_balance (DECIMAL(10,2)) in workforce.leave_balance']
  carryover_cap decimal(10,2) [note: 'Maximum leave balance that can be carried over to the next accrual period. Any balance above this cap is forfeited per policy. | Column carryover_cap (DECIMAL(10,2)) in workforce.leave_balance']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.leave_balance']
  created_timestamp timestamp [note: 'Timestamp when this leave balance record was first created in the system. Audit trail for record lifecycle. | Column created_timestamp (TIMESTAMP) in workforce.leave_balance']
  eligibility_status varchar [note: 'Current eligibility status of the employee for this leave type. Ineligible may apply during probation, leave of absence, or termination notice period. | Column eligibility_status (STRING) in workforce.leave_balance']
  forfeited_balance decimal(10,2) [note: 'Leave hours or days forfeited at the end of the prior period due to exceeding carryover caps or use-it-or-lose-it policy. Represents lost leave liability. | Column forfeited_balance (DECIMAL(10,2)) in workforce.leave_balance']
  is_active boolean [note: 'Indicates whether this leave balance record is currently active. Inactive records represent historical snapshots or terminated leave types. | Column is_active (BOOLEAN) in workforce.leave_balance']
  last_accrual_date date [note: 'Date of the most recent leave accrual transaction for this employee and leave type. Typically aligns with pay period end date. | Column last_accrual_date (DATE) in workforce.leave_balance']
  last_usage_date date [note: 'Date of the most recent leave usage (deduction) for this employee and leave type. Helps identify stale balances and usage patterns. | Column last_usage_date (DATE) in workforce.leave_balance']
  leave_type_code varchar [note: 'Code representing the type of leave (e.g., VAC for vacation, SICK for sick leave, PTO for paid time off, FLOAT for floating holiday, COMP for compensatory time). Standardized codes per Media Broadcasting HR policy. | Column leave_type_code (STRING) in workforce.leave_balance']
  leave_type_name varchar [note: 'Human-readable name of the leave type (e.g., Vacation, Sick Leave, Personal Time Off, Floating Holiday, Compensatory Time). | Column leave_type_name (STRING) in workforce.leave_balance']
  liability_amount decimal(12,2) [note: 'Monetary value of the current available leave balance, calculated as available_balance multiplied by the employees hourly or daily rate. Represents financial liability for Media Broadcasting. | Column liability_amount (DECIMAL(12,2)) in workforce.leave_balance']
  notes varchar [note: 'Free-text notes regarding this leave balance record, including reasons for manual adjustments, policy exceptions, or special circumstances documented by HR. | Column notes (STRING) in workforce.leave_balance']
  opening_balance decimal(10,2) [note: 'Leave balance at the start of the current accrual period, including any carryover from the prior period. Expressed in hours or days per unit of measure. | Column opening_balance (DECIMAL(10,2)) in workforce.leave_balance']
  pending_requests decimal(10,2) [note: 'Total leave hours or days currently requested but not yet approved or denied. Represents potential future deductions from available balance. | Column pending_requests (DECIMAL(10,2)) in workforce.leave_balance']
  policy_tier varchar [note: 'The accrual policy tier applicable to this employee for this leave type, typically based on tenure or job level (e.g., Tier 1: 0-2 years, Tier 2: 3-5 years, Tier 3: 6+ years). | Column policy_tier (STRING) in workforce.leave_balance']
  projected_year_end_balance decimal(10,2) [note: 'Forecasted leave balance at the end of the current accrual period, assuming no further usage. Used for liability planning and to alert employees of potential forfeitures. | Column projected_year_end_balance (DECIMAL(10,2)) in workforce.leave_balance']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.leave_balance']
  unit_of_measure varchar [note: 'Unit in which leave balance is tracked and reported: hours or days. Standardized per leave type and employee classification. | Column unit_of_measure (STRING) in workforce.leave_balance']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.leave_balance']
  updated_by varchar [note: 'User ID or system identifier of the person or process that last updated this leave balance record. Supports audit and compliance requirements. | Column updated_by (STRING) in workforce.leave_balance']
  updated_timestamp timestamp [note: 'Timestamp when this leave balance record was last modified. Updated each pay period or after leave transactions. Audit trail for record lifecycle. | Column updated_timestamp (TIMESTAMP) in workforce.leave_balance']
  used_current_period decimal(10,2) [note: 'Total leave hours or days used (taken) by the employee during the current period. Sourced from approved leave requests and time-tracking system. | Column used_current_period (DECIMAL(10,2)) in workforce.leave_balance']

  Note: 'Master record tracking the accrued and available leave balances for each employee across all leave types — vacation, sick, PTO, floating holiday, and comp time. Captures balance as of date, accrued hours/days in current period, used hours/days in current period, carried-over balance from prior year, forfeited balance, and adjusted balance. Updated each pay period by the payroll and time-tracking systems. Enables HR and managers to monitor leave liability and enforce accrual caps per Media Broadcasting policy. | Unity Catalog table: media_broadcasting_ecm.workforce.leave_balance'
}

Table workforce.timesheet {
  timesheet_id varchar [pk, note: 'Unique identifier for the timesheet record. Primary key. | Column timesheet_id (BIGINT) in workforce.timesheet']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Timesheets in broadcast operations track which channel/property work was performed for. Essential for cost allocation, project tracking, and channel P&L reporting. Standard practice in multi-channel b | Column channel_id (BIGINT) in scheduling.timesheet']
  corrected_timesheet_id varchar [note: 'Self-referencing FK on timesheet (corrected_timesheet_id) | Column corrected_timesheet_id (BIGINT) in workforce.timesheet']
  location_id varchar [note: 'Identifier of the primary work location or facility where the employee performed work during this timesheet period. Links to location master record. | Column location_id (BIGINT) in production.timesheet']
  org_unit_id varchar [note: 'Identifier of the department to which the employee belongs during this timesheet period. Links to department master record. | Column org_unit_id (BIGINT) in workforce.timesheet']
  primary_timesheet_approving_manager_employee_id varchar [note: 'Identifier of the manager or supervisor who approved or is responsible for approving this timesheet. Links to employee master record. | Column timesheet_approving_manager_employee_id (BIGINT) in workforce.timesheet']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: Crew timesheets reference specific program schedules they worked on (e.g., production crew for specific broadcast). Production cost tracking and labor accounting requires linking timesheets to program | Column program_schedule_id (BIGINT) in scheduling.timesheet']
  tertiary_timesheet_modified_by_user_employee_id varchar [note: 'User identifier of the person who last modified this timesheet record. Used for audit trail and accountability. | Column timesheet_modified_by_user_employee_id (BIGINT) in workforce.timesheet']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.timesheet']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.timesheet']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.timesheet']
  approval_date date [note: 'The date on which the timesheet was approved by the manager. Null if not yet approved. | Column approval_date (DATE) in workforce.timesheet']
  approval_status varchar [note: 'Current approval state of the timesheet in the workflow. Tracks progression from draft through submission, approval, or rejection. | Column approval_status (STRING) in workforce.timesheet']
  approval_timestamp timestamp [note: 'The precise date and time when the timesheet was approved, used for audit trail and SLA tracking. | Column approval_timestamp (TIMESTAMP) in workforce.timesheet']
  cost_center_code varchar [note: 'Cost center code to which the timesheet hours are allocated for financial reporting and departmental cost tracking. | Column cost_center_code (STRING) in workforce.timesheet']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.timesheet']
  created_timestamp timestamp [note: 'The date and time when this timesheet record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in workforce.timesheet']
  double_time_hours decimal(8,2) [note: 'Total number of double-time hours worked, typically compensated at 2x regular rate. Common for holiday work, excessive overtime, or seventh consecutive day worked per union agreements. | Column double_time_hours (DECIMAL(8,2)) in workforce.timesheet']
  holiday_hours decimal(8,2) [note: 'Total number of paid holiday hours included in this timesheet period for recognized company holidays. | Column holiday_hours (DECIMAL(8,2)) in workforce.timesheet']
  last_modified_timestamp timestamp [note: 'The date and time when this timesheet record was last modified. Used for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in workforce.timesheet']
  notes varchar [note: 'Free-text notes or comments added by the employee or manager regarding this timesheet, such as explanations for unusual hours or special circumstances. | Column notes (STRING) in workforce.timesheet']
  on_call_hours decimal(8,2) [note: 'Total number of on-call hours during the pay period. Relevant for broadcast engineers and technical staff required to be available for emergency playout or transmission issues. | Column on_call_hours (DECIMAL(8,2)) in workforce.timesheet']
  overtime_hours decimal(8,2) [note: 'Total number of overtime hours worked during the pay period, typically compensated at 1.5x regular rate. Critical for broadcast operations staff working irregular shifts and live event crews subject to union overtime rules. | Column overtime_hours (DECIMAL(8,2)) in workforce.timesheet']
  pay_grade varchar [note: 'Pay grade or salary band of the employee during this timesheet period. Used for compensation calculation and reporting. Business-confidential information. | Column pay_grade (STRING) in workforce.timesheet']
  pay_period_end_date date [note: 'The last date of the pay period covered by this timesheet. Defines the end of the time reporting window. | Column pay_period_end_date (DATE) in workforce.timesheet']
  pay_period_start_date date [note: 'The first date of the pay period covered by this timesheet. Defines the beginning of the time reporting window. | Column pay_period_start_date (DATE) in workforce.timesheet']
  payroll_processed_flag boolean [note: 'Indicates whether this timesheet has been processed by the payroll system. True if processed, False if pending. | Column payroll_processed_flag (BOOLEAN) in workforce.timesheet']
  project_code varchar [note: 'Project or production code to which the timesheet hours are allocated. Used for cost tracking and project accounting in content production and live event operations. | Column project_code (STRING) in workforce.timesheet']
  pto_hours decimal(8,2) [note: 'Total number of paid time off hours included in this timesheet period, including vacation, sick leave, and personal days. | Column pto_hours (DECIMAL(8,2)) in workforce.timesheet']
  regular_hours decimal(8,2) [note: 'Total number of regular working hours recorded in this timesheet, excluding overtime, double-time, or premium hours. Basis for standard compensation calculation. | Column regular_hours (DECIMAL(8,2)) in workforce.timesheet']
  rejection_reason varchar [note: 'Detailed explanation provided by the approving manager if the timesheet was rejected. Null if timesheet was not rejected. | Column rejection_reason (STRING) in workforce.timesheet']
  shift_differential_hours decimal(8,2) [note: 'Total number of hours worked during shifts eligible for differential pay (e.g., night shift, weekend shift). Common in 24/7 broadcast operations. | Column shift_differential_hours (DECIMAL(8,2)) in workforce.timesheet']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.timesheet']
  submission_date date [note: 'The date on which the employee submitted the timesheet for approval. Critical for tracking compliance with submission deadlines. | Column submission_date (DATE) in workforce.timesheet']
  submission_timestamp timestamp [note: 'The precise date and time when the timesheet was submitted by the employee, used for audit trail and compliance verification. | Column submission_timestamp (TIMESTAMP) in workforce.timesheet']
  timesheet_number varchar [note: 'Human-readable business identifier for the timesheet, typically formatted as TS-YYYYMMDD or similar pattern for external reference and reporting. | Column timesheet_number (STRING) in workforce.timesheet']
  total_hours_approved decimal(8,2) [note: 'Total number of hours approved by the manager for payroll processing. May differ from submitted hours if adjustments were made during approval. | Column total_hours_approved (DECIMAL(8,2)) in workforce.timesheet']
  total_hours_submitted decimal(8,2) [note: 'Total number of hours submitted by the employee across all categories (regular, overtime, double-time, on-call, shift differential, PTO, holiday, unpaid leave). Sum of all hour types. | Column total_hours_submitted (DECIMAL(8,2)) in workforce.timesheet']
  union_code varchar [note: 'Code identifying the labor union to which the employee belongs, if applicable. Critical for applying correct overtime rules, shift differentials, and residual calculations per union collective bargaining agreements. | Column union_code (STRING) in workforce.timesheet']
  unpaid_leave_hours decimal(8,2) [note: 'Total number of unpaid leave hours recorded in this timesheet period, such as unpaid personal leave or leave without pay. | Column unpaid_leave_hours (DECIMAL(8,2)) in workforce.timesheet']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.timesheet']
  work_order_number varchar [note: 'Work order number associated with the timesheet, used for tracking time against specific maintenance, production, or operational tasks. | Column work_order_number (STRING) in workforce.timesheet']

  Note: 'Transactional record of an employee\'s time worked for a specific pay period — capturing regular hours, overtime hours, double-time hours, on-call hours, and shift differential hours by day. Includes timesheet period start/end, submission date, approval status, approving manager, total hours submitted, total hours approved, project/cost center allocation codes, and any time-off hours included. Critical for broadcast operations staff working irregular shifts, live event crews, and production personnel subject to union overtime rules. | Unity Catalog table: media_broadcasting_ecm.workforce.timesheet'
}

Table workforce.work_schedule {
  work_schedule_id varchar [pk, note: 'Unique identifier for the work schedule pattern. Primary key. | Column work_schedule_id (BIGINT) in workforce.work_schedule']
  base_work_schedule_id varchar [note: 'Self-referencing FK on work_schedule (base_work_schedule_id) | Column base_work_schedule_id (BIGINT) in workforce.work_schedule']
  primary_daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Broadcast work schedules align with dayparts (morning shift covers morning daypart, prime time shift covers prime daypart). 24/7 operations shift planning requires mapping work schedules to broadcast  | Column primary_daypart_id (BIGINT) in scheduling.work_schedule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.work_schedule']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.work_schedule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.work_schedule']
  applicable_job_families varchar [note: 'Comma-separated list of job families or roles this schedule is designed for (e.g., Broadcast Engineer, Playout Operator, Master Control Technician, Production Staff, Administrative). Supports role-based schedule assignment. | Column applicable_job_families (STRING) in workforce.work_schedule']
  applicable_org_units varchar [note: 'Comma-separated list of organizational unit codes or names where this schedule is used (e.g., Broadcast Operations, Playout Engineering, News Production, Corporate Office). Enables filtering schedules by department or division. | Column applicable_org_units (STRING) in workforce.work_schedule']
  break_duration_minutes varchar [note: 'Total duration of unpaid breaks during the shift, measured in minutes (e.g., 30 for half-hour lunch, 60 for one-hour lunch). Used to calculate net working hours and compliance with labor regulations. | Column break_duration_minutes (INT) in workforce.work_schedule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.work_schedule']
  created_by_user varchar [note: 'Username or employee identifier of the person who created this work schedule record. Supports accountability and audit requirements. | Column created_by_user (STRING) in workforce.work_schedule']
  created_timestamp timestamp [note: 'Timestamp when this work schedule record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in workforce.work_schedule']
  daypart_classification varchar [note: 'Broadcast industry daypart classification for the schedule: morning (6-9 AM), daytime (9 AM-4 PM), early_fringe (4-7 PM), prime_access (7-8 PM), prime_time (8-11 PM), late_fringe (11 PM-1 AM), overnight (1-6 AM). Aligns shift schedules with programming and advertising dayparts. [ENUM-REF-CANDIDATE: morning|daytime|early_fringe|prime_access|prime_time|late_fringe|overnight — 7 candidates stripped; promote to reference product] | Column daypart_classification (STRING) in workforce.work_schedule']
  days_of_week varchar [note: 'Comma-separated list of days this schedule applies to (e.g., Mon,Tue,Wed,Thu,Fri for standard office; Mon,Tue,Wed,Thu for compressed week; Sat,Sun for weekend shift). Supports broadcast operations requiring 24/7 coverage. | Column days_of_week (STRING) in workforce.work_schedule']
  effective_end_date date [note: 'Date when this work schedule pattern is no longer active. Null for currently active schedules. Used to retire outdated schedules while preserving historical assignments. | Column effective_end_date (DATE) in workforce.work_schedule']
  effective_start_date date [note: 'Date when this work schedule pattern becomes active and available for employee assignment. Supports versioning and historical tracking of schedule changes. | Column effective_start_date (DATE) in workforce.work_schedule']
  flsa_classification varchar [note: 'FLSA classification for employees on this schedule: exempt (salaried, not eligible for overtime) or non_exempt (hourly, eligible for overtime). Determines overtime calculation and minimum wage requirements. | Column flsa_classification (STRING) in workforce.work_schedule']
  holiday_work_required boolean [note: 'Indicates whether employees on this schedule are expected to work on company-recognized holidays. True for essential broadcast operations (playout, master control), false for administrative roles. | Column holiday_work_required (BOOLEAN) in workforce.work_schedule']
  last_modified_by_user varchar [note: 'Username or employee identifier of the person who last modified this work schedule record. Supports accountability and audit requirements. | Column last_modified_by_user (STRING) in workforce.work_schedule']
  last_modified_timestamp timestamp [note: 'Timestamp when this work schedule record was last updated. Used for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in workforce.work_schedule']
  meal_break_required boolean [note: 'Indicates whether a meal break is legally or contractually required for this schedule. True for shifts exceeding a certain duration (typically 6+ hours), false for shorter shifts. Ensures compliance with labor regulations. | Column meal_break_required (BOOLEAN) in workforce.work_schedule']
  on_call_frequency varchar [note: 'Frequency of on-call duty for schedules that include on-call rotation: none (no on-call), weekly (one week per rotation), biweekly (one week every two weeks), monthly (one week per month), as_needed (ad-hoc). Relevant for broadcast engineering and technical support roles. | Column on_call_frequency (STRING) in workforce.work_schedule']
  on_call_response_time_minutes varchar [note: 'Maximum time in minutes an on-call employee must respond to a call-out (e.g., 30 for 30-minute response, 60 for one-hour response). Null for schedules without on-call duty. Critical for broadcast continuity and Service Level Agreement (SLA) compliance. | Column on_call_response_time_minutes (INT) in workforce.work_schedule']
  overtime_calculation_basis varchar [note: 'Basis for calculating overtime: daily (hours beyond threshold in a single day), weekly (hours beyond threshold in a work week), biweekly (hours beyond threshold in a two-week pay period). Determines when premium pay rates apply. | Column overtime_calculation_basis (STRING) in workforce.work_schedule']
  overtime_threshold_hours decimal(5,2) [note: 'Number of hours per day or week after which overtime compensation applies for employees on this schedule. Typically 8 hours per day or 40 hours per week under FLSA; may vary by jurisdiction and collective bargaining agreements. | Column overtime_threshold_hours (DECIMAL(5,2)) in workforce.work_schedule']
  paid_break_duration_minutes varchar [note: 'Total duration of paid breaks during the shift, measured in minutes (e.g., 15 for two 15-minute breaks). Separate from unpaid meal breaks; included in compensable time. | Column paid_break_duration_minutes (INT) in workforce.work_schedule']
  requires_broadcast_license boolean [note: 'Indicates whether employees assigned to this schedule must hold a valid broadcast engineering or operator license (e.g., FCC General Radiotelephone Operator License). True for technical playout and transmission roles, false for administrative and production roles. | Column requires_broadcast_license (BOOLEAN) in workforce.work_schedule']
  rest_period_between_shifts_hours decimal(5,2) [note: 'Minimum number of hours required between the end of one shift and the start of the next for employees on this schedule (e.g., 8 for eight-hour rest, 11 for eleven-hour rest). Ensures compliance with labor regulations and employee well-being, especially for rotating broadcast shifts. | Column rest_period_between_shifts_hours (DECIMAL(5,2)) in workforce.work_schedule']
  rotation_cycle_days varchar [note: 'Number of days in the rotation cycle for rotating shift schedules (e.g., 7 for weekly rotation, 14 for bi-weekly, 28 for four-week cycle). Null for fixed schedules. Broadcast operations often use 7, 14, or 21-day cycles to ensure equitable distribution of overnight and weekend shifts. | Column rotation_cycle_days (INT) in workforce.work_schedule']
  schedule_code varchar [note: 'Short alphanumeric code uniquely identifying the schedule pattern (e.g., STD-9TO5, SHIFT-AM, SHIFT-PM, ONCALL-ROT). Used for quick reference in HR systems and employee assignments. | Column schedule_code (STRING) in workforce.work_schedule']
  schedule_description varchar [note: 'Detailed description of the work schedule pattern, including any special conditions, rotation details, or operational notes (e.g., \'Four 10-hour shifts Monday-Thursday with Friday off; on-call rotation every fourth week; requires FCC license\'). | Column schedule_description (STRING) in workforce.work_schedule']
  schedule_name varchar [note: 'Human-readable name of the work schedule pattern (e.g., Standard Office Hours, Morning Broadcast Shift, Evening Playout Shift, On-Call Rotation, Compressed Work Week). | Column schedule_name (STRING) in workforce.work_schedule']
  schedule_status varchar [note: 'Current lifecycle status of the work schedule. Active schedules are available for employee assignment; inactive schedules are no longer used; draft schedules are under review; deprecated schedules are phased out but retained for historical reference. | Column schedule_status (STRING) in workforce.work_schedule']
  schedule_type varchar [note: 'Classification of the schedule pattern: fixed (consistent daily hours), rotating (shifts that change on a cycle), on_call (availability-based), compressed (longer days, fewer days per week), flexible (variable start/end within boundaries), split_shift (two separate work periods in one day). | Column schedule_type (STRING) in workforce.work_schedule']
  shift_differential_eligible boolean [note: 'Indicates whether employees on this schedule are eligible for shift differential pay (premium compensation for evening, night, or weekend shifts). True for overnight broadcast shifts, false for standard daytime office schedules. | Column shift_differential_eligible (BOOLEAN) in workforce.work_schedule']
  shift_differential_rate decimal(5,2) [note: 'Percentage or flat amount of additional compensation for shift differential, if applicable (e.g., 10 for 10% premium, 2.50 for $2.50/hour premium). Null if shift_differential_eligible is false. | Column shift_differential_rate (DECIMAL(5,2)) in workforce.work_schedule']
  shift_end_time timestamp [note: 'Standard end time for the work shift in HH:MM 24-hour format (e.g., 17:00 for 5 PM, 06:00 for 6 AM next day). For rotating or flexible schedules, this represents the primary or latest end time. | Column shift_end_time (TIMESTAMP) in workforce.work_schedule']
  shift_start_time timestamp [note: 'Standard start time for the work shift in HH:MM 24-hour format (e.g., 09:00 for 9 AM, 22:00 for 10 PM). For rotating or flexible schedules, this represents the primary or earliest start time. | Column shift_start_time (TIMESTAMP) in workforce.work_schedule']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.work_schedule']
  time_zone varchar [note: 'IANA time zone identifier for the schedule (e.g., America/New_York, America/Los_Angeles, Europe/London). Critical for broadcast operations spanning multiple time zones to ensure accurate shift timing and playout coordination. | Column time_zone (STRING) in workforce.work_schedule']
  total_weekly_hours decimal(5,2) [note: 'Total number of hours per week defined by this schedule pattern. Standard full-time is typically 40 hours; broadcast operations may have 37.5, 40, or 42 hours depending on shift structure and break policies. | Column total_weekly_hours (DECIMAL(5,2)) in workforce.work_schedule']
  union_code varchar [note: 'Code identifying the labor union or collective bargaining unit whose agreement governs this schedule (e.g., IBEW for International Brotherhood of Electrical Workers, NABET-CWA for National Association of Broadcast Employees and Technicians). Null for non-union schedules. | Column union_code (STRING) in workforce.work_schedule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.work_schedule']
  weekend_work_required boolean [note: 'Indicates whether this schedule includes regular weekend work (Saturday and/or Sunday). True for broadcast operations requiring 24/7 coverage, false for standard Monday-Friday office schedules. | Column weekend_work_required (BOOLEAN) in workforce.work_schedule']

  Note: 'Reference master defining the standard work schedule patterns used across Media Broadcasting — 9-to-5 office, rotating broadcast shift (AM/PM/overnight), live event schedule, on-call rotation, and compressed work week. Captures schedule code, schedule name, schedule type, total weekly hours, shift start time, shift end time, days of week, break duration, overtime threshold, and applicable org units. Broadcast operations require 24/7 shift coverage — this entity governs shift pattern assignments for all operational staff. | Unity Catalog table: media_broadcasting_ecm.workforce.work_schedule'
}

Table workforce.performance_review {
  performance_review_id varchar [pk, note: 'Unique identifier for the performance review record. Primary key for the performance review entity. | Column performance_review_id (BIGINT) in workforce.performance_review']
  approver_employee_id varchar [note: 'Identifier of the senior manager or HR leader who provided final approval of the performance review. | Column approver_employee_id (BIGINT) in workforce.performance_review']
  previous_performance_review_id varchar [note: 'Self-referencing FK on performance_review (previous_performance_review_id) | Column previous_performance_review_id (BIGINT) in workforce.performance_review']
  primary_performance_employee_id varchar [note: 'Identifier of the employee being reviewed. Links to the employee master record in the workforce domain. | Column primary_performance_employee_id (BIGINT) in workforce.performance_review']
  reviewer_employee_id varchar [note: 'Identifier of the employee conducting the review, typically the direct manager or supervisor. | Column reviewer_employee_id (BIGINT) in workforce.performance_review']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.performance_review']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.performance_review']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.performance_review']
  approval_date date [note: 'The date on which the performance review received final approval and became official. | Column approval_date (DATE) in workforce.performance_review']
  calibration_date date [note: 'The date on which the performance review rating was calibrated through management review session. | Column calibration_date (DATE) in workforce.performance_review']
  calibration_status varchar [note: 'Status indicating whether the review has undergone calibration process to ensure rating consistency across the organization. Calibration involves peer review of ratings by management. | Column calibration_status (STRING) in workforce.performance_review']
  collaboration_rating decimal(3,2) [note: 'Competency rating for teamwork, communication, and cross-functional collaboration on a 1-5 scale. | Column collaboration_rating (DECIMAL(3,2)) in workforce.performance_review']
  compensation_adjustment_recommended_flag boolean [note: 'Boolean indicator of whether a compensation adjustment (salary increase, bonus) is recommended based on this performance review. | Column compensation_adjustment_recommended_flag (BOOLEAN) in workforce.performance_review']
  completed_timestamp timestamp [note: 'The timestamp when the performance review was marked as completed, indicating all required steps including approval and acknowledgement are finished. | Column completed_timestamp (TIMESTAMP) in workforce.performance_review']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.performance_review']
  created_timestamp timestamp [note: 'The timestamp when the performance review record was first created in the system. | Column created_timestamp (TIMESTAMP) in workforce.performance_review']
  development_plan_required_flag boolean [note: 'Boolean indicator of whether a formal performance improvement or development plan is required as an outcome of this review. | Column development_plan_required_flag (BOOLEAN) in workforce.performance_review']
  dispute_comments varchar [note: 'Narrative explanation provided by the employee if they dispute the performance review rating or feedback. | Column dispute_comments (STRING) in workforce.performance_review']
  employee_acknowledgement_flag boolean [note: 'Boolean indicator of whether the employee has acknowledged the performance review. Required for review completion. | Column employee_acknowledgement_flag (BOOLEAN) in workforce.performance_review']
  employee_comments varchar [note: 'Narrative comments and self-reflection provided by the employee as part of their self-assessment in the performance review. | Column employee_comments (STRING) in workforce.performance_review']
  employee_dispute_flag boolean [note: 'Boolean indicator of whether the employee has formally disputed the performance review rating or feedback. | Column employee_dispute_flag (BOOLEAN) in workforce.performance_review']
  employee_self_assessment_score decimal(3,2) [note: 'The self-rating provided by the employee on a 1-5 scale as part of the performance review process. Captures employee\'s own perception of their performance. | Column employee_self_assessment_score (DECIMAL(3,2)) in workforce.performance_review']
  final_approved_rating decimal(3,2) [note: 'The final overall performance rating after calibration and approval by senior management. This is the official rating used for compensation and promotion decisions. | Column final_approved_rating (DECIMAL(3,2)) in workforce.performance_review']
  goal_achievement_score decimal(5,2) [note: 'Percentage score representing the degree to which the employee achieved their performance goals during the review period. Calculated as weighted average of individual goal completion rates. | Column goal_achievement_score (DECIMAL(5,2)) in workforce.performance_review']
  innovation_rating decimal(3,2) [note: 'Competency rating for creativity, problem-solving, and innovative thinking on a 1-5 scale. | Column innovation_rating (DECIMAL(3,2)) in workforce.performance_review']
  last_modified_timestamp timestamp [note: 'The timestamp when the performance review record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in workforce.performance_review']
  leadership_rating decimal(3,2) [note: 'Competency rating for leadership capabilities, people management, and influence on a 1-5 scale. Applicable to employees in leadership roles or demonstrating leadership potential. | Column leadership_rating (DECIMAL(3,2)) in workforce.performance_review']
  overall_rating decimal(3,2) [note: 'The overall performance rating assigned to the employee on a 1-5 scale, where 1 is unsatisfactory and 5 is exceptional. May include decimal precision for nuanced scoring. | Column overall_rating (DECIMAL(3,2)) in workforce.performance_review']
  pre_calibration_rating decimal(3,2) [note: 'The initial overall rating assigned by the reviewer before the calibration process. Retained for audit trail and calibration impact analysis. | Column pre_calibration_rating (DECIMAL(3,2)) in workforce.performance_review']
  promotion_eligible_flag boolean [note: 'Boolean indicator of whether the employee is eligible for promotion consideration based on this performance review outcome. | Column promotion_eligible_flag (BOOLEAN) in workforce.performance_review']
  recommended_compensation_adjustment_percent decimal(5,2) [note: 'The recommended percentage increase in base compensation resulting from this performance review. Used to inform compensation planning decisions. | Column recommended_compensation_adjustment_percent (DECIMAL(5,2)) in workforce.performance_review']
  review_acknowledgement_date date [note: 'The date on which the employee formally acknowledged receipt and review of their performance evaluation. | Column review_acknowledgement_date (DATE) in workforce.performance_review']
  review_date date [note: 'The date on which the formal performance review discussion was conducted between reviewer and employee. | Column review_date (DATE) in workforce.performance_review']
  review_period_end_date date [note: 'The end date of the performance period being evaluated in this review. | Column review_period_end_date (DATE) in workforce.performance_review']
  review_period_start_date date [note: 'The start date of the performance period being evaluated in this review. | Column review_period_start_date (DATE) in workforce.performance_review']
  review_status varchar [note: 'Current lifecycle status of the performance review. Tracks progression from draft through calibration to final approval. [ENUM-REF-CANDIDATE: draft|submitted|in_calibration|calibrated|approved|completed|cancelled — 7 candidates stripped; promote to reference product] | Column review_status (STRING) in workforce.performance_review']
  review_type varchar [note: 'The type or category of performance review being conducted. Determines the review cycle and evaluation criteria applied. | Column review_type (STRING) in workforce.performance_review']
  reviewer_comments varchar [note: 'Detailed narrative feedback provided by the reviewer regarding the employee\'s performance, strengths, areas for improvement, and development recommendations. | Column reviewer_comments (STRING) in workforce.performance_review']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.performance_review']
  succession_planning_flag boolean [note: 'Boolean indicator of whether the employee should be included in succession planning discussions based on this performance review outcome. | Column succession_planning_flag (BOOLEAN) in workforce.performance_review']
  technical_skills_rating decimal(3,2) [note: 'Competency rating for technical skills and job-specific expertise on a 1-5 scale. Evaluates proficiency in role-required technical capabilities. | Column technical_skills_rating (DECIMAL(3,2)) in workforce.performance_review']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.performance_review']

  Note: 'Transactional record of each formal employee performance evaluation conducted at Media Broadcasting — annual reviews, mid-year check-ins, probationary reviews, and project-based assessments. Captures review period, review type, overall rating (1-5 scale), competency ratings by dimension (technical skills, collaboration, innovation, leadership), goal achievement score, reviewer comments, employee self-assessment score, calibration status, and final approved rating. Feeds compensation adjustment decisions, promotion eligibility, and succession planning. | Unity Catalog table: media_broadcasting_ecm.workforce.performance_review'
}

Table workforce.goal {
  goal_id varchar [pk, note: 'Unique identifier for the employee performance goal record. Primary key. | Column goal_id (BIGINT) in workforce.goal']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Employee goals in broadcasting are often tied to specific channel performance (ratings targets, revenue goals, audience growth). Performance management workflow requires linking goals to channels for  | Column channel_id (BIGINT) in scheduling.goal']
  org_unit_id varchar [note: 'Reference to the department or organizational unit to which this goal is aligned. Supports departmental goal rollup and reporting. Links to the department master record. | Column org_unit_id (BIGINT) in workforce.goal']
  parent_goal_id varchar [note: 'Self-referencing FK on goal (parent_goal_id) | Column parent_goal_id (BIGINT) in workforce.goal']
  primary_goal_employee_id varchar [note: 'Reference to the employee to whom this goal is assigned. Links to the employee master record in the workforce domain. | Column goal_employee_id (BIGINT) in workforce.goal']
  review_cycle_id varchar [note: 'Reference to the performance review cycle or period to which this goal belongs (e.g., 2024 Annual Review, Q2 2024 Quarterly Review). Links to the review cycle master record. | Column review_cycle_id (BIGINT) in billing.goal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.goal']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.goal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.goal']
  achievement_percentage decimal(5,2) [note: 'Calculated percentage of goal completion based on current value relative to target value. Values over 100% indicate the goal was exceeded. Used for performance scoring and reporting. | Column achievement_percentage (DECIMAL(5,2)) in workforce.goal']
  approval_status varchar [note: 'Workflow status of goal approval. Draft: being created by employee; pending approval: submitted to manager; approved: accepted by manager; rejected: not accepted; revision requested: manager requested changes before approval. | Column approval_status (STRING) in workforce.goal']
  approved_date date [note: 'Date when the manager approved this goal. Null if the goal has not yet been approved. | Column approved_date (DATE) in workforce.goal']
  baseline_value decimal(18,4) [note: 'Starting or current value of the metric at the time the goal was set. Provides context for measuring progress and improvement (e.g., current audience reach before the goal period). | Column baseline_value (DECIMAL(18,4)) in workforce.goal']
  completion_date date [note: 'Actual date when the goal was marked as completed or achieved. Null if the goal is still in progress or not yet achieved. | Column completion_date (DATE) in workforce.goal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.goal']
  created_timestamp timestamp [note: 'Date and time when this goal record was first created in the system. Supports audit trail and goal lifecycle tracking. | Column created_timestamp (TIMESTAMP) in workforce.goal']
  current_value decimal(18,4) [note: 'Most recent measured value of the target metric, reflecting progress toward the goal. Updated periodically as performance data becomes available. | Column current_value (DECIMAL(18,4)) in workforce.goal']
  due_date date [note: 'Target completion date by which the goal should be achieved. Used to assess timeliness of goal attainment and plan performance reviews. | Column due_date (DATE) in workforce.goal']
  employee_notes varchar [note: 'Free-text notes from the employee documenting progress, challenges encountered, resources needed, or self-assessment. Supports employee self-reflection and two-way performance dialogue. | Column employee_notes (STRING) in workforce.goal']
  goal_category varchar [note: 'Classification of the goal scope and level. Individual goals are personal performance targets; team goals are shared across a work group; organizational goals cascade from company-wide objectives; departmental goals align with division priorities; project goals are tied to specific initiatives; strategic goals support long-term business strategy. | Column goal_category (STRING) in workforce.goal']
  goal_description varchar [note: 'Detailed narrative description of the goal, including context, expected outcomes, and success criteria. Provides comprehensive understanding of what the employee is expected to achieve. | Column goal_description (STRING) in workforce.goal']
  goal_type varchar [note: 'Nature of the goal measurement. Quantitative goals have numeric targets (e.g., revenue, ratings); qualitative goals are assessed subjectively (e.g., leadership quality); behavioral goals focus on conduct and values; developmental goals target skill acquisition; operational goals improve processes; strategic goals advance long-term positioning. | Column goal_type (STRING) in workforce.goal']
  is_mandatory boolean [note: 'Indicates whether this goal is mandatory (required for all employees in a role or department) or optional (individually selected). Mandatory goals often relate to compliance, training, or core job functions. | Column is_mandatory (BOOLEAN) in workforce.goal']
  is_stretch_goal boolean [note: 'Indicates whether this is a stretch goal (aspirational target beyond normal expectations). Stretch goals are typically weighted differently in performance evaluations and partial achievement is often considered successful. | Column is_stretch_goal (BOOLEAN) in workforce.goal']
  last_review_date date [note: 'Date of the most recent progress review or check-in for this goal. Used to track regular monitoring and feedback cadence. | Column last_review_date (DATE) in workforce.goal']
  last_updated_timestamp timestamp [note: 'Date and time when this goal record was most recently modified. Tracks the currency of goal data and supports change auditing. | Column last_updated_timestamp (TIMESTAMP) in workforce.goal']
  manager_notes varchar [note: 'Free-text notes and feedback from the manager regarding goal progress, challenges, support provided, or observations. Used for coaching and performance documentation. | Column manager_notes (STRING) in workforce.goal']
  measurement_unit varchar [note: 'Unit of measure for the target value (e.g., \'percent\', \'viewers\', \'hours\', \'episodes\', \'dollars\', \'rating points\'). Clarifies how the numeric target should be interpreted. | Column measurement_unit (STRING) in workforce.goal']
  next_review_date date [note: 'Scheduled date for the next progress review or check-in. Supports proactive performance management and ensures regular goal monitoring. | Column next_review_date (DATE) in workforce.goal']
  okr_alignment varchar [note: 'Reference to the company-level or department-level OKR (Objectives and Key Results) that this goal supports. Ensures goal alignment with organizational strategy. May reference specific objective identifiers or descriptive text. | Column okr_alignment (STRING) in workforce.goal']
  priority_level varchar [note: 'Business priority assigned to this goal. Critical goals are essential to business success; high priority goals are important but not mission-critical; medium priority goals are standard objectives; low priority goals are developmental or stretch targets. | Column priority_level (STRING) in workforce.goal']
  progress_status varchar [note: 'Current state of goal progress. Not started: work has not begun; in progress: actively being worked on; on track: progressing as expected; at risk: may not meet target; behind: falling short of milestones; completed: target achieved; exceeded: surpassed target; cancelled: goal no longer applicable. [ENUM-REF-CANDIDATE: not_started|in_progress|on_track|at_risk|behind|completed|exceeded|cancelled — 8 candidates stripped; promote to reference product] | Column progress_status (STRING) in workforce.goal']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.goal']
  start_date date [note: 'Date when the goal period begins and the employee starts working toward the objective. Marks the beginning of the performance measurement window. | Column start_date (DATE) in workforce.goal']
  target_metric varchar [note: 'The specific measurable indicator or key performance indicator (KPI) used to assess goal achievement (e.g., \'Audience Reach\', \'Content Production Volume\', \'System Uptime Percentage\', \'Training Completion Rate\'). | Column target_metric (STRING) in workforce.goal']
  target_value decimal(18,4) [note: 'Numeric target value that defines success for the goal. Used in conjunction with measurement_unit to specify the quantitative objective (e.g., 15.0 for 15% increase, 1000000 for one million viewers). | Column target_value (DECIMAL(18,4)) in workforce.goal']
  title varchar [note: 'Short, descriptive title of the performance goal (e.g., \'Increase Audience Reach by 15%\', \'Complete Digital Asset Migration\'). | Column title (STRING) in workforce.goal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.goal']
  visibility_level varchar [note: 'Defines who can view this goal. Private: only employee and manager; manager: visible to management chain; department: visible to department members; organization: visible company-wide; public: visible to external stakeholders. | Column visibility_level (STRING) in workforce.goal']
  weight_percentage decimal(5,2) [note: 'Relative importance or weight of this goal within the employees overall performance review, expressed as a percentage (e.g., 25.00 means this goal represents 25% of the total performance score). All goals for an employee typically sum to 100%. | Column weight_percentage (DECIMAL(5,2)) in workforce.goal']

  Note: 'Master record for individual employee performance goals and objectives set within Media Broadcasting\'s performance management cycle. Captures goal title, goal description, goal category (individual/team/organizational), alignment to company OKR, target metric, target value, measurement unit, due date, weight percentage within review, progress status, and last updated date. Supports MBO (Management by Objectives) and OKR frameworks used across broadcast operations, content, technology, and corporate functions. | Unity Catalog table: media_broadcasting_ecm.workforce.goal'
}

Table workforce.training_course {
  training_course_id varchar [pk, note: 'Unique identifier for the training course. Primary key. | Column training_course_id (BIGINT) in workforce.training_course']
  applicable_daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Training courses for broadcast operations may be daypart-specific (e.g., "Prime Time Programming Strategy", "Morning Show Production Techniques"). Specialized training curriculum design requires linki | Column applicable_daypart_id (BIGINT) in scheduling.training_course']
  prerequisite_training_course_id varchar [note: 'Self-referencing FK on training_course (prerequisite_training_course_id) | Column prerequisite_training_course_id (BIGINT) in workforce.training_course']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.training_course']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.training_course']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.training_course']
  accreditation_body varchar [note: 'Name of the external accreditation or certification body that has approved or accredited this training course (e.g., Society of Cable Telecommunications Engineers, Federal Communications Commission, Project Management Institute). Null if not externally accredited. | Column accreditation_body (STRING) in workforce.training_course']
  certification_awarded varchar [note: 'Name of the certification, credential, or certificate of completion awarded upon successful course completion (e.g., FCC Broadcast Operator License, SCTE Broadband Transportation Specialist, Media Broadcasting Editorial Standards Certificate). Null if no formal certification is awarded. | Column certification_awarded (STRING) in workforce.training_course']
  continuing_education_credits decimal(5,2) [note: 'Number of continuing education units (CEUs) or professional development hours (PDHs) awarded upon course completion, recognized by industry associations or regulatory bodies. Null if no formal credits are awarded. | Column continuing_education_credits (DECIMAL(5,2)) in workforce.training_course']
  cost_per_participant decimal(10,2) [note: 'Standard cost charged per participant for enrollment in the training course, in USD. Includes tuition, materials, and vendor fees. Used for training budget planning and cost allocation. Null if the course is provided at no charge. | Column cost_per_participant (DECIMAL(10,2)) in workforce.training_course']
  course_code varchar [note: 'Unique alphanumeric code assigned to the training course for catalog and registration purposes (e.g., BC-101, FCC-REG-2023, EEO-COMP). | Column course_code (STRING) in workforce.training_course']
  course_description varchar [note: 'Comprehensive narrative description of the training course content, topics covered, instructional approach, and target audience. Used in the learning catalog and course registration materials. | Column course_description (STRING) in workforce.training_course']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.training_course']
  created_timestamp timestamp [note: 'Date and time when the training course record was first created in the learning management system. | Column created_timestamp (TIMESTAMP) in workforce.training_course']
  delivery_method varchar [note: 'Mode of instruction for the training course: instructor-led (in-person classroom), e-learning (self-paced online), blended (combination of online and in-person), virtual classroom (live online), or on-the-job (hands-on mentoring). | Column delivery_method (STRING) in workforce.training_course']
  duration_hours decimal(5,2) [note: 'Total instructional time required to complete the training course, measured in hours (e.g., 2.5 hours for a half-day workshop, 40 hours for a week-long certification program). | Column duration_hours (DECIMAL(5,2)) in workforce.training_course']
  effective_date date [note: 'Date on which the training course became or will become available for enrollment and delivery. Represents the start of the courses active lifecycle. | Column effective_date (DATE) in workforce.training_course']
  expiration_date date [note: 'Date on which the training course will be retired or is no longer available for enrollment. Null if the course has no planned end date. | Column expiration_date (DATE) in workforce.training_course']
  language varchar [note: 'Primary language in which the training course is delivered, using ISO 639-2 three-letter language codes (e.g., ENG for English, SPA for Spanish, FRA for French). | Column language (STRING) in workforce.training_course']
  last_review_date date [note: 'Date on which the training course content was last reviewed and validated for accuracy, relevance, and regulatory compliance. Used to track currency of course materials. | Column last_review_date (DATE) in workforce.training_course']
  learning_objectives varchar [note: 'Detailed description of the knowledge, skills, and competencies that participants will acquire upon successful completion of the training course. Defines the expected learning outcomes. | Column learning_objectives (STRING) in workforce.training_course']
  mandatory_flag boolean [note: 'Indicates whether the training course is mandatory for specific job roles or all employees (True) or optional/elective (False). Mandatory courses are typically driven by regulatory requirements (FCC, EEO, COPPA) or critical operational competencies. | Column mandatory_flag (BOOLEAN) in workforce.training_course']
  max_enrollment varchar [note: 'Maximum number of participants that can be enrolled in a single offering or session of the training course. Null if there is no enrollment cap (e.g., for self-paced e-learning courses). | Column max_enrollment (INT) in workforce.training_course']
  modified_timestamp timestamp [note: 'Date and time when the training course record was last updated or modified in the learning management system. | Column modified_timestamp (TIMESTAMP) in workforce.training_course']
  next_review_date date [note: 'Scheduled date for the next periodic review and update of the training course content. Ensures courses remain current with regulatory changes, technology updates, and business process evolution. | Column next_review_date (DATE) in workforce.training_course']
  prerequisites varchar [note: 'Description of prerequisite courses, certifications, or experience required before an employee can enroll in this training course (e.g., Must complete BC-100 Introduction to Broadcasting, Requires 6 months experience in playout operations). Null if no prerequisites. | Column prerequisites (STRING) in workforce.training_course']
  provider_name varchar [note: 'Name of the organization or entity that developed or delivers the training course (e.g., Media Broadcasting Learning & Development, Dalet Academy, Society of Cable Telecommunications Engineers). | Column provider_name (STRING) in workforce.training_course']
  provider_type varchar [note: 'Source of the training course: internal (developed and delivered by Media Broadcasting HR/L&D), external (third-party training vendor), vendor (system vendor training such as Dalet or Ericsson), industry association (MPA, ATSC, SCTE), or regulatory body (FCC-mandated training). | Column provider_type (STRING) in workforce.training_course']
  recertification_period_months varchar [note: 'Number of months after which the certification or training must be renewed or retaken to maintain compliance or currency (e.g., 12 months for annual cybersecurity awareness, 36 months for FCC regulatory training). Null if no recertification is required. | Column recertification_period_months (INT) in workforce.training_course']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.training_course']
  title varchar [note: 'Full descriptive title of the training course as displayed in the learning catalog and on certificates. | Column title (STRING) in workforce.training_course']
  training_course_category varchar [note: 'Primary classification of the training course by subject area: broadcast operations (playout, scheduling, transmission), regulatory compliance (FCC, EEO, COPPA), technical skills (MAM, CDN, encoding), leadership development, cybersecurity awareness, or editorial standards. | Column training_course_category (STRING) in workforce.training_course']
  training_course_status varchar [note: 'Current lifecycle status of the training course: active (available for enrollment), inactive (temporarily unavailable), under development (being created or updated), retired (permanently discontinued), or suspended (on hold pending review or update). | Column training_course_status (STRING) in workforce.training_course']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.training_course']
  version varchar [note: 'Version number of the training course content, incremented with each major or minor revision (e.g., 1.0, 1.1, 2.0). Tracks course evolution and ensures participants complete the current version. | Column version (STRING) in workforce.training_course']

  Note: 'Reference catalog of all training courses and learning programs available to Media Broadcasting employees — broadcast operations certifications, FCC regulatory training, EEO compliance training, editorial standards, cybersecurity awareness, leadership development, and technical skills programs. Captures course code, course title, course category, delivery method (instructor-led/e-learning/blended), duration hours, provider (internal/external), certification awarded, recertification period, mandatory flag, and applicable job profiles. | Unity Catalog table: media_broadcasting_ecm.workforce.training_course'
}

Table workforce.training_enrollment {
  training_enrollment_id varchar [pk, note: 'Unique identifier for the training enrollment record. Primary key for this entity. | Column training_enrollment_id (BIGINT) in workforce.training_enrollment']
  employee_id varchar [note: 'Identifier of the employee enrolled in the training course. Links to the employee master record in the workforce domain. | Column employee_id (BIGINT) in workforce.training_enrollment']
  primary_previous_enrollment_training_enrollment_id varchar [note: 'Identifier of the previous training enrollment record that this recertification enrollment supersedes. Used to track recertification history and lineage. Null for initial enrollments. | Column previous_enrollment_training_enrollment_id (BIGINT) in workforce.training_enrollment']
  training_course_id varchar [note: 'Identifier of the training course or learning program for which the employee is enrolled. Links to the training course catalog. | Column training_course_id (BIGINT) in workforce.training_enrollment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.training_enrollment']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.training_enrollment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.training_enrollment']
  actual_start_date date [note: 'Actual date when the employee commenced the training course. May differ from scheduled start date due to delays or early starts. | Column actual_start_date (DATE) in workforce.training_enrollment']
  assessment_result varchar [note: 'Outcome of the training assessment indicating whether the employee passed, failed, has a pending assessment, did not require assessment for completion, or has an incomplete assessment. | Column assessment_result (STRING) in workforce.training_enrollment']
  assessment_score decimal(5,2) [note: 'Numerical score achieved by the employee on the training assessment, test, or examination. Typically expressed as a percentage (0-100) or raw score. Null if no assessment was administered or not yet taken. | Column assessment_score (DECIMAL(5,2)) in workforce.training_enrollment']
  attendance_percentage decimal(5,2) [note: 'Percentage of scheduled training sessions or modules that the employee attended or completed. Calculated as (hours completed / hours scheduled) * 100. Used for compliance verification and completion criteria. | Column attendance_percentage (DECIMAL(5,2)) in workforce.training_enrollment']
  certificate_expiry_date date [note: 'Date when the training certificate expires and recertification or refresher training is required. Null for certifications that do not expire or if no certificate was issued. Critical for tracking compliance with FCC technical certification requirements. | Column certificate_expiry_date (DATE) in workforce.training_enrollment']
  certificate_issue_date date [note: 'Date when the training completion certificate was issued to the employee. Null if no certificate was issued. | Column certificate_issue_date (DATE) in workforce.training_enrollment']
  certificate_issued boolean [note: 'Boolean flag indicating whether a training completion certificate was issued to the employee upon successful completion. True if certificate was issued, False otherwise. | Column certificate_issued (BOOLEAN) in workforce.training_enrollment']
  certificate_number varchar [note: 'Unique certificate identification number issued upon successful training completion. Used for verification and audit purposes. Null if no certificate was issued. | Column certificate_number (STRING) in workforce.training_enrollment']
  completion_date date [note: 'Date when the employee completed all requirements of the training course. Null if training is not yet completed. | Column completion_date (DATE) in workforce.training_enrollment']
  cost_amount decimal(12,2) [note: 'Total cost incurred for this training enrollment including tuition, materials, instructor fees, and facility costs. Used for training budget tracking and cost allocation. | Column cost_amount (DECIMAL(12,2)) in workforce.training_enrollment']
  cost_center_code varchar [note: 'Cost center code to which the training expenses are allocated. Used for financial reporting and departmental budget tracking. | Column cost_center_code (STRING) in workforce.training_enrollment']
  cost_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the training cost amount (e.g., USD, GBP, EUR). | Column cost_currency_code (STRING) in workforce.training_enrollment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.training_enrollment']
  created_timestamp timestamp [note: 'Timestamp when this enrollment record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in workforce.training_enrollment']
  enrolled_by_user varchar [note: 'Username or identifier of the person who initiated the enrollment (e.g., HR administrator, manager, or self-enrollment by employee). Used for audit trail and enrollment source tracking. | Column enrolled_by_user (STRING) in workforce.training_enrollment']
  enrollment_date date [note: 'Date when the employee was enrolled in the training course. Represents the business event timestamp for enrollment initiation. | Column enrollment_date (DATE) in workforce.training_enrollment']
  enrollment_number varchar [note: 'Business-facing unique enrollment reference number assigned to this training enrollment for tracking and reporting purposes. | Column enrollment_number (STRING) in workforce.training_enrollment']
  enrollment_status varchar [note: 'Current lifecycle status of the training enrollment indicating progression through the learning journey. Tracks whether the employee is enrolled, actively participating, has completed, failed, withdrawn, or had the enrollment cancelled. | Column enrollment_status (STRING) in workforce.training_enrollment']
  enrollment_type varchar [note: 'Classification of the enrollment indicating whether the training is mandatory (required by policy or regulation), voluntary (employee-initiated), recommended (suggested by manager), or compliance-driven (regulatory requirement such as FCC or EEO training). | Column enrollment_type (STRING) in workforce.training_enrollment']
  instructor_name varchar [note: 'Name of the instructor, facilitator, or trainer who delivered the training session. Null for self-paced online courses without instructor involvement. | Column instructor_name (STRING) in workforce.training_enrollment']
  is_mandatory boolean [note: 'Boolean flag indicating whether this training is mandatory for the employee based on role, regulatory requirements, or company policy. True for mandatory training, False for optional training. | Column is_mandatory (BOOLEAN) in workforce.training_enrollment']
  is_recertification boolean [note: 'Boolean flag indicating whether this enrollment represents a recertification or refresher training for a previously completed course. True for recertification enrollments, False for initial certifications. | Column is_recertification (BOOLEAN) in workforce.training_enrollment']
  is_regulatory_required boolean [note: 'Boolean flag indicating whether this training is required to meet regulatory compliance obligations such as FCC broadcast licensing requirements, EEO training mandates, or technical certification standards. True for regulatory-required training. | Column is_regulatory_required (BOOLEAN) in workforce.training_enrollment']
  modified_by_user varchar [note: 'Username or identifier of the person who last modified this enrollment record. Used for audit trail and accountability. | Column modified_by_user (STRING) in workforce.training_enrollment']
  modified_timestamp timestamp [note: 'Timestamp when this enrollment record was last modified or updated. Used for audit trail and change tracking. | Column modified_timestamp (TIMESTAMP) in workforce.training_enrollment']
  notes varchar [note: 'Free-text field for additional notes, comments, or special circumstances related to this training enrollment. May include accommodations provided, special arrangements, or other relevant information. | Column notes (STRING) in workforce.training_enrollment']
  number_of_attempts varchar [note: 'Count of how many times the employee attempted the training assessment or examination. Used for tracking learning progress and identifying employees who may need additional support. | Column number_of_attempts (INT) in workforce.training_enrollment']
  passing_score_threshold decimal(5,2) [note: 'Minimum score required to pass the training assessment and achieve completion status. Used to determine pass/fail result. Null if no assessment is required for completion. | Column passing_score_threshold (DECIMAL(5,2)) in workforce.training_enrollment']
  regulatory_framework varchar [note: 'Name of the regulatory framework or governing body requirement that mandates this training (e.g., FCC Broadcast License Compliance, EEO Training, OSHA Safety, SOX Financial Controls). Null if not regulatory-driven. | Column regulatory_framework (STRING) in workforce.training_enrollment']
  scheduled_end_date date [note: 'Planned date when the training session or learning program is scheduled to conclude for this enrollment. | Column scheduled_end_date (DATE) in workforce.training_enrollment']
  scheduled_start_date date [note: 'Planned date when the training session or learning program is scheduled to begin for this enrollment. | Column scheduled_start_date (DATE) in workforce.training_enrollment']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.training_enrollment']
  training_delivery_method varchar [note: 'Method by which the training content is delivered to the employee. Includes in-person classroom sessions, virtual instructor-led training, self-paced online courses, blended learning combining multiple methods, or on-the-job practical training. | Column training_delivery_method (STRING) in workforce.training_enrollment']
  training_hours_completed decimal(6,2) [note: 'Actual number of training hours completed by the employee. Used for tracking progress, compliance reporting, and crediting continuing education units. | Column training_hours_completed (DECIMAL(6,2)) in workforce.training_enrollment']
  training_hours_scheduled decimal(6,2) [note: 'Total number of training hours scheduled for this enrollment based on the course curriculum. Used for planning and resource allocation. | Column training_hours_scheduled (DECIMAL(6,2)) in workforce.training_enrollment']
  training_location varchar [note: 'Physical or virtual location where the training is conducted. For in-person training, includes facility name or address. For virtual training, may include platform name (e.g., Zoom, Microsoft Teams). Null for self-paced online courses. | Column training_location (STRING) in workforce.training_enrollment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.training_enrollment']
  withdrawal_date date [note: 'Date when the employee withdrew from the training course before completion. Null if the enrollment was not withdrawn. | Column withdrawal_date (DATE) in workforce.training_enrollment']
  withdrawal_reason varchar [note: 'Free-text explanation or categorized reason for why the employee withdrew from the training. Used for analyzing training dropout patterns and improving course design. Null if not withdrawn. | Column withdrawal_reason (STRING) in workforce.training_enrollment']

  Note: 'Transactional record of an employee\'s enrollment and completion status for a specific training course or learning program. Captures enrollment date, scheduled session date, completion date, completion status (enrolled/in-progress/completed/failed/withdrawn), assessment score, pass/fail result, certificate issued flag, certificate expiry date, and training hours credited. Enables compliance tracking for mandatory FCC regulatory training, EEO training, and broadcast technical certifications required for licensed operations. | Unity Catalog table: media_broadcasting_ecm.workforce.training_enrollment'
}

Table workforce.certification {
  certification_id varchar [pk, note: 'Unique identifier for the professional certification record. Primary key for the certification entity. | Column certification_id (BIGINT) in workforce.certification']
  employee_id varchar [note: 'Reference to the employee who holds this certification. Links to the employee master record in the workforce domain. | Column employee_id (BIGINT) in workforce.certification']
  renewed_certification_id varchar [note: 'Self-referencing FK on certification (renewed_certification_id) | Column renewed_certification_id (BIGINT) in workforce.certification']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.certification']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.certification']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.certification']
  certificate_url varchar [note: 'Web URL or digital link to the electronic certificate or credential badge. Used for digital verification and display of credentials. | Column certificate_url (STRING) in workforce.certification']
  certification_category varchar [note: 'Functional domain or technical discipline that the certification covers. Used to align certifications with job roles and departmental needs. [ENUM-REF-CANDIDATE: broadcast_engineering|it_infrastructure|cloud_computing|network_engineering|audio_engineering|video_engineering|rf_transmission|compliance_regulatory|project_management|cybersecurity — 10 candidates stripped; promote to reference product] | Column certification_category (STRING) in workforce.certification']
  certification_code varchar [note: 'Short code or abbreviation for the certification type. Examples: GROL, CBNT, CBT, CPBE, AWS-SAA, SMPTE-CTS. Used for internal classification and reporting. | Column certification_code (STRING) in workforce.certification']
  certification_level varchar [note: 'Proficiency or seniority level represented by the certification. Entry-level certifications demonstrate foundational knowledge; expert and master levels indicate advanced expertise and leadership capability. | Column certification_level (STRING) in workforce.certification']
  certification_name varchar [note: 'Full official name of the professional certification, license, or credential. Examples: FCC General Radiotelephone Operator License (GROL), SBE Certified Broadcast Networking Technologist (CBNT), AWS Certified Solutions Architect, SMPTE Certified Technology Specialist. | Column certification_name (STRING) in workforce.certification']
  certification_number varchar [note: 'Unique certificate or license number issued by the certifying body. This is the official credential identifier that can be used for verification purposes. | Column certification_number (STRING) in workforce.certification']
  certification_status varchar [note: 'Current lifecycle status of the certification. Active certifications are valid and current; expired certifications have passed their expiry date; suspended certifications are temporarily invalid; revoked certifications have been permanently withdrawn; pending verification certifications are awaiting confirmation; in-progress certifications are being pursued but not yet awarded. | Column certification_status (STRING) in workforce.certification']
  certification_type varchar [note: 'Classification of the certification based on its nature and purpose. Regulatory licenses are legally required for specific broadcast operations; professional certifications demonstrate industry expertise; technical certifications validate specialized technical skills; vendor certifications are product-specific credentials; industry credentials are association-based qualifications. | Column certification_type (STRING) in workforce.certification']
  continuing_education_hours_completed decimal(6,2) [note: 'Number of continuing education hours the employee has completed toward the current renewal cycle. Used to track progress toward recertification requirements. | Column continuing_education_hours_completed (DECIMAL(6,2)) in workforce.certification']
  continuing_education_hours_required decimal(6,2) [note: 'Number of continuing education or professional development hours required to maintain or renew the certification. Null for certifications without continuing education requirements. | Column continuing_education_hours_required (DECIMAL(6,2)) in workforce.certification']
  cost_amount decimal(12,2) [note: 'Total cost incurred to obtain or renew the certification, including exam fees, training costs, and application fees. Used for workforce development budget tracking and ROI analysis. | Column cost_amount (DECIMAL(12,2)) in workforce.certification']
  cost_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the certification cost. Examples: USD, GBP, EUR, CAD. | Column cost_currency_code (STRING) in workforce.certification']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.certification']
  created_timestamp timestamp [note: 'Timestamp when this certification record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in workforce.certification']
  document_storage_path varchar [note: 'File path or document management system reference to the scanned or digital copy of the physical certificate. Used for record retention and audit purposes. | Column document_storage_path (STRING) in workforce.certification']
  employer_sponsored boolean [note: 'Indicates whether the certification was sponsored or paid for by the employer. True if the company funded the certification; false if the employee self-funded it. | Column employer_sponsored (BOOLEAN) in workforce.certification']
  exam_score decimal(5,2) [note: 'Score achieved on the certification exam, if applicable. May be a percentage, numeric score, or standardized score depending on the certification body. Null for certifications that do not have scored exams. | Column exam_score (DECIMAL(5,2)) in workforce.certification']
  expiry_date date [note: 'Date on which the certification expires and is no longer valid. Null for certifications that do not expire. Critical for compliance tracking and renewal planning. | Column expiry_date (DATE) in workforce.certification']
  is_regulatory_required boolean [note: 'Indicates whether this certification is required by law or regulation for the employee to perform specific duties. True for FCC licenses and other legally mandated credentials; false for voluntary professional certifications. | Column is_regulatory_required (BOOLEAN) in workforce.certification']
  is_required_for_role boolean [note: 'Indicates whether this certification is a mandatory requirement for the employees current job role. True for certifications that are job prerequisites (e.g., FCC GROL for broadcast engineers); false for optional or supplementary credentials. | Column is_required_for_role (BOOLEAN) in workforce.certification']
  issue_date date [note: 'Date on which the certification was originally issued or awarded to the employee. Used to calculate tenure and experience with the credential. | Column issue_date (DATE) in workforce.certification']
  issuing_body varchar [note: 'Name of the organization or regulatory authority that issued the certification. Examples: Federal Communications Commission (FCC), Society of Broadcast Engineers (SBE), Society of Motion Picture and Television Engineers (SMPTE), Amazon Web Services (AWS), Microsoft, Cisco. | Column issuing_body (STRING) in workforce.certification']
  modified_by_user varchar [note: 'User identifier or username of the person who last modified this certification record. Used for audit trail and accountability. | Column modified_by_user (STRING) in workforce.certification']
  modified_timestamp timestamp [note: 'Timestamp when this certification record was last updated. Used for audit trail and change tracking. | Column modified_timestamp (TIMESTAMP) in workforce.certification']
  next_renewal_due_date date [note: 'Date by which the certification must be renewed to maintain active status. Used for proactive renewal reminders and compliance monitoring. | Column next_renewal_due_date (DATE) in workforce.certification']
  notes varchar [note: 'Free-text field for additional information, special conditions, or context about the certification. May include details about specializations, endorsements, or unique circumstances. | Column notes (STRING) in workforce.certification']
  passing_score decimal(5,2) [note: 'Minimum score required to pass the certification exam. Used to contextualize the exam score and assess performance relative to the standard. | Column passing_score (DECIMAL(5,2)) in workforce.certification']
  renewal_date date [note: 'Date on which the certification was last renewed or recertified. Tracks ongoing maintenance of the credential. | Column renewal_date (DATE) in workforce.certification']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.certification']
  training_provider varchar [note: 'Name of the organization or institution that provided the training or preparation for the certification exam. May be the same as the issuing body or a separate training vendor. | Column training_provider (STRING) in workforce.certification']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.certification']
  verification_date date [note: 'Date on which the certification was verified with the issuing body. Used for audit trail and compliance documentation. | Column verification_date (DATE) in workforce.certification']
  verification_method varchar [note: 'Method used to verify the authenticity of the certification. Online registry checks use public databases; issuer confirmation involves direct contact with the certifying body; document review examines physical certificates; third-party services use specialized verification providers; self-attestation relies on employee declaration. | Column verification_method (STRING) in workforce.certification']
  verification_status varchar [note: 'Status of third-party verification of the certification with the issuing body. Verified certifications have been confirmed as authentic; pending verifications are awaiting response; failed verifications could not be confirmed; not required applies to internal or non-critical certifications. | Column verification_status (STRING) in workforce.certification']

  Note: 'Master record of professional certifications, licenses, and credentials held by Media Broadcasting employees — FCC General Radiotelephone Operator License (GROL), SBE (Society of Broadcast Engineers) certifications, SMPTE technical certifications, IT/cloud certifications, and professional credentials. Captures certification name, issuing body, certification number, issue date, expiry date, renewal status, verification status, and associated job profile requirements. Critical for ensuring licensed broadcast operations are staffed with appropriately credentialed engineers. | Unity Catalog table: media_broadcasting_ecm.workforce.certification | Domain ownership:  Workforce entity supporting employee certification and compliance tracking.'
}

Table workforce.disciplinary_action {
  disciplinary_action_id varchar [pk, note: 'Unique identifier for the disciplinary action record. Primary key for the disciplinary action entity. | Column disciplinary_action_id (BIGINT) in workforce.disciplinary_action']
  escalated_disciplinary_action_id varchar [note: 'Self-referencing FK on disciplinary_action (escalated_disciplinary_action_id) | Column escalated_disciplinary_action_id (BIGINT) in workforce.disciplinary_action']
  primary_disciplinary_employee_id varchar [note: 'Identifier of the Media Broadcasting employee who is the subject of this disciplinary action. | Column primary_disciplinary_employee_id (BIGINT) in workforce.disciplinary_action']
  tertiary_disciplinary_issuing_manager_employee_id varchar [note: 'Identifier of the manager or supervisor who issued the disciplinary action to the employee. | Column tertiary_disciplinary_issuing_manager_employee_id (BIGINT) in workforce.disciplinary_action']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.disciplinary_action']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.disciplinary_action']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.disciplinary_action']
  action_date date [note: 'Date the disciplinary action was formally issued to the employee. This is the official date of record for the action and starts any applicable timelines. | Column action_date (DATE) in workforce.disciplinary_action']
  action_number varchar [note: 'Business identifier for the disciplinary action, formatted as DA-YYYYNNNN for external reference and case tracking. | Column action_number (STRING) in workforce.disciplinary_action']
  action_status varchar [note: 'Current lifecycle state of the disciplinary action: draft (being prepared), pending review (awaiting HR/legal approval), active (in effect), completed (action fulfilled or time elapsed), overturned (reversed on appeal), or expired (no longer on employee record per retention policy). | Column action_status (STRING) in workforce.disciplinary_action']
  action_type varchar [note: 'Classification of the disciplinary action severity level: verbal warning (informal counseling), written warning (first formal step), final warning (last chance before termination), performance improvement plan (PIP - structured remediation), suspension (temporary removal from duties), or termination for cause (employment ended due to policy violation). | Column action_type (STRING) in workforce.disciplinary_action']
  appeal_filed_date date [note: 'Date the employee filed a formal appeal or grievance. Null if no appeal has been filed. | Column appeal_filed_date (DATE) in workforce.disciplinary_action']
  appeal_filed_flag boolean [note: 'Indicates whether the employee has filed a formal appeal or grievance challenging this disciplinary action. True if appeal filed, false otherwise. | Column appeal_filed_flag (BOOLEAN) in workforce.disciplinary_action']
  appeal_outcome varchar [note: 'Result of the appeal or grievance process: upheld (original action stands), overturned (action reversed), modified (action reduced or changed), or pending (under review). Null if no appeal filed. | Column appeal_outcome (STRING) in workforce.disciplinary_action']
  corrective_action_required varchar [note: 'Specific actions, behavioral changes, or performance improvements the employee must demonstrate to resolve the disciplinary action. May include training completion, metric achievement, or behavioral modification. | Column corrective_action_required (STRING) in workforce.disciplinary_action']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.disciplinary_action']
  created_timestamp timestamp [note: 'Timestamp when this disciplinary action record was first created in the HR system. Audit trail for record creation. | Column created_timestamp (TIMESTAMP) in workforce.disciplinary_action']
  employee_acknowledgment_date date [note: 'Date the employee signed or electronically acknowledged the disciplinary action documentation. Null if not yet acknowledged. | Column employee_acknowledgment_date (DATE) in workforce.disciplinary_action']
  employee_acknowledgment_flag boolean [note: 'Indicates whether the employee has acknowledged receipt and review of the disciplinary action documentation. True if acknowledged, false if not yet acknowledged. | Column employee_acknowledgment_flag (BOOLEAN) in workforce.disciplinary_action']
  employee_response varchar [note: 'Written response or statement provided by the employee regarding the disciplinary action. May include explanations, disagreements, or mitigating circumstances. Null if no response provided. | Column employee_response (STRING) in workforce.disciplinary_action']
  incident_date date [note: 'Date when the policy violation or performance issue that triggered this disciplinary action occurred. May precede the action date due to investigation time. | Column incident_date (DATE) in workforce.disciplinary_action']
  investigation_summary varchar [note: 'Summary of the investigation conducted prior to issuing the disciplinary action, including interviews, evidence reviewed, and findings. Documents due process and fair treatment. | Column investigation_summary (STRING) in workforce.disciplinary_action']
  legal_review_completed_flag boolean [note: 'Indicates whether required legal review has been completed and approved. Null if legal review is not required. | Column legal_review_completed_flag (BOOLEAN) in workforce.disciplinary_action']
  legal_review_required_flag boolean [note: 'Indicates whether this disciplinary action requires legal department review and approval before issuance. Typically true for terminations, suspensions, or actions involving potential litigation risk. | Column legal_review_required_flag (BOOLEAN) in workforce.disciplinary_action']
  legal_reviewer_name varchar [note: 'Name of the legal department representative who reviewed and approved this disciplinary action. Null if legal review was not required or not yet completed. | Column legal_reviewer_name (STRING) in workforce.disciplinary_action']
  modified_by_user varchar [note: 'User ID or name of the HR system user who last modified this disciplinary action record. Audit trail for accountability. | Column modified_by_user (STRING) in workforce.disciplinary_action']
  modified_timestamp timestamp [note: 'Timestamp when this disciplinary action record was last modified. Audit trail for record updates. | Column modified_timestamp (TIMESTAMP) in workforce.disciplinary_action']
  notes varchar [note: 'Additional confidential notes, context, or follow-up information related to the disciplinary action. May include manager observations, HR guidance, or case management details. | Column notes (STRING) in workforce.disciplinary_action']
  outcome varchar [note: 'Final outcome of the disciplinary action: successful (employee met corrective action requirements and improved), unsuccessful (employee failed to improve, may lead to further action), in progress (action period still active), or terminated (employment ended as result of this action). | Column outcome (STRING) in workforce.disciplinary_action']
  pip_end_date date [note: 'End date of the performance improvement plan period if action type is PIP. Typically 30, 60, or 90 days from start. Null for non-PIP actions. | Column pip_end_date (DATE) in workforce.disciplinary_action']
  pip_start_date date [note: 'Start date of the performance improvement plan period if action type is PIP. Null for non-PIP actions. | Column pip_start_date (DATE) in workforce.disciplinary_action']
  policy_violated varchar [note: 'Reference to the specific company policy, code of conduct section, or employment agreement clause that was violated. Includes policy number and title for traceability. | Column policy_violated (STRING) in workforce.disciplinary_action']
  record_retention_date date [note: 'Date until which this disciplinary action record must be retained in the employee file per employment law and company policy. After this date, record may be purged or archived per retention schedule. | Column record_retention_date (DATE) in workforce.disciplinary_action']
  response_deadline_date date [note: 'Date by which the employee must provide a written response, complete required corrective actions, or demonstrate improvement. Null if no response is required. | Column response_deadline_date (DATE) in workforce.disciplinary_action']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.disciplinary_action']
  suspension_end_date date [note: 'End date of suspension period if action type is suspension. Null for non-suspension actions. | Column suspension_end_date (DATE) in workforce.disciplinary_action']
  suspension_paid_flag boolean [note: 'Indicates whether the suspension is paid (true) or unpaid (false). Null for non-suspension actions. Paid suspensions are typically used during investigations; unpaid for disciplinary purposes. | Column suspension_paid_flag (BOOLEAN) in workforce.disciplinary_action']
  suspension_start_date date [note: 'Start date of suspension period if action type is suspension. Null for non-suspension actions. | Column suspension_start_date (DATE) in workforce.disciplinary_action']
  termination_triggered_flag boolean [note: 'Indicates whether this disciplinary action resulted in or triggered employee termination. True if termination occurred, false otherwise. Feeds termination workflow when true. | Column termination_triggered_flag (BOOLEAN) in workforce.disciplinary_action']
  union_notification_required_flag boolean [note: 'Indicates whether union notification is required for this disciplinary action per collective bargaining agreement. True for union-represented employees in positions covered by CBA disciplinary procedures. | Column union_notification_required_flag (BOOLEAN) in workforce.disciplinary_action']
  union_notified_date date [note: 'Date the union representative was formally notified of the disciplinary action. Null if union notification is not required or not yet completed. | Column union_notified_date (DATE) in workforce.disciplinary_action']
  union_representative_name varchar [note: 'Name of the union representative notified and involved in the disciplinary action process. Null if not applicable. | Column union_representative_name (STRING) in workforce.disciplinary_action']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.disciplinary_action']
  violation_category varchar [note: 'High-level classification of the policy violation type: attendance (tardiness, absenteeism), performance (failure to meet job standards), conduct (behavioral issues), safety (workplace safety violations), compliance (regulatory or legal violations), confidentiality (data/information breach), or harassment (workplace harassment or discrimination). [ENUM-REF-CANDIDATE: attendance|performance|conduct|safety|compliance|confidentiality|harassment — 7 candidates stripped; promote to reference product] | Column violation_category (STRING) in workforce.disciplinary_action']
  violation_description varchar [note: 'Detailed narrative description of the specific policy violation or performance issue, including facts, circumstances, and impact. Maintained as confidential employment record. | Column violation_description (STRING) in workforce.disciplinary_action']

  Note: 'Transactional record of formal disciplinary actions taken against Media Broadcasting employees — verbal warnings, written warnings, performance improvement plans (PIPs), suspensions, and terminations for cause. Captures action date, action type, policy violation description, investigation summary, corrective action required, response deadline, employee acknowledgment status, HR business partner assigned, legal review flag, and outcome. Maintained under restricted access per employment law requirements and feeds termination workflow when applicable. | Unity Catalog table: media_broadcasting_ecm.workforce.disciplinary_action'
}

Table workforce.workforce_grievance {
  workforce_grievance_id varchar [pk, note: 'Unique identifier for the workforce grievance record. Primary key for the workforce grievance entity. | Column workforce_grievance_id (BIGINT) in workforce.workforce_grievance']
  escalated_workforce_grievance_id varchar [note: 'Self-referencing FK on workforce_grievance (escalated_workforce_grievance_id) | Column escalated_workforce_grievance_id (BIGINT) in workforce.workforce_grievance']
  org_unit_id varchar [note: 'Identifier of the organizational unit where the complainant was assigned at the time of filing. Links to the org_unit master record. | Column org_unit_id (BIGINT) in workforce.workforce_grievance']
  primary_workforce_complainant_employee_id varchar [note: 'Identifier of the employee who filed the grievance. Links to the employee master record. | Column primary_workforce_complainant_employee_id (BIGINT) in workforce.workforce_grievance']
  tertiary_workforce_employee_id varchar [note: 'Identifier of the HR investigator or case manager assigned to investigate and resolve the grievance. Links to the employee master record. | Column tertiary_workforce_employee_id (BIGINT) in workforce.workforce_grievance']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.workforce_grievance']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.workforce_grievance']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.workforce_grievance']
  appeal_date date [note: 'The date when an appeal was formally filed, if applicable. | Column appeal_date (DATE) in workforce.workforce_grievance']
  appeal_filed_flag boolean [note: 'Indicates whether an appeal was filed by either party following the initial resolution. | Column appeal_filed_flag (BOOLEAN) in workforce.workforce_grievance']
  appeal_status varchar [note: 'Current status of the appeal process if an appeal was filed. | Column appeal_status (STRING) in workforce.workforce_grievance']
  complaint_description varchar [note: 'Detailed narrative description of the grievance, including the nature of the complaint, circumstances, and impact on the complainant. | Column complaint_description (STRING) in workforce.workforce_grievance']
  confidentiality_level varchar [note: 'Level of confidentiality required for the grievance case based on sensitivity, legal risk, and privacy considerations. | Column confidentiality_level (STRING) in workforce.workforce_grievance']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.workforce_grievance']
  created_timestamp timestamp [note: 'Timestamp when the grievance record was first created in the HR system. | Column created_timestamp (TIMESTAMP) in workforce.workforce_grievance']
  disciplinary_action_taken varchar [note: 'Type of disciplinary action taken against the respondent if the grievance was substantiated. | Column disciplinary_action_taken (STRING) in workforce.workforce_grievance']
  external_agency_name varchar [note: 'Name of the external agency to which the grievance was reported (e.g., EEOC, OSHA, state labor department). | Column external_agency_name (STRING) in workforce.workforce_grievance']
  external_agency_reported_flag boolean [note: 'Indicates whether the grievance was also reported to an external regulatory or enforcement agency such as EEOC, OSHA, or state labor board. | Column external_agency_reported_flag (BOOLEAN) in workforce.workforce_grievance']
  external_case_number varchar [note: 'Case or complaint number assigned by the external agency for tracking purposes. | Column external_case_number (STRING) in workforce.workforce_grievance']
  filed_date date [note: 'The date when the formal grievance was officially filed with Human Resources, marking the start of the investigation timeline. | Column filed_date (DATE) in workforce.workforce_grievance']
  grievance_number varchar [note: 'Externally-visible unique business identifier for the grievance case, formatted as GRV-YYYYNNNN for tracking and reference purposes. | Column grievance_number (STRING) in workforce.workforce_grievance']
  grievance_status varchar [note: 'Current lifecycle status of the grievance case in the investigation and resolution workflow. | Column grievance_status (STRING) in workforce.workforce_grievance']
  grievance_type varchar [note: 'Classification of the grievance based on the nature of the complaint: workplace harassment, discrimination, wage dispute, unsafe working conditions, union grievance filing, or retaliation. | Column grievance_type (STRING) in workforce.workforce_grievance']
  incident_date date [note: 'The date when the alleged incident or violation that prompted the grievance occurred. | Column incident_date (DATE) in workforce.workforce_grievance']
  incident_location varchar [note: 'Physical or virtual location where the alleged incident occurred (e.g., studio, office, remote work, production site). | Column incident_location (STRING) in workforce.workforce_grievance']
  investigation_end_date date [note: 'The date when the investigation was completed and findings were documented. | Column investigation_end_date (DATE) in workforce.workforce_grievance']
  investigation_findings varchar [note: 'Summary of the investigation findings, evidence collected, witness statements, and conclusions reached by the investigator. | Column investigation_findings (STRING) in workforce.workforce_grievance']
  investigation_start_date date [note: 'The date when the formal investigation of the grievance commenced. | Column investigation_start_date (DATE) in workforce.workforce_grievance']
  last_modified_timestamp timestamp [note: 'Timestamp when the grievance record was last updated, reflecting the most recent change to case status or details. | Column last_modified_timestamp (TIMESTAMP) in workforce.workforce_grievance']
  legal_counsel_involved_flag boolean [note: 'Indicates whether legal counsel was engaged by either party during the grievance process. | Column legal_counsel_involved_flag (BOOLEAN) in workforce.workforce_grievance']
  modified_by_user varchar [note: 'Username or identifier of the HR system user who last modified the grievance record. | Column modified_by_user (STRING) in workforce.workforce_grievance']
  resolution_date date [note: 'The date when the grievance was formally resolved and outcome communicated to involved parties. | Column resolution_date (DATE) in workforce.workforce_grievance']
  resolution_description varchar [note: 'Detailed description of the resolution actions taken, corrective measures implemented, and any remediation provided to the complainant. | Column resolution_description (STRING) in workforce.workforce_grievance']
  resolution_outcome varchar [note: 'Final determination of the grievance investigation: substantiated (complaint upheld), unsubstantiated (complaint not supported), partially substantiated, withdrawn by complainant, or settled through mediation. | Column resolution_outcome (STRING) in workforce.workforce_grievance']
  respondent_type varchar [note: 'Classification of the respondent entity: individual employee, manager, department, organization-level, or external party. | Column respondent_type (STRING) in workforce.workforce_grievance']
  retaliation_reported_flag boolean [note: 'Indicates whether the complainant reported retaliation following the filing of the grievance. | Column retaliation_reported_flag (BOOLEAN) in workforce.workforce_grievance']
  severity_level varchar [note: 'Assessment of the grievance severity based on potential impact, legal risk, and urgency of resolution required. | Column severity_level (STRING) in workforce.workforce_grievance']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.workforce_grievance']
  union_involved_flag boolean [note: 'Indicates whether a labor union was involved in the grievance filing or resolution process. | Column union_involved_flag (BOOLEAN) in workforce.workforce_grievance']
  union_name varchar [note: 'Name of the labor union representing the complainant or involved in the grievance process, if applicable. | Column union_name (STRING) in workforce.workforce_grievance']
  union_representative_name varchar [note: 'Name of the union representative who assisted the complainant or participated in the grievance proceedings. | Column union_representative_name (STRING) in workforce.workforce_grievance']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.workforce_grievance']

  Note: 'Transactional record of formal employee grievances, complaints, and HR investigations filed at Media Broadcasting — workplace harassment, discrimination, wage disputes, unsafe working conditions, and union grievance filings. Captures grievance date, grievance type, complainant employee, respondent employee or manager, description of complaint, investigation status, assigned HR investigator, resolution date, resolution outcome, and appeal status. Distinct from talent grievances in the talent domain — this covers internal staff employment disputes only. | Unity Catalog table: media_broadcasting_ecm.workforce.workforce_grievance'
}

Table workforce.headcount_plan {
  headcount_plan_id varchar [pk, note: 'Unique identifier for the headcount plan record. Primary key for the headcount plan entity. | Column headcount_plan_id (BIGINT) in workforce.headcount_plan']
  approved_by_employee_id varchar [note: 'Reference to the employee (typically a senior executive or finance leader) who approved this headcount plan. Links to the employee master data. | Column approved_by_employee_id (BIGINT) in workforce.headcount_plan']
  org_unit_id varchar [note: 'Reference to the organizational unit (department, division, cost center) for which this headcount plan is defined. Links to the org_unit master data. | Column org_unit_id (BIGINT) in workforce.headcount_plan']
  revised_headcount_plan_id varchar [note: 'Self-referencing FK on headcount_plan (revised_headcount_plan_id) | Column revised_headcount_plan_id (BIGINT) in workforce.headcount_plan']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.headcount_plan']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.headcount_plan']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.headcount_plan']
  approval_date date [note: 'The date on which this headcount plan was formally approved by the authorized approver. Marks the transition from draft to approved status. | Column approval_date (DATE) in workforce.headcount_plan']
  approved_fte_count decimal(10,2) [note: 'The approved target headcount expressed in Full-Time Equivalent (FTE) units for this org unit, job family, and fiscal year. Represents the authorized staffing level approved by finance and executive leadership. | Column approved_fte_count (DECIMAL(10,2)) in workforce.headcount_plan']
  attrition_assumption_percentage decimal(5,2) [note: 'The assumed annual attrition rate (as a percentage) used in workforce planning for this org unit and job family. Informs net hiring targets and replacement planning. | Column attrition_assumption_percentage (DECIMAL(5,2)) in workforce.headcount_plan']
  budget_amount decimal(18,2) [note: 'The total budgeted compensation and benefits amount allocated for this headcount plan (org unit, job family, fiscal year). Expressed in the budget currency and used for financial planning and variance analysis. | Column budget_amount (DECIMAL(18,2)) in workforce.headcount_plan']
  budget_currency_code varchar [note: 'The three-letter ISO 4217 currency code for the budget amount (e.g., USD, GBP, EUR). Supports multi-currency budgeting for global Media Broadcasting operations. | Column budget_currency_code (STRING) in workforce.headcount_plan']
  contractor_fte_count decimal(10,2) [note: 'The planned or approved headcount for contractors and contingent workers expressed in FTE units. Tracked separately from permanent employee FTE for total workforce visibility. | Column contractor_fte_count (DECIMAL(10,2)) in workforce.headcount_plan']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.headcount_plan']
  created_by_user varchar [note: 'The user ID or username of the person who created this headcount plan record. Supports audit trail and accountability. | Column created_by_user (STRING) in workforce.headcount_plan']
  created_timestamp timestamp [note: 'The date and time when this headcount plan record was first created in the system. Supports audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in workforce.headcount_plan']
  critical_role_flag boolean [note: 'Indicates whether this headcount plan record covers critical or hard-to-fill roles that require special attention in workforce planning and talent acquisition. True if critical; False otherwise. | Column critical_role_flag (BOOLEAN) in workforce.headcount_plan']
  current_filled_fte decimal(10,2) [note: 'The current actual headcount in FTE units as of the plan snapshot date. Used to calculate variance against approved FTE and identify open capacity. | Column current_filled_fte (DECIMAL(10,2)) in workforce.headcount_plan']
  diversity_hiring_target_percentage decimal(5,2) [note: 'The target percentage of new hires from underrepresented groups for this org unit and job family. Supports diversity, equity, and inclusion (DEI) goals and regulatory compliance. | Column diversity_hiring_target_percentage (DECIMAL(5,2)) in workforce.headcount_plan']
  fiscal_year varchar [note: 'The fiscal year for which this headcount plan applies (e.g., 2024, 2025). Aligns with Media Broadcasting\'s annual budget and planning cycle. | Column fiscal_year (INT) in workforce.headcount_plan']
  intern_fte_count decimal(10,2) [note: 'The planned or approved headcount for interns and temporary student workers expressed in FTE units. Supports talent pipeline and early career program planning. | Column intern_fte_count (DECIMAL(10,2)) in workforce.headcount_plan']
  job_family varchar [note: 'The job family or functional category for which headcount is planned (e.g., Broadcast Operations, Content Production, Engineering, Sales). Aligns with Media Broadcasting\'s job architecture and talent segmentation. [ENUM-REF-CANDIDATE: broadcast_operations|content_production|engineering|sales|finance|hr|legal|marketing|it|executive — 10 candidates stripped; promote to reference product] | Column job_family (STRING) in workforce.headcount_plan']
  last_modified_by_user varchar [note: 'The user ID or username of the person who last modified this headcount plan record. Supports audit trail and accountability. | Column last_modified_by_user (STRING) in workforce.headcount_plan']
  last_modified_timestamp timestamp [note: 'The date and time when this headcount plan record was last updated. Supports change tracking and audit trail. | Column last_modified_timestamp (TIMESTAMP) in workforce.headcount_plan']
  net_hiring_target varchar [note: 'The net number of new hires required to achieve the approved FTE count after accounting for attrition and current filled FTE. Calculated as (approved_fte_count - current_filled_fte + expected_attrition). | Column net_hiring_target (INT) in workforce.headcount_plan']
  open_requisition_count varchar [note: 'The number of open job requisitions currently in the recruitment pipeline for this org unit and job family. Tracks active hiring efforts against the approved plan. | Column open_requisition_count (INT) in workforce.headcount_plan']
  plan_approval_status varchar [note: 'The current approval status of this headcount plan record in the budget and planning workflow. Tracks progression from draft through executive approval. | Column plan_approval_status (STRING) in workforce.headcount_plan']
  plan_effective_end_date date [note: 'The date through which this headcount plan remains effective. Typically aligns with the end of the fiscal year or planning period. Null indicates an open-ended plan. | Column plan_effective_end_date (DATE) in workforce.headcount_plan']
  plan_effective_start_date date [note: 'The date from which this headcount plan becomes effective. Typically aligns with the start of the fiscal year or the beginning of a planning period. | Column plan_effective_start_date (DATE) in workforce.headcount_plan']
  plan_notes varchar [note: 'Free-text notes and commentary on this headcount plan record. Captures business context, assumptions, constraints, or special considerations for workforce planning. | Column plan_notes (STRING) in workforce.headcount_plan']
  plan_type varchar [note: 'The type or category of headcount plan (e.g., Annual, Quarterly, Mid-Year Revision, Strategic). Distinguishes between regular annual planning cycles and ad-hoc revisions. | Column plan_type (STRING) in workforce.headcount_plan']
  plan_version_code varchar [note: 'Version identifier for the headcount plan (e.g., FY2024-V1, FY2024-V2-REVISED). Supports multiple iterations of the annual plan as revisions are made during budget cycles. | Column plan_version_code (STRING) in workforce.headcount_plan']
  planning_scenario varchar [note: 'The business scenario or strategic context for this headcount plan (e.g., Baseline, Growth, Cost Reduction, Restructuring, Merger Integration). Supports scenario-based workforce planning. | Column planning_scenario (STRING) in workforce.headcount_plan']
  remote_work_fte_count decimal(10,2) [note: 'The number of FTEs in this plan designated for remote or hybrid work arrangements. Supports workforce flexibility planning and real estate optimization. | Column remote_work_fte_count (DECIMAL(10,2)) in workforce.headcount_plan']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.headcount_plan']
  succession_plan_required_flag boolean [note: 'Indicates whether roles in this headcount plan require formal succession planning due to business criticality or leadership pipeline needs. True if succession planning is required; False otherwise. | Column succession_plan_required_flag (BOOLEAN) in workforce.headcount_plan']
  union_fte_count decimal(10,2) [note: 'The number of FTEs in this plan covered by collective bargaining agreements or union membership. Critical for labor relations planning and compliance in broadcast operations. | Column union_fte_count (DECIMAL(10,2)) in workforce.headcount_plan']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.headcount_plan']
  variance_fte decimal(10,2) [note: 'The variance between approved FTE count and current filled FTE. Calculated as (approved_fte_count - current_filled_fte). Positive values indicate unfilled capacity; negative values indicate overstaffing. | Column variance_fte (DECIMAL(10,2)) in workforce.headcount_plan']

  Note: 'Master record for workforce headcount planning at Media Broadcasting — capturing approved headcount targets by org unit, job family, and fiscal year. Captures plan version, fiscal year, org unit, job family, approved FTE count, current filled FTE, open requisition count, attrition assumption percentage, net hiring target, and plan approval status. Supports annual workforce planning cycles, budget submissions to finance, and ongoing headcount variance tracking against approved plan. | Unity Catalog table: media_broadcasting_ecm.workforce.headcount_plan'
}

Table workforce.requisition {
  requisition_id varchar [pk, note: 'Unique identifier for the job requisition record. Primary key for the requisition entity. | Column requisition_id (BIGINT) in workforce.requisition']
  job_profile_id varchar [note: 'Reference to the job profile defining role requirements, qualifications, and compensation band for this requisition. | Column job_profile_id (BIGINT) in workforce.requisition']
  org_unit_id varchar [note: 'Reference to the organizational unit (department, division, or team) requesting the hire. | Column org_unit_id (BIGINT) in workforce.requisition']
  position_id varchar [note: 'Reference to the approved position being filled by this requisition. Links to the position master record. | Column position_id (BIGINT) in workforce.requisition']
  primary_requisition_approved_by_employee_id varchar [note: 'Reference to the employee who provided final approval for this requisition, typically a senior manager or HR director. | Column requisition_approved_by_employee_id (BIGINT) in workforce.requisition']
  replacement_requisition_id varchar [note: 'Self-referencing FK on requisition (replacement_requisition_id) | Column replacement_requisition_id (BIGINT) in workforce.requisition']
  tertiary_requisition_recruiter_employee_id varchar [note: 'Reference to the HR recruiter or talent acquisition specialist assigned to manage this requisition. | Column requisition_recruiter_employee_id (BIGINT) in workforce.requisition']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.requisition']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.requisition']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.requisition']
  approval_date date [note: 'Date when the requisition received final approval from authorized approvers to proceed with recruiting. | Column approval_date (DATE) in workforce.requisition']
  approved_headcount_source varchar [note: 'Source of headcount authorization indicating whether the position is funded from annual budget, supplemental budget, backfill allocation, reallocation, or new approval. | Column approved_headcount_source (STRING) in workforce.requisition']
  bonus_eligible boolean [note: 'Indicates whether the position is eligible for performance-based bonus compensation. | Column bonus_eligible (BOOLEAN) in workforce.requisition']
  business_justification varchar [note: 'Detailed explanation of the business need and rationale for opening this requisition, including impact on operations, revenue, or strategic initiatives. | Column business_justification (STRING) in workforce.requisition']
  close_date date [note: 'Date when the requisition was closed, either due to successful fill, cancellation, or other closure reason. | Column close_date (DATE) in workforce.requisition']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.requisition']
  created_timestamp timestamp [note: 'Timestamp when the requisition record was first created in the system. | Column created_timestamp (TIMESTAMP) in workforce.requisition']
  eeo_job_category varchar [note: 'EEO-1 job category classification for regulatory reporting to the Equal Employment Opportunity Commission. | Column eeo_job_category (STRING) in workforce.requisition']
  employment_type varchar [note: 'Type of employment arrangement for the position being filled: full-time, part-time, contract, temporary, intern, or freelance. | Column employment_type (STRING) in workforce.requisition']
  equity_eligible boolean [note: 'Indicates whether the position is eligible for equity compensation such as stock options or restricted stock units. | Column equity_eligible (BOOLEAN) in workforce.requisition']
  flsa_classification varchar [note: 'FLSA classification indicating whether the position is exempt or non-exempt from overtime pay requirements. | Column flsa_classification (STRING) in workforce.requisition']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified the requisition record. | Column modified_by_user (STRING) in workforce.requisition']
  modified_timestamp timestamp [note: 'Timestamp when the requisition record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in workforce.requisition']
  number_of_openings varchar [note: 'Total number of positions to be filled under this requisition. Supports bulk hiring for multiple identical roles. | Column number_of_openings (INT) in workforce.requisition']
  open_date date [note: 'Date when the requisition was officially opened and made available for candidate sourcing and recruiting activities. | Column open_date (DATE) in workforce.requisition']
  openings_filled varchar [note: 'Number of positions that have been successfully filled and closed under this requisition. | Column openings_filled (INT) in workforce.requisition']
  posting_description varchar [note: 'Full job description text used in external job postings, including responsibilities, qualifications, and company information. | Column posting_description (STRING) in workforce.requisition']
  posting_title varchar [note: 'Public-facing job title used in job postings and external advertisements, which may differ from internal job profile title. | Column posting_title (STRING) in workforce.requisition']
  priority_level varchar [note: 'Business priority assigned to this requisition indicating urgency of filling the position. | Column priority_level (STRING) in workforce.requisition']
  remote_work_eligible boolean [note: 'Indicates whether the position allows remote or hybrid work arrangements. | Column remote_work_eligible (BOOLEAN) in workforce.requisition']
  requisition_number varchar [note: 'Business-facing unique requisition identifier used in HR systems and communications. Externally visible requisition code. | Column requisition_number (STRING) in workforce.requisition']
  requisition_status varchar [note: 'Current lifecycle status of the requisition indicating its stage in the talent acquisition pipeline. [ENUM-REF-CANDIDATE: draft|pending_approval|open|on_hold|filled|cancelled|closed — 7 candidates stripped; promote to reference product] | Column requisition_status (STRING) in workforce.requisition']
  requisition_type varchar [note: 'Classification of the requisition indicating whether it is for a new position, backfill of a departed employee, replacement, contract-to-hire conversion, internal transfer, or seasonal hire. | Column requisition_type (STRING) in workforce.requisition']
  salary_currency_code varchar [note: 'Three-letter ISO 4217 currency code for salary amounts (e.g., USD, GBP, EUR). | Column salary_currency_code (STRING) in workforce.requisition']
  salary_range_maximum decimal(15,2) [note: 'Maximum annual salary or hourly rate for the position, defining the upper bound of the compensation band. | Column salary_range_maximum (DECIMAL(15,2)) in workforce.requisition']
  salary_range_minimum decimal(15,2) [note: 'Minimum annual salary or hourly rate for the position, used for candidate expectations and budget planning. | Column salary_range_minimum (DECIMAL(15,2)) in workforce.requisition']
  security_clearance_required boolean [note: 'Indicates whether the position requires a security clearance or background check due to access to sensitive broadcast content or systems. | Column security_clearance_required (BOOLEAN) in workforce.requisition']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.requisition']
  sourcing_channels varchar [note: 'Comma-separated list of authorized sourcing channels for candidate recruitment (e.g., internal job board, LinkedIn, agency, referral, campus recruiting). | Column sourcing_channels (STRING) in workforce.requisition']
  target_start_date date [note: 'Desired start date for the new hire to begin employment. Used for workforce planning and onboarding preparation. | Column target_start_date (DATE) in workforce.requisition']
  travel_requirement_percentage varchar [note: 'Percentage of time the position requires business travel, expressed as an integer from 0 to 100. | Column travel_requirement_percentage (INT) in workforce.requisition']
  union_name varchar [note: 'Name of the labor union representing this position, if applicable (e.g., IATSE, SAG-AFTRA, NABET-CWA). | Column union_name (STRING) in workforce.requisition']
  union_position boolean [note: 'Indicates whether the position is covered by a collective bargaining agreement or union contract. | Column union_position (BOOLEAN) in workforce.requisition']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.requisition']

  Note: 'Transactional record of an approved job requisition opened to fill a position at Media Broadcasting — covering new hire requisitions, backfill requisitions, and contract-to-hire conversions. Captures requisition number, position reference, job profile, org unit, hiring manager, recruiter assigned, requisition type, approved headcount source, target start date, requisition open date, requisition status (open/on-hold/filled/cancelled), number of openings, and sourcing channels authorized. The SSOT for talent acquisition pipeline tracking. | Unity Catalog table: media_broadcasting_ecm.workforce.requisition'
}

Table workforce.applicant {
  applicant_id varchar [pk, note: 'Unique identifier for each job applicant who has applied to a Media Broadcasting requisition. Primary key for the applicant master record. | Column applicant_id (BIGINT) in workforce.applicant']
  referral_employee_id varchar [note: 'Employee ID of the internal staff member who referred this applicant. Nullable if not an employee referral. | Column referral_employee_id (BIGINT) in workforce.applicant']
  referred_by_applicant_id varchar [note: 'Self-referencing FK on applicant (referred_by_applicant_id) | Column referred_by_applicant_id (BIGINT) in workforce.applicant']
  requisition_id varchar [note: 'Reference to the job requisition this applicant applied for. Links to the open position posting. | Column requisition_id (BIGINT) in workforce.applicant']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.applicant']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.applicant']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.applicant']
  address_line1 varchar [note: 'First line of applicant\'s current residential address (street number and name). | Column address_line1 (STRING) in workforce.applicant']
  address_line2 varchar [note: 'Second line of applicant\'s address (apartment, suite, unit number). Nullable. | Column address_line2 (STRING) in workforce.applicant']
  alternate_phone_number varchar [note: 'Secondary contact phone number for the applicant. Optional backup contact method. | Column alternate_phone_number (STRING) in workforce.applicant']
  application_date date [note: 'Date when the applicant submitted their application for the requisition. Business event timestamp for application lifecycle. | Column application_date (DATE) in workforce.applicant']
  application_number varchar [note: 'Externally-visible unique application tracking number assigned when candidate submits application. Format: APP-YYYYMMDD-sequence. | Column application_number (STRING) in workforce.applicant']
  application_source varchar [note: 'Channel or platform through which the applicant submitted their application (e.g., LinkedIn, Indeed, employee referral, recruitment agency). | Column application_source (STRING) in workforce.applicant']
  application_status varchar [note: 'Current lifecycle status of the application in the recruitment workflow (e.g., new, screening, interviewed, offer extended, rejected). [ENUM-REF-CANDIDATE: new|screening|interview_scheduled|interviewed|offer_extended|offer_accepted|offer_declined|rejected|withdrawn — 9 candidates stripped; promote to reference product] | Column application_status (STRING) in workforce.applicant']
  background_check_consent boolean [note: 'Indicates whether the applicant has provided consent for a background check as part of the hiring process. Required for compliance. | Column background_check_consent (BOOLEAN) in workforce.applicant']
  city varchar [note: 'City or municipality of applicant\'s current residential address. | Column city (STRING) in workforce.applicant']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for applicant\'s current residential address (e.g., USA, GBR, CAN). | Column country_code (STRING) in workforce.applicant']
  cover_letter_reference varchar [note: 'Reference identifier or URI to the applicant\'s cover letter document. Nullable if not provided. | Column cover_letter_reference (STRING) in workforce.applicant']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.applicant']
  created_timestamp timestamp [note: 'Timestamp when the applicant record was first created in the ATS (Applicant Tracking System). Audit trail for record creation. | Column created_timestamp (TIMESTAMP) in workforce.applicant']
  current_employer varchar [note: 'Name of the organization where the applicant is currently employed. Nullable if unemployed or not disclosed. | Column current_employer (STRING) in workforce.applicant']
  current_job_title varchar [note: 'Job title or role the applicant currently holds at their present employer. Nullable if unemployed. | Column current_job_title (STRING) in workforce.applicant']
  degree_field varchar [note: 'Major or field of study for the applicant\'s highest degree (e.g., Communications, Journalism, Film Production, Business Administration). | Column degree_field (STRING) in workforce.applicant']
  desired_salary_amount decimal(12,2) [note: 'Salary amount the applicant is seeking for the position. Used for compensation alignment during offer stage. | Column desired_salary_amount (DECIMAL(12,2)) in workforce.applicant']
  desired_salary_currency varchar [note: 'Three-letter ISO 4217 currency code for the desired salary amount (e.g., USD, GBP, EUR). | Column desired_salary_currency (STRING) in workforce.applicant']
  disability_status varchar [note: 'Self-reported disability status for OFCCP Section 503 compliance reporting. Collected separately for accommodation and compliance purposes. | Column disability_status (STRING) in workforce.applicant']
  earliest_start_date date [note: 'Earliest date the applicant is available to begin employment if an offer is extended. | Column earliest_start_date (DATE) in workforce.applicant']
  eeoc_ethnicity varchar [note: 'Self-reported ethnicity for EEOC applicant flow reporting. Used for diversity and compliance tracking. | Column eeoc_ethnicity (STRING) in workforce.applicant']
  eeoc_gender varchar [note: 'Self-reported gender for EEOC applicant flow reporting. Collected separately from application data for compliance purposes. | Column eeoc_gender (STRING) in workforce.applicant']
  eeoc_race varchar [note: 'Self-reported race for EEOC applicant flow reporting. Collected for diversity and compliance tracking purposes. | Column eeoc_race (STRING) in workforce.applicant']
  email_address varchar [note: 'Primary email address for applicant communication throughout the recruitment process. | Column email_address (STRING) in workforce.applicant']
  highest_education_level varchar [note: 'Highest level of formal education completed by the applicant (e.g., high school, bachelor, master, doctorate). | Column highest_education_level (STRING) in workforce.applicant']
  last_modified_timestamp timestamp [note: 'Timestamp when the applicant record was last updated. Audit trail for tracking changes to application status or candidate information. | Column last_modified_timestamp (TIMESTAMP) in workforce.applicant']
  legal_first_name varchar [note: 'Applicant\'s legal first name as it appears on government-issued identification documents. | Column legal_first_name (STRING) in workforce.applicant']
  legal_last_name varchar [note: 'Applicant\'s legal last name (surname/family name) as it appears on government-issued identification. | Column legal_last_name (STRING) in workforce.applicant']
  legal_middle_name varchar [note: 'Applicant\'s legal middle name or initial. Nullable if not provided. | Column legal_middle_name (STRING) in workforce.applicant']
  phone_number varchar [note: 'Primary contact phone number for the applicant. Used for interview scheduling and recruitment communication. | Column phone_number (STRING) in workforce.applicant']
  postal_code varchar [note: 'Postal or ZIP code of applicant\'s current residential address. | Column postal_code (STRING) in workforce.applicant']
  preferred_name varchar [note: 'Name the applicant prefers to be called during the recruitment process. May differ from legal name. | Column preferred_name (STRING) in workforce.applicant']
  recruitment_agency_name varchar [note: 'Name of the external recruitment or staffing agency that sourced this applicant. Nullable if not agency-sourced. | Column recruitment_agency_name (STRING) in workforce.applicant']
  resume_document_reference varchar [note: 'Reference identifier or URI to the applicant\'s resume/CV document stored in the Media Asset Management (MAM) or document management system. | Column resume_document_reference (STRING) in workforce.applicant']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.applicant']
  state_province varchar [note: 'State, province, or region of applicant\'s current residential address. | Column state_province (STRING) in workforce.applicant']
  university_name varchar [note: 'Name of the educational institution where the applicant earned their highest degree. | Column university_name (STRING) in workforce.applicant']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.applicant']
  veteran_status varchar [note: 'Self-reported veteran status for OFCCP (Office of Federal Contract Compliance Programs) compliance reporting. | Column veteran_status (STRING) in workforce.applicant']
  willing_to_relocate boolean [note: 'Indicates whether the applicant is willing to relocate for the position if required. | Column willing_to_relocate (BOOLEAN) in workforce.applicant']
  work_authorization_status varchar [note: 'Applicant\'s legal authorization to work in the country where the position is located (e.g., citizen, permanent resident, work visa, requires sponsorship). | Column work_authorization_status (STRING) in workforce.applicant']
  years_of_experience decimal(4,1) [note: 'Total years of relevant professional work experience reported by the applicant. Used for qualification screening. | Column years_of_experience (DECIMAL(4,1)) in workforce.applicant']

  Note: 'Master record for each job applicant who has applied to a Media Broadcasting requisition — capturing candidate identity, contact information, application source (LinkedIn/Indeed/employee referral/agency), resume reference, application date, current employer, years of experience, highest education level, and consent to background check. Distinct from the employee master — applicants who are hired will have an employee record created upon onboarding. Supports ATS (Applicant Tracking System) integration and EEOC applicant flow reporting. | Unity Catalog table: media_broadcasting_ecm.workforce.applicant'
}

Table workforce.interview_event {
  interview_event_id varchar [pk, note: 'Unique identifier for each interview event conducted as part of the hiring process. | Column interview_event_id (BIGINT) in workforce.interview_event']
  applicant_id varchar [note: 'Reference to the candidate being interviewed for the position. | Column applicant_id (BIGINT) in workforce.interview_event']
  position_id varchar [note: 'Reference to the specific position being filled through this interview process. | Column position_id (BIGINT) in workforce.interview_event']
  primary_interviewer_employee_id varchar [note: 'Reference to the lead interviewer responsible for conducting and documenting this interview. | Column primary_interviewer_employee_id (BIGINT) in workforce.interview_event']
  requisition_id varchar [note: 'Reference to the job requisition for which this interview is being conducted. | Column requisition_id (BIGINT) in workforce.interview_event']
  rescheduled_interview_event_id varchar [note: 'Self-referencing FK on interview_event (rescheduled_interview_event_id) | Column rescheduled_interview_event_id (BIGINT) in workforce.interview_event']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.interview_event']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.interview_event']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.interview_event']
  actual_end_time timestamp [note: 'The actual date and time when the interview concluded. | Column actual_end_time (TIMESTAMP) in workforce.interview_event']
  actual_start_time timestamp [note: 'The actual date and time when the interview began, which may differ from scheduled time. | Column actual_start_time (TIMESTAMP) in workforce.interview_event']
  advance_to_next_round boolean [note: 'Indicates whether the candidate should proceed to the next interview round based on this interview\'s outcome. | Column advance_to_next_round (BOOLEAN) in workforce.interview_event']
  assessment_completion_time_minutes varchar [note: 'Time taken by the candidate to complete any technical assessment or skills test, measured in minutes. | Column assessment_completion_time_minutes (INT) in workforce.interview_event']
  assessment_score decimal(5,2) [note: 'Numerical score from any technical assessment, coding challenge, or skills test administered during the interview. | Column assessment_score (DECIMAL(5,2)) in workforce.interview_event']
  cancellation_reason varchar [note: 'Explanation for why the interview was cancelled or rescheduled, if applicable. | Column cancellation_reason (STRING) in workforce.interview_event']
  candidate_consent_recorded boolean [note: 'Indicates whether the candidate provided consent for interview recording and data processing in compliance with privacy regulations. | Column candidate_consent_recorded (BOOLEAN) in workforce.interview_event']
  communication_skills_rating decimal(3,2) [note: 'Evaluation of the candidate\'s verbal and written communication abilities during the interview. | Column communication_skills_rating (DECIMAL(3,2)) in workforce.interview_event']
  concerns_summary varchar [note: 'Summary of any concerns, weaknesses, or red flags identified during the interview process. | Column concerns_summary (STRING) in workforce.interview_event']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.interview_event']
  created_timestamp timestamp [note: 'Date and time when this interview event record was first created in the system. | Column created_timestamp (TIMESTAMP) in workforce.interview_event']
  cultural_fit_rating decimal(3,2) [note: 'Assessment of how well the candidate aligns with Media Broadcasting\'s organizational culture and values. | Column cultural_fit_rating (DECIMAL(3,2)) in workforce.interview_event']
  duration_minutes varchar [note: 'Total length of the interview in minutes, calculated from actual start and end times. | Column duration_minutes (INT) in workforce.interview_event']
  feedback_notes varchar [note: 'Detailed qualitative feedback and observations recorded by the interviewer(s) regarding the candidate\'s performance, strengths, and areas of concern. | Column feedback_notes (STRING) in workforce.interview_event']
  feedback_submitted_timestamp timestamp [note: 'Date and time when the interviewer submitted their feedback and ratings for this interview. | Column feedback_submitted_timestamp (TIMESTAMP) in workforce.interview_event']
  hire_recommendation varchar [note: 'Interviewer\'s recommendation on whether to proceed with hiring this candidate. | Column hire_recommendation (STRING) in workforce.interview_event']
  interview_format varchar [note: 'Delivery method used to conduct the interview (phone, video conference, in-person meeting, or hybrid). | Column interview_format (STRING) in workforce.interview_event']
  interview_location varchar [note: 'Physical location, office address, or virtual meeting platform where the interview was conducted. | Column interview_location (STRING) in workforce.interview_event']
  interview_panel_size varchar [note: 'Total number of interviewers participating in this interview event. | Column interview_panel_size (INT) in workforce.interview_event']
  interview_recording_available boolean [note: 'Indicates whether a recording of the interview is available for review, subject to consent and compliance requirements. | Column interview_recording_available (BOOLEAN) in workforce.interview_event']
  interview_round_number varchar [note: 'Sequential number indicating which round of interviews this represents in the hiring process (e.g., 1 for phone screen, 2 for panel interview, 3 for executive interview). | Column interview_round_number (INT) in workforce.interview_event']
  interview_status varchar [note: 'Current lifecycle status of the interview event itself. | Column interview_status (STRING) in workforce.interview_event']
  interview_type varchar [note: 'Classification of the interview format and purpose conducted during this event. | Column interview_type (STRING) in workforce.interview_event']
  interviewer_calibration_session varchar [note: 'Reference to any calibration session where this interview was reviewed to ensure consistent evaluation standards across hiring panels. | Column interviewer_calibration_session (STRING) in workforce.interview_event']
  last_modified_timestamp timestamp [note: 'Date and time when this interview event record was most recently updated. | Column last_modified_timestamp (TIMESTAMP) in workforce.interview_event']
  modified_by_user varchar [note: 'Identifier of the user or system that last modified this interview event record. | Column modified_by_user (STRING) in workforce.interview_event']
  overall_rating decimal(3,2) [note: 'Composite numerical rating assigned to the candidate based on interview performance, typically on a scale (e.g., 1.00 to 5.00). | Column overall_rating (DECIMAL(3,2)) in workforce.interview_event']
  scheduled_date date [note: 'The date on which the interview was originally scheduled to occur. | Column scheduled_date (DATE) in workforce.interview_event']
  scheduled_end_time timestamp [note: 'The precise date and time when the interview was scheduled to conclude. | Column scheduled_end_time (TIMESTAMP) in workforce.interview_event']
  scheduled_start_time timestamp [note: 'The precise date and time when the interview was scheduled to begin. | Column scheduled_start_time (TIMESTAMP) in workforce.interview_event']
  scheduling_status varchar [note: 'Current state of the interview scheduling and execution process. | Column scheduling_status (STRING) in workforce.interview_event']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.interview_event']
  strengths_summary varchar [note: 'Summary of the candidate\'s key strengths and positive attributes identified during the interview. | Column strengths_summary (STRING) in workforce.interview_event']
  technical_competency_rating decimal(3,2) [note: 'Rating of the candidate\'s technical skills and job-specific competencies demonstrated during the interview. | Column technical_competency_rating (DECIMAL(3,2)) in workforce.interview_event']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.interview_event']
  video_conference_link varchar [note: 'URL or meeting link for virtual interviews conducted via video conferencing platforms. | Column video_conference_link (STRING) in workforce.interview_event']

  Note: 'Transactional record of each interview conducted as part of a Media Broadcasting hiring process — phone screens, video interviews, panel interviews, technical assessments, and executive interviews. Captures interview date, interview type, interviewer(s), applicant reference, requisition reference, interview format (phone/video/in-person), interview scorecard rating, hire/no-hire recommendation, feedback notes, and scheduling status. Enables structured interview process tracking and interviewer calibration across hiring panels. | Unity Catalog table: media_broadcasting_ecm.workforce.interview_event'
}

Table workforce.onboarding_task {
  onboarding_task_id varchar [pk, note: 'Unique identifier for each onboarding task assigned to a new hire or rehire at Media Broadcasting. Primary key for the onboarding task record. | Column onboarding_task_id (BIGINT) in workforce.onboarding_task']
  onboarding_dependency_task_id varchar [note: 'Reference to another onboarding task that must be completed before this task can begin. Null if this task has no prerequisites. Enables sequencing of onboarding activities (e.g., system access setup depends on background check clearance). | Column dependency_task_id (BIGINT) in workforce.onboarding_task']
  org_unit_id varchar [note: 'Reference to the organizational unit (department, division, business unit) for which this onboarding task is being performed. Links to the org_unit master record to provide organizational context. | Column org_unit_id (BIGINT) in workforce.onboarding_task']
  position_id varchar [note: 'Reference to the position being filled by the new hire. Links to the position master record to provide organizational context for the onboarding task. | Column position_id (BIGINT) in workforce.onboarding_task']
  primary_onboarding_employee_id varchar [note: 'Reference to the employee (new hire or rehire) to whom this onboarding task is assigned. Links to the employee master record. | Column primary_onboarding_employee_id (BIGINT) in workforce.onboarding_task']
  primary_prerequisite_onboarding_task_id varchar [note: 'Self-referencing FK on onboarding_task (prerequisite_onboarding_task_id) | Column prerequisite_onboarding_task_id (BIGINT) in workforce.onboarding_task']
  tertiary_onboarding_completed_by_employee_id varchar [note: 'Reference to the employee who actually completed the task. May differ from assigned owner if task was delegated or reassigned. Links to the employee master record. | Column tertiary_onboarding_completed_by_employee_id (BIGINT) in workforce.onboarding_task']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.onboarding_task']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.onboarding_task']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.onboarding_task']
  actual_hours decimal(5,2) [note: 'Actual number of hours spent completing this onboarding task. Used to refine future estimates and identify process improvement opportunities. | Column actual_hours (DECIMAL(5,2)) in workforce.onboarding_task']
  approval_date date [note: 'Date when the task completion was approved by the designated approver. Null if approval is not required or not yet granted. | Column approval_date (DATE) in workforce.onboarding_task']
  approval_required_flag boolean [note: 'Boolean flag indicating whether this task requires manager or HR approval before being marked as completed. True for tasks with compliance or security implications (e.g., system access setup, background check clearance). | Column approval_required_flag (BOOLEAN) in workforce.onboarding_task']
  assigned_date date [note: 'Date when the onboarding task was assigned to the employee and owner. Typically triggered by hire date confirmation or completion of a prerequisite task. | Column assigned_date (DATE) in workforce.onboarding_task']
  assigned_owner_role varchar [note: 'Functional role of the person assigned to complete this onboarding task. Indicates which department or function is responsible for task execution. [ENUM-REF-CANDIDATE: hr_specialist|it_administrator|hiring_manager|facilities_coordinator|training_coordinator|union_representative|payroll_administrator — 7 candidates stripped; promote to reference product] | Column assigned_owner_role (STRING) in workforce.onboarding_task']
  completion_date date [note: 'Actual date when the onboarding task was completed successfully. Null if task is not yet completed. Used to calculate onboarding cycle time and identify overdue tasks. | Column completion_date (DATE) in workforce.onboarding_task']
  completion_timestamp timestamp [note: 'Precise timestamp when the onboarding task was marked as completed in the system. Provides audit trail for compliance reporting and Service Level Agreement (SLA) tracking. | Column completion_timestamp (TIMESTAMP) in workforce.onboarding_task']
  compliance_requirement_code varchar [note: 'Code identifying the regulatory or compliance requirement that mandates this onboarding task (e.g., IRCA for I-9 verification, FCC for broadcast license verification, OSHA for safety training, GDPR for data privacy training). Null for non-compliance tasks. | Column compliance_requirement_code (STRING) in workforce.onboarding_task']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.onboarding_task']
  created_by_user varchar [note: 'User ID or system account that created this onboarding task record. Provides audit trail for record creation. | Column created_by_user (STRING) in workforce.onboarding_task']
  created_timestamp timestamp [note: 'Timestamp when this onboarding task record was first created in the system. Provides audit trail for record creation. | Column created_timestamp (TIMESTAMP) in workforce.onboarding_task']
  documentation_url varchar [note: 'URL or file path to supporting documentation, forms, or instructions for completing this onboarding task. May link to internal knowledge base, policy documents, or training materials. | Column documentation_url (STRING) in workforce.onboarding_task']
  due_date date [note: 'Target date by which the onboarding task must be completed. Calculated based on hire date, task priority, and regulatory requirements (e.g., I-9 must be completed within 3 business days of hire date per federal law). | Column due_date (DATE) in workforce.onboarding_task']
  estimated_hours decimal(5,2) [note: 'Estimated number of hours required to complete this onboarding task. Used for workload planning and resource allocation across HR, IT, and facilities teams. | Column estimated_hours (DECIMAL(5,2)) in workforce.onboarding_task']
  is_blocking_task boolean [note: 'Boolean flag indicating whether this task must be completed before subsequent onboarding tasks can begin. True for critical path tasks (e.g., I-9 verification, background check clearance, system access setup); false for tasks that can proceed in parallel. | Column is_blocking_task (BOOLEAN) in workforce.onboarding_task']
  is_mandatory boolean [note: 'Boolean flag indicating whether this task is mandatory for all new hires (true) or optional/role-specific (false). Mandatory tasks include I-9 verification, benefits enrollment, compliance training; optional tasks may include union card processing (union positions only) or specialized equipment provisioning. | Column is_mandatory (BOOLEAN) in workforce.onboarding_task']
  last_modified_by_user varchar [note: 'User ID or system account that last modified this onboarding task record. Provides audit trail for record modifications. | Column last_modified_by_user (STRING) in workforce.onboarding_task']
  last_modified_timestamp timestamp [note: 'Timestamp when this onboarding task record was last updated. Provides audit trail for record modifications. | Column last_modified_timestamp (TIMESTAMP) in workforce.onboarding_task']
  notes varchar [note: 'Free-text field for additional notes, comments, or special instructions related to this onboarding task. May include reasons for delays, exceptions granted, or coordination details. | Column notes (STRING) in workforce.onboarding_task']
  priority_level varchar [note: 'Priority level indicating urgency and importance of the onboarding task. Critical tasks (e.g., I-9 verification) must be completed before employee can start work; high priority tasks should be completed within first week; medium and low priority tasks have more flexible timelines. | Column priority_level (STRING) in workforce.onboarding_task']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.onboarding_task']
  start_date date [note: 'Actual date when work on the onboarding task began. May differ from assigned date if task was queued or awaiting prerequisite completion. | Column start_date (DATE) in workforce.onboarding_task']
  task_category varchar [note: 'High-level category grouping onboarding tasks by functional area: compliance (I-9, background checks), hr_administration (benefits enrollment, payroll setup), it_provisioning (system access, equipment), facilities (badge, workspace), training (orientation, safety, compliance), union_processing (union card, dues setup). | Column task_category (STRING) in workforce.onboarding_task']
  task_code varchar [note: 'Standardized code identifying the type of onboarding task (e.g., I9_VERIFY, BG_CHECK, EQUIP_PROV, SYS_ACCESS, BENEFITS_ENROLL, COMPLIANCE_TRAIN, FACILITY_ORIENT, UNION_CARD). Used for task categorization and reporting. | Column task_code (STRING) in workforce.onboarding_task']
  task_description varchar [note: 'Detailed description of the onboarding task, including specific actions required, documentation needed, and any special instructions for completion. | Column task_description (STRING) in workforce.onboarding_task']
  task_name varchar [note: 'Human-readable name of the onboarding task (e.g., I-9 Employment Eligibility Verification, Background Check Clearance, Equipment Provisioning, System Access Setup, Benefits Enrollment, Mandatory Compliance Training, Broadcast Facility Orientation, Union Card Processing). | Column task_name (STRING) in workforce.onboarding_task']
  task_status varchar [note: 'Current lifecycle status of the onboarding task: not_started (assigned but not yet begun), in_progress (actively being worked), pending_approval (awaiting manager or HR approval), completed (finished successfully), cancelled (no longer required), blocked (cannot proceed due to dependency or issue). | Column task_status (STRING) in workforce.onboarding_task']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.onboarding_task']

  Note: 'Transactional record tracking each onboarding task assigned to a new hire or rehire at Media Broadcasting — I-9 verification, background check clearance, equipment provisioning, system access setup, benefits enrollment, mandatory compliance training, broadcast facility orientation, and union card processing. Captures task name, task category, assigned owner (HR/IT/manager), due date, completion date, completion status, and blocking flag (whether subsequent tasks depend on this one). Ensures consistent onboarding across all Media Broadcasting locations and business units. | Unity Catalog table: media_broadcasting_ecm.workforce.onboarding_task'
}

Table workforce.union_membership {
  union_membership_id varchar [pk, note: 'Unique identifier for the union membership record. Primary key for tracking each employee\'s union affiliation within Media Broadcasting. | Column union_membership_id (BIGINT) in workforce.union_membership']
  employee_id varchar [note: 'Reference to the Media Broadcasting employee who holds this union membership. Links to the workforce employee master record. | Column employee_id (BIGINT) in workforce.union_membership']
  prior_union_membership_id varchar [note: 'Self-referencing FK on union_membership (prior_union_membership_id) | Column prior_union_membership_id (BIGINT) in workforce.union_membership']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.union_membership']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.union_membership']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.union_membership']
  bargaining_unit_code varchar [note: 'Code identifying the specific bargaining unit to which this employee belongs. A bargaining unit is a group of employees with a clear community of interest who are represented by a union for collective bargaining purposes. Large employers may have multiple bargaining units for different job families, locations, or divisions. | Column bargaining_unit_code (STRING) in workforce.union_membership']
  cba_effective_start_date date [note: 'Date when the current collective bargaining agreement became effective and binding. CBAs are typically negotiated for multi-year terms and this date marks the beginning of the current contract period. | Column cba_effective_start_date (DATE) in workforce.union_membership']
  cba_expiration_date date [note: 'Date when the current collective bargaining agreement expires. Negotiations for a successor agreement typically begin 60-90 days before expiration. If no new agreement is reached, the existing CBA may be extended or employees may work under the expired contract terms while negotiations continue. | Column cba_expiration_date (DATE) in workforce.union_membership']
  cba_reference_code varchar [note: 'Reference code or identifier for the specific collective bargaining agreement that governs this employee\'s terms and conditions of employment. Multiple CBAs may exist for different unions, job classifications, or facilities within Media Broadcasting. | Column cba_reference_code (STRING) in workforce.union_membership']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.union_membership']
  created_timestamp timestamp [note: 'Timestamp when this union membership record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in workforce.union_membership']
  dues_deduction_amount decimal(10,2) [note: 'Amount of union dues deducted from the employee\'s paycheck each pay period. May be a flat amount or a percentage of gross earnings as specified in the collective bargaining agreement. Null if dues deduction is not authorized. | Column dues_deduction_amount (DECIMAL(10,2)) in workforce.union_membership']
  dues_deduction_authorized boolean [note: 'Indicates whether the employee has authorized automatic payroll deduction of union dues. True means the employee has signed a dues checkoff authorization form and Media Broadcasting deducts dues from each paycheck and remits to the union. False means the employee pays dues directly to the union. | Column dues_deduction_authorized (BOOLEAN) in workforce.union_membership']
  dues_deduction_frequency varchar [note: 'Frequency at which union dues are deducted from the employee\'s paycheck. Must align with the employee\'s pay frequency and union requirements. | Column dues_deduction_frequency (STRING) in workforce.union_membership']
  fair_share_fee_payer boolean [note: 'Indicates whether the employee pays a fair share or agency fee rather than full union dues. In some jurisdictions and under some CBAs, non-members who are covered by the union contract must pay a fee to cover the cost of representation, but this fee is typically lower than full membership dues. This practice varies by state right-to-work laws and recent Supreme Court rulings. | Column fair_share_fee_payer (BOOLEAN) in workforce.union_membership']
  grievance_eligible boolean [note: 'Indicates whether the employee is eligible to file grievances under the collective bargaining agreement\'s grievance and arbitration procedures. True for members in good standing. False for employees in probationary periods, suspended members, or those who have opted out of union representation where permitted by law. | Column grievance_eligible (BOOLEAN) in workforce.union_membership']
  health_welfare_plan_participant boolean [note: 'Indicates whether the employee participates in a union-sponsored health and welfare benefit plan. Many unions maintain multi-employer health plans that provide medical, dental, vision, and other benefits funded by employer contributions. | Column health_welfare_plan_participant (BOOLEAN) in workforce.union_membership']
  initiation_fee_amount decimal(10,2) [note: 'One-time initiation fee paid by the employee when joining the union. This fee covers administrative costs of processing the membership application and is typically specified in the union constitution. May be paid in a lump sum or through payroll deduction installments. | Column initiation_fee_amount (DECIMAL(10,2)) in workforce.union_membership']
  initiation_fee_paid_date date [note: 'Date when the employee completed payment of the union initiation fee. Membership may not be fully active until this fee is paid in full. | Column initiation_fee_paid_date (DATE) in workforce.union_membership']
  job_classification_code varchar [note: 'Union job classification code that determines the employee\'s pay scale, work rules, and benefits under the collective bargaining agreement. Job classifications define specific roles, skill levels, and wage rates negotiated between the union and employer. | Column job_classification_code (STRING) in workforce.union_membership']
  job_classification_title varchar [note: 'Descriptive title of the union job classification under which the employee is covered. Examples include Camera Operator, Audio Engineer, Production Assistant, Broadcast Technician, Grip, Electrician, Driver, etc. This may differ from the employee\'s official job title in HR systems. | Column job_classification_title (STRING) in workforce.union_membership']
  last_dues_payment_date date [note: 'Date of the most recent union dues payment received from or on behalf of this employee. Used to track dues currency and membership good standing status. | Column last_dues_payment_date (DATE) in workforce.union_membership']
  last_modified_timestamp timestamp [note: 'Timestamp when this union membership record was most recently updated. Used for audit trail, change tracking, and data synchronization. | Column last_modified_timestamp (TIMESTAMP) in workforce.union_membership']
  membership_end_date date [note: 'Date when the employee\'s union membership ended, either through withdrawal, termination of employment, or conversion to retired status. Null for active memberships. | Column membership_end_date (DATE) in workforce.union_membership']
  membership_initiation_date date [note: 'Date when the employee was formally initiated into union membership and became a full member. This may differ from the hire date if there was a probationary period or if the employee joined the union after starting employment. | Column membership_initiation_date (DATE) in workforce.union_membership']
  membership_status varchar [note: 'Current status of the employee\'s union membership. Active indicates full membership in good standing with dues current. Inactive indicates membership has lapsed or employee is on leave. Suspended indicates temporary suspension due to disciplinary action or non-payment. Pending indicates application submitted but not yet approved. Withdrawn indicates voluntary resignation from union. Retired indicates membership converted to retired status. | Column membership_status (STRING) in workforce.union_membership']
  modified_by_user varchar [note: 'User ID or system identifier of the person or process that last modified this union membership record. Used for audit trail and accountability. | Column modified_by_user (STRING) in workforce.union_membership']
  notes varchar [note: 'Free-text field for additional notes, comments, or special circumstances related to this union membership. May include information about dues payment arrangements, membership transfers, special accommodations, or historical context. | Column notes (STRING) in workforce.union_membership']
  pension_plan_participant boolean [note: 'Indicates whether the employee participates in a union-sponsored pension or retirement plan. Many unions, particularly in broadcasting and entertainment, maintain multi-employer pension plans funded by employer contributions negotiated in the CBA. | Column pension_plan_participant (BOOLEAN) in workforce.union_membership']
  probationary_period_end_date date [note: 'Date when the employee\'s probationary period under the collective bargaining agreement ends. During probation, employees may have limited rights and protections. After probation ends, employees typically gain full seniority rights, just cause protection, and full grievance rights. | Column probationary_period_end_date (DATE) in workforce.union_membership']
  right_to_work_state boolean [note: 'Indicates whether the employee works in a right-to-work state where union membership and dues payment cannot be required as a condition of employment. This affects whether union security clauses in the CBA apply to this employee. | Column right_to_work_state (BOOLEAN) in workforce.union_membership']
  seniority_date date [note: 'Date used to calculate the employee\'s seniority for purposes of layoffs, recalls, shift bidding, vacation scheduling, and other seniority-based rights under the collective bargaining agreement. May be the original hire date or adjusted for breaks in service. | Column seniority_date (DATE) in workforce.union_membership']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.union_membership']
  union_local_number varchar [note: 'The local chapter or lodge number of the union to which the employee belongs. Local unions represent members in specific geographic regions or facilities and handle local grievances and contract administration. | Column union_local_number (STRING) in workforce.union_membership']
  union_member_number varchar [note: 'Unique member identification number assigned by the union to this employee. This ID is used for union records, benefit claims, and communications. Different from the employee_id which is Media Broadcasting\'s internal identifier. | Column union_member_number (STRING) in workforce.union_membership']
  union_name varchar [note: 'Name of the labor union or guild to which the employee belongs. Primary unions for Media Broadcasting staff include NABET-CWA (National Association of Broadcast Employees and Technicians - Communications Workers of America) for broadcast engineers and technicians, SAG-AFTRA (Screen Actors Guild - American Federation of Television and Radio Artists) for on-air talent, WGA (Writers Guild of America) for writers, IATSE (International Alliance of Theatrical Stage Employees) for production crew, Teamsters for drivers and facilities staff, and DGA (Directors Guild of America) for directors. | Column union_name (STRING) in workforce.union_membership']
  union_steward_flag boolean [note: 'Indicates whether the employee serves as a union steward or shop steward. Union stewards are elected or appointed members who represent fellow workers in grievances, workplace disputes, and contract enforcement. Stewards have special protections under labor law and may have release time for union duties. | Column union_steward_flag (BOOLEAN) in workforce.union_membership']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.union_membership']

  Note: 'Master record tracking each Media Broadcasting employee\'s union membership and collective bargaining agreement (CBA) affiliation — NABET-CWA (broadcast engineers/technicians), SAG-AFTRA (on-air staff), WGA (writers), IATSE (production crew), and Teamsters (drivers/facilities). Captures union name, local number, membership status, initiation date, dues deduction authorization, CBA reference, job classification under CBA, and grievance eligibility. Distinct from talent guild affiliations in the talent domain — this covers internal staff union membership only. | Unity Catalog table: media_broadcasting_ecm.workforce.union_membership'
}

Table workforce.separation_record {
  separation_record_id varchar [pk, note: 'Unique identifier for the employee separation record. Primary key for the separation_record product. | Column separation_record_id (BIGINT) in workforce.separation_record']
  org_unit_id varchar [note: 'Reference to the organizational unit (department, division) the employee belonged to at separation. | Column org_unit_id (BIGINT) in workforce.separation_record']
  position_id varchar [note: 'Reference to the position the employee held at the time of separation. | Column position_id (BIGINT) in workforce.separation_record']
  primary_separation_employee_id varchar [note: 'Reference to the employee who is separating from Media Broadcasting. Links to the employee master record. | Column primary_separation_employee_id (BIGINT) in workforce.separation_record']
  prior_separation_record_id varchar [note: 'Self-referencing FK on separation_record (prior_separation_record_id) | Column prior_separation_record_id (BIGINT) in workforce.separation_record']
  quaternary_quinary_separation_approved_by_employee_id varchar [note: 'Reference to the manager or HR leader who approved the separation. Null if not yet approved. | Column quinary_separation_approved_by_employee_id (BIGINT) in workforce.separation_record']
  tertiary_quaternary_separation_initiated_by_employee_id varchar [note: 'Reference to the employee or HR user who initiated the separation record in the system. | Column quaternary_separation_initiated_by_employee_id (BIGINT) in workforce.separation_record']
  tertiary_separation_hr_business_partner_employee_id varchar [note: 'Reference to the HR business partner who managed the separation process and documentation. | Column tertiary_separation_hr_business_partner_employee_id (BIGINT) in workforce.separation_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.separation_record']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.separation_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.separation_record']
  approval_date date [note: 'The date the separation was formally approved by the authorized manager or HR leader. | Column approval_date (DATE) in workforce.separation_record']
  badge_access_revocation_date date [note: 'The date physical building access badges and credentials were deactivated. Important for facility security. | Column badge_access_revocation_date (DATE) in workforce.separation_record']
  cobra_eligible_flag boolean [note: 'Indicates whether the employee is eligible for COBRA health insurance continuation coverage under federal law. | Column cobra_eligible_flag (BOOLEAN) in workforce.separation_record']
  cobra_notification_date date [note: 'The date COBRA continuation coverage notification was sent to the employee. Required within 14 days of separation for compliance. | Column cobra_notification_date (DATE) in workforce.separation_record']
  cost_center_code varchar [note: 'The cost center the employee was assigned to at the time of separation. Used for financial reporting and workforce analytics. | Column cost_center_code (STRING) in workforce.separation_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.separation_record']
  created_timestamp timestamp [note: 'The timestamp when this separation record was first created in the system. Audit trail for record creation. | Column created_timestamp (TIMESTAMP) in workforce.separation_record']
  equipment_return_date date [note: 'The date all company equipment was returned by the employee. Null if equipment has not been fully returned. | Column equipment_return_date (DATE) in workforce.separation_record']
  equipment_return_status varchar [note: 'Status of company equipment return: all returned (complete), partially returned (some items outstanding), not returned (no items returned), or not applicable (no equipment issued). | Column equipment_return_status (STRING) in workforce.separation_record']
  exit_interview_completed_flag boolean [note: 'Indicates whether an exit interview was conducted with the departing employee. True if completed, False if not completed or declined. | Column exit_interview_completed_flag (BOOLEAN) in workforce.separation_record']
  exit_interview_date date [note: 'The date the exit interview was conducted. Null if no exit interview was completed. | Column exit_interview_date (DATE) in workforce.separation_record']
  exit_interview_sentiment varchar [note: 'Overall sentiment classification from the exit interview: positive (employee left on good terms), neutral (professional departure), negative (employee expressed dissatisfaction), or not applicable (no interview conducted). | Column exit_interview_sentiment (STRING) in workforce.separation_record']
  exit_interview_summary varchar [note: 'Summary of key themes and feedback from the exit interview. Confidential HR information used for organizational improvement. | Column exit_interview_summary (STRING) in workforce.separation_record']
  final_paycheck_amount decimal(15,2) [note: 'Total gross amount of the final paycheck before deductions. Includes regular pay, accrued PTO payout, and any other final compensation. | Column final_paycheck_amount (DECIMAL(15,2)) in workforce.separation_record']
  final_paycheck_date date [note: 'The date the employee\'s final paycheck was issued, including all outstanding wages, accrued paid time off, and other compensation. | Column final_paycheck_date (DATE) in workforce.separation_record']
  last_modified_timestamp timestamp [note: 'The timestamp when this separation record was last updated. Audit trail for tracking changes. | Column last_modified_timestamp (TIMESTAMP) in workforce.separation_record']
  last_working_date date [note: 'The last date the employee physically worked or performed duties. May differ from separation date if employee is on garden leave or paid time off during notice period. | Column last_working_date (DATE) in workforce.separation_record']
  non_compete_agreement_flag boolean [note: 'Indicates whether the employee is bound by a non-compete agreement that restricts employment with competitors for a specified period. | Column non_compete_agreement_flag (BOOLEAN) in workforce.separation_record']
  non_compete_expiry_date date [note: 'The date the non-compete agreement expires and the employee is free to work for competitors. Null if no non-compete exists. | Column non_compete_expiry_date (DATE) in workforce.separation_record']
  non_disclosure_agreement_flag boolean [note: 'Indicates whether the employee is bound by a non-disclosure agreement protecting Media Broadcasting\'s confidential information and trade secrets. | Column non_disclosure_agreement_flag (BOOLEAN) in workforce.separation_record']
  notes varchar [note: 'Free-text field for additional confidential notes, special circumstances, or instructions related to the separation. | Column notes (STRING) in workforce.separation_record']
  notice_date date [note: 'The date the employee or employer provided notice of the separation. May be null for immediate terminations or unexpected events. | Column notice_date (DATE) in workforce.separation_record']
  notice_period_days varchar [note: 'Number of days between notice date and separation date. Used to track compliance with contractual notice requirements. | Column notice_period_days (INT) in workforce.separation_record']
  rehire_eligibility_flag boolean [note: 'Indicates whether the employee is eligible for rehire at Media Broadcasting. True if eligible, False if ineligible due to performance, conduct, or policy violations. | Column rehire_eligibility_flag (BOOLEAN) in workforce.separation_record']
  rehire_eligibility_reason varchar [note: 'Explanation for the rehire eligibility determination. Confidential HR information documenting the basis for the decision. | Column rehire_eligibility_reason (STRING) in workforce.separation_record']
  separation_date date [note: 'The official date the employee\'s employment relationship with Media Broadcasting ended. Last day of active employment. | Column separation_date (DATE) in workforce.separation_record']
  separation_number varchar [note: 'Business-facing unique identifier for the separation event, used in HR documentation and communications. Format: SEP-YYYYNNNN. | Column separation_number (STRING) in workforce.separation_record']
  separation_reason_code varchar [note: 'Detailed reason code for the separation, providing granular classification beyond separation type (e.g., performance, relocation, better opportunity, misconduct, reduction in force). | Column separation_reason_code (STRING) in workforce.separation_record']
  separation_reason_description varchar [note: 'Free-text description providing additional context and details about the separation reason. Confidential business information. | Column separation_reason_description (STRING) in workforce.separation_record']
  separation_status varchar [note: 'Current workflow status of the separation record: initiated, pending approval, approved, processing (offboarding in progress), completed (all tasks done), or cancelled. | Column separation_status (STRING) in workforce.separation_record']
  separation_type varchar [note: 'High-level classification of the separation event: voluntary resignation, involuntary termination, retirement, layoff, end of contract, or death. | Column separation_type (STRING) in workforce.separation_record']
  severance_amount decimal(15,2) [note: 'Total severance payment amount provided to the employee. Null if no severance was offered or employee was ineligible. | Column severance_amount (DECIMAL(15,2)) in workforce.separation_record']
  severance_eligible_flag boolean [note: 'Indicates whether the employee is eligible for a severance package based on separation type, tenure, and company policy. | Column severance_eligible_flag (BOOLEAN) in workforce.separation_record']
  severance_payment_date date [note: 'The date the severance payment was issued to the employee. Null if no severance was provided. | Column severance_payment_date (DATE) in workforce.separation_record']
  severance_weeks decimal(5,2) [note: 'Number of weeks of pay provided as severance, typically calculated based on tenure and position level. | Column severance_weeks (DECIMAL(5,2)) in workforce.separation_record']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.separation_record']
  system_access_revocation_date date [note: 'The date all system access, credentials, and permissions were revoked for the employee. Critical for security and compliance. | Column system_access_revocation_date (DATE) in workforce.separation_record']
  unemployment_claim_filed_flag boolean [note: 'Indicates whether the employee filed for unemployment benefits following separation. Used for tracking and responding to claims. | Column unemployment_claim_filed_flag (BOOLEAN) in workforce.separation_record']
  unemployment_claim_status varchar [note: 'Current status of the unemployment benefits claim: approved, denied, pending review, contested by employer, or not filed. | Column unemployment_claim_status (STRING) in workforce.separation_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.separation_record']

  Note: 'Transactional record capturing the full details of an employee\'s separation from Media Broadcasting — voluntary resignation, involuntary termination, retirement, layoff, end of contract, or death. Captures separation date, separation type, separation reason code, exit interview completion flag, exit interview sentiment, rehire eligibility flag, final paycheck date, severance package details, non-compete agreement flag, equipment return status, system access revocation date, and COBRA notification date. The authoritative offboarding record feeding payroll final settlement and IT deprovisioning. | Unity Catalog table: media_broadcasting_ecm.workforce.separation_record'
}

Table workforce.course_requirement {
  course_requirement_id varchar [pk, note: 'Unique identifier for this course requirement record. Primary key. | Column course_requirement_id (BIGINT) in workforce.course_requirement']
  job_profile_id varchar [note: 'Foreign key linking to the job profile that has this training course requirement. | Column job_profile_id (BIGINT) in workforce.course_requirement']
  training_course_id varchar [note: 'Foreign key linking to the training course that is required or recommended for the job profile. | Column training_course_id (BIGINT) in workforce.course_requirement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.course_requirement']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.course_requirement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.course_requirement']
  applicable_job_profiles varchar [note: 'Comma-separated list of job roles, job families, or organizational units for which this training course is applicable or required (e.g., Broadcast Engineers, Content Producers, Ad Sales Representatives, All Employees). Used to auto-assign training to employees based on their job profile. [Moved from training_course: This denormalized STRING field in training_course contains a comma-separated list of job profiles for which the course is applicable. This is the exact relationship data that should be normalized into the course_requirement association, where each job profile becomes a separate record with its own requirement attributes (is_mandatory, completion_deadline_days, etc.). The denormalized field proves the business operates this way but lacks proper normalization.] | Column applicable_job_profiles (STRING) in workforce.course_requirement']
  completion_deadline_days varchar [note: 'Number of days from hire date or role assignment by which the employee must complete this training course. Used for onboarding and compliance tracking. | Column completion_deadline_days (INT) in workforce.course_requirement']
  completion_order_sequence varchar [note: 'Recommended or required sequence order for completing this course relative to other courses for this job profile. Supports learning path design where prerequisite courses must be completed before advanced courses. | Column completion_order_sequence (INT) in workforce.course_requirement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in workforce.course_requirement']
  created_timestamp timestamp [note: 'Date and time when this course requirement record was first created in the system. | Column created_timestamp (TIMESTAMP) in workforce.course_requirement']
  effective_end_date date [note: 'Date when this training requirement was retired or replaced for this job profile. Null if currently active. Enables historical analysis of training program evolution. | Column effective_end_date (DATE) in workforce.course_requirement']
  effective_start_date date [note: 'Date when this training requirement became effective for this job profile. Supports historical tracking of curriculum changes. | Column effective_start_date (DATE) in workforce.course_requirement']
  is_mandatory boolean [note: 'Indicates whether this training course is mandatory (true) or optional/recommended (false) for this job profile. Drives compliance tracking and enforcement. | Column is_mandatory (BOOLEAN) in workforce.course_requirement']
  modified_timestamp timestamp [note: 'Date and time when this course requirement record was last updated or modified. | Column modified_timestamp (TIMESTAMP) in workforce.course_requirement']
  recertification_period_months varchar [note: 'Number of months after which employees in this job profile must retake or renew this training course. Supports ongoing compliance for roles requiring periodic recertification (e.g., FCC regulations, safety training). | Column recertification_period_months (INT) in workforce.course_requirement']
  requirement_rationale varchar [note: 'Business justification for why this course is required for this job profile. Examples: regulatory compliance (FCC, EEO), operational safety, technical competency, leadership development. | Column requirement_rationale (STRING) in workforce.course_requirement']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in workforce.course_requirement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in workforce.course_requirement']
  waiver_allowed_flag boolean [note: 'Indicates whether this requirement can be waived for employees in this job profile based on prior experience or equivalent credentials. | Column waiver_allowed_flag (BOOLEAN) in workforce.course_requirement']

  Note: 'This association product represents the training curriculum requirement between training courses and job profiles. It captures which courses are mandatory or optional for each job role, completion deadlines, recertification periods, and sequencing requirements. Each record links one training course to one job profile with attributes that define the compliance and learning path requirements for that specific role-course combination. Managed by HR and Learning & Development teams to ensure workforce compliance and skills development.. Existence Justification: This is a genuine operational M:N relationship representing training curriculum requirements managed by HR and Learning & Development teams. A training course applies to multiple job profiles (e.g., \'FCC Compliance Training\' required for broadcast engineer, studio director, content scheduler), and each job profile requires multiple training courses (e.g., broadcast engineer needs technical certifications, safety training, regulatory compliance courses). The business actively manages this relationship by defining mandatory vs. optional courses, setting completion deadlines, updating requirements as regulations change, and tracking compliance. | Unity Catalog table: media_broadcasting_ecm.workforce.course_requirement'
}

Table workforce.benefit_plan {
  benefit_plan_id varchar [pk, note: 'Primary key for benefit_plan | Column benefit_plan_id (BIGINT) in workforce.benefit_plan']
  benefit_employee_id varchar [note: 'Reference to the user who created this benefit plan record. | Column employee_id (BIGINT) in workforce.benefit_plan']
  benefit_modified_by_user_employee_id varchar [note: 'Reference to the user who last modified this benefit plan record. | Column modified_by_user_employee_id (BIGINT) in workforce.benefit_plan']
  superseded_benefit_plan_id varchar [note: 'Self-referencing FK on benefit_plan (superseded_benefit_plan_id) | Column superseded_benefit_plan_id (BIGINT) in workforce.benefit_plan']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in workforce.benefit_plan']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in workforce.benefit_plan']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in workforce.benefit_plan']
  annual_deductible_amount decimal(15,2) [note: 'Annual deductible amount the employee must pay before the plan begins coverage. Applicable to health and insurance plans. | Column annual_deductible_amount (DECIMAL(15,2)) in workforce.benefit_plan']
  annual_out_of_pocket_maximum decimal(15,2) [note: 'Maximum amount the employee will pay out-of-pocket in a plan year. Applicable to health and insurance plans. | Column annual_out_of_pocket_maximum (DECIMAL(15,2)) in workforce.benefit_plan']
  benefit_plan_description varchar [note: 'Detailed description of the benefit plan including coverage details, features, and key terms. | Column description (STRING) in workforce.benefit_plan']
  benefit_plan_status varchar [note: 'Current lifecycle status of the benefit plan indicating availability for enrollment and administration. | Column status (STRING) in workforce.benefit_plan']
  coinsurance_percentage decimal(5,2) [note: 'Percentage of costs the employee pays after meeting the deductible. Applicable to health and insurance plans. | Column coinsurance_percentage (DECIMAL(5,2)) in workforce.benefit_plan']
  compliance_status varchar [note: 'Current compliance status of the benefit plan with respect to regulatory requirements such as ERISA and ACA. | Column compliance_status (STRING) in workforce.benefit_plan']
