    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:costPerInteraction rdf:type rdf:Property ;
    rdfs:label 'Cost Per Interaction' ;
    rdfs:comment 'Average cost in USD for processing a single interaction through this channel, used for financial analysis and channel optimization.' ;
