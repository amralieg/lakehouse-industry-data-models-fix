    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentLibraryAccess rdf:type rdf:Property ;
    rdfs:label 'Content Library Access' ;
    rdfs:comment 'Level of access to the content library indicating which content tiers and archives are available to subscribers.' ;
    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:corporateLicenseEligible rdf:type rdf:Property ;
    rdfs:label 'Corporate License Eligible' ;
    rdfs:comment 'Indicates whether this plan is available for corporate or enterprise licensing agreements with volume pricing and centralized billing.' ;
    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dvrEnabled rdf:type rdf:Property ;
    rdfs:label 'Dvr Enabled' ;
    rdfs:comment 'Indicates whether subscribers can record live broadcasts for later viewing using cloud DVR functionality.' ;
