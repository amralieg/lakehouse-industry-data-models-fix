    rdfs:comment 'Name or identifier of the digital platform or system used for enrollment through this channel (e.g., Salesforce Health Cloud, custom web portal).' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresIdentityVerification rdf:type rdf:Property ;
    rdfs:label 'Requires Identity Verification' ;
    rdfs:comment 'Indicates whether the channel requires identity verification of the enrollee before completing enrollment.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresEligibilityVerification rdf:type rdf:Property ;
    rdfs:label 'Requires Eligibility Verification' ;
    rdfs:comment 'Indicates whether the channel requires real-time eligibility verification before enrollment can be completed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
