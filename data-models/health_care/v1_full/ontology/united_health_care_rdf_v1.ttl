    rdfs:comment 'Identifier for the specific benefit package that defines the covered services, cost-sharing amounts, and coverage limitations for the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenefitPackage .

ind:coverageLevel rdf:type rdf:Property ;
    rdfs:label 'Coverage Level' ;
    rdfs:comment 'The tier of coverage indicating who is covered under the policy, affecting premium amounts and benefit eligibility.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipCode rdf:type rdf:Property ;
    rdfs:label 'Relationship Code' ;
    rdfs:comment 'The member\'s relationship to the primary subscriber, determining dependent eligibility and coverage rights.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
