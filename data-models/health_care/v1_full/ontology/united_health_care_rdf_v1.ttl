ind:lastEdpsSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Last Edps Submission Date' ;
    rdfs:comment 'Most recent date when encounter data was submitted to CMS via EDPS for this member.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chartReviewCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Chart Review Completion Date' ;
    rdfs:comment 'Date when the medical chart review was completed for this member\'s risk adjustment validation.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
