ind:primarySkillGroup rdf:type rdf:Property ;
    rdfs:label 'Primary Skill Group' ;
    rdfs:comment 'The primary skill group or competency required for agents handling interactions from this queue (e.g., Claims, Eligibility, Benefits, Appeals).' ;
