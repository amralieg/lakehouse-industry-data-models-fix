ind:lineOfBusinessName rdf:type rdf:Property ;
    rdfs:label 'Line Of Business Name' ;
    rdfs:comment 'The name of the line of business to which this allocation applies.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationCategory rdf:type rdf:Property ;
    rdfs:label 'Allocation Category' ;
    rdfs:comment 'The category of expense being allocated (e.g., administrative, claims, medical, operational).' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMlrEligible rdf:type rdf:Property ;
    rdfs:label 'Is Mlr Eligible' ;
    rdfs:comment 'Indicates whether this allocation is eligible for inclusion in MLR calculations.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allocationDriverUnit rdf:type rdf:Property ;
    rdfs:label 'Allocation Driver Unit' ;
    rdfs:comment 'The unit of measure for the allocation driver (e.g., headcount, square feet, member months).' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPoolAmount rdf:type rdf:Property ;
    rdfs:label 'Total Pool Amount' ;
    rdfs:comment 'The total amount in the allocation pool before distribution across targets.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reversedAllocationDetailId rdf:type rdf:Property ;
    rdfs:label 'Reversed Allocation Detail Id' ;
    rdfs:comment 'The allocation detail ID that this record reverses, if applicable.' ;
