    rdfs:comment 'Indicates if the plan reports per member per month (PMPM) metrics to CMS.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateSpecificComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'State Specific Compliance Flag' ;
    rdfs:comment 'State-level compliance status for the plan.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFormularyCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Formulary Compliant' ;
    rdfs:comment 'Indicates if the plan\'s formulary meets regulatory requirements.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHipaaCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Hipaa Compliant' ;
    rdfs:comment 'Indicates compliance with HIPAA privacy and security rules.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHitechCompliant rdf:type rdf:Property ;
