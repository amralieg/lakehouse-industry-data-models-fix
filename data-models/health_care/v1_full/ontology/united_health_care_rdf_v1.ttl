ind:hccScore rdf:type rdf:Property ;
    rdfs:label 'Hcc Score' ;
    rdfs:comment 'HCC risk adjustment score for the member, indicating predicted healthcare costs and complexity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rafScore rdf:type rdf:Property ;
    rdfs:label 'Raf Score' ;
    rdfs:comment 'Risk Adjustment Factor score for the member used in Medicare Advantage payment calculations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationDate rdf:type rdf:Property ;
    rdfs:label 'Calculation Date' ;
    rdfs:comment 'Date when the measure result was calculated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calculationVersion rdf:type rdf:Property ;
    rdfs:label 'Calculation Version' ;
    rdfs:comment 'Version of the calculation engine or software used to compute the measure result.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCompletenessPercentage rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Percentage' ;
    rdfs:comment 'Percentage of required data elements that were available for the measure calculation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:missingDataFlag rdf:type rdf:Property ;
    rdfs:label 'Missing Data Flag' ;
    rdfs:comment 'Indicates whether critical data elements were missing for the measure calculation.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:imputationFlag rdf:type rdf:Property ;
    rdfs:label 'Imputation Flag' ;
    rdfs:comment 'Indicates whether data imputation methods were used to fill missing values in the measure calculation.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validationDate rdf:type rdf:Property ;
    rdfs:label 'Validation Date' ;
    rdfs:comment 'Date when the measure result was validated by internal quality assurance processes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validatedBy rdf:type rdf:Property ;
    rdfs:label 'Validated By' ;
    rdfs:comment 'Name or identifier of the person or system that validated the measure result.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishedFlag rdf:type rdf:Property ;
    rdfs:label 'Published Flag' ;
    rdfs:comment 'Indicates whether the measure result has been published externally (e.g., on public reporting websites, to CMS).' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicationDate rdf:type rdf:Property ;
    rdfs:label 'Publication Date' ;
    rdfs:comment 'Date when the measure result was published externally.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planDescription rdf:type rdf:Property ;
    rdfs:label 'Plan Description' ;
    rdfs:comment 'Detailed description of the quality improvement plan objectives, scope, and expected outcomes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current lifecycle status of the quality improvement plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDomain rdf:type rdf:Property ;
    rdfs:label 'Target Domain' ;
    rdfs:comment 'Specific quality domain or area of focus that the improvement plan addresses.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starsMeasureId rdf:type rdf:Property ;
    rdfs:label 'Stars Measure Id' ;
    rdfs:comment 'Specific CMS Stars measure identifier targeted by the improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Measure .

ind:baselinePerformanceRate rdf:type rdf:Property ;
    rdfs:label 'Baseline Performance Rate' ;
    rdfs:comment 'Initial performance rate or score before implementation of the improvement plan, expressed as a percentage.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPerformanceRate rdf:type rdf:Property ;
    rdfs:label 'Current Performance Rate' ;
    rdfs:comment 'Most recent performance rate or score during plan execution, expressed as a percentage.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baselineMeasurementDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Measurement Date' ;
    rdfs:comment 'Date when the baseline performance measurement was captured.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetAchievementDate rdf:type rdf:Property ;
    rdfs:label 'Target Achievement Date' ;
    rdfs:comment 'Expected date by which the target performance rate should be achieved.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualAchievementDate rdf:type rdf:Property ;
    rdfs:label 'Actual Achievement Date' ;
    rdfs:comment 'Actual date when the target performance rate was achieved, if applicable.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planEndDate rdf:type rdf:Property ;
    rdfs:label 'Plan End Date' ;
    rdfs:comment 'Planned or actual end date for the quality improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsibleExecutiveName rdf:type rdf:Property ;
    rdfs:label 'Responsible Executive Name' ;
    rdfs:comment 'Name of the executive sponsor or leader accountable for the improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleExecutiveTitle rdf:type rdf:Property ;
    rdfs:label 'Responsible Executive Title' ;
    rdfs:comment 'Job title of the executive sponsor responsible for the improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectManagerName rdf:type rdf:Property ;
    rdfs:label 'Project Manager Name' ;
    rdfs:comment 'Name of the project manager or coordinator leading day-to-day execution of the improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectManagerEmail rdf:type rdf:Property ;
    rdfs:label 'Project Manager Email' ;
    rdfs:comment 'Email address of the project manager responsible for the improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectManagerPhone rdf:type rdf:Property ;
    rdfs:label 'Project Manager Phone' ;
    rdfs:comment 'Contact phone number for the project manager responsible for the improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionStrategy rdf:type rdf:Property ;
    rdfs:label 'Intervention Strategy' ;
    rdfs:comment 'Description of the intervention methods and strategies being implemented to achieve improvement goals.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualSpendAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Spend Amount' ;
    rdfs:comment 'Actual amount spent on the quality improvement plan to date.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Budget Currency Code' ;
    rdfs:comment 'ISO currency code for budget and spend amounts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roiTargetPercentage rdf:type rdf:Property ;
    rdfs:label 'Roi Target Percentage' ;
    rdfs:comment 'Expected return on investment for the quality improvement plan, expressed as a percentage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Deadline Date' ;
    rdfs:comment 'Regulatory deadline by which the improvement plan must be completed or compliance achieved.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:barrierDescription rdf:type rdf:Property ;
    rdfs:label 'Barrier Description' ;
    rdfs:comment 'Description of identified barriers or challenges to achieving improvement plan objectives.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationMethodology rdf:type rdf:Property ;
    rdfs:label 'Evaluation Methodology' ;
    rdfs:comment 'Description of the methodology used to evaluate effectiveness and outcomes of the improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByName rdf:type rdf:Property ;
    rdfs:label 'Approved By Name' ;
    rdfs:comment 'Name of the individual or committee that approved the improvement plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByTitle rdf:type rdf:Property ;
    rdfs:label 'Approved By Title' ;
    rdfs:comment 'Title or role of the individual or committee that approved the improvement plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneCount rdf:type rdf:Property ;
    rdfs:label 'Milestone Count' ;
    rdfs:comment 'Total number of milestones defined for the improvement plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:completedMilestoneCount rdf:type rdf:Property ;
    rdfs:label 'Completed Milestone Count' ;
    rdfs:comment 'Number of milestones that have been completed to date.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Date' ;
    rdfs:comment 'Date when the most recent risk assessment was conducted for the improvement plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stakeholderEngagementLevel rdf:type rdf:Property ;
    rdfs:label 'Stakeholder Engagement Level' ;
    rdfs:comment 'Level of stakeholder engagement and participation in the improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bestPracticesIdentified rdf:type rdf:Property ;
    rdfs:label 'Best Practices Identified' ;
    rdfs:comment 'Description of best practices identified through the improvement plan that can be replicated.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedInitiativeReference rdf:type rdf:Property ;
    rdfs:label 'Related Initiative Reference' ;
    rdfs:comment 'Reference to related quality improvement initiatives or programs.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionDate rdf:type rdf:Property ;
    rdfs:label 'Revision Date' ;
    rdfs:comment 'Date when the improvement plan was last revised or updated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revisionReason rdf:type rdf:Property ;
    rdfs:label 'Revision Reason' ;
    rdfs:comment 'Description of the reason for the most recent revision to the improvement plan.' ;
    rdfs:domain ind:ImprovementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentLocation rdf:type rdf:Property ;
    rdfs:label 'Document Location' ;
    rdfs:comment 'File path or URL where the full improvement plan document is stored.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activeFlag rdf:type rdf:Property ;
    rdfs:label 'Active Flag' ;
    rdfs:comment 'Indicates whether the improvement plan is currently active.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:archivedFlag rdf:type rdf:Property ;
    rdfs:label 'Archived Flag' ;
    rdfs:comment 'Indicates whether the improvement plan has been archived.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:archiveDate rdf:type rdf:Property ;
    rdfs:label 'Archive Date' ;
    rdfs:comment 'Date when the improvement plan was archived.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'Date when the improvement plan was cancelled, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Description of the reason why the improvement plan was cancelled.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalMetricId rdf:type rdf:Property ;
    rdfs:label 'Clinical Metric Id' ;
    rdfs:comment 'Unique identifier for the clinical quality metric definition. Primary key for the clinical metric master table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalMetric .

ind:metricCode rdf:type rdf:Property ;
    rdfs:label 'Metric Code' ;
    rdfs:comment 'Standardized code identifier for the clinical quality metric (e.g., HBD for HbA1c control, CBP for controlling high blood pressure).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricName rdf:type rdf:Property ;
    rdfs:label 'Metric Name' ;
    rdfs:comment 'Full descriptive name of the clinical quality metric (e.g., Hemoglobin A1c Control for Patients with Diabetes, 30-Day All-Cause Hospital Readmission Rate).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricCategory rdf:type rdf:Property ;
    rdfs:label 'Metric Category' ;
    rdfs:comment 'High-level categorization of the clinical quality metric based on the domain of care or measurement focus.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricType rdf:type rdf:Property ;
    rdfs:label 'Metric Type' ;
    rdfs:comment 'Classification of the metric based on what aspect of care quality it measures (process compliance, health outcomes, patient experience, etc.).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationMethod rdf:type rdf:Property ;
    rdfs:label 'Calculation Method' ;
    rdfs:comment 'The mathematical approach used to calculate the metric value (e.g., rate per 1000 members, percentage of eligible population, mean value).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure' ;
    rdfs:comment 'The unit in which the metric value is expressed (e.g., percentage, rate per 1000 member months, days, dollars, score).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourceType rdf:type rdf:Property ;
    rdfs:label 'Data Source Type' ;
    rdfs:comment 'The primary type of data source used to calculate the metric (administrative claims, electronic health records, member surveys, etc.).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionMethod rdf:type rdf:Property ;
    rdfs:label 'Collection Method' ;
    rdfs:comment 'The method by which data for the metric is collected and aggregated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisMeasureCode rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Code' ;
    rdfs:comment 'The official HEDIS measure code if this metric is part of the HEDIS measurement set (e.g., CBP, CDC-HbA1c, COL).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starsMeasureCode rdf:type rdf:Property ;
    rdfs:label 'Stars Measure Code' ;
    rdfs:comment 'The CMS Star Ratings measure identifier if this metric is used in Medicare Advantage or Part D Star Ratings (e.g., C01, D01).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starsDomain rdf:type rdf:Property ;
    rdfs:label 'Stars Domain' ;
    rdfs:comment 'The Star Ratings domain category to which this metric belongs for Medicare Advantage or Part D plans.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starsWeight rdf:type rdf:Property ;
    rdfs:label 'Stars Weight' ;
    rdfs:comment 'The weighting factor applied to this metric in the overall CMS Star Ratings calculation (1x, 3x, or 5x).' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nqfMeasureNumber rdf:type rdf:Property ;
    rdfs:label 'Nqf Measure Number' ;
    rdfs:comment 'The National Quality Forum endorsed measure number if this metric has NQF endorsement.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalDomain rdf:type rdf:Property ;
    rdfs:label 'Clinical Domain' ;
    rdfs:comment 'The clinical specialty or disease area that the metric addresses.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageRangeMin rdf:type rdf:Property ;
    rdfs:label 'Age Range Min' ;
    rdfs:comment 'The minimum age in years for members included in the metric\'s target population.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageRangeMax rdf:type rdf:Property ;
    rdfs:label 'Age Range Max' ;
    rdfs:comment 'The maximum age in years for members included in the metric\'s target population.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicableLob rdf:type rdf:Property ;
    rdfs:label 'Applicable Lob' ;
    rdfs:comment 'Comma-separated list of lines of business to which this metric applies (e.g., Commercial, Medicare, Medicaid, Exchange).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableProductTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Product Types' ;
    rdfs:comment 'Comma-separated list of product types for which this metric is measured (e.g., HMO, PPO, POS, EPO, HDHP).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRiskAdjusted rdf:type rdf:Property ;
    rdfs:label 'Is Risk Adjusted' ;
    rdfs:comment 'Indicates whether the metric calculation includes risk adjustment for member acuity and case mix.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchmarkPercentile50 rdf:type rdf:Property ;
    rdfs:label 'Benchmark Percentile 50' ;
    rdfs:comment 'The 50th percentile (median) benchmark value for this metric from the benchmark source.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkPercentile75 rdf:type rdf:Property ;
    rdfs:label 'Benchmark Percentile 75' ;
    rdfs:comment 'The 75th percentile benchmark value for this metric from the benchmark source.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkPercentile90 rdf:type rdf:Property ;
    rdfs:label 'Benchmark Percentile 90' ;
    rdfs:comment 'The 90th percentile benchmark value for this metric from the benchmark source.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:starsCutPoint2Star rdf:type rdf:Property ;
    rdfs:label 'Stars Cut Point 2 Star' ;
    rdfs:comment 'The performance threshold for achieving a 2-star rating on this CMS Stars measure.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:starsCutPoint3Star rdf:type rdf:Property ;
    rdfs:label 'Stars Cut Point 3 Star' ;
    rdfs:comment 'The performance threshold for achieving a 3-star rating on this CMS Stars measure.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:starsCutPoint4Star rdf:type rdf:Property ;
    rdfs:label 'Stars Cut Point 4 Star' ;
    rdfs:comment 'The performance threshold for achieving a 4-star rating on this CMS Stars measure.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:starsCutPoint5Star rdf:type rdf:Property ;
    rdfs:label 'Stars Cut Point 5 Star' ;
    rdfs:comment 'The performance threshold for achieving a 5-star rating on this CMS Stars measure.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryRequirement rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement' ;
    rdfs:comment 'Indicates whether reporting of this metric is mandatory, voluntary, or required for specific contracts or accreditation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationProgram rdf:type rdf:Property ;
    rdfs:label 'Accreditation Program' ;
    rdfs:comment 'The accreditation program(s) for which this metric is required (e.g., NCQA Health Plan Accreditation, URAC).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementReason rdf:type rdf:Property ;
    rdfs:label 'Retirement Reason' ;
    rdfs:comment 'Explanation for why the metric was retired or deprecated, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueSetOid rdf:type rdf:Property ;
    rdfs:label 'Value Set Oid' ;
    rdfs:comment 'The Object Identifier for the value set(s) used in the metric definition for identifying relevant diagnoses, procedures, or medications.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snomedCodes rdf:type rdf:Property ;
    rdfs:label 'Snomed Codes' ;
    rdfs:comment 'Comma-separated list of SNOMED CT codes used in the metric definition for clinical concepts.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lookbackPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Days' ;
    rdfs:comment 'The number of days prior to the measurement period end date to look back for relevant clinical events or services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pharmacyBenefitRequired rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Benefit Required' ;
    rdfs:comment 'Indicates whether members must have pharmacy benefit coverage to be included in the metric calculation.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalBenefitRequired rdf:type rdf:Property ;
    rdfs:label 'Medical Benefit Required' ;
    rdfs:comment 'Indicates whether members must have medical benefit coverage to be included in the metric calculation.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stratificationVariables rdf:type rdf:Property ;
    rdfs:label 'Stratification Variables' ;
    rdfs:comment 'Comma-separated list of variables by which the metric should be stratified for reporting (e.g., age group, gender, race, ethnicity, geography).' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCompositeMeasure rdf:type rdf:Property ;
    rdfs:label 'Is Composite Measure' ;
    rdfs:comment 'Indicates whether this metric is a composite measure that combines multiple component measures.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:componentMeasures rdf:type rdf:Property ;
    rdfs:label 'Component Measures' ;
    rdfs:comment 'Comma-separated list of component measure codes that comprise this composite measure, if applicable.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementNotation rdf:type rdf:Property ;
    rdfs:label 'Improvement Notation' ;
    rdfs:comment 'Indicates the direction of improvement for the metric (increase in rate is better, decrease in rate is better, or maintain current rate).' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCollectionStartDate rdf:type rdf:Property ;
    rdfs:label 'Data Collection Start Date' ;
    rdfs:comment 'The earliest date from which data should be collected for calculating this metric.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataCollectionEndDate rdf:type rdf:Property ;
    rdfs:label 'Data Collection End Date' ;
    rdfs:comment 'The latest date through which data should be collected for calculating this metric.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Submission Deadline' ;
    rdfs:comment 'The deadline by which metric results must be submitted to the regulatory body or accreditation organization.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditEligible rdf:type rdf:Property ;
    rdfs:label 'Audit Eligible' ;
    rdfs:comment 'Indicates whether this metric is subject to external audit or validation by NCQA, CMS, or other oversight bodies.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incentiveProgramEligible rdf:type rdf:Property ;
    rdfs:label 'Incentive Program Eligible' ;
    rdfs:comment 'Indicates whether this metric is included in provider or member incentive programs for quality performance.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Public Reporting Required' ;
    rdfs:comment 'Indicates whether results for this metric must be publicly reported on websites or quality comparison tools.' ;
    rdfs:domain ind:ClinicalMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Report Submission Id' ;
    rdfs:comment 'Unique identifier for each quality report submission record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReportSubmission .

ind:reportType rdf:type rdf:Property ;
    rdfs:label 'Report Type' ;
    rdfs:comment 'The type or category of quality report being submitted, such as HEDIS measures, CAHPS surveys, CMS Stars ratings, or accreditation reports.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportName rdf:type rdf:Property ;
    rdfs:label 'Report Name' ;
    rdfs:comment 'The official name or title of the quality report being submitted.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportCode rdf:type rdf:Property ;
    rdfs:label 'Report Code' ;
    rdfs:comment 'The standardized code or identifier assigned to the report type by the regulatory body or accreditation organization.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementYear rdf:type rdf:Property ;
    rdfs:label 'Measurement Year' ;
    rdfs:comment 'The calendar year for which quality measures were calculated and reported.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:submissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submission Timestamp' ;
    rdfs:comment 'The precise date and time when the quality report was submitted to the receiving organization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:receivingOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Receiving Organization Name' ;
    rdfs:comment 'The full legal name of the organization receiving the quality report submission.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberCount rdf:type rdf:Property ;
    rdfs:label 'Member Count' ;
    rdfs:comment 'The total number of health plan members included in the quality measurement population for this report.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportVersion rdf:type rdf:Property ;
    rdfs:label 'Report Version' ;
    rdfs:comment 'The version number or identifier for this submission, used to track revisions and resubmissions of the same report.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isResubmission rdf:type rdf:Property ;
    rdfs:label 'Is Resubmission' ;
    rdfs:comment 'Indicates whether this submission is a resubmission or correction of a previously submitted quality report.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Original Submission Id' ;
    rdfs:comment 'Reference to the original report submission identifier if this is a resubmission or correction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Risk .

ind:resubmissionReason rdf:type rdf:Property ;
    rdfs:label 'Resubmission Reason' ;
    rdfs:comment 'The reason or explanation for resubmitting a previously filed quality report.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Confirmation Number' ;
    rdfs:comment 'The confirmation or tracking number provided by the receiving organization upon successful submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgementDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledgement Date' ;
    rdfs:comment 'The date on which the receiving organization acknowledged receipt of the quality report submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:acceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Acceptance Date' ;
    rdfs:comment 'The date on which the receiving organization formally accepted the quality report submission as complete and compliant.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectionDate rdf:type rdf:Property ;
    rdfs:label 'Rejection Date' ;
    rdfs:comment 'The date on which the receiving organization rejected the quality report submission due to errors or non-compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectionCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Code' ;
    rdfs:comment 'The standardized code assigned by the receiving organization to categorize the reason for rejection.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditDate rdf:type rdf:Property ;
    rdfs:label 'Audit Date' ;
    rdfs:comment 'The date on which the regulatory audit or validation review was conducted for this quality report.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditFindings rdf:type rdf:Property ;
    rdfs:label 'Audit Findings' ;
    rdfs:comment 'Detailed findings, observations, or issues identified during the regulatory audit or validation review.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionStatus rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Status' ;
    rdfs:comment 'The current status of corrective actions required in response to audit findings or regulatory feedback.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileName rdf:type rdf:Property ;
    rdfs:label 'File Name' ;
    rdfs:comment 'The name of the electronic file or document submitted to the regulatory body or accreditation organization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileFormat rdf:type rdf:Property ;
    rdfs:label 'File Format' ;
    rdfs:comment 'The format of the electronic file submitted for the quality report.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileSizeBytes rdf:type rdf:Property ;
    rdfs:label 'File Size Bytes' ;
    rdfs:comment 'The size of the submitted file in bytes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fileChecksum rdf:type rdf:Property ;
    rdfs:label 'File Checksum' ;
    rdfs:comment 'The cryptographic checksum or hash value of the submitted file used to verify data integrity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionChannel rdf:type rdf:Property ;
    rdfs:label 'Submission Channel' ;
    rdfs:comment 'The specific electronic portal, system, or platform used to submit the quality report.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterName rdf:type rdf:Property ;
    rdfs:label 'Submitter Name' ;
    rdfs:comment 'The name of the individual who submitted the quality report on behalf of the health plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterEmail rdf:type rdf:Property ;
    rdfs:label 'Submitter Email' ;
    rdfs:comment 'The email address of the individual who submitted the quality report.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterPhone rdf:type rdf:Property ;
    rdfs:label 'Submitter Phone' ;
    rdfs:comment 'The phone number of the individual who submitted the quality report.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterRole rdf:type rdf:Property ;
    rdfs:label 'Submitter Role' ;
    rdfs:comment 'The job title or role of the individual who submitted the quality report.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverName rdf:type rdf:Property ;
    rdfs:label 'Approver Name' ;
    rdfs:comment 'The name of the individual who approved the quality report for submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverEmail rdf:type rdf:Property ;
    rdfs:label 'Approver Email' ;
    rdfs:comment 'The email address of the individual who approved the quality report for submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverRole rdf:type rdf:Property ;
    rdfs:label 'Approver Role' ;
    rdfs:comment 'The job title or role of the individual who approved the quality report for submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'The date and time when the quality report received internal approval before submission to the regulatory body.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Data Source System' ;
    rdfs:comment 'The name of the source system or application from which quality measure data was extracted for this report.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataExtractionDate rdf:type rdf:Property ;
    rdfs:label 'Data Extraction Date' ;
    rdfs:comment 'The date on which data was extracted from source systems for quality measure calculation and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measureCount rdf:type rdf:Property ;
    rdfs:label 'Measure Count' ;
    rdfs:comment 'The total number of individual quality measures included in this report submission.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:penaltyApplied rdf:type rdf:Property ;
    rdfs:label 'Penalty Applied' ;
    rdfs:comment 'Indicates whether regulatory penalties were applied due to late submission, non-compliance, or quality measure performance.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'The monetary amount of penalties assessed due to late submission, non-compliance, or quality measure performance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyReason rdf:type rdf:Property ;
    rdfs:label 'Penalty Reason' ;
    rdfs:comment 'The reason or explanation for penalties assessed on this quality report submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationRequired rdf:type rdf:Property ;
    rdfs:label 'Attestation Required' ;
    rdfs:comment 'Indicates whether executive attestation or certification is required for this quality report submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationCompleted rdf:type rdf:Property ;
    rdfs:label 'Attestation Completed' ;
    rdfs:comment 'Indicates whether the required executive attestation or certification has been completed for this submission.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationDate rdf:type rdf:Property ;
    rdfs:label 'Attestation Date' ;
    rdfs:comment 'The date on which executive attestation or certification was completed for this quality report.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attestorName rdf:type rdf:Property ;
    rdfs:label 'Attestor Name' ;
    rdfs:comment 'The name of the executive or authorized individual who provided attestation or certification for this quality report.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestorTitle rdf:type rdf:Property ;
    rdfs:label 'Attestor Title' ;
    rdfs:comment 'The job title or position of the executive who provided attestation or certification for this quality report.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFeedback rdf:type rdf:Property ;
    rdfs:label 'Regulatory Feedback' ;
    rdfs:comment 'Feedback, comments, or guidance provided by the regulatory body or accreditation organization in response to the submission.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationLevel rdf:type rdf:Property ;
    rdfs:label 'Accreditation Level' ;
    rdfs:comment 'The accreditation level or status awarded by NCQA or URAC based on quality measure performance and compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicReportingDate rdf:type rdf:Property ;
    rdfs:label 'Public Reporting Date' ;
    rdfs:comment 'The date on which quality measure results from this submission will be or were publicly reported.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isFinalSubmission rdf:type rdf:Property ;
    rdfs:label 'Is Final Submission' ;
    rdfs:comment 'Indicates whether this is the final, official submission for the reporting period or a preliminary/draft submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supplementalDataSubmitted rdf:type rdf:Property ;
    rdfs:label 'Supplemental Data Submitted' ;
    rdfs:comment 'Indicates whether supplemental data or supporting documentation was submitted along with the quality report.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validationErrorsCount rdf:type rdf:Property ;
    rdfs:label 'Validation Errors Count' ;
    rdfs:comment 'The number of validation errors identified in the quality report submission by the receiving organization\'s validation system.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationWarningsCount rdf:type rdf:Property ;
    rdfs:label 'Validation Warnings Count' ;
    rdfs:comment 'The number of validation warnings identified in the quality report submission that do not prevent acceptance but require review.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Date' ;
    rdfs:comment 'The date on which the quality report submission received official certification from the regulatory body or accreditation organization.' ;
    rdfs:domain ind:ReportSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Expiration Date' ;
    rdfs:comment 'The date on which the certification for this quality report submission expires and renewal or resubmission is required.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clinicalMetricResultId rdf:type rdf:Property ;
    rdfs:label 'Clinical Metric Result Id' ;
    rdfs:comment 'Unique identifier for the clinical quality metric result record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalMetricResult .

ind:measureType rdf:type rdf:Property ;
    rdfs:label 'Measure Type' ;
    rdfs:comment 'Classification of the measure based on what aspect of care quality it evaluates.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityId rdf:type rdf:Property ;
    rdfs:label 'Entity Id' ;
    rdfs:comment 'Unique identifier of the specific entity (provider NPI, facility ID, cohort ID) for which this metric result applies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityType rdf:type rdf:Property ;
    rdfs:label 'Facility Type' ;
    rdfs:comment 'Type of healthcare facility if the metric result is facility-specific.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberCohortDescription rdf:type rdf:Property ;
    rdfs:label 'Member Cohort Description' ;
    rdfs:comment 'Textual description of the member population cohort for which this metric was calculated (e.g., Diabetic Members Age 18-75, Commercial HMO Members).' ;
    rdfs:domain ind:ClinicalMetricResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rate rdf:type rdf:Property ;
    rdfs:label 'Rate' ;
    rdfs:comment 'Calculated performance rate for the quality metric, expressed as a percentage (numerator divided by denominator minus exclusions, multiplied by 100).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateType rdf:type rdf:Property ;
    rdfs:label 'Rate Type' ;
    rdfs:comment 'Unit or format in which the metric result rate is expressed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkValue rdf:type rdf:Property ;
    rdfs:label 'Benchmark Value' ;
    rdfs:comment 'Benchmark or target value for this quality metric against which performance is compared.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceLevel rdf:type rdf:Property ;
    rdfs:label 'Performance Level' ;
    rdfs:comment 'Categorical assessment of performance relative to the benchmark (below, meets, exceeds).' ;
    rdfs:domain ind:ClinicalMetricResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceIntervalLower rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Lower' ;
    rdfs:comment 'Lower bound of the 95% confidence interval for the calculated metric rate, indicating statistical precision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceIntervalUpper rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Upper' ;
    rdfs:comment 'Upper bound of the 95% confidence interval for the calculated metric rate, indicating statistical precision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskAdjustedRate rdf:type rdf:Property ;
    rdfs:label 'Risk Adjusted Rate' ;
    rdfs:comment 'Quality metric rate after applying risk adjustment methodology to account for population health differences.' ;
    rdfs:domain ind:ClinicalMetricResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:observedToExpectedRatio rdf:type rdf:Property ;
    rdfs:label 'Observed To Expected Ratio' ;
    rdfs:comment 'Ratio of observed metric result to expected result based on risk adjustment model; values above 1.0 indicate higher than expected performance.' ;
    rdfs:domain ind:ClinicalMetricResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incentiveEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Incentive Eligible Flag' ;
    rdfs:comment 'Indicates whether this metric result qualifies for quality-based incentive payments or value-based care arrangements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Incentive Amount' ;
    rdfs:comment 'Dollar amount of quality incentive payment associated with achieving this metric result, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyFlag rdf:type rdf:Property ;
    rdfs:label 'Penalty Flag' ;
    rdfs:comment 'Indicates whether this metric result triggers a quality-based penalty or withhold under value-based care arrangements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:improvementTarget rdf:type rdf:Property ;
    rdfs:label 'Improvement Target' ;
    rdfs:comment 'Target performance rate established for quality improvement initiatives for this metric.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorPeriodRate rdf:type rdf:Property ;
    rdfs:label 'Prior Period Rate' ;
    rdfs:comment 'Quality metric rate from the previous measurement period for trend analysis and improvement tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateChange rdf:type rdf:Property ;
    rdfs:label 'Rate Change' ;
    rdfs:comment 'Percentage point change in the quality metric rate compared to the prior measurement period (positive indicates improvement for most metrics).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trendDirection rdf:type rdf:Property ;
    rdfs:label 'Trend Direction' ;
    rdfs:comment 'Directional trend of quality metric performance over time (improving, declining, stable).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outlierFlag rdf:type rdf:Property ;
    rdfs:label 'Outlier Flag' ;
    rdfs:comment 'Indicates whether this metric result is a statistical outlier (significantly above or below expected range) requiring investigation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outlierType rdf:type rdf:Property ;
    rdfs:label 'Outlier Type' ;
    rdfs:comment 'Classification of outlier status as high performer (positive outlier) or low performer (negative outlier).' ;
    rdfs:domain ind:ClinicalMetricResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Data Quality Flag' ;
    rdfs:comment 'Indicator of whether the underlying data for this metric result passed data quality validation checks.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suppressionFlag rdf:type rdf:Property ;
    rdfs:label 'Suppression Flag' ;
    rdfs:comment 'Indicates whether this metric result is suppressed from public reporting due to small sample size or privacy concerns.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suppressionReason rdf:type rdf:Property ;
    rdfs:label 'Suppression Reason' ;
    rdfs:comment 'Reason why this metric result is suppressed from reporting, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
