  quaternary_sponsorship_modified_by_user_employee_id varchar [note: 'Identifier of the user who last modified the sponsorship record. | Column sponsorship_modified_by_user_employee_id (BIGINT) in workforce.sponsorship']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Sponsorships represent non-spot revenue requiring separate classification for financial reporting. Sponsorship revenue recognition and non-spot revenue reporting require linking sponsorships to their  | Column revenue_stream_id (BIGINT) in finance.sponsorship']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the sponsor, if applicable. | Column sales_agency_id (BIGINT) in sales.sponsorship']
  salesforce_opportunity_id varchar [note: 'Reference to the originating sales opportunity in Salesforce Media Cloud CRM system. | Column salesforce_opportunity_id (BIGINT) in sales.sponsorship']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Series-level sponsorships (season-long partnerships, franchise deals). Business process: upfront sponsorship packages, multi-season partnership agreements, series franchise sponsorship valuation, seas | Column series_id (BIGINT) in content.sponsorship']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Talent-driven sponsorships including celebrity endorsements and spokesperson deals require direct talent linkage for contract fulfillment tracking, exclusivity enforcement, usage rights validation, an | Column talent_profile_id (BIGINT) in talent.sponsorship']
  tertiary_sponsorship_employee_id varchar [note: 'Reference to the sales account executive responsible for managing this sponsorship relationship. | Column sponsorship_employee_id (BIGINT) in workforce.sponsorship']
  title_id varchar [note: 'Unique identifier for the sponsored program or content asset in the Media Asset Management (MAM) system. | Column title_id (BIGINT) in content.sponsorship']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sponsorship']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sponsorship']
  approved_timestamp timestamp [note: 'Timestamp when the sponsorship deal was approved and moved to active status. | Column approved_timestamp (TIMESTAMP) in sales.sponsorship']
  audience_guarantee_flag boolean [note: 'Indicates whether the sponsorship includes audience delivery guarantees measured by Nielsen or other measurement providers. | Column audience_guarantee_flag (BOOLEAN) in sales.sponsorship']
  billboard_count varchar [note: 'Number of billboard mentions or placements included in the sponsorship package. | Column billboard_count (INT) in sales.sponsorship']
  category_exclusivity_flag boolean [note: 'Indicates whether the sponsor has category exclusivity rights for the sponsored content. | Column category_exclusivity_flag (BOOLEAN) in sales.sponsorship']
  contract_reference_number varchar [note: 'Legal contract or insertion order number associated with the sponsorship agreement. | Column contract_reference_number (STRING) in sales.sponsorship']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sponsorship']
  created_timestamp timestamp [note: 'Timestamp when the sponsorship record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.sponsorship']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the sponsorship value. | Column currency_code (STRING) in sales.sponsorship']
  deliverables_description varchar [note: 'Detailed description of sponsorship deliverables including billboards, opens/closes, product integration, logo placement, mentions, and other sponsor benefits. | Column deliverables_description (STRING) in sales.sponsorship']
  exclusive_category varchar [note: 'Product or service category for which the sponsor holds exclusivity rights (e.g., automotive, telecommunications, financial services). | Column exclusive_category (STRING) in sales.sponsorship']
  exclusivity_terms varchar [note: 'Description of category exclusivity provisions preventing competing sponsors within the same product or service category. | Column exclusivity_terms (STRING) in sales.sponsorship']
  flight_end_date date [note: 'End date of the sponsorship flight period when sponsor benefits conclude. | Column flight_end_date (DATE) in sales.sponsorship']
  flight_start_date date [note: 'Start date of the sponsorship flight period when sponsor benefits begin. | Column flight_start_date (DATE) in sales.sponsorship']
  fulfillment_percentage decimal(5,2) [note: 'Percentage of sponsorship deliverables that have been completed and delivered to the sponsor. | Column fulfillment_percentage (DECIMAL(5,2)) in sales.sponsorship']
  fulfillment_status varchar [note: 'Status indicating progress toward completing all sponsorship deliverables and obligations. | Column fulfillment_status (STRING) in sales.sponsorship']
  guaranteed_impressions varchar [note: 'Minimum number of impressions guaranteed to the sponsor across all deliverables and platforms. | Column guaranteed_impressions (BIGINT) in sales.sponsorship']
  logo_placement_flag boolean [note: 'Indicates whether sponsor logo placement is included in the deliverables. | Column logo_placement_flag (BOOLEAN) in sales.sponsorship']
  makegood_eligible_flag boolean [note: 'Indicates whether the sponsorship is eligible for makegood compensation if deliverables are not met or audience guarantees are missed. | Column makegood_eligible_flag (BOOLEAN) in sales.sponsorship']
  modified_timestamp timestamp [note: 'Timestamp when the sponsorship record was last modified. | Column modified_timestamp (TIMESTAMP) in sales.sponsorship']
  notes varchar [note: 'Additional notes, comments, or special instructions related to the sponsorship deal. | Column notes (STRING) in sales.sponsorship']
  platform_distribution varchar [note: 'Platforms where the sponsored content will be distributed (linear broadcast, OTT, VOD, digital, social media). | Column platform_distribution (STRING) in sales.sponsorship']
  product_integration_flag boolean [note: 'Indicates whether product integration within content is part of the sponsorship agreement. | Column product_integration_flag (BOOLEAN) in sales.sponsorship']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sponsorship']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sponsorship']
  sponsored_content_type varchar [note: 'Type of content being sponsored (program, series, event, segment, etc.). | Column sponsored_content_type (STRING) in sales.sponsorship']
  sponsored_program_name varchar [note: 'Name of the specific program, series, or event being sponsored. | Column sponsored_program_name (STRING) in sales.sponsorship']
  sponsorship_code varchar [note: 'Business identifier or code for the sponsorship deal used in trafficking and billing systems. | Column sponsorship_code (STRING) in sales.sponsorship']
  sponsorship_name varchar [note: 'Descriptive name of the sponsorship deal for business reference and reporting. | Column sponsorship_name (STRING) in sales.sponsorship']
  sponsorship_status varchar [note: 'Current lifecycle status of the sponsorship deal. [ENUM-REF-CANDIDATE: draft|proposed|negotiating|approved|active|fulfilled|cancelled|expired — 8 candidates stripped; promote to reference product] | Column sponsorship_status (STRING) in sales.sponsorship']
  sponsorship_type varchar [note: 'Classification of the sponsorship arrangement indicating the level and nature of sponsor integration. | Column sponsorship_type (STRING) in sales.sponsorship']
  target_demographic varchar [note: 'Primary demographic audience segment targeted by the sponsorship (e.g., Adults 18-49, Women 25-54). | Column target_demographic (STRING) in sales.sponsorship']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sponsorship']
  value_amount decimal(18,2) [note: 'Total monetary value of the sponsorship deal. | Column value_amount (DECIMAL(18,2)) in sales.sponsorship']

  Note: 'Master record for a program or content sponsorship deal where an advertiser sponsors a specific program, segment, event, or content series. Captures sponsorship ID, advertiser, agency, sponsored program or event, sponsorship type (presenting sponsor, title sponsor, segment sponsor, branded content), sponsorship value, deliverables (billboards, opens/closes, product integration, logo placement), exclusivity terms, flight dates, and fulfillment status. Distinct from standard spot advertising — sponsorships carry integration and exclusivity obligations. | Unity Catalog table: media_broadcasting_ecm.sales.sponsorship Integrates with Wide Orbit (traffic) and Salesforce Media Cloud (sales CRM) for realistic demos.'
}

Table sales.political_ad_disclosure {
  political_ad_disclosure_id varchar [pk, note: 'Unique identifier for the FCC-mandated political advertising disclosure record. Primary key for political ad disclosure tracking and public inspection file maintenance. | Column political_ad_disclosure_id (BIGINT) in sales.political_ad_disclosure']
  ad_order_id varchar [note: 'Reference to the parent advertising order under which this political ad was sold and scheduled. | Column ad_order_id (BIGINT) in sales.political_ad_disclosure']
  ad_spot_id varchar [note: 'Reference to the specific advertising spot that aired. Links to the broadcast ad inventory and trafficking system for proof of performance. | Column ad_spot_id (BIGINT) in sales.political_ad_disclosure']
  advertiser_id varchar [note: 'Reference to the advertiser entity representing the political candidate committee, issue advocacy group, or Political Action Committee (PAC) that purchased the advertising. | Column advertiser_id (BIGINT) in sales.political_ad_disclosure']
  isci_creative_id varchar [note: 'Foreign key linking to sales.isci_creative. Business justification: Normalize creative reference in FCC political ad disclosure. Disclosure must reference which creative aired for compliance tracking. Currently denormalized as isci_code STRING; should FK to isci_creat | Column isci_creative_id (BIGINT) in sales.political_ad_disclosure']
  primary_political_employee_id varchar [note: 'Identifier of the user who created the political ad disclosure record. Supports audit trail and accountability for regulatory compliance documentation. | Column primary_political_employee_id (BIGINT) in workforce.political_ad_disclosure']
  public_inspection_file_id varchar [note: 'Foreign key linking to compliance.public_inspection_file. Business justification: Political ad disclosures are required public file documents under FCC regulations. Broadcasters must link disclosure records to public inspection file entries showing sponsor identification, rates cha | Column public_inspection_file_id (BIGINT) in compliance.political_ad_disclosure']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Political advertising has specific revenue recognition and FCC reporting requirements. Political advertising revenue reporting and regulatory compliance require linking political ads to their revenue  | Column revenue_stream_id (BIGINT) in finance.political_ad_disclosure']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.political_ad_disclosure']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.political_ad_disclosure']
  air_date date [note: 'The date on which the political advertisement aired. Used for public inspection file chronological organization and lowest unit rate window determination. | Column air_date (DATE) in sales.political_ad_disclosure']
  air_time timestamp [note: 'The precise timestamp when the political advertisement was broadcast. Required for affidavit generation and proof of performance documentation. | Column air_time (TIMESTAMP) in sales.political_ad_disclosure']
  candidate_name varchar [note: 'Full name of the political candidate featured in or sponsoring the advertisement. Required for candidate ads and independent expenditure communications. Null for issue-only advocacy. | Column candidate_name (STRING) in sales.political_ad_disclosure']
  candidate_office varchar [note: 'The elected office being sought by the candidate (e.g., President, U.S. Senator, Governor, State Representative). Required for candidate-related political ads. | Column candidate_office (STRING) in sales.political_ad_disclosure']
  contract_number varchar [note: 'Reference number of the advertising contract or agreement under which the political ad was purchased. Links disclosure to sales order and billing documentation. | Column contract_number (STRING) in sales.political_ad_disclosure']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.political_ad_disclosure']
  created_timestamp timestamp [note: 'Timestamp when the political ad disclosure record was first created in the system. Audit trail for compliance tracking and record retention. | Column created_timestamp (TIMESTAMP) in sales.political_ad_disclosure']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this disclosure record. Typically USD for U.S. broadcast stations. | Column currency_code (STRING) in sales.political_ad_disclosure']
  daypart varchar [note: 'The broadcast daypart segment during which the political ad aired (e.g., Prime Time, Early Morning, Late Fringe). Affects lowest unit rate calculation and advertising value assessment. | Column daypart (STRING) in sales.political_ad_disclosure']
  disclosure_number varchar [note: 'Unique business identifier for the political ad disclosure record used in public inspection files and FCC reporting. Human-readable reference number for regulatory compliance tracking. | Column disclosure_number (STRING) in sales.political_ad_disclosure']
  disclosure_status varchar [note: 'Current lifecycle status of the political ad disclosure record. Tracks progression from initial filing through amendments to final archival in public inspection file. | Column disclosure_status (STRING) in sales.political_ad_disclosure']
  disclosure_text varchar [note: 'The exact on-air or written disclosure statement required by FCC regulations identifying who paid for the advertisement. Must include \'paid for by\' language and sponsoring organization name. | Column disclosure_text (STRING) in sales.political_ad_disclosure']
  election_date date [note: 'Date of the election for which the political advertisement is relevant. Used to determine lowest unit rate windows (45 days for primary, 60 days for general election). | Column election_date (DATE) in sales.political_ad_disclosure']
  election_type varchar [note: 'Type of election associated with the political advertisement. Determines applicable lowest unit rate periods and disclosure requirements. | Column election_type (STRING) in sales.political_ad_disclosure']
  equal_time_obligation_flag boolean [note: 'Indicates whether this political ad triggers FCC equal time obligations requiring the broadcaster to offer comparable advertising opportunities to opposing candidates. | Column equal_time_obligation_flag (BOOLEAN) in sales.political_ad_disclosure']
  filing_date date [note: 'Date when the political ad disclosure record was filed in the public inspection file. FCC requires immediate disclosure upon request and placement in public file as soon as possible. | Column filing_date (DATE) in sales.political_ad_disclosure']
  lowest_unit_rate_amount decimal(15,2) [note: 'The lowest unit rate available for the class of time and daypart in which the political ad aired. Used to verify compliance with FCC lowest unit rate requirements for candidate advertising. | Column lowest_unit_rate_amount (DECIMAL(15,2)) in sales.political_ad_disclosure']
  lowest_unit_rate_applied boolean [note: 'Indicates whether the FCC-mandated lowest unit rate was applied to this political ad spot. Required to be true for candidate ads within 45 days of primary or 60 days of general election. | Column lowest_unit_rate_applied (BOOLEAN) in sales.political_ad_disclosure']
  market_code varchar [note: 'Nielsen Designated Market Area (DMA) code or other market identifier for the geographic region where the political ad aired. Used for reach analysis and compliance tracking. | Column market_code (STRING) in sales.political_ad_disclosure']
  modified_timestamp timestamp [note: 'Timestamp of the most recent modification to the political ad disclosure record. Tracks amendments and updates for compliance audit purposes. | Column modified_timestamp (TIMESTAMP) in sales.political_ad_disclosure']
  notes varchar [note: 'Additional notes, comments, or clarifications regarding the political ad disclosure. May include special circumstances, amendments, or compliance officer annotations. | Column notes (STRING) in sales.political_ad_disclosure']
  political_ad_type varchar [note: 'Classification of the political advertisement according to FCC categories. Determines applicable disclosure requirements, lowest unit rate eligibility, and equal time obligations. | Column political_ad_type (STRING) in sales.political_ad_disclosure']
  rate_class varchar [note: 'The advertising rate class or tier under which the political ad was sold (e.g., preemptible, non-preemptible, fixed position). Determines lowest unit rate calculation and equal time obligations. | Column rate_class (STRING) in sales.political_ad_disclosure']
  reasonable_access_flag boolean [note: 'Indicates whether this ad purchase was made under FCC reasonable access requirements mandating broadcasters provide federal candidates reasonable access to purchase advertising time. | Column reasonable_access_flag (BOOLEAN) in sales.political_ad_disclosure']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.political_ad_disclosure']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.political_ad_disclosure']
  sponsor_contact_email varchar [note: 'Email address of the primary contact at the sponsoring organization for correspondence regarding the political advertising campaign. | Column sponsor_contact_email (STRING) in sales.political_ad_disclosure']
  sponsor_contact_name varchar [note: 'Name of the primary contact person at the sponsoring organization responsible for the political advertising campaign. | Column sponsor_contact_name (STRING) in sales.political_ad_disclosure']
  sponsor_contact_phone varchar [note: 'Phone number of the primary contact at the sponsoring organization. Required for FCC public inspection file and reasonable access compliance. | Column sponsor_contact_phone (STRING) in sales.political_ad_disclosure']
  sponsoring_organization varchar [note: 'Legal name of the organization sponsoring or paying for the political advertisement. May be a candidate committee, PAC, super PAC, issue advocacy group, or independent expenditure committee. | Column sponsoring_organization (STRING) in sales.political_ad_disclosure']
  spot_length_seconds varchar [note: 'Duration of the political advertisement in seconds. Standard lengths are 15, 30, or 60 seconds. Affects rate calculation and inventory management. | Column spot_length_seconds (INT) in sales.political_ad_disclosure']
  spot_rate_charged decimal(15,2) [note: 'The actual rate charged for the political ad spot. Must comply with lowest unit rate requirements during pre-election windows for candidate ads. | Column spot_rate_charged (DECIMAL(15,2)) in sales.political_ad_disclosure']
  station_call_sign varchar [note: 'FCC-assigned call letters identifying the broadcast station that aired the political advertisement. Required for public inspection file organization and regulatory reporting. | Column station_call_sign (STRING) in sales.political_ad_disclosure']
  total_contract_value decimal(15,2) [note: 'Total monetary value of the political advertising contract. Required disclosure for public inspection file and transparency in political advertising spending. | Column total_contract_value (DECIMAL(15,2)) in sales.political_ad_disclosure']
  total_spots_contracted varchar [note: 'Total number of advertising spots contracted under the political advertising agreement. Used for campaign tracking and public disclosure of advertising volume. | Column total_spots_contracted (INT) in sales.political_ad_disclosure']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.political_ad_disclosure']

  Note: 'FCC-mandated political advertising disclosure record for political candidate and issue advertising. Captures disclosure ID, ad spot reference, advertiser (candidate committee or issue group), political ad type (candidate, ballot issue, PAC), sponsoring organization, FCC-required disclosure text, lowest unit rate applied, equal time obligation flag, reasonable access flag, station file reference, and filing date. Required for FCC political file compliance and public inspection file maintenance. | Unity Catalog table: media_broadcasting_ecm.sales.political_ad_disclosure Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.sales_account {
  sales_account_id varchar [pk, note: 'Unique identifier for the sales account record. Primary key for the sales account entity representing advertising agencies, direct advertisers, content licensees, syndication buyers, and distribution partners. | Column sales_account_id (BIGINT) in sales.sales_account']
  assigned_sales_rep_id varchar [note: 'Reference to the primary sales representative or account executive responsible for managing this account relationship and driving revenue. | Column assigned_sales_rep_id (BIGINT) in sales.sales_account']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Sales accounts must be associated with the contracting legal entity for proper invoicing, tax treatment, and intercompany elimination. Required for contract execution authority, tax jurisdiction deter | Column company_legal_entity_id (BIGINT) in finance.sales_account']
  parent_account_sales_account_id varchar [note: 'Reference to the parent sales account in a hierarchical account structure. Used to model agency networks, holding company subsidiaries, and multi-location advertiser organizations. | Column parent_account_sales_account_id (BIGINT) in sales.sales_account']
  sales_territory_id varchar [note: 'Foreign key linking to sales.sales_territory. Business justification: Sales accounts are assigned to territories for territory management. Currently sales_account has market_territory as a STRING, which should be normalized to a FK to sales_territory. This FK enables pr | Column sales_territory_id (BIGINT) in sales.sales_account']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sales_account']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sales_account']
  account_name varchar [note: 'The legal or trading name of the sales account organization. This is the primary human-readable identifier for the account. | Column account_name (STRING) in sales.sales_account']
  account_status varchar [note: 'Current lifecycle status of the sales account. Active indicates the account is in good standing and can transact; inactive indicates dormant but not closed; suspended indicates temporary hold due to credit or compliance issues; pending indicates account setup in progress; closed indicates permanently terminated relationship. | Column account_status (STRING) in sales.sales_account']
  account_tier varchar [note: 'The strategic tier or classification of the account based on revenue potential, relationship depth, and strategic importance. Higher tiers receive preferential pricing, dedicated support, and priority inventory access. | Column account_tier (STRING) in sales.sales_account']
  account_type varchar [note: 'Classification of the sales account based on its commercial relationship with Media Broadcasting. Agency represents advertising agencies; direct_advertiser represents brands buying media directly; MVPD (Multichannel Video Programming Distributor) and vMVPD (Virtual Multichannel Video Programming Distributor) represent distribution partners; syndicator represents content resale partners; content_licensee represents organizations licensing content rights. | Column account_type (STRING) in sales.sales_account']
  agency_commission_rate decimal(5,4) [note: 'The commission percentage paid to advertising agencies for media buys placed on behalf of their clients. Typically expressed as a decimal (e.g., 0.1500 for 15%). Null for non-agency accounts. | Column agency_commission_rate (DECIMAL(5,4)) in sales.sales_account']
  annual_revenue_potential decimal(18,2) [note: 'The estimated annual revenue opportunity from this account based on historical spend, market share, and sales forecasts. Used for territory planning and quota allocation. | Column annual_revenue_potential (DECIMAL(18,2)) in sales.sales_account']
  auto_renewal_flag boolean [note: 'Indicates whether the master service agreement automatically renews at the end of the contract term. True means the contract renews unless either party provides notice; false means the contract expires and requires renegotiation. | Column auto_renewal_flag (BOOLEAN) in sales.sales_account']
  billing_account_id varchar [note: 'Foreign key to SSOT billing.billing_account']
  billing_address_line1 varchar [note: 'The first line of the billing address where invoices should be sent. Typically contains street number and street name. | Column billing_address_line1 (STRING) in sales.sales_account']
  billing_address_line2 varchar [note: 'The second line of the billing address for suite, floor, or department information. | Column billing_address_line2 (STRING) in sales.sales_account']
  billing_billing_account_id varchar [note: 'FK to SSOT billing.billing_account']
  billing_city varchar [note: 'The city component of the billing address. | Column billing_city (STRING) in sales.sales_account']
  billing_contact_email varchar [note: 'The email address of the primary billing contact for invoice delivery and payment correspondence. | Column billing_contact_email (STRING) in sales.sales_account']
  billing_contact_name varchar [note: 'The full name of the primary billing contact at the account organization who handles invoices, payment processing, and financial inquiries. | Column billing_contact_name (STRING) in sales.sales_account']
  billing_contact_phone varchar [note: 'The phone number of the primary billing contact for urgent payment or invoice inquiries. | Column billing_contact_phone (STRING) in sales.sales_account']
  billing_country_code varchar [note: 'The three-letter ISO 3166-1 alpha-3 country code for the billing address (e.g., USA, GBR, CAN). | Column billing_country_code (STRING) in sales.sales_account']
  billing_postal_code varchar [note: 'The postal or ZIP code component of the billing address. | Column billing_postal_code (STRING) in sales.sales_account']
  billing_state_province varchar [note: 'The state or province component of the billing address. | Column billing_state_province (STRING) in sales.sales_account']
  blackout_restrictions varchar [note: 'Geographic or temporal restrictions on where or when this account\'s advertising or content may be broadcast. Used to enforce exclusivity agreements, competitive conflicts, or regulatory blackout periods. | Column blackout_restrictions (STRING) in sales.sales_account']
  contract_end_date date [note: 'The expiration date of the current master service agreement or framework contract with this account. Null indicates an evergreen or open-ended agreement. | Column contract_end_date (DATE) in sales.sales_account']
  contract_start_date date [note: 'The effective start date of the current master service agreement or framework contract with this account. | Column contract_start_date (DATE) in sales.sales_account']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sales_account']
  created_timestamp timestamp [note: 'The date and time when this sales account record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in sales.sales_account']
  credit_limit_amount decimal(18,2) [note: 'The maximum outstanding receivables balance allowed for this account before credit hold is applied. Expressed in the account\'s preferred currency. | Column credit_limit_amount (DECIMAL(18,2)) in sales.sales_account']
  credit_rating varchar [note: 'The credit rating assigned to this account based on payment history, financial stability, and risk assessment. Used to determine payment terms, credit limits, and whether prepayment is required. NR indicates not rated. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|D|NR — 11 candidates stripped; promote to reference product] | Column credit_rating (STRING) in sales.sales_account']
  holding_company_name varchar [note: 'The name of the parent holding company or corporate group to which this account belongs. Used to aggregate spend and manage relationships at the holding company level (e.g., WPP, Omnicom, Publicis Groupe for agencies). | Column holding_company_name (STRING) in sales.sales_account']
  industry_vertical varchar [note: 'The primary industry vertical or business sector of the account (e.g., Automotive, Financial Services, Retail, Pharmaceutical, Technology). Used for competitive separation and industry-specific rate cards. | Column industry_vertical (STRING) in sales.sales_account']
  last_activity_date date [note: 'The date of the most recent sales activity, campaign, or transaction associated with this account. Used to identify dormant accounts and trigger re-engagement campaigns. | Column last_activity_date (DATE) in sales.sales_account']
  last_modified_timestamp timestamp [note: 'The date and time when this sales account record was last updated. Used for change tracking and data synchronization. | Column last_modified_timestamp (TIMESTAMP) in sales.sales_account']
  notes varchar [note: 'Free-form text field for capturing important account-specific information, special handling instructions, relationship history, or strategic context that does not fit structured fields. | Column notes (STRING) in sales.sales_account']
  payment_terms_days varchar [note: 'The number of days allowed for payment after invoice date, as agreed in the master service agreement. Common values include 30, 60, or 90 days. Zero indicates prepayment required. | Column payment_terms_days (INT) in sales.sales_account']
  preferred_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which this account prefers to transact and receive invoices (e.g., USD, GBP, EUR, CAD). | Column preferred_currency_code (STRING) in sales.sales_account']
  primary_contact_email varchar [note: 'The email address of the primary business contact for proposals, campaign planning, and general account communication. | Column primary_contact_email (STRING) in sales.sales_account']
  primary_contact_name varchar [note: 'The full name of the primary business contact or account manager at the client organization who handles day-to-day commercial and operational matters. | Column primary_contact_name (STRING) in sales.sales_account']
  primary_contact_phone varchar [note: 'The phone number of the primary business contact for urgent campaign or operational matters. | Column primary_contact_phone (STRING) in sales.sales_account']
  salesforce_account_reference varchar [note: 'The source system identifier from Salesforce Media Cloud CRM. This is the external key used to synchronize account data between the lakehouse and the operational CRM system. | Column salesforce_account_reference (STRING) in sales.sales_account']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sales_account']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sales_account']
  tax_id_number varchar [note: 'The tax identification number (TIN), employer identification number (EIN), or value-added tax (VAT) registration number for this account. Used for tax reporting and compliance. | Column tax_id_number (STRING) in sales.sales_account']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sales_account']

  Note: 'Master record for advertising agencies, direct advertisers, content licensees, syndication buyers, and distribution partners that engage in commercial transactions with Media Broadcasting. Serves as the SSOT for all sales-facing organizational identities — capturing account type (agency, direct, MVPD, syndicator), holding company hierarchy, credit rating, payment terms, assigned sales rep, market territory, agency commission rate, blackout restrictions, preferred currency, and CRM source ID from Salesforce Media Cloud. This is the commercial counterpart to subscriber identity and is the anchor entity for all sales pipeline activity. | Unity Catalog table: media_broadcasting_ecm.sales.sales_account'
}

Table sales.sales_contact {
  sales_contact_id varchar [pk, note: 'Unique identifier for the sales contact record. Primary key. | Column sales_contact_id (BIGINT) in sales.sales_contact']
  assigned_sales_rep_id varchar [note: 'Reference to the sales representative or account executive responsible for managing this contact relationship. | Column assigned_sales_rep_id (BIGINT) in sales.sales_contact']
  sales_account_id varchar [note: 'Reference to the parent sales account or advertiser organization this contact belongs to. | Column sales_account_id (BIGINT) in sales.sales_contact']
  sales_agency_id varchar [note: 'Reference to the advertising agency this contact represents, if applicable. Null for direct brand contacts. | Column sales_agency_id (BIGINT) in sales.sales_contact']
  sales_employee_id varchar [note: 'Reference to the system user who originally created this contact record. | Column employee_id (BIGINT) in workforce.sales_contact']
  sales_last_modified_by_user_employee_id varchar [note: 'Reference to the system user who most recently modified this contact record. | Column last_modified_by_user_employee_id (BIGINT) in workforce.sales_contact']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sales_contact']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sales_contact']
  budget_authority_usd decimal(18,2) [note: 'Estimated annual advertising budget the contact controls or influences, in USD. Used for opportunity sizing and account prioritization. | Column budget_authority_usd (DECIMAL(18,2)) in sales.sales_contact']
  contact_source varchar [note: 'Origin or acquisition channel through which this contact was first captured. Used for lead source attribution and ROI analysis. | Column contact_source (STRING) in sales.sales_contact']
  contact_status varchar [note: 'Current lifecycle status of the contact. Inactive or departed contacts are excluded from active sales campaigns. | Column contact_status (STRING) in sales.sales_contact']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sales_contact']
  created_timestamp timestamp [note: 'Timestamp when this contact record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.sales_contact']
  decision_authority_level varchar [note: 'Level of purchasing authority the contact holds within their organization. Critical for routing proposals and negotiating upfront commitments. | Column decision_authority_level (STRING) in sales.sales_contact']
  do_not_contact boolean [note: 'Master suppression flag indicating the contact has requested no further outreach. Overrides all other opt-in settings. | Column do_not_contact (BOOLEAN) in sales.sales_contact']
  email_address varchar [note: 'Primary business email address for the sales contact. Used for proposal delivery, upfront negotiation, and campaign communication. | Column email_address (STRING) in sales.sales_contact']
  first_name varchar [note: 'Given name of the sales contact individual. | Column first_name (STRING) in sales.sales_contact']
  full_name varchar [note: 'Complete display name of the sales contact, typically concatenation of first and last name. | Column full_name (STRING) in sales.sales_contact']
  last_contact_date date [note: 'Date of the most recent sales interaction or touchpoint with this contact. Used for relationship health scoring. | Column last_contact_date (DATE) in sales.sales_contact']
  last_modified_timestamp timestamp [note: 'Timestamp when this contact record was most recently updated. | Column last_modified_timestamp (TIMESTAMP) in sales.sales_contact']
  last_name varchar [note: 'Family name or surname of the sales contact individual. | Column last_name (STRING) in sales.sales_contact']
  linkedin_profile_url varchar [note: 'URL to the contact\'s LinkedIn professional profile. Used for relationship intelligence and network mapping. | Column linkedin_profile_url (STRING) in sales.sales_contact']
  mailing_address_line1 varchar [note: 'Primary street address line for physical correspondence and contract delivery. | Column mailing_address_line1 (STRING) in sales.sales_contact']
  mailing_address_line2 varchar [note: 'Secondary address line for suite, floor, or department information. | Column mailing_address_line2 (STRING) in sales.sales_contact']
  mailing_city varchar [note: 'City name for the contact\'s mailing address. | Column mailing_city (STRING) in sales.sales_contact']
  mailing_country_code varchar [note: 'Three-letter ISO country code for the contact\'s mailing address (e.g., USA, CAN, GBR). | Column mailing_country_code (STRING) in sales.sales_contact']
  mailing_postal_code varchar [note: 'Postal or ZIP code for the contact\'s mailing address. | Column mailing_postal_code (STRING) in sales.sales_contact']
  mailing_state_province varchar [note: 'State, province, or region for the contact\'s mailing address. | Column mailing_state_province (STRING) in sales.sales_contact']
  mobile_number varchar [note: 'Mobile or cellular phone number for urgent or time-sensitive communication during upfront or scatter market negotiations. | Column mobile_number (STRING) in sales.sales_contact']
  next_follow_up_date date [note: 'Scheduled date for the next planned outreach or follow-up activity with this contact. | Column next_follow_up_date (DATE) in sales.sales_contact']
  notes varchar [note: 'Free-form text field for sales team to capture relationship notes, preferences, and context about the contact. | Column notes (STRING) in sales.sales_contact']
  opt_in_email boolean [note: 'Indicates whether the contact has explicitly consented to receive marketing and promotional emails. | Column opt_in_email (BOOLEAN) in sales.sales_contact']
  opt_in_phone boolean [note: 'Indicates whether the contact has consented to receive phone calls for sales and marketing purposes. | Column opt_in_phone (BOOLEAN) in sales.sales_contact']
  opt_in_sms boolean [note: 'Indicates whether the contact has consented to receive SMS text messages for time-sensitive sales notifications. | Column opt_in_sms (BOOLEAN) in sales.sales_contact']
  phone_number varchar [note: 'Primary business telephone number for direct contact. May include extension. | Column phone_number (STRING) in sales.sales_contact']
  preferred_communication_channel varchar [note: 'Contact\'s stated preference for how they wish to be reached for sales discussions and proposal reviews. | Column preferred_communication_channel (STRING) in sales.sales_contact']
  primary_contact_flag boolean [note: 'Indicates whether this contact is the primary point of contact for their account. Used for proposal routing and commission attribution. | Column primary_contact_flag (BOOLEAN) in sales.sales_contact']
  relationship_tier varchar [note: 'Classification of the contact\'s relationship strength and priority level. Strategic contacts receive white-glove service and early access to upfront inventory. | Column relationship_tier (STRING) in sales.sales_contact']
  role_type varchar [note: 'Functional role classification of the contact in the sales process. Determines routing and approval workflows. | Column role_type (STRING) in sales.sales_contact']
  sales_partner_contact_id varchar [note: 'Foreign key to SSOT partner.partner_contact']
  sales_partner_partner_contact_id varchar [note: 'FK to SSOT partner.partner_contact']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sales_contact']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sales_contact']
  title varchar [note: 'Professional job title or position of the contact within their organization (e.g., Media Buyer, Brand Manager, VP of Marketing). | Column title (STRING) in sales.sales_contact']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sales_contact']

  Note: 'Individual buyer, decision-maker, or agency representative associated with a sales account. Tracks name, title, role (media buyer, planner, brand manager, legal), email, phone, preferred communication channel, opt-in status, and relationship tier. Sourced from Salesforce Media Cloud Contact object. Supports upfront negotiation tracking, proposal routing, and commission attribution. Distinct from subscriber identity — this is a B2B commercial contact, not a consumer. | Unity Catalog table: media_broadcasting_ecm.sales.sales_contact'
}

Table sales.opportunity {
  opportunity_id varchar [pk, note: 'Unique identifier for the sales opportunity record. Primary key sourced from Salesforce Media Cloud Opportunity object. | Column opportunity_id (BIGINT) in sales.opportunity']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Opportunities represent potential deals with billing accounts. Sales pipeline reporting, revenue forecasting, and opportunity-to-invoice tracking require linking opportunities to the billing account t | Column billing_account_id (BIGINT) in billing.opportunity']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Sales opportunities for facility-based services (studio bookings, transmission capacity, uplink services) require facility identification for availability checks, pricing, and resource allocation duri | Column broadcast_facility_id (BIGINT) in technology.opportunity']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Sales opportunities for broadcast advertising must reference the licensed station where ads will air for FCC compliance tracking, public inspection file requirements, and regulatory reporting. Station | Column broadcast_license_id (BIGINT) in compliance.opportunity']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Opportunities must be assigned to cost centers for budget tracking, P&L attribution, and sales forecast roll-up by business unit. Essential for financial planning and variance analysis in media sales  | Column cost_center_id (BIGINT) in finance.opportunity']
  employee_id varchar [note: 'Reference to the sales representative or account executive assigned as the primary owner of this opportunity. Used for commission calculation and territory management. | Column employee_id (BIGINT) in workforce.opportunity']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Opportunities require profit center attribution for segment reporting, EBITDA tracking, and management reporting by business line (Linear TV, Streaming, Syndication). Critical for quarterly business r | Column profit_center_id (BIGINT) in finance.opportunity']
  sales_account_id varchar [note: 'Reference to the advertiser or client account associated with this opportunity. Links to the master account record in Salesforce Media Cloud. | Column sales_account_id (BIGINT) in sales.opportunity']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser in this deal. Null for direct sales. Links to agency master record. | Column sales_agency_id (BIGINT) in sales.opportunity']
  sales_team_id varchar [note: 'Reference to the sales team or division responsible for this opportunity (e.g., National Sales, Local Sales, Digital Sales). Used for team performance tracking and territory alignment. | Column sales_team_id (BIGINT) in sales.opportunity']
  sales_territory_id varchar [note: 'Foreign key linking to sales.sales_territory. Business justification: Opportunities belong to sales territories for territory management and quota allocation. This FK enables territory-based opportunity tracking. N:1 relationship. New attribute needed for territory mana | Column sales_territory_id (BIGINT) in sales.opportunity']
  upfront_deal_id varchar [note: 'Reference to the parent upfront commitment deal if this opportunity is part of an upfront negotiation. Null for scatter market and direct deals. Used to track upfront commitment fulfillment. | Column upfront_deal_id (BIGINT) in sales.opportunity']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.opportunity']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.opportunity']
  campaign_objective varchar [note: 'Primary marketing objective the advertiser aims to achieve with this campaign. Influences creative strategy, placement selection, and success metrics. [ENUM-REF-CANDIDATE: brand_awareness|product_launch|direct_response|lead_generation|traffic|engagement|video_views|app_installs — 8 candidates stripped; promote to reference product] | Column campaign_objective (STRING) in sales.opportunity']
  close_date date [note: 'Target date by which the sales team expects to close this opportunity (win or lose). Used for pipeline forecasting and sales velocity tracking. Updated as negotiations progress. | Column close_date (DATE) in sales.opportunity']
  closed_date date [note: 'Actual date when the opportunity was marked as closed-won or closed-lost. Null for open opportunities. Used for sales cycle analysis and win rate calculation. | Column closed_date (DATE) in sales.opportunity']
  competitive_displacement varchar [note: 'Free-text notes capturing competitive intelligence about which competitor this deal may displace or compete against. Used for win/loss analysis and competitive strategy. | Column competitive_displacement (STRING) in sales.opportunity']
  cpm_rate decimal(10,2) [note: 'Cost per thousand impressions rate negotiated for this opportunity. Standard pricing metric for digital and streaming advertising. Expressed in currency per 1,000 impressions. | Column cpm_rate (DECIMAL(10,2)) in sales.opportunity']
  cprp_rate decimal(10,2) [note: 'Cost per rating point negotiated for linear TV or radio buys. Standard pricing metric for broadcast advertising. Calculated as total cost divided by total GRPs delivered. | Column cprp_rate (DECIMAL(10,2)) in sales.opportunity']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.opportunity']
  created_timestamp timestamp [note: 'Timestamp when this opportunity record was first created in Salesforce Media Cloud. Used for lead-to-close cycle time analysis and pipeline velocity tracking. | Column created_timestamp (TIMESTAMP) in sales.opportunity']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the estimated value (e.g., USD, GBP, EUR). Supports multi-currency deal tracking for international sales. | Column currency_code (STRING) in sales.opportunity']
  daypart varchar [note: 'Time segment of the broadcast day targeted by this opportunity. Daypart classification affects pricing and audience demographics. Applicable primarily to linear TV and radio deals. [ENUM-REF-CANDIDATE: early_morning|daytime|early_fringe|prime_access|prime_time|late_fringe|late_night|overnight|weekend|sports|news — 11 candidates stripped; promote to reference product] | Column daypart (STRING) in sales.opportunity']
  deal_type varchar [note: 'Classification of the sales opportunity by transaction model. Upfront = advance commitment during upfront season; Scatter = last-minute inventory sales; Direct = direct-sold advertising; Programmatic Guaranteed = automated guaranteed buys; Content License = licensing content rights; Syndication = resale of content to multiple outlets. | Column deal_type (STRING) in sales.opportunity']
  demographic_target varchar [note: 'Primary demographic audience segment targeted by this campaign (e.g., \'Adults 18-49\', \'Women 25-54\', \'Men 18-34\'). Used for audience guarantee and measurement alignment. | Column demographic_target (STRING) in sales.opportunity']
  estimated_value decimal(15,2) [note: 'Total estimated revenue value of the opportunity in USD. For advertising deals, represents total campaign spend; for content licensing, represents license fee. Used for revenue forecasting and quota tracking. | Column estimated_value (DECIMAL(15,2)) in sales.opportunity']
  flight_end_date date [note: 'Planned end date for the advertising campaign or content distribution window. Defines the duration of the media buy or license period. | Column flight_end_date (DATE) in sales.opportunity']
  flight_start_date date [note: 'Planned start date for the advertising campaign or content distribution window. For advertising, marks the beginning of the ad flight; for content licensing, marks the start of the license window. | Column flight_start_date (DATE) in sales.opportunity']
  forecast_category varchar [note: 'Sales forecast category indicating confidence level for revenue recognition. Pipeline = early stage; Best Case = likely but not committed; Commit = high confidence; Closed = won. Used for revenue forecasting rollups. | Column forecast_category (STRING) in sales.opportunity']
  is_upfront boolean [note: 'Boolean flag indicating whether this opportunity is part of the annual upfront sales season. True = upfront commitment; False = scatter market or other deal type. Used for upfront tracking and reporting. | Column is_upfront (BOOLEAN) in sales.opportunity']
  last_activity_date date [note: 'Date of the most recent sales activity (call, email, meeting) logged against this opportunity. Used for pipeline hygiene monitoring and stale opportunity identification. | Column last_activity_date (DATE) in sales.opportunity']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to this opportunity record. Used for data freshness validation and change tracking. Updated automatically on any field modification. | Column last_modified_timestamp (TIMESTAMP) in sales.opportunity']
  lead_source varchar [note: 'Origin channel of this sales opportunity. Tracks how the lead was generated for marketing attribution and lead source ROI analysis. [ENUM-REF-CANDIDATE: inbound|outbound|referral|event|partner|renewal|upsell — 7 candidates stripped; promote to reference product] | Column lead_source (STRING) in sales.opportunity']
  loss_notes varchar [note: 'Free-text detailed explanation of why the opportunity was lost. Captures competitive intelligence, pricing feedback, and strategic insights for future deals. | Column loss_notes (STRING) in sales.opportunity']
  loss_reason varchar [note: 'Primary reason for losing the opportunity if stage is closed-lost. Used for loss analysis, competitive intelligence, and sales process improvement. Null for won or open opportunities. | Column loss_reason (STRING) in sales.opportunity']
  next_step varchar [note: 'Description of the next action or milestone required to advance this opportunity. Used for sales activity tracking and pipeline hygiene. Updated regularly by sales executive. | Column next_step (STRING) in sales.opportunity']
  opportunity_name varchar [note: 'Descriptive name of the sales opportunity, typically including advertiser name, campaign type, and time period (e.g., \'Acme Corp Q4 Upfront Buy\'). | Column opportunity_name (STRING) in sales.opportunity']
  opportunity_number varchar [note: 'Human-readable business identifier for the opportunity, typically auto-generated in format OPP-YYYYNNNN. Used in sales communications and reporting. | Column opportunity_number (STRING) in sales.opportunity']
  probability decimal(5,2) [note: 'Estimated likelihood of closing this opportunity as a percentage (0.00 to 100.00). Typically aligned with stage (e.g., Proposal = 40%, Negotiation = 60%). Used for weighted pipeline forecasting. | Column probability (DECIMAL(5,2)) in sales.opportunity']
  product_category varchar [note: 'High-level classification of the media product being sold. Linear TV = traditional broadcast; Digital Video = online video ads; Streaming = OTT/SVOD/AVOD inventory; Content Licensing = rights to broadcast content. [ENUM-REF-CANDIDATE: linear_tv|digital_video|streaming|radio|podcast|display|social|sponsorship|content_licensing — 9 candidates stripped; promote to reference product] | Column product_category (STRING) in sales.opportunity']
  requires_makegood boolean [note: 'Boolean flag indicating whether this opportunity includes makegood provisions for audience delivery shortfalls. True = makegoods may be required if audience guarantees are not met. Used for inventory planning. | Column requires_makegood (BOOLEAN) in sales.opportunity']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.opportunity']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.opportunity']
  stage varchar [note: 'Current stage in the sales pipeline lifecycle. Tracks progression from initial prospecting through closure. Used for pipeline forecasting and sales funnel analysis. | Column stage (STRING) in sales.opportunity']
  target_grp decimal(10,2) [note: 'Target Gross Rating Points representing the total audience reach multiplied by frequency. Standard metric for linear TV and radio campaign planning. One GRP = 1% of the target audience reached. | Column target_grp (DECIMAL(10,2)) in sales.opportunity']
  target_impressions varchar [note: 'Total number of ad impressions committed in this opportunity. Primary delivery metric for digital video, streaming, and programmatic deals. Measured in thousands or millions. | Column target_impressions (BIGINT) in sales.opportunity']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.opportunity']

  Note: 'A qualified sales pursuit representing a potential advertising campaign, content licensing deal, syndication agreement, or distribution carriage negotiation. Tracks deal stage (prospecting, proposal, negotiation, closed-won, closed-lost), estimated deal value, deal type (upfront, scatter, direct, programmatic guaranteed, content license, syndication), target flight dates, assigned sales executive, probability of close, and competitive displacement notes. Sourced from Salesforce Media Cloud Opportunity object. The primary pipeline entity feeding revenue forecasting and upfront commitment tracking. | Unity Catalog table: media_broadcasting_ecm.sales.opportunity'
}

Table sales.proposal {
  proposal_id varchar [pk, note: 'Primary key for proposal']
  advertiser_id varchar [note: 'FK to advertiser']
  campaign_id varchar [note: 'FK to campaign']
  proposal_approved_by_employee_id varchar [note: 'FK to employee who approved the proposal']
  proposal_created_by_employee_id varchar [note: 'FK to employee who created the proposal']
  proposal_rep_id varchar [note: 'FK to sales rep']
  proposal_sales_agency_id varchar [note: 'FK to sales agency']
  proposal_sales_rep_id varchar [note: 'FK to sales representative']
  sales_account_id varchar [note: 'FK to sales account']
  sales_agency_id varchar [note: 'FK to sales agency']
  approval_date date [note: 'Date proposal was approved']
  approved_at timestamp [note: 'Timestamp when proposal was approved']
  channel_mix varchar [note: 'Proposed channel distribution']
  commission_rate decimal(5,4) [note: 'Agency commission rate']
  cpm decimal(10,2) [note: 'Proposed cost per thousand']
  created_at timestamp [note: 'Record creation timestamp']
  created_timestamp timestamp [note: 'Timestamp when record was created']
  currency_code varchar [note: 'Currency code for budget (ISO 4217)']
  daypart_mix varchar [note: 'Proposed daypart distribution']
  discount_percent decimal(5,2) [note: 'Discount percentage applied to proposal']
  discount_percentage decimal(5,2) [note: 'Discount percentage offered']
  expiration_date date [note: 'Date proposal expires']
  expiry_date date [note: 'Date proposal expires']
  flight_end_date date [note: 'Campaign flight end date']
  flight_start_date date [note: 'Campaign flight start date']
  modified_timestamp timestamp [note: 'Timestamp when record was last modified']
  net_proposed_value decimal(18,2) [note: 'Net value after discounts']
  notes varchar [note: 'Additional notes or comments']
  payment_terms varchar [note: 'Payment terms (net 30, net 60, etc.)']
  proposal_date date [note: 'Date proposal was created']
  proposal_name varchar [note: 'Name of the sales proposal']
  proposal_number varchar [note: 'Unique proposal reference number']
  proposal_status varchar [note: 'Current status of the proposal (draft, submitted, approved, rejected)']
  proposal_type varchar [note: 'Type of proposal (upfront, scatter, sponsorship)']
  proposed_grp decimal(10,2) [note: 'Proposed gross rating points']
  proposed_impressions varchar [note: 'Proposed impression delivery']
  rejected_at timestamp [note: 'Timestamp when proposal was rejected']
  rejection_reason varchar [note: 'Reason for rejection if applicable']
  submitted_at timestamp [note: 'Timestamp when proposal was submitted']
  submitted_timestamp timestamp [note: 'Timestamp when proposal was submitted']
  target_demographic varchar [note: 'Target demographic audience']
  terms_and_conditions varchar [note: 'Terms and conditions text']
  total_budget_amount decimal(18,2) [note: 'Total proposed budget amount']
  total_proposed_value decimal(18,2) [note: 'Total proposed monetary value']
  total_value decimal(18,2) [note: 'Total monetary value of the proposal']
  updated_at timestamp [note: 'Record last update timestamp']
  valid_from_date date [note: 'Start of proposal validity period']
  valid_to_date date [note: 'End of proposal validity period']
  version varchar [note: 'Version number of the proposal']
  version_number varchar [note: 'Proposal version number']
  win_probability_percent decimal(5,2) [note: 'Estimated probability of winning the deal']

  Note: 'A formal commercial offer presented to an advertiser, agency, or content buyer in response to an RFP or proactive pitch. Captures proposal version, total proposed value, CPM/GRP targets, daypart mix, platform mix (linear, OTT, FAST, AVOD), content adjacency preferences, audience demographic targets, flight start and end dates, proposal status (draft, submitted, revised, accepted, rejected), and expiry date. Linked to an opportunity and one or more rate cards. Sourced from Salesforce Media Cloud Proposal/Quote object. | Unity Catalog table: media_broadcasting_ecm.sales.proposal'
}

Table sales.proposal_line {
  proposal_line_id varchar [pk, note: 'Unique identifier for the proposal line item. Primary key. | Column proposal_line_id (BIGINT) in sales.proposal_line']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Each proposal line specifies inventory on a specific channel. Business process: line-item inventory allocation, channel-specific rate card application, audience delivery planning. Replaces denormalize | Column channel_id (BIGINT) in scheduling.proposal_line']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Proposal lines specify daypart for inventory being offered. Business process: daypart-based pricing, audience targeting, GRP/impression estimation. Replaces denormalized daypart text field with proper | Column daypart_id (BIGINT) in scheduling.proposal_line']
  licensed_media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Individual proposal lines in content licensing proposals specify which media assets are included in each license grant. This enables line-level asset availability checking, format specification matchi | Column licensed_media_asset_id (BIGINT) in mediaasset.proposal_line']
  primary_proposal_employee_id varchar [note: 'Reference to the sales user who created this proposal line item. | Column primary_proposal_employee_id (BIGINT) in workforce.proposal_line']
  product_id varchar [note: 'Reference to the advertising product or content license offering being proposed in this line. | Column product_id (BIGINT) in sales.proposal_line']
  rate_card_id varchar [note: 'Reference to the rate card used as the basis for pricing this proposal line. | Column rate_card_id (BIGINT) in advertising.proposal_line']
  sales_proposal_id varchar [note: 'Reference to the parent sales proposal containing this line item. | Column sales_proposal_id (BIGINT) in sales.proposal_line']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.proposal_line']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.proposal_line']
  agency_commission_percentage decimal(5,2) [note: 'Percentage commission allocated to the advertising agency for this line item. | Column agency_commission_percentage (DECIMAL(5,2)) in sales.proposal_line']
  audience_guarantee_flag boolean [note: 'Indicates whether this line includes an audience delivery guarantee requiring makegoods if underdelivered. | Column audience_guarantee_flag (BOOLEAN) in sales.proposal_line']
  cpm decimal(10,2) [note: 'Cost per thousand impressions for this inventory line, a standard pricing metric in advertising. | Column cpm (DECIMAL(10,2)) in sales.proposal_line']
  cprp decimal(15,2) [note: 'Cost per rating point for this line item, used in broadcast television pricing. | Column cprp (DECIMAL(15,2)) in sales.proposal_line']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.proposal_line']
  created_timestamp timestamp [note: 'Date and time when this proposal line item record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.proposal_line']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this line item. | Column currency_code (STRING) in sales.proposal_line']
  discount_amount decimal(15,2) [note: 'Absolute dollar amount of discount applied to this line item. | Column discount_amount (DECIMAL(15,2)) in sales.proposal_line']
  discount_percentage decimal(5,2) [note: 'Percentage discount applied to this line item (e.g., volume discount, upfront commitment discount). | Column discount_percentage (DECIMAL(5,2)) in sales.proposal_line']
  flight_end_date date [note: 'End date of the proposed campaign flight or license window for this line item. | Column flight_end_date (DATE) in sales.proposal_line']
  flight_start_date date [note: 'Start date of the proposed campaign flight or license window for this line item. | Column flight_start_date (DATE) in sales.proposal_line']
  gross_amount decimal(15,2) [note: 'Total gross value of this proposal line before any discounts or adjustments. | Column gross_amount (DECIMAL(15,2)) in sales.proposal_line']
  guaranteed_impressions varchar [note: 'Minimum number of impressions guaranteed to be delivered for this line item if audience guarantee applies. | Column guaranteed_impressions (BIGINT) in sales.proposal_line']
  inventory_type varchar [note: 'Type of advertising or content inventory unit being offered in this proposal line. [ENUM-REF-CANDIDATE: linear_spot|digital_preroll|digital_midroll|sponsorship|program_integration|content_license|syndication_slot|vod_placement|fast_channel|display_banner — 10 candidates stripped; promote to reference product] | Column inventory_type (STRING) in sales.proposal_line']
  line_description varchar [note: 'Detailed description of the inventory offering, targeting, and special terms for this proposal line. | Column line_description (STRING) in sales.proposal_line']
  line_number varchar [note: 'Sequential line number within the proposal for ordering and reference purposes. | Column line_number (INT) in sales.proposal_line']
  line_status varchar [note: 'Current status of this proposal line item in the sales negotiation lifecycle. | Column line_status (STRING) in sales.proposal_line']
  makegood_eligible_flag boolean [note: 'Indicates whether this line item is eligible for makegood spots if delivery guarantees are not met. | Column makegood_eligible_flag (BOOLEAN) in sales.proposal_line']
  modified_timestamp timestamp [note: 'Date and time when this proposal line item record was last modified. | Column modified_timestamp (TIMESTAMP) in sales.proposal_line']
  net_amount decimal(15,2) [note: 'Net value of this proposal line after discounts and before agency commission. | Column net_amount (DECIMAL(15,2)) in sales.proposal_line']
  notes varchar [note: 'Additional notes, comments, or special instructions related to this proposal line item. | Column notes (STRING) in sales.proposal_line']
  platform varchar [note: 'Distribution platform or channel where the inventory will be delivered. [ENUM-REF-CANDIDATE: linear_tv|ott|vod|svod|avod|fast|digital_web|mobile_app|social_media|podcast — 10 candidates stripped; promote to reference product] | Column platform (STRING) in sales.proposal_line']
  proposed_grp decimal(10,2) [note: 'Estimated Gross Rating Points to be delivered, representing the sum of ratings achieved by the schedule. | Column proposed_grp (DECIMAL(10,2)) in sales.proposal_line']
  proposed_impressions varchar [note: 'Estimated number of impressions or views to be delivered for this line item. | Column proposed_impressions (BIGINT) in sales.proposal_line']
  proposed_trp decimal(10,2) [note: 'Estimated Target Rating Points for the specific demographic audience being targeted. | Column proposed_trp (DECIMAL(10,2)) in sales.proposal_line']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.proposal_line']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.proposal_line']
  target_demographic varchar [note: 'Audience demographic segment being targeted for this inventory (e.g., Adults 18-49, Women 25-54). | Column target_demographic (STRING) in sales.proposal_line']
  unit_length_seconds varchar [note: 'Duration of each advertising unit in seconds (e.g., 15, 30, 60 seconds for spots). | Column unit_length_seconds (INT) in sales.proposal_line']
  unit_quantity varchar [note: 'Number of advertising units or spots being proposed in this line (e.g., 30 spots, 5 sponsorships). | Column unit_quantity (INT) in sales.proposal_line']
  unit_rate decimal(15,2) [note: 'Proposed rate per individual unit (e.g., cost per spot, cost per sponsorship). | Column unit_rate (DECIMAL(15,2)) in sales.proposal_line']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.proposal_line']

  Note: 'Individual line item within a sales proposal, representing a specific inventory unit being offered — a daypart block, a program sponsorship, a digital pre-roll package, a content license window, or a syndication slot. Captures unit type, platform, channel or property, daypart, audience demographic target, proposed impressions or GRPs, unit rate, CPM, total line value, and makegood eligibility flag. Enables granular negotiation at the inventory unit level before order commitment. | Unity Catalog table: media_broadcasting_ecm.sales.proposal_line Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.upfront_commitment {
  upfront_commitment_id varchar [pk, note: 'Unique identifier for the upfront commitment record. Primary key. | Column upfront_commitment_id (BIGINT) in sales.upfront_commitment']
  advertiser_id varchar [note: 'Reference to the advertiser account that made this upfront commitment. | Column advertiser_id (BIGINT) in sales.upfront_commitment']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Upfront commitments are multi-million dollar contractual obligations with billing accounts. Accounts receivable forecasting, commitment fulfillment tracking, and option exercise billing require linkin | Column billing_account_id (BIGINT) in billing.upfront_commitment']
  opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Upfront commitments result from closed opportunities during the upfront sales cycle. This FK enables tracing commitments back to their originating opportunities. N:1 relationship. New attribute needed | Column opportunity_id (BIGINT) in sales.upfront_commitment']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Upfront commitments represent multi-year revenue contracts requiring revenue stream mapping for recognition scheduling and deferred revenue tracking. Critical for upfront revenue recognition over flig | Column revenue_stream_id (BIGINT) in finance.upfront_commitment']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser in this upfront deal. | Column sales_agency_id (BIGINT) in sales.upfront_commitment']
  sales_rep_id varchar [note: 'FK to sales.rep | Column sales_rep_id (BIGINT) in sales.upfront_commitment']
  upfront_deal_id varchar [note: 'Foreign key linking to sales.upfront_deal. Business justification: Upfront commitments are the binding financial commitments resulting from upfront deal negotiations. This FK links the commitment back to the deal negotiation that produced it, tracking the progression | Column upfront_deal_id (BIGINT) in sales.upfront_commitment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.upfront_commitment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.upfront_commitment']
  adjusted_commitment_amount decimal(18,2) [note: 'The current binding commitment amount after all option exercises and cancellations have been applied. Calculated as total_committed_spend minus total_cancelled_amount. | Column adjusted_commitment_amount (DECIMAL(18,2)) in sales.upfront_commitment']
  audience_guarantee_flag boolean [note: 'Indicates whether the upfront commitment includes audience delivery guarantees based on ratings or impressions. | Column audience_guarantee_flag (BOOLEAN) in sales.upfront_commitment']
  cancellation_option_percentage decimal(5,2) [note: 'The percentage of the total commitment that the advertiser has the option to cancel at defined option dates, typically 50%. | Column cancellation_option_percentage (DECIMAL(5,2)) in sales.upfront_commitment']
  commitment_date date [note: 'The date when the upfront commitment was formally executed and became binding. | Column commitment_date (DATE) in sales.upfront_commitment']
  commitment_number varchar [note: 'Business identifier for the upfront commitment, used in sales and billing communications. | Column commitment_number (STRING) in sales.upfront_commitment']
  commitment_status varchar [note: 'Current lifecycle status of the upfront commitment. [ENUM-REF-CANDIDATE: draft|pending_approval|confirmed|active|partially_fulfilled|fulfilled|cancelled|expired — 8 candidates stripped; promote to reference product] | Column commitment_status (STRING) in sales.upfront_commitment']
  committed_grp_volume decimal(12,2) [note: 'The total GRP volume committed by the advertiser across the upfront period. GRP represents the sum of ratings achieved by the campaign. | Column committed_grp_volume (DECIMAL(12,2)) in sales.upfront_commitment']
  committed_impression_volume varchar [note: 'The total number of impressions committed by the advertiser across the upfront period, typically used for digital and streaming platforms. | Column committed_impression_volume (BIGINT) in sales.upfront_commitment']
  contract_document_reference varchar [note: 'Reference identifier or file path to the executed upfront contract document. | Column contract_document_reference (STRING) in sales.upfront_commitment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.upfront_commitment']
  created_timestamp timestamp [note: 'The timestamp when this upfront commitment record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.upfront_commitment']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the committed spend amount. | Column currency_code (STRING) in sales.upfront_commitment']
  daypart_allocation varchar [note: 'The broadcast daypart segments allocated for this upfront commitment (e.g., Prime Time, Early Morning, Late Night). Multiple dayparts may be specified. | Column daypart_allocation (STRING) in sales.upfront_commitment']
  delivered_spend_to_date decimal(18,2) [note: 'The cumulative dollar amount that has been delivered against this upfront commitment through actual ad orders and campaigns. | Column delivered_spend_to_date (DECIMAL(18,2)) in sales.upfront_commitment']
  digital_allocation_amount decimal(18,2) [note: 'The portion of the total committed spend allocated to digital platform inventory. | Column digital_allocation_amount (DECIMAL(18,2)) in sales.upfront_commitment']
  effective_end_date date [note: 'The date when the upfront commitment period ends, typically the end of the broadcast season. | Column effective_end_date (DATE) in sales.upfront_commitment']
  effective_start_date date [note: 'The date when the upfront commitment period begins, typically the start of the broadcast season. | Column effective_start_date (DATE) in sales.upfront_commitment']
  first_option_date date [note: 'The first date on which the advertiser may exercise their cancellation option. | Column first_option_date (DATE) in sales.upfront_commitment']
  fulfillment_percentage decimal(5,2) [note: 'The percentage of the adjusted commitment that has been fulfilled through delivered spend. Calculated as (delivered_spend_to_date / adjusted_commitment_amount) * 100. | Column fulfillment_percentage (DECIMAL(5,2)) in sales.upfront_commitment']
  guaranteed_cpm decimal(10,2) [note: 'The guaranteed CPM rate negotiated for this upfront commitment. CPM represents the cost per thousand impressions. | Column guaranteed_cpm (DECIMAL(10,2)) in sales.upfront_commitment']
  last_modified_timestamp timestamp [note: 'The timestamp when this upfront commitment record was last modified. | Column last_modified_timestamp (TIMESTAMP) in sales.upfront_commitment']
  linear_allocation_amount decimal(18,2) [note: 'The portion of the total committed spend allocated to linear (traditional broadcast) television inventory. | Column linear_allocation_amount (DECIMAL(18,2)) in sales.upfront_commitment']
  makegood_provision_flag boolean [note: 'Indicates whether the upfront commitment includes provisions for makegood spots (compensatory ad spots) if delivery guarantees are not met. | Column makegood_provision_flag (BOOLEAN) in sales.upfront_commitment']
  notes varchar [note: 'Free-form notes and comments related to this upfront commitment, including special terms, conditions, or historical context. | Column notes (STRING) in sales.upfront_commitment']
  remaining_commitment_balance decimal(18,2) [note: 'The remaining dollar amount yet to be fulfilled against the adjusted commitment. Calculated as adjusted_commitment_amount minus delivered_spend_to_date. | Column remaining_commitment_balance (DECIMAL(18,2)) in sales.upfront_commitment']
  second_option_date date [note: 'The second date on which the advertiser may exercise their cancellation option, if applicable. | Column second_option_date (DATE) in sales.upfront_commitment']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.upfront_commitment']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.upfront_commitment']
  streaming_allocation_amount decimal(18,2) [note: 'The portion of the total committed spend allocated to streaming (OTT, SVOD, AVOD) platform inventory. | Column streaming_allocation_amount (DECIMAL(18,2)) in sales.upfront_commitment']
  target_demographic varchar [note: 'The primary audience demographic segment targeted by this upfront commitment (e.g., Adults 18-49, Women 25-54). | Column target_demographic (STRING) in sales.upfront_commitment']
  third_option_date date [note: 'The third date on which the advertiser may exercise their cancellation option, if applicable. | Column third_option_date (DATE) in sales.upfront_commitment']
  total_cancelled_amount decimal(18,2) [note: 'The cumulative dollar amount that has been cancelled by the advertiser across all option exercise events. | Column total_cancelled_amount (DECIMAL(18,2)) in sales.upfront_commitment']
  total_committed_spend decimal(18,2) [note: 'The total dollar amount the advertiser or agency committed to spend during the upfront period. | Column total_committed_spend (DECIMAL(18,2)) in sales.upfront_commitment']
  total_exercised_amount decimal(18,2) [note: 'The cumulative dollar amount that has been exercised (confirmed for delivery) across all option exercise events. | Column total_exercised_amount (DECIMAL(18,2)) in sales.upfront_commitment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.upfront_commitment']
  upfront_year varchar [note: 'The broadcast season year for this upfront commitment, typically formatted as YYYY-YYYY (e.g., 2024-2025). | Column upfront_year (STRING) in sales.upfront_commitment']

  Note: 'A binding advance advertising sales commitment made during the annual upfront market, representing a guaranteed spend level from an advertiser or agency across a broadcast season. Captures upfront year, advertiser account, agency, total committed spend, committed GRP or impression volume, platform allocation (linear, digital, streaming), cancellation option windows (typically 50% cancellable at defined dates), option exercise history (exercise date, exercised amount, cancelled amount per window, cancellation reason), resulting adjusted commitment after each option date, and fulfillment tracking against actual delivered orders. The SSOT for upfront deal obligations feeding scatter market inventory availability calculations — cancelled options release inventory to the scatter pool. | Unity Catalog table: media_broadcasting_ecm.sales.upfront_commitment Integrates with Wide Orbit (traffic) and Salesforce Media Cloud (sales CRM) for realistic demos.'
}

Table sales.scatter_order {
  scatter_order_id varchar [pk, note: 'Primary key for scatter order']
  advertiser_id varchar [note: 'FK to advertiser']
  campaign_id varchar [note: 'FK to associated campaign']
  rep_id varchar [note: 'FK to sales rep']
  sales_account_id varchar [note: 'FK to sales account']
  sales_agency_id varchar [note: 'FK to sales agency']
  scatter_approved_by_employee_id varchar [note: 'FK to employee who approved the order']
  scatter_created_by_employee_id varchar [note: 'FK to employee who created the order']
  scatter_sales_agency_id varchar [note: 'FK to sales agency']
  upfront_commitment_id varchar [note: 'FK to upfront commitment if applicable']
  approval_date date [note: 'Date order was approved']
  cancellation_terms varchar [note: 'Cancellation terms and conditions']
  commission_rate decimal(5,4) [note: 'Agency commission rate']
  confirmed_at timestamp [note: 'Timestamp when order was confirmed']
  cpm_rate decimal(10,4) [note: 'Cost per thousand impressions rate']
  created_at timestamp [note: 'Record creation timestamp']
  created_timestamp timestamp [note: 'Timestamp when record was created']
  currency_code varchar [note: 'Currency code for order (ISO 4217)']
  daypart_mix varchar [note: 'Distribution of spots across dayparts']
  delivered_impressions varchar [note: 'Actual delivered impressions']
  discount_percent decimal(5,2) [note: 'Discount percentage applied to order']
  flight_end_date date [note: 'Order flight end date']
  flight_start_date date [note: 'Order flight start date']
  modified_timestamp timestamp [note: 'Timestamp when record was last modified']
  negotiated_cpm decimal(12,2) [note: 'Negotiated cost per thousand impressions']
  net_order_value decimal(18,2) [note: 'Net value after discounts and commissions']
  notes varchar [note: 'Additional notes or comments']
  order_date date [note: 'Date the scatter order was placed']
  order_name varchar [note: 'Human-readable name for the scatter order']
  order_number varchar [note: 'Unique scatter order number']
  order_status varchar [note: 'Current status of the order (pending, confirmed, cancelled)']
  order_type varchar [note: 'Type of scatter order (standard, opportunistic, remnant)']
  payment_terms varchar [note: 'Payment terms (net 30, net 60, etc.)']
  preemption_priority varchar [note: 'Priority level for preemption decisions']
  priority_level varchar [note: 'Priority level for inventory allocation']
  scatter_order_number varchar [note: 'Unique scatter order reference number']
  target_demographic varchar [note: 'Target demographic for the scatter buy']
  target_grp decimal(10,2) [note: 'Target gross rating points']
  target_impressions varchar [note: 'Target number of impressions']
  total_order_amount decimal(18,2) [note: 'Total order amount']
  total_order_value decimal(18,2) [note: 'Total monetary value of the scatter order']
  total_spots bigint [note: 'Total number of ad spots in the order']
  total_spots_ordered varchar [note: 'Total number of spots ordered']
  total_value decimal(18,2) [note: 'Total monetary value of the order']
  updated_at timestamp [note: 'Record last update timestamp']

  Note: 'A short-term advertising inventory purchase made in the scatter market outside of upfront commitments, typically placed weeks or days before air date. Captures order date, advertiser, agency, campaign flight dates, inventory type, platform, daypart, requested impressions or GRPs, negotiated CPM, total order value, priority level, preemption risk flag, and fulfillment status. Scatter orders are priced at prevailing market rates (typically at a premium to upfront) and are subject to preemption by higher-rated inventory. Feeds Wide Orbit traffic scheduling. | Unity Catalog table: media_broadcasting_ecm.sales.scatter_order'
}

Table sales.ad_sales_order {
  ad_sales_order_id varchar [pk, note: 'Unique identifier for the advertising sales order. Primary key for this entity. | Column ad_sales_order_id (BIGINT) in sales.ad_sales_order']
  advertiser_id varchar [note: 'Reference to the advertiser who is purchasing the advertising inventory under this order. | Column advertiser_id (BIGINT) in sales.ad_sales_order']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Ad orders must specify the licensed station for regulatory compliance, political ad disclosure requirements, public inspection file inclusion, and FCC reporting. Core operational requirement for broad | Column broadcast_license_id (BIGINT) in compliance.ad_sales_order']
  campaign_id varchar [note: 'Reference to the advertising campaign that this order is fulfilling. | Column campaign_id (BIGINT) in sales.ad_sales_order']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Orders specify primary channel for spot placement. Business process: order entry, inventory reservation, channel-level revenue tracking. Supports multi-channel orders at line level while tracking prim | Column channel_id (BIGINT) in scheduling.ad_sales_order']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Orders must be booked to the correct legal entity for revenue recognition, tax compliance, and statutory reporting. Essential for order-to-cash legal entity routing, VAT/sales tax calculation, and ent | Column company_legal_entity_id (BIGINT) in finance.ad_sales_order']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Ad sales orders generate invoices upon campaign execution. Order-to-cash reconciliation, revenue recognition, and billing dispute resolution require direct linkage from sales order to the master invoi | Column invoice_id (BIGINT) in billing.ad_sales_order']
  opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Ad sales orders are the result of closed/won opportunities. This FK is critical for sales pipeline traceability and win/loss analysis. N:1 relationship (one opportunity leads to one order). New attrib | Column opportunity_id (BIGINT) in sales.ad_sales_order']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Ad sales orders must map to revenue streams for ASC 606/IFRS 15 compliance. Different deal types (upfront, scatter, programmatic) have distinct recognition rules. Essential for revenue recognition aut | Column revenue_stream_id (BIGINT) in finance.ad_sales_order']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser and managing the media buy on their behalf. | Column sales_agency_id (BIGINT) in sales.ad_sales_order']
  sales_proposal_id varchar [note: 'Foreign key linking to sales.sales_proposal. Business justification: Ad sales orders are executed based on accepted proposals. This FK enables tracing orders back to the proposal that was accepted. N:1 relationship (one proposal leads to one order). New attribute neede | Column sales_proposal_id (BIGINT) in sales.ad_sales_order']
  sales_rep_id varchar [note: 'Reference to the sales representative who closed this advertising order and is responsible for account management. | Column sales_rep_id (BIGINT) in sales.ad_sales_order']
  upfront_commitment_id varchar [note: 'Foreign key linking to sales.upfront_commitment. Business justification: Ad sales orders are often drawn down from upfront commitments. This FK links the executed order back to the advance commitment that funded it. Nullable because not all ad sales orders come from upfron | Column upfront_commitment_id (BIGINT) in sales.ad_sales_order']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.ad_sales_order']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.ad_sales_order']
  affidavit_required boolean [note: 'Indicates whether proof-of-broadcast affidavits are required for this order to verify that ads were delivered as contracted. | Column affidavit_required (BOOLEAN) in sales.ad_sales_order']
  approval_timestamp timestamp [note: 'The timestamp when this advertising sales order was approved and authorized for trafficking and fulfillment. | Column approval_timestamp (TIMESTAMP) in sales.ad_sales_order']
  approved_by varchar [note: 'The name or identifier of the manager or executive who approved this advertising sales order. | Column approved_by (STRING) in sales.ad_sales_order']
  billing_contact_email varchar [note: 'The email address of the billing contact for invoice delivery and payment communication. | Column billing_contact_email (STRING) in sales.ad_sales_order']
  billing_contact_name varchar [note: 'The name of the primary billing contact at the advertiser or agency responsible for payment processing. | Column billing_contact_name (STRING) in sales.ad_sales_order']
  cancellation_terms varchar [note: 'The contractual terms and conditions under which the advertiser or broadcaster may cancel the order, including notice periods and penalties. | Column cancellation_terms (STRING) in sales.ad_sales_order']
  commission_rate decimal(5,2) [note: 'The commission rate percentage applied to this order for sales representative compensation. | Column commission_rate (DECIMAL(5,2)) in sales.ad_sales_order']
  contract_signed_date date [note: 'The date when the advertising sales contract was executed and signed by both parties. | Column contract_signed_date (DATE) in sales.ad_sales_order']
  contracted_cpm decimal(10,2) [note: 'The contracted cost per thousand impressions agreed upon for this advertising order. | Column contracted_cpm (DECIMAL(10,2)) in sales.ad_sales_order']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.ad_sales_order']
  created_timestamp timestamp [note: 'The timestamp when this order record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.ad_sales_order']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the order value and financial terms. | Column currency_code (STRING) in sales.ad_sales_order']
  daypart_mix varchar [note: 'Description of the distribution of ad spots across broadcast dayparts such as prime time, daytime, late night, and early morning. | Column daypart_mix (STRING) in sales.ad_sales_order']
  deal_type varchar [note: 'The type of advertising sales deal. Upfront represents advance commitments during upfront sales events, scatter represents last-minute inventory purchases, direct represents direct advertiser buys, and programmatic_guaranteed represents automated guaranteed deals. | Column deal_type (STRING) in sales.ad_sales_order']
  flight_end_date date [note: 'The date when the advertising campaign flight ends and ad delivery concludes. | Column flight_end_date (DATE) in sales.ad_sales_order']
  flight_start_date date [note: 'The date when the advertising campaign flight begins and ad delivery commences. | Column flight_start_date (DATE) in sales.ad_sales_order']
  grp_guarantee decimal(10,2) [note: 'The guaranteed Gross Rating Points committed to the advertiser, representing the total percentage of the target audience reached multiplied by frequency. | Column grp_guarantee (DECIMAL(10,2)) in sales.ad_sales_order']
  impression_guarantee varchar [note: 'The total number of impressions guaranteed to be delivered under this advertising order. | Column impression_guarantee (BIGINT) in sales.ad_sales_order']
  isci_codes varchar [note: 'Comma-separated list of ISCI codes identifying the creative assets approved for use in this advertising order. | Column isci_codes (STRING) in sales.ad_sales_order']
  last_modified_timestamp timestamp [note: 'The timestamp when this order record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in sales.ad_sales_order']
  makegood_provisions varchar [note: 'The contractual provisions defining how compensatory ad spots will be provided if the broadcaster fails to deliver the guaranteed audience or impressions. | Column makegood_provisions (STRING) in sales.ad_sales_order']
  order_date date [note: 'The date when the advertising sales order was placed and confirmed by the advertiser or agency. | Column order_date (DATE) in sales.ad_sales_order']
  order_notes varchar [note: 'Free-text notes and comments related to this advertising order, capturing special instructions, client requests, or operational considerations. | Column order_notes (STRING) in sales.ad_sales_order']
  order_number varchar [note: 'The externally-known business identifier for this advertising sales order, used for client communication and billing reference. | Column order_number (STRING) in sales.ad_sales_order']
  order_status varchar [note: 'Current lifecycle status of the advertising sales order in the fulfillment workflow. | Column order_status (STRING) in sales.ad_sales_order']
  payment_terms varchar [note: 'The contractual payment terms defining when payment is due, such as net 30, net 60, or payment upon delivery. | Column payment_terms (STRING) in sales.ad_sales_order']
  platform_mix varchar [note: 'Description of the distribution of advertising inventory across platforms such as linear TV, OTT, digital, mobile, and social channels. | Column platform_mix (STRING) in sales.ad_sales_order']
  political_ad_flag boolean [note: 'Indicates whether this order contains political advertising content, which requires special disclosure and compliance tracking per FCC regulations. | Column political_ad_flag (BOOLEAN) in sales.ad_sales_order']
  preemption_risk_level varchar [note: 'The level of risk that this order may be preempted by higher-priority advertising inventory. Non-preemptible orders have guaranteed placement, while high-risk orders may be bumped for premium advertisers. | Column preemption_risk_level (STRING) in sales.ad_sales_order']
  priority_class varchar [note: 'The priority classification of this order in the ad scheduling and trafficking system, determining placement precedence during inventory conflicts. | Column priority_class (STRING) in sales.ad_sales_order']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.ad_sales_order']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.ad_sales_order']
  target_audience varchar [note: 'Description of the demographic and psychographic target audience for this advertising order, used for audience measurement and guarantee validation. | Column target_audience (STRING) in sales.ad_sales_order']
  total_order_value decimal(18,2) [note: 'The total contracted monetary value of the advertising sales order across all line items and flights. | Column total_order_value (DECIMAL(18,2)) in sales.ad_sales_order']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.ad_sales_order']

  Note: 'The executed and confirmed advertising sales order representing a binding commercial agreement to deliver a specific advertising campaign across defined inventory. Encompasses all order types including upfront fulfillment orders, scatter market purchases, direct buys, and programmatic guaranteed deals. Captures order number, deal type (upfront, scatter, direct, programmatic_guaranteed), advertiser, agency, campaign name, total order value, contracted CPM, GRP or impression guarantee, platform mix, flight start and end dates, cancellation terms, makegood provisions, preemption risk level, priority class, affidavit requirements, ISCI codes for creative, and order status (confirmed, in-flight, completed, cancelled, preempted). This is the primary handoff entity from sales to advertising trafficking in Wide Orbit. | Unity Catalog table: media_broadcasting_ecm.sales.ad_sales_order Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.order_line {
  order_line_id varchar [pk, note: 'Unique identifier for the order line item. Primary key for the order line entity. | Column order_line_id (BIGINT) in sales.order_line']
  ad_order_id varchar [note: 'Reference to the parent ad sales order that contains this line item. Links to the ad_order entity. | Column ad_order_id (BIGINT) in sales.order_line']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Each order line specifies the channel for spot placement. Business process: trafficking, playout scheduling, channel-level delivery tracking. Replaces denormalized channel_name text field with proper  | Column channel_id (BIGINT) in scheduling.order_line']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Order lines specify daypart for purchased inventory. Business process: order fulfillment, daypart delivery tracking, makegood allocation. Replaces denormalized daypart text field with proper FK. | Column daypart_id (BIGINT) in scheduling.order_line']
  proposal_line_id varchar [note: 'Foreign key linking to sales.proposal_line. Business justification: Order lines are the executed versions of proposal lines. This FK enables tracing order line execution back to the original proposal line. N:1 relationship (one proposal line can lead to multiple order | Column proposal_line_id (BIGINT) in sales.order_line']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Order lines may have different revenue recognition treatments (guaranteed vs. preemptible, linear vs. digital). Required for line-level revenue recognition, performance obligation tracking, and makego | Column revenue_stream_id (BIGINT) in finance.order_line']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: Confirmed order lines map to specific schedule slots for playout. Business process: traffic-to-playout handoff, as-run reconciliation, affidavit generation, delivery verification against contracted im | Column schedule_slot_id (BIGINT) in scheduling.order_line']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.order_line']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.order_line']
  actual_grp_delivered decimal(10,2) [note: 'Actual GRP delivered for this line item. Used to compare against contracted GRP for linear TV performance tracking. | Column actual_grp_delivered (DECIMAL(10,2)) in sales.order_line']
  actual_impressions_delivered varchar [note: 'Actual number of impressions delivered for this line item. Used to compare against contracted impressions for performance tracking. | Column actual_impressions_delivered (BIGINT) in sales.order_line']
  air_date date [note: 'Specific date when the ad unit is scheduled to air or be delivered. For single-spot placements. | Column air_date (DATE) in sales.order_line']
  air_end_date date [note: 'End date of the flight period for this ad unit. Defines the conclusion of the campaign window. | Column air_end_date (DATE) in sales.order_line']
  air_start_date date [note: 'Start date of the flight period for this ad unit. Used for campaigns spanning multiple days or weeks. | Column air_start_date (DATE) in sales.order_line']
  contracted_grp decimal(10,2) [note: 'Gross Rating Points contracted for this line item. Represents the total audience reach multiplied by frequency, used for linear TV buys. | Column contracted_grp (DECIMAL(10,2)) in sales.order_line']
  contracted_impressions varchar [note: 'Number of impressions (ad views) contracted for this line item. Used primarily for digital and OTT placements with impression-based guarantees. | Column contracted_impressions (BIGINT) in sales.order_line']
  contracted_trp decimal(10,2) [note: 'Target Rating Points contracted for this line item. Similar to GRP but focused on a specific target demographic audience. | Column contracted_trp (DECIMAL(10,2)) in sales.order_line']
  cpm decimal(10,2) [note: 'Cost per thousand impressions for this line item. Standard digital advertising pricing metric. | Column cpm (DECIMAL(10,2)) in sales.order_line']
  cprp decimal(15,2) [note: 'Cost per rating point for this line item. Standard linear TV pricing metric calculated as total cost divided by GRP or TRP. | Column cprp (DECIMAL(15,2)) in sales.order_line']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.order_line']
  created_timestamp timestamp [note: 'Timestamp when this order line record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.order_line']
  creative_title varchar [note: 'Title or name of the creative asset (commercial, video ad) that will be played for this line item. | Column creative_title (STRING) in sales.order_line']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the line item pricing (e.g., USD, GBP, EUR). | Column currency_code (STRING) in sales.order_line']
  dai_enabled_flag boolean [note: 'Indicates whether this line item uses Dynamic Ad Insertion technology for personalized, server-side ad stitching in streaming content. | Column dai_enabled_flag (BOOLEAN) in sales.order_line']
  delivery_status varchar [note: 'Current delivery status of the line item: scheduled, in progress, delivered, under-delivered, over-delivered, cancelled, or makegood issued. [ENUM-REF-CANDIDATE: scheduled|in_progress|delivered|under_delivered|over_delivered|cancelled|makegood_issued — 7 candidates stripped; promote to reference product] | Column delivery_status (STRING) in sales.order_line']
  geographic_market varchar [note: 'Geographic market or Designated Market Area (DMA) where this line item will be delivered. Used for local vs national buys. | Column geographic_market (STRING) in sales.order_line']
  guaranteed_flag boolean [note: 'Indicates whether this line item has a guaranteed delivery commitment (impressions, GRPs, or placement) versus best-effort delivery. | Column guaranteed_flag (BOOLEAN) in sales.order_line']
  isci_code varchar [note: 'Industry Standard Commercial Identification code for the creative asset associated with this line item. Used for trafficking and affidavit verification. | Column isci_code (STRING) in sales.order_line']
  line_number varchar [note: 'Sequential line number within the parent order, used for ordering and referencing specific line items in the order. | Column line_number (INT) in sales.order_line']
  line_status varchar [note: 'Current lifecycle status of the order line: draft, confirmed, trafficked (sent to playout), aired, invoiced, cancelled, or on hold. [ENUM-REF-CANDIDATE: draft|confirmed|trafficked|aired|invoiced|cancelled|on_hold — 7 candidates stripped; promote to reference product] | Column line_status (STRING) in sales.order_line']
  line_total_amount decimal(15,2) [note: 'Total revenue value for this order line item. Calculated as unit rate multiplied by quantity or contracted impressions/GRPs. | Column line_total_amount (DECIMAL(15,2)) in sales.order_line']
  makegood_eligible_flag boolean [note: 'Indicates whether this line item is eligible for makegood spots (compensatory ad placements) if delivery targets are not met. | Column makegood_eligible_flag (BOOLEAN) in sales.order_line']
  modified_timestamp timestamp [note: 'Timestamp when this order line record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in sales.order_line']
  notes varchar [note: 'Free-form notes or special instructions for this order line item. May include trafficking instructions, creative specifications, or delivery requirements. | Column notes (STRING) in sales.order_line']
  platform varchar [note: 'Platform or channel where the ad unit will be delivered: linear TV, OTT (Over-The-Top), VOD (Video On Demand), SVOD, AVOD, FAST, digital web, mobile app, social media, or podcast. [ENUM-REF-CANDIDATE: linear_tv|ott|vod|svod|avod|tvod|fast|digital_web|mobile_app|social|podcast — 11 candidates stripped; promote to reference product] | Column platform (STRING) in sales.order_line']
  product_category varchar [note: 'Product or service category being advertised (e.g., automotive, financial services, consumer packaged goods). Used for competitive separation and content adjacency rules. | Column product_category (STRING) in sales.order_line']
  program_title varchar [note: 'Title of the specific program, show, or content where the ad unit is scheduled to appear. | Column program_title (STRING) in sales.order_line']
  programmatic_flag boolean [note: 'Indicates whether this line item was sold through programmatic advertising channels (automated bidding and buying). | Column programmatic_flag (BOOLEAN) in sales.order_line']
  sales_type varchar [note: 'Type of sales transaction: upfront (advance commitment), scatter (last-minute inventory), direct, programmatic, sponsorship, or barter. | Column sales_type (STRING) in sales.order_line']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.order_line']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.order_line']
  spot_length_seconds varchar [note: 'Duration of the ad spot in seconds (e.g., 15, 30, 60). Standard commercial lengths used for pricing and scheduling. | Column spot_length_seconds (INT) in sales.order_line']
  target_demographic varchar [note: 'Target audience demographic for this line item (e.g., Adults 18-49, Women 25-54). Used for audience guarantee and measurement. | Column target_demographic (STRING) in sales.order_line']
  unit_rate decimal(15,2) [note: 'Rate charged per individual ad unit (per spot, per impression block, per sponsorship). The base pricing for this line item. | Column unit_rate (DECIMAL(15,2)) in sales.order_line']
  unit_type varchar [note: 'Type of advertising unit being sold: a 30-second spot, digital pre-roll, sponsorship billboard, branded content integration, or other ad format. [ENUM-REF-CANDIDATE: spot|pre_roll|mid_roll|post_roll|sponsorship|billboard|branded_content|overlay|companion_banner|native_ad — 10 candidates stripped; promote to reference product] | Column unit_type (STRING) in sales.order_line']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.order_line']

  Note: 'Individual line item within a confirmed ad sales order, representing a specific ad placement unit — a 30-second spot in a named program, a digital pre-roll unit, a sponsorship billboard, or a branded content integration. Captures line number, unit type, platform, channel, program or content title, daypart, air date or date range, spot length, contracted impressions or GRPs, unit rate, CPM, line total value, creative ISCI code, DAI flag, and delivery status. The granular unit of trafficking instruction passed to Wide Orbit for scheduling and playout. | Unity Catalog table: media_broadcasting_ecm.sales.order_line Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.content_license_deal {
  content_license_deal_id varchar [pk, note: 'Unique identifier for the content license deal. Primary key for this entity. | Column content_license_deal_id (BIGINT) in sales.content_license_deal']
  broadcast_standard_id varchar [note: 'Foreign key linking to technology.broadcast_standard. Business justification: Content license agreements specify technical delivery requirements (ATSC 3.0, DVB-T2, ISDB-T) that licensees must support. Essential for contract compliance verification, content mastering specificati | Column broadcast_standard_id (BIGINT) in technology.content_license_deal']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: License deals may grant rights to air content on specific channels. Business process: rights clearance verification, channel programming strategy, license fee allocation by channel. | Column channel_id (BIGINT) in scheduling.content_license_deal']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: License deals are executed by specific legal entities (often different from operating entity) for IP ownership and tax optimization. Required for licensing entity determination, withholding tax calcul | Column company_legal_entity_id (BIGINT) in finance.content_license_deal']
  content_library_id varchar [note: 'Reference to a content library or collection being licensed. May be null if the deal covers a single title rather than a library. | Column content_library_id (BIGINT) in content.content_license_deal']
  content_title_id varchar [note: 'Reference to the specific content title or program being licensed. May be null if the deal covers a library or collection rather than a single title. | Column content_title_id (BIGINT) in content.content_license_deal']
  employee_id varchar [note: 'Reference to the sales representative or account manager responsible for negotiating and managing this content license deal. | Column employee_id (BIGINT) in workforce.content_license_deal']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Content license deals generate invoices per payment schedule (installments, milestones). Licensing revenue recognition, payment tracking, and contract compliance auditing require direct linkage from l | Column invoice_id (BIGINT) in billing.content_license_deal']
  licensor_partner_partner_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Content license deals are negotiated with content owners/licensors who are formal partners (studios, production companies, distributors). Critical for tracking licensor relationships, managing royalty | Column licensor_partner_partner_partner_id (BIGINT) in partner.content_license_deal']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Content license deals directly license specific media assets (films, series episodes, specials) to distribution partners. This link is essential for rights management, delivery fulfillment, asset acce | Column media_asset_id (BIGINT) in mediaasset.content_license_deal']
  opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Content license deals result from closed opportunities. This FK enables tracing license deals back to their originating opportunities. N:1 relationship. New attribute needed for pipeline traceability. | Column opportunity_id (BIGINT) in sales.content_license_deal']
  production_project_id varchar [note: 'Foreign key linking to production.project. Business justification: Content license deals must reference the master production project for series-level licensing (multi-season packages, format rights, remake rights), rights clearance verification, delivery obligation  | Column production_project_id (BIGINT) in production.content_license_deal']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: License deals have complex revenue recognition (minimum guarantees, revenue shares, holdbacks) requiring specific revenue stream mapping. Critical for licensing revenue recognition, deferred revenue c | Column revenue_stream_id (BIGINT) in finance.content_license_deal']
  sales_account_id varchar [note: 'Reference to the third-party broadcaster, streaming platform, Multichannel Video Programming Distributor (MVPD), or international distributor acquiring the content license. | Column sales_account_id (BIGINT) in sales.content_license_deal']
  sales_agency_id varchar [note: 'Foreign key linking to sales.sales_agency. Business justification: Content licensing deals may involve agencies representing the licensee. This FK tracks agency involvement in content licensing transactions. Nullable because many content deals are direct (no agency i | Column sales_agency_id (BIGINT) in sales.content_license_deal']
  sales_team_id varchar [note: 'Reference to the sales team or business unit responsible for this content license deal. | Column sales_team_id (BIGINT) in sales.content_license_deal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.content_license_deal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.content_license_deal']
  approval_date date [note: 'The date when the deal received final internal approval to proceed to execution. | Column approval_date (DATE) in sales.content_license_deal']
  commission_eligible_flag boolean [note: 'Indicates whether this deal is eligible for sales commission calculation and payout. | Column commission_eligible_flag (BOOLEAN) in sales.content_license_deal']
  commission_rate_percentage decimal(5,2) [note: 'The commission rate percentage applicable to this deal for sales compensation purposes. | Column commission_rate_percentage (DECIMAL(5,2)) in sales.content_license_deal']
  contract_document_url varchar [note: 'Reference URL or file path to the executed contract document or agreement for this content license deal. | Column contract_document_url (STRING) in sales.content_license_deal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.content_license_deal']
  created_timestamp timestamp [note: 'Timestamp when this content license deal record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.content_license_deal']
  deal_name varchar [note: 'Business-friendly name or title assigned to this content license deal for identification and reference purposes. | Column deal_name (STRING) in sales.content_license_deal']
  deal_number varchar [note: 'Externally-known unique business identifier or contract number for this content license deal, used for tracking and reference across systems. | Column deal_number (STRING) in sales.content_license_deal']
  deal_status varchar [note: 'Current lifecycle status of the content license deal, tracking its progression from initial negotiation through execution and eventual closure. [ENUM-REF-CANDIDATE: draft|negotiation|pending_approval|approved|executed|active|expired|terminated|cancelled — 9 candidates stripped; promote to reference product] | Column deal_status (STRING) in sales.content_license_deal']
  deal_value_amount decimal(18,2) [note: 'Total monetary value of the license deal, representing the expected or guaranteed revenue from this agreement. | Column deal_value_amount (DECIMAL(18,2)) in sales.content_license_deal']
  deal_value_currency varchar [note: 'Three-letter ISO 4217 currency code for the deal value amount. | Column deal_value_currency (STRING) in sales.content_license_deal']
  eidr_identifier varchar [note: 'Entertainment Identifier Registry (EIDR) unique identifier for the content covered by this license deal, used for global content identification. | Column eidr_identifier (STRING) in sales.content_license_deal']
  executed_date date [note: 'The date when the contract was formally executed and signed by all parties, making it legally binding. | Column executed_date (DATE) in sales.content_license_deal']
  holdback_restrictions varchar [note: 'Description of any holdback periods or exclusivity restrictions that limit when or how the content can be exploited, including blackout periods or sequential windowing requirements. | Column holdback_restrictions (STRING) in sales.content_license_deal']
  isan_identifier varchar [note: 'International Standard Audiovisual Number (ISAN) uniquely identifying the audiovisual content covered by this license deal. | Column isan_identifier (STRING) in sales.content_license_deal']
  last_modified_timestamp timestamp [note: 'Timestamp when this content license deal record was most recently updated or modified. | Column last_modified_timestamp (TIMESTAMP) in sales.content_license_deal']
  license_end_date date [note: 'The date when the license period expires and the licensee must cease exploitation of the content. | Column license_end_date (DATE) in sales.content_license_deal']
  license_fee_structure varchar [note: 'The pricing model or fee structure governing how the licensee compensates the licensor for the content rights. | Column license_fee_structure (STRING) in sales.content_license_deal']
  license_start_date date [note: 'The date when the license period begins and the licensee is granted rights to exploit the content. | Column license_start_date (DATE) in sales.content_license_deal']
  license_type varchar [note: 'Classification of the licensing arrangement indicating the exclusivity and rights structure of the deal. | Column license_type (STRING) in sales.content_license_deal']
  minimum_guarantee_amount decimal(18,2) [note: 'Minimum guaranteed payment amount that the licensee commits to pay regardless of actual usage or revenue performance. Applicable for revenue share deals with minimum guarantees. | Column minimum_guarantee_amount (DECIMAL(18,2)) in sales.content_license_deal']
  notes varchar [note: 'Free-form notes or comments capturing additional context, special terms, or important details about this content license deal. | Column notes (STRING) in sales.content_license_deal']
  payment_schedule varchar [note: 'Description of the payment terms and schedule, including milestones, installments, or recurring payment frequency for the license fees. | Column payment_schedule (STRING) in sales.content_license_deal']
  platform_rights_avod boolean [note: 'Indicates whether the license grants rights for Advertising-Supported Video On Demand (AVOD) distribution. | Column platform_rights_avod (BOOLEAN) in sales.content_license_deal']
  platform_rights_fast boolean [note: 'Indicates whether the license grants rights for Free Ad-Supported Streaming Television (FAST) channels. | Column platform_rights_fast (BOOLEAN) in sales.content_license_deal']
  platform_rights_linear boolean [note: 'Indicates whether the license grants rights for traditional scheduled linear broadcasting. | Column platform_rights_linear (BOOLEAN) in sales.content_license_deal']
  platform_rights_svod boolean [note: 'Indicates whether the license grants rights for Subscription Video On Demand (SVOD) distribution. | Column platform_rights_svod (BOOLEAN) in sales.content_license_deal']
  platform_rights_tvod boolean [note: 'Indicates whether the license grants rights for Transactional Video On Demand (TVOD) distribution. | Column platform_rights_tvod (BOOLEAN) in sales.content_license_deal']
  renewal_option_flag boolean [note: 'Indicates whether the licensee has an option to renew the license upon expiration. | Column renewal_option_flag (BOOLEAN) in sales.content_license_deal']
  renewal_terms varchar [note: 'Description of the renewal terms and conditions if a renewal option exists, including pricing adjustments and notification requirements. | Column renewal_terms (STRING) in sales.content_license_deal']
  revenue_share_percentage decimal(5,2) [note: 'Percentage of revenue that the licensee will share with the licensor, applicable for revenue share fee structures. | Column revenue_share_percentage (DECIMAL(5,2)) in sales.content_license_deal']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.content_license_deal']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.content_license_deal']
  termination_clause varchar [note: 'Description of the conditions and procedures under which either party may terminate the license agreement prior to the natural expiration date. | Column termination_clause (STRING) in sales.content_license_deal']
  territory varchar [note: 'Geographic territory or territories where the licensee is granted rights to distribute or broadcast the content. May include country codes, regions, or worldwide designation. | Column territory (STRING) in sales.content_license_deal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.content_license_deal']

  Note: 'A negotiated agreement to license specific content titles or libraries to third-party broadcasters, streaming platforms, MVPDs, or international distributors. Captures deal name, licensee account, content title or library scope, license type (exclusive, non-exclusive, sub-license), territory, platform rights granted (linear, SVOD, AVOD, TVOD, FAST), license fee structure (flat, per-episode, revenue share), deal value, payment schedule, holdback restrictions, ISAN or EIDR content identifiers, and deal status. Owned by sales as the commercial negotiation record; rights domain owns the resulting rights windows. | Unity Catalog table: media_broadcasting_ecm.sales.content_license_deal Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.sales_syndication_deal {
  sales_syndication_deal_id varchar [pk, note: 'Unique identifier for the syndication deal record. Primary key for the sales syndication deal entity. | Column sales_syndication_deal_id (BIGINT) in sales.sales_syndication_deal']
  content_package_id varchar [note: 'Reference to the content package (series, strip, specials, or program bundle) being syndicated under this deal. | Column content_package_id (BIGINT) in content.sales_syndication_deal']
  opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Syndication deals result from closed opportunities. This FK enables tracing syndication deals back to their originating opportunities. N:1 relationship. New attribute needed for pipeline traceability. | Column opportunity_id (BIGINT) in sales.sales_syndication_deal']
  primary_sales_employee_id varchar [note: 'Reference to the user who created this syndication deal record. | Column primary_sales_employee_id (BIGINT) in workforce.sales_syndication_deal']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Syndication deals with barter splits and cash components require revenue stream mapping for proper accounting treatment. Enables barter revenue recognition and syndication revenue reporting in media o | Column revenue_stream_id (BIGINT) in finance.sales_syndication_deal']
  sales_account_id varchar [note: 'Reference to the syndicator, station group, or distributor account that is the counterparty to this syndication deal. | Column sales_account_id (BIGINT) in sales.sales_syndication_deal']
  sales_agency_id varchar [note: 'Foreign key linking to sales.sales_agency. Business justification: Syndication deals may involve agencies representing station groups or syndicators. This FK tracks agency involvement in syndication transactions. Nullable because many syndication deals are direct. | Column sales_agency_id (BIGINT) in sales.sales_syndication_deal']
  sales_rep_id varchar [note: 'Reference to the sales representative or account executive responsible for negotiating and managing this syndication deal. | Column sales_rep_id (BIGINT) in sales.sales_syndication_deal']
  sales_rights_rights_syndication_deal_id varchar [note: 'FK reference to canonical source']
  sales_rights_syndication_deal_id varchar [note: 'FK to rights syndication deal for licensing terms | Column rights_syndication_deal_id (BIGINT) in rights.sales_syndication_deal']
  syndication_media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Syndication deals license specific program assets to local stations/broadcasters. While content_package_id references the editorial package, syndication_media_asset_id links to the actual broadcast ma | Column syndication_media_asset_id (BIGINT) in mediaasset.sales_syndication_deal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sales_syndication_deal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sales_syndication_deal']
  barter_split_percentage decimal(5,2) [note: 'Percentage of advertising inventory retained by the syndicator versus sold by the station. For example, 70/30 split means syndicator retains 70% of ad inventory and station sells 30%. Null for pure cash deals. | Column barter_split_percentage (DECIMAL(5,2)) in sales.sales_syndication_deal']
  cash_license_fee_amount decimal(15,2) [note: 'Total cash license fee paid by the station or station group to the syndicator for the content rights over the deal term. Null for pure barter deals. | Column cash_license_fee_amount (DECIMAL(15,2)) in sales.sales_syndication_deal']
  clearance_percentage_target decimal(5,2) [note: 'Target percentage of U.S. television households or market coverage that must be achieved for the syndication deal to be considered successful. Clearance is the percentage of the national audience that has access to the syndicated program. | Column clearance_percentage_target (DECIMAL(5,2)) in sales.sales_syndication_deal']
  commission_rate_percentage decimal(5,2) [note: 'Percentage of the deal value paid as commission to the sales representative or sales team. | Column commission_rate_percentage (DECIMAL(5,2)) in sales.sales_syndication_deal']
  contract_document_url varchar [note: 'URL or file path to the executed syndication contract document stored in the document management system. | Column contract_document_url (STRING) in sales.sales_syndication_deal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sales_syndication_deal']
  created_timestamp timestamp [note: 'Timestamp when this syndication deal record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.sales_syndication_deal']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this syndication deal. | Column currency_code (STRING) in sales.sales_syndication_deal']
  daypart_restriction varchar [note: 'Time-of-day restrictions for when the syndicated content may be broadcast. Dayparts are segments of the broadcast day such as early morning, daytime, early fringe, prime access, prime time, late fringe, and overnight. | Column daypart_restriction (STRING) in sales.sales_syndication_deal']
  deal_name varchar [note: 'Human-readable name of the syndication deal, typically including the content title and syndicator or station group name. | Column deal_name (STRING) in sales.sales_syndication_deal']
  deal_number varchar [note: 'Externally-known business identifier for the syndication deal, used in contracts and communications with syndicators and station groups. | Column deal_number (STRING) in sales.sales_syndication_deal']
  deal_status varchar [note: 'Current lifecycle status of the syndication deal. Draft: initial creation. Proposed: submitted to counterparty. Negotiation: terms being discussed. Approved: internally approved, awaiting execution. Active: contract executed and in effect. Suspended: temporarily paused. Terminated: ended before expiration. Expired: reached natural end date. [ENUM-REF-CANDIDATE: draft|proposed|negotiation|approved|active|suspended|terminated|expired — 8 candidates stripped; promote to reference product] | Column deal_status (STRING) in sales.sales_syndication_deal']
  deal_term_months varchar [note: 'Duration of the syndication deal in months, representing the period during which the content may be broadcast under the agreed terms. | Column deal_term_months (INT) in sales.sales_syndication_deal']
  effective_end_date date [note: 'Date when the syndication deal expires and the content rights are no longer available for broadcast under this agreement. | Column effective_end_date (DATE) in sales.sales_syndication_deal']
  effective_start_date date [note: 'Date when the syndication deal becomes active and the content rights become available for broadcast. | Column effective_start_date (DATE) in sales.sales_syndication_deal']
  episode_count varchar [note: 'Total number of episodes or program units included in the syndication package. | Column episode_count (INT) in sales.sales_syndication_deal']
  exclusivity_flag boolean [note: 'Indicates whether the syndication deal grants exclusive broadcast rights within the specified territory. True means no other station in the territory may air the content during the deal term. | Column exclusivity_flag (BOOLEAN) in sales.sales_syndication_deal']
  holdback_period_days varchar [note: 'Number of days after original network broadcast before the content becomes available for syndication. Holdback is an exclusivity period that protects the original broadcaster. | Column holdback_period_days (INT) in sales.sales_syndication_deal']
  last_modified_timestamp timestamp [note: 'Timestamp when this syndication deal record was most recently updated. | Column last_modified_timestamp (TIMESTAMP) in sales.sales_syndication_deal']
  notes varchar [note: 'Free-form text field for additional notes, special terms, or internal comments about the syndication deal. | Column notes (STRING) in sales.sales_syndication_deal']
  payment_schedule varchar [note: 'Schedule for cash license fee payments. Upfront: full payment at deal execution. Monthly/Quarterly/Annual: periodic installments. Upon-delivery: payment when content is delivered. Milestone-based: payments tied to specific events. | Column payment_schedule (STRING) in sales.sales_syndication_deal']
  renewal_option_flag boolean [note: 'Indicates whether the syndication deal includes an option for the station or station group to renew the content rights for an additional term. | Column renewal_option_flag (BOOLEAN) in sales.sales_syndication_deal']
  renewal_terms varchar [note: 'Description of the renewal option terms, including renewal period, pricing adjustments, and notice requirements. | Column renewal_terms (STRING) in sales.sales_syndication_deal']
  runs_per_episode varchar [note: 'Number of times each episode may be broadcast during the deal term. Common values are 2, 4, 6, or unlimited. | Column runs_per_episode (INT) in sales.sales_syndication_deal']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sales_syndication_deal']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sales_syndication_deal']
  station_count varchar [note: 'Number of broadcast stations or outlets that have committed to air the syndicated content under this deal. | Column station_count (INT) in sales.sales_syndication_deal']
  syndication_type varchar [note: 'Classification of the syndication deal structure. First-run: original content produced for syndication. Off-network: previously aired network content. Barter: compensation via ad inventory. Cash-plus-barter: hybrid of cash license fee and ad inventory. Cash: pure license fee with no barter component. | Column syndication_type (STRING) in sales.sales_syndication_deal']
  territory varchar [note: 'Geographic territory covered by the syndication deal, typically defined by Designated Market Areas (DMAs), regions, or countries where the content may be broadcast. | Column territory (STRING) in sales.sales_syndication_deal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sales_syndication_deal']

  Note: 'A commercial agreement to distribute and resell content programming to multiple broadcast stations, cable networks, or digital outlets through syndication. Captures syndication deal name, syndicator or station group account, content package (series, strip, specials), syndication type (first-run, off-network, barter, cash-plus-barter), barter split (percentage of ad inventory retained vs. sold), cash license fee, territory, clearance percentage target, station count, deal term, and status. Distinct from content_license_deal in that syndication involves barter inventory and multi-station clearance mechanics. | Unity Catalog table: media_broadcasting_ecm.sales.sales_syndication_deal Integrates with Wide Orbit (traffic) and Salesforce Media Cloud (sales CRM) for realistic demos.'
}

Table sales.carriage_deal {
  carriage_deal_id varchar [pk, note: 'Unique identifier for the carriage deal. Primary key for this entity. | Column carriage_deal_id (BIGINT) in sales.carriage_deal']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Carriage agreements are license-specific - distribution partners carry specific licensed stations. Must-carry designation and retransmission consent are license-level FCC regulatory concepts requiring | Column broadcast_license_id (BIGINT) in compliance.carriage_deal']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Carriage deals specify which channel is being carried by the distributor. Business process: channel distribution, carriage fee calculation, retransmission consent tracking. Replaces denormalized chann | Column channel_id (BIGINT) in scheduling.carriage_deal']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Carriage agreements are legal contracts executed by specific broadcast license-holding entities. Required for FCC compliance reporting and retransmission consent legal entity tracking in media broadca | Column company_legal_entity_id (BIGINT) in finance.carriage_deal']
  distribution_partner_id varchar [note: 'Reference to the MVPD, vMVPD, cable, or satellite operator account that is party to this carriage agreement. | Column distribution_partner_id (BIGINT) in distribution.carriage_deal']
  opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Carriage deals result from closed opportunities. This FK enables tracing carriage deals back to their originating opportunities. N:1 relationship. New attribute needed for pipeline traceability. | Column opportunity_id (BIGINT) in sales.carriage_deal']
  origination_broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Carriage agreements specify the origination facility for signal delivery to distribution partners. Required for signal handoff coordination, technical specifications, SLA monitoring, and operational e | Column origination_broadcast_facility_id (BIGINT) in technology.carriage_deal']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Carriage fees are recurring subscription-like revenue requiring specific revenue stream treatment for recognition and forecasting. Essential for carriage fee revenue recognition and subscriber-based r | Column revenue_stream_id (BIGINT) in finance.carriage_deal']
  sales_account_id varchar [note: 'Foreign key linking to sales.sales_account. Business justification: Carriage deals are commercial agreements with MVPDs/operators. While carriage_deal.partner_id links to sales.distribution_partner (technical/operational), this FK links to sales_account for the | Column sales_account_id (BIGINT) in sales.carriage_deal']
  sales_rep_id varchar [note: 'Foreign key linking to sales.rep. Business justification: Carriage deals are negotiated by sales reps and should be attributed to them for performance tracking and commission calculation. This FK enables rep attribution for carriage deals. N:1 relationship.  | Column sales_rep_id (BIGINT) in sales.carriage_deal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.carriage_deal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.carriage_deal']
  advertising_revenue_share_pct decimal(5,2) [note: 'Percentage of advertising revenue generated on the carried channel(s) that is shared with the operator, if applicable. | Column advertising_revenue_share_pct (DECIMAL(5,2)) in sales.carriage_deal']
  auto_renewal_flag boolean [note: 'Indicates whether the carriage agreement automatically renews for successive terms unless either party provides notice of termination. | Column auto_renewal_flag (BOOLEAN) in sales.carriage_deal']
  billing_frequency varchar [note: 'Frequency at which carriage fees are invoiced to the operator: monthly (standard), quarterly, or annually. | Column billing_frequency (STRING) in sales.carriage_deal']
  blackout_zone_restrictions varchar [note: 'Geographic regions or designated market areas (DMAs) where content must be blacked out due to territorial rights restrictions or sports blackout rules. | Column blackout_zone_restrictions (STRING) in sales.carriage_deal']
  carriage_fee_per_subscriber decimal(15,4) [note: 'Monthly fee paid by the operator per subscriber for carriage of the channel(s). Core revenue metric for retransmission consent and negotiated carriage deals. | Column carriage_fee_per_subscriber (DECIMAL(15,4)) in sales.carriage_deal']
  carriage_status varchar [note: 'Current lifecycle state of the carriage agreement: draft (initial proposal), negotiation (under discussion), executed (signed but not yet effective), active (currently in force), suspended (temporarily paused), expired (term ended), terminated (cancelled before term end), or renewed (extended for additional term). [ENUM-REF-CANDIDATE: draft|negotiation|executed|active|suspended|expired|terminated|renewed — 8 candidates stripped; promote to reference product] | Column carriage_status (STRING) in sales.carriage_deal']
  channel_position_number varchar [note: 'Specific channel number or position assigned by the operator in their electronic program guide (EPG) and channel lineup. | Column channel_position_number (INT) in sales.carriage_deal']
  contract_term_months varchar [note: 'Duration of the carriage agreement in months, from effective start to end date. | Column contract_term_months (INT) in sales.carriage_deal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.carriage_deal']
  created_timestamp timestamp [note: 'Timestamp when this carriage deal record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.carriage_deal']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this carriage agreement (e.g., USD, EUR, GBP). | Column currency_code (STRING) in sales.carriage_deal']
  deal_name varchar [note: 'Human-readable name or title for this carriage agreement, typically including operator and channel lineup. | Column deal_name (STRING) in sales.carriage_deal']
  deal_number varchar [note: 'Externally-known business identifier for this carriage agreement, used in contracts and invoicing. | Column deal_number (STRING) in sales.carriage_deal']
  deal_type varchar [note: 'Classification of the carriage agreement structure: must-carry (mandatory channel inclusion per FCC rules), retransmission consent (negotiated fee-based carriage), negotiated carriage (standard commercial agreement), wholesale distribution (bulk channel package), or direct-to-consumer (OTT platform carriage). | Column deal_type (STRING) in sales.carriage_deal']
  dispute_resolution_method varchar [note: 'Agreed-upon method for resolving disputes arising from the carriage agreement: negotiation, mediation, arbitration, or litigation. | Column dispute_resolution_method (STRING) in sales.carriage_deal']
  effective_end_date date [note: 'Date when the carriage agreement term expires. Nullable for open-ended or evergreen agreements. | Column effective_end_date (DATE) in sales.carriage_deal']
  effective_start_date date [note: 'Date when the carriage agreement becomes binding and channel delivery obligations commence. | Column effective_start_date (DATE) in sales.carriage_deal']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction and governing law specified in the carriage agreement (e.g., State of New York, England and Wales). | Column governing_law_jurisdiction (STRING) in sales.carriage_deal']
  hd_tier_flag boolean [note: 'Indicates whether the channel(s) are carried in the operators high-definition tier. | Column hd_tier_flag (BOOLEAN) in sales.carriage_deal']
  last_modified_timestamp timestamp [note: 'Timestamp when this carriage deal record was last updated in the system. | Column last_modified_timestamp (TIMESTAMP) in sales.carriage_deal']
  minimum_subscriber_guarantee varchar [note: 'Minimum number of subscribers the operator guarantees for billing purposes, regardless of actual subscriber count. Used to establish revenue floor. | Column minimum_subscriber_guarantee (INT) in sales.carriage_deal']
  most_favored_nation_clause boolean [note: 'Indicates whether the agreement includes a most-favored-nation clause guaranteeing the operator receives terms no less favorable than those offered to other operators. | Column most_favored_nation_clause (BOOLEAN) in sales.carriage_deal']
  must_carry_designation boolean [note: 'Indicates whether this carriage is mandated under FCC must-carry rules, requiring cable operators to carry local broadcast stations without compensation. | Column must_carry_designation (BOOLEAN) in sales.carriage_deal']
  notes varchar [note: 'Free-text field for additional comments, special terms, or operational notes related to this carriage agreement. | Column notes (STRING) in sales.carriage_deal']
  payment_terms_net_days varchar [note: 'Number of days from invoice date within which the operator must remit carriage fee payment (e.g., Net 30, Net 60). | Column payment_terms_net_days (INT) in sales.carriage_deal']
  performance_guarantee_sla varchar [note: 'Service level agreement terms specifying uptime, signal quality, and technical performance guarantees for channel delivery. | Column performance_guarantee_sla (STRING) in sales.carriage_deal']
  renewal_option_date date [note: 'Date by which either party must exercise renewal option or provide notice of non-renewal. | Column renewal_option_date (DATE) in sales.carriage_deal']
  retransmission_consent_designation boolean [note: 'Indicates whether this carriage is governed by retransmission consent rules, allowing broadcasters to negotiate compensation for signal rebroadcast. | Column retransmission_consent_designation (BOOLEAN) in sales.carriage_deal']
  retransmission_consent_fee decimal(15,4) [note: 'Specific fee negotiated under retransmission consent rules for rebroadcast authorization of over-the-air signals. May be same as or distinct from general carriage fee. | Column retransmission_consent_fee (DECIMAL(15,4)) in sales.carriage_deal']
  sd_tier_flag boolean [note: 'Indicates whether the channel(s) are carried in the operators standard-definition tier. | Column sd_tier_flag (BOOLEAN) in sales.carriage_deal']
  signed_date date [note: 'Date when the carriage agreement was executed by all parties. | Column signed_date (DATE) in sales.carriage_deal']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.carriage_deal']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.carriage_deal']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the carriage agreement. | Column termination_notice_days (INT) in sales.carriage_deal']
  tier_placement varchar [note: 'Operator service tier in which the channel(s) are placed: basic (lowest tier), expanded basic, digital, premium, or specialized tiers (sports, news, entertainment), or a-la-carte (individual channel purchase). [ENUM-REF-CANDIDATE: basic|expanded_basic|digital|premium|sports|news|entertainment|a_la_carte — 8 candidates stripped; promote to reference product] | Column tier_placement (STRING) in sales.carriage_deal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.carriage_deal']

  Note: 'A commercial agreement with an MVPD, vMVPD, or cable/satellite operator for the carriage of one or more broadcast channels or streaming services. Captures operator account, channel lineup, carriage fee per subscriber per month, must-carry vs. retransmission consent designation, retransmission consent fee, blackout zone restrictions, HD/SD tier, minimum subscriber guarantee, deal term, renewal option dates, and carriage status. Feeds billing domain for monthly carriage fee invoicing and distribution domain for channel delivery obligations. | Unity Catalog table: media_broadcasting_ecm.sales.carriage_deal Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.agency_commission {
  agency_commission_id varchar [pk, note: 'Unique identifier for the agency commission record. Primary key. | Column agency_commission_id (BIGINT) in sales.agency_commission']
  ad_order_id varchar [note: 'Reference to the advertising order for which this commission was earned. Links to the ad order transaction. | Column ad_order_id (BIGINT) in sales.agency_commission']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Agency commissions are calculated on invoiced amounts and may be invoiced separately to agencies. Commission reconciliation, agency payment processing, and commission expense tracking require direct l | Column invoice_id (BIGINT) in billing.agency_commission']
  sales_agency_id varchar [note: 'Reference to the advertising agency that earned this commission. Links to the agency master record in the advertising domain. | Column sales_agency_id (BIGINT) in sales.agency_commission']
  sales_rep_id varchar [note: 'Foreign key linking to sales.rep. Business justification: Agency commissions should be tied to the sales rep who closed the deal for proper commission tracking and rep performance analysis. This FK enables rep-level commission tracking. N:1 relationship. New | Column sales_rep_id (BIGINT) in sales.agency_commission']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.agency_commission']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.agency_commission']
  applicable_deal_types varchar [note: 'Comma-separated list of deal types to which this commission structure applies (e.g., upfront, scatter, sponsorship, programmatic). Empty indicates all deal types are eligible. | Column applicable_deal_types (STRING) in sales.agency_commission']
  approved_by varchar [note: 'Name or identifier of the person who approved the commission for payment. Required for audit compliance. | Column approved_by (STRING) in sales.agency_commission']
  approved_timestamp timestamp [note: 'The date and time when the commission was approved for payment. Null if not yet approved. | Column approved_timestamp (TIMESTAMP) in sales.agency_commission']
  calculation_timestamp timestamp [note: 'The date and time when the commission amount was calculated by the system. Used for audit trail and version control. | Column calculation_timestamp (TIMESTAMP) in sales.agency_commission']
  commission_amount decimal(15,2) [note: 'The total commission amount earned by the agency for this order, calculated based on commission rate and basis. Expressed in the transaction currency. | Column commission_amount (DECIMAL(15,2)) in sales.agency_commission']
  commission_basis varchar [note: 'The financial basis on which the commission is calculated. Gross billings includes all charges before discounts; net billings deducts agency commission; net net deducts both agency commission and cash discount; revenue recognized uses the accounting revenue figure. | Column commission_basis (STRING) in sales.agency_commission']
  commission_rate decimal(5,4) [note: 'The percentage rate applied to calculate the commission. Expressed as a decimal (e.g., 0.1500 for 15%). Null when commission_type is flat_fee. | Column commission_rate (DECIMAL(5,4)) in sales.agency_commission']
  commission_status varchar [note: 'Current lifecycle status of the commission record. Pending indicates awaiting calculation; calculated means amount determined but not approved; approved is ready for payment; paid indicates payment completed; disputed flags reconciliation issues; reversed indicates a reversal transaction; cancelled means the commission was voided. [ENUM-REF-CANDIDATE: pending|calculated|approved|paid|disputed|reversed|cancelled — 7 candidates stripped; promote to reference product] | Column commission_status (STRING) in sales.agency_commission']
  commission_structure_code varchar [note: 'Business identifier for the commission structure applied to this record. Used for reporting and reconciliation across systems. | Column commission_structure_code (STRING) in sales.agency_commission']
  commission_type varchar [note: 'Classification of the commission structure. Standard represents the typical 15% agency commission; negotiated indicates custom rates; tiered applies different rates based on volume; performance-based ties commission to campaign outcomes; flat fee is a fixed amount; hybrid combines multiple methods. | Column commission_type (STRING) in sales.agency_commission']
  contract_reference varchar [note: 'Reference to the agency contract or master service agreement that governs this commission structure. Used to link commission records to contractual terms. | Column contract_reference (STRING) in sales.agency_commission']
  cost_center varchar [note: 'The cost center responsible for this commission expense. Used for internal management accounting and budget tracking. | Column cost_center (STRING) in sales.agency_commission']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.agency_commission']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the commission amount (e.g., USD, GBP, EUR). | Column currency_code (STRING) in sales.agency_commission']
  dispute_reason varchar [note: 'Description of the reason for commission dispute if commission_status is disputed. Documents agency objections, calculation errors, or contractual interpretation differences. | Column dispute_reason (STRING) in sales.agency_commission']
  dispute_resolution_date date [note: 'The date on which a disputed commission was resolved and either approved for payment or cancelled. | Column dispute_resolution_date (DATE) in sales.agency_commission']
  effective_end_date date [note: 'The date on which this commission structure expires and is no longer applicable to new orders. Null indicates an open-ended structure. | Column effective_end_date (DATE) in sales.agency_commission']
  effective_start_date date [note: 'The date from which this commission structure becomes active and applicable to new orders. | Column effective_start_date (DATE) in sales.agency_commission']
  fiscal_period varchar [note: 'The fiscal period (year-quarter or year-month) in which this commission is recognized for financial reporting. Format: YYYY-QN for quarters or YYYY-MM for months (e.g., 2024-Q2, 2024-06). | Column fiscal_period (STRING) in sales.agency_commission']
  gl_account_code varchar [note: 'The general ledger account code to which this commission expense is posted for financial accounting. | Column gl_account_code (STRING) in sales.agency_commission']
  notes varchar [note: 'General free-text notes or comments about this commission record. Used for special instructions, context, or operational details. | Column notes (STRING) in sales.agency_commission']
  order_gross_amount decimal(15,2) [note: 'The gross billing amount of the associated ad order before any deductions. Used as the basis for commission calculation when commission_basis is gross_billings. | Column order_gross_amount (DECIMAL(15,2)) in sales.agency_commission']
  order_net_amount decimal(15,2) [note: 'The net billing amount of the associated ad order after agency commission deduction. Used as the basis for commission calculation when commission_basis is net_billings. | Column order_net_amount (DECIMAL(15,2)) in sales.agency_commission']
  override_approved_by varchar [note: 'Name or identifier of the authorized person who approved the commission override. Required for audit compliance when override_flag is true. | Column override_approved_by (STRING) in sales.agency_commission']
  override_flag boolean [note: 'Indicates whether this commission record was manually overridden from the standard calculation. True when a manual adjustment was applied; false for standard automated calculation. | Column override_flag (BOOLEAN) in sales.agency_commission']
  override_reason varchar [note: 'Business justification for manual override of the commission calculation. Required when override_flag is true. Documents special circumstances, contractual exceptions, or correction rationale. | Column override_reason (STRING) in sales.agency_commission']
  payment_date date [note: 'The actual date on which the commission payment was made to the agency. Null if not yet paid. | Column payment_date (DATE) in sales.agency_commission']
  payment_due_date date [note: 'The date by which the commission payment is due to the agency per contractual terms. | Column payment_due_date (DATE) in sales.agency_commission']
  payment_method varchar [note: 'The payment instrument used to remit the commission. ACH (Automated Clearing House) for electronic bank transfer; wire transfer for same-day funds; check for paper payment; credit memo for account credit; offset for netting against agency payables. | Column payment_method (STRING) in sales.agency_commission']
  payment_reference_number varchar [note: 'External reference number for the payment transaction (e.g., check number, wire confirmation, ACH trace number). Used for reconciliation and audit. | Column payment_reference_number (STRING) in sales.agency_commission']
  reconciliation_date date [note: 'The date on which this commission record was successfully reconciled with agency statements and financial records. | Column reconciliation_date (DATE) in sales.agency_commission']
  reconciliation_notes varchar [note: 'Free-text notes documenting reconciliation activities, discrepancies found, resolution steps, or special handling instructions. Used for audit trail and dispute resolution. | Column reconciliation_notes (STRING) in sales.agency_commission']
  reconciliation_status varchar [note: 'Status of the financial reconciliation process for this commission. Tracks whether the commission calculation and payment have been verified and matched to agency statements. | Column reconciliation_status (STRING) in sales.agency_commission']
  record_created_timestamp timestamp [note: 'The date and time when this commission record was first created in the system. Part of the audit trail. | Column record_created_timestamp (TIMESTAMP) in sales.agency_commission']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.agency_commission']
  source_record_reference varchar [note: 'The unique identifier of this record in the source operational system. Used for traceability and data lineage. | Column source_record_reference (STRING) in sales.agency_commission']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.agency_commission']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.agency_commission']

  Note: 'The commission structure and earned commission records for advertising agencies acting on behalf of advertisers. Captures agency account, commission rate (standard 15% agency commission or negotiated rate), commission basis (gross billings, net billings), applicable deal types, effective date range, earned commission amount per order, payment status, and reconciliation notes. Supports commission calculation for billing and financial reconciliation. Distinct from talent residuals (managed in rights/talent domain) — this is purely the commercial agency fee structure. | Unity Catalog table: media_broadcasting_ecm.sales.agency_commission Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.rep {
  rep_id varchar [pk, note: 'Primary key for rep | Column rep_id (BIGINT) in sales.rep']
  employee_id varchar [note: 'Foreign key reference to the employee master record in the HR/workforce domain. Links the sales rep to their core employee profile. | Column employee_id (BIGINT) in workforce.rep']
  manager_rep_id varchar [note: 'Foreign key reference to the sales manager or team lead who supervises this sales representative. Self-referential relationship within the sales rep hierarchy. | Column manager_rep_id (BIGINT) in sales.rep']
  sales_team_id varchar [note: 'Foreign key linking to sales.sales_team. Business justification: rep product has sales_team_name (STRING) but no FK to sales_team. This is denormalized - the team name should be retrieved via JOIN to sales_team. Adding sales_team_id FK allows normalization. Standar | Column sales_team_id (BIGINT) in sales.rep']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.rep']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.rep']
  account_portfolio_segment varchar [note: 'Classification of the account portfolio managed by the sales representative. Indicates whether they manage agency relationships, direct advertiser accounts, distribution partners (MVPD/vMVPD), OTT platforms, syndication buyers, or other client segments. [ENUM-REF-CANDIDATE: agency|direct_advertiser|mvpd|vmvpd|ott_platform|syndicator|international|government — 8 candidates stripped; promote to reference product] | Column account_portfolio_segment (STRING) in sales.rep']
  annual_quota_amount decimal(18,2) [note: 'Total annual revenue quota assigned to the sales representative for the current quota period. Measured in the company\'s reporting currency. | Column annual_quota_amount (DECIMAL(18,2)) in sales.rep']
  assignment_end_date date [note: 'Date the sales representative\'s current territory or account portfolio assignment ended. Null if currently active in the assignment. | Column assignment_end_date (DATE) in sales.rep']
  assignment_start_date date [note: 'Date the sales representative began their current territory or account portfolio assignment. May differ from hire date if reassigned. | Column assignment_start_date (DATE) in sales.rep']
  commission_plan_type varchar [note: 'Type of commission structure applied to the sales representative. Defines how commissions are calculated based on sales performance (e.g., base salary plus commission, commission-only, tiered rates, accelerators for exceeding quota). | Column commission_plan_type (STRING) in sales.rep']
  commission_rate_percentage decimal(5,2) [note: 'Standard commission rate percentage applied to qualified sales revenue. May vary by deal type or quota attainment tier. | Column commission_rate_percentage (DECIMAL(5,2)) in sales.rep']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.rep']
  created_timestamp timestamp [note: 'Timestamp when the sales representative record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.rep']
  deal_type_specialization varchar [note: 'Primary deal type or sales channel specialization for the representative. Indicates whether they focus on national TV advertising, digital campaigns, content licensing, syndication deals, or other revenue streams. [ENUM-REF-CANDIDATE: national_tv|local_tv|digital|syndication|licensing|upfront|scatter|programmatic|sponsorship|multi_platform — 10 candidates stripped; promote to reference product] | Column deal_type_specialization (STRING) in sales.rep']
  digital_certified_flag boolean [note: 'Boolean flag indicating whether the sales representative is certified and authorized to sell digital advertising inventory, including OTT, streaming, and programmatic channels. | Column digital_certified_flag (BOOLEAN) in sales.rep']
  email_address varchar [note: 'Primary business email address for the sales representative used for client communication and internal correspondence. | Column email_address (STRING) in sales.rep']
  hire_date date [note: 'Date the sales representative was hired or onboarded into the sales organization. | Column hire_date (DATE) in sales.rep']
  last_modified_timestamp timestamp [note: 'Timestamp when the sales representative record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in sales.rep']
  office_location varchar [note: 'Primary office location or city where the sales representative is based. May be a physical office or designated home office location. | Column office_location (STRING) in sales.rep']
  performance_tier varchar [note: 'Performance classification or tier assigned to the sales representative based on quota attainment and sales metrics. Used for recognition, compensation adjustments, and coaching. | Column performance_tier (STRING) in sales.rep']
  phone_number varchar [note: 'Primary business phone number for the sales representative used for client outreach and deal negotiations. | Column phone_number (STRING) in sales.rep']
  quota_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the quota amount (e.g., USD, GBP, EUR). | Column quota_currency_code (STRING) in sales.rep']
  quota_period_end_date date [note: 'End date of the current quota period for the sales representative. | Column quota_period_end_date (DATE) in sales.rep']
  quota_period_start_date date [note: 'Start date of the current quota period for the sales representative. Typically aligns with fiscal year or calendar year. | Column quota_period_start_date (DATE) in sales.rep']
  rep_name varchar [note: 'Full legal name of the sales representative as it appears in business records and communications. | Column rep_name (STRING) in sales.rep']
  rep_status varchar [note: 'Current operational status of the sales representative within the sales organization. Indicates whether they are actively selling, on leave, or no longer with the company. | Column rep_status (STRING) in sales.rep']
  salesforce_user_reference varchar [note: 'Unique user identifier in Salesforce Media Cloud CRM system. Links the sales rep record to their Salesforce user profile for opportunity tracking and pipeline management. | Column salesforce_user_reference (STRING) in sales.rep']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.rep']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.rep']
  territory_assignment varchar [note: 'Geographic or market territory assigned to the sales representative. May be defined by region, DMA (Designated Market Area), or account segment. | Column territory_assignment (STRING) in sales.rep']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.rep']
  upfront_certified_flag boolean [note: 'Boolean flag indicating whether the sales representative is certified and authorized to negotiate and close upfront advertising deals. Upfront deals are advance commitments made during the annual upfront sales event. | Column upfront_certified_flag (BOOLEAN) in sales.rep']

  Note: 'The sales representative or account executive profile within the sales domain, capturing the commercial assignment and quota context for each seller. Tracks rep name, employee ID (FK to HR/workforce), territory assignment, account portfolio, deal type specialization (national TV, digital, syndication, licensing), annual quota, quota period, commission plan type, manager, and active status. This is the sales-domain view of the seller — not a duplicate of HR employee master — focused on commercial assignment, quota, and territory rather than HR attributes. | Unity Catalog table: media_broadcasting_ecm.sales.rep Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.sales_territory {
  sales_territory_id varchar [pk, note: 'Unique identifier for the sales territory. Primary key. | Column sales_territory_id (BIGINT) in sales.sales_territory']
  assigned_sales_rep_id varchar [note: 'Identifier of the primary sales representative or account executive assigned to this territory. | Column assigned_sales_rep_id (BIGINT) in sales.sales_territory']
  assigned_sales_team_id varchar [note: 'Identifier of the sales team collectively responsible for this territory, if team-based assignment is used. | Column assigned_sales_team_id (BIGINT) in sales.sales_territory']
  parent_territory_sales_territory_id varchar [note: 'Identifier of the parent territory in a hierarchical territory structure. Null for top-level territories. | Column parent_territory_sales_territory_id (BIGINT) in sales.sales_territory']
  primary_sales_employee_id varchar [note: 'Identifier of the sales manager or director responsible for overseeing this territory and its assigned reps. | Column primary_sales_employee_id (BIGINT) in workforce.sales_territory']
  sales_rights_rights_territory_id varchar [note: 'FK to SSOT rights.rights_territory']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sales_territory']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sales_territory']
  account_count varchar [note: 'Number of active advertiser or agency accounts assigned to this territory. | Column account_count (INT) in sales.sales_territory']
  account_segment varchar [note: 'Classification of accounts within this territory by size or relationship type: enterprise (largest accounts), major (key accounts), mid_market, small_business, agency (advertising agencies), or direct (direct advertisers). | Column account_segment (STRING) in sales.sales_territory']
  commission_rate_percent decimal(5,2) [note: 'Standard commission percentage rate applied to sales within this territory for compensation calculation. | Column commission_rate_percent (DECIMAL(5,2)) in sales.sales_territory']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sales_territory']
  created_timestamp timestamp [note: 'Date and time when this territory record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.sales_territory']
  dma_list varchar [note: 'Comma-separated list of Nielsen DMA codes or names included in this territory for broadcast market segmentation. | Column dma_list (STRING) in sales.sales_territory']
  effective_end_date date [note: 'Date when this territory definition expires or is superseded. Null for open-ended territories. | Column effective_end_date (DATE) in sales.sales_territory']
  effective_start_date date [note: 'Date when this territory definition becomes active and assignments take effect. | Column effective_start_date (DATE) in sales.sales_territory']
  geographic_coverage varchar [note: 'Textual description of the geographic area covered by this territory (e.g., states, DMAs, postal codes, countries). Free-form field for complex geographic definitions. | Column geographic_coverage (STRING) in sales.sales_territory']
  last_modified_timestamp timestamp [note: 'Date and time when this territory record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in sales.sales_territory']
  notes varchar [note: 'Free-form notes or comments about this territory, including special instructions, historical context, or operational considerations. | Column notes (STRING) in sales.sales_territory']
  priority_level varchar [note: 'Strategic priority assigned to this territory for resource allocation and management focus: high, medium, low, or strategic (top-tier focus). | Column priority_level (STRING) in sales.sales_territory']
  product_line_focus varchar [note: 'Primary advertising product lines or inventory types this territory is authorized to sell (e.g., Linear TV, Digital Video, OTT/Streaming, Radio, Display, Sponsorships). Comma-separated for multiple product lines. | Column product_line_focus (STRING) in sales.sales_territory']
  revenue_target_amount decimal(18,2) [note: 'Annual or period revenue quota assigned to this territory, used for quota allocation and performance tracking. | Column revenue_target_amount (DECIMAL(18,2)) in sales.sales_territory']
  revenue_target_currency varchar [note: 'Three-letter ISO 4217 currency code for the revenue target amount (e.g., USD, GBP, EUR). | Column revenue_target_currency (STRING) in sales.sales_territory']
  sales_channel varchar [note: 'Primary sales channel or go-to-market approach for this territory: direct (direct sales team), agency (sold through agencies), programmatic (automated buying), self_service (online self-serve), or partner (channel partners). | Column sales_channel (STRING) in sales.sales_territory']
  scatter_market_flag boolean [note: 'Indicates whether this territory handles scatter market (last-minute, short-term) ad inventory sales. True if scatter sales are part of territory scope. | Column scatter_market_flag (BOOLEAN) in sales.sales_territory']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sales_territory']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sales_territory']
  territory_code varchar [note: 'Short alphanumeric code uniquely identifying the territory for reporting and system integration (e.g., NE-01, AUTO-WEST, MAJ-CA). | Column territory_code (STRING) in sales.sales_territory']
  territory_description varchar [note: 'Detailed textual description of the territory scope, coverage rules, special conditions, and strategic objectives. | Column territory_description (STRING) in sales.sales_territory']
  territory_name varchar [note: 'Business name of the sales territory (e.g., Northeast Region, Automotive Vertical, Major Accounts West). | Column territory_name (STRING) in sales.sales_territory']
  territory_status varchar [note: 'Current lifecycle status of the territory: active (in use), inactive (not currently assigned), pending (awaiting activation), suspended (temporarily disabled), or archived (historical record). | Column territory_status (STRING) in sales.sales_territory']
  territory_type varchar [note: 'Classification of the territory structure: geographic (region-based), account_segment (by account size or tier), vertical (industry-based such as automotive, pharma, retail, entertainment), hybrid (combination), national (entire country), or regional (multi-state or multi-market). | Column territory_type (STRING) in sales.sales_territory']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sales_territory']
  upfront_participation_flag boolean [note: 'Indicates whether this territory participates in annual upfront advertising sales events. True if territory is included in upfront planning and commitments. | Column upfront_participation_flag (BOOLEAN) in sales.sales_territory']
  vertical_industry_focus varchar [note: 'Primary industry vertical or sector this territory specializes in (e.g., Automotive, Pharmaceutical, Retail, Entertainment, Financial Services, Technology). Used for vertical-based territory models. | Column vertical_industry_focus (STRING) in sales.sales_territory']

  Note: 'Defines the geographic, account-based, or vertical market territory assigned to sales teams and individual reps. Captures territory name, territory type (geographic region, account segment, vertical — automotive, pharma, retail, entertainment), assigned sales rep or team, revenue target, account count, and effective date range. Supports territory management, quota allocation, and pipeline reporting by market segment. Managed within Salesforce Media Cloud territory management module. | Unity Catalog table: media_broadcasting_ecm.sales.sales_territory'
}

Table sales.rfp {
  rfp_id varchar [pk, note: 'Unique identifier for the request for proposal record. Primary key. | Column rfp_id (BIGINT) in sales.rfp']
  advertiser_id varchar [note: 'Reference to the advertiser or brand issuing the RFP. Links to the advertiser master entity. | Column advertiser_id (BIGINT) in sales.rfp']
  opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: RFPs feed the opportunity pipeline. When an RFP is qualified, it becomes an opportunity. This FK enables tracing opportunities back to their originating RFPs. N:1 relationship (one RFP can lead to one | Column opportunity_id (BIGINT) in sales.rfp']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser and submitting the RFP on their behalf. Nullable if direct advertiser submission. | Column sales_agency_id (BIGINT) in sales.rfp']
  sales_rep_id varchar [note: 'Reference to the sales representative or account executive responsible for managing this RFP and preparing the response proposal. | Column sales_rep_id (BIGINT) in sales.rfp']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.rfp']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.rfp']
  award_decision_date date [note: 'Date when the advertiser or agency communicated their final decision on the RFP (awarded or lost). Nullable until decision is made. | Column award_decision_date (DATE) in sales.rfp']
  awarded_amount decimal(15,2) [note: 'Total dollar value of the campaign if the RFP was awarded to the broadcaster. Nullable if RFP was lost or still pending. Used for revenue forecasting and sales performance tracking. | Column awarded_amount (DECIMAL(15,2)) in sales.rfp']
  budget_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the budget amounts (e.g., USD, GBP, EUR). Ensures consistent financial reporting across international campaigns. | Column budget_currency_code (STRING) in sales.rfp']
  budget_range_max decimal(15,2) [note: 'Maximum budget amount the advertiser is willing to commit for the campaign. Defines the upper bound for proposal pricing. | Column budget_range_max (DECIMAL(15,2)) in sales.rfp']
  budget_range_min decimal(15,2) [note: 'Minimum budget amount the advertiser is willing to commit for the campaign. Used for opportunity qualification and inventory allocation. | Column budget_range_min (DECIMAL(15,2)) in sales.rfp']
  campaign_objective varchar [note: 'High-level business goal or marketing objective the advertiser seeks to achieve through this campaign (e.g., brand awareness, product launch, direct response, seasonal promotion). | Column campaign_objective (STRING) in sales.rfp']
  competitive_separation_requirements varchar [note: 'Rules for separating this advertiser\'s spots from competing brands within the same ad pod or program. Typically specifies minimum time separation or exclusivity within a break. | Column competitive_separation_requirements (STRING) in sales.rfp']
  content_adjacency_restrictions varchar [note: 'Advertiser-specified restrictions on content types or genres where ads should not appear (e.g., no violent content, no political programming, no competitive sports). Used for brand safety and compliance. | Column content_adjacency_restrictions (STRING) in sales.rfp']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.rfp']
  created_timestamp timestamp [note: 'Timestamp when this RFP record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in sales.rfp']
  daypart_requirements varchar [note: 'Specific broadcast daypart preferences or requirements (e.g., Prime Time, Early Morning, Late Night, Weekend). Dayparts are time segments of the broadcast day used for scheduling and pricing. | Column daypart_requirements (STRING) in sales.rfp']
  desired_frequency decimal(5,2) [note: 'Target average number of times each unique viewer should be exposed to the advertisement during the campaign. Frequency is a key metric for message reinforcement. | Column desired_frequency (DECIMAL(5,2)) in sales.rfp']
  desired_grp_target decimal(10,2) [note: 'Target Gross Rating Points the advertiser seeks to achieve. GRP is a standard audience measurement metric representing the sum of all rating points delivered by a campaign. | Column desired_grp_target (DECIMAL(10,2)) in sales.rfp']
  desired_impressions varchar [note: 'Total number of ad impressions the advertiser seeks to purchase. An impression represents a single ad view by a viewer. | Column desired_impressions (BIGINT) in sales.rfp']
  desired_reach_percent decimal(5,2) [note: 'Target percentage of unique audience members the advertiser wants to reach at least once during the campaign. Reach is a key audience delivery metric. | Column desired_reach_percent (DECIMAL(5,2)) in sales.rfp']
  flight_end_date date [note: 'Desired end date for the advertising campaign flight. Defines the conclusion of the campaign delivery window. | Column flight_end_date (DATE) in sales.rfp']
  flight_start_date date [note: 'Desired start date for the advertising campaign flight. Defines the beginning of the campaign delivery window. | Column flight_start_date (DATE) in sales.rfp']
  last_modified_timestamp timestamp [note: 'Timestamp when this RFP record was last updated. Tracks changes throughout the RFP review and response process. | Column last_modified_timestamp (TIMESTAMP) in sales.rfp']
  loss_reason varchar [note: 'Explanation or categorization of why the RFP was lost if not awarded. Used for competitive analysis and sales process improvement. Nullable if RFP was awarded or still pending. | Column loss_reason (STRING) in sales.rfp']
  notes varchar [note: 'Free-form text field for capturing additional context, special requirements, internal comments, or follow-up actions related to the RFP. Used for collaboration and knowledge transfer. | Column notes (STRING) in sales.rfp']
  platform_preference varchar [note: 'Advertiser\'s preferred distribution platforms for the campaign. May include linear television, Connected TV (CTV), digital video, streaming (OTT), or cross-platform packages. Multiple platforms may be specified. | Column platform_preference (STRING) in sales.rfp']
  pricing_model_preference varchar [note: 'Advertiser\'s preferred pricing structure for the campaign. Options include Cost Per Mille (CPM), Cost Per Rating Point (CPRP), flat rate, performance-based, or hybrid models. | Column pricing_model_preference (STRING) in sales.rfp']
  priority_level varchar [note: 'Internal priority classification assigned to the RFP based on strategic value, budget size, client relationship, or competitive factors. Used for resource allocation and response sequencing. | Column priority_level (STRING) in sales.rfp']
  response_due_date date [note: 'Deadline by which the broadcaster must submit a response proposal to the RFP. Critical for sales team prioritization and workflow management. | Column response_due_date (DATE) in sales.rfp']
  response_submitted_date date [note: 'Date when the broadcaster submitted their proposal response to the RFP. Nullable until response is completed. Used to track response turnaround time. | Column response_submitted_date (DATE) in sales.rfp']
  rfp_number varchar [note: 'Business identifier for the RFP, typically assigned by the source system or agency. Used for external reference and tracking. | Column rfp_number (STRING) in sales.rfp']
  rfp_status varchar [note: 'Current lifecycle status of the RFP in the sales pipeline. Tracks progression from receipt through final disposition. | Column rfp_status (STRING) in sales.rfp']
  source varchar [note: 'Origin channel through which the RFP was received. Distinguishes between agency-mediated, direct advertiser, programmatic platform, upfront market, scatter market, or network referral submissions. | Column rfp_source (STRING) in sales.rfp']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.rfp']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.rfp']
  submission_date date [note: 'Date when the RFP was received or submitted by the advertiser, agency, or content buyer. Principal business event timestamp for the RFP lifecycle. | Column submission_date (DATE) in sales.rfp']
  target_age_range varchar [note: 'Specific age demographic range requested by the advertiser (e.g., 18-34, 25-54, 35-49). Used for audience targeting and rate card selection. | Column target_age_range (STRING) in sales.rfp']
  target_audience_description varchar [note: 'Narrative description of the desired audience demographics and psychographics, including age range, gender, household income (HHI), geography, interests, and behavioral attributes. | Column target_audience_description (STRING) in sales.rfp']
  target_gender varchar [note: 'Gender demographic targeting requirement specified in the RFP. May be male, female, all genders, or unspecified. | Column target_gender (STRING) in sales.rfp']
  target_geography varchar [note: 'Geographic targeting requirements, including designated market areas (DMAs), regions, states, or national coverage. May include multiple geographies separated by delimiters. | Column target_geography (STRING) in sales.rfp']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.rfp']

  Note: 'A Request for Proposal received from an advertiser, agency, or content buyer soliciting inventory availability, pricing, and audience delivery options for an upcoming campaign or content acquisition. Captures RFP source (agency, direct, programmatic platform), submission date, response due date, campaign objectives, target audience demographics (age, gender, HHI, geography), budget range, platform preferences (linear, CTV, digital, cross-platform), daypart requirements, content adjacency restrictions, competitive separation requirements, desired flight dates, and RFP status (received, in-review, responded, awarded, lost). The upstream trigger for proposal creation and opportunity qualification in the sales pipeline. Response quality and turnaround time are key competitive differentiators in winning agency business. | Unity Catalog table: media_broadcasting_ecm.sales.rfp Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.avail {
  avail_id varchar [pk, note: 'Unique identifier for the advertising inventory availability record. | Column avail_id (BIGINT) in sales.avail']
  ad_order_line_id varchar [note: 'Reference to the confirmed ad order line that has purchased this inventory, if sold. | Column ad_order_line_id (BIGINT) in sales.avail']
  ad_pod_id varchar [note: 'Foreign key linking to sales.ad_pod. Business justification: Avails represent inventory availability within ad pods. This FK links the available inventory slot to its containing ad pod for proper inventory management and scheduling. Nullable because some avails | Column ad_pod_id (BIGINT) in sales.avail']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Advertising avails are facility-specific inventory units for local/regional sales. Facility identification enables inventory management, geographic targeting, and transmission capacity planning. Criti | Column broadcast_facility_id (BIGINT) in technology.avail']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Available inventory slots are station-specific and must reference the broadcast license for regulatory tracking, compliance verification, and ensuring sold inventory matches licensed station capabilit | Column broadcast_license_id (BIGINT) in compliance.avail']
  channel_id varchar [note: 'Reference to the broadcast channel or platform where this inventory is available. | Column channel_id (BIGINT) in scheduling.avail']
  primary_avail_employee_id varchar [note: 'Reference to the user who created this availability record. | Column avail_employee_id (BIGINT) in workforce.avail']
  rate_card_id varchar [note: 'Reference to the rate card that defines pricing for this inventory type and daypart. | Column rate_card_id (BIGINT) in advertising.avail']
  sales_account_id varchar [note: 'Reference to the advertiser or agency account that currently holds this inventory. | Column sales_account_id (BIGINT) in sales.avail']
  sales_proposal_id varchar [note: 'Reference to the sales proposal that includes this availability, if applicable. | Column sales_proposal_id (BIGINT) in sales.avail']
  sales_rep_id varchar [note: 'Reference to the sales representative responsible for selling this inventory. | Column sales_rep_id (BIGINT) in sales.avail']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: When an avail is sold and confirmed, it maps to a specific schedule slot for playout. Business process: order fulfillment, traffic-to-playout handoff, as-run reconciliation, affidavit generation. | Column schedule_slot_id (BIGINT) in scheduling.avail']
  title_id varchar [note: 'Reference to the program or content title during which this advertising slot is available. | Column title_id (BIGINT) in content.avail']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.avail']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.avail']
  ad_pod_position varchar [note: 'Position of this spot within the ad pod or commercial break (1 for first position, 2 for second, etc.). | Column ad_pod_position (INT) in sales.avail']
  air_date date [note: 'Scheduled broadcast date when this advertising slot will air. | Column air_date (DATE) in sales.avail']
  air_time timestamp [note: 'Precise scheduled broadcast timestamp when this advertising slot will air. | Column air_time (TIMESTAMP) in sales.avail']
  avail_code varchar [note: 'Business identifier code for this availability record, typically generated by the traffic system. | Column avail_code (STRING) in sales.avail']
  break_type varchar [note: 'Type of commercial break where this inventory is positioned (opening, mid-break, closing, standalone). | Column break_type (STRING) in sales.avail']
  content_rating varchar [note: 'Parental guidance rating of the program content surrounding this advertising slot (TV-Y, TV-Y7, TV-G, TV-PG, TV-14, TV-MA). | Column content_rating (STRING) in sales.avail']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.avail']
  created_timestamp timestamp [note: 'Date and time when this availability record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.avail']
  daypart varchar [note: 'Time segment of the broadcast day when this inventory is available (early morning, morning, daytime, early fringe, prime access, prime time, late fringe, late night, overnight). [ENUM-REF-CANDIDATE: early_morning|morning|daytime|early_fringe|prime_access|prime_time|late_fringe|late_night|overnight — 9 candidates stripped; promote to reference product] | Column daypart (STRING) in sales.avail']
  floor_cpm_usd decimal(12,2) [note: 'Minimum Cost Per Thousand Impressions (CPM) rate in USD that the seller will accept for this inventory. | Column floor_cpm_usd (DECIMAL(12,2)) in sales.avail']
  floor_rate_usd decimal(12,2) [note: 'Minimum unit rate in USD that the seller will accept for this advertising slot. | Column floor_rate_usd (DECIMAL(12,2)) in sales.avail']
  genre varchar [note: 'Content genre or category of the program where this advertising slot is available (e.g., News, Sports, Drama, Comedy, Reality). | Column genre (STRING) in sales.avail']
  geographic_market varchar [note: 'Designated Market Area (DMA) or geographic market where this inventory will be broadcast or streamed. | Column geographic_market (STRING) in sales.avail']
  hold_expiry_timestamp timestamp [note: 'Date and time when the current hold on this inventory will expire if not confirmed. | Column hold_expiry_timestamp (TIMESTAMP) in sales.avail']
  hold_placed_timestamp timestamp [note: 'Date and time when the current hold was placed on this inventory. | Column hold_placed_timestamp (TIMESTAMP) in sales.avail']
  hold_status varchar [note: 'Current reservation status of this inventory (available, first hold, second hold, third hold, released, sold, expired). [ENUM-REF-CANDIDATE: available|first_hold|second_hold|third_hold|released|sold|expired — 7 candidates stripped; promote to reference product] | Column hold_status (STRING) in sales.avail']
  inventory_type varchar [note: 'Type of advertising unit available for sale (spot, sponsorship, integration, digital pre-roll, mid-roll, post-roll, overlay, branded content). [ENUM-REF-CANDIDATE: spot|sponsorship|integration|pre_roll|mid_roll|post_roll|overlay|branded_content — 8 candidates stripped; promote to reference product] | Column inventory_type (STRING) in sales.avail']
  last_modified_timestamp timestamp [note: 'Date and time when this availability record was last updated. | Column last_modified_timestamp (TIMESTAMP) in sales.avail']
  makegood_eligible_flag boolean [note: 'Indicates whether this inventory is eligible for makegood compensation if performance guarantees are not met. | Column makegood_eligible_flag (BOOLEAN) in sales.avail']
  notes varchar [note: 'Additional notes or special instructions related to this availability (e.g., creative restrictions, special positioning requirements). | Column notes (STRING) in sales.avail']
  platform_type varchar [note: 'Distribution platform type where this inventory is available (linear, VOD, SVOD, AVOD, TVOD, OTT, FAST, digital). [ENUM-REF-CANDIDATE: linear|vod|svod|avod|tvod|ott|fast|digital — 8 candidates stripped; promote to reference product] | Column platform_type (STRING) in sales.avail']
  preemptible_flag boolean [note: 'Indicates whether this inventory can be preempted by higher-priority advertising (true) or is guaranteed (false). | Column preemptible_flag (BOOLEAN) in sales.avail']
  projected_grp decimal(10,2) [note: 'Estimated Gross Rating Points this slot is expected to deliver, representing the percentage of the target audience reached multiplied by frequency. | Column projected_grp (DECIMAL(10,2)) in sales.avail']
  projected_impressions varchar [note: 'Estimated number of viewer impressions this advertising slot is expected to deliver based on historical audience data. | Column projected_impressions (BIGINT) in sales.avail']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.avail']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.avail']
  target_demographic varchar [note: 'Primary audience demographic segment this inventory is projected to reach (e.g., Adults 18-49, Women 25-54, Men 18-34). | Column target_demographic (STRING) in sales.avail']
  unit_length_seconds varchar [note: 'Duration of the advertising unit in seconds (e.g., 15, 30, 60 for traditional spots). | Column unit_length_seconds (INT) in sales.avail']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.avail']
  window_end_date date [note: 'End date of the availability window for content licensing or sponsorship opportunities. | Column window_end_date (DATE) in sales.avail']
  window_start_date date [note: 'Start date of the availability window for content licensing or sponsorship opportunities. | Column window_start_date (DATE) in sales.avail']

  Note: 'An inventory availability record representing a specific advertising slot, sponsorship position, or content window that is available for sale at a given point in time. Captures channel or platform, program or content title, daypart, air date or window, unit type (spot, sponsorship, integration, digital pre-roll), spot length, available impressions or GRPs, audience demographic projection, floor CPM, hold status (available, first hold, second hold, released, sold), holding account reference, hold expiry date, and source system (Wide Orbit, programmatic SSP). Avails are the sellable inventory units that sales reps present to buyers and that proposals are built from. Sourced from Wide Orbit inventory management and EPG scheduling. Updated in near-real-time as holds are placed and orders confirmed. | Unity Catalog table: media_broadcasting_ecm.sales.avail Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.upfront_option_exercise {
  upfront_option_exercise_id varchar [pk, note: 'Unique identifier for the upfront option exercise record. Primary key. | Column upfront_option_exercise_id (BIGINT) in sales.upfront_option_exercise']
  advertiser_id varchar [note: 'Reference to the advertiser (brand or company) that holds the upfront commitment and is exercising this option. | Column advertiser_id (BIGINT) in sales.upfront_option_exercise']
  primary_upfront_employee_id varchar [note: 'Reference to the user (typically sales manager or director) who approved this option exercise, if approval was required. | Column primary_upfront_employee_id (BIGINT) in workforce.upfront_option_exercise']
  private_marketplace_deal_id varchar [note: 'FK to private marketplace deal for programmatic option exercise']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser in this upfront commitment and option exercise, if applicable. | Column sales_agency_id (BIGINT) in sales.upfront_option_exercise']
  sales_rep_id varchar [note: 'Reference to the sales representative who managed this option exercise transaction and communicated with the advertiser or agency. | Column sales_rep_id (BIGINT) in sales.upfront_option_exercise']
  tertiary_upfront_last_modified_by_user_employee_id varchar [note: 'Reference to the user who most recently modified this option exercise record. | Column tertiary_upfront_last_modified_by_user_employee_id (BIGINT) in workforce.upfront_option_exercise']
  upfront_commitment_id varchar [note: 'Reference to the parent upfront commitment contract under which this option exercise occurs. | Column upfront_commitment_id (BIGINT) in sales.upfront_option_exercise']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.upfront_option_exercise']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.upfront_option_exercise']
  adjusted_commitment_amount decimal(18,2) [note: 'The resulting total commitment amount for the parent upfront deal after this option exercise is applied. Used to track the cumulative impact of option exercises on the overall upfront commitment. | Column adjusted_commitment_amount (DECIMAL(18,2)) in sales.upfront_option_exercise']
  amendment_document_reference varchar [note: 'Reference identifier or file path to the contract amendment document associated with this option exercise, if applicable. | Column amendment_document_reference (STRING) in sales.upfront_option_exercise']
  approval_required_flag boolean [note: 'Indicates whether this option exercise requires internal management approval before being finalized. True for exercises that deviate from standard terms or involve significant cancellations. | Column approval_required_flag (BOOLEAN) in sales.upfront_option_exercise']
  approval_timestamp timestamp [note: 'The date and time when this option exercise was approved by management, if approval was required. | Column approval_timestamp (TIMESTAMP) in sales.upfront_option_exercise']
  cancellation_reason_code varchar [note: 'Standardized code indicating the primary reason the advertiser cancelled or reduced this option window commitment. | Column cancellation_reason_code (STRING) in sales.upfront_option_exercise']
  cancellation_reason_notes varchar [note: 'Free-text explanation providing additional context for the cancellation or reduction decision. Captured from sales representative or advertiser communication. | Column cancellation_reason_notes (STRING) in sales.upfront_option_exercise']
  cancelled_amount decimal(18,2) [note: 'The dollar amount the advertiser cancelled or declined to commit for this option window. Calculated as original_committed_spend minus exercised_amount. | Column cancelled_amount (DECIMAL(18,2)) in sales.upfront_option_exercise']
  cancelled_grp_volume decimal(12,2) [note: 'The Gross Rating Point volume cancelled or declined for this option window. Calculated as committed_grp_volume minus exercised_grp_volume. | Column cancelled_grp_volume (DECIMAL(12,2)) in sales.upfront_option_exercise']
  committed_grp_volume decimal(12,2) [note: 'The Gross Rating Point volume originally committed for this option window. GRP is a standard audience measurement metric representing reach multiplied by frequency. | Column committed_grp_volume (DECIMAL(12,2)) in sales.upfront_option_exercise']
  contract_amendment_required_flag boolean [note: 'Indicates whether this option exercise triggers a formal contract amendment or addendum to the original upfront agreement. True for material changes that require legal documentation. | Column contract_amendment_required_flag (BOOLEAN) in sales.upfront_option_exercise']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.upfront_option_exercise']
  created_timestamp timestamp [note: 'The date and time when this option exercise record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.upfront_option_exercise']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this option exercise record (e.g., USD, GBP, EUR). | Column currency_code (STRING) in sales.upfront_option_exercise']
  daypart_allocation varchar [note: 'The broadcast daypart(s) allocated for this option window (e.g., Prime Time, Early Morning, Late Night, Weekend). Daypart is a time segment of the broadcast day used for scheduling and pricing. | Column daypart_allocation (STRING) in sales.upfront_option_exercise']
  digital_allocation_amount decimal(18,2) [note: 'The portion of the exercised amount allocated to digital platform inventory (web, mobile app, connected TV). | Column digital_allocation_amount (DECIMAL(18,2)) in sales.upfront_option_exercise']
  exercise_method varchar [note: 'The communication channel or method through which the advertiser submitted their option exercise decision (e.g., email notification, phone call, self-service portal, in-person meeting, automatic per contract terms). | Column exercise_method (STRING) in sales.upfront_option_exercise']
  exercise_status varchar [note: 'Current status of this option exercise. Confirmed means the advertiser exercised the full option amount; partially_confirmed means a reduced amount was exercised; cancelled means the option was declined; expired means the deadline passed without action; pending means the option window is open but not yet exercised. | Column exercise_status (STRING) in sales.upfront_option_exercise']
  exercised_amount decimal(18,2) [note: 'The dollar amount the advertiser confirmed and committed to spend for this option window. May equal original_committed_spend (full exercise) or be less (partial exercise). | Column exercised_amount (DECIMAL(18,2)) in sales.upfront_option_exercise']
  exercised_grp_volume decimal(12,2) [note: 'The Gross Rating Point volume the advertiser confirmed for this option window after exercise. May be less than committed_grp_volume if partially exercised. | Column exercised_grp_volume (DECIMAL(12,2)) in sales.upfront_option_exercise']
  inventory_release_date date [note: 'The date on which cancelled inventory from this option exercise was released to scatter market availability. Critical for scatter market inventory planning and sales. | Column inventory_release_date (DATE) in sales.upfront_option_exercise']
  inventory_released_flag boolean [note: 'Indicates whether the cancelled inventory from this option exercise has been released back to scatter market availability. True means inventory is available for scatter sales; False means it is still held or being reallocated. | Column inventory_released_flag (BOOLEAN) in sales.upfront_option_exercise']
  last_modified_timestamp timestamp [note: 'The date and time when this option exercise record was most recently updated. | Column last_modified_timestamp (TIMESTAMP) in sales.upfront_option_exercise']
  linear_allocation_amount decimal(18,2) [note: 'The portion of the exercised amount allocated to traditional linear (scheduled) television broadcast inventory. | Column linear_allocation_amount (DECIMAL(18,2)) in sales.upfront_option_exercise']
  notes varchar [note: 'General free-text notes and comments about this option exercise, including negotiation details, special terms, or follow-up actions required. | Column notes (STRING) in sales.upfront_option_exercise']
  option_deadline_date date [note: 'The contractual deadline date by which the advertiser must exercise this option window. Failure to exercise by this date may result in automatic cancellation or confirmation per contract terms. | Column option_deadline_date (DATE) in sales.upfront_option_exercise']
  option_exercise_date date [note: 'The date on which the advertiser exercised (confirmed or cancelled) this option window. This is the business event date when the decision was made. | Column option_exercise_date (DATE) in sales.upfront_option_exercise']
  option_exercise_number varchar [note: 'Business identifier for this option exercise event, typically formatted as commitment number plus option window sequence. | Column option_exercise_number (STRING) in sales.upfront_option_exercise']
  option_window_number varchar [note: 'Sequential number of the option window within the upfront commitment (e.g., 1 for first option, 2 for second option, 3 for third option). Upfront deals typically have multiple option dates where advertisers can confirm or cancel portions of their commitment. | Column option_window_number (INT) in sales.upfront_option_exercise']
  original_committed_spend decimal(18,2) [note: 'The original dollar amount committed for this option window at the time the upfront deal was signed. This is the baseline amount subject to the option exercise decision. | Column original_committed_spend (DECIMAL(18,2)) in sales.upfront_option_exercise']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.upfront_option_exercise']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.upfront_option_exercise']
  streaming_allocation_amount decimal(18,2) [note: 'The portion of the exercised amount allocated to Over-The-Top (OTT) streaming platform inventory (SVOD, AVOD, FAST channels). | Column streaming_allocation_amount (DECIMAL(18,2)) in sales.upfront_option_exercise']
  target_demographic varchar [note: 'The audience demographic segment this option window commitment was intended to reach (e.g., Adults 18-49, Women 25-54, Men 18-34). Standard Nielsen demographic notation. | Column target_demographic (STRING) in sales.upfront_option_exercise']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.upfront_option_exercise']

  Note: 'Records the exercise or cancellation of option windows within an upfront commitment, capturing the advertiser\'s decision to confirm, reduce, or cancel a portion of their advance commitment at each contractual option date. Captures upfront commitment reference, option window number, option exercise date, original committed spend for the window, exercised amount, cancelled amount, reason for cancellation, and resulting adjusted commitment. Critical for scatter market inventory release calculations — cancelled upfront options free inventory for scatter sales. | Unity Catalog table: media_broadcasting_ecm.sales.upfront_option_exercise Integrates with Wide Orbit (traffic) and Salesforce Media Cloud (sales CRM) for realistic demos.'
}

Table sales.forecast {
  forecast_id varchar [pk, note: 'Unique identifier for the revenue forecast record. | Column forecast_id (BIGINT) in sales.forecast']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Sales forecasts are segmented by daypart for revenue planning. Business process: daypart-level revenue forecasting, quota allocation, inventory yield optimization by daypart. | Column daypart_id (BIGINT) in scheduling.forecast']
  employee_id varchar [note: 'Identifier of the sales manager who approved this forecast submission. | Column employee_id (BIGINT) in workforce.forecast']
  prior_forecast_id varchar [note: 'Self-referencing FK on forecast (prior_forecast_id) | Column prior_forecast_id (BIGINT) in sales.forecast']
  sales_account_id varchar [note: 'Identifier of the account this forecast is associated with, if forecast is account-specific. | Column sales_account_id (BIGINT) in sales.forecast']
  sales_rep_id varchar [note: 'Identifier of the sales representative who submitted this forecast. | Column sales_rep_id (BIGINT) in sales.forecast']
  sales_territory_id varchar [note: 'Foreign key linking to sales.sales_territory. Business justification: Forecasts are often segmented by sales territory for territory-level revenue projections and quota tracking. This FK enables territory-based forecasting. N:1 relationship. New attribute needed to esta | Column sales_territory_id (BIGINT) in sales.forecast']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.forecast']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.forecast']
  account_segment varchar [note: 'Segmentation of the account type for this forecast: enterprise (large advertisers), mid-market, small business, agency (media buying agencies), direct (direct-to-advertiser). | Column account_segment (STRING) in sales.forecast']
  approval_timestamp timestamp [note: 'Timestamp when this forecast was approved by the sales manager. | Column approval_timestamp (TIMESTAMP) in sales.forecast']
  attainment_percentage decimal(5,2) [note: 'Percentage of quota represented by the total forecasted revenue (forecasted revenue / quota * 100). | Column attainment_percentage (DECIMAL(5,2)) in sales.forecast']
  best_case_revenue decimal(18,2) [note: 'Revenue amount in the best case forecast category (optimistic scenario including stretch opportunities). | Column best_case_revenue (DECIMAL(18,2)) in sales.forecast']
  broadcast_year varchar [note: 'Broadcast year (September to August cycle) this forecast applies to, represented as the starting calendar year. | Column broadcast_year (INT) in sales.forecast']
  carriage_revenue decimal(18,2) [note: 'Forecasted revenue from carriage fee agreements (distribution payments from cable/satellite providers). | Column carriage_revenue (DECIMAL(18,2)) in sales.forecast']
  closed_revenue decimal(18,2) [note: 'Revenue amount from deals already closed and won during this forecast period. | Column closed_revenue (DECIMAL(18,2)) in sales.forecast']
  commit_revenue decimal(18,2) [note: 'Revenue amount in the commit forecast category (high confidence deals expected to close). | Column commit_revenue (DECIMAL(18,2)) in sales.forecast']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.forecast']
  created_timestamp timestamp [note: 'Timestamp when this forecast record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.forecast']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this forecast. | Column currency_code (STRING) in sales.forecast']
  deal_type varchar [note: 'Type of sales deal being forecasted: upfront (advance commitment), scatter (last-minute inventory), licensing (content rights), syndication (content resale), carriage (distribution fee), sponsorship (branded integration). | Column deal_type (STRING) in sales.forecast']
  fiscal_quarter varchar [note: 'Fiscal quarter this forecast applies to (Q1, Q2, Q3, Q4). | Column fiscal_quarter (STRING) in sales.forecast']
  forecast_category varchar [note: 'Classification of the forecast confidence level: commit (high confidence), best case (optimistic), pipeline (possible), omitted (excluded from forecast), closed (already won). | Column forecast_category (STRING) in sales.forecast']
  forecast_name varchar [note: 'Descriptive name for the forecast record, typically including period and rep name. | Column forecast_name (STRING) in sales.forecast']
  forecast_number varchar [note: 'Business-readable unique identifier for the forecast submission. | Column forecast_number (STRING) in sales.forecast']
  forecast_status varchar [note: 'Current lifecycle status of the forecast record. | Column forecast_status (STRING) in sales.forecast']
  last_modified_timestamp timestamp [note: 'Timestamp when this forecast record was last modified. | Column last_modified_timestamp (TIMESTAMP) in sales.forecast']
  licensing_revenue decimal(18,2) [note: 'Forecasted revenue from content licensing deals (selling rights to broadcast or distribute content). | Column licensing_revenue (DECIMAL(18,2)) in sales.forecast']
  manager_override_amount decimal(18,2) [note: 'Revenue amount adjusted by sales manager override, used when manager believes rep forecast needs correction. | Column manager_override_amount (DECIMAL(18,2)) in sales.forecast']
  manager_override_reason varchar [note: 'Explanation provided by sales manager for any override adjustment to the forecast. | Column manager_override_reason (STRING) in sales.forecast']
  notes varchar [note: 'Free-text notes and commentary from the sales representative about assumptions, risks, or opportunities in this forecast. | Column notes (STRING) in sales.forecast']
  period_end_date date [note: 'End date of the time period this forecast covers. | Column period_end_date (DATE) in sales.forecast']
  period_start_date date [note: 'Start date of the time period this forecast covers. | Column period_start_date (DATE) in sales.forecast']
  period_type varchar [note: 'Time period granularity for this forecast: quarter, broadcast year (Sept-Aug), calendar year, or month. | Column period_type (STRING) in sales.forecast']
  pipeline_revenue decimal(18,2) [note: 'Revenue amount in the pipeline forecast category (possible deals still in early stages). | Column pipeline_revenue (DECIMAL(18,2)) in sales.forecast']
  quota_amount decimal(18,2) [note: 'Assigned sales quota target for this sales rep and period. | Column quota_amount (DECIMAL(18,2)) in sales.forecast']
  scatter_revenue decimal(18,2) [note: 'Forecasted revenue from scatter market deals (last-minute ad inventory sales outside upfront commitments). | Column scatter_revenue (DECIMAL(18,2)) in sales.forecast']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.forecast']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.forecast']
  submission_date date [note: 'Date when this forecast version was submitted by the sales representative. | Column submission_date (DATE) in sales.forecast']
  submission_timestamp timestamp [note: 'Precise timestamp when this forecast version was submitted. | Column submission_timestamp (TIMESTAMP) in sales.forecast']
  syndication_revenue decimal(18,2) [note: 'Forecasted revenue from syndication deals (reselling content to multiple outlets). | Column syndication_revenue (DECIMAL(18,2)) in sales.forecast']
  total_forecasted_revenue decimal(18,2) [note: 'Total projected revenue amount for this forecast period across all deal types and categories. | Column total_forecasted_revenue (DECIMAL(18,2)) in sales.forecast']
  update_frequency varchar [note: 'Expected frequency of forecast updates for this period: weekly (standard selling periods), daily (upfront season), monthly (long-range planning), ad hoc (as needed). | Column update_frequency (STRING) in sales.forecast']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.forecast']
  upfront_revenue decimal(18,2) [note: 'Forecasted revenue from upfront deals (advance advertising commitments made during upfront season). | Column upfront_revenue (DECIMAL(18,2)) in sales.forecast']
  variance_to_quota decimal(18,2) [note: 'Difference between total forecasted revenue and quota amount (positive indicates over-quota forecast, negative indicates gap). | Column variance_to_quota (DECIMAL(18,2)) in sales.forecast']
  version varchar [note: 'Version number of this forecast submission, incremented with each revision for the same period. | Column version (INT) in sales.forecast']
  weighted_pipeline_value decimal(18,2) [note: 'Total pipeline value adjusted by probability weights for each opportunity, providing a risk-adjusted forecast. | Column weighted_pipeline_value (DECIMAL(18,2)) in sales.forecast']

  Note: 'Revenue forecast record capturing projected bookings by sales rep, territory, account segment, deal type (upfront, scatter, licensing, syndication, carriage), and time period (quarter, broadcast year). Tracks forecast version, submission date, forecast category (commit, best case, pipeline, omitted), total forecasted revenue, weighted pipeline value, variance to quota, and manager override amount. Enables sales leadership to project revenue attainment against quota, identify pipeline gaps, and allocate resources. Updated weekly during active selling periods and daily during upfront season. | Unity Catalog table: media_broadcasting_ecm.sales.forecast Salesforce Media Cloud integration supported.'
}

Table sales.sales_deal_approval {
  sales_deal_approval_id varchar [pk, note: 'Unique identifier for the sales deal approval workflow record. | Column sales_deal_approval_id (BIGINT) in sales.sales_deal_approval']
  ad_sales_order_id varchar [note: 'Reference to the advertising sales order requiring approval. Used when the approval is triggered at the order stage rather than opportunity stage. | Column ad_sales_order_id (BIGINT) in sales.sales_deal_approval']
  carriage_deal_id varchar [note: 'Foreign key linking to sales.carriage_deal. Business justification: Carriage deals require approval due to their strategic importance and long-term nature. This FK enables tracking approval workflow for carriage deals. N:1 relationship. New attribute needed for approv | Column carriage_deal_id (BIGINT) in sales.sales_deal_approval']
  content_license_deal_id varchar [note: 'Foreign key linking to sales.content_license_deal. Business justification: Content license deals require approval due to rights complexity and deal value. This FK enables tracking approval workflow for license deals. N:1 relationship. New attribute needed for approval workfl | Column content_license_deal_id (BIGINT) in sales.sales_deal_approval']
  escalated_sales_deal_approval_id varchar [note: 'Self-referencing FK on sales_deal_approval (escalated_sales_deal_approval_id) | Column escalated_sales_deal_approval_id (BIGINT) in sales.sales_deal_approval']
  opportunity_id varchar [note: 'Reference to the sales opportunity requiring approval. Links to the opportunity being evaluated for non-standard terms or high-value thresholds. | Column opportunity_id (BIGINT) in sales.sales_deal_approval']
  primary_sales_employee_id varchar [note: 'Unique identifier of the user assigned to review and approve this deal. Links to the employee or user record in the system. | Column primary_sales_employee_id (BIGINT) in workforce.sales_deal_approval']
  sales_proposal_id varchar [note: 'Foreign key linking to sales.sales_proposal. Business justification: Proposals may require approval before being sent to clients, especially for non-standard pricing or terms. This FK enables tracking approval workflow for proposals. N:1 relationship. New attribute nee | Column sales_proposal_id (BIGINT) in sales.sales_deal_approval']
  sales_scatter_order_id varchar [note: 'Foreign key linking to sales.sales_scatter_order. Business justification: Scatter orders may require approval when they involve non-standard pricing, extended payment terms, or high-value deals. This FK enables tracking approval workflow for scatter orders. N:1 relationship | Column sales_scatter_order_id (BIGINT) in sales.sales_deal_approval']
  sales_syndication_deal_id varchar [note: 'Reference to the syndication deal requiring approval. Used for content licensing and syndication agreements that exceed standard authority levels. | Column sales_syndication_deal_id (BIGINT) in sales.sales_deal_approval']
  tertiary_quinary_sales_last_modified_by_user_employee_id varchar [note: 'Identifier of the user who last modified the approval record. Tracks who made the most recent update for audit and accountability purposes. | Column quinary_sales_last_modified_by_user_employee_id (BIGINT) in workforce.sales_deal_approval']
  tertiary_sales_submitted_by_user_employee_id varchar [note: 'Identifier of the sales representative or user who submitted the deal for approval. Tracks originator for accountability and commission purposes. | Column tertiary_sales_submitted_by_user_employee_id (BIGINT) in workforce.sales_deal_approval']
  upfront_commitment_id varchar [note: 'Foreign key linking to sales.upfront_commitment. Business justification: Upfront commitments typically require approval due to their high value and multi-year nature. This FK enables tracking approval workflow for upfront commitments. N:1 relationship. New attribute needed | Column upfront_commitment_id (BIGINT) in sales.sales_deal_approval']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sales_deal_approval']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sales_deal_approval']
  approval_conditions varchar [note: 'Specific conditions, stipulations, or requirements attached to the approval. May include contingencies such as legal review, credit check, or contract amendments that must be satisfied before execution. | Column approval_conditions (STRING) in sales.sales_deal_approval']
  approval_decision_timestamp timestamp [note: 'Date and time when the approver made their decision (approved, rejected, or escalated). Used to calculate approval cycle time and SLA compliance. | Column approval_decision_timestamp (TIMESTAMP) in sales.sales_deal_approval']
  approval_expiry_timestamp timestamp [note: 'Date and time by which the approval decision must be made. If no decision is rendered by this time, the approval may auto-escalate or expire. | Column approval_expiry_timestamp (TIMESTAMP) in sales.sales_deal_approval']
  approval_notes varchar [note: 'Free-text comments and observations recorded by the approver during the review process. Captures context, concerns, or additional instructions. | Column approval_notes (STRING) in sales.sales_deal_approval']
  approval_number varchar [note: 'Business identifier for the approval workflow instance. Format: APV-YYYYMMDD followed by sequence number for tracking and audit purposes. | Column approval_number (STRING) in sales.sales_deal_approval']
  approval_status varchar [note: 'Current state of the approval workflow. Tracks progression from submission through final decision or escalation to higher authority. | Column approval_status (STRING) in sales.sales_deal_approval']
  approval_tier varchar [note: 'Hierarchical approval level triggered by deal characteristics. Higher tiers required for larger values, extended terms, or non-standard conditions. | Column approval_tier (STRING) in sales.sales_deal_approval']
  approval_trigger_reason varchar [note: 'Business justification for why this deal requires management approval. May include multiple reasons such as value threshold exceeded, below-floor pricing, extended payment terms, custom barter arrangement, or non-standard cancellation options. | Column approval_trigger_reason (STRING) in sales.sales_deal_approval']
  approver_email varchar [note: 'Email address of the approver for notification and communication regarding the approval request. | Column approver_email (STRING) in sales.sales_deal_approval']
  approver_name varchar [note: 'Full name of the individual assigned to approve this deal. Captured for audit trail and reporting purposes. | Column approver_name (STRING) in sales.sales_deal_approval']
  approver_role varchar [note: 'Functional role or title of the individual authorized to approve at this tier. Examples: Sales Manager, Finance Director, VP Sales, CFO. | Column approver_role (STRING) in sales.sales_deal_approval']
  below_floor_pricing_flag boolean [note: 'Indicates whether the negotiated rate falls below the established rate card floor, requiring pricing exception approval. | Column below_floor_pricing_flag (BOOLEAN) in sales.sales_deal_approval']
  compliance_review_required_flag boolean [note: 'Indicates whether the deal requires compliance review for regulatory adherence, political advertising rules, or industry standards compliance. | Column compliance_review_required_flag (BOOLEAN) in sales.sales_deal_approval']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sales_deal_approval']
  created_timestamp timestamp [note: 'Date and time when the approval workflow record was first created in the system. Marks the initiation of the approval process. | Column created_timestamp (TIMESTAMP) in sales.sales_deal_approval']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the deal value amount. Ensures proper financial evaluation across multi-currency operations. | Column currency_code (STRING) in sales.sales_deal_approval']
  custom_barter_arrangement_flag boolean [note: 'Indicates whether the deal involves non-cash barter or trade arrangements requiring special approval and valuation review. | Column custom_barter_arrangement_flag (BOOLEAN) in sales.sales_deal_approval']
  deal_type varchar [note: 'Classification of the commercial deal requiring approval. Determines which approval tier and rules apply based on deal structure and risk profile. [ENUM-REF-CANDIDATE: upfront|scatter|syndication|sponsorship|barter|digital|streaming|linear — 8 candidates stripped; promote to reference product] | Column deal_type (STRING) in sales.sales_deal_approval']
  deal_value_amount decimal(18,2) [note: 'Total monetary value of the deal requiring approval. Used to determine appropriate approval tier based on value thresholds. | Column deal_value_amount (DECIMAL(18,2)) in sales.sales_deal_approval']
  escalated_to_tier varchar [note: 'The higher approval tier to which this request has been escalated. Tracks the escalation path through the approval hierarchy. | Column escalated_to_tier (STRING) in sales.sales_deal_approval']
  escalation_reason varchar [note: 'Justification for escalating the approval to a higher tier. Documents why the current approver is unable or unwilling to make the decision at their level. | Column escalation_reason (STRING) in sales.sales_deal_approval']
  extended_payment_terms_flag boolean [note: 'Indicates whether the deal includes payment terms that exceed standard credit policy, requiring finance approval. | Column extended_payment_terms_flag (BOOLEAN) in sales.sales_deal_approval']
  finance_review_required_flag boolean [note: 'Indicates whether the deal requires finance department review for credit risk, revenue recognition, or payment terms validation. | Column finance_review_required_flag (BOOLEAN) in sales.sales_deal_approval']
  last_modified_timestamp timestamp [note: 'Date and time when the approval record was last updated. Tracks changes to status, approver assignments, or conditions throughout the workflow lifecycle. | Column last_modified_timestamp (TIMESTAMP) in sales.sales_deal_approval']
  legal_review_required_flag boolean [note: 'Indicates whether the deal requires legal department review before final approval. Triggered by contract complexity, liability concerns, or regulatory considerations. | Column legal_review_required_flag (BOOLEAN) in sales.sales_deal_approval']
  non_standard_cancellation_flag boolean [note: 'Indicates whether the deal includes cancellation options or terms that deviate from standard contract provisions. | Column non_standard_cancellation_flag (BOOLEAN) in sales.sales_deal_approval']
  rejection_reason varchar [note: 'Detailed explanation provided by the approver when rejecting the deal. Captures business rationale for denial to inform sales team and support future negotiations. | Column rejection_reason (STRING) in sales.sales_deal_approval']
  sla_met_flag boolean [note: 'Indicates whether the approval decision was made within the target SLA timeframe. Used for performance monitoring and process improvement. | Column sla_met_flag (BOOLEAN) in sales.sales_deal_approval']
  sla_target_hours varchar [note: 'Target number of hours within which the approval decision should be made. Defines the expected response time for this approval tier. | Column sla_target_hours (INT) in sales.sales_deal_approval']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sales_deal_approval']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sales_deal_approval']
  submitted_timestamp timestamp [note: 'Date and time when the approval request was submitted into the workflow. Marks the start of the approval cycle for SLA tracking. | Column submitted_timestamp (TIMESTAMP) in sales.sales_deal_approval']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sales_deal_approval']
  value_threshold_exceeded_flag boolean [note: 'Indicates whether the deal value exceeds the sales representative\'s approval authority limit, triggering escalation to management. | Column value_threshold_exceeded_flag (BOOLEAN) in sales.sales_deal_approval']

  Note: 'Workflow record capturing the approval chain and sign-off status for high-value or non-standard commercial deals requiring management, legal, or finance authorization before execution. Tracks deal reference (opportunity or order), approval tier triggered (value threshold, non-standard terms, extended payment, below-floor pricing), approver role, approver identity, approval status (pending, approved, rejected, escalated), approval timestamp, conditions attached, and delegation rules. Critical for deals exceeding rate card floors, extended cancellation options, or custom barter arrangements. | Unity Catalog table: media_broadcasting_ecm.sales.sales_deal_approval Integrates with Wide Orbit (traffic) and Salesforce Media Cloud (sales CRM) for realistic demos.'
}

Table sales.proposal_distribution {
  proposal_distribution_id varchar [pk, note: 'Unique identifier for this proposal distribution record. Primary key. | Column proposal_distribution_id (BIGINT) in sales.proposal_distribution']
  primary_proposal_sales_proposal_id varchar [note: 'Foreign key linking to the sales proposal that was distributed to the contact. | Column primary_proposal_sales_proposal_id (BIGINT) in sales.proposal_distribution']
  proposal_contact_sales_contact_id varchar [note: 'Foreign key linking to the sales contact who received the proposal. | Column contact_sales_contact_id (BIGINT) in sales.proposal_distribution']
  proposal_id varchar [note: 'Reference to the proposal being distributed']
  proposal_sales_contact_id varchar [note: 'Foreign key to the sales contact who received the proposal. | Column sales_contact_id (BIGINT) in sales.proposal_distribution']
  sent_by_employee_id varchar [note: 'FK to employee who sent the distribution']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.proposal_distribution']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.proposal_distribution']
  attachment_count varchar [note: 'Number of attachments included']
  attachment_names varchar [note: 'Names of attached files']
  bounce_reason varchar [note: 'Reason for delivery bounce if applicable']
  cc_recipients varchar [note: 'CC recipients list']
  click_count varchar [note: 'Number of clicks on proposal links']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.proposal_distribution']
  created_timestamp timestamp [note: 'Record creation timestamp']
  delivery_status varchar [note: 'Status of delivery (sent, delivered, bounced)']
  delivery_timestamp timestamp [note: 'Timestamp when delivery was confirmed']
  distribution_date date
  distribution_method varchar [note: 'Method of distribution (email, portal, print)']
  download_count varchar [note: 'Number of times proposal was downloaded']
  expiration_date date [note: 'Date when proposal link expires']
  feedback_notes varchar [note: 'Free-text notes capturing the contacts specific feedback, questions, objections, or comments about the proposal. Used for proposal refinement and competitive intelligence. | Column feedback_notes (STRING) in sales.proposal_distribution']
  last_viewed_timestamp timestamp [note: 'Last time proposal was viewed']
  notes varchar
  opened_at timestamp
  opened_flag boolean [note: 'Indicates whether this contact has opened or viewed the proposal materials. Tracked via email tracking pixels or document management system access logs. | Column opened_flag (BOOLEAN) in sales.proposal_distribution']
  opened_timestamp timestamp [note: 'Timestamp of the first time this contact opened or accessed the proposal. Null if never opened. Used for engagement scoring and follow-up prioritization. | Column opened_timestamp (TIMESTAMP) in sales.proposal_distribution']
  recipient_company varchar
  recipient_email varchar [note: 'Email address of recipient']
  recipient_name varchar [note: 'Name of recipient']
  recipient_type varchar [note: 'Role of the contact in receiving this proposal: primary recipient, carbon copy, blind carbon copy, internal reviewer, or approver. Determines routing and notification behavior. | Column recipient_type (STRING) in sales.proposal_distribution']
  response_date date [note: 'Date when this contact provided formal feedback or response to the proposal. Null if no response received. Used for conversion tracking and sales cycle analysis. | Column response_date (DATE) in sales.proposal_distribution']
  response_type varchar [note: 'Classification of the contacts response to the proposal: accepted, rejected, revision requested, questions raised, or no response. Drives workflow routing and follow-up actions. | Column response_type (STRING) in sales.proposal_distribution']
  sent_date timestamp [note: 'Timestamp when the proposal was sent or distributed to this specific contact. Used for tracking response time and follow-up scheduling. | Column sent_date (TIMESTAMP) in sales.proposal_distribution']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.proposal_distribution']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.proposal_distribution']
  time_spent_seconds varchar [note: 'Time spent viewing the proposal']
  tracking_code varchar [note: 'Unique tracking identifier']
  tracking_token varchar [note: 'Unique tracking token for analytics']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.proposal_distribution']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  view_count varchar [note: 'Number of times proposal was viewed']

  Note: 'This association product represents the distribution event between sales_proposal and sales_contact. It captures the operational tracking of which contacts received which proposals, their engagement with the proposal materials, and their responses. Each record links one sales_proposal to one sales_contact with attributes that exist only in the context of this distribution relationship.. Existence Justification: In media broadcasting sales operations, a single proposal is routinely distributed to multiple contacts within an advertiser organization and agency (e.g., media buyer, brand manager, legal counsel, CFO for approval), and each contact receives and responds to multiple proposals over time. The business actively manages proposal distribution as an operational process with engagement tracking (who opened it, when, what feedback they provided) to prioritize follow-ups and refine proposals. This is not an analytical correlation but a core sales workflow that humans create, update, and query. | Unity Catalog table: media_broadcasting_ecm.sales.proposal_distribution Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.facility_service_agreement {
  facility_service_agreement_id varchar [pk, note: 'Unique identifier for the facility service agreement record. Primary key for the association. | Column facility_service_agreement_id (BIGINT) in sales.facility_service_agreement']
  broadcast_facility_id varchar [note: 'Foreign key linking to the broadcast facility where services are being provided. Identifies the physical infrastructure location (studio, transmission site, uplink center, or NOC) covered by the service agreement. | Column broadcast_facility_id (BIGINT) in technology.facility_service_agreement']
  rep_id varchar [note: 'Reference to the sales representative or account executive responsible for managing this facility service agreement. This is the person who negotiated the contract and handles renewals, amendments, and account relationship for this specific facility service. | Column rep_id (BIGINT) in sales.facility_service_agreement']
  sales_account_id varchar [note: 'Foreign key linking to the sales account that has contracted for facility services. Identifies the commercial entity (agency, advertiser, licensee, or partner) in the service agreement. | Column sales_account_id (BIGINT) in sales.facility_service_agreement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.facility_service_agreement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.facility_service_agreement']
  agreement_status varchar [note: 'Current lifecycle status of the facility service agreement. Draft indicates negotiation in progress, active indicates services are being provided, suspended indicates temporary hold, expired indicates contract period ended, terminated indicates early cancellation, renewed indicates contract was extended. | Column agreement_status (STRING) in sales.facility_service_agreement']
  billing_frequency varchar [note: 'The cadence at which the sales account is invoiced for facility services under this agreement. Defines whether billing occurs monthly (most common for ongoing services), quarterly (for larger contracts), annually (for full facility leases), per-use (for ad-hoc studio rentals), or at milestones (for project-based services). | Column billing_frequency (STRING) in sales.facility_service_agreement']
  contracted_capacity varchar [note: 'The amount or extent of facility capacity allocated to this sales account under the agreement. Format varies by service type: hours per month for studio rental, bandwidth allocation for transmission, rack units for colocation, percentage of facility for full lease. This defines the resource commitment. | Column contracted_capacity (STRING) in sales.facility_service_agreement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.facility_service_agreement']
  created_date timestamp [note: 'Timestamp when this facility service agreement record was first created in the system. Used for audit trail and contract lifecycle tracking. | Column created_date (TIMESTAMP) in sales.facility_service_agreement']
  effective_end_date date [note: 'The date when this facility service agreement expires or is terminated. After this date, the sales account no longer has contracted access to the facility services unless the agreement is renewed. Null indicates an open-ended or evergreen agreement. | Column effective_end_date (DATE) in sales.facility_service_agreement']
  effective_start_date date [note: 'The date when this facility service agreement becomes active and the sales account gains access to the contracted facility services. Marks the beginning of the contract period and the start of billing. | Column effective_start_date (DATE) in sales.facility_service_agreement']
  last_modified_date timestamp [note: 'Timestamp when this facility service agreement record was last updated. Tracks changes to contract terms, capacity allocations, or status changes. | Column last_modified_date (TIMESTAMP) in sales.facility_service_agreement']
  rate_card_reference varchar [note: 'Reference identifier to the pricing rate card or pricing schedule that governs billing for this service agreement. Links to the commercial pricing structure negotiated for this account-facility combination, which may differ from standard rates based on volume commitments or strategic relationship. | Column rate_card_reference (STRING) in sales.facility_service_agreement']
  service_type varchar [note: 'Classification of the service being provided under this agreement. Defines what type of facility access or service the sales account has contracted for (e.g., studio rental for production, transmission services for broadcast distribution, uplink services for satellite feeds, colocation for equipment hosting, managed services for technical operations, or full facility lease). | Column service_type (STRING) in sales.facility_service_agreement']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.facility_service_agreement']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.facility_service_agreement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.facility_service_agreement']

  Note: 'This association product represents the contractual service agreement between a sales account and a broadcast facility. It captures the commercial terms under which a sales account (advertising agency, direct advertiser, content licensee, or distribution partner) contracts for services at a specific broadcast facility (studio, transmission site, uplink center, or NOC). Each record links one sales account to one broadcast facility with attributes that define the service type, capacity allocation, pricing, and contract lifecycle dates that exist only in the context of this commercial relationship.. Existence Justification: In media broadcasting operations, large sales accounts (networks, station groups, advertising agencies, content licensees) routinely contract for services across multiple broadcast facilities simultaneously—a major advertiser may need studio access at multiple production facilities, transmission services at regional sites, and uplink capacity at satellite centers. Conversely, each broadcast facility serves multiple sales accounts concurrently, with different service types, capacity allocations, and commercial terms per account. The business actively manages these facility service agreements as distinct commercial contracts with lifecycle tracking, capacity management, and account-specific pricing. | Unity Catalog table: media_broadcasting_ecm.sales.facility_service_agreement Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.campaign_funding {
  campaign_funding_id varchar [pk, note: 'Unique identifier for this campaign funding allocation record. Primary key. | Column campaign_funding_id (BIGINT) in sales.campaign_funding']
  campaign_id varchar [note: 'Foreign key linking to the advertising campaign being funded by this opportunity allocation | Column campaign_id (BIGINT) in sales.campaign_funding']
  opportunity_id varchar [note: 'Foreign key linking to the sales opportunity providing funding for this campaign | Column opportunity_id (BIGINT) in sales.campaign_funding']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.campaign_funding']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.campaign_funding']
  allocation_amount decimal(18,2) [note: 'The dollar amount from this opportunity allocated to fund this specific campaign. Sum of all allocation_amounts for an opportunity should not exceed the opportunity\'s estimated_value. | Column allocation_amount (DECIMAL(18,2)) in sales.campaign_funding']
  allocation_percentage decimal(5,2) [note: 'The percentage of the opportunity\'s total estimated value allocated to this campaign. Used for portfolio buys and umbrella deals where a single opportunity funds multiple campaigns. | Column allocation_percentage (DECIMAL(5,2)) in sales.campaign_funding']
  campaign_funding_status varchar [note: 'Current status of this funding allocation. Proposed = opportunity not yet closed, Committed = opportunity closed-won and funding committed, Active = campaign is running with this funding, Completed = flight dates passed, Cancelled = allocation removed. | Column campaign_funding_status (STRING) in sales.campaign_funding']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.campaign_funding']
  created_timestamp timestamp [note: 'Timestamp when this funding allocation record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.campaign_funding']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the allocation_amount. Typically matches both the opportunity and campaign currency codes. | Column currency_code (STRING) in sales.campaign_funding']
  flight_end_date date [note: 'The end date for this specific opportunity-campaign allocation. May differ from the campaign\'s overall end date if the opportunity only funds a portion of the campaign\'s flight window. | Column flight_end_date (DATE) in sales.campaign_funding']
  flight_start_date date [note: 'The start date for this specific opportunity-campaign allocation. May differ from the campaign\'s overall start date if the opportunity only funds a portion of the campaign\'s flight window. | Column flight_start_date (DATE) in sales.campaign_funding']
  modified_timestamp timestamp [note: 'Timestamp when this funding allocation record was last modified. | Column modified_timestamp (TIMESTAMP) in sales.campaign_funding']
  notes varchar [note: 'Free-form text field for additional context about this funding allocation, such as special terms, budget source details, or reconciliation notes. | Column notes (STRING) in sales.campaign_funding']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.campaign_funding']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.campaign_funding']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.campaign_funding']

  Note: 'This association product represents the funding relationship between sales opportunities and advertising campaigns in media broadcasting. It captures how opportunity pipeline deals are allocated to fund specific campaigns, tracking the portion of each opportunity\'s budget committed to each campaign. Each record links one opportunity to one campaign with allocation amounts, percentages, flight dates, and funding status that exist only in the context of this relationship. Critical for revenue recognition, upfront commitment tracking, and reconciling sales pipeline to campaign delivery.. Existence Justification: In media broadcasting sales operations, large advertisers frequently split a single campaign across multiple sales opportunities representing different budget sources, quarters, or sales representatives. Conversely, umbrella deals and portfolio buys result in a single opportunity funding portions of multiple campaigns. Sales teams actively manage these funding allocations during upfront negotiations, tracking allocation amounts, percentages, and flight date ranges for each opportunity-campaign pairing. | Unity Catalog table: media_broadcasting_ecm.sales.campaign_funding Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.brand {
  brand_id varchar [pk, note: 'Primary key for brand | Column brand_id (BIGINT) in sales.brand']
  parent_brand_id varchar [note: 'Reference to the parent brand in a brand hierarchy. Used for sub-brands, regional variants, or digital extensions of a master brand. Null for top-level brands. | Column parent_brand_id (BIGINT) in sales.brand']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.brand']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.brand']
  brand_code varchar [note: 'Short alphanumeric code used as a unique business identifier for the brand in sales systems, rate cards, and trafficking systems. Typically 3-10 uppercase characters. | Column brand_code (STRING) in sales.brand']
  brand_description varchar [note: 'Detailed narrative description of the brand, its positioning, audience, and content offering. Used in sales proposals, syndication packages, and agency presentations. | Column brand_description (STRING) in sales.brand']
  brand_name varchar [note: 'The official name of the brand as recognized in the market and used in advertising sales, content licensing, and syndication deals. | Column brand_name (STRING) in sales.brand']
  brand_status varchar [note: 'Current lifecycle status of the brand. Active brands are available for sales and trafficking; inactive brands are no longer sold; pending brands are in setup; retired brands are archived; suspended brands are temporarily unavailable. | Column status (STRING) in sales.brand']
  brand_type varchar [note: 'Classification of the brand by its primary distribution or business model: network (broadcast network), station (local affiliate), digital_platform (online property), streaming_service (SVOD/AVOD), syndication (content distributor), or studio (production house). | Column brand_type (STRING) in sales.brand']
  call_sign varchar [note: 'The FCC-assigned call sign for broadcast stations (e.g., WABC-TV, KNBC). Null for non-broadcast brands. | Column call_sign (STRING) in sales.brand']
  content_genre varchar [note: 'The primary content genre or programming category associated with the brand. Used for content licensing, syndication categorization, and advertiser alignment. | Column content_genre (STRING) in sales.brand']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.brand']
  created_timestamp timestamp [note: 'The timestamp when this brand record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in sales.brand']
  distribution_channel varchar [note: 'The primary distribution channel through which the brand delivers content to audiences. | Column distribution_channel (STRING) in sales.brand']
  dma_code varchar [note: 'The Nielsen Designated Market Area code representing the geographic television market. Used for local advertising sales and market-specific rate cards. | Column dma_code (STRING) in sales.brand']
  is_ad_supported boolean [note: 'Indicates whether the brand carries advertising inventory. True for ad-supported brands (AVOD, linear TV); false for subscription-only or ad-free brands (SVOD). | Column is_ad_supported (BOOLEAN) in sales.brand']
  is_subscription_based boolean [note: 'Indicates whether the brand operates on a subscription revenue model (SVOD, cable subscription). Used to distinguish revenue streams in sales reporting. | Column is_subscription_based (BOOLEAN) in sales.brand']
  is_syndication_eligible boolean [note: 'Indicates whether the brand is eligible for content syndication deals. True if the brand can license content to third-party distributors; false otherwise. | Column is_syndication_eligible (BOOLEAN) in sales.brand']
  launch_date date [note: 'The date the brand was officially launched or made available for commercial sales and distribution. | Column launch_date (DATE) in sales.brand']
  logo_url varchar [note: 'URL to the official brand logo asset. Used in sales proposals, rate cards, and advertising creative materials. | Column brand_logo_url (STRING) in sales.brand']
  nielsen_station_code varchar [note: 'The unique station or network code assigned by Nielsen for audience measurement and ratings reporting. Critical for upfront commitments and post-campaign analysis. | Column nielsen_station_code (STRING) in sales.brand']
  notes varchar [note: 'Free-form text field for additional notes, comments, or special instructions related to the brand. Used by sales teams for context and deal-specific information. | Column notes (STRING) in sales.brand']
  owner varchar [note: 'The legal entity or corporate parent that owns the brand. Used for rights management, licensing, and syndication agreements. | Column brand_owner (STRING) in sales.brand']
  primary_market varchar [note: 'The primary geographic market or country where the brand operates, represented as a 3-letter ISO country code (e.g., USA, CAN, GBR). | Column primary_market (STRING) in sales.brand']
  programmatic_enabled boolean [note: 'Indicates whether the brand supports programmatic advertising sales through automated buying platforms and real-time bidding (RTB). | Column programmatic_enabled (BOOLEAN) in sales.brand']
  retirement_date date [note: 'The date the brand was retired or discontinued from active sales and distribution. Null for active brands. | Column retirement_date (DATE) in sales.brand']
  sales_contact_email varchar [note: 'Primary email address for sales inquiries and agency outreach for this brand. Organizational contact data classified as confidential. | Column sales_contact_email (STRING) in sales.brand']
  sales_contact_phone varchar [note: 'Primary phone number for sales inquiries and agency outreach for this brand. Organizational contact data classified as confidential. | Column sales_contact_phone (STRING) in sales.brand']
  salesforce_account_code varchar [note: 'The unique Salesforce Account ID linking this brand to the Salesforce Media Cloud CRM system. Used for opportunity tracking, pipeline management, and sales contract association. | Column salesforce_account_code (STRING) in sales.brand']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.brand']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.brand']
  tagline varchar [note: 'The official marketing tagline or slogan associated with the brand. Used in advertising creative and promotional materials. | Column brand_tagline (STRING) in sales.brand']
  target_audience varchar [note: 'The primary demographic or psychographic audience segment the brand targets (e.g., Adults 18-49, Kids 2-11, Upscale Millennials). Used for advertising sales targeting and rate card positioning. | Column target_audience (STRING) in sales.brand']
  tier varchar [note: 'The commercial tier or positioning of the brand in the sales hierarchy. Premium brands command higher CPM rates; value brands offer lower-cost inventory. | Column brand_tier (STRING) in sales.brand']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.brand']
  updated_by varchar [note: 'The username or identifier of the user who last updated this brand record. Used for audit trail and accountability. | Column updated_by (STRING) in sales.brand']
  updated_timestamp timestamp [note: 'The timestamp when this brand record was last modified. Used for audit trail, change tracking, and data synchronization. | Column updated_timestamp (TIMESTAMP) in sales.brand']
  upfront_participation boolean [note: 'Indicates whether the brand participates in the annual upfront advertising sales market. True for brands that sell inventory in upfront commitments; false for scatter-only brands. | Column upfront_participation (BOOLEAN) in sales.brand']
  website_url varchar [note: 'The primary website URL for the brand. Used for digital advertising integration, content syndication links, and agency reference. | Column brand_website_url (STRING) in sales.brand']

  Note: 'Master reference table for brand. Referenced by brand_id. | Unity Catalog table: media_broadcasting_ecm.sales.brand Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.sales_team {
  sales_team_id varchar [pk, note: 'Primary key for sales_team | Column sales_team_id (BIGINT) in sales.sales_team']
  employee_id varchar [note: 'Identifier of the sales manager or director who leads this sales team. | Column employee_id (BIGINT) in workforce.sales_team']
  parent_sales_team_id varchar [note: 'Identifier of the parent sales team if this team is part of a hierarchical sales organization structure. Null for top-level teams. | Column parent_team_id (BIGINT) in sales.sales_team']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sales_team']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sales_team']
  channel_focus varchar [note: 'The distribution channel or platform this sales team primarily sells inventory or content for. | Column channel_focus (STRING) in sales.sales_team']
  commission_structure varchar [note: 'The commission or incentive structure applied to this sales team (e.g., flat rate per deal, tiered based on quota attainment, revenue share percentage). | Column commission_structure (STRING) in sales.sales_team']
  contact_email varchar [note: 'Primary email address for contacting the sales team or team manager. | Column contact_email (STRING) in sales.sales_team']
  contact_phone varchar [note: 'Primary phone number for reaching the sales team or team manager. | Column contact_phone (STRING) in sales.sales_team']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sales_team']
  created_timestamp timestamp [note: 'Timestamp when this sales team record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.sales_team']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the quota and revenue targets (e.g., USD, GBP, EUR). | Column currency_code (STRING) in sales.sales_team']
  effective_end_date date [note: 'Date when this sales team was dissolved, merged, or became inactive. Null for currently active teams. | Column effective_end_date (DATE) in sales.sales_team']
  effective_start_date date [note: 'Date when this sales team was established or became active in the organization. | Column effective_start_date (DATE) in sales.sales_team']
  market_segment varchar [note: 'The market segment or customer category this sales team focuses on (e.g., local advertisers, national agencies, direct clients, programmatic buyers). | Column market_segment (STRING) in sales.sales_team']
  notes varchar [note: 'Free-form notes or comments about the sales team, including special responsibilities, strategic focus areas, or organizational context. | Column notes (STRING) in sales.sales_team']
  office_location varchar [note: 'Primary office location or city where this sales team is based (e.g., New York, Los Angeles, Chicago). | Column office_location (STRING) in sales.sales_team']
  product_focus varchar [note: 'Primary product or content type this sales team specializes in selling (e.g., linear TV spots, streaming inventory, sports programming, news sponsorships). | Column product_focus (STRING) in sales.sales_team']
  quota_amount decimal(18,2) [note: 'The revenue or sales target assigned to this team for the current fiscal period, expressed in the base currency. | Column quota_amount (DECIMAL(18,2)) in sales.sales_team']
  quota_period varchar [note: 'The time period over which the sales quota is measured (e.g., monthly, quarterly, annual, upfront season). | Column quota_period (STRING) in sales.sales_team']
  region varchar [note: 'Geographic region or market territory assigned to this sales team (e.g., Northeast, West Coast, National, International). | Column region (STRING) in sales.sales_team']
  sales_team_status varchar [note: 'Current operational status of the sales team indicating whether it is actively selling, temporarily suspended, or undergoing organizational changes. | Column status (STRING) in sales.sales_team']
  salesforce_team_code varchar [note: 'External identifier for this sales team in Salesforce Media Cloud, used for integration and synchronization. | Column salesforce_team_code (STRING) in sales.sales_team']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sales_team']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sales_team']
  team_code varchar [note: 'Short alphanumeric code used to identify the sales team in systems and reports (e.g., ECAS, NSYN, DSW). | Column team_code (STRING) in sales.sales_team']
  team_name varchar [note: 'Official name of the sales team (e.g., East Coast Advertising Sales, National Syndication Team, Digital Sales West). | Column team_name (STRING) in sales.sales_team']
  team_size varchar [note: 'Number of active sales representatives or account executives currently assigned to this team. | Column team_size (INT) in sales.sales_team']
  team_type varchar [note: 'Classification of the sales team based on the primary revenue stream or sales function they manage. | Column team_type (STRING) in sales.sales_team']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sales_team']
  updated_timestamp timestamp [note: 'Timestamp when this sales team record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in sales.sales_team']

  Note: 'Master reference table for sales_team. Referenced by sales_team_id. | Unity Catalog table: media_broadcasting_ecm.sales.sales_team Integrates with Wide Orbit (traffic) and Salesforce Media Cloud (sales CRM) for realistic demos.'
}

Table sales.sales_product {
  sales_product_id varchar [pk, note: 'Primary key for product | Column product_id (BIGINT) in sales.product']
  billing_product_id varchar [note: 'FK to billing product for invoicing SKU linkage | Column billing_product_id (BIGINT) in billing.product']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.product']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.product']
  audience_demographic varchar [note: 'Target audience demographic profile for the product (e.g., Adults 18-49, Women 25-54). | Column audience_demographic (STRING) in sales.product']
  available_from_date date [note: 'Date when this product becomes available for sale and booking. | Column available_from_date (DATE) in sales.product']
  available_until_date date [note: 'Date when this product is no longer available for sale, applicable to seasonal or limited-time offerings. | Column available_until_date (DATE) in sales.product']
  base_rate decimal(18,2) [note: 'Standard list price for one unit of the product before discounts, premiums, or negotiated adjustments. | Column base_rate (DECIMAL(18,2)) in sales.product']
  commission_rate decimal(5,2) [note: 'Standard commission percentage paid to sales representatives or agencies on sales of this product. | Column commission_rate (DECIMAL(5,2)) in sales.product']
  content_rating varchar [note: 'Age-appropriateness or content rating associated with the programming or content (e.g., TV-PG, TV-14, TV-MA). | Column content_rating (STRING) in sales.product']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.product']
  created_timestamp timestamp [note: 'Timestamp when this product record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.product']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the base rate and pricing. | Column currency_code (STRING) in sales.product']
  daypart varchar [note: 'Broadcast daypart or time segment when the product is available (e.g., Prime Time, Early Morning, Late Night). | Column daypart (STRING) in sales.product']
  domain_verified_flag boolean [note: 'Flag indicating this product belongs to the verified 17-domain structure']
  duration_seconds varchar [note: 'Length of the advertising spot or content segment in seconds, applicable to time-based media products. | Column duration_seconds (INT) in sales.product']
  effective_date date [note: 'Date when the current version of this product definition became effective, used for rate card versioning and historical tracking. | Column effective_date (DATE) in sales.product']
  estimated_reach varchar [note: 'Projected number of unique viewers, listeners, or users reached by one unit of this product. | Column estimated_reach (BIGINT) in sales.product']
  expiration_date date [note: 'Date when the current version of this product definition expires and is superseded by a new version. | Column expiration_date (DATE) in sales.product']
  genre varchar [note: 'Genre or category of the content associated with this product (e.g., News, Sports, Drama, Comedy). | Column genre (STRING) in sales.product']
  geographic_market varchar [note: 'Geographic market or designated market area (DMA) where the product is available for sale. | Column geographic_market (STRING) in sales.product']
  inventory_type varchar [note: 'Classification of inventory availability and priority: guaranteed delivery, preemptible by higher-value bookings, remnant unsold inventory, or programmatically traded. | Column inventory_type (STRING) in sales.product']
  is_makegood_eligible boolean [note: 'Indicates whether this product is eligible for makegood compensation if delivery guarantees are not met. | Column is_makegood_eligible (BOOLEAN) in sales.product']
  is_premium boolean [note: 'Indicates whether this is a premium product commanding higher rates due to high demand, exclusive positioning, or superior audience quality. | Column is_premium (BOOLEAN) in sales.product']
  is_sponsorable boolean [note: 'Indicates whether this product can be sold as a sponsorship package with brand integration opportunities. | Column is_sponsorable (BOOLEAN) in sales.product']
  maximum_order_quantity varchar [note: 'Maximum number of units that can be purchased in a single order for this product, used to manage inventory scarcity. | Column maximum_order_quantity (INT) in sales.product']
  minimum_order_quantity varchar [note: 'Minimum number of units that must be purchased in a single order for this product. | Column minimum_order_quantity (INT) in sales.product']
  modified_timestamp timestamp [note: 'Timestamp when this product record was last modified. | Column modified_timestamp (TIMESTAMP) in sales.product']
  notes varchar [note: 'Additional notes, special instructions, or internal comments about the product for sales and operations teams. | Column notes (STRING) in sales.product']
  platform varchar [note: 'Specific platform or network where the product is distributed (e.g., ABC Network, Hulu, ESPN+). | Column platform (STRING) in sales.product']
  product_category varchar [note: 'Media channel category for the product, indicating the distribution platform or medium. | Column product_category (STRING) in sales.product']
  product_code varchar [note: 'Externally-known unique business identifier for the product, used in sales proposals, rate cards, and contracts. | Column product_code (STRING) in sales.product']
  product_manager_name varchar [note: 'Name of the product manager or business owner responsible for this product offering. | Column product_manager_name (STRING) in sales.product']
  product_type varchar [note: 'Classification of the product by its commercial nature: advertising inventory, content licensing, syndication rights, or distribution deals. | Column product_type (STRING) in sales.product']
  sales_channel varchar [note: 'Primary sales channel or market through which this product is sold. | Column sales_channel (STRING) in sales.product']
  sales_product_description varchar [note: 'Detailed description of the product, including its features, benefits, and target audience. | Column description (STRING) in sales.product']
  sales_product_name varchar [note: 'Human-readable name of the advertising or content product offered for sale. | Column name (STRING) in sales.product']
  sales_product_status varchar [note: 'Current lifecycle status of the product in the sales catalog. | Column status (STRING) in sales.product']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.product']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.product']
  unit_of_measure varchar [note: 'The standard unit by which this product is sold and measured (e.g., 30-second spot, thousand impressions, episode license). | Column unit_of_measure (STRING) in sales.product']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.product']

  Note: 'Sales product catalog representing sellable inventory items linked to billing products for order fulfillment and revenue tracking. Coverage gaps ordered by demo impact: (1) ad inventory product definitions for upfront/scatter, (2) sponsorship product types, (3) programmatic product catalog. Sample data generated for both MVM and ECM variants in samples/ directory.'
}

