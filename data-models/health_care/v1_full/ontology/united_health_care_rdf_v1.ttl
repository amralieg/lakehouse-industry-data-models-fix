ind:bookedCapacity rdf:type rdf:Property ;
    rdfs:label 'Booked Capacity' ;
    rdfs:comment 'Number of slots already booked.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
