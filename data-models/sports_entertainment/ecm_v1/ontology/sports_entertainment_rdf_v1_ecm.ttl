    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectionCategory rdf:type rdf:Property ;
    rdfs:label 'Selection Category' ;
    rdfs:comment 'Broader categorization of the selection for market segmentation and reporting (moneyline, handicap, total, proposition, futures, live in-play).' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectionType rdf:type rdf:Property ;
    rdfs:label 'Selection Type' ;
    rdfs:comment 'Classification of the selection indicating the nature of the wagering option (team, individual player, binary outcome, proposition bet, over/under total, point spread).' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affiliateName rdf:type rdf:Property ;
    rdfs:label 'Affiliate Name' ;
    rdfs:comment 'Legal or trading name of the affiliate partner organization or individual.' ;
    rdfs:domain ind:Affiliate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affiliateType rdf:type rdf:Property ;
    rdfs:label 'Affiliate Type' ;
    rdfs:comment 'Classification of the affiliate partner based on their business model and marketing channel specialization.' ;
    rdfs:domain ind:Affiliate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apiAccessEnabled rdf:type rdf:Property ;
    rdfs:label 'Api Access Enabled' ;
    rdfs:comment 'Indicates whether the affiliate has been granted programmatic API access for real-time data feeds, odds integration, or automated reporting.' ;
    rdfs:domain ind:Affiliate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionModel rdf:type rdf:Property ;
    rdfs:label 'Commission Model' ;
    rdfs:comment 'Compensation structure defining how the affiliate earns commissions from referred player activity.' ;
