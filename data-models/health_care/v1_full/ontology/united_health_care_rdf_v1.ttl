    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownerTeam rdf:type rdf:Property ;
    rdfs:label 'Owner Team' ;
    rdfs:comment 'The sales team or business unit responsible for this lead.' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territory rdf:type rdf:Property ;
    rdfs:label 'Territory' ;
    rdfs:comment 'The geographic or market territory to which this lead is assigned.' ;
    rdfs:domain ind:UnitedHealthCare ;
