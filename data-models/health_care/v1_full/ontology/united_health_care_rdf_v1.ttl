ind:bundledPaymentType rdf:type rdf:Property ;
    rdfs:label 'Bundled Payment Type' ;
    rdfs:comment 'If this is a bundled payment method, specifies the type of bundling (retrospective, prospective, acute only, acute and post-acute, post-acute only, episode-based).' ;
