    rdfs:range xsd:dateTime .

ind:portalSessionCode rdf:type rdf:Property ;
    rdfs:label 'Portal Session Code' ;
    rdfs:comment 'Identifier of the user session during which the event occurred.' ;
    rdfs:domain ind:PortalEngagementEvent ;
    rdf:type owl:DatatypeProperty ;
