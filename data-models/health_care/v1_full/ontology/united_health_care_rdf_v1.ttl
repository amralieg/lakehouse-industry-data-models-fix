ind:downsideSharingPercentage rdf:type rdf:Property ;
    rdfs:label 'Downside Sharing Percentage' ;
    rdfs:comment 'Percentage of losses above target that the provider is responsible for as shared risk.' ;
    rdfs:domain ind:RiskSharingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumSavingsRate rdf:type rdf:Property ;
    rdfs:label 'Minimum Savings Rate' ;
    rdfs:comment 'Minimum percentage of savings required before shared savings payments are triggered.' ;
    rdfs:domain ind:RiskSharingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumLossRate rdf:type rdf:Property ;
    rdfs:label 'Minimum Loss Rate' ;
    rdfs:comment 'Minimum percentage of losses required before shared losses are triggered.' ;
    rdfs:domain ind:RiskSharingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceYear rdf:type rdf:Property ;
    rdfs:label 'Performance Year' ;
    rdfs:comment 'Calendar or contract year for which performance is measured under the risk sharing agreement.' ;
