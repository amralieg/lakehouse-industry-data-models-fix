ind:supportsSep rdf:type rdf:Property ;
    rdfs:label 'Supports Sep' ;
    rdfs:comment 'Indicates whether the channel supports enrollment during Special Enrollment Periods triggered by qualifying life events.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsAep rdf:type rdf:Property ;
    rdfs:label 'Supports Aep' ;
    rdfs:comment 'Indicates whether the channel supports enrollment during the Annual Enrollment Period for Medicare or open enrollment for commercial plans.' ;
    rdfs:domain ind:Channel ;
