ind:cobraFlag rdf:type rdf:Property ;
    rdfs:label 'Cobra Flag' ;
    rdfs:comment 'Indicates whether this AR line item is associated with COBRA continuation coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketplaceFlag rdf:type rdf:Property ;
    rdfs:label 'Marketplace Flag' ;
    rdfs:comment 'Indicates whether this AR line item is associated with a health insurance marketplace or exchange plan.' ;
    rdfs:domain ind:ArLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exchangeId rdf:type rdf:Property ;
    rdfs:label 'Exchange Id' ;
    rdfs:comment 'Identifier of the health insurance exchange or marketplace associated with this AR line item.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Exchange .

ind:surchargeId rdf:type rdf:Property ;
    rdfs:label 'Surcharge Id' ;
    rdfs:comment 'Unique identifier for the surcharge record. Primary key for the surcharge data product.' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calculationBasis rdf:type rdf:Property ;
    rdfs:label 'Calculation Basis' ;
    rdfs:comment 'The base value used to calculate the surcharge amount (e.g., base premium, total premium, member count, claims experience).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumSurchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Surcharge Amount' ;
    rdfs:comment 'Minimum dollar amount that can be charged for this surcharge, regardless of calculation method.' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumSurchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Surcharge Amount' ;
    rdfs:comment 'Maximum dollar amount that can be charged for this surcharge, used to cap calculated amounts.' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ageBasedIndicator rdf:type rdf:Property ;
    rdfs:label 'Age Based Indicator' ;
    rdfs:comment 'Flag indicating whether this surcharge varies based on member age.' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geographicBasedIndicator rdf:type rdf:Property ;
    rdfs:label 'Geographic Based Indicator' ;
    rdfs:comment 'Flag indicating whether this surcharge varies based on member geographic location or rating area.' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryMandatedIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandated Indicator' ;
    rdfs:comment 'Flag indicating whether this surcharge is mandated by federal or state regulations.' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxableIndicator rdf:type rdf:Property ;
    rdfs:label 'Taxable Indicator' ;
    rdfs:comment 'Flag indicating whether this surcharge amount is subject to premium taxes or other taxation.' ;
