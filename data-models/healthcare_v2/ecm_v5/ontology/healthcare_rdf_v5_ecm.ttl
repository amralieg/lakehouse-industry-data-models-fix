    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isApmEnrolled rdf:type rdf:Property ;
    rdfs:label 'Is Apm Enrolled' ;
    rdfs:comment 'True if the entity is enrolled in an Alternative Payment Model.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCareGapClosureIncluded rdf:type rdf:Property ;
