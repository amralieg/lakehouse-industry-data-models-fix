Table partner.payment_schedule {
  payment_schedule_id varchar [pk, note: 'Primary key for payment_schedule | Column payment_schedule_id (BIGINT) in partner.payment_schedule']
  contract_id varchar [note: 'Reference to the partner contract or agreement that governs this payment schedule. | Column contract_id (BIGINT) in talent.payment_schedule']
  partner_id varchar [note: 'Reference to the studio, syndicator, content provider, MVPD (Multichannel Video Programming Distributor), or third-party distribution partner receiving payment. | Column partner_id (BIGINT) in partner.payment_schedule']
  revised_payment_schedule_id varchar [note: 'Self-referencing FK on payment_schedule (revised_payment_schedule_id) | Column revised_payment_schedule_id (BIGINT) in partner.payment_schedule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.payment_schedule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.payment_schedule']
  advance_amount decimal(18,2) [note: 'Upfront payment amount advanced to the partner against future royalties or revenue share, to be recouped from subsequent earnings. | Column advance_amount (DECIMAL(18,2)) in partner.payment_schedule']
  amendment_count varchar [note: 'The number of times this payment schedule has been amended or modified since its original creation. | Column amendment_count (INT) in partner.payment_schedule']
  approved_by varchar [note: 'Name or identifier of the business user or executive who approved this payment schedule for activation. | Column approved_by (STRING) in partner.payment_schedule']
  approved_timestamp timestamp [note: 'The date and time when this payment schedule was formally approved and authorized for execution. | Column approved_timestamp (TIMESTAMP) in partner.payment_schedule']
  auto_renewal_flag boolean [note: 'Indicates whether the payment schedule automatically renews at the end of its term unless explicitly terminated. | Column auto_renewal_flag (BOOLEAN) in partner.payment_schedule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.payment_schedule']
  created_timestamp timestamp [note: 'The date and time when this payment schedule record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.payment_schedule']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this payment schedule (e.g., USD, EUR, GBP). | Column currency_code (STRING) in partner.payment_schedule']
  effective_end_date date [note: 'The date when this payment schedule expires or is no longer in effect. Nullable for open-ended schedules. | Column effective_end_date (DATE) in partner.payment_schedule']
  effective_start_date date [note: 'The date when this payment schedule becomes effective and binding. | Column effective_start_date (DATE) in partner.payment_schedule']
  escalation_clause_flag boolean [note: 'Indicates whether the payment schedule includes an escalation clause that increases payment amounts over time or based on performance milestones. | Column escalation_clause_flag (BOOLEAN) in partner.payment_schedule']
  escalation_percentage decimal(5,2) [note: 'The percentage increase applied to payment amounts under the escalation clause, if applicable (e.g., 5.00 represents 5% annual increase). | Column escalation_percentage (DECIMAL(5,2)) in partner.payment_schedule']
  final_payment_date date [note: 'The scheduled date for the final payment under this payment schedule, marking the end of the payment obligation. | Column final_payment_date (DATE) in partner.payment_schedule']
  first_payment_date date [note: 'The scheduled date for the first payment under this payment schedule. | Column first_payment_date (DATE) in partner.payment_schedule']
  minimum_guarantee_amount decimal(18,2) [note: 'The minimum guaranteed payment amount that must be paid to the partner regardless of performance or revenue, common in content licensing and distribution agreements. | Column minimum_guarantee_amount (DECIMAL(18,2)) in partner.payment_schedule']
  modified_timestamp timestamp [note: 'The date and time when this payment schedule record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in partner.payment_schedule']
  notes varchar [note: 'Free-text field for additional notes, special instructions, or contextual information about the payment schedule. | Column notes (STRING) in partner.payment_schedule']
  payment_account_number varchar [note: 'The partner\'s bank account number or payment account identifier to which payments under this schedule are remitted. | Column payment_account_number (STRING) in partner.payment_schedule']
  payment_amount decimal(18,2) [note: 'The standard payment amount for each scheduled payment installment, in the specified currency. May be fixed or variable depending on schedule type. | Column payment_amount (DECIMAL(18,2)) in partner.payment_schedule']
  payment_calculation_basis varchar [note: 'The basis or formula used to calculate payment amounts: fixed amount, gross revenue, net revenue, subscriber count, viewership metrics, per episode, or per season. | Column payment_calculation_basis (STRING) in partner.payment_schedule']
  payment_frequency varchar [note: 'Frequency at which payments are scheduled to be made under this schedule: one-time, monthly, quarterly, semi-annual, annual, upon delivery, or upon broadcast. | Column payment_frequency (STRING) in partner.payment_schedule']
  payment_method varchar [note: 'The financial instrument or mechanism used to execute payments: wire transfer, ACH (Automated Clearing House), check, letter of credit, escrow, or direct deposit. | Column payment_method (STRING) in partner.payment_schedule']
  payment_priority varchar [note: 'Business priority level assigned to this payment schedule for cash flow management and payment processing sequencing. | Column payment_priority (STRING) in partner.payment_schedule']
  payment_routing_number varchar [note: 'The bank routing number or SWIFT code for the partner\'s payment account, used for wire transfers and ACH transactions. | Column payment_routing_number (STRING) in partner.payment_schedule']
  payment_terms_days varchar [note: 'Number of days from invoice date or trigger event within which payment must be made (e.g., Net 30, Net 60). | Column payment_terms_days (INT) in partner.payment_schedule']
  payment_trigger_event varchar [note: 'The business event or milestone that triggers payment obligation, such as content delivery, broadcast date, subscriber threshold, or contract execution. | Column payment_trigger_event (STRING) in partner.payment_schedule']
  recoupment_flag boolean [note: 'Indicates whether advances or minimum guarantees are subject to recoupment from future revenue or royalty payments. | Column recoupment_flag (BOOLEAN) in partner.payment_schedule']
  recoupment_percentage decimal(5,2) [note: 'The percentage of future payments that will be withheld to recoup advances or minimum guarantees (e.g., 100.00 represents full recoupment). | Column recoupment_percentage (DECIMAL(5,2)) in partner.payment_schedule']
  renewal_notice_days varchar [note: 'Number of days advance notice required before the renewal date to terminate or modify the payment schedule. | Column renewal_notice_days (INT) in partner.payment_schedule']
  revenue_share_percentage decimal(5,2) [note: 'The percentage of revenue to be shared with the partner, applicable for revenue-sharing payment schedules (e.g., 25.00 represents 25%). | Column revenue_share_percentage (DECIMAL(5,2)) in partner.payment_schedule']
  royalty_rate decimal(5,2) [note: 'The royalty rate percentage or per-unit rate applied to calculate royalty payments for content usage, licensing, or distribution. | Column royalty_rate (DECIMAL(5,2)) in partner.payment_schedule']
  schedule_number varchar [note: 'Business-facing unique identifier or reference number for this payment schedule, used in partner communications and financial reporting. | Column schedule_number (STRING) in partner.payment_schedule']
  schedule_status varchar [note: 'Current lifecycle status of the payment schedule: draft (under negotiation), active (in effect), suspended (temporarily paused), completed (all payments made), terminated (cancelled), or amended (modified). | Column schedule_status (STRING) in partner.payment_schedule']
  schedule_type varchar [note: 'Classification of the payment schedule based on the nature of the financial obligation: content acquisition, licensing fee, royalty, revenue share, minimum guarantee, advance, or co-production arrangement. | Column schedule_type (STRING) in partner.payment_schedule']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.payment_schedule']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.payment_schedule']
  total_contract_value decimal(18,2) [note: 'The total monetary value of all payments scheduled under this payment schedule over its entire term, in the specified currency. | Column total_contract_value (DECIMAL(18,2)) in partner.payment_schedule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.payment_schedule']
  withholding_tax_rate decimal(5,2) [note: 'The tax withholding rate percentage applied to payments for cross-border transactions or as required by tax regulations (e.g., 15.00 represents 15%). | Column withholding_tax_rate (DECIMAL(5,2)) in partner.payment_schedule']

  Note: 'Master reference table for payment_schedule. Referenced by payment_schedule_id. | Unity Catalog table: media_broadcasting_ecm.partner.payment_schedule'
}

