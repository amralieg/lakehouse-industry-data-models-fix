ind:rosterAddDate rdf:type rdf:Property ;
    rdfs:label 'Roster Add Date' ;
    rdfs:comment 'Date when the provider was added to the active provider roster following credentialing approval.' ;
    rdfs:domain ind:CredentialingDecision ;
    rdf:type owl:DatatypeProperty ;
