    rdfs:range xsd:string .

ind:reportingThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Reporting Threshold Amount' ;
    rdfs:comment 'Monetary threshold above which the operator must report transactions to regulatory authorities.' ;
    rdfs:domain ind:Operator ;
