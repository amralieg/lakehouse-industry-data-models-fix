    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radvAuditFlag rdf:type rdf:Property ;
    rdfs:label 'Radv Audit Flag' ;
    rdfs:comment 'Indicator that the member\'s risk data has been selected for CMS RADV audit review.' ;
