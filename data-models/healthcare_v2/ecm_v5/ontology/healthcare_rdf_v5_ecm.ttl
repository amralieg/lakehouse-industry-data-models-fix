    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggerEvent rdf:type rdf:Property ;
    rdfs:label 'Trigger Event' ;
    rdfs:comment 'Description of the precipitating event or circumstance.' ;
    rdfs:domain ind:BehavioralHealthCrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:behavioralHealthOtpEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Otp Enrollment Id' ;
    rdfs:comment 'Reference to the OTP enrollment record associated with the consent.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BehavioralHealthOtpEnrollment .

ind:part2DisclosureAllowed rdf:type rdf:Property ;
    rdfs:label 'Part2 Disclosure Allowed' ;
    rdfs:comment 'Flag indicating whether the consent permits disclosure of the protected information.' ;
    rdfs:domain ind:BehavioralHealthCfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:part2DisclosureDate rdf:type rdf:Property ;
    rdfs:label 'Part2 Disclosure Date' ;
    rdfs:comment 'Date when a disclosure was made under the consent, if applicable.' ;
    rdfs:domain ind:BehavioralHealthCfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:part2Exemptions rdf:type rdf:Property ;
    rdfs:label 'Part2 Exemptions' ;
    rdfs:comment 'Narrative description of any statutory exemptions applicable to the consent.' ;
    rdfs:domain ind:BehavioralHealthCfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:part2Section rdf:type rdf:Property ;
    rdfs:label 'Part2 Section' ;
    rdfs:comment 'Specific Part 2 regulatory section governing this consent.' ;
    rdfs:domain ind:BehavioralHealthCfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rpmAlertThresholdId rdf:type rdf:Property ;
    rdfs:label 'Rpm Alert Threshold Id' ;
    rdfs:comment 'Unique identifier for the RPM alert threshold configuration.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RpmAlertThreshold .

ind:orderingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Ordering Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Patient-specific alert thresholds are clinical orders set by physicians. Tracking the ordering clinician ensures clinical accountability and supports scope-of-practice compliance for threshold modific' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:rpmEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Rpm Employee Id' ;
    rdfs:comment 'Identifier of the user who created the threshold configuration.' ;
    rdfs:domain ind:RpmAlertThreshold ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:escalationPolicy rdf:type rdf:Property ;
    rdfs:label 'Escalation Policy' ;
    rdfs:comment 'Name or identifier of the escalation workflow to invoke on alert.' ;
    rdfs:domain ind:RpmAlertThreshold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationResult rdf:type rdf:Property ;
    rdfs:label 'Evaluation Result' ;
    rdfs:comment 'Result of the most recent evaluation (e.g., within_range|breached).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lowerThreshold rdf:type rdf:Property ;
    rdfs:label 'Lower Threshold' ;
    rdfs:comment 'Lower bound that triggers an alert when the metric falls below this value.' ;
    rdfs:domain ind:RpmAlertThreshold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:metricCode rdf:type rdf:Property ;
    rdfs:label 'Metric Code' ;
    rdfs:comment 'Standard code for the metric (e.g., LOINC code).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rpmAlertThresholdDescription rdf:type rdf:Property ;
    rdfs:label 'Rpm Alert Threshold Description' ;
    rdfs:comment 'Free-text description of the purpose or context of the threshold.' ;
    rdfs:domain ind:RpmAlertThreshold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rpmAlertThresholdStatus rdf:type rdf:Property ;
    rdfs:label 'Rpm Alert Threshold Status' ;
    rdfs:comment 'Current lifecycle status of the alert threshold configuration.' ;
    rdfs:domain ind:RpmAlertThreshold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdType rdf:type rdf:Property ;
    rdfs:label 'Threshold Type' ;
    rdfs:comment 'Indicates whether the threshold is an absolute value, relative change, or percentage.' ;
    rdfs:domain ind:RpmAlertThreshold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upperThreshold rdf:type rdf:Property ;
    rdfs:label 'Upper Threshold' ;
    rdfs:comment 'Upper bound that triggers an alert when the metric exceeds this value.' ;
    rdfs:domain ind:RpmAlertThreshold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousAssessmentPsychiatricAssessmentBehavioralHealthPsychiatricAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Previous Assessment Psychiatric Assessment Behavioral Health Psychiatric Assessment Id' ;
    rdfs:comment 'Reference to a prior related psychiatric assessment, if any.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BehavioralHealthPsychiatricAssessment .

ind:psychiatricAssessmentId rdf:type rdf:Property ;
