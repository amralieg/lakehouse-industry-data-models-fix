ind:supersedesHccCode rdf:type rdf:Property ;
    rdfs:label 'Supersedes Hcc Code' ;
    rdfs:comment 'The HCC code(s) that this category supersedes in the hierarchy when both conditions are present.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diseaseInteractionGroup rdf:type rdf:Property ;
    rdfs:label 'Disease Interaction Group' ;
    rdfs:comment 'Identifies disease interaction groups where multiple HCCs together result in additional risk adjustment.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isInteractionEligible rdf:type rdf:Property ;
    rdfs:label 'Is Interaction Eligible' ;
    rdfs:comment 'Indicates whether this HCC category is eligible to participate in disease interaction calculations for additional risk adjustment.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
