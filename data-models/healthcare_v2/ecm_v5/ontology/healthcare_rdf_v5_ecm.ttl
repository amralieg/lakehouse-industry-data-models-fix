    rdfs:comment 'Employment status of patient at assessment.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientIncomeBracket rdf:type rdf:Property ;
    rdfs:label 'Patient Income Bracket' ;
    rdfs:comment 'Income bracket category for socioeconomic context.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substanceUseDisorderFlag rdf:type rdf:Property ;
    rdfs:label 'Substance Use Disorder Flag' ;
    rdfs:comment 'Flag indicating presence of substance use disorder identified.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
