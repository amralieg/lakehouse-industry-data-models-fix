  corrective_action_required boolean [note: 'Indicates corrective action required.']
  financial_impact_amount decimal(15,2) [note: 'Financial impact amount.']
  finding_description varchar [note: 'Finding description.']
  finding_severity varchar [note: 'Finding severity.']
  review_completion_date date [note: 'Review completion date.']
  review_start_date date [note: 'Review start date.']
  reviewer_name varchar [note: 'Reviewer name.']
  sample_selection_method varchar [note: 'Sample selection method (random, targeted, risk-based).']
  sample_sequence_number varchar [note: 'Sample sequence number.']
  selected_date date [note: 'Selected date.']

  Note: 'Tracks claims selected for compliance audits (RAC, MAC, ZPIC, internal) with sample selection method, review findings, and financial impact. Links to corrective action plans and supports audit response workflows.'
}

Table supply.material_master {
  material_master_id varchar [pk, note: 'Unique identifier for each material master record.']
  compliance_program_id varchar [note: 'Compliance program governing this material (e.g., controlled substance, hazmat).']
  expense_chart_of_accounts_id varchar [note: 'General ledger account for expense posting.']
  hcpcs_code_id varchar [note: 'HCPCS code for billing and reimbursement.']
  ndc_drug_id varchar [note: 'National Drug Code reference for pharmaceuticals.']
  payer_id varchar [note: 'Payer for reimbursement tracking.']
  preferred_vendor_id varchar [note: 'Preferred vendor for this material.']
  terminology_mapping_id varchar [note: 'Mapping to standard terminologies (SNOMED, LOINC, etc.).']
  approved_date date [note: 'Date the material was approved for use.']
  catalog_price decimal(18,4) [note: 'List price from vendor catalog.']
  cdm_charge_code varchar [note: 'Charge master code for billing.']
  contract_price decimal(18,4) [note: 'Negotiated contract price.']
  cost_center_code varchar [note: 'Cost center for expense allocation.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  dea_schedule varchar [note: 'DEA controlled substance schedule (I-V).']
  discontinuation_date date [note: 'Date the material was discontinued.']
  fda_device_class varchar [note: 'FDA device classification (I, II, III).']
  fda_product_code varchar [note: 'FDA product code.']
  formulary_status varchar [note: 'Formulary status (preferred, non-preferred, restricted).']
  gl_account_code varchar [note: 'General ledger account code.']
  gtin varchar [note: 'Global Trade Item Number.']
  is_controlled_substance boolean [note: 'Indicates if material is a controlled substance.']
  is_hazardous boolean [note: 'Indicates if material is hazardous.']
  is_implantable boolean [note: 'Indicates if material is an implantable device.']
  is_latex_free boolean [note: 'Indicates if material is latex-free.']
  is_sterile boolean [note: 'Indicates if material is sterile.']
  item_category_code varchar [note: 'Material category code.']
  item_category_name varchar [note: 'Material category name.']
  item_description varchar [note: 'Full description of the material.']
  item_number varchar [note: 'Internal item number.']
  item_status varchar [note: 'Status (active, inactive, obsolete).']
  item_type varchar [note: 'Type (supply, device, pharmaceutical, etc.).']
  last_updated_timestamp timestamp [note: 'Last update timestamp.']
  lead_time_days varchar [note: 'Lead time in days for procurement.']
  lot_tracking_required boolean [note: 'Indicates if lot tracking is required.']
  manufacturer_item_number varchar [note: 'Manufacturer\'s item number.']
  manufacturer_name varchar [note: 'Manufacturer name.']
  ndc_code varchar [note: 'National Drug Code.']
  order_unit_of_measure varchar [note: 'Unit of measure for ordering.']
  par_level decimal(18,4) [note: 'Par level for inventory management.']
  preferred_vendor_item_number varchar [note: 'Preferred vendor\'s item number.']
  recall_status varchar [note: 'Current recall status.']
  reorder_point decimal(18,4) [note: 'Reorder point for inventory replenishment.']
  reorder_quantity decimal(18,4) [note: 'Reorder quantity.']
  serial_tracking_required boolean [note: 'Indicates if serial tracking is required.']
  shelf_life_days varchar [note: 'Shelf life in days.']
  storage_location_type varchar [note: 'Type of storage location required.']
  storage_temperature_max_c decimal(5,2) [note: 'Maximum storage temperature in Celsius.']
  storage_temperature_min_c decimal(5,2) [note: 'Minimum storage temperature in Celsius.']
  udi varchar [note: 'Unique Device Identifier.']
  unit_of_measure varchar [note: 'Base unit of measure.']
  unspsc_code varchar [note: 'United Nations Standard Products and Services Code.']
  uom_conversion_factor decimal(18,6) [note: 'Conversion factor between units of measure.']

  Note: 'Master catalog of all materials, supplies, devices, and pharmaceuticals procured and managed by the health system. Supports supply chain management, inventory control, clinical order fulfillment, and regulatory compliance (UDI, FDA, DEA). Links to vendor contracts, formulary status, and charge master for revenue cycle integration.'
}

Table supply.vendor {
  vendor_id varchar [pk, note: 'Unique identifier for each vendor.']
  trading_partner_id varchar [note: 'EDI trading partner record.']
  address_line1 varchar [note: 'Vendor address line 1.']
  address_line2 varchar [note: 'Vendor address line 2.']
  approved_date date [note: 'Date vendor was approved.']
  bank_account_number varchar [note: 'Vendor bank account number for ACH payments.']
  bank_routing_number varchar [note: 'Vendor bank routing number.']
  city varchar [note: 'Vendor city.']
  contract_end_date date [note: 'Contract end date.']
  contract_start_date date [note: 'Contract start date.']
  contract_tier varchar [note: 'Contract tier (national, regional, local).']
  country_code varchar [note: 'Vendor country code.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency code for transactions.']
  dea_registration_number decimal(9,4) [note: 'DEA registration number for controlled substances.']
  diversity_certification_expiration_date decimal(9,4) [note: 'Diversity certification expiration date.']
  diversity_certification_number varchar [note: 'Diversity certification number.']
  diversity_classification varchar [note: 'Diversity classification (MBE, WBE, SDVOSB, etc.).']
  doing_business_as_name varchar [note: 'Doing business as name.']
  edi_capable_flag boolean [note: 'Indicates if vendor supports EDI.']
  fda_establishment_number varchar [note: 'FDA establishment number.']
  fill_rate decimal(5,2) [note: 'Vendor fill rate percentage.']
  gpo_affiliation varchar [note: 'Group purchasing organization affiliation.']
  gpo_contract_number varchar [note: 'GPO contract number.']
  insurance_certificate_number varchar [note: 'Vendor insurance certificate number.']
  insurance_expiration_date decimal(9,4) [note: 'Vendor insurance expiration date.']
  lead_time_days varchar [note: 'Average lead time in days.']
  minimum_order_amount decimal(12,2) [note: 'Minimum order amount.']
  npi varchar [note: 'National Provider Identifier (for clinical vendors).']
  oig_excluded_flag boolean [note: 'Indicates if vendor is on OIG exclusion list.']
  oig_exclusion_checked_date date [note: 'Date OIG exclusion was last checked.']
  on_time_delivery_rate decimal(5,2) [note: 'On-time delivery rate percentage.']
  payment_method varchar [note: 'Payment method (ACH, check, wire, etc.).']
  payment_terms varchar [note: 'Payment terms (Net 30, Net 60, etc.).']
  performance_rating decimal(3,2) [note: 'Vendor performance rating (0-5 scale).']
  postal_code varchar [note: 'Vendor postal code.']
  preferred_vendor_flag boolean [note: 'Indicates if vendor is preferred.']
  primary_contact_email varchar [note: 'Primary contact email address.']
  primary_contact_name varchar [note: 'Primary contact name.']
  primary_contact_phone varchar [note: 'Primary contact phone number.']
  punchout_catalog_url varchar [note: 'URL for punchout catalog integration.']
  recall_notification_flag boolean [note: 'Indicates if vendor provides recall notifications.']
  remittance_email varchar [note: 'Email for remittance advice.']
  state_code varchar [note: 'Vendor state code.']
  tax_number varchar [note: 'Vendor tax identification number.']
  udi_capable_flag boolean [note: 'Indicates if vendor supports UDI.']
  updated_timestamp timestamp [note: 'Last update timestamp.']
  vendor_name varchar [note: 'Vendor legal name.']
  vendor_number varchar [note: 'Vendor number.']
  vendor_status varchar [note: 'Vendor status (active, inactive, suspended).']
  vendor_type varchar [note: 'Vendor type (distributor, manufacturer, GPO, etc.).']

  Note: 'Master vendor registry for all suppliers of materials, devices, pharmaceuticals, and services. Supports vendor performance tracking, compliance screening (OIG exclusion, DEA registration), diversity spend reporting, and EDI integration for automated procurement workflows.'
}

Table supply.purchase_order {
  purchase_order_id varchar [pk, note: 'Unique identifier for each purchase order.']
  buyer_employee_id varchar [note: 'Employee who created the purchase order.']
  care_site_id varchar [note: 'Care site for delivery.']
  chart_of_accounts_id varchar [note: 'GL account for expense posting.']
  clinical_order_id varchar [note: 'Clinical order triggering this purchase (for patient-specific implants).']
  fiscal_period_id varchar [note: 'Fiscal period for budget tracking.']
  inventory_location_id varchar [note: 'Delivery location.']
  reimbursement_payer_id varchar [note: 'Payer for reimbursement tracking (for patient-specific items).']
  vendor_contract_id varchar [note: 'Vendor contract governing this PO.']
  vendor_id varchar [note: 'Vendor receiving the purchase order.']
  actual_delivery_date date [note: 'Actual delivery date.']
  approval_status varchar [note: 'Approval status (pending, approved, rejected).']
  approved_timestamp timestamp [note: 'Approval timestamp.']
  budget_year varchar [note: 'Budget year.']
  cancellation_reason varchar [note: 'Reason for cancellation.']
  confirmed_delivery_date date [note: 'Vendor-confirmed delivery date.']
  cost_center_code varchar [note: 'Cost center code.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency code.']
  discount_amount decimal(18,2) [note: 'Total discount amount.']
  freight_amount decimal(18,2) [note: 'Freight charges.']
  freight_terms_code varchar [note: 'Freight terms (FOB, prepaid, etc.).']
  fulfillment_status varchar [note: 'Fulfillment status (open, partial, complete).']
  gl_account_code varchar [note: 'GL account code.']
  gpo_contract_number varchar [note: 'GPO contract number.']
  gross_amount decimal(18,2) [note: 'Gross amount before discounts.']
  invoice_status varchar [note: 'Invoice status (not invoiced, partial, complete).']
  is_capital_expenditure boolean [note: 'Indicates if this is a capital expenditure.']
  is_contract_compliant boolean [note: 'Indicates if PO is contract-compliant.']
  is_emergency_order boolean [note: 'Indicates if this is an emergency order.']
  line_item_count varchar [note: 'Number of line items.']
  net_amount decimal(18,2) [note: 'Net amount after discounts.']
  notes varchar [note: 'PO notes.']
  order_date date [note: 'Order date.']
  payment_terms_code varchar [note: 'Payment terms.']
  po_number varchar [note: 'Purchase order number.']
  po_status varchar [note: 'PO status (draft, open, closed, cancelled).']
  po_type varchar [note: 'PO type (standard, blanket, contract, etc.).']
  purchasing_group_code varchar [note: 'Purchasing group code.']
  purchasing_org_code varchar [note: 'Purchasing organization code.']
  requested_delivery_date date [note: 'Requested delivery date.']
  source_system_code varchar [note: 'Source system code.']
  source_system_po_key varchar [note: 'Source system PO key.']
  tax_amount decimal(18,2) [note: 'Tax amount.']
  three_way_match_status varchar [note: 'Three-way match status (pending, matched, exception).']
  updated_timestamp timestamp [note: 'Last update timestamp.']
  vendor_quote_number varchar [note: 'Vendor quote number.']

  Note: 'Purchase orders issued to vendors for materials, supplies, devices, and services. Supports three-way match (PO-receipt-invoice), budget tracking, contract compliance, and integration with accounts payable and general ledger for financial reconciliation.'
}

Table supply.purchase_order_line {
  purchase_order_line_id varchar [pk, note: 'Unique identifier for each purchase order line.']
  care_site_id varchar [note: 'Care site for delivery.']
  chart_of_accounts_id varchar [note: 'GL account for expense posting.']
  cpt_code_id varchar [note: 'CPT code for billing.']
  fund_id varchar [note: 'Fund for budget tracking.']
  hcpcs_code_id varchar [note: 'HCPCS code for billing.']
  material_master_id varchar [note: 'Material master record.']
  purchase_order_id varchar [note: 'Parent purchase order.']
  requisition_id varchar [note: 'Requisition triggering this line.']
  vendor_contract_id varchar [note: 'Vendor contract governing this line.']
  vendor_id varchar [note: 'Vendor for this line.']
  approval_status varchar [note: 'Approval status.']
  approved_by varchar [note: 'User who approved this line.']
  approved_timestamp timestamp [note: 'Approval timestamp.']
  backorder_quantity decimal(18,4) [note: 'Quantity on backorder.']
  cancelled_quantity decimal(18,4) [note: 'Quantity cancelled.']
  cost_center_code varchar [note: 'Cost center code.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency code.']
  discount_percent decimal(5,2) [note: 'Discount percentage.']
  expense_type varchar [note: 'Expense type (operating, capital).']
  expiration_date decimal(9,4) [note: 'Expiration date for perishable items.']
  extended_amount decimal(18,2) [note: 'Extended amount (quantity * unit price).']
  freight_amount decimal(18,2) [note: 'Freight charges for this line.']
  gl_account_code varchar [note: 'GL account code.']
  gpo_contract_number varchar [note: 'GPO contract number.']
  invoiced_quantity decimal(18,4) [note: 'Quantity invoiced.']
  is_contract_item boolean [note: 'Indicates if item is on contract.']
  is_formulary_item boolean [note: 'Indicates if item is on formulary.']
  is_recall_active boolean [note: 'Indicates if item is under recall.']
  item_category varchar [note: 'Item category.']
  item_description varchar [note: 'Item description.']
  last_modified_timestamp timestamp [note: 'Last modification timestamp.']
  line_number varchar [note: 'Line number within PO.']
  line_status varchar [note: 'Line status (open, closed, cancelled).']
  line_type varchar [note: 'Line type (material, service, freight).']
  lot_number varchar [note: 'Lot number.']
  ndc_code varchar [note: 'National Drug Code.']
  ordered_quantity decimal(18,4) [note: 'Quantity ordered.']
  promised_delivery_date date [note: 'Vendor-promised delivery date.']
  received_quantity decimal(18,4) [note: 'Quantity received.']
  requested_delivery_date date [note: 'Requested delivery date.']
  ship_to_location_code varchar [note: 'Ship-to location code.']
  source_system_code varchar [note: 'Source system code.']
  tax_amount decimal(18,2) [note: 'Tax amount.']
  udi varchar [note: 'Unique Device Identifier.']
  unit_of_measure varchar [note: 'Unit of measure.']
  unit_price decimal(18,4) [note: 'Unit price.']
  vendor_item_number varchar [note: 'Vendor item number.']

  Note: 'Line-item detail for purchase orders, linking to material master, vendor contracts, and requisitions. Supports three-way match reconciliation, backorder tracking, and GL account allocation for financial reporting.'
}

Table supply.goods_receipt {
  goods_receipt_id varchar [pk, note: 'Unique identifier for each goods receipt transaction.']
  awaiting_clinical_order_id varchar [note: 'Clinical order awaiting this receipt (for patient-specific implants).']
  care_site_id varchar [note: 'Care site where goods were received.']
  chart_of_accounts_id varchar [note: 'GL account for inventory valuation.']
  fiscal_period_id varchar [note: 'Fiscal period for financial reporting.']
  inventory_location_id varchar [note: 'Inventory location where goods were received.']
  material_master_id varchar [note: 'Material master record.']
  primary_goods_received_by_employee_id varchar [note: 'Employee who received the goods.']
  purchase_order_id varchar [note: 'Purchase order for this receipt.']
  purchase_order_line_id varchar [note: 'Purchase order line for this receipt.']
  vendor_id varchar [note: 'Vendor who shipped the goods.']
  condition_on_receipt varchar [note: 'Condition of goods on receipt (good, damaged, etc.).']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency code.']
  delivery_note_number varchar [note: 'Vendor delivery note number.']
  discrepancy_flag boolean [note: 'Indicates if there was a discrepancy.']
  discrepancy_notes varchar [note: 'Notes on discrepancy.']
  discrepancy_type varchar [note: 'Type of discrepancy (quantity, quality, etc.).']
  expiration_date decimal(9,4) [note: 'Expiration date.']
  implantable_device_flag boolean [note: 'Indicates if item is an implantable device.']
  inventory_update_flag boolean [note: 'Indicates if inventory was updated.']
  lot_number varchar [note: 'Lot number.']
  manufacture_date date [note: 'Manufacture date.']
  movement_type varchar [note: 'Movement type (receipt, return, etc.).']
  plant_code varchar [note: 'Plant code.']
  posting_timestamp timestamp [note: 'Posting timestamp.']
  quantity_ordered decimal(18,4) [note: 'Quantity ordered.']
  quantity_received decimal(18,4) [note: 'Quantity received.']
  recall_flag boolean [note: 'Indicates if item is under recall.']
  recall_reference_number varchar [note: 'Recall reference number.']
  receipt_date date [note: 'Receipt date.']
  receipt_number varchar [note: 'Receipt number.']
  receipt_status varchar [note: 'Receipt status (complete, partial, etc.).']
  serial_number varchar [note: 'Serial number.']
  source_document_number varchar [note: 'Source document number.']
  sterile_processing_required boolean [note: 'Indicates if sterile processing is required.']
  storage_condition varchar [note: 'Storage condition (room temp, refrigerated, etc.).']
  temperature_excursion_flag boolean [note: 'Indicates if temperature excursion occurred.']
  three_way_match_status varchar [note: 'Three-way match status.']
  total_receipt_value decimal(18,2) [note: 'Total receipt value.']
  udi_device_identifier varchar [note: 'UDI device identifier.']
  udi_production_identifier varchar [note: 'UDI production identifier.']
  unit_cost decimal(18,4) [note: 'Unit cost.']
  unit_of_measure varchar [note: 'Unit of measure.']
  updated_timestamp timestamp [note: 'Last update timestamp.']
  vendor_invoice_number varchar [note: 'Vendor invoice number.']

  Note: 'Goods receipt transactions recording the physical receipt of materials from vendors. Supports three-way match (PO-receipt-invoice), lot/serial tracking, UDI capture for implantable devices, expiration date tracking, and recall management. Triggers inventory balance updates and accounts payable accruals.'
}

Table supply.inventory_location {
  inventory_location_id varchar [pk, note: 'Unique identifier for each inventory location.']
  building_id varchar [note: 'Building where location is located.']
  care_site_id varchar [note: 'Care site where location is located.']
  cost_center_id varchar [note: 'Cost center for expense allocation.']
  equipment_asset_id varchar [note: 'Equipment asset (e.g., ADC machine).']
  org_unit_id varchar [note: 'Organizational unit responsible for this location.']
  osha_safety_program_id varchar [note: 'OSHA safety program governing this location.']
  parent_location_inventory_location_id varchar [note: 'Parent inventory location (for hierarchical locations).']
  access_restriction_level varchar [note: 'Access restriction level (public, restricted, controlled).']
  adc_manufacturer varchar [note: 'Automated dispensing cabinet manufacturer.']
  bin_aisle varchar [note: 'Bin aisle.']
  bin_shelf varchar [note: 'Bin shelf.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  cycle_count_frequency varchar [note: 'Cycle count frequency (daily, weekly, monthly).']
  deactivation_date date [note: 'Deactivation date.']
  effective_date date [note: 'Effective date.']
  expiration_tracking_enabled decimal(9,4) [note: 'Indicates if expiration tracking is enabled.']
  floor_number varchar [note: 'Floor number.']
  gl_account_code varchar [note: 'GL account code for inventory valuation.']
  hazardous_material_storage boolean [note: 'Indicates if location stores hazardous materials.']
  humidity_controlled boolean [note: 'Indicates if location is humidity-controlled.']
  last_cycle_count_date date [note: 'Last cycle count date.']
  lawson_location_code varchar [note: 'Lawson location code.']
  location_code varchar [note: 'Location code.']
  location_name varchar [note: 'Location name.']
  location_notes varchar [note: 'Location notes.']
  location_status varchar [note: 'Location status (active, inactive).']
  location_type varchar [note: 'Location type (warehouse, OR, nursing unit, ADC, etc.).']
  next_cycle_count_date date [note: 'Next cycle count date.']
  par_level_managed boolean [note: 'Indicates if location is par-level managed.']
  par_replenishment_method varchar [note: 'Par replenishment method (manual, automated).']
  primary_contact_name varchar [note: 'Primary contact name.']
  primary_contact_phone varchar [note: 'Primary contact phone.']
  recall_management_enabled boolean [note: 'Indicates if recall management is enabled.']
  replenishment_frequency varchar [note: 'Replenishment frequency.']
  room_number varchar [note: 'Room number.']
  sap_storage_location_code varchar [note: 'SAP storage location code.']
  secure_controlled_substance boolean [note: 'Indicates if location stores controlled substances.']
  sterile_processing_staging boolean [note: 'Indicates if location is sterile processing staging area.']
  storage_capacity_cubic_ft decimal(10,2) [note: 'Storage capacity in cubic feet.']
  storage_capacity_units varchar [note: 'Storage capacity in units.']
  temperature_max_celsius decimal(5,2) [note: 'Maximum temperature in Celsius.']
  temperature_min_celsius decimal(5,2) [note: 'Minimum temperature in Celsius.']
  temperature_requirement varchar [note: 'Temperature requirement (room temp, refrigerated, frozen).']
  udi_tracking_enabled boolean [note: 'Indicates if UDI tracking is enabled.']
  updated_timestamp timestamp [note: 'Last update timestamp.']

  Note: 'Inventory storage locations (central warehouse, OR supply rooms, nursing units, automated dispensing cabinets, etc.). Supports par-level management, cycle counting, temperature/humidity monitoring for controlled substances and refrigerated items, and integration with ADC systems.'
}

Table supply.requisition {
  requisition_id varchar [pk, note: 'Surrogate primary key for requisition']

  Note: 'Internal requisitions for materials and supplies from clinical departments, nursing units, and OR. Supports approval workflows, budget checking, par-level replenishment, and conversion to purchase orders. Links to surgical cases and clinical orders for demand forecasting.'
}

Table supply.udi_record {
  udi_record_id varchar [pk, note: 'Surrogate primary key for udi_record']

  Note: 'Unique Device Identifier (UDI) records for implantable medical devices. Supports FDA UDI requirements, patient-device linkage for recalls and adverse event reporting, explant tracking, and MDR (Medical Device Reporting) compliance. Critical for patient safety and regulatory compliance.'
}

Table supply.surgical_bom {
  surgical_bom_id varchar [pk, note: 'Surrogate primary key for surgical_bom']

  Note: 'Surgical bill of materials (BOM) defining standard supply and implant requirements for surgical procedures. Supports preference card management, case cart assembly, cost estimation, and supply chain planning. Links to CPT codes, surgeons, and OR locations for standardization and cost control.'
}

Table supply.case_cart {
  case_cart_id varchar [pk, note: 'Surrogate primary key for case_cart']

  Note: 'Case cart assembly and fulfillment for surgical cases. Tracks picking, assembly, delivery, usage, returns, and waste for OR supply management. Supports implant tracking, UDI capture, recall management, and cost-per-case analytics. Links to surgical cases and surgical BOMs.'
}

Table supply.recall_notice {
  recall_notice_id varchar [pk, note: 'Surrogate primary key for recall_notice']
  vibe_placeholder varchar [note: 'Added by VIBE mutator to ensure target entity is touched.']

  Note: 'FDA and vendor recall notices for materials, devices, and pharmaceuticals. Supports recall class determination, patient impact assessment, inventory quarantine, patient notification workflows, and regulatory reporting. Links to UDI records, inventory balances, and patient procedures for recall remediation.'
}

Table supply.vendor_contract {
  vendor_contract_id varchar [pk, note: 'Surrogate primary key for vendor_contract']
  vibe_placeholder varchar [note: 'Added by VIBE mutator to ensure target entity is touched.']

  Note: 'Vendor contracts governing pricing, terms, rebates, and compliance requirements. Supports GPO contract tracking, diversity spend reporting, sole-source justification, and contract compliance monitoring. Links to purchase orders and vendor performance metrics for contract optimization.'
}

Table supply.location_audit {
  location_audit_id varchar [pk]
  audit_id varchar
  auditor_employee_id varchar [note: 'Employee who performed the physical inventory audit at the location.']
  care_site_id varchar [note: 'Facility where the audited inventory location resides.']
  corrective_action_plan_id varchar [note: 'Link to formal corrective action plan if audit findings require remediation.']
  inventory_location_id varchar
  accuracy_rate decimal(5,2) [note: 'Inventory accuracy rate (percentage of items matching expected)']
  audit_date date
  audit_duration_minutes decimal(9,4) [note: 'Duration of the audit in minutes']
  audit_end_timestamp timestamp [note: 'Timestamp when the audit was completed; used for audit duration and resource planning.']
  audit_pass_flag boolean [note: 'Re-derived attribute added during thin-product expansion based on business context for supply.location_audit.']
  audit_report_url varchar [note: 'URL or path to detailed audit report document']
  audit_result varchar [note: 'Overall audit result (pass, pass with findings, fail)']
  audit_scope varchar [note: 'Scope of audit (all items, high-value items, controlled substances, expired items, specific material category)']
  audit_start_timestamp timestamp [note: 'Timestamp when the audit began; used for audit duration calculation and scheduling.']
  audit_status varchar [note: 'Current status of the audit (e.g., scheduled, in progress, completed, findings pending review).']
  audit_type varchar [note: 'Type of inventory audit (e.g., cycle count, full physical, spot check, regulatory, expiration review).']
  auditor_notes varchar
  auditor_signature_date date [note: 'Re-derived attribute added during thin-product expansion based on business context for supply.location_audit.']
  compliance_score decimal(5,2)
  controlled_substance_audit_flag boolean [note: 'Flag indicating whether controlled substances were included in this audit']
  controlled_substance_discrepancy_flag boolean [note: 'Flag indicating whether controlled substance discrepancies were found']
  controlled_substance_discrepancy_reported_flag boolean [note: 'Flag indicating whether controlled substance discrepancies were reported to regulatory authorities']
  corrective_action_completed_date date
  corrective_action_due_date date [note: 'Due date for corrective action']
  corrective_action_required_flag boolean [note: 'Flag indicating whether corrective action is required']
  created_timestamp timestamp [note: 'Timestamp when the audit record was created.']
  critical_findings_count varchar [note: 'Number of critical findings (e.g., expired controlled substances, recalled items in use, temperature excursions).']
  damaged_items_count varchar [note: 'Number of damaged items found']
  damaged_items_value decimal(15,2) [note: 'Total dollar value of damaged items']
  discrepancies_found_count varchar [note: 'Number of discrepancies found']
  discrepancy_count varchar [note: 'Number of items where physical count did not match system inventory balance.']
  discrepancy_items_count varchar [note: 'Number of items with discrepancies found']
  discrepancy_rate decimal(7,4) [note: 'Percentage of items with discrepancies']
  discrepancy_value decimal(18,2) [note: 'Total dollar value of inventory discrepancies identified during the audit.']
  documentation_compliance_flag boolean [note: 'Whether documentation is complete and compliant']
  documentation_compliant_flag boolean [note: 'Flag indicating whether required documentation (logs, records) was complete']
  expired_items_count varchar [note: 'Number of expired items found during the audit, critical for patient safety and regulatory compliance.']
  expired_items_found varchar [note: 'Number of expired items discovered during audit']
  expired_items_value decimal(15,2) [note: 'Total dollar value of expired items']
  findings_count varchar
  follow_up_due_date date [note: 'Date by which follow-up actions must be completed; used for corrective action tracking.']
  follow_up_required boolean
  inventory_variance_amount decimal(18,2) [note: 'Total dollar value of inventory variance identified during the audit; used for shrinkage and loss reporting.']
  items_audited_count varchar [note: 'Total number of distinct items (SKUs) audited during this audit; used for audit completeness tracking.']
  items_counted varchar [note: 'Number of distinct items counted during audit']
  items_with_discrepancy_count varchar [note: 'Number of items with inventory discrepancies']
  labeling_compliance_flag boolean [note: 'Indicates whether all items were properly labeled with UDI, lot number, and expiration date per regulatory requirements.']
  labeling_compliant_flag boolean [note: 'Flag indicating whether items were properly labeled']
  location_status_at_audit varchar
  net_variance_value decimal(18,2) [note: 'Re-derived attribute added during thin-product expansion based on business context for supply.location_audit.']
  next_audit_date date
  organization_compliant_flag boolean [note: 'Flag indicating whether location organization and cleanliness were compliant']
  overage_value decimal(15,2) [note: 'Total dollar value of inventory overages']
  par_level_compliance_flag boolean [note: 'Whether inventory levels meet established par levels']
  re_audit_due_date date [note: 'Due date for re-audit']
  re_audit_required_flag boolean [note: 'Whether re-audit is required']
  recall_items_found varchar [note: 'Number of recalled items discovered during audit']
  recalled_items_count varchar [note: 'Number of recalled items found that should have been removed']
  recalled_items_found_count varchar [note: 'Number of recalled items identified during the audit that should have been removed from inventory.']
  recalled_items_found_flag boolean [note: 'Indicates whether any recalled items were found during the audit; triggers immediate corrective action.']
  recalled_items_value decimal(15,2) [note: 'Total dollar value of recalled items found']
  regulatory_report_date date [note: 'Date discrepancies were reported to regulatory agency']
  regulatory_report_reference_number varchar [note: 'Reference number from regulatory agency']
  regulatory_reportable_flag boolean [note: 'Whether findings must be reported to regulatory body']
  regulatory_requirement_met_flag boolean [note: 'Whether the location meets all applicable regulatory storage and inventory requirements.']
  security_compliance_flag boolean [note: 'Whether security controls are adequate (locked storage, access logs)']
  security_compliant_flag boolean [note: 'Flag indicating whether security controls (locks, access logs) were compliant']
  shortage_value decimal(15,2) [note: 'Total dollar value of inventory shortages']
  storage_compliance_flag boolean [note: 'Indicates whether items were stored according to manufacturer and regulatory requirements.']
  storage_condition_compliant_flag boolean [note: 'Flag indicating whether storage conditions (temperature, humidity, security) were compliant']
  storage_condition_notes varchar [note: 'Notes on storage conditions observed (temperature, humidity, organization, cleanliness).']
  temperature_compliance_flag boolean [note: 'Indicates whether temperature-sensitive storage areas were within required ranges during the audit period.']
  temperature_compliant_flag boolean [note: 'Whether storage temperature requirements were met at the time of audit (critical for biologics, reagents).']
  temperature_log_compliant_flag boolean [note: 'Flag indicating whether temperature logs were complete and within range']
  total_discrepancy_value decimal(15,2) [note: 'Total dollar value of inventory discrepancies (positive for overages, negative for shortages)']
  total_items_counted varchar [note: 'Total number of distinct items physically counted during the audit.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the audit record.']
  variance_amount decimal(18,2) [note: 'Total dollar variance identified during audit']
  variance_percentage decimal(5,2) [note: 'Variance as percentage of expected inventory value']
  variance_units varchar [note: 'Total unit count variance identified during audit']
  vibe_enriched_flag boolean [note: 'Re-derived attribute added during thin-product expansion based on business context for supply.location_audit.']

  Note: 'Inventory location audit: re-derived from business context to track physical count audits, variance/discrepancy valuation, expired/recalled/damaged item findings, storage/temperature/security/labeling compliance, controlled-substance discrepancy reporting, corrective-action linkage, and re-audit scheduling for supply chain governance.'
}

Table supply.material_policy_governance {
  material_policy_governance_id varchar [pk]
  approver_employee_id varchar [note: 'Employee ID of the person who approved the governance decision']
  care_site_id varchar [note: 'Facility where the material policy governance applies, supporting site-specific policy enforcement.']
  compliance_policy_id varchar
  contract_id varchar [note: 'Contract governing this material']
  material_approved_by_employee_id varchar [note: 'Employee who approved exception or compliance']
  material_master_id varchar [note: 'Recommended alternative material if this one is restricted']
  material_policy_owner_employee_id varchar [note: 'Employee who owns or is responsible for this policy']
  material_preferred_vendor_id varchar [note: 'Preferred vendor for this material under this policy']
  material_vendor_id varchar [note: 'Vendor associated with the governed material, linking supply chain governance to vendor management.']
  primary_material_master_id varchar
  recall_notice_id varchar [note: 'Foreign key to recall notice']
  reviewer_employee_id varchar [note: 'FK to the employee responsible for reviewing and maintaining this governance record.']
  superseded_by_material_policy_governance_id varchar [note: 'ID of governance record that supersedes this one']
  tertiary_material_master_id varchar [note: 'Foreign key to preferred alternative material if this material is restricted']
  value_analysis_committee_id varchar [note: 'Value analysis committee that reviewed this material']
  vendor_contract_id varchar [note: 'FK to the vendor contract associated with this material; links governance to contractual obligations.']
  annual_spend_threshold decimal(18,2) [note: 'Dollar threshold above which additional governance controls are triggered for this material.']
  approval_authority varchar [note: 'Authority required for approval (department chair, value analysis committee, pharmacy & therapeutics committee, chief medical officer)']
  approval_authority_role varchar [note: 'Role or committee that must approve exceptions or purchases of this governed material.']
  approval_criteria varchar [note: 'Criteria that must be met for approval']
  approval_date date [note: 'Date approval was granted']
  approval_required_flag boolean [note: 'Whether purchasing this material requires additional approval beyond standard procurement workflow.']
  approval_status varchar [note: 'Approval state of the governance decision (e.g. draft, approved, rejected, retired).']
  approval_threshold_amount decimal(18,2) [note: 'Dollar threshold above which approval is required']
  clinical_equivalence_flag boolean [note: 'Flag indicating whether preferred alternative is clinically equivalent']
  clinical_evidence_reference varchar [note: 'Reference to clinical evidence or value analysis committee decision supporting the governance policy.']
  clinical_evidence_summary varchar [note: 'Summary of clinical evidence supporting policy decision']
  compliance_score decimal(5,2) [note: 'Re-derived attribute added during thin-product expansion based on business context for supply.material_policy_governance.']
  compliance_status varchar
  contract_compliance_flag boolean [note: 'Whether material is compliant with GPO or system contracts']
  controlled_substance_flag boolean [note: 'Indicates this material is a DEA-scheduled controlled substance; triggers DEA 222 and PDMP reporting requirements.']
  corrective_action_completed_date date [note: 'Date corrective actions were completed and verified.']
  corrective_action_due_date date [note: 'Date by which corrective actions must be completed.']
  corrective_action_required_flag boolean [note: 'Indicates whether a corrective action is required to bring this material into compliance.']
  cost_comparison_preferred_vs_restricted decimal(15,2) [note: 'Cost difference between preferred alternative and restricted material']
  cost_impact_category varchar [note: 'Classification of cost impact (e.g., high-cost, physician preference item, commodity, strategic).']
  created_timestamp timestamp [note: 'Timestamp when the governance record was created for lineage and audit tracking.']
  effective_date date
  environmental_impact_rating varchar [note: 'Environmental impact rating (low, medium, high)']
  environmental_sustainability_flag boolean [note: 'Flag indicating whether policy is related to environmental sustainability goals']
  exception_approved_by varchar [note: 'Name or employee ID of the authority who approved the exception; supports governance accountability.']
  exception_expiration_date decimal(9,4) [note: 'Date the policy exception expires; triggers re-evaluation or corrective action.']
  exception_flag boolean
  exception_justification varchar
  expiration_date decimal(9,4) [note: 'Date when the governance policy expires and must be renewed or reviewed.']
  formulary_restricted_flag boolean [note: 'Indicates this material is subject to formulary restriction; requires P&T committee approval for use.']
  formulary_status varchar [note: 'Formulary status (on-formulary, non-formulary, conditional)']
  governance_category varchar [note: 'Category of governance (e.g., Regulatory Compliance, Formulary Control, Recall Management, Hazardous Material, Controlled Substance, Single-Use Device).']
  governance_level varchar [note: 'Organizational level at which the policy is enforced (e.g., enterprise, region, facility, department).']
  governance_notes varchar
  hazardous_material_flag boolean [note: 'Indicates this material is classified as hazardous; triggers OSHA HazCom and EPA waste disposal requirements.']
  last_audit_date date [note: 'Date of the most recent compliance audit covering this material-policy linkage.']
  last_override_date date [note: 'Date of most recent policy override']
  last_violation_date date [note: 'Re-derived attribute added during thin-product expansion based on business context for supply.material_policy_governance.']
  material_category varchar [note: 'Category of material (implant, surgical supply, pharmaceutical, diagnostic, durable medical equipment)']
  monitoring_frequency varchar [note: 'Cadence at which compliance against the policy is monitored (e.g. monthly, quarterly, annual).']
  next_review_date date
  override_allowed_flag boolean [note: 'Flag indicating whether policy can be overridden']
  override_count varchar [note: 'Number of times policy has been overridden for this material']
  policy_category varchar [note: 'Category of policy (clinical appropriateness, cost control, safety, regulatory, environmental)']
  policy_effective_date date [note: 'Date policy became effective']
  policy_enforcement_method varchar [note: 'Method of policy enforcement (system hard stop, soft alert, post-use review, periodic audit)']
  policy_expiration_date decimal(9,4) [note: 'Date policy expires or is scheduled for review']
  policy_requirement varchar [note: 'Specific policy requirement or restriction']
  policy_type varchar [note: 'Type of governance policy (e.g., formulary restriction, value analysis, standardization, recall response, sustainability).']
  policy_version varchar [note: 'Version of the compliance policy applied; supports policy change impact analysis.']
  recall_flag boolean [note: 'Flag indicating whether material is subject to recall']
  regulatory_body varchar [note: 'Regulatory or accrediting body whose requirements govern this material (e.g., FDA, DEA, Joint Commission, EPA, OSHA).']
  regulatory_classification varchar [note: 'Regulatory classification of the material driving governance scope (e.g. hazardous, controlled, implantable).']
  regulatory_compliance_flag boolean [note: 'Whether material meets regulatory requirements (FDA, EPA, OSHA)']
  regulatory_reference varchar [note: 'Reference to regulatory requirement driving this governance']
  restriction_level varchar [note: 'Level of restriction on material usage (unrestricted, limited, restricted, prohibited)']
  restriction_reason varchar [note: 'Reason for restriction (cost, safety concern, recall, formulary non-compliance, clinical evidence insufficient)']
  restriction_type varchar [note: 'Type of restriction (prohibited, restricted to specific indications, requires approval, preferred alternative available)']
  review_date date
  review_outcome varchar [note: 'Re-derived attribute added during thin-product expansion based on business context for supply.material_policy_governance.']
  reviewer_role varchar
  risk_level varchar [note: 'Assessed governance risk level for the material-policy linkage (e.g. low, medium, high).']
  safety_alert_date date [note: 'Date safety alert was issued']
  safety_alert_flag boolean [note: 'Flag indicating whether a safety alert is associated with this material']
  safety_alert_source varchar [note: 'Source of safety alert (FDA, manufacturer, internal quality review)']
  single_use_only_flag boolean [note: 'Indicates this is a single-use device; reprocessing is prohibited per FDA and Joint Commission requirements.']
  substitution_allowed_flag boolean [note: 'Whether an approved substitute material may be used in place of this item.']
  sustainability_criteria varchar [note: 'Sustainability criteria (recyclable, reduced packaging, lower carbon footprint, reusable)']
  udi_required_flag boolean [note: 'Indicates whether FDA UDI (Unique Device Identifier) tracking is required for this material.']
  updated_timestamp timestamp [note: 'Timestamp when the governance record was last updated for lineage and audit tracking.']
  utilization_monitoring_flag boolean [note: 'Flag indicating whether utilization is actively monitored']
  utilization_target varchar [note: 'Target utilization level or reduction goal']
  utilization_variance_threshold decimal(7,4) [note: 'Threshold for utilization variance that triggers review']
  value_analysis_committee_review_date date [note: 'Date material was reviewed by value analysis committee']
  value_analysis_date date [note: 'Date of value analysis review']
  value_analysis_recommendation varchar [note: 'Recommendation from value analysis committee']
  value_analysis_score decimal(5,2) [note: 'Value analysis score (clinical efficacy, cost, safety composite)']
  vibe_enriched_flag boolean [note: 'Re-derived attribute added during thin-product expansion based on business context for supply.material_policy_governance.']

  Note: 'Material-level policy governance records linking materials to compliance policies (e.g., controlled substance, hazmat, formulary). Supports exception tracking, policy compliance monitoring, and regulatory audit trail.'
}

Table supply.vendor_site {
  vendor_site_id varchar [pk, note: 'Surrogate primary key for vendor_site']
