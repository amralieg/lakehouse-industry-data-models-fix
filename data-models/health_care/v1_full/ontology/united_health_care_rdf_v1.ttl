ind:serviceLevelTargetSeconds rdf:type rdf:Property ;
    rdfs:label 'Service Level Target Seconds' ;
    rdfs:comment 'Target time in seconds within which a specified percentage of interactions should be answered (e.g., 80% in 20 seconds).' ;
    rdfs:domain ind:Queue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceLevelTargetPercentage rdf:type rdf:Property ;
    rdfs:label 'Service Level Target Percentage' ;
    rdfs:comment 'Target percentage of interactions that should be answered within the service level target time (e.g., 80%).' ;
    rdfs:domain ind:Queue ;
