ind:relatedEntityId rdf:type rdf:Property ;
    rdfs:label 'Related Entity Id' ;
    rdfs:comment 'System identifier of the entity (provider, member, facility) referenced in the case note.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedEntityName rdf:type rdf:Property ;
    rdfs:label 'Related Entity Name' ;
    rdfs:comment 'Name of the entity (provider, member, facility) referenced in the case note.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimCount rdf:type rdf:Property ;
    rdfs:label 'Claim Count' ;
    rdfs:comment 'Number of claims referenced or discussed in the case note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:potentialOverpaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Potential Overpayment Amount' ;
    rdfs:comment 'Estimated dollar amount of potential overpayment identified in the investigation as documented in the case note.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
