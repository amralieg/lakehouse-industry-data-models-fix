  modified_by varchar [note: 'The user ID or name of the person who last modified this source document record. | Column modified_by (STRING) in finance.source_document']
  modified_timestamp timestamp [note: 'The date and time when this source document record was last modified in the system. | Column modified_timestamp (TIMESTAMP) in finance.source_document']
  net_amount decimal(18,2) [note: 'The net amount of the source document after applying all taxes, discounts, and adjustments. | Column net_amount (DECIMAL(18,2)) in finance.source_document']
  payment_terms varchar [note: 'The payment terms code or description specifying the due date calculation and discount conditions for this source document. | Column payment_terms (STRING) in finance.source_document']
  posting_date date [note: 'The date the source document was posted to the general ledger, determining the fiscal period for financial reporting. | Column posting_date (DATE) in finance.source_document']
  reference_number varchar [note: 'External reference number or identifier provided by the counterparty (e.g., vendor invoice number, customer purchase order number) for cross-reference and reconciliation. | Column reference_number (STRING) in finance.source_document']
  reversal_date date [note: 'The date on which this source document was reversed, if applicable. | Column reversal_date (DATE) in finance.source_document']
  reversal_indicator boolean [note: 'Boolean flag indicating whether this source document has been reversed or cancelled. | Column reversal_indicator (BOOLEAN) in finance.source_document']
  reversal_reason varchar [note: 'Free-text explanation or code indicating the reason for reversing this source document. | Column reversal_reason (STRING) in finance.source_document']
  source_document_description varchar [note: 'Free-text description or header text providing additional context and details about the source document. | Column description (STRING) in finance.source_document']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.source_document']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.source_document']
  tax_amount decimal(18,2) [note: 'The total tax amount associated with the source document, including sales tax, VAT, or other applicable taxes. | Column tax_amount (DECIMAL(18,2)) in finance.source_document']
  trading_partner_code varchar [note: 'The company code of the intercompany trading partner for intercompany transactions. | Column trading_partner_code (STRING) in finance.source_document']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.source_document']
  created_by varchar [note: 'The user ID or name of the person who created this source document record in the system. | Column created_by (STRING) in finance.source_document']

  Note: 'Master reference table for source_document. Referenced by source_document_id. | Unity Catalog table: media_broadcasting_ecm.finance.source_document SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.depreciation_schedule {
  depreciation_schedule_id varchar [pk, note: 'Primary key for depreciation_schedule | Column depreciation_schedule_id (BIGINT) in finance.depreciation_schedule']
  cost_center_id varchar [note: 'Reference to the cost center that bears the depreciation expense. Used for management accounting and departmental cost allocation. | Column cost_center_id (BIGINT) in finance.depreciation_schedule']
  fixed_asset_id varchar [note: 'Reference to the fixed asset being depreciated. Links to the asset master record for equipment, facilities, broadcast infrastructure, or production equipment. | Column asset_id (BIGINT) in finance.depreciation_schedule']
  revised_depreciation_schedule_id varchar [note: 'Self-referencing FK on depreciation_schedule (revised_depreciation_schedule_id) | Column revised_depreciation_schedule_id (BIGINT) in finance.depreciation_schedule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.depreciation_schedule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.depreciation_schedule']
  accumulated_depreciation decimal(18,2) [note: 'The total depreciation expense recognized to date since the asset was placed in service. Contra-asset account balance. | Column accumulated_depreciation (DECIMAL(18,2)) in finance.depreciation_schedule']
  annual_depreciation_amount decimal(18,2) [note: 'The calculated annual depreciation expense for this asset under the specified depreciation method. Used for budgeting and forecasting. | Column annual_depreciation_amount (DECIMAL(18,2)) in finance.depreciation_schedule']
  approval_date date [note: 'The date when this depreciation schedule was approved. Part of the audit trail for financial controls. | Column approval_date (DATE) in finance.depreciation_schedule']
  approval_status varchar [note: 'The approval workflow status for this depreciation schedule. Ensures proper authorization before depreciation posting. | Column approval_status (STRING) in finance.depreciation_schedule']
  approved_by varchar [note: 'The user ID or name of the person who approved this depreciation schedule. Used for audit trail and accountability. | Column approved_by (STRING) in finance.depreciation_schedule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.depreciation_schedule']
  created_timestamp timestamp [note: 'The date and time when this depreciation schedule record was first created in the system. Part of the audit trail. | Column created_timestamp (TIMESTAMP) in finance.depreciation_schedule']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this schedule. Ensures consistent currency treatment across multi-currency operations. | Column currency_code (STRING) in finance.depreciation_schedule']
  depreciable_base decimal(18,2) [note: 'The amount subject to depreciation, calculated as original cost minus salvage value. The total amount to be expensed over the asset\'s useful life. | Column depreciable_base (DECIMAL(18,2)) in finance.depreciation_schedule']
  depreciation_book_type varchar [note: 'The accounting book or ledger for which this depreciation schedule applies. Supports parallel depreciation for different reporting frameworks. | Column depreciation_book_type (STRING) in finance.depreciation_schedule']
  depreciation_method varchar [note: 'The accounting method used to calculate depreciation expense over the asset\'s useful life. Determines the pattern of expense recognition. | Column depreciation_method (STRING) in finance.depreciation_schedule']
  depreciation_rate_percent decimal(5,2) [note: 'The percentage rate applied to calculate depreciation, particularly for declining balance methods. Expressed as a percentage. | Column depreciation_rate_percent (DECIMAL(5,2)) in finance.depreciation_schedule']
  depreciation_schedule_status varchar [note: 'Current lifecycle status of the depreciation schedule. Indicates whether depreciation is actively being calculated and posted. | Column status (STRING) in finance.depreciation_schedule']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_end_date date [note: 'The date when depreciation ends for this asset. May be the end of useful life, disposal date, or full depreciation date. Nullable for active schedules. | Column effective_end_date (DATE) in finance.depreciation_schedule']
  effective_start_date date [note: 'The date when depreciation begins for this asset. Typically the asset\'s placed-in-service date or acquisition date. | Column effective_start_date (DATE) in finance.depreciation_schedule']
  fiscal_year varchar [note: 'The fiscal year for which this depreciation schedule is effective. Supports year-specific depreciation calculations and reporting. | Column fiscal_year (INT) in finance.depreciation_schedule']
  general_ledger_account_code varchar [note: 'The chart of accounts code for posting depreciation expense. Links to the GL account master for financial statement classification. | Column general_ledger_account_code (STRING) in finance.depreciation_schedule']
  impairment_amount decimal(18,2) [note: 'The amount of impairment loss recognized, reducing the carrying value of the asset. Nullable if no impairment has occurred. | Column impairment_amount (DECIMAL(18,2)) in finance.depreciation_schedule']
  impairment_date date [note: 'The date when an impairment loss was recognized for this asset. Nullable if no impairment has occurred. | Column impairment_date (DATE) in finance.depreciation_schedule']
  impairment_indicator boolean [note: 'Flag indicating whether the asset has been tested for impairment or shows indicators of impairment. Triggers impairment review processes. | Column impairment_indicator (BOOLEAN) in finance.depreciation_schedule']
  last_depreciation_run_date date [note: 'The date when depreciation was last calculated and posted for this schedule. Used to track period-end close activities. | Column last_depreciation_run_date (DATE) in finance.depreciation_schedule']
  modified_by varchar [note: 'The user ID or name of the person who last modified this depreciation schedule. Supports audit trail and change tracking. | Column modified_by (STRING) in finance.depreciation_schedule']
  modified_timestamp timestamp [note: 'The date and time when this depreciation schedule record was last modified. Tracks changes for audit and compliance purposes. | Column modified_timestamp (TIMESTAMP) in finance.depreciation_schedule']
  net_book_value decimal(18,2) [note: 'The current carrying value of the asset, calculated as original cost minus accumulated depreciation. Represents the undepreciated balance. | Column net_book_value (DECIMAL(18,2)) in finance.depreciation_schedule']
  next_depreciation_run_date date [note: 'The scheduled date for the next depreciation calculation. Used for planning period-end close and financial reporting cycles. | Column next_depreciation_run_date (DATE) in finance.depreciation_schedule']
  notes varchar [note: 'Free-text field for additional comments, explanations, or special instructions related to this depreciation schedule. | Column notes (STRING) in finance.depreciation_schedule']
  original_cost decimal(18,2) [note: 'The initial acquisition or construction cost of the asset, including all costs necessary to bring the asset to its intended use. | Column original_cost (DECIMAL(18,2)) in finance.depreciation_schedule']
  salvage_value decimal(18,2) [note: 'The estimated residual value of the asset at the end of its useful life. The amount expected to be recovered through sale or disposal. | Column salvage_value (DECIMAL(18,2)) in finance.depreciation_schedule']
  schedule_number varchar [note: 'Business identifier for the depreciation schedule. Externally visible reference number used in financial reporting and audit trails. | Column schedule_number (STRING) in finance.depreciation_schedule']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.depreciation_schedule']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.depreciation_schedule']
  sox_control_flag boolean [note: 'Indicates whether this depreciation schedule is subject to SOX internal control testing and audit requirements. | Column sox_control_flag (BOOLEAN) in finance.depreciation_schedule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.depreciation_schedule']
  useful_life_units varchar [note: 'The estimated total production capacity or usage units over the asset\'s life. Used for units-of-production depreciation method. Nullable for time-based methods. | Column useful_life_units (BIGINT) in finance.depreciation_schedule']
  useful_life_years decimal(5,2) [note: 'The estimated economic useful life of the asset in years. Used to calculate annual depreciation expense under time-based methods. | Column useful_life_years (DECIMAL(5,2)) in finance.depreciation_schedule']

  Note: 'Master reference table for depreciation_schedule. Referenced by depreciation_schedule_id. | Unity Catalog table: media_broadcasting_ecm.finance.depreciation_schedule SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

