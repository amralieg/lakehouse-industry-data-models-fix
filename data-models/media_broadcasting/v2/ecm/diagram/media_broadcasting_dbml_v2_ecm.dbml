  created_timestamp timestamp [note: 'Timestamp when the clearance record was first created in the system. | Column created_timestamp (TIMESTAMP) in talent.talent_clearance']
  exclusivity_conflict_flag boolean [note: 'Indicates whether the requested usage conflicts with existing exclusivity clauses in the talent contract. | Column exclusivity_conflict_flag (BOOLEAN) in talent.talent_clearance']
  expiry_date date [note: 'Date when the granted clearance expires and usage rights are no longer valid. | Column expiry_date (DATE) in talent.talent_clearance']
