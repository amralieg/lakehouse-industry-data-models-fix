    rdfs:range xsd:boolean .

ind:actuaryCredentials rdf:type rdf:Property ;
    rdfs:label 'Actuary Credentials' ;
    rdfs:comment 'Professional credentials of the certifying actuary (e.g., FSA, FCAS, MAAA).' ;
