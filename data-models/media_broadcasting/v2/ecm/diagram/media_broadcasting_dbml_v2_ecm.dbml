  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Syndication fees attributed to content licensing or distribution cost centers for cost tracking and departmental P&L. Enables studios to track licensing revenue against content acquisition and distrib | Column cost_center_id (BIGINT) in finance.syndication_license_fee']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Syndication license fee results in ONE invoice. Currently stores invoice_number and invoice_date as STRING/DATE; need FK to the master invoice record. Remove invoice_number and invoice_date as they ca | Column invoice_id (BIGINT) in billing.syndication_license_fee']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Syndication license fees are payments made under rights license agreements. The syndication_license_fee product tracks financial transactions for content licensing, and should reference the underlying | Column license_agreement_id (BIGINT) in rights.syndication_license_fee']
  partner_id varchar [note: 'Reference to the content licensee (broadcast station, streaming platform, international distributor) responsible for payment. | Column partner_id (BIGINT) in partner.syndication_license_fee']
  processed_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Syndication license fee processing involves specialized staff managing complex international payments, withholding tax, and rights accounting. Tracking processor employee supports operational oversigh | Column processed_by_employee_id (BIGINT) in workforce.syndication_license_fee']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Syndication fees attributed to profit centers (content divisions, studios) for licensing revenue segment reporting and business unit P&L. Essential for media companies tracking content licensing perfo | Column profit_center_id (BIGINT) in finance.syndication_license_fee']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Syndication fees need revenue stream classification for content licensing revenue reporting, distinct from direct-to-consumer streams. Critical for studios and content producers tracking licensing rev | Column revenue_stream_id (BIGINT) in finance.syndication_license_fee']
  satellite_transponder_id varchar [note: 'Foreign key linking to technology.satellite_transponder. Business justification: Syndication distribution fees tied to specific transponders enable bandwidth cost allocation, territory coverage verification, signal quality SLA tracking, and distribution cost reconciliation in cont | Column satellite_transponder_id (BIGINT) in technology.syndication_license_fee']
