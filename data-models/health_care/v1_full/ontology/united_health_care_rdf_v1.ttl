    rdfs:comment 'Indicates whether cases at this priority level require quality assurance review before closure to ensure compliance and member satisfaction.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supervisorApprovalRequired rdf:type rdf:Property ;
