    rdfs:range xsd:integer .

ind:employeeGroupCode rdf:type rdf:Property ;
    rdfs:label 'Employee Group Code' ;
    rdfs:comment 'Code identifying the employee group or classification to which this payroll calendar applies (e.g., \'RN\', \'ADMIN\', \'PHYSICIAN\').' ;
    rdfs:domain ind:PayrollCalendar ;
