    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:viewQualityRating rdf:type rdf:Property ;
    rdfs:label 'View Quality Rating' ;
    rdfs:comment 'Subjective rating of sightline quality from this zone. Influences pricing and customer satisfaction.' ;
    rdfs:domain ind:PriceZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:willCallEnabled rdf:type rdf:Property ;
    rdfs:label 'Will Call Enabled' ;
    rdfs:comment 'Indicates whether will-call pickup is available for tickets in this zone.' ;
    rdfs:domain ind:PriceZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ageRestrictionRequired rdf:type rdf:Property ;
    rdfs:label 'Age Restriction Required' ;
    rdfs:comment 'Indicates whether age verification is required for items on this menu (typically for alcohol).' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alcoholServiceAvailable rdf:type rdf:Property ;
    rdfs:label 'Alcohol Service Available' ;
    rdfs:comment 'Indicates whether alcoholic beverages are available on this menu.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allergenInformationProvided rdf:type rdf:Property ;
    rdfs:label 'Allergen Information Provided' ;
    rdfs:comment 'Indicates whether allergen information is provided for menu items.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:averageItemPrice rdf:type rdf:Property ;
    rdfs:label 'Average Item Price' ;
    rdfs:comment 'The average price of items on this menu in local currency.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityServiceLevel rdf:type rdf:Property ;
    rdfs:label 'Capacity Service Level' ;
    rdfs:comment 'The expected service capacity level for this menu based on staffing and equipment.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cuisineType rdf:type rdf:Property ;
    rdfs:label 'Cuisine Type' ;
    rdfs:comment 'The style or type of cuisine offered on this menu (e.g., American, Italian, Mexican, Asian Fusion, BBQ).' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryToSeatAvailable rdf:type rdf:Property ;
    rdfs:label 'Delivery To Seat Available' ;
    rdfs:comment 'Indicates whether items from this menu can be delivered directly to fan seats.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dietaryOptionsAvailable rdf:type rdf:Property ;
    rdfs:label 'Dietary Options Available' ;
    rdfs:comment 'Comma-separated list of dietary options offered (e.g., vegetarian, vegan, gluten-free, halal, kosher, dairy-free).' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTypeRestriction rdf:type rdf:Property ;
    rdfs:label 'Event Type Restriction' ;
    rdfs:comment 'Comma-separated list of event types for which this menu is available (e.g., sports, concerts, family_shows). Null if available for all events.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthPermitNumber rdf:type rdf:Property ;
    rdfs:label 'Health Permit Number' ;
    rdfs:comment 'The health department permit number for food service operations associated with this menu.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemCount rdf:type rdf:Property ;
    rdfs:label 'Item Count' ;
    rdfs:comment 'The total number of distinct items available on this menu.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:localSourcingPercentage rdf:type rdf:Property ;
    rdfs:label 'Local Sourcing Percentage' ;
    rdfs:comment 'The percentage of menu ingredients sourced from local suppliers (within defined geographic radius).' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:menuCode rdf:type rdf:Property ;
    rdfs:label 'Menu Code' ;
    rdfs:comment 'The externally-known unique code or identifier for the menu used in point-of-sale and inventory systems.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:menuDescription rdf:type rdf:Property ;
    rdfs:label 'Menu Description' ;
    rdfs:comment 'Detailed description of the menu, its offerings, and unique features.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:menuName rdf:type rdf:Property ;
    rdfs:label 'Menu Name' ;
    rdfs:comment 'The official name of the menu (e.g., Premium Suite Menu, General Concessions, VIP Lounge Menu).' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:menuType rdf:type rdf:Property ;
    rdfs:label 'Menu Type' ;
    rdfs:comment 'Classification of the menu based on service model and venue location.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobileOrderingEnabled rdf:type rdf:Property ;
    rdfs:label 'Mobile Ordering Enabled' ;
    rdfs:comment 'Indicates whether this menu is available for mobile ordering through the venue app.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nutritionalInformationProvided rdf:type rdf:Property ;
    rdfs:label 'Nutritional Information Provided' ;
    rdfs:comment 'Indicates whether nutritional information (calories, fat, sodium, etc.) is provided for menu items.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatingHours rdf:type rdf:Property ;
    rdfs:label 'Operating Hours' ;
    rdfs:comment 'The hours during which this menu is available (e.g., 2 hours before event through end of event, all day).' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointOfSaleSystemCode rdf:type rdf:Property ;
    rdfs:label 'Point Of Sale System Code' ;
    rdfs:comment 'The identifier for the point-of-sale system used to process orders from this menu.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preOrderAvailable rdf:type rdf:Property ;
    rdfs:label 'Pre Order Available' ;
    rdfs:comment 'Indicates whether fans can pre-order from this menu before arriving at the venue.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priceTier rdf:type rdf:Property ;
    rdfs:label 'Price Tier' ;
    rdfs:comment 'The pricing tier classification for items on this menu.' ;
    rdfs:domain ind:Menu ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoGenerateWorkOrders rdf:type rdf:Property ;
    rdfs:label 'Auto Generate Work Orders' ;
    rdfs:comment 'Indicates whether work orders should be automatically created by the system based on the plan schedule, or manually triggered.' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blackoutPeriodRestriction rdf:type rdf:Property ;
    rdfs:label 'Blackout Period Restriction' ;
    rdfs:comment 'Description of time periods when this maintenance cannot be performed due to event schedules or operational constraints (e.g., no maintenance during event days).' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRequired rdf:type rdf:Property ;
    rdfs:label 'Compliance Required' ;
    rdfs:comment 'Indicates whether this maintenance plan is mandated by regulatory or safety compliance requirements (OSHA, ADA, local building codes).' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedCostPerExecution rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Per Execution' ;
    rdfs:comment 'Budgeted cost in USD for a single execution of this maintenance plan, including labor, materials, and vendor fees.' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Duration Minutes' ;
    rdfs:comment 'Expected time in minutes required to complete a single execution of this maintenance plan.' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyInterval rdf:type rdf:Property ;
    rdfs:label 'Frequency Interval' ;
    rdfs:comment 'Numeric interval value used in conjunction with frequency_type to define exact recurrence (e.g., every 2 weeks, every 3 months).' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyType rdf:type rdf:Property ;
    rdfs:label 'Frequency Type' ;
    rdfs:comment 'Recurrence pattern defining how often maintenance activities are scheduled under this plan.' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationLeadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Notification Lead Time Days' ;
    rdfs:comment 'Number of days in advance that responsible parties should be notified before scheduled maintenance execution.' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyRequirements rdf:type rdf:Property ;
    rdfs:label 'Safety Requirements' ;
    rdfs:comment 'Specific safety protocols, personal protective equipment (PPE), or lockout/tagout procedures required for this maintenance activity.' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workInstructions rdf:type rdf:Property ;
    rdfs:label 'Work Instructions' ;
    rdfs:comment 'Step-by-step procedural instructions or reference to standard operating procedures (SOPs) for executing this maintenance plan.' ;
    rdfs:domain ind:MaintenancePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Carrier Policy Number' ;
    rdfs:comment 'Unique policy or contract number assigned by the insurance carrier for this benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinsurancePercentage rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Percentage' ;
    rdfs:comment 'Percentage of costs the employee pays after meeting the deductible. Expressed as a decimal (e.g., 20.00 for 20%).' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionFrequency rdf:type rdf:Property ;
    rdfs:label 'Contribution Frequency' ;
    rdfs:comment 'Frequency at which employee and employer contributions are collected for the benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copayAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Amount' ;
    rdfs:comment 'Fixed dollar amount the employee pays for specific covered services (e.g., doctor visits, prescriptions).' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageLevel rdf:type rdf:Property ;
    rdfs:label 'Coverage Level' ;
    rdfs:comment 'Scope of coverage indicating who is eligible under the plan enrollment.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Period End Date' ;
    rdfs:comment 'End date of the annual open enrollment period when employees can elect or change this benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Period Start Date' ;
    rdfs:comment 'Start date of the annual open enrollment period when employees can elect or change this benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isCobraEligible rdf:type rdf:Property ;
    rdfs:label 'Is Cobra Eligible' ;
    rdfs:comment 'Indicates whether this benefit plan is eligible for COBRA continuation coverage after employment termination.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFsaEligible rdf:type rdf:Property ;
    rdfs:label 'Is Fsa Eligible' ;
    rdfs:comment 'Indicates whether this benefit plan allows employees to contribute to a Flexible Spending Account for eligible expenses.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHsaEligible rdf:type rdf:Property ;
    rdfs:label 'Is Hsa Eligible' ;
    rdfs:comment 'Indicates whether this benefit plan qualifies as a high-deductible health plan eligible for HSA contributions.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextComplianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Compliance Review Date' ;
    rdfs:comment 'Scheduled date for the next regulatory compliance review of this benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outOfPocketMaximum rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Maximum' ;
    rdfs:comment 'Maximum annual amount the employee pays for covered services before the plan pays 100%. Applicable to health plans.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planAdministratorEmail rdf:type rdf:Property ;
    rdfs:label 'Plan Administrator Email' ;
    rdfs:comment 'Email address of the plan administrator for employee inquiries and plan management communications.' ;
