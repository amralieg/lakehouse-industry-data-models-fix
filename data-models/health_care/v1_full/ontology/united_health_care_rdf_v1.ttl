ind:oopMaxIndividual rdf:type rdf:Property ;
    rdfs:label 'Oop Max Individual' ;
    rdfs:comment 'The maximum Out of Pocket (OOP) amount the individual member will pay in a plan year, after which the plan pays 100% of covered services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
