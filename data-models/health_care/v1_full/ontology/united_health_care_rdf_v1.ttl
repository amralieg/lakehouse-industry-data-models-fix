    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualityMetricsReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Quality Metrics Review Status' ;
    rdfs:comment 'The status of quality metrics review for this re-credentialing event.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMetricsReviewDate rdf:type rdf:Property ;
    rdfs:label 'Quality Metrics Review Date' ;
    rdfs:comment 'The date when quality metrics were reviewed for this re-credentialing event.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complaintsReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Complaints Review Status' ;
    rdfs:comment 'The status of member complaints review for this re-credentialing event.' ;
