ind:caqhVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Caqh Verification Status' ;
    rdfs:comment 'Status of the verification of provider credentials through the CAQH ProView database.' ;
    rdfs:domain ind:CredentialingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSanctionsStatus rdf:type rdf:Property ;
    rdfs:label 'State Sanctions Status' ;
    rdfs:comment 'Status indicating whether the provider has been screened for state-level sanctions or disciplinary actions.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
