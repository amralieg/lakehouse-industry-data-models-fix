ind:audienceReachType rdf:type rdf:Property ;
    rdfs:label 'Audience Reach Type' ;
    rdfs:comment 'Primary audience reach channel for this inventory category: in-venue (live attendees), broadcast (TV/radio), digital (online/mobile), hybrid (multiple channels), or global (worldwide distribution).' ;
    rdfs:domain ind:InventoryCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:categoryRestrictions rdf:type rdf:Property ;
