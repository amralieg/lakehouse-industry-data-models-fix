facility,site_management,unit,negative_pressure_room_count,negative_pressure_room_count,Negative Pressure Room Count,INT,,,,,master_data,"Number of negative pressure (airborne infection isolation) rooms within the unit, used for patients with airborne infectious diseases such as tuberculosis, measles, or COVID-19. Subset of isolation rooms.",
facility,site_management,unit,nurse_call_system_type,nurse_call_system_type,Nurse Call System Type,STRING,,,,,master_data,"Type of nurse call system installed in the unit, such as Wired Pillow Speaker, Wireless Badge System, Integrated EMR Alert System, or Mobile App-Based. Used for patient safety and response time monitoring.",
facility,site_management,unit,nurse_to_patient_ratio,nurse_to_patient_ratio,Nurse to Patient Ratio,STRING,,,,"^1:[0-9]{1,2}$",master_data,"Target nurse-to-patient staffing ratio for the unit, expressed as 1:X (e.g., 1:2 for ICU, 1:4 for step-down, 1:6 for med-surg). Used for staffing planning and quality benchmarking.",
facility,site_management,unit,operational_hours_end,operational_hours_end,Operational Hours End Time,STRING,,,,^([01][0-9]|2[0-3]):[0-5][0-9]$,master_data,"Daily end time for unit operations in HH:MM 24-hour format. For 24/7 units, this is typically 23:59. For outpatient or procedural units, this reflects scheduled closing time.",
facility,site_management,unit,operational_hours_start,operational_hours_start,Operational Hours Start Time,STRING,,,,^([01][0-9]|2[0-3]):[0-5][0-9]$,master_data,"Daily start time for unit operations in HH:MM 24-hour format. For 24/7 units (ICU, ED), this is typically 00:00. For outpatient or procedural units, this reflects scheduled opening time.",
facility,site_management,unit,revenue_center_code,revenue_center_code,Revenue Center Code,STRING,,,,^[0-9]{4}$,master_data,"Four-digit revenue center code used on UB-04 claims for billing and reimbursement. Maps to CMS revenue code standards (e.g., 0100-0219 for room and board, 0300-0329 for laboratory).",
facility,site_management,unit,specialty_service_line,specialty_service_line,Specialty Service Line,STRING,,,,,master_data,"Clinical specialty or service line associated with the unit, such as Cardiology, Oncology, Pediatrics, Orthopedics, Neurology, General Surgery, Obstetrics, or Behavioral Health. Supports clinical analytics and resource planning.",
facility,site_management,unit,square_footage,square_footage,Square Footage,"DECIMAL(10,2)",,,,,master_data,"Total square footage of the units physical space. Used for facility planning, space utilization analysis, and environmental services scheduling.",
facility,site_management,unit,staffed_bed_count,staffed_bed_count,Staffed Bed Count,INT,,,,,master_data,Number of beds currently staffed and available for patient occupancy. Staffed bed count is typically less than or equal to licensed bed count and reflects actual operational capacity based on workforce availability.,
facility,site_management,unit,stroke_center_designation,stroke_center_designation,Stroke Center Designation,STRING,,,,comprehensive|primary|acute_ready|not_designated,master_data,"Stroke center certification level for units providing acute stroke care. Comprehensive (highest), primary, acute stroke ready, or not designated. Impacts patient routing and quality reporting.",
facility,site_management,unit,teaching_unit_flag,teaching_unit_flag,Teaching Unit Flag,BOOLEAN,,,,,master_data,"Boolean flag indicating whether the unit is designated as a teaching unit where medical residents, fellows, nursing students, or other trainees receive clinical education. Impacts staffing models and documentation requirements.",
facility,site_management,unit,telemetry_monitoring_capability,telemetry_monitoring_capability,Telemetry Monitoring Capability Flag,BOOLEAN,,,,,master_data,"Boolean flag indicating whether the unit has continuous cardiac telemetry monitoring capability. True for ICU, CCU, step-down, and telemetry units. False for general med-surg and outpatient units.",
facility,site_management,unit,trauma_level,trauma_level,Trauma Level Designation,STRING,,,,level_1|level_2|level_3|level_4|not_applicable,master_data,"Trauma center level designation for Emergency Department (ED) units. Level 1 is highest capability (comprehensive trauma care), Level 4 is basic. Not applicable for non-ED units.",
facility,site_management,unit,unit_code,unit_code,Unit Code,STRING,,,,"^[A-Z0-9]{2,10}$",master_data,"Short alphanumeric code used to identify the unit in operational systems, scheduling, and Admit Discharge Transfer (ADT) workflows. Typically 2-10 characters.",
facility,site_management,unit,unit_name,unit_name,Unit Name,STRING,,,,,master_data,"Full descriptive name of the unit, such as Medical Surgical Floor 3 West, Intensive Care Unit (ICU) North, Emergency Department (ED) Main, or Operating Room (OR) Suite B.",
facility,site_management,unit,unit_status,unit_status,Unit Operational Status,STRING,,,,active|inactive|under_construction|temporarily_closed|decommissioned,master_data,Current operational status of the unit. Active units are open and accepting patients. Inactive or temporarily closed units are not operational. Under construction units are being built or renovated. Decommissioned units are permanently closed.,
facility,site_management,unit,unit_type,unit_type,Unit Type,STRING,,,,inpatient|outpatient|procedural|diagnostic|administrative|support,master_data,"High-level classification of the units operational purpose: inpatient (patient stays overnight), outpatient (same-day care), procedural (OR, cath lab), diagnostic (radiology, lab), administrative (offices), or support (pharmacy, supply).",
facility,site_management,unit,wing_or_section,wing_or_section,Wing or Section,STRING,,,,,master_data,"Wing, section, or zone designation within the floor, such as North, South, East, West, Tower A, Pavilion B. Used for wayfinding and spatial organization.",
