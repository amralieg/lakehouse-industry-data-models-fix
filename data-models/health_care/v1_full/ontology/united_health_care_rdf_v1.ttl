ind:eftEnrollmentFlag rdf:type rdf:Property ;
    rdfs:label 'Eft Enrollment Flag' ;
    rdfs:comment 'Indicates whether the provider is enrolled to receive payments via electronic funds transfer.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eraEnrollmentFlag rdf:type rdf:Property ;
    rdfs:label 'Era Enrollment Flag' ;
    rdfs:comment 'Indicates whether the provider is enrolled to receive electronic remittance advice for claim payments.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acoParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Aco Participation Flag' ;
    rdfs:comment 'Indicates whether the provider participates in an Accountable Care Organization arrangement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accountableCareOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Accountable Care Organization Id' ;
    rdfs:comment 'Unique identifier for the Accountable Care Organization in which the provider participates.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccountableCareOrganization .

ind:pcmhRecognitionFlag rdf:type rdf:Property ;
    rdfs:label 'Pcmh Recognition Flag' ;
    rdfs:comment 'Indicates whether the provider has achieved Patient Centered Medical Home recognition from NCQA or equivalent body.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:culturalCompetencyLanguage rdf:type rdf:Property ;
    rdfs:label 'Cultural Competency Language' ;
    rdfs:comment 'Languages in which the provider or practice staff can deliver culturally competent care to members.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weekendHoursFlag rdf:type rdf:Property ;
    rdfs:label 'Weekend Hours Flag' ;
    rdfs:comment 'Indicates whether the provider offers services during weekend hours.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eveningHoursFlag rdf:type rdf:Property ;
    rdfs:label 'Evening Hours Flag' ;
    rdfs:comment 'Indicates whether the provider offers services during evening hours.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affiliationSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Affiliation Source System' ;
    rdfs:comment 'The source system or platform from which the network affiliation record originated.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Verification Date' ;
    rdfs:comment 'The date on which the provider\'s network affiliation information was last verified for accuracy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextVerificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Verification Due Date' ;
    rdfs:comment 'The date by which the provider\'s network affiliation information must be re-verified.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractAmendmentCount rdf:type rdf:Property ;
    rdfs:label 'Contract Amendment Count' ;
    rdfs:comment 'The number of amendments made to the provider\'s network contract since the original effective date.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastAmendmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Amendment Date' ;
    rdfs:comment 'The date of the most recent amendment to the provider\'s network contract.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceGuaranteeFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Guarantee Flag' ;
    rdfs:comment 'Indicates whether the provider\'s contract includes performance guarantees or quality-based incentives.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:malpracticeInsuranceFlag rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Flag' ;
    rdfs:comment 'Indicates whether the provider maintains current malpractice insurance coverage as required by the network contract.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:malpracticeExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Malpractice Expiration Date' ;
    rdfs:comment 'The expiration date of the provider\'s current malpractice insurance policy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseVerificationDate rdf:type rdf:Property ;
    rdfs:label 'License Verification Date' ;
    rdfs:comment 'The date on which the provider\'s professional license was last verified as current and in good standing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deaVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Dea Verification Date' ;
    rdfs:comment 'The date on which the provider\'s DEA registration was last verified for prescribing controlled substances.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:boardCertificationFlag rdf:type rdf:Property ;
    rdfs:label 'Board Certification Flag' ;
    rdfs:comment 'Indicates whether the provider is board certified in their specialty by a recognized medical board.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalPrivilegesFlag rdf:type rdf:Property ;
    rdfs:label 'Hospital Privileges Flag' ;
    rdfs:comment 'Indicates whether the provider has admitting privileges at one or more hospitals in the network.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsPaymentTier rdf:type rdf:Property ;
    rdfs:label 'Claims Payment Tier' ;
    rdfs:comment 'The payment tier that determines the reimbursement rate schedule applied to the provider\'s claims.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promptPaymentDiscountRate rdf:type rdf:Property ;
    rdfs:label 'Prompt Payment Discount Rate' ;
    rdfs:comment 'The discount percentage applied if the provider accepts prompt payment terms under the contract.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Withhold Percentage' ;
    rdfs:comment 'The percentage of payments withheld for quality performance or risk-sharing arrangements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stopLossThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Stop Loss Threshold Amount' ;
    rdfs:comment 'The dollar threshold above which stop-loss protection applies for risk-bearing providers.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:affiliationNotes rdf:type rdf:Property ;
    rdfs:label 'Affiliation Notes' ;
    rdfs:comment 'Free-text notes or comments regarding the provider\'s network affiliation, restrictions, or special arrangements.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMetricId rdf:type rdf:Property ;
    rdfs:label 'Quality Metric Id' ;
    rdfs:comment 'Unique identifier for the quality metric record. Primary key for the quality metric entity.' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measureCode rdf:type rdf:Property ;
    rdfs:label 'Measure Code' ;
    rdfs:comment 'Standardized code identifying the specific quality measure being reported (e.g., HEDIS measure code, CMS star rating measure code).' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureName rdf:type rdf:Property ;
    rdfs:label 'Measure Name' ;
    rdfs:comment 'Full descriptive name of the quality measure (e.g., Breast Cancer Screening, Diabetes HbA1c Control).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureCategory rdf:type rdf:Property ;
    rdfs:label 'Measure Category' ;
    rdfs:comment 'HEDIS domain category for the quality measure: effectiveness of care, access/availability of care, experience of care, utilization, health plan descriptive information, or measures reported using electronic health records.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusions rdf:type rdf:Property ;
    rdfs:label 'Exclusions' ;
    rdfs:comment 'The count of members or events excluded from the denominator due to valid clinical or administrative reasons as defined by the measure specification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:score rdf:type rdf:Property ;
    rdfs:label 'Score' ;
    rdfs:comment 'The standardized quality score assigned to the provider based on the measure rate, often normalized or weighted according to program specifications (e.g., CMS Star Rating score).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentileRank rdf:type rdf:Property ;
    rdfs:label 'Percentile Rank' ;
    rdfs:comment 'The percentile rank of the provider\'s performance on this quality measure compared to all providers in the comparison population (0-100 scale).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkRate rdf:type rdf:Property ;
    rdfs:label 'Benchmark Rate' ;
    rdfs:comment 'The benchmark or target performance rate for this quality measure, established by the payer, regulatory body, or industry standard.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nationalAverageRate rdf:type rdf:Property ;
    rdfs:label 'National Average Rate' ;
    rdfs:comment 'The national average performance rate for this quality measure across all reporting providers, used for comparative analysis.' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceStatus rdf:type rdf:Property ;
    rdfs:label 'Performance Status' ;
    rdfs:comment 'Classification of the provider\'s performance relative to the benchmark: exceeds benchmark, meets benchmark, below benchmark, not applicable, or insufficient data.' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementFlag rdf:type rdf:Property ;
    rdfs:label 'Improvement Flag' ;
    rdfs:comment 'Indicates whether the provider\'s performance on this measure has improved compared to the prior measurement period (true if improved, false otherwise).' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificationStatus rdf:type rdf:Property ;
    rdfs:label 'Certification Status' ;
    rdfs:comment 'The certification status of the quality metric submission: certified (meets all requirements), provisional (conditional approval), not certified, certification expired, or certification pending.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'The date when the quality metric data was submitted to the regulatory body, accreditation organization, or internal quality department.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'The status of the quality metric submission: draft, submitted, accepted, rejected, resubmission required, or finalized.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingEntity rdf:type rdf:Property ;
    rdfs:label 'Reporting Entity' ;
    rdfs:comment 'The name of the health plan, provider organization, or entity responsible for reporting this quality metric.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseMixIndex rdf:type rdf:Property ;
    rdfs:label 'Case Mix Index' ;
    rdfs:comment 'The case mix index representing the average complexity and resource intensity of the provider\'s patient population for this quality measure.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measureSteward rdf:type rdf:Property ;
    rdfs:label 'Measure Steward' ;
    rdfs:comment 'The organization responsible for developing and maintaining the quality measure specification (e.g., NCQA, CMS, AMA-PCPI).' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageStratification rdf:type rdf:Property ;
    rdfs:label 'Age Stratification' ;
    rdfs:comment 'The age group or stratification for which this quality metric is reported (e.g., 18-44, 45-64, 65+, pediatric, adult).' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderStratification rdf:type rdf:Property ;
    rdfs:label 'Gender Stratification' ;
    rdfs:comment 'The gender stratification for which this quality metric is reported: male, female, all genders, other, or not applicable.' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:raceEthnicityStratification rdf:type rdf:Property ;
    rdfs:label 'Race Ethnicity Stratification' ;
    rdfs:comment 'The race and ethnicity stratification for which this quality metric is reported, used for health equity analysis.' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageStratification rdf:type rdf:Property ;
    rdfs:label 'Language Stratification' ;
    rdfs:comment 'The primary language stratification for which this quality metric is reported, used for health equity and access analysis.' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthEquityFlag rdf:type rdf:Property ;
    rdfs:label 'Health Equity Flag' ;
    rdfs:comment 'Indicates whether this quality metric is designated as a health equity measure, focusing on reducing disparities in care (true if health equity measure, false otherwise).' ;
    rdfs:domain ind:QualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:groupPracticeId rdf:type rdf:Property ;
