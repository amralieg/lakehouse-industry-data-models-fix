finance,ledger_accounting,fiscal_period,adjustment_period_flag,adjustment_period_flag,Adjustment Period Flag,BOOLEAN,,,,,reference_data,"Indicates whether this is an adjustment period used for year-end closing entries. True if adjustment period, False otherwise.",
finance,ledger_accounting,fiscal_period,budget_period_flag,budget_period_flag,Budget Period Flag,BOOLEAN,,,,,reference_data,"Indicates whether this fiscal period is used for budget planning and allocation. True if budget period, False otherwise.",
finance,ledger_accounting,fiscal_period,business_days_in_period,business_days_in_period,Business Days in Fiscal Period,INT,,,,,reference_data,The total number of business days (excluding weekends and holidays) in the fiscal period. Used for operational and productivity metrics.,
finance,ledger_accounting,fiscal_period,calendar_month,calendar_month,Calendar Month,INT,,,,,reference_data,The calendar month in which the fiscal period starts (1-12). Null for non-monthly periods.,
finance,ledger_accounting,fiscal_period,calendar_quarter,calendar_quarter,Calendar Quarter,INT,,,,,reference_data,"The calendar quarter in which the fiscal period starts (1, 2, 3, or 4). Null for non-monthly periods.",
finance,ledger_accounting,fiscal_period,calendar_year,calendar_year,Calendar Year,INT,,,,,reference_data,"The calendar year in which the fiscal period starts (e.g., 2024). May differ from fiscal_year for organizations with non-calendar fiscal years.",
finance,ledger_accounting,fiscal_period,close_approved_by,close_approved_by,Period Close Approved By User,STRING,,,,,reference_data,The username or identifier of the user who approved the period close. Used for segregation of duties and audit trail.,
finance,ledger_accounting,fiscal_period,close_date,close_date,Fiscal Period Close Date,DATE,,,,,reference_data,The date when the fiscal period was closed. Null if the period is still open or future. Format: yyyy-MM-dd.,
finance,ledger_accounting,fiscal_period,close_initiated_by,close_initiated_by,Period Close Initiated By User,STRING,,,,,reference_data,The username or identifier of the user who initiated the period close process. Used for audit trail and accountability.,
finance,ledger_accounting,fiscal_period,cms_reporting_period_flag,cms_reporting_period_flag,Centers for Medicare and Medicaid Services (CMS) Reporting Period Flag,BOOLEAN,,,,,reference_data,"Indicates whether this fiscal period is used for CMS cost reporting and reimbursement submissions. True if CMS reporting period, False otherwise.",
finance,ledger_accounting,fiscal_period,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,reference_data,The date and time when this fiscal period record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.,
finance,ledger_accounting,fiscal_period,days_in_period,days_in_period,Days in Fiscal Period,INT,,,,,reference_data,The total number of calendar days in the fiscal period. Calculated as end_date minus start_date plus one.,
finance,ledger_accounting,fiscal_period,end_date,end_date,Fiscal Period End Date,DATE,,,,,reference_data,The last day of the fiscal period. Format: yyyy-MM-dd.,
finance,ledger_accounting,fiscal_period,fiscal_period_description,fiscal_period_description,Fiscal Period Description,STRING,,,,,reference_data,"Additional descriptive text or notes about the fiscal period, such as special circumstances, adjustments, or business context.",
finance,ledger_accounting,fiscal_period,fiscal_year,fiscal_year,Fiscal Year,INT,,,,,reference_data,"The fiscal year to which this period belongs (e.g., 2024).",
finance,ledger_accounting,fiscal_period,period_end_close_checklist_complete_flag,period_end_close_checklist_complete_flag,Period-End Close Checklist Complete Flag,BOOLEAN,,,,,reference_data,"Indicates whether all period-end close checklist tasks have been completed for this period. True if complete, False otherwise.",
finance,ledger_accounting,fiscal_period,period_name,period_name,Fiscal Period Name,STRING,,,,,reference_data,"Human-readable name of the fiscal period (e.g., January 2024, Q1 FY2024, FY2024).",
finance,ledger_accounting,fiscal_period,period_number,period_number,Fiscal Period Number,INT,,,,,reference_data,"Sequential number of the period within the fiscal year (e.g., 1 for January, 2 for February, or 1 for Q1).",
finance,ledger_accounting,fiscal_period,period_status,period_status,Fiscal Period Status,STRING,,,,future|open|closed|permanently_closed,reference_data,"Current status of the fiscal period: future (not yet started), open (available for journal entry posting), closed (temporarily closed, can be reopened), permanently_closed (locked, no further entries allowed).",
finance,ledger_accounting,fiscal_period,period_type,period_type,Fiscal Period Type,STRING,,,,month|quarter|year|adjustment,reference_data,"Type of fiscal period: month (monthly period), quarter (quarterly period), year (annual period), or adjustment (adjustment period for year-end entries).",
finance,ledger_accounting,fiscal_period,permanent_close_date,permanent_close_date,Fiscal Period Permanent Close Date,DATE,,,,,reference_data,The date when the fiscal period was permanently closed and locked from further entries. Null if not permanently closed. Format: yyyy-MM-dd.,
finance,ledger_accounting,fiscal_period,quarter_number,quarter_number,Fiscal Quarter Number,INT,,,,,reference_data,"The fiscal quarter number within the fiscal year (1, 2, 3, or 4). Null for non-monthly periods or adjustment periods.",
finance,ledger_accounting,fiscal_period,reopen_date,reopen_date,Fiscal Period Reopen Date,DATE,,,,,reference_data,The date when a previously closed period was reopened for adjustments. Null if never reopened. Format: yyyy-MM-dd.,
finance,ledger_accounting,fiscal_period,reporting_period_flag,reporting_period_flag,Reporting Period Flag,BOOLEAN,,,,,reference_data,"Indicates whether this fiscal period is used for external financial reporting (e.g., quarterly earnings, annual reports). True if reporting period, False otherwise.",
finance,ledger_accounting,fiscal_period,start_date,start_date,Fiscal Period Start Date,DATE,,,,,reference_data,The first day of the fiscal period. Format: yyyy-MM-dd.,
