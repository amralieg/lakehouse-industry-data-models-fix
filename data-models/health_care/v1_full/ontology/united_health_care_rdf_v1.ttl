    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oopMaxAmount rdf:type rdf:Property ;
    rdfs:label 'Oop Max Amount' ;
    rdfs:comment 'The maximum dollar amount the member will pay out-of-pocket for covered services in a plan year. After this limit is reached, the plan pays 100% of covered services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
