    rdfs:range xsd:string .

ind:pcpEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Pcp Eligible Flag' ;
    rdfs:comment 'Indicator of whether the provider is eligible to serve as a Primary Care Physician for members.' ;
