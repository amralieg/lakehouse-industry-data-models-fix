    rdfs:comment 'Indicates whether this intervention type includes a peer support or peer counseling component delivered by individuals with lived experience.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:familyCaregiverInvolvement rdf:type rdf:Property ;
    rdfs:label 'Family Caregiver Involvement' ;
    rdfs:comment 'Indicates whether this intervention type involves or encourages participation of family members or informal caregivers. Supports family-centered care models.' ;
