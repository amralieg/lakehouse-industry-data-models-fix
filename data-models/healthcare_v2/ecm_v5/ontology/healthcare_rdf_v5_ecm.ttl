    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewTriggerCriteria rdf:type rdf:Property ;
    rdfs:label 'Review Trigger Criteria' ;
    rdfs:comment 'Business rule that triggered the mortality review (e.g., death within 30 days of discharge).' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineScore rdf:type rdf:Property ;
    rdfs:label 'Baseline Score' ;
    rdfs:comment 'Score calculated from baseline period data used as a reference point.' ;
    rdfs:domain ind:VbpProgram ;
