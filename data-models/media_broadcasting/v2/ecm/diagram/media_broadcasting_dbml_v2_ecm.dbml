Table finance.accounts_receivable {
  accounts_receivable_id varchar [pk, note: 'Unique identifier for the accounts receivable record. Primary key for this entity. | Column accounts_receivable_id (BIGINT) in finance.accounts_receivable']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: AR postings reference GL accounts from the chart of accounts. The gl_account STRING is a business key that should be supplemented with FK to chart_of_accounts.chart_of_accounts_id. | Column chart_of_accounts_id (BIGINT) in finance.accounts_receivable']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Accounts receivable records must be associated with a legal entity for consolidation and reporting. The company_code is a business key reference to legal_entity. FK enables proper legal entity consoli | Column company_legal_entity_id (BIGINT) in finance.accounts_receivable']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: AR records can be allocated to cost centers for revenue tracking. The cost_center STRING column will be replaced by FK to cost_center.cost_center_id. | Column cost_center_id (BIGINT) in finance.accounts_receivable']
  invoice_id varchar [note: 'Reference to the invoice document that originated this receivable entry. | Column invoice_id (BIGINT) in billing.accounts_receivable']
  political_ad_record_id varchar [note: 'Foreign key linking to compliance.political_ad_record. Business justification: Political advertising receivables require public file disclosure with payment details and rate compliance (lowest unit charge rules). AR aging and collection for political ads must be tracked separate | Column political_ad_record_id (BIGINT) in compliance.accounts_receivable']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: AR records track profit center for revenue attribution and EBITDA reporting. The profit_center STRING column will be replaced by FK to profit_center.profit_center_id. | Column profit_center_id (BIGINT) in finance.accounts_receivable']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: AR is classified by revenue stream type (advertising, subscription, carriage fees, syndication). The revenue_stream STRING column will be replaced by FK to revenue_stream.revenue_stream_id for proper  | Column revenue_stream_id (BIGINT) in finance.accounts_receivable']
  subscriber_id varchar [note: 'Identifier of the customer (advertiser, MVPD, syndication partner, or content licensee) who owes the receivable amount. | Column subscriber_id (BIGINT) in subscriber.accounts_receivable']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.accounts_receivable']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.accounts_receivable']
  aging_bucket varchar [note: 'The aging category of the receivable based on days past due (current, 1-30 days, 31-60 days, 61-90 days, over 90 days). | Column aging_bucket (STRING) in finance.accounts_receivable']
  assignment_field varchar [note: 'Free-text assignment field used for additional sorting, grouping, or reconciliation purposes in SAP FI-AR. | Column assignment_field (STRING) in finance.accounts_receivable']
  baseline_date date [note: 'The reference date used to calculate payment terms and due date, typically the document date or posting date. | Column baseline_date (DATE) in finance.accounts_receivable']
  business_unit varchar [note: 'The business unit or division within Media Broadcasting that owns this receivable (e.g., Linear TV, Streaming, News, Sports). | Column business_unit (STRING) in finance.accounts_receivable']
  clearing_date date [note: 'The date when the receivable was fully cleared through payment or other settlement mechanism. Null if still open. | Column clearing_date (DATE) in finance.accounts_receivable']
  clearing_status varchar [note: 'Current clearing status of the receivable indicating whether it is open, partially cleared, fully cleared, disputed, or written off. | Column clearing_status (STRING) in finance.accounts_receivable']
  company_code varchar [note: 'The SAP company code representing the legal entity that holds this receivable. | Column company_code (STRING) in finance.accounts_receivable']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.accounts_receivable']
  created_timestamp timestamp [note: 'The timestamp when this accounts receivable record was first created in the system. | Column created_timestamp (TIMESTAMP) in finance.accounts_receivable']
  days_past_due varchar [note: 'The number of days the receivable is overdue, calculated as the difference between current date and due date. Zero or negative if not yet due. | Column days_past_due (INT) in finance.accounts_receivable']
  dispute_date date [note: 'The date when the customer formally disputed this receivable. | Column dispute_date (DATE) in finance.accounts_receivable']
  dispute_flag boolean [note: 'Boolean indicator of whether the customer has disputed this receivable (True = disputed, False = not disputed). | Column dispute_flag (BOOLEAN) in finance.accounts_receivable']
  dispute_reason varchar [note: 'Free-text description of the reason the customer has disputed this receivable, if applicable. | Column dispute_reason (STRING) in finance.accounts_receivable']
  document_currency varchar [note: 'The three-letter ISO 4217 currency code in which the receivable was originally denominated (e.g., USD, EUR, GBP). | Column document_currency (STRING) in finance.accounts_receivable']
  document_date date [note: 'The date on the original business document (invoice date, credit memo date) that created this receivable. | Column document_date (DATE) in finance.accounts_receivable']
  document_number varchar [note: 'The externally-known business document number for this receivable entry, typically the SAP FI-AR document number. | Column document_number (STRING) in finance.accounts_receivable']
  document_type varchar [note: 'Classification of the receivable document type (invoice, credit memo, debit memo, payment, down payment, adjustment). | Column document_type (STRING) in finance.accounts_receivable']
  due_date date [note: 'The date by which payment is expected from the customer based on payment terms. | Column due_date (DATE) in finance.accounts_receivable']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  dunning_date date [note: 'The date when the most recent dunning notice was sent to the customer for this receivable. | Column dunning_date (DATE) in finance.accounts_receivable']
  dunning_level varchar [note: 'The current dunning level indicating the escalation stage of collection efforts (0 = no dunning, 1-9 = escalating levels). | Column dunning_level (INT) in finance.accounts_receivable']
  exchange_rate decimal(12,6) [note: 'The foreign exchange rate used to convert document currency to local currency at the time of posting. | Column exchange_rate (DECIMAL(12,6)) in finance.accounts_receivable']
  fiscal_period varchar [note: 'The fiscal period (month) within the fiscal year when this receivable was posted. | Column fiscal_period (INT) in finance.accounts_receivable']
  fiscal_year varchar [note: 'The fiscal year in which this receivable was posted, used for period-end close and financial reporting. | Column fiscal_year (INT) in finance.accounts_receivable']
  gl_account varchar [note: 'The general ledger account code to which this receivable is posted in the chart of accounts. | Column gl_account (STRING) in finance.accounts_receivable']
  last_modified_timestamp timestamp [note: 'The timestamp when this accounts receivable record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in finance.accounts_receivable']
  local_currency varchar [note: 'The three-letter ISO 4217 currency code of the company\'s local reporting currency. | Column local_currency (STRING) in finance.accounts_receivable']
  local_currency_amount decimal(18,2) [note: 'The receivable amount converted to the company\'s local reporting currency for consolidation and financial reporting. | Column local_currency_amount (DECIMAL(18,2)) in finance.accounts_receivable']
  open_amount decimal(18,2) [note: 'The current outstanding amount still owed by the customer in document currency after partial payments or adjustments. | Column open_amount (DECIMAL(18,2)) in finance.accounts_receivable']
  original_amount decimal(18,2) [note: 'The original gross amount of the receivable in document currency when first posted. | Column original_amount (DECIMAL(18,2)) in finance.accounts_receivable']
  payment_method varchar [note: 'The expected or actual payment method for settling this receivable (wire transfer, check, ACH, credit card, direct debit, cash). | Column payment_method (STRING) in finance.accounts_receivable']
  payment_terms varchar [note: 'The payment terms code defining the due date calculation, discount periods, and payment conditions (e.g., Net 30, 2/10 Net 30). | Column payment_terms (STRING) in finance.accounts_receivable']
  posting_date date [note: 'The date when the receivable was posted to the general ledger in the financial system. | Column posting_date (DATE) in finance.accounts_receivable']
  reference_document varchar [note: 'External reference document number such as customer purchase order number, contract number, or other business reference. | Column reference_document (STRING) in finance.accounts_receivable']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.accounts_receivable']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.accounts_receivable']
  text_description varchar [note: 'Free-text description or memo field providing additional context about this receivable entry. | Column text_description (STRING) in finance.accounts_receivable']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.accounts_receivable']

  Note: 'SAP FI-AR authoritative record of outstanding receivables owed to Media Broadcasting from advertisers, MVPDs, syndication partners, and content licensees. Captures customer account, invoice reference, due date, open amount, currency, payment terms, dunning level, clearing status, aging bucket, and dispute flag. Supports cash flow forecasting, revenue assurance, and period-end close reconciliation. | Unity Catalog table: media_broadcasting_ecm.finance.accounts_receivable SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.accounts_payable {
  accounts_payable_id varchar [pk, note: 'Unique identifier for the accounts payable record. Primary key for the accounts payable entity. | Column accounts_payable_id (BIGINT) in finance.accounts_payable']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: AP postings reference GL accounts from the chart of accounts. The gl_account STRING is a business key that should be supplemented with FK to chart_of_accounts.chart_of_accounts_id for referential inte | Column chart_of_accounts_id (BIGINT) in finance.accounts_payable']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Accounts payable records must be associated with a legal entity for consolidation and reporting. The company_code is a business key reference to legal_entity. FK will enable proper legal entity consol | Column company_legal_entity_id (BIGINT) in finance.accounts_payable']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: AP records can be allocated to cost centers for expense tracking. The cost_center STRING column will be replaced by FK to cost_center.cost_center_id, enabling proper cost allocation and budget trackin | Column cost_center_id (BIGINT) in finance.accounts_payable']
  equipment_procurement_id varchar [note: 'Foreign key linking to technology.equipment_procurement. Business justification: AP invoices are matched to equipment purchase orders for three-way match (PO, goods receipt, invoice). Finance validates invoice against PO terms for payment approval, purchase price variance analysis | Column equipment_procurement_id (BIGINT) in technology.accounts_payable']
  vendor_contract_id varchar [note: 'Foreign key linking to technology.vendor_contract. Business justification: AP invoices are paid under vendor contracts (maintenance agreements, service contracts, equipment leases, support agreements). Finance validates invoice terms, pricing, and payment terms against maste | Column vendor_contract_id (BIGINT) in technology.accounts_payable']
  vendor_id varchar [note: 'Identifier of the vendor to whom payment is owed. Links to talent agencies, production vendors, content licensors, technology providers, and distribution partners. | Column vendor_id (BIGINT) in partner.accounts_payable']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.accounts_payable']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.accounts_payable']
  assignment_reference varchar [note: 'Free-text reference field for additional assignment information (e.g., production code, content title, project ID). Used for detailed cost tracking. | Column assignment_reference (STRING) in finance.accounts_payable']
  baseline_date date [note: 'Date from which payment terms are calculated. Typically the document date or goods receipt date, used to determine the due date. | Column baseline_date (DATE) in finance.accounts_payable']
  clearing_date date [note: 'Date when the payable was fully cleared (paid). Null if still open or partially cleared. | Column clearing_date (DATE) in finance.accounts_payable']
  clearing_document_number varchar [note: 'SAP FI document number of the payment document that cleared this payable. Null if not yet cleared. | Column clearing_document_number (STRING) in finance.accounts_payable']
  clearing_status varchar [note: 'Current clearing status of the payable. Open=unpaid, Partially Cleared=partial payment applied, Fully Cleared=completely paid. | Column clearing_status (STRING) in finance.accounts_payable']
  company_code varchar [note: 'Four-character SAP company code representing the legal entity responsible for this payable. Used for financial consolidation and reporting. | Column company_code (STRING) in finance.accounts_payable']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.accounts_payable']
  created_timestamp timestamp [note: 'Timestamp when this accounts payable record was first created in the SAP FI-AP system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in finance.accounts_payable']
  discount_amount decimal(18,2) [note: 'Potential cash discount amount available if payment is made by the discount due date, in document currency. | Column discount_amount (DECIMAL(18,2)) in finance.accounts_payable']
  discount_due_date date [note: 'Date by which payment must be made to qualify for early payment discount. Null if no discount terms apply. | Column discount_due_date (DATE) in finance.accounts_payable']
  document_currency varchar [note: 'Three-letter ISO 4217 currency code for the invoice (e.g., USD, EUR, GBP). Currency in which the vendor billed. | Column document_currency (STRING) in finance.accounts_payable']
  document_date date [note: 'Date on the vendor invoice or credit memo. Typically the invoice date provided by the vendor. | Column document_date (DATE) in finance.accounts_payable']
  document_number varchar [note: 'Ten-digit SAP FI document number uniquely identifying this payable within the company code and fiscal year. The externally-known business identifier for this payable. | Column document_number (STRING) in finance.accounts_payable']
  document_type varchar [note: 'SAP document type code classifying the nature of the payable. KR=Vendor Invoice, KG=Vendor Credit Memo, KN=Net Vendor Invoice, RE=Invoice Receipt, DR=Debit Memo. | Column document_type (STRING) in finance.accounts_payable']
  due_date date [note: 'Date by which payment is due to the vendor. Calculated from baseline date and payment terms. Critical for cash management and avoiding late payment penalties. | Column due_date (DATE) in finance.accounts_payable']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  exchange_rate decimal(12,5) [note: 'Exchange rate used to convert document currency to local currency at posting date. Null if document currency equals local currency. | Column exchange_rate (DECIMAL(12,5)) in finance.accounts_payable']
  fiscal_period varchar [note: 'Fiscal period (1-12 or 1-16 for special periods) within the fiscal year when the document was posted. Used for monthly financial close. | Column fiscal_period (INT) in finance.accounts_payable']
  fiscal_year varchar [note: 'Four-digit fiscal year in which the document was posted. Used for period-end close and financial reporting. | Column fiscal_year (INT) in finance.accounts_payable']
  gl_account varchar [note: 'Ten-digit general ledger account number to which this payable is posted. Determines the expense or asset classification in the chart of accounts. | Column gl_account (STRING) in finance.accounts_payable']
  gross_amount decimal(18,2) [note: 'Total invoice amount before any deductions, in document currency. Represents the full amount billed by the vendor. | Column gross_amount (DECIMAL(18,2)) in finance.accounts_payable']
  invoice_reference varchar [note: 'Vendor-provided invoice number or reference identifier. Used for vendor reconciliation and payment matching. | Column invoice_reference (STRING) in finance.accounts_payable']
  last_modified_timestamp timestamp [note: 'Timestamp when this accounts payable record was last modified (e.g., payment block added, partial payment applied). Used for audit trail. | Column last_modified_timestamp (TIMESTAMP) in finance.accounts_payable']
  local_currency_amount decimal(18,2) [note: 'Net payable amount converted to the company code local currency for general ledger posting and financial reporting. | Column local_currency_amount (DECIMAL(18,2)) in finance.accounts_payable']
  net_amount decimal(18,2) [note: 'Net amount payable to vendor after all deductions (discounts, withholding tax), in document currency. This is the amount that will be paid. | Column net_amount (DECIMAL(18,2)) in finance.accounts_payable']
  open_amount decimal(18,2) [note: 'Outstanding unpaid amount remaining on this payable, in document currency. Reduced as partial payments are applied. Zero when fully cleared. | Column open_amount (DECIMAL(18,2)) in finance.accounts_payable']
  payment_block varchar [note: 'Single-character code indicating if payment is blocked (e.g., A=Blocked for Payment, R=Blocked for Review, blank=Not Blocked). Prevents automatic payment until resolved. | Column payment_block (STRING) in finance.accounts_payable']
  payment_block_reason varchar [note: 'Free-text explanation for why payment is blocked (e.g., pending approval, invoice dispute, missing documentation). Null if not blocked. | Column payment_block_reason (STRING) in finance.accounts_payable']
  payment_method varchar [note: 'Single-character code indicating the payment method (e.g., C=Check, T=Wire Transfer, E=Electronic Funds Transfer, A=ACH). Determines payment run processing. | Column payment_method (STRING) in finance.accounts_payable']
  payment_terms varchar [note: 'Four-character code defining the payment terms negotiated with the vendor (e.g., net 30, 2/10 net 30). Determines due date and cash discount eligibility. | Column payment_terms (STRING) in finance.accounts_payable']
  posting_date date [note: 'Date when the accounts payable document was posted to the general ledger. Determines the fiscal period for financial reporting. | Column posting_date (DATE) in finance.accounts_payable']
  purchase_order_number varchar [note: 'Ten-digit purchase order number if this payable originated from a PO-based procurement. Used for three-way match (PO, goods receipt, invoice). | Column purchase_order_number (STRING) in finance.accounts_payable']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.accounts_payable']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.accounts_payable']
  sox_control_flag boolean [note: 'Boolean flag indicating whether this payable is subject to SOX financial controls and requires additional approval workflows. True for material transactions. | Column sox_control_flag (BOOLEAN) in finance.accounts_payable']
  tax_amount decimal(18,2) [note: 'Total tax amount included in the invoice (VAT, sales tax, GST), in document currency. May include multiple tax jurisdictions. | Column tax_amount (DECIMAL(18,2)) in finance.accounts_payable']
  text_description varchar [note: 'Free-text description of the payable, typically describing the goods or services invoiced (e.g., \'Q4 2023 content licensing fees\', \'Studio equipment rental\'). | Column text_description (STRING) in finance.accounts_payable']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.accounts_payable']
  withholding_tax_amount decimal(18,2) [note: 'Amount of withholding tax deducted from vendor payment per tax regulations (e.g., talent residuals withholding, foreign vendor withholding), in document currency. | Column withholding_tax_amount (DECIMAL(18,2)) in finance.accounts_payable']
  withholding_tax_indicator boolean [note: 'Boolean flag indicating whether withholding tax applies to this payable. True if withholding tax is calculated and deducted. | Column withholding_tax_indicator (BOOLEAN) in finance.accounts_payable']

  Note: 'SAP FI-AP authoritative record of outstanding payables owed by Media Broadcasting to talent agencies, production vendors, content licensors, technology providers, and distribution partners. Captures vendor account, invoice reference, due date, open amount, currency, payment terms, payment block status, withholding tax indicator, and clearing status. Supports cash management, vendor payment runs, and period-end close. | Unity Catalog table: media_broadcasting_ecm.finance.accounts_payable SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.intercompany_transaction {
  intercompany_transaction_id varchar [pk, note: 'Unique identifier for the intercompany transaction record within the Media Broadcasting corporate group. | Column intercompany_transaction_id (BIGINT) in finance.intercompany_transaction']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Intercompany charges for facility usage (one legal entity using another\'s broadcast facility) require facility identification for transfer pricing documentation, intercompany billing, and consolidatio | Column broadcast_facility_id (BIGINT) in technology.intercompany_transaction']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Intercompany transactions post to GL accounts. The gl_account_code STRING is a business key that should be supplemented with FK to chart_of_accounts.chart_of_accounts_id. | Column chart_of_accounts_id (BIGINT) in finance.intercompany_transaction']
  sending_cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Intercompany transactions can be allocated to sending cost center. The sending_cost_center STRING column will be replaced by FK to cost_center.cost_center_id. | Column sending_cost_center_id (BIGINT) in finance.intercompany_transaction']
  sending_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Intercompany transactions have a sending legal entity. The sending_company_code is a business key reference to legal_entity. FK enables proper intercompany elimination and netting. | Column sending_legal_entity_id (BIGINT) in finance.intercompany_transaction']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.intercompany_transaction']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.intercompany_transaction']
  approval_required_flag boolean [note: 'Boolean indicator (True/False) specifying whether this intercompany transaction requires formal approval workflow before posting, typically based on transaction amount thresholds or type. | Column approval_required_flag (BOOLEAN) in finance.intercompany_transaction']
  approval_timestamp timestamp [note: 'The date and time when the intercompany transaction was formally approved, recorded in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column approval_timestamp (TIMESTAMP) in finance.intercompany_transaction']
  approved_by varchar [note: 'User ID or name of the authorized person who approved the intercompany transaction for posting, maintaining audit trail for SOX compliance. | Column approved_by (STRING) in finance.intercompany_transaction']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.intercompany_transaction']
  created_timestamp timestamp [note: 'The date and time when the intercompany transaction record was first created in the system, recorded in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column created_timestamp (TIMESTAMP) in finance.intercompany_transaction']
  due_date date [note: 'The date by which the intercompany transaction amount is due for settlement between the legal entities, calculated based on payment terms. | Column due_date (DATE) in finance.intercompany_transaction']
  elimination_flag boolean [note: 'Boolean indicator (True/False) specifying whether this intercompany transaction requires elimination entries during consolidated financial statement preparation at group level. | Column elimination_flag (BOOLEAN) in finance.intercompany_transaction']
  elimination_status varchar [note: 'Current status of the consolidation elimination process for this intercompany transaction in the group financial consolidation system. | Column elimination_status (STRING) in finance.intercompany_transaction']
  exchange_rate decimal(12,6) [note: 'The foreign exchange rate applied to convert the transaction currency to local or group currency, typically sourced from the corporate treasury system. | Column exchange_rate (DECIMAL(12,6)) in finance.intercompany_transaction']
  exchange_rate_type varchar [note: 'The type of exchange rate used for currency conversion (e.g., spot rate, monthly average rate, budget rate, or fixed contractual rate). | Column exchange_rate_type (STRING) in finance.intercompany_transaction']
  gl_account_code varchar [note: 'The general ledger account code to which the intercompany transaction is posted, following the corporate chart of accounts structure. | Column gl_account_code (STRING) in finance.intercompany_transaction']
  group_currency varchar [note: 'The three-letter ISO 4217 currency code representing the corporate group reporting currency (typically USD for Media Broadcasting). | Column group_currency (STRING) in finance.intercompany_transaction']
  group_currency_amount decimal(18,2) [note: 'The transaction amount converted to the corporate group reporting currency for consolidated financial statement preparation. | Column group_currency_amount (DECIMAL(18,2)) in finance.intercompany_transaction']
  intercompany_transaction_description varchar [note: 'Free-text description providing additional business context for the intercompany transaction, such as the specific content title licensed, service provided, or purpose of the charge. | Column intercompany_transaction_description (STRING) in finance.intercompany_transaction']
  local_currency varchar [note: 'The three-letter ISO 4217 currency code representing the local currency of the receiving company code. | Column local_currency (STRING) in finance.intercompany_transaction']
  local_currency_amount decimal(18,2) [note: 'The transaction amount converted to the local currency of the receiving company code for local statutory reporting purposes. | Column local_currency_amount (DECIMAL(18,2)) in finance.intercompany_transaction']
  modified_timestamp timestamp [note: 'The date and time when the intercompany transaction record was last modified, recorded in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX), supporting audit trail requirements. | Column modified_timestamp (TIMESTAMP) in finance.intercompany_transaction']
  netting_status varchar [note: 'Indicates whether the intercompany transaction is subject to bilateral netting arrangements to reduce cash settlement volumes between legal entities. | Column netting_status (STRING) in finance.intercompany_transaction']
  payment_terms varchar [note: 'The payment terms code defining the due date calculation and settlement terms for the intercompany transaction (e.g., NET30, NET60, IMM for immediate). | Column payment_terms (STRING) in finance.intercompany_transaction']
  posting_date date [note: 'The date on which the intercompany transaction was posted to the general ledger, determining the fiscal period for financial statement inclusion. | Column posting_date (DATE) in finance.intercompany_transaction']
  receiving_company_code varchar [note: 'The SAP company code of the legal entity receiving or being charged for the intercompany transaction (the entity consuming the service, content, or financing). | Column receiving_company_code (STRING) in finance.intercompany_transaction']
  receiving_cost_center varchar [note: 'The cost center within the receiving company code that is being charged for the intercompany transaction, enabling detailed cost allocation and budget tracking. | Column receiving_cost_center (STRING) in finance.intercompany_transaction']
  reconciliation_period varchar [note: 'The fiscal period (YYYY-MM format) in which this intercompany transaction is subject to monthly intercompany reconciliation procedures. | Column reconciliation_period (STRING) in finance.intercompany_transaction']
  reconciliation_status varchar [note: 'Current status of the intercompany reconciliation process indicating whether the transaction has been matched and confirmed by both sending and receiving entities. | Column reconciliation_status (STRING) in finance.intercompany_transaction']
  reference_document_number varchar [note: 'External reference number linking this intercompany transaction to source documents such as content licensing agreements, service invoices, or loan agreements. | Column reference_document_number (STRING) in finance.intercompany_transaction']
  sending_company_code varchar [note: 'The SAP company code of the legal entity originating or charging the intercompany transaction (the entity providing the service, content, or financing). | Column sending_company_code (STRING) in finance.intercompany_transaction']
  settlement_date date [note: 'The actual date on which the intercompany transaction was settled through cash payment or netting between the legal entities. | Column settlement_date (DATE) in finance.intercompany_transaction']
  settlement_status varchar [note: 'Current status of cash settlement for the intercompany transaction, tracking whether payment has been made between the legal entities. | Column settlement_status (STRING) in finance.intercompany_transaction']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.intercompany_transaction']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.intercompany_transaction']
  sox_control_flag boolean [note: 'Boolean indicator (True/False) identifying whether this intercompany transaction is subject to SOX-compliant financial controls and requires additional audit trail documentation. | Column sox_control_flag (BOOLEAN) in finance.intercompany_transaction']
  transaction_amount decimal(18,2) [note: 'The monetary value of the intercompany transaction in the transaction currency, representing the gross charge before any adjustments or netting. | Column transaction_amount (DECIMAL(18,2)) in finance.intercompany_transaction']
  transaction_currency varchar [note: 'The three-letter ISO 4217 currency code in which the intercompany transaction was originally denominated (e.g., USD, EUR, GBP). | Column transaction_currency (STRING) in finance.intercompany_transaction']
  transaction_date date [note: 'The business date on which the intercompany transaction occurred or was initiated, used for period assignment and financial reporting. | Column transaction_date (DATE) in finance.intercompany_transaction']
  transaction_number varchar [note: 'Business-facing unique identifier for the intercompany transaction, typically following the format IC-XXXXXXXXXX for tracking and reconciliation purposes. | Column transaction_number (STRING) in finance.intercompany_transaction']
  transaction_status varchar [note: 'Current lifecycle status of the intercompany transaction indicating its position in the approval, posting, and reconciliation workflow. [ENUM-REF-CANDIDATE: draft|pending_approval|approved|posted|reconciled|disputed|cancelled — 7 candidates stripped; promote to reference product] | Column transaction_status (STRING) in finance.intercompany_transaction']
  transaction_type varchar [note: 'Classification of the intercompany transaction indicating the nature of the charge or transfer between legal entities (e.g., content licensing charges between production subsidiaries and broadcast networks, shared service allocations, management fees, technology recharges, intercompany loans, royalty payments). | Column transaction_type (STRING) in finance.intercompany_transaction']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.intercompany_transaction']
  value_date date [note: 'The effective date for interest calculation and cash flow purposes, particularly relevant for intercompany loans and financing arrangements. | Column value_date (DATE) in finance.intercompany_transaction']

  Note: 'Financial transaction record between legal entities within the Media Broadcasting corporate group — capturing content licensing charges between production subsidiaries and broadcast networks, shared service allocations, management fees, technology recharges, and intercompany loans. Each record identifies sending and receiving company codes, transaction type, amount, currency, bilateral netting status, consolidation elimination flag, and reconciliation period. Essential for monthly intercompany reconciliation, consolidated financial statement preparation, and elimination entries at group level. | Unity Catalog table: media_broadcasting_ecm.finance.intercompany_transaction SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.period_close {
  period_close_id varchar [pk, note: 'Unique identifier for the financial period close record. Primary key for the period close entity. | Column period_close_id (BIGINT) in finance.period_close']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Period close is executed per legal entity in SAP S/4HANA. The company_code is a business key reference to legal_entity. FK enables proper period-end close tracking and SOX controls. | Column company_legal_entity_id (BIGINT) in finance.period_close']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Period close triggers regulatory filing deadlines (FCC Form 323 ownership reports, annual EEO reports, biennial ownership reports). Close calendar must track associated regulatory filings to ensure fi | Column regulatory_filing_id (BIGINT) in compliance.period_close']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.period_close']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.period_close']
  actual_close_date date [note: 'The actual date when the period close was completed and the period was locked for further postings. Null if close is not yet completed. | Column actual_close_date (DATE) in finance.period_close']
  close_checklist_completion_pct decimal(5,2) [note: 'Percentage of period-end close checklist tasks that have been completed. Ranges from 0.00 to 100.00. Provides visibility into close progress. | Column close_checklist_completion_pct (DECIMAL(5,2)) in finance.period_close']
  close_completed_timestamp timestamp [note: 'Date and time when the period close process was completed and the period was locked. Null if close is not yet completed. | Column close_completed_timestamp (TIMESTAMP) in finance.period_close']
  close_initiated_timestamp timestamp [note: 'Date and time when the period close process was formally initiated in the system. | Column close_initiated_timestamp (TIMESTAMP) in finance.period_close']
  close_notes varchar [note: 'Free-text field for documenting significant events, issues, or observations during the period close process. Provides context for future reference and audit trail. | Column close_notes (STRING) in finance.period_close']
  close_phase varchar [note: 'Current phase of the period-end close process. Pre-close for preliminary activities, soft close for initial close with limited posting allowed, hard close for final close with restricted access, final close for locked period after SOX sign-off. | Column close_phase (STRING) in finance.period_close']
  close_status varchar [note: 'Current status of the period close execution. Tracks the lifecycle state from initiation through completion or failure. | Column close_status (STRING) in finance.period_close']
  company_code varchar [note: 'Four-character alphanumeric identifier for the legal entity in SAP S/4HANA. Represents the smallest organizational unit for which a complete self-contained set of accounts can be drawn up for purposes of external reporting. | Column company_code (STRING) in finance.period_close']
  consolidation_status varchar [note: 'Status of financial consolidation processing for this company code and period. Tracks whether the legal entity data has been successfully consolidated into group reporting. | Column consolidation_status (STRING) in finance.period_close']
  controller_email varchar [note: 'Email address of the responsible controller for communication and notification purposes during the close process. | Column controller_email (STRING) in finance.period_close']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.period_close']
  created_timestamp timestamp [note: 'Date and time when this period close record was first created in the system. Audit trail field for record lifecycle tracking. | Column created_timestamp (TIMESTAMP) in finance.period_close']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the company code local currency. All monetary amounts in this record are expressed in this currency. | Column currency_code (STRING) in finance.period_close']
  ebitda_amount decimal(18,2) [note: 'Calculated EBITDA for this company code and period in local currency. Key profitability metric for media broadcasting operations and corporate reporting. | Column ebitda_amount (DECIMAL(18,2)) in finance.period_close']
  external_audit_required boolean [note: 'Indicates whether this period close requires external auditor review and sign-off. Typically true for quarterly and annual closes for publicly traded entities. | Column external_audit_required (BOOLEAN) in finance.period_close']
  external_audit_status varchar [note: 'Status of external auditor review for this period close. Tracks the progress of third-party audit activities. | Column external_audit_status (STRING) in finance.period_close']
  fiscal_period varchar [note: 'The accounting period number within the fiscal year (typically 1-12 for monthly periods, or 1-4 for quarterly periods). Represents the specific reporting period being closed. | Column fiscal_period (INT) in finance.period_close']
  fiscal_year varchar [note: 'The fiscal year for which the period close is being executed. Represents the 12-month financial reporting period for the organization. | Column fiscal_year (INT) in finance.period_close']
  intercompany_elimination_status varchar [note: 'Status of intercompany transaction elimination processing for consolidated financial reporting. Indicates whether intercompany balances have been identified and eliminated. | Column intercompany_elimination_status (STRING) in finance.period_close']
  last_modified_by varchar [note: 'User identifier of the person who last modified this period close record. Audit trail field for accountability. | Column last_modified_by (STRING) in finance.period_close']
  last_modified_timestamp timestamp [note: 'Date and time when this period close record was most recently updated. Audit trail field for change tracking. | Column last_modified_timestamp (TIMESTAMP) in finance.period_close']
  last_reopen_date date [note: 'Date when the period was most recently reopened for adjustments. Null if the period has never been reopened. | Column last_reopen_date (DATE) in finance.period_close']
  open_items_count varchar [note: 'Number of open line items (uncleared documents) remaining in the general ledger at the time of close execution. Indicates outstanding reconciliation work. | Column open_items_count (INT) in finance.period_close']
  period_lock_timestamp timestamp [note: 'Date and time when the posting period was locked in the system. Null if the period is not yet locked. | Column period_lock_timestamp (TIMESTAMP) in finance.period_close']
  period_type varchar [note: 'Classification of the accounting period being closed. Monthly for standard month-end close, quarterly for quarter-end, annual for year-end, special for adjustment periods. | Column period_type (STRING) in finance.period_close']
  posting_period_locked boolean [note: 'Indicates whether the posting period has been locked to prevent further transactions. True when the period is closed and locked, false when still open for postings. | Column posting_period_locked (BOOLEAN) in finance.period_close']
  reopen_count varchar [note: 'Number of times this period has been reopened after initial close. Tracks the frequency of post-close adjustments and indicates close process quality. | Column reopen_count (INT) in finance.period_close']
  reopen_reason varchar [note: 'Business justification for the most recent period reopen. Documents the reason for post-close adjustments for audit trail purposes. | Column reopen_reason (STRING) in finance.period_close']
  responsible_controller varchar [note: 'Name or identifier of the financial controller responsible for executing and certifying the period close for this company code and period. | Column responsible_controller (STRING) in finance.period_close']
  revenue_assurance_status varchar [note: 'Status of revenue assurance validation for this period. Indicates whether all revenue streams (advertising, subscription, carriage fees, syndication) have been reconciled and verified. | Column revenue_assurance_status (STRING) in finance.period_close']
  scheduled_close_date date [note: 'The planned target date for completing the period close process. Established based on the financial calendar and reporting deadlines. | Column scheduled_close_date (DATE) in finance.period_close']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.period_close']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.period_close']
  sox_control_status varchar [note: 'Status of SOX internal control testing and certification for this period close. Required for publicly traded companies to ensure financial reporting compliance. | Column sox_control_status (STRING) in finance.period_close']
  sox_signoff_by varchar [note: 'Name or identifier of the individual who provided the SOX control sign-off for this period close. | Column sox_signoff_by (STRING) in finance.period_close']
  sox_signoff_date date [note: 'Date when the SOX control certification was completed and signed off by the responsible controller or compliance officer. Null if not yet signed off. | Column sox_signoff_date (DATE) in finance.period_close']
  unreconciled_amount decimal(18,2) [note: 'Total monetary value of unreconciled items in the company code currency. Represents the financial exposure from incomplete reconciliations. | Column unreconciled_amount (DECIMAL(18,2)) in finance.period_close']
  unreconciled_items_count varchar [note: 'Number of accounts or subledger items that have not been reconciled to the general ledger at the time of close. Critical metric for close quality. | Column unreconciled_items_count (INT) in finance.period_close']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.period_close']
  variance_to_forecast_amount decimal(18,2) [note: 'Monetary variance between actual period results and forecasted amounts in company code currency. Positive indicates favorable variance, negative indicates unfavorable. | Column variance_to_forecast_amount (DECIMAL(18,2)) in finance.period_close']

  Note: 'Record of each financial period-end close cycle executed in SAP S/4HANA for Media Broadcasting legal entities. Tracks fiscal year, accounting period, company code, close phase (pre-close, soft close, hard close), close status, scheduled date, actual completion date, responsible controller, open items count, unreconciled items, and SOX sign-off status. Provides the authoritative audit trail for the monthly, quarterly, and annual close process. | Unity Catalog table: media_broadcasting_ecm.finance.period_close Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.legal_entity {
  legal_entity_id varchar [pk, note: 'Primary key for legal_entity | Column legal_entity_id (BIGINT) in finance.legal_entity']
  parent_entity_legal_entity_id varchar [note: 'Reference to the parent legal entity in the corporate hierarchy. Used to establish organizational structure and consolidation relationships. Null for the ultimate parent entity. | Column parent_entity_legal_entity_id (BIGINT) in finance.legal_entity']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.legal_entity']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.legal_entity']
  accounting_standard varchar [note: 'Primary accounting standard or framework used for financial reporting by this legal entity. Determines recognition, measurement, and disclosure requirements. | Column accounting_standard (STRING) in finance.legal_entity']
  activation_date date [note: 'The date on which the legal entity became active and began conducting business operations. Used for financial reporting period determination. | Column activation_date (DATE) in finance.legal_entity']
  broadcast_license_holder_flag boolean [note: 'Indicates whether this legal entity holds one or more broadcast licenses issued by the FCC or equivalent regulatory authority. True if the entity is a licensed broadcaster. | Column broadcast_license_holder_flag (BOOLEAN) in finance.legal_entity']
  chart_of_accounts varchar [note: 'Four-character code identifying the chart of accounts assigned to this legal entity in SAP S/4HANA. Defines the structure of general ledger accounts used for financial postings. | Column chart_of_accounts (STRING) in finance.legal_entity']
  company_code varchar [note: 'Four-character alphanumeric code uniquely identifying the legal entity within the SAP S/4HANA FI module. Used as the organizational unit for financial accounting and the smallest organizational unit for which a complete self-contained set of accounts can be drawn up for purposes of external reporting. | Column company_code (STRING) in finance.legal_entity']
  consolidation_group varchar [note: 'Identifier for the consolidation group or reporting unit to which this legal entity belongs. Used for corporate consolidation, intercompany eliminations, and segment reporting. | Column consolidation_group (STRING) in finance.legal_entity']
  country_of_incorporation varchar [note: 'Three-letter ISO country code representing the country where the legal entity is incorporated and registered. Determines primary legal jurisdiction and regulatory framework. | Column country_of_incorporation (STRING) in finance.legal_entity']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.legal_entity']
  created_timestamp timestamp [note: 'The date and time when this legal entity record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in finance.legal_entity']
  credit_control_area varchar [note: 'Four-character code identifying the credit control area assigned to this legal entity in SAP S/4HANA. Used for credit management and accounts receivable monitoring. | Column credit_control_area (STRING) in finance.legal_entity']
  deactivation_date date [note: 'The date on which the legal entity ceased active operations or was dissolved. Null for active entities. Used to determine the end of financial reporting obligations. | Column deactivation_date (DATE) in finance.legal_entity']
  ebitda_reporting_flag boolean [note: 'Indicates whether this legal entity is included in corporate EBITDA calculations and segment performance reporting. True if the entity contributes to consolidated EBITDA metrics. | Column ebitda_reporting_flag (BOOLEAN) in finance.legal_entity']
  entity_status varchar [note: 'Current operational status of the legal entity. Active indicates the entity is conducting business; inactive indicates temporary suspension; dormant indicates no current operations but entity remains registered; liquidation indicates entity is being wound down; dissolved indicates entity has been formally closed. | Column entity_status (STRING) in finance.legal_entity']
  entity_type varchar [note: 'Classification of the legal entity based on its primary business function within the Media Broadcasting corporate structure. Determines the operational model and reporting requirements. | Column entity_type (STRING) in finance.legal_entity']
  fiscal_year_variant varchar [note: 'Two-character code defining the fiscal year structure for this legal entity, including the number of periods, period start and end dates, and year-end closing rules. Used for period-based financial reporting. | Column fiscal_year_variant (STRING) in finance.legal_entity']
  functional_currency varchar [note: 'Three-letter ISO 4217 currency code representing the primary currency in which the entity conducts its business and maintains its books of account. Used for financial statement preparation and consolidation. | Column functional_currency (STRING) in finance.legal_entity']
  incorporation_date date [note: 'The date on which the legal entity was officially incorporated or registered with the governing authority. | Column incorporation_date (DATE) in finance.legal_entity']
  intercompany_elimination_group varchar [note: 'Code identifying the group of entities for which intercompany transactions must be eliminated during consolidation. Used to ensure accurate consolidated financial statements. | Column intercompany_elimination_group (STRING) in finance.legal_entity']
  last_modified_timestamp timestamp [note: 'The date and time when this legal entity record was last updated. Used for change tracking and audit compliance. | Column last_modified_timestamp (TIMESTAMP) in finance.legal_entity']
  legal_entity_name varchar [note: 'Full legal name of the entity as registered with the governing authority. This is the official name used in all legal documents, contracts, regulatory filings, and financial statements. | Column legal_entity_name (STRING) in finance.legal_entity']
  legal_form varchar [note: 'The legal structure or incorporation type of the entity (e.g., Corporation, Limited Liability Company, Partnership, Public Limited Company). Determines liability, taxation, and regulatory obligations. | Column legal_form (STRING) in finance.legal_entity']
  ownership_percentage decimal(5,2) [note: 'Percentage of equity ownership held by the parent entity. Used for consolidation calculations and minority interest determination. Range: 0.00 to 100.00. | Column ownership_percentage (DECIMAL(5,2)) in finance.legal_entity']
  primary_contact_email varchar [note: 'Primary email address for official correspondence with the legal entity. Used for regulatory notifications and corporate communications. | Column primary_contact_email (STRING) in finance.legal_entity']
  primary_contact_phone varchar [note: 'Primary telephone number for the legal entity. Used for official business communications. | Column primary_contact_phone (STRING) in finance.legal_entity']
  registered_address_line1 varchar [note: 'First line of the official registered address of the legal entity as filed with the incorporation authority. Used for legal correspondence and regulatory filings. | Column registered_address_line1 (STRING) in finance.legal_entity']
  registered_address_line2 varchar [note: 'Second line of the official registered address (suite, floor, building name). Optional field for additional address details. | Column registered_address_line2 (STRING) in finance.legal_entity']
  registered_city varchar [note: 'City or municipality of the registered address. | Column registered_city (STRING) in finance.legal_entity']
  registered_country varchar [note: 'Three-letter ISO country code for the registered address. Typically matches the country of incorporation. | Column registered_country (STRING) in finance.legal_entity']
  registered_postal_code varchar [note: 'Postal or ZIP code of the registered address. | Column registered_postal_code (STRING) in finance.legal_entity']
  registered_state_province varchar [note: 'State, province, or region of the registered address. Uses standard postal abbreviations where applicable. | Column registered_state_province (STRING) in finance.legal_entity']
  registration_number varchar [note: 'Official registration or incorporation number assigned by the government authority in the country of incorporation. Used for legal identification and regulatory compliance. | Column registration_number (STRING) in finance.legal_entity']
  regulatory_reporting_obligations varchar [note: 'Comma-separated list of regulatory reporting frameworks and obligations applicable to this legal entity (e.g., SEC 10-K, FCC Form 323, Ofcom Annual Return). Determines mandatory filings and disclosure requirements. | Column regulatory_reporting_obligations (STRING) in finance.legal_entity']
  reporting_currency varchar [note: 'Three-letter ISO 4217 currency code representing the currency used for external financial reporting and consolidation at the corporate level. | Column reporting_currency (STRING) in finance.legal_entity']
  short_name varchar [note: 'Abbreviated or trade name of the legal entity used for internal reporting and operational purposes. | Column short_name (STRING) in finance.legal_entity']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.legal_entity']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.legal_entity']
  sox_scope_flag boolean [note: 'Indicates whether this legal entity is within the scope of SOX compliance and internal control testing. True if the entity is material to consolidated financial statements and subject to SOX Section 404 requirements. | Column sox_scope_flag (BOOLEAN) in finance.legal_entity']
  tax_identification_number varchar [note: 'Primary tax identification number assigned by the tax authority in the country of incorporation. Used for all tax filings, withholding, and revenue reporting. | Column tax_identification_number (STRING) in finance.legal_entity']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.legal_entity']
  vat_registration_number varchar [note: 'VAT or GST registration number for entities operating in jurisdictions requiring VAT registration. Used for VAT reporting and cross-border transactions. | Column vat_registration_number (STRING) in finance.legal_entity']

  Note: 'Master record of each legal entity, company code, and reporting unit within the Media Broadcasting corporate structure — including broadcast networks, streaming platforms, production studios, and holding companies. Captures company code, legal entity name, country of incorporation, functional currency, fiscal year variant, chart of accounts assignment, consolidation group, tax registration numbers, and regulatory reporting obligations (SOX, IFRS, GAAP). The organizational anchor for all financial postings. | Unity Catalog table: media_broadcasting_ecm.finance.legal_entity Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.cost_allocation {
  cost_allocation_id varchar [pk, note: 'Unique identifier for the cost allocation transaction record. Primary key for the cost allocation entity. | Column cost_allocation_id (BIGINT) in finance.cost_allocation']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Shared facility costs (power, cooling, security, building maintenance) are allocated from central cost centers to user departments/productions. Finance allocates facility overhead based on usage metri | Column broadcast_facility_id (BIGINT) in technology.cost_allocation']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Cost allocations occur within legal entities for internal cost distribution. The company_code is a business key reference to legal_entity. | Column company_legal_entity_id (BIGINT) in finance.cost_allocation']
  cost_element_chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Cost elements in SAP CO are GL accounts from the chart of accounts. The cost_element STRING is a business key that should be supplemented with FK to chart_of_accounts.chart_of_accounts_id. | Column cost_element_chart_of_accounts_id (BIGINT) in finance.cost_allocation']
  original_allocation_cost_allocation_id varchar [note: 'Foreign key reference to the original cost allocation record that this record reverses. Null if this is not a reversal transaction. | Column original_allocation_cost_allocation_id (BIGINT) in finance.cost_allocation']
  primary_sender_cost_center_id varchar [note: 'Foreign key reference to the cost center from which costs are being allocated (the source of the shared costs being distributed). | Column primary_sender_cost_center_id (BIGINT) in finance.cost_allocation']
  receiver_profit_center_id varchar [note: 'Foreign key reference to the profit center receiving the allocated costs. Null if the receiver is a cost center instead of a profit center. | Column receiver_profit_center_id (BIGINT) in finance.cost_allocation']
  studio_facility_id varchar [note: 'Foreign key linking to technology.studio_facility. Business justification: Studio costs are allocated to productions or departments based on booking hours and usage. Finance tracks studio utilization and allocates studio overhead (depreciation, maintenance, utilities) for pr | Column studio_facility_id (BIGINT) in technology.cost_allocation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.cost_allocation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.cost_allocation']
  allocated_amount decimal(18,2) [note: 'The monetary amount allocated from the sender cost center to the receiver cost center or profit center in the transaction currency. This is the core financial value of the allocation. | Column allocated_amount (DECIMAL(18,2)) in finance.cost_allocation']
  allocation_key varchar [note: 'The allocation key or driver used to determine the proportion of costs allocated to the receiver (e.g., headcount, square footage, revenue, FTE, transaction volume). Defines the basis for cost distribution. | Column allocation_key (STRING) in finance.cost_allocation']
  allocation_key_value decimal(18,4) [note: 'The numeric value of the allocation key used for this specific allocation (e.g., 15 FTEs, 2500 square feet, 1000000 transactions). Used to calculate the allocated amount. | Column allocation_key_value (DECIMAL(18,4)) in finance.cost_allocation']
  allocation_method varchar [note: 'The method used to allocate costs from sender to receiver. Direct: one-to-one allocation. Statistical: based on statistical key figures. Activity-based: based on activity quantities consumed. Assessment: periodic allocation without traceability. Distribution: proportional distribution based on allocation keys. | Column allocation_method (STRING) in finance.cost_allocation']
  allocation_percentage decimal(5,2) [note: 'The percentage of total sender costs allocated to this receiver, expressed as a decimal (e.g., 15.75 for 15.75%). Derived from the allocation key value relative to total allocation base. | Column allocation_percentage (DECIMAL(5,2)) in finance.cost_allocation']
  allocation_run_date date [note: 'The date on which the allocation cycle was executed and this allocation record was created. May differ from posting date if allocations are run in advance and posted later. | Column allocation_run_date (DATE) in finance.cost_allocation']
  allocation_status varchar [note: 'Current lifecycle status of the cost allocation record. Posted: successfully posted to CO ledger. Pending: awaiting approval or posting. Reversed: allocation has been reversed. Cancelled: allocation was cancelled before posting. Error: allocation failed validation or posting. | Column allocation_status (STRING) in finance.cost_allocation']
  allocation_type varchar [note: 'Business classification of the cost allocation indicating the nature of costs being distributed (e.g., overhead, shared services, facilities, technology infrastructure, corporate overhead, intercompany charges). | Column allocation_type (STRING) in finance.cost_allocation']
  approval_required_flag boolean [note: 'Boolean flag indicating whether this allocation requires managerial approval before posting (True) or can be posted automatically (False). Used for governance and control of high-value or sensitive allocations. | Column approval_required_flag (BOOLEAN) in finance.cost_allocation']
  approval_timestamp timestamp [note: 'Date and time when this cost allocation was approved for posting. Null if no approval was required or allocation is still pending approval. | Column approval_timestamp (TIMESTAMP) in finance.cost_allocation']
  approved_by_user varchar [note: 'SAP user ID of the person who approved this cost allocation for posting. Null if no approval was required or allocation is still pending approval. | Column approved_by_user (STRING) in finance.cost_allocation']
  business_area varchar [note: 'The SAP business area to which this allocation is assigned. Used for segment reporting and cross-company code consolidation in Media Broadcasting. | Column business_area (STRING) in finance.cost_allocation']
  company_code varchar [note: 'The SAP company code under which this cost allocation is recorded. Represents the legal entity for financial reporting purposes. | Column company_code (STRING) in finance.cost_allocation']
  controlling_area varchar [note: 'The SAP controlling area within which this cost allocation is executed. Represents the organizational unit for cost accounting and internal reporting. | Column controlling_area (STRING) in finance.cost_allocation']
  cost_element varchar [note: 'The SAP CO cost element (account assignment) under which the allocated cost is recorded. Maps to the general ledger account in SAP FI. | Column cost_element (STRING) in finance.cost_allocation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.cost_allocation']
  created_by_user varchar [note: 'SAP user ID of the person or system process that created this cost allocation record. Part of standard audit trail for accountability and compliance. | Column created_by_user (STRING) in finance.cost_allocation']
  created_timestamp timestamp [note: 'Date and time when this cost allocation record was first created in the system. Part of standard audit trail for data lineage and compliance. | Column created_timestamp (TIMESTAMP) in finance.cost_allocation']
  document_number varchar [note: 'The SAP CO document number assigned to this cost allocation transaction. Provides traceability and audit trail for the allocation posting. | Column document_number (STRING) in finance.cost_allocation']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  ebitda_reporting_segment varchar [note: 'The EBITDA reporting segment to which this allocation contributes. Used for segment-level EBITDA calculation and executive reporting in Media Broadcasting. | Column ebitda_reporting_segment (STRING) in finance.cost_allocation']
  fiscal_period varchar [note: 'The fiscal period (month) within the fiscal year when the allocation was posted (1-12 or 1-13 for special periods). Used for monthly financial close and reporting. | Column fiscal_period (INT) in finance.cost_allocation']
  fiscal_year varchar [note: 'The fiscal year in which the cost allocation was posted (e.g., 2024). Used for period-based financial reporting and EBITDA tracking. | Column fiscal_year (INT) in finance.cost_allocation']
  functional_area varchar [note: 'The functional area classification for this allocation (e.g., production, distribution, sales, administration). Used for cost-of-sales accounting and functional P&L reporting. | Column functional_area (STRING) in finance.cost_allocation']
  intercompany_flag boolean [note: 'Boolean flag indicating whether this allocation crosses company code boundaries and represents an intercompany charge (True) or is intra-company (False). Used for consolidation and elimination processing. | Column intercompany_flag (BOOLEAN) in finance.cost_allocation']
  last_modified_by_user varchar [note: 'SAP user ID of the person or system process that last modified this cost allocation record. Part of standard audit trail for accountability and compliance. | Column last_modified_by_user (STRING) in finance.cost_allocation']
  last_modified_timestamp timestamp [note: 'Date and time when this cost allocation record was last modified. Updated whenever any field in the record changes. Part of standard audit trail for change tracking. | Column last_modified_timestamp (TIMESTAMP) in finance.cost_allocation']
  notes varchar [note: 'Free-text field for additional comments, explanations, or business context regarding this cost allocation. Used for documentation and audit trail purposes. | Column notes (STRING) in finance.cost_allocation']
  posting_date date [note: 'The date on which the cost allocation transaction was posted to the SAP CO ledger. Determines the fiscal period assignment and financial reporting period. | Column posting_date (DATE) in finance.cost_allocation']
  reversal_indicator boolean [note: 'Boolean flag indicating whether this allocation record is a reversal of a previous allocation (True) or an original allocation (False). Used for correction and adjustment tracking. | Column reversal_indicator (BOOLEAN) in finance.cost_allocation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.cost_allocation']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.cost_allocation']
  sox_control_flag boolean [note: 'Boolean flag indicating whether this allocation is subject to SOX financial controls and requires additional audit documentation (True) or is outside SOX scope (False). | Column sox_control_flag (BOOLEAN) in finance.cost_allocation']
  transaction_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the allocated amount (e.g., USD, EUR, GBP). Represents the currency in which the allocation was originally recorded. | Column transaction_currency_code (STRING) in finance.cost_allocation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.cost_allocation']

  Note: 'Record of cost allocation and recharge transactions executed within SAP CO — distributing shared costs (facilities, technology infrastructure, corporate overhead, shared services) from sender cost centers to receiver cost centers or profit centers across Media Broadcasting. Captures allocation cycle, sender cost center, receiver cost center/profit center, allocation method (direct, statistical, activity-based), allocated amount, allocation key, and fiscal period. Enables accurate departmental P&L and EBITDA calculation. | Unity Catalog table: media_broadcasting_ecm.finance.cost_allocation SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.capex_project {
  capex_project_id varchar [pk, note: 'Unique identifier for the capital expenditure project record. Primary key. | Column capex_project_id (BIGINT) in finance.capex_project']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Capital projects (facility upgrades, equipment installations, infrastructure improvements) are executed at specific broadcast facilities. Finance tracks capex spend by facility location for asset capi | Column broadcast_facility_id (BIGINT) in technology.capex_project']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Broadcast equipment capex (transmitter upgrades, tower modifications, EAS equipment) is license-specific and requires FCC notification/approval. Capital planning and asset capitalization must track wh | Column broadcast_license_id (BIGINT) in compliance.capex_project']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Capex projects belong to legal entities for asset ownership and depreciation tracking. The company_code is a business key reference to legal_entity. | Column company_legal_entity_id (BIGINT) in finance.capex_project']
  cost_center_id varchar [note: 'Identifier of the cost center responsible for the capital project. Links to the organizational unit that owns the asset and will bear depreciation expense post-capitalization. | Column cost_center_id (BIGINT) in finance.capex_project']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.capex_project']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.capex_project']
  actual_capitalization_date date [note: 'Actual date when the project was settled to fixed assets and depreciation commenced. Used for SOX compliance and financial statement preparation. | Column actual_capitalization_date (DATE) in finance.capex_project']
  actual_completion_date date [note: 'Actual date when project was completed and ready for asset settlement. Triggers capitalization workflow and depreciation start date calculation. | Column actual_completion_date (DATE) in finance.capex_project']
  actual_start_date date [note: 'Actual date when project execution commenced. Used for variance analysis against planned timeline. | Column actual_start_date (DATE) in finance.capex_project']
  approval_date date [note: 'Date when the capital project received formal budget approval from the investment committee or authorized governance body. Marks the start of the capital commitment period. | Column approval_date (DATE) in finance.capex_project']
  approved_budget_amount decimal(18,2) [note: 'Total capital budget approved for the project by the investment committee. Represents the authorized spending limit for the capital investment. | Column approved_budget_amount (DECIMAL(18,2)) in finance.capex_project']
  asset_class_code varchar [note: 'Fixed asset class code that the project will be capitalized into upon completion. Determines depreciation method, useful life, and GL account assignment. Examples include broadcast equipment, buildings, IT infrastructure. | Column asset_class_code (STRING) in finance.capex_project']
  auc_account_code varchar [note: 'General ledger account code for the asset under construction balance sheet account. All project costs are accumulated in this account until capitalization. Typically a fixed asset sub-account per chart of accounts. | Column auc_account_code (STRING) in finance.capex_project']
  business_area varchar [note: 'Business area or segment for internal management reporting. Examples include Linear Broadcasting, OTT Streaming, News Division, Sports Network. Used for EBITDA segment reporting. | Column business_area (STRING) in finance.capex_project']
  company_code varchar [note: 'SAP company code representing the legal entity that owns the capital project. Used for financial statement consolidation and intercompany eliminations. | Column company_code (STRING) in finance.capex_project']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.capex_project']
  created_by_user varchar [note: 'User ID of the person who created the capital project record. Used for audit trail and accountability. | Column created_by_user (STRING) in finance.capex_project']
  created_timestamp timestamp [note: 'Timestamp when the capital project record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in finance.capex_project']
  cumulative_spend_amount decimal(18,2) [note: 'Total actual expenditure incurred to date on the capital project. Aggregates all posted costs from journal entries and purchase orders. Used for budget variance analysis and capitalization. | Column cumulative_spend_amount (DECIMAL(18,2)) in finance.capex_project']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all project financial amounts. Typically matches the company code currency for domestic projects. | Column currency_code (STRING) in finance.capex_project']
  depreciation_method varchar [note: 'Planned depreciation method to be applied once the asset is capitalized. Straight line is most common for buildings and infrastructure; declining balance may be used for technology assets; units of production for usage-based assets. | Column depreciation_method (STRING) in finance.capex_project']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  governance_review_status varchar [note: 'Status of the capital project governance review by the investment committee or capital allocation board. Tracks approval workflow and conditional requirements. | Column governance_review_status (STRING) in finance.capex_project']
  investment_justification varchar [note: 'Primary business rationale for the capital investment. Capacity expansion includes new studios or transmission capacity; technology upgrade covers platform modernization; regulatory compliance addresses FCC or technical standards; cost reduction targets operational efficiency; revenue generation supports new monetization channels. | Column investment_justification (STRING) in finance.capex_project']
  last_modified_by_user varchar [note: 'User ID of the person who last modified the capital project record. Used for audit trail and change accountability. | Column last_modified_by_user (STRING) in finance.capex_project']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to the capital project record. Used for change tracking and data freshness monitoring. | Column last_modified_timestamp (TIMESTAMP) in finance.capex_project']
  notes varchar [note: 'Free-form text field for additional project context, change history, or special instructions. Used for audit trail and knowledge transfer. | Column notes (STRING) in finance.capex_project']
  planned_capitalization_date date [note: 'Target date for transferring the asset under construction (AUC) to fixed assets and beginning depreciation. Aligns with asset placed-in-service date for financial reporting. | Column planned_capitalization_date (DATE) in finance.capex_project']
  planned_completion_date date [note: 'Target date for project completion and readiness for capitalization. Used for depreciation planning and asset lifecycle management. | Column planned_completion_date (DATE) in finance.capex_project']
  planned_start_date date [note: 'Scheduled date for project execution to begin. Used for resource planning and timeline tracking. | Column planned_start_date (DATE) in finance.capex_project']
  project_classification varchar [note: 'Categorical classification of the capital project type. Infrastructure includes broadcast towers and transmission equipment; technology covers OTT platforms and enterprise systems; facilities encompasses studio construction and office build-outs; equipment includes production gear and IRDs. | Column project_classification (STRING) in finance.capex_project']
  project_code varchar [note: 'Business identifier for the capital project, used across financial systems and reporting. Typically follows organizational coding standards for capital investment tracking. | Column project_code (STRING) in finance.capex_project']
  project_description varchar [note: 'Detailed description of the capital project scope, objectives, and deliverables. Provides context for investment justification and asset capitalization. | Column project_description (STRING) in finance.capex_project']
  project_name varchar [note: 'Descriptive name of the capital project, such as \'OTT Platform Infrastructure Upgrade\' or \'Studio B Renovation\'. | Column project_name (STRING) in finance.capex_project']
  project_status varchar [note: 'Current lifecycle status of the capital project. Planning indicates pre-approval stage; approved means budget authorized; in_progress reflects active execution; completed indicates project finished but not yet capitalized; capitalized means transferred to fixed assets; cancelled indicates project terminated. [ENUM-REF-CANDIDATE: planning|approved|in_progress|on_hold|completed|capitalized|cancelled — 7 candidates stripped; promote to reference product] | Column project_status (STRING) in finance.capex_project']
  remaining_budget_amount decimal(18,2) [note: 'Unspent budget balance available for the project. Calculated as approved budget minus cumulative spend. Used for commitment control and budget monitoring. | Column remaining_budget_amount (DECIMAL(18,2)) in finance.capex_project']
  risk_rating varchar [note: 'Overall risk assessment for the capital project considering technical complexity, budget size, timeline, and strategic importance. Used for governance escalation and monitoring frequency. | Column risk_rating (STRING) in finance.capex_project']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.capex_project']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.capex_project']
  sox_control_flag boolean [note: 'Indicates whether the capital project is subject to SOX internal controls for financial reporting. True for projects above materiality thresholds or involving critical financial systems. | Column sox_control_flag (BOOLEAN) in finance.capex_project']
  sponsor_name varchar [note: 'Name of the executive sponsor or business owner who approved and champions the capital investment. Typically a VP or C-level executive. | Column sponsor_name (STRING) in finance.capex_project']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.capex_project']
  useful_life_years varchar [note: 'Expected useful life of the asset in years for depreciation calculation. Determined by asset class and regulatory/tax guidelines. Broadcast towers may be 20-30 years; technology platforms 3-7 years; studio facilities 15-40 years. | Column useful_life_years (INT) in finance.capex_project']

  Note: 'Capital expenditure project master record tracking Media Broadcasting infrastructure investments from approval through capitalization — covering broadcast tower upgrades, OTT platform builds, studio construction, transmission equipment, and enterprise technology implementations. Captures project code, classification (infrastructure/technology/facilities), approved budget, cumulative spend, asset-under-construction (AUC) account, planned capitalization date, depreciation parameters, responsible cost center, and governance status. Links to fixed_asset upon settlement and to journal_entry for actual cost postings. | Unity Catalog table: media_broadcasting_ecm.finance.capex_project SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.fixed_asset {
  fixed_asset_id varchar [pk, note: 'Unique identifier for the fixed asset record. Primary key. | Column fixed_asset_id (BIGINT) in finance.fixed_asset']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Fixed assets (cameras, switchers, transmitters, servers) are physically located at broadcast facilities. Finance requires facility location for insurance valuation, property tax allocation, depreciati | Column broadcast_facility_id (BIGINT) in technology.fixed_asset']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Broadcast transmission assets (transmitters, antennas, towers) are licensed assets with regulatory obligations. Asset register must track license association for FCC technical compliance, insurance, a | Column broadcast_license_id (BIGINT) in compliance.fixed_asset']
  capex_project_id varchar [note: 'Reference to the capital expenditure project under which this asset was approved and funded. Links the asset to CAPEX budget tracking and project lifecycle. | Column capex_project_id (BIGINT) in finance.fixed_asset']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Fixed assets belong to legal entities for ownership and depreciation tracking. The company_code is a business key reference to legal_entity. | Column company_legal_entity_id (BIGINT) in finance.fixed_asset']
  cost_center_id varchar [note: 'Reference to the cost center responsible for this asset. Links the asset to organizational responsibility and budget allocation. | Column cost_center_id (BIGINT) in finance.fixed_asset']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Transmission equipment (transmitters, encoders, satellite uplinks) are capitalized as fixed assets. Finance tracks these for depreciation calculation, insurance valuation, disposal accounting, and reg | Column transmission_equipment_id (BIGINT) in technology.fixed_asset']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.fixed_asset']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.fixed_asset']
  accumulated_depreciation decimal(18,2) [note: 'The total depreciation expense recognized to date since acquisition. Used to calculate net book value. | Column accumulated_depreciation (DECIMAL(18,2)) in finance.fixed_asset']
  acquisition_cost decimal(18,2) [note: 'The original purchase price or capitalized cost of the asset at the time of acquisition, excluding accumulated depreciation. Represents the gross book value. | Column acquisition_cost (DECIMAL(18,2)) in finance.fixed_asset']
  acquisition_date date [note: 'The date on which the asset was acquired or capitalized. This is the principal business event timestamp marking when the asset entered the company\'s balance sheet. | Column acquisition_date (DATE) in finance.fixed_asset']
  asset_class varchar [note: 'Classification code that categorizes the asset type (e.g., broadcast equipment, studio facilities, transmission towers, OTT infrastructure, production equipment, capitalized software). Determines depreciation rules and financial treatment. | Column asset_class (STRING) in finance.fixed_asset']
  asset_description varchar [note: 'Detailed textual description of the fixed asset including make, model, specifications, and location details. Provides human-readable context for the asset. | Column asset_description (STRING) in finance.fixed_asset']
  asset_location varchar [note: 'Physical location or site where the asset is installed or deployed (e.g., transmission tower site, studio facility, data center). Used for asset tracking and maintenance planning. | Column asset_location (STRING) in finance.fixed_asset']
  asset_notes varchar [note: 'Free-text field for additional notes, comments, or special instructions related to the asset. Used for operational context and exception documentation. | Column asset_notes (STRING) in finance.fixed_asset']
  asset_number varchar [note: 'The externally-known unique asset number assigned by SAP FI-AA for tracking and identification purposes. This is the business identifier used across financial reporting and asset management processes. | Column asset_number (STRING) in finance.fixed_asset']
  asset_status varchar [note: 'Current lifecycle status of the fixed asset indicating whether it is in active use, under construction, disposed, retired, or impaired. | Column asset_status (STRING) in finance.fixed_asset']
  asset_sub_number varchar [note: 'Sub-asset number used when a main asset is divided into multiple components for separate depreciation tracking (e.g., building structure vs. HVAC system). | Column asset_sub_number (STRING) in finance.fixed_asset']
  asset_super_number varchar [note: 'Parent asset number when this asset is part of a larger asset hierarchy (e.g., individual broadcast equipment within a transmission tower complex). | Column asset_super_number (STRING) in finance.fixed_asset']
  business_area varchar [note: 'The business area or division to which this asset is allocated (e.g., broadcast operations, streaming platform, production studio). Used for segment reporting. | Column business_area (STRING) in finance.fixed_asset']
  capitalization_date date [note: 'The date on which the asset was placed in service and capitalization began. May differ from acquisition date for assets under construction. | Column capitalization_date (DATE) in finance.fixed_asset']
  company_code varchar [note: 'The SAP company code representing the legal entity that owns this asset. Used for financial consolidation and legal reporting. | Column company_code (STRING) in finance.fixed_asset']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.fixed_asset']
  created_timestamp timestamp [note: 'The timestamp when this fixed asset record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in finance.fixed_asset']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts associated with this asset (acquisition cost, depreciation, net book value). | Column currency_code (STRING) in finance.fixed_asset']
  depreciation_area varchar [note: 'SAP depreciation area code indicating the valuation view (e.g., 01 for book depreciation, 15 for tax depreciation). Supports parallel accounting. | Column depreciation_area (STRING) in finance.fixed_asset']
  depreciation_method varchar [note: 'The accounting method used to calculate periodic depreciation expense for this asset. Determines how the asset\'s cost is allocated over its useful life. | Column depreciation_method (STRING) in finance.fixed_asset']
  disposal_date date [note: 'The date on which the asset was disposed, sold, or retired from service. Null for active assets. | Column disposal_date (DATE) in finance.fixed_asset']
  disposal_method varchar [note: 'The method by which the asset was disposed (e.g., sale, scrap, donation, trade-in, transfer to another entity, write-off). Null for active assets. | Column disposal_method (STRING) in finance.fixed_asset']
  disposal_proceeds decimal(18,2) [note: 'The amount received from the sale or disposal of the asset. Used to calculate gain or loss on disposal. Null for active assets. | Column disposal_proceeds (DECIMAL(18,2)) in finance.fixed_asset']
  ebitda_reporting_segment varchar [note: 'The EBITDA reporting segment to which this asset\'s depreciation expense is allocated. Used for segment profitability analysis and corporate reporting. | Column ebitda_reporting_segment (STRING) in finance.fixed_asset']
  gain_loss_on_disposal decimal(18,2) [note: 'The financial gain or loss recognized upon disposal, calculated as disposal proceeds minus net book value at disposal. Null for active assets. | Column gain_loss_on_disposal (DECIMAL(18,2)) in finance.fixed_asset']
  insurance_policy_number varchar [note: 'The insurance policy number covering this asset. Used for risk management and claims processing. | Column insurance_policy_number (STRING) in finance.fixed_asset']
  last_modified_timestamp timestamp [note: 'The timestamp when this fixed asset record was last updated. Used for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in finance.fixed_asset']
  manufacturer varchar [note: 'Name of the manufacturer or vendor who produced the asset. Used for warranty claims and vendor management. | Column manufacturer (STRING) in finance.fixed_asset']
  model_number varchar [note: 'Manufacturer\'s model number or product code for the asset. Used for parts ordering and technical specifications lookup. | Column model_number (STRING) in finance.fixed_asset']
  net_book_value decimal(18,2) [note: 'The current carrying value of the asset on the balance sheet, calculated as acquisition cost minus accumulated depreciation. Represents the asset\'s current financial value. | Column net_book_value (DECIMAL(18,2)) in finance.fixed_asset']
  purchase_order_number varchar [note: 'The purchase order number under which the asset was originally procured. Links the asset to procurement records. | Column purchase_order_number (STRING) in finance.fixed_asset']
  remaining_useful_life_years decimal(5,2) [note: 'The number of years remaining in the asset\'s useful life as of the current reporting period. Used for forward-looking depreciation planning. | Column remaining_useful_life_years (DECIMAL(5,2)) in finance.fixed_asset']
  serial_number varchar [note: 'Manufacturer\'s serial number or unique equipment identifier for the physical asset. Used for warranty tracking and maintenance records. | Column serial_number (STRING) in finance.fixed_asset']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.fixed_asset']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.fixed_asset']
  sox_control_flag boolean [note: 'Boolean indicator (True/False) denoting whether this asset is subject to SOX financial controls and requires enhanced audit trails and approval workflows. | Column sox_control_flag (BOOLEAN) in finance.fixed_asset']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.fixed_asset']
  useful_life_years decimal(5,2) [note: 'The estimated number of years over which the asset is expected to provide economic benefit and be depreciated. Used in depreciation calculations. | Column useful_life_years (DECIMAL(5,2)) in finance.fixed_asset']
  vendor_name varchar [note: 'Name of the vendor or supplier from whom the asset was purchased. Used for vendor performance tracking. | Column vendor_name (STRING) in finance.fixed_asset']
  warranty_expiration_date date [note: 'The date on which the manufacturer\'s warranty for this asset expires. Used for maintenance planning and cost forecasting. | Column warranty_expiration_date (DATE) in finance.fixed_asset']

  Note: 'SAP FI-AA authoritative master record for all capitalized fixed assets owned by Media Broadcasting — including broadcast transmission towers, satellite uplink equipment, studio facilities, OTT server infrastructure, production equipment, and capitalized software. Captures asset number, asset class, description, acquisition date, acquisition cost, accumulated depreciation, net book value, depreciation method, useful life, cost center, and disposal status. Supports balance sheet reporting and CAPEX-to-asset lifecycle tracking. | Unity Catalog table: media_broadcasting_ecm.finance.fixed_asset SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.depreciation_run {
  depreciation_run_id varchar [pk, note: 'Unique identifier for the depreciation calculation and posting run. Primary key for the depreciation run record. | Column depreciation_run_id (BIGINT) in finance.depreciation_run']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Depreciation runs are executed per legal entity in SAP FI-AA. The company_code is a business key reference to legal_entity. | Column company_legal_entity_id (BIGINT) in finance.depreciation_run']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Depreciation can be allocated to cost centers for expense tracking. The cost_center_code STRING column will be replaced by FK to cost_center.cost_center_id. | Column cost_center_id (BIGINT) in finance.depreciation_run']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Depreciation can be allocated to profit centers for P&L tracking. The profit_center_code STRING column will be replaced by FK to profit_center.profit_center_id. | Column profit_center_id (BIGINT) in finance.depreciation_run']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.depreciation_run']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.depreciation_run']
  asset_class varchar [note: 'Classification code grouping fixed assets by type (e.g., broadcast equipment, studio facilities, transmission towers, vehicles, IT infrastructure). Determines default depreciation methods, useful life, and general ledger account assignments. | Column asset_class (STRING) in finance.depreciation_run']
  asset_count varchar [note: 'The total number of fixed asset records processed in this depreciation run for the specified company code, asset class, and depreciation area. Used for run completeness validation and audit trail. | Column asset_count (INT) in finance.depreciation_run']
  business_area varchar [note: 'Four-character code representing the business area (e.g., broadcast operations, digital streaming, production services) for segment reporting. Enables EBITDA tracking and financial analysis by business line. | Column business_area (STRING) in finance.depreciation_run']
  company_code varchar [note: 'Four-character alphanumeric code identifying the legal entity within the SAP enterprise structure for which depreciation is calculated. Represents the smallest organizational unit for which a complete self-contained set of accounts can be drawn up for purposes of external reporting. | Column company_code (STRING) in finance.depreciation_run']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.depreciation_run']
  created_timestamp timestamp [note: 'The timestamp when this depreciation run record was first created in the system. Provides audit trail for data lineage and supports SOX compliance requirements. | Column created_timestamp (TIMESTAMP) in finance.depreciation_run']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which depreciation amounts are expressed (e.g., USD, GBP, EUR). Aligns with company code currency and general ledger posting currency. | Column currency_code (STRING) in finance.depreciation_run']
  depreciation_area varchar [note: 'Two-digit code representing the depreciation area (e.g., 01 for book depreciation, 15 for tax depreciation, 20 for group consolidation). Allows parallel valuation of assets according to different accounting principles and legal requirements. | Column depreciation_area (STRING) in finance.depreciation_run']
  depreciation_method varchar [note: 'Four-character code identifying the depreciation calculation method applied (e.g., straight-line, declining balance, units of production). Determines how asset value reduction is calculated over the useful life. | Column depreciation_method (STRING) in finance.depreciation_run']
  document_date date [note: 'The document date assigned to the general ledger posting document created by the depreciation run. Typically matches the last day of the posting period for period-end depreciation postings. | Column document_date (DATE) in finance.depreciation_run']
  document_number varchar [note: 'Ten-digit SAP financial document number generated when depreciation amounts are posted to the general ledger. Provides the link between asset accounting and financial accounting for audit trail and reconciliation. | Column document_number (STRING) in finance.depreciation_run']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  ebitda_reporting_segment varchar [note: 'The EBITDA reporting segment to which this depreciation run contributes. Used for segment-level financial analysis and executive reporting of operating performance before depreciation impact. | Column ebitda_reporting_segment (STRING) in finance.depreciation_run']
  error_count varchar [note: 'The number of asset records that encountered errors during the depreciation calculation or posting process. Non-zero values trigger exception handling and require investigation before period-end close. | Column error_count (INT) in finance.depreciation_run']
  error_log_reference varchar [note: 'Reference identifier or file path to the detailed error log generated during the depreciation run. Used for troubleshooting and resolving posting errors before period-end close. | Column error_log_reference (STRING) in finance.depreciation_run']
  fiscal_year varchar [note: 'The fiscal year for which the depreciation run was executed. Represents the accounting period year in which the depreciation expense is recognized. | Column fiscal_year (INT) in finance.depreciation_run']
  last_modified_timestamp timestamp [note: 'The timestamp when this depreciation run record was last updated. Tracks changes to run status, posted amounts, or other attributes for audit trail and data quality monitoring. | Column last_modified_timestamp (TIMESTAMP) in finance.depreciation_run']
  notes varchar [note: 'Free-text field for capturing additional context, explanations for variances, manual adjustments applied, or special circumstances related to the depreciation run. Supports audit trail and period-end close documentation. | Column notes (STRING) in finance.depreciation_run']
  planned_depreciation_amount decimal(18,2) [note: 'The total depreciation expense amount calculated by the system for the specified period, company code, and depreciation area based on asset master data and depreciation rules. Represents the expected value reduction before any adjustments or errors. | Column planned_depreciation_amount (DECIMAL(18,2)) in finance.depreciation_run']
  posted_depreciation_amount decimal(18,2) [note: 'The actual depreciation expense amount successfully posted to the general ledger for the period. May differ from planned amount due to posting errors, manual adjustments, or period-end corrections. | Column posted_depreciation_amount (DECIMAL(18,2)) in finance.depreciation_run']
  posting_date date [note: 'The date on which the depreciation amounts were posted to the general ledger. Determines the fiscal period and year in which the expense is recognized for financial reporting purposes. | Column posting_date (DATE) in finance.depreciation_run']
  posting_period varchar [note: 'The posting period within the fiscal year (typically 1-12 for monthly periods, or 1-16 including special periods) to which the depreciation amounts are posted. Aligns with the period-end close calendar. | Column posting_period (INT) in finance.depreciation_run']
  repeat_run_indicator boolean [note: 'Boolean flag indicating whether this run is a repeat execution for a period that was previously processed. True indicates repeat run to correct prior errors; false indicates initial run for the period. | Column repeat_run_indicator (BOOLEAN) in finance.depreciation_run']
  reversal_date date [note: 'The date on which the depreciation run posting was reversed in the general ledger. Null if no reversal has occurred. Used for period-end close reconciliation and audit trail. | Column reversal_date (DATE) in finance.depreciation_run']
  reversal_document_number varchar [note: 'The SAP financial document number of the reversal posting if this depreciation run was reversed. Null if no reversal has occurred. Links to the reversing document for audit trail. | Column reversal_document_number (STRING) in finance.depreciation_run']
  reversal_indicator boolean [note: 'Boolean flag indicating whether this depreciation run was subsequently reversed due to errors or period adjustments. True indicates the run was reversed; false indicates the run remains active. | Column reversal_indicator (BOOLEAN) in finance.depreciation_run']
  run_completed_timestamp timestamp [note: 'The precise date and time when the depreciation run completed processing (successfully or with errors). Used to calculate run duration and monitor period-end close performance. | Column run_completed_timestamp (TIMESTAMP) in finance.depreciation_run']
  run_date date [note: 'The calendar date on which the depreciation calculation and posting run was executed. Used for audit trail and reconciliation purposes. | Column run_date (DATE) in finance.depreciation_run']
  run_initiated_by_user varchar [note: 'The SAP user ID of the person or system account that initiated the depreciation run. Provides accountability and audit trail for period-end close activities and SOX compliance. | Column run_initiated_by_user (STRING) in finance.depreciation_run']
  run_status varchar [note: 'Current lifecycle status of the depreciation run. Tracks progression from initiation through completion or failure, supporting period-end close monitoring and exception management. | Column run_status (STRING) in finance.depreciation_run']
  run_timestamp timestamp [note: 'The precise date and time when the depreciation run was initiated in the SAP FI-AA system. Provides granular audit trail for period-end close activities. | Column run_timestamp (TIMESTAMP) in finance.depreciation_run']
  run_type varchar [note: 'Categorization of the depreciation run execution. Planned runs are scheduled periodic calculations; unplanned runs address mid-period adjustments; repeat runs correct prior errors; test runs validate configuration without posting. | Column run_type (STRING) in finance.depreciation_run']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.depreciation_run']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.depreciation_run']
  sox_control_flag boolean [note: 'Boolean flag indicating whether this depreciation run is subject to SOX internal control requirements for financial reporting accuracy. True indicates SOX-controlled process requiring additional audit trail and approval workflows. | Column sox_control_flag (BOOLEAN) in finance.depreciation_run']
  test_run_indicator boolean [note: 'Boolean flag indicating whether this was a test run executed to validate depreciation calculations without posting to the general ledger. True indicates test mode; false indicates production posting run. | Column test_run_indicator (BOOLEAN) in finance.depreciation_run']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.depreciation_run']
  variance_amount decimal(18,2) [note: 'The difference between planned depreciation amount and posted depreciation amount (posted minus planned). Positive variance indicates over-posting; negative variance indicates under-posting. Used for reconciliation and exception investigation. | Column variance_amount (DECIMAL(18,2)) in finance.depreciation_run']
  warning_count varchar [note: 'The number of asset records that generated warnings during the depreciation run. Warnings indicate potential data quality issues or configuration anomalies that do not prevent posting but require review. | Column warning_count (INT) in finance.depreciation_run']

  Note: 'Record of each periodic depreciation calculation and posting run executed in SAP FI-AA for Media Broadcasting fixed assets. Captures depreciation run date, company code, asset class, depreciation area, planned depreciation amount, posted depreciation amount, depreciation method, fiscal period, run status, and error count. Provides the audit trail for asset value reduction postings and supports period-end close and balance sheet accuracy. | Unity Catalog table: media_broadcasting_ecm.finance.depreciation_run SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.tax_posting {
  tax_posting_id varchar [pk, note: 'Unique identifier for the tax posting record in SAP FI. Primary key for the tax posting entity. | Column tax_posting_id (BIGINT) in finance.tax_posting']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Property taxes, facility-specific taxes, and local jurisdiction taxes are posted by facility location. Finance tracks tax obligations by facility for compliance reporting, tax return preparation, and  | Column broadcast_facility_id (BIGINT) in technology.tax_posting']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Tax postings reference GL accounts for tax liability and expense tracking. The gl_account_number STRING is a business key that should be supplemented with FK to chart_of_accounts.chart_of_accounts_id. | Column chart_of_accounts_id (BIGINT) in finance.tax_posting']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Tax postings belong to legal entities for tax reporting and compliance. The company_code is a business key reference to legal_entity. | Column company_legal_entity_id (BIGINT) in finance.tax_posting']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Tax postings can be allocated to cost centers for expense tracking. The cost_center_code STRING column will be replaced by FK to cost_center.cost_center_id. | Column cost_center_id (BIGINT) in finance.tax_posting']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Tax postings can be allocated to profit centers for P&L tracking. The profit_center_code STRING column will be replaced by FK to profit_center.profit_center_id. | Column profit_center_id (BIGINT) in finance.tax_posting']
  subscriber_id varchar [note: 'SAP customer master record number when the tax posting relates to a customer transaction (e.g., VAT on advertising sales or sales tax on subscriber transactions). Null for vendor-related tax postings. | Column subscriber_id (BIGINT) in subscriber.tax_posting']
  vendor_id varchar [note: 'SAP vendor master record number when the tax posting relates to a vendor payment (e.g., withholding tax on talent or licensor payments). Null for customer-related tax postings. | Column vendor_id (BIGINT) in partner.tax_posting']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.tax_posting']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.tax_posting']
  audit_trail_notes varchar [note: 'Free-text field for documenting special circumstances, adjustments, or explanations related to the tax posting. Used for audit defense and tax authority inquiries. | Column audit_trail_notes (STRING) in finance.tax_posting']
  business_area varchar [note: 'Business area classification for cross-company code reporting. Used to consolidate tax postings across multiple legal entities for enterprise-wide tax analysis. | Column business_area (STRING) in finance.tax_posting']
  clearing_date date [note: 'Date on which the tax liability was settled or cleared through payment to the tax authority. Null for uncleared postings. Used for cash flow analysis and tax remittance tracking. | Column clearing_date (DATE) in finance.tax_posting']
  company_code varchar [note: 'Four-character SAP company code representing the legal entity for which the tax posting is recorded. Aligns with organizational structure in SAP S/4HANA FI module. | Column company_code (STRING) in finance.tax_posting']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.tax_posting']
  created_by_user varchar [note: 'SAP user ID of the person or system process that created the tax posting record. Used for audit trail and accountability. | Column created_by_user (STRING) in finance.tax_posting']
  created_timestamp timestamp [note: 'Timestamp when the tax posting record was first created in SAP FI. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in finance.tax_posting']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the tax posting amounts. All monetary values in this record are denominated in this currency. | Column currency_code (STRING) in finance.tax_posting']
  document_date date [note: 'Date of the source document (invoice, payment, contract) that triggered the tax posting. May differ from posting date due to processing delays. | Column document_date (DATE) in finance.tax_posting']
  fiscal_year varchar [note: 'Four-digit fiscal year in which the tax posting was recorded. Used for period-based tax reporting and compliance. | Column fiscal_year (INT) in finance.tax_posting']
  gl_account_number varchar [note: 'The general ledger account number to which the tax amount is posted. Typically a tax liability or tax expense account in the chart of accounts. | Column gl_account_number (STRING) in finance.tax_posting']
  last_modified_by_user varchar [note: 'SAP user ID of the person or system process that last modified the tax posting record. Used for audit trail and change tracking. | Column last_modified_by_user (STRING) in finance.tax_posting']
  last_modified_timestamp timestamp [note: 'Timestamp when the tax posting record was last modified in SAP FI. Used for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in finance.tax_posting']
  payment_reference varchar [note: 'Reference number of the payment transaction that cleared this tax liability. Links the tax posting to the actual remittance to the tax authority. | Column payment_reference (STRING) in finance.tax_posting']
  posting_date date [note: 'Date on which the tax posting was recorded in the general ledger. Determines the accounting period for financial reporting and tax return preparation. | Column posting_date (DATE) in finance.tax_posting']
  posting_status varchar [note: 'Current lifecycle status of the tax posting. Posted indicates active posting; Parked indicates pending approval; Cleared indicates settled with tax authority; Reversed indicates cancelled by reversal entry; Cancelled indicates voided before posting. | Column posting_status (STRING) in finance.tax_posting']
  reference_document_number varchar [note: 'External reference number linking the tax posting to the originating business transaction (invoice number, payment reference, contract number). Used for audit trail and reconciliation. | Column reference_document_number (STRING) in finance.tax_posting']
  reversal_indicator boolean [note: 'Boolean flag indicating whether this tax posting is a reversal of a previous posting. True if this is a reversal entry; False for original postings. | Column reversal_indicator (BOOLEAN) in finance.tax_posting']
  reversed_document_number varchar [note: 'Tax document number of the original posting that this entry reverses. Populated only when reversal_indicator is True. Used for audit trail and reconciliation. | Column reversed_document_number (STRING) in finance.tax_posting']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.tax_posting']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.tax_posting']
  sox_control_flag boolean [note: 'Boolean flag indicating whether this tax posting is subject to SOX internal controls and audit requirements. True for material tax postings requiring additional review and documentation. | Column sox_control_flag (BOOLEAN) in finance.tax_posting']
  tax_amount decimal(18,2) [note: 'The calculated tax amount posted to the tax account. Derived from taxable base amount multiplied by tax rate. Used for tax liability tracking and remittance. | Column tax_amount (DECIMAL(18,2)) in finance.tax_posting']
  tax_code varchar [note: 'SAP tax code identifying the tax type, rate, and calculation method. Examples include VAT codes, withholding tax codes, sales tax codes, and use tax codes configured in SAP FI. | Column tax_code (STRING) in finance.tax_posting']
  tax_document_number varchar [note: 'Ten-digit SAP document number uniquely identifying the tax posting document within the company code and fiscal year. Used for audit trail and tax return reconciliation. | Column tax_document_number (STRING) in finance.tax_posting']
  tax_jurisdiction varchar [note: 'Code identifying the tax authority or jurisdiction (country, state, province, municipality) to which the tax is owed. Critical for multi-jurisdictional tax compliance and reporting. | Column tax_jurisdiction (STRING) in finance.tax_posting']
  tax_rate decimal(5,2) [note: 'The percentage rate applied to the taxable base amount to calculate the tax amount. Expressed as a percentage (e.g., 20.00 for 20% VAT). | Column tax_rate (DECIMAL(5,2)) in finance.tax_posting']
  tax_reporting_country varchar [note: 'Three-letter ISO 3166 country code identifying the country where the tax return will be filed. May differ from company code country for cross-border transactions. | Column tax_reporting_country (STRING) in finance.tax_posting']
  tax_return_period varchar [note: 'The reporting period (quarterly or monthly) to which this tax posting applies for tax return filing. Format: YYYY-Q# for quarterly or YYYY-M## for monthly (e.g., 2024-Q1, 2024-M03). | Column tax_return_period (STRING) in finance.tax_posting']
  tax_type varchar [note: 'Classification of the tax posting by tax category. VAT/GST applies to advertising sales and subscription revenue; withholding tax applies to talent and licensor payments; sales tax applies to subscriber transactions; use tax applies to equipment purchases. | Column tax_type (STRING) in finance.tax_posting']
  taxable_base_amount decimal(18,2) [note: 'The gross amount subject to taxation before tax calculation. Represents the revenue, payment, or transaction value on which the tax is computed. | Column taxable_base_amount (DECIMAL(18,2)) in finance.tax_posting']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.tax_posting']

  Note: 'Record of tax-related financial postings in SAP FI for Media Broadcasting — covering VAT/GST on advertising sales, withholding tax on talent and licensor payments, sales tax on subscriber transactions, and use tax on equipment purchases. Captures tax document number, tax code, tax jurisdiction, taxable base amount, tax amount, tax rate, company code, posting date, and tax return period. Supports indirect tax compliance, tax return preparation, and audit defense. | Unity Catalog table: media_broadcasting_ecm.finance.tax_posting SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.ebitda_snapshot {
  ebitda_snapshot_id varchar [pk, note: 'Unique identifier for the EBITDA snapshot record. Primary key for this period-locked financial management reporting record. | Column ebitda_snapshot_id (BIGINT) in finance.ebitda_snapshot']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: License-level EBITDA reporting is required for debt covenant compliance, ownership attribution calculations (JSA/SSA revenue sharing), and FCC financial qualification reviews during license transfers. | Column broadcast_license_id (BIGINT) in compliance.ebitda_snapshot']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: EBITDA snapshots are per legal entity for management reporting and consolidation. The company_code is a business key reference to legal_entity. | Column company_legal_entity_id (BIGINT) in finance.ebitda_snapshot']
  cost_center_id varchar [note: 'Reference to the cost center associated with this EBITDA snapshot. Cost centers track where costs are incurred within the organization. | Column cost_center_id (BIGINT) in finance.ebitda_snapshot']
  profit_center_id varchar [note: 'Reference to the profit center for which this EBITDA snapshot is recorded. Profit centers represent organizational units responsible for costs and revenues. | Column profit_center_id (BIGINT) in finance.ebitda_snapshot']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.ebitda_snapshot']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.ebitda_snapshot']
  advertising_revenue_amount decimal(18,2) [note: 'Total revenue generated from advertising sales during the reporting period, including linear TV ads, digital ads, and DAI (Dynamic Ad Insertion). | Column advertising_revenue_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  approval_timestamp timestamp [note: 'Date and time when this EBITDA snapshot was approved and finalized for management reporting. | Column approval_timestamp (TIMESTAMP) in finance.ebitda_snapshot']
  approved_by_user varchar [note: 'User ID or name of the manager or controller who approved this EBITDA snapshot for final reporting. | Column approved_by_user (STRING) in finance.ebitda_snapshot']
  budget_ebitda_amount decimal(18,2) [note: 'Budgeted EBITDA amount for this reporting period as approved in the annual planning cycle. | Column budget_ebitda_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  budget_variance_amount decimal(18,2) [note: 'Variance between actual EBITDA and budgeted EBITDA, calculated as actual minus budget. | Column budget_variance_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  budget_variance_percentage decimal(5,2) [note: 'Budget variance expressed as a percentage of budgeted EBITDA. | Column budget_variance_percentage (DECIMAL(5,2)) in finance.ebitda_snapshot']
  business_segment varchar [note: 'The business segment classification for this EBITDA snapshot, such as Linear Broadcasting, Streaming/OTT, Content Production, or Syndication. | Column business_segment (STRING) in finance.ebitda_snapshot']
  carriage_fee_revenue_amount decimal(18,2) [note: 'Revenue from carriage fees and retransmission consent agreements with MVPDs (Multichannel Video Programming Distributors) and vMVPDs during the reporting period. | Column carriage_fee_revenue_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  company_code varchar [note: 'The SAP company code representing the legal entity for which this EBITDA snapshot is recorded. | Column company_code (STRING) in finance.ebitda_snapshot']
  content_acquisition_cost_amount decimal(18,2) [note: 'Direct costs for acquiring or licensing content during the reporting period, including rights payments and royalties. | Column content_acquisition_cost_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  controlling_area varchar [note: 'The controlling area in SAP CO that groups one or more company codes for management accounting purposes. | Column controlling_area (STRING) in finance.ebitda_snapshot']
  covenant_compliance_flag boolean [note: 'Indicates whether this EBITDA snapshot is used for debt covenant compliance reporting and monitoring. | Column covenant_compliance_flag (BOOLEAN) in finance.ebitda_snapshot']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.ebitda_snapshot']
  created_timestamp timestamp [note: 'Date and time when this EBITDA snapshot record was first created in the system. | Column created_timestamp (TIMESTAMP) in finance.ebitda_snapshot']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which all monetary amounts in this snapshot are denominated. | Column currency_code (STRING) in finance.ebitda_snapshot']
  distribution_cost_amount decimal(18,2) [note: 'Direct costs for content distribution and delivery, including CDN (Content Delivery Network) fees, playout, and transmission costs. | Column distribution_cost_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  ebitda_amount decimal(18,2) [note: 'EBITDA calculated as gross margin minus total operating expenses. This is the authoritative management reporting metric for operational profitability. | Column ebitda_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  ebitda_margin_percentage decimal(5,2) [note: 'EBITDA expressed as a percentage of total revenue. Key profitability metric for board reporting and covenant compliance. | Column ebitda_margin_percentage (DECIMAL(5,2)) in finance.ebitda_snapshot']
  facilities_expense_amount decimal(18,2) [note: 'Operating expenses for facilities, rent, utilities, and physical infrastructure during the reporting period. | Column facilities_expense_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  fiscal_period varchar [note: 'The fiscal period (month or quarter) within the fiscal year for which this EBITDA snapshot is recorded. | Column fiscal_period (INT) in finance.ebitda_snapshot']
  fiscal_year varchar [note: 'The fiscal year for which this EBITDA snapshot is recorded, representing the annual accounting period. | Column fiscal_year (INT) in finance.ebitda_snapshot']
  forecast_ebitda_amount decimal(18,2) [note: 'Latest forecast EBITDA amount for this reporting period, updated through rolling forecast processes. | Column forecast_ebitda_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  forecast_variance_amount decimal(18,2) [note: 'Variance between actual EBITDA and forecast EBITDA, calculated as actual minus forecast. | Column forecast_variance_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  forecast_variance_percentage decimal(5,2) [note: 'Forecast variance expressed as a percentage of forecast EBITDA. | Column forecast_variance_percentage (DECIMAL(5,2)) in finance.ebitda_snapshot']
  gross_margin_amount decimal(18,2) [note: 'Gross margin calculated as total revenue minus total direct costs for the reporting period. | Column gross_margin_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  gross_margin_percentage decimal(5,2) [note: 'Gross margin expressed as a percentage of total revenue. | Column gross_margin_percentage (DECIMAL(5,2)) in finance.ebitda_snapshot']
  last_modified_timestamp timestamp [note: 'Date and time when this EBITDA snapshot record was last modified before being locked. | Column last_modified_timestamp (TIMESTAMP) in finance.ebitda_snapshot']
  marketing_expense_amount decimal(18,2) [note: 'Operating expenses for marketing, advertising, and promotional activities during the reporting period. | Column marketing_expense_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  notes varchar [note: 'Free-text notes and commentary from management regarding this EBITDA snapshot, including explanations of variances or one-time adjustments. | Column notes (STRING) in finance.ebitda_snapshot']
  other_direct_cost_amount decimal(18,2) [note: 'Other direct costs not classified in the primary cost categories but directly attributable to revenue generation. | Column other_direct_cost_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  other_operating_expense_amount decimal(18,2) [note: 'Other operating expenses not classified in the primary expense categories. | Column other_operating_expense_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  other_revenue_amount decimal(18,2) [note: 'Revenue from other sources not classified in the primary revenue streams, such as merchandise, events, or ancillary services. | Column other_revenue_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  period_lock_date date [note: 'The date on which this EBITDA snapshot was locked and became the authoritative management reporting record. | Column period_lock_date (DATE) in finance.ebitda_snapshot']
  personnel_expense_amount decimal(18,2) [note: 'Operating expenses for personnel costs including salaries, benefits, and talent residuals during the reporting period. | Column personnel_expense_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  prepared_by_user varchar [note: 'User ID or name of the financial analyst who prepared this EBITDA snapshot. | Column prepared_by_user (STRING) in finance.ebitda_snapshot']
  prior_period_ebitda_amount decimal(18,2) [note: 'EBITDA amount from the comparable prior period (prior year same period) for variance analysis. | Column prior_period_ebitda_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  prior_period_variance_amount decimal(18,2) [note: 'Variance between current period EBITDA and prior period EBITDA, calculated as current minus prior. | Column prior_period_variance_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  prior_period_variance_percentage decimal(5,2) [note: 'Prior period variance expressed as a percentage of prior period EBITDA. | Column prior_period_variance_percentage (DECIMAL(5,2)) in finance.ebitda_snapshot']
  production_cost_amount decimal(18,2) [note: 'Direct costs for content production and post-production activities during the reporting period. | Column production_cost_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  reporting_period_end_date date [note: 'The end date of the reporting period covered by this EBITDA snapshot. | Column reporting_period_end_date (DATE) in finance.ebitda_snapshot']
  reporting_period_start_date date [note: 'The start date of the reporting period covered by this EBITDA snapshot. | Column reporting_period_start_date (DATE) in finance.ebitda_snapshot']
  snapshot_number varchar [note: 'Business identifier for this EBITDA snapshot, typically following a sequential or period-based numbering scheme for management reporting. | Column snapshot_number (STRING) in finance.ebitda_snapshot']
  snapshot_status varchar [note: 'Current status of this EBITDA snapshot in the period-close workflow. Once locked, the snapshot becomes the authoritative record for board reporting and covenant compliance. | Column snapshot_status (STRING) in finance.ebitda_snapshot']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.ebitda_snapshot']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.ebitda_snapshot']
  sox_control_flag boolean [note: 'Indicates whether this EBITDA snapshot is subject to SOX financial reporting controls and audit requirements. | Column sox_control_flag (BOOLEAN) in finance.ebitda_snapshot']
  subscription_revenue_amount decimal(18,2) [note: 'Total revenue from subscription services during the reporting period, including SVOD (Subscription Video On Demand) and membership fees. | Column subscription_revenue_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  syndication_revenue_amount decimal(18,2) [note: 'Revenue from content syndication and licensing to third-party broadcasters and platforms during the reporting period. | Column syndication_revenue_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  technology_expense_amount decimal(18,2) [note: 'Operating expenses for technology infrastructure, software licenses, and IT services during the reporting period. | Column technology_expense_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  total_direct_cost_amount decimal(18,2) [note: 'Total direct costs for the reporting period. Sum of content acquisition, production, distribution, and other direct costs. | Column total_direct_cost_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  total_operating_expense_amount decimal(18,2) [note: 'Total operating expenses for the reporting period. Sum of personnel, marketing, technology, facilities, and other operating expenses. | Column total_operating_expense_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  total_revenue_amount decimal(18,2) [note: 'Total revenue across all streams for the reporting period. Sum of advertising, subscription, carriage fees, syndication, and other revenue. | Column total_revenue_amount (DECIMAL(18,2)) in finance.ebitda_snapshot']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.ebitda_snapshot']

  Note: 'Periodic management accounting snapshot capturing EBITDA (Earnings Before Interest, Taxes, Depreciation, and Amortization) by profit center, business segment, and reporting period for Media Broadcasting. Stores revenue by stream, direct costs, gross margin, operating expenses, EBITDA amount, EBITDA margin percentage, prior period comparison, budget variance, and forecast variance. Derived from SAP CO actual postings and serves as the authoritative management reporting record — NOT an analytics aggregate but a period-locked financial record used for board reporting and covenant compliance. | Unity Catalog table: media_broadcasting_ecm.finance.ebitda_snapshot SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.financial_reconciliation {
  financial_reconciliation_id varchar [pk, note: 'Unique identifier for the financial reconciliation record. Primary key for the financial reconciliation entity. | Column financial_reconciliation_id (BIGINT) in finance.financial_reconciliation']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Reconciliations are performed per GL account. The gl_account_number STRING is a business key that should be supplemented with FK to chart_of_accounts.chart_of_accounts_id. | Column chart_of_accounts_id (BIGINT) in finance.financial_reconciliation']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Financial reconciliations are performed per legal entity during period-end close. The company_code is a business key reference to legal_entity. | Column company_legal_entity_id (BIGINT) in finance.financial_reconciliation']
  primary_financial_reconciler_employee_id varchar [note: 'Employee identifier of the person who performed the reconciliation, used for audit trail and accountability purposes. | Column primary_financial_reconciler_employee_id (BIGINT) in workforce.financial_reconciliation']
  reviewer_employee_id varchar [note: 'Employee identifier of the person who reviewed the reconciliation, supporting SOX-compliant segregation of duties. | Column reviewer_employee_id (BIGINT) in workforce.financial_reconciliation']
  sox_control_id varchar [note: 'Foreign key linking to compliance.sox_control. Business justification: Reconciliations are SOX control activities (account reconciliation controls). Control testing requires linking reconciliation evidence to control documentation. Finance must track which SOX control ea | Column sox_control_id (BIGINT) in compliance.financial_reconciliation']
  vendor_contract_id varchar [note: 'Foreign key linking to technology.vendor_contract. Business justification: Contract liability reconciliations (prepaid maintenance, deferred service revenue, accrued contract costs) require contract reference. Finance reconciles contract balances monthly for revenue recognit | Column vendor_contract_id (BIGINT) in technology.financial_reconciliation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.financial_reconciliation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.financial_reconciliation']
  adjustment_document_number varchar [note: 'The SAP FI document number of the journal entry posted to resolve the reconciliation variance, providing traceability to corrective actions. | Column adjustment_document_number (STRING) in finance.financial_reconciliation']
  adjustment_required_flag boolean [note: 'Boolean indicator specifying whether a journal entry adjustment is required to resolve the identified variance. | Column adjustment_required_flag (BOOLEAN) in finance.financial_reconciliation']
  company_code varchar [note: 'SAP company code representing the legal entity for which this reconciliation is performed, enabling multi-entity financial consolidation. | Column company_code (STRING) in finance.financial_reconciliation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.financial_reconciliation']
  created_by_user varchar [note: 'The system user ID of the person who created this reconciliation record, supporting audit trail and accountability. | Column created_by_user (STRING) in finance.financial_reconciliation']
  created_timestamp timestamp [note: 'The date and time when this reconciliation record was first created in the system, supporting audit trail and data lineage requirements. | Column created_timestamp (TIMESTAMP) in finance.financial_reconciliation']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the reconciliation amounts, supporting multi-currency financial operations. | Column currency_code (STRING) in finance.financial_reconciliation']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  ebitda_reporting_segment varchar [note: 'The EBITDA reporting segment to which this reconciliation applies, supporting segment-level financial performance tracking and corporate reporting. | Column ebitda_reporting_segment (STRING) in finance.financial_reconciliation']
  fiscal_period varchar [note: 'The fiscal period (month or quarter) within the fiscal year for which this reconciliation applies, typically used during period-end close. | Column fiscal_period (INT) in finance.financial_reconciliation']
  fiscal_year varchar [note: 'The fiscal year for which this reconciliation is being performed, aligned with Media Broadcasting\'s financial calendar. | Column fiscal_year (INT) in finance.financial_reconciliation']
  gl_account_number varchar [note: 'The general ledger account number from the chart of accounts that is being reconciled, representing the GL balance side of the reconciliation. | Column gl_account_number (STRING) in finance.financial_reconciliation']
  gl_balance_amount decimal(18,2) [note: 'The balance amount recorded in the general ledger for the specified GL account as of the reconciliation date. | Column gl_balance_amount (DECIMAL(18,2)) in finance.financial_reconciliation']
  intercompany_flag boolean [note: 'Boolean indicator specifying whether this reconciliation involves intercompany transactions requiring elimination during financial consolidation. | Column intercompany_flag (BOOLEAN) in finance.financial_reconciliation']
  last_modified_by_user varchar [note: 'The system user ID of the person who last modified this reconciliation record, supporting audit trail and change management. | Column last_modified_by_user (STRING) in finance.financial_reconciliation']
  last_modified_timestamp timestamp [note: 'The date and time when this reconciliation record was last updated, supporting change tracking and audit trail requirements. | Column last_modified_timestamp (TIMESTAMP) in finance.financial_reconciliation']
  materiality_threshold_amount decimal(18,2) [note: 'The predetermined materiality threshold for this reconciliation type; variances below this amount may be considered immaterial and require less investigation. | Column materiality_threshold_amount (DECIMAL(18,2)) in finance.financial_reconciliation']
  reconciler_name varchar [note: 'Full name of the finance team member who performed the reconciliation activity. | Column reconciler_name (STRING) in finance.financial_reconciliation']
  reconciliation_date date [note: 'The business date on which the reconciliation activity was performed or completed, representing the principal business event timestamp for this reconciliation. | Column reconciliation_date (DATE) in finance.financial_reconciliation']
  reconciliation_notes varchar [note: 'Additional free-text notes and comments related to the reconciliation activity, including special circumstances, follow-up actions, or audit observations. | Column reconciliation_notes (STRING) in finance.financial_reconciliation']
  reconciliation_number varchar [note: 'Business-facing unique identifier or reference number assigned to this reconciliation activity for tracking and audit purposes. | Column reconciliation_number (STRING) in finance.financial_reconciliation']
  reconciliation_status varchar [note: 'Current lifecycle status of the reconciliation activity indicating workflow stage and approval state. | Column reconciliation_status (STRING) in finance.financial_reconciliation']
  reconciliation_type varchar [note: 'Category of reconciliation being performed: bank reconciliations, intercompany balance reconciliations, subledger-to-GL reconciliations (AR, AP, fixed assets), or revenue stream reconciliations between Wide Orbit billing, Zuora subscription billing, and SAP FI. [ENUM-REF-CANDIDATE: bank|intercompany|subledger_to_gl|revenue_stream|fixed_asset|accounts_receivable|accounts_payable — 7 candidates stripped; promote to reference product] | Column reconciliation_type (STRING) in finance.financial_reconciliation']
  review_date date [note: 'The date on which the reconciliation was reviewed and validated by the reviewer, part of the SOX control evidence. | Column review_date (DATE) in finance.financial_reconciliation']
  reviewer_name varchar [note: 'Full name of the finance manager or supervisor who reviewed and validated the reconciliation results. | Column reviewer_name (STRING) in finance.financial_reconciliation']
  sign_off_status varchar [note: 'Approval status indicating whether the reconciliation has been formally signed off by the reviewer as part of period-end close procedures. | Column sign_off_status (STRING) in finance.financial_reconciliation']
  sign_off_timestamp timestamp [note: 'The precise date and time when the reconciliation was formally signed off, providing audit trail for SOX compliance. | Column sign_off_timestamp (TIMESTAMP) in finance.financial_reconciliation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.financial_reconciliation']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.financial_reconciliation']
  sox_control_flag boolean [note: 'Boolean indicator specifying whether this reconciliation is part of SOX-compliant internal control procedures requiring enhanced documentation and audit trail. | Column sox_control_flag (BOOLEAN) in finance.financial_reconciliation']
  subledger_balance_amount decimal(18,2) [note: 'The balance amount recorded in the subledger system (AR, AP, fixed assets, or revenue system) as of the reconciliation date, to be compared against the GL balance. | Column subledger_balance_amount (DECIMAL(18,2)) in finance.financial_reconciliation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.financial_reconciliation']
  variance_amount decimal(18,2) [note: 'The calculated difference between the GL balance and the subledger balance, representing the reconciliation discrepancy that requires investigation and resolution. | Column variance_amount (DECIMAL(18,2)) in finance.financial_reconciliation']
  variance_explanation varchar [note: 'Detailed business explanation of the variance identified during reconciliation, including root cause analysis and corrective actions taken or planned. | Column variance_explanation (STRING) in finance.financial_reconciliation']
  variance_percentage decimal(5,2) [note: 'The variance amount expressed as a percentage of the GL balance, used to assess materiality and prioritize reconciliation efforts. | Column variance_percentage (DECIMAL(5,2)) in finance.financial_reconciliation']

  Note: 'Record of financial reconciliation activities performed during period-end close for Media Broadcasting — including bank reconciliations, intercompany balance reconciliations, subledger-to-GL reconciliations (AR, AP, fixed assets), and revenue stream reconciliations between Wide Orbit billing, Zuora subscription billing, and SAP FI. Captures reconciliation type, reconciliation period, system-of-record source, GL balance, subledger balance, variance amount, variance explanation, reconciler, and sign-off status. | Unity Catalog table: media_broadcasting_ecm.finance.financial_reconciliation SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.facility_legal_assignment {
  facility_legal_assignment_id varchar [pk, note: 'Unique identifier for this facility-legal entity assignment record. Primary key. | Column facility_legal_assignment_id (BIGINT) in finance.facility_legal_assignment']
  broadcast_facility_id varchar [note: 'Foreign key linking to the broadcast facility that is associated with the legal entity | Column broadcast_facility_id (BIGINT) in technology.facility_legal_assignment']
  legal_entity_id varchar [note: 'Foreign key linking to the legal entity that has a legal or financial relationship with the broadcast facility | Column legal_entity_id (BIGINT) in finance.facility_legal_assignment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.facility_legal_assignment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.facility_legal_assignment']
  assignment_status varchar [note: 'Current lifecycle status of this facility-legal entity assignment. Values: active (currently in effect), pending (future-dated assignment), expired (past end date), terminated (assignment ended before planned end date). | Column assignment_status (STRING) in finance.facility_legal_assignment']
  cost_allocation_percentage decimal(5,2) [note: 'Percentage of facility operating costs allocated to this legal entity. Used for intercompany charging and cost center allocation. Sum of percentages across all legal entities for a facility should equal 100.00 for shared facilities. | Column cost_allocation_percentage (DECIMAL(5,2)) in finance.facility_legal_assignment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.facility_legal_assignment']
  created_timestamp timestamp [note: 'Timestamp when this assignment record was created in the system. | Column created_timestamp (TIMESTAMP) in finance.facility_legal_assignment']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_end_date date [note: 'Date on which this legal entity assignment ended or will end. Null indicates the assignment is currently active. Used for tracking facility transfers, lease expirations, and reorganizations. | Column effective_end_date (DATE) in finance.facility_legal_assignment']
  effective_start_date date [note: 'Date on which this legal entity assignment became effective. Used for historical tracking of facility ownership and cost allocation changes over time. | Column effective_start_date (DATE) in finance.facility_legal_assignment']
  intercompany_charge_code varchar [note: 'Code used for intercompany billing and cost allocation transactions related to this facility assignment. Links to the chart of accounts for proper financial posting. | Column intercompany_charge_code (STRING) in finance.facility_legal_assignment']
  lease_or_own_flag boolean [note: 'Boolean indicator of whether the facility is leased (true) or owned (false) by this legal entity. Simplified binary view of ownership_type for financial reporting. | Column lease_or_own_flag (BOOLEAN) in finance.facility_legal_assignment']
  ownership_type varchar [note: 'Classification of the legal relationship between the legal entity and the facility. Values: owned (legal entity owns the facility), leased (legal entity leases the facility), shared_services (facility shared across multiple entities), co_location (entity co-located within a facility owned by another entity), managed_services (third-party managed facility used by entity). | Column ownership_type (STRING) in finance.facility_legal_assignment']
  primary_user_flag boolean [note: 'Indicates whether this legal entity is the primary operational user of the facility. Used to designate the primary responsible entity for regulatory reporting and operational management when multiple entities share a facility. | Column primary_user_flag (BOOLEAN) in finance.facility_legal_assignment']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.facility_legal_assignment']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.facility_legal_assignment']
  tax_reporting_entity_flag boolean [note: 'Indicates whether this legal entity is responsible for tax reporting obligations related to this facility (property tax, local business tax, etc.). Critical for multi-entity shared facilities. | Column tax_reporting_entity_flag (BOOLEAN) in finance.facility_legal_assignment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.facility_legal_assignment']
  updated_by varchar [note: 'User or system identifier that last modified this assignment record. | Column updated_by (STRING) in finance.facility_legal_assignment']
  updated_timestamp timestamp [note: 'Timestamp when this assignment record was last modified. | Column updated_timestamp (TIMESTAMP) in finance.facility_legal_assignment']
  created_by varchar [note: 'User or system identifier that created this assignment record. | Column created_by (STRING) in finance.facility_legal_assignment']

  Note: 'This association product represents the legal and financial relationship between a legal entity and a broadcast facility. It captures ownership structure, cost allocation, and operational responsibility for facilities that may be owned, leased, or shared across multiple legal entities within the Media Broadcasting corporate structure. Each record links one legal entity to one broadcast facility with attributes that define the nature of the legal and financial relationship, supporting intercompany charging, tax compliance, and regulatory reporting.. Existence Justification: In Media Broadcasting corporate structures, legal entities commonly operate multiple broadcast facilities (studios, NOCs, transmission sites) across geographic regions, and facilities are frequently shared across multiple legal entities through co-location arrangements, shared services models, or intercompany leasing. The business actively manages these assignments for financial reporting (cost allocation, intercompany charging), tax compliance (property tax responsibility, VAT registration), and regulatory reporting (SOX scope, broadcast license holder designation). This is an operational relationship tracked in ERP and financial systems, not an analytical correlation. | Unity Catalog table: media_broadcasting_ecm.finance.facility_legal_assignment Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.project_assignment {
  project_assignment_id varchar [pk, note: 'Unique identifier for the project assignment record. Primary key. | Column project_assignment_id (BIGINT) in finance.project_assignment']
  budget_line_id varchar [note: 'Associated budget line']
  capex_project_id varchar [note: 'Foreign key linking to the capital expenditure project to which the employee is assigned. | Column capex_project_id (BIGINT) in finance.project_assignment']
  cost_center_id varchar [note: 'Cost center for the assignment']
  primary_project_manager_employee_id varchar [note: 'FK to workforce.employee | Column project_manager_employee_id (BIGINT) in workforce.project_assignment']
  project_approved_by_employee_id varchar [note: 'Employee who approved the assignment']
  project_employee_id varchar [note: 'Foreign key linking to the employee assigned to the capital project. | Column employee_id (BIGINT) in workforce.project_assignment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.project_assignment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.project_assignment']
  actual_amount decimal(18,2)
  actual_cost decimal(18,2) [note: 'Actual cost incurred']
  actual_hours decimal(10,2) [note: 'Actual hours worked on assignment']
  allocation_percent decimal(18,2)
  allocation_percentage decimal(5,2) [note: 'Percentage of the employee\'s working time allocated to this capital project. Used for resource planning and cost allocation. Explicitly identified in detection reasoning as \'allocation_percentage\'. | Column allocation_percentage (DECIMAL(5,2)) in finance.project_assignment']
  approval_status varchar [note: 'Approval status of the assignment']
  approved_timestamp timestamp [note: 'Timestamp of approval']
  assignment_end_date date
  assignment_start_date date
  assignment_status varchar [note: 'Current status of the project assignment. Active indicates the employee is currently working on the project, Planned for future assignments, Completed for finished assignments, Suspended for temporarily paused assignments. | Column assignment_status (STRING) in finance.project_assignment']
  assignment_type varchar [note: 'Type of project assignment']
  billable_flag boolean [note: 'Indicates whether the employee\'s time on this project is billable to the project budget or capitalized as part of project costs. Used for cost accounting and capitalization calculations. Explicitly identified in detection reasoning. | Column billable_flag (BOOLEAN) in finance.project_assignment']
  budget_amount decimal(18,2)
  budgeted_cost decimal(18,2) [note: 'Total budgeted cost']
  budgeted_hours decimal(10,2) [note: 'Budgeted hours for the assignment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.project_assignment']
  created_timestamp timestamp [note: 'Timestamp when the assignment record was created in the system. | Column created_timestamp (TIMESTAMP) in finance.project_assignment']
  end_date date [note: 'Date when the employee\'s assignment to this capital project ended or is planned to end. Null for ongoing assignments. Explicitly identified in detection reasoning. | Column end_date (DATE) in finance.project_assignment']
  hourly_rate decimal(18,2) [note: 'Hourly billing rate for assignment']
  notes varchar [note: 'Additional notes for the assignment']
  rate_currency varchar [note: 'Currency for hourly rate']
  rate_currency_code varchar [note: 'Currency code for hourly rate']
  role varchar [note: 'The specific role or function the employee performs on this capital project. Examples include Project Manager, Technical Lead, Finance Controller, Procurement Specialist. Explicitly identified in detection reasoning. | Column role (STRING) in finance.project_assignment']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.project_assignment']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.project_assignment']
  start_date date [note: 'Date when the employee\'s assignment to this capital project began. Explicitly identified in detection reasoning. | Column start_date (DATE) in finance.project_assignment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.project_assignment']
  updated_timestamp timestamp [note: 'Timestamp when the assignment record was last updated. | Column updated_timestamp (TIMESTAMP) in finance.project_assignment']
  variance_amount decimal(18,2) [note: 'Variance between budgeted and actual']
  variance_hours decimal(10,2) [note: 'Variance between budgeted and actual hours']

  Note: 'This association product represents the Assignment between capex_project and employee. It captures the formal assignment of employees to capital expenditure projects in various roles beyond the single project manager. Each record links one capex_project to one employee with attributes that exist only in the context of this project assignment relationship, including role, time allocation, assignment dates, and billability status.. Existence Justification: In media broadcasting capital projects, multiple employees participate in different specialized roles (project manager, technical lead, finance controller, procurement specialist, engineers, architects) with varying time allocations and assignment periods. Employees work on multiple concurrent capex projects (e.g., a finance controller may oversee budget compliance for 3-4 projects simultaneously at 25% allocation each). The business actively manages these assignments as a workforce planning and project governance process, tracking who is assigned to which project, in what role, for what time period, and at what allocation percentage. | Unity Catalog table: media_broadcasting_ecm.finance.project_assignment SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.obligation_gl_mapping {
  obligation_gl_mapping_id varchar [pk, note: 'Unique identifier for this obligation-to-GL-account mapping record. Primary key. | Column obligation_gl_mapping_id (BIGINT) in finance.obligation_gl_mapping']
  chart_of_accounts_id varchar [note: 'Foreign key linking to the general ledger account used to record costs or financial impacts related to this regulatory obligation. | Column chart_of_accounts_id (BIGINT) in finance.obligation_gl_mapping']
  regulatory_obligation_id varchar [note: 'Foreign key linking to the regulatory obligation that generates financial postings to this GL account. | Column regulatory_obligation_id (BIGINT) in compliance.obligation_gl_mapping']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.obligation_gl_mapping']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.obligation_gl_mapping']
  accrual_required boolean [note: 'Indicates whether costs for this obligation must be accrued in this GL account prior to cash payment. True for obligations with annual fees that must be accrued monthly, regulatory penalties under dispute, or multi-year license fees. Corresponds to accrual_required_flag from detection data. | Column accrual_required (BOOLEAN) in finance.obligation_gl_mapping']
  cost_allocation_rule varchar [note: 'Business rule describing how costs for this obligation should be allocated to this GL account. May reference allocation keys, cost centers, profit centers, or percentage splits (e.g., \'Allocate 60% to linear TV cost center, 40% to OTT\', \'Direct charge to broadcast operations functional area\'). Corresponds to cost_allocation_rule from detection data. | Column cost_allocation_rule (STRING) in finance.obligation_gl_mapping']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.obligation_gl_mapping']
  effective_date date [note: 'Date when this obligation-to-GL-account mapping became or becomes effective. Used to track changes in how obligations are recorded over time (e.g., when a new regulation requires a new GL account, or when cost allocation rules change). Corresponds to effective_date from detection data. | Column effective_date (DATE) in finance.obligation_gl_mapping']
  estimated_annual_amount decimal(18,2) [note: 'Estimated annual financial impact of this obligation in this GL account, in the account\'s currency. Used for budgeting, forecasting, and materiality assessments. May be null for event-driven obligations with unpredictable costs. | Column estimated_annual_amount (DECIMAL(18,2)) in finance.obligation_gl_mapping']
  expiration_date date [note: 'Date when this mapping expires or is superseded by a new mapping rule. Null for ongoing mappings. Supports historical tracking of how obligation accounting has evolved. | Column expiration_date (DATE) in finance.obligation_gl_mapping']
  mapping_status varchar [note: 'Current status of this mapping: active (currently in use for financial postings), inactive (no longer used but retained for historical reference), pending_approval (proposed mapping awaiting finance/compliance approval), superseded (replaced by a newer mapping). | Column mapping_status (STRING) in finance.obligation_gl_mapping']
  mapping_type varchar [note: 'Classification of how this obligation maps to this GL account: license_fee (broadcast spectrum fees), compliance_expense (ongoing compliance costs), capital_expenditure (EAS equipment, closed captioning infrastructure), prepaid_regulatory (prepaid license fees), accrued_penalty (potential fines), legal_reserve (litigation reserves), equipment_maintenance (regulatory equipment upkeep), consulting_fee (compliance consultants), audit_cost (regulatory audits), other. Corresponds to obligation_gl_mapping_type from detection data. | Column mapping_type (STRING) in finance.obligation_gl_mapping']
  notes varchar [note: 'Free-text notes explaining special circumstances, exceptions, or business context for this mapping (e.g., \'Per CFO directive 2023-Q2, all FCC license fees now flow through prepaid account\', \'Mapping changed due to SOX control enhancement\'). | Column notes (STRING) in finance.obligation_gl_mapping']
  reporting_line_item varchar [note: 'The financial statement line item or regulatory report line where this obligation-account combination should be reported. Used for external regulatory financial reporting (e.g., FCC Form 323, Ofcom Annual Return) and internal management reporting. Corresponds to reporting_line_item from detection data. | Column reporting_line_item (STRING) in finance.obligation_gl_mapping']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.obligation_gl_mapping']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.obligation_gl_mapping']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.obligation_gl_mapping']

  Note: 'This association product represents the mapping between regulatory obligations and chart of accounts entries. It captures how each regulatory obligation flows through specific general ledger accounts for financial tracking, cost allocation, and regulatory reporting. Each record links one regulatory obligation to one GL account with mapping rules that govern how compliance costs are recorded and reported.. Existence Justification: In media broadcasting operations, regulatory obligations generate financial impacts across multiple GL accounts (e.g., FCC license fees flow through both regulatory expense and prepaid accounts; EAS equipment obligations touch capex, depreciation, and maintenance accounts). Conversely, each GL account receives postings from multiple regulatory obligations (e.g., the \'Regulatory Compliance Expense\' account aggregates costs from content regulations, licensing, EAS, closed captioning, and public file obligations). The compliance and finance teams actively manage these mappings to ensure proper cost allocation, accrual accounting, and regulatory financial reporting. | Unity Catalog table: media_broadcasting_ecm.finance.obligation_gl_mapping SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.cost_center_obligation_allocation {
  cost_center_obligation_allocation_id varchar [pk, note: 'Unique identifier for this cost center obligation allocation record. Primary key. | Column cost_center_obligation_allocation_id (BIGINT) in finance.cost_center_obligation_allocation']
  cost_approved_by_employee_id varchar [note: 'Employee who approved']
  cost_center_id varchar [note: 'Foreign key linking to the cost center that holds partial responsibility for the regulatory obligation | Column cost_center_id (BIGINT) in finance.cost_center_obligation_allocation']
  cost_responsible_contact_employee_id varchar [note: 'The employee identifier of the individual within this cost center who serves as the primary contact and responsible party for this obligation. Links to employee master data. | Column responsible_contact_employee_id (BIGINT) in workforce.cost_center_obligation_allocation']
  legal_entity_id varchar [note: 'Legal entity for the allocation']
  profit_center_id varchar [note: 'Associated profit center']
  regulatory_obligation_id varchar [note: 'Foreign key linking to the regulatory obligation being allocated across cost centers | Column regulatory_obligation_id (BIGINT) in compliance.cost_center_obligation_allocation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.cost_center_obligation_allocation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.cost_center_obligation_allocation']
  actual_spend_amount decimal(18,2) [note: 'Actual spend against the allocation']
  allocation_amount decimal(18,2)
  allocation_basis varchar [note: 'Basis for allocation calculation']
  allocation_effective_date date [note: 'The date from which this cost center obligation allocation becomes effective and active. | Column allocation_effective_date (DATE) in finance.cost_center_obligation_allocation']
  allocation_end_date date [note: 'The date when this cost center obligation allocation ends or is superseded. Null indicates an ongoing allocation. | Column allocation_end_date (DATE) in finance.cost_center_obligation_allocation']
  allocation_method varchar [note: 'Method used for allocation calculation']
  allocation_percent decimal(18,2)
  allocation_status varchar [note: 'Current status of this allocation: active (currently in effect), inactive (temporarily suspended), pending (approved but not yet effective), superseded (replaced by newer allocation). | Column allocation_status (STRING) in finance.cost_center_obligation_allocation']
  allocation_type varchar [note: 'Type of allocation (direct, shared, overhead)']
  approval_status varchar [note: 'Approval status of the allocation']
  approved_timestamp timestamp [note: 'Timestamp of approval']
  compliance_budget_amount decimal(18,2) [note: 'The budget amount allocated by this cost center specifically for compliance activities related to this regulatory obligation. Denominated in the cost center\'s currency. | Column compliance_budget_amount (DECIMAL(18,2)) in finance.cost_center_obligation_allocation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.cost_center_obligation_allocation']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency code for monetary amounts']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_end_date date
  effective_start_date date
  fiscal_period varchar [note: 'Fiscal period of allocation']
  fiscal_year varchar [note: 'Fiscal year of allocation']
  last_review_date date [note: 'The date when this cost center last reviewed its compliance status and responsibilities for this specific regulatory obligation. | Column last_review_date (DATE) in finance.cost_center_obligation_allocation']
  next_review_date date [note: 'The scheduled date for this cost center\'s next compliance review for this specific regulatory obligation. | Column next_review_date (DATE) in finance.cost_center_obligation_allocation']
  notes varchar [note: 'Free-text field for additional context about this specific cost center\'s responsibility for this obligation, including special arrangements, dependencies, or coordination requirements with other cost centers. | Column notes (STRING) in finance.cost_center_obligation_allocation']
  obligation_allocation_percentage decimal(5,2) [note: 'The percentage of responsibility for this regulatory obligation allocated to this specific cost center. Used for budget allocation and accountability tracking. Sum of all allocations for a given obligation should equal 100%. | Column obligation_allocation_percentage (DECIMAL(5,2)) in finance.cost_center_obligation_allocation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.cost_center_obligation_allocation']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.cost_center_obligation_allocation']
  spend_currency varchar [note: 'Currency of spend amounts']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.cost_center_obligation_allocation']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  variance_amount decimal(18,2) [note: 'Variance between budget and actual']
  variance_percentage decimal(5,2) [note: 'Variance percentage from budget']

  Note: 'This association product represents the allocation of regulatory compliance responsibility and budget across cost centers for specific regulatory obligations. It captures the distributed accountability model where multiple cost centers share responsibility for meeting a single regulatory obligation (e.g., EEO compliance spans HR and station cost centers; closed captioning spans production and engineering). Each record links one cost_center to one regulatory_obligation with allocation percentage, responsible contact, compliance budget, and review dates that exist only in the context of this shared responsibility relationship.. Existence Justification: In media broadcasting operations, regulatory obligations such as EEO compliance, closed captioning requirements, and content licensing span multiple organizational cost centers. A single regulatory obligation (e.g., FCC closed captioning compliance) requires coordinated effort and budget from production studios, engineering operations, and quality assurance cost centers. Conversely, a single cost center (e.g., Digital Platform Operations) is responsible for portions of multiple regulatory obligations (content licensing, data privacy, accessibility standards). The business actively manages these allocations with specific budget amounts, responsible contacts, and review schedules for each cost center-obligation pairing. | Unity Catalog table: media_broadcasting_ecm.finance.cost_center_obligation_allocation SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.cost_center_authorization {
  cost_center_authorization_id varchar [pk, note: 'Unique identifier for this cost center authorization record. Primary key. | Column cost_center_authorization_id (BIGINT) in finance.cost_center_authorization']
  cost_center_id varchar [note: 'Foreign key linking to the cost center for which authorization is granted | Column cost_center_id (BIGINT) in finance.cost_center_authorization']
  cost_employee_id varchar [note: 'Foreign key linking to the employee who holds authorization for this cost center | Column employee_id (BIGINT) in workforce.cost_center_authorization']
  cost_granted_by_employee_id varchar [note: 'Reference to the employee who granted or approved this authorization. Used for audit trail and authorization chain of custody. | Column granted_by_employee_id (BIGINT) in workforce.cost_center_authorization']
  cost_revoked_by_employee_id varchar [note: 'Reference to the employee who revoked this authorization. Null if authorization has not been revoked. | Column revoked_by_employee_id (BIGINT) in workforce.cost_center_authorization']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.cost_center_authorization']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.cost_center_authorization']
  approval_limit_amount decimal(18,2) [note: 'The maximum monetary amount this employee is authorized to approve for transactions against this cost center. Null indicates unlimited approval authority or non-monetary authorization. | Column approval_limit_amount (DECIMAL(18,2)) in finance.cost_center_authorization']
  authorization_level varchar [note: 'The hierarchical authorization level granted to this employee for this cost center. Higher levels typically correspond to higher approval limits and broader authority. | Column authorization_level (STRING) in finance.cost_center_authorization']
  authorization_status varchar [note: 'Current lifecycle status of this authorization indicating whether it is currently in force, suspended temporarily, permanently revoked, or pending activation. | Column authorization_status (STRING) in finance.cost_center_authorization']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.cost_center_authorization']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_end_date date [note: 'The date on which this authorization expires or was revoked. Null indicates an open-ended authorization that remains active. | Column effective_end_date (DATE) in finance.cost_center_authorization']
  effective_start_date date [note: 'The date from which this authorization becomes active and the employee can exercise approval authority for this cost center. | Column effective_start_date (DATE) in finance.cost_center_authorization']
  granted_date date [note: 'The date on which this authorization was officially granted or approved. | Column granted_date (DATE) in finance.cost_center_authorization']
  notes varchar [note: 'Free-text field for additional context, special conditions, or restrictions associated with this authorization. | Column notes (STRING) in finance.cost_center_authorization']
  revocation_reason varchar [note: 'Free-text explanation of why this authorization was revoked (e.g., role change, termination, reorganization, policy violation). | Column revocation_reason (STRING) in finance.cost_center_authorization']
  revoked_date date [note: 'The date on which this authorization was revoked. Null if authorization has not been revoked. | Column revoked_date (DATE) in finance.cost_center_authorization']
  role varchar [note: 'The specific role or capacity in which the employee is authorized for this cost center (e.g., APPROVER, CONTROLLER, PROCUREMENT_MANAGER, DEPARTMENT_HEAD). Determines the type of actions the employee can perform. | Column role (STRING) in finance.cost_center_authorization']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.cost_center_authorization']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.cost_center_authorization']
  sox_control_flag boolean [note: 'Indicates whether this authorization is subject to SOX financial controls and requires enhanced audit trail and segregation of duties validation. | Column sox_control_flag (BOOLEAN) in finance.cost_center_authorization']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.cost_center_authorization']

  Note: 'This association product represents the authorization relationship between cost_center and employee. It captures the formal approval authority granted to employees for specific cost centers, including their role, authorization level, approval limits, and validity period. Each record links one cost_center to one employee with attributes that exist only in the context of this authorization relationship.. Existence Justification: In media broadcasting organizations, cost centers require multiple authorized approvers with different roles and approval limits for financial control and segregation of duties. A single cost center has multiple employees authorized to approve transactions (department heads, finance controllers, procurement managers, budget owners), each with specific authorization levels and monetary limits. Conversely, senior employees (VPs, finance directors) hold approval authority across multiple cost centers within their span of control. The current model\'s single responsible_manager_employee_id cannot represent this multi-approver authorization structure. | Unity Catalog table: media_broadcasting_ecm.finance.cost_center_authorization SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.facility_cost_allocation {
  facility_cost_allocation_id varchar [pk, note: 'Unique identifier for this cost allocation relationship. Primary key. | Column facility_cost_allocation_id (BIGINT) in finance.facility_cost_allocation']
  approved_by_employee_id varchar [note: 'Reference to the employee (typically finance controller or facility manager) who approved this allocation arrangement. | Column approved_by_employee_id (BIGINT) in workforce.facility_cost_allocation']
  broadcast_facility_id varchar [note: 'Foreign key linking to the broadcast facility whose costs are being allocated | Column broadcast_facility_id (BIGINT) in technology.facility_cost_allocation']
  cost_center_id varchar [note: 'Foreign key linking to the cost center that incurs allocated costs from facility usage | Column cost_center_id (BIGINT) in finance.facility_cost_allocation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.facility_cost_allocation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.facility_cost_allocation']
  allocation_method varchar [note: 'The methodology used to calculate the allocation percentage: direct_usage (metered consumption), proportional_headcount (based on staff count), square_footage (based on space occupied), activity_based (based on activity drivers), fixed_percentage (negotiated static allocation). | Column allocation_method (STRING) in finance.facility_cost_allocation']
  allocation_percentage decimal(5,2) [note: 'The percentage of facility costs allocated to this cost center, representing proportional usage or consumption of facility resources. Used for overhead distribution and chargeback calculations. | Column allocation_percentage (DECIMAL(5,2)) in finance.facility_cost_allocation']
  allocation_status varchar [note: 'Current lifecycle status of this allocation relationship: active (costs being allocated), pending (approved but not yet effective), suspended (temporarily paused), terminated (ended). | Column allocation_status (STRING) in finance.facility_cost_allocation']
  approval_date date [note: 'The date when this cost allocation arrangement was approved by finance and facility management. | Column approval_date (DATE) in finance.facility_cost_allocation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.facility_cost_allocation']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_end_date date [note: 'The date on which this cost allocation relationship ends. Null indicates an ongoing allocation arrangement. | Column effective_end_date (DATE) in finance.facility_cost_allocation']
  effective_start_date date [note: 'The date from which this cost allocation relationship becomes active and costs begin to be allocated to the cost center. | Column effective_start_date (DATE) in finance.facility_cost_allocation']
  monthly_allocated_amount decimal(18,2) [note: 'The calculated monthly cost amount allocated to this cost center from this facility, derived from allocation_percentage applied to facility operating costs. Used for budget tracking and variance analysis. | Column monthly_allocated_amount (DECIMAL(18,2)) in finance.facility_cost_allocation']
  notes varchar [note: 'Free-text field for additional context about this allocation relationship, including special arrangements, seasonal adjustments, or business justification. | Column notes (STRING) in finance.facility_cost_allocation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.facility_cost_allocation']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.facility_cost_allocation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.facility_cost_allocation']
  usage_metric_type varchar [note: 'The type of metric used to measure and justify the cost allocation: square_footage (floor space occupied), equipment_count (number of devices/racks), booking_hours (studio/control room reservation time), headcount (staff assigned to facility), bandwidth_gbps (network capacity consumed), power_kva (electrical load). | Column usage_metric_type (STRING) in finance.facility_cost_allocation']
  usage_metric_value decimal(18,2) [note: 'The quantitative value of the usage metric for this allocation relationship. Interpretation depends on usage_metric_type (e.g., 2500.00 square feet, 150.00 booking hours per month, 45.00 equipment units). | Column usage_metric_value (DECIMAL(18,2)) in finance.facility_cost_allocation']

  Note: 'This association product represents the cost allocation relationship between cost centers and broadcast facilities in Media Broadcasting operations. It captures how operational costs are distributed across shared physical infrastructure when multiple departments (news, sports, production, engineering) utilize the same studios, master control rooms, NOCs, and transmission sites. Each record links one cost center to one broadcast facility with allocation percentages, usage periods, and metrics that exist only in the context of this shared-resource relationship.. Existence Justification: In Media Broadcasting operations, broadcast facilities (studios, master control rooms, NOCs, transmission sites) are shared infrastructure used by multiple operational cost centers simultaneously. A single studio facility serves news, sports, and entertainment production departments, while a single cost center like \'Digital Platform Operations\' utilizes multiple facilities (studio, NOC, data center) across different locations. The business actively manages these allocation relationships to distribute facility overhead costs for accurate departmental P&L and EBITDA reporting. | Unity Catalog table: media_broadcasting_ecm.finance.facility_cost_allocation SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

