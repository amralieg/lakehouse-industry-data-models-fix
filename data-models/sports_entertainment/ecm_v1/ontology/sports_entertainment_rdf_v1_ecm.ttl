ind:problemCategory rdf:type rdf:Property ;
    rdfs:label 'Problem Category' ;
    rdfs:comment 'High-level categorization of the problem domain.' ;
    rdfs:domain ind:ProblemRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:problemNumber rdf:type rdf:Property ;
    rdfs:label 'Problem Number' ;
    rdfs:comment 'Human-readable unique business identifier for the problem record, typically following format PRB followed by 7 digits.' ;
    rdfs:domain ind:ProblemRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:problemSubcategory rdf:type rdf:Property ;
    rdfs:label 'Problem Subcategory' ;
    rdfs:comment 'Detailed subcategory providing granular classification within the problem category.' ;
    rdfs:domain ind:ProblemRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceCount rdf:type rdf:Property ;
    rdfs:label 'Recurrence Count' ;
    rdfs:comment 'Number of times this problem has recurred or been reopened.' ;
    rdfs:domain ind:ProblemRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:urgency rdf:type rdf:Property ;
    rdfs:label 'Urgency' ;
    rdfs:comment 'Time sensitivity for resolving the problem based on business needs.' ;
    rdfs:domain ind:ProblemRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorReference rdf:type rdf:Property ;
