ind:underpaymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Underpayment Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment corrects an underpayment on the original claim.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestRate rdf:type rdf:Property ;
    rdfs:label 'Interest Rate' ;
    rdfs:comment 'The interest rate applied when calculating interest on delayed payments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalComments rdf:type rdf:Property ;
    rdfs:label 'Internal Comments' ;
    rdfs:comment 'Internal comments for claims processing staff regarding the adjustment, not shared externally.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eobIndicator rdf:type rdf:Property ;
    rdfs:label 'Eob Indicator' ;
    rdfs:comment 'Flag indicating whether an EOB was generated and sent to the member for this adjustment.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remittanceAdviceIndicator rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Indicator' ;
    rdfs:comment 'Flag indicating whether a remittance advice (835 transaction) was generated and sent to the provider for this adjustment.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialPeriod rdf:type rdf:Property ;
    rdfs:label 'Financial Period' ;
    rdfs:comment 'The financial accounting period (e.g., 2023-Q4, 2023-12) to which this adjustment is allocated for financial reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'The fiscal year to which this adjustment is allocated for financial reporting purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generalLedgerAccount rdf:type rdf:Property ;
    rdfs:label 'General Ledger Account' ;
    rdfs:comment 'The general ledger account code to which this adjustment amount is posted for financial accounting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenter rdf:type rdf:Property ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'The cost center code associated with this adjustment for internal cost allocation and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment reverses a previous adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctionIndicator rdf:type rdf:Property ;
    rdfs:label 'Correction Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment corrects an error in a previous adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemGeneratedIndicator rdf:type rdf:Property ;
    rdfs:label 'System Generated Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment was automatically generated by the claims system versus manually entered.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportingIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment must be included in regulatory reporting (e.g., MLR, state filings).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskAdjustmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment impacts risk adjustment calculations (HCC, RAF scores).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hccImpactIndicator rdf:type rdf:Property ;
    rdfs:label 'Hcc Impact Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment affects HCC coding and risk scores for Medicare Advantage or ACA plans.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureImpactIndicator rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Impact Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment impacts quality measure reporting (HEDIS, Stars).' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processedByUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Processed By User Agent Id' ;
    rdfs:comment 'The user ID of the claims examiner or system user who processed the adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:processingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processing Timestamp' ;
    rdfs:comment 'The date and time when the adjustment was processed in the claims system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Source System Adjustment Id' ;
    rdfs:comment 'The unique adjustment identifier from the source system of record.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingAdjustment .

ind:effectiveStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Start Timestamp' ;
    rdfs:comment 'The timestamp when this adjustment record became effective in the data warehouse for historical tracking.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectiveEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective End Timestamp' ;
    rdfs:comment 'The timestamp when this adjustment record was superseded or became inactive in the data warehouse for historical tracking.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:denialReasonId rdf:type rdf:Property ;
    rdfs:label 'Denial Reason Id' ;
    rdfs:comment 'Unique system-generated identifier for each claim denial reason.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DenialReason .

ind:subCategory rdf:type rdf:Property ;
    rdfs:label 'Sub Category' ;
    rdfs:comment 'More specific classification within the category.' ;
    rdfs:domain ind:DenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAppealable rdf:type rdf:Property ;
    rdfs:label 'Is Appealable' ;
    rdfs:comment 'Indicates whether the denial can be appealed by the provider or member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealWindowDays rdf:type rdf:Property ;
    rdfs:label 'Appeal Window Days' ;
    rdfs:comment 'Number of days after denial within which an appeal may be submitted.' ;
    rdfs:domain ind:DenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defaultAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Default Adjustment Amount' ;
    rdfs:comment 'Standard monetary amount to adjust when this denial reason is applied.' ;
    rdfs:domain ind:DenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultAdjustmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Default Adjustment Percentage' ;
    rdfs:comment 'Standard percentage to adjust payment when this denial reason is applied.' ;
    rdfs:domain ind:DenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:relatedServiceType rdf:type rdf:Property ;
    rdfs:label 'Related Service Type' ;
    rdfs:comment 'Type of service to which the denial reason applies.' ;
    rdfs:domain ind:DenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedServiceCode rdf:type rdf:Property ;
    rdfs:label 'Related Service Code' ;
    rdfs:comment 'Code (e.g., CPT, HCPCS, NDC) associated with the service for this denial reason.' ;
    rdfs:domain ind:DenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Related Diagnosis Code' ;
    rdfs:comment 'ICD-10 diagnosis code linked to the denial reason when applicable.' ;
    rdfs:domain ind:DenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedProcedureCode rdf:type rdf:Property ;
    rdfs:label 'Related Procedure Code' ;
    rdfs:comment 'Procedure code (CPT/HCPCS) associated with the denial reason.' ;
    rdfs:domain ind:DenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Policy Document Reference' ;
    rdfs:comment 'Identifier or URL of the internal policy document that defines this denial reason.' ;
    rdfs:domain ind:DenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReviewTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Review Timestamp' ;
    rdfs:comment 'Date and time when the denial reason was last reviewed for relevance or compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:planEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Plan Enrollment Id' ;
    rdfs:comment 'Unique identifier for the care plan enrollment record. Primary key for the plan enrollment entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlanEnrollment .

ind:planId rdf:type rdf:Property ;
    rdfs:label 'Plan Id' ;
    rdfs:comment 'Unique identifier for the care plan into which the member is enrolled. References the care plan catalog.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:carePlanType rdf:type rdf:Property ;
    rdfs:label 'Care Plan Type' ;
    rdfs:comment 'Classification of the care plan program type (e.g., chronic condition management, disease management, case management).' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carePlanName rdf:type rdf:Property ;
    rdfs:label 'Care Plan Name' ;
    rdfs:comment 'Descriptive name of the care plan program (e.g., Diabetes Management Program, CHF Care Coordination).' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Date' ;
    rdfs:comment 'Date when the member was enrolled into the care plan program.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Enrollment Timestamp' ;
    rdfs:comment 'Precise timestamp when the enrollment was recorded in the system.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:riskStratificationLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Level' ;
    rdfs:comment 'Risk level assigned to the member based on clinical and utilization data (e.g., low risk, moderate risk, high risk).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScore rdf:type rdf:Property ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Numerical risk score calculated for the member based on Hierarchical Condition Categories (HCC) and other risk factors.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Primary Diagnosis Code' ;
    rdfs:comment 'Primary International Classification of Diseases 10th Revision (ICD-10) diagnosis code that qualifies the member for the care plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryDiagnosisDescription rdf:type rdf:Property ;
    rdfs:label 'Primary Diagnosis Description' ;
    rdfs:comment 'Textual description of the primary diagnosis condition.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccCodes rdf:type rdf:Property ;
    rdfs:label 'Hcc Codes' ;
    rdfs:comment 'Comma-separated list of Hierarchical Condition Category (HCC) codes associated with the member for risk adjustment purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedCareManagerName rdf:type rdf:Property ;
    rdfs:label 'Assigned Care Manager Name' ;
    rdfs:comment 'Full name of the care manager assigned to the member.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamId rdf:type rdf:Property ;
    rdfs:label 'Team Id' ;
    rdfs:comment 'Unique identifier for the multidisciplinary care team assigned to support the member\'s care plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Team .

ind:referringProviderId rdf:type rdf:Property ;
    rdfs:label 'Referring Provider Id' ;
    rdfs:comment 'Unique identifier for the provider who referred the member to the care plan program.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:referringProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Referring Provider Npi' ;
    rdfs:comment 'National Provider Identifier (NPI) for the provider who referred the member to the care plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberConsentStatus rdf:type rdf:Property ;
    rdfs:label 'Member Consent Status' ;
    rdfs:comment 'Status of the member\'s consent to participate in the care plan program (e.g., consented, declined, pending, revoked).' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDate rdf:type rdf:Property ;
    rdfs:label 'Consent Date' ;
    rdfs:comment 'Date when the member provided consent to participate in the care plan program.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Method' ;
    rdfs:comment 'Method by which the member provided consent (e.g., verbal, written, electronic, implied).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disenrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Disenrollment Date' ;
    rdfs:comment 'Date when the member was disenrolled or exited from the care plan program.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disenrollmentReason rdf:type rdf:Property ;
    rdfs:label 'Disenrollment Reason' ;
    rdfs:comment 'Reason for the member\'s disenrollment from the care plan (e.g., goals achieved, member declined, loss of eligibility, non-compliance).' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disenrollmentInitiatedBy rdf:type rdf:Property ;
    rdfs:label 'Disenrollment Initiated By' ;
    rdfs:comment 'Party who initiated the disenrollment (e.g., member, care manager, provider, health plan, system).' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programDurationDays rdf:type rdf:Property ;
    rdfs:label 'Program Duration Days' ;
    rdfs:comment 'Expected or actual duration of the care plan enrollment in days.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Target Completion Date' ;
    rdfs:comment 'Target date by which the care plan goals are expected to be achieved.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Date' ;
    rdfs:comment 'Actual date when the care plan goals were achieved and the program was completed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outreachFrequency rdf:type rdf:Property ;
    rdfs:label 'Outreach Frequency' ;
    rdfs:comment 'Planned frequency of care manager outreach to the member (e.g., weekly, monthly, as needed).' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastOutreachDate rdf:type rdf:Property ;
    rdfs:label 'Last Outreach Date' ;
    rdfs:comment 'Date of the most recent care manager outreach or contact with the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextScheduledOutreachDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Outreach Date' ;
    rdfs:comment 'Date when the next care manager outreach or contact with the member is scheduled.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalOutreachAttempts rdf:type rdf:Property ;
    rdfs:label 'Total Outreach Attempts' ;
    rdfs:comment 'Total number of outreach attempts made to the member since enrollment.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:successfulOutreachCount rdf:type rdf:Property ;
    rdfs:label 'Successful Outreach Count' ;
    rdfs:comment 'Number of successful outreach contacts made with the member.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberEngagementLevel rdf:type rdf:Property ;
    rdfs:label 'Member Engagement Level' ;
    rdfs:comment 'Assessment of the member\'s level of engagement and participation in the care plan (e.g., highly engaged, moderately engaged, not engaged).' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barriersToCare rdf:type rdf:Property ;
    rdfs:label 'Barriers To Care' ;
    rdfs:comment 'Documented barriers that may impact the member\'s ability to participate in the care plan (e.g., transportation, language, financial, health literacy).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialDeterminantsOfHealthFlags rdf:type rdf:Property ;
    rdfs:label 'Social Determinants Of Health Flags' ;
    rdfs:comment 'Comma-separated flags indicating social determinants of health factors affecting the member (e.g., housing instability, food insecurity, transportation barriers).' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterRequired rdf:type rdf:Property ;
    rdfs:label 'Interpreter Required' ;
    rdfs:comment 'Indicates whether an interpreter is required for care plan communications.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carePlanGoals rdf:type rdf:Property ;
    rdfs:label 'Care Plan Goals' ;
    rdfs:comment 'Documented goals and objectives established for the member\'s care plan.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carePlanInterventions rdf:type rdf:Property ;
    rdfs:label 'Care Plan Interventions' ;
    rdfs:comment 'Documented interventions and activities planned or delivered as part of the care plan.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisMeasureApplicable rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Applicable' ;
    rdfs:comment 'Comma-separated list of HEDIS quality measures applicable to this care plan enrollment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMeasureGaps rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Gaps' ;
    rdfs:comment 'Documented gaps in care or quality measures that the care plan aims to address.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueBasedCareProgram rdf:type rdf:Property ;
    rdfs:label 'Value Based Care Program' ;
    rdfs:comment 'Name of the Value Based Care (VBC) or Alternative Payment Model (APM) program associated with the care plan enrollment.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acoAffiliation rdf:type rdf:Property ;
    rdfs:label 'Aco Affiliation' ;
    rdfs:comment 'Name or identifier of the Accountable Care Organization (ACO) affiliated with the care plan.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcmhDesignation rdf:type rdf:Property ;
    rdfs:label 'Pcmh Designation' ;
    rdfs:comment 'Indicates whether the member\'s primary care provider has Patient Centered Medical Home (PCMH) designation.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizationRequired rdf:type rdf:Property ;
    rdfs:label 'Authorization Required' ;
    rdfs:comment 'Indicates whether prior authorization is required for care plan services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Authorization Number' ;
    rdfs:comment 'Authorization number for approved care plan services requiring prior authorization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Authorization Status' ;
    rdfs:comment 'Status of the prior authorization for care plan services (e.g., approved, denied, pending, expired).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCostSavings rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Savings' ;
    rdfs:comment 'Estimated cost savings expected from the care plan enrollment based on predictive models.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programCost rdf:type rdf:Property ;
    rdfs:label 'Program Cost' ;
    rdfs:comment 'Total cost of delivering the care plan program to the member.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roiProjection rdf:type rdf:Property ;
    rdfs:label 'Roi Projection' ;
    rdfs:comment 'Projected Return on Investment (ROI) for the care plan enrollment based on cost savings and program costs.' ;
    rdfs:domain ind:PlanEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrollmentSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Enrollment Source System' ;
    rdfs:comment 'Name of the source system or application from which the enrollment record originated (e.g., Pegasystems, Salesforce Health Cloud).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordVersion rdf:type rdf:Property ;
    rdfs:label 'Record Version' ;
    rdfs:comment 'Version number of the enrollment record for tracking changes and updates.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:diagnosisId rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Id' ;
    rdfs:comment 'Unique surrogate key for each claim diagnosis record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Diagnosis .

ind:codingSystem rdf:type rdf:Property ;
    rdfs:label 'Coding System' ;
    rdfs:comment 'Specifies whether the code follows the Clinical Modification (CM) or Procedure Coding System (PCS) subset.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBillable rdf:type rdf:Property ;
    rdfs:label 'Is Billable' ;
    rdfs:comment 'Flag indicating whether the diagnosis is billable under the member’s benefit plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCovered rdf:type rdf:Property ;
    rdfs:label 'Is Covered' ;
    rdfs:comment 'Flag indicating whether the diagnosis is covered by the member’s health plan.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hccIndicator rdf:type rdf:Property ;
    rdfs:label 'Hcc Indicator' ;
    rdfs:comment 'Indicates whether the diagnosis maps to a Hierarchical Condition Category for risk adjustment.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drgDescription rdf:type rdf:Property ;
    rdfs:label 'Drg Description' ;
    rdfs:comment 'Textual description of the DRG code.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apcDescription rdf:type rdf:Property ;
    rdfs:label 'Apc Description' ;
    rdfs:comment 'Description of the APC code.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewStatus rdf:type rdf:Property ;
    rdfs:label 'Review Status' ;
    rdfs:comment 'Current status of the most recent review of the diagnosis code.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isExternal rdf:type rdf:Property ;
    rdfs:label 'Is External' ;
    rdfs:comment 'Indicates whether the diagnosis originates from an external reference source.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEligibleForPayment rdf:type rdf:Property ;
    rdfs:label 'Is Eligible For Payment' ;
    rdfs:comment 'Flag indicating if the diagnosis qualifies for payment under the member’s benefit plan.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Payment Indicator' ;
    rdfs:comment 'Specifies the payment status of the diagnosis for the claim.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costWeight rdf:type rdf:Property ;
    rdfs:label 'Cost Weight' ;
    rdfs:comment 'Weight used in cost calculations and reimbursement models for the diagnosis.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:batchId rdf:type rdf:Property ;
    rdfs:label 'Batch Id' ;
    rdfs:comment 'Unique identifier for the claim batch. Primary key for the claim batch entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Batch .

ind:clearinghouseName rdf:type rdf:Property ;
    rdfs:label 'Clearinghouse Name' ;
    rdfs:comment 'Name of the clearinghouse that processed and forwarded the claim batch, if applicable.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearinghouseId rdf:type rdf:Property ;
    rdfs:label 'Clearinghouse Id' ;
    rdfs:comment 'Unique identifier for the clearinghouse that processed the claim batch.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clearinghouse .

ind:submitterId rdf:type rdf:Property ;
    rdfs:label 'Submitter Id' ;
    rdfs:comment 'Unique identifier for the submitter of the claim batch.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Submitter .

ind:submitterNpi rdf:type rdf:Property ;
    rdfs:label 'Submitter Npi' ;
    rdfs:comment 'National Provider Identifier of the submitter, if the submitter is a healthcare provider.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterTin rdf:type rdf:Property ;
    rdfs:label 'Submitter Tin' ;
    rdfs:comment 'Tax Identification Number of the submitter for financial and tax reporting purposes.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiverName rdf:type rdf:Property ;
    rdfs:label 'Receiver Name' ;
    rdfs:comment 'Name of the payer or entity receiving the claim batch for processing.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiverId rdf:type rdf:Property ;
    rdfs:label 'Receiver Id' ;
    rdfs:comment 'Unique identifier for the receiver of the claim batch.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Receiver .

ind:processingStartDate rdf:type rdf:Property ;
    rdfs:label 'Processing Start Date' ;
    rdfs:comment 'Date when processing of the claim batch began.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:processingEndDate rdf:type rdf:Property ;
    rdfs:label 'Processing End Date' ;
    rdfs:comment 'Date when processing of the claim batch was completed.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Validation Timestamp' ;
    rdfs:comment 'Precise timestamp when the claim batch passed validation checks.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'Date when all claims in the batch were fully processed and adjudicated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:completionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completion Timestamp' ;
    rdfs:comment 'Precise timestamp when all claims in the batch were fully processed and adjudicated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:totalClaimCount rdf:type rdf:Property ;
    rdfs:label 'Total Claim Count' ;
    rdfs:comment 'Total number of claims included in the batch.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acceptedClaimCount rdf:type rdf:Property ;
    rdfs:label 'Accepted Claim Count' ;
    rdfs:comment 'Number of claims in the batch that were accepted for processing.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rejectedClaimCount rdf:type rdf:Property ;
    rdfs:label 'Rejected Claim Count' ;
    rdfs:comment 'Number of claims in the batch that were rejected during processing.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pendingClaimCount rdf:type rdf:Property ;
    rdfs:label 'Pending Claim Count' ;
    rdfs:comment 'Number of claims in the batch that are currently pending review or additional information.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suspendedClaimCount rdf:type rdf:Property ;
    rdfs:label 'Suspended Claim Count' ;
    rdfs:comment 'Number of claims in the batch that have been suspended for manual review or investigation.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalMemberResponsibilityAmount rdf:type rdf:Property ;
    rdfs:label 'Total Member Responsibility Amount' ;
    rdfs:comment 'Total amount for which members are responsible across all claims in the batch, including copays, coinsurance, and deductibles.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Total Adjustment Amount' ;
    rdfs:comment 'Total amount of adjustments applied across all claims in the batch, including denials, reductions, and contractual adjustments.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceDateFrom rdf:type rdf:Property ;
    rdfs:label 'Service Date From' ;
    rdfs:comment 'Earliest service date among all claims in the batch.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceDateTo rdf:type rdf:Property ;
    rdfs:label 'Service Date To' ;
    rdfs:comment 'Latest service date among all claims in the batch.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:controlNumber rdf:type rdf:Property ;
    rdfs:label 'Control Number' ;
    rdfs:comment 'Interchange control number or transaction control number from the EDI transmission, used for tracking and reconciliation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionSetIdentifier rdf:type rdf:Property ;
    rdfs:label 'Transaction Set Identifier' ;
    rdfs:comment 'ANSI X12 transaction set identifier indicating the type of claim transaction (837I for institutional, 837P for professional, 837D for dental).' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationErrorCount rdf:type rdf:Property ;
    rdfs:label 'Validation Error Count' ;
    rdfs:comment 'Number of validation errors encountered during batch processing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationWarningCount rdf:type rdf:Property ;
    rdfs:label 'Validation Warning Count' ;
    rdfs:comment 'Number of validation warnings encountered during batch processing that did not prevent acceptance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resubmissionIndicator rdf:type rdf:Property ;
    rdfs:label 'Resubmission Indicator' ;
    rdfs:comment 'Indicates whether this batch is a resubmission of a previously rejected or corrected batch.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalBatchId rdf:type rdf:Property ;
    rdfs:label 'Original Batch Id' ;
    rdfs:comment 'Identifier of the original batch if this is a resubmission or correction.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Batch .

ind:testIndicator rdf:type rdf:Property ;
    rdfs:label 'Test Indicator' ;
    rdfs:comment 'Indicates whether this batch is a test submission for validation purposes and should not be processed for payment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:duplicateCheckPerformed rdf:type rdf:Property ;
    rdfs:label 'Duplicate Check Performed' ;
    rdfs:comment 'Indicates whether duplicate claim checking was performed on the batch.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:duplicateClaimCount rdf:type rdf:Property ;
    rdfs:label 'Duplicate Claim Count' ;
    rdfs:comment 'Number of duplicate claims identified in the batch.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fraudScreeningPerformed rdf:type rdf:Property ;
    rdfs:label 'Fraud Screening Performed' ;
    rdfs:comment 'Indicates whether fraud, waste, and abuse screening was performed on the batch.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudAlertCount rdf:type rdf:Property ;
    rdfs:label 'Fraud Alert Count' ;
    rdfs:comment 'Number of fraud alerts triggered during batch processing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoAdjudicationRate rdf:type rdf:Property ;
    rdfs:label 'Auto Adjudication Rate' ;
    rdfs:comment 'Percentage of claims in the batch that were automatically adjudicated without manual intervention.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:manualReviewCount rdf:type rdf:Property ;
    rdfs:label 'Manual Review Count' ;
    rdfs:comment 'Number of claims in the batch that required manual review.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processingSystem rdf:type rdf:Property ;
    rdfs:label 'Processing System' ;
    rdfs:comment 'Name of the claims processing system that handled the batch (e.g., Facets, QNXT, HealthRules).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingEnvironment rdf:type rdf:Property ;
    rdfs:label 'Processing Environment' ;
    rdfs:comment 'System environment in which the batch was processed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaMetIndicator rdf:type rdf:Property ;
    rdfs:label 'Sla Met Indicator' ;
    rdfs:comment 'Indicates whether the batch processing met the defined service level agreement targets.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processingDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Processing Duration Minutes' ;
    rdfs:comment 'Total time in minutes taken to process the batch from start to completion.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acknowledgementSentIndicator rdf:type rdf:Property ;
    rdfs:label 'Acknowledgement Sent Indicator' ;
    rdfs:comment 'Indicates whether an acknowledgement (997 or 999 transaction) was sent to the submitter confirming receipt of the batch.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acknowledgementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledgement Timestamp' ;
    rdfs:comment 'Precise timestamp when the acknowledgement was sent to the submitter.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:remittanceAdviceGeneratedIndicator rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Generated Indicator' ;
    rdfs:comment 'Indicates whether an 835 remittance advice was generated for the batch.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remittanceAdviceDate rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Date' ;
    rdfs:comment 'Date when the remittance advice was generated for the batch.' ;
    rdfs:domain ind:Batch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'Date when payment was issued for the claims in the batch.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eftTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Eft Trace Number' ;
    rdfs:comment 'Trace number for electronic funds transfer if payment was issued electronically.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archivedIndicator rdf:type rdf:Property ;
    rdfs:label 'Archived Indicator' ;
    rdfs:comment 'Indicates whether the batch has been archived for long-term storage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fwaFlagId rdf:type rdf:Property ;
    rdfs:label 'Fwa Flag Id' ;
    rdfs:comment 'Unique identifier for the fraud, waste, and abuse flag record used to mark claims for special investigation review.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:flagCode rdf:type rdf:Property ;
    rdfs:label 'Flag Code' ;
    rdfs:comment 'Unique alphanumeric code identifying the specific type of fraud, waste, or abuse indicator applied to a claim for investigation purposes.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flagName rdf:type rdf:Property ;
    rdfs:label 'Flag Name' ;
    rdfs:comment 'Short descriptive name of the fraud, waste, or abuse flag for display and reporting purposes.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionRequired rdf:type rdf:Property ;
    rdfs:label 'Action Required' ;
    rdfs:comment 'The mandatory workflow action or investigation step that must be taken when a claim is marked with this FWA flag.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoDenyIndicator rdf:type rdf:Property ;
    rdfs:label 'Auto Deny Indicator' ;
    rdfs:comment 'Boolean flag indicating whether claims marked with this FWA flag should be automatically denied without manual review.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siuReferralRequired rdf:type rdf:Property ;
    rdfs:label 'Siu Referral Required' ;
    rdfs:comment 'Boolean indicator specifying whether claims with this flag must be escalated to the Special Investigations Unit for formal fraud investigation.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Threshold Amount' ;
    rdfs:comment 'Minimum dollar amount threshold that must be exceeded for this FWA flag to trigger investigation or escalation actions.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicableClaimTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Claim Types' ;
    rdfs:comment 'Comma-separated list of claim types (medical, pharmacy, dental, vision, institutional, professional) to which this FWA flag applies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableServiceCategories rdf:type rdf:Property ;
    rdfs:label 'Applicable Service Categories' ;
    rdfs:comment 'Comma-separated list of healthcare service categories (inpatient, outpatient, emergency, DME, home health, etc.) where this FWA flag is relevant.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerSpecialtyFilter rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Filter' ;
    rdfs:comment 'Comma-separated list of provider specialty codes or taxonomy classifications to which this FWA flag specifically applies, used to target detection rules.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureCodePattern rdf:type rdf:Property ;
    rdfs:label 'Procedure Code Pattern' ;
    rdfs:comment 'Regular expression or wildcard pattern defining Current Procedural Terminology (CPT), Healthcare Common Procedure Coding System (HCPCS), or other procedure codes that trigger this FWA flag.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCodePattern rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code Pattern' ;
    rdfs:comment 'Regular expression or wildcard pattern defining International Classification of Diseases 10th Revision (ICD-10) diagnosis codes that trigger this FWA flag when present on claims.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Statistical Threshold Value' ;
    rdfs:comment 'Numerical threshold value (e.g., standard deviations, percentile rank, frequency count) that must be exceeded for statistical outlier detection to trigger this FWA flag.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recurrenceThresholdCount rdf:type rdf:Property ;
    rdfs:label 'Recurrence Threshold Count' ;
    rdfs:comment 'Number of times a specific pattern or behavior must occur within the lookback period before this FWA flag is triggered.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByUser rdf:type rdf:Property ;
    rdfs:label 'Approved By User' ;
    rdfs:comment 'Username or identifier of the supervisor or compliance officer who approved this FWA flag for production use.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryCitation rdf:type rdf:Property ;
    rdfs:label 'Regulatory Citation' ;
    rdfs:comment 'Specific legal or regulatory reference (statute, regulation, or guidance document) that defines or mandates detection of this FWA pattern.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedAnnualSavings rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Savings' ;
    rdfs:comment 'Projected annual cost savings or loss prevention amount resulting from detection and prevention of this FWA pattern.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:historicalDetectionCount rdf:type rdf:Property ;
    rdfs:label 'Historical Detection Count' ;
    rdfs:comment 'Total number of claims that have been flagged with this FWA indicator since its inception, used for effectiveness tracking.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:falsePositiveRate rdf:type rdf:Property ;
    rdfs:label 'False Positive Rate' ;
    rdfs:comment 'Percentage (0-100) of flagged claims that were determined upon investigation to be legitimate, indicating the precision of this FWA detection rule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:truePositiveRate rdf:type rdf:Property ;
    rdfs:label 'True Positive Rate' ;
    rdfs:comment 'Percentage (0-100) of flagged claims that were confirmed as actual fraud, waste, or abuse upon investigation, indicating detection accuracy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Average Recovery Amount' ;
    rdfs:comment 'Mean dollar amount recovered or prevented per confirmed FWA case detected by this flag, used to measure financial impact.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelVersion rdf:type rdf:Property ;
    rdfs:label 'Model Version' ;
    rdfs:comment 'Version identifier of the predictive analytics model or rules engine configuration used to generate this FWA flag, supporting model governance and traceability.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationPath rdf:type rdf:Property ;
    rdfs:label 'Escalation Path' ;
    rdfs:comment 'Defined workflow or organizational hierarchy for escalating confirmed FWA cases detected by this flag, including Special Investigations Unit (SIU), legal, and regulatory reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationRequirements rdf:type rdf:Property ;
    rdfs:label 'Documentation Requirements' ;
    rdfs:comment 'Specific medical records, supporting documentation, or evidence that must be requested from providers when claims are flagged with this FWA indicator.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingRequired rdf:type rdf:Property ;
    rdfs:label 'Training Required' ;
    rdfs:comment 'Boolean flag indicating whether claims examiners and investigators require specialized training to properly investigate claims marked with this FWA flag.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalVendorFlag rdf:type rdf:Property ;
    rdfs:label 'External Vendor Flag' ;
    rdfs:comment 'Boolean indicator specifying whether this FWA flag was developed by an external payment integrity vendor (e.g., Cotiviti) versus internal program integrity team.' ;
    rdfs:domain ind:FwaFlag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:integrationSystem rdf:type rdf:Property ;
    rdfs:label 'Integration System' ;
    rdfs:comment 'Name of the claims administration or payment integrity system (e.g., Facets, QNXT, Cotiviti) where this FWA flag is implemented and applied during claims processing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Case Assignment Id' ;
    rdfs:comment 'Unique identifier for the care case assignment record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CaseAssignment .

ind:caseId rdf:type rdf:Property ;
    rdfs:label 'Case Id' ;
    rdfs:comment 'Identifier of the care case to which the team member is assigned.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Case .

ind:careTeamMemberId rdf:type rdf:Property ;
    rdfs:label 'Care Team Member Id' ;
    rdfs:comment 'Identifier of the care team member (e.g., nurse, social worker) assigned to the case.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TeamMember .

ind:role rdf:type rdf:Property ;
    rdfs:label 'Role' ;
    rdfs:comment 'Role of the assigned care team member within the case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibility rdf:type rdf:Property ;
    rdfs:label 'Responsibility' ;
    rdfs:comment 'Specific responsibility assigned to the care team member for this case.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Start Date' ;
    rdfs:comment 'Date when the care team member\'s assignment to the case begins.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Assignment End Date' ;
    rdfs:comment 'Date when the care team member\'s assignment to the case ends or is terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assignment Status' ;
    rdfs:comment 'Current status of the assignment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentType rdf:type rdf:Property ;
    rdfs:label 'Assignment Type' ;
    rdfs:comment 'Type of assignment indicating primary or supporting role.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentReason rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason' ;
    rdfs:comment 'Reason why the care team member was assigned to the case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careProgramId rdf:type rdf:Property ;
    rdfs:label 'Care Program Id' ;
    rdfs:comment 'Identifier of the broader care program (e.g., Diabetes Management) linked to the case.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Program .

ind:communicationMethod rdf:type rdf:Property ;
    rdfs:label 'Communication Method' ;
    rdfs:comment 'Preferred method for the care team member to communicate with the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPreference rdf:type rdf:Property ;
    rdfs:label 'Contact Preference' ;
    rdfs:comment 'Indicates who initiates contact for the assignment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledHoursPerWeek rdf:type rdf:Property ;
    rdfs:label 'Scheduled Hours Per Week' ;
    rdfs:comment 'Number of hours per week the care team member is scheduled to work on this case.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualHoursWorked rdf:type rdf:Property ;
    rdfs:label 'Actual Hours Worked' ;
    rdfs:comment 'Actual number of hours logged by the care team member for this case.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Timestamp' ;
    rdfs:comment 'Timestamp when the assignment becomes effective (may differ from start date for backdated assignments).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expirationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expiration Timestamp' ;
    rdfs:comment 'Timestamp when the assignment expires automatically if not manually ended.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isCriticalCare rdf:type rdf:Property ;
    rdfs:label 'Is Critical Care' ;
    rdfs:comment 'Flag indicating if the assignment is for a critical care case.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:teamMemberId rdf:type rdf:Property ;
    rdfs:label 'Team Member Id' ;
    rdfs:comment 'Identifier of the primary care coordinator overseeing the case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TeamMember .

ind:caseStatus rdf:type rdf:Property ;
    rdfs:label 'Case Status' ;
    rdfs:comment 'Current status of the care case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberAge rdf:type rdf:Property ;
    rdfs:label 'Member Age' ;
    rdfs:comment 'Age of the member at the time of assignment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberZipCode rdf:type rdf:Property ;
    rdfs:label 'Member Zip Code' ;
    rdfs:comment '5-digit ZIP code of the member\'s residence.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberState rdf:type rdf:Property ;
    rdfs:label 'Member State' ;
    rdfs:comment 'Two-letter state code of the member\'s residence.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberCountry rdf:type rdf:Property ;
    rdfs:label 'Member Country' ;
    rdfs:comment 'Three-letter ISO country code of the member\'s residence.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careTeamMemberRoleCode rdf:type rdf:Property ;
    rdfs:label 'Care Team Member Role Code' ;
    rdfs:comment 'Standardized code representing the role of the care team member.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Assignment Source System' ;
    rdfs:comment 'System of record where the assignment originated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isVirtualCare rdf:type rdf:Property ;
    rdfs:label 'Is Virtual Care' ;
    rdfs:comment 'Indicates if the care provided under this assignment is delivered virtually (telehealth).' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthPlatform rdf:type rdf:Property ;
    rdfs:label 'Telehealth Platform' ;
    rdfs:comment 'Platform used for virtual care interactions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationCompleteness rdf:type rdf:Property ;
    rdfs:label 'Documentation Completeness' ;
    rdfs:comment 'Status of required documentation for the assignment.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastContactDate rdf:type rdf:Property ;
    rdfs:label 'Last Contact Date' ;
    rdfs:comment 'Date of the most recent contact between the care team member and the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextScheduledContactDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Contact Date' ;
    rdfs:comment 'Planned date for the next member contact.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:careTeamMemberEmail rdf:type rdf:Property ;
    rdfs:label 'Care Team Member Email' ;
    rdfs:comment 'Email address of the care team member.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careTeamMemberPhone rdf:type rdf:Property ;
    rdfs:label 'Care Team Member Phone' ;
    rdfs:comment 'Contact phone number of the care team member.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberPrimaryCarePhysicianNpi rdf:type rdf:Property ;
    rdfs:label 'Member Primary Care Physician Npi' ;
    rdfs:comment 'National Provider Identifier of the member\'s primary care physician.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentNotesFlagged rdf:type rdf:Property ;
    rdfs:label 'Assignment Notes Flagged' ;
    rdfs:comment 'Indicates if the assignment notes contain any flagged content requiring review.' ;
    rdfs:domain ind:CaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentScheduleId rdf:type rdf:Property ;
    rdfs:label 'Payment Schedule Id' ;
    rdfs:comment 'Unique identifier for the claim payment schedule record. Primary key for tracking scheduled payment installments and their associated details.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Sequence Number' ;
    rdfs:comment 'Sequential number indicating the order of this payment installment within the overall payment schedule (e.g., 1 for first payment, 2 for second payment).' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Payment Date' ;
    rdfs:comment 'The date on which this payment installment is scheduled to be processed and disbursed to the provider or member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Scheduled Payment Amount' ;
    rdfs:comment 'The monetary amount scheduled to be paid in this installment. Represents a portion or full amount of the total claim payment obligation.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentMethodCode rdf:type rdf:Property ;
    rdfs:label 'Payment Method Code' ;
    rdfs:comment 'Code indicating the payment instrument or mechanism to be used for disbursement (e.g., ACH for Automated Clearing House, EFT for Electronic Funds Transfer, CHECK for paper check).' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Classification of the payment indicating whether it represents a full claim payment, partial payment, installment in a series, advance payment, or final settlement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeType rdf:type rdf:Property ;
    rdfs:label 'Payee Type' ;
    rdfs:comment 'Classification of the recipient entity type receiving this scheduled payment (e.g., healthcare provider, member for reimbursement, facility, third-party vendor).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeId rdf:type rdf:Property ;
    rdfs:label 'Payee Id' ;
    rdfs:comment 'Unique identifier of the entity receiving the payment. May represent provider NPI, member ID, facility ID, or vendor ID depending on payee type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payee .

ind:payeeTaxId rdf:type rdf:Property ;
    rdfs:label 'Payee Tax Id' ;
    rdfs:comment 'Federal Tax Identification Number of the payee entity. Required for IRS reporting and payment processing compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Payment Address Line 1' ;
    rdfs:comment 'First line of the mailing address where payment check or correspondence should be sent. Primary street address component.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Payment Address Line 2' ;
    rdfs:comment 'Second line of the payment mailing address for suite numbers, apartment numbers, or additional address details.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentCity rdf:type rdf:Property ;
    rdfs:label 'Payment City' ;
    rdfs:comment 'City name component of the payment mailing address.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentState rdf:type rdf:Property ;
    rdfs:label 'Payment State' ;
    rdfs:comment 'Two-letter state or province code for the payment mailing address. Uses standard USPS state abbreviations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentZipCode rdf:type rdf:Property ;
    rdfs:label 'Payment Zip Code' ;
    rdfs:comment 'Five or nine-digit postal code for the payment mailing address. Supports both standard and ZIP+4 formats.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentCountryCode rdf:type rdf:Property ;
    rdfs:label 'Payment Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the payment mailing address. Supports international payment processing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Account Number' ;
    rdfs:comment 'Bank account number for electronic payment disbursement via ACH or EFT. Encrypted and protected per PCI DSS standards.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'Nine-digit ABA routing transit number identifying the financial institution for electronic payment processing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountType rdf:type rdf:Property ;
    rdfs:label 'Bank Account Type' ;
    rdfs:comment 'Classification of the bank account type for electronic payment disbursement (checking, savings, business accounts).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Payment Currency Code' ;
    rdfs:comment 'Three-letter ISO currency code indicating the currency in which the payment will be disbursed (e.g., USD for US Dollars).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Original Scheduled Date' ;
    rdfs:comment 'The initial date on which this payment was originally scheduled before any modifications or rescheduling occurred. Maintains audit trail of schedule changes.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Actual Payment Date' ;
    rdfs:comment 'The actual date on which the payment was processed and disbursed. Populated after payment execution for reconciliation and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Payment Amount' ;
    rdfs:comment 'The actual monetary amount disbursed in this payment. May differ from scheduled amount due to adjustments, offsets, or recoupments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Adjustment Amount' ;
    rdfs:comment 'Total amount of adjustments applied to the scheduled payment amount. Represents the difference between scheduled and actual payment amounts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentAdjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Payment Adjustment Reason Code' ;
    rdfs:comment 'Standard code indicating the reason for payment adjustment (e.g., offset, recoupment, coordination of benefits, prior overpayment recovery).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAdjustmentReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Adjustment Reason Description' ;
    rdfs:comment 'Detailed text description explaining the reason for the payment adjustment. Provides context beyond the standard reason code.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentRunDate rdf:type rdf:Property ;
    rdfs:label 'Payment Run Date' ;
    rdfs:comment 'The date on which the payment processing batch was executed. Represents the business date of the payment cycle.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:holdIndicator rdf:type rdf:Property ;
    rdfs:label 'Hold Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this scheduled payment is currently on hold and should not be processed. Used for payment suspension pending investigation or resolution.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holdReasonCode rdf:type rdf:Property ;
    rdfs:label 'Hold Reason Code' ;
    rdfs:comment 'Code indicating the reason why the payment is on hold (e.g., fraud investigation, member request, provider dispute, coordination of benefits pending).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Hold Reason Description' ;
    rdfs:comment 'Detailed text description explaining why the payment is on hold. Provides additional context for hold resolution.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdPlacedDate rdf:type rdf:Property ;
    rdfs:label 'Hold Placed Date' ;
    rdfs:comment 'The date on which the payment hold was placed. Used for tracking hold duration and aging analysis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:holdReleasedDate rdf:type rdf:Property ;
    rdfs:label 'Hold Released Date' ;
    rdfs:comment 'The date on which the payment hold was released and the payment was cleared for processing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interestStartDate rdf:type rdf:Property ;
    rdfs:label 'Interest Start Date' ;
    rdfs:comment 'The date from which interest calculation begins for delayed payment. Typically based on regulatory prompt payment timeframes.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interestEndDate rdf:type rdf:Property ;
    rdfs:label 'Interest End Date' ;
    rdfs:comment 'The date through which interest is calculated for delayed payment. Typically the actual payment date.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:offsetAmount rdf:type rdf:Property ;
    rdfs:label 'Offset Amount' ;
    rdfs:comment 'Amount deducted from the scheduled payment to recover prior overpayments or other obligations owed by the payee.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offsetReasonCode rdf:type rdf:Property ;
    rdfs:label 'Offset Reason Code' ;
    rdfs:comment 'Standard code indicating the reason for payment offset (e.g., prior overpayment recovery, recoupment, third-party liability).' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offsetClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Offset Claim Number' ;
    rdfs:comment 'Claim number of the original claim from which overpayment is being recovered through this offset. Provides audit trail for recoupment.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobPayerName rdf:type rdf:Property ;
    rdfs:label 'Cob Payer Name' ;
    rdfs:comment 'Name of the other insurance carrier responsible for primary or secondary payment under coordination of benefits rules. Impacts payment scheduling and amounts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobAmountPaidByOther rdf:type rdf:Property ;
    rdfs:label 'Cob Amount Paid By Other' ;
    rdfs:comment 'Amount paid by another insurance carrier under coordination of benefits. Used to calculate this payers payment obligation.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Subrogation Case Number' ;
    rdfs:comment 'Unique identifier for the subrogation case associated with this payment. Links payment to third-party liability recovery efforts.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPriority rdf:type rdf:Property ;
    rdfs:label 'Payment Priority' ;
    rdfs:comment 'Priority level assigned to this scheduled payment for processing queue management (e.g., urgent for prompt payment compliance, normal for standard processing).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNotificationEmail rdf:type rdf:Property ;
    rdfs:label 'Payment Notification Email' ;
    rdfs:comment 'Email address to which payment notification and remittance advice should be sent. Used for electronic payment communication.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNotificationPhone rdf:type rdf:Property ;
    rdfs:label 'Payment Notification Phone' ;
    rdfs:comment 'Phone number for payment notification and inquiry. Used for payee contact regarding payment status and issues.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberName rdf:type rdf:Property ;
    rdfs:label 'Member Name' ;
    rdfs:comment 'Full name of the health plan member associated with the claim. Used for payment reconciliation and member communication.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceStartDate rdf:type rdf:Property ;
    rdfs:label 'Service Start Date' ;
    rdfs:comment 'The beginning date of the service period for which the claim payment is being made. Used for payment period tracking and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceEndDate rdf:type rdf:Property ;
    rdfs:label 'Service End Date' ;
    rdfs:comment 'The ending date of the service period for which the claim payment is being made. Used for payment period tracking and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalClaimAmount rdf:type rdf:Property ;
    rdfs:label 'Total Claim Amount' ;
    rdfs:comment 'Total approved payment amount for the entire claim. The sum of all scheduled payment installments should equal this amount.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingBalance rdf:type rdf:Property ;
    rdfs:label 'Remaining Balance' ;
    rdfs:comment 'Outstanding balance remaining to be paid on the claim after this scheduled payment. Used for tracking payment completion status.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Terms' ;
    rdfs:comment 'Description of the payment terms and schedule agreed upon for this claim (e.g., Net 30, installment plan details, payment frequency).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installmentPlanId rdf:type rdf:Property ;
    rdfs:label 'Installment Plan Id' ;
    rdfs:comment 'Unique identifier for the installment payment plan under which this scheduled payment is structured. Links multiple payment schedules to a common plan.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:totalInstallments rdf:type rdf:Property ;
    rdfs:label 'Total Installments' ;
    rdfs:comment 'Total number of payment installments planned for this claim. Used to track payment schedule completion.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cancellationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Code' ;
    rdfs:comment 'Code indicating the reason why the scheduled payment was cancelled (e.g., claim denied on appeal, duplicate payment, member request).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Description' ;
    rdfs:comment 'Detailed text description explaining why the scheduled payment was cancelled. Provides additional context for audit and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Code' ;
    rdfs:comment 'Code indicating the reason why the payment was reversed (e.g., overpayment identified, duplicate payment, fraud detection).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalAmount rdf:type rdf:Property ;
    rdfs:label 'Reversal Amount' ;
    rdfs:comment 'The monetary amount reversed from the original payment. May be partial or full reversal of the payment.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentProcessorId rdf:type rdf:Property ;
    rdfs:label 'Payment Processor Id' ;
    rdfs:comment 'Unique identifier assigned by the payment processor for tracking and reconciliation of this payment transaction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentProcessor .

ind:paymentConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Confirmation Number' ;
    rdfs:comment 'Confirmation number provided by the payment processor upon successful payment processing. Used for payment verification and inquiry.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNotes rdf:type rdf:Property ;
