laboratory,specialized_diagnostics,susceptibility_result,clsi_breakpoint_version,clsi_breakpoint_version,Clinical and Laboratory Standards Institute (CLSI) Breakpoint Version,STRING,,,,,transactional_data,"Version of the CLSI M100 Performance Standards document used to interpret the susceptibility result. Breakpoints are updated annually and version is critical for accurate interpretation (e.g., M100-Ed31, M100-Ed32).",
laboratory,specialized_diagnostics,susceptibility_result,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when this susceptibility result record was first created in the data platform. Audit trail for data lineage and compliance.,
laboratory,specialized_diagnostics,susceptibility_result,disk_diffusion_zone_diameter_mm,disk_diffusion_zone_diameter_mm,Disk Diffusion Zone Diameter (Millimeters),"DECIMAL(5,2)",,,,,transactional_data,Zone of inhibition diameter measured in millimeters for disk diffusion (Kirby-Bauer) susceptibility testing method. Larger zones indicate greater susceptibility.,
laboratory,specialized_diagnostics,susceptibility_result,inducible_resistance_flag,inducible_resistance_flag,Inducible Resistance Flag,BOOLEAN,,,,,transactional_data,"Indicates whether inducible resistance was detected (e.g., inducible clindamycin resistance in Staphylococcus, inducible AmpC in Enterobacteriaceae). True indicates inducible resistance detected; False indicates not detected.",
laboratory,specialized_diagnostics,susceptibility_result,infection_control_alert_flag,infection_control_alert_flag,Infection Control Alert Flag,BOOLEAN,,,,,transactional_data,"Indicates whether this result triggered an infection control alert due to detection of multidrug-resistant organism (MDRO), reportable organism, or outbreak-associated pathogen. True indicates alert generated.",
laboratory,specialized_diagnostics,susceptibility_result,loinc_code,loinc_code,Logical Observation Identifiers Names and Codes (LOINC) Code,STRING,,,,,transactional_data,LOINC code identifying the specific susceptibility test performed. Enables standardized reporting and interoperability across systems.,
laboratory,specialized_diagnostics,susceptibility_result,mic_operator,mic_operator,Minimum Inhibitory Concentration (MIC) Operator,STRING,,,,=|<=|>=|<|>,transactional_data,"Comparison operator for the MIC value when the exact value is at or beyond the test range limits (e.g., <=0.5 indicates at or below the lowest tested concentration).",
laboratory,specialized_diagnostics,susceptibility_result,mic_unit,mic_unit,Minimum Inhibitory Concentration (MIC) Unit of Measure,STRING,,,,mcg/mL|mg/L|IU/mL,transactional_data,"Unit of measure for the MIC value, typically micrograms per milliliter (mcg/mL) or milligrams per liter (mg/L).",
laboratory,specialized_diagnostics,susceptibility_result,mic_value,mic_value,Minimum Inhibitory Concentration (MIC) Value,"DECIMAL(10,4)",,,,,transactional_data,Minimum inhibitory concentration value representing the lowest concentration of antimicrobial agent that inhibits visible growth of the organism. Expressed as a numeric value with unit of measure.,
laboratory,specialized_diagnostics,susceptibility_result,panel_code,panel_code,Antimicrobial Panel Code,STRING,,,,,transactional_data,"Code identifying the standardized panel or battery of antimicrobial agents tested together (e.g., Gram Positive Panel, Gram Negative Panel, Anaerobe Panel). Panels are organism-specific.",
laboratory,specialized_diagnostics,susceptibility_result,panel_name,panel_name,Antimicrobial Panel Name,STRING,,,,,transactional_data,"Human-readable name of the antimicrobial susceptibility panel tested (e.g., Gram Positive Cocci Panel, Enterobacteriaceae Panel, Pseudomonas Panel).",
laboratory,specialized_diagnostics,susceptibility_result,performing_lab_code,performing_lab_code,Performing Laboratory Code,STRING,,,,,transactional_data,Code identifying the laboratory facility or department that performed the susceptibility testing. May be internal facility code or CLIA number.,
laboratory,specialized_diagnostics,susceptibility_result,performing_lab_name,performing_lab_name,Performing Laboratory Name,STRING,,,,,transactional_data,"Name of the laboratory facility or department that performed the susceptibility testing (e.g., Main Hospital Microbiology Lab, Reference Laboratory).",
laboratory,specialized_diagnostics,susceptibility_result,quality_control_status,quality_control_status,Quality Control (QC) Status,STRING,,,,passed|failed|not applicable,transactional_data,Status of quality control testing performed concurrently with patient susceptibility testing. Passed indicates QC organisms yielded expected results; Failed indicates out-of-range QC results requiring investigation.,
laboratory,specialized_diagnostics,susceptibility_result,reportable_to_public_health_flag,reportable_to_public_health_flag,Reportable to Public Health Flag,BOOLEAN,,,"dbx_restricted, dbx_pii",,transactional_data,"Indicates whether this susceptibility result is reportable to public health authorities (e.g., state health department, CDC) due to detection of notifiable disease or antimicrobial resistance pattern. True indicates reportable.",
laboratory,specialized_diagnostics,susceptibility_result,resistance_gene,resistance_gene,Resistance Gene,STRING,,,,,transactional_data,"Specific resistance gene detected through molecular testing (e.g., mecA, vanA, blaNDM, blaKPC). Used for epidemiological tracking and infection control.",
laboratory,specialized_diagnostics,susceptibility_result,resistance_mechanism,resistance_mechanism,Resistance Mechanism,STRING,,,,,transactional_data,"Known or suspected mechanism of antimicrobial resistance detected (e.g., ESBL, Carbapenemase, MRSA, VRE, AmpC). Critical for infection control and antibiotic stewardship.",
laboratory,specialized_diagnostics,susceptibility_result,resistant_breakpoint,resistant_breakpoint,Resistant Breakpoint Threshold,"DECIMAL(10,4)",,,,,transactional_data,MIC breakpoint value at or above which the organism is classified as resistant according to CLSI guidelines. Used for automated interpretation.,
laboratory,specialized_diagnostics,susceptibility_result,result_comment,result_comment,Result Comment,STRING,,,,,transactional_data,"Free-text comment or interpretive note from the laboratory regarding the susceptibility result. May include recommendations for therapy, warnings about resistance patterns, or technical notes.",
laboratory,specialized_diagnostics,susceptibility_result,result_status,result_status,Result Status,STRING,,,,preliminary|final|corrected|cancelled|entered in error,transactional_data,Current status of the susceptibility result in its lifecycle. Preliminary results may be released before final verification; Final results have been verified and released; Corrected indicates an amendment to a previously final result.,
laboratory,specialized_diagnostics,susceptibility_result,result_timestamp,result_timestamp,Result Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when the susceptibility test result was generated or finalized by the laboratory information system. Represents the business event time of result availability.,
laboratory,specialized_diagnostics,susceptibility_result,snomed_code,snomed_code,Systematized Nomenclature of Medicine Clinical Terms (SNOMED CT) Code,STRING,,,,,transactional_data,SNOMED CT code for the susceptibility test result or interpretation. Supports clinical documentation and semantic interoperability.,
laboratory,specialized_diagnostics,susceptibility_result,source_system_code,source_system_code,Source System Code,STRING,,,,,transactional_data,"Code identifying the source laboratory information system (LIS) that generated this susceptibility result (e.g., Epic Beaker, Cerner PathNet, Sunquest). Used for data lineage and integration troubleshooting.",
laboratory,specialized_diagnostics,susceptibility_result,susceptibility_interpretation,susceptibility_interpretation,Susceptibility Interpretation,STRING,,,,susceptible|intermediate|resistant|susceptible-dose dependent|not tested|indeterminate,transactional_data,Clinical interpretation of the susceptibility test result based on CLSI breakpoints. Susceptible indicates the organism is inhibited by achievable drug concentrations; Intermediate indicates uncertain efficacy; Resistant indicates the organism is not inhibited by normally achievable concentrations; Susceptible-dose dependent indicates efficacy depends on dosing regimen.,
laboratory,specialized_diagnostics,susceptibility_result,susceptible_breakpoint,susceptible_breakpoint,Susceptible Breakpoint Threshold,"DECIMAL(10,4)",,,,,transactional_data,MIC breakpoint value at or below which the organism is classified as susceptible according to CLSI guidelines. Used for automated interpretation.,
laboratory,specialized_diagnostics,susceptibility_result,synergy_test_result,synergy_test_result,Synergy Test Result,STRING,,,,positive|negative|not performed,transactional_data,"Result of synergy testing for combination antimicrobial therapy (e.g., beta-lactam/beta-lactamase inhibitor combinations). Positive indicates synergistic effect detected.",
laboratory,specialized_diagnostics,susceptibility_result,testing_method,testing_method,Antimicrobial Susceptibility Testing (AST) Method,STRING,,,,broth microdilution|disk diffusion|E-test|automated system|agar dilution|gradient diffusion,transactional_data,"Laboratory method used to perform the susceptibility test. Common methods include broth microdilution (gold standard for MIC), disk diffusion (Kirby-Bauer), E-test (gradient diffusion), and automated systems (e.g., VITEK, Phoenix).",
laboratory,specialized_diagnostics,susceptibility_result,updated_timestamp,updated_timestamp,Record Updated Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when this susceptibility result record was last modified in the data platform. Audit trail for data lineage and compliance.,
laboratory,specialized_diagnostics,susceptibility_result,verified_timestamp,verified_timestamp,Verified Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when the susceptibility result was verified and approved for clinical use by authorized laboratory personnel (medical technologist or pathologist).,
laboratory,transfusion_services,blood_bank_unit,blood_bank_unit_id,blood_bank_unit_id,Blood Bank Unit Identifier (ID),BIGINT,Y,,,,master_data,Unique identifier for the blood product unit. Primary key for the blood bank unit record.,
laboratory,transfusion_services,blood_bank_unit,consent_record_id,consent_record_id,Consent Record Id (Foreign Key),BIGINT,,consent.consent_consent_record.consent_record_id,,,master_data,"Foreign key linking to consent.consent_record. Business justification: Blood product administration requires documented consent. Directed donations (family member to patient), autologous transfusions (patients own blood), and Jehovahs Witness refusals all require conse",
laboratory,transfusion_services,blood_bank_unit,cost_center_id,cost_center_id,Cost Center Id (Foreign Key),BIGINT,,finance.cost_center.cost_center_id,,,master_data,"Foreign key linking to finance.cost_center. Business justification: Blood bank inventory and transfusion services must be costed to the blood bank cost center for product cost tracking, wastage analysis, and departmental budget management. Required for transfusion ser",
laboratory,transfusion_services,blood_bank_unit,crossmatch_specimen_id,crossmatch_specimen_id,Crossmatch Specimen Id (Foreign Key),BIGINT,,laboratory.specimen.specimen_id,,,master_data,Foreign key linking to laboratory.specimen. Business justification: Blood bank units are crossmatched against patient specimens. Currently no FK exists. Business reality: crossmatch requires patient specimen (type and screen). Adding crossmatch_specimen_id FK (nullabl,
laboratory,transfusion_services,blood_bank_unit,hcpcs_code_id,hcpcs_code_id,Hcpcs Code Id (Foreign Key),BIGINT,,reference.hcpcs_code.hcpcs_code_id,,,master_data,"Foreign key linking to reference.hcpcs_code. Business justification: Blood product units require HCPCS linkage for billing, inventory valuation, and utilization reporting. The hcpcs_code text field is denormalized; proper FK enables automated charge capture, payer cont",
laboratory,transfusion_services,blood_bank_unit,material_master_id,material_master_id,Material Master Id (Foreign Key),BIGINT,,supply.material_master.material_master_id,,,master_data,"Foreign key linking to supply.material_master. Business justification: Blood products and transfusion supplies (filters, tubing, warmers, collection sets) are inventory items in the material master. This link enables blood bank inventory management, charge capture, and r",
laboratory,transfusion_services,blood_bank_unit,reagent_lot_id,reagent_lot_id,Reagent Lot Id (Foreign Key),BIGINT,,laboratory.reagent_lot.reagent_lot_id,,,master_data,"Foreign key linking to laboratory.reagent_lot. Business justification: Blood bank operations use reagent lots for typing and crossmatch testing. Currently blood_bank_unit has lot_number (string) but this likely refers to the blood product lot, not reagent lot. Adding rea",
laboratory,transfusion_services,blood_bank_unit,storage_room_id,storage_room_id,Storage Room Id (Foreign Key),BIGINT,,facility.room.room_id,,,master_data,"Foreign key linking to facility.room. Business justification: Blood bank units are stored in specific temperature-controlled rooms (blood bank refrigerators). AABB standards and FDA regulations require precise physical location tracking for inventory management,",
laboratory,transfusion_services,blood_bank_unit,abo_blood_group,abo_blood_group,ABO Blood Group,STRING,,,,A|B|AB|O,master_data,ABO blood type of the unit. Critical for compatibility matching with recipient to prevent hemolytic transfusion reactions.,
laboratory,transfusion_services,blood_bank_unit,bacterial_contamination_testing_status,bacterial_contamination_testing_status,Bacterial Contamination Testing Status,STRING,,,,tested_negative|tested_positive|pending|not_applicable,master_data,"Status of bacterial detection testing, primarily for platelet units which are stored at room temperature. Positive results require unit quarantine and discard.",
laboratory,transfusion_services,blood_bank_unit,charge_amount,charge_amount,Blood Unit Charge Amount,"DECIMAL(10,2)",,,dbx_confidential,,master_data,Amount charged to the patient or payer for this blood unit. Used for revenue cycle management and billing.,
laboratory,transfusion_services,blood_bank_unit,cmv_status,cmv_status,Cytomegalovirus (CMV) Status,STRING,,,,cmv_negative|cmv_positive|cmv_safe,master_data,"CMV serology status of the donor. CMV-negative or CMV-safe (leukoreduced) units are required for immunocompromised patients, neonates, and pregnant women.",
laboratory,transfusion_services,blood_bank_unit,collection_facility_code,collection_facility_code,Blood Collection Facility Code,STRING,,,,,master_data,Identifier of the blood center or facility where the donation was collected. Required for traceability and recall management.,
laboratory,transfusion_services,blood_bank_unit,cost_amount,cost_amount,Blood Unit Cost Amount,"DECIMAL(10,2)",,,dbx_confidential,,master_data,"Acquisition or production cost of the blood unit. Used for inventory valuation, cost accounting, and financial reporting.",
laboratory,transfusion_services,blood_bank_unit,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,master_data,Date and time when this blood bank unit record was first created in the system. Used for audit trail and data lineage.,
laboratory,transfusion_services,blood_bank_unit,crossmatch_required_flag,crossmatch_required_flag,Crossmatch Required Flag,BOOLEAN,,,,,master_data,Indicates whether a serologic crossmatch is required before issuing this unit. May be waived for type O emergency release or for patients with negative antibody screens.,
laboratory,transfusion_services,blood_bank_unit,discard_reason,discard_reason,Discard Reason,STRING,,,,,master_data,"Reason why the unit was discarded. Used for quality improvement, waste reduction initiatives, and regulatory reporting. [ENUM-REF-CANDIDATE: expired|temperature_excursion|positive_test_result|damaged|contaminated|outdated|quality_control_failure|other — 8 candidates stripped; promote to reference product]",
laboratory,transfusion_services,blood_bank_unit,discard_timestamp,discard_timestamp,Discard Timestamp,TIMESTAMP,,,,,master_data,Date and time when the unit was discarded. Triggers waste tracking and quality review processes.,
laboratory,transfusion_services,blood_bank_unit,donation_date,donation_date,Blood Donation Date,DATE,,,,,master_data,Date when the blood was collected from the donor. Used to calculate product age and expiration date.,
laboratory,transfusion_services,blood_bank_unit,donation_identification_number,donation_identification_number,Donation Identification Number (DIN),STRING,,,,,master_data,Unique identifier assigned to the original blood donation from which this unit was derived. Links unit to donor record for traceability and recall purposes.,
laboratory,transfusion_services,blood_bank_unit,expiration_date,expiration_date,Blood Unit Expiration Date,DATE,,,,,master_data,"Date after which the blood product is no longer suitable for transfusion. Varies by product type and storage conditions (e.g., 42 days for packed red cells, 5 days for platelets).",
laboratory,transfusion_services,blood_bank_unit,extended_phenotype,extended_phenotype,Extended Red Cell Phenotype,STRING,,,,,master_data,"Additional red blood cell antigen profile beyond ABO/Rh (e.g., Kell, Duffy, Kidd, MNS). Used for patients with alloantibodies or those requiring antigen-matched units.",
laboratory,transfusion_services,blood_bank_unit,hemoglobin_s_status,hemoglobin_s_status,Hemoglobin S (Sickle Cell) Status,STRING,,,,negative|trait|positive|unknown,master_data,Indicates presence of sickle hemoglobin in the donor unit. Some institutions avoid sickle trait units for neonatal or exchange transfusions.,
laboratory,transfusion_services,blood_bank_unit,infectious_disease_testing_status,infectious_disease_testing_status,Infectious Disease Testing Status,STRING,,,,tested_negative|tested_positive|pending|not_tested,master_data,"Overall status of mandatory infectious disease testing (HIV, HBV, HCV, syphilis, HTLV, West Nile Virus, Zika, Chagas). Only units testing negative are released for transfusion.",
laboratory,transfusion_services,blood_bank_unit,irradiation_date,irradiation_date,Irradiation Date,DATE,,,,,master_data,"Date when the blood unit was irradiated. Irradiated units have reduced shelf life (typically 28 days from irradiation or original expiration, whichever is sooner).",
laboratory,transfusion_services,blood_bank_unit,irradiation_status,irradiation_status,Irradiation Status,STRING,,,,irradiated|non_irradiated,master_data,Indicates whether the unit has been gamma-irradiated to prevent transfusion-associated graft-versus-host disease (TA-GVHD) in immunocompromised patients.,
laboratory,transfusion_services,blood_bank_unit,issue_timestamp,issue_timestamp,Issue Timestamp,TIMESTAMP,,,,,master_data,Date and time when the unit was issued from the blood bank to the clinical area for transfusion. Starts the clock for return or transfusion completion.,
laboratory,transfusion_services,blood_bank_unit,issued_to_location,issued_to_location,Issued to Clinical Location,STRING,,,,,master_data,"Clinical unit or department to which the blood unit was issued (e.g., OR 3, ICU 2, ED). Used for tracking and accountability.",
laboratory,transfusion_services,blood_bank_unit,last_updated_timestamp,last_updated_timestamp,Record Last Updated Timestamp,TIMESTAMP,,,,,master_data,Date and time when this blood bank unit record was last modified. Supports change tracking and audit compliance.,
laboratory,transfusion_services,blood_bank_unit,leukoreduction_status,leukoreduction_status,Leukoreduction Status,STRING,,,,leukoreduced|non_leukoreduced,master_data,"Indicates whether white blood cells have been removed from the unit. Leukoreduction reduces febrile reactions, CMV transmission risk, and HLA alloimmunization.",
laboratory,transfusion_services,blood_bank_unit,lot_number,lot_number,Manufacturing Lot Number,STRING,,,,,master_data,"Lot number for pooled products (e.g., pooled platelets, pooled cryoprecipitate) or for products manufactured from multiple donations. Required for recall management.",
laboratory,transfusion_services,blood_bank_unit,product_code,product_code,Blood Product Code,STRING,,,,"^[A-Z0-9]{4,10}$",master_data,"Standardized code identifying the specific blood product type. Used for inventory management, ordering, and billing.",
laboratory,transfusion_services,blood_bank_unit,product_type,product_type,Blood Product Type,STRING,,,,packed_red_blood_cells|platelets|fresh_frozen_plasma|cryoprecipitate|whole_blood|granulocytes,master_data,"Classification of the blood component or product. Determines storage requirements, shelf life, and clinical indications for transfusion.",
laboratory,transfusion_services,blood_bank_unit,quarantine_reason,quarantine_reason,Quarantine Reason,STRING,,,,,master_data,"Reason why the unit has been placed in quarantine status (e.g., pending investigation, donor callback, positive test result, temperature deviation). Prevents inadvertent release.",
laboratory,transfusion_services,blood_bank_unit,quarantine_timestamp,quarantine_timestamp,Quarantine Timestamp,TIMESTAMP,,,,,master_data,Date and time when the unit was placed into quarantine status. Initiates investigation and documentation requirements.,
laboratory,transfusion_services,blood_bank_unit,reservation_timestamp,reservation_timestamp,Reservation Timestamp,TIMESTAMP,,,,,master_data,Date and time when the unit was reserved for a specific patient. Used to manage hold times and release units if not transfused within policy timeframe.,
laboratory,transfusion_services,blood_bank_unit,reserved_for_patient_mrn,reserved_for_patient_mrn,Reserved for Patient Medical Record Number (MRN),STRING,,,"dbx_restricted, dbx_pii_identifier",,master_data,Medical Record Number of the patient for whom this unit has been reserved or crossmatched. Ensures unit is held for the intended recipient.,
laboratory,transfusion_services,blood_bank_unit,return_timestamp,return_timestamp,Return Timestamp,TIMESTAMP,,,,,master_data,Date and time when an issued unit was returned to the blood bank unused. Units returned within acceptable time and temperature may be re-entered into inventory.,
laboratory,transfusion_services,blood_bank_unit,rh_type,rh_type,Rh Factor Type,STRING,,,,positive|negative,master_data,"Rh (D antigen) status of the blood unit. Essential for preventing Rh alloimmunization, especially in Rh-negative recipients.",
laboratory,transfusion_services,blood_bank_unit,source_system,source_system,Source System Identifier,STRING,,,,,master_data,"Identifier of the Laboratory Information System (LIS) or blood bank system from which this record originated (e.g., Epic Beaker, Cerner PathNet). Supports data integration and troubleshooting.",
laboratory,transfusion_services,blood_bank_unit,special_processing_codes,special_processing_codes,Special Processing Codes,STRING,,,,,master_data,"Comma-separated list of special processing or modifications applied to the unit (e.g., washed, volume-reduced, split, pooled). Affects clinical use and billing.",
laboratory,transfusion_services,blood_bank_unit,storage_temperature_c,storage_temperature_c,Storage Temperature (Celsius),"DECIMAL(4,1)",,,,,master_data,"Current storage temperature in Celsius. Must be maintained within product-specific ranges (e.g., 1-6°C for red cells, 20-24°C for platelets, ≤-18°C for FFP).",
laboratory,transfusion_services,blood_bank_unit,supplier_facility_code,supplier_facility_code,Supplier Facility Code,STRING,,,,,master_data,Identifier of the external blood supplier or blood center if the unit was not collected in-house. Used for vendor management and recall coordination.,
laboratory,transfusion_services,blood_bank_unit,temperature_alarm_flag,temperature_alarm_flag,Temperature Alarm Flag,BOOLEAN,,,,,master_data,Indicates whether a temperature excursion alarm has been triggered for this unit. Temperature deviations may render the unit unsuitable for transfusion.,
laboratory,transfusion_services,blood_bank_unit,transfusion_timestamp,transfusion_timestamp,Transfusion Timestamp,TIMESTAMP,,,,,master_data,Date and time when the transfusion was started. Critical for hemovigilance reporting and adverse event investigation.,
laboratory,transfusion_services,blood_bank_unit,unit_number,unit_number,Blood Unit Number (ISBT 128),STRING,,,,"^[A-Z0-9]{13,14}$",master_data,Globally unique blood unit identifier encoded using ISBT 128 standard barcode format. Enables worldwide traceability of blood products from donor to recipient.,
laboratory,transfusion_services,blood_bank_unit,unit_status,unit_status,Blood Unit Status,STRING,,,,,master_data,"Current lifecycle status of the blood unit. Tracks the unit from availability through final disposition (transfused, discarded, or returned). [ENUM-REF-CANDIDATE: available|reserved|crossmatched|issued|transfused|returned|discarded|quarantined|expired — 9 candidates stripped; promote to reference product]",
laboratory,transfusion_services,blood_bank_unit,volume_ml,volume_ml,Blood Unit Volume (Milliliters),"DECIMAL(6,2)",,,,,master_data,Volume of the blood product in milliliters. Used for dosing calculations and inventory management.,
laboratory,transfusion_services,transfusion_event,transfusion_event_id,transfusion_event_id,Transfusion Event Identifier (ID),BIGINT,Y,,,,transactional_data,Unique identifier for the transfusion event record. Primary key.,
laboratory,transfusion_services,transfusion_event,blood_bank_unit_id,blood_bank_unit_id,Blood Bank Unit Identifier (ID),BIGINT,,laboratory.blood_bank_unit.blood_bank_unit_id,,,transactional_data,Unique identifier for the specific blood product unit transfused. Links to blood bank inventory.,
laboratory,transfusion_services,transfusion_event,care_site_id,care_site_id,Performing Facility Identifier (ID),BIGINT,,facility.care_site.care_site_id,,,transactional_data,Unique identifier for the healthcare facility where the transfusion was performed.,
laboratory,transfusion_services,transfusion_event,charge_id,charge_id,Charge Id (Foreign Key),BIGINT,,billing.charge.charge_id,,,transactional_data,"Foreign key linking to billing.charge. Business justification: Transfusion events generate billable charges for blood products and administration services. Direct link supports charge capture at point of transfusion, enables blood bank revenue tracking, facilitat",
laboratory,transfusion_services,transfusion_event,clinical_order_id,clinical_order_id,Transfusion Order Identifier (ID),BIGINT,,order.clinical_order.clinical_order_id,,,transactional_data,Unique identifier for the clinical order authorizing the transfusion.,
laboratory,transfusion_services,transfusion_event,cost_center_id,cost_center_id,Cost Center Id (Foreign Key),BIGINT,,finance.cost_center.cost_center_id,,,transactional_data,"Foreign key linking to finance.cost_center. Business justification: Transfusion services must be charged to the performing cost center for transfusion service cost tracking, nursing time allocation, and departmental budgeting. Essential for blood utilization program c",
laboratory,transfusion_services,transfusion_event,demographics_id,demographics_id,Patient Identifier (ID),BIGINT,,patient.demographics.demographics_id,,,transactional_data,Unique identifier for the patient receiving the transfusion. Links to the patient master record.,
laboratory,transfusion_services,transfusion_event,employee_id,employee_id,Crossmatch Technologist Identifier (ID),BIGINT,,workforce.employee.employee_id,"dbx_confidential, dbx_pii",,transactional_data,Unique identifier for the medical laboratory technologist who performed the crossmatch testing.,
laboratory,transfusion_services,transfusion_event,hcpcs_code_id,hcpcs_code_id,Hcpcs Code Id (Foreign Key),BIGINT,,reference.hcpcs_code.hcpcs_code_id,,,transactional_data,"Foreign key linking to reference.hcpcs_code. Business justification: Transfusion events require HCPCS linkage for billing, hemovigilance reporting, and utilization management. Enables automated charge capture for blood administration, supports transfusion reaction cost",
laboratory,transfusion_services,transfusion_event,message_log_id,message_log_id,Message Log Id (Foreign Key),BIGINT,,interoperability.message_log.message_log_id,,,transactional_data,Foreign key linking to interoperability.message_log. Business justification: Transfusion events trigger blood administration notifications to blood bank systems and hemovigilance reporting to FDA/AABB. Links transfusion to transmission event for adverse reaction reporting audi,
laboratory,transfusion_services,transfusion_event,patient_safety_event_id,patient_safety_event_id,Patient Safety Event Id (Foreign Key),BIGINT,,quality.patient_safety_event.patient_safety_event_id,,,transactional_data,"Foreign key linking to quality.patient_safety_event. Business justification: Transfusion reactions (hemolytic, allergic, TRALI) are reportable patient safety events. Blood bank and quality departments link transfusion events to safety event tracking for hemovigilance programs ",
laboratory,transfusion_services,transfusion_event,payer_id,payer_id,Payer Id (Foreign Key),BIGINT,,insurance.payer.payer_id,,,transactional_data,"Foreign key linking to insurance.payer. Business justification: Blood product transfusions are high-cost events requiring prior authorization and coverage verification. Utilization review programs monitor transfusion appropriateness, and billing requires payer ide",
laboratory,transfusion_services,transfusion_event,specimen_id,specimen_id,Patient Blood Sample Identifier (ID),BIGINT,,laboratory.specimen.specimen_id,,,transactional_data,Identifier for the patient blood specimen used for compatibility testing. Critical for ensuring correct patient-unit matching.,
laboratory,transfusion_services,transfusion_event,surgical_case_id,surgical_case_id,Surgical Case Id (Foreign Key),BIGINT,,scheduling.surgical_case.surgical_case_id,,,transactional_data,"Foreign key linking to scheduling.surgical_case. Business justification: Blood transfusions during surgery are common and require tracking for blood bank management, surgical quality metrics, and hemovigilance reporting. Essential for linking intra-operative transfusions t",
laboratory,transfusion_services,transfusion_event,treatment_consent_id,treatment_consent_id,Treatment Consent Id (Foreign Key),BIGINT,,consent.treatment_consent.treatment_consent_id,"dbx_restricted, dbx_pii",,transactional_data,"Foreign key linking to consent.treatment_consent. Business justification: Blood transfusions require specific informed consent documenting transfusion risks (reactions, infections, iron overload), benefits, and alternatives. Regulatory requirement in most jurisdictions. Jeh",
laboratory,transfusion_services,transfusion_event,visit_id,visit_id,Visit Identifier (ID),BIGINT,,encounter.visit.visit_id,,,transactional_data,Unique identifier for the clinical encounter during which the transfusion occurred.,
laboratory,transfusion_services,transfusion_event,antibody_screen_result,antibody_screen_result,Antibody Screen Result,STRING,,,,positive|negative|not_performed|indeterminate,transactional_data,Result of the antibody screening test to detect unexpected antibodies in patient serum that could cause transfusion reactions.,
laboratory,transfusion_services,transfusion_event,clinical_indication,clinical_indication,Clinical Indication,STRING,,,,,transactional_data,"Medical reason or clinical indication for the transfusion (e.g., acute blood loss, anemia, thrombocytopenia, coagulopathy). Supports appropriateness review and utilization management.",
laboratory,transfusion_services,transfusion_event,consent_datetime,consent_datetime,Consent Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when informed consent for transfusion was obtained.,
laboratory,transfusion_services,transfusion_event,consent_obtained,consent_obtained,Consent Obtained Indicator,BOOLEAN,,,,,transactional_data,Boolean flag indicating whether informed consent for transfusion was obtained from the patient or authorized representative prior to administration.,
laboratory,transfusion_services,transfusion_event,created_datetime,created_datetime,Record Created Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when this transfusion event record was first created in the system. Audit trail timestamp.,
laboratory,transfusion_services,transfusion_event,crossmatch_datetime,crossmatch_datetime,Crossmatch Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when the crossmatch compatibility testing was completed.,
laboratory,transfusion_services,transfusion_event,crossmatch_result,crossmatch_result,Crossmatch Result,STRING,,,,compatible|incompatible|not_performed|indeterminate,transactional_data,"Outcome of the compatibility testing between donor unit and patient sample. Compatible indicates safe to transfuse, incompatible indicates potential reaction risk.",
laboratory,transfusion_services,transfusion_event,crossmatch_type,crossmatch_type,Crossmatch Type,STRING,,,,electronic|immediate_spin|full_serologic|type_and_screen|emergency_release,transactional_data,"Type of compatibility testing performed prior to transfusion. Electronic crossmatch uses computer verification, immediate spin is abbreviated testing, full serologic is complete antiglobulin testing.",
laboratory,transfusion_services,transfusion_event,hemovigilance_reported,hemovigilance_reported,Hemovigilance Reported Indicator,BOOLEAN,,,,,transactional_data,"Boolean flag indicating whether this transfusion event was reported to the institutional or national hemovigilance surveillance system, typically for adverse reactions.",
laboratory,transfusion_services,transfusion_event,last_updated_datetime,last_updated_datetime,Record Last Updated Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when this transfusion event record was most recently modified. Audit trail timestamp.,
laboratory,transfusion_services,transfusion_event,notes,notes,Transfusion Notes,STRING,,,,,transactional_data,"Free-text clinical notes or comments related to the transfusion event, including any special circumstances, patient tolerance, or follow-up actions.",
laboratory,transfusion_services,transfusion_event,post_transfusion_blood_pressure_diastolic,post_transfusion_blood_pressure_diastolic,Post-Transfusion Blood Pressure Diastolic,INT,,,,,transactional_data,Patient diastolic blood pressure in mmHg measured after transfusion completion. Used to detect hemodynamic changes.,
laboratory,transfusion_services,transfusion_event,post_transfusion_blood_pressure_systolic,post_transfusion_blood_pressure_systolic,Post-Transfusion Blood Pressure Systolic,INT,,,,,transactional_data,Patient systolic blood pressure in mmHg measured after transfusion completion. Used to detect hemodynamic changes.,
laboratory,transfusion_services,transfusion_event,post_transfusion_pulse,post_transfusion_pulse,Post-Transfusion Pulse Rate,INT,,,,,transactional_data,Patient pulse rate in beats per minute measured after transfusion completion. Used to detect hemodynamic changes.,
laboratory,transfusion_services,transfusion_event,post_transfusion_respiratory_rate,post_transfusion_respiratory_rate,Post-Transfusion Respiratory Rate,INT,,,,,transactional_data,Patient respiratory rate in breaths per minute measured after transfusion completion. Used to detect respiratory complications.,
laboratory,transfusion_services,transfusion_event,post_transfusion_temperature,post_transfusion_temperature,Post-Transfusion Temperature,"DECIMAL(4,1)",,,,,transactional_data,Patient body temperature in degrees Celsius measured after transfusion completion. Used to detect febrile reactions.,
laboratory,transfusion_services,transfusion_event,pre_transfusion_blood_pressure_diastolic,pre_transfusion_blood_pressure_diastolic,Pre-Transfusion Blood Pressure Diastolic,INT,,,,,transactional_data,Patient diastolic blood pressure in mmHg measured immediately before transfusion start. Baseline for reaction monitoring.,
laboratory,transfusion_services,transfusion_event,pre_transfusion_blood_pressure_systolic,pre_transfusion_blood_pressure_systolic,Pre-Transfusion Blood Pressure Systolic,INT,,,,,transactional_data,Patient systolic blood pressure in mmHg measured immediately before transfusion start. Baseline for reaction monitoring.,
laboratory,transfusion_services,transfusion_event,pre_transfusion_pulse,pre_transfusion_pulse,Pre-Transfusion Pulse Rate,INT,,,,,transactional_data,Patient pulse rate in beats per minute measured immediately before transfusion start. Baseline for reaction monitoring.,
laboratory,transfusion_services,transfusion_event,pre_transfusion_respiratory_rate,pre_transfusion_respiratory_rate,Pre-Transfusion Respiratory Rate,INT,,,,,transactional_data,Patient respiratory rate in breaths per minute measured immediately before transfusion start. Baseline for reaction monitoring.,
laboratory,transfusion_services,transfusion_event,pre_transfusion_temperature,pre_transfusion_temperature,Pre-Transfusion Temperature,"DECIMAL(4,1)",,,,,transactional_data,Patient body temperature in degrees Celsius measured immediately before transfusion start. Baseline for reaction monitoring.,
laboratory,transfusion_services,transfusion_event,reaction_description,reaction_description,Reaction Description,STRING,,,,,transactional_data,"Free-text clinical description of the transfusion reaction signs, symptoms, and clinical course. May include fever, chills, rash, dyspnea, hypotension, or other manifestations.",
laboratory,transfusion_services,transfusion_event,reaction_onset_datetime,reaction_onset_datetime,Reaction Onset Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when the transfusion reaction symptoms were first observed. Critical for determining reaction type and causality.,
laboratory,transfusion_services,transfusion_event,reaction_severity,reaction_severity,Reaction Severity,STRING,,,,mild|moderate|severe|life_threatening,transactional_data,"Clinical severity classification of the transfusion reaction. Mild reactions may require monitoring only, severe and life-threatening reactions require immediate intervention.",
laboratory,transfusion_services,transfusion_event,special_requirements,special_requirements,Special Requirements,STRING,,,,,transactional_data,"Any special processing or handling requirements for the transfusion (e.g., irradiated, CMV-negative, leukoreduced, washed). Critical for immunocompromised patients.",
laboratory,transfusion_services,transfusion_event,transfusion_end_datetime,transfusion_end_datetime,Transfusion End Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when the blood product transfusion was completed or discontinued.,
laboratory,transfusion_services,transfusion_event,transfusion_number,transfusion_number,Transfusion Number,STRING,,,,,transactional_data,"Human-readable business identifier for the transfusion event, often used for tracking and audit purposes.",
laboratory,transfusion_services,transfusion_event,transfusion_rate,transfusion_rate,Transfusion Rate,"DECIMAL(18,2)",,,,,transactional_data,"Rate at which the blood product was administered (e.g., 100 mL/hour, slow infusion over 4 hours). Important for patient safety and reaction prevention.",
laboratory,transfusion_services,transfusion_event,transfusion_reaction_occurred,transfusion_reaction_occurred,Transfusion Reaction Occurred Indicator,BOOLEAN,,,,,transactional_data,Boolean flag indicating whether any adverse transfusion reaction was observed during or after the transfusion.,
laboratory,transfusion_services,transfusion_event,transfusion_reaction_type,transfusion_reaction_type,Transfusion Reaction Type,STRING,,,,,transactional_data,"Classification of the adverse transfusion reaction type if one occurred. Includes febrile non-hemolytic reaction (FNHTR), allergic, anaphylactic, acute hemolytic, delayed hemolytic, transfusion-related acute lung injury (TRALI), and transfusion-associated circulatory overload (TACO). [ENUM-REF-CANDIDATE: febrile_non_hemolytic|allergic|anaphylactic|acute_hemolytic|delayed_hemolytic|transfusion_related_acute_lung_injury|transfusion_associated_circulatory_overload — 7 candidates stripped; promote to reference product]",
laboratory,transfusion_services,transfusion_event,transfusion_site,transfusion_site,Transfusion Site,STRING,,,,,transactional_data,"Anatomical location or clinical area where the transfusion was administered (e.g., right antecubital, left hand, central line).",
laboratory,transfusion_services,transfusion_event,transfusion_start_datetime,transfusion_start_datetime,Transfusion Start Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when the blood product transfusion was initiated. Critical for monitoring transfusion duration and reaction timing.,
laboratory,transfusion_services,transfusion_event,transfusion_status,transfusion_status,Transfusion Status,STRING,,,,ordered|prepared|in_progress|completed|discontinued|cancelled,transactional_data,Current lifecycle status of the transfusion event. Tracks progression from order through completion or discontinuation.,
laboratory,transfusion_services,transfusion_event,unexpected_antibody_identified,unexpected_antibody_identified,Unexpected Antibody Identified,STRING,,,,,transactional_data,"Specific antibody or antibodies identified during antibody identification testing, if antibody screen was positive. May include multiple antibodies separated by commas.",
laboratory,transfusion_services,transfusion_event,volume_transfused_ml,volume_transfused_ml,Volume Transfused in Milliliters (mL),INT,,,,,transactional_data,Total volume of blood product transfused in milliliters. Used for dosing verification and fluid balance monitoring.,
order,entry_management,clinical_order,clinical_order_id,clinical_order_id,Clinical Order ID,BIGINT,Y,,,,master_data,Unique surrogate identifier for each clinical order record in the enterprise data lakehouse. Primary key for the clinical_order data product.,
order,entry_management,clinical_order,attestation_id,attestation_id,Attestation Id (Foreign Key),BIGINT,,compliance.attestation.attestation_id,,,master_data,"Foreign key linking to compliance.attestation. Business justification: Providers attest to appropriate ordering practices (antibiotic stewardship attestation, opioid prescribing attestation). Compliance attestation covers ordering behavior for regulatory and quality prog",
order,entry_management,clinical_order,consent_record_id,consent_record_id,Consent Record Id (Foreign Key),BIGINT,,consent.consent_record.consent_record_id,,,master_data,"Foreign key linking to consent.consent_record. Business justification: Procedures, surgeries, and high-risk treatments require documented informed consent. Pre-procedure verification workflows mandate linking orders to the authorizing consent record. Core HIPAA and state",
order,entry_management,clinical_order,cpt_code_id,cpt_code_id,Cpt Code Id (Foreign Key),BIGINT,,reference.cpt_code.cpt_code_id,,,master_data,"Foreign key linking to reference.cpt_code. Business justification: Procedure orders must link to CPT master for charge capture, prior authorization validation, RVU-based resource planning, and compliance with coding standards. Essential for revenue cycle and utilizat",
order,entry_management,clinical_order,icd_code_id,icd_code_id,Icd10 Indication Code Id (Foreign Key),BIGINT,,reference.icd_code.icd_code_id,,,master_data,"Foreign key linking to reference.icd_code. Business justification: Core clinical ordering workflow requires validation of diagnosis indication against ICD-10 master for billing compliance, clinical decision support, quality reporting, and medical necessity documentat",
order,entry_management,clinical_order,material_master_id,material_master_id,Material Master Id (Foreign Key),BIGINT,,supply.material_master.material_master_id,,,master_data,"Foreign key linking to supply.material_master. Business justification: Surgical and procedural orders frequently specify medical devices, implants, or supplies by catalog number (e.g., orthopedic hardware, cardiac stents). Essential for charge capture, inventory depletio",
order,entry_management,clinical_order,order_set_id,order_set_id,Order Set ID,BIGINT,,order.order_set.order_set_id,,,master_data,"Identifier of the clinical order set or protocol from which this order was generated, if applicable. Order sets are pre-defined bundles of evidence-based orders (e.g., Sepsis Bundle, AMI Order Set). Null if the order was placed individually outside an order set.",
order,entry_management,clinical_order,ordering_cost_center_id,ordering_cost_center_id,Ordering Cost Center Id (Foreign Key),BIGINT,,finance.cost_center.cost_center_id,,,master_data,"Foreign key linking to finance.cost_center. Business justification: Clinical orders must be charged to departmental cost centers for accurate cost allocation, profitability analysis, and departmental budgeting. Essential for activity-based costing and service line fin",
order,entry_management,clinical_order,parent_clinical_order_id,parent_clinical_order_id,Parent Order ID,BIGINT,,order.clinical_order.clinical_order_id,,,master_data,"Reference to the parent clinical order when this order is a child or linked order in a chained order relationship (e.g., a reflex lab order triggered by a parent panel, or a follow-up order linked to an original). Null for top-level independent orders.",
order,entry_management,clinical_order,payer_id,payer_id,Payer Id (Foreign Key),BIGINT,,insurance.payer.payer_id,,,master_data,"Foreign key linking to insurance.payer. Business justification: Every clinical order requires payer identification for real-time eligibility verification, coverage determination, and prior authorization checks at order entry. CPOE systems integrate payer data for ",
order,entry_management,clinical_order,preferred_vendor_id,preferred_vendor_id,Preferred Vendor Id (Foreign Key),BIGINT,,supply.vendor.vendor_id,,,master_data,"Foreign key linking to supply.vendor. Business justification: High-value implant orders often specify preferred vendor (e.g., vendor rep present in OR for device support). Tracks vendor-specific devices for consignment inventory, pricing, and vendor performance.",
order,entry_management,clinical_order,primary_clinical_care_site_id,primary_clinical_care_site_id,Ordering Department ID,BIGINT,,facility.care_site.care_site_id,,,master_data,"Reference to the clinical department or unit from which the order was placed (e.g., ICU, ED, Cardiology Clinic). Used for departmental utilization reporting, cost allocation, and operational analytics.",
order,entry_management,clinical_order,primary_clinical_clinician_id,primary_clinical_clinician_id,Ordering Provider ID,BIGINT,,provider.clinician.clinician_id,,,master_data,Reference to the clinician who entered or authorized this order via Computerized Physician Order Entry (CPOE). Corresponds to the ordering provider NPI-linked record in the provider master.,
order,entry_management,clinical_order,quality_measure_id,quality_measure_id,Quality Measure Id (Foreign Key),BIGINT,,quality.measure.measure_id,,,master_data,"Foreign key linking to quality.measure. Business justification: Clinical orders directly contribute to quality measure numerator/denominator calculation (e.g., timely antibiotic administration for sepsis, VTE prophylaxis orders). Quality reporting systems query or",
order,entry_management,clinical_order,research_study_id,research_study_id,Research Study Id (Foreign Key),BIGINT,,research.research_study.research_study_id,,,master_data,"Foreign key linking to research.research_study. Business justification: Clinical orders for investigational procedures, research labs, or study-specific imaging must link to the research study for research billing determination, coverage analysis (standard-of-care vs rese",
order,entry_management,clinical_order,tertiary_clinical_authorizing_provider_clinician_id,tertiary_clinical_authorizing_provider_clinician_id,Authorizing Provider ID,BIGINT,,provider.clinician.clinician_id,,,master_data,"Reference to the provider who authorized or approved the order when different from the ordering provider (e.g., attending physician authorizing a resident-entered order). Supports order authentication and supervision compliance tracking.",
order,entry_management,clinical_order,visit_id,visit_id,Visit ID,BIGINT,,encounter.visit.visit_id,,,master_data,"Reference to the patient encounter or visit during which this clinical order was placed. Links the order to the encounter context (inpatient, outpatient, ED, ambulatory).",
order,entry_management,clinical_order,authorization_number,authorization_number,Prior Authorization Number,STRING,,,,,master_data,"Payer-issued prior authorization number obtained before order fulfillment for services requiring pre-authorization (e.g., advanced imaging, elective procedures, specialty referrals). Required for claims submission and denial prevention.",
order,entry_management,clinical_order,bigint_surrogate_key_for_clean_keying,bigint_surrogate_key_for_clean_keying,Patient ID,BIGINT,,,,,master_data,Reference to the patient for whom this clinical order was placed. Core PARTY_REFERENCE linking the order to the patient master record.,
order,entry_management,clinical_order,cancellation_reason,cancellation_reason,Order Cancellation Reason,STRING,,,,,master_data,"Reason code or description explaining why the order was cancelled or discontinued (e.g., Duplicate Order, Patient Refused, Clinical Contraindication, Order Error). Required for medication safety and quality reporting. [ENUM-REF-CANDIDATE: duplicate|patient_refused|contraindication|order_error|provider_request|clinical_change — promote to reference product]",
order,entry_management,clinical_order,cancelled_datetime,cancelled_datetime,Order Cancelled Datetime,TIMESTAMP,,,,,master_data,"Timestamp when the order was cancelled or discontinued. Null for active or completed orders. Used for order lifecycle analytics, duplicate order detection, and medication safety reporting.",
order,entry_management,clinical_order,clinical_decision_support_alert,clinical_decision_support_alert,Clinical Decision Support (CDS) Alert Response,STRING,,,,no_alert|alert_accepted|alert_overridden|alert_cancelled,master_data,"Indicates whether a Clinical Decision Support (CDS) alert was triggered at order entry and the providers response. Supports medication safety monitoring, duplicate order detection, and CDS effectiveness analytics per AHRQ and ONC requirements.",
order,entry_management,clinical_order,clinical_indication_text,clinical_indication_text,Clinical Indication Free Text,STRING,,,,,master_data,Free-text clinical rationale or indication entered by the ordering provider to justify the order. Supplements the ICD-10 indication code with narrative context. Used by Clinical Documentation Improvement (CDI) and utilization management teams.,
order,entry_management,clinical_order,completed_datetime,completed_datetime,Order Completed Datetime,TIMESTAMP,,,,,master_data,Timestamp when the order was fulfilled and marked as completed by the performing department or system. Used for turnaround time (TAT) measurement and order fulfillment analytics.,
order,entry_management,clinical_order,cosign_completed_datetime,cosign_completed_datetime,Co-sign Completed Datetime,TIMESTAMP,,,,,master_data,Timestamp when the required co-signature for a verbal or telephone order was completed by the authorizing provider. Used to measure compliance with TJC verbal order authentication requirements.,
order,entry_management,clinical_order,cosign_due_datetime,cosign_due_datetime,Co-sign Due Datetime,TIMESTAMP,,,,,master_data,Deadline by which a verbal or telephone order must be co-signed by the authorizing provider per TJC and CMS requirements (typically within 24-48 hours). Null for electronically-entered orders that do not require co-signature.,
order,entry_management,clinical_order,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,master_data,Timestamp when this clinical order record was first created in the enterprise data lakehouse (Silver Layer). Serves as the RECORD_AUDIT_CREATED field for data lineage and audit trail purposes. Distinct from order_datetime (clinical event time).,
order,entry_management,clinical_order,frequency_code,frequency_code,Order Frequency Code,STRING,,,,,master_data,"Standardized frequency code specifying how often a recurring order should be executed (e.g., QD for daily, BID for twice daily, Q4H for every 4 hours, PRN for as needed). Applicable primarily to pharmacy, nursing, and timed lab orders.",
order,entry_management,clinical_order,id_fk,id_fk,,BIGINT,,,,,master_data,entity_type,
order,entry_management,clinical_order,is_cpoe_entered,is_cpoe_entered,Computerized Physician Order Entry (CPOE) Flag,BOOLEAN,,,,,master_data,"Indicates whether the order was entered directly by the ordering provider via Computerized Physician Order Entry (CPOE) (True) versus entered by a nurse, pharmacist, or other staff on behalf of the provider (False). Key metric for CPOE adoption and Meaningful Use/Promoting Interoperability reporting.",
order,entry_management,clinical_order,is_order_set_member,is_order_set_member,Order Set Member Flag,BOOLEAN,,,,,master_data,Indicates whether this order was placed as part of a clinical order set or protocol bundle (True) versus as a standalone individual order (False). Used for order set utilization analytics and evidence-based practice reporting.,
order,entry_management,clinical_order,is_recurring,is_recurring,Recurring Order Flag,BOOLEAN,,,,,master_data,"Indicates whether this order is a recurring or standing order (True) that repeats on a defined schedule, versus a one-time order (False). Relevant for nursing, pharmacy, and lab orders with scheduled frequencies.",
order,entry_management,clinical_order,is_verbal_order,is_verbal_order,Verbal Order Flag,BOOLEAN,,,,,master_data,Indicates whether this order was received verbally (True) and requires subsequent written or electronic authentication per TJC and CMS standards. Drives co-signature workflow and compliance monitoring.,
order,entry_management,clinical_order,number_of_occurrences,number_of_occurrences,Number of Order Occurrences,INT,,,,,master_data,"Total number of times a recurring order is to be executed before automatic discontinuation. For example, a lab order for CBC x3 days would have number_of_occurrences = 3. Null for open-ended standing orders.",
order,entry_management,clinical_order,order_catalog_code,order_catalog_code,Order Catalog Code,STRING,,,,,master_data,"Internal order catalog or procedure code from the source EHR system (Epic procedure ID or Cerner catalog item code). Used for order set management, CDM mapping, and charge capture reconciliation.",
order,entry_management,clinical_order,order_class,order_class,Clinical Order Class,STRING,,,,inpatient|outpatient|ED|ambulatory,master_data,"Patient care setting classification for the order, indicating the clinical context in which the order was placed. Inpatient orders originate from admitted patients; ED orders from Emergency Department encounters; ambulatory from clinic visits.",
order,entry_management,clinical_order,order_datetime,order_datetime,Order Placed Datetime,TIMESTAMP,,,,,master_data,The principal real-world timestamp when the clinical order was placed or entered into the CPOE system. Serves as the BUSINESS_EVENT_TIMESTAMP for this transaction. Used for turnaround time (TAT) calculations and regulatory reporting.,
order,entry_management,clinical_order,order_entered_datetime,order_entered_datetime,Order Entered Datetime,TIMESTAMP,,,,,master_data,"Timestamp when the order was physically entered into the EHR system, which may differ from order_datetime (the clinically intended order time) for verbal or backdated orders. Used for CPOE compliance auditing and order authentication tracking.",
order,entry_management,clinical_order,order_mode,order_mode,Clinical Order Mode,STRING,,,,electronic|verbal|written|telephone,master_data,Method by which the clinical order was entered or communicated. Electronic orders are entered directly via CPOE; verbal and telephone orders require co-signature per regulatory requirements. Supports compliance auditing and order authentication tracking.,
order,entry_management,clinical_order,order_name,order_name,Clinical Order Name,STRING,,,,,master_data,"Human-readable name or description of the ordered item or service as displayed in the EHR (e.g., CBC with Differential, Chest X-Ray PA and Lateral, Metoprolol 25mg PO). Sourced from the Charge Description Master (CDM) or order catalog.",
order,entry_management,clinical_order,order_number,order_number,Clinical Order Number,STRING,,,,,master_data,"Externally-known, human-readable order identifier assigned by the source system (Epic Orders or Cerner Millennium). Used for cross-system reconciliation, audit trails, and communication with clinical staff. Serves as the BUSINESS_IDENTIFIER for this transaction.",
order,entry_management,clinical_order,order_priority,order_priority,Clinical Order Priority,STRING,,,,STAT|routine|urgent|timed,master_data,Clinical urgency classification for the order. STAT indicates immediate action required; timed indicates a specific scheduled execution time. Embedded enum per product design specification. Drives turnaround time (TAT) SLA monitoring.,
order,entry_management,clinical_order,order_status,order_status,Clinical Order Status,STRING,,,,pending|active|completed|cancelled|on_hold|discontinued,master_data,Current workflow lifecycle state of the clinical order. Drives downstream fulfillment routing and reporting. Values align with Epic Orders and HL7 FHIR ServiceRequest status codes.,
order,entry_management,clinical_order,order_type,order_type,Clinical Order Type,STRING,,,,,master_data,"Classification of the clinical order by modality or service category. Determines routing to the appropriate fulfillment system: Beaker (LIS) for lab, Radiant (RIS) for radiology, Willow for pharmacy, etc. Embedded enum per product design specification. [ENUM-REF-CANDIDATE: lab|radiology|pharmacy|referral|nursing|dietary|consult — 7 candidates stripped; promote to reference product]",
order,entry_management,clinical_order,ordering_provider_npi,ordering_provider_npi,Ordering Provider National Provider Identifier (NPI),STRING,,,,^[0-9]{10}$,master_data,"10-digit National Provider Identifier (NPI) of the clinician who placed the order. Stored denormalized on the order for regulatory reporting, claims submission, and audit purposes per CMS requirements. Distinct from the FK to the provider master.",
order,entry_management,clinical_order,patient_mrn,patient_mrn,Patient Medical Record Number (MRN),STRING,,,"dbx_pii_identifier,dbx_restricted,pii_phi,pii_pii,pii_sensitive",,master_data,"Medical Record Number (MRN) of the patient for whom the order was placed. Stored denormalized on the order for cross-system reconciliation, HL7 ADT message processing, and regulatory audit trails. Sourced from the Master Patient Index (MPI).",
order,entry_management,clinical_order,quantity_ordered,quantity_ordered,Quantity Ordered,"DECIMAL(10,3)",,,,,master_data,"Numeric quantity of the ordered item or service (e.g., number of lab panels, number of imaging views, medication dose quantity). Unit of measure is captured in quantity_unit. Used for supply chain, pharmacy dispensing, and charge capture.",
order,entry_management,clinical_order,quantity_unit,quantity_unit,Order Quantity Unit of Measure,STRING,,,,,master_data,"Unit of measure for the quantity_ordered field (e.g., mg, mL, units, each, tablet). Follows UCUM (Unified Code for Units of Measure) standards for interoperability with HL7 FHIR.",
order,entry_management,clinical_order,source_system,source_system,Order Source System,STRING,,,,Epic|Cerner|MEDITECH|manual,master_data,"Operational system of record from which this clinical order originated. Supports data lineage, ETL reconciliation, and multi-system enterprise integration. Values correspond to the enterprise EHR systems in use.",
order,entry_management,clinical_order,start_datetime,start_datetime,Order Start Datetime,TIMESTAMP,,,,,master_data,"Datetime when the order is scheduled to begin or when fulfillment should commence. For timed orders, this is the precise execution start time. Distinct from order_datetime (when placed) and order_datetime (when entered).",
order,entry_management,clinical_order,stop_datetime,stop_datetime,Order Stop Datetime,TIMESTAMP,,,,,master_data,"Datetime when the order expires, is discontinued, or fulfillment should cease. Critical for pharmacy and nursing orders to prevent over-administration. Nullable for one-time orders.",
order,entry_management,clinical_order,updated_timestamp,updated_timestamp,Record Updated Timestamp,TIMESTAMP,,,,,master_data,"Timestamp when this clinical order record was last modified in the enterprise data lakehouse. Serves as the RECORD_AUDIT_UPDATED field for change tracking, incremental ETL processing, and audit compliance.",
order,entry_management,cpoe_alert,cpoe_alert_id,cpoe_alert_id,Computerized Physician Order Entry (CPOE) Alert ID,BIGINT,Y,,,,transactional_data,Unique identifier for the CPOE clinical decision support alert event.,
order,entry_management,cpoe_alert,alert_rule_id,alert_rule_id,Alert Rule ID,BIGINT,,order.alert_rule.alert_rule_id,,,transactional_data,"Unique identifier of the specific clinical decision support rule or logic that triggered this alert, used for rule performance tracking and optimization.",
order,entry_management,cpoe_alert,clinical_ai_model_inference_log_id,clinical_ai_model_inference_log_id,Model Inference Log Id (Foreign Key),BIGINT,,clinical_ai.clinical_ai_model_inference_log.clinical_ai_model_inference_log_id,,,transactional_data,"Foreign key linking to clinical_ai.model_inference_log. Business justification: CDS governance: AI-generated CPOE alerts (drug interaction predictions, dosing recommendations) must trace to the specific model inference run for explainability, alert fatigue analysis, and FDA SaMD ",Internal - LLM Generated Cross-Domain Link
order,entry_management,cpoe_alert,clinical_order_id,clinical_order_id,Clinical Order ID,BIGINT,,order.clinical_order.clinical_order_id,,,transactional_data,Foreign key reference to the clinical order that triggered this alert during CPOE entry workflow.,
order,entry_management,cpoe_alert,clinician_id,clinician_id,Ordering Provider ID,BIGINT,,provider.clinician.clinician_id,,,transactional_data,Foreign key reference to the clinician who was entering the order when the alert was triggered.,
order,entry_management,cpoe_alert,compliance_policy_id,compliance_policy_id,Policy Id (Foreign Key),BIGINT,,compliance.compliance_policy.compliance_policy_id,,,transactional_data,"Foreign key linking to compliance.policy. Business justification: CPOE alert rules implement clinical policies (formulary policy, dose range policy, duplicate therapy policy). Alert logic enforces policy compliance at point of order entry for medication safety.",
order,entry_management,cpoe_alert,insurance_coverage_policy_id,insurance_coverage_policy_id,Coverage Policy Id (Foreign Key),BIGINT,,insurance.insurance_coverage_policy.insurance_coverage_policy_id,,,transactional_data,"Foreign key linking to insurance.coverage_policy. Business justification: CPOE alerts fire based on payer coverage policies for non-covered services, step therapy requirements, and prior authorization needs. Real-world process: clinical decision support systems integrate pa",
order,entry_management,cpoe_alert,mpi_record_id,mpi_record_id,Patient ID,BIGINT,,patient.mpi_record.mpi_record_id,,,transactional_data,Foreign key reference to the patient for whom the order was being entered when the alert fired.,
order,entry_management,cpoe_alert,visit_id,visit_id,Visit ID,BIGINT,,encounter.visit.visit_id,,,transactional_data,Foreign key reference to the patient encounter during which this alert was fired.,
order,entry_management,cpoe_alert,alert_acknowledged_flag,alert_acknowledged_flag,Alert Acknowledged Flag,BOOLEAN,,,,,transactional_data,Boolean indicator of whether the provider explicitly acknowledged viewing the alert before taking action.,
order,entry_management,cpoe_alert,alert_display_duration_seconds,alert_display_duration_seconds,Alert Display Duration Seconds,INT,,,,,transactional_data,"Number of seconds the alert was displayed on screen before the provider responded, used for alert fatigue analysis.",
order,entry_management,cpoe_alert,alert_fire_timestamp,alert_fire_timestamp,Alert Fire Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when the clinical decision support alert was triggered during CPOE order entry workflow.,
order,entry_management,cpoe_alert,alert_message,alert_message,Alert Message,STRING,,,,,transactional_data,Full text message content of the alert explaining the clinical concern and recommended action.,
order,entry_management,cpoe_alert,alert_priority,alert_priority,Alert Priority,STRING,,,,critical|high|medium|low,transactional_data,Priority level assigned to the alert based on clinical significance and potential patient harm.,
order,entry_management,cpoe_alert,alert_rule_version,alert_rule_version,Alert Rule Version,STRING,,,,,transactional_data,"Version number of the CDS rule at the time the alert was fired, supporting rule change tracking and historical analysis.",
order,entry_management,cpoe_alert,alert_severity,alert_severity,Alert Severity,STRING,,,,hard_stop|soft_stop|informational|warning,transactional_data,"Severity level of the alert indicating whether the order can proceed: hard stop (order blocked), soft stop (override allowed), informational (no action required), or warning (caution advised).",
order,entry_management,cpoe_alert,alert_source_system,alert_source_system,Alert Source System,STRING,,,,,transactional_data,"Name of the clinical decision support system or knowledge base that generated the alert (e.g., Epic CDS, First Databank, Medi-Span, Micromedex).",
order,entry_management,cpoe_alert,alert_suppressed_flag,alert_suppressed_flag,Alert Suppressed Flag,BOOLEAN,,,,,transactional_data,Boolean indicator of whether the alert was suppressed by system configuration or provider preference settings and not displayed to the ordering provider.,
order,entry_management,cpoe_alert,alert_title,alert_title,Alert Title,STRING,,,,,transactional_data,Short descriptive title of the alert displayed to the ordering provider in the CPOE interface.,
order,entry_management,cpoe_alert,alert_trigger_detail,alert_trigger_detail,Alert Trigger Detail,STRING,,,,,transactional_data,"Detailed information about what triggered the alert, such as specific drug names in an interaction, allergy substance, or duplicate order details.",
order,entry_management,cpoe_alert,alert_type,alert_type,Alert Type,STRING,,,,drug_drug_interaction|drug_allergy|duplicate_order|dose_range_check|contraindication|formulary_substitution,transactional_data,Category of clinical decision support alert fired during order entry. [ENUM-REF-CANDIDATE: drug_drug_interaction|drug_allergy|duplicate_order|dose_range_check|contraindication|formulary_substitution|critical_lab_value|renal_dosing|pregnancy_warning|age_based_warning|therapeutic_duplication|black_box_warning — promote to reference product],
order,entry_management,cpoe_alert,allergy_substance,allergy_substance,Allergy Substance,STRING,,,,,transactional_data,"Allergen or substance that triggered a drug-allergy alert, matched against the patients documented allergy list.",
order,entry_management,cpoe_alert,clinical_context,clinical_context,Clinical Context,STRING,,,,,transactional_data,"Additional clinical context at the time of alert such as patient location, care setting, or clinical indication that may influence alert interpretation.",
order,entry_management,cpoe_alert,created_timestamp,created_timestamp,Created Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when this alert record was first created in the system.,
order,entry_management,cpoe_alert,duplicate_order_timeframe_hours,duplicate_order_timeframe_hours,Duplicate Order Timeframe Hours,INT,,,,,transactional_data,"Number of hours within which a duplicate order was detected, used for duplicate order alerts to indicate how recently a similar order was placed.",
order,entry_management,cpoe_alert,formulary_status,formulary_status,Formulary Status,STRING,,,,formulary|non_formulary|restricted|prior_auth_required,transactional_data,Formulary classification of the ordered medication that triggered a formulary substitution alert.,
order,entry_management,cpoe_alert,interacting_medication_1,interacting_medication_1,Interacting Medication 1,STRING,,,,,transactional_data,"First medication involved in a drug-drug interaction alert, typically the newly ordered medication.",
order,entry_management,cpoe_alert,interacting_medication_2,interacting_medication_2,Interacting Medication 2,STRING,,,,,transactional_data,"Second medication involved in a drug-drug interaction alert, typically an existing active medication on the patients medication list.",
order,entry_management,cpoe_alert,modified_timestamp,modified_timestamp,Modified Timestamp,TIMESTAMP,,,,,transactional_data,Date and time when this alert record was last modified or updated.,
order,entry_management,cpoe_alert,ordered_dose,ordered_dose,Ordered Dose,"DECIMAL(18,4)",,,,,transactional_data,Medication dose that was ordered and triggered a dose range check alert.,
order,entry_management,cpoe_alert,ordered_dose_unit,ordered_dose_unit,Ordered Dose Unit,STRING,,,,,transactional_data,"Unit of measure for the ordered dose (e.g., mg, mL, units) that triggered the dose range check alert.",
order,entry_management,cpoe_alert,override_reason_code,override_reason_code,Override Reason Code,STRING,,,,,transactional_data,"Standardized code indicating the reason the provider chose to override the alert, required for soft stop alerts that are dismissed.",
order,entry_management,cpoe_alert,override_reason_text,override_reason_text,Override Reason Text,STRING,,,,,transactional_data,Free-text explanation provided by the ordering provider justifying why the alert was overridden.,
order,entry_management,cpoe_alert,patient_age_at_alert,patient_age_at_alert,Patient Age at Alert,INT,,,,,transactional_data,"Patients age in years at the time the alert was fired, relevant for age-based dosing and contraindication alerts.",
order,entry_management,cpoe_alert,patient_weight_kg,patient_weight_kg,Patient Weight Kilograms,"DECIMAL(8,2)",,,,,transactional_data,"Patients weight in kilograms at the time of alert, used for weight-based dosing calculations in dose range check alerts.",
order,entry_management,cpoe_alert,provider_response,provider_response,Provider Response,STRING,,,,accepted|overridden|modified|cancelled|deferred,transactional_data,"Action taken by the ordering provider in response to the alert: accepted (order changed per alert), overridden (alert dismissed and order continued), modified (order adjusted), cancelled (order abandoned), or deferred (decision postponed).",
order,entry_management,cpoe_alert,recommended_dose_max,recommended_dose_max,Recommended Dose Maximum,"DECIMAL(18,4)",,,,,transactional_data,Maximum recommended dose from the clinical decision support knowledge base for dose range check alerts.,
order,entry_management,cpoe_alert,recommended_dose_min,recommended_dose_min,Recommended Dose Minimum,"DECIMAL(18,4)",,,,,transactional_data,Minimum recommended dose from the clinical decision support knowledge base for dose range check alerts.,
order,entry_management,cpoe_alert,response_timestamp,response_timestamp,Response Timestamp,TIMESTAMP,,,,,transactional_data,"Date and time when the ordering provider responded to the alert by accepting, overriding, or modifying the order.",
order,entry_management,cpoe_alert,suggested_alternative_medication,suggested_alternative_medication,Suggested Alternative Medication,STRING,,,,,transactional_data,Formulary-preferred alternative medication suggested by the alert as a therapeutic substitution.,
order,entry_management,cpoe_alert,suppression_reason,suppression_reason,Suppression Reason,STRING,,,,,transactional_data,"Reason why the alert was suppressed, such as provider preference override, alert fatigue reduction rule, or duplicate alert within session.",
order,entry_management,order_authorization,order_authorization_id,order_authorization_id,Order Authorization Identifier (ID),BIGINT,Y,,,,transactional_data,Unique identifier for the order authorization record. Primary key for this entity.,
order,entry_management,order_authorization,business_associate_agreement_id,business_associate_agreement_id,Business Associate Agreement Id (Foreign Key),BIGINT,,compliance.business_associate_agreement.business_associate_agreement_id,,,transactional_data,"Foreign key linking to compliance.business_associate_agreement. Business justification: Authorization vendors (eviCore, AIM) are business associates handling PHI. BAA governs authorization service relationship for HIPAA compliance and PHI protection.",
order,entry_management,order_authorization,clinical_order_id,clinical_order_id,Clinical Order Identifier (ID),BIGINT,,order.clinical_order.clinical_order_id,,,transactional_data,"Reference to the clinical order requiring prior authorization. Links to the order management system (Epic Orders, Beaker, Radiant, Willow).",
order,entry_management,order_authorization,cpt_code_id,cpt_code_id,Procedure Code Id (Foreign Key),BIGINT,,reference.cpt_code.cpt_code_id,,,transactional_data,"Foreign key linking to reference.cpt_code. Business justification: Prior authorization core workflow requires linking authorization decision to CPT master for coverage determination, medical policy application, appeals management, and authorization tracking. Critical",
order,entry_management,order_authorization,health_plan_id,health_plan_id,Health Plan Id (Foreign Key),BIGINT,,insurance.health_plan.health_plan_id,"dbx_restricted, dbx_pii",,transactional_data,"Foreign key linking to insurance.health_plan. Business justification: Authorization requirements and approval criteria are plan-specific, not just payer-level. Different plans under same payer have distinct benefit designs, authorization rules, and coverage policies. Re",
order,entry_management,order_authorization,icd_code_id,icd_code_id,Diagnosis Code Id (Foreign Key),BIGINT,,reference.icd_code.icd_code_id,,,transactional_data,"Foreign key linking to reference.icd_code. Business justification: Medical necessity validation for prior authorization requires ICD-10 linkage. Payers evaluate diagnosis against coverage policies and medical necessity criteria; essential for authorization decisions,",
order,entry_management,order_authorization,insurance_coverage_id,insurance_coverage_id,Insurance Coverage Id (Foreign Key),BIGINT,,patient.insurance_coverage.insurance_coverage_id,,,transactional_data,"Foreign key linking to patient.insurance_coverage. Business justification: Prior authorizations are obtained for specific insurance coverage policies; linking authorization to coverage enables tracking authorization utilization against benefit limits, appeals management by p",
order,entry_management,order_authorization,material_master_id,material_master_id,Material Master Id (Foreign Key),BIGINT,,supply.material_master.material_master_id,,,transactional_data,"Foreign key linking to supply.material_master. Business justification: Prior authorizations for high-cost devices (spinal implants, prosthetics, DME) require payer approval tied to specific catalog item. Authorization specifies approved device SKU, manufacturer, and cost",
order,entry_management,order_authorization,payer_id,payer_id,Payer Identifier (ID),BIGINT,,insurance.payer.payer_id,,,transactional_data,"Unique identifier for the payer organization, typically the payers National Payer ID or internal system identifier.",
order,entry_management,order_authorization,research_study_id,research_study_id,Research Study Id (Foreign Key),BIGINT,,research.research_study.research_study_id,,,transactional_data,"Foreign key linking to research.research_study. Business justification: Research-related procedures often require special authorization tied to study protocol and IRB approval. Linking authorization to study supports protocol compliance verification, research billing vali",
order,entry_management,order_authorization,approved_quantity,approved_quantity,Approved Service Quantity,"DECIMAL(10,2)",,,,,transactional_data,"Quantity of services, visits, units, or procedures approved by the payer. May represent number of visits, units of service, or treatment sessions.",
order,entry_management,order_authorization,approved_quantity_unit,approved_quantity_unit,Approved Quantity Unit of Measure,STRING,,,,visits|units|sessions|days|procedures|treatments,transactional_data,"Unit of measure for the approved quantity (e.g., visits, units, sessions, days).",
order,entry_management,order_authorization,authorization_number,authorization_number,Payer Authorization Number,STRING,,,,,transactional_data,Unique authorization number assigned by the payer for tracking and reference. Also known as prior authorization number or pre-certification number.,
order,entry_management,order_authorization,authorization_status,authorization_status,Authorization Decision Status,STRING,,,,,transactional_data,Current status of the authorization request reflecting the payers decision and lifecycle state. [ENUM-REF-CANDIDATE: approved|denied|pending|partial|expired|cancelled|appealed — 7 candidates stripped; promote to reference product],
order,entry_management,order_authorization,authorization_type,authorization_type,Authorization Type,STRING,,,,prior_authorization|concurrent_review|retrospective_review|pre_certification|referral_authorization,transactional_data,"Type or category of authorization request (e.g., prior authorization, concurrent review, retrospective review, pre-certification).",
order,entry_management,order_authorization,claim_appeal_decision_date,claim_appeal_decision_date,Appeal Decision Date,DATE,,,,,transactional_data,Date when the payer rendered a decision on the appeal.,
order,entry_management,order_authorization,claim_appeal_filed_date,claim_appeal_filed_date,Appeal Filed Date,DATE,,,,,transactional_data,Date when an appeal was filed with the payer for a denied or partially approved authorization.,
order,entry_management,order_authorization,claim_appeal_status,claim_appeal_status,Authorization Appeal Status,STRING,,,,not_appealed|appeal_pending|appeal_approved|appeal_denied|appeal_withdrawn,transactional_data,Status of any appeal filed against a denial or partial approval decision.,
order,entry_management,order_authorization,claim_denial_reason_code,claim_denial_reason_code,Authorization Denial Reason Code,STRING,,,,,transactional_data,Standardized code indicating the reason for denial or partial approval. Typically uses payer-specific or industry-standard denial reason codes.,
order,entry_management,order_authorization,claim_denial_reason_description,claim_denial_reason_description,Authorization Denial Reason Description,STRING,,,,,transactional_data,Detailed textual explanation of the denial or partial approval reason provided by the payer.,
order,entry_management,order_authorization,clinical_notes,clinical_notes,Authorization Clinical Notes,STRING,,,dbx_confidential,,transactional_data,Free-text clinical notes or justification provided to support the authorization request.,
order,entry_management,order_authorization,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,transactional_data,Timestamp when this authorization record was first created in the system. Audit trail for data lineage.,
order,entry_management,order_authorization,decision_datetime,decision_datetime,Authorization Decision Date and Time,TIMESTAMP,,,,,transactional_data,"Date and time when the payer rendered the authorization decision (approved, denied, or partial).",
order,entry_management,order_authorization,effective_date,effective_date,Authorization Effective Date,DATE,,,,,transactional_data,Date when the authorization becomes effective and services may begin. Start of the authorization validity period.,
order,entry_management,order_authorization,expiration_date,expiration_date,Authorization Expiration Date,DATE,,,,,transactional_data,Date when the authorization expires and is no longer valid. End of the authorization validity period.,
order,entry_management,order_authorization,facility_service_category,facility_service_category,Service Category,STRING,,,,,transactional_data,"High-level category of the clinical service requiring authorization (e.g., inpatient, outpatient, lab, radiology, pharmacy, DME). [ENUM-REF-CANDIDATE: inpatient|outpatient|laboratory|radiology|pharmacy|dme|home_health|skilled_nursing — 8 candidates stripped; promote to reference product]",
order,entry_management,order_authorization,patient_mrn,patient_mrn,Patient Medical Record Number (MRN),STRING,,,"dbx_restricted, dbx_pii_identifier",,transactional_data,Medical Record Number of the patient for whom the authorization is requested. Directly identifies an individual patient.,
order,entry_management,order_authorization,peer_to_peer_conducted,peer_to_peer_conducted,Peer-to-Peer Review Conducted Flag,BOOLEAN,,,,,transactional_data,Indicates whether a peer-to-peer clinical review was conducted between the requesting provider and payer medical director.,
order,entry_management,order_authorization,peer_to_peer_date,peer_to_peer_date,Peer-to-Peer Review Date,DATE,,,,,transactional_data,Date when the peer-to-peer clinical review was conducted.,
order,entry_management,order_authorization,priority,priority,Authorization Request Priority,STRING,,,,routine|urgent|stat|emergent,transactional_data,"Priority level of the authorization request indicating urgency (e.g., routine, urgent, stat, emergent).",
order,entry_management,order_authorization,request_datetime,request_datetime,Authorization Request Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when the prior authorization request was submitted to the payer. Represents the principal business event timestamp for this transaction.,
order,entry_management,order_authorization,requested_quantity,requested_quantity,Requested Service Quantity,"DECIMAL(10,2)",,,,,transactional_data,"Quantity of services, visits, or units originally requested in the authorization submission.",
order,entry_management,order_authorization,requesting_provider_name,requesting_provider_name,Requesting Provider Name,STRING,,,,,transactional_data,Full name of the provider who submitted the authorization request.,
order,entry_management,order_authorization,requesting_provider_npi,requesting_provider_npi,Requesting Provider National Provider Identifier (NPI),STRING,,,,^[0-9]{10}$,transactional_data,National Provider Identifier (NPI) of the provider who requested the authorization.,
order,entry_management,order_authorization,reviewer_name,reviewer_name,Payer Reviewer Name,STRING,,,,,transactional_data,Name of the payer representative or medical reviewer who processed the authorization request.,
order,entry_management,order_authorization,servicing_facility_name,servicing_facility_name,Servicing Facility Name,STRING,,,,,transactional_data,Name of the facility where the authorized service will be performed.,
order,entry_management,order_authorization,servicing_provider_npi,servicing_provider_npi,Servicing Provider National Provider Identifier (NPI),STRING,,,,^[0-9]{10}$,transactional_data,National Provider Identifier (NPI) of the provider who will perform the authorized service.,
order,entry_management,order_authorization,source_system,source_system,Source System Name,STRING,,,,,transactional_data,"Name of the operational system from which this authorization record originated (e.g., Epic Resolute, Cerner Revenue Cycle, MEDITECH).",
order,entry_management,order_authorization,submission_method,submission_method,Authorization Submission Method,STRING,,,,electronic|fax|phone|portal|mail,transactional_data,"Method used to submit the authorization request to the payer (e.g., electronic, fax, phone, portal).",
order,entry_management,order_authorization,turnaround_time_hours,turnaround_time_hours,Authorization Turnaround Time in Hours,"DECIMAL(8,2)",,,,,transactional_data,Elapsed time in hours between authorization request submission and payer decision. Used for performance monitoring and SLA tracking.,
order,entry_management,order_authorization,updated_timestamp,updated_timestamp,Record Updated Timestamp,TIMESTAMP,,,,,transactional_data,Timestamp when this authorization record was last modified. Audit trail for data lineage and change tracking.,
order,entry_management,order_status_history,order_status_history_id,order_status_history_id,Order Status History ID,BIGINT,Y,,,,transactional_data,"pii_phi,pii_pii,pii_sensitive",
order,entry_management,order_status_history,clinical_order_id,clinical_order_id,Order ID,BIGINT,,order.clinical_order.clinical_order_id,,,transactional_data,Reference to the parent clinical order whose lifecycle event is being recorded. Links this history record to the originating order in the order management system (Epic Orders / Cerner Millennium).,
order,entry_management,order_status_history,cpoe_alert_id,cpoe_alert_id,Clinical Decision Support (CDS) Alert ID,BIGINT,,order.cpoe_alert.cpoe_alert_id,,,transactional_data,"Identifier of the Clinical Decision Support (CDS) alert (drug-drug interaction, allergy, dosing alert, duplicate order) that was triggered and may have prompted this lifecycle event. Null if no CDS alert was associated. Supports CDS effectiveness analysis and alert fatigue reporting.",
order,entry_management,order_status_history,demographics_id,demographics_id,Patient ID,BIGINT,,patient.demographics.demographics_id,"dbx_restricted, dbx_pii_health",,transactional_data,Reference to the patient associated with the clinical order. Required for HIPAA audit compliance and PHI traceability across all order lifecycle events.,
order,entry_management,order_status_history,employee_id,employee_id,Modifying User ID,BIGINT,,workforce.employee.employee_id,"dbx_confidential, dbx_pii",,transactional_data,order_status_history_employee_id,
order,entry_management,order_status_history,order_set_id,order_set_id,Order Set ID,BIGINT,,order.order_order_set.order_set_id,,,transactional_data,"Identifier of the clinical order set or protocol from which the parent order was generated, if applicable. Supports analysis of order set adherence and protocol-driven order modification patterns.",
order,entry_management,order_status_history,org_unit_id,org_unit_id,Receiving Department ID,BIGINT,,workforce.org_unit.org_unit_id,,,transactional_data,"Reference to the clinical department or fulfillment unit (lab, pharmacy, radiology, nursing unit) that received this order event for execution. Supports departmental workload analysis and order routing audit.",
order,entry_management,order_status_history,primary_order_clinician_id,primary_order_clinician_id,Ordering Provider ID,BIGINT,,provider.clinician.clinician_id,,,transactional_data,Reference to the clinician who originally placed the order. Used for accountability tracking and CPOE audit trails.,
order,entry_management,order_status_history,primary_order_message_log_id,primary_order_message_log_id,Health Level Seven (HL7) Message ID,BIGINT,,interoperability.message_log.message_log_id,,,transactional_data,The HL7 message control ID (MSH-10) of the HL7 v2 or FHIR message that triggered or communicated this order lifecycle event. Supports interoperability audit trails and Health Information Exchange (HIE) reconciliation.,
order,entry_management,order_status_history,source_system_event_message_log_id,source_system_event_message_log_id,Source System Event ID,BIGINT,,interoperability.message_log.message_log_id,,,transactional_data,"The native event or audit record identifier from the originating operational system (Epic, Cerner, etc.). Enables bidirectional traceability between the lakehouse silver layer and the source EHR audit log for reconciliation and dispute resolution.",
order,entry_management,order_status_history,visit_id,visit_id,Encounter ID,BIGINT,,encounter.visit.visit_id,,,transactional_data,"Reference to the clinical encounter (visit, admission, or ED episode) during which this order lifecycle event occurred. Supports encounter-level order audit and CDI review.",
order,entry_management,order_status_history,cds_alert_overridden,cds_alert_overridden,Clinical Decision Support (CDS) Alert Overridden Flag,BOOLEAN,,,,,transactional_data,Indicates whether a Clinical Decision Support (CDS) alert was overridden by the provider when this event was triggered. True = alert was acknowledged and overridden; False = alert was not overridden or no alert was present. Critical for patient safety audit and alert override rate reporting.,
order,entry_management,order_status_history,consent_event_sequence_number,consent_event_sequence_number,Event Sequence Number,INT,,,,,transactional_data,Monotonically increasing sequence number for all lifecycle events belonging to the same parent order. Enables chronological ordering of events within an orders history and detection of out-of-order event delivery from source systems.,
order,entry_management,order_status_history,consent_event_timestamp,consent_event_timestamp,Event Timestamp,TIMESTAMP,,,,,transactional_data,"The precise date and time (with timezone offset) at which this lifecycle event occurred in the clinical system. This is the authoritative real-world event time, distinct from record audit timestamps. Stored in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).",
order,entry_management,order_status_history,consent_event_type,consent_event_type,Order Event Type,STRING,,,,,transactional_data,Discriminator classifying the kind of lifecycle event recorded. STATUS_CHANGE = workflow state transition; MODIFICATION = dose/frequency/route/priority change; AMENDMENT = clinical content update; CORRECTION = error correction; RENEWAL = order re-authorization; DISCONTINUATION = order stopped; COSIGN_REQUEST = co-signature required; COSIGN_COMPLETED = co-signature fulfilled. [ENUM-REF-CANDIDATE: STATUS_CHANGE|MODIFICATION|AMENDMENT|CORRECTION|RENEWAL|DISCONTINUATION|COSIGN_REQUEST|COSIGN_COMPLETED — promote to reference product],
order,entry_management,order_status_history,cosignature_required,cosignature_required,Co-Signature Required Flag,BOOLEAN,,,,,transactional_data,Indicates whether this order modification or event requires a co-signature from a supervising or authorizing provider before the change takes effect. Applies to resident/trainee orders and controlled substance modifications per institutional policy.,
order,entry_management,order_status_history,cosignature_timestamp,cosignature_timestamp,Co-Signature Timestamp,TIMESTAMP,,,,,transactional_data,The date and time at which the required co-signature was completed by the supervising provider. Null if co-signature has not yet been obtained. Used to measure co-signature turnaround time for compliance reporting.,
order,entry_management,order_status_history,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,transactional_data,"The date and time at which this history record was first written to the lakehouse silver layer. Represents the ETL ingestion time, distinct from event_timestamp (the real-world clinical event time). Used for data pipeline monitoring and late-arrival detection.",
order,entry_management,order_status_history,dea_schedule,dea_schedule,Drug Enforcement Administration (DEA) Schedule,STRING,,,,CI|CII|CIII|CIV|CV,transactional_data,The DEA controlled substance schedule (CI through CV) applicable to the medication order at the time of this event. Populated only when is_controlled_substance is True. Determines regulatory handling requirements.,
order,entry_management,order_status_history,discontinuation_type,discontinuation_type,Discontinuation Type,STRING,,,,,transactional_data,"Classifies the reason category for order discontinuation when event_type is DISCONTINUATION. AMA = Against Medical Advice. Supports medication reconciliation, discharge planning, and quality reporting. [ENUM-REF-CANDIDATE: COMPLETED|PROVIDER_DISCONTINUED|PATIENT_REFUSED|AMA|FORMULARY|DUPLICATE|PROTOCOL — promote to reference product]",
order,entry_management,order_status_history,effective_datetime,effective_datetime,Order Event Effective Datetime,TIMESTAMP,,,,,transactional_data,"The date and time at which this lifecycle event becomes clinically effective (e.g., when a renewed order becomes active, when a hold is lifted). May differ from event_timestamp when events are scheduled or backdated. Supports medication administration record (MAR) reconciliation.",
order,entry_management,order_status_history,hipaa_audit_category,hipaa_audit_category,Health Insurance Portability and Accountability Act (HIPAA) Audit Category,STRING,,,,ACCESS|MODIFICATION|DISCLOSURE|CORRECTION|DELETION,transactional_data,"HIPAA-defined audit event category for this order lifecycle event, used for compliance reporting to OCR and internal privacy audits. Classifies the event as an access, modification, disclosure, correction, or deletion of PHI per HIPAA Security Rule requirements.",
order,entry_management,order_status_history,is_amendment,is_amendment,Amendment Flag,BOOLEAN,,,,,transactional_data,Indicates whether this event represents a formal clinical amendment to the order record (as opposed to a routine status change or system-generated update). True = formal amendment requiring clinical documentation. Supports HIM and CDI amendment tracking.,
order,entry_management,order_status_history,is_controlled_substance,is_controlled_substance,Controlled Substance Flag,BOOLEAN,,,,,transactional_data,Indicates whether the order subject to this lifecycle event involves a DEA-scheduled controlled substance. True = controlled substance order. Triggers enhanced audit requirements and DEA compliance tracking.,
order,entry_management,order_status_history,is_verbal_order,is_verbal_order,Verbal Order Flag,BOOLEAN,,,,,transactional_data,Indicates whether this order event was initiated as a verbal or telephone order requiring subsequent written authentication. True = verbal/telephone order; False = directly entered CPOE order. Tracked for Joint Commission verbal order compliance.,
order,entry_management,order_status_history,modified_field_name,modified_field_name,Modified Field Name,STRING,,,,,transactional_data,"The name of the specific clinical order field that was changed during a MODIFICATION, AMENDMENT, or CORRECTION event (e.g., dose, frequency, route, quantity, priority, start_date, stop_date, indication). Null for pure status transitions.",
order,entry_management,order_status_history,modifying_provider_npi,modifying_provider_npi,Modifying Provider National Provider Identifier (NPI),STRING,,,,^[0-9]{10}$,transactional_data,"The 10-digit National Provider Identifier (NPI) of the licensed provider who triggered this event, when the modifying user is a credentialed clinician. Denormalized from the provider record to preserve the NPI value at the time of the event for regulatory audit purposes. Required for CMS and OIG compliance reporting.",
order,entry_management,order_status_history,modifying_user_role,modifying_user_role,Modifying User Role,STRING,,,,,transactional_data,"The clinical or operational role of the user who triggered this lifecycle event at the time of the event. Supports role-based audit analysis and compliance review (e.g., identifying unauthorized order modifications). [ENUM-REF-CANDIDATE: PHYSICIAN|NURSE|PHARMACIST|RESIDENT|SYSTEM|ADMIN|TECHNICIAN — 7 candidates stripped; promote to reference product]",
order,entry_management,order_status_history,new_status,new_status,New Order Status,STRING,,,,,transactional_data,"The order workflow status immediately after this lifecycle event. Together with previous_status, defines the state transition that occurred. [ENUM-REF-CANDIDATE: DRAFT|PENDING|ACTIVE|HOLD|SUSPENDED|COMPLETED|DISCONTINUED|CANCELLED|EXPIRED|ERROR — promote to reference product]",
order,entry_management,order_status_history,new_value,new_value,New Field Value,"DECIMAL(18,2)",,,"dbx_restricted, dbx_pii_health",,transactional_data,The value of the modified clinical field immediately after this modification event. Paired with previous_value to form a complete before/after audit record. Contains PHI when the field relates to medication or clinical details.,
order,entry_management,order_status_history,order_number,order_number,Order Number,STRING,,,,,transactional_data,"The human-readable, externally visible order identifier (e.g., Epic order number, Cerner accession number) at the time of this event. Denormalized from the order header to support direct lookup in audit reports without joining to the order table.",
order,entry_management,order_status_history,order_priority,order_priority,Order Priority,STRING,,,,ROUTINE|URGENT|STAT|ASAP,transactional_data,"The priority level of the order at the time of this event. Captures the priority as it existed at this point in the lifecycle, enabling detection of priority escalations or de-escalations over time.",
order,entry_management,order_status_history,order_type,order_type,Order Type,STRING,,,,,transactional_data,Classification of the clinical order category at the time of this event. Determines routing to downstream fulfillment systems: LAB → Beaker/LIS; RADIOLOGY → Radiant/RIS; PHARMACY → Willow; REFERRAL → Cadence. Denormalized here to support event-level analytics without joining back to the order header. [ENUM-REF-CANDIDATE: LAB|RADIOLOGY|PHARMACY|REFERRAL|PROCEDURE|NURSING|DIET|CONSULT — 8 candidates stripped; promote to reference product],
order,entry_management,order_status_history,override_reason,override_reason,CDS Alert Override Reason,STRING,,,"dbx_restricted, dbx_pii_health",,transactional_data,The structured or free-text reason provided by the provider when overriding a Clinical Decision Support (CDS) alert associated with this order event. Populated only when cds_alert_overridden is True. Supports patient safety review and quality improvement programs.,
order,entry_management,order_status_history,previous_status,previous_status,Previous Order Status,STRING,,,,,transactional_data,The order workflow status immediately before this lifecycle event. Enables reconstruction of the full state machine history and supports CDI review and medication reconciliation. [ENUM-REF-CANDIDATE: DRAFT|PENDING|ACTIVE|HOLD|SUSPENDED|COMPLETED|DISCONTINUED|CANCELLED|EXPIRED|ERROR — promote to reference product],
order,entry_management,order_status_history,previous_value,previous_value,Previous Field Value,"DECIMAL(18,2)",,,"dbx_restricted, dbx_pii_health",,transactional_data,"The value of the modified clinical field (dose, frequency, route, priority, quantity, etc.) immediately before this modification event. Stored as a string to accommodate heterogeneous field types across order categories. Populated only for MODIFICATION, AMENDMENT, and CORRECTION event types. Contains PHI when the field relates to medication or clinical details.",
order,entry_management,order_status_history,reason_code,reason_code,Event Reason Code,STRING,,,,,transactional_data,"Structured reason code explaining why this lifecycle event occurred (e.g., CLINICAL_CHANGE, PATIENT_REQUEST, PROVIDER_CORRECTION, DUPLICATE_ORDER, ALLERGY_ALERT, DRUG_INTERACTION, FORMULARY_SUBSTITUTION, PROTOCOL_CHANGE). Sourced from the EHR reason code catalog. Supports CDI and quality review workflows.",
order,entry_management,order_status_history,reason_text,reason_text,Event Reason Free Text,STRING,,,"dbx_restricted, dbx_pii_health",,transactional_data,Free-text clinical justification or narrative explanation provided by the user or system for this lifecycle event. Supplements the structured reason_code with provider-authored context. May contain PHI when clinical rationale references patient-specific information.,
order,entry_management,order_status_history,renewal_sequence_number,renewal_sequence_number,Renewal Sequence Number,INT,,,,,transactional_data,Sequential counter indicating which renewal iteration this event represents for the parent order. Starts at 1 for the first renewal. Null for non-renewal events. Supports chronic medication management and long-term order tracking.,
order,entry_management,order_status_history,source_system,source_system,Source System,STRING,,,,,transactional_data,"The operational system of record that generated this lifecycle event. Identifies the originating EHR module for data lineage and reconciliation purposes (e.g., EPIC_ORDERS for physician CPOE, WILLOW for pharmacy verification, BEAKER for lab order processing, RADIANT for radiology order management). [ENUM-REF-CANDIDATE: EPIC_ORDERS|CERNER_POWERCHARTS|WILLOW|BEAKER|RADIANT|MEDITECH|MANUAL — 7 candidates stripped; promote to reference product]",
order,entry_management,order_status_history,transmission_datetime,transmission_datetime,Order Transmission Datetime,TIMESTAMP,,,,,transactional_data,"The date and time at which this order event was transmitted to the downstream fulfillment system (Beaker, Radiant, Willow, etc.). Null if transmission is not required or has not yet occurred.",
order,entry_management,order_status_history,transmission_status,transmission_status,Order Transmission Status,STRING,,,,SENT|PENDING|FAILED|ACKNOWLEDGED|NOT_REQUIRED,transactional_data,"Status of the order transmission to the downstream fulfillment system (pharmacy, lab, radiology) following this lifecycle event. Tracks whether the event was successfully communicated to the executing department.",
order,entry_management,order_status_history,updated_timestamp,updated_timestamp,Record Updated Timestamp,TIMESTAMP,,,,,transactional_data,"The date and time at which this history record was last updated in the lakehouse silver layer. Although the event log is intended to be immutable, this field captures any correction or reprocessing events applied to the record for data quality purposes.",
order,entry_management,order_status_history,verbal_order_authentication_datetime,verbal_order_authentication_datetime,Verbal Order Authentication Datetime,TIMESTAMP,,,,,transactional_data,The date and time at which a verbal or telephone order was authenticated (signed) by the ordering provider. Null for non-verbal orders. Must occur within the timeframe required by Joint Commission standards (typically 24-48 hours).,
order,entry_management,order_status_history,workstation_code,workstation_code,Workstation ID,STRING,,,,,transactional_data,"Identifier of the clinical workstation, device, or terminal from which this order lifecycle event was initiated. Supports HIPAA access audit trails and security incident investigation.",
order,entry_management,reconciliation,reconciliation_id,reconciliation_id,Order Reconciliation ID,BIGINT,Y,,,,transactional_data,"pii_phi,pii_pii,pii_sensitive",
