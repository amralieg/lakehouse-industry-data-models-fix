ind:paymentModel rdf:type rdf:Property ;
    rdfs:label 'Payment Model' ;
    rdfs:comment 'Payment model used for the plan.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isExemptFromMlr rdf:type rdf:Property ;
    rdfs:label 'Is Exempt From Mlr' ;
    rdfs:comment 'Indicates if the plan is exempt from MLR requirements.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduleId rdf:type rdf:Property ;
    rdfs:label 'Schedule Id' ;
    rdfs:comment 'Unique system-generated identifier for each provider schedule record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumSchedule .

ind:date rdf:type rdf:Property ;
    rdfs:label 'Date' ;
    rdfs:comment 'Calendar date for which the schedule applies.' ;
    rdfs:domain ind:UnitedHealthCare ;
