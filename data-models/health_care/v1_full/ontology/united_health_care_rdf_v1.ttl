    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveragePercentage rdf:type rdf:Property ;
    rdfs:label 'Coverage Percentage' ;
    rdfs:comment 'The percentage of the allowed amount that the plan covers (inverse of coinsurance percentage). For example, 80% means the plan pays 80%.' ;
