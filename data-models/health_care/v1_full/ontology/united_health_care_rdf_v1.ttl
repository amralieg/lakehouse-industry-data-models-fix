ind:snpType rdf:type rdf:Property ;
    rdfs:label 'Snp Type' ;
    rdfs:comment 'The type of Special Needs Plan (SNP): Dual Eligible Special Needs Plan (D-SNP), Chronic Condition Special Needs Plan (C-SNP), or Institutional Special Needs Plan (I-SNP).' ;
    rdfs:domain ind:UnitedHealthCare ;
