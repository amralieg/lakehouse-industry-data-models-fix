ind:packageName rdf:type rdf:Property ;
    rdfs:label 'Package Name' ;
    rdfs:comment 'Marketing or business name of the benefit package displayed to members and providers.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageDescription rdf:type rdf:Property ;
    rdfs:label 'Package Description' ;
    rdfs:comment 'Detailed narrative description of the benefit package including covered services, limitations, and key features.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productCategory rdf:type rdf:Property ;
    rdfs:label 'Product Category' ;
    rdfs:comment 'High-level categorization of the benefit package by service type. LTSS (Long Term Services and Supports).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metalTier rdf:type rdf:Property ;
    rdfs:label 'Metal Tier' ;
    rdfs:comment 'ACA (Affordable Care Act) marketplace metal tier classification representing actuarial value and cost-sharing level.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialValuePercentage rdf:type rdf:Property ;
    rdfs:label 'Actuarial Value Percentage' ;
    rdfs:comment 'Percentage of total average costs for covered benefits that the plan pays, used for ACA (Affordable Care Act) metal tier classification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:networkTier rdf:type rdf:Property ;
    rdfs:label 'Network Tier' ;
    rdfs:comment 'Tiered network classification determining cost-sharing levels based on provider participation and performance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hsaEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Hsa Eligible Flag' ;
    rdfs:comment 'Indicator whether the benefit package qualifies for HSA (Health Savings Account) contributions under IRS regulations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hraEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Hra Eligible Flag' ;
    rdfs:comment 'Indicator whether the benefit package supports HRA (Health Reimbursement Arrangement) funding by employers.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fsaEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Fsa Eligible Flag' ;
    rdfs:comment 'Indicator whether the benefit package allows FSA (Flexible Spending Account) participation for healthcare expenses.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deductibleIndividualAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Individual Amount' ;
    rdfs:comment 'Annual deductible amount that an individual member must pay before the plan begins cost-sharing for covered services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleFamilyAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Family Amount' ;
    rdfs:comment 'Annual deductible amount that a family must collectively pay before the plan begins cost-sharing for covered services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleEmbeddedFlag rdf:type rdf:Property ;
    rdfs:label 'Deductible Embedded Flag' ;
    rdfs:comment 'Indicator whether individual deductibles are embedded within the family deductible, allowing individual members to reach their deductible independently.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfPocketMaxIndividualAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Max Individual Amount' ;
    rdfs:comment 'Maximum annual amount an individual member pays for covered services before the plan pays 100% of covered expenses. OOP (Out of Pocket).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfPocketMaxFamilyAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Max Family Amount' ;
    rdfs:comment 'Maximum annual amount a family collectively pays for covered services before the plan pays 100% of covered expenses. OOP (Out of Pocket).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayPrimaryCareAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Primary Care Amount' ;
    rdfs:comment 'Fixed dollar amount the member pays for a primary care physician office visit. PCP (Primary Care Physician).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copaySpecialistAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Specialist Amount' ;
    rdfs:comment 'Fixed dollar amount the member pays for a specialist physician office visit.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayEmergencyRoomAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Emergency Room Amount' ;
    rdfs:comment 'Fixed dollar amount the member pays for an emergency room visit. ER (Emergency Room).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayUrgentCareAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Urgent Care Amount' ;
    rdfs:comment 'Fixed dollar amount the member pays for an urgent care facility visit.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayInpatientHospitalAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Inpatient Hospital Amount' ;
    rdfs:comment 'Fixed dollar amount or per-day amount the member pays for inpatient hospital admission.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayOutpatientSurgeryAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Outpatient Surgery Amount' ;
    rdfs:comment 'Fixed dollar amount the member pays for outpatient surgical procedures.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacyBenefitIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Benefit Included Flag' ;
    rdfs:comment 'Indicator whether prescription drug coverage is included in this benefit package.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Deductible Amount' ;
    rdfs:comment 'Annual deductible amount specific to prescription drug coverage before cost-sharing begins.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacyTierStructure rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Tier Structure' ;
    rdfs:comment 'Number of cost-sharing tiers in the prescription drug formulary determining member copayments or coinsurance.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dentalBenefitIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Dental Benefit Included Flag' ;
    rdfs:comment 'Indicator whether dental coverage is included in this benefit package.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visionBenefitIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Vision Benefit Included Flag' ;
    rdfs:comment 'Indicator whether vision coverage is included in this benefit package.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthBenefitIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Benefit Included Flag' ;
    rdfs:comment 'Indicator whether mental health and substance use disorder services are included. BH (Behavioral Health).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveCareCoverageLevel rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Coverage Level' ;
    rdfs:comment 'Cost-sharing level for preventive services as defined by ACA (Affordable Care Act) and USPSTF (United States Preventive Services Task Force) guidelines.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maternityCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Maternity Coverage Flag' ;
    rdfs:comment 'Indicator whether maternity and newborn care services are covered as essential health benefits.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pediatricCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Pediatric Coverage Flag' ;
    rdfs:comment 'Indicator whether pediatric services including dental and vision are included as required by ACA (Affordable Care Act).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:durableMedicalEquipmentCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Durable Medical Equipment Coverage Flag' ;
    rdfs:comment 'Indicator whether durable medical equipment is covered under this benefit package. DME (Durable Medical Equipment).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:homeHealthCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Home Health Coverage Flag' ;
    rdfs:comment 'Indicator whether home health services are covered under this benefit package.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:skilledNursingFacilityCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Skilled Nursing Facility Coverage Flag' ;
    rdfs:comment 'Indicator whether skilled nursing facility services are covered. SNF (Skilled Nursing Facility).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospiceCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Hospice Coverage Flag' ;
    rdfs:comment 'Indicator whether hospice care services are covered under this benefit package.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rehabilitationServicesCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Rehabilitation Services Coverage Flag' ;
    rdfs:comment 'Indicator whether physical therapy, occupational therapy, and speech therapy services are covered.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chiropracticCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Chiropractic Coverage Flag' ;
    rdfs:comment 'Indicator whether chiropractic services are covered under this benefit package.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acupunctureCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Acupuncture Coverage Flag' ;
    rdfs:comment 'Indicator whether acupuncture services are covered under this benefit package.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Telehealth Coverage Flag' ;
    rdfs:comment 'Indicator whether telehealth and telemedicine services are covered with parity to in-person visits.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfNetworkCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Coverage Flag' ;
    rdfs:comment 'Indicator whether the benefit package provides any coverage for out-of-network providers.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfNetworkDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Deductible Amount' ;
    rdfs:comment 'Annual deductible amount for out-of-network services, typically higher than in-network deductible.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfNetworkCoinsurancePercentage rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Coinsurance Percentage' ;
    rdfs:comment 'Percentage of covered service costs the member pays for out-of-network services after meeting the deductible.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorAuthorizationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Required Flag' ;
    rdfs:comment 'Indicator whether certain services require prior authorization approval before coverage. PA (Prior Authorization).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Referral Required Flag' ;
    rdfs:comment 'Indicator whether members must obtain referrals from their PCP (Primary Care Physician) to see specialists.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifetimeMaximumAmount rdf:type rdf:Property ;
    rdfs:label 'Lifetime Maximum Amount' ;
    rdfs:comment 'Maximum dollar amount the plan will pay over the member\'s lifetime. Note: ACA (Affordable Care Act) prohibits lifetime limits on essential health benefits.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualMaximumAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Maximum Amount' ;
    rdfs:comment 'Maximum dollar amount the plan will pay in a single plan year. Note: ACA (Affordable Care Act) prohibits annual limits on essential health benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openEnrollmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Open Enrollment Start Date' ;
    rdfs:comment 'Beginning date of the annual period when members can enroll or change benefit packages without qualifying events.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grandfatheredPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Grandfathered Plan Flag' ;
    rdfs:comment 'Indicator whether the benefit package is grandfathered under ACA (Affordable Care Act), exempting it from certain ACA requirements.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualifiedHealthPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Qualified Health Plan Flag' ;
    rdfs:comment 'Indicator whether the benefit package is certified as a QHP (Qualified Health Plan) for ACA (Affordable Care Act) marketplace sale.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketplaceType rdf:type rdf:Property ;
    rdfs:label 'Marketplace Type' ;
    rdfs:comment 'Type of ACA (Affordable Care Act) health insurance marketplace where the plan is offered. FFM (Federally Facilitated Marketplace), SBM (State Based Marketplace).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costSharingReductionEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Reduction Eligible Flag' ;
    rdfs:comment 'Indicator whether the benefit package is eligible for ACA (Affordable Care Act) cost-sharing reductions for qualifying low-income members. CSR (Cost Sharing Reduction).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumTaxCreditEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Tax Credit Eligible Flag' ;
    rdfs:comment 'Indicator whether members enrolled in this benefit package are eligible for ACA (Affordable Care Act) premium tax credits. PTC (Premium Tax Credit).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumEssentialCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Minimum Essential Coverage Flag' ;
    rdfs:comment 'Indicator whether the benefit package meets ACA (Affordable Care Act) minimum essential coverage requirements. MEC (Minimum Essential Coverage).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumValueFlag rdf:type rdf:Property ;
    rdfs:label 'Minimum Value Flag' ;
    rdfs:comment 'Indicator whether the benefit package provides minimum value (60% actuarial value) as required by ACA (Affordable Care Act) employer mandate. MV (Minimum Value).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affordabilitySafeHarborMetFlag rdf:type rdf:Property ;
    rdfs:label 'Affordability Safe Harbor Met Flag' ;
    rdfs:comment 'Indicator whether the benefit package meets ACA (Affordable Care Act) employer affordability safe harbor thresholds.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraContinuationEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Cobra Continuation Eligible Flag' ;
    rdfs:comment 'Indicator whether the benefit package is subject to COBRA (Consolidated Omnibus Budget Reconciliation Act) continuation coverage requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaPortabilityCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Portability Compliant Flag' ;
    rdfs:comment 'Indicator whether the benefit package complies with HIPAA (Health Insurance Portability and Accountability Act) portability and creditable coverage requirements.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareSecondaryPayerFlag rdf:type rdf:Property ;
    rdfs:label 'Medicare Secondary Payer Flag' ;
    rdfs:comment 'Indicator whether the benefit package coordinates with Medicare as the secondary payer. MSP (Medicare Secondary Payer).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coordinationOfBenefitsMethod rdf:type rdf:Property ;
    rdfs:label 'Coordination Of Benefits Method' ;
    rdfs:comment 'Method used to coordinate benefits when a member has coverage under multiple plans. COB (Coordination of Benefits).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Rights Flag' ;
    rdfs:comment 'Indicator whether the plan retains subrogation rights to recover payments from third parties liable for member injuries.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalLossRatioTargetPercentage rdf:type rdf:Property ;
    rdfs:label 'Medical Loss Ratio Target Percentage' ;
    rdfs:comment 'Target percentage of premium revenue that must be spent on medical claims and quality improvement as required by ACA (Affordable Care Act). MLR (Medical Loss Ratio).' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskAdjustmentEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Eligible Flag' ;
    rdfs:comment 'Indicator whether the benefit package participates in CMS (Centers for Medicare and Medicaid Services) risk adjustment programs for payment calibration.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityRatingStars rdf:type rdf:Property ;
    rdfs:label 'Quality Rating Stars' ;
    rdfs:comment 'CMS (Centers for Medicare and Medicaid Services) star rating (1-5 scale) reflecting plan quality and performance on HEDIS (Healthcare Effectiveness Data and Information Set) and CAHPS (Consumer Assessment of Healthcare Providers and Systems) measures.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ncqaAccreditationStatus rdf:type rdf:Property ;
    rdfs:label 'Ncqa Accreditation Status' ;
    rdfs:comment 'Current accreditation status from NCQA (National Committee for Quality Assurance) indicating quality and compliance standards met.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uracAccreditationStatus rdf:type rdf:Property ;
    rdfs:label 'Urac Accreditation Status' ;
    rdfs:comment 'Current accreditation status from URAC (Utilization Review Accreditation Commission) for utilization management and quality standards.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateFilingNumber rdf:type rdf:Property ;
    rdfs:label 'State Filing Number' ;
    rdfs:comment 'Unique identifier assigned by the state insurance department for regulatory filing and approval of the benefit package.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsContractNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Contract Number' ;
    rdfs:comment 'Five-character contract identifier assigned by CMS (Centers for Medicare and Medicaid Services) for Medicare Advantage and Part D plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsPlanId rdf:type rdf:Property ;
    rdfs:label 'Cms Plan Id' ;
    rdfs:comment 'Three-digit plan identifier assigned by CMS (Centers for Medicare and Medicaid Services) within a contract for Medicare plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:hiosPlanId rdf:type rdf:Property ;
    rdfs:label 'Hios Plan Id' ;
    rdfs:comment '14-character standard plan identifier assigned by CMS (Centers for Medicare and Medicaid Services) for ACA (Affordable Care Act) marketplace plans. HIOS (Health Insurance Oversight System).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:serviceAreaDescription rdf:type rdf:Property ;
    rdfs:label 'Service Area Description' ;
    rdfs:comment 'Geographic description of counties, ZIP codes, or regions where the benefit package is available for enrollment.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageSupport rdf:type rdf:Property ;
    rdfs:label 'Language Support' ;
    rdfs:comment 'Languages in which member materials, customer service, and provider directories are available for this benefit package.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberServicesPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Member Services Phone Number' ;
    rdfs:comment 'Primary phone number for member inquiries, eligibility verification, and customer support for this benefit package.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerServicesPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Provider Services Phone Number' ;
    rdfs:comment 'Primary phone number for provider inquiries, eligibility verification, and claims support for this benefit package.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:summaryOfBenefitsUrl rdf:type rdf:Property ;
    rdfs:label 'Summary Of Benefits Url' ;
    rdfs:comment 'Web address where the standardized ACA (Affordable Care Act) Summary of Benefits and Coverage document is published. SBC (Summary of Benefits and Coverage).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formularyUrl rdf:type rdf:Property ;
    rdfs:label 'Formulary Url' ;
    rdfs:comment 'Web address where the current prescription drug formulary and covered medications list is published.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerDirectoryUrl rdf:type rdf:Property ;
    rdfs:label 'Provider Directory Url' ;
    rdfs:comment 'Web address where the searchable provider network directory is published for member and provider access.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transparencyInCoverageUrl rdf:type rdf:Property ;
    rdfs:label 'Transparency In Coverage Url' ;
    rdfs:comment 'Web address where machine-readable files containing negotiated rates and allowed amounts are published as required by federal transparency rules.' ;
    rdfs:domain ind:BenefitPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageId rdf:type rdf:Property ;
    rdfs:label 'Coverage Id' ;
    rdfs:comment 'Unique identifier for the member coverage record. Primary key for the coverage entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Coverage .

ind:productPlanId rdf:type rdf:Property ;
    rdfs:label 'Product Plan Id' ;
    rdfs:comment 'Unique identifier for the health plan associated with this coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductPlan .

ind:memberNumber rdf:type rdf:Property ;
    rdfs:label 'Member Number' ;
    rdfs:comment 'The member identification number printed on the member ID card. Used for eligibility verification and claims submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberNumber rdf:type rdf:Property ;
    rdfs:label 'Subscriber Number' ;
    rdfs:comment 'The subscriber identification number for the primary policyholder.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipToSubscriber rdf:type rdf:Property ;
    rdfs:label 'Relationship To Subscriber' ;
    rdfs:comment 'The relationship of the member to the primary subscriber (e.g., self, spouse, child, dependent).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lob rdf:type rdf:Property ;
    rdfs:label 'Lob' ;
    rdfs:comment 'The line of business category for this coverage (e.g., Commercial, Medicare, Medicaid, Marketplace).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tier rdf:type rdf:Property ;
    rdfs:label 'Tier' ;
    rdfs:comment 'The coverage tier indicating who is covered under the policy (e.g., employee only, employee + spouse, family).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Original Effective Date' ;
    rdfs:comment 'The original effective date of the member\'s first coverage with the organization, used for continuous coverage calculations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobraEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Effective Date' ;
    rdfs:comment 'The effective date of Consolidated Omnibus Budget Reconciliation Act (COBRA) continuation coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobraTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Termination Date' ;
    rdfs:comment 'The termination date of Consolidated Omnibus Budget Reconciliation Act (COBRA) continuation coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobIndicator rdf:type rdf:Property ;
    rdfs:label 'Cob Indicator' ;
    rdfs:comment 'Indicates whether Coordination of Benefits (COB) applies to this coverage due to other insurance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobOrder rdf:type rdf:Property ;
    rdfs:label 'Cob Order' ;
    rdfs:comment 'The order of this coverage in Coordination of Benefits (COB) processing (primary, secondary, tertiary).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcpNpi rdf:type rdf:Property ;
    rdfs:label 'Pcp Npi' ;
    rdfs:comment 'The National Provider Identifier (NPI) of the member\'s assigned Primary Care Physician (PCP).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcpEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Pcp Effective Date' ;
    rdfs:comment 'The date when the Primary Care Physician (PCP) assignment became effective.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pcpTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Pcp Termination Date' ;
    rdfs:comment 'The date when the Primary Care Physician (PCP) assignment ended.' ;
