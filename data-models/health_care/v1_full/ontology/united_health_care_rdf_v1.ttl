    rdfs:comment 'An alternate email address for the lead contact, providing additional communication options.' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:age rdf:type rdf:Property ;
    rdfs:label 'Age' ;
    rdfs:comment 'The calculated age of the prospective member at the time of lead capture, used for eligibility screening.' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualHouseholdIncome rdf:type rdf:Property ;
