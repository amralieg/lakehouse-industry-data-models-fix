    rdfs:comment 'Service level agreement target for care manager response time in hours when members initiate contact through this channel.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationChannel rdf:type rdf:Property ;
