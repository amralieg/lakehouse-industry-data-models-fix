ind:riskTier rdf:type rdf:Property ;
    rdfs:label 'Risk Tier' ;
    rdfs:comment 'Categorical classification of member risk level based on RAF score and clinical complexity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryDiagnosisCategory rdf:type rdf:Property ;
    rdfs:label 'Primary Diagnosis Category' ;
    rdfs:comment 'Primary disease category driving the member\'s risk score and care management needs.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comorbidityIndex rdf:type rdf:Property ;
    rdfs:label 'Comorbidity Index' ;
    rdfs:comment 'Calculated index measuring the burden of multiple chronic conditions affecting the member.' ;
