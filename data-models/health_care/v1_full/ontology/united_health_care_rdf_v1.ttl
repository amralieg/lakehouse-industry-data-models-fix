ind:thresholdMaximum rdf:type rdf:Property ;
    rdfs:label 'Threshold Maximum' ;
    rdfs:comment 'Maximum acceptable value above which performance may indicate inefficiency or other issues.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingLevel rdf:type rdf:Property ;
    rdfs:label 'Reporting Level' ;
    rdfs:comment 'Organizational level at which the metric is aggregated and reported.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableChannel rdf:type rdf:Property ;
    rdfs:label 'Applicable Channel' ;
    rdfs:comment 'Service channel(s) to which this metric applies.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiIndicator rdf:type rdf:Property ;
    rdfs:label 'Kpi Indicator' ;
    rdfs:comment 'Indicates whether this metric is designated as a Key Performance Indicator for executive reporting.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaMetricIndicator rdf:type rdf:Property ;
    rdfs:label 'Sla Metric Indicator' ;
    rdfs:comment 'Indicates whether this metric is part of contractual Service Level Agreement commitments.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Required Indicator' ;
    rdfs:comment 'Indicates whether tracking this metric is mandated by regulatory requirements.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trendDirectionPositive rdf:type rdf:Property ;
    rdfs:label 'Trend Direction Positive' ;
    rdfs:comment 'Indicates whether higher, lower, or stable values represent positive performance for this metric.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayFormat rdf:type rdf:Property ;
    rdfs:label 'Display Format' ;
    rdfs:comment 'Preferred format for displaying the metric value in reports and dashboards.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decimalPrecision rdf:type rdf:Property ;
    rdfs:label 'Decimal Precision' ;
    rdfs:comment 'Number of decimal places to display for the metric value.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aggregationMethod rdf:type rdf:Property ;
    rdfs:label 'Aggregation Method' ;
    rdfs:comment 'Statistical method used to aggregate individual metric values across time periods or organizational units.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightingFactor rdf:type rdf:Property ;
    rdfs:label 'Weighting Factor' ;
    rdfs:comment 'Relative weight assigned to this metric when calculating composite scores or balanced scorecards.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:relatedMetrics rdf:type rdf:Property ;
    rdfs:label 'Related Metrics' ;
    rdfs:comment 'List of related or complementary metrics that should be analyzed together.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityRules rdf:type rdf:Property ;
    rdfs:label 'Data Quality Rules' ;
    rdfs:comment 'Specific data quality validation rules that apply to this metric\'s source data.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertThresholdCritical rdf:type rdf:Property ;
    rdfs:label 'Alert Threshold Critical' ;
    rdfs:comment 'Metric value that triggers critical alerts requiring immediate attention.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alertThresholdWarning rdf:type rdf:Property ;
    rdfs:label 'Alert Threshold Warning' ;
    rdfs:comment 'Metric value that triggers warning alerts indicating potential performance issues.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingDashboard rdf:type rdf:Property ;
    rdfs:label 'Reporting Dashboard' ;
    rdfs:comment 'Name or identifier of the primary dashboard where this metric is displayed.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryStandardReference rdf:type rdf:Property ;
    rdfs:label 'Industry Standard Reference' ;
    rdfs:comment 'Reference to industry standards or best practices that define this metric.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRequirement rdf:type rdf:Property ;
    rdfs:label 'Compliance Requirement' ;
    rdfs:comment 'Specific regulatory or compliance requirement that mandates tracking this metric.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:historicalBaseline rdf:type rdf:Property ;
    rdfs:label 'Historical Baseline' ;
    rdfs:comment 'Historical average or baseline value used for trend analysis and performance comparison.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baselinePeriod rdf:type rdf:Property ;
    rdfs:label 'Baseline Period' ;
    rdfs:comment 'Time period used to establish the historical baseline value.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalityIndicator rdf:type rdf:Property ;
    rdfs:label 'Seasonality Indicator' ;
    rdfs:comment 'Indicates whether this metric exhibits seasonal patterns that should be considered in analysis.' ;
    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relatedClaimId rdf:type rdf:Property ;
    rdfs:label 'Related Claim Id' ;
    rdfs:comment 'Identifier of the healthcare claim referenced in the feedback, if the feedback pertains to a specific claim.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:isAnonymous rdf:type rdf:Property ;
    rdfs:label 'Is Anonymous' ;
    rdfs:comment 'Indicates whether the feedback was submitted anonymously without identifying information.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseText rdf:type rdf:Property ;
    rdfs:label 'Response Text' ;
    rdfs:comment 'The response or resolution notes provided by the customer service team addressing the feedback.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceReferenceId rdf:type rdf:Property ;
    rdfs:label 'Source Reference Id' ;
    rdfs:comment 'Unique identifier or reference number from the source system where the feedback originated.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyName rdf:type rdf:Property ;
    rdfs:label 'Survey Name' ;
    rdfs:comment 'Name or title of the survey campaign from which the feedback was collected.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionableFlag rdf:type rdf:Property ;
    rdfs:label 'Actionable Flag' ;
    rdfs:comment 'Indicates whether the feedback contains actionable insights that require operational or policy changes.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complimentFlag rdf:type rdf:Property ;
    rdfs:label 'Compliment Flag' ;
    rdfs:comment 'Indicates whether the feedback is a compliment or positive recognition of service quality.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complaintFlag rdf:type rdf:Property ;
    rdfs:label 'Complaint Flag' ;
    rdfs:comment 'Indicates whether the feedback is a formal complaint requiring investigation and response.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberSatisfactionPostResolution rdf:type rdf:Property ;
    rdfs:label 'Member Satisfaction Post Resolution' ;
    rdfs:comment 'Member satisfaction rating collected after the feedback was resolved, typically on a scale of 1 to 5.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewedByQaFlag rdf:type rdf:Property ;
    rdfs:label 'Reviewed By Qa Flag' ;
    rdfs:comment 'Indicates whether the feedback handling was reviewed by the quality assurance team.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qaReviewDate rdf:type rdf:Property ;
    rdfs:label 'Qa Review Date' ;
    rdfs:comment 'Date when the quality assurance review of the feedback handling was completed.' ;
    rdfs:domain ind:Feedback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sanctionTypeId rdf:type rdf:Property ;
    rdfs:label 'Sanction Type Id' ;
    rdfs:comment 'Unique identifier for the sanction type reference record.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SanctionType .

ind:authorityType rdf:type rdf:Property ;
    rdfs:label 'Authority Type' ;
    rdfs:comment 'Classification of the issuing authority by organizational type (federal agency, state agency, professional board, licensing board, law enforcement, court).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'Geographic or regulatory jurisdiction where this sanction type applies (e.g., United States, specific state abbreviation, or multi-state compact).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningSource rdf:type rdf:Property ;
    rdfs:label 'Screening Source' ;
    rdfs:comment 'Primary data source or database used to screen for this sanction type during credentialing (e.g., OIG LEIE, SAM.gov, NPDB, State Licensing Board Database).' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningFrequency rdf:type rdf:Property ;
    rdfs:label 'Screening Frequency' ;
    rdfs:comment 'Required frequency for screening providers against this sanction type (monthly, quarterly, annually, initial credentialing only, or continuous monitoring).' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandatoryScreeningFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Screening Flag' ;
    rdfs:comment 'Indicates whether screening for this sanction type is mandatory for provider credentialing and network participation (true) or optional/supplementary (false).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoDisqualificationFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Disqualification Flag' ;
    rdfs:comment 'Indicates whether a match on this sanction type results in automatic disqualification from network participation (true) or requires credentialing committee review (false).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:committeeReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Committee Review Required Flag' ;
    rdfs:comment 'Indicates whether a match on this sanction type requires review and decision by the credentialing committee (true) or can be processed administratively (false).' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkParticipationImpact rdf:type rdf:Property ;
    rdfs:label 'Network Participation Impact' ;
    rdfs:comment 'Standard impact of this sanction type on provider network participation status (disqualification, suspension, restriction, enhanced monitoring, or no impact).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateReportableFlag rdf:type rdf:Property ;
    rdfs:label 'State Reportable Flag' ;
    rdfs:comment 'Indicates whether this sanction type must be reported to state insurance departments or Medicaid agencies (true) or is not subject to state reporting requirements (false).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncqaRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Ncqa Requirement Flag' ;
    rdfs:comment 'Indicates whether screening for this sanction type is required for NCQA accreditation compliance (true) or is supplementary to NCQA standards (false).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uracRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Urac Requirement Flag' ;
    rdfs:comment 'Indicates whether screening for this sanction type is required for URAC accreditation compliance (true) or is supplementary to URAC standards (false).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionScope rdf:type rdf:Property ;
    rdfs:label 'Exclusion Scope' ;
    rdfs:comment 'Scope of exclusion or sanction applicability (all federal healthcare programs, Medicare and Medicaid only, state programs, specific program, or professional practice restrictions).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Allowed Flag' ;
    rdfs:comment 'Indicates whether providers with this sanction type can apply for reinstatement or network participation after remediation (true) or the sanction is permanent (false).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumExclusionPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Minimum Exclusion Period Months' ;
    rdfs:comment 'Minimum duration in months that this sanction type typically remains in effect before reinstatement can be considered (null if permanent or variable).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lookbackPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Years' ;
    rdfs:comment 'Number of years to review historical records for this sanction type during initial credentialing and re-credentialing (e.g., 5 years for criminal history, 10 years for malpractice).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primarySourceVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Source Verification Required Flag' ;
    rdfs:comment 'Indicates whether primary source verification is required for this sanction type (true) or secondary sources are acceptable (false).' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caqhDataElement rdf:type rdf:Property ;
    rdfs:label 'Caqh Data Element' ;
    rdfs:comment 'Corresponding CAQH ProView data element or field name that captures information related to this sanction type for credentialing data integration.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npdbReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Npdb Reportable Flag' ;
    rdfs:comment 'Indicates whether this sanction type is reportable to the National Practitioner Data Bank (true) or is not subject to NPDB reporting requirements (false).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipdbReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Hipdb Reportable Flag' ;
    rdfs:comment 'Indicates whether this sanction type is reportable to the Healthcare Integrity and Protection Data Bank (true) or is not subject to HIPDB reporting requirements (false). Note: HIPDB was integrated into NPDB in 2013.' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialtySpecificFlag rdf:type rdf:Property ;
    rdfs:label 'Specialty Specific Flag' ;
    rdfs:comment 'Indicates whether this sanction type applies only to specific medical specialties or professional disciplines (true) or applies broadly to all provider types (false).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealProcessAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Process Available Flag' ;
    rdfs:comment 'Indicates whether providers have the right to appeal credentialing decisions based on this sanction type (true) or decisions are final (false).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationRequirement rdf:type rdf:Property ;
    rdfs:label 'Notification Requirement' ;
    rdfs:comment 'Required timeframe for notifying relevant parties (provider, network operations, compliance, CMS) when this sanction type is identified (immediate, within 24 hours, within 5 days, within 30 days, or no specific requirement).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementSanctionTypeCode rdf:type rdf:Property ;
    rdfs:label 'Replacement Sanction Type Code' ;
    rdfs:comment 'Code of the sanction type that replaces this one if this type has been deprecated or consolidated (null if not replaced).' ;
    rdfs:domain ind:SanctionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalizationFields rdf:type rdf:Property ;
    rdfs:label 'Personalization Fields' ;
    rdfs:comment 'Comma-separated list of data fields used to personalize the communication content.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Included Flag' ;
    rdfs:comment 'Indicates whether the communication contains Protected Health Information.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessAssociateId rdf:type rdf:Property ;
    rdfs:label 'Business Associate Id' ;
    rdfs:comment 'Identifier of the third-party business associate that processed or sent the communication.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BusinessAssociate .

ind:responseRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Response Required Flag' ;
    rdfs:comment 'Indicates whether the communication requires a response or action from the recipient.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:urgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Urgency Flag' ;
    rdfs:comment 'Indicates whether the communication is marked as urgent requiring immediate attention.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readReceiptRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Read Receipt Requested Flag' ;
    rdfs:comment 'Indicates whether a read receipt was requested for this communication.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readReceiptReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Read Receipt Received Flag' ;
    rdfs:comment 'Indicates whether a read receipt was received from the recipient.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryConfirmationCode rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Code' ;
    rdfs:comment 'Confirmation code or tracking number provided by the delivery service for the communication.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threadId rdf:type rdf:Property ;
    rdfs:label 'Thread Id' ;
    rdfs:comment 'Identifier linking this communication to a conversation thread or series of related messages.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentCommunicationId rdf:type rdf:Property ;
    rdfs:label 'Parent Communication Id' ;
    rdfs:comment 'Identifier of the parent communication if this is a follow-up or reply message.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Communication .

ind:workLocation rdf:type rdf:Property ;
    rdfs:label 'Work Location' ;
    rdfs:comment 'Indicates whether the agent is scheduled to work from office, remotely, or in a hybrid arrangement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteCode rdf:type rdf:Property ;
    rdfs:label 'Site Code' ;
    rdfs:comment 'Code identifying the physical contact center site or location where the agent is scheduled to work.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteName rdf:type rdf:Property ;
    rdfs:label 'Site Name' ;
    rdfs:comment 'Name of the physical contact center site or location where the agent is scheduled to work.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryQueueId rdf:type rdf:Property ;
    rdfs:label 'Primary Queue Id' ;
    rdfs:comment 'Identifier for the primary service queue to which the agent is assigned during this shift.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Queue .

ind:primaryQueueName rdf:type rdf:Property ;
    rdfs:label 'Primary Queue Name' ;
    rdfs:comment 'Name of the primary service queue to which the agent is assigned (e.g., Member Inquiries, Claims Support, Provider Services).' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryQueueId rdf:type rdf:Property ;
    rdfs:label 'Secondary Queue Id' ;
    rdfs:comment 'Identifier for the secondary or backup service queue to which the agent may be assigned during this shift.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Queue .

ind:secondaryQueueName rdf:type rdf:Property ;
    rdfs:label 'Secondary Queue Name' ;
    rdfs:comment 'Name of the secondary or backup service queue to which the agent may be assigned.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:skillSet rdf:type rdf:Property ;
    rdfs:label 'Skill Set' ;
    rdfs:comment 'Comma-separated list of skills or competencies the agent possesses that determine queue assignment (e.g., Claims, Eligibility, Billing, Spanish).' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:break1StartTime rdf:type rdf:Property ;
    rdfs:label 'Break 1 Start Time' ;
    rdfs:comment 'Scheduled start time for the agent\'s first break period. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:break1EndTime rdf:type rdf:Property ;
    rdfs:label 'Break 1 End Time' ;
    rdfs:comment 'Scheduled end time for the agent\'s first break period. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:break1DurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Break 1 Duration Minutes' ;
    rdfs:comment 'Duration of the first break period in minutes.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:break1Type rdf:type rdf:Property ;
    rdfs:label 'Break 1 Type' ;
    rdfs:comment 'Classification of the first break as paid, unpaid, or meal break.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:break2StartTime rdf:type rdf:Property ;
    rdfs:label 'Break 2 Start Time' ;
    rdfs:comment 'Scheduled start time for the agent\'s second break period. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:break2EndTime rdf:type rdf:Property ;
    rdfs:label 'Break 2 End Time' ;
    rdfs:comment 'Scheduled end time for the agent\'s second break period. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:break2DurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Break 2 Duration Minutes' ;
    rdfs:comment 'Duration of the second break period in minutes.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:break2Type rdf:type rdf:Property ;
    rdfs:label 'Break 2 Type' ;
    rdfs:comment 'Classification of the second break as paid, unpaid, or meal break.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lunchStartTime rdf:type rdf:Property ;
    rdfs:label 'Lunch Start Time' ;
    rdfs:comment 'Scheduled start time for the agent\'s lunch break. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lunchEndTime rdf:type rdf:Property ;
    rdfs:label 'Lunch End Time' ;
    rdfs:comment 'Scheduled end time for the agent\'s lunch break. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lunchDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Lunch Duration Minutes' ;
    rdfs:comment 'Duration of the lunch break in minutes.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalBreakTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Total Break Time Minutes' ;
    rdfs:comment 'Total duration of all scheduled breaks including lunch in minutes.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:productiveTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Productive Time Minutes' ;
    rdfs:comment 'Total productive time available for handling customer interactions, calculated as shift duration minus break time.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overtimeEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Overtime Eligible Flag' ;
    rdfs:comment 'Indicates whether the agent is eligible for overtime compensation during this shift.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shiftDifferentialCode rdf:type rdf:Property ;
    rdfs:label 'Shift Differential Code' ;
    rdfs:comment 'Code indicating any shift differential pay applicable (e.g., night shift, weekend, holiday differential).' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedCallVolume rdf:type rdf:Property ;
    rdfs:label 'Expected Call Volume' ;
    rdfs:comment 'Forecasted number of calls expected to be handled by the agent during this shift based on workforce planning models.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expectedAhtSeconds rdf:type rdf:Property ;
    rdfs:label 'Expected Aht Seconds' ;
    rdfs:comment 'Expected average handle time per interaction in seconds based on historical performance and queue characteristics.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetOccupancyPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Occupancy Percentage' ;
    rdfs:comment 'Target percentage of productive time the agent should be actively handling customer interactions versus available time.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetUtilizationPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Utilization Percentage' ;
    rdfs:comment 'Target percentage of total shift time the agent should be in productive activities including calls, after-call work, and other work.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meetingPurpose rdf:type rdf:Property ;
    rdfs:label 'Meeting Purpose' ;
    rdfs:comment 'Description of the meeting purpose if this schedule is for meeting activities (e.g., team huddle, coaching session, town hall).' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:swapRequestId rdf:type rdf:Property ;
    rdfs:label 'Swap Request Id' ;
    rdfs:comment 'Identifier linking this schedule to a shift swap request if the schedule was created or modified as a result of an approved swap.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Request .

ind:timeOffRequestId rdf:type rdf:Property ;
    rdfs:label 'Time Off Request Id' ;
    rdfs:comment 'Identifier linking this schedule to a time-off request if the schedule was cancelled or modified due to approved time off.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Request .

ind:committeeReviewDate rdf:type rdf:Property ;
    rdfs:label 'Committee Review Date' ;
    rdfs:comment 'The date the credentialing committee reviewed and made a determination on the provider application.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:committeeDecision rdf:type rdf:Property ;
    rdfs:label 'Committee Decision' ;
    rdfs:comment 'The final decision rendered by the credentialing committee regarding the provider application.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateMedicaidExclusionStatus rdf:type rdf:Property ;
    rdfs:label 'State Medicaid Exclusion Status' ;
    rdfs:comment 'Result of the state Medicaid exclusion screening.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureQuestionsCompleteFlag rdf:type rdf:Property ;
    rdfs:label 'Disclosure Questions Complete Flag' ;
    rdfs:comment 'Indicates whether the provider has completed all required disclosure questions regarding malpractice history, sanctions, and criminal background.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adverseActionReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Adverse Action Reported Flag' ;
    rdfs:comment 'Indicates whether any adverse actions (license sanctions, malpractice judgments, hospital privilege restrictions) were reported or discovered during credentialing.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delegationOversightDate rdf:type rdf:Property ;
    rdfs:label 'Delegation Oversight Date' ;
    rdfs:comment 'The date when the health plan conducted oversight review of the delegated credentialing entity\'s work.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationCompletenessDate rdf:type rdf:Property ;
    rdfs:label 'Application Completeness Date' ;
    rdfs:comment 'The date when the credentialing application was deemed complete with all required documentation received.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expeditedReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Flag' ;
    rdfs:comment 'Indicates whether this credentialing application was processed through an expedited review process due to urgent network needs.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expeditedReviewJustification rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Justification' ;
    rdfs:comment 'Business justification for expediting the credentialing review process.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recredentialCycleNumber rdf:type rdf:Property ;
    rdfs:label 'Recredential Cycle Number' ;
    rdfs:comment 'Sequential number indicating which re-credentialing cycle this represents for the provider (1 for initial, 2 for first re-credential, etc.).' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:restrictionImposedFlag rdf:type rdf:Property ;
    rdfs:label 'Restriction Imposed Flag' ;
    rdfs:comment 'Indicates whether any restrictions or limitations were placed on the provider\'s participation in the network.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restrictionDescription rdf:type rdf:Property ;
    rdfs:label 'Restriction Description' ;
    rdfs:comment 'Detailed description of any restrictions or limitations imposed on the provider\'s network participation.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportableEventFlag rdf:type rdf:Property ;
    rdfs:label 'Reportable Event Flag' ;
    rdfs:comment 'Indicates whether the credentialing decision or termination constitutes a reportable event to the NPDB or state authorities.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceReviewScore rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Score' ;
    rdfs:comment 'Compliance score assigned during the credentialing review based on regulatory compliance, sanctions screening, and disclosure responses.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:verificationEventId rdf:type rdf:Property ;
    rdfs:label 'Verification Event Id' ;
    rdfs:comment 'Unique identifier for each primary source verification event performed during provider credentialing or re-credentialing process.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verificationSourceType rdf:type rdf:Property ;
    rdfs:label 'Verification Source Type' ;
    rdfs:comment 'Classification of the primary source entity providing verification data.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationResult rdf:type rdf:Property ;
    rdfs:label 'Verification Result' ;
    rdfs:comment 'Outcome of the verification event indicating whether the credential or information was successfully verified.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verification Timestamp' ;
    rdfs:comment 'Precise date and time when the verification event was completed or recorded in the system.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:verificationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Expiration Date' ;
    rdfs:comment 'Date when the verified credential or information expires and requires re-verification.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialNumber rdf:type rdf:Property ;
    rdfs:label 'Credential Number' ;
    rdfs:comment 'Unique identifier or number associated with the credential being verified (e.g., license number, board certification number, DEA number).' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialIssueDate rdf:type rdf:Property ;
    rdfs:label 'Credential Issue Date' ;
    rdfs:comment 'Date when the credential being verified was originally issued by the primary source.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Credential Expiration Date' ;
    rdfs:comment 'Date when the credential being verified expires according to the primary source.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialStatus rdf:type rdf:Property ;
    rdfs:label 'Credential Status' ;
    rdfs:comment 'Current status of the credential as reported by the primary source.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyBoardName rdf:type rdf:Property ;
    rdfs:label 'Specialty Board Name' ;
    rdfs:comment 'Name of the specialty board that issued board certification (e.g., American Board of Internal Medicine).' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionsScreeningDatabase rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screening Database' ;
    rdfs:comment 'Name of the sanctions or exclusions database queried during verification (e.g., OIG LEIE, SAM, NPDB).' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionsFound rdf:type rdf:Property ;
    rdfs:label 'Sanctions Found' ;
    rdfs:comment 'Indicates whether any sanctions, exclusions, or disciplinary actions were found during screening.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:educationalInstitutionName rdf:type rdf:Property ;
    rdfs:label 'Educational Institution Name' ;
    rdfs:comment 'Name of the medical school or educational institution that granted the provider\'s degree.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:degreeType rdf:type rdf:Property ;
    rdfs:label 'Degree Type' ;
    rdfs:comment 'Type of professional degree earned by the provider (e.g., MD, DO, DDS, PharmD).' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospitalAffiliationName rdf:type rdf:Property ;
    rdfs:label 'Hospital Affiliation Name' ;
    rdfs:comment 'Name of the hospital where the provider holds clinical privileges.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privilegesEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Privileges Effective Date' ;
    rdfs:comment 'Date when the provider\'s hospital privileges became effective.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:privilegesExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Privileges Expiration Date' ;
    rdfs:comment 'Date when the provider\'s hospital privileges expire.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peerReferenceName rdf:type rdf:Property ;
    rdfs:label 'Peer Reference Name' ;
    rdfs:comment 'Name of the peer professional who provided a reference for the provider during credentialing.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerReferenceContact rdf:type rdf:Property ;
    rdfs:label 'Peer Reference Contact' ;
    rdfs:comment 'Contact information for the peer reference (phone or email).' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerReferenceDate rdf:type rdf:Property ;
    rdfs:label 'Peer Reference Date' ;
    rdfs:comment 'Date when the peer reference was obtained or verified.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:workHistoryEmployerName rdf:type rdf:Property ;
    rdfs:label 'Work History Employer Name' ;
    rdfs:comment 'Name of the employer or practice where the provider previously worked, being verified as part of work history.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workHistoryStartDate rdf:type rdf:Property ;
    rdfs:label 'Work History Start Date' ;
    rdfs:comment 'Start date of the provider\'s employment at the verified employer.' ;
