  residual_rate_type varchar [note: 'Type of residual payment structure for this usage right (e.g., flat fee, percentage of revenue, per-use rate, tiered schedule, or none). | Column residual_rate_type (STRING) in talent.usage_right']
  right_type varchar [note: 'Type of usage right granted. [ENUM-REF-CANDIDATE: broadcast|streaming|vod|svod|avod|tvod|fast|home_video|theatrical|promotional|social_media|out_of_home — promote to reference product] | Column right_type (STRING) in talent.usage_right']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.usage_right']
  territory varchar [note: 'Geographic territory where the usage right is valid (e.g., USA, CAN, GBR, worldwide). | Column territory (STRING) in talent.usage_right']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.usage_right']
  updated_timestamp timestamp [note: 'Timestamp when this usage right record was last updated in the system. | Column updated_timestamp (TIMESTAMP) in talent.usage_right']
  usage_limit_type varchar [note: 'Type of usage limitation applied to this right (e.g., unlimited, limited by number of runs, time duration, impressions, or revenue cap). | Column usage_limit_type (STRING) in talent.usage_right']
  usage_limit_unit varchar [note: 'Unit of measure for the usage limit value (e.g., runs, days, impressions, currency code). Null if unlimited. | Column usage_limit_unit (STRING) in talent.usage_right']
  usage_limit_value decimal(18,2) [note: 'Numeric value of the usage limit (e.g., 10 runs, 365 days, 1000000 impressions, 50000 USD revenue cap). Null if unlimited. | Column usage_limit_value (DECIMAL(18,2)) in talent.usage_right']
  usage_scope varchar [note: 'Detailed description of what the usage right covers (e.g., likeness, voice, name, performance, image). | Column usage_scope (STRING) in talent.usage_right']
  verification_method varchar [note: 'Method used to verify and clear this usage right (e.g., contract review, legal clearance, agent confirmation, automated system check). | Column verification_method (STRING) in talent.usage_right']
  window_end_date date [note: 'End date of the usage rights window. Defines when the right expires. Nullable for perpetual rights. | Column window_end_date (DATE) in talent.usage_right']
  window_start_date date [note: 'Start date of the usage rights window. Defines when the right becomes effective. | Column window_start_date (DATE) in talent.usage_right']

  Note: 'Defines the specific usage rights granted to Media Broadcasting for a talent\'s likeness, voice, name, and performance under a given contract, and tracks the clearance verification workflow for each right. Captures right type (broadcast, streaming, VOD, SVOD, AVOD, TVOD, FAST, home video, theatrical, promotional, social media, out-of-home), territory, language, platform, window dates, exclusivity flag, clearance status (pending, cleared, conditionally cleared, blocked), blocking reason, clearance granted by, and approval/consent tracking. Ensures talent usage is both contractually authorized and operationally verified before content goes to air or distribution. | Unity Catalog table: media_broadcasting_ecm.talent.usage_right Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

Table talent.contract_option {
  contract_option_id varchar [pk, note: 'Unique identifier for the contract option record. Primary key. | Column contract_option_id (BIGINT) in talent.contract_option']
  contract_id varchar [note: 'Reference to the parent talent contract that contains this option clause. | Column contract_id (BIGINT) in talent.contract_option']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.contract_option']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in talent.contract_option']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in talent.contract_option']
  auto_renewal_flag boolean [note: 'Indicates whether the option automatically renews or rolls over if not explicitly declined by the production company within the option window. True if auto-renewal applies, False if explicit exercise is required. | Column auto_renewal_flag (BOOLEAN) in talent.contract_option']
  business_affairs_contact varchar [note: 'Name or identifier of the business affairs executive or legal representative responsible for managing this option and coordinating exercise decisions. | Column business_affairs_contact (STRING) in talent.contract_option']
  compensation_step_up_percentage decimal(5,2) [note: 'Percentage increase in base compensation upon exercise of the option, relative to the prior contract period or base rate. Common in multi-season series deals where talent compensation escalates with each renewal. | Column compensation_step_up_percentage (DECIMAL(5,2)) in talent.contract_option']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in talent.contract_option']
  created_timestamp timestamp [note: 'The date and time when this contract option record was first created in the system. Audit trail for record lifecycle tracking. | Column created_timestamp (TIMESTAMP) in talent.contract_option']
  exclusivity_clause_flag boolean [note: 'Indicates whether the option includes an exclusivity provision that restricts the talent from accepting competing work during the option period or upon exercise. True if exclusivity applies, False otherwise. | Column exclusivity_clause_flag (BOOLEAN) in talent.contract_option']
  exclusivity_scope varchar [note: 'Detailed description of the exclusivity restrictions, including prohibited activities, competing networks or platforms, genre restrictions, and geographic limitations. Only applicable if exclusivity_clause_flag is True. | Column exclusivity_scope (STRING) in talent.contract_option']
  exercise_approval_date date [note: 'The date on which the option exercise was formally approved by the authorized business affairs or executive authority. May differ from notification date in organizations requiring multi-level approval. | Column exercise_approval_date (DATE) in talent.contract_option']
  exercise_compensation_amount decimal(15,2) [note: 'The base compensation amount payable to the talent if the option is exercised. Represents the step-up or incremental payment beyond the option fee for the additional work commitment. | Column exercise_compensation_amount (DECIMAL(15,2)) in talent.contract_option']
  exercise_compensation_currency varchar [note: 'Three-letter ISO 4217 currency code for the exercise compensation (e.g., USD, GBP, EUR, CAD). | Column exercise_compensation_currency (STRING) in talent.contract_option']
  exercise_notification_date date [note: 'The date on which the production company formally notified the talent (or their representative) of the decision to exercise the option. Triggers contractual obligations and payment schedules. | Column exercise_notification_date (DATE) in talent.contract_option']
  exercise_notification_method varchar [note: 'The communication channel or mechanism used to deliver the option exercise notification, as required by the contract terms. Important for legal compliance and dispute resolution. | Column exercise_notification_method (STRING) in talent.contract_option']
  exercise_status varchar [note: 'Current state of the option: unexercised (option window open, not yet acted upon), exercised (option formally invoked by production company), lapsed (option window closed without exercise), waived (option voluntarily released by production company), pending approval (exercise submitted awaiting legal or executive approval), or conditionally exercised (exercise subject to specific conditions being met). | Column exercise_status (STRING) in talent.contract_option']
  guild_notification_date date [note: 'The date on which the option exercise was reported to the applicable guild. Required for compliance audit trails when guild_notification_required_flag is True. | Column guild_notification_date (DATE) in talent.contract_option']
  guild_notification_required_flag boolean [note: 'Indicates whether the option exercise must be reported to the talents guild (SAG-AFTRA, WGA, DGA) for compliance and residual tracking purposes. True if guild notification is required, False otherwise. | Column guild_notification_required_flag (BOOLEAN) in talent.contract_option']
  lapse_date date [note: 'The actual date on which the option lapsed due to non-exercise within the option window. Recorded for audit and contract history purposes. | Column lapse_date (DATE) in talent.contract_option']
  lapse_reason varchar [note: 'Business rationale or explanation for why the option was allowed to lapse without exercise. May include creative decisions, budget constraints, performance issues, or strategic pivots. | Column lapse_reason (STRING) in talent.contract_option']
  notes varchar [note: 'Free-form text field for additional context, special conditions, negotiation history, or operational notes related to the option. Used by business affairs and production teams for internal coordination. | Column notes (STRING) in talent.contract_option']
  option_description varchar [note: 'Detailed narrative description of the option terms, scope, and conditions. May include specific deliverables, performance triggers, or creative commitments associated with the option. | Column option_description (STRING) in talent.contract_option']
  option_fee_amount decimal(15,2) [note: 'The monetary consideration paid to the talent to secure the option right, regardless of whether the option is ultimately exercised. Typically non-refundable and may be applied against future compensation if exercised. | Column option_fee_amount (DECIMAL(15,2)) in talent.contract_option']
  option_fee_currency varchar [note: 'Three-letter ISO 4217 currency code for the option fee (e.g., USD, GBP, EUR, CAD). | Column option_fee_currency (STRING) in talent.contract_option']
  option_number varchar [note: 'Sequential number of this option within the contract (e.g., 1 for first option, 2 for second option). Used to track multi-year or multi-project option sequences. | Column option_number (INT) in talent.contract_option']
  option_type varchar [note: 'Classification of the option based on its business purpose: series pickup option for additional seasons, sequel option for follow-on films, spin-off option for derivative content, overall deal extension for multi-project agreements, season renewal for episodic content, or project continuation for phased productions. | Column option_type (STRING) in talent.contract_option']
  option_window_end_date date [note: 'The final date by which the option must be exercised or it will lapse. Critical deadline for business affairs teams to track to avoid inadvertent loss of talent commitments. | Column option_window_end_date (DATE) in talent.contract_option']
  option_window_start_date date [note: 'The earliest date on which the option can be exercised by the production company or network. Marks the beginning of the exercise window. | Column option_window_start_date (DATE) in talent.contract_option']
  performance_trigger_description varchar [note: 'Description of any performance-based conditions or milestones that must be met before the option can be exercised (e.g., minimum ratings thresholds, box office targets, critical acclaim metrics, audience engagement benchmarks). | Column performance_trigger_description (STRING) in talent.contract_option']
  performance_trigger_met_flag boolean [note: 'Indicates whether all performance-based conditions have been satisfied, enabling the option to be exercised. True if triggers are met or not applicable, False if triggers exist but are not yet satisfied. | Column performance_trigger_met_flag (BOOLEAN) in talent.contract_option']
  residual_eligibility_flag boolean [note: 'Indicates whether work performed under this option (if exercised) qualifies the talent for residual payments under guild collective bargaining agreements. True if residuals apply, False otherwise. | Column residual_eligibility_flag (BOOLEAN) in talent.contract_option']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.contract_option']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.contract_option']
  updated_timestamp timestamp [note: 'The date and time when this contract option record was last modified. Audit trail for change tracking and compliance. | Column updated_timestamp (TIMESTAMP) in talent.contract_option']

  Note: 'Tracks option periods embedded in talent contracts — including option type (series pickup option, sequel option, spin-off option, overall deal extension), option number in sequence, option exercise window (start and end date), option fee, compensation step-up on exercise, exercise status (unexercised, exercised, lapsed, waived), and exercise notification date. Enables production and business affairs teams to proactively manage option deadlines and avoid inadvertent lapse of valuable talent commitments. | Unity Catalog table: media_broadcasting_ecm.talent.contract_option Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

Table talent.availability {
  availability_id varchar [pk, note: 'Unique identifier for the talent availability record. Primary key. | Column availability_id (BIGINT) in talent.availability']
  opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Talent availability holds placed for sales opportunities requiring specific talent (celebrity host for advertiser-sponsored special, talent-driven content pitch). Real business process: sales team pit | Column opportunity_id (BIGINT) in sales.availability']
  production_project_id varchar [note: 'Reference to the production requesting or holding this availability. Null if this is a general unavailability not tied to a specific production. | Column production_project_id (BIGINT) in production.availability']
  studio_facility_id varchar [note: 'Foreign key linking to technology.studio_facility. Business justification: Availability holds are placed against specific studio resources when booking talent. Studio booking systems check talent availability before confirming studio reservations to prevent double-booking an | Column studio_facility_id (BIGINT) in technology.availability']
  talent_profile_id varchar [note: 'Reference to the talent (actor, director, writer, producer, host, correspondent, crew member) whose availability is being tracked. | Column talent_profile_id (BIGINT) in talent.availability']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.availability']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in talent.availability']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in talent.availability']
  availability_type varchar [note: 'Classification of the availability status: available (talent is free), hold (production has placed a hold), first_refusal (talent has granted first right to book), confirmed_booking (talent is booked), personal_unavailability (talent is unavailable for personal reasons), conflicting_production (talent is committed to another production). | Column availability_type (STRING) in talent.availability']
  booking_confirmed_date date [note: 'The date when the booking was confirmed and the talent was officially committed to the production. Null if not yet confirmed. | Column booking_confirmed_date (DATE) in talent.availability']
  booking_status varchar [note: 'Current lifecycle status of the availability record: tentative (hold placed but not confirmed), confirmed (booking finalized), cancelled (booking or hold cancelled), released (hold dropped by production), expired (hold expired without confirmation). | Column booking_status (STRING) in talent.availability']
  conflict_production_network varchar [note: 'Network or studio associated with the conflicting production. Used to identify potential exclusivity clause violations. | Column conflict_production_network (STRING) in talent.availability']
  conflict_production_title varchar [note: 'Title of the conflicting production when availability_type is conflicting_production. Null if not applicable. | Column conflict_production_title (STRING) in talent.availability']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in talent.availability']
  created_by_user varchar [note: 'Username or identifier of the system user who created this availability record. | Column created_by_user (STRING) in talent.availability']
  created_timestamp timestamp [note: 'Timestamp when this availability record was first created in the system. | Column created_timestamp (TIMESTAMP) in talent.availability']
  end_date date [note: 'The end date of the availability or unavailability window. Represents the last day the talent is available or unavailable. Null for open-ended availability. | Column end_date (DATE) in talent.availability']
  exclusivity_conflict_flag boolean [note: 'Indicates whether this availability record represents a conflict with an existing exclusivity clause in the talents contract. True if conflict exists, False otherwise. | Column exclusivity_conflict_flag (BOOLEAN) in talent.availability']
  guild_notification_date date [note: 'The date when the guild was notified of this booking. Null if notification not yet sent or not required. | Column guild_notification_date (DATE) in talent.availability']
  guild_notification_required_flag boolean [note: 'Indicates whether guild notification is required for this booking per collective bargaining agreement rules (SAG-AFTRA, WGA, DGA). True if notification required, False otherwise. | Column guild_notification_required_flag (BOOLEAN) in talent.availability']
  hold_expiration_date date [note: 'The date by which the production must confirm the booking or the hold will expire. Null if not applicable. | Column hold_expiration_date (DATE) in talent.availability']
  hold_level varchar [note: 'Priority level of the hold when availability_type is hold or first_refusal. First hold has highest priority, second and third holds are backup options. Null if not a hold. | Column hold_level (STRING) in talent.availability']
  hold_placed_date date [note: 'The date when the hold was initially placed on the talent. Null if availability_type is not hold or first_refusal. | Column hold_placed_date (DATE) in talent.availability']
  hold_released_date date [note: 'The date when the hold was released or dropped by the requesting production. Null if hold was not released. | Column hold_released_date (DATE) in talent.availability']
  notes varchar [note: 'Free-text notes capturing additional context, special conditions, or instructions related to this availability record. | Column notes (STRING) in talent.availability']
  priority_level varchar [note: 'Business priority assigned to this availability request. High priority requests receive preferential treatment in conflict resolution. | Column priority_level (STRING) in talent.availability']
  requesting_contact_email varchar [note: 'Email address of the production contact who placed the availability request. | Column requesting_contact_email (STRING) in talent.availability']
  requesting_contact_phone varchar [note: 'Phone number of the production contact who placed the availability request. | Column requesting_contact_phone (STRING) in talent.availability']
  requesting_department varchar [note: 'The department or business unit that requested the availability hold or booking (e.g., Drama Production, News, Sports, Documentary Unit). | Column requesting_department (STRING) in talent.availability']
  requesting_producer_name varchar [note: 'Name of the producer or production manager who requested the availability hold or booking. | Column requesting_producer_name (STRING) in talent.availability']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.availability']
  start_date date [note: 'The start date of the availability or unavailability window. Represents the first day the talent is available or unavailable. | Column start_date (DATE) in talent.availability']
  unavailability_reason varchar [note: 'Detailed explanation of why the talent is unavailable during this period (e.g., personal commitment, vacation, medical leave, prior contractual obligation). | Column unavailability_reason (STRING) in talent.availability']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.availability']
  updated_by_user varchar [note: 'Username or identifier of the system user who last updated this availability record. | Column updated_by_user (STRING) in talent.availability']
  updated_timestamp timestamp [note: 'Timestamp when this availability record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in talent.availability']

  Note: 'Operational record of a talent\'s confirmed availability or unavailability for production bookings — capturing availability window start and end dates, availability type (available, hold, first refusal, confirmed booking, personal unavailability, conflicting production), hold level (first hold, second hold, third hold), requesting production, and release date if hold is dropped. Supports production scheduling, casting decisions, and conflict resolution across concurrent productions. Integrates with appearance_schedule and Dalet Galaxy workflow orchestration. | Unity Catalog table: media_broadcasting_ecm.talent.availability | Domain ownership:  Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

Table talent.pension_health_contribution {
