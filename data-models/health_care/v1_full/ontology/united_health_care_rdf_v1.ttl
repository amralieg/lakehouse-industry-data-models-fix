    rdfs:range xsd:date .

ind:deductibleIndividual rdf:type rdf:Property ;
    rdfs:label 'Deductible Individual' ;
    rdfs:comment 'The annual deductible amount that the individual member must pay before the plan begins to pay benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleFamily rdf:type rdf:Property ;
    rdfs:label 'Deductible Family' ;
    rdfs:comment 'The annual deductible amount that the family must collectively pay before the plan begins to pay benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
