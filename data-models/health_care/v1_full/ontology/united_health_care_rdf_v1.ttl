ind:supportsOep rdf:type rdf:Property ;
    rdfs:label 'Supports Oep' ;
    rdfs:comment 'Indicates whether the channel supports enrollment during the Open Enrollment Period for individual and family plans.' ;
    rdfs:domain ind:Channel ;
