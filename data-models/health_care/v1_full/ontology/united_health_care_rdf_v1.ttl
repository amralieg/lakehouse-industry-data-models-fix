    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isMultilingual rdf:type rdf:Property ;
    rdfs:label 'Is Multilingual' ;
    rdfs:comment 'Boolean flag indicating whether the channel supports multiple languages for member interactions.' ;
    rdfs:domain ind:ServiceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAdaCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Ada Compliant' ;
    rdfs:comment 'Boolean flag indicating whether the channel meets Americans with Disabilities Act accessibility requirements.' ;
