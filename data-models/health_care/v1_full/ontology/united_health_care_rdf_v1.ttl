    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queueId rdf:type rdf:Property ;
    rdfs:label 'Queue Id' ;
    rdfs:comment 'Unique identifier for the customer service queue configuration.' ;
    rdfs:domain ind:UnitedHealthCare ;
