    rdfs:range xsd:string .

ind:manufacturerName rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Name' ;
    rdfs:comment 'The name of the pharmaceutical manufacturer or labeler responsible for producing and distributing the specialty drug.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageRequirements rdf:type rdf:Property ;
    rdfs:label 'Storage Requirements' ;
    rdfs:comment 'Special storage conditions required for the specialty drug, such as refrigeration, freezing, or protection from light, to maintain stability and efficacy.' ;
