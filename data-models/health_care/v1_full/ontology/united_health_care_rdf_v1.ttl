ind:reductionLevel rdf:type rdf:Property ;
    rdfs:label 'Reduction Level' ;
    rdfs:comment 'Indicates the level of cost sharing reduction for ACA marketplace plans (73%, 87%, 94% actuarial value variants, or standard).' ;
