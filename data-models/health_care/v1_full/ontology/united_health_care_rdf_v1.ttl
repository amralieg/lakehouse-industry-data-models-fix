    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filedDate rdf:type rdf:Property ;
    rdfs:label 'Filed Date' ;
    rdfs:comment 'Date when the dispute was formally filed or initiated.' ;
