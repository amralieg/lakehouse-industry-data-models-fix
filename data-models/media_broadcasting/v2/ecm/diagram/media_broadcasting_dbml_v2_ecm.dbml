  name_usage_flag boolean [note: 'Indicates whether the clearance includes usage of the talent\'s name in promotional or marketing materials. | Column name_usage_flag (BOOLEAN) in talent.talent_clearance']
  notes varchar [note: 'Additional comments, context, or special instructions related to the clearance request and approval process. | Column notes (STRING) in talent.talent_clearance']
  performance_usage_flag boolean [note: 'Indicates whether the clearance includes usage of the talent\'s recorded performance or voice. | Column performance_usage_flag (BOOLEAN) in talent.talent_clearance']
  priority_level varchar [note: 'Business priority assigned to the clearance request based on production schedules and air dates. | Column priority_level (STRING) in talent.talent_clearance']
  request_date date [note: 'Date when the clearance request was initiated by the production or rights team. | Column request_date (DATE) in talent.talent_clearance']
  request_number varchar [note: 'Business identifier for the clearance request, used for tracking and reference across systems. | Column request_number (STRING) in talent.talent_clearance']
  residual_payment_triggered_flag boolean [note: 'Indicates whether this clearance triggers residual payment obligations under guild agreements. | Column residual_payment_triggered_flag (BOOLEAN) in talent.talent_clearance']
  reviewed_by_legal_flag boolean [note: 'Indicates whether the clearance request has been reviewed and approved by the legal department. | Column reviewed_by_legal_flag (BOOLEAN) in talent.talent_clearance']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.talent_clearance']
  talent_approval_date date [note: 'Date when the talent provided their explicit approval or consent for the specified usage. | Column talent_approval_date (DATE) in talent.talent_clearance']
  talent_approval_received_flag boolean [note: 'Indicates whether the required talent approval has been obtained and documented. | Column talent_approval_received_flag (BOOLEAN) in talent.talent_clearance']
  talent_approval_required_flag boolean [note: 'Indicates whether explicit talent consent or approval is required before usage can proceed. | Column talent_approval_required_flag (BOOLEAN) in talent.talent_clearance']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.talent_clearance']
  updated_timestamp timestamp [note: 'Timestamp when the clearance record was last modified or updated. | Column updated_timestamp (TIMESTAMP) in talent.talent_clearance']
  usage_category varchar [note: 'Classification of the intended usage based on broadcast and distribution business models. | Column usage_category (STRING) in talent.talent_clearance']

  Note: 'Records the rights clearance verification process for talent likeness, name, and performance usage in a specific production or campaign — capturing clearance request date, clearance type (broadcast clearance, promotional clearance, social media clearance, international clearance), clearance status (pending, cleared, conditionally cleared, blocked), blocking reason, clearance granted by, clearance expiry date, and any required talent approval or consent. Ensures talent usage complies with contractual, guild, and regulatory obligations before content goes to air or distribution. | Unity Catalog table: media_broadcasting_ecm.talent.talent_clearance Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

Table talent.cba_rate_card {
  cba_rate_card_id varchar [pk, note: 'Unique identifier for the CBA rate card entry. Primary key. | Column cba_rate_card_id (BIGINT) in talent.cba_rate_card']
  created_by_user_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Labor relations employees create and maintain CBA rate cards. Required for rate card governance, compliance tracking, audit trails, and accountability. Column created_by_user is denormalized employee ']
  superseded_by_rate_card_cba_rate_card_id varchar [note: 'Reference to the newer CBA rate card entry that replaces this one, if applicable. | Column superseded_by_rate_card_cba_rate_card_id (BIGINT) in talent.cba_rate_card']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.cba_rate_card']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in talent.cba_rate_card']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in talent.cba_rate_card']
  budget_tier varchar [note: 'Production budget classification that determines applicable rates (e.g., high budget, low budget, ultra-low budget, modified low budget). | Column budget_tier (STRING) in talent.cba_rate_card']
  cba_code varchar [note: 'Standardized code identifying the specific collective bargaining agreement (e.g., SAG_AFTRA_TV, DGA_BASIC, WGA_MBA, IATSE_BASIC). | Column cba_code (STRING) in talent.cba_rate_card']
  cba_name varchar [note: 'Full legal name of the collective bargaining agreement (e.g., SAG-AFTRA Television Agreement, DGA Basic Agreement, WGA Minimum Basic Agreement). | Column cba_name (STRING) in talent.cba_rate_card']
  cba_ratification_date date [note: 'Date when the CBA was ratified by the guild membership. | Column cba_ratification_date (DATE) in talent.cba_rate_card']
  cba_version varchar [note: 'Version identifier of the CBA document (e.g., 2023-2026, v4.2). | Column cba_version (STRING) in talent.cba_rate_card']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in talent.cba_rate_card']
  created_timestamp timestamp [note: 'Timestamp when this CBA rate card record was first created in the system. | Column created_timestamp (TIMESTAMP) in talent.cba_rate_card']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the minimum scale rate (e.g., USD, CAD, GBP). | Column currency_code (STRING) in talent.cba_rate_card']
  effective_date date [note: 'Date when this CBA rate becomes effective and enforceable. | Column effective_date (DATE) in talent.cba_rate_card']
  expiration_date date [note: 'Date when this CBA rate expires and is no longer enforceable. Null if the rate remains in effect indefinitely or until superseded. | Column expiration_date (DATE) in talent.cba_rate_card']
  forced_call_penalty_multiplier decimal(4,2) [note: 'Multiplier applied when talent is called back to work before the minimum turnaround period has elapsed. | Column forced_call_penalty_multiplier (DECIMAL(4,2)) in talent.cba_rate_card']
  golden_time_multiplier decimal(4,2) [note: 'Multiplier applied to base rate for hours worked beyond double-time threshold (e.g., 3.0 for triple-time), applicable in certain guild agreements. | Column golden_time_multiplier (DECIMAL(4,2)) in talent.cba_rate_card']
  guild_code varchar [note: 'Code representing the labor guild or union that negotiated this CBA (SAG-AFTRA, DGA, WGA, IATSE, NABET, AFM, OTHER). [ENUM-REF-CANDIDATE: SAG-AFTRA|DGA|WGA|IATSE|NABET|AFM|OTHER — 7 candidates stripped; promote to reference product] | Column guild_code (STRING) in talent.cba_rate_card']
  job_classification varchar [note: 'Specific job title or classification within the performer category (e.g., Series Regular, Guest Star, Co-Star, Director of Photography, Script Supervisor). | Column job_classification (STRING) in talent.cba_rate_card']
  jurisdiction varchar [note: 'Geographic jurisdiction where this CBA rate applies, using three-letter country code (e.g., USA, CAN, GBR). | Column jurisdiction (STRING) in talent.cba_rate_card']
  local_chapter varchar [note: 'Local guild chapter or regional office that administers this rate (e.g., SAG-AFTRA Los Angeles, IATSE Local 600). | Column local_chapter (STRING) in talent.cba_rate_card']
  meal_penalty_amount decimal(10,2) [note: 'Penalty payment owed to talent when meal breaks are not provided within the CBA-mandated timeframe. | Column meal_penalty_amount (DECIMAL(10,2)) in talent.cba_rate_card']
  minimum_scale_rate decimal(15,2) [note: 'Minimum compensation amount defined by the CBA for this rate type and performer category. | Column minimum_scale_rate (DECIMAL(15,2)) in talent.cba_rate_card']
  notes varchar [note: 'Additional notes, clarifications, or special conditions related to this CBA rate card entry. | Column notes (STRING) in talent.cba_rate_card']
  overtime_multiplier decimal(4,2) [note: 'Multiplier applied to base rate for overtime hours (e.g., 1.5 for time-and-a-half, 2.0 for double-time). | Column overtime_multiplier (DECIMAL(4,2)) in talent.cba_rate_card']
  overtime_threshold_hours decimal(5,2) [note: 'Number of hours worked before overtime rates apply (e.g., 8.0 for daily overtime, 40.0 for weekly overtime). | Column overtime_threshold_hours (DECIMAL(5,2)) in talent.cba_rate_card']
  pension_health_contribution_rate decimal(5,4) [note: 'Percentage of gross compensation that the employer must contribute to pension and health funds as mandated by the CBA (e.g., 0.1850 for 18.5%). | Column pension_health_contribution_rate (DECIMAL(5,4)) in talent.cba_rate_card']
  performer_category varchar [note: 'Classification of the talent role covered by this rate (e.g., principal performer, day player, stunt performer, background actor, director, writer, producer, crew member). | Column performer_category (STRING) in talent.cba_rate_card']
  production_type varchar [note: 'Type of production this rate applies to (e.g., theatrical motion picture, television series, television movie, new media, commercial, industrial). | Column production_type (STRING) in talent.cba_rate_card']
  rate_status varchar [note: 'Current lifecycle status of this rate card entry (active, expired, superseded, pending, draft). | Column rate_status (STRING) in talent.cba_rate_card']
  rate_type varchar [note: 'Type of compensation rate defined in this CBA entry (day rate, weekly rate, episodic rate, theatrical rate, session rate, hourly rate). | Column rate_type (STRING) in talent.cba_rate_card']
  residual_eligibility_flag boolean [note: 'Indicates whether this rate category qualifies for residual payments under the CBA (True/False). | Column residual_eligibility_flag (BOOLEAN) in talent.cba_rate_card']
  residual_formula_code varchar [note: 'Code identifying the residual calculation formula applicable to this rate (e.g., NETWORK_PRIME, BASIC_CABLE, SVOD_HIGH_BUDGET). | Column residual_formula_code (STRING) in talent.cba_rate_card']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.cba_rate_card']
  turnaround_hours decimal(4,1) [note: 'Minimum rest period required between work days as mandated by the CBA (e.g., 12.0 hours). | Column turnaround_hours (DECIMAL(4,1)) in talent.cba_rate_card']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.cba_rate_card']
  updated_timestamp timestamp [note: 'Timestamp when this CBA rate card record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in talent.cba_rate_card']

  Note: 'Reference table of minimum scale rates and contribution percentages defined by each Collective Bargaining Agreement (CBA) applicable to Media Broadcasting — covering SAG-AFTRA Codified Basic Agreement, SAG-AFTRA Television Agreement, DGA Basic Agreement, WGA Minimum Basic Agreement, and IATSE Basic Agreement. Captures rate type (day rate, weekly rate, episodic rate, theatrical rate), performer category, effective date, expiration date, P&H contribution rate, and overtime multiplier. Used by compensation_structure and residual_eligibility to validate scale compliance. | Unity Catalog table: media_broadcasting_ecm.talent.cba_rate_card Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

Table talent.contract_amendment {
  contract_amendment_id varchar [pk, note: 'Unique identifier for the contract amendment record. Primary key. | Column contract_amendment_id (BIGINT) in talent.contract_amendment']
  contract_id varchar [note: 'Reference to the original executed talent contract being amended. Links to the parent contract record in the talent contract system. | Column contract_id (BIGINT) in talent.contract_amendment']
  modified_by_user_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Business affairs employees modify contract amendments. Required for audit trails, approval workflows, compliance tracking, and change management. Column modified_by_user is denormalized employee refer']
  superseded_by_amendment_contract_amendment_id varchar [note: 'Reference to a subsequent amendment that replaces or supersedes this amendment. Used to maintain amendment version history and prevent application of outdated terms. | Column superseded_by_amendment_contract_amendment_id (BIGINT) in talent.contract_amendment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.contract_amendment']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in talent.contract_amendment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in talent.contract_amendment']
  amended_clause_reference varchar [note: 'Specific section, paragraph, or clause number from the original contract that this amendment modifies (e.g., Section 3.2, Paragraph 5(a), Exhibit B). | Column amended_clause_reference (STRING) in talent.contract_amendment']
  amended_term_value decimal(18,2) [note: 'The new contractual term or value established by this amendment. Replaces or supplements the original term value. | Column amended_term_value (DECIMAL(18,2)) in talent.contract_amendment']
  amendment_description varchar [note: 'Detailed narrative description of the contractual changes being made, including the business rationale and specific terms being modified or added. | Column amendment_description (STRING) in talent.contract_amendment']
  amendment_number varchar [note: 'Sequential or hierarchical identifier for this amendment within the contract (e.g., Amendment 1, Amendment 2A). Used for tracking and referencing specific modifications. | Column amendment_number (STRING) in talent.contract_amendment']
  amendment_status varchar [note: 'Current lifecycle state of the amendment. Tracks progression from drafting through execution or rejection. Only executed amendments are legally binding. | Column amendment_status (STRING) in talent.contract_amendment']
  amendment_type varchar [note: 'Classification of the amendment by the primary contractual element being modified. Determines which business affairs and legal review workflows apply. [ENUM-REF-CANDIDATE: compensation_adjustment|credit_modification|exclusivity_scope_change|option_term_revision|force_majeure_addition|residual_formula_change|backend_participation_change|term_extension|role_scope_change|other — 10 candidates stripped; promote to reference product] | Column amendment_type (STRING) in talent.contract_amendment']
  business_affairs_approver_name varchar [note: 'Name of the business affairs executive who reviewed and approved this amendment on behalf of the production company or network. | Column business_affairs_approver_name (STRING) in talent.contract_amendment']
  company_signature_date date [note: 'Date on which the authorized company representative signed the amendment. Execution date is typically the later of talent and company signature dates. | Column company_signature_date (DATE) in talent.contract_amendment']
  compensation_impact_amount decimal(15,2) [note: 'Net financial impact of the amendment on total talent compensation. Positive values indicate increases, negative indicate reductions. Used for budget reconciliation and residual calculations. | Column compensation_impact_amount (DECIMAL(15,2)) in talent.contract_amendment']
  compensation_impact_currency varchar [note: 'Three-letter ISO 4217 currency code for the compensation impact amount (e.g., USD, GBP, CAD). | Column compensation_impact_currency (STRING) in talent.contract_amendment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in talent.contract_amendment']
  created_timestamp timestamp [note: 'Timestamp when this amendment record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in talent.contract_amendment']
  document_reference_uri varchar [note: 'URI or file path to the executed amendment document stored in the media asset management or document management system. | Column document_reference_uri (STRING) in talent.contract_amendment']
  effective_date date [note: 'Date on which the amendment terms become legally binding and operationally effective. May be retroactive, concurrent with execution, or future-dated. | Column effective_date (DATE) in talent.contract_amendment']
  execution_date date [note: 'Date on which all required parties signed the amendment, making it legally enforceable. Distinct from effective date which may differ. | Column execution_date (DATE) in talent.contract_amendment']
  guild_notification_date date [note: 'Date on which the amendment was formally reported to the applicable talent guild. Required for compliance with CBA notification timelines. | Column guild_notification_date (DATE) in talent.contract_amendment']
  guild_notification_required_flag boolean [note: 'Indicates whether the amendment must be reported to the talent guild per collective bargaining agreement (CBA) requirements. True for material changes to compensation, credit, or working conditions. | Column guild_notification_required_flag (BOOLEAN) in talent.contract_amendment']
  last_modified_timestamp timestamp [note: 'Timestamp when this amendment record was most recently updated. Tracks all modifications for compliance and audit purposes. | Column last_modified_timestamp (TIMESTAMP) in talent.contract_amendment']
  legal_review_completed_date date [note: 'Date on which legal review of the amendment was completed and approval granted. Required before execution. | Column legal_review_completed_date (DATE) in talent.contract_amendment']
  legal_reviewer_name varchar [note: 'Name of the legal counsel who reviewed the amendment for compliance with guild rules, employment law, and corporate policy. | Column legal_reviewer_name (STRING) in talent.contract_amendment']
  notes varchar [note: 'Free-form notes capturing additional context, negotiation history, special conditions, or operational instructions related to this amendment. | Column notes (STRING) in talent.contract_amendment']
  original_term_value decimal(18,2) [note: 'The original contractual term or value being replaced or modified by this amendment. Captured for audit trail and comparison purposes. | Column original_term_value (DECIMAL(18,2)) in talent.contract_amendment']
  rejection_reason varchar [note: 'Explanation of why the amendment was rejected by talent, company, or legal review. Captured for negotiation history and future reference. | Column rejection_reason (STRING) in talent.contract_amendment']
  residual_calculation_impact_flag boolean [note: 'Indicates whether this amendment affects residual payment calculations. True triggers recalculation of residual formulas and payment schedules. | Column residual_calculation_impact_flag (BOOLEAN) in talent.contract_amendment']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.contract_amendment']
  talent_representative_agency varchar [note: 'Name of the talent agency or law firm representing the talent in this amendment negotiation. | Column talent_representative_agency (STRING) in talent.contract_amendment']
  talent_representative_name varchar [note: 'Name of the talent agent, manager, or attorney who negotiated and approved this amendment on behalf of the talent. | Column talent_representative_name (STRING) in talent.contract_amendment']
  talent_signature_date date [note: 'Date on which the talent or their authorized representative signed the amendment. | Column talent_signature_date (DATE) in talent.contract_amendment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.contract_amendment']

  Note: 'Records formal amendments and modifications to executed talent contracts — capturing amendment number, amendment type (compensation adjustment, credit modification, exclusivity scope change, option term revision, force majeure clause addition), amendment effective date, original contract reference, amended clause description, amendment status (draft, executed, rejected), and signatory confirmation. Maintains a complete audit trail of all contractual changes to support business affairs, legal, and residual calculation accuracy. | Unity Catalog table: media_broadcasting_ecm.talent.contract_amendment Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

Table talent.talent_grievance {
  talent_grievance_id varchar [pk, note: 'Unique identifier for the talent grievance record. Primary key. | Column talent_grievance_id (BIGINT) in talent.talent_grievance']
  contract_id varchar [note: 'Reference to the specific talent contract under which this grievance was filed, if applicable. | Column contract_id (BIGINT) in talent.talent_grievance']
  guild_affiliation_id varchar [note: 'Foreign key linking to talent.guild_affiliation. Business justification: talent_grievance currently has guild_code and guild_name (STRING) duplicating data from guild_affiliation. Grievances are filed in the context of a specific guild membership. Adding FK to guild_affili | Column guild_affiliation_id (BIGINT) in talent.talent_grievance']
  modified_by_user_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: HR or legal employees manage talent grievance records. Required for case management, workload tracking, compliance documentation, and audit trails. Column modified_by_user is denormalized employee ref']
  production_project_id varchar [note: 'Reference to the production entity associated with this grievance, if applicable. | Column production_project_id (BIGINT) in production.talent_grievance']
  talent_profile_id varchar [note: 'Reference to the talent individual who is party to this grievance (either filing party or responding party). | Column talent_profile_id (BIGINT) in talent.talent_grievance']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.talent_grievance']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in talent.talent_grievance']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in talent.talent_grievance']
  appeal_date date [note: 'Date on which an appeal was filed, if applicable. | Column appeal_date (DATE) in talent.talent_grievance']
  appeal_filed_flag boolean [note: 'Indicates whether an appeal has been filed following the initial arbitration award or decision (True if appeal filed, False if not). | Column appeal_filed_flag (BOOLEAN) in talent.talent_grievance']
  arbitration_reference_number varchar [note: 'Unique reference number assigned by the arbitration body or guild for tracking this grievance through the dispute resolution process. | Column arbitration_reference_number (STRING) in talent.talent_grievance']
  arbitrator_name varchar [note: 'Name of the arbitrator or mediator assigned to hear and decide this grievance. | Column arbitrator_name (STRING) in talent.talent_grievance']
  cba_version varchar [note: 'Version or year of the Collective Bargaining Agreement (CBA) under which this grievance was filed (e.g., 2020 SAG-AFTRA CBA, 2023 WGA MBA). | Column cba_version (STRING) in talent.talent_grievance']
  confidentiality_flag boolean [note: 'Indicates whether this grievance is subject to confidentiality or non-disclosure provisions (True if confidential, False if not). | Column confidentiality_flag (BOOLEAN) in talent.talent_grievance']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in talent.talent_grievance']
  created_timestamp timestamp [note: 'Timestamp when this grievance record was first created in the system. | Column created_timestamp (TIMESTAMP) in talent.talent_grievance']
  disputed_amount decimal(15,2) [note: 'Monetary amount in dispute, such as unpaid compensation, residuals, or damages claimed by the filing party. | Column disputed_amount (DECIMAL(15,2)) in talent.talent_grievance']
  disputed_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the disputed amount (e.g., USD, GBP, CAD). | Column disputed_currency_code (STRING) in talent.talent_grievance']
  filing_date date [note: 'Date on which the grievance was formally filed with the guild or arbitration body. | Column filing_date (DATE) in talent.talent_grievance']
  filing_party_name varchar [note: 'Name of the individual or organization that filed the grievance. | Column filing_party_name (STRING) in talent.talent_grievance']
  filing_party_type varchar [note: 'Type of entity that initiated the grievance: talent (individual), guild (on behalf of member), production company, network, or studio. | Column filing_party_type (STRING) in talent.talent_grievance']
  grievance_description varchar [note: 'Detailed narrative description of the grievance, including the nature of the dispute, alleged violations, and relief sought. | Column grievance_description (STRING) in talent.talent_grievance']
  grievance_number varchar [note: 'Externally-known unique business identifier for this grievance, used in legal correspondence and guild communications. | Column grievance_number (STRING) in talent.talent_grievance']
  grievance_type varchar [note: 'Classification of the grievance by subject matter: compensation dispute, credit dispute, working condition violation, residual underpayment, exclusivity breach, or contract breach. | Column grievance_type (STRING) in talent.talent_grievance']
  guild_representative_contact varchar [note: 'Contact information (email or phone) for the guild representative managing this grievance. | Column guild_representative_contact (STRING) in talent.talent_grievance']
  guild_representative_name varchar [note: 'Name of the guild representative or business agent handling this grievance on behalf of the talent. | Column guild_representative_name (STRING) in talent.talent_grievance']
  hearing_date date [note: 'Scheduled or actual date of the arbitration hearing or mediation session for this grievance. | Column hearing_date (DATE) in talent.talent_grievance']
  last_modified_timestamp timestamp [note: 'Timestamp when this grievance record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in talent.talent_grievance']
  legal_counsel_name varchar [note: 'Name of the legal counsel or attorney representing the filing party in this grievance. | Column legal_counsel_name (STRING) in talent.talent_grievance']
  notes varchar [note: 'Additional internal notes, comments, or context regarding the grievance, maintained by business affairs or legal teams. | Column notes (STRING) in talent.talent_grievance']
  priority_level varchar [note: 'Priority level assigned to this grievance by the guild or business affairs team: low, medium, high, or urgent. | Column priority_level (STRING) in talent.talent_grievance']
  production_title varchar [note: 'Title of the production (film, series, episode) to which this grievance relates, if applicable. | Column production_title (STRING) in talent.talent_grievance']
  resolution_date date [note: 'Date on which the grievance was formally resolved, either through settlement, arbitration award, withdrawal, or dismissal. | Column resolution_date (DATE) in talent.talent_grievance']
  resolution_method varchar [note: 'Method by which the grievance was resolved: negotiated settlement (parties agreed), arbitration award (arbitrator decided), mediation (facilitated agreement), withdrawal (filing party withdrew), or dismissal (rejected by arbitrator or guild). | Column resolution_method (STRING) in talent.talent_grievance']
  resolution_status varchar [note: 'Current status of the grievance in its lifecycle: open (filed but not yet in arbitration), in arbitration (active proceedings), settled (parties reached agreement), withdrawn (filing party withdrew), arbitration award issued (arbitrator rendered decision), or dismissed (grievance rejected). | Column resolution_status (STRING) in talent.talent_grievance']
  responding_party_name varchar [note: 'Name of the individual or organization against whom the grievance was filed. | Column responding_party_name (STRING) in talent.talent_grievance']
  responding_party_type varchar [note: 'Type of entity against whom the grievance was filed: talent (individual), guild, production company, network, or studio. | Column responding_party_type (STRING) in talent.talent_grievance']
  settlement_amount decimal(15,2) [note: 'Monetary amount agreed upon or awarded as part of the grievance settlement or arbitration award, if applicable. | Column settlement_amount (DECIMAL(15,2)) in talent.talent_grievance']
  settlement_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the settlement amount (e.g., USD, GBP, CAD). | Column settlement_currency_code (STRING) in talent.talent_grievance']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.talent_grievance']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.talent_grievance']

  Note: 'Operational record of formal grievances, disputes, and arbitration proceedings filed by or against talent or their guild representatives — capturing grievance type (compensation dispute, credit dispute, working condition violation, residual underpayment, exclusivity breach), filing party, responding party, guild involved, grievance filing date, arbitration reference number, hearing date, resolution status (open, in arbitration, settled, withdrawn, arbitration award issued), settlement amount, and resolution date. Supports legal, business affairs, and compliance teams in managing guild relations. | Unity Catalog table: media_broadcasting_ecm.talent.talent_grievance Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

Table talent.partner_relationship {
  partner_relationship_id varchar [pk, note: 'Unique identifier for this talent-partner relationship record. Primary key. | Column partner_relationship_id (BIGINT) in talent.partner_relationship']
  partner_id varchar [note: 'Foreign key linking to the partner entity in the partner master | Column partner_id (BIGINT) in partner.partner_relationship']
  talent_profile_id varchar [note: 'Foreign key linking to the talent profile in the talent master | Column talent_profile_id (BIGINT) in talent.partner_relationship']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.partner_relationship']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in talent.partner_relationship']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in talent.partner_relationship']
  conflict_of_interest_flag boolean [note: 'Indicates whether there are known conflicts of interest between this talent and partner that require disclosure or management (e.g., competing projects, contractual restrictions). | Column conflict_of_interest_flag (BOOLEAN) in talent.partner_relationship']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in talent.partner_relationship']
  deal_count varchar [note: 'Total number of individual deals or projects executed between this talent and partner under this relationship. Used for relationship strength assessment. | Column deal_count (INT) in talent.partner_relationship']
  effective_end_date date [note: 'The date when this talent-partner relationship ended or is scheduled to end. Null for ongoing relationships. | Column effective_end_date (DATE) in talent.partner_relationship']
  effective_start_date date [note: 'The date when this talent-partner relationship became active. Used for exclusivity window tracking and deal history analysis. | Column effective_start_date (DATE) in talent.partner_relationship']
  exclusivity_flag boolean [note: 'Indicates whether this relationship includes exclusivity provisions that restrict the talent from working with competing partners during the relationship period. | Column exclusivity_flag (BOOLEAN) in talent.partner_relationship']
  preferred_partner_flag boolean [note: 'Indicates whether this partner has preferred status for this talent, meaning the talent or their representation prioritizes opportunities from this partner. | Column preferred_partner_flag (BOOLEAN) in talent.partner_relationship']
  relationship_created_timestamp timestamp [note: 'The date and time when this talent-partner relationship record was first created in the system. | Column relationship_created_timestamp (TIMESTAMP) in talent.partner_relationship']
  relationship_status varchar [note: 'Current lifecycle status of the talent-partner relationship. Active indicates ongoing business engagement. | Column relationship_status (STRING) in talent.partner_relationship']
  relationship_type varchar [note: 'Classification of the business relationship type between talent and partner. Determines exclusivity scope and deal structure. | Column relationship_type (STRING) in talent.partner_relationship']
  relationship_updated_timestamp timestamp [note: 'The date and time when this talent-partner relationship record was last modified. | Column relationship_updated_timestamp (TIMESTAMP) in talent.partner_relationship']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.partner_relationship']
  total_deal_value decimal(15,2) [note: 'Cumulative monetary value of all deals executed between this talent and partner. Used for strategic tier assessment and relationship ROI analysis. | Column total_deal_value (DECIMAL(15,2)) in talent.partner_relationship']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.partner_relationship']

  Note: 'This association product represents the ongoing business relationship between talent and external partners (studios, networks, streamers, syndicators). It captures deal history, exclusivity arrangements, preferred status, and conflict tracking that exist only in the context of this specific talent-partner pairing. Each record links one talent to one partner with relationship-specific metadata used for deal sourcing, conflict management, and strategic talent roster management.. Existence Justification: In media broadcasting, talent (actors, directors, writers, producers) routinely maintain simultaneous business relationships with multiple partners (studios, networks, streamers, syndicators) across their careers. Partners likewise maintain rosters of talent relationships spanning dozens to hundreds of individuals. The business actively manages these relationships as distinct entities with relationship-specific metadata including exclusivity windows, deal history, preferred status, and conflict tracking that cannot be attributed to either the talent or partner alone. | Unity Catalog table: media_broadcasting_ecm.talent.partner_relationship Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

Table talent.endorsement_deal {
  endorsement_deal_id varchar [pk, note: 'Unique identifier for this endorsement deal record. Primary key for the association. | Column endorsement_deal_id (BIGINT) in talent.endorsement_deal']
  employee_id varchar [note: 'Reference to the sales representative or user who created this deal record. Used for sales attribution and commission tracking. | Column employee_id (BIGINT) in workforce.endorsement_deal']
  sales_account_id varchar [note: 'Foreign key linking to the sales account (advertiser/brand) who is party to this endorsement deal | Column sales_account_id (BIGINT) in sales.endorsement_deal']
  talent_profile_id varchar [note: 'Foreign key linking to the talent who is party to this endorsement deal | Column talent_profile_id (BIGINT) in talent.endorsement_deal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.endorsement_deal']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in talent.endorsement_deal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in talent.endorsement_deal']
  commission_rate decimal(5,4) [note: 'The commission percentage paid to the talent\'s agent or representation agency for this specific deal. This is deal-specific and may vary from the standard agency rate. | Column commission_rate (DECIMAL(5,4)) in talent.endorsement_deal']
  contract_end_date date [note: 'The expiration date of the endorsement contract. Defines when the talent\'s endorsement obligations and usage rights terminate. | Column contract_end_date (DATE) in talent.endorsement_deal']
  contract_start_date date [note: 'The effective start date of the endorsement contract. Defines when the talent\'s endorsement obligations and usage rights begin. | Column contract_start_date (DATE) in talent.endorsement_deal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in talent.endorsement_deal']
  deal_created_timestamp timestamp [note: 'The date and time when this endorsement deal record was first created in the system. Used for audit and deal pipeline tracking. | Column deal_created_timestamp (TIMESTAMP) in talent.endorsement_deal']
  deal_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the deal value is denominated (e.g., USD, EUR, GBP). | Column deal_currency_code (STRING) in talent.endorsement_deal']
  deal_last_modified_timestamp timestamp [note: 'The date and time when this endorsement deal record was last updated. Used for audit and change tracking. | Column deal_last_modified_timestamp (TIMESTAMP) in talent.endorsement_deal']
  deal_status varchar [note: 'The current lifecycle status of the endorsement deal. Tracks the deal from negotiation through active performance to completion or termination. | Column deal_status (STRING) in talent.endorsement_deal']
  deal_value_amount decimal(18,2) [note: 'The total monetary value of the endorsement deal. This is the contracted compensation amount for the talent\'s endorsement services, which varies by talent-advertiser combination and belongs to the deal itself. | Column deal_value_amount (DECIMAL(18,2)) in talent.endorsement_deal']
  exclusivity_period_end date [note: 'The end date of the exclusivity period. After this date, the talent may be free to endorse competitors even if the contract is still active. | Column exclusivity_period_end (DATE) in talent.endorsement_deal']
  exclusivity_period_start date [note: 'The start date of any exclusivity period during which the talent cannot endorse competing brands in the same category. May differ from contract start date. | Column exclusivity_period_start (DATE) in talent.endorsement_deal']
  exclusivity_scope varchar [note: 'Defines the product category or competitive scope of the exclusivity clause (e.g., \'automotive\', \'luxury watches\', \'soft drinks\'). Determines which competing brands the talent cannot endorse during the exclusivity period. | Column exclusivity_scope (STRING) in talent.endorsement_deal']
  morals_clause_flag boolean [note: 'Indicates whether the deal includes a morals clause allowing the advertiser to terminate if the talent engages in conduct that damages their brand reputation. | Column morals_clause_flag (BOOLEAN) in talent.endorsement_deal']
  payment_schedule varchar [note: 'The agreed payment schedule for the deal value (e.g., \'Lump Sum on Signing\', \'Quarterly Installments\', \'50% upfront, 50% on completion\'). Defines how the deal value is disbursed over time. | Column payment_schedule (STRING) in talent.endorsement_deal']
  performance_deliverables varchar [note: 'Description of the specific deliverables the talent must provide (e.g., \'2 TV commercials, 4 social media posts per month, 1 live event appearance\'). Defines the scope of work for this deal. | Column performance_deliverables (STRING) in talent.endorsement_deal']
  renewal_deadline_date date [note: 'The deadline by which the advertiser must exercise their renewal option, if applicable. After this date, the talent is free to negotiate with other advertisers. | Column renewal_deadline_date (DATE) in talent.endorsement_deal']
  renewal_option_flag boolean [note: 'Indicates whether the advertiser has an option to renew the endorsement deal under predefined terms. Used for pipeline forecasting and talent availability planning. | Column renewal_option_flag (BOOLEAN) in talent.endorsement_deal']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.endorsement_deal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.endorsement_deal']
  usage_media_types varchar [note: 'The media channels where the advertiser is permitted to use the talent\'s endorsement (e.g., \'TV, Digital, Print\', \'Social Media Only\', \'All Media\'). Defines the scope of usage rights. | Column usage_media_types (STRING) in talent.endorsement_deal']
  usage_territory varchar [note: 'The geographic territory or market where the advertiser has rights to use the talent\'s likeness and endorsement (e.g., \'North America\', \'Global\', \'EU + UK\'). This is deal-specific and varies by advertiser. | Column usage_territory (STRING) in talent.endorsement_deal']

  Note: 'This association product represents the commercial contract between talent_profile and sales_account for endorsement, licensing, or brand ambassador arrangements. It captures the business terms, territorial scope, exclusivity constraints, and financial arrangements that exist only in the context of this specific talent-advertiser relationship. Each record links one talent to one sales account (advertiser/brand) with deal-specific attributes that belong to neither the talent profile nor the sales account alone.. Existence Justification: In the media broadcasting industry, talent can simultaneously hold endorsement deals with multiple non-competing advertisers (e.g., a celebrity endorses a car brand, a beverage brand, and a fashion brand at the same time), and each advertiser/sales account contracts with multiple talent for their campaigns. The business actively manages these endorsement deals as distinct commercial contracts with deal-specific terms including compensation, exclusivity scope, territorial rights, usage permissions, and performance deliverables that belong to neither the talent profile nor the sales account alone. | Unity Catalog table: media_broadcasting_ecm.talent.endorsement_deal Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

Table talent.facility_access {
  facility_access_id varchar [pk, note: 'Unique identifier for this facility access authorization record. Primary key. | Column facility_access_id (BIGINT) in talent.facility_access']
  authorized_by_employee_id varchar [note: 'Foreign key reference to the employee who authorized this facility access. Used for accountability and audit trail purposes. | Column authorized_by_employee_id (BIGINT) in workforce.facility_access']
  broadcast_facility_id varchar [note: 'Foreign key linking to the broadcast facility where access is authorized | Column broadcast_facility_id (BIGINT) in technology.facility_access']
  talent_profile_id varchar [note: 'Foreign key linking to the talent profile being granted facility access | Column talent_profile_id (BIGINT) in talent.facility_access']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.facility_access']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in talent.facility_access']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in talent.facility_access']
  access_level varchar [note: 'The level of physical access granted to the talent at this facility. Determines which areas and zones within the facility the talent can enter. Values: public_areas, studio_floor, control_room, master_control, noc, restricted, executive. | Column access_level (STRING) in talent.facility_access']
  access_purpose varchar [note: 'Business reason for granting facility access to this talent (e.g., production work, rehearsal, meeting, interview, tour). Used for compliance and security auditing. | Column access_purpose (STRING) in talent.facility_access']
  access_status varchar [note: 'Current lifecycle status of this facility access authorization. Determines whether the access is currently valid and usable. Values: active, inactive, suspended, revoked. | Column access_status (STRING) in talent.facility_access']
  authorization_date date [note: 'Date when this facility access authorization was granted. | Column authorization_date (DATE) in talent.facility_access']
  background_check_date date [note: 'Date when the most recent background check was completed for this talent at this facility. Required for certain facility types with high security classification. | Column background_check_date (DATE) in talent.facility_access']
  badge_issue_date date [note: 'Date when the access badge was issued to the talent for this facility. | Column badge_issue_date (DATE) in talent.facility_access']
  badge_number varchar [note: 'Unique physical or digital badge identifier issued to the talent for access to this specific facility. Used by access control systems to grant entry and track movement within the facility. | Column badge_number (STRING) in talent.facility_access']
  clearance_expiration_date date [note: 'Date when the security clearance for this talent at this facility expires and requires renewal. Critical for maintaining continuous access authorization and compliance with security policies. | Column clearance_expiration_date (DATE) in talent.facility_access']
  clearance_status varchar [note: 'Current security clearance status for this talent at this specific facility. Determines whether the talent is authorized to access the facility. Values: active, pending, expired, revoked, suspended. | Column clearance_status (STRING) in talent.facility_access']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in talent.facility_access']
  created_timestamp timestamp [note: 'Timestamp when this facility access authorization record was first created in the system. | Column created_timestamp (TIMESTAMP) in talent.facility_access']
  escort_required_flag boolean [note: 'Indicates whether the talent must be accompanied by an authorized escort when accessing this facility. Used for visitors, contractors, or talent with limited clearance levels. | Column escort_required_flag (BOOLEAN) in talent.facility_access']
  insurance_verified_flag boolean [note: 'Indicates whether production insurance coverage has been verified for this talent at this facility. Required before granting access for production work. | Column insurance_verified_flag (BOOLEAN) in talent.facility_access']
  last_access_timestamp timestamp [note: 'Timestamp of the most recent physical access event when the talent entered this facility. Used for security auditing, compliance tracking, and identifying inactive access authorizations. | Column last_access_timestamp (TIMESTAMP) in talent.facility_access']
  last_updated_timestamp timestamp [note: 'Timestamp when this facility access authorization record was most recently modified. | Column last_updated_timestamp (TIMESTAMP) in talent.facility_access']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.facility_access']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.facility_access']

  Note: 'This association product represents the access authorization relationship between talent and broadcast facilities. It captures security clearance, physical access permissions, and compliance tracking for talent working at or visiting specific facilities. Each record links one talent profile to one broadcast facility with attributes that govern access rights, badge issuance, and security compliance requirements specific to that talent-facility combination.. Existence Justification: In media broadcasting operations, talent routinely work across multiple facilities (studios, remote locations, network operations centers) throughout their careers and even within single production cycles. Each facility hosts hundreds of different talent over time. Facility management and security teams actively manage access authorizations as a distinct operational process, tracking clearance status, badge issuance, access levels, and expiration dates specific to each talent-facility pairing to ensure security compliance, insurance verification, and union requirements are met. | Unity Catalog table: media_broadcasting_ecm.talent.facility_access Talent/residuals entity supporting contract+compensation_structure+guild_affiliation+cba_rate_card+residual_payment flows.'
}

