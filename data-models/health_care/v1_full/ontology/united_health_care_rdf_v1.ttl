ind:culturalCompetencyTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Cultural Competency Training Date' ;
    rdfs:comment 'The date on which the team member completed cultural competency training required for diverse patient populations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hipaaTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Hipaa Training Date' ;
    rdfs:comment 'The date on which the team member completed required HIPAA privacy and security training.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:careManagementCertification rdf:type rdf:Property ;
    rdfs:label 'Care Management Certification' ;
    rdfs:comment 'The type of care management certification held by the team member (e.g., CCM for Certified Case Manager, ACM for Accredited Case Manager).' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chronicConditionSpecialties rdf:type rdf:Property ;
    rdfs:label 'Chronic Condition Specialties' ;
    rdfs:comment 'Comma-separated list of chronic conditions or disease states in which the team member has specialized training or expertise (e.g., diabetes, CHF, COPD, asthma).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccExpertiseCodes rdf:type rdf:Property ;
    rdfs:label 'Hcc Expertise Codes' ;
    rdfs:comment 'Comma-separated list of HCC codes representing chronic conditions for which the team member has specialized clinical expertise.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vbcProgramParticipation rdf:type rdf:Property ;
    rdfs:label 'Vbc Program Participation' ;
    rdfs:comment 'Comma-separated list of value-based care programs or alternative payment models in which the team member participates (e.g., ACO, PCMH, bundled payments).' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisMeasureResponsibility rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Responsibility' ;
    rdfs:comment 'Comma-separated list of HEDIS quality measures for which this team member has accountability or reporting responsibility.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:afterHoursAvailability rdf:type rdf:Property ;
    rdfs:label 'After Hours Availability' ;
    rdfs:comment 'Indicates whether the team member is available for care coordination or clinical consultation outside of standard business hours.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weekendAvailability rdf:type rdf:Property ;
    rdfs:label 'Weekend Availability' ;
    rdfs:comment 'Indicates whether the team member is available for care coordination or clinical services on weekends.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ehrSystemAccess rdf:type rdf:Property ;
    rdfs:label 'Ehr System Access' ;
    rdfs:comment 'The name or identifier of the EHR system(s) to which the team member has access for viewing and documenting patient care information.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieParticipation rdf:type rdf:Property ;
    rdfs:label 'Hie Participation' ;
    rdfs:comment 'Indicates whether the team member participates in health information exchange networks for sharing patient data across care settings.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prescribingAuthority rdf:type rdf:Property ;
    rdfs:label 'Prescribing Authority' ;
    rdfs:comment 'Indicates whether the team member has legal authority to prescribe medications.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:controlledSubstanceAuthority rdf:type rdf:Property ;
    rdfs:label 'Controlled Substance Authority' ;
    rdfs:comment 'Indicates whether the team member has authority to prescribe controlled substances (Schedule II-V medications).' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorAuthorizationAuthority rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Authority' ;
    rdfs:comment 'Indicates whether the team member has authority to approve or deny prior authorization requests for medical services or medications.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carePlanSigningAuthority rdf:type rdf:Property ;
    rdfs:label 'Care Plan Signing Authority' ;
    rdfs:comment 'Indicates whether the team member has authority to sign and approve care plans for members.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supervisorNpi rdf:type rdf:Property ;
    rdfs:label 'Supervisor Npi' ;
    rdfs:comment 'The NPI of the supervising provider or clinical director who oversees this team member\'s care management activities.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentType rdf:type rdf:Property ;
    rdfs:label 'Employment Type' ;
    rdfs:comment 'The employment relationship type between the team member and the health plan or care management organization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ftePercentage rdf:type rdf:Property ;
    rdfs:label 'Fte Percentage' ;
    rdfs:comment 'The percentage of full-time equivalent hours dedicated to care team activities (e.g., 100.00 for full-time, 50.00 for half-time).' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'The financial cost center code to which the team member\'s activities and expenses are allocated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentCode rdf:type rdf:Property ;
    rdfs:label 'Department Code' ;
    rdfs:comment 'The organizational department code to which the team member is assigned (e.g., care management, utilization management, disease management).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobAssignment rdf:type rdf:Property ;
    rdfs:label 'Lob Assignment' ;
    rdfs:comment 'The primary line of business or product segment to which the team member is assigned for care management activities.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityScore rdf:type rdf:Property ;
    rdfs:label 'Quality Score' ;
    rdfs:comment 'The team member\'s quality performance score based on HEDIS measures, patient outcomes, and care management effectiveness metrics.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCredentialingDate rdf:type rdf:Property ;
    rdfs:label 'Last Credentialing Date' ;
    rdfs:comment 'The date on which the team member\'s credentials were last verified and approved through the credentialing process.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextCredentialingDate rdf:type rdf:Property ;
    rdfs:label 'Next Credentialing Date' ;
    rdfs:comment 'The date on which the team member\'s credentials are due for re-verification and renewal.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:malpracticeInsuranceCarrier rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Carrier' ;
    rdfs:comment 'The name of the insurance carrier providing professional liability (malpractice) coverage for the team member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'The date on which the most recent background check was completed for the team member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backgroundCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Background Check Status' ;
    rdfs:comment 'The result status of the team member\'s background check screening.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionsCheckDate rdf:type rdf:Property ;
    rdfs:label 'Sanctions Check Date' ;
    rdfs:comment 'The date on which the team member was last screened against federal and state exclusion lists (OIG, SAM, state Medicaid exclusions).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sanctionsCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Sanctions Check Status' ;
    rdfs:comment 'The result status of the team member\'s screening against federal and state exclusion and sanctions lists.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationNotes rdf:type rdf:Property ;
    rdfs:label 'Termination Notes' ;
    rdfs:comment 'Additional notes or details regarding the team member\'s termination or departure from the care team.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rehireEligible rdf:type rdf:Property ;
    rdfs:label 'Rehire Eligible' ;
    rdfs:comment 'Indicates whether the team member is eligible for rehire or reassignment to future care teams.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:classificationId rdf:type rdf:Property ;
    rdfs:label 'Classification Id' ;
    rdfs:comment 'Unique identifier for the claim classification record mapping diagnoses to payment groupings.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drgVersion rdf:type rdf:Property ;
    rdfs:label 'Drg Version' ;
    rdfs:comment 'Version identifier of the DRG classification system used (e.g., MS-DRG v40, APR-DRG v38).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgType rdf:type rdf:Property ;
    rdfs:label 'Drg Type' ;
    rdfs:comment 'Specific DRG methodology applied: Medicare Severity DRG, All Patient Refined DRG, All Patient DRG, or International Refined DRG.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgGeometricMeanLos rdf:type rdf:Property ;
    rdfs:label 'Drg Geometric Mean Los' ;
    rdfs:comment 'Geometric mean length of stay in days for the assigned DRG, used to identify outlier cases.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drgArithmeticMeanLos rdf:type rdf:Property ;
    rdfs:label 'Drg Arithmetic Mean Los' ;
    rdfs:comment 'Arithmetic mean length of stay in days for the assigned DRG.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:apcVersion rdf:type rdf:Property ;
    rdfs:label 'Apc Version' ;
    rdfs:comment 'Version identifier of the APC classification system used for the payment period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apcRelativeWeight rdf:type rdf:Property ;
    rdfs:label 'Apc Relative Weight' ;
    rdfs:comment 'Relative payment weight assigned to the APC reflecting the resource intensity of the service.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:apcPaymentRate rdf:type rdf:Property ;
    rdfs:label 'Apc Payment Rate' ;
    rdfs:comment 'National unadjusted payment rate for the assigned APC before geographic and policy adjustments.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:apcStatusIndicator rdf:type rdf:Property ;
    rdfs:label 'Apc Status Indicator' ;
    rdfs:comment 'Single-character code indicating the payment methodology for the APC (e.g., S=Significant Procedure, T=Surgical Procedure, V=Clinic Visit).' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:majorDiagnosticCategory rdf:type rdf:Property ;
    rdfs:label 'Major Diagnostic Category' ;
    rdfs:comment 'Broad clinical category (00-25) grouping diagnoses by body system or disease etiology, used as first step in DRG assignment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mdcDescription rdf:type rdf:Property ;
    rdfs:label 'Mdc Description' ;
    rdfs:comment 'Full text description of the Major Diagnostic Category (e.g., Diseases and Disorders of the Nervous System).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mortalityRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Mortality Risk Level' ;
    rdfs:comment 'Classification of patient mortality risk based on clinical factors, primarily used in APR-DRG methodology.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complicationComorbidityLevel rdf:type rdf:Property ;
    rdfs:label 'Complication Comorbidity Level' ;
    rdfs:comment 'Indicator of whether the claim includes complications or comorbidities (CC) or major complications or comorbidities (MCC) affecting DRG assignment and payment.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Principal Diagnosis Code' ;
    rdfs:comment 'ICD-10-CM diagnosis code representing the condition established after study to be chiefly responsible for the admission, used as primary input for classification.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalProcedureCode rdf:type rdf:Property ;
    rdfs:label 'Principal Procedure Code' ;
    rdfs:comment 'ICD-10-PCS procedure code for the principal procedure performed during the inpatient stay, key factor in DRG assignment.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surgicalIndicator rdf:type rdf:Property ;
    rdfs:label 'Surgical Indicator' ;
    rdfs:comment 'Flag indicating whether the claim includes a surgical procedure, affecting DRG/APC classification pathway.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grouperVersion rdf:type rdf:Property ;
    rdfs:label 'Grouper Version' ;
    rdfs:comment 'Version identifier of the grouper software used to assign the DRG or APC classification.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grouperReturnCode rdf:type rdf:Property ;
    rdfs:label 'Grouper Return Code' ;
    rdfs:comment 'Code returned by the grouper software indicating the result status of the classification process (e.g., success, warning, error).' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grouperErrorMessage rdf:type rdf:Property ;
    rdfs:label 'Grouper Error Message' ;
    rdfs:comment 'Descriptive error or warning message returned by the grouper software if classification encountered issues.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientAgeYears rdf:type rdf:Property ;
    rdfs:label 'Patient Age Years' ;
    rdfs:comment 'Patient\'s age in years at the time of admission or service, used as a factor in DRG/APC assignment.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientAgeDays rdf:type rdf:Property ;
    rdfs:label 'Patient Age Days' ;
    rdfs:comment 'Patient\'s age in days for neonates and infants, used in specific DRG assignments for pediatric cases.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientSex rdf:type rdf:Property ;
    rdfs:label 'Patient Sex' ;
    rdfs:comment 'Patient\'s biological sex (Male, Female, Unknown) used in DRG assignment for sex-specific conditions.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:birthWeightGrams rdf:type rdf:Property ;
    rdfs:label 'Birth Weight Grams' ;
    rdfs:comment 'Newborn\'s birth weight in grams, critical factor for neonatal DRG assignment.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lengthOfStayDays rdf:type rdf:Property ;
    rdfs:label 'Length Of Stay Days' ;
    rdfs:comment 'Total number of days the patient remained in the facility, used to identify outlier cases for additional payment.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outlierIndicator rdf:type rdf:Property ;
    rdfs:label 'Outlier Indicator' ;
    rdfs:comment 'Flag indicating whether the claim qualifies for outlier payment due to extraordinarily high costs or extended length of stay.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outlierPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Outlier Payment Amount' ;
    rdfs:comment 'Additional payment amount approved for outlier cases exceeding cost or length of stay thresholds.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferIndicator rdf:type rdf:Property ;
    rdfs:label 'Transfer Indicator' ;
    rdfs:comment 'Flag indicating whether the claim represents a transfer case, which may result in adjusted DRG payment.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferDrgPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Transfer Drg Payment Amount' ;
    rdfs:comment 'Adjusted DRG payment amount for transfer cases, calculated based on per diem rates.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseDrgPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Base Drg Payment Amount' ;
    rdfs:comment 'Standard DRG payment amount before adjustments for outliers, transfers, or other payment policies.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wageIndex rdf:type rdf:Property ;
    rdfs:label 'Wage Index' ;
    rdfs:comment 'Geographic adjustment factor applied to the labor portion of the DRG payment based on the provider\'s location.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costOutlierThreshold rdf:type rdf:Property ;
    rdfs:label 'Cost Outlier Threshold' ;
    rdfs:comment 'Cost threshold amount that must be exceeded for the claim to qualify for outlier payment.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingDrgPayment rdf:type rdf:Property ;
    rdfs:label 'Operating Drg Payment' ;
    rdfs:comment 'Operating payment component of the DRG payment covering routine operating costs.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalDrgPayment rdf:type rdf:Property ;
    rdfs:label 'Capital Drg Payment' ;
    rdfs:comment 'Capital payment component of the DRG payment covering capital-related costs.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disproportionateSharePayment rdf:type rdf:Property ;
    rdfs:label 'Disproportionate Share Payment' ;
    rdfs:comment 'Additional payment for hospitals serving a disproportionate share of low-income patients.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indirectMedicalEducationPayment rdf:type rdf:Property ;
    rdfs:label 'Indirect Medical Education Payment' ;
    rdfs:comment 'Additional payment for teaching hospitals to account for higher costs associated with medical education programs.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newTechnologyAddonPayment rdf:type rdf:Property ;
    rdfs:label 'New Technology Addon Payment' ;
    rdfs:comment 'Additional payment for new medical technologies and services not adequately reflected in standard DRG payments.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readmissionIndicator rdf:type rdf:Property ;
    rdfs:label 'Readmission Indicator' ;
    rdfs:comment 'Flag indicating whether the admission is a readmission within a specified timeframe, potentially subject to payment penalties.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readmissionPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Readmission Penalty Amount' ;
    rdfs:comment 'Payment reduction amount applied due to excess readmissions under the Hospital Readmissions Reduction Program.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueBasedPurchasingAdjustment rdf:type rdf:Property ;
    rdfs:label 'Value Based Purchasing Adjustment' ;
    rdfs:comment 'Payment adjustment (positive or negative) based on hospital performance on quality measures under the VBP program.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hospitalAcquiredConditionPenalty rdf:type rdf:Property ;
    rdfs:label 'Hospital Acquired Condition Penalty' ;
    rdfs:comment 'Payment reduction applied to hospitals with high rates of hospital-acquired conditions.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:presentOnAdmissionIndicator rdf:type rdf:Property ;
    rdfs:label 'Present On Admission Indicator' ;
    rdfs:comment 'Code indicating whether the principal diagnosis was present at the time of admission (Y=Yes, N=No, U=Unknown, W=Clinically Undetermined, 1=Exempt).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareSeverityLevel rdf:type rdf:Property ;
    rdfs:label 'Medicare Severity Level' ;
    rdfs:comment 'Numeric severity level (0-3) assigned in MS-DRG methodology based on presence and severity of complications and comorbidities.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overrideReasonCode rdf:type rdf:Property ;
    rdfs:label 'Override Reason Code' ;
    rdfs:comment 'Code indicating the reason for manual override of the automated classification assignment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Override Reason Description' ;
    rdfs:comment 'Detailed explanation of why the automated classification was manually overridden.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityReportingIndicator rdf:type rdf:Property ;
    rdfs:label 'Quality Reporting Indicator' ;
    rdfs:comment 'Flag indicating whether the classification is subject to quality measure reporting requirements (HEDIS, CAHPS, etc.).' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditReason rdf:type rdf:Property ;
    rdfs:label 'Audit Reason' ;
    rdfs:comment 'Reason why the classification was flagged for audit (e.g., high payment amount, unusual DRG, coding inconsistency).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionId rdf:type rdf:Property ;
    rdfs:label 'Intervention Id' ;
    rdfs:comment 'Unique identifier for the care intervention record. Primary key for the intervention entity.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Intervention .

ind:outcome rdf:type rdf:Property ;
    rdfs:label 'Outcome' ;
    rdfs:comment 'The documented outcome or result of the intervention (e.g., successful, member declined, unable to reach).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Date' ;
    rdfs:comment 'The date on which the intervention was originally scheduled to occur.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledStartTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Time' ;
    rdfs:comment 'The precise date and time when the intervention was scheduled to begin.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledEndTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Time' ;
    rdfs:comment 'The precise date and time when the intervention was scheduled to end.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Start Timestamp' ;
    rdfs:comment 'The actual date and time when the intervention began.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual End Timestamp' ;
    rdfs:comment 'The actual date and time when the intervention was completed or ended.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deliveryChannel rdf:type rdf:Property ;
    rdfs:label 'Delivery Channel' ;
    rdfs:comment 'The channel or setting through which the intervention was accessed (e.g., office, home, telephonic, digital platform).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryLocation rdf:type rdf:Property ;
    rdfs:label 'Delivery Location' ;
    rdfs:comment 'The physical or virtual location where the intervention was delivered (e.g., clinic address, member home, telehealth platform).' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careManagerName rdf:type rdf:Property ;
    rdfs:label 'Care Manager Name' ;
    rdfs:comment 'Full name of the care manager or case manager who delivered the intervention.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careManagerRole rdf:type rdf:Property ;
    rdfs:label 'Care Manager Role' ;
    rdfs:comment 'The professional role or credential of the care manager who delivered the intervention (e.g., RN, social worker, health educator).' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careManagerCredential rdf:type rdf:Property ;
    rdfs:label 'Care Manager Credential' ;
    rdfs:comment 'Professional credentials or certifications held by the care manager (e.g., RN, LCSW, CCM, CDE).' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goal rdf:type rdf:Property ;
    rdfs:label 'Goal' ;
    rdfs:comment 'The specific goal or objective that the intervention is designed to achieve (e.g., improve medication adherence, reduce hospital readmissions).' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetMetric rdf:type rdf:Property ;
    rdfs:label 'Target Metric' ;
    rdfs:comment 'The measurable metric or outcome that the intervention is targeting (e.g., HbA1c level, blood pressure, medication adherence rate).' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postInterventionValue rdf:type rdf:Property ;
    rdfs:label 'Post Intervention Value' ;
    rdfs:comment 'The measurement or value of the target metric after the intervention was delivered, used to assess effectiveness.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberFeedback rdf:type rdf:Property ;
    rdfs:label 'Member Feedback' ;
    rdfs:comment 'Free-text feedback or comments provided by the member about the intervention experience.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionPlan rdf:type rdf:Property ;
    rdfs:label 'Action Plan' ;
    rdfs:comment 'The action plan or next steps agreed upon with the member following the intervention.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpType rdf:type rdf:Property ;
    rdfs:label 'Follow Up Type' ;
    rdfs:comment 'The type of follow-up intervention or contact planned (e.g., phone call, visit, assessment).' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralMadeFlag rdf:type rdf:Property ;
    rdfs:label 'Referral Made Flag' ;
    rdfs:comment 'Boolean indicator of whether a referral to another provider, specialist, or service was made as part of the intervention.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Referral Provider Npi' ;
    rdfs:comment 'The NPI of the provider or organization to which the member was referred.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralReason rdf:type rdf:Property ;
    rdfs:label 'Referral Reason' ;
    rdfs:comment 'The clinical or care management reason for making the referral.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:educationalMaterialsProvided rdf:type rdf:Property ;
    rdfs:label 'Educational Materials Provided' ;
    rdfs:comment 'List or description of educational materials, resources, or tools provided to the member during the intervention.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageOfService rdf:type rdf:Property ;
    rdfs:label 'Language Of Service' ;
    rdfs:comment 'The language in which the intervention was delivered to the member.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterUsedFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Used Flag' ;
    rdfs:comment 'Boolean indicator of whether a language interpreter was used during the intervention.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpreterType rdf:type rdf:Property ;
    rdfs:label 'Interpreter Type' ;
    rdfs:comment 'The type of interpreter service used (e.g., in-person, telephonic, video).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:culturalConsiderations rdf:type rdf:Property ;
    rdfs:label 'Cultural Considerations' ;
    rdfs:comment 'Documentation of cultural, religious, or personal preferences considered during the intervention delivery.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibilityAccommodations rdf:type rdf:Property ;
    rdfs:label 'Accessibility Accommodations' ;
    rdfs:comment 'Description of accessibility accommodations provided (e.g., wheelchair access, hearing assistance, large print materials).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costToMember rdf:type rdf:Property ;
    rdfs:label 'Cost To Member' ;
    rdfs:comment 'The out-of-pocket cost to the member for the intervention, if any (e.g., copay, coinsurance).' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costToPlan rdf:type rdf:Property ;
    rdfs:label 'Cost To Plan' ;
    rdfs:comment 'The cost incurred by the health plan for delivering the intervention.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestId rdf:type rdf:Property ;
    rdfs:label 'Request Id' ;
    rdfs:comment 'Identifier for the prior authorization associated with the intervention, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Request .

ind:hedisMeasureApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Applicable Flag' ;
    rdfs:comment 'Boolean indicator of whether this intervention contributes to HEDIS quality measure reporting.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:starsMeasureApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Stars Measure Applicable Flag' ;
    rdfs:comment 'Boolean indicator of whether this intervention contributes to Medicare Stars quality rating measures.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityImprovementInitiative rdf:type rdf:Property ;
    rdfs:label 'Quality Improvement Initiative' ;
    rdfs:comment 'The quality improvement or population health initiative that this intervention supports.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained Flag' ;
    rdfs:comment 'Boolean indicator of whether member consent was obtained for the intervention and data collection.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentType rdf:type rdf:Property ;
    rdfs:label 'Consent Type' ;
    rdfs:comment 'The type of consent obtained from the member (e.g., verbal, written, electronic).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Compliant Flag' ;
    rdfs:comment 'Boolean indicator of whether the intervention was delivered in compliance with HIPAA privacy and security requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancelledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancelled Timestamp' ;
    rdfs:comment 'The date and time when the intervention was cancelled, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rescheduledFromInterventionId rdf:type rdf:Property ;
    rdfs:label 'Rescheduled From Intervention Id' ;
    rdfs:comment 'Identifier of the original intervention record if this intervention is a rescheduled version.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contactAttemptNumber rdf:type rdf:Property ;
    rdfs:label 'Contact Attempt Number' ;
    rdfs:comment 'The sequential number of contact attempts made to reach the member for this intervention.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contactSuccessfulFlag rdf:type rdf:Property ;
    rdfs:label 'Contact Successful Flag' ;
    rdfs:comment 'Boolean indicator of whether contact with the member was successfully established.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noShowFlag rdf:type rdf:Property ;
    rdfs:label 'No Show Flag' ;
    rdfs:comment 'Boolean indicator of whether the member failed to attend a scheduled intervention without prior notice.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationCompleteFlag rdf:type rdf:Property ;
    rdfs:label 'Documentation Complete Flag' ;
    rdfs:comment 'Boolean indicator of whether all required documentation for the intervention has been completed.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Documentation Completed Date' ;
    rdfs:comment 'The date on which all intervention documentation was completed.' ;
    rdfs:domain ind:Intervention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cohortMemberId rdf:type rdf:Property ;
    rdfs:label 'Cohort Member Id' ;
    rdfs:comment 'Unique identifier for the cohort member assignment record, serving as the primary key for tracking member enrollment in specific care management cohorts.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cohortId rdf:type rdf:Property ;
    rdfs:label 'Cohort Id' ;
    rdfs:comment 'Unique identifier for the care management cohort to which the member is assigned, linking to the cohort definition.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cohort .

ind:disenrollmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Disenrollment Timestamp' ;
    rdfs:comment 'Precise timestamp when the member was disenrolled from the cohort, including time of day for audit and tracking purposes.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:enrollmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Enrollment Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason or criteria that qualified the member for inclusion in the cohort, such as chronic condition diagnosis, risk score threshold, or HEDIS gap.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Enrollment Reason Description' ;
    rdfs:comment 'Detailed textual description of the reason or criteria that qualified the member for cohort enrollment, providing context beyond the code.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disenrollmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Disenrollment Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for the member\'s removal from the cohort, such as program completion, member request, loss of eligibility, or death.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disenrollmentReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Disenrollment Reason Description' ;
    rdfs:comment 'Detailed textual description of the reason for cohort disenrollment, providing context beyond the code.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referringProviderProviderProfileId rdf:type rdf:Property ;
    rdfs:label 'Referring Provider Provider Profile Id' ;
    rdfs:comment 'Unique identifier for the provider who referred the member to the cohort, if applicable, linking to the provider master record.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Profile .

ind:audienceSegmentId rdf:type rdf:Property ;
    rdfs:label 'Audience Segment Id' ;
    rdfs:comment 'The segment identifier for Medicare Advantage plans, further specifying benefit variations within a PBP.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AudienceSegment .

ind:consentStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Status' ;
    rdfs:comment 'Status indicating whether the member has provided consent to participate in the care management program, as required by HIPAA and state regulations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optOutFlag rdf:type rdf:Property ;
    rdfs:label 'Opt Out Flag' ;
    rdfs:comment 'Boolean indicator of whether the member has opted out of the care management program or specific outreach activities.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutDate rdf:type rdf:Property ;
    rdfs:label 'Opt Out Date' ;
    rdfs:comment 'The date when the member opted out of the care management program, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:optOutReason rdf:type rdf:Property ;
    rdfs:label 'Opt Out Reason' ;
    rdfs:comment 'Textual description of the reason the member opted out of the care management program, supporting program improvement efforts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextOutreachDate rdf:type rdf:Property ;
    rdfs:label 'Next Outreach Date' ;
    rdfs:comment 'The date when the next care manager outreach to the member is scheduled or planned.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engagementLevel rdf:type rdf:Property ;
    rdfs:label 'Engagement Level' ;
    rdfs:comment 'Assessment of the member\'s level of engagement and participation in the care management program based on response to outreach and adherence to care plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementScore rdf:type rdf:Property ;
    rdfs:label 'Engagement Score' ;
    rdfs:comment 'Quantitative score representing the member\'s level of engagement in the care management program, calculated based on outreach response rates, care plan adherence, and program participation.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gapClosureTargetDate rdf:type rdf:Property ;
    rdfs:label 'Gap Closure Target Date' ;
    rdfs:comment 'The target date by which identified care gaps or HEDIS measure gaps should be closed for the member, supporting quality improvement goals.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:carePlanStatus rdf:type rdf:Property ;
    rdfs:label 'Care Plan Status' ;
    rdfs:comment 'Current status of the care plan associated with the member\'s cohort enrollment, indicating whether it is active, pending development, or completed.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carePlanStartDate rdf:type rdf:Property ;
    rdfs:label 'Care Plan Start Date' ;
    rdfs:comment 'The date when the care plan for the member became active, marking the beginning of structured care management interventions.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:carePlanEndDate rdf:type rdf:Property ;
    rdfs:label 'Care Plan End Date' ;
    rdfs:comment 'The date when the care plan for the member was completed or terminated, marking the end of structured care management interventions.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interventionCount rdf:type rdf:Property ;
    rdfs:label 'Intervention Count' ;
    rdfs:comment 'The total number of care management interventions or activities completed for the member during their cohort enrollment period.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hospitalizationCount rdf:type rdf:Property ;
    rdfs:label 'Hospitalization Count' ;
    rdfs:comment 'The number of inpatient hospitalizations the member experienced during their cohort enrollment period, used to track program effectiveness.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:erVisitCount rdf:type rdf:Property ;
    rdfs:label 'Er Visit Count' ;
    rdfs:comment 'The number of emergency room visits the member experienced during their cohort enrollment period, used to track program effectiveness and potentially preventable utilization.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readmissionFlag rdf:type rdf:Property ;
    rdfs:label 'Readmission Flag' ;
    rdfs:comment 'Boolean indicator of whether the member experienced a 30-day hospital readmission during their cohort enrollment period, a key quality and cost metric.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalCostOfCare rdf:type rdf:Property ;
    rdfs:label 'Total Cost Of Care' ;
    rdfs:comment 'The total healthcare costs incurred for the member during their cohort enrollment period, including medical, pharmacy, and other covered services, used to measure program ROI.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pmpmCost rdf:type rdf:Property ;
    rdfs:label 'Pmpm Cost' ;
    rdfs:comment 'The average monthly healthcare cost for the member during their cohort enrollment period, calculated as total cost divided by enrollment months.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baselinePmpmCost rdf:type rdf:Property ;
    rdfs:label 'Baseline Pmpm Cost' ;
    rdfs:comment 'The member\'s average monthly healthcare cost prior to cohort enrollment, used as a baseline for measuring program impact on cost reduction.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costSavingsAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Savings Amount' ;
    rdfs:comment 'The estimated cost savings achieved for the member during their cohort enrollment period compared to baseline or predicted costs, demonstrating program value.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityMeasureImprovementCount rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Improvement Count' ;
    rdfs:comment 'The number of HEDIS or other quality measures for which the member showed improvement or gap closure during their cohort enrollment period.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programCompletionFlag rdf:type rdf:Property ;
    rdfs:label 'Program Completion Flag' ;
    rdfs:comment 'Boolean indicator of whether the member successfully completed the care management program according to defined criteria and goals.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:programCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Program Completion Date' ;
    rdfs:comment 'The date when the member successfully completed the care management program, if applicable.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:autoRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Flag' ;
    rdfs:comment 'Boolean indicator of whether the member\'s cohort enrollment is set to automatically renew for subsequent program periods based on continued eligibility.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalCohortId rdf:type rdf:Property ;
    rdfs:label 'External Cohort Id' ;
    rdfs:comment 'The cohort identifier from the external source system, used for cross-system reconciliation and data lineage tracking.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cohort .

ind:externalMemberId rdf:type rdf:Property ;
    rdfs:label 'External Member Id' ;
    rdfs:comment 'The member identifier from the external source system, used for cross-system reconciliation and data lineage tracking.' ;
    rdfs:domain ind:CohortMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assignment Method' ;
    rdfs:comment 'The method or approach used to assign the member to the cohort, such as automated algorithm, manual review, or predictive modeling.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Assignment Confidence Score' ;
    rdfs:comment 'A confidence score or probability indicating the strength of the cohort assignment based on predictive modeling or rules-based criteria, ranging from 0 to 100.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordCreatedDate rdf:type rdf:Property ;
    rdfs:label 'Record Created Date' ;
    rdfs:comment 'The date when the cohort member assignment record was first created in the system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Record Updated Date' ;
    rdfs:comment 'The date when the cohort member assignment record was last updated or modified in the system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:purpose rdf:type rdf:Property ;
    rdfs:label 'Purpose' ;
    rdfs:comment 'Primary purpose or focus of the care team (e.g., chronic disease management, post-acute care).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceArea rdf:type rdf:Property ;
    rdfs:label 'Service Area' ;
    rdfs:comment 'Geographic region or market segment the care team serves (e.g., state code, ZIP code range).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careModel rdf:type rdf:Property ;
    rdfs:label 'Care Model' ;
    rdfs:comment 'Payment and delivery model under which the care team operates.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositionRules rdf:type rdf:Property ;
    rdfs:label 'Composition Rules' ;
    rdfs:comment 'Business rules defining required roles and ratios within the team.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberPopulation rdf:type rdf:Property ;
    rdfs:label 'Member Population' ;
    rdfs:comment 'Description of member segment the team serves (e.g., Medicare Advantage, HCC high risk).' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccRiskAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Hcc Risk Adjustment Factor' ;
    rdfs:comment 'Average HCC risk score for members assigned to the team.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Primary phone number for the care team.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

