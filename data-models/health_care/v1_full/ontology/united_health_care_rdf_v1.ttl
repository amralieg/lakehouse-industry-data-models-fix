ind:isMedicareAdvantage rdf:type rdf:Property ;
    rdfs:label 'Is Medicare Advantage' ;
    rdfs:comment 'Indicates if the plan is a Medicare Advantage product.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPdp rdf:type rdf:Property ;
    rdfs:label 'Is Pdp' ;
    rdfs:comment 'Indicates if the plan is a Prescription Drug Plan.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSnp rdf:type rdf:Property ;
    rdfs:label 'Is Snp' ;
    rdfs:comment 'Indicates if the plan is a Special Needs Plan.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
