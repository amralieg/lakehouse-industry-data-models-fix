    rdfs:range xsd:string .

ind:planAdministratorName rdf:type rdf:Property ;
    rdfs:label 'Plan Administrator Name' ;
    rdfs:comment 'Name of the individual or department responsible for administering this benefit plan within the organization.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planAdministratorPhone rdf:type rdf:Property ;
    rdfs:label 'Plan Administrator Phone' ;
    rdfs:comment 'Phone number of the plan administrator for employee inquiries and plan management communications.' ;
