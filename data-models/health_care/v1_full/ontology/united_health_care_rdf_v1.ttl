    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentationQualityScore rdf:type rdf:Property ;
    rdfs:label 'Documentation Quality Score' ;
    rdfs:comment 'Quality metric assessing the adequacy of medical record documentation supporting reported diagnoses.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskCaptureOpportunityCount rdf:type rdf:Property ;
