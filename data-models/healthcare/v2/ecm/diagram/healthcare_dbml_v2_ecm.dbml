  termination_date date [note: 'Date on which the health plan\'s participation in this quality program ended or is scheduled to end. Null for ongoing participation.']
  termination_reason varchar [note: 'Reason for termination of participation.']
  updated_date timestamp [note: 'Timestamp when this program participation record was last modified.']
