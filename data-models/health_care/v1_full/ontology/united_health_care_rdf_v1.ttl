    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityImprovementPriority rdf:type rdf:Property ;
    rdfs:label 'Quality Improvement Priority' ;
    rdfs:comment 'Internal priority level assigned to this measure for quality improvement initiatives and resource allocation.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationRequired rdf:type rdf:Property ;
    rdfs:label 'Accreditation Required' ;
    rdfs:comment 'Indicates whether this measure is required for NCQA, URAC, or other accreditation programs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationBody rdf:type rdf:Property ;
    rdfs:label 'Accreditation Body' ;
    rdfs:comment 'Organization requiring this measure for accreditation purposes (e.g., NCQA, URAC, Joint Commission).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required' ;
    rdfs:comment 'Indicates whether this measure must be reported to state or federal regulatory agencies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryAgency rdf:type rdf:Property ;
