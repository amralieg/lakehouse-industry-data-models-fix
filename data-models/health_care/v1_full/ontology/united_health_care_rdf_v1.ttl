    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hearingCoverageType rdf:type rdf:Property ;
    rdfs:label 'Hearing Coverage Type' ;
    rdfs:comment 'Level of hearing benefits included in the plan, including exams and hearing aids.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hearingAidAllowance rdf:type rdf:Property ;
