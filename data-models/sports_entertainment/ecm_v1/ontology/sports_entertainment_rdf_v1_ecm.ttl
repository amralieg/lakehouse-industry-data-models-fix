    rdfs:range xsd:string .

ind:isRenewable rdf:type rdf:Property ;
    rdfs:label 'Is Renewable' ;
    rdfs:comment 'Indicates whether inventory in this category is typically sold on a renewable basis (true) such as season-long or multi-year deals, or as one-time purchases (false).' ;
    rdfs:domain ind:InventoryCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumPurchaseQuantity rdf:type rdf:Property ;
    rdfs:label 'Maximum Purchase Quantity' ;
    rdfs:comment 'Maximum number of units available or allowed for purchase in this inventory category. Null if unlimited or not applicable.' ;
