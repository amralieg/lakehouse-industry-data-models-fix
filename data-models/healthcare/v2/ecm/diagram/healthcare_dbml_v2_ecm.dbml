  credential_number varchar [note: 'Credential number.']
  credential_status varchar [note: 'Credential status (Active, Expired, Suspended, etc.).']
  credential_type varchar [note: 'Credential type (License, Certification, DEA, Board Certification, CME, etc.).']
  days_to_expiration decimal(9,4) [note: 'Days to expiration.']
  dea_business_activity_type varchar [note: 'DEA business activity type.']
  dea_schedule_authorizations varchar [note: 'DEA schedule authorizations (II, III, IV, V).']
  effective_from date [note: 'Effective from date.']
