Table rights.event_blackout_rule {
  event_blackout_rule_id varchar [pk, note: 'Primary key']
  rights_blackout_rule_id varchar [note: 'FK to parent rights_blackout_rule if inheriting']
  sports_event_id varchar [note: 'FK to content.sports_event']
  sports_league_id varchar [note: 'FK to content.sports_league']
  sports_team_id varchar [note: 'FK to content.sports_team (home team triggering blackout)']
  active_flag boolean [note: 'Whether rule is currently active']
  applies_to_live_flag boolean [note: 'Whether blackout applies to live broadcast']
  applies_to_replay_flag boolean [note: 'Whether blackout applies to replay/VOD']
  blackout_window_hours_after varchar [note: 'Hours after event end to lift blackout']
  blackout_window_hours_before varchar [note: 'Hours before event start to begin blackout']
  created_timestamp timestamp [note: 'Record creation timestamp']
  dma_code varchar [note: 'Nielsen DMA code for blackout territory']
  effective_end_date date [note: 'End date of rule effectiveness']
  effective_start_date date [note: 'Start date of rule effectiveness']
  lift_condition varchar [note: 'Condition to lift blackout (e.g., SELLOUT, TIME_DELAY)']
  radius_miles varchar [note: 'Radius in miles from venue for blackout']
  rule_name varchar [note: 'Descriptive name of the blackout rule']
  rule_type varchar [note: 'Type: LOCAL, NATIONAL, OUT_OF_MARKET']
  sellout_exception_flag boolean [note: 'Whether sellout lifts the blackout']
  territory_code varchar [note: 'ISO territory/country code']
  territory_name varchar [note: 'Human-readable territory name']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Defines DMA/territory-specific blackout rules for live sports events, extending the general rights_blackout_rule for event-level granularity.'
}

Table rights.neighbouring_rights_claim {
  neighbouring_rights_claim_id varchar [pk, note: 'Primary key']
  claimant_holder_id varchar [note: 'FK to rights.holder - the party claiming']
  master_recording_id varchar [note: 'FK to content.master_recording']
  claim_status varchar [note: 'Status: pending, verified, disputed, paid']
  claimant_type varchar [note: 'Type of claimant: featured_artist, non_featured_artist, sound_recording_owner']
  collection_society_code varchar [note: 'Collecting society: SoundExchange, PPL, GVL, etc.']
  created_at timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'ISO currency code']
  dispute_reason varchar [note: 'Reason for dispute if status is disputed']
  effective_end_date date [note: 'End date of claim validity']
  effective_start_date date [note: 'Start date of claim validity']
  gross_royalty_amount decimal(18,2) [note: 'Gross royalty amount before deductions']
  isrc_code varchar [note: 'International Standard Recording Code']
  net_royalty_amount decimal(18,2) [note: 'Net royalty amount after fees']
  ownership_share_percent decimal(5,2) [note: 'Percentage ownership share claimed']
  payment_date date [note: 'Date royalty was paid']
  territory_code varchar [note: 'ISO territory code for claim']
  total_plays varchar [note: 'Total non-interactive streams/plays in period']
  updated_at timestamp [note: 'Record last update timestamp']
  usage_period_end_date date [note: 'End of usage reporting period']
  usage_period_start_date date [note: 'Start of usage reporting period']

  Note: 'SoundExchange-style non-interactive digital performance royalty claim for sound recordings'
}

