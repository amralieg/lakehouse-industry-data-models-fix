  superseded_by_obligation_regulatory_obligation_id varchar [note: 'Reference to the regulatory obligation that supersedes this one, if applicable. Null if not superseded. | Column superseded_by_obligation_regulatory_obligation_id (BIGINT) in compliance.regulatory_obligation']
