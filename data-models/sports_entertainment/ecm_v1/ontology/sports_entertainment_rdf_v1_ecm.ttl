ind:negativeCarryoverAllowed rdf:type rdf:Property ;
    rdfs:label 'Negative Carryover Allowed' ;
    rdfs:comment 'Indicates whether negative commission balances from one period can be carried forward to offset future earnings.' ;
    rdfs:domain ind:Affiliate ;
