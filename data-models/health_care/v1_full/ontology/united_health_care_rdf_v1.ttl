    rdfs:comment 'Indicates whether this HCC category is commonly identified as a suspect condition requiring provider outreach for recapture.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureLinkage rdf:type rdf:Property ;
