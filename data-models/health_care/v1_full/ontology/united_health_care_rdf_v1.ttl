    rdfs:comment 'Medical specialty required for the clinical reviewer who evaluates authorization requests for this service type.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkRequirement rdf:type rdf:Property ;
    rdfs:label 'Network Requirement' ;
    rdfs:comment 'Specifies whether prior authorization is required only for in-network services, out-of-network services, or both.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
