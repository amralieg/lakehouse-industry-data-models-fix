ind:transferPricingDocumentationFlag rdf:type rdf:Property ;
    rdfs:label 'Transfer Pricing Documentation Flag' ;
    rdfs:comment 'Indicates whether transfer pricing documentation has been prepared and maintained for this intercompany transaction to support tax compliance.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialityThresholdFlag rdf:type rdf:Property ;
    rdfs:label 'Materiality Threshold Flag' ;
    rdfs:comment 'Indicates whether the intercompany transaction amount exceeds the materiality threshold requiring enhanced review or disclosure.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statutoryFilingCategory rdf:type rdf:Property ;
    rdfs:label 'Statutory Filing Category' ;
    rdfs:comment 'The type of statutory or regulatory filing to which this intercompany transaction must be reported for insurance regulatory compliance.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Flag' ;
    rdfs:comment 'Indicates whether this intercompany transaction is related to risk adjustment payments or settlements under Medicare Advantage or ACA programs.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetDepreciationId rdf:type rdf:Property ;
    rdfs:label 'Asset Depreciation Id' ;
    rdfs:comment 'Unique identifier for each asset depreciation transaction record.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Amount' ;
    rdfs:comment 'Monetary value of depreciation expense charged for the period in functional currency.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netBookValue rdf:type rdf:Property ;
    rdfs:label 'Net Book Value' ;
    rdfs:comment 'Current carrying value of the asset calculated as original cost less accumulated depreciation.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationStartDate rdf:type rdf:Property ;
    rdfs:label 'Depreciation Start Date' ;
    rdfs:comment 'Date when depreciation calculation begins for the asset, typically the placed-in-service date.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depreciationEndDate rdf:type rdf:Property ;
    rdfs:label 'Depreciation End Date' ;
    rdfs:comment 'Date when depreciation calculation ends for the asset, typically when fully depreciated or disposed.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalCost rdf:type rdf:Property ;
    rdfs:label 'Original Cost' ;
    rdfs:comment 'Initial acquisition cost or capitalized value of the asset at the time of purchase or construction.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciableBasis rdf:type rdf:Property ;
    rdfs:label 'Depreciable Basis' ;
    rdfs:comment 'Amount subject to depreciation, calculated as original cost less salvage value.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookTypeCode rdf:type rdf:Property ;
    rdfs:label 'Book Type Code' ;
    rdfs:comment 'Code identifying the accounting book or reporting basis for the depreciation (e.g., corporate GAAP, tax, IFRS).' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contraAccountCode rdf:type rdf:Property ;
    rdfs:label 'Contra Account Code' ;
    rdfs:comment 'General ledger contra-asset account code for accumulated depreciation.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalEntryId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Id' ;
    rdfs:comment 'Unique identifier of the journal entry that recorded the depreciation transaction in the general ledger.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneralLedger .

ind:journalBatchId rdf:type rdf:Property ;
    rdfs:label 'Journal Batch Id' ;
    rdfs:comment 'Unique identifier of the journal batch containing the depreciation entry.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Batch .

ind:depreciationStatus rdf:type rdf:Property ;
    rdfs:label 'Depreciation Status' ;
    rdfs:comment 'Current status of the asset\'s depreciation schedule.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Adjustment Flag' ;
    rdfs:comment 'Indicates whether this depreciation entry is an adjustment to a prior period calculation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impairmentFlag rdf:type rdf:Property ;
    rdfs:label 'Impairment Flag' ;
    rdfs:comment 'Indicates whether the asset has been subject to an impairment charge affecting depreciation.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bonusDepreciationFlag rdf:type rdf:Property ;
    rdfs:label 'Bonus Depreciation Flag' ;
    rdfs:comment 'Indicates whether bonus depreciation was applied to the asset for tax purposes.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:section179Flag rdf:type rdf:Property ;
    rdfs:label 'Section 179 Flag' ;
    rdfs:comment 'Indicates whether Section 179 expensing election was applied to the asset for tax purposes.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:section179Amount rdf:type rdf:Property ;
    rdfs:label 'Section 179 Amount' ;
    rdfs:comment 'Amount of Section 179 expense deduction claimed for the asset in the year of acquisition.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Depreciation Amount' ;
    rdfs:comment 'Depreciation expense amount calculated for tax reporting purposes.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookTaxDifference rdf:type rdf:Property ;
    rdfs:label 'Book Tax Difference' ;
    rdfs:comment 'Difference between book depreciation and tax depreciation for the period, creating temporary differences.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredTaxImpact rdf:type rdf:Property ;
    rdfs:label 'Deferred Tax Impact' ;
    rdfs:comment 'Deferred tax asset or liability impact resulting from book-tax depreciation differences.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalizationDate rdf:type rdf:Property ;
    rdfs:label 'Capitalization Date' ;
    rdfs:comment 'Date when the asset was capitalized and added to the fixed asset register.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:acquisitionMethod rdf:type rdf:Property ;
    rdfs:label 'Acquisition Method' ;
    rdfs:comment 'Method by which the asset was acquired by the organization.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Expiration Date' ;
    rdfs:comment 'Date when the manufacturer or vendor warranty for the asset expires.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaseFlag rdf:type rdf:Property ;
    rdfs:label 'Lease Flag' ;
    rdfs:comment 'Indicates whether the asset is held under a lease agreement rather than owned outright.' ;
    rdfs:domain ind:AssetDepreciation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leaseId rdf:type rdf:Property ;
    rdfs:label 'Lease Id' ;
    rdfs:comment 'Unique identifier of the lease agreement if the asset is leased.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Lease .

ind:taxReturnId rdf:type rdf:Property ;
    rdfs:label 'Tax Return Id' ;
    rdfs:comment 'Unique identifier for the tax return filing record. Primary key for the tax return entity.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:filingEntityName rdf:type rdf:Property ;
    rdfs:label 'Filing Entity Name' ;
    rdfs:comment 'Legal name of the entity filing the tax return (UnitedHealth Care or subsidiary legal entity name).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Employer Identification Number' ;
    rdfs:comment 'Federal tax identification number assigned by the IRS to the filing entity. Also known as Federal Tax ID.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnType rdf:type rdf:Property ;
    rdfs:label 'Return Type' ;
    rdfs:comment 'Classification of the tax return by tax type (e.g., federal income, state income, franchise, premium tax).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formNumber rdf:type rdf:Property ;
    rdfs:label 'Form Number' ;
    rdfs:comment 'Official form number used for filing (e.g., 1120 for corporate income tax, 1120-PC for property and casualty insurance companies).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingMethod rdf:type rdf:Property ;
    rdfs:label 'Filing Method' ;
    rdfs:comment 'Method used to submit the tax return (electronic filing, paper filing, or extension request).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Code' ;
    rdfs:comment 'Code identifying the tax jurisdiction (federal IRS, state abbreviation, or local jurisdiction code).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionName rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Name' ;
    rdfs:comment 'Full name of the tax jurisdiction (e.g., Internal Revenue Service, California Franchise Tax Board, New York City Department of Finance).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDueDate rdf:type rdf:Property ;
    rdfs:label 'Filing Due Date' ;
    rdfs:comment 'Original statutory due date for filing the tax return, before any extensions.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extendedDueDate rdf:type rdf:Property ;
    rdfs:label 'Extended Due Date' ;
    rdfs:comment 'Extended due date for filing if an extension was granted.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualFilingDate rdf:type rdf:Property ;
    rdfs:label 'Actual Filing Date' ;
    rdfs:comment 'Date the tax return was actually filed with the tax authority.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossReceiptsAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Receipts Amount' ;
    rdfs:comment 'Total gross receipts or revenue reported on the tax return for the tax period.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalIncomeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Income Amount' ;
    rdfs:comment 'Total taxable income calculated after adjustments and deductions.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDeductionsAmount rdf:type rdf:Property ;
    rdfs:label 'Total Deductions Amount' ;
    rdfs:comment 'Total deductions claimed on the tax return, including ordinary and necessary business expenses.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxableIncomeAmount rdf:type rdf:Property ;
    rdfs:label 'Taxable Income Amount' ;
    rdfs:comment 'Net taxable income subject to tax after all adjustments, deductions, and exemptions.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Tax Rate Percentage' ;
    rdfs:comment 'Effective or statutory tax rate applied to taxable income (expressed as decimal, e.g., 0.2100 for 21%).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Liability Amount' ;
    rdfs:comment 'Total tax liability calculated before credits and payments.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCreditsAmount rdf:type rdf:Property ;
    rdfs:label 'Total Credits Amount' ;
    rdfs:comment 'Total tax credits claimed to reduce tax liability (e.g., foreign tax credits, research credits).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPaymentsAmount rdf:type rdf:Property ;
    rdfs:label 'Total Payments Amount' ;
    rdfs:comment 'Total tax payments made during the tax year, including estimated tax payments and withholdings.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netTaxDueAmount rdf:type rdf:Property ;
    rdfs:label 'Net Tax Due Amount' ;
    rdfs:comment 'Net amount of tax due to be paid with the return after credits and payments. Positive value indicates amount owed.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditForwardAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Forward Amount' ;
    rdfs:comment 'Amount of overpayment to be credited to the next tax year\'s estimated tax.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consolidatedReturnIndicator rdf:type rdf:Property ;
    rdfs:label 'Consolidated Return Indicator' ;
    rdfs:comment 'Indicates whether this return is filed as part of a consolidated group of corporations.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentCompanyEin rdf:type rdf:Property ;
    rdfs:label 'Parent Company Ein' ;
    rdfs:comment 'EIN of the parent company if this return is part of a consolidated filing.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendedReturnIndicator rdf:type rdf:Property ;
    rdfs:label 'Amended Return Indicator' ;
    rdfs:comment 'Indicates whether this is an amended return correcting a previously filed return.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalReturnFilingDate rdf:type rdf:Property ;
    rdfs:label 'Original Return Filing Date' ;
    rdfs:comment 'Filing date of the original return if this is an amended return.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extensionApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Extension Approval Date' ;
    rdfs:comment 'Date the filing extension was approved by the tax authority.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preparerName rdf:type rdf:Property ;
    rdfs:label 'Preparer Name' ;
    rdfs:comment 'Name of the individual or firm that prepared the tax return.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerPtin rdf:type rdf:Property ;
    rdfs:label 'Preparer Ptin' ;
    rdfs:comment 'IRS-issued Preparer Tax Identification Number for the individual who prepared the return.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerFirmName rdf:type rdf:Property ;
    rdfs:label 'Preparer Firm Name' ;
    rdfs:comment 'Name of the accounting or tax preparation firm that prepared the return.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerFirmEin rdf:type rdf:Property ;
    rdfs:label 'Preparer Firm Ein' ;
    rdfs:comment 'EIN of the tax preparation firm.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signingOfficerName rdf:type rdf:Property ;
    rdfs:label 'Signing Officer Name' ;
    rdfs:comment 'Name of the corporate officer authorized to sign the tax return.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signingOfficerTitle rdf:type rdf:Property ;
    rdfs:label 'Signing Officer Title' ;
    rdfs:comment 'Title of the corporate officer who signed the return (e.g., Chief Financial Officer, President, Treasurer).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnStatus rdf:type rdf:Property ;
    rdfs:label 'Return Status' ;
    rdfs:comment 'Current processing status of the tax return in the filing lifecycle.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditStartDate rdf:type rdf:Property ;
    rdfs:label 'Audit Start Date' ;
    rdfs:comment 'Date the tax audit commenced.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Audit Adjustment Amount' ;
    rdfs:comment 'Total amount of tax adjustments resulting from the audit.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:generalLedgerAccountNumber rdf:type rdf:Property ;
    rdfs:label 'General Ledger Account Number' ;
    rdfs:comment 'General ledger account number where tax liability or refund is recorded.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateFilingRequirementIndicator rdf:type rdf:Property ;
    rdfs:label 'State Filing Requirement Indicator' ;
    rdfs:comment 'Indicates whether this entity has a state tax filing requirement in the jurisdiction.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:apportionmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Apportionment Percentage' ;
    rdfs:comment 'Percentage of income apportioned to the jurisdiction for multi-state filers (expressed as decimal, e.g., 0.1250 for 12.5%).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nexusBasis rdf:type rdf:Property ;
    rdfs:label 'Nexus Basis' ;
    rdfs:comment 'Legal basis establishing tax nexus in the jurisdiction (e.g., physical presence, economic nexus, factor presence).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:foreignTaxCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Foreign Tax Credit Amount' ;
    rdfs:comment 'Amount of foreign tax credit claimed to offset U.S. tax on foreign-source income.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:researchDevelopmentCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Research Development Credit Amount' ;
    rdfs:comment 'Amount of research and development tax credit claimed.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netOperatingLossCarryforwardAmount rdf:type rdf:Property ;
    rdfs:label 'Net Operating Loss Carryforward Amount' ;
    rdfs:comment 'Amount of net operating loss carried forward from prior years to offset current year taxable income.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
