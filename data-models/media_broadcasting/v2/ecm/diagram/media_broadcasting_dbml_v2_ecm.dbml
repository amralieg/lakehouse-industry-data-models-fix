Table production.project {
  project_id varchar [pk, note: 'Primary key for project | Column project_id (BIGINT) in production.project']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Production projects bill clients/studios for production services, co-production arrangements, or facility rentals through billing accounts. Essential for production service invoicing, milestone billin | Column billing_account_id (BIGINT) in billing.project']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Production projects are planned and budgeted against specific broadcast facilities for transmission/distribution. Real-world production planning requires facility assignment for capacity planning, tec | Column broadcast_facility_id (BIGINT) in technology.project']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Productions must operate under specific broadcast licenses for regulatory compliance, rights clearance, and distribution authorization. Essential for FCC compliance reporting and license renewal proce | Column broadcast_license_id (BIGINT) in compliance.project']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Branded content and product integration productions are commissioned for specific advertiser campaigns. Business process: sponsor deliverable tracking, advertiser-funded content production management, | Column campaign_id (BIGINT) in sales.project']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Projects are commissioned for specific broadcast channels/networks. Network commissioning process requires tracking which channel ordered the content. Essential for content planning, budget allocation | Column channel_id (BIGINT) in scheduling.project']
  coppa_declaration_id varchar [note: 'Foreign key linking to compliance.coppa_declaration. Business justification: Projects targeting children must have COPPA declarations on file before production begins. Required for greenlight approval and distribution planning for children\'s programming. | Column coppa_declaration_id (BIGINT) in compliance.project']
  master_license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Projects often have master license agreements governing distribution rights (co-production deals, pre-sales, output deals). Real business need: tracking which license agreements fund or govern a produ | Column master_license_agreement_id (BIGINT) in rights.project']
  opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Content licensing and syndication sales opportunities reference specific production projects to verify rights availability, establish cost basis for pricing, coordinate delivery schedules, and ensure  | Column opportunity_id (BIGINT) in sales.project']
  primary_title_id varchar [note: 'FK to content.title.title_id — Critical production-to-content traceability: must answer \'what content title does this production project produce?\' for scheduling, rights clearance, and financial reporting workflows. | Column primary_title_id (BIGINT) in content.project']
  production_company_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Production projects are executed by or with external production companies (partners). Linking enables contract management, payment processing, co-production tracking, and rights negotiation. The `prod | Column production_company_partner_id (BIGINT) in partner.project']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Projects must track which regulatory obligations apply based on content type, distribution channels, and target audience. Drives compliance planning and budget allocation for regulatory requirements. | Column regulatory_obligation_id (BIGINT) in compliance.project']
  showrunner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Showrunner is a formal employment role in episodic production tracked in HR systems for compensation, guild reporting (WGA/DGA), and on-screen credits—critical for series content. | Column showrunner_employee_id (BIGINT) in workforce.project']
  target_ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Productions are commissioned for specific streaming platforms (Netflix Originals, HBO Max Exclusives). Platform determines technical specs, content ratings, delivery windows. Real business process: pl | Column target_ott_platform_id (BIGINT) in distribution.project']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.project']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.project']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.project']
  actual_delivery_date date [note: 'Date on which the final deliverable was actually delivered to the distribution or broadcast platform. Compared against target_delivery_date to measure on-time delivery performance and SLA compliance. | Column actual_delivery_date (DATE) in production.project']
  actual_spend_usd decimal(18,2) [note: 'Cumulative actual expenditure incurred against this production project to date, denominated in US Dollars. Sourced from SAP S/4HANA cost postings. Compared against approved_budget_usd for variance and financial reconciliation reporting. | Column actual_spend_usd (DECIMAL(18,2)) in production.project']
  approved_budget_usd decimal(18,2) [note: 'Total production budget formally approved at greenlight, denominated in US Dollars. Represents the authorized spend ceiling for the project. Used for financial controlling, variance analysis, and EBITDA reporting in SAP S/4HANA. | Column approved_budget_usd (DECIMAL(18,2)) in production.project']
  co_production_flag boolean [note: 'Indicates whether this production project is a co-production involving one or more external production partners. Triggers co-production agreement workflows, shared rights structures, and split budget reporting in SAP S/4HANA. | Column co_production_flag (BOOLEAN) in production.project']
  content_genre varchar [note: 'Primary genre classification of the content being produced (e.g., drama, comedy, thriller, sports, news, reality). Used for audience targeting, scheduling, advertising sales, and rights windowing strategies. [ENUM-REF-CANDIDATE: drama|comedy|thriller|action|documentary|news|reality|sports|animation|horror — promote to reference product] | Column content_genre (STRING) in production.project']
  content_rating varchar [note: 'Official content rating assigned by the Motion Picture Association (MPA) or TV Parental Guidelines system. Governs broadcast scheduling, advertising eligibility, and platform distribution restrictions including COPPA compliance for children\'s content. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA — 11 candidates stripped; promote to reference product] | Column content_rating (STRING) in production.project']
  coppa_applicable boolean [note: 'Indicates whether this production is directed at children under 13 and therefore subject to COPPA compliance requirements. Affects data collection practices, advertising eligibility, and platform distribution restrictions. | Column coppa_applicable (BOOLEAN) in production.project']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.project']
  created_timestamp timestamp [note: 'Timestamp when this production project record was first created in the lakehouse Silver layer. Conforms to ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in production.project']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the budget and spend amounts recorded on this project (e.g., USD, GBP, EUR). Supports multi-currency production environments for international co-productions. | Column currency_code (STRING) in production.project']
  dalet_workflow_reference varchar [note: 'Integration reference identifier linking this production project to its corresponding workflow instance in Dalet Galaxy Media Asset Management and Workflow Orchestration system. Enables cross-system traceability for ingest, metadata, archive, and workflow operations. | Column dalet_workflow_reference (STRING) in production.project']
  drm_required boolean [note: 'Indicates whether Digital Rights Management (DRM) protection must be applied to the delivered content assets. Drives technical delivery specifications for CDN, streaming platform configuration, and Akamai CDN security settings. | Column drm_required (BOOLEAN) in production.project']
  eidr varchar [note: 'Entertainment Identifier Registry (EIDR) identifier for this content project. Provides a universal, persistent identifier for the title across supply chain partners, distributors, and platforms. | Column eidr (STRING) in production.project']
  episode_count varchar [note: 'Total number of episodes commissioned for this production project. Applicable to scripted and unscripted series. Used for budget modeling, scheduling, and rights licensing calculations. Null for single-title formats such as feature films. | Column episode_count (INT) in production.project']
  fcc_license_required boolean [note: 'Indicates whether this production requires FCC broadcast licensing compliance review prior to linear broadcast distribution. Applicable to content intended for over-the-air or cable transmission in the United States. | Column fcc_license_required (BOOLEAN) in production.project']
  greenlight_date date [note: 'Calendar date on which the production project received formal executive greenlight approval. Marks the official start of the production lifecycle and triggers budget release and resource mobilization. | Column greenlight_date (DATE) in production.project']
  greenlight_status varchar [note: 'Executive approval status of the production project. Indicates whether the project has received formal greenlight authorization to proceed, is pending approval, is on hold, or has been cancelled. Controls budget release and resource mobilization. | Column greenlight_status (STRING) in production.project']
  isan varchar [note: 'Globally unique identifier assigned to this audiovisual work under the International Standard Audiovisual Number (ISAN) standard (ISO 15706). Used for rights management, royalty tracking, and cross-platform content identification. | Column isan (STRING) in production.project']
  original_ip_flag boolean [note: 'Indicates whether this production is based on original intellectual property owned by the organization, as opposed to licensed or adapted IP. Affects rights ownership, residuals obligations, and long-term asset valuation. | Column original_ip_flag (BOOLEAN) in production.project']
  post_production_start_date date [note: 'Scheduled or actual date on which post-production activities commenced, including editing, VFX, color grading, audio mixing, and transcoding. Used for facility booking and deliverable milestone planning. | Column post_production_start_date (DATE) in production.project']
  pre_production_start_date date [note: 'Scheduled or actual date on which pre-production activities commenced, including casting, location scouting, script breakdown, and crew hiring. Used for production planning and milestone tracking. | Column pre_production_start_date (DATE) in production.project']
  primary_language varchar [note: 'ISO 639-1 or ISO 639-2 language code for the primary language in which the content is produced (e.g., en, es, fr). Drives localization, dubbing, subtitling, and distribution territory planning. | Column primary_language (STRING) in production.project']
  principal_photography_end_date date [note: 'Scheduled or actual date on which principal photography concluded (picture wrap). Triggers transition to post-production phase and initiates post-production resource scheduling. | Column principal_photography_end_date (DATE) in production.project']
  principal_photography_start_date date [note: 'Scheduled or actual date on which principal photography (primary filming) commenced. A key production milestone used for crew scheduling, facility booking, and insurance activation. | Column principal_photography_start_date (DATE) in production.project']
  production_country varchar [note: 'ISO 3166-1 alpha-3 country code for the primary country in which the production is being executed. Determines applicable regulatory frameworks, tax incentive eligibility, and co-production treaty benefits. | Column production_country (STRING) in production.project']
  production_format varchar [note: 'Primary technical production format and resolution specification (e.g., 4K UHD, HD 1080p, HDR10). Determines post-production pipeline, transcoding requirements, and delivery specifications for broadcast and streaming platforms. [ENUM-REF-CANDIDATE: 4K_UHD|HD_1080p|HD_720p|SD|HDR10|Dolby_Vision|IMAX — 7 candidates stripped; promote to reference product] | Column production_format (STRING) in production.project']
  production_phase varchar [note: 'Current phase of the content production lifecycle. Tracks the project\'s progression from development through delivery. Used to gate workflow steps, resource allocation, and financial milestone releases. | Column production_phase (STRING) in production.project']
  project_type varchar [note: 'Classification of the content production project by format and genre category. Drives production workflow templates, budget models, rights structures, and scheduling logic. [ENUM-REF-CANDIDATE: scripted_series|feature_film|documentary|live_event|news_segment|unscripted_series|short_form — promote to reference product] | Column project_type (STRING) in production.project']
  sap_wbs_element varchar [note: 'SAP S/4HANA Work Breakdown Structure element code that maps this production project to the enterprise financial controlling hierarchy for budget tracking, cost allocation, and financial reconciliation. | Column sap_wbs_element (STRING) in production.project']
  season_number varchar [note: 'Season number within a series franchise. Used to link this production project to prior seasons for rights continuity, talent residuals, and audience analytics. Null for non-series formats. | Column season_number (INT) in production.project']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.project']
  synopsis varchar [note: 'Short narrative description of the content production project\'s story, subject matter, or editorial concept. Used for internal greenlight documentation, sales pitches, EPG metadata, and Dalet Galaxy asset metadata. | Column synopsis (STRING) in production.project']
  target_delivery_date date [note: 'Contractually committed or internally planned date by which the finished content must be delivered to distribution, broadcast, or streaming platforms. Drives post-production scheduling, windowing strategy, and SLA compliance. | Column target_delivery_date (DATE) in production.project']
  total_runtime_minutes varchar [note: 'Total planned or delivered runtime of the production in minutes. For series, this is the aggregate runtime across all episodes. Used for scheduling, licensing, and royalty calculations. | Column total_runtime_minutes (INT) in production.project']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.project']
  updated_timestamp timestamp [note: 'Timestamp when this production project record was most recently modified in the lakehouse Silver layer. Conforms to ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for change tracking, incremental processing, and audit compliance. | Column updated_timestamp (TIMESTAMP) in production.project']

  Note: 'Master record for a content production project — the greenlit initiative that drives all production activity. Captures the project title, type (scripted series, feature film, documentary, live event, news segment), greenlight status, production phase (development, pre-production, principal photography, post-production, delivery), approved budget, actual spend, production company, showrunner or executive producer, target delivery date, ISAN identifier, and integration reference to Dalet Galaxy workflow. This is the top-level anchor entity for the entire production domain. | Unity Catalog table: media_broadcasting_ecm.production.project'
}

Table production.shoot_schedule {
  shoot_schedule_id varchar [pk, note: 'Unique surrogate identifier for a shoot schedule record in the production domain. Primary key for the shoot_schedule data product. | Column shoot_schedule_id (BIGINT) in production.shoot_schedule']
  location_id varchar [note: 'Foreign key linking to production.location. Business justification: Normalization opportunity. Shoot schedule currently has location_name (STRING). FK to location table provides referential integrity and enables retrieving full location details (address, permits, safe | Column location_id (BIGINT) in production.shoot_schedule']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Shoot days generate dailies (raw footage) ingested into MAM for editorial review. Role-prefixed as dailies_asset_id since shoot_schedule already has dalet_workflow_id. Essential for post-production wo | Column media_asset_id (BIGINT) in mediaasset.shoot_schedule']
  primary_shoot_employee_id varchar [note: 'Reference to the director assigned to lead principal photography on this shoot day. Supports crew assignment and talent tracking. | Column primary_shoot_employee_id (BIGINT) in workforce.shoot_schedule']
  production_project_id varchar [note: 'Reference to the parent production project to which this shoot schedule day belongs. Links the daily schedule to the overarching production entity. | Column production_project_id (BIGINT) in production.shoot_schedule']
  studio_facility_id varchar [note: 'Reference to the studio or location facility booked for this shoot day. Supports integration with facility booking and resource coordination. | Column studio_facility_id (BIGINT) in technology.shoot_schedule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.shoot_schedule']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.shoot_schedule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.shoot_schedule']
  actual_extras_count varchar [note: 'The actual number of background performers (extras) who worked on this shoot day. Used for payroll reconciliation, SAG-AFTRA reporting, and production cost tracking. | Column actual_extras_count (INT) in production.shoot_schedule']
  actual_shoot_hours decimal(5,2) [note: 'The actual number of hours spent in principal photography for the day. Used for budget reconciliation, overtime calculation, and production efficiency analysis. | Column actual_shoot_hours (DECIMAL(5,2)) in production.shoot_schedule']
  actual_wrap_time timestamp [note: 'The actual time at which principal photography concluded for the day. Compared against scheduled wrap time to calculate overtime and assess schedule adherence. | Column actual_wrap_time (TIMESTAMP) in production.shoot_schedule']
  call_time timestamp [note: 'The scheduled time at which cast and crew are required to report to set. Used for crew coordination, transport logistics, and facility readiness planning. | Column call_time (TIMESTAMP) in production.shoot_schedule']
  cover_set_description varchar [note: 'Description of the alternate interior or cover set designated for use if weather or other conditions prevent the primary shoot. Only applicable when weather_contingency_flag is True. | Column cover_set_description (STRING) in production.shoot_schedule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.shoot_schedule']
  created_timestamp timestamp [note: 'The timestamp at which this shoot schedule record was first created in the system. Supports audit trail, data lineage, and compliance requirements. | Column created_timestamp (TIMESTAMP) in production.shoot_schedule']
  dalet_workflow_reference varchar [note: 'The workflow instance identifier assigned by Dalet Galaxy for the ingest and orchestration workflow associated with this shoot day\'s deliverables. Enables traceability between the shoot schedule and downstream media asset management processes. | Column dalet_workflow_reference (STRING) in production.shoot_schedule']
  day_out_of_days_type varchar [note: 'Industry-standard Day Out of Days (DOOD) designation indicating the cast/crew work status for this shoot day. SW=Start Work, W=Work, WF=Work Finish, F=Finish, H=Hold, D=Drop, SWF=Start Work Finish. Used for talent scheduling, residuals calculation, and SAG-AFTRA compliance. [ENUM-REF-CANDIDATE: SW|W|WF|F|H|D|SWF — 7 candidates stripped; promote to reference product] | Column day_out_of_days_type (STRING) in production.shoot_schedule']
  estimated_extras_count varchar [note: 'The planned number of background performers (extras) required for this shoot day. Used for casting coordination, catering planning, and SAG-AFTRA background performer compliance. | Column estimated_extras_count (INT) in production.shoot_schedule']
  estimated_shoot_hours decimal(5,2) [note: 'The planned number of shooting hours for the day, used for budget forecasting, crew scheduling, and facility booking. Expressed in decimal hours (e.g., 10.50 = 10 hours 30 minutes). | Column estimated_shoot_hours (DECIMAL(5,2)) in production.shoot_schedule']
  first_shot_time timestamp [note: 'The scheduled or actual time at which the first camera roll of the day begins. A key production efficiency metric used to assess set readiness and pre-production effectiveness. | Column first_shot_time (TIMESTAMP) in production.shoot_schedule']
  is_overtime_day boolean [note: 'Indicates whether this shoot day resulted in overtime hours for cast or crew, triggering additional compensation obligations under union agreements (SAG-AFTRA, DGA, IATSE). Derived operationally but stored for compliance and payroll audit purposes. | Column is_overtime_day (BOOLEAN) in production.shoot_schedule']
  meal_penalty_flag boolean [note: 'Indicates whether a meal penalty was incurred on this shoot day due to failure to provide a meal break within the union-mandated interval (typically 6 hours). Triggers additional compensation obligations under SAG-AFTRA and IATSE agreements. | Column meal_penalty_flag (BOOLEAN) in production.shoot_schedule']
  page_count decimal(5,2) [note: 'The number of script pages scheduled for photography on this shoot day, expressed in eighths of a page per industry convention (e.g., 4.625 = 4 and 5/8 pages). A standard production efficiency metric used to assess daily output against industry benchmarks. | Column page_count (DECIMAL(5,2)) in production.shoot_schedule']
  production_notes varchar [note: 'Free-text field capturing significant events, issues, or observations from the shoot day, including equipment failures, weather delays, cast illness, or creative changes. Sourced from the daily production report. | Column production_notes (STRING) in production.shoot_schedule']
  production_unit varchar [note: 'Identifies the filming unit responsible for this shoot day. Main unit is led by the principal director; second unit handles action sequences or supplemental footage; splinter unit shoots simultaneously with main unit on a separate set; insert unit captures close-up or detail shots. | Column production_unit (STRING) in production.shoot_schedule']
  revision_date date [note: 'The date on which the current revision of this shoot schedule was issued. Used to track the cadence of schedule changes and identify the most current approved version. | Column revision_date (DATE) in production.shoot_schedule']
  revision_version varchar [note: 'The version identifier of this shoot schedule revision (e.g., \'v1\', \'v3-BLUE\', \'Rev-7\'). Production schedules are revised frequently; tracking version enables audit of changes and comparison of planned vs. actual across revisions. | Column revision_version (STRING) in production.shoot_schedule']
  scene_numbers varchar [note: 'Comma-separated list of scene numbers from the production script scheduled for photography on this shoot day (e.g., \'12, 13A, 14, 15B\'). Derived from the stripboard and used for script supervisor tracking and editorial planning. | Column scene_numbers (STRING) in production.shoot_schedule']
  schedule_number varchar [note: 'Externally-known alphanumeric identifier for this shoot schedule record, used in production paperwork, call sheets, and cross-system references (e.g., SS-2024-0042). | Column schedule_number (STRING) in production.shoot_schedule']
  schedule_status varchar [note: 'Current lifecycle state of the shoot schedule day. Drives workflow actions and reporting across production management. [ENUM-REF-CANDIDATE: draft|confirmed|in_progress|completed|cancelled|postponed — promote to reference product if additional states are required] | Column schedule_status (STRING) in production.shoot_schedule']
  scheduled_wrap_time timestamp [note: 'The planned time at which principal photography is expected to conclude for the day. Used for facility booking, crew scheduling, and overtime cost estimation. | Column scheduled_wrap_time (TIMESTAMP) in production.shoot_schedule']
  shoot_date date [note: 'The calendar date on which principal photography is scheduled or was executed. The primary business event date for this schedule record. | Column shoot_date (DATE) in production.shoot_schedule']
  shoot_day_number varchar [note: 'Sequential shoot day number within the production (e.g., Day 1, Day 15, Day 42). Used to track production progress against the total approved shoot days and for budget burn-rate analysis. | Column shoot_day_number (INT) in production.shoot_schedule']
  shoot_type varchar [note: 'Classifies the nature of the shoot day environment. Distinguishes between controlled studio environments and on-location shoots, which have different logistical, permitting, and cost implications. | Column shoot_type (STRING) in production.shoot_schedule']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.shoot_schedule']
  total_approved_shoot_days varchar [note: 'The total number of principal photography days approved in the production greenlight. Used to calculate schedule completion percentage and identify overages requiring executive approval. | Column total_approved_shoot_days (INT) in production.shoot_schedule']
  turnaround_hours decimal(4,2) [note: 'The minimum rest period in hours between the wrap of the previous shoot day and the call time of this shoot day. Union agreements (SAG-AFTRA, DGA, IATSE) mandate minimum turnaround periods; violations trigger penalty payments. | Column turnaround_hours (DECIMAL(4,2)) in production.shoot_schedule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.shoot_schedule']
  updated_timestamp timestamp [note: 'The timestamp at which this shoot schedule record was most recently modified. Used for change detection, incremental data loading in the Databricks Silver Layer, and audit trail maintenance. | Column updated_timestamp (TIMESTAMP) in production.shoot_schedule']
  weather_contingency_flag boolean [note: 'Indicates whether this shoot day has a weather contingency plan in place. When True, an alternate interior or cover set is designated in case outdoor conditions prevent the primary shoot. Critical for location shoots and insurance risk management. | Column weather_contingency_flag (BOOLEAN) in production.shoot_schedule']

  Note: 'Day-by-day principal photography schedule for a production project. Tracks shoot dates, call times, wrap times, location or studio facility, scene numbers, unit (main unit, second unit, splinter unit), director, first assistant director, estimated vs actual shoot hours, weather contingency flags, and schedule revision version. Integrates with facility booking and crew assignment to coordinate all on-set resources. Distinct from the EPG scheduling domain which governs broadcast playout. | Unity Catalog table: media_broadcasting_ecm.production.shoot_schedule'
}

Table production.budget {
  budget_id varchar [pk, note: 'Primary key for budget | Column budget_id (BIGINT) in production.budget']
  approved_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Budget approvals require employee-level accountability for SOX compliance, audit trails, and financial controls—standard in production accounting systems. Replaces denormalized approved_by name field. | Column approved_by_employee_id (BIGINT) in workforce.budget']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Production budgets must be assigned to cost centers for financial consolidation, variance analysis, and departmental P&L reporting. Replaces denormalized sap_cost_center_code with proper FK for SAP in | Column cost_center_id (BIGINT) in finance.budget']
  production_project_id varchar [note: 'Reference to the parent production project this budget record belongs to. Links the financial control baseline to the production entity. | Column production_project_id (BIGINT) in production.budget']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Production budgets must roll up to profit centers for segment reporting, EBITDA calculation, and covenant compliance. Media companies track production profitability by business unit/channel (profit ce | Column profit_center_id (BIGINT) in finance.budget']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.budget']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.budget']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.budget']
  actual_cost_amount decimal(18,2) [note: 'Cumulative actual costs incurred to date for this cost category, sourced from SAP S/4HANA FI/CO actual postings. Represents real expenditure against the approved budget. | Column actual_cost_amount (DECIMAL(18,2)) in production.budget']
  approval_status varchar [note: 'Current workflow approval status of this budget record. DRAFT = in preparation; PENDING_APPROVAL = submitted for sign-off; APPROVED = formally authorized; REJECTED = returned for revision; LOCKED = frozen for actuals comparison; CLOSED = production complete. | Column approval_status (STRING) in production.budget']
  approved_amount decimal(18,2) [note: 'The formally approved budget amount for this cost category and version, representing the financial control baseline authorized by the production greenlight committee. | Column approved_amount (DECIMAL(18,2)) in production.budget']
  approved_timestamp timestamp [note: 'Date and time when this budget version was formally approved by the authorized signatory. Null if not yet approved. | Column approved_timestamp (TIMESTAMP) in production.budget']
  budget_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this budget record within the production finance system. Used for cross-system reference and reporting. | Column budget_code (STRING) in production.budget']
  change_reason varchar [note: 'Free-text narrative explaining the business justification for a budget revision (e.g., \'Schedule extension due to weather delays\', \'Additional VFX shots approved by director\'). Mandatory for revised versions. | Column change_reason (STRING) in production.budget']
  change_request_reference varchar [note: 'Reference number of the formal budget change request (BCR) document that authorized a revision to this budget line, traceable in the production finance approval workflow. | Column change_request_reference (STRING) in production.budget']
  committed_amount decimal(18,2) [note: 'Total value of open purchase order commitments (obligations) for this cost category that have been raised but not yet invoiced. Represents encumbered funds in the SAP MM/CO commitment ledger. | Column committed_amount (DECIMAL(18,2)) in production.budget']
  contingency_amount decimal(18,2) [note: 'The absolute monetary value of the contingency reserve allocated for this cost category, derived from the contingency percentage applied to the approved budget amount. | Column contingency_amount (DECIMAL(18,2)) in production.budget']
  contingency_percentage decimal(5,2) [note: 'The percentage of the approved budget allocated as contingency reserve for this cost category, representing the risk buffer approved by the production finance committee. | Column contingency_percentage (DECIMAL(5,2)) in production.budget']
  cost_category_code varchar [note: 'SAP cost element or cost category code classifying the type of production expenditure (e.g., ATL-TALENT, BTL-CREW, BTL-EQUIPMENT, POST-VFX, POST-AUDIO). [ENUM-REF-CANDIDATE: ATL-TALENT|ATL-RIGHTS|BTL-CREW|BTL-EQUIPMENT|BTL-FACILITIES|BTL-TRAVEL|POST-VFX|POST-AUDIO|POST-COLOR|CONTINGENCY — promote to reference product] | Column cost_category_code (STRING) in production.budget']
  cost_category_name varchar [note: 'Human-readable name of the production cost category (e.g., \'Above-the-Line Talent\', \'Below-the-Line Crew\', \'Visual Effects\', \'Audio Post-Production\'). | Column cost_category_name (STRING) in production.budget']
  cost_line_type varchar [note: 'High-level classification of the cost line distinguishing above-the-line (ATL) creative costs (writers, directors, producers, talent) from below-the-line (BTL) technical and crew costs, post-production, contingency, and overhead. | Column cost_line_type (STRING) in production.budget']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.budget']
  created_timestamp timestamp [note: 'Timestamp when this budget record was first created in the source system or ingested into the Databricks Silver Layer. Supports audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in production.budget']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which all monetary amounts on this budget record are denominated (e.g., USD, GBP, EUR). | Column currency_code (STRING) in production.budget']
  exchange_rate decimal(12,6) [note: 'The foreign exchange rate applied to convert this budget record\'s currency to the production\'s reporting currency at the time of budget approval or revision. | Column exchange_rate (DECIMAL(12,6)) in production.budget']
  fiscal_period varchar [note: 'The fiscal period (month number 1–12 or 1–16 for special periods) within the fiscal year to which this budget line is assigned in SAP CO. | Column fiscal_period (INT) in production.budget']
  fiscal_year varchar [note: 'The four-digit fiscal year to which this budget record belongs in the SAP S/4HANA CO controlling area, used for annual financial planning and SOX reporting. | Column fiscal_year (INT) in production.budget']
  forecast_amount decimal(18,2) [note: 'Latest estimate of the total cost expected to be incurred for this cost category by production completion, incorporating actuals to date and projected remaining spend. | Column forecast_amount (DECIMAL(18,2)) in production.budget']
  is_greenlight_budget boolean [note: 'Indicates whether this budget record represents the original greenlight-approved budget for the production, as distinct from subsequent revisions. The greenlight budget is the primary financial authorization baseline. | Column is_greenlight_budget (BOOLEAN) in production.budget']
  is_locked boolean [note: 'Indicates whether this budget version has been locked and is no longer open for modification. A locked budget serves as the immutable financial baseline for variance reporting. | Column is_locked (BOOLEAN) in production.budget']
  notes varchar [note: 'Free-text field for additional commentary, assumptions, or clarifications associated with this budget record, entered by the production finance team. | Column notes (STRING) in production.budget']
  period_end_date date [note: 'The end date of the fiscal or production period covered by this budget record. Defines the temporal boundary for cost accumulation and variance measurement. | Column period_end_date (DATE) in production.budget']
  period_start_date date [note: 'The start date of the fiscal or production period covered by this budget record, aligning to the SAP fiscal year/period structure. | Column period_start_date (DATE) in production.budget']
  production_phase varchar [note: 'The production lifecycle phase to which this budget line is attributed (e.g., Development, Pre-Production, Principal Photography, Post-Production, Delivery). Enables phase-level budget tracking. | Column production_phase (STRING) in production.budget']
  reporting_currency_code varchar [note: 'ISO 4217 three-letter code for the group reporting currency to which all amounts are translated for consolidated financial reporting (e.g., USD for a US-headquartered broadcaster). | Column reporting_currency_code (STRING) in production.budget']
  revised_amount decimal(18,2) [note: 'The most recently revised budget amount for this cost category following a formal budget change request. Null if no revision has been approved since the original budget. | Column revised_amount (DECIMAL(18,2)) in production.budget']
  sap_cost_object_code varchar [note: 'The SAP S/4HANA CO cost object identifier (Internal Order number or WBS Element ID) that anchors this budget record to the controlling module for financial reconciliation. | Column sap_cost_object_code (STRING) in production.budget']
  sap_wbs_element varchar [note: 'SAP Project System Work Breakdown Structure element code that maps this budget line to a specific phase or deliverable within the production project hierarchy (e.g., PRE-PROD, PRINCIPAL, POST-PROD). | Column sap_wbs_element (STRING) in production.budget']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.budget']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.budget']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this budget record in the source system or Silver Layer. Used for incremental load detection and change data capture. | Column updated_timestamp (TIMESTAMP) in production.budget']
  variance_amount decimal(18,2) [note: 'The difference between the approved (or revised) budget amount and the sum of actual costs plus commitments. A negative value indicates an over-budget condition; positive indicates underspend. | Column variance_amount (DECIMAL(18,2)) in production.budget']
  version varchar [note: 'Version label of this budget record, distinguishing the original greenlight budget from subsequent revisions and the locked final version. Supports budget version history tracking. | Column version (STRING) in production.budget']
  version_number varchar [note: 'Sequential integer version number of this budget record (e.g., 1 = original, 2 = first revision). Enables ordered version history and audit trail. | Column version_number (INT) in production.budget']

  Note: 'Detailed production budget record aligned to the SAP S/4HANA CO (Controlling) module. Captures above-the-line and below-the-line cost categories, approved budget amounts by cost category, revised budget amounts, actual costs to date, purchase order commitments, variance amounts, currency, budget version, and approval status. Serves as the financial control baseline for a production project. Links to SAP cost centers and WBS elements for financial reconciliation. | Unity Catalog table: media_broadcasting_ecm.production.budget'
}

Table production.budget_line {
  budget_line_id varchar [pk, note: 'Unique surrogate identifier for each individual budget line item within a production budget. Primary key for this entity. | Column budget_line_id (BIGINT) in production.budget_line']
  approved_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Line-item budget approvals track authorization chain for production accounting variance analysis and audit compliance—required for financial controls. Replaces denormalized approved_by name. | Column approved_by_employee_id (BIGINT) in workforce.budget_line']
  budget_id varchar [note: 'Reference to the parent production budget document that contains this line item. A production may have multiple budget versions (e.g., greenlight, revised, final). | Column budget_id (BIGINT) in production.budget_line']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Budget lines track advertiser-funded production costs for branded content and product integrations. Business process: advertiser co-production cost allocation, campaign-funded production expense track | Column campaign_id (BIGINT) in sales.budget_line']
  content_episode_id varchar [note: 'Reference to the specific episode or segment to which this budget line is allocated. Null for series-level or film-level lines that are not episode-specific. | Column content_episode_id (BIGINT) in content.budget_line']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Individual budget line items must post to cost centers for detailed expense tracking and actuals vs. budget variance reporting. Required for monthly financial close and departmental budget management. | Column cost_center_id (BIGINT) in finance.budget_line']
  partner_id varchar [note: 'Reference to the vendor, supplier, or payee associated with this budget line item (e.g., VFX house, location owner, equipment rental company, music licensor). | Column partner_id (BIGINT) in partner.budget_line']
  production_project_id varchar [note: 'Reference to the parent production project to which this budget line belongs. Links the line item to its overarching production context. | Column production_project_id (BIGINT) in production.budget_line']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.budget_line']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.budget_line']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.budget_line']
  account_code varchar [note: 'Industry-standard production account code identifying the cost category within the budget (e.g., 1100 for Above-the-Line Talent, 2200 for Camera Equipment). Follows standard production accounting chart of accounts (e.g., AICP, Producers Guild). | Column account_code (STRING) in production.budget_line']
  accrued_amount decimal(18,2) [note: 'Costs accrued for work performed or services received but not yet invoiced or formally committed. Supports period-end financial close and accurate cost-to-complete reporting. | Column accrued_amount (DECIMAL(18,2)) in production.budget_line']
  actual_amount decimal(18,2) [note: 'Total actual costs incurred and posted against this budget line to date, sourced from SAP FI invoice postings and payroll actuals. Used for variance analysis against budgeted and committed amounts. | Column actual_amount (DECIMAL(18,2)) in production.budget_line']
  approved_timestamp timestamp [note: 'Date and time when this budget line was formally approved by the authorized approver. Provides an audit trail for financial governance and SOX compliance. | Column approved_timestamp (TIMESTAMP) in production.budget_line']
  budgeted_amount decimal(18,2) [note: 'Original approved budget amount for this line item as established at greenlight or budget approval. Represents the planned cost baseline against which actuals and commitments are measured. | Column budgeted_amount (DECIMAL(18,2)) in production.budget_line']
  committed_amount decimal(18,2) [note: 'Total value of purchase orders, contracts, or binding agreements raised against this budget line but not yet invoiced. Represents financial obligations that reduce available budget. | Column committed_amount (DECIMAL(18,2)) in production.budget_line']
  contingency_pct decimal(7,4) [note: 'Contingency percentage applied to this budget line to cover unforeseen cost overruns. Typically 5–15% for production lines. Contributes to the overall production contingency reserve. | Column contingency_pct (DECIMAL(7,4)) in production.budget_line']
  contract_reference varchar [note: 'Reference number of the underlying contract or deal memo associated with this budget line (e.g., talent agreement, location agreement, VFX services contract). Links to Rightsline or SAP contract management. | Column contract_reference (STRING) in production.budget_line']
  cost_category varchar [note: 'High-level cost category classifying the budget line within the production budget structure. Above-the-line covers creative talent (writers, directors, producers, cast); below-the-line covers crew, equipment, locations, and production services. [ENUM-REF-CANDIDATE: above_the_line|below_the_line|post_production|music_licensing|vfx|marketing|overhead|contingency|insurance|legal — promote to reference product] | Column cost_category (STRING) in production.budget_line']
  cost_sub_category varchar [note: 'Granular sub-classification within the cost category (e.g., \'Cast Fees\', \'Location Fees\', \'Equipment Rental\', \'VFX Compositing\', \'Music Synchronization License\', \'Post-Production Labor\'). Enables detailed variance analysis at the sub-category level. | Column cost_sub_category (STRING) in production.budget_line']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.budget_line']
  created_timestamp timestamp [note: 'Date and time when this budget line record was first created in the system. Provides audit trail for record provenance and financial governance. | Column created_timestamp (TIMESTAMP) in production.budget_line']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this budget line (e.g., USD, GBP, EUR). Supports multi-currency production budgets for international co-productions. | Column currency_code (STRING) in production.budget_line']
  forecast_amount decimal(18,2) [note: 'Estimate at Completion (EAC) for this budget line, representing the current best estimate of total cost when the line item is fully complete. Combines actuals to date with estimate to complete. | Column forecast_amount (DECIMAL(18,2)) in production.budget_line']
  fringe_rate_pct decimal(7,4) [note: 'Percentage applied to labor costs on this line to account for employer fringe benefits (payroll taxes, pension contributions, health insurance, residuals). Standard production accounting practice for above-the-line and below-the-line labor lines. | Column fringe_rate_pct (DECIMAL(7,4)) in production.budget_line']
  gl_account_code varchar [note: 'SAP S/4HANA General Ledger account number to which this budget line maps for financial reporting and cost center allocation. Enables reconciliation between production budgets and enterprise financial statements. | Column gl_account_code (STRING) in production.budget_line']
  is_above_the_line boolean [note: 'Flag indicating whether this budget line is classified as above-the-line (ATL) cost, covering creative talent such as writers, directors, producers, and principal cast. False indicates below-the-line (BTL) cost. | Column is_above_the_line (BOOLEAN) in production.budget_line']
  is_union_labor boolean [note: 'Flag indicating whether this budget line involves union or guild labor subject to collective bargaining agreements (DGA, SAG-AFTRA, WGA, IATSE). Drives fringe rate calculations and residuals obligations. | Column is_union_labor (BOOLEAN) in production.budget_line']
  line_description varchar [note: 'Free-text description of the specific cost item represented by this budget line (e.g., \'Lead Actor Day Rate — Week 3\', \'Steadicam Rental — Principal Photography\', \'Dolby Atmos Mix — Episode 4\'). | Column line_description (STRING) in production.budget_line']
  line_number varchar [note: 'Sequential line number within the parent budget document, used for ordering and referencing individual line items in budget reports and purchase orders. | Column line_number (INT) in production.budget_line']
  line_status varchar [note: 'Current lifecycle status of the budget line item, tracking its progression from initial draft through approval, commitment, invoicing, and payment. Drives workflow routing and financial reporting. [ENUM-REF-CANDIDATE: draft|approved|committed|invoiced|paid|cancelled|on_hold — 7 candidates stripped; promote to reference product] | Column line_status (STRING) in production.budget_line']
  notes varchar [note: 'Free-text notes or comments entered by the production accountant or line producer providing additional context, assumptions, or justification for this budget line item. | Column notes (STRING) in production.budget_line']
  production_phase varchar [note: 'Phase of the production workflow during which this cost is incurred. Enables phase-based cost tracking and cash flow forecasting across the full production lifecycle from development through delivery. | Column production_phase (STRING) in production.budget_line']
  purchase_order_number varchar [note: 'SAP purchase order number raised against this budget line for vendor commitments. Links the budget line to the formal procurement document and enables three-way matching (PO, goods receipt, invoice). | Column purchase_order_number (STRING) in production.budget_line']
  quantity decimal(12,4) [note: 'Quantity of units associated with this budget line (e.g., number of shoot days, number of crew members, number of VFX shots, hours of post-production labor). Combined with unit_rate to derive budgeted amount. | Column quantity (DECIMAL(12,4)) in production.budget_line']
  revised_budgeted_amount decimal(18,2) [note: 'Most recent approved revision to the budgeted amount, reflecting approved change orders, scope changes, or budget transfers. Null if no revision has been approved since original budget. | Column revised_budgeted_amount (DECIMAL(18,2)) in production.budget_line']
  shoot_date_end date [note: 'Planned or actual end date for the activity or service associated with this budget line. Used for scheduling, resource allocation, and cost accrual period determination. | Column shoot_date_end (DATE) in production.budget_line']
  shoot_date_start date [note: 'Planned or actual start date for the activity or service associated with this budget line (e.g., first day of location shoot, start of VFX work, commencement of post-production labor). | Column shoot_date_start (DATE) in production.budget_line']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.budget_line']
  tax_credit_eligible boolean [note: 'Flag indicating whether this budget line qualifies for production tax credits or incentives (e.g., UK High-End TV Tax Relief, US state film tax credits). Enables automated calculation of eligible spend for tax credit claims. | Column tax_credit_eligible (BOOLEAN) in production.budget_line']
  unit_of_measure varchar [note: 'Unit of measure for the quantity field (e.g., day, hour, week, flat_fee, shot, reel, license). Defines how the quantity is counted for rate-based cost calculations. [ENUM-REF-CANDIDATE: day|hour|week|flat_fee|shot|reel|license|unit — 8 candidates stripped; promote to reference product] | Column unit_of_measure (STRING) in production.budget_line']
  unit_rate decimal(18,4) [note: 'Rate per unit of measure for this budget line (e.g., daily rate for a crew member, hourly rate for facility hire, per-shot rate for VFX). Multiplied by quantity to derive the budgeted amount. | Column unit_rate (DECIMAL(18,4)) in production.budget_line']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.budget_line']
  updated_timestamp timestamp [note: 'Date and time when this budget line record was most recently modified. Supports incremental data loading in the Databricks Silver Layer and change data capture from SAP S/4HANA. | Column updated_timestamp (TIMESTAMP) in production.budget_line']
  wbs_element varchar [note: 'SAP Work Breakdown Structure element code that hierarchically positions this budget line within the production project plan (e.g., PRD-2024-001.3.2.1 for a specific post-production task). | Column wbs_element (STRING) in production.budget_line']

  Note: 'Individual line-item within a production budget, representing a specific cost category or account code (e.g., cast fees, location fees, equipment rental, VFX, music licensing, post-production labor). Captures account code, cost category, sub-category, vendor or payee, budgeted amount, committed amount, actual amount, episode or segment allocation, and SAP G/L account reference. Enables granular cost tracking and variance analysis at the line-item level. | Unity Catalog table: media_broadcasting_ecm.production.budget_line'
}

Table production.crew_assignment {
  crew_assignment_id varchar [pk, note: 'Unique surrogate identifier for a crew assignment record in the production domain. Primary key for the crew_assignment data product. | Column crew_assignment_id (BIGINT) in production.crew_assignment']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Crew labor costs must be assigned to cost centers for departmental expense tracking, labor cost allocation, union reporting, and departmental budget management. Essential for tracking above-the-line v | Column cost_center_id (BIGINT) in finance.crew_assignment']
  loan_out_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Crew members often work through loan-out companies or talent agencies (partners). Linking enables tracking all crew supplied by that partner, payment processing to the loan-out entity, union/guild com | Column loan_out_partner_id (BIGINT) in partner.crew_assignment']
  manager_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Production crew hierarchies require tracking each crew member\'s direct manager for time approval, scheduling conflict resolution, and union labor compliance reporting—standard in broadcast production  | Column manager_employee_id (BIGINT) in workforce.crew_assignment']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Crew can be assigned to specific episodes within a series production. Optional FK (nullable) — crew may be assigned at project level or episode level. Enables episode-specific crew tracking for episod | Column production_episode_id (BIGINT) in production.crew_assignment']
  production_project_id varchar [note: 'Reference to the production project to which this crew member is assigned. Links the assignment to the master production record. | Column production_project_id (BIGINT) in production.crew_assignment']
  talent_profile_id varchar [note: 'Reference to the crew member\'s master record in the talent domain. Identifies the individual below-the-line crew member being assigned. | Column talent_profile_id (BIGINT) in talent.crew_assignment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.crew_assignment']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.crew_assignment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.crew_assignment']
  assignment_number varchar [note: 'Externally-known business identifier for this crew assignment, used in deal memos, call sheets, and payroll processing. Format: CA-{YEAR}-{SEQUENCE}. | Column assignment_number (STRING) in production.crew_assignment']
  assignment_status varchar [note: 'Current lifecycle state of the crew assignment. Drives payroll eligibility, call sheet inclusion, and production roster reporting. Values: pending (offer extended, not yet accepted), confirmed (deal memo signed), active (currently on set/in production), on_hold (temporarily suspended), completed (assignment concluded), cancelled (assignment terminated before start). | Column assignment_status (STRING) in production.crew_assignment']
  background_check_status varchar [note: 'Status of the crew member\'s background check for this production assignment. Required for productions involving minors (COPPA compliance) or access to secure facilities. Values: not_required, pending, cleared, failed, expired. | Column background_check_status (STRING) in production.crew_assignment']
  box_rental_rate decimal(18,4) [note: 'Daily or weekly rate paid to the crew member for the rental of their personal tool box or specialized equipment package (e.g., makeup artist\'s kit, wardrobe supervisor\'s supplies). Distinct from kit_rental_rate which covers technical equipment. | Column box_rental_rate (DECIMAL(18,4)) in production.crew_assignment']
  contracted_rate decimal(18,4) [note: 'The agreed compensation rate for this crew assignment, expressed in the applicable deal_type unit (per day, per week, or flat total). Stored in the production\'s base currency. Used for budget tracking and payroll processing in SAP S/4HANA. | Column contracted_rate (DECIMAL(18,4)) in production.crew_assignment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.crew_assignment']
  created_timestamp timestamp [note: 'The date and time when this crew assignment record was first created in the system. Used for audit trail, data lineage, and compliance reporting. Conforms to ISO 8601 format with timezone offset. | Column created_timestamp (TIMESTAMP) in production.crew_assignment']
  credit_name varchar [note: 'The name as it should appear in the production\'s end credits, which may differ from the crew member\'s legal name (e.g., stage name, preferred professional name). Sourced from the deal memo credit clause. | Column credit_name (STRING) in production.crew_assignment']
  credit_position varchar [note: 'Specifies where the crew member\'s credit appears in the production: main_title (opening credits), end_title (closing credits), both, or none (no contractual credit obligation). Drives post-production credit sequence assembly. | Column credit_position (STRING) in production.crew_assignment']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the contracted_rate (e.g., USD, GBP, EUR). Required for international co-productions where crew may be contracted in local currencies. | Column currency_code (STRING) in production.crew_assignment']
  dalet_workflow_reference varchar [note: 'The workflow instance identifier in Dalet Galaxy that corresponds to this crew assignment\'s production workflow. Enables traceability between the HR/payroll record and the media asset management workflow orchestration system. | Column dalet_workflow_reference (STRING) in production.crew_assignment']
  deal_type varchar [note: 'The compensation structure type for this crew assignment. Daily = per-day rate; Weekly = per-week rate with guaranteed days; Flat = fixed total fee for the engagement; Run of Show = engaged for the full production duration; Episodic = per-episode rate for series production. | Column deal_type (STRING) in production.crew_assignment']
  department varchar [note: 'The production department to which the crew member belongs for this assignment (e.g., camera, grip, electric, art, wardrobe, hair/makeup, post-production, sound, VFX). Drives crew call sheet grouping and budget cost center allocation. [ENUM-REF-CANDIDATE: camera|grip|electric|art|wardrobe|hair_makeup|post_production|sound|vfx|production — 10 candidates stripped; promote to reference product] | Column department (STRING) in production.crew_assignment']
  end_date date [note: 'The contractually agreed last day of work for this crew assignment. Nullable for open-ended or rolling assignments. Used for wrap scheduling and final payroll processing. | Column end_date (DATE) in production.crew_assignment']
  filming_location_country varchar [note: 'ISO 3166-1 alpha-3 country code for the primary filming location where this crew member will work. Determines applicable labor laws, tax treaties, work permit requirements, and per diem rates. | Column filming_location_country (STRING) in production.crew_assignment']
  guaranteed_days varchar [note: 'The minimum number of work days guaranteed to the crew member under this assignment deal, regardless of actual production schedule. Relevant for weekly and episodic deal types. Used for take-or-pay liability calculation. | Column guaranteed_days (INT) in production.crew_assignment']
  kit_rental_rate decimal(18,4) [note: 'Daily or weekly rate paid to the crew member for the rental of their personal professional equipment (kit) used on the production (e.g., camera operator\'s lens kit, sound mixer\'s equipment package). Common in below-the-line crew deals. | Column kit_rental_rate (DECIMAL(18,4)) in production.crew_assignment']
  last_updated_timestamp timestamp [note: 'The date and time when this crew assignment record was most recently modified. Used for change data capture (CDC), audit trail, and Silver layer incremental processing in the Databricks Lakehouse. | Column last_updated_timestamp (TIMESTAMP) in production.crew_assignment']
  meal_penalty_eligible boolean [note: 'Indicates whether this crew member is entitled to meal penalty payments if the production fails to provide a meal break within the contractually required interval (typically 6 hours under IATSE/DGA agreements). Drives production scheduling compliance. | Column meal_penalty_eligible (BOOLEAN) in production.crew_assignment']
  overtime_eligible boolean [note: 'Indicates whether this crew member is eligible for overtime pay under their union/guild agreement or applicable labor law. True = eligible for overtime; False = flat deal or exempt classification. Drives payroll calculation logic. | Column overtime_eligible (BOOLEAN) in production.crew_assignment']
  overtime_rate_multiplier decimal(5,2) [note: 'The multiplier applied to the base contracted_rate for overtime hours (e.g., 1.5 for time-and-a-half, 2.0 for double-time). Applicable only when overtime_eligible is True. Sourced from the applicable union/guild agreement. | Column overtime_rate_multiplier (DECIMAL(5,2)) in production.crew_assignment']
  per_diem_rate decimal(18,4) [note: 'Daily allowance paid to the crew member for meals and incidental expenses when working away from their home base location. Rate varies by filming location and union agreement. Used for production cost budgeting. | Column per_diem_rate (DECIMAL(18,4)) in production.crew_assignment']
  production_company varchar [note: 'The legal name of the production company or entity that is the employer of record for this crew assignment. Relevant for co-productions where multiple entities may employ different crew members. Used for payroll and tax reporting. | Column production_company (STRING) in production.crew_assignment']
  residuals_eligible boolean [note: 'Indicates whether this crew member is entitled to residual payments when the production is reused, syndicated, or distributed on additional platforms (e.g., streaming, international broadcast). Residuals are governed by DGA, IATSE, and SAG-AFTRA agreements. | Column residuals_eligible (BOOLEAN) in production.crew_assignment']
  role_title varchar [note: 'The specific production role or job title assigned to the crew member (e.g., Director, Director of Photography, Gaffer, Script Supervisor, Editor, Colorist, VFX Supervisor, Sound Mixer, Key Grip, Best Boy). [ENUM-REF-CANDIDATE: director|director_of_photography|gaffer|script_supervisor|editor|colorist|vfx_supervisor|sound_mixer|key_grip|best_boy|production_designer|costume_designer — promote to reference product] | Column role_title (STRING) in production.crew_assignment']
  safety_training_certified boolean [note: 'Indicates whether the crew member has completed the required on-set safety training certification for this production (e.g., OSHA safety, COVID-19 protocols, stunt safety). Required for insurance compliance and production liability management. | Column safety_training_certified (BOOLEAN) in production.crew_assignment']
  sap_personnel_action_code varchar [note: 'The personnel action number in SAP S/4HANA HR that corresponds to this crew assignment. Used for payroll processing, benefits enrollment, and HR compliance reporting. Enables reconciliation between the production data product and the ERP system of record. | Column sap_personnel_action_code (STRING) in production.crew_assignment']
  scheduled_days varchar [note: 'The total number of work days currently scheduled for this crew member on the production, as reflected in the current production schedule. May differ from guaranteed_days if the schedule changes. | Column scheduled_days (INT) in production.crew_assignment']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.crew_assignment']
  start_date date [note: 'The contractually agreed first day of work for this crew assignment. Used for payroll calculation, permit verification, and production schedule alignment. | Column start_date (DATE) in production.crew_assignment']
  travel_allowance decimal(18,4) [note: 'Fixed or estimated travel reimbursement amount for this crew assignment, covering transportation costs to and from the filming location. Distinct from per_diem_rate which covers daily living expenses. | Column travel_allowance (DECIMAL(18,4)) in production.crew_assignment']
  turnaround_hours decimal(5,2) [note: 'The minimum number of hours required between the end of one work day and the start of the next for this crew member, as stipulated by their union/guild agreement (e.g., 10 hours for IATSE, 12 hours for DGA). Violation triggers turnaround penalty payments. | Column turnaround_hours (DECIMAL(5,2)) in production.crew_assignment']
  union_guild_affiliation varchar [note: 'The labor union or guild to which the crew member belongs for this assignment. Determines applicable minimum rates, working conditions, residuals obligations, and benefit fund contributions. DGA = Directors Guild of America; IATSE = International Alliance of Theatrical Stage Employees; SAG-AFTRA = Screen Actors Guild–American Federation of Television and Radio Artists; WGA = Writers Guild of America; NABET = National Association of Broadcast Employees and Technicians; Teamsters = International Brotherhood of Teamsters. [ENUM-REF-CANDIDATE: DGA|IATSE|SAG-AFTRA|WGA|NABET|Teamsters|non_union — 7 candidates stripped; promote to reference product] | Column union_guild_affiliation (STRING) in production.crew_assignment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.crew_assignment']
  work_permit_expiry_date date [note: 'The expiration date of the crew member\'s work permit or visa authorization. Used to trigger renewal alerts and ensure continuous legal work authorization throughout the assignment period. | Column work_permit_expiry_date (DATE) in production.crew_assignment']
  work_permit_number varchar [note: 'The official government-issued work permit or visa authorization number for the crew member in the production jurisdiction. Nullable when work_permit_required is False. Required for compliance audits and production insurance. | Column work_permit_number (STRING) in production.crew_assignment']
  work_permit_required boolean [note: 'Indicates whether a work permit or visa authorization is required for this crew member to legally work on this production in the filming jurisdiction. True = permit required; False = no permit required (domestic/citizen crew). Triggers compliance workflow in HR. | Column work_permit_required (BOOLEAN) in production.crew_assignment']

  Note: 'Assignment of a crew member to a specific production project in a defined role and department. Captures crew role (director, DP, gaffer, script supervisor, editor, colorist, VFX supervisor, sound mixer), department (camera, grip, electric, art, wardrobe, hair/makeup, post-production), start date, end date, deal type (daily, weekly, flat), contracted rate, union or guild affiliation (DGA, IATSE, SAG-AFTRA), overtime eligibility, work permit status, and assignment status. References the talent domain for the crew members master record. Tracks the full below-the-line crew roster for a production. | Unity Catalog table: media_broadcasting_ecm.production.crew_assignment'
}

Table production.facility_booking {
  facility_booking_id varchar [pk, note: 'Unique surrogate identifier for each facility booking record in the production domain. Primary key for the facility_booking data product. | Column facility_booking_id (BIGINT) in production.facility_booking']
  content_episode_id varchar [note: 'Identifier of the specific episode or segment within the production project that requires this facility booking. Nullable for feature films or non-episodic productions. | Column content_episode_id (BIGINT) in content.facility_booking']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Facility bookings must be assigned to cost centers for facility cost allocation and chargeback to production departments. Replaces denormalized cost_center_code. Required for studio utilization report | Column cost_center_id (BIGINT) in finance.facility_booking']
  partner_id varchar [note: 'Identifier of the external facility vendor or studio lot operator when the booked facility is not company-owned. References the vendor master in SAP S/4HANA for procurement and payment processing. | Column partner_id (BIGINT) in partner.facility_booking']
  primary_facility_employee_id varchar [note: 'Identifier of the production coordinator or scheduler who created this facility booking. Used for accountability, approval workflows, and audit trail purposes. | Column primary_facility_employee_id (BIGINT) in workforce.facility_booking']
  production_project_id varchar [note: 'Identifier of the production project for which this facility is being booked. Links the booking to the overarching content production initiative. | Column production_project_id (BIGINT) in production.facility_booking']
  shoot_schedule_id varchar [note: 'Foreign key linking to production.shoot_schedule. Business justification: Facility bookings are made for specific shoot schedule entries. Operational link — booking times align with shoot schedule. Optional FK (nullable) — facilities may also be booked for post-production o | Column shoot_schedule_id (BIGINT) in production.facility_booking']
  studio_facility_id varchar [note: 'Identifier of the production facility being booked, referencing the master facility record that holds static attributes such as capacity and technical specifications. | Column studio_facility_id (BIGINT) in technology.facility_booking']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.facility_booking']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.facility_booking']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.facility_booking']
  actual_cost decimal(18,4) [note: 'The final invoiced or accrued cost of the facility booking after actual usage is confirmed. Includes any overtime charges or adjustments. Reconciled against estimated_cost for budget variance reporting in SAP S/4HANA CO. | Column actual_cost (DECIMAL(18,4)) in production.facility_booking']
  actual_end timestamp [note: 'The actual date and time the facility usage concluded, as recorded by the facility operator or production coordinator. Used for overtime calculation, billing reconciliation, and schedule variance reporting. | Column actual_end (TIMESTAMP) in production.facility_booking']
  actual_start timestamp [note: 'The actual date and time the facility usage commenced, as recorded by the facility operator or production coordinator. May differ from booking_start due to delays or early starts. Used for variance analysis and billing reconciliation. | Column actual_start (TIMESTAMP) in production.facility_booking']
  booking_end timestamp [note: 'The scheduled date and time at which the facility booking period ends. Combined with booking_start to compute duration and detect scheduling conflicts across productions. | Column booking_end (TIMESTAMP) in production.facility_booking']
  booking_reference varchar [note: 'Externally visible alphanumeric reference code assigned to this booking, used in communications with facility operators, vendors, and production coordinators. Corresponds to the booking order number in SAP S/4HANA MM module. | Column booking_reference (STRING) in production.facility_booking']
  booking_start timestamp [note: 'The scheduled date and time at which the facility booking period begins. Used for conflict detection, crew scheduling, and playout coordination. Stored in ISO 8601 format with timezone offset. | Column booking_start (TIMESTAMP) in production.facility_booking']
  booking_status varchar [note: 'Current lifecycle state of the facility booking. \'tentative\' indicates a provisional hold pending confirmation; \'confirmed\' indicates a firm reservation; \'cancelled\' indicates the booking was withdrawn; \'completed\' indicates the facility usage has concluded; \'on_hold\' indicates a temporary pause pending decision. | Column booking_status (STRING) in production.facility_booking']
  cancellation_date date [note: 'The date on which the facility booking was formally cancelled. Used to determine whether cancellation fees apply per the vendor contract terms and for financial accrual reversal in SAP S/4HANA. | Column cancellation_date (DATE) in production.facility_booking']
  cancellation_fee decimal(18,4) [note: 'Monetary penalty charged by the facility vendor when a confirmed booking is cancelled within the contractual notice period. Recorded for financial reconciliation and budget variance reporting. | Column cancellation_fee (DECIMAL(18,4)) in production.facility_booking']
  cancellation_reason varchar [note: 'Free-text explanation for why the booking was cancelled. Populated only when booking_status is \'cancelled\'. Used for production post-mortem analysis and vendor dispute resolution. | Column cancellation_reason (STRING) in production.facility_booking']
  capacity_persons varchar [note: 'Maximum number of persons the facility can accommodate during the booking period. Used for crew planning, health and safety compliance, and resource allocation decisions. | Column capacity_persons (INT) in production.facility_booking']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.facility_booking']
  created_timestamp timestamp [note: 'The date and time when this facility booking record was first created in the system. Serves as the audit trail creation marker and is used for SLA compliance tracking and data lineage. | Column created_timestamp (TIMESTAMP) in production.facility_booking']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the rate and total cost are denominated (e.g., USD, GBP, EUR). Required for multi-territory productions and financial reconciliation in SAP S/4HANA. | Column currency_code (STRING) in production.facility_booking']
  dalet_workflow_reference varchar [note: 'Reference identifier of the associated workflow job in Dalet Galaxy Media Asset Management system. Enables traceability between the facility booking and the ingest, metadata, or archive workflow triggered by the production activity. | Column dalet_workflow_reference (STRING) in production.facility_booking']
  estimated_cost decimal(18,4) [note: 'The projected total cost of the facility booking at the time of reservation, calculated from rate_amount and the planned booking duration. Used for production budget planning and greenlight approvals. | Column estimated_cost (DECIMAL(18,4)) in production.facility_booking']
  facility_location varchar [note: 'Physical location or campus of the facility (e.g., \'Burbank Studio Lot\', \'London Soho Post\'). Used for logistics planning, travel coordination, and geographic cost allocation. | Column facility_location (STRING) in production.facility_booking']
  facility_type varchar [note: 'Classification of the production facility being booked. Drives resource conflict detection logic and cost allocation rules. [ENUM-REF-CANDIDATE: soundstage|editing_suite|dubbing_stage|color_grading_suite|adr_studio|screening_room|post_production_bay — promote to reference product] | Column facility_type (STRING) in production.facility_booking']
  is_exclusive boolean [note: 'Indicates whether this booking grants exclusive use of the facility for the booked period, preventing any concurrent bookings by other productions. When False, the facility may be shared with other productions subject to capacity constraints. | Column is_exclusive (BOOLEAN) in production.facility_booking']
  notes varchar [note: 'Free-text field for production coordinators to capture special requirements, setup instructions, access arrangements, or other operational notes relevant to the facility booking. | Column notes (STRING) in production.facility_booking']
  overtime_hours decimal(8,2) [note: 'Number of hours the facility was used beyond the originally booked end time. Drives overtime rate calculations and is a key input to actual_cost reconciliation and production schedule variance analysis. | Column overtime_hours (DECIMAL(8,2)) in production.facility_booking']
  production_phase varchar [note: 'The stage of the content production lifecycle during which this facility is being used. Enables cost allocation by production phase and supports milestone tracking. [ENUM-REF-CANDIDATE: pre_production|principal_photography|post_production|vfx|color_grading|audio_mix|delivery — promote to reference product] | Column production_phase (STRING) in production.facility_booking']
  purchase_order_number varchar [note: 'SAP S/4HANA MM purchase order number raised for this facility booking when the facility is provided by an external vendor. Required for accounts payable processing and three-way match (PO, goods receipt, invoice). | Column purchase_order_number (STRING) in production.facility_booking']
  rate_amount decimal(18,4) [note: 'The contracted rate charged for the facility per the applicable rate_type unit (e.g., cost per hour or cost per day). Sourced from the facility rate card or negotiated contract. Used for budget estimation and cost allocation. | Column rate_amount (DECIMAL(18,4)) in production.facility_booking']
  rate_type varchar [note: 'The billing rate structure applied to this facility booking. Determines how the total cost is calculated — per hour, per day, half-day block, weekly block, or a negotiated flat fee. | Column rate_type (STRING) in production.facility_booking']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.facility_booking']
  technical_specs varchar [note: 'Free-text description of the technical capabilities and equipment configuration of the facility at the time of booking (e.g., \'Dolby Atmos 7.1.4 mixing console, Pro Tools HDX, 4K DI suite\'). Sourced from Dalet Galaxy facility metadata. | Column technical_specs (STRING) in production.facility_booking']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.facility_booking']
  updated_timestamp timestamp [note: 'The date and time when this facility booking record was most recently modified. Used for change detection in ETL pipelines, audit compliance, and conflict resolution in concurrent update scenarios. | Column updated_timestamp (TIMESTAMP) in production.facility_booking']
  wbs_element varchar [note: 'SAP S/4HANA Project System Work Breakdown Structure element code that identifies the specific production phase or deliverable to which this facility cost is charged. Enables granular project cost tracking. | Column wbs_element (STRING) in production.facility_booking']

  Note: 'Reservation and usage record for a production facility — soundstage, editing suite, dubbing stage, color grading suite, ADR studio, screening room, or post-production bay. Captures facility name, facility type, location, booking start datetime, booking end datetime, booked production project, booked episode or segment, booking status (tentative, confirmed, cancelled), rate per hour or day, total cost, and technical specifications of the facility. Enables resource conflict detection and cost allocation. | Unity Catalog table: media_broadcasting_ecm.production.facility_booking'
}

Table production.equipment_allocation {
  equipment_allocation_id varchar [pk, note: 'Unique surrogate identifier for each equipment allocation record. Primary key for the equipment_allocation data product in the production domain. | Column equipment_allocation_id (BIGINT) in production.equipment_allocation']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Equipment allocations must be tracked to cost centers for equipment cost tracking and departmental chargebacks. Replaces denormalized cost_centre_code (British spelling). Required for rental cost allo | Column cost_center_id (BIGINT) in finance.equipment_allocation']
  employee_id varchar [note: 'Reference to the crew member accountable for the equipment during the allocation period. Used for loss, damage, and insurance claim attribution. | Column employee_id (BIGINT) in workforce.equipment_allocation']
  equipment_item_id varchar [note: 'Reference to the master equipment item record (camera body, lens, lighting rig, sound package, jib, drone, editing workstation, encoding hardware) being allocated. | Column equipment_item_id (BIGINT) in production.equipment_allocation']
  partner_id varchar [note: 'Reference to the external rental vendor supplying the equipment. Null when the equipment is an owned asset. Used for vendor cost reconciliation in SAP S/4HANA. | Column partner_id (BIGINT) in partner.equipment_allocation']
  production_project_id varchar [note: 'Reference to the production project or title to which this equipment is allocated. Links the allocation to the broader production workflow managed in Dalet Galaxy. | Column production_project_id (BIGINT) in production.equipment_allocation']
  shoot_day_id varchar [note: 'Reference to the specific shoot day or production schedule entry for which the equipment is allocated. Enables day-level cost tracking and scheduling conflict detection. | Column shoot_day_id (BIGINT) in production.equipment_allocation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.equipment_allocation']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.equipment_allocation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.equipment_allocation']
  allocation_end_date date [note: 'The date on which the equipment allocation ends — i.e., the last day the equipment is assigned to the production. Used for rental cost calculation and return scheduling. | Column allocation_end_date (DATE) in production.equipment_allocation']
  allocation_number varchar [note: 'Externally-known business identifier for the allocation record, used in production paperwork, crew call sheets, and facility booking confirmations. Format: EQALLOC-{YYYY}-{NNNNNN}. | Column allocation_number (STRING) in production.equipment_allocation']
  allocation_start_date date [note: 'The date on which the equipment allocation begins — i.e., the first day the equipment is available to the production. Used for rental rate calculation and scheduling conflict detection. | Column allocation_start_date (DATE) in production.equipment_allocation']
  allocation_status varchar [note: 'Current lifecycle state of the equipment allocation. Drives workflow routing in Dalet Galaxy and cost accrual in SAP S/4HANA. [ENUM-REF-CANDIDATE: requested|confirmed|checked_out|in_use|checked_in|cancelled|lost|damaged — promote to reference product] | Column allocation_status (STRING) in production.equipment_allocation']
  asset_tag_code varchar [note: 'Internal asset tag or barcode label affixed to owned equipment for physical inventory tracking. Format: {CC}-{NNNNNN} where CC is category code. Null for rented equipment. | Column asset_tag_code (STRING) in production.equipment_allocation']
  checkout_condition varchar [note: 'Assessed physical condition of the equipment at the time of checkout. Establishes the baseline condition for damage assessment upon return. Recorded by the equipment manager. | Column checkout_condition (STRING) in production.equipment_allocation']
  checkout_timestamp timestamp [note: 'Exact date and time the equipment was physically checked out from the equipment room or rental house. Serves as the principal business event timestamp for the allocation lifecycle. | Column checkout_timestamp (TIMESTAMP) in production.equipment_allocation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.equipment_allocation']
  created_timestamp timestamp [note: 'Timestamp when the equipment allocation record was first created in the system. Supports audit trail requirements and data lineage tracking in the Databricks Silver Layer. | Column created_timestamp (TIMESTAMP) in production.equipment_allocation']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the rental rate and insurance value amounts (e.g., USD, GBP, EUR). Supports multi-currency productions and financial consolidation in SAP S/4HANA FI. | Column currency_code (STRING) in production.equipment_allocation']
  dalet_workflow_reference varchar [note: 'Identifier of the associated Dalet Galaxy workflow instance that orchestrates the equipment allocation within the broader production ingest and post-production pipeline. Enables end-to-end workflow traceability. | Column dalet_workflow_reference (STRING) in production.equipment_allocation']
  damage_claim_amount decimal(18,2) [note: 'Monetary value of the damage or loss claim raised against this allocation, in the currency specified by currency_code. Null when no damage claim exists. Used for financial reconciliation and insurance recovery. | Column damage_claim_amount (DECIMAL(18,2)) in production.equipment_allocation']
  damage_description varchar [note: 'Free-text description of any damage, loss, or malfunction identified at return. Null when equipment is returned in acceptable condition. Used to support insurance claims and vendor dispute resolution. | Column damage_description (STRING) in production.equipment_allocation']
  equipment_category varchar [note: 'High-level classification of the equipment type being allocated. Drives cost centre coding, insurance grouping, and crew department assignment. [ENUM-REF-CANDIDATE: camera|lens|lighting|sound|grip|drone|editing_workstation|encoding_hardware|other — promote to reference product] | Column equipment_category (STRING) in production.equipment_allocation']
  equipment_name varchar [note: 'Human-readable name or model designation of the equipment item (e.g., ARRI ALEXA Mini LF, Cooke S4/i 32mm, Litepanels Astra 6X). Supports crew call sheets and production reports. | Column equipment_name (STRING) in production.equipment_allocation']
  insurance_policy_number varchar [note: 'Reference number of the insurance policy covering this equipment allocation. Used for claims processing and compliance with production insurance requirements. | Column insurance_policy_number (STRING) in production.equipment_allocation']
  insurance_value decimal(18,2) [note: 'Declared replacement value of the equipment for insurance purposes, in the currency specified by currency_code. Used to calculate insurance premiums and process loss/damage claims. | Column insurance_value (DECIMAL(18,2)) in production.equipment_allocation']
  is_insurance_required boolean [note: 'Indicates whether specific insurance coverage must be arranged for this equipment allocation (True) or whether it falls under the production\'s blanket policy (False). Relevant for high-value or specialist equipment. | Column is_insurance_required (BOOLEAN) in production.equipment_allocation']
  is_owned_asset boolean [note: 'Indicates whether the equipment is owned by the production company (True) or rented from an external vendor (False). Drives depreciation accounting vs. rental cost booking in SAP S/4HANA FI. | Column is_owned_asset (BOOLEAN) in production.equipment_allocation']
  notes varchar [note: 'Free-text field for additional operational notes related to the equipment allocation, such as special handling instructions, configuration requirements, or crew briefing notes. | Column notes (STRING) in production.equipment_allocation']
  production_department varchar [note: 'The production department responsible for the equipment allocation (e.g., camera, lighting, grip, sound). Used for departmental budget tracking and cost centre allocation in SAP S/4HANA CO. [ENUM-REF-CANDIDATE: camera|lighting|grip|sound|art|vfx|post_production|production_office|other — promote to reference product] | Column production_department (STRING) in production.equipment_allocation']
  purchase_order_number varchar [note: 'SAP S/4HANA purchase order number raised for the equipment rental from an external vendor. Null for owned assets. Used for three-way match (PO, goods receipt, invoice) in accounts payable. | Column purchase_order_number (STRING) in production.equipment_allocation']
  quantity varchar [note: 'Number of identical equipment units covered by this allocation record (e.g., 3 identical LED panels allocated as a single record). Defaults to 1 for individually serialised items. | Column quantity (INT) in production.equipment_allocation']
  rental_rate_amount decimal(18,2) [note: 'The agreed rental rate per day or per week (per rental_rate_type) for the equipment, in the production\'s base currency. Used for production budget tracking and vendor cost reconciliation in SAP S/4HANA. | Column rental_rate_amount (DECIMAL(18,2)) in production.equipment_allocation']
  rental_rate_type varchar [note: 'Indicates whether the rental rate is charged on a daily, weekly, or flat-fee basis. Determines how the total rental cost is computed for budget tracking and vendor invoice reconciliation. | Column rental_rate_type (STRING) in production.equipment_allocation']
  return_condition varchar [note: 'Assessed physical condition of the equipment at the time of return. Compared against checkout_condition to identify damage or deterioration. Triggers damage claim workflow if degraded. [ENUM-REF-CANDIDATE: new|excellent|good|fair|poor|damaged|lost — 7 candidates stripped; promote to reference product] | Column return_condition (STRING) in production.equipment_allocation']
  return_timestamp timestamp [note: 'Exact date and time the equipment was physically returned to the equipment room or rental house. Null until the equipment is returned. Used to calculate actual rental duration and late return penalties. | Column return_timestamp (TIMESTAMP) in production.equipment_allocation']
  serial_number varchar [note: 'Manufacturer serial number of the specific equipment unit allocated. Used for asset tracking, insurance claims, and loss/damage investigations. Classified confidential as it identifies a specific high-value asset. | Column serial_number (STRING) in production.equipment_allocation']
  shoot_location varchar [note: 'Name or description of the physical location where the equipment will be used (e.g., Stage 4 - Pinewood Studios, Exterior - Canary Wharf, OB Van Unit 3). Supports logistics planning and insurance coverage verification. | Column shoot_location (STRING) in production.equipment_allocation']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.equipment_allocation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.equipment_allocation']
  updated_timestamp timestamp [note: 'Timestamp when the equipment allocation record was last modified. Used for change data capture (CDC) in the Databricks Silver Layer pipeline and audit compliance. | Column updated_timestamp (TIMESTAMP) in production.equipment_allocation']
  wbs_element_code varchar [note: 'SAP S/4HANA Work Breakdown Structure (WBS) element code identifying the specific production phase or deliverable to which this equipment cost is attributed (e.g., pre-production, principal photography, post-production). | Column wbs_element_code (STRING) in production.equipment_allocation']

  Note: 'Allocation record tracking the assignment of production equipment (cameras, lenses, lighting rigs, sound packages, jibs, drones, editing workstations, encoding hardware) to a production project or shoot day. Captures equipment item, equipment category, serial number, rental vendor or owned asset flag, allocation start date, allocation end date, daily or weekly rental rate, insurance value, condition at checkout, condition at return, and responsible crew member. Supports equipment cost tracking and loss/damage management. | Unity Catalog table: media_broadcasting_ecm.production.equipment_allocation'
}

Table production.production_episode {
  production_episode_id varchar [pk, note: 'Unique surrogate identifier for the production episode record in the lakehouse Silver layer. Serves as the primary key for all downstream joins and lineage tracking. | Column production_episode_id (BIGINT) in production.production_episode']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Episodes require content ratings before broadcast/distribution. Core regulatory workflow linking production output to compliance certification. Drives scheduling decisions and parental control metadat | Column compliance_content_rating_id (BIGINT) in compliance.production_episode']
  coppa_declaration_id varchar [note: 'Foreign key linking to compliance.coppa_declaration. Business justification: Individual episodes may require COPPA declarations independent of project-level status when content varies by episode. Essential for mixed-audience series with occasional child-directed episodes. | Column coppa_declaration_id (BIGINT) in compliance.production_episode']
  media_asset_id varchar [note: 'Native asset identifier assigned by Dalet Galaxy Media Asset Management system for this episode. Used for direct lookup and workflow orchestration in the MAM system, ingest tracking, and archive retrieval. | Column media_asset_id (BIGINT) in mediaasset.production_episode']
  production_content_episode_id varchar [note: 'FK to content episode for catalog metadata linkage | Column content_episode_id (BIGINT) in content.production_episode']
  project_id varchar [note: 'Reference to the parent production project (series, mini-series, anthology, or episodic documentary) to which this episode belongs. Establishes the episode-to-project hierarchy. | Column project_id (BIGINT) in production.production_episode']
  release_window_id varchar [note: 'Foreign key linking to distribution.release_window. Business justification: Episodes are released within specific distribution windows defining platform, territory, and timing. Real business process: episodic release scheduling, windowing strategy execution, and platform excl | Column release_window_id (BIGINT) in distribution.production_episode']
  script_id varchar [note: 'Foreign key linking to production.script. Business justification: Episodes are based on specific scripts. Strong content relationship — script is the source document for episode production. FK links episode to the locked script version used for production. | Column script_id (BIGINT) in production.production_episode']
  season_id varchar [note: 'Reference to the season record that groups this episode within a multi-season series. Null for mini-series or anthology formats that do not have a season structure. | Column season_id (BIGINT) in content.production_episode']
  syndication_license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Individual episodes may have separate syndication or international license agreements distinct from the series-level agreement. Real business need: episode-level rights tracking for syndication deals, | Column syndication_license_agreement_id (BIGINT) in rights.production_episode']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Production episodes generate content title records. While production_episode links to season, direct title linkage is needed for episodic content workflows, metadata delivery, and distribution schedul | Column title_id (BIGINT) in content.production_episode']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.production_episode']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.production_episode']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.production_episode']
  actual_cost_usd decimal(18,2) [note: 'Total actual production cost incurred for this episode in US dollars, as recorded in SAP S/4HANA. Used for budget variance analysis, EBITDA reporting, and production cost per minute calculations. | Column actual_cost_usd (DECIMAL(18,2)) in production.production_episode']
  actual_delivery_date date [note: 'Date on which the completed episode master was actually delivered to the distributor, broadcaster, or platform. Compared against scheduled_delivery_date for SLA compliance and penalty assessment. | Column actual_delivery_date (DATE) in production.production_episode']
  actual_running_time_sec varchar [note: 'Final delivered running time of the episode in seconds as measured from the completed master file. May differ from target due to editorial decisions made during post-production. Used for playout scheduling reconciliation and delivery compliance verification. | Column actual_running_time_sec (INT) in production.production_episode']
  approved_budget_usd decimal(18,2) [note: 'Total approved production budget for this episode in US dollars, as sanctioned at greenlight. Used for budget vs. actual variance analysis in SAP S/4HANA CO and financial reporting under SOX compliance. | Column approved_budget_usd (DECIMAL(18,2)) in production.production_episode']
  audio_language_code varchar [note: 'ISO 639-2 three-letter language code for the primary audio track of this episode. Used for distribution rights matching, subtitle/dubbing workflow triggering, and EPG metadata population. | Column audio_language_code (STRING) in production.production_episode']
  audio_mix_completion_date date [note: 'Date on which the final audio mix (including dialogue, music, and effects) was completed and approved. Prerequisite for final mastering and delivery. Tracked as a post-production milestone in Dalet Galaxy. | Column audio_mix_completion_date (DATE) in production.production_episode']
  closed_captioning_compliant boolean [note: 'Indicates whether this episode meets FCC closed captioning requirements (47 CFR Part 79) and Ofcom subtitling standards. Required for broadcast clearance and regulatory compliance reporting. | Column closed_captioning_compliant (BOOLEAN) in production.production_episode']
  color_grade_completion_date date [note: 'Date on which color grading (digital color correction and finishing) was completed and approved. Required before final mastering and transcode for delivery. Tracked as a post-production milestone in Dalet Galaxy. | Column color_grade_completion_date (DATE) in production.production_episode']
  content_rating varchar [note: 'Audience content rating assigned to this episode per the TV Parental Guidelines system (US) or equivalent regulatory body. Required for EPG metadata, DAI ad targeting restrictions, and COPPA compliance for children\'s content. | Column content_rating (STRING) in production.production_episode']
  content_type varchar [note: 'Broad classification of the episode content format. Determines applicable production workflows, rights frameworks, talent residual calculations, and compliance requirements (e.g., COPPA for children\'s content). [ENUM-REF-CANDIDATE: scripted|unscripted|documentary|news|sports|animation|live_event — promote to reference product] | Column content_type (STRING) in production.production_episode']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.production_episode']
  created_timestamp timestamp [note: 'Timestamp when this production episode record was first created in the system. Used for audit trail, data lineage, and production workflow initiation tracking. Conforms to ISO 8601 extended format. | Column created_timestamp (TIMESTAMP) in production.production_episode']
  delivery_date date [note: 'Contractually committed or operationally planned date by which the completed episode master must be delivered to the distributor, broadcaster, or platform. Used for SLA tracking and rights window activation in Rightsline. | Column delivery_date (DATE) in production.production_episode']
  director_name varchar [note: 'Full name of the credited director for this episode. Used for DGA residuals calculation, talent contract compliance, and creative attribution in production records. | Column director_name (STRING) in production.production_episode']
  eidr_code varchar [note: 'EIDR content identifier for this episode, enabling interoperability across supply chain partners, distributors, and rights management systems. Registered with the Entertainment Identifier Registry. | Column eidr_code (STRING) in production.production_episode']
  episode_code varchar [note: 'Internal production code assigned by the production team to uniquely identify this episode within the production management system (e.g., Dalet Galaxy asset code). Used for workflow routing, asset tagging, and facility booking references. | Column episode_code (STRING) in production.production_episode']
  episode_number varchar [note: 'Sequential production episode number within the season or series. Used for scheduling, EPG metadata, and audience tracking. Corresponds to the broadcast order number. | Column episode_number (INT) in production.production_episode']
  first_air_date date [note: 'Date on which this episode first aired or was made available to audiences on any platform (linear broadcast, VOD, OTT). Marks the start of the content windowing lifecycle and triggers residuals calculation in Rightsline. | Column first_air_date (DATE) in production.production_episode']
  greenlight_date date [note: 'Date on which executive approval (greenlight) was granted to proceed with production of this episode. Marks the official start of the production lifecycle and triggers budget release in SAP S/4HANA. | Column greenlight_date (DATE) in production.production_episode']
  isan varchar [note: 'Globally unique identifier for this episode as registered with the ISAN International Agency. Used for rights clearance, royalty tracking, and cross-platform content identification. Conforms to ISO 15706-2. | Column isan (STRING) in production.production_episode']
  master_format varchar [note: 'Technical format specification of the delivered episode master file (e.g., UHD HDR, HD 1080p). Determines transcode profiles required for multi-platform distribution and CDN delivery via Akamai. | Column master_format (STRING) in production.production_episode']
  picture_lock_date date [note: 'Date on which the final edited picture was locked, freezing all visual edits. Triggers downstream post-production workflows including VFX, color grading, and audio mixing. Critical milestone for delivery scheduling. | Column picture_lock_date (DATE) in production.production_episode']
  production_company varchar [note: 'Name of the production company or studio responsible for producing this episode. Used for co-production agreements, rights attribution, and financial reconciliation in SAP S/4HANA. | Column production_company (STRING) in production.production_episode']
  production_status varchar [note: 'Current lifecycle stage of the episode within the end-to-end production workflow. Drives workflow routing in Dalet Galaxy and milestone reporting to production management. [ENUM-REF-CANDIDATE: development|pre_production|principal_photography|post_production|picture_lock|delivered|archived — promote to reference product] | Column production_status (STRING) in production.production_episode']
  script_lock_date date [note: 'Date on which the final shooting script was locked, freezing all creative changes. Triggers pre-production scheduling, crew assignments, and facility bookings. Key milestone for production planning. | Column script_lock_date (DATE) in production.production_episode']
  shoot_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the primary country where principal photography was conducted. Used for production tax credit eligibility, co-production treaty compliance, and content origin classification. | Column shoot_country_code (STRING) in production.production_episode']
  shoot_end_date date [note: 'Scheduled or actual end date of principal photography (picture wrap) for this episode. Used to confirm transition to post-production and trigger post-production workflow initiation in Dalet Galaxy. | Column shoot_end_date (DATE) in production.production_episode']
  shoot_location varchar [note: 'Primary geographic location where principal photography for this episode was conducted. Used for production tax credit eligibility, location permit compliance, and production logistics reporting. | Column shoot_location (STRING) in production.production_episode']
  shoot_start_date date [note: 'Scheduled or actual start date of principal photography for this episode. Used for crew scheduling, facility booking, and production budget burn-rate tracking in SAP S/4HANA. | Column shoot_start_date (DATE) in production.production_episode']
  showrunner_name varchar [note: 'Full name of the showrunner (executive producer with creative oversight) responsible for this episode. Key accountability reference for production governance and editorial decisions. | Column showrunner_name (STRING) in production.production_episode']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.production_episode']
  subtitle_languages varchar [note: 'Comma-separated list of ISO 639-2 three-letter language codes for subtitle tracks available in the delivered master. Used for accessibility compliance (FCC closed captioning rules), distribution rights, and EPG metadata. | Column subtitle_languages (STRING) in production.production_episode']
  target_running_time_sec varchar [note: 'Planned editorial running time of the episode in seconds, excluding commercial breaks. Used for scheduling slot allocation, playout automation configuration in Ericsson MediaFirst, and delivery specification compliance. | Column target_running_time_sec (INT) in production.production_episode']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.production_episode']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this production episode record. Used for incremental data pipeline processing, change data capture, and audit compliance in the Databricks Silver layer. | Column updated_timestamp (TIMESTAMP) in production.production_episode']
  vfx_completion_date date [note: 'Date on which all visual effects shots were completed and approved for integration into the picture lock. Tracked as a post-production milestone. Null if the episode contains no VFX work. | Column vfx_completion_date (DATE) in production.production_episode']
  writer_name varchar [note: 'Full name of the credited writer(s) for this episode. Used for residuals calculation, WGA/guild compliance reporting, and rights attribution in Rightsline. | Column writer_name (STRING) in production.production_episode']

  Note: 'Master record for an individual episode, segment, or installment within a production project (series, mini-series, anthology, or episodic documentary). Captures episode number, episode title, season number, running time target, production status, writer, director, script lock date, picture lock date, audio mix completion date, delivery date, and ISAN episode identifier. Acts as the granular production unit below the project level for episodic content. | Unity Catalog table: media_broadcasting_ecm.production.production_episode'
}

Table production.script {
  script_id varchar [pk, note: 'Unique identifier for the production script or screenplay record. Primary key. | Column script_id (BIGINT) in production.script']
  production_project_id varchar [note: 'Reference to the parent production project or episode to which this script belongs. | Column production_project_id (BIGINT) in production.script']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Scripts are written for specific content titles. Essential for pre-production planning, rights clearance (script-based content analysis), and tracking script versions against final distributed content | Column title_id (BIGINT) in content.script']
  underlying_rights_holder_id varchar [note: 'Foreign key linking to rights.rights_holder. Business justification: Scripts are often based on underlying IP owned by rights holders (novels, plays, life rights, true stories, existing franchises). Real business need: tracking the rights holder of the underlying IP be | Column underlying_rights_holder_id (BIGINT) in rights.script']
  writer_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: When writers are staff employees (vs. freelance), tracking employment relationship is essential for WGA residuals calculation, benefits administration, and tax reporting—common in animation and daytim | Column writer_employee_id (BIGINT) in workforce.script']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.script']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.script']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.script']
  approval_date date [note: 'The date on which the script was officially approved for production. | Column approval_date (DATE) in production.script']
  approved_by varchar [note: 'The name or identifier of the individual or role who approved the script for production. | Column approved_by (STRING) in production.script']
  confidentiality_level varchar [note: 'The confidentiality classification of the script document (public, internal, confidential, restricted). | Column confidentiality_level (STRING) in production.script']
  copyright_holder varchar [note: 'The legal entity or individual who holds the copyright to the script. | Column copyright_holder (STRING) in production.script']
  copyright_year varchar [note: 'The year in which the script copyright was established or registered. | Column copyright_year (INT) in production.script']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.script']
  created_timestamp timestamp [note: 'The timestamp when this script record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.script']
  dalet_document_reference varchar [note: 'The unique document identifier or reference in the Dalet Galaxy Media Asset Management (MAM) system linking this script record to the digital script file. | Column dalet_document_reference (STRING) in production.script']
  distribution_restriction varchar [note: 'Any restrictions or limitations on the distribution or sharing of the script (e.g., internal use only, NDA required). | Column distribution_restriction (STRING) in production.script']
  draft_type varchar [note: 'The classification of the script draft stage (outline, first draft, revised draft, shooting script, post-production script, final draft). | Column draft_type (STRING) in production.script']
  estimated_runtime_minutes varchar [note: 'The estimated runtime of the production in minutes based on the script length and pacing. | Column estimated_runtime_minutes (INT) in production.script']
  file_format varchar [note: 'The digital file format of the script document (PDF, DOCX, FDX, FOUNTAIN, TXT). | Column file_format (STRING) in production.script']
  file_size_mb decimal(10,2) [note: 'The size of the script file in megabytes. | Column file_size_mb (DECIMAL(10,2)) in production.script']
  format varchar [note: 'The production format for which the script is intended (feature film, television episode, miniseries, web series, documentary, commercial, short film). [ENUM-REF-CANDIDATE: feature film|television episode|miniseries|web series|documentary|commercial|short film — 7 candidates stripped; promote to reference product] | Column format (STRING) in production.script']
  genre varchar [note: 'The genre or category of the script (e.g., drama, comedy, thriller, documentary). | Column genre (STRING) in production.script']
  language varchar [note: 'The primary language in which the script is written (e.g., English, Spanish, French). | Column language (STRING) in production.script']
  lock_date date [note: 'The date on which the script was locked and finalized for production. | Column lock_date (DATE) in production.script']
  lock_status boolean [note: 'Indicates whether the script is locked for production (true) or still open for revisions (false). | Column lock_status (BOOLEAN) in production.script']
  notes varchar [note: 'General notes, comments, or annotations related to the script for production reference. | Column notes (STRING) in production.script']
  page_count varchar [note: 'The total number of pages in the script document. | Column page_count (INT) in production.script']
  revision_date date [note: 'The date of the most recent revision or update to the script. | Column revision_date (DATE) in production.script']
  revision_notes varchar [note: 'Notes or comments describing the changes made in the current revision of the script. | Column revision_notes (STRING) in production.script']
  rights_clearance_status varchar [note: 'The status of rights clearance for the script (pending, cleared, restricted, expired). | Column rights_clearance_status (STRING) in production.script']
  scene_count varchar [note: 'The total number of scenes defined in the script. | Column scene_count (INT) in production.script']
  script_number varchar [note: 'The externally-known unique identifier or code assigned to this script for production tracking and reference purposes. | Column script_number (STRING) in production.script']
  script_status varchar [note: 'Current lifecycle status of the script (draft, in review, approved, locked, archived, rejected). | Column script_status (STRING) in production.script']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.script']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.script']
  updated_timestamp timestamp [note: 'The timestamp when this script record was last updated or modified. | Column updated_timestamp (TIMESTAMP) in production.script']
  version_number varchar [note: 'The version or revision number of the script (e.g., 1.0, 2.3, Final). | Column version_number (STRING) in production.script']
  wga_registration_number varchar [note: 'The WGA registration number assigned to this script for copyright and intellectual property protection. | Column wga_registration_number (STRING) in production.script']
  writer_credits varchar [note: 'The names and credits of the writer(s) who authored or contributed to the script. | Column writer_credits (STRING) in production.script']

  Note: 'Master record for a production script or screenplay associated with a production project or episode. Captures script title, version number, draft type (outline, first draft, revised draft, shooting script, post-production script), writer credits, WGA registration number, page count, script lock status, lock date, language, and Dalet Galaxy document reference. Tracks the full script revision history and serves as the authoritative script record for production and rights purposes. | Unity Catalog table: media_broadcasting_ecm.production.script'
}

Table production.post_production_task {
  post_production_task_id varchar [pk, note: 'Unique identifier for the post-production task within the Dalet Galaxy workflow orchestration pipeline. | Column post_production_task_id (BIGINT) in production.post_production_task']
  content_episode_id varchar [note: 'Reference to the parent episode or content asset that this post-production task is associated with. | Column content_episode_id (BIGINT) in content.post_production_task']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: Post-production tasks (editing, color, audio mix) create specific content versions. Critical for tracking which production tasks generated which distributable versions, version lineage, and linking pr | Column content_version_id (BIGINT) in content.post_production_task']
  deliverable_id varchar [note: 'Foreign key linking to production.deliverable. Business justification: Post-production tasks produce deliverables. Optional FK (nullable) — not all tasks produce final deliverables (intermediate tasks). When populated, links task output to contractual/operational deliver | Column deliverable_id (BIGINT) in production.post_production_task']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Post-production tasks (editing, color grading, audio mix) produce intermediate and final assets stored in MAM. Role-prefixed as output_asset_id to distinguish from source media. Critical for workflow  | Column media_asset_id (BIGINT) in mediaasset.post_production_task']
  parent_task_post_production_task_id varchar [note: 'Reference to the parent post-production task if this task is a sub-task or dependent task in a hierarchical workflow. | Column parent_task_post_production_task_id (BIGINT) in production.post_production_task']
  partner_id varchar [note: 'Reference to the external vendor or post-production facility assigned to perform this task, if outsourced. | Column partner_id (BIGINT) in partner.post_production_task']
  primary_post_employee_id varchar [note: 'Reference to the crew member or operator assigned to execute this post-production task. | Column primary_post_employee_id (BIGINT) in workforce.post_production_task']
  production_project_id varchar [note: 'Reference to the parent production project that this post-production task belongs to. | Column production_project_id (BIGINT) in production.post_production_task']
  script_id varchar [note: 'Foreign key linking to production.script. Business justification: Post-production tasks reference scripts for scene/dialogue context. Optional FK (nullable) — provides editorial context for tasks. Enables linking task to script version for continuity. | Column script_id (BIGINT) in production.post_production_task']
  studio_facility_id varchar [note: 'Reference to the post-production facility or studio where the task is being performed. | Column studio_facility_id (BIGINT) in technology.post_production_task']
  vfx_shot_id varchar [note: 'Foreign key linking to production.vfx_shot. Business justification: VFX-specific post-production tasks (compositing, rendering, etc.) are shot-specific. Optional FK (nullable) — only VFX tasks populate this. Enables linking Dalet workflow tasks to VFX shot tracking. | Column vfx_shot_id (BIGINT) in production.post_production_task']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.post_production_task']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.post_production_task']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.post_production_task']
  actual_completion_timestamp timestamp [note: 'Actual date and time when the post-production task was completed and submitted for review or approval. | Column actual_completion_timestamp (TIMESTAMP) in production.post_production_task']
  actual_cost_amount decimal(15,2) [note: 'Actual cost incurred for completing this post-production task, used for budget variance analysis. | Column actual_cost_amount (DECIMAL(15,2)) in production.post_production_task']
  actual_duration_hours decimal(8,2) [note: 'Actual number of hours spent completing the post-production task, used for cost tracking and performance analysis. | Column actual_duration_hours (DECIMAL(8,2)) in production.post_production_task']
  actual_start_timestamp timestamp [note: 'Actual date and time when work on the post-production task commenced. | Column actual_start_timestamp (TIMESTAMP) in production.post_production_task']
  approved_timestamp timestamp [note: 'Date and time when the task output was formally approved and authorized to proceed to the next workflow stage. | Column approved_timestamp (TIMESTAMP) in production.post_production_task']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.post_production_task']
  created_timestamp timestamp [note: 'Date and time when this post-production task record was first created in the workflow system. | Column created_timestamp (TIMESTAMP) in production.post_production_task']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts associated with this task. | Column currency_code (STRING) in production.post_production_task']
  dalet_workflow_task_reference varchar [note: 'External system identifier from Dalet Galaxy workflow orchestration system for this specific task instance. | Column dalet_workflow_task_reference (STRING) in production.post_production_task']
  dependency_type varchar [note: 'Type of scheduling dependency relationship this task has with its predecessor tasks in the workflow. | Column dependency_type (STRING) in production.post_production_task']
  estimated_cost_amount decimal(15,2) [note: 'Budgeted cost for completing this post-production task, including labor, equipment, and vendor fees. | Column estimated_cost_amount (DECIMAL(15,2)) in production.post_production_task']
  estimated_duration_hours decimal(8,2) [note: 'Planned number of hours required to complete the post-production task, used for resource planning and scheduling. | Column estimated_duration_hours (DECIMAL(8,2)) in production.post_production_task']
  output_media_path varchar [note: 'File system path or MAM location where the completed output files or deliverables from this task are stored. | Column output_media_path (STRING) in production.post_production_task']
  priority varchar [note: 'Business priority level assigned to the task, determining scheduling and resource allocation urgency. | Column priority (STRING) in production.post_production_task']
  qc_pass_flag boolean [note: 'Indicator of whether the task output passed quality control review on first submission without requiring revisions. | Column qc_pass_flag (BOOLEAN) in production.post_production_task']
  rejection_reason varchar [note: 'Explanation of why the task output was rejected during review, requiring rework or revision. | Column rejection_reason (STRING) in production.post_production_task']
  review_notes varchar [note: 'Feedback, comments, or change requests provided by reviewers or approvers during the quality control or approval process. | Column review_notes (STRING) in production.post_production_task']
  revision_number varchar [note: 'Version number indicating how many times this task has been revised or reworked due to feedback or quality issues. | Column revision_number (INT) in production.post_production_task']
  scheduled_due_date date [note: 'Target completion date for the post-production task as defined in the production schedule. | Column scheduled_due_date (DATE) in production.post_production_task']
  scheduled_start_date date [note: 'Planned date when the post-production task is scheduled to begin. | Column scheduled_start_date (DATE) in production.post_production_task']
  sequence_number varchar [note: 'Ordering position of this task within the overall post-production workflow or within a parent task group. | Column sequence_number (INT) in production.post_production_task']
  source_media_path varchar [note: 'File system path or Media Asset Management (MAM) location of the source media files or assets for this task. | Column source_media_path (STRING) in production.post_production_task']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.post_production_task']
  task_notes varchar [note: 'General operational notes, instructions, or context information related to the execution of this post-production task. | Column task_notes (STRING) in production.post_production_task']
  task_number varchar [note: 'Human-readable business identifier for the post-production task, often used for tracking and communication purposes. | Column task_number (STRING) in production.post_production_task']
  task_status varchar [note: 'Current lifecycle status of the post-production task within the workflow pipeline. [ENUM-REF-CANDIDATE: queued|in_progress|review|approved|rejected|complete|on_hold|cancelled — 8 candidates stripped; promote to reference product] | Column task_status (STRING) in production.post_production_task']
  task_type varchar [note: 'Classification of the post-production work task indicating the specific type of creative or technical operation being performed. [ENUM-REF-CANDIDATE: offline_edit|online_conform|vfx_composite|color_grade|audio_mix|adr_record|subtitle_burn_in|qc_review|transcode|archive_ingest|foley_record|sound_design|title_graphics|versioning — 14 candidates stripped; promote to reference product] | Column task_type (STRING) in production.post_production_task']
  technical_specification varchar [note: 'Detailed technical requirements and parameters for the task output, such as resolution, frame rate, codec, color space, or audio format. | Column technical_specification (STRING) in production.post_production_task']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.post_production_task']
  updated_timestamp timestamp [note: 'Date and time when this post-production task record was last modified or updated. | Column updated_timestamp (TIMESTAMP) in production.post_production_task']
  workstation_code varchar [note: 'Identifier of the specific editing suite, color grading bay, or audio mixing console assigned for this task. | Column workstation_code (STRING) in production.post_production_task']

  Note: 'Individual post-production work task within the Dalet Galaxy workflow orchestration pipeline. Captures task type (offline edit, online conform, VFX composite, color grade, audio mix, ADR record, subtitle burn-in, QC review, transcode, archive ingest), assigned operator or vendor, task status (queued, in-progress, review, approved, rejected, complete), priority, due date, actual completion date, parent episode or deliverable, and Dalet Galaxy workflow task ID. Enables end-to-end post-production workflow tracking. | Unity Catalog table: media_broadcasting_ecm.production.post_production_task'
}

Table production.vfx_shot {
  vfx_shot_id varchar [pk, note: 'Unique identifier for the VFX shot record. Primary key. | Column vfx_shot_id (BIGINT) in production.vfx_shot']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: VFX rendering and processing often occurs at specific broadcast facilities with render farms and high-performance workstations. Real-world VFX operations track facility assignment for resource allocat | Column broadcast_facility_id (BIGINT) in technology.vfx_shot']
  employee_id varchar [note: 'Reference to the VFX supervisor responsible for overseeing the creative and technical execution of this shot. | Column employee_id (BIGINT) in workforce.vfx_shot']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: VFX shots produce rendered asset files stored in MAM for editorial integration. Role-prefixed as rendered_asset_id to distinguish from source plates. Critical for VFX delivery workflows and version co | Column media_asset_id (BIGINT) in mediaasset.vfx_shot']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: VFX shots are episode-specific. Optional FK (nullable) — VFX may be project-level or episode-level. Enables episode-specific VFX tracking and cost allocation for episodic content. | Column production_episode_id (BIGINT) in production.vfx_shot']
  production_project_id varchar [note: 'Reference to the parent production project for which this VFX shot is being created. | Column production_project_id (BIGINT) in production.vfx_shot']
  script_id varchar [note: 'Foreign key linking to production.script. Business justification: VFX shots reference specific script scenes. FK links VFX shot to script for scene context and continuity. Enables tracking which script scenes require VFX work. | Column script_id (BIGINT) in production.vfx_shot']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: VFX shots are created for specific content titles. Required for VFX cost allocation to distributed content, content-level VFX asset tracking, and post-production reporting by title. While vfx_shot lin | Column title_id (BIGINT) in content.vfx_shot']
  vendor_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: VFX shots are outsourced to external VFX vendors (partners). Linking enables bid comparison across vendors, delivery tracking, payment processing, vendor performance evaluation, and shot allocation op | Column vendor_partner_id (BIGINT) in partner.vfx_shot']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.vfx_shot']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.vfx_shot']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.vfx_shot']
  actual_cost decimal(15,2) [note: 'Actual incurred cost for the VFX shot upon completion, including all revisions and additional work. Used for budget reconciliation and variance analysis. | Column actual_cost (DECIMAL(15,2)) in production.vfx_shot']
  actual_delivery_date date [note: 'Actual date when the final approved version of the VFX shot was delivered and accepted by the production team. | Column actual_delivery_date (DATE) in production.vfx_shot']
  approved_cost decimal(15,2) [note: 'Final approved budget allocation for the VFX shot after negotiation and production approval. This is the committed cost against which actual expenditure is tracked. | Column approved_cost (DECIMAL(15,2)) in production.vfx_shot']
  approved_date date [note: 'Date when the VFX shot received final creative and technical approval from the director, VFX supervisor, or production stakeholders. | Column approved_date (DATE) in production.vfx_shot']
  archive_location varchar [note: 'Physical or logical storage location where the final approved VFX shot and associated project files are archived for long-term preservation and future retrieval. | Column archive_location (STRING) in production.vfx_shot']
  aspect_ratio varchar [note: 'Aspect ratio of the VFX shot (e.g., 16:9, 2.39:1, 1.85:1), defining the width-to-height proportions of the frame. | Column aspect_ratio (NUMERIC) in production.vfx_shot']
  assigned_team_name varchar [note: 'Name of the in-house VFX team or department assigned to execute this shot. Null if the shot is outsourced to an external vendor. | Column assigned_team_name (STRING) in production.vfx_shot']
  bid_cost decimal(15,2) [note: 'Initial bid or estimated cost for the VFX shot as quoted by the vendor or estimated by the in-house team during pre-production planning. Expressed in the production\'s base currency. | Column bid_cost (DECIMAL(15,2)) in production.vfx_shot']
  brief_issued_date date [note: 'Date when the VFX shot brief and requirements were issued to the vendor or in-house team, marking the start of the VFX production timeline. | Column brief_issued_date (DATE) in production.vfx_shot']
  color_space varchar [note: 'Color space standard used for the VFX shot (e.g., Rec. 709, DCI-P3, ACEScg), ensuring color consistency across the production pipeline. | Column color_space (STRING) in production.vfx_shot']
  complexity_tier varchar [note: 'Classification of the VFX shot complexity level used for resource planning and cost estimation. Simple: basic compositing or cleanup. Moderate: multi-layer compositing or simple CGI. Complex: advanced CGI, multiple effects layers, or intricate integration. Hero: signature shots requiring top-tier artistry and extensive iteration. | Column complexity_tier (STRING) in production.vfx_shot']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.vfx_shot']
  created_timestamp timestamp [note: 'Timestamp when this VFX shot record was first created in the system, marking the initial entry into the production tracking database. | Column created_timestamp (TIMESTAMP) in production.vfx_shot']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts associated with this VFX shot (bid_cost, approved_cost, actual_cost). | Column currency_code (STRING) in production.vfx_shot']
  dalet_workflow_reference varchar [note: 'Unique workflow identifier in the Dalet Galaxy Media Asset Management system, linking this VFX shot record to the orchestrated production workflow and asset metadata. | Column dalet_workflow_reference (STRING) in production.vfx_shot']
  delivery_version varchar [note: 'Version number of the VFX shot delivery. Increments with each iteration submitted for review. Final approved version is recorded here. | Column delivery_version (INT) in production.vfx_shot']
  eidr_code varchar [note: 'EIDR identifier for the VFX shot if registered as a distinct audiovisual asset, enabling global identification and rights management across the content supply chain. | Column eidr_code (STRING) in production.vfx_shot']
  file_format varchar [note: 'Digital file format of the delivered VFX shot (e.g., EXR, DPX, ProRes, DNxHD), specifying the codec and container used for delivery. | Column file_format (STRING) in production.vfx_shot']
  final_frame_count varchar [note: 'Total number of frames in the final approved VFX shot. Used for billing, workload estimation, and archival metadata. | Column final_frame_count (INT) in production.vfx_shot']
  frame_rate decimal(5,2) [note: 'Frame rate of the VFX shot in frames per second (fps), typically 23.976, 24, 25, 29.97, or 30 fps depending on the production format. | Column frame_rate (DECIMAL(5,2)) in production.vfx_shot']
  notes varchar [note: 'Free-text field for production notes, creative direction, technical requirements, or any additional context relevant to the VFX shot execution and review. | Column notes (STRING) in production.vfx_shot']
  resolution varchar [note: 'Pixel resolution of the VFX shot (e.g., 1920x1080, 3840x2160, 4096x2160), indicating the output format and quality tier. | Column resolution (STRING) in production.vfx_shot']
  revision_count varchar [note: 'Total number of revision iterations the VFX shot underwent from initial submission to final approval. Used for workload analysis and vendor performance evaluation. | Column revision_count (INT) in production.vfx_shot']
  scene_reference varchar [note: 'Reference to the scene number or identifier in the script or production schedule to which this VFX shot belongs. | Column scene_reference (STRING) in production.vfx_shot']
  scheduled_delivery_date date [note: 'Target date by which the final approved VFX shot is scheduled to be delivered, as agreed in the production schedule or vendor contract. | Column scheduled_delivery_date (DATE) in production.vfx_shot']
  shot_code varchar [note: 'Unique business identifier for the VFX shot, typically following a hierarchical naming convention such as sequence_scene_shot (e.g., SQ010_SC020_0150). Used across production, post-production, and vendor communication. | Column shot_code (STRING) in production.vfx_shot']
  shot_name varchar [note: 'Human-readable descriptive name or title for the VFX shot, providing context about the shot content (e.g., \'Hero flies over city\', \'Explosion in warehouse\'). | Column shot_name (STRING) in production.vfx_shot']
  shot_status varchar [note: 'Current lifecycle status of the VFX shot. Brief issued: initial requirements provided. In-progress: active work by vendor or team. Vendor review: internal QA at vendor. Client review: submitted to production for approval. Approved: final sign-off received. Archived: shot completed and archived. | Column shot_status (STRING) in production.vfx_shot']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.vfx_shot']
  take_reference varchar [note: 'Reference to the specific camera take or plate footage that serves as the base for this VFX shot. | Column take_reference (STRING) in production.vfx_shot']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.vfx_shot']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this VFX shot record, capturing any modification to status, cost, delivery version, or other tracked attributes. | Column updated_timestamp (TIMESTAMP) in production.vfx_shot']
  vfx_category varchar [note: 'Primary category of visual effects work required for this shot: compositing (layering multiple elements), CGI (computer-generated imagery), matte painting (digital background painting), motion capture (performance capture), de-aging (digital age reduction), or green screen key (chroma key extraction). | Column vfx_category (STRING) in production.vfx_shot']

  Note: 'Master record for an individual VFX (Visual Effects) shot within a production. Captures shot code, scene and take reference, VFX category (compositing, CGI, matte painting, motion capture, de-aging, green screen key), complexity tier, assigned VFX vendor or in-house team, bid cost, approved cost, delivery version, shot status (brief issued, in-progress, vendor review, client review, approved, archived), and final frame count. Tracks the full VFX pipeline from brief to approved delivery. | Unity Catalog table: media_broadcasting_ecm.production.vfx_shot'
}

Table production.deliverable {
  deliverable_id varchar [pk, note: 'Unique identifier for the production deliverable. Primary key. | Column deliverable_id (BIGINT) in production.deliverable']
  abr_profile_id varchar [note: 'Foreign key linking to distribution.abr_profile. Business justification: Each deliverable conforms to specific ABR encoding profile for adaptive streaming distribution. Real business process: transcoding workflow configuration, encoding quality control, and streaming optim | Column abr_profile_id (BIGINT) in distribution.deliverable']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Deliverables must comply with specific accessibility obligations (closed captioning, audio description, emergency information access) based on distribution channel and regulatory jurisdiction. | Column accessibility_obligation_id (BIGINT) in compliance.deliverable']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Deliverables must reference their content rating for distribution compliance verification. Required for platform submission, broadcast clearance, and international distribution workflows. | Column compliance_content_rating_id (BIGINT) in compliance.deliverable']
  content_delivery_order_id varchar [note: 'Foreign key linking to distribution.content_delivery_order. Business justification: Deliverables fulfill specific content delivery orders to distribution partners. Real business process: fulfillment tracking, delivery confirmation, and partner order management. | Column content_delivery_order_id (BIGINT) in distribution.deliverable']
  distribution_drm_policy_id varchar [note: 'Foreign key linking to distribution.drm_policy. Business justification: Deliverables require specific DRM protection policies based on content rights and platform requirements. Real business process: content protection enforcement, rights management, and secure delivery c | Column distribution_drm_policy_id (BIGINT) in distribution.deliverable']
  encoder_config_id varchar [note: 'Foreign key linking to technology.encoder_config. Business justification: Deliverables must be encoded using specific encoder configurations to meet platform technical requirements. Real-world delivery workflows track which encoder profile was used for compliance verificati | Column encoder_config_id (BIGINT) in technology.deliverable']
  format_spec_id varchar [note: 'Foreign key linking to production.format_spec. Business justification: Normalization opportunity. Deliverable currently has target_format (STRING). FK to format_spec allows retrieving full technical specification (resolution, frame_rate, codec, etc.) and ensures delivera | Column format_spec_id (BIGINT) in production.deliverable']
  isci_creative_id varchar [note: 'Foreign key linking to sales.isci_creative. Business justification: Branded content deliverables often ARE the ad creative asset delivered to advertisers. Business process: branded content asset delivery to advertisers, product integration segment handoff, advertiser  | Column isci_creative_id (BIGINT) in sales.deliverable']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Deliverables are created to fulfill specific license agreement technical and format requirements (e.g., HD master for territory X, dubbed version for territory Y). Real business need: linking delivera | Column license_agreement_id (BIGINT) in rights.deliverable']
  media_asset_id varchar [note: 'Reference to the digital media asset in the Media Asset Management (MAM) system that represents this deliverable. Links to Dalet Galaxy or other MAM upon delivery. | Column media_asset_id (BIGINT) in mediaasset.deliverable']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Deliverables can be episode-specific (e.g., episodic masters for series). Optional FK (nullable) — deliverables may be project-level or episode-level. Enables episode-specific deliverable tracking. | Column production_episode_id (BIGINT) in production.deliverable']
  production_project_id varchar [note: 'Reference to the parent production project that this deliverable belongs to. | Column production_project_id (BIGINT) in production.deliverable']
  recipient_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Deliverables are sent to distribution partners, broadcasters, streaming platforms, and licensees. Linking enables delivery obligation tracking, SLA compliance monitoring, acceptance workflow managemen | Column recipient_partner_id (BIGINT) in partner.deliverable']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Deliverables must meet specific regulatory obligations before distribution. Links delivery workflow to compliance verification for broadcast standards, platform requirements, and international regulat | Column regulatory_obligation_id (BIGINT) in compliance.deliverable']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: Specific deliverable versions (HD, 4K, censored cuts) are scheduled for playout. Playout automation references exact deliverable file. Required for traffic/continuity operations, version control, and  | Column schedule_slot_id (BIGINT) in scheduling.deliverable']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: Deliverables are delivered to specific streaming endpoints for CDN ingestion and distribution. Real business process: content delivery tracking, CDN ingestion workflow, and delivery confirmation. | Column streaming_endpoint_id (BIGINT) in distribution.deliverable']
  target_ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Deliverables are formatted for specific platforms with platform-specific technical requirements (resolution, codec, DRM). Real business process: platform-specific asset preparation, transcoding, and d | Column target_ott_platform_id (BIGINT) in distribution.deliverable']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Deliverables are final production outputs that become content titles in the distribution system. Critical for asset-to-content mapping, delivery acceptance workflows, and tracking which production del | Column title_id (BIGINT) in content.deliverable']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.deliverable']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.deliverable']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.deliverable']
  actual_delivery_timestamp timestamp [note: 'Actual date and time when the deliverable was successfully delivered or handed off. | Column actual_delivery_timestamp (TIMESTAMP) in production.deliverable']
  aspect_ratio varchar [note: 'Display aspect ratio of the video deliverable (e.g., \'16:9\', \'4:3\', \'2.39:1\', \'1:1\'). Null for non-video deliverables. | Column aspect_ratio (NUMERIC) in production.deliverable']
  audio_channels varchar [note: 'Audio channel configuration for the deliverable (e.g., \'Stereo\', \'5.1 Surround\', \'7.1 Surround\', \'Mono\', \'Dolby Atmos\'). Null for non-audio deliverables. | Column audio_channels (STRING) in production.deliverable']
  audio_description_flag boolean [note: 'Indicates whether an audio description track for visually impaired viewers is included. True = audio description present; False = no audio description. | Column audio_description_flag (BOOLEAN) in production.deliverable']
  checksum_md5 varchar [note: 'MD5 hash of the deliverable file for integrity verification during transfer and storage. | Column checksum_md5 (STRING) in production.deliverable']
  closed_caption_flag boolean [note: 'Indicates whether closed captions for accessibility are included in this deliverable. True = closed captions present; False = no closed captions. | Column closed_caption_flag (BOOLEAN) in production.deliverable']
  compliance_certificate_flag boolean [note: 'Indicates whether a regulatory compliance certificate (e.g., FCC, Ofcom, content rating) accompanies this deliverable. True = certificate included; False = no certificate. | Column compliance_certificate_flag (BOOLEAN) in production.deliverable']
  content_rating varchar [note: 'Age or content rating assigned to this deliverable (e.g., \'TV-PG\', \'TV-14\', \'TV-MA\', \'G\', \'PG\', \'PG-13\', \'R\', \'NC-17\'). Used for compliance and audience targeting. | Column content_rating (STRING) in production.deliverable']
  contract_reference varchar [note: 'Reference number or identifier of the contract or agreement that mandates this deliverable. | Column contract_reference (STRING) in production.deliverable']
  cost_amount decimal(15,2) [note: 'Total cost incurred to produce this deliverable, including labor, equipment, facilities, and post-production services. | Column cost_amount (DECIMAL(15,2)) in production.deliverable']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.deliverable']
  created_timestamp timestamp [note: 'Date and time when this deliverable record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.deliverable']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the cost amount (e.g., \'USD\', \'EUR\', \'GBP\'). | Column currency_code (STRING) in production.deliverable']
  deliverable_name varchar [note: 'Human-readable name or title of the deliverable (e.g., \'Broadcast Master HD\', \'Promo Cut 30s\', \'Closed Caption SRT File\'). | Column deliverable_name (STRING) in production.deliverable']
  deliverable_type varchar [note: 'Category of deliverable output. Broadcast master = final linear transmission file; streaming master = OTT/VOD optimized file; promo cut = promotional excerpt; trailer = marketing preview; EPK = Electronic Press Kit; closed caption file = accessibility text; audio description track = visually impaired narration; subtitle file = translation text; M&E track = Music and Effects (no dialogue); textless version = graphics-free master; compliance certificate = regulatory approval document; QC report = Quality Control validation; as-run log = actual playout record. [ENUM-REF-CANDIDATE: broadcast_master|streaming_master|promo_cut|trailer|epk|closed_caption_file|audio_description_track|subtitle_file|me_track|textless_version|compliance_certificate|qc_report|as_run_log|other — 14 candidates stripped; promote to reference product] | Column deliverable_type (STRING) in production.deliverable']
  delivery_location varchar [note: 'Physical address, URL, FTP path, or cloud storage location where the deliverable was sent or made available. | Column delivery_location (STRING) in production.deliverable']
  delivery_method varchar [note: 'Method or protocol used to deliver the deliverable to the recipient. Physical media = hard drive/tape shipment; FTP = File Transfer Protocol; Aspera = high-speed file transfer; Signiant = media transfer platform; AWS S3 = Amazon cloud storage; Akamai NetStorage = CDN storage; Google Drive/Dropbox = cloud file sharing. [ENUM-REF-CANDIDATE: physical_media|ftp|aspera|signiant|aws_s3|akamai_netstorage|google_drive|dropbox|other — 9 candidates stripped; promote to reference product] | Column delivery_method (STRING) in production.deliverable']
  delivery_status varchar [note: 'Current lifecycle state of the deliverable. Not started = work has not begun; in progress = actively being produced; QC pending = awaiting quality control review; QC failed = did not pass quality checks; QC passed = approved for delivery; ready for delivery = prepared and awaiting handoff; delivered = sent to recipient; accepted = recipient confirmed receipt and approval; rejected = recipient declined or returned; cancelled = deliverable no longer required. [ENUM-REF-CANDIDATE: not_started|in_progress|qc_pending|qc_failed|qc_passed|ready_for_delivery|delivered|accepted|rejected|cancelled — 10 candidates stripped; promote to reference product] | Column delivery_status (STRING) in production.deliverable']
  due_date date [note: 'Contractually or operationally required date by which this deliverable must be completed and handed off. | Column due_date (DATE) in production.deliverable']
  duration_seconds decimal(10,3) [note: 'Total runtime duration of the deliverable in seconds (for video/audio deliverables). Null for non-time-based deliverables like documents or images. | Column duration_seconds (DECIMAL(10,3)) in production.deliverable']
  eidr_code varchar [note: 'Unique universal identifier for the audiovisual content assigned by the Entertainment Identifier Registry. Used for global content identification and rights management. | Column eidr_code (STRING) in production.deliverable']
  file_size_bytes varchar [note: 'Total file size of the deliverable in bytes. Used for storage planning, transfer time estimation, and CDN capacity management. | Column file_size_bytes (BIGINT) in production.deliverable']
  language_code varchar [note: 'Primary language of the deliverable content using ISO 639-1 or ISO 639-2 two or three-letter code, optionally followed by ISO 3166-1 alpha-2 country code (e.g., \'en\', \'en-US\', \'es-MX\', \'fr-CA\'). | Column language_code (STRING) in production.deliverable']
  qc_notes varchar [note: 'Detailed notes from the quality control review, including any issues found, corrective actions taken, or validation comments. | Column qc_notes (STRING) in production.deliverable']
  qc_operator_name varchar [note: 'Name of the quality control technician or automated system that performed the QC validation. | Column qc_operator_name (STRING) in production.deliverable']
  qc_pass_flag boolean [note: 'Indicates whether the deliverable passed quality control validation. True = passed QC; False = failed QC or not yet tested. | Column qc_pass_flag (BOOLEAN) in production.deliverable']
  qc_performed_timestamp timestamp [note: 'Date and time when quality control validation was completed for this deliverable. | Column qc_performed_timestamp (TIMESTAMP) in production.deliverable']
  revision_notes varchar [note: 'Description of changes made in this revision of the deliverable (e.g., \'Corrected audio sync issue\', \'Updated end credits\', \'Re-encoded for HDR\'). | Column revision_notes (STRING) in production.deliverable']
  revision_number varchar [note: 'Version or revision number of this deliverable. Increments when the deliverable is updated or redelivered after corrections. | Column revision_number (INT) in production.deliverable']
  scheduled_delivery_timestamp timestamp [note: 'Planned date and time for delivery of this deliverable to the recipient or platform. | Column scheduled_delivery_timestamp (TIMESTAMP) in production.deliverable']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.deliverable']
  subtitle_languages varchar [note: 'Comma-separated list of language codes for subtitle tracks included in this deliverable (e.g., \'en,es,fr\'). Null if no subtitles are included. | Column subtitle_languages (STRING) in production.deliverable']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.deliverable']
  updated_timestamp timestamp [note: 'Date and time when this deliverable record was last modified. | Column updated_timestamp (TIMESTAMP) in production.deliverable']

  Note: 'Contractually or operationally required output deliverable from a production project — the specific media asset or document that must be produced and handed off. Captures deliverable name, deliverable type (broadcast master, streaming master, promo cut, trailer, EPK, closed caption file, audio description track, subtitles, M&E track, textless version, compliance certificate), target format, target platform or recipient, due date, actual delivery date, delivery status, and QC pass/fail flag. Links to the digital asset management domain upon delivery. | Unity Catalog table: media_broadcasting_ecm.production.deliverable'
}

Table production.qc_review {
  qc_review_id varchar [pk, note: 'Unique identifier for the quality control review record. Primary key. | Column qc_review_id (BIGINT) in production.qc_review']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: QC reviews verify compliance against specific accessibility obligations. Links quality control processes to regulatory requirements for CVAA, FCC accessibility rules, and international standards. | Column accessibility_obligation_id (BIGINT) in compliance.qc_review']
  approver_employee_id varchar [note: 'Reference to the person or role who provided final approval for the deliverable. | Column approver_employee_id (BIGINT) in workforce.qc_review']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: QC review stations and infrastructure are located at specific broadcast facilities. Real-world quality control workflows require tracking which facility performed each review for compliance auditing,  | Column broadcast_facility_id (BIGINT) in technology.qc_review']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: QC reviews verify closed captioning accuracy, synchronization, and completeness against FCC standards. Direct operational link between quality control and accessibility compliance verification. | Column closed_caption_record_id (BIGINT) in compliance.qc_review']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: QC failures that violate broadcast standards, accessibility requirements, or content ratings trigger compliance incidents. Links quality control to incident management and corrective action workflows. | Column compliance_incident_id (BIGINT) in compliance.qc_review']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: QC reviews validate specific content versions for distribution. Essential for version-level quality tracking, linking production QC to content version records, and ensuring only QC-passed versions are | Column content_version_id (BIGINT) in content.qc_review']
  deliverable_id varchar [note: 'Reference to the production deliverable or post-production output being reviewed. | Column deliverable_id (BIGINT) in production.qc_review']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Production QC reviews inspect specific media assets for technical compliance before delivery. Role-prefixed as reviewed_asset_id since qc_review already links to deliverable. Essential for broadcast c | Column media_asset_id (BIGINT) in mediaasset.qc_review']
  post_production_task_id varchar [note: 'Foreign key linking to production.post_production_task. Business justification: QC reviews are performed on post-production task outputs. Optional FK (nullable) — QC may be on final deliverables or intermediate task outputs. When populated, links QC review to the specific Dalet w | Column post_production_task_id (BIGINT) in production.qc_review']
  primary_qc_employee_id varchar [note: 'Reference to the QC operator or technician who performed the review. | Column primary_qc_employee_id (BIGINT) in workforce.qc_review']
  production_project_id varchar [note: 'Reference to the parent production project this QC review belongs to. | Column production_project_id (BIGINT) in production.qc_review']
  target_abr_profile_id varchar [note: 'Foreign key linking to distribution.abr_profile. Business justification: QC reviews validate deliverables against target ABR profile specifications for distribution readiness. Real business process: quality assurance for streaming assets, technical compliance validation, a | Column target_abr_profile_id (BIGINT) in distribution.qc_review']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.qc_review']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.qc_review']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.qc_review']
  audio_channel_configuration varchar [note: 'Audio channel layout (e.g., stereo, 5.1 surround, 7.1 surround, mono). | Column audio_channel_configuration (STRING) in production.qc_review']
  audio_codec varchar [note: 'Audio codec used in the deliverable (e.g., AAC, Dolby Digital, PCM). | Column audio_codec (STRING) in production.qc_review']
  audio_description_compliance_flag boolean [note: 'Indicates whether audio description track meets accessibility standards. True if compliant, False if missing or non-compliant. | Column audio_description_compliance_flag (BOOLEAN) in production.qc_review']
  closed_caption_compliance_flag boolean [note: 'Indicates whether closed captions meet accessibility and regulatory standards (FCC, CVAA). True if compliant, False if violations detected. | Column closed_caption_compliance_flag (BOOLEAN) in production.qc_review']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.qc_review']
  created_timestamp timestamp [note: 'Timestamp when the QC review record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.qc_review']
  dalet_workflow_reference varchar [note: 'Identifier linking this QC review to the corresponding workflow instance in Dalet Galaxy MAM for ingest and workflow orchestration. | Column dalet_workflow_reference (STRING) in production.qc_review']
  error_codes varchar [note: 'Comma-separated list of specific error codes identified during the review, aligned with EBU R128, ATSC A/85, and ITU-R BT.1788 standards (e.g., V001 for video freeze, A002 for loudness violation, C003 for closed caption sync error). | Column error_codes (STRING) in production.qc_review']
  final_approval_date date [note: 'Date when the deliverable received final approval for distribution. Null if not yet approved. | Column final_approval_date (DATE) in production.qc_review']
  final_approval_status varchar [note: 'Final approval status of the deliverable after QC review and any remediation: approved (ready for distribution), rejected (does not meet standards), pending approval (awaiting sign-off), or conditional approval (approved with minor caveats). | Column final_approval_status (STRING) in production.qc_review']
  loudness_compliance_flag boolean [note: 'Indicates whether the deliverable meets loudness standards (EBU R128 or ATSC A/85). True if compliant, False if violations detected. | Column loudness_compliance_flag (BOOLEAN) in production.qc_review']
  loudness_lufs decimal(6,2) [note: 'Measured integrated loudness level in LUFS (Loudness Units relative to Full Scale) per EBU R128 or ATSC A/85 standards. Target is typically -23 LUFS for broadcast. | Column loudness_lufs (DECIMAL(6,2)) in production.qc_review']
  p1_critical_error_count varchar [note: 'Number of P1 critical errors that prevent broadcast or distribution (e.g., audio dropout, video corruption, missing segments). | Column p1_critical_error_count (INT) in production.qc_review']
  p2_major_error_count varchar [note: 'Number of P2 major errors that significantly impact quality but may not prevent distribution (e.g., color grading inconsistencies, audio sync issues). | Column p2_major_error_count (INT) in production.qc_review']
  p3_minor_error_count varchar [note: 'Number of P3 minor errors that have minimal impact on viewer experience (e.g., minor subtitle timing issues, cosmetic artifacts). | Column p3_minor_error_count (INT) in production.qc_review']
  qc_notes varchar [note: 'Free-text notes and observations recorded by the QC operator during the review, including context for errors and recommendations. | Column qc_notes (STRING) in production.qc_review']
  qc_platform varchar [note: 'Name of the QC platform or tool used to perform the review (e.g., Dalet Galaxy QC module, Tektronix Sentry, Interra Baton). | Column qc_platform (STRING) in production.qc_review']
  qc_result varchar [note: 'Overall result of the QC review: pass (no issues), fail (critical issues preventing distribution), conditional pass (minor issues requiring remediation), or pending review (awaiting final approval). | Column qc_result (STRING) in production.qc_review']
  qc_type varchar [note: 'Type of quality control review performed: technical QC (video/audio quality), editorial QC (content accuracy), compliance QC (regulatory standards), accessibility QC (closed captions, audio description), loudness QC (EBU R128/ATSC A/85), or format QC (file format and codec validation). | Column qc_type (STRING) in production.qc_review']
  re_qc_date date [note: 'Date when the deliverable was re-reviewed after remediation. Null if no re-QC has been performed. | Column re_qc_date (DATE) in production.qc_review']
  remediation_notes varchar [note: 'Detailed notes describing the remediation actions required to address identified errors and bring the deliverable into compliance. | Column remediation_notes (STRING) in production.qc_review']
  remediation_required_flag boolean [note: 'Indicates whether the deliverable requires remediation or correction before final approval. True if remediation needed, False if no action required. | Column remediation_required_flag (BOOLEAN) in production.qc_review']
  review_date date [note: 'Date when the QC review was performed. | Column review_date (DATE) in production.qc_review']
  review_duration_minutes decimal(10,2) [note: 'Total duration of the QC review session in minutes. | Column review_duration_minutes (DECIMAL(10,2)) in production.qc_review']
  review_end_timestamp timestamp [note: 'Timestamp when the QC operator completed the review session. | Column review_end_timestamp (TIMESTAMP) in production.qc_review']
  review_number varchar [note: 'Business identifier for the QC review, typically formatted as a human-readable reference code. | Column review_number (STRING) in production.qc_review']
  review_start_timestamp timestamp [note: 'Timestamp when the QC operator began the review session. | Column review_start_timestamp (TIMESTAMP) in production.qc_review']
  review_status varchar [note: 'Current lifecycle status of the QC review process. | Column review_status (STRING) in production.qc_review']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.qc_review']
  total_error_count varchar [note: 'Total number of errors identified across all severity levels during the QC review. | Column total_error_count (INT) in production.qc_review']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.qc_review']
  updated_timestamp timestamp [note: 'Timestamp when the QC review record was last modified. | Column updated_timestamp (TIMESTAMP) in production.qc_review']
  video_codec varchar [note: 'Video codec used in the deliverable (e.g., H.264, H.265/HEVC, ProRes, MPEG-2). | Column video_codec (STRING) in production.qc_review']
  video_frame_rate decimal(18,2) [note: 'Measured video frame rate (e.g., 23.976, 25, 29.97, 50, 59.94 fps). | Column video_frame_rate (DECIMAL(18,2)) in production.qc_review']
  video_resolution varchar [note: 'Measured video resolution of the deliverable (e.g., 1920x1080, 3840x2160). | Column video_resolution (STRING) in production.qc_review']

  Note: 'Quality control review record for a production deliverable or post-production output. Captures QC type (technical QC, editorial QC, compliance QC, accessibility QC, loudness QC), QC operator, review date, pass/fail/conditional result, error count by severity (P1 critical, P2 major, P3 minor), specific error codes per EBU R128/ATSC A/85 loudness standards and ITU-R BT.1788 video quality standards, remediation required flag, re-QC date, and final approval status. Ensures all deliverables meet broadcast and platform technical specifications before distribution. Feeds the deliverable acceptance workflow. | Unity Catalog table: media_broadcasting_ecm.production.qc_review'
}

Table production.ingest_record {
  ingest_record_id varchar [pk, note: 'Unique identifier for the media ingest record in the Dalet Galaxy MAM system. Primary key. | Column ingest_record_id (BIGINT) in production.ingest_record']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Media ingest operations occur at specific broadcast facilities with dedicated ingest infrastructure. Real-world media operations require tracking which facility performed each ingest for asset locatio | Column broadcast_facility_id (BIGINT) in technology.ingest_record']
  employee_id varchar [note: 'System identifier for the operator who performed the ingest. Links to employee or contractor identity management system. | Column employee_id (BIGINT) in workforce.ingest_record']
  media_asset_id varchar [note: 'Unique asset identifier assigned by Dalet Galaxy MAM system upon successful ingest completion. This is the system-of-record identifier for the ingested media asset. | Column media_asset_id (BIGINT) in mediaasset.ingest_record']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Normalization opportunity. Ingest record currently has episode_number (STRING). FK to production_episode provides referential integrity and enables linking ingested media to episode metadata (title, s | Column production_episode_id (BIGINT) in production.ingest_record']
  production_project_id varchar [note: 'Reference to the production project this ingest is associated with. Links to the parent production project entity. | Column production_project_id (BIGINT) in production.ingest_record']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Production ingest records capture source material for specific content titles. Critical for production-to-content asset lineage, source material tracking, and linking production ingests to final distr | Column title_id (BIGINT) in content.ingest_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.ingest_record']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.ingest_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.ingest_record']
  aspect_ratio varchar [note: 'Display aspect ratio of the video content. Standard values include 16:9, 4:3, 21:9, 2.39:1. | Column aspect_ratio (NUMERIC) in production.ingest_record']
  audio_channels varchar [note: 'Number of audio channels in the ingested media. Common values include 1 (mono), 2 (stereo), 6 (5.1 surround), 8 (7.1 surround). | Column audio_channels (INT) in production.ingest_record']
  audio_sample_rate varchar [note: 'Audio sample rate in Hz. Common values include 44100, 48000, 96000. | Column audio_sample_rate (INT) in production.ingest_record']
  bit_depth varchar [note: 'Bit depth of the video or audio content. Common values include 8, 10, 12, 16, 24. | Column bit_depth (INT) in production.ingest_record']
  checksum_md5 varchar [note: 'MD5 hash of the ingested file for integrity verification. Used to detect corruption during transfer and storage. | Column checksum_md5 (STRING) in production.ingest_record']
  checksum_sha256 varchar [note: 'SHA-256 hash of the ingested file for enhanced integrity verification and compliance with modern security standards. | Column checksum_sha256 (STRING) in production.ingest_record']
  codec varchar [note: 'Video or audio codec used in the source media. Examples include H.264, H.265/HEVC, ProRes 422, DNxHD, PCM, AAC. | Column codec (STRING) in production.ingest_record']
  color_space varchar [note: 'Color space of the video content. Examples include Rec.709, Rec.2020, DCI-P3, sRGB, Log-C. | Column color_space (STRING) in production.ingest_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.ingest_record']
  created_timestamp timestamp [note: 'Timestamp when this ingest record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in production.ingest_record']
  duration_seconds decimal(12,3) [note: 'Total duration of the ingested media in seconds. Null for still images or non-time-based media. | Column duration_seconds (DECIMAL(12,3)) in production.ingest_record']
  error_code varchar [note: 'System error code if the ingest operation failed. Used for troubleshooting and operational reporting. | Column error_code (STRING) in production.ingest_record']
  error_message varchar [note: 'Human-readable error message describing the reason for ingest failure. Null if ingest was successful. | Column error_message (STRING) in production.ingest_record']
  file_size_bytes varchar [note: 'Total file size of the ingested media in bytes. Used for storage capacity planning and transfer validation. | Column file_size_bytes (BIGINT) in production.ingest_record']
  frame_rate decimal(6,3) [note: 'Frames per second of the video content. Common values include 23.976, 24, 25, 29.97, 30, 50, 59.94, 60. | Column frame_rate (DECIMAL(6,3)) in production.ingest_record']
  ingest_completion_timestamp timestamp [note: 'Date and time when the ingest operation completed successfully or failed. Null if still in progress. | Column ingest_completion_timestamp (TIMESTAMP) in production.ingest_record']
  ingest_number varchar [note: 'Human-readable business identifier for the ingest event, typically formatted as ING-YYYYMMDD-sequence for tracking and reference purposes. | Column ingest_number (STRING) in production.ingest_record']
  ingest_operator_name varchar [note: 'Name of the operator or technician who initiated the ingest operation. Used for accountability and workflow tracking. | Column ingest_operator_name (STRING) in production.ingest_record']
  ingest_priority varchar [note: 'Priority level assigned to the ingest operation. Determines processing queue order and resource allocation. | Column ingest_priority (STRING) in production.ingest_record']
  ingest_status varchar [note: 'Current lifecycle status of the ingest operation. Tracks progression from initiation through completion or failure. | Column ingest_status (STRING) in production.ingest_record']
  ingest_timestamp timestamp [note: 'Date and time when the ingest operation was initiated. This is the principal business event timestamp for the ingest record. | Column ingest_timestamp (TIMESTAMP) in production.ingest_record']
  notes varchar [note: 'Free-text notes or comments entered by the ingest operator. May include special handling instructions, content observations, or technical issues. | Column notes (STRING) in production.ingest_record']
  quality_check_status varchar [note: 'Status of automated or manual quality control checks performed on the ingested media. Ensures technical compliance before downstream use. | Column quality_check_status (STRING) in production.ingest_record']
  resolution varchar [note: 'Video resolution of the ingested media. Can be expressed as pixel dimensions (e.g., 1920x1080) or standard abbreviations (HD, 4K, 8K). | Column resolution (STRING) in production.ingest_record']
  scene_numbers varchar [note: 'Comma-separated list of scene numbers associated with this ingested media. Links the raw footage to the production script and shooting schedule. | Column scene_numbers (STRING) in production.ingest_record']
  shoot_date date [note: 'Date when the media was originally captured or recorded on set. Distinct from ingest date. | Column shoot_date (DATE) in production.ingest_record']
  source_device varchar [note: 'Name or identifier of the camera, recorder, or device that captured the source media. Examples include camera model, recorder serial number, or external vendor name. | Column source_device (STRING) in production.ingest_record']
  source_format varchar [note: 'Technical format of the source media file. Examples include RAW, ProRes, XAVC, MXF, WAV, MP4. [ENUM-REF-CANDIDATE: RAW|ProRes|ProRes422|ProRes4444|XAVC|XAVC-I|XAVC-L|MXF|DNxHD|DNxHR|WAV|AIFF|MP4|MOV|AVI — promote to reference product] | Column source_format (STRING) in production.ingest_record']
  source_media_type varchar [note: 'Classification of the source media being ingested. Indicates the nature and origin of the content. [ENUM-REF-CANDIDATE: camera-footage|audio-recording|graphics|b-roll|stock-footage|archive|external-delivery — 7 candidates stripped; promote to reference product] | Column source_media_type (STRING) in production.ingest_record']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.ingest_record']
  source_tape_code varchar [note: 'Identifier of the physical tape or media card from which content was ingested. Used for legacy tape-based workflows and physical media tracking. | Column source_tape_code (STRING) in production.ingest_record']
  storage_location varchar [note: 'Physical or logical storage location where the ingested media is stored. May include storage tier, volume, or path information. | Column storage_location (STRING) in production.ingest_record']
  storage_tier varchar [note: 'Storage tier classification indicating access speed and cost. Online for immediate access, nearline for frequent access, archive for long-term retention, deep-archive for compliance. | Column storage_tier (STRING) in production.ingest_record']
  timecode_end varchar [note: 'Ending timecode of the ingested media in HH:MM:SS:FF format. Used for synchronization and editorial reference. | Column timecode_end (STRING) in production.ingest_record']
  timecode_start varchar [note: 'Starting timecode of the ingested media in HH:MM:SS:FF format. Used for synchronization and editorial reference. | Column timecode_start (STRING) in production.ingest_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.ingest_record']
  updated_timestamp timestamp [note: 'Timestamp when this ingest record was last modified. Used for audit trail and change tracking. | Column updated_timestamp (TIMESTAMP) in production.ingest_record']

  Note: 'Record of a media ingest event into the Dalet Galaxy MAM system — capturing raw camera footage, audio recordings, graphics, or other source media arriving from set or external sources. Captures ingest date and time, source media type, source format (RAW, ProRes, XAVC, MXF, WAV), ingest operator, storage location, file size, checksum, ingest status (pending, in-progress, complete, failed), associated production project and episode, and Dalet Galaxy asset ID assigned upon successful ingest. The operational handoff record between production and digital asset management. | Unity Catalog table: media_broadcasting_ecm.production.ingest_record'
}

Table production.milestone {
  milestone_id varchar [pk, note: 'Primary key for milestone | Column milestone_id (BIGINT) in production.milestone']
  predecessor_milestone_id varchar [note: 'Reference to another milestone that must be completed before this milestone can begin or be achieved. | Column predecessor_milestone_id (BIGINT) in production.milestone']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Milestones can be episode-specific (e.g., picture lock for episode 3). Optional FK (nullable) — milestones may be project-level or episode-level. Enables episode-specific milestone tracking for episod | Column production_episode_id (BIGINT) in production.milestone']
  production_project_id varchar [note: 'Reference to the parent production project or episode for which this milestone is tracked. | Column production_project_id (BIGINT) in production.milestone']
  responsible_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Production milestones assign accountability to specific employees for schedule management, escalation routing, and performance review metrics—standard in project management. Replaces denormalized resp | Column responsible_owner_employee_id (BIGINT) in workforce.milestone']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Production milestones track progress toward content title delivery. Essential for content delivery scheduling, windowing plan coordination, and tracking production progress against content distributio | Column title_id (BIGINT) in content.milestone']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.milestone']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.milestone']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.milestone']
  actual_date date [note: 'The date on which the milestone was actually achieved or completed. Null if milestone has not yet been reached. | Column actual_date (DATE) in production.milestone']
  approval_authority varchar [note: 'Name or role of the individual or committee authorized to approve this milestone (e.g., Executive Producer, Network Executive, Showrunner). | Column approval_authority (STRING) in production.milestone']
  approval_date date [note: 'Date on which formal approval or sign-off was granted for this milestone. Null if approval is not yet obtained. | Column approval_date (DATE) in production.milestone']
  approval_required_flag boolean [note: 'Indicates whether formal approval or sign-off is required before this milestone can be marked as achieved. | Column approval_required_flag (BOOLEAN) in production.milestone']
  baseline_date date [note: 'Approved baseline date for the milestone after initial project approval, used for variance tracking and performance measurement. | Column baseline_date (DATE) in production.milestone']
  budget_impact_usd decimal(15,2) [note: 'Estimated financial impact or cost associated with achieving this milestone, or cost of delay if milestone is missed. | Column budget_impact_usd (DECIMAL(15,2)) in production.milestone']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.milestone']
  created_timestamp timestamp [note: 'Timestamp when this milestone record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.milestone']
  critical_path_flag boolean [note: 'Indicates whether this milestone is on the critical path of the production schedule, meaning any delay directly impacts final delivery date. | Column critical_path_flag (BOOLEAN) in production.milestone']
  dalet_workflow_reference varchar [note: 'External identifier linking this milestone to the corresponding workflow or task in Dalet Galaxy Media Asset Management system. | Column dalet_workflow_reference (STRING) in production.milestone']
  deliverable_description varchar [note: 'Detailed description of the tangible output or deliverable associated with this milestone (e.g., locked picture file, final audio mix stems, QC report). | Column deliverable_description (STRING) in production.milestone']
  deliverable_format varchar [note: 'Technical format or specification of the deliverable (e.g., ProRes 422 HQ, IMF package, DCP, broadcast master tape format). | Column deliverable_format (STRING) in production.milestone']
  dependency_count varchar [note: 'Number of other milestones or tasks that are dependent on the completion of this milestone. | Column dependency_count (INT) in production.milestone']
  forecast_date date [note: 'Current projected or estimated date for milestone completion based on latest production progress and risk assessment. | Column forecast_date (DATE) in production.milestone']
  milestone_name varchar [note: 'Human-readable name or title of the milestone event (e.g., Greenlight Approval, Picture Lock, Final Delivery). | Column milestone_name (STRING) in production.milestone']
  milestone_status varchar [note: 'Current lifecycle status of the milestone indicating whether it is pending, on track, delayed, completed, or no longer applicable. | Column milestone_status (STRING) in production.milestone']
  milestone_type varchar [note: 'Categorical classification of the milestone within the production lifecycle. Defines the phase or gate this milestone represents. [ENUM-REF-CANDIDATE: greenlight|pre_production_start|principal_photography_start|principal_photography_end|picture_lock|audio_mix_complete|vfx_complete|color_grading_complete|final_qc_pass|delivery_to_broadcaster|archive_complete|post_production_start|rough_cut_complete|final_cut_complete|mastering_complete — promote to reference product] | Column milestone_type (STRING) in production.milestone']
  mitigation_plan varchar [note: 'Description of actions or contingency plans in place to address identified risks and ensure milestone is achieved. | Column mitigation_plan (STRING) in production.milestone']
  notes varchar [note: 'Free-form text field for additional context, comments, or observations related to this milestone event. | Column notes (STRING) in production.milestone']
  planned_date date [note: 'Originally scheduled or target date for achieving this milestone as defined during production planning. | Column planned_date (DATE) in production.milestone']
  responsible_department varchar [note: 'The production department or functional area responsible for delivering this milestone. [ENUM-REF-CANDIDATE: production|post_production|vfx|audio|editorial|color|qc|delivery|archive|legal|finance — 11 candidates stripped; promote to reference product] | Column responsible_department (STRING) in production.milestone']
  risk_description varchar [note: 'Detailed explanation of identified risks, issues, or blockers that may prevent timely achievement of this milestone. | Column risk_description (STRING) in production.milestone']
  risk_level varchar [note: 'Assessment of the risk that this milestone will not be achieved on time, based on current production status and known issues. | Column risk_level (STRING) in production.milestone']
  sap_wbs_element varchar [note: 'SAP project structure element code linking this milestone to the enterprise project management and financial tracking hierarchy. | Column sap_wbs_element (STRING) in production.milestone']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.milestone']
  stakeholder_notification_flag boolean [note: 'Indicates whether stakeholders (network executives, distributors, talent) must be notified when this milestone is achieved or at risk. | Column stakeholder_notification_flag (BOOLEAN) in production.milestone']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.milestone']
  updated_timestamp timestamp [note: 'Timestamp when this milestone record was last modified or updated. | Column updated_timestamp (TIMESTAMP) in production.milestone']
  variance_days varchar [note: 'Number of days difference between planned date and actual date (positive indicates delay, negative indicates early completion). Calculated field for reporting purposes. | Column variance_days (INT) in production.milestone']

  Note: 'Key milestone event in the production lifecycle for a project or episode. Captures milestone type (greenlight, pre-production start, first day of photography, picture lock, audio mix complete, VFX complete, final QC pass, delivery to broadcaster, archive complete), planned date, actual date, milestone status (upcoming, at-risk, achieved, missed), responsible owner, and any associated approval or sign-off requirement. Enables production schedule tracking and stakeholder reporting against key delivery gates. | Unity Catalog table: media_broadcasting_ecm.production.milestone'
}

Table production.location {
  location_id varchar [pk, note: 'Unique identifier for the production location. Primary key. | Column location_id (BIGINT) in production.location']
  owner_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Location owners and management companies are partners who lease filming locations. Linking enables tracking all locations managed by that partner, payment processing for location fees, permit coordina | Column owner_partner_id (BIGINT) in partner.location']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.location']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.location']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.location']
  address_line_1 varchar [note: 'Primary street address of the production location including street number and name. | Column address_line_1 (STRING) in production.location']
  address_line_2 varchar [note: 'Secondary address information such as suite, building, or unit number. | Column address_line_2 (STRING) in production.location']
  base_camp_capacity varchar [note: 'Number of trailers or mobile units that can be accommodated at the base camp area near the location for cast, crew, wardrobe, makeup, and catering. | Column base_camp_capacity (INT) in production.location']
  city varchar [note: 'City or municipality where the location is situated. | Column city (STRING) in production.location']
  country_code varchar [note: 'Three-letter ISO country code where the location is situated (e.g., USA, CAN, GBR, MEX). | Column country_code (STRING) in production.location']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.location']
  created_timestamp timestamp [note: 'Timestamp when this location record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.location']
  fee_amount decimal(15,2) [note: 'Total fee paid to the location owner or manager for the right to film at this location. Excludes additional costs such as permits, insurance, or restoration. | Column fee_amount (DECIMAL(15,2)) in production.location']
  fee_currency varchar [note: 'Three-letter ISO currency code for the location fee (e.g., USD, CAD, GBP, EUR). | Column fee_currency (STRING) in production.location']
  insurance_required_flag boolean [note: 'Indicates whether the location owner requires specific production insurance coverage or certificates of insurance before filming can commence. | Column insurance_required_flag (BOOLEAN) in production.location']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the location in decimal degrees format, used for mapping, navigation, and sunrise/sunset calculations. | Column latitude (DECIMAL(10,7)) in production.location']
  location_code varchar [note: 'Business identifier code for the location used in production schedules and call sheets. Typically assigned by the location manager or production coordinator. | Column location_code (STRING) in production.location']
  location_name varchar [note: 'Human-readable name or title of the production location (e.g., \'Downtown Warehouse District\', \'Malibu Beach House\', \'Historic City Hall\'). | Column location_name (STRING) in production.location']
  location_status varchar [note: 'Current lifecycle status of the location: scouted (identified by location scout), approved (approved for use by director/producer), contracted (agreement signed with owner), active (currently in use for shooting), wrapped (shooting completed), rejected (not suitable for production). | Column location_status (STRING) in production.location']
  location_type varchar [note: 'Classification of the location based on its physical characteristics and usage: practical interior (real indoor space), practical exterior (real outdoor space), backlot (studio-controlled outdoor set), remote (distant or hard-to-access site), international (foreign location), studio exterior (controlled outdoor studio space). | Column location_type (STRING) in production.location']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the location in decimal degrees format, used for mapping, navigation, and logistics planning. | Column longitude (DECIMAL(10,7)) in production.location']
  manager_notes varchar [note: 'Free-text notes and observations from the location manager regarding access, restrictions, special requirements, or other relevant production considerations. | Column manager_notes (STRING) in production.location']
  noise_assessment varchar [note: 'Assessment of ambient noise levels at the location: quiet (minimal background noise, suitable for dialogue recording), moderate (some noise, may require sound treatment), noisy (significant noise, requires ADR or sound mitigation), unacceptable (excessive noise, unsuitable for production). | Column noise_assessment (STRING) in production.location']
  owner_contact_email varchar [note: 'Primary email address for the location owner or authorized representative for contract and coordination communications. | Column owner_contact_email (STRING) in production.location']
  owner_contact_phone varchar [note: 'Primary phone number for the location owner or authorized representative for coordination and emergency contact during production. | Column owner_contact_phone (STRING) in production.location']
  parking_capacity varchar [note: 'Number of vehicle parking spaces available at or near the location for crew, cast, and equipment trucks. | Column parking_capacity (INT) in production.location']
  permit_authority varchar [note: 'Name of the governmental or regulatory authority responsible for issuing filming permits for this location (e.g., \'Los Angeles Film Office\', \'NYC Mayor Office of Media and Entertainment\'). | Column permit_authority (STRING) in production.location']
  permit_expiry_date date [note: 'Date when the filming permit expires and is no longer valid for production use. | Column permit_expiry_date (DATE) in production.location']
  permit_issue_date date [note: 'Date when the filming permit was officially issued by the permitting authority. | Column permit_issue_date (DATE) in production.location']
  permit_number varchar [note: 'Official permit or authorization number issued by the permitting authority for filming at this location. | Column permit_number (STRING) in production.location']
  permit_status varchar [note: 'Current status of filming permits required for this location: not required (no permit needed), pending (application submitted), approved (permit granted), denied (permit rejected), expired (permit validity lapsed). | Column permit_status (STRING) in production.location']
  postal_code varchar [note: 'Postal or ZIP code for the location address. | Column postal_code (STRING) in production.location']
  power_availability varchar [note: 'Assessment of electrical power availability at the location: grid (connected to utility power), generator required (no grid power, generators needed), limited (some power available but insufficient for full production), none (no power infrastructure). | Column power_availability (STRING) in production.location']
  region varchar [note: 'Broader geographic region or area classification (e.g., \'Southern California\', \'Pacific Northwest\', \'New England\') used for production planning and logistics. | Column region (STRING) in production.location']
  restoration_required_flag boolean [note: 'Indicates whether the production is contractually obligated to restore the location to its original condition after filming concludes. | Column restoration_required_flag (BOOLEAN) in production.location']
  restroom_facilities varchar [note: 'Assessment of restroom availability: on site (permanent facilities available), portable required (portable restrooms must be brought in), nearby (facilities within walking distance), none (no facilities available). | Column restroom_facilities (STRING) in production.location']
  safety_assessment_date date [note: 'Date when the safety assessment was conducted by the production safety officer or third-party assessor. | Column safety_assessment_date (DATE) in production.location']
  safety_assessment_status varchar [note: 'Status of the safety and risk assessment conducted for this location: not assessed (no evaluation performed), in progress (assessment underway), passed (meets safety requirements), failed (does not meet safety standards), conditional (approved with specific safety measures required). | Column safety_assessment_status (STRING) in production.location']
  scout_approval_status varchar [note: 'Approval status from the location scout assessment: pending (awaiting review), approved (meets production requirements), rejected (does not meet requirements), conditional (approved with specific conditions or modifications). | Column scout_approval_status (STRING) in production.location']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.location']
  state_province varchar [note: 'State, province, or administrative region of the location. | Column state_province (STRING) in production.location']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.location']
  updated_timestamp timestamp [note: 'Timestamp when this location record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in production.location']
  water_availability varchar [note: 'Assessment of water access at the location: available (connected to water supply), limited (some water but insufficient for full crew), trucked in required (no water infrastructure, must be transported), none (no water access). | Column water_availability (STRING) in production.location']

  Note: 'Master record for a physical production location — an on-location shoot site used for principal photography or second unit work. Captures location name, address, GPS coordinates, country, region, location type (practical interior, practical exterior, backlot, remote, international), location scout approval status, permit status, permit authority, permit expiry date, location fee, safety assessment status, noise assessment, sunrise/sunset data relevance, parking and base camp capacity, and contact details for the location owner or manager. Distinct from facility_booking which covers controlled studio and post-production facilities. | Unity Catalog table: media_broadcasting_ecm.production.location'
}

Table production.cost_transaction {
  cost_transaction_id varchar [pk, note: 'Primary key for cost_transaction | Column cost_transaction_id (BIGINT) in production.cost_transaction']
  approver_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Transaction-level approval tracking enables financial controls, segregation of duties, and audit compliance for production expenditures—standard accounting practice. Replaces denormalized approver_nam | Column approver_employee_id (BIGINT) in workforce.cost_transaction']
  budget_line_id varchar [note: 'Foreign key linking to production.budget_line. Business justification: Cost transactions are posted against specific budget line items. Currently uses budget_line_reference (STRING) — replacing with FK to budget_line.budget_line_id provides referential integrity and enab | Column budget_line_id (BIGINT) in production.cost_transaction']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Cost transactions must reference the GL account structure for financial posting, trial balance generation, and financial statement preparation. Replaces denormalized gl_account_code with FK to enforce | Column chart_of_accounts_id (BIGINT) in finance.cost_transaction']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Every production cost transaction must be assigned to a cost center for GL posting, reconciliation, and audit trail. Mandatory for SAP integration and financial statement preparation. Replaces denorma | Column cost_center_id (BIGINT) in finance.cost_transaction']
  journal_entry_id varchar [note: 'Foreign key linking to finance.journal_entry. Business justification: Production cost transactions generate or reference journal entries in the financial GL. Required for reconciliation between production spend tracking and financial ledger, mandatory for month-end clos | Column journal_entry_id (BIGINT) in finance.cost_transaction']
  partner_id varchar [note: 'Identifier of the vendor or supplier from whom goods or services were procured, if applicable. | Column partner_id (BIGINT) in partner.cost_transaction']
  production_budget_id varchar [note: 'Reference to the specific budget line or cost object this transaction is charged against. | Column production_budget_id (BIGINT) in production.cost_transaction']
  production_project_id varchar [note: 'Reference to the production project against which this cost transaction is posted. | Column production_project_id (BIGINT) in production.cost_transaction']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.cost_transaction']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.cost_transaction']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.cost_transaction']
  approval_date date [note: 'Date on which the transaction was approved for payment. | Column approval_date (DATE) in production.cost_transaction']
  cost_category_code varchar [note: 'Code representing the cost category or expense type (e.g., talent, equipment, location, post-production). | Column cost_category_code (STRING) in production.cost_transaction']
  cost_category_name varchar [note: 'Descriptive name of the cost category or expense classification. | Column cost_category_name (STRING) in production.cost_transaction']
  cost_transaction_description varchar [note: 'Detailed description or narrative of the cost transaction, including purpose and context. | Column cost_transaction_description (STRING) in production.cost_transaction']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.cost_transaction']
  created_timestamp timestamp [note: 'Timestamp when this cost transaction record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.cost_transaction']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the transaction amount. | Column currency_code (STRING) in production.cost_transaction']
  exchange_rate decimal(12,6) [note: 'Exchange rate applied to convert the transaction amount to the reporting currency. | Column exchange_rate (DECIMAL(12,6)) in production.cost_transaction']
  fiscal_period varchar [note: 'Fiscal period (month or quarter) within the fiscal year for this transaction. | Column fiscal_period (STRING) in production.cost_transaction']
  fiscal_year varchar [note: 'Fiscal year in which the transaction was posted for financial reporting purposes. | Column fiscal_year (STRING) in production.cost_transaction']
  invoice_date date [note: 'Date on the vendor invoice or billing document. | Column invoice_date (DATE) in production.cost_transaction']
  invoice_number varchar [note: 'Vendor invoice number or billing reference for this transaction. | Column invoice_number (STRING) in production.cost_transaction']
  net_amount decimal(18,2) [note: 'Net transaction amount excluding taxes and other adjustments. | Column net_amount (DECIMAL(18,2)) in production.cost_transaction']
  notes varchar [note: 'Additional notes, comments, or special instructions related to this transaction. | Column notes (STRING) in production.cost_transaction']
  payee_name varchar [note: 'Name of the individual or entity receiving payment for this transaction (e.g., crew member, contractor, petty cash recipient). | Column payee_name (STRING) in production.cost_transaction']
  payment_date date [note: 'Date on which payment was made or is scheduled to be made for this transaction. | Column payment_date (DATE) in production.cost_transaction']
  payment_method varchar [note: 'Method used for payment: wire transfer, check, credit card, petty cash, ACH, or payroll. | Column payment_method (STRING) in production.cost_transaction']
  payment_status varchar [note: 'Current payment status of the transaction: pending, approved, paid, cancelled, on hold, or rejected. | Column payment_status (STRING) in production.cost_transaction']
  posting_date date [note: 'The date on which the transaction was posted to the general ledger in SAP. | Column posting_date (DATE) in production.cost_transaction']
  production_phase varchar [note: 'Phase of production during which this cost was incurred: pre-production, principal photography, post-production, delivery, or closed. | Column production_phase (STRING) in production.cost_transaction']
  purchase_order_number varchar [note: 'Purchase order number associated with this transaction, if applicable. | Column purchase_order_number (STRING) in production.cost_transaction']
  reporting_currency_amount decimal(18,2) [note: 'Transaction amount converted to the standard reporting currency (typically USD) for consolidated financial reporting. | Column reporting_currency_amount (DECIMAL(18,2)) in production.cost_transaction']
  reporting_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the reporting currency. | Column reporting_currency_code (STRING) in production.cost_transaction']
  sap_document_number varchar [note: 'SAP S/4HANA financial document number (FI/CO posting document) associated with this transaction. | Column sap_document_number (STRING) in production.cost_transaction']
  sap_line_item_number varchar [note: 'Line item number within the SAP document for granular traceability. | Column sap_line_item_number (STRING) in production.cost_transaction']
  sap_wbs_element varchar [note: 'SAP WBS element representing the project structure node for this cost transaction. | Column sap_wbs_element (STRING) in production.cost_transaction']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.cost_transaction']
  tax_amount decimal(18,2) [note: 'Tax amount associated with this transaction, if applicable. | Column tax_amount (DECIMAL(18,2)) in production.cost_transaction']
  transaction_amount decimal(18,2) [note: 'The monetary amount of the cost transaction in the original transaction currency. | Column transaction_amount (DECIMAL(18,2)) in production.cost_transaction']
  transaction_date date [note: 'The date on which the cost transaction was incurred or posted in the financial system. | Column transaction_date (DATE) in production.cost_transaction']
  transaction_number varchar [note: 'Business-facing unique transaction number or document reference for this cost entry. | Column transaction_number (STRING) in production.cost_transaction']
  transaction_type varchar [note: 'Classification of the cost transaction: purchase order, vendor invoice, petty cash disbursement, payroll charge, inter-company cost allocation, or credit memo. | Column transaction_type (STRING) in production.cost_transaction']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.cost_transaction']
  updated_timestamp timestamp [note: 'Timestamp when this cost transaction record was last updated or modified. | Column updated_timestamp (TIMESTAMP) in production.cost_transaction']

  Note: 'Individual cost transaction record incurred during production — purchase orders, vendor invoices, petty cash disbursements, payroll charges, and inter-company cost allocations posted against a production project. Captures transaction date, transaction type, vendor or payee, cost category, budget line reference, amount, currency, SAP document number, payment status, and approver. Provides the granular financial audit trail for production spend reconciliation against the production budget. | Unity Catalog table: media_broadcasting_ecm.production.cost_transaction'
}

Table production.insurance_policy {
  insurance_policy_id varchar [pk, note: 'Primary key for insurance_policy | Column insurance_policy_id (BIGINT) in production.insurance_policy']
  broker_contact_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: When insurance brokers are internal employees (common in large media companies with in-house risk management), tracking for vendor management, compliance reporting, and contact continuity. | Column broker_contact_employee_id (BIGINT) in workforce.insurance_policy']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Insurance premiums must be allocated to cost centers for insurance expense allocation across production departments. Required for production insurance cost tracking (E&O, general liability, equipment) | Column cost_center_id (BIGINT) in finance.insurance_policy']
  insurer_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Insurance carriers are partners providing production insurance (E&O, general liability, equipment). Linking enables tracking all policies with that carrier, claims history analysis, renewal negotiatio | Column insurer_partner_id (BIGINT) in partner.insurance_policy']
  production_project_id varchar [note: 'Reference to the production project covered by this insurance policy. Links to the production project entity. | Column production_project_id (BIGINT) in production.insurance_policy']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Production insurance policies may require regulatory filings in certain jurisdictions for workers\' compensation, liability coverage, and bond requirements. Links insurance compliance to regulatory rep | Column regulatory_filing_id (BIGINT) in compliance.insurance_policy']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.insurance_policy']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.insurance_policy']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.insurance_policy']
  additional_insured_parties varchar [note: 'List of additional parties named as insured under this policy, such as broadcasters, distributors, or co-production partners. Comma-separated list. | Column additional_insured_parties (STRING) in production.insurance_policy']
  broker_contact_email varchar [note: 'Primary email address for the insurance broker handling this policy. Used for policy inquiries and claims coordination. | Column broker_contact_email (STRING) in production.insurance_policy']
  broker_contact_phone varchar [note: 'Primary phone number for the insurance broker handling this policy. | Column broker_contact_phone (STRING) in production.insurance_policy']
  broker_name varchar [note: 'The name of the insurance broker or agent who facilitated the policy placement. | Column broker_name (STRING) in production.insurance_policy']
  cancellation_date date [note: 'The date when the policy was cancelled, if applicable. Null for active policies. | Column cancellation_date (DATE) in production.insurance_policy']
  cancellation_reason varchar [note: 'The reason for policy cancellation, such as non-payment, production completion, or insured request. | Column cancellation_reason (STRING) in production.insurance_policy']
  certificate_issue_date date [note: 'The date when the Certificate of Insurance was issued for this policy. | Column certificate_issue_date (DATE) in production.insurance_policy']
  certificate_of_insurance_issued_flag boolean [note: 'Indicates whether a Certificate of Insurance has been issued for this policy. Required for broadcaster delivery compliance and vendor contracts. | Column certificate_of_insurance_issued_flag (BOOLEAN) in production.insurance_policy']
  claim_history_flag boolean [note: 'Indicates whether any claims have been filed against this policy. True if claims exist, False if no claims. | Column claim_history_flag (BOOLEAN) in production.insurance_policy']
  compliance_requirement_met_flag boolean [note: 'Indicates whether this policy meets all broadcaster delivery and regulatory compliance requirements for the production. True if compliant, False if deficiencies exist. | Column compliance_requirement_met_flag (BOOLEAN) in production.insurance_policy']
  coverage_amount decimal(18,2) [note: 'The maximum liability or coverage limit provided by this policy, expressed in the policy currency. | Column coverage_amount (DECIMAL(18,2)) in production.insurance_policy']
  coverage_territory varchar [note: 'Geographic territory or jurisdictions where the insurance coverage applies. May be worldwide or limited to specific countries/regions. | Column coverage_territory (STRING) in production.insurance_policy']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.insurance_policy']
  created_timestamp timestamp [note: 'Timestamp when this insurance policy record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.insurance_policy']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this policy (coverage, deductible, premium). | Column currency_code (STRING) in production.insurance_policy']
  deductible_amount decimal(18,2) [note: 'The deductible or excess amount that must be paid by the insured before the insurance coverage applies, expressed in the policy currency. | Column deductible_amount (DECIMAL(18,2)) in production.insurance_policy']
  exclusions_summary varchar [note: 'Summary of key exclusions or limitations in the insurance coverage. Describes what is NOT covered by this policy. | Column exclusions_summary (STRING) in production.insurance_policy']
  notes varchar [note: 'Free-text notes or comments about this insurance policy, including special arrangements, negotiations, or internal observations. | Column notes (STRING) in production.insurance_policy']
  payment_date date [note: 'The actual date when the insurance premium was paid. | Column payment_date (DATE) in production.insurance_policy']
  payment_due_date date [note: 'The date by which the insurance premium payment is due to keep the policy in force. | Column payment_due_date (DATE) in production.insurance_policy']
  payment_status varchar [note: 'Current status of the premium payment for this policy. Indicates whether the premium has been fully paid, is pending, or is overdue. | Column payment_status (STRING) in production.insurance_policy']
  policy_document_url varchar [note: 'URL or file path to the digital copy of the full insurance policy document stored in the Media Asset Management (MAM) system or document repository. | Column policy_document_url (STRING) in production.insurance_policy']
  policy_effective_date date [note: 'The date when the insurance coverage begins and the policy becomes active. | Column policy_effective_date (DATE) in production.insurance_policy']
  policy_expiration_date date [note: 'The date when the insurance coverage ends and the policy is no longer in force. | Column policy_expiration_date (DATE) in production.insurance_policy']
  policy_number varchar [note: 'The unique policy number assigned by the insurance carrier. This is the externally-known identifier for the policy. | Column policy_number (STRING) in production.insurance_policy']
  policy_status varchar [note: 'Current lifecycle status of the insurance policy. Indicates whether the policy is in force, expired, or cancelled. | Column policy_status (STRING) in production.insurance_policy']
  policy_term_days varchar [note: 'The total duration of the insurance policy coverage period, measured in days. | Column policy_term_days (INT) in production.insurance_policy']
  policy_type varchar [note: 'The category of insurance coverage provided by this policy. Defines the risk domain covered. [ENUM-REF-CANDIDATE: cast_insurance|errors_and_omissions|general_liability|equipment_coverage|negative_film_protection|workers_compensation|completion_bond — 7 candidates stripped; promote to reference product] | Column policy_type (STRING) in production.insurance_policy']
  premium_amount decimal(18,2) [note: 'The total premium cost paid for this insurance policy, expressed in the policy currency. | Column premium_amount (DECIMAL(18,2)) in production.insurance_policy']
  prior_policy_number varchar [note: 'The policy number of the previous insurance policy if this is a renewal. Null for new policies. | Column prior_policy_number (STRING) in production.insurance_policy']
  renewal_flag boolean [note: 'Indicates whether this policy is a renewal of a previous policy. True if renewed, False if new policy. | Column renewal_flag (BOOLEAN) in production.insurance_policy']
  sap_policy_reference varchar [note: 'Reference number or identifier for this insurance policy in the SAP S/4HANA ERP system, used for financial reconciliation and cost tracking. | Column sap_policy_reference (STRING) in production.insurance_policy']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.insurance_policy']
  special_conditions varchar [note: 'Any special conditions, endorsements, or riders attached to this policy that modify standard coverage terms. | Column special_conditions (STRING) in production.insurance_policy']
  total_claims_filed varchar [note: 'The total number of insurance claims filed against this policy to date. | Column total_claims_filed (INT) in production.insurance_policy']
  total_claims_paid_amount decimal(18,2) [note: 'The cumulative amount paid out by the insurer for all claims under this policy, expressed in the policy currency. | Column total_claims_paid_amount (DECIMAL(18,2)) in production.insurance_policy']
  underwriter_name varchar [note: 'The name of the underwriter at the insurance carrier who approved and underwrote this policy. | Column underwriter_name (STRING) in production.insurance_policy']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.insurance_policy']
  updated_timestamp timestamp [note: 'Timestamp when this insurance policy record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in production.insurance_policy']

  Note: 'Insurance policy record covering a production project against production risks — cast insurance, errors and omissions (E&O), general liability, equipment, negative film, workers compensation, and completion bond. Captures policy type, insurer, policy number, coverage amount, deductible, premium, policy start date, policy end date, covered production project, broker, and claim history flag. Essential for production risk management and broadcaster delivery compliance. | Unity Catalog table: media_broadcasting_ecm.production.insurance_policy'
}

Table production.production_clearance {
  production_clearance_id varchar [pk, note: 'Unique identifier for the production clearance record. Primary key for tracking rights clearance throughout the clearance lifecycle. | Column production_clearance_id (BIGINT) in production.production_clearance']
  advertiser_id varchar [note: 'Foreign key linking to sales.advertiser. Business justification: Clearances required for advertiser brand usage, logos, trademarks, and product appearances in content. Business process: advertiser brand clearance management, trademark usage rights tracking, product | Column advertiser_id (BIGINT) in sales.production_clearance']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Rights clearances incur costs that must be tracked to cost centers for rights expense tracking and amortization schedules. Essential for music licensing, talent rights, and IP clearance cost managemen | Column cost_center_id (BIGINT) in finance.production_clearance']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Production clearances track the approval process for using content/music/talent in production. These clearances are often governed by license agreements that grant usage rights. The production_clearan | Column license_agreement_id (BIGINT) in rights.production_clearance']
  production_content_clearance_id varchar [note: 'FK to canonical content clearance for rights/legal | Column content_clearance_id (BIGINT) in content.production_clearance']
  production_content_content_clearance_id varchar [note: 'FK reference to canonical source']
  production_project_id varchar [note: 'Reference to the production project for which this clearance applies. Links clearance to the content being produced. | Column production_project_id (BIGINT) in production.production_clearance']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Rights clearances often require regulatory filings for music licensing (ASCAP/BMI), international distribution rights, and foreign content quotas. Links clearance workflow to regulatory reporting. | Column regulatory_filing_id (BIGINT) in compliance.production_clearance']
  requested_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Rights clearance requests track requester employee for workflow routing, approval escalation, and audit trails—standard in legal/business affairs operations. Replaces denormalized requested_by name. | Column requested_by_employee_id (BIGINT) in workforce.production_clearance']
  rights_holder_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Rights clearances are obtained from IP owners, music publishers, stock footage libraries, and clearance agencies (partners). Linking enables tracking all clearances from that partner, payment processi | Column rights_holder_partner_id (BIGINT) in partner.production_clearance']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Production clearances (music, IP, location rights) are obtained for specific content titles. Critical for content distribution clearance workflows, rights management, and ensuring production-side clea | Column title_id (BIGINT) in content.production_clearance']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.production_clearance']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.production_clearance']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.production_clearance']
  approved_by varchar [note: 'Name or identifier of the legal or business affairs representative who approved the clearance terms and authorized execution of the agreement. | Column approved_by (STRING) in production.production_clearance']
  attribution_required_flag boolean [note: 'Indicates whether the clearance agreement requires on-screen or end-credit attribution to the rights holder or original creator. True if attribution is mandatory; false if not required. | Column attribution_required_flag (BOOLEAN) in production.production_clearance']
  attribution_text varchar [note: 'Exact text required for on-screen or end-credit attribution as specified by the rights holder. Must be displayed verbatim to comply with clearance terms. | Column attribution_text (STRING) in production.production_clearance']
  clearance_date date [note: 'Date on which the rights holder formally approved the clearance and the agreement became legally binding. Marks the start of the clearance validity period. | Column clearance_date (DATE) in production.production_clearance']
  clearance_number varchar [note: 'Business-facing unique reference number for the clearance record, used in legal documentation and rights management correspondence. | Column clearance_number (STRING) in production.production_clearance']
  clearance_status varchar [note: 'Current lifecycle state of the clearance request. Pending indicates initial submission; in_negotiation indicates active rights holder discussions; cleared indicates approved and legally binding; denied indicates rights holder refusal; expired indicates clearance period has lapsed; revoked indicates post-clearance withdrawal of rights. | Column clearance_status (STRING) in production.production_clearance']
  clearance_type varchar [note: 'Category of intellectual property clearance required. Sync license covers musical composition synchronization rights; master use covers sound recording rights; clip license covers third-party video footage; trademark clearance covers brand logos and marks; likeness release covers individual appearance rights; brand placement covers product integration; literary excerpt covers written content; archival footage covers historical video content. [ENUM-REF-CANDIDATE: sync_license|master_use_license|clip_license|trademark_clearance|likeness_release|brand_placement|literary_excerpt|archival_footage — 8 candidates stripped; promote to reference product] | Column clearance_type (STRING) in production.production_clearance']
  contract_reference varchar [note: 'Reference number or identifier for the underlying legal contract or license agreement governing this clearance. Links to contract management system for full terms and conditions. | Column contract_reference (STRING) in production.production_clearance']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.production_clearance']
  created_timestamp timestamp [note: 'Timestamp when this clearance record was first created in the system. Audit field for data lineage and compliance tracking. | Column created_timestamp (TIMESTAMP) in production.production_clearance']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the original clearance fee if negotiated in a currency other than USD. Used for financial reconciliation and foreign exchange tracking. | Column currency_code (STRING) in production.production_clearance']
  duration_days varchar [note: 'Total number of days for which the clearance is valid, calculated from effective_start_date to expiry_date. Used for rights management reporting and renewal planning. | Column duration_days (INT) in production.production_clearance']
  effective_start_date date [note: 'Date from which the clearance becomes valid and the intellectual property may be used in production and distribution. May differ from clearance_date if agreement includes a future effective date. | Column effective_start_date (DATE) in production.production_clearance']
  exclusivity_flag boolean [note: 'Indicates whether the clearance grants exclusive rights to use the intellectual property within the specified territory and media types. True if exclusive; false if non-exclusive and rights holder may license to other parties. | Column exclusivity_flag (BOOLEAN) in production.production_clearance']
  expiry_date date [note: 'Date on which the clearance expires and the intellectual property may no longer be used without renewal or renegotiation. Null indicates perpetual clearance. Critical for compliance and content windowing. | Column expiry_date (DATE) in production.production_clearance']
  fee_usd decimal(15,2) [note: 'Total fee paid to the rights holder for clearance, expressed in US dollars. Includes all licensing costs, synchronization fees, master use fees, and any negotiated payments. | Column fee_usd (DECIMAL(15,2)) in production.production_clearance']
  ip_description varchar [note: 'Detailed description of the third-party intellectual property being cleared, including title, artist, duration, usage context, and specific elements requiring clearance. | Column ip_description (STRING) in production.production_clearance']
  isan varchar [note: 'International Standard Audiovisual Number for audiovisual content being cleared, such as archival footage or clip licenses. Unique identifier for audiovisual works. | Column isan (STRING) in production.production_clearance']
  isrc varchar [note: 'International Standard Recording Code for music recordings being cleared. Unique identifier for sound recordings used in music synchronization and master use clearances. | Column isrc (STRING) in production.production_clearance']
  iswc varchar [note: 'International Standard Musical Work Code for musical compositions being cleared. Unique identifier for musical works used in synchronization license clearances. | Column iswc (STRING) in production.production_clearance']
  media_type_cleared varchar [note: 'Distribution channels and platforms for which the clearance is valid, specified as comma-separated values (e.g., broadcast,SVOD,AVOD,theatrical,FAST,social_media). Defines the media formats and delivery methods authorized under this clearance. | Column media_type_cleared (STRING) in production.production_clearance']
  notes varchar [note: 'Free-text field for additional context, negotiation history, special conditions, or internal comments related to the clearance process and agreement. | Column notes (STRING) in production.production_clearance']
  priority varchar [note: 'Business priority level for obtaining this clearance. Critical indicates production cannot proceed without clearance; high indicates significant creative or schedule impact; medium indicates moderate impact; low indicates optional or easily substitutable. | Column priority (STRING) in production.production_clearance']
  renewal_required_flag boolean [note: 'Indicates whether the clearance requires periodic renewal or renegotiation. True if the clearance has a fixed term and must be renewed; false if perpetual or automatically renewing. | Column renewal_required_flag (BOOLEAN) in production.production_clearance']
  restrictions varchar [note: 'Any usage restrictions, limitations, or conditions imposed by the rights holder, such as prohibited contexts, content rating requirements, editorial approval rights, or blackout periods. | Column restrictions (STRING) in production.production_clearance']
  rights_holder_contact varchar [note: 'Primary contact information for rights holder correspondence, including email, phone, or agent details for clearance negotiation and documentation. | Column rights_holder_contact (STRING) in production.production_clearance']
  rightsline_clearance_reference varchar [note: 'External identifier for this clearance record in the Rightsline rights and royalties management system. Used for cross-system reconciliation and audit trail. | Column rightsline_clearance_reference (STRING) in production.production_clearance']
  sap_cost_object_code varchar [note: 'SAP cost object identifier (WBS element or internal order) to which the clearance fee is charged. Links clearance costs to production budget tracking in SAP S/4HANA. | Column sap_cost_object_code (STRING) in production.production_clearance']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.production_clearance']
  territory varchar [note: 'Geographic territories for which the clearance is valid, specified as comma-separated ISO 3166-1 alpha-3 country codes or regional groupings (e.g., USA,CAN,MEX or worldwide). Defines where the content may be distributed with this cleared IP. | Column territory (STRING) in production.production_clearance']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.production_clearance']
  updated_timestamp timestamp [note: 'Timestamp when this clearance record was last modified. Audit field for change tracking and data quality monitoring. | Column updated_timestamp (TIMESTAMP) in production.production_clearance']
  usage_description varchar [note: 'Detailed description of how the intellectual property will be used within the production, including scene context, duration, prominence, and creative treatment. Critical for rights holder approval and compliance verification. | Column usage_description (STRING) in production.production_clearance']

  Note: 'Rights clearance record for third-party intellectual property used within a production — music synchronization, archival footage, brand logos, literary excerpts, trademarks, and likeness rights. Captures clearance type (sync license, master use, clip license, trademark clearance, likeness release), rights holder, territory, media type cleared (broadcast, SVOD, AVOD, theatrical), clearance fee, clearance status (pending, cleared, denied, expired), clearance date, and expiry date. Ensures all third-party IP embedded in a production is legally cleared before broadcast or distribution. | Unity Catalog table: media_broadcasting_ecm.production.production_clearance'
}

Table production.format_spec {
  format_spec_id varchar [pk, note: 'Primary key for format_spec | Column format_spec_id (BIGINT) in production.format_spec']
  abr_profile_id varchar [note: 'Foreign key linking to distribution.abr_profile. Business justification: Production format specifications map to distribution ABR profiles for transcoding workflows. Real business process: format conversion pipeline configuration, encoding preset selection, and quality ass | Column abr_profile_id (BIGINT) in distribution.format_spec']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Channels define technical delivery specifications (resolution, codec, audio format) that productions must meet. Broadcast standards compliance requires format specs tied to target channel. Required fo | Column channel_id (BIGINT) in scheduling.format_spec']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.format_spec']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.format_spec']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.format_spec']
  abr_profile varchar [note: 'The adaptive bitrate streaming profile or ladder configuration associated with this format specification. | Column abr_profile (STRING) in production.format_spec']
  approval_date date [note: 'The date on which this format specification was officially approved for use in production workflows. | Column approval_date (DATE) in production.format_spec']
  approved_by varchar [note: 'The name or identifier of the person or role who approved this format specification for production use. | Column approved_by (STRING) in production.format_spec']
  aspect_ratio varchar [note: 'The proportional relationship between width and height of the video frame (e.g., 16:9, 4:3, 2.39:1, 1.85:1). | Column aspect_ratio (NUMERIC) in production.format_spec']
  audio_bit_depth varchar [note: 'The number of bits used to represent each audio sample (e.g., 16, 24, 32). | Column audio_bit_depth (INT) in production.format_spec']
  audio_codec varchar [note: 'The audio compression codec used for encoding (e.g., AAC, AC-3, E-AC-3, PCM, Dolby Digital Plus, Dolby Atmos). | Column audio_codec (STRING) in production.format_spec']
  audio_configuration varchar [note: 'The audio channel layout and configuration for this format specification. | Column audio_configuration (STRING) in production.format_spec']
  audio_sample_rate_khz decimal(6,2) [note: 'The audio sampling frequency in kilohertz (e.g., 48, 96, 192). | Column audio_sample_rate_khz (DECIMAL(6,2)) in production.format_spec']
  bit_depth varchar [note: 'The number of bits used to represent color information per channel (e.g., 8, 10, 12, 16). | Column bit_depth (INT) in production.format_spec']
  broadcast_standard varchar [note: 'The broadcast television standard applicable to this format specification. | Column broadcast_standard (STRING) in production.format_spec']
  chroma_subsampling varchar [note: 'The chroma subsampling scheme defining color resolution relative to luminance (e.g., 4:2:0, 4:2:2, 4:4:4). | Column chroma_subsampling (STRING) in production.format_spec']
  closed_caption_standard varchar [note: 'The closed captioning or subtitle standard supported by this format (e.g., CEA-608, CEA-708, DVB Subtitles, TTML). | Column closed_caption_standard (STRING) in production.format_spec']
  color_space varchar [note: 'The color space standard defining the range and representation of colors in the video signal. | Column color_space (STRING) in production.format_spec']
  compliance_requirements varchar [note: 'List of regulatory or industry compliance requirements that this format specification satisfies (e.g., FCC broadcast standards, ATSC 3.0, DVB-T2). | Column compliance_requirements (STRING) in production.format_spec']
  container_format varchar [note: 'The file container or wrapper format used to package video, audio, and metadata streams (e.g., MXF, MOV, MP4, TS). | Column container_format (STRING) in production.format_spec']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.format_spec']
  created_timestamp timestamp [note: 'The timestamp when this format specification record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.format_spec']
  dalet_format_profile_reference varchar [note: 'The corresponding format profile identifier in Dalet Galaxy MAM system used for workflow orchestration and transcoding. | Column dalet_format_profile_reference (STRING) in production.format_spec']
  drm_compatibility varchar [note: 'The DRM systems or encryption standards compatible with this format specification (e.g., Widevine, PlayReady, FairPlay). | Column drm_compatibility (STRING) in production.format_spec']
  effective_end_date date [note: 'The date on which this format specification is no longer valid for new production projects. Null indicates no planned end date. | Column effective_end_date (DATE) in production.format_spec']
  effective_start_date date [note: 'The date from which this format specification becomes effective and available for use in production projects. | Column effective_start_date (DATE) in production.format_spec']
  file_size_gb decimal(12,3) [note: 'The estimated or typical file size in gigabytes for content encoded in this format specification for a standard duration. | Column file_size_gb (DECIMAL(12,3)) in production.format_spec']
  format_code varchar [note: 'Short alphanumeric code or identifier used to reference this format specification in production systems and workflows. | Column format_code (STRING) in production.format_spec']
  format_name varchar [note: 'Business name or label for this format specification (e.g., \'UHD 4K HDR10 Theatrical\', \'HD 1080p Broadcast Standard\'). | Column format_name (STRING) in production.format_spec']
  format_status varchar [note: 'The current lifecycle status of this format specification within the production environment. | Column format_status (STRING) in production.format_spec']
  format_type varchar [note: 'Classification of the format specification by its intended use in the production workflow. | Column format_type (STRING) in production.format_spec']
  frame_rate decimal(8,3) [note: 'The number of frames per second for this format specification (e.g., 23.976, 24, 25, 29.97, 30, 50, 59.94, 60). | Column frame_rate (DECIMAL(8,3)) in production.format_spec']
  hdr_standard varchar [note: 'The HDR standard applied to this format specification, or SDR if standard dynamic range. | Column hdr_standard (STRING) in production.format_spec']
  is_default_format boolean [note: 'Boolean flag indicating whether this format specification is the default or recommended format for its type and resolution class. | Column is_default_format (BOOLEAN) in production.format_spec']
  resolution varchar [note: 'The spatial resolution of the video format, defining the number of pixels and scan type (progressive or interlaced). | Column resolution (STRING) in production.format_spec']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.format_spec']
  streaming_protocol varchar [note: 'The streaming delivery protocol supported by this format (e.g., HLS, MPEG-DASH, RTMP, SRT). | Column streaming_protocol (STRING) in production.format_spec']
  technical_notes varchar [note: 'Additional technical notes, specifications, or guidance for production teams using this format specification. | Column technical_notes (STRING) in production.format_spec']
  timecode_format varchar [note: 'The timecode standard and format used for frame-accurate synchronization and editing. | Column timecode_format (STRING) in production.format_spec']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.format_spec']
  updated_timestamp timestamp [note: 'The timestamp when this format specification record was last modified or updated. | Column updated_timestamp (TIMESTAMP) in production.format_spec']
  video_bitrate_mbps decimal(10,2) [note: 'The target or maximum video bitrate in megabits per second for this format specification. | Column video_bitrate_mbps (DECIMAL(10,2)) in production.format_spec']
  video_codec varchar [note: 'The video compression codec used for encoding (e.g., H.264, H.265/HEVC, ProRes, DNxHD, AVC-Intra, XAVC). | Column video_codec (STRING) in production.format_spec']

  Note: 'Reference record defining the technical production format specification for a project or deliverable — the agreed capture and delivery format standard. Captures format name, frame rate (23.976, 25, 29.97, 50, 59.94), resolution (HD 1080i, HD 1080p, UHD 4K, 8K), aspect ratio, color space (Rec.709, Rec.2020, P3), HDR standard (HDR10, Dolby Vision, HLG), audio configuration (5.1, 7.1, Atmos), codec, container format, and applicable broadcast standard (ATSC, DVB). Serves as the technical specification baseline for all production and post-production work. | Unity Catalog table: media_broadcasting_ecm.production.format_spec'
}

Table production.rating_submission {
  rating_submission_id varchar [pk, note: 'Primary key for rating_submission | Column rating_submission_id (BIGINT) in production.rating_submission']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Rating submissions result in content ratings; this is the natural outcome link. Tracks the submission-to-certification workflow for MPAA, TV Parental Guidelines, and international rating authorities. | Column compliance_content_rating_id (BIGINT) in compliance.rating_submission']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: Rating rejections, appeals, or content rating disputes are tracked as compliance incidents. Links rating workflow to incident management for regulatory risk tracking and remediation. | Column compliance_incident_id (BIGINT) in compliance.rating_submission']
  content_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: Rating submissions result in content ratings that must be tracked in the content domain. Essential for compliance workflows, distribution clearance, and linking production-side rating requests to cont | Column content_rating_id (BIGINT) in content.rating_submission']
  primary_rating_employee_id varchar [note: 'Identifier of the user or staff member who submitted the content for rating. | Column primary_rating_employee_id (BIGINT) in workforce.rating_submission']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Rating submissions can be episode-specific (episodic content rated individually). Optional FK (nullable) — submissions may be project-level or episode-level. Enables episode-specific rating tracking. | Column production_episode_id (BIGINT) in production.rating_submission']
  production_project_id varchar [note: 'Reference to the production project for which content rating is being submitted. | Column production_project_id (BIGINT) in production.rating_submission']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.rating_submission']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.rating_submission']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.rating_submission']
  appeal_date date [note: 'Date when the appeal was formally filed with the rating authority. | Column appeal_date (DATE) in production.rating_submission']
  appeal_filed_flag boolean [note: 'Indicates whether an appeal was filed against the initial rating decision. | Column appeal_filed_flag (BOOLEAN) in production.rating_submission']
  appeal_outcome varchar [note: 'Result of the appeal process. Upheld means original rating stands, overturned means rating was changed, modified means rating was adjusted. | Column appeal_outcome (STRING) in production.rating_submission']
  broadcast_clearance_required_flag boolean [note: 'Indicates whether this rating is required for broadcast clearance and compliance with Federal Communications Commission (FCC) or equivalent regulatory requirements. | Column broadcast_clearance_required_flag (BOOLEAN) in production.rating_submission']
  certificate_expiry_date date [note: 'Date when the rating certificate expires and content must be re-submitted for re-rating if applicable. Null if certificate does not expire. | Column certificate_expiry_date (DATE) in production.rating_submission']
  certificate_issue_date date [note: 'Date when the rating certificate was officially issued by the rating authority. | Column certificate_issue_date (DATE) in production.rating_submission']
  content_runtime_minutes varchar [note: 'Total runtime of the submitted content in minutes. | Column content_runtime_minutes (INT) in production.rating_submission']
  content_type varchar [note: 'Classification of the content being submitted for rating. [ENUM-REF-CANDIDATE: feature_film|television_series|television_episode|short_film|documentary|music_video|commercial|trailer|web_series — 9 candidates stripped; promote to reference product] | Column content_type (STRING) in production.rating_submission']
  coppa_applicable_flag boolean [note: 'Indicates whether the content is subject to COPPA regulations due to being directed at children under 13. | Column coppa_applicable_flag (BOOLEAN) in production.rating_submission']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.rating_submission']
  created_timestamp timestamp [note: 'Timestamp when this rating submission record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.rating_submission']
  cuts_description varchar [note: 'Detailed description of the cuts, edits, or modifications required by the rating authority. Includes timecodes, scene descriptions, and nature of changes. | Column cuts_description (STRING) in production.rating_submission']
  cuts_required_flag boolean [note: 'Indicates whether the rating authority required editorial cuts or modifications to the content to achieve the assigned rating. | Column cuts_required_flag (BOOLEAN) in production.rating_submission']
  dalet_workflow_reference varchar [note: 'Reference to the Dalet Galaxy Media Asset Management workflow orchestration identifier associated with this rating submission process. | Column dalet_workflow_reference (STRING) in production.rating_submission']
  distribution_clearance_required_flag boolean [note: 'Indicates whether this rating is required for distribution clearance across platforms (theatrical, OTT, SVOD, AVOD, linear broadcast). | Column distribution_clearance_required_flag (BOOLEAN) in production.rating_submission']
  eidr varchar [note: 'Entertainment Identifier Registry unique identifier for the content submitted for rating. | Column eidr (STRING) in production.rating_submission']
  isan varchar [note: 'International Standard Audiovisual Number uniquely identifying the audiovisual work submitted for rating. | Column isan (STRING) in production.rating_submission']
  notes varchar [note: 'Additional free-form notes or comments regarding the rating submission, review process, or special circumstances. | Column notes (STRING) in production.rating_submission']
  rating_authority varchar [note: 'The governing body or ratings organization to which the content was submitted. Examples: MPA (Motion Picture Association), BBFC (British Board of Film Classification), FSK (Freiwillige Selbstkontrolle der Filmwirtschaft), CBFC (Central Board of Film Certification), ACB (Australian Classification Board), OFLC (Office of Film and Literature Classification), KMRB (Korea Media Rating Board), EIRIN (Film Classification and Rating Organization Japan), CSA (Conseil Supérieur de l\'Audiovisuel), DJCTQ (Departamento de Justiça Classificação Títulos e Qualificação), NICAM (Netherlands Institute for the Classification of Audiovisual Media), PEGI (Pan European Game Information), ESRB (Entertainment Software Rating Board), TV Parental Guidelines. [ENUM-REF-CANDIDATE: MPA|BBFC|FSK|CBFC|ACB|OFLC|KMRB|EIRIN|CSA|DJCTQ|NICAM|PEGI|ESRB|TV_PARENTAL_GUIDELINES — 14 candidates stripped; promote to reference product] | Column rating_authority (STRING) in production.rating_submission']
  rating_conditions varchar [note: 'Any conditions, restrictions, or requirements imposed by the rating authority for the assigned rating. Examples: specific scenes must be cut, warning messages required, restricted broadcast hours. | Column rating_conditions (STRING) in production.rating_submission']
  review_completion_date date [note: 'Date when the rating authority completed its review and issued the final rating decision. | Column review_completion_date (DATE) in production.rating_submission']
  reviewer_notes varchar [note: 'Internal notes or feedback provided by the rating authority reviewers regarding the content evaluation. May include guidance for future submissions. | Column reviewer_notes (STRING) in production.rating_submission']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.rating_submission']
  submission_date date [note: 'Date when the content rating submission was formally submitted to the rating authority. | Column submission_date (DATE) in production.rating_submission']
  submission_fee_amount decimal(15,2) [note: 'Fee charged by the rating authority for processing the rating submission. | Column submission_fee_amount (DECIMAL(15,2)) in production.rating_submission']
  submission_fee_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the submission fee. | Column submission_fee_currency_code (STRING) in production.rating_submission']
  submission_reference_number varchar [note: 'External reference number or tracking code assigned by the submitter or rating authority for this submission. | Column submission_reference_number (STRING) in production.rating_submission']
  submission_status varchar [note: 'Current lifecycle status of the rating submission. Tracks progression from draft through submission, review, and final decision. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|appealed|withdrawn — 7 candidates stripped; promote to reference product] | Column submission_status (STRING) in production.rating_submission']
  submitted_content_title varchar [note: 'The title of the content as submitted to the rating authority. May differ from production working title. | Column submitted_content_title (STRING) in production.rating_submission']
  submitted_content_version varchar [note: 'Version identifier of the content submitted for rating (e.g., theatrical cut, director\'s cut, TV edit, unrated version). | Column submitted_content_version (STRING) in production.rating_submission']
  territory varchar [note: 'Geographic territory or jurisdiction for which this rating is valid. Use 3-letter ISO country codes (e.g., USA, GBR, DEU, IND, AUS). | Column territory (STRING) in production.rating_submission']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.rating_submission']
  updated_timestamp timestamp [note: 'Timestamp when this rating submission record was last updated in the system. | Column updated_timestamp (TIMESTAMP) in production.rating_submission']

  Note: 'Submission record for content rating classification by a governing body (MPA, BBFC, FSK, CBFC, or equivalent national ratings authority). Captures submission date, rating authority, submitted content title and version, rating received (G, PG, PG-13, R, NC-17, TV-Y, TV-14, TV-MA, etc.), rating descriptors (violence, language, sexual content), submission status, certificate number, certificate expiry, territory, and any conditions or cuts required for the rating. Required for broadcast compliance and distribution clearance. | Unity Catalog table: media_broadcasting_ecm.production.rating_submission'
}

Table production.daily_production_report {
  daily_production_report_id varchar [pk, note: 'Unique identifier for the daily production report. Primary key for this entity. | Column daily_production_report_id (BIGINT) in production.daily_production_report']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Daily production reports track actual spend that must reconcile to cost centers for daily cost tracking and variance alerts. Essential for production accounting to monitor burn rate and trigger budget | Column cost_center_id (BIGINT) in finance.daily_production_report']
  location_id varchar [note: 'Reference to the primary filming location for this shoot day. | Column location_id (BIGINT) in production.daily_production_report']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Daily production reports reference dailies/footage assets generated that shoot day for editorial review. Role-prefixed as dailies_asset_id. Essential for linking production metadata (scenes shot, page | Column media_asset_id (BIGINT) in mediaasset.daily_production_report']
  previous_daily_production_report_id varchar [note: 'Self-referencing FK on daily_production_report (previous_daily_production_report_id) | Column previous_daily_production_report_id (BIGINT) in production.daily_production_report']
  primary_daily_employee_id varchar [note: 'Reference to the director responsible for this shoot day. | Column primary_daily_employee_id (BIGINT) in workforce.daily_production_report']
  production_episode_id varchar [note: 'Reference to the specific episode being shot on this day, if applicable. | Column production_episode_id (BIGINT) in production.daily_production_report']
  production_project_id varchar [note: 'Reference to the production project for which this daily report was generated. | Column production_project_id (BIGINT) in production.daily_production_report']
  shoot_schedule_id varchar [note: 'Foreign key linking to production.shoot_schedule. Business justification: Daily production report is generated FOR a specific shoot schedule entry. Strong operational link — the report captures actuals vs. the schedule. FK enables variance analysis (scheduled vs. actual tim | Column shoot_schedule_id (BIGINT) in production.daily_production_report']
  tertiary_daily_submitted_by_user_employee_id varchar [note: 'Reference to the user who submitted this daily production report for approval. | Column tertiary_daily_submitted_by_user_employee_id (BIGINT) in workforce.daily_production_report']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Daily production reports document shoot progress for specific content titles. Required for production cost allocation to titles, shoot day tracking by content, and linking production activity to final | Column title_id (BIGINT) in content.daily_production_report']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.daily_production_report']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.daily_production_report']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.daily_production_report']
  accidents_incidents_description varchar [note: 'Detailed description of any accidents, injuries, or safety incidents that occurred, if applicable. | Column accidents_incidents_description (STRING) in production.daily_production_report']
  accidents_incidents_flag boolean [note: 'Indicates whether any accidents, injuries, or safety incidents occurred during this shoot day. | Column accidents_incidents_flag (BOOLEAN) in production.daily_production_report']
  ad_notes varchar [note: 'Notes from the first assistant director regarding logistics, schedule adherence, crew performance, and operational issues. | Column ad_notes (STRING) in production.daily_production_report']
  approval_timestamp timestamp [note: 'Timestamp when this daily production report was approved and locked. | Column approval_timestamp (TIMESTAMP) in production.daily_production_report']
  background_actors_count varchar [note: 'Number of background actors (extras) used on this shoot day. | Column background_actors_count (INT) in production.daily_production_report']
  call_time timestamp [note: 'Scheduled crew call time for the start of the shoot day. | Column call_time (TIMESTAMP) in production.daily_production_report']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.daily_production_report']
  created_timestamp timestamp [note: 'Timestamp when this daily production report record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.daily_production_report']
  dalet_workflow_reference varchar [note: 'Reference identifier to the corresponding workflow in Dalet Galaxy Media Asset Management system for ingest and post-production tracking. | Column dalet_workflow_reference (STRING) in production.daily_production_report']
  digital_media_consumed_tb decimal(8,2) [note: 'Total terabytes of digital media captured during the shoot day, if shooting digitally. | Column digital_media_consumed_tb (DECIMAL(8,2)) in production.daily_production_report']
  director_notes varchar [note: 'Notes and observations from the director regarding the shoot day, creative decisions, and performance. | Column director_notes (STRING) in production.daily_production_report']
  film_stock_consumed_feet varchar [note: 'Total feet of film stock consumed during the shoot day, if shooting on film. | Column film_stock_consumed_feet (INT) in production.daily_production_report']
  first_shot_time timestamp [note: 'Actual timestamp when the first shot of the day was captured. | Column first_shot_time (TIMESTAMP) in production.daily_production_report']
  last_shot_time timestamp [note: 'Actual timestamp when the final shot of the day was captured. | Column last_shot_time (TIMESTAMP) in production.daily_production_report']
  meal_break_end timestamp [note: 'Timestamp when the primary meal break ended and shooting resumed. | Column meal_break_end (TIMESTAMP) in production.daily_production_report']
  meal_break_start timestamp [note: 'Timestamp when the primary meal break began. | Column meal_break_start (TIMESTAMP) in production.daily_production_report']
  meal_penalty_incurred_flag boolean [note: 'Indicates whether a meal penalty was incurred due to late or missed meal breaks per union rules. | Column meal_penalty_incurred_flag (BOOLEAN) in production.daily_production_report']
  overtime_hours decimal(8,2) [note: 'Total overtime hours incurred across all crew members on this shoot day. | Column overtime_hours (DECIMAL(8,2)) in production.daily_production_report']
  pages_shot decimal(5,2) [note: 'Number of script pages (in eighths) completed during this shoot day, the primary measure of production progress. | Column pages_shot (DECIMAL(5,2)) in production.daily_production_report']
  production_unit varchar [note: 'The production unit responsible for this shoot day (main unit, second unit, etc.). | Column production_unit (STRING) in production.daily_production_report']
  report_date date [note: 'The shoot date for which this daily production report was generated. Principal business event timestamp for this transaction. | Column report_date (DATE) in production.daily_production_report']
  report_number varchar [note: 'Business identifier for the daily production report, typically sequential or formatted per production standards. | Column report_number (STRING) in production.daily_production_report']
  report_status varchar [note: 'Current lifecycle status of the daily production report in the approval workflow. | Column report_status (STRING) in production.daily_production_report']
  sap_cost_object_code varchar [note: 'Reference to the SAP cost object (WBS element or internal order) for production accounting reconciliation. | Column sap_cost_object_code (STRING) in production.daily_production_report']
  scenes_completed varchar [note: 'Comma-separated list or range of scene numbers completed during this shoot day (e.g., 12, 14A, 15-17). | Column scenes_completed (STRING) in production.daily_production_report']
  schedule_variance_days decimal(4,2) [note: 'Number of days ahead or behind schedule after this shoot day. Positive values indicate ahead of schedule, negative values indicate behind schedule. | Column schedule_variance_days (DECIMAL(4,2)) in production.daily_production_report']
  setups_completed varchar [note: 'Total number of camera setups completed during the shoot day. | Column setups_completed (INT) in production.daily_production_report']
  shoot_day_number varchar [note: 'Sequential day number within the principal photography schedule (e.g., Day 1, Day 2, etc.). | Column shoot_day_number (INT) in production.daily_production_report']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.daily_production_report']
  total_crew_hours decimal(8,2) [note: 'Aggregate crew hours worked across all crew members on this shoot day. | Column total_crew_hours (DECIMAL(8,2)) in production.daily_production_report']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.daily_production_report']
  updated_timestamp timestamp [note: 'Timestamp when this daily production report record was last modified. | Column updated_timestamp (TIMESTAMP) in production.daily_production_report']
  weather_conditions varchar [note: 'Description of weather conditions during the shoot day, relevant for exterior shoots and schedule impact. | Column weather_conditions (STRING) in production.daily_production_report']
  wrap_time timestamp [note: 'Actual wrap time when the shoot day concluded and crew was dismissed. | Column wrap_time (TIMESTAMP) in production.daily_production_report']

  Note: 'Daily operational report generated at wrap each shoot day — the authoritative record of what was accomplished during principal photography. Captures report date, production project, episode, scenes completed, setups completed, pages shot, first shot time, last shot time, meal breaks, total crew hours, overtime hours, film stock or digital media consumed, accidents or incidents, weather conditions, director and AD notes, and schedule variance (ahead/behind). The DPR is the primary accountability document for production progress and the basis for production accounting reconciliation. | Unity Catalog table: media_broadcasting_ecm.production.daily_production_report'
}

Table production.call_sheet {
  call_sheet_id varchar [pk, note: 'Unique identifier for the call sheet record. Primary key. | Column call_sheet_id (BIGINT) in production.call_sheet']
  employee_id varchar [note: 'Reference to the user (typically the first assistant director or production coordinator) who issued this call sheet. | Column employee_id (BIGINT) in workforce.call_sheet']
  location_id varchar [note: 'Foreign key linking to production.location. Business justification: Normalization opportunity. Call sheet currently has denormalized location_name, location_address, location_type. Adding FK to location table allows retrieving authoritative location data via JOIN and  | Column location_id (BIGINT) in production.call_sheet']
  production_episode_id varchar [note: 'Reference to the specific episode being shot on this call sheet date. Nullable for non-episodic productions. | Column production_episode_id (BIGINT) in production.call_sheet']
  production_project_id varchar [note: 'Reference to the production project for which this call sheet is issued. | Column production_project_id (BIGINT) in production.call_sheet']
  revised_call_sheet_id varchar [note: 'Self-referencing FK on call_sheet (revised_call_sheet_id) | Column revised_call_sheet_id (BIGINT) in production.call_sheet']
  shoot_schedule_id varchar [note: 'Foreign key linking to production.shoot_schedule. Business justification: Call sheet is issued FOR a specific shoot schedule entry. Strong operational relationship — the call sheet operationalizes the shoot schedule for that day. FK allows linking call sheet details to the  | Column shoot_schedule_id (BIGINT) in production.call_sheet']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Call sheets schedule production for specific content titles. Essential for production planning by content, crew scheduling against content delivery dates, and tracking shoot schedules to final content | Column title_id (BIGINT) in content.call_sheet']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.call_sheet']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.call_sheet']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.call_sheet']
  advance_schedule_notes varchar [note: 'Advance schedule information for the following shoot day, providing crew with next-day preparation details. | Column advance_schedule_notes (STRING) in production.call_sheet']
  base_camp_location varchar [note: 'Location of the base camp where trailers, catering, and crew facilities are set up. | Column base_camp_location (STRING) in production.call_sheet']
  call_sheet_number varchar [note: 'The externally-known call sheet number or identifier issued by the assistant director department for this shoot day. | Column call_sheet_number (STRING) in production.call_sheet']
  call_sheet_status varchar [note: 'Current lifecycle status of the call sheet document. | Column call_sheet_status (STRING) in production.call_sheet']
  cast_call_times varchar [note: 'Structured list of individual cast member call times and pickup details (e.g., Actor Name: 05:30 - Pickup from hotel). Stored as formatted text. | Column cast_call_times (STRING) in production.call_sheet']
  cover_set_description varchar [note: 'Description of the cover set or alternative scenes to be shot if weather or other conditions prevent the primary schedule. | Column cover_set_description (STRING) in production.call_sheet']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.call_sheet']
  created_timestamp timestamp [note: 'Timestamp when this call sheet record was first created in the system. | Column created_timestamp (TIMESTAMP) in production.call_sheet']
  dalet_workflow_reference varchar [note: 'Reference identifier linking this call sheet to the corresponding workflow task or document in Dalet Galaxy Media Asset Management system. | Column dalet_workflow_reference (STRING) in production.call_sheet']
  department_call_times varchar [note: 'Structured list of individual department call times (e.g., Hair/Makeup: 06:00, Camera: 07:00, Grip/Electric: 06:30). Stored as formatted text. | Column department_call_times (STRING) in production.call_sheet']
  director_name varchar [note: 'Name of the director assigned to this shoot day. | Column director_name (STRING) in production.call_sheet']
  estimated_wrap_time timestamp [note: 'Anticipated time for the shoot day to conclude and crew to wrap. | Column estimated_wrap_time (TIMESTAMP) in production.call_sheet']
  first_ad_name varchar [note: 'Name of the first assistant director responsible for issuing this call sheet and managing the shoot day. | Column first_ad_name (STRING) in production.call_sheet']
  first_shot_time timestamp [note: 'Scheduled time for the first camera shot or principal photography to begin. | Column first_shot_time (TIMESTAMP) in production.call_sheet']
  general_crew_call_time timestamp [note: 'The default call time for general crew members to arrive on set or location. | Column general_crew_call_time (TIMESTAMP) in production.call_sheet']
  meal_times varchar [note: 'Scheduled meal break times for the shoot day (e.g., Breakfast: 07:00, Lunch: 13:00). | Column meal_times (STRING) in production.call_sheet']
  nearest_hospital varchar [note: 'Name and address of the nearest hospital or emergency medical facility to the shoot location. | Column nearest_hospital (STRING) in production.call_sheet']
  notes varchar [note: 'Additional notes, instructions, or important information for cast and crew regarding this shoot day. | Column notes (STRING) in production.call_sheet']
  page_count decimal(5,2) [note: 'Total script page count scheduled to be shot on this call sheet date, measured in eighths of a page. | Column page_count (DECIMAL(5,2)) in production.call_sheet']
  parking_instructions varchar [note: 'Parking location and instructions for crew and cast arriving at the shoot location. | Column parking_instructions (STRING) in production.call_sheet']
  production_unit varchar [note: 'The production unit or crew team assigned to this shoot day. | Column production_unit (STRING) in production.call_sheet']
  revision_date date [note: 'Date when the current revision of the call sheet was issued. | Column revision_date (DATE) in production.call_sheet']
  revision_number varchar [note: 'Sequential revision number of the call sheet. Incremented each time the call sheet is revised and reissued. | Column revision_number (INT) in production.call_sheet']
  safety_notices varchar [note: 'Safety notices, hazard warnings, and safety protocols for the shoot day (e.g., stunts, pyrotechnics, special effects). | Column safety_notices (STRING) in production.call_sheet']
  scene_descriptions varchar [note: 'Brief descriptions of the scenes to be shot, providing context for cast and crew. | Column scene_descriptions (STRING) in production.call_sheet']
  scene_numbers varchar [note: 'Comma-separated list of scene numbers scheduled to be shot on this call sheet date. | Column scene_numbers (STRING) in production.call_sheet']
  shoot_date date [note: 'The principal shoot date for which this call sheet is issued. This is the business event date for the production day. | Column shoot_date (DATE) in production.call_sheet']
  shoot_day_number varchar [note: 'Sequential shoot day number within the production schedule (e.g., Day 1, Day 2, etc.). | Column shoot_day_number (INT) in production.call_sheet']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.call_sheet']
  special_equipment_requirements varchar [note: 'List of special equipment, vehicles, props, or technical gear required for this shoot day. | Column special_equipment_requirements (STRING) in production.call_sheet']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.call_sheet']
  updated_timestamp timestamp [note: 'Timestamp when this call sheet record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in production.call_sheet']
  weather_contingency_flag boolean [note: 'Indicates whether a weather contingency plan or cover set is in place for this shoot day. | Column weather_contingency_flag (BOOLEAN) in production.call_sheet']
  weather_forecast varchar [note: 'Weather forecast for the shoot date and location, critical for outdoor shoots and contingency planning. | Column weather_forecast (STRING) in production.call_sheet']

  Note: 'Daily call sheet issued by the assistant director department for each shoot day. Captures call date, production project, episode, general crew call time, individual department call times, cast member call times and pickup details, scenes to be shot with brief descriptions, location or stage, special equipment requirements, advance schedule for following day, safety notices, and weather forecast. The call sheet is the primary communication and coordination document for all cast and crew on a production. | Unity Catalog table: media_broadcasting_ecm.production.call_sheet'
}

Table production.broadcast {
  broadcast_id varchar [pk, note: 'Primary key for the broadcast association | Column broadcast_id (BIGINT) in production.broadcast']
  channel_id varchar [note: 'Channel for the broadcast']
  production_episode_id varchar [note: 'Foreign key linking to the production episode being broadcast in this slot | Column production_episode_id (BIGINT) in production.broadcast']
  rights_content_window_id varchar [note: 'Reference to the specific rights window or license agreement governing this broadcast. Same episode may have different rights windows for different territories, platforms, or time periods. | Column rights_window_id (BIGINT) in rights.broadcast']
  schedule_slot_id varchar [note: 'Foreign key linking to the schedule slot in which this episode is broadcast | Column schedule_slot_id (BIGINT) in scheduling.broadcast']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.broadcast']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.broadcast']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.broadcast']
  actual_broadcast_time timestamp [note: 'Actual broadcast time']
  actual_end_time timestamp [note: 'Actual end time of broadcast']
  actual_start_time timestamp [note: 'Actual start time of broadcast']
  approved_by varchar [note: 'User who approved the broadcast']
  audience_rating decimal(5,2) [note: 'Audience rating for the broadcast']
  audio_format varchar [note: 'Audio format (stereo, surround)']
  audio_language varchar [note: 'Primary audio language']
  broadcast_date date [note: 'The calendar date on which this specific broadcast of the episode occurred or is scheduled to occur. Enables tracking of original vs repeat airings over time. | Column broadcast_date (DATE) in production.broadcast']
  broadcast_duration_seconds varchar [note: 'Duration of the broadcast in seconds']
  broadcast_status varchar [note: 'Current lifecycle status of this specific broadcast event. Tracks whether the scheduled broadcast occurred as planned or was preempted/cancelled. | Column broadcast_status (STRING) in production.broadcast']
  broadcast_time timestamp [note: 'Scheduled broadcast time']
  broadcast_type varchar [note: 'Type of broadcast (premiere, repeat, special)']
  closed_caption_flag boolean [note: 'Whether closed captions available']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.broadcast']
  created_timestamp timestamp [note: 'System timestamp when this broadcast assignment was created in the scheduling system. Audit trail for scheduling operations. | Column created_timestamp (TIMESTAMP) in production.broadcast']
  duration_seconds varchar
  dvs_flag boolean [note: 'Whether descriptive video service available']
  edit_type varchar [note: 'Classification of editorial modifications applied for this specific broadcast (content edits for standards, time compression, localization). Varies by territory and daypart. | Column edit_type (STRING) in production.broadcast']
  end_time timestamp [note: 'Scheduled end time of broadcast']
  feed_source varchar [note: 'Source feed for the broadcast']
  live_flag boolean [note: 'Whether broadcast was live']
  network_code varchar [note: 'Network code for the broadcast']
  notes varchar
  platform_type varchar [note: 'Distribution platform on which this broadcast occurs. Same episode may be scheduled across linear TV, streaming simulcast, and VOD platforms with different rights and versions. | Column platform_type (STRING) in production.broadcast']
  preempted_flag boolean [note: 'Whether broadcast was preempted']
  preemption_reason varchar [note: 'Reason for preemption if applicable']
  premiere_flag boolean [note: 'Whether this is a premiere broadcast']
  repeat_number varchar [note: 'Sequential count of how many times this episode has been broadcast on this channel/platform. 0 = original airing, 1+ = repeat. Critical for rights management and audience measurement. | Column repeat_number (INT) in production.broadcast']
  runtime_seconds varchar [note: 'Total runtime in seconds']
  sap_available_flag boolean [note: 'Whether secondary audio program was available']
  share_percentage decimal(5,2) [note: 'Share percentage of viewing audience']
  simulcast_flag boolean [note: 'Whether broadcast was simulcast']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.broadcast']
  start_time timestamp [note: 'Scheduled start time of broadcast']
  tape_delay_flag boolean
  technical_issues varchar
  territory_code varchar [note: 'ISO country or region code identifying the geographic territory for this broadcast. Same episode may be broadcast simultaneously in multiple territories with different versions or rights windows. | Column territory_code (STRING) in production.broadcast']
  transmission_version varchar [note: 'The specific editorial version of the episode transmitted in this broadcast (e.g., theatrical cut, TV edit, international version). Different slots may air different versions of the same episode. | Column transmission_version (STRING) in production.broadcast']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.broadcast']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  video_resolution varchar [note: 'Video resolution (SD, HD, 4K)']
  created_by varchar [note: 'User ID or name of the scheduler who created this broadcast assignment. Accountability for scheduling decisions. | Column created_by (STRING) in production.broadcast']

  Note: 'This association product represents the broadcast event linking a production episode to a specific schedule slot. It captures the operational details of each individual airing of an episode, including transmission version, territory, platform, repeat sequencing, and rights window. Each record represents one broadcast occurrence of one episode in one slot, enabling multi-territory, multi-platform scheduling with version control and repeat tracking.. Existence Justification: In media broadcasting operations, a single production episode is broadcast multiple times across different schedule slots (primetime, repeat slots, different channels, international feeds, streaming platforms). Conversely, each schedule slot contains exactly one episode at a time, but the same slot position (e.g., Monday 8pm) will host different episodes over time. The business actively manages broadcast events as operational records, tracking which version of which episode airs in which slot, for which territory, on which platform, with specific rights windows and repeat sequencing. | Unity Catalog table: media_broadcasting_ecm.production.broadcast'
}

Table production.episode_sponsorship {
  episode_sponsorship_id varchar [pk, note: 'Unique surrogate identifier for this episode-sponsorship placement record. Primary key. | Column episode_sponsorship_id (BIGINT) in production.episode_sponsorship']
  primary_episode_production_episode_id varchar [note: 'Foreign key linking to the specific episode receiving sponsorship placement | Column episode_production_episode_id (BIGINT) in production.episode_sponsorship']
  sponsorship_id varchar [note: 'Foreign key linking to the sponsorship deal being fulfilled through this episode | Column sponsorship_id (BIGINT) in sales.episode_sponsorship']
  verified_by_employee_id varchar [note: 'Reference to the employee who verified fulfillment of this specific episode-sponsorship placement. | Column verified_by_employee_id (BIGINT) in workforce.episode_sponsorship']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.episode_sponsorship']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.episode_sponsorship']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.episode_sponsorship']
  actual_impressions varchar [note: 'Actual number of impressions delivered for this specific episode-sponsorship placement across all distribution platforms. | Column actual_impressions (BIGINT) in production.episode_sponsorship']
  billboard_placement_timecode varchar [note: 'SMPTE timecode indicating the exact placement location of the sponsor billboard within the episode master (e.g., opening, closing, mid-roll). Identified in detection phase. | Column billboard_placement_timecode (STRING) in production.episode_sponsorship']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.episode_sponsorship']
  created_timestamp timestamp [note: 'Timestamp when this episode-sponsorship placement record was created in the system. | Column created_timestamp (TIMESTAMP) in production.episode_sponsorship']
  end_date date [note: 'Date when this specific sponsorship placement expires for this episode. Corresponds to sponsorship_end_date from detection phase. | Column end_date (DATE) in production.episode_sponsorship']
  fulfillment_status varchar [note: 'Current status of deliverable fulfillment for this specific episode-sponsorship placement. Tracks whether sponsor obligations have been met for this episode. Identified in detection phase. | Column fulfillment_status (STRING) in production.episode_sponsorship']
  logo_display_duration_seconds decimal(6,2) [note: 'Duration in seconds that the sponsor logo is displayed during this episode placement. Used for fulfillment verification and sponsor reporting. Identified in detection phase. | Column logo_display_duration_seconds (DECIMAL(6,2)) in production.episode_sponsorship']
  makegood_reason varchar [note: 'Description of why a makegood is required for this placement (e.g., technical issue, audience under-delivery, incorrect placement). | Column makegood_reason (STRING) in production.episode_sponsorship']
  makegood_required_flag boolean [note: 'Indicates whether a makegood (compensatory placement) is required due to under-delivery or quality issues with this specific episode-sponsorship placement. | Column makegood_required_flag (BOOLEAN) in production.episode_sponsorship']
  placement_type varchar [note: 'Classification of the specific type of sponsorship placement within this episode (opening, closing, mid-roll, integration, etc.). Derived from billboard_placement_timecode and deliverables. | Column placement_type (STRING) in production.episode_sponsorship']
  product_integration_scene_numbers varchar [note: 'Comma-separated list of scene numbers where product integration occurs for this sponsor within this episode. Used for production coordination and fulfillment tracking. Identified in detection phase. | Column product_integration_scene_numbers (STRING) in production.episode_sponsorship']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.episode_sponsorship']
  start_date date [note: 'Date when this specific sponsorship placement becomes active for this episode. Corresponds to sponsorship_start_date from detection phase. | Column start_date (DATE) in production.episode_sponsorship']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.episode_sponsorship']
  updated_timestamp timestamp [note: 'Timestamp when this episode-sponsorship placement record was last updated. | Column updated_timestamp (TIMESTAMP) in production.episode_sponsorship']
  verification_date date [note: 'Date on which fulfillment of this episode-sponsorship placement was verified and approved. | Column verification_date (DATE) in production.episode_sponsorship']

  Note: 'This association product represents the Contract between production_episode and sponsorship. It captures the specific placement, fulfillment, and integration details for each sponsorship deal applied to each episode. Each record links one production_episode to one sponsorship with attributes that exist only in the context of this relationship, including placement timecodes, fulfillment tracking, and integration scene references.. Existence Justification: In media broadcasting operations, a single episode can have multiple sponsorship deals (e.g., Brand A sponsors the opening billboard, Brand B sponsors the closing billboard, Brand C has product integration in scenes 5-7), and a single sponsorship deal (especially for series or season-level sponsorships) applies to multiple episodes across the season or series run. The business actively manages each episode-sponsorship placement as a distinct fulfillment obligation with specific timecodes, placement types, verification status, and impression tracking. | Unity Catalog table: media_broadcasting_ecm.production.episode_sponsorship'
}

Table production.project_sponsorship {
  project_sponsorship_id varchar [pk, note: 'Unique surrogate identifier for the project sponsorship record. Primary key. | Column project_sponsorship_id (BIGINT) in production.project_sponsorship']
  advertiser_id varchar [note: 'Foreign key to sales.advertiser. Links this sponsorship to the funding advertiser. | Column advertiser_id (BIGINT) in sales.project_sponsorship']
  production_project_id varchar [note: 'Foreign key to production.project. Links this sponsorship to the content production project. | Column production_project_id (BIGINT) in production.project_sponsorship']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in production.project_sponsorship']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in production.project_sponsorship']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in production.project_sponsorship']
  approval_rights_level varchar [note: 'Level of creative approval authority granted to the advertiser over content related to their sponsorship (e.g., none, consultation, approval required, creative control). Explicitly identified in detection phase relationship data. | Column approval_rights_level (STRING) in production.project_sponsorship']
  co_production_agreement_reference varchar [note: 'External reference identifier or document number for the legal co-production or sponsorship agreement governing this partnership. Explicitly identified in detection phase relationship data. | Column co_production_agreement_reference (STRING) in production.project_sponsorship']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in production.project_sponsorship']
  created_timestamp timestamp [note: 'System timestamp when this sponsorship record was created. | Column created_timestamp (TIMESTAMP) in production.project_sponsorship']
  deliverable_requirements varchar [note: 'Textual description of the specific deliverables the production team must provide to the advertiser (e.g., logo placement duration, product integration scenes, behind-the-scenes content, premiere tickets). Explicitly identified in detection phase relationship data. | Column deliverable_requirements (STRING) in production.project_sponsorship']
  funding_amount decimal(18,2) [note: 'Total monetary contribution committed by the advertiser to this production project, denominated in the currency specified in funding_currency_code. Explicitly identified in detection phase relationship data. | Column funding_amount (DECIMAL(18,2)) in production.project_sponsorship']
  funding_currency_code varchar [note: 'ISO 4217 three-letter currency code for the funding amount (e.g., USD, EUR, GBP). | Column funding_currency_code (STRING) in production.project_sponsorship']
  funding_percentage decimal(5,2) [note: 'Percentage of the total production budget contributed by this advertiser, expressed as a decimal (e.g., 25.00 for 25%). Explicitly identified in detection phase relationship data. | Column funding_percentage (DECIMAL(5,2)) in production.project_sponsorship']
  logo_placement_seconds varchar [note: 'Total duration in seconds of advertiser logo or brand placement within the content, as contractually committed. | Column logo_placement_seconds (INT) in production.project_sponsorship']
  partnership_end_date date [note: 'Expiration or completion date of the sponsorship partnership agreement. | Column partnership_end_date (DATE) in production.project_sponsorship']
  partnership_start_date date [note: 'Effective start date of the sponsorship partnership agreement. | Column partnership_start_date (DATE) in production.project_sponsorship']
  partnership_status varchar [note: 'Current lifecycle status of the sponsorship partnership (e.g., proposed, negotiating, active, fulfilled, terminated). | Column partnership_status (STRING) in production.project_sponsorship']
  partnership_type varchar [note: 'Classification of the sponsorship arrangement indicating the level and nature of the advertiser\'s involvement (e.g., title sponsor, co-production partner, product placement, branded content integration). Explicitly identified in detection phase relationship data. | Column partnership_type (STRING) in production.project_sponsorship']
  product_integration_flag boolean [note: 'Boolean indicator of whether this sponsorship includes product integration or placement within the content narrative. | Column product_integration_flag (BOOLEAN) in production.project_sponsorship']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in production.project_sponsorship']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in production.project_sponsorship']
  updated_timestamp timestamp [note: 'System timestamp when this sponsorship record was last modified. | Column updated_timestamp (TIMESTAMP) in production.project_sponsorship']

  Note: 'This association product represents the commercial partnership between a content production project and an advertising client who provides funding or co-production support. It captures the financial terms, partnership structure, and deliverable obligations that exist only in the context of this specific project-advertiser relationship. Each record links one production project to one advertiser with attributes governing the sponsorship arrangement.. Existence Justification: In media broadcasting, content production projects frequently secure funding from multiple advertising partners simultaneously (e.g., a documentary series with automotive, tech, and beverage sponsors), and advertisers invest in multiple production projects across their portfolio. The business actively manages these sponsorship partnerships as distinct operational entities with specific financial terms, deliverable obligations, approval rights, and partnership statuses that belong to neither the project nor the advertiser alone. | Unity Catalog table: media_broadcasting_ecm.production.project_sponsorship'
}

