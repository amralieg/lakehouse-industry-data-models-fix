    rdfs:range xsd:string .

ind:skillLevelRequired rdf:type rdf:Property ;
    rdfs:label 'Skill Level Required' ;
    rdfs:comment 'Minimum skill level required for service representatives handling cases at this priority level, used for workforce management and routing.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:afterHoursSupportRequired rdf:type rdf:Property ;
    rdfs:label 'After Hours Support Required' ;
    rdfs:comment 'Indicates whether this priority level requires 24/7 support coverage including after-hours and weekend availability.' ;
