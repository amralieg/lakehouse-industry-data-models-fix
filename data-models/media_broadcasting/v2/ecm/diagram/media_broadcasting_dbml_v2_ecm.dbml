  net_payment_amount decimal(18,2) [note: 'Net payment amount after withholding tax deduction (fee_amount minus withholding_tax_amount). | Column net_payment_amount (DECIMAL(18,2)) in billing.syndication_license_fee']
  notes varchar [note: 'Additional notes or comments regarding this syndication license fee billing record. | Column notes (STRING) in billing.syndication_license_fee']
  payment_method varchar [note: 'Method of payment used or expected for this syndication license fee. | Column payment_method (STRING) in billing.syndication_license_fee']
  payment_received_date date [note: 'Actual date payment was received from the licensee (null if unpaid). | Column payment_received_date (DATE) in billing.syndication_license_fee']
  payment_reference_number varchar [note: 'External payment reference number or transaction ID provided by the licensee or payment processor. | Column payment_reference_number (STRING) in billing.syndication_license_fee']
  payment_schedule_type varchar [note: 'Type of payment schedule structure for the syndication license fee. | Column payment_schedule_type (STRING) in billing.syndication_license_fee']
  payment_status varchar [note: 'Current payment status of this syndication license fee installment. | Column payment_status (STRING) in billing.syndication_license_fee']
  revenue_recognition_date date [note: 'Date on which revenue from this fee is recognized under ASC 606 accounting standards. | Column revenue_recognition_date (DATE) in billing.syndication_license_fee']
  revenue_recognition_status varchar [note: 'Current revenue recognition status for this syndication license fee under ASC 606. | Column revenue_recognition_status (STRING) in billing.syndication_license_fee']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.syndication_license_fee']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.syndication_license_fee']
  total_installments varchar [note: 'Total number of installments in the payment schedule (null for lump-sum payments). | Column total_installments (INT) in billing.syndication_license_fee']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.syndication_license_fee']
  updated_timestamp timestamp [note: 'Timestamp when this syndication license fee record was last modified. | Column updated_timestamp (TIMESTAMP) in billing.syndication_license_fee']
  withholding_tax_amount decimal(18,2) [note: 'Calculated withholding tax amount deducted from the fee payment. | Column withholding_tax_amount (DECIMAL(18,2)) in billing.syndication_license_fee']
  withholding_tax_rate decimal(5,4) [note: 'Withholding tax rate applied to the fee amount based on licensee jurisdiction and tax treaty provisions (expressed as decimal, e.g., 0.1500 for 15%). | Column withholding_tax_rate (DECIMAL(5,4)) in billing.syndication_license_fee']

  Note: 'Billing record for syndication license fee payments due from content licensees (broadcast stations, streaming platforms, international distributors). Captures licensee name, licensed content title, license window (first-run, off-network, international), fee amount, payment schedule (lump sum, installment), installment due dates, currency, withholding tax rate, and Rightsline contract reference. Supports revenue recognition for content licensing under ASC 606. | Unity Catalog table: media_broadcasting_ecm.billing.syndication_license_fee'
}

Table billing.credit_memo {
  credit_memo_id varchar [pk, note: 'Unique identifier for the credit memo. Primary key for the credit memo entity. | Column credit_memo_id (BIGINT) in billing.credit_memo']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Makegoods, underdelivery credits, and preemption adjustments must trace to originating ad_order for accurate credit application, revenue reversal, and advertiser account reconciliation in advertising  | Column ad_order_id (BIGINT) in sales.credit_memo']
  advertising_makegood_id varchar [note: 'Foreign key linking to sales.makegood. Business justification: Makegood credits must reference the makegood record for audit trail, revenue reversal tracking, and reconciliation of makegood obligations with actual delivery in advertising billing. | Column advertising_makegood_id (BIGINT) in sales.credit_memo']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Credit memos issued as remediation for audit findings (e.g., makegoods for closed captioning failures, political ad rate corrections) must reference the finding for audit trail and financial impact tr | Column audit_finding_id (BIGINT) in compliance.credit_memo']
  billing_account_id varchar [note: 'Billing account or subscription account to which the credit is applied. | Column billing_account_id (BIGINT) in billing.credit_memo']
  campaign_id varchar [note: 'Reference to the advertising campaign for which a makegood credit is being issued due to under-delivery. Null for non-advertising credits. | Column campaign_id (BIGINT) in sales.credit_memo']
  communication_template_id varchar [note: 'Foreign key linking to billing.communication_template. Business justification: Credit memo notification uses ONE communication template to notify customer of the credit. Need FK to track which template was used for audit and customer service purposes. No redundant columns to rem | Column communication_template_id (BIGINT) in billing.credit_memo']
  compliance_finding_id varchar [note: 'Foreign key linking to content.compliance_finding. Business justification: Regulatory violations (FCC fines, content rating breaches) trigger credit memos to advertisers/distributors as makegoods or contractual penalties. Compliance and finance teams track which findings gen | Column compliance_finding_id (BIGINT) in content.credit_memo']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: Credit memos issued as remediation for compliance incidents (political ad disputes, accessibility failures, content rating violations) must link to the incident for financial impact analysis and regul | Column compliance_incident_id (BIGINT) in compliance.credit_memo']
  contract_id varchar [note: 'Reference to the carriage agreement, syndication license, or subscription contract associated with this credit. Null if not contract-related. | Column contract_id (BIGINT) in talent.credit_memo']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Credit memos need cost center attribution for variance analysis and departmental impact tracking. Enables media orgs to track revenue adjustments and makegoods against responsible cost centers for acc | Column cost_center_id (BIGINT) in finance.credit_memo']
  invoice_line_id varchar [note: 'Foreign key linking to billing.invoice_line. Business justification: Credit memo can reference ONE specific invoice line item (not just the entire invoice). Credits are often issued for specific line items (e.g., one ad spot that didn\'t air, one subscription month). Ne | Column invoice_line_id (BIGINT) in billing.credit_memo']
  original_ad_spot_id varchar [note: 'Foreign key linking to sales.ad_spot. Business justification: Spot-level credits for technical failures, preemptions, or affidavit discrepancies require direct ad_spot reference for precise credit calculation and makegood tracking in broadcast advertising operat | Column original_ad_spot_id (BIGINT) in sales.credit_memo']
  original_invoice_id varchar [note: 'Reference to the original invoice being credited, adjusted, or written off. Null for credits not tied to a specific invoice. | Column original_invoice_id (BIGINT) in billing.credit_memo']
  outage_record_id varchar [note: 'Foreign key linking to technology.outage_record. Business justification: Credits for service interruptions must reference outage records for SLA breach validation, revenue impact calculation, regulatory reporting, and automated credit approval workflows in broadcast servic | Column outage_record_id (BIGINT) in technology.credit_memo']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Credits issued for partner disputes (makegood spots for under-delivery, SLA breach penalties, content delivery failures) require partner attribution for dispute resolution workflows, relationship heal | Column partner_id (BIGINT) in partner.credit_memo']
  primary_credit_employee_id varchar [note: 'Identifier of the user who approved the credit memo, for audit trail and SOX compliance. | Column primary_credit_employee_id (BIGINT) in workforce.credit_memo']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Credit memos must be attributed to profit centers for accurate segment P&L and revenue adjustments. Critical for media broadcasters tracking makegoods and revenue corrections by channel or platform fo | Column profit_center_id (BIGINT) in finance.credit_memo']
  subscriber_id varchar [note: 'Identifier of the customer, advertiser, subscriber, or carriage partner receiving the credit. | Column subscriber_id (BIGINT) in subscriber.credit_memo']
  tertiary_credit_modified_by_user_employee_id varchar [note: 'Identifier of the user who last modified the credit memo record, for audit trail purposes. | Column tertiary_credit_modified_by_user_employee_id (BIGINT) in workforce.credit_memo']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.credit_memo']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.credit_memo']
  applied_date date [note: 'Date the credit was actually applied to the customer account or invoice balance. Null if not yet applied. | Column applied_date (DATE) in billing.credit_memo']
  approval_date date [note: 'Date the credit memo was approved by authorized personnel. Required for credits above threshold amounts. | Column approval_date (DATE) in billing.credit_memo']
  bad_debt_write_off_flag boolean [note: 'Indicates whether this credit memo represents a bad debt write-off for an uncollectable balance. True for write-offs, false for other credit types. | Column bad_debt_write_off_flag (BOOLEAN) in billing.credit_memo']
  collection_agency_name varchar [note: 'Name of the third-party collection agency to which the debt was referred, if applicable. | Column collection_agency_name (STRING) in billing.credit_memo']
  collection_agency_referral_flag boolean [note: 'Indicates whether the original debt was referred to a collection agency before write-off. Used for tracking recovery potential. | Column collection_agency_referral_flag (BOOLEAN) in billing.credit_memo']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.credit_memo']
  created_timestamp timestamp [note: 'Timestamp when the credit memo record was first created in the billing system. | Column created_timestamp (TIMESTAMP) in billing.credit_memo']
  credit_amount decimal(18,2) [note: 'Monetary value of the credit being issued, always positive. Represents the amount to be deducted from customer balance or written off. | Column credit_amount (DECIMAL(18,2)) in billing.credit_memo']
  credit_memo_number varchar [note: 'Externally-visible business identifier for the credit memo, used in customer communications and financial reporting. Typically follows format CM-YYYYMMDD-NNNN. | Column credit_memo_number (STRING) in billing.credit_memo']
  credit_memo_status varchar [note: 'Current lifecycle status of the credit memo in the approval and application workflow. | Column credit_memo_status (STRING) in billing.credit_memo']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the credit amount (e.g., USD, GBP, EUR). | Column currency_code (STRING) in billing.credit_memo']
  gl_account_code varchar [note: 'General ledger account code to which the credit or write-off is posted in SAP S/4HANA for financial reporting. | Column gl_account_code (STRING) in billing.credit_memo']
  issue_date date [note: 'Date the credit memo was formally issued and became effective for accounting purposes. | Column issue_date (DATE) in billing.credit_memo']
  makegood_spots_quantity varchar [note: 'Number of compensatory advertising spots to be provided as makegood for under-delivered campaigns. Null for non-makegood credits. | Column makegood_spots_quantity (INT) in billing.credit_memo']
  modified_timestamp timestamp [note: 'Timestamp when the credit memo record was last modified, for audit trail and change tracking. | Column modified_timestamp (TIMESTAMP) in billing.credit_memo']
  net_credit_amount decimal(18,2) [note: 'Net credit amount after tax adjustments. Equals credit_amount minus tax_amount. | Column net_credit_amount (DECIMAL(18,2)) in billing.credit_memo']
  notes varchar [note: 'Additional internal notes, comments, or special instructions related to the credit memo processing and approval. | Column notes (STRING) in billing.credit_memo']
  reason_code varchar [note: 'Business reason category for issuing the credit memo. Makegood refers to compensatory ad spots for under-delivered campaigns; billing_error for invoice corrections; service_outage for subscriber service credits; goodwill for customer retention; bad_debt_write_off for uncollectable balances. | Column reason_code (STRING) in billing.credit_memo']
  reason_description varchar [note: 'Detailed narrative explanation of why the credit memo was issued, including specific circumstances, campaign details, or error descriptions. | Column reason_description (STRING) in billing.credit_memo']
  recovery_amount decimal(18,2) [note: 'Amount subsequently recovered from a written-off debt through collection efforts or customer payment. Null if no recovery occurred. | Column recovery_amount (DECIMAL(18,2)) in billing.credit_memo']
  recovery_date date [note: 'Date on which a previously written-off amount was recovered. Null if no recovery occurred. | Column recovery_date (DATE) in billing.credit_memo']
  revenue_recognition_impact varchar [note: 'Accounting period impact classification for revenue recognition under ASC 606. Indicates whether the credit affects current, prior, or future period revenue. | Column revenue_recognition_impact (STRING) in billing.credit_memo']
  sap_document_number varchar [note: 'SAP S/4HANA financial document number for the credit memo posting, used for reconciliation and audit trail. | Column sap_document_number (STRING) in billing.credit_memo']
  sap_posting_date date [note: 'Date the credit memo was posted to SAP S/4HANA general ledger for financial reporting. | Column sap_posting_date (DATE) in billing.credit_memo']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.credit_memo']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.credit_memo']
  tax_amount decimal(18,2) [note: 'Tax portion of the credit amount, if applicable. Used for tax reporting and reconciliation. | Column tax_amount (DECIMAL(18,2)) in billing.credit_memo']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.credit_memo']

  Note: 'Formal credit or write-off document issued to reduce, reverse, or write off a previously billed amount — covering makegoods for under-delivered ad campaigns, billing error corrections, subscriber service credits, carriage fee adjustments, and bad debt write-offs for uncollectable balances. Captures credit memo number, reason code (makegood, billing error, service outage, goodwill, bad_debt_write_off), original invoice reference, credit amount, currency, approval status, applied date, collection agency referral flag, recovery amount if subsequently collected, and SAP credit/bad-debt posting reference. SSOT for all billing credits, adjustments, and write-offs. | Unity Catalog table: media_broadcasting_ecm.billing.credit_memo'
}

Table billing.billing_dispute {
  billing_dispute_id varchar [pk, note: 'Unique identifier for the billing dispute record. Primary key. | Column billing_dispute_id (BIGINT) in billing.billing_dispute']
  advertiser_id varchar [note: 'Foreign key linking to sales.advertiser. Business justification: Advertiser disputes require direct advertiser context for resolution workflow, escalation routing, credit hold decisions, and advertiser relationship management in media sales operations. | Column advertiser_id (BIGINT) in sales.billing_dispute']
  billing_account_id varchar [note: 'FK to the billing account associated with this dispute']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Advertising disputes often center on campaign-level delivery metrics (GRP, reach, frequency). Direct campaign link enables dispute resolution teams to access performance data and audience guarantees f | Column campaign_id (BIGINT) in sales.billing_dispute']
  communication_template_id varchar [note: 'Foreign key linking to billing.communication_template. Business justification: Billing dispute correspondence uses ONE communication template for dispute notifications and updates. Need FK to track which template was used for audit and customer service purposes. No redundant col | Column communication_template_id (BIGINT) in billing.billing_dispute']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: Billing disputes often arise from compliance incidents (political ad rate challenges per FCC lowest unit charge rules, advertiser disputes over closed captioning failures). Links financial and complia | Column compliance_incident_id (BIGINT) in compliance.billing_dispute']
  credit_memo_id varchar [note: 'Reference to the credit memo document issued to resolve the dispute, if applicable. | Column credit_memo_id (BIGINT) in billing.billing_dispute']
  employee_id varchar [note: 'Reference to the employee or team member assigned to investigate and resolve the dispute. | Column employee_id (BIGINT) in workforce.billing_dispute']
  invoice_id varchar [note: 'Reference to the invoice being disputed. Links to the invoice that triggered this dispute. | Column invoice_id (BIGINT) in billing.billing_dispute']
  outage_record_id varchar [note: 'Foreign key linking to technology.outage_record. Business justification: Billing disputes often stem from service outages; linking enables automated validation of customer claims against actual downtime records, SLA breach confirmation, and dispute resolution acceleration  | Column outage_record_id (BIGINT) in technology.billing_dispute']
  partner_id varchar [note: 'Reference to the entity (customer, advertiser, MVPD, licensee) who raised the dispute. Polymorphic reference resolved via disputing_party_type. | Column partner_id (BIGINT) in partner.billing_dispute']
  write_off_id varchar [note: 'Foreign key linking to billing.write_off. Business justification: Billing dispute can be resolved via ONE write-off decision (when dispute is valid and amount is written off). Need FK to write_off for dispute resolution tracking. No redundant columns to remove. | Column write_off_id (BIGINT) in billing.billing_dispute']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.billing_dispute']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.billing_dispute']
  assigned_resolver_name varchar [note: 'Name of the employee or team assigned to resolve the dispute, for operational tracking. | Column assigned_resolver_name (STRING) in billing.billing_dispute']
  contact_email varchar [note: 'Email address of the primary contact person for the disputing party, used for dispute correspondence. | Column contact_email (STRING) in billing.billing_dispute']
  contact_phone varchar [note: 'Phone number of the primary contact person for the disputing party, used for dispute resolution communication. | Column contact_phone (STRING) in billing.billing_dispute']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.billing_dispute']
  created_timestamp timestamp [note: 'Timestamp when the dispute record was first created in the data system, for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in billing.billing_dispute']
  credit_amount decimal(15,2) [note: 'The actual monetary credit amount issued to the disputing party as resolution, in the invoice currency. | Column credit_amount (DECIMAL(15,2)) in billing.billing_dispute']
  credit_memo_issued_flag boolean [note: 'Indicates whether a credit memo was issued as part of the dispute resolution (True) or not (False). | Column credit_memo_issued_flag (BOOLEAN) in billing.billing_dispute']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the disputed amount (e.g., USD, GBP, EUR). | Column currency_code (STRING) in billing.billing_dispute']
  dispute_amount decimal(18,2) [note: 'Monetary amount being disputed']
  dispute_description varchar [note: 'Detailed narrative explanation of the dispute as provided by the disputing party, capturing the specific issue and context. | Column dispute_description (STRING) in billing.billing_dispute']
  dispute_reason varchar [note: 'Detailed reason or justification for the dispute']
  dispute_reference_number varchar [note: 'Alternate business key for the dispute']
  dispute_status varchar [note: 'Current lifecycle state of the dispute: open (newly raised), under_review (being investigated), resolved (closed with outcome), escalated (sent to higher authority), withdrawn (retracted by disputing party), rejected (dispute denied without resolution). | Column dispute_status (STRING) in billing.billing_dispute']
  dispute_type varchar [note: 'Classification of the dispute reason: amount_error (billing calculation error), service_not_received (content or service not delivered), makegood_claim (compensatory ad spot request), duplicate_charge (same charge billed twice), rate_discrepancy (incorrect pricing applied), contract_dispute (terms interpretation disagreement). | Column dispute_type (STRING) in billing.billing_dispute']
  disputed_amount decimal(15,2) [note: 'The monetary amount being contested by the disputing party, in the invoice currency. | Column disputed_amount (DECIMAL(15,2)) in billing.billing_dispute']
  disputing_party_name varchar [note: 'Name of the organization or individual who raised the dispute, for reporting and communication purposes. | Column disputing_party_name (STRING) in billing.billing_dispute']
  disputing_party_type varchar [note: 'Category of the entity raising the dispute: subscriber (end consumer), advertiser (ad campaign buyer), MVPD (Multichannel Video Programming Distributor), licensee (content license holder), distributor (content distribution partner). | Column disputing_party_type (STRING) in billing.billing_dispute']
  escalation_level varchar [note: 'Numeric indicator of how many times the dispute has been escalated (0 = no escalation, 1 = first escalation to supervisor, 2 = second escalation to manager, etc.). | Column escalation_level (INT) in billing.billing_dispute']
  escalation_reason varchar [note: 'Explanation of why the dispute was escalated beyond the initial resolver, capturing complexity or policy exception requirements. | Column escalation_reason (STRING) in billing.billing_dispute']
  external_case_number varchar [note: 'Reference number from an external system (e.g., CRM case ID, legal case number) if the dispute is tracked in multiple systems. | Column external_case_number (STRING) in billing.billing_dispute']
  filed_date date [note: 'Date when the dispute was formally filed']
  last_modified_by varchar [note: 'Username or identifier of the system user who last updated the dispute record. | Column last_modified_by (STRING) in billing.billing_dispute']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to the dispute record, for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in billing.billing_dispute']
  open_date date [note: 'The date the dispute was formally raised and entered into the dispute management system. | Column open_date (DATE) in billing.billing_dispute']
  open_timestamp timestamp [note: 'Precise timestamp when the dispute was created in the system, used for SLA tracking and audit trail. | Column open_timestamp (TIMESTAMP) in billing.billing_dispute']
  priority varchar [note: 'Business priority level assigned to the dispute based on amount, customer tier, or contractual importance: low (routine), medium (standard), high (significant customer or amount), critical (executive escalation or legal risk). | Column priority (STRING) in billing.billing_dispute']
  reference_number varchar [note: 'Externally-visible unique reference number for the dispute, used in customer communications and tracking. Format: DSP-YYYYMMDD sequence. | Column reference_number (STRING) in billing.billing_dispute']
  resolution_date date [note: 'The date the dispute was formally closed with a final outcome. | Column resolution_date (DATE) in billing.billing_dispute']
  resolution_deadline_date date [note: 'Target date by which the dispute must be resolved per Service Level Agreement (SLA) or contractual terms. | Column resolution_deadline_date (DATE) in billing.billing_dispute']
  resolution_notes varchar [note: 'Internal notes documenting the investigation findings, resolution rationale, and actions taken by the resolver. | Column resolution_notes (STRING) in billing.billing_dispute']
  resolution_outcome varchar [note: 'Final outcome of the dispute resolution: full_credit (entire disputed amount credited), partial_credit (portion credited), no_adjustment (dispute rejected, no change), makegood_issued (compensatory ad spot provided), contract_amendment (terms renegotiated), escalated_unresolved (sent to legal or executive review). | Column resolution_outcome (STRING) in billing.billing_dispute']
  resolution_timestamp timestamp [note: 'Precise timestamp when the dispute was resolved, used for SLA compliance measurement. | Column resolution_timestamp (TIMESTAMP) in billing.billing_dispute']
  root_cause_category varchar [note: 'Classification of the underlying cause of the dispute for process improvement and trend analysis: billing_system_error (system calculation bug), data_entry_error (manual input mistake), rate_card_error (incorrect pricing configuration), service_delivery_failure (content or ad not delivered), contract_misinterpretation (terms unclear or misread), customer_misunderstanding (customer expectation mismatch). | Column root_cause_category (STRING) in billing.billing_dispute']
  sla_breach_flag boolean [note: 'Indicates whether the dispute resolution exceeded the contractual SLA deadline (True) or was resolved within SLA (False). | Column sla_breach_flag (BOOLEAN) in billing.billing_dispute']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.billing_dispute']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.billing_dispute']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.billing_dispute']
  created_by varchar [note: 'Username or identifier of the system user who created the dispute record in the billing system. | Column created_by (STRING) in billing.billing_dispute']

  Note: 'Canonical dispute entity for billing domain - reconciles MVM dispute vs ECM billing_dispute. Tracks customer or partner disputes against invoices including dispute type, status, amounts, resolution workflow and outcomes.'
}

Table billing.refund {
  refund_id varchar [pk, note: 'Unique identifier for the refund transaction. Primary key for the refund record. | Column refund_id (BIGINT) in billing.refund']
  billing_account_id varchar [note: 'Reference to the billing account receiving the refund. | Column billing_account_id (BIGINT) in billing.refund']
  billing_dispute_id varchar [note: 'Reference to the billing dispute record that triggered this refund, if the refund is the result of a resolved dispute. | Column billing_dispute_id (BIGINT) in billing.refund']
  communication_template_id varchar [note: 'Foreign key linking to billing.communication_template. Business justification: Refund notification uses ONE communication template to notify customer of the refund. Need FK to track which template was used for audit and customer service purposes. No redundant columns to remove. | Column communication_template_id (BIGINT) in billing.refund']
  credit_memo_id varchar [note: 'Foreign key linking to billing.credit_memo. Business justification: Refund can be triggered by ONE credit memo. Credit memos often result in refunds when the credit amount exceeds the outstanding balance. Need direct FK from refund to credit_memo (not just via billing | Column credit_memo_id (BIGINT) in billing.refund']
  invoice_id varchar [note: 'Reference to the original invoice that this refund is associated with, if applicable. | Column invoice_id (BIGINT) in billing.refund']
  outage_record_id varchar [note: 'Foreign key linking to technology.outage_record. Business justification: Refunds for service failures require outage documentation for approval justification, financial impact reporting, root cause tracking, and regulatory compliance in subscriber service refund processing | Column outage_record_id (BIGINT) in technology.refund']
  payment_id varchar [note: 'Reference to the original payment transaction that is being refunded. | Column payment_id (BIGINT) in billing.refund']
  payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: Refund is issued to ONE payment method (refund destination). Currently stores payment_method_last_four as STRING; need FK to the stored payment_method record. Remove payment_method_last_four as it can | Column payment_method_id (BIGINT) in billing.refund']
  processed_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Refund processing requires employee authorization for financial control. Tracking which billing staff member processed each refund is standard practice for fraud prevention and audit compliance in med | Column processed_by_employee_id (BIGINT) in workforce.refund']
  subscriber_id varchar [note: 'Reference to the subscriber who is receiving the refund. | Column subscriber_id (BIGINT) in subscriber.refund']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.refund']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.refund']
  amount decimal(18,2) [note: 'Gross monetary amount being refunded to the subscriber or account, before any adjustments or fees. | Column amount (DECIMAL(18,2)) in billing.refund']
  approval_timestamp timestamp [note: 'Date and time when the refund was approved for processing. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column approval_timestamp (TIMESTAMP) in billing.refund']
  channel varchar [note: 'The channel or interface through which the refund was initiated (web portal, mobile app, call center, retail location, automated system, batch process). | Column channel (STRING) in billing.refund']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.refund']
  created_timestamp timestamp [note: 'Date and time when this refund record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column created_timestamp (TIMESTAMP) in billing.refund']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the refund amount (e.g., USD, GBP, EUR). | Column currency_code (STRING) in billing.refund']
  expected_settlement_date date [note: 'Projected date when the refund is expected to be settled and funds returned to the subscriber. Format: yyyy-MM-dd. | Column expected_settlement_date (DATE) in billing.refund']
  fee decimal(18,2) [note: 'Any processing fee deducted from the refund amount, if applicable (e.g., payment gateway fees, administrative charges). | Column fee (DECIMAL(18,2)) in billing.refund']
  is_chargeback_related boolean [note: 'Boolean flag indicating whether this refund is related to a payment chargeback or dispute initiated by the subscriber through their financial institution. | Column is_chargeback_related (BOOLEAN) in billing.refund']
  is_partial_refund boolean [note: 'Boolean flag indicating whether this is a partial refund (true) or a full refund (false) of the original payment amount. | Column is_partial_refund (BOOLEAN) in billing.refund']
  method varchar [note: 'The method by which the refund is being returned to the subscriber: back to original payment instrument, check, account credit, wire transfer, or other mechanism. [ENUM-REF-CANDIDATE: original_payment_method|credit_card|bank_transfer|check|account_credit|wire_transfer|paypal|other — 8 candidates stripped; promote to reference product] | Column refund_method (STRING) in billing.refund']
  net_refund_amount decimal(18,2) [note: 'Net monetary amount actually returned to the subscriber or account after deducting any processing fees (refund_amount - refund_fee). | Column net_refund_amount (DECIMAL(18,2)) in billing.refund']
  notes varchar [note: 'Free-form text field for additional notes, comments, or context about the refund transaction, used by customer service and finance teams. | Column notes (STRING) in billing.refund']
  processing_date date [note: 'Date when the refund was submitted for payment processing. Format: yyyy-MM-dd. | Column processing_date (DATE) in billing.refund']
  reason_code varchar [note: 'Standardized code indicating the reason for the refund (e.g., CANCEL, DISPUTE, OVERPAY, SVCFAIL, GOODWILL). | Column reason_code (STRING) in billing.refund']
  reason_description varchar [note: 'Detailed narrative explanation of why the refund was issued, providing business context beyond the reason code. | Column reason_description (STRING) in billing.refund']
  refund_number varchar [note: 'Externally-visible business identifier for the refund, used in customer communications and financial reconciliation. Format: RFD-XXXXXXXXXX. | Column refund_number (STRING) in billing.refund']
  refund_status varchar [note: 'Current lifecycle status of the refund transaction in the processing workflow. [ENUM-REF-CANDIDATE: pending_approval|approved|processing|completed|failed|cancelled|reversed — 7 candidates stripped; promote to reference product] | Column refund_status (STRING) in billing.refund']
  refund_type varchar [note: 'Classification of the refund based on the revenue stream being reversed: subscription billing, advertising billing, carriage fee, syndication license fee, overpayment, or other. | Column refund_type (STRING) in billing.refund']
  request_date date [note: 'Date when the refund was originally requested by the subscriber or initiated by the system. Format: yyyy-MM-dd. | Column request_date (DATE) in billing.refund']
  reversal_reason varchar [note: 'Explanation for why a completed refund was reversed or cancelled, if applicable. | Column reversal_reason (STRING) in billing.refund']
  sap_document_number varchar [note: 'SAP S/4HANA financial document number for the refund posting in the general ledger, used for financial reconciliation and audit trail. | Column sap_document_number (STRING) in billing.refund']
  sap_posting_date date [note: 'Date when the refund was posted to the SAP S/4HANA general ledger. Format: yyyy-MM-dd. | Column sap_posting_date (DATE) in billing.refund']
  settlement_date date [note: 'Date when the refund funds were actually settled and returned to the subscriber or account. Format: yyyy-MM-dd. | Column settlement_date (DATE) in billing.refund']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.refund']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.refund']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.refund']
  updated_timestamp timestamp [note: 'Date and time when this refund record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column updated_timestamp (TIMESTAMP) in billing.refund']
  wideorbit_refund_reference varchar [note: 'External identifier from Wide Orbit traffic and billing system for refunds originating from advertising revenue, used for system integration and reconciliation. | Column wideorbit_refund_reference (STRING) in billing.refund']
  zuora_refund_reference varchar [note: 'External identifier from Zuora subscription billing system for refunds originating from subscription revenue, used for system integration and reconciliation. | Column zuora_refund_reference (STRING) in billing.refund']

  Note: 'Record of a monetary refund issued back to a subscriber or billing account following an overpayment, cancellation, or resolved dispute. Captures refund amount, currency, refund method (original payment method, check, account credit), refund reason, originating payment reference, approval status, processing date, settlement date, and SAP financial posting reference. Distinct from credit memos (which reduce invoice balances) — refunds represent actual cash outflows. | Unity Catalog table: media_broadcasting_ecm.billing.refund'
}

Table billing.dunning_event {
  dunning_event_id varchar [pk, note: 'Unique identifier for the dunning event record. Primary key. | Column dunning_event_id (BIGINT) in billing.dunning_event']
  billing_account_id varchar [note: 'Reference to the delinquent billing account against which this dunning action was taken. | Column billing_account_id (BIGINT) in billing.dunning_event']
  billing_dispute_id varchar [note: 'Foreign key linking to billing.billing_dispute. Business justification: Dunning event can trigger or relate to ONE billing dispute. Customers often raise disputes during dunning process. Need FK to billing_dispute for dispute lifecycle tracking. No redundant columns to re | Column billing_dispute_id (BIGINT) in billing.dunning_event']
  communication_template_id varchar [note: 'Identifier of the message template used for this dunning communication. | Column communication_template_id (BIGINT) in billing.dunning_event']
  employee_id varchar [note: 'Reference to the customer service agent who manually intervened or handled this dunning event, if applicable. | Column employee_id (BIGINT) in workforce.dunning_event']
  invoice_id varchar [note: 'Reference to the specific invoice that triggered this dunning action, if applicable. | Column invoice_id (BIGINT) in billing.dunning_event']
  payment_id varchar [note: 'Reference to the payment transaction record if a payment retry was successful. | Column payment_id (BIGINT) in billing.dunning_event']
  payment_method_id varchar [note: 'Reference to the payment method used for retry attempts, if applicable. | Column payment_method_id (BIGINT) in billing.dunning_event']
  refund_id varchar [note: 'Foreign key linking to billing.refund. Business justification: Dunning event can result in ONE refund (e.g., when dunning reveals an overpayment or billing error). Need FK to refund for dunning outcome tracking. No redundant columns to remove. | Column refund_id (BIGINT) in billing.dunning_event']
  subscriber_id varchar [note: 'Reference to the subscriber associated with the delinquent account. | Column subscriber_id (BIGINT) in subscriber.dunning_event']
  write_off_id varchar [note: 'Foreign key linking to billing.write_off. Business justification: Dunning event can result in ONE write-off decision (final step in dunning process when account is uncollectable). Need FK to write_off for dunning outcome tracking. No redundant columns to remove. | Column write_off_id (BIGINT) in billing.dunning_event']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.dunning_event']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.dunning_event']
  account_balance_at_action decimal(15,2) [note: 'Outstanding balance on the billing account at the time the dunning action was taken. | Column account_balance_at_action (DECIMAL(15,2)) in billing.dunning_event']
  account_termination_flag boolean [note: 'Indicates whether the billing account was terminated as a result of this dunning action. | Column account_termination_flag (BOOLEAN) in billing.dunning_event']
  account_termination_timestamp timestamp [note: 'Date and time when the billing account was terminated, if applicable. | Column account_termination_timestamp (TIMESTAMP) in billing.dunning_event']
  action_timestamp timestamp [note: 'Date and time when the dunning action was executed. | Column action_timestamp (TIMESTAMP) in billing.dunning_event']
  action_type varchar [note: 'Type of dunning action taken against the delinquent account. | Column action_type (STRING) in billing.dunning_event']
  amount_recovered decimal(15,2) [note: 'Amount successfully recovered as a result of this dunning action, if any. | Column amount_recovered (DECIMAL(15,2)) in billing.dunning_event']
  churn_risk_score decimal(5,2) [note: 'Calculated risk score indicating the likelihood of subscriber churn as a result of this dunning action (0-100 scale). | Column churn_risk_score (DECIMAL(5,2)) in billing.dunning_event']
  communication_channel varchar [note: 'Channel through which the dunning communication was delivered to the subscriber. | Column communication_channel (STRING) in billing.dunning_event']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.dunning_event']
  created_timestamp timestamp [note: 'Date and time when this dunning event record was first created in the system. | Column created_timestamp (TIMESTAMP) in billing.dunning_event']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this dunning event. | Column currency_code (STRING) in billing.dunning_event']
  days_past_due varchar [note: 'Number of days the account has been delinquent at the time of this dunning action. | Column days_past_due (INT) in billing.dunning_event']
  dunning_step_number varchar [note: 'Sequential step number in the dunning workflow (e.g., 1 for first reminder, 2 for second reminder, 3 for suspension warning, 4 for service suspension). | Column dunning_step_number (INT) in billing.dunning_event']
  next_dunning_step_scheduled_date date [note: 'Scheduled date for the next dunning action if this step did not resolve the delinquency. | Column next_dunning_step_scheduled_date (DATE) in billing.dunning_event']
  notes varchar [note: 'Free-text notes or comments recorded by agents or system regarding this dunning action. | Column notes (STRING) in billing.dunning_event']
  outcome varchar [note: 'Result or outcome of the dunning action taken. [ENUM-REF-CANDIDATE: payment_received|payment_failed|promise_to_pay|dispute_raised|no_response|account_suspended|account_terminated — 7 candidates stripped; promote to reference product] | Column outcome (STRING) in billing.dunning_event']
  recipient_address varchar [note: 'Email address, phone number, or postal address to which the dunning communication was sent. | Column recipient_address (STRING) in billing.dunning_event']
  response_received_flag boolean [note: 'Indicates whether the subscriber responded to this dunning action (e.g., made a payment, contacted support, updated payment method). | Column response_received_flag (BOOLEAN) in billing.dunning_event']
  response_timestamp timestamp [note: 'Date and time when the subscriber responded to the dunning action, if applicable. | Column response_timestamp (TIMESTAMP) in billing.dunning_event']
  retry_attempt_count varchar [note: 'Number of automated payment retry attempts made for this dunning event, if action type is payment retry. | Column retry_attempt_count (INT) in billing.dunning_event']
  service_suspension_flag boolean [note: 'Indicates whether subscriber services were suspended as a result of this dunning action. | Column service_suspension_flag (BOOLEAN) in billing.dunning_event']
  service_suspension_timestamp timestamp [note: 'Date and time when subscriber services were suspended, if applicable. | Column service_suspension_timestamp (TIMESTAMP) in billing.dunning_event']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.dunning_event']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.dunning_event']
  system_source varchar [note: 'Source system that generated or recorded this dunning event (e.g., Zuora, Wide Orbit, SAP S/4HANA). | Column system_source (STRING) in billing.dunning_event']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.dunning_event']
  updated_timestamp timestamp [note: 'Date and time when this dunning event record was last updated. | Column updated_timestamp (TIMESTAMP) in billing.dunning_event']

  Note: 'Record of a dunning action taken against a delinquent billing account — automated payment retry, reminder notice, suspension warning, or service suspension. Captures dunning step number, dunning action type (email reminder, SMS alert, payment retry, service suspension, account termination), action date, account balance at time of action, retry attempt count, communication channel, response received flag, and outcome. Supports subscriber churn prevention and revenue recovery workflows. | Unity Catalog table: media_broadcasting_ecm.billing.dunning_event'
}

Table billing.revenue_recognition_schedule {
  revenue_recognition_schedule_id varchar [pk, note: 'Unique identifier for the revenue recognition schedule entry. Primary key for ASC 606 revenue recognition tracking. | Column revenue_recognition_schedule_id (BIGINT) in billing.revenue_recognition_schedule']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Order-level revenue recognition schedules for ASC 606 compliance require direct ad_order link to track performance obligations, flight dates, and deferred revenue by advertising order. | Column ad_order_id (BIGINT) in sales.revenue_recognition_schedule']
  content_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Revenue recognition schedules for content licensing deals track which titles are amortized over contract periods for ASC 606 compliance, deferred revenue tracking, content asset valuation, and perform | Column content_title_id (BIGINT) in content.revenue_recognition_schedule']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Revenue schedules need cost center attribution for internal reporting and cost allocation. Enables media orgs to track deferred revenue and recognition timing by department or business unit for manage | Column cost_center_id (BIGINT) in finance.revenue_recognition_schedule']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Multi-year carriage fee agreements require revenue recognition schedules for upfront payments or minimum guarantees. Links recognition schedules to distribution agreements for carriage fee amortizatio | Column distribution_agreement_id (BIGINT) in partner.revenue_recognition_schedule']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: ASC 606 revenue recognition schedules track how invoice revenue is recognized over time across multiple accounting periods. Multi-period contracts generate invoices that have associated recognition sc | Column invoice_id (BIGINT) in billing.revenue_recognition_schedule']
  payment_id varchar [note: 'Foreign key linking to billing.payment. Business justification: Revenue recognition schedule can be triggered by ONE payment (payment timing affects ASC 606 revenue recognition). Need FK to payment for revenue recognition audit trail. No redundant columns to remov | Column payment_id (BIGINT) in billing.revenue_recognition_schedule']
  prepared_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Revenue recognition schedules (ASC 606 compliance) are prepared by revenue accounting staff. Tracking preparer employee (replacing text field approved_by) supports audit trail, compliance verification | Column prepared_by_employee_id (BIGINT) in workforce.revenue_recognition_schedule']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Revenue schedules must be attributed to profit centers for segment-level deferred revenue and revenue recognition reporting. Critical for media companies tracking deferred revenue by channel, platform | Column profit_center_id (BIGINT) in finance.revenue_recognition_schedule']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Revenue recognition schedules must classify by revenue stream for ASC 606 compliance and deferred revenue tracking by category. Essential for media companies with multi-year content licensing or subsc | Column revenue_stream_id (BIGINT) in finance.revenue_recognition_schedule']
  subscriber_id varchar [note: 'Reference to the customer or counterparty receiving the service or content (subscriber, advertiser, MVPD, syndication buyer). Links to the customer master data for reporting and analytics. | Column subscriber_id (BIGINT) in subscriber.revenue_recognition_schedule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.revenue_recognition_schedule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.revenue_recognition_schedule']
  adjustment_reason varchar [note: 'Business justification for any modification to the original recognition schedule (e.g., \'Contract amendment - extended term by 6 months\', \'Makegood issued for underdelivered GRPs\', \'Early termination - subscriber cancellation\', \'Price adjustment - volume discount applied\'). Required for audit trail and SOX compliance. | Column adjustment_reason (STRING) in billing.revenue_recognition_schedule']
  approval_status varchar [note: 'Workflow approval state for the revenue recognition schedule. Required for SOX compliance and segregation of duties. Pending Approval (awaiting finance review), Approved (authorized for recognition posting), Rejected (requires correction or additional documentation). | Column approval_status (STRING) in billing.revenue_recognition_schedule']
  approval_timestamp timestamp [note: 'Date and time when the revenue recognition schedule was approved for posting. Part of the SOX audit trail for revenue recognition controls. | Column approval_timestamp (TIMESTAMP) in billing.revenue_recognition_schedule']
  business_unit varchar [note: 'High-level business division or operating segment responsible for the revenue (e.g., Streaming Services, Linear Broadcasting, Content Licensing, Advertising Sales). Used for executive reporting and segment disclosure. | Column business_unit (STRING) in billing.revenue_recognition_schedule']
  contract_reference_number varchar [note: 'External business identifier for the contract (e.g., subscription number, license agreement number, upfront deal code). Used for reconciliation with Zuora, Rightsline, and Wide Orbit systems. | Column contract_reference_number (STRING) in billing.revenue_recognition_schedule']
  contract_type varchar [note: 'Classification of the revenue-generating contract. Determines recognition method and accounting treatment. Subscription (SVOD recurring), Syndication License (content resale), Upfront Ad Deal (advance advertising commitment), Carriage Agreement (MVPD distribution fee), Transactional VOD (TVOD pay-per-view), Sponsorship (branded content deal). | Column contract_type (STRING) in billing.revenue_recognition_schedule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.revenue_recognition_schedule']
  created_timestamp timestamp [note: 'Date and time when the revenue recognition schedule record was first created in the system. Part of the audit trail for data lineage and compliance. | Column created_timestamp (TIMESTAMP) in billing.revenue_recognition_schedule']
  cumulative_recognized_amount decimal(18,2) [note: 'Total revenue recognized to date from contract inception through the current reporting period. Increases each period as revenue is earned. Used for deferred revenue balance calculation and revenue assurance reconciliation. | Column cumulative_recognized_amount (DECIMAL(18,2)) in billing.revenue_recognition_schedule']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the contract value and recognized amounts (e.g., USD, GBP, EUR, CAD). Used for multi-currency revenue reporting and consolidation. | Column currency_code (STRING) in billing.revenue_recognition_schedule']
  current_period_recognized_amount decimal(18,2) [note: 'Revenue amount recognized in the current accounting period (month or quarter). Posted to the SAP revenue account. May differ from monthly recognized amount for usage-based or milestone-based contracts. | Column current_period_recognized_amount (DECIMAL(18,2)) in billing.revenue_recognition_schedule']
  deferred_revenue_balance decimal(18,2) [note: 'Remaining unearned revenue balance on the contract. Calculated as total contract value minus cumulative recognized amount. Represents the liability on the balance sheet under ASC 606. Decreases as revenue is recognized over time. | Column deferred_revenue_balance (DECIMAL(18,2)) in billing.revenue_recognition_schedule']
  last_recognition_date date [note: 'Date of the most recent revenue recognition posting. Used to track recognition progress and identify schedules requiring current-period processing. | Column last_recognition_date (DATE) in billing.revenue_recognition_schedule']
  modified_timestamp timestamp [note: 'Date and time when the revenue recognition schedule record was last updated. Tracks changes to recognition amounts, dates, or status for audit and reconciliation purposes. | Column modified_timestamp (TIMESTAMP) in billing.revenue_recognition_schedule']
  monthly_recognized_amount decimal(18,2) [note: 'Standard monthly revenue amount to be recognized under straight-line method. Calculated as total contract value divided by recognition period months. May vary for usage-based or milestone-based contracts. | Column monthly_recognized_amount (DECIMAL(18,2)) in billing.revenue_recognition_schedule']
  next_recognition_date date [note: 'Scheduled date for the next revenue recognition posting. Used by automated revenue recognition jobs to process monthly or quarterly recognition batches. | Column next_recognition_date (DATE) in billing.revenue_recognition_schedule']
  notes varchar [note: 'Free-text field for additional context, special instructions, or audit notes related to the revenue recognition schedule (e.g., \'Upfront deal with makegood provision\', \'Syndication license with holdback period\', \'Early termination - prorated final month\'). | Column notes (STRING) in billing.revenue_recognition_schedule']
  performance_obligation_description varchar [note: 'Narrative description of the performance obligation under ASC 606 (e.g., \'Provide streaming access to content library for 12 months\', \'Deliver 52 episodes of syndicated series\', \'Deliver 1000 GRPs in Q4 upfront commitment\'). Documents the basis for revenue recognition timing. | Column performance_obligation_description (STRING) in billing.revenue_recognition_schedule']
  recognition_end_date date [note: 'Date when revenue recognition is scheduled to complete. Corresponds to the contract expiration date or end of the performance obligation period. Null for evergreen contracts until termination notice. | Column recognition_end_date (DATE) in billing.revenue_recognition_schedule']
  recognition_method varchar [note: 'ASC 606 revenue recognition method applied to this contract. Straight-Line (equal monthly recognition for subscriptions), Milestone-Based (triggered by delivery events for syndication), Usage-Based (actual consumption for AVOD/TVOD), Proportional Performance (percentage-of-completion for production contracts), Point-in-Time (immediate recognition for transactional sales). | Column recognition_method (STRING) in billing.revenue_recognition_schedule']
  recognition_period_months varchar [note: 'Total number of months over which revenue will be recognized. Calculated from recognition start date to end date. Used for straight-line recognition calculations and forecasting. | Column recognition_period_months (INT) in billing.revenue_recognition_schedule']
  recognition_start_date date [note: 'Date when revenue recognition begins. Corresponds to the contract effective date or service commencement date under ASC 606. Marks the beginning of the performance obligation period. | Column recognition_start_date (DATE) in billing.revenue_recognition_schedule']
  recognition_status varchar [note: 'Current lifecycle state of the revenue recognition schedule. Scheduled (future start date), In Progress (actively recognizing), Completed (fully recognized), Suspended (temporarily paused), Terminated (contract cancelled early), Adjusted (modified due to contract amendment or makegood). | Column recognition_status (STRING) in billing.revenue_recognition_schedule']
  sap_deferred_revenue_account_code varchar [note: 'General Ledger (GL) liability account code in SAP S/4HANA where deferred revenue balance is maintained. Decreases as revenue is recognized and transferred to the revenue account. | Column sap_deferred_revenue_account_code (STRING) in billing.revenue_recognition_schedule']
  sap_revenue_account_code varchar [note: 'General Ledger (GL) account code in SAP S/4HANA where recognized revenue is posted. Maps to the appropriate revenue account based on contract type and business unit (e.g., subscription revenue, advertising revenue, licensing revenue). | Column sap_revenue_account_code (STRING) in billing.revenue_recognition_schedule']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.revenue_recognition_schedule']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.revenue_recognition_schedule']
  source_system_contract_reference varchar [note: 'Native contract identifier in the source system (e.g., Zuora subscription ID, Wide Orbit order number, Rightsline license agreement ID). Used for data lineage and reconciliation back to operational systems. | Column source_system_contract_reference (STRING) in billing.revenue_recognition_schedule']
  total_contract_value decimal(18,2) [note: 'Total monetary value of the contract to be recognized over the performance period. Represents the transaction price under ASC 606. Denominated in the contract currency. | Column total_contract_value (DECIMAL(18,2)) in billing.revenue_recognition_schedule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.revenue_recognition_schedule']

  Note: 'ASC 606 revenue recognition schedule defining how and when deferred revenue from multi-period contracts (subscriptions, syndication licenses, upfront ad deals) is recognized into earned revenue. Captures contract reference, total contract value, recognition start date, recognition end date, recognition method (straight-line, milestone, usage-based), monthly recognized amount, cumulative recognized amount, deferred balance, and SAP revenue account posting reference. Integrates with SAP S/4HANA revenue accounting module. | Unity Catalog table: media_broadcasting_ecm.billing.revenue_recognition_schedule'
}

Table billing.tax_record {
  tax_record_id varchar [pk, note: 'Unique identifier for the tax calculation and reporting record. Primary key for the tax_record product. | Column tax_record_id (BIGINT) in billing.tax_record']
  credit_memo_id varchar [note: 'Foreign key linking to billing.credit_memo. Business justification: Tax record can apply to ONE credit memo (tax on credits or tax reversals). Credit memos have tax implications that need to be tracked separately from invoice tax. Need FK to credit_memo for tax compli | Column credit_memo_id (BIGINT) in billing.tax_record']
  invoice_id varchar [note: 'Reference to the billing invoice transaction to which this tax record applies. Links tax calculation to the parent billing document. | Column invoice_id (BIGINT) in billing.tax_record']
  invoice_line_id varchar [note: 'Foreign key linking to billing.invoice_line. Business justification: Tax record can be calculated at invoice line level (line-level tax calculation). Tax_record has tax_line_number suggesting line-level detail. Need FK to invoice_line for granular tax tracking and comp | Column invoice_line_id (BIGINT) in billing.tax_record']
  payment_id varchar [note: 'Foreign key linking to billing.payment. Business justification: Tax record can be associated with ONE payment (tax withholding on payments, especially for international syndication payments). Need FK to payment for tax withholding tracking and compliance. No redun | Column payment_id (BIGINT) in billing.tax_record']
  prepared_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Tax records are prepared by tax accounting staff for compliance reporting and remittance. Tracking preparer employee supports audit trail, tax authority inquiries, and operational oversight in broadca | Column prepared_by_employee_id (BIGINT) in workforce.tax_record']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Tax records for international syndication (withholding tax, VAT) may require regulatory filing references for cross-border compliance (e.g., IRS Form 1042, EU VAT MOSS filings). Links tax and regulato | Column regulatory_filing_id (BIGINT) in compliance.tax_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.tax_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.tax_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.tax_record']
  created_timestamp timestamp [note: 'Timestamp when this tax record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in billing.tax_record']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the taxable and tax amounts (e.g., USD, GBP, EUR, JPY). | Column currency_code (STRING) in billing.tax_record']
  customer_tax_classification varchar [note: 'Tax classification of the customer for determining applicable tax treatment. Business (B2B), Individual (B2C), Government, Non-Profit, Exempt Organization. | Column customer_tax_classification (STRING) in billing.tax_record']
  customer_tax_number varchar [note: 'The customer\'s tax identification number (TIN, VAT number, GST number, EIN, etc.) used for tax reporting and validation. Format varies by jurisdiction. | Column customer_tax_number (STRING) in billing.tax_record']
  dispute_flag boolean [note: 'Indicates whether this tax record is under dispute with the tax authority or customer (True = disputed, False = not disputed). | Column dispute_flag (BOOLEAN) in billing.tax_record']
  dispute_reason varchar [note: 'Description of the reason for the tax dispute (e.g., Incorrect jurisdiction, Rate disagreement, Exemption certificate rejected, Nexus challenge). Populated when dispute_flag is True. | Column dispute_reason (STRING) in billing.tax_record']
  nexus_country varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code where tax nexus is established (e.g., USA, GBR, FRA, CAN). | Column nexus_country (STRING) in billing.tax_record']
  nexus_state_province varchar [note: 'State or province where the business has established tax nexus (physical or economic presence triggering tax obligation). Critical for US sales tax and Canadian GST/PST compliance. | Column nexus_state_province (STRING) in billing.tax_record']
  notes varchar [note: 'Free-text field for additional context, special circumstances, manual adjustments, or audit notes related to this tax calculation. | Column notes (STRING) in billing.tax_record']
  remittance_date date [note: 'Date when the tax amount was remitted (paid) to the tax authority. Null if remittance_status is pending or disputed. | Column remittance_date (DATE) in billing.tax_record']
  remittance_reference_number varchar [note: 'Payment reference or confirmation number from the tax authority acknowledging receipt of the tax remittance. Used for audit trail and reconciliation. | Column remittance_reference_number (STRING) in billing.tax_record']
  remittance_status varchar [note: 'Current status of tax payment to the tax authority. Pending (not yet paid), Remitted (paid in full), Partially Remitted (partial payment made), Disputed (under review or appeal), Waived (exempted or forgiven). | Column remittance_status (STRING) in billing.tax_record']
  reverse_charge_flag boolean [note: 'Indicates whether the reverse charge mechanism applies (True = customer is responsible for self-assessing and remitting VAT/GST, False = supplier charges and remits tax). Common in EU cross-border B2B transactions. | Column reverse_charge_flag (BOOLEAN) in billing.tax_record']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.tax_record']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.tax_record']
  source_system_tax_reference varchar [note: 'The unique identifier for this tax record in the source operational system. Enables traceability and reconciliation back to the originating system. | Column source_system_tax_reference (STRING) in billing.tax_record']
  tax_amount decimal(18,2) [note: 'Calculated tax amount for this jurisdiction and tax type (taxable_amount × tax_rate). Denominated in the invoice currency. | Column tax_amount (DECIMAL(18,2)) in billing.tax_record']
  tax_authority varchar [note: 'Name of the governmental tax authority responsible for collection and enforcement (e.g., IRS, HMRC, California Department of Tax and Fee Administration, Direction Générale des Finances Publiques). | Column tax_authority (STRING) in billing.tax_record']
  tax_calculation_method varchar [note: 'Method used to calculate the tax amount. Automated (system-calculated), Manual (finance team entry), Third-Party Service (Avalara, Vertex, TaxJar), Override (manual adjustment to automated calculation). | Column tax_calculation_method (STRING) in billing.tax_record']
  tax_category varchar [note: 'Business categorization of the taxable item or service (e.g., Subscription Services, Advertising Services, Content Licensing, Equipment Rental, Digital Downloads). Used for tax rate determination and reporting segmentation. | Column tax_category (STRING) in billing.tax_record']
  tax_exemption_certificate_number varchar [note: 'Reference number of the tax exemption certificate on file, if applicable. Required for audit trail when exemption is claimed. | Column tax_exemption_certificate_number (STRING) in billing.tax_record']
  tax_exemption_flag boolean [note: 'Indicates whether a tax exemption was applied to this transaction (True = exemption applied, False = no exemption). | Column tax_exemption_flag (BOOLEAN) in billing.tax_record']
  tax_exemption_reason varchar [note: 'Business reason or regulatory basis for the tax exemption (e.g., Non-profit organization, Government entity, Educational institution, Resale certificate, Export transaction). | Column tax_exemption_reason (STRING) in billing.tax_record']
  tax_filing_due_date date [note: 'The statutory due date for filing the tax return that includes this transaction, based on the tax jurisdiction and filing period. | Column tax_filing_due_date (DATE) in billing.tax_record']
  tax_filing_period varchar [note: 'The tax reporting period to which this transaction applies, formatted as YYYY-Q# for quarterly or YYYY-M## for monthly (e.g., 2024-Q1, 2024-M03). Aligns with jurisdiction-specific filing schedules. | Column tax_filing_period (STRING) in billing.tax_record']
  tax_jurisdiction_code varchar [note: 'Code identifying the tax jurisdiction (country, state, province, county, or municipality) where the tax obligation arises. Format: ISO country code optionally followed by subdivision code (e.g., US-CA, GB, FR-75). | Column tax_jurisdiction_code (STRING) in billing.tax_record']
  tax_jurisdiction_name varchar [note: 'Full name of the tax jurisdiction (e.g., California, United Kingdom, Paris) for human-readable reporting and compliance documentation. | Column tax_jurisdiction_name (STRING) in billing.tax_record']
  tax_line_number varchar [note: 'Sequential line number for this tax record within the parent invoice, supporting multiple tax jurisdictions or tax types per invoice. | Column tax_line_number (INT) in billing.tax_record']
  tax_point_date date [note: 'The date when the tax liability arises according to tax regulations (also known as time of supply). May differ from transaction_date based on jurisdiction-specific rules for services, advance payments, or continuous supplies. | Column tax_point_date (DATE) in billing.tax_record']
  tax_rate decimal(10,6) [note: 'Tax rate applied to the taxable amount, expressed as a decimal (e.g., 0.0825 for 8.25%). Supports precision to six decimal places for complex multi-jurisdictional calculations. | Column tax_rate (DECIMAL(10,6)) in billing.tax_record']
  tax_treatment_code varchar [note: 'Internal or regulatory code defining the specific tax treatment applied (e.g., standard rate, reduced rate, zero-rated, exempt, out-of-scope). Maps to jurisdiction-specific tax rules. | Column tax_treatment_code (STRING) in billing.tax_record']
  tax_type varchar [note: 'Type of tax applied to the transaction. Sales Tax (US state/local), VAT (Value-Added Tax, EU/international), GST (Goods and Services Tax), Withholding Tax (international syndication/licensing), Excise Tax (specific content types), Use Tax (cross-border digital services). | Column tax_type (STRING) in billing.tax_record']
  taxable_amount decimal(18,2) [note: 'The portion of the invoice amount subject to taxation in this jurisdiction, after applying exemptions and exclusions. Denominated in the invoice currency. | Column taxable_amount (DECIMAL(18,2)) in billing.tax_record']
  third_party_tax_service varchar [note: 'Name of the external tax calculation service provider if third-party method was used (e.g., Avalara AvaTax, Vertex Cloud, TaxJar, Thomson Reuters ONESOURCE). | Column third_party_tax_service (STRING) in billing.tax_record']
  transaction_date date [note: 'The date of the underlying billing transaction that triggered the tax calculation. Used to determine applicable tax rates and rules in effect at the time of transaction. | Column transaction_date (DATE) in billing.tax_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.tax_record']
  updated_timestamp timestamp [note: 'Timestamp when this tax record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for audit trail and change tracking. | Column updated_timestamp (TIMESTAMP) in billing.tax_record']

  Note: 'Tax calculation and reporting record associated with a billing transaction — capturing applicable tax jurisdiction, tax type (VAT, GST, sales tax, withholding tax), tax rate applied, taxable amount, tax amount, tax exemption certificate reference, nexus state/country, tax authority, filing period, and remittance status. Supports multi-jurisdiction tax compliance for subscriber billing (CCPA, GDPR jurisdictions) and international syndication license fee withholding. | Unity Catalog table: media_broadcasting_ecm.billing.tax_record'
}

Table billing.payment_allocation {
  payment_allocation_id varchar [pk, note: 'Unique identifier for the payment allocation record. Primary key. | Column payment_allocation_id (BIGINT) in billing.payment_allocation']
  credit_memo_id varchar [note: 'Foreign key linking to billing.credit_memo. Business justification: Payment allocation can apply to ONE credit memo (not just invoices). Payments can be allocated to credit memos to settle negative balances. Need FK to credit_memo for complete payment allocation track | Column credit_memo_id (BIGINT) in billing.payment_allocation']
  invoice_id varchar [note: 'Reference to the invoice receiving the payment allocation. Links to the invoice record that is being settled or partially paid by this allocation. | Column invoice_id (BIGINT) in billing.payment_allocation']
  payment_id varchar [note: 'Reference to the payment transaction being allocated. Links to the payment record that is being distributed across one or more invoices. | Column payment_id (BIGINT) in billing.payment_allocation']
  primary_payment_employee_id varchar [note: 'System user identifier of the person or automated process that created this allocation. Used for audit trails, accountability, and troubleshooting allocation errors. May be system account for automated allocations. | Column primary_payment_employee_id (BIGINT) in workforce.payment_allocation']
  refund_id varchar [note: 'Foreign key linking to billing.refund. Business justification: Payment allocation can be reversed by ONE refund. When a refund is issued, the original payment allocation needs to be tracked for audit trail. Need FK to refund for allocation reversal tracking. No r | Column refund_id (BIGINT) in billing.payment_allocation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.payment_allocation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.payment_allocation']
  accounting_period varchar [note: 'The financial accounting period (YYYY-MM format) to which this allocation is posted. Determines which month/quarter/year the revenue and cash receipt are recognized. Used for period close, financial reporting, and revenue assurance. | Column accounting_period (STRING) in billing.payment_allocation']
  adjustment_amount decimal(18,2) [note: 'Additional adjustment applied during allocation, such as currency conversion differences, rounding adjustments, or billing corrections. Can be positive or negative. Used for reconciliation and variance analysis. | Column adjustment_amount (DECIMAL(18,2)) in billing.payment_allocation']
  allocated_amount decimal(18,2) [note: 'The monetary amount from the payment that is allocated to this specific invoice. For partial payments, this represents the portion applied to this invoice. For full settlements, this equals the invoice outstanding balance. Critical for accounts receivable aging and revenue assurance calculations. | Column allocated_amount (DECIMAL(18,2)) in billing.payment_allocation']
  allocation_date date [note: 'The business date when the payment allocation was executed and applied to the invoice. This date determines the accounting period for revenue recognition and accounts receivable aging. Critical for financial reporting and compliance with ASC 606. | Column allocation_date (DATE) in billing.payment_allocation']
  allocation_method varchar [note: 'The business rule or algorithm used to determine this allocation. Manual indicates user-specified allocation; Automatic indicates system-applied based on aging rules; Prorated indicates proportional distribution across multiple invoices; FIFO (First In First Out) indicates oldest invoice paid first; LIFO (Last In First Out) indicates newest invoice paid first; Specific indicates customer-directed allocation to particular invoice. | Column allocation_method (STRING) in billing.payment_allocation']
  allocation_number varchar [note: 'Human-readable business identifier for the payment allocation record. Format: PA-YYYYMMDD-NNNN where YYYYMMDD is allocation date and NNNN is sequence number. | Column allocation_number (STRING) in billing.payment_allocation']
  allocation_sequence varchar [note: 'Sequential order number for this allocation within the parent payment transaction. When a single payment is split across multiple invoices, this field indicates the application order. Used for FIFO/LIFO allocation logic and audit trails. | Column allocation_sequence (INT) in billing.payment_allocation']
  allocation_status varchar [note: 'Current lifecycle status of the payment allocation. Pending indicates allocation is awaiting confirmation; Applied indicates allocation has been posted to accounts receivable; Reversed indicates allocation has been undone; Voided indicates allocation was cancelled before application; Disputed indicates allocation is under review; Reconciled indicates allocation has been verified and closed. | Column allocation_status (STRING) in billing.payment_allocation']
  allocation_timestamp timestamp [note: 'Precise date and time when the payment allocation was processed in the billing system. Used for audit trails and transaction sequencing. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column allocation_timestamp (TIMESTAMP) in billing.payment_allocation']
  allocation_type varchar [note: 'Classification of the payment allocation method. Full Settlement indicates payment completely satisfies invoice balance; Partial Payment indicates payment covers portion of invoice; Advance Deposit indicates payment received before invoice generation; Unapplied Credit indicates payment not yet matched to specific invoice; Overpayment indicates payment exceeds invoice amount; Prepayment indicates payment for future services. | Column allocation_type (STRING) in billing.payment_allocation']
  approval_timestamp timestamp [note: 'Date and time when this allocation was approved by authorized personnel. Null if no approval required or pending approval. Used for audit trails and compliance with financial controls. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column approval_timestamp (TIMESTAMP) in billing.payment_allocation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.payment_allocation']
  created_timestamp timestamp [note: 'System timestamp when this payment allocation record was first created in the database. Used for data lineage, audit trails, and troubleshooting. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Immutable after initial insert. | Column created_timestamp (TIMESTAMP) in billing.payment_allocation']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the allocated amount. Must match the currency of both the payment and invoice for proper reconciliation. | Column currency_code (STRING) in billing.payment_allocation']
  discount_amount decimal(18,2) [note: 'Early payment discount or settlement discount applied at the time of this allocation. Reduces the allocated amount required to satisfy the invoice balance. Common in advertising billing for prompt payment incentives. | Column discount_amount (DECIMAL(18,2)) in billing.payment_allocation']
  dispute_flag boolean [note: 'Indicates whether this allocation is currently under dispute by the customer or internal review. True if disputed; False if not disputed. Disputed allocations may be reversed or adjusted pending resolution. | Column dispute_flag (BOOLEAN) in billing.payment_allocation']
  dispute_reason varchar [note: 'Business explanation for why this allocation is disputed. Examples include incorrect invoice matching, payment amount mismatch, duplicate allocation, unauthorized payment application, or customer contest of charges. Required when dispute_flag is True. | Column dispute_reason (STRING) in billing.payment_allocation']
  effective_date date [note: 'The date from which this allocation is considered effective for revenue recognition purposes. May differ from allocation_date for backdated or future-dated allocations. Used in revenue assurance and financial period close processes. | Column effective_date (DATE) in billing.payment_allocation']
  gl_document_number varchar [note: 'The SAP S/4HANA general ledger document number generated when this allocation was posted to the financial system. Used for cross-system reconciliation and audit trails between billing and finance. | Column gl_document_number (STRING) in billing.payment_allocation']
  gl_posting_date date [note: 'The date when this allocation was posted to the general ledger in SAP S/4HANA. Used for financial reconciliation between billing system and ERP. May differ from allocation_date due to batch processing or period close timing. | Column gl_posting_date (DATE) in billing.payment_allocation']
  invoice_reference_number varchar [note: 'Business identifier of the invoice receiving this allocation. Denormalized from invoice table for quick reference and reporting without joins. Typically matches invoice_number from the invoice product. | Column invoice_reference_number (STRING) in billing.payment_allocation']
  notes varchar [note: 'Free-form text field for additional context, special instructions, or explanatory comments about this allocation. Used for documenting unusual allocation scenarios, customer requests, or manual intervention reasons. | Column notes (STRING) in billing.payment_allocation']
  payment_reference_number varchar [note: 'External reference number from the payment transaction, such as check number, wire transfer confirmation, credit card authorization code, or ACH trace number. Used for payment reconciliation and dispute resolution. | Column payment_reference_number (STRING) in billing.payment_allocation']
  reconciliation_date date [note: 'The date when this allocation was successfully reconciled between billing and financial systems. Null if reconciliation is pending or variance exists. Used for revenue assurance reporting and SOX compliance. | Column reconciliation_date (DATE) in billing.payment_allocation']
  reconciliation_status varchar [note: 'Indicates whether this allocation has been reconciled between billing system and general ledger. Unreconciled indicates pending reconciliation; Reconciled indicates amounts match across systems; Variance indicates discrepancy requiring investigation; Under Review indicates active reconciliation in progress. | Column reconciliation_status (STRING) in billing.payment_allocation']
  revenue_recognition_date date [note: 'The accounting date when revenue from this allocation is recognized in financial statements. May differ from allocation_date based on revenue recognition rules for subscription services, advance payments, or deferred revenue scenarios. Critical for ASC 606 compliance. | Column revenue_recognition_date (DATE) in billing.payment_allocation']
  reversal_date date [note: 'The date when this allocation was reversed or voided. Null if allocation is still active. Used for audit trails and accounts receivable reconciliation when allocations are corrected or disputed. | Column reversal_date (DATE) in billing.payment_allocation']
  reversal_reason varchar [note: 'Business explanation for why the allocation was reversed or voided. Examples include payment dispute, incorrect invoice matching, duplicate allocation, customer refund request, or billing error correction. Required when allocation_status is reversed or voided. | Column reversal_reason (STRING) in billing.payment_allocation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.payment_allocation']
  source_system_allocation_reference varchar [note: 'The unique identifier for this allocation in the source system (Zuora, Wide Orbit, or SAP). Used for cross-system reconciliation, data lineage tracking, and troubleshooting integration issues. | Column source_system_allocation_reference (STRING) in billing.payment_allocation']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.payment_allocation']
  unapplied_balance decimal(18,2) [note: 'Remaining payment amount not allocated to any invoice after this allocation. Represents credit balance available for future invoice matching. Critical for cash application and accounts receivable management. | Column unapplied_balance (DECIMAL(18,2)) in billing.payment_allocation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.payment_allocation']
  updated_timestamp timestamp [note: 'System timestamp when this payment allocation record was last modified. Updated automatically on every change to track data currency and support incremental processing. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column updated_timestamp (TIMESTAMP) in billing.payment_allocation']
  writeoff_amount decimal(18,2) [note: 'Portion of the invoice balance written off as uncollectible at the time of this allocation. Used when accepting partial payment as final settlement. Impacts bad debt reserves and revenue recognition adjustments. | Column writeoff_amount (DECIMAL(18,2)) in billing.payment_allocation']

  Note: 'Association record linking a payment to one or more invoices it partially or fully settles, enabling many-to-many payment-to-invoice matching. Captures payment reference, invoice reference, allocated amount, allocation date, allocation type (full settlement, partial payment, advance deposit, unapplied credit), and allocation status. Critical for revenue assurance and accounts receivable aging accuracy when a single payment covers multiple invoices or a payment is split across periods. | Unity Catalog table: media_broadcasting_ecm.billing.payment_allocation'
}

Table billing.run {
  run_id varchar [pk, note: 'Primary key for run | Column run_id (BIGINT) in billing.run']
  billing_cycle_id varchar [note: 'Reference to the billing cycle for which this run was executed. Links to the billing cycle configuration that defines the schedule and account population. | Column billing_cycle_id (BIGINT) in billing.run']
  communication_template_id varchar [note: 'Foreign key linking to billing.communication_template. Business justification: Billing run uses ONE communication template for invoice delivery (batch invoice distribution). Need FK to track which template was used for this run for audit purposes. No redundant columns to remove. | Column communication_template_id (BIGINT) in billing.run']
  primary_run_approved_by_user_employee_id varchar [note: 'Identifier of the user who approved this billing run for distribution. Null if approval not required or run not yet approved. | Column run_approved_by_user_employee_id (BIGINT) in workforce.run']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.run']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.run']
  accounts_with_errors varchar [note: 'Count of customer accounts that failed to process successfully during this billing run. Used to identify accounts requiring manual intervention. | Column accounts_with_errors (INT) in billing.run']
  actual_start_timestamp timestamp [note: 'Actual date and time when the billing run execution began. Used to measure processing delays and operational performance. | Column actual_start_timestamp (TIMESTAMP) in billing.run']
  approval_required_flag boolean [note: 'Indicates whether this billing run requires management approval before invoice distribution. True for high-value runs, correction runs, or runs with significant adjustments. | Column approval_required_flag (BOOLEAN) in billing.run']
  approval_timestamp timestamp [note: 'Date and time when the billing run was approved for invoice distribution. Null if approval not required or run not yet approved. | Column approval_timestamp (TIMESTAMP) in billing.run']
  billing_date date [note: 'The effective billing date applied to all invoices generated in this run. Determines invoice date, due date calculation, and revenue recognition period. | Column billing_date (DATE) in billing.run']
  billing_period_end_date date [note: 'End date of the service period covered by invoices in this billing run. Defines the cutoff for usage charges and subscription calculations. | Column billing_period_end_date (DATE) in billing.run']
  billing_period_start_date date [note: 'Start date of the service period covered by invoices in this billing run. Used for subscription proration and usage aggregation. | Column billing_period_start_date (DATE) in billing.run']
  completion_timestamp timestamp [note: 'Date and time when the billing run finished execution, whether successfully or with errors. Null for runs still in progress or suspended. | Column completion_timestamp (TIMESTAMP) in billing.run']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.run']
  created_timestamp timestamp [note: 'Date and time when this billing run record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in billing.run']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all amounts in this billing run (e.g., USD, GBP, EUR). Ensures consistent currency handling across invoices. | Column currency_code (STRING) in billing.run']
  distribution_completion_timestamp timestamp [note: 'Date and time when invoice distribution to customers completed. Null for runs still distributing or not yet started. | Column distribution_completion_timestamp (TIMESTAMP) in billing.run']
  distribution_start_timestamp timestamp [note: 'Date and time when invoice distribution to customers began. Used to track delivery SLA and customer communication timing. | Column distribution_start_timestamp (TIMESTAMP) in billing.run']
  error_count varchar [note: 'Total number of errors encountered during billing run execution. Includes account processing failures, invoice generation errors, and system exceptions. | Column error_count (INT) in billing.run']
  failure_reason varchar [note: 'Detailed description of the error or issue that caused the billing run to fail. Null for successful runs. Used for root cause analysis and troubleshooting. | Column failure_reason (STRING) in billing.run']
  invoice_distribution_status varchar [note: 'Status of invoice delivery to customers. Pending runs await distribution; in-progress runs are actively sending; completed runs finished delivery; failed runs encountered distribution errors; cancelled runs were stopped. | Column invoice_distribution_status (STRING) in billing.run']
  notes varchar [note: 'Free-text operational notes about this billing run. May include special instructions, manual adjustments applied, or explanations for off-cycle execution. | Column notes (STRING) in billing.run']
  processing_duration_seconds varchar [note: 'Total elapsed time in seconds from actual start to completion of the billing run. Used for performance monitoring and capacity planning. | Column processing_duration_seconds (INT) in billing.run']
  retry_count varchar [note: 'Number of times this billing run has been retried after failure. Used to identify chronic processing issues and trigger escalation. | Column retry_count (INT) in billing.run']
  revenue_category varchar [note: 'Primary revenue classification for this billing run. Subscription runs bill SVOD/linear subscribers; advertising runs bill CPM/GRP campaigns; carriage runs bill MVPD distribution fees; syndication runs bill content licensing; transactional runs bill TVOD purchases. | Column revenue_category (STRING) in billing.run']
  run_number varchar [note: 'Business-friendly identifier for the billing run, typically formatted as cycle-sequence (e.g., 2024-01-R001). Used for operational tracking and reporting. | Column run_number (STRING) in billing.run']
  run_status varchar [note: 'Current lifecycle state of the billing run. Scheduled runs are queued; in-progress runs are actively generating invoices; completed runs finished successfully; failed runs encountered errors; cancelled runs were aborted; suspended runs are paused pending resolution. | Column run_status (STRING) in billing.run']
  run_type varchar [note: 'Classification of the billing run execution. Regular runs follow standard cycle schedules; off-cycle runs address mid-period changes; final runs close out terminated accounts; correction runs fix prior errors; makegood runs issue compensatory credits; adjustment runs apply manual corrections. | Column run_type (STRING) in billing.run']
  sap_posting_batch_reference varchar [note: 'SAP S/4HANA batch identifier for financial posting of billing run results. Links billing transactions to general ledger entries. | Column sap_posting_batch_reference (STRING) in billing.run']
  scheduled_start_timestamp timestamp [note: 'Planned date and time when the billing run was scheduled to begin execution. Used for operational planning and SLA tracking. | Column scheduled_start_timestamp (TIMESTAMP) in billing.run']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.run']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.run']
  total_accounts_processed varchar [note: 'Total count of customer accounts included in this billing run execution. Used for operational monitoring and reconciliation. | Column total_accounts_processed (INT) in billing.run']
  total_amount_billed decimal(18,2) [note: 'Sum of all invoice totals generated in this billing run, representing gross revenue before payments. Used for revenue assurance and financial reconciliation. | Column total_amount_billed (DECIMAL(18,2)) in billing.run']
  total_invoice_lines_generated varchar [note: 'Total count of invoice line items created across all invoices in this billing run. Used for detailed processing metrics and performance analysis. | Column total_invoice_lines_generated (INT) in billing.run']
  total_invoices_generated varchar [note: 'Total count of invoices successfully generated during this billing run. May differ from accounts processed if some accounts had zero charges or errors. | Column total_invoices_generated (INT) in billing.run']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.run']
  updated_timestamp timestamp [note: 'Date and time when this billing run record was last modified. Used for audit trail and change tracking. | Column updated_timestamp (TIMESTAMP) in billing.run']
  warning_count varchar [note: 'Total number of warnings generated during billing run execution. Warnings indicate potential issues that did not prevent invoice generation but require review. | Column warning_count (INT) in billing.run']
  wide_orbit_batch_reference varchar [note: 'External identifier from Wide Orbit traffic and billing system for advertising billing runs. Used for ad sales invoice reconciliation. | Column wide_orbit_batch_reference (STRING) in billing.run']
  zuora_billing_run_reference varchar [note: 'External identifier from Zuora subscription billing system for this billing run. Used for cross-system reconciliation and audit trail. | Column zuora_billing_run_reference (STRING) in billing.run']

  Note: 'Operational record of a scheduled billing cycle execution — the batch process that generates invoices for all accounts in a billing cycle. Captures billing run date, billing cycle reference, run type (regular, off-cycle, final), total accounts processed, total invoices generated, total amount billed, run status (scheduled, in-progress, completed, failed), error count, and Zuora billing run ID. Enables billing operations monitoring and revenue assurance reconciliation. | Unity Catalog table: media_broadcasting_ecm.billing.run'
}

Table billing.write_off {
  write_off_id varchar [pk, note: 'Unique identifier for the bad debt write-off record. Primary key. | Column write_off_id (BIGINT) in billing.write_off']
  approved_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Write-offs require management approval per financial policy. Tracking approver employee (replacing text field approving_authority) is mandatory financial control for bad debt management and supports a | Column approved_by_employee_id (BIGINT) in workforce.write_off']
  billing_account_id varchar [note: 'Reference to the billing account under which the invoice was issued. | Column billing_account_id (BIGINT) in billing.write_off']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Write-offs must be attributed to cost centers for bad debt expense allocation and departmental impact tracking. Enables media orgs to track uncollectible revenue by department or business unit for acc | Column cost_center_id (BIGINT) in finance.write_off']
  credit_memo_id varchar [note: 'Foreign key linking to billing.credit_memo. Business justification: Write-off can be accompanied by ONE credit memo (formal credit document for the written-off amount). Write-offs often generate credit memos for accounting purposes. Need FK to credit_memo for write-of | Column credit_memo_id (BIGINT) in billing.write_off']
  invoice_id varchar [note: 'Reference to the invoice that contains the uncollectable balance being written off. | Column invoice_id (BIGINT) in billing.write_off']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Write-offs attributed to profit centers for segment-level bad debt expense and EBITDA impact. Critical for media broadcasters tracking uncollectible revenue by channel or platform for accurate segment | Column profit_center_id (BIGINT) in finance.write_off']
  subscriber_id varchar [note: 'Reference to the customer or advertiser associated with the uncollectable invoice. | Column subscriber_id (BIGINT) in subscriber.write_off']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.write_off']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.write_off']
  aging_bucket_at_write_off varchar [note: 'Accounts receivable aging category of the invoice at the time of write-off (e.g., current, 30 days, 60 days, 90 days, 120+ days). | Column aging_bucket_at_write_off (STRING) in billing.write_off']
  amount decimal(18,2) [note: 'The monetary value of the uncollectable balance being written off as bad debt. | Column amount (DECIMAL(18,2)) in billing.write_off']
  approval_date date [note: 'The date on which the write-off was formally approved by the authorized authority. | Column approval_date (DATE) in billing.write_off']
  collection_agency_name varchar [note: 'Name of the external collection agency to which the debt was referred, if applicable. | Column collection_agency_name (STRING) in billing.write_off']
  collection_agency_referral_flag boolean [note: 'Indicates whether the uncollectable debt was referred to an external collection agency before or after the write-off decision (True/False). | Column collection_agency_referral_flag (BOOLEAN) in billing.write_off']
  collection_referral_date date [note: 'The date on which the debt was referred to the external collection agency. | Column collection_referral_date (DATE) in billing.write_off']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.write_off']
  created_timestamp timestamp [note: 'The date and time when this write-off record was first created in the system. | Column created_timestamp (TIMESTAMP) in billing.write_off']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the write-off amount (e.g., USD, GBP, EUR). | Column currency_code (STRING) in billing.write_off']
  days_outstanding_at_write_off varchar [note: 'Number of days the invoice was outstanding (from invoice date to write-off date) at the time the write-off decision was made. | Column days_outstanding_at_write_off (INT) in billing.write_off']
  ebitda_impact_flag boolean [note: 'Indicates whether this write-off has a material impact on EBITDA reporting for the period (True/False). | Column ebitda_impact_flag (BOOLEAN) in billing.write_off']
  fiscal_period varchar [note: 'The fiscal period (e.g., 2024-Q1, 2024-01) in which the write-off was recorded for financial reporting purposes. | Column fiscal_period (STRING) in billing.write_off']
  fiscal_year varchar [note: 'The fiscal year in which the write-off was recorded. | Column fiscal_year (INT) in billing.write_off']
  gl_account_code varchar [note: 'SAP S/4HANA general ledger account code to which the bad debt expense is posted (typically a bad debt expense account). | Column gl_account_code (STRING) in billing.write_off']
  notes varchar [note: 'Additional free-text notes or comments related to the write-off decision, approval process, or special circumstances. | Column notes (STRING) in billing.write_off']
  original_invoice_amount decimal(18,2) [note: 'The total amount originally invoiced before any payments, adjustments, or write-offs were applied. | Column original_invoice_amount (DECIMAL(18,2)) in billing.write_off']
  outstanding_balance_at_write_off decimal(18,2) [note: 'The remaining unpaid balance on the invoice at the time the write-off decision was made. | Column outstanding_balance_at_write_off (DECIMAL(18,2)) in billing.write_off']
  reason_code varchar [note: 'Standardized code indicating the business reason for the write-off decision (e.g., subscriber churn, advertiser insolvency, dispute settled at zero, statute of limitations, bankruptcy, fraud, uncollectable). [ENUM-REF-CANDIDATE: subscriber_churn|advertiser_insolvency|dispute_settled_zero|statute_limitations|bankruptcy|fraud|uncollectable — 7 candidates stripped; promote to reference product] | Column reason_code (STRING) in billing.write_off']
  reason_description varchar [note: 'Detailed narrative explanation of the circumstances and business justification for the write-off decision. | Column reason_description (STRING) in billing.write_off']
  recovery_amount decimal(18,2) [note: 'The monetary amount subsequently recovered from the customer after the write-off was recorded, if any partial or full recovery occurred. | Column recovery_amount (DECIMAL(18,2)) in billing.write_off']
  recovery_date date [note: 'The date on which a recovery payment was received after the write-off, if applicable. | Column recovery_date (DATE) in billing.write_off']
  recovery_gl_account_code varchar [note: 'SAP S/4HANA general ledger account code to which any recovered amount is posted (typically a bad debt recovery income account). | Column recovery_gl_account_code (STRING) in billing.write_off']
  revenue_category varchar [note: 'Classification of the revenue stream associated with the written-off invoice (e.g., subscription, advertising, carriage fee, syndication, licensing). | Column revenue_category (STRING) in billing.write_off']
  reversal_date date [note: 'The date on which the write-off was reversed, if applicable. | Column reversal_date (DATE) in billing.write_off']
  reversal_flag boolean [note: 'Indicates whether this write-off has been reversed due to subsequent payment or correction (True/False). | Column reversal_flag (BOOLEAN) in billing.write_off']
  reversal_reason varchar [note: 'Explanation of why the write-off was reversed (e.g., customer payment received, accounting error correction). | Column reversal_reason (STRING) in billing.write_off']
  sap_document_number varchar [note: 'SAP S/4HANA financial document number generated when the write-off was posted to the general ledger. | Column sap_document_number (STRING) in billing.write_off']
  sap_posting_date date [note: 'The date on which the write-off transaction was posted in SAP S/4HANA for financial reporting purposes. | Column sap_posting_date (DATE) in billing.write_off']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.write_off']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.write_off']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.write_off']
  updated_timestamp timestamp [note: 'The date and time when this write-off record was last modified. | Column updated_timestamp (TIMESTAMP) in billing.write_off']
  write_off_date date [note: 'The date on which the bad debt write-off decision was executed and recorded in the financial system. | Column write_off_date (DATE) in billing.write_off']
  write_off_number varchar [note: 'Business-facing unique identifier for the write-off transaction, used for tracking and audit purposes. | Column write_off_number (STRING) in billing.write_off']

  Note: 'Record of a bad debt write-off decision for an uncollectable invoice balance — capturing write-off amount, write-off date, reason code (subscriber churn, advertiser insolvency, dispute settled at zero, statute of limitations), approving authority, SAP bad debt expense account posting, collection agency referral flag, and recovery amount if subsequently collected. Supports revenue assurance, EBITDA reporting, and accounts receivable aging management. | Unity Catalog table: media_broadcasting_ecm.billing.write_off'
}

Table billing.ad_billing_reconciliation {
  ad_billing_reconciliation_id varchar [pk, note: 'Unique identifier for the advertising billing reconciliation record. Primary key for this entity. | Column ad_billing_reconciliation_id (BIGINT) in billing.ad_billing_reconciliation']
  ad_billing_order_id varchar [note: 'Reference to the advertising billing order that this reconciliation record is associated with. | Column ad_billing_order_id (BIGINT) in billing.ad_billing_reconciliation']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Reconciliation process requires direct link to ad_order to verify contracted vs. delivered spots, calculate underdelivery, and determine makegood obligations. Essential for advertising billing accurac | Column ad_order_id (BIGINT) in sales.ad_billing_reconciliation']
  advertiser_id varchar [note: 'Reference to the advertiser party for whom the advertising spots were delivered and billed. | Column advertiser_id (BIGINT) in sales.ad_billing_reconciliation']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Spot delivery verification requires facility records for signal coverage confirmation, geographic delivery validation, affidavit generation, and proof-of-performance documentation in advertising billi | Column broadcast_facility_id (BIGINT) in technology.ad_billing_reconciliation']
  campaign_id varchar [note: 'Reference to the advertising campaign associated with this reconciliation record. | Column campaign_id (BIGINT) in sales.ad_billing_reconciliation']
  content_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Reconciliation processes verify contracted spots aired during specific programming. Teams link discrepancies and makegoods to content that carried ads for affidavit validation, dispute resolution, and | Column content_title_id (BIGINT) in content.ad_billing_reconciliation']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Reconciliations attributed to sales or finance cost centers for process ownership tracking and variance analysis. Enables media orgs to track advertising billing accuracy and makegood costs by respons | Column cost_center_id (BIGINT) in finance.ad_billing_reconciliation']
  employee_id varchar [note: 'Identifier of the billing operations user who performed and approved the reconciliation process. | Column employee_id (BIGINT) in workforce.ad_billing_reconciliation']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Ad billing reconciliation results in ONE final invoice (after reconciling ordered vs. aired spots and makegoods). Need FK to the invoice generated after reconciliation. No redundant columns to remove. | Column invoice_id (BIGINT) in billing.ad_billing_reconciliation']
  nielsen_rating_id varchar [note: 'Foreign key linking to audience.nielsen_rating. Business justification: Reconciliation process compares contracted audience guarantees against actual Nielsen ratings delivered to calculate under-delivery, determine makegood spots, and adjust billing. Direct operational de | Column nielsen_rating_id (BIGINT) in audience.ad_billing_reconciliation']
  original_ad_billing_reconciliation_id varchar [note: 'Self-referencing FK on ad_billing_reconciliation (original_ad_billing_reconciliation_id) | Column original_ad_billing_reconciliation_id (BIGINT) in billing.ad_billing_reconciliation']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Reconciliations attributed to profit centers for segment-level revenue assurance and makegood tracking. Critical for media broadcasters tracking advertising delivery accuracy and revenue adjustments b | Column profit_center_id (BIGINT) in finance.ad_billing_reconciliation']
  sales_agency_id varchar [note: 'Reference to the advertising agency that placed the order on behalf of the advertiser, if applicable. | Column sales_agency_id (BIGINT) in sales.ad_billing_reconciliation']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Reconciliation of ordered vs. aired spots requires equipment logs for discrepancy investigation, makegood determination, equipment failure tracking, and advertiser dispute resolution in broadcast adve | Column transmission_equipment_id (BIGINT) in technology.ad_billing_reconciliation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.ad_billing_reconciliation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.ad_billing_reconciliation']
  adjustment_amount decimal(18,2) [note: 'The net adjustment amount applied to the billing due to makegoods, credits, or other reconciliation adjustments. | Column adjustment_amount (DECIMAL(18,2)) in billing.ad_billing_reconciliation']
  affidavit_count varchar [note: 'The total number of proof-of-broadcast affidavits associated with this reconciliation record, documenting actual spot delivery. | Column affidavit_count (INT) in billing.ad_billing_reconciliation']
  affidavit_verification_status varchar [note: 'The status of affidavit verification indicating whether proof-of-broadcast documentation has been validated and accepted. | Column affidavit_verification_status (STRING) in billing.ad_billing_reconciliation']
  contracted_amount decimal(18,2) [note: 'The total monetary value of the advertising order as originally contracted, before any adjustments or makegoods. | Column contracted_amount (DECIMAL(18,2)) in billing.ad_billing_reconciliation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.ad_billing_reconciliation']
  created_timestamp timestamp [note: 'Timestamp when this reconciliation record was first created in the billing system. | Column created_timestamp (TIMESTAMP) in billing.ad_billing_reconciliation']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this reconciliation record. | Column currency_code (STRING) in billing.ad_billing_reconciliation']
  delivered_amount decimal(18,2) [note: 'The monetary value of advertising spots that were successfully delivered and verified through affidavits. | Column delivered_amount (DECIMAL(18,2)) in billing.ad_billing_reconciliation']
  dispute_date date [note: 'The date when the dispute was formally raised by the advertiser or agency regarding this reconciliation. | Column dispute_date (DATE) in billing.ad_billing_reconciliation']
  dispute_flag boolean [note: 'Boolean indicator of whether this reconciliation record is currently under dispute by the advertiser or agency. | Column dispute_flag (BOOLEAN) in billing.ad_billing_reconciliation']
  dispute_reason varchar [note: 'Detailed explanation of the reason for dispute if the reconciliation is contested by the advertiser or agency. | Column dispute_reason (STRING) in billing.ad_billing_reconciliation']
  flight_end_date date [note: 'The end date of the advertising campaign flight period during which spots were scheduled to air. | Column flight_end_date (DATE) in billing.ad_billing_reconciliation']
  flight_start_date date [note: 'The start date of the advertising campaign flight period during which spots were scheduled to air. | Column flight_start_date (DATE) in billing.ad_billing_reconciliation']
  makegood_spots_quantity varchar [note: 'The number of compensatory advertising spots provided to the advertiser to remedy missed or underdelivered spots. | Column makegood_spots_quantity (INT) in billing.ad_billing_reconciliation']
  makegood_value_amount decimal(18,2) [note: 'The monetary value of the makegood spots provided as compensation, calculated at the original contracted rate. | Column makegood_value_amount (DECIMAL(18,2)) in billing.ad_billing_reconciliation']
  net_billable_amount decimal(18,2) [note: 'The final net amount billable to the advertiser after all reconciliation adjustments, makegoods, and credits have been applied. | Column net_billable_amount (DECIMAL(18,2)) in billing.ad_billing_reconciliation']
  notes varchar [note: 'Free-text notes and comments regarding the reconciliation process, special circumstances, or resolution details. | Column notes (STRING) in billing.ad_billing_reconciliation']
  reconciliation_date date [note: 'The date when the reconciliation process was completed and the advertising delivery was verified against the billing order. | Column reconciliation_date (DATE) in billing.ad_billing_reconciliation']
  reconciliation_number varchar [note: 'Business-facing unique reference number for this reconciliation record, used for tracking and reporting purposes. | Column reconciliation_number (STRING) in billing.ad_billing_reconciliation']
  reconciliation_status varchar [note: 'Current lifecycle status of the reconciliation process indicating whether the advertising delivery has been verified and settled. | Column reconciliation_status (STRING) in billing.ad_billing_reconciliation']
  reconciliation_timestamp timestamp [note: 'Precise timestamp when the reconciliation record was finalized, used for audit trail and settlement timing. | Column reconciliation_timestamp (TIMESTAMP) in billing.ad_billing_reconciliation']
  reconciliation_type varchar [note: 'The type of reconciliation record indicating whether this is a standard delivery verification, makegood settlement, credit issuance, or billing adjustment. | Column reconciliation_type (STRING) in billing.ad_billing_reconciliation']
  resolution_date date [note: 'The date when the reconciliation dispute was resolved and the final settlement was agreed upon. | Column resolution_date (DATE) in billing.ad_billing_reconciliation']
  revenue_recognition_date date [note: 'The date when the advertising revenue from this reconciliation is recognized in the financial system per ASC 606 standards. | Column revenue_recognition_date (DATE) in billing.ad_billing_reconciliation']
  sap_posting_reference varchar [note: 'The SAP S/4HANA document number or posting reference for the financial transaction associated with this reconciliation. | Column sap_posting_reference (STRING) in billing.ad_billing_reconciliation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.ad_billing_reconciliation']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.ad_billing_reconciliation']
  total_spots_aired varchar [note: 'The actual number of advertising spots that were successfully broadcast and verified through affidavits. | Column total_spots_aired (INT) in billing.ad_billing_reconciliation']
  total_spots_missed varchar [note: 'The number of ordered advertising spots that failed to air as scheduled, requiring makegood remediation. | Column total_spots_missed (INT) in billing.ad_billing_reconciliation']
  total_spots_ordered varchar [note: 'The total number of advertising spots that were contracted and ordered for this campaign flight. | Column total_spots_ordered (INT) in billing.ad_billing_reconciliation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.ad_billing_reconciliation']
  updated_timestamp timestamp [note: 'Timestamp when this reconciliation record was last modified or updated. | Column updated_timestamp (TIMESTAMP) in billing.ad_billing_reconciliation']
  variance_percentage decimal(5,2) [note: 'The percentage variance between contracted and delivered advertising value, calculated as (delivered - contracted) / contracted * 100. | Column variance_percentage (DECIMAL(5,2)) in billing.ad_billing_reconciliation']
  wide_orbit_order_reference varchar [note: 'External order identifier from the Wide Orbit traffic and billing system for cross-system reconciliation. | Column wide_orbit_order_reference (STRING) in billing.ad_billing_reconciliation']

  Note: 'Consolidated advertising billing reconciliation record combining proof-of-broadcast affidavits and compensatory makegood spots for advertising revenue settlement — the billing-side view of ad delivery confirmation and remediation | Unity Catalog table: media_broadcasting_ecm.billing.ad_billing_reconciliation'
}

Table billing.communication_template {
  communication_template_id varchar [pk, note: 'Primary key for communication_template | Column communication_template_id (BIGINT) in billing.communication_template']
  parent_communication_template_id varchar [note: 'Reference to the previous version of this template, enabling version history tracking. Null for initial versions. | Column parent_template_id (BIGINT) in billing.communication_template']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.communication_template']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.communication_template']
  approval_required_flag boolean [note: 'Indicates whether this template requires management or compliance approval before it can be activated. | Column approval_required_flag (BOOLEAN) in billing.communication_template']
  approved_by varchar [note: 'Name or identifier of the person who approved this template for use. | Column approved_by (STRING) in billing.communication_template']
  approved_timestamp timestamp [note: 'Date and time when this template was approved for use. | Column approved_timestamp (TIMESTAMP) in billing.communication_template']
  attachment_file_name_pattern varchar [note: 'Pattern or template for generating attachment file names. May contain merge field placeholders. | Column attachment_file_name_pattern (STRING) in billing.communication_template']
  attachment_required_flag boolean [note: 'Indicates whether this template requires an attachment (such as an invoice PDF or payment receipt) to be included when sent. | Column attachment_required_flag (BOOLEAN) in billing.communication_template']
  bcc_recipients varchar [note: 'Comma-separated list of email addresses to be blind copied on communications generated from this template. | Column bcc_recipients (STRING) in billing.communication_template']
  body_content varchar [note: 'Main content body of the communication template. May contain HTML markup and merge field placeholders for dynamic data insertion. | Column body_content (STRING) in billing.communication_template']
  cc_recipients varchar [note: 'Comma-separated list of email addresses to be copied on communications generated from this template. | Column cc_recipients (STRING) in billing.communication_template']
  communication_channel varchar [note: 'Delivery channel through which the communication is sent to the recipient. | Column communication_channel (STRING) in billing.communication_template']
  communication_template_status varchar [note: 'Current lifecycle status of the communication template indicating whether it is available for use. | Column status (STRING) in billing.communication_template']
  compliance_category varchar [note: 'Classification of the communication for regulatory compliance purposes (e.g., CAN-SPAM, GDPR, TCPA). | Column compliance_category (STRING) in billing.communication_template']
  content_format varchar [note: 'Format type of the template content defining how the body content is structured and rendered. | Column content_format (STRING) in billing.communication_template']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.communication_template']
  created_timestamp timestamp [note: 'Date and time when this template record was first created in the system. | Column created_timestamp (TIMESTAMP) in billing.communication_template']
  effective_end_date date [note: 'Date after which this communication template is no longer active. Null indicates no end date. | Column effective_end_date (DATE) in billing.communication_template']
  effective_start_date date [note: 'Date from which this communication template becomes active and available for use. | Column effective_start_date (DATE) in billing.communication_template']
  language_code varchar [note: 'ISO 639-1 language code (with optional ISO 3166-1 country code) indicating the language of the template content. | Column language_code (STRING) in billing.communication_template']
  last_used_timestamp timestamp [note: 'Date and time when this template was most recently used to generate a communication. | Column last_used_timestamp (TIMESTAMP) in billing.communication_template']
  merge_fields varchar [note: 'Comma-separated list of merge field placeholders available in this template for dynamic data insertion (e.g., customer_name, invoice_number, amount_due). | Column merge_fields (STRING) in billing.communication_template']
  modified_by varchar [note: 'Identifier of the user or system that last modified this template record. | Column modified_by (STRING) in billing.communication_template']
  modified_timestamp timestamp [note: 'Date and time when this template record was last modified. | Column modified_timestamp (TIMESTAMP) in billing.communication_template']
  notes varchar [note: 'Internal notes or comments about the template for administrative reference. | Column notes (STRING) in billing.communication_template']
  opt_out_allowed_flag boolean [note: 'Indicates whether recipients can opt out of receiving communications generated from this template. | Column opt_out_allowed_flag (BOOLEAN) in billing.communication_template']
  priority_level varchar [note: 'Priority classification for communications sent using this template, affecting delivery queue and recipient notification settings. | Column priority_level (STRING) in billing.communication_template']
  reply_to_email varchar [note: 'Email address to which recipient replies are directed. | Column reply_to_email (STRING) in billing.communication_template']
  retention_period_days varchar [note: 'Number of days that communications generated from this template must be retained for compliance and audit purposes. | Column retention_period_days (INT) in billing.communication_template']
  sender_email varchar [note: 'Email address used as the sender for email communications generated from this template. | Column sender_email (STRING) in billing.communication_template']
  sender_name varchar [note: 'Display name of the sender shown to recipients in the communication. | Column sender_name (STRING) in billing.communication_template']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.communication_template']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.communication_template']
  subject_line varchar [note: 'Subject line or title used for email and portal communications. May contain merge field placeholders. | Column subject_line (STRING) in billing.communication_template']
  template_code varchar [note: 'Unique business identifier code for the template used in system integrations and references. | Column template_code (STRING) in billing.communication_template']
  template_name varchar [note: 'Human-readable name of the communication template. | Column template_name (STRING) in billing.communication_template']
  template_type varchar [note: 'Classification of the communication template by its business purpose within billing operations. | Column template_type (STRING) in billing.communication_template']
  trigger_event varchar [note: 'Business event or condition that triggers the use of this communication template (e.g., invoice_generated, payment_overdue, dispute_opened). | Column trigger_event (STRING) in billing.communication_template']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.communication_template']
  usage_count varchar [note: 'Total number of times this template has been used to generate communications. | Column usage_count (BIGINT) in billing.communication_template']
  version_number varchar [note: 'Version identifier for the template, following semantic versioning (major.minor format) to track template revisions. | Column version_number (STRING) in billing.communication_template']
  created_by varchar [note: 'Identifier of the user or system that created this template record. | Column created_by (STRING) in billing.communication_template']

  Note: 'Master reference table for communication_template. Referenced by communication_template_id. | Unity Catalog table: media_broadcasting_ecm.billing.communication_template'
}

Table billing.billing_product {
  billing_product_id varchar [pk, note: 'Primary key for product | Column product_id (BIGINT) in billing.product']
  finance_revenue_stream_id varchar [note: 'FK added per VREQ']
  parent_product_id varchar [note: 'Self-referencing FK on product (parent_product_id) | Column parent_product_id (BIGINT) in billing.product']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.product']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.product']
  base_price decimal(15,2) [note: 'Standard list price for the product before any discounts, promotions, or volume adjustments. Expressed in the default currency (USD). | Column base_price (DECIMAL(15,2)) in billing.product']
  billing_frequency varchar [note: 'Frequency at which the product is billed to customers: one-time (single charge), daily, weekly, monthly, quarterly, semi-annual, annual, or usage-based (billed based on consumption). | Column billing_frequency (STRING) in billing.product']
  billing_product_description varchar [note: 'Detailed business description of the product, including features, benefits, and target audience. Used in marketing materials and billing communications. | Column description (STRING) in billing.product']
  billing_product_status varchar [note: 'Current lifecycle status of the product: active (available for sale), inactive (temporarily unavailable), discontinued (permanently retired), pending_launch (approved but not yet available), or sunset (scheduled for retirement). | Column status (STRING) in billing.product']
  billing_system varchar [note: 'Source billing system that processes transactions for this product: Zuora (subscription billing), Wide Orbit (advertising billing), SAP S/4HANA (financial posting), legacy (older systems), or manual (manually invoiced). | Column billing_system (STRING) in billing.product']
  content_rating varchar [note: 'Content rating classification for media products, indicating age-appropriateness and content warnings. Follows MPAA (film) and TV Parental Guidelines standards. NR indicates not rated or not applicable. | Column content_rating (STRING) in billing.product']
  cost_center varchar [note: 'Cost center responsible for the product, used for internal financial reporting and profitability analysis. | Column cost_center (STRING) in billing.product']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.product']
  created_timestamp timestamp [note: 'Timestamp when the product record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in billing.product']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the product pricing (e.g., USD, EUR, GBP, CAD). | Column currency_code (STRING) in billing.product']
  domain_verified_flag boolean [note: 'Flag indicating this product belongs to the verified 17-domain structure']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_end_date date [note: 'Date when the product is discontinued and no longer available for new sales. Null for products with no planned end date. | Column effective_end_date (DATE) in billing.product']
  effective_start_date date [note: 'Date when the product becomes available for sale and billing. Products cannot be sold before this date. | Column effective_start_date (DATE) in billing.product']
  genre varchar [note: 'Primary genre or content category for media products (e.g., Drama, Comedy, News, Sports, Documentary, Reality, Kids). Used for content classification and recommendation engines. | Column genre (STRING) in billing.product']
  gl_account_code varchar [note: 'General ledger account code to which revenue from this product is posted in SAP S/4HANA financial system. | Column gl_account_code (STRING) in billing.product']
  is_bundled boolean [note: 'Indicates whether the product is sold as part of a bundle or package. True if bundled, False if sold standalone. | Column is_bundled (BOOLEAN) in billing.product']
  is_promotional boolean [note: 'Indicates whether the product is offered as a promotional or limited-time offer. True if promotional, False if standard offering. | Column is_promotional (BOOLEAN) in billing.product']
  is_taxable boolean [note: 'Indicates whether the product is subject to sales tax, VAT, or other consumption taxes. True if taxable, False if tax-exempt. | Column is_taxable (BOOLEAN) in billing.product']
  last_modified_timestamp timestamp [note: 'Timestamp when the product record was last updated. Used for change tracking and data synchronization across systems. | Column last_modified_timestamp (TIMESTAMP) in billing.product']
  last_price_change_date date [note: 'Date when the base price was last modified. Used for pricing history tracking and customer communication. | Column last_price_change_date (DATE) in billing.product']
  launch_date date [note: 'Date when the product was first introduced to the market. Used for product lifecycle analytics and reporting. | Column launch_date (DATE) in billing.product']
  minimum_commitment_period_months varchar [note: 'Minimum contract commitment period in months required for the product. Null if no minimum commitment. | Column minimum_commitment_period_months (INT) in billing.product']
  pci_dss_scope boolean [note: 'Indicates whether the product involves payment card processing and falls under PCI DSS compliance scope. True if in scope, False if out of scope. | Column pci_dss_scope (BOOLEAN) in billing.product']
  platform_availability varchar [note: 'Comma-separated list of platforms where the product is available (e.g., iOS, Android, Web, Roku, Apple TV, Fire TV, Smart TV). Used for distribution planning and customer support. | Column platform_availability (STRING) in billing.product']
  product_category varchar [note: 'High-level categorization of the product by distribution channel: linear TV (broadcast/cable), streaming (OTT/SVOD), digital (web/mobile), audio (radio/podcast), print (magazine), bundle (multi-service package), or ancillary (merchandise/licensing). | Column product_category (STRING) in billing.product']
  product_code varchar [note: 'Externally-known unique business identifier for the product, used across billing systems and customer communications. | Column product_code (STRING) in billing.product']
  product_name varchar [note: 'Human-readable name of the product as displayed to customers and used in billing statements. | Column product_name (STRING) in billing.product']
  product_owner varchar [note: 'Name or identifier of the business unit or individual responsible for managing the product lifecycle, pricing, and strategy. | Column product_owner (STRING) in billing.product']
  product_type varchar [note: 'Classification of the product by revenue model: subscription (recurring subscriber fees), advertising (ad inventory sales), carriage fee (distribution fees from cable/satellite operators), syndication (content licensing), pay-per-view (one-time event purchases), or transactional (on-demand rentals/purchases). | Column product_type (STRING) in billing.product']
  profit_center varchar [note: 'Profit center to which product revenue and costs are allocated for P&L reporting and business unit performance measurement. | Column profit_center (STRING) in billing.product']
  requires_contract boolean [note: 'Indicates whether the product requires a formal contract or subscription agreement. True if contract required, False if available without contract. | Column requires_contract (BOOLEAN) in billing.product']
  revenue_recognition_rule varchar [note: 'ASC 606 revenue recognition treatment for the product: point-in-time (recognize at delivery), over-time (recognize ratably over contract period), proportional (recognize based on performance obligations), or deferred (recognize upon specific milestone). | Column revenue_recognition_rule (STRING) in billing.product']
  sales_channel varchar [note: 'Primary sales channel through which the product is distributed: direct (direct sales team), retail (physical stores), online (e-commerce), partner (third-party distributors), affiliate (affiliate marketing), or call_center (telesales). | Column sales_channel (STRING) in billing.product']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.product']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.product']
  target_market_segment varchar [note: 'Primary market segment the product is designed for: consumer (individual subscribers), business (small/medium business), enterprise (large corporations), government (public sector), education (schools/universities), or nonprofit (charitable organizations). | Column target_market_segment (STRING) in billing.product']
  tax_code varchar [note: 'Tax classification code used to determine applicable sales tax, VAT, or GST rates for the product. Integrates with tax calculation engines. | Column tax_code (STRING) in billing.product']
  trial_period_days varchar [note: 'Number of days for free trial period offered for the product. Null if no trial period available. | Column trial_period_days (INT) in billing.product']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.product']

  Note: 'Billing product catalog defining billable items, pricing, and revenue recognition rules for subscription and transactional billing. Coverage gaps ordered by demo impact: (1) revenue stream linkage for M&B sub-verticals, (2) subscription billing flows, (3) ad billing reconciliation. Sample data generated for both MVM and ECM variants in samples/ directory.'
}

