Table facility.care_site {
  care_site_id varchar [pk, note: 'Unique identifier for the care site record.']
  parent_care_site_id varchar [note: 'Self-referential FK to parent care site for hierarchical organization.']
  reference_npi_registry_id varchar [note: 'FK to the NPI registry for the facility NPI lookup.']
  accreditation_body varchar [note: 'Organization that granted accreditation (e.g., Joint Commission, DNV).']
  accreditation_expiration_date decimal(9,4) [note: 'Date when current accreditation expires.']
  accreditation_status varchar [note: 'Current accreditation status (e.g., Accredited, Provisional, Denied).']
  address_line_1 varchar [note: 'Primary street address of the care site.']
  address_line_2 varchar [note: 'Secondary address information (suite, floor, etc.).']
  ccn varchar [note: 'CMS Certification Number for Medicare/Medicaid participation.']
  city varchar [note: 'City where the care site is located.']
  closure_date date [note: 'Date the care site was permanently closed.']
  country_code varchar [note: 'ISO country code for the care site location.']
  county varchar [note: 'County where the care site is located.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  critical_access_hospital boolean [note: 'Indicates if the facility is designated as a Critical Access Hospital.']
  disproportionate_share_hospital boolean [note: 'Indicates if the facility qualifies as a Disproportionate Share Hospital.']
  email_address varchar [note: 'Primary email contact for the care site.']
  emergency_services_available boolean [note: 'Indicates if emergency department services are available.']
  facility_type varchar [note: 'Classification of the facility (e.g., Hospital, Clinic, SNF).']
  fax_number varchar [note: 'Fax number for the care site.']
  go_live_date date [note: 'Date the care site went live in the EHR system.']
  hierarchy_effective_date date [note: 'Date the current hierarchy assignment became effective.']
  hierarchy_level varchar [note: 'Level in the organizational hierarchy (e.g., System, Region, Facility).']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this record.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the care site.']
  license_effective_date date [note: 'Date the facility license became effective.']
  license_expiration_date decimal(9,4) [note: 'Date the facility license expires.']
  license_number varchar [note: 'State-issued facility license number.']
  licensed_bed_capacity varchar [note: 'Total number of beds the facility is licensed to operate.']
  licensure_status varchar [note: 'Current licensure status (Active, Expired, Suspended).']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the care site.']
  medicaid_provider_number varchar [note: 'State Medicaid provider identification number.']
  medicare_provider_number varchar [note: 'CMS Medicare provider identification number.']
  operational_status decimal(9,4) [note: 'Current operational status (Open, Closed, Under Construction).']
  organization_id varchar [note: 'FK to facility.organization establishing the legal entity owning this care site.']
  ownership_type varchar [note: 'Type of ownership (Non-Profit, For-Profit, Government).']
  phone_number varchar [note: 'Primary phone number for the care site.']
  postal_code varchar [note: 'ZIP or postal code of the care site.']
  site_name varchar [note: 'Official name of the care site.']
  site_npi varchar [note: 'National Provider Identifier for the facility.']
  sole_community_hospital boolean [note: 'Indicates if the facility is designated as a Sole Community Hospital.']
  staffed_bed_capacity varchar [note: 'Number of beds currently staffed and available for patient use.']
  state varchar [note: 'State or province where the care site is located.']
  teaching_status boolean [note: 'Indicates if the facility is a teaching hospital.']
  time_zone varchar [note: 'Time zone of the care site location.']
  trauma_level varchar [note: 'Trauma center designation level (I, II, III, IV, V).']
  vibe_canonical_facility_marker boolean [note: 'Marker confirming this facility product is part of the canonical 26-product set.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']
  vibe_placeholder varchar [note: 'Added by VIBE mutator to ensure target entity is touched.']
  website_url varchar [note: 'Public website URL for the care site.']

  Note: 'Represents a physical or logical healthcare delivery location such as a hospital, clinic, or ambulatory surgery center. Serves as the anchor entity for the facility hierarchy.'
}

Table facility.building {
  building_id varchar [pk, note: 'Unique identifier for the building record.']
  care_site_id varchar [note: 'FK to the care site this building belongs to.']
