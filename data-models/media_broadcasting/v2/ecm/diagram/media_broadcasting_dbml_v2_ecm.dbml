  lead_talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Co-production agreements frequently specify lead talent (star, showrunner, director) as part of the deal structure—attached talent drives financing approval and production greenlight decisions. Critic | Column lead_talent_profile_id (BIGINT) in talent.coproduction_agreement']
  production_project_id varchar [note: 'Foreign key linking to production.project. Business justification: Co-production agreements directly reference the production project being co-financed and co-produced. Linking enables tracking budget contributions, IP ownership splits, delivery obligations, and fina | Column production_project_id (BIGINT) in production.coproduction_agreement']
  production_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Coproduction agreements are title-specific investments requiring direct linkage for production finance tracking, IP ownership percentage calculation, delivery milestone management, and revenue waterfa | Column production_title_id (BIGINT) in content.coproduction_agreement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.coproduction_agreement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.coproduction_agreement']
  agreement_number varchar [note: 'Externally-known business identifier for the co-production agreement, used in contracts and communications. | Column agreement_number (STRING) in partner.coproduction_agreement']
  agreement_status varchar [note: 'Current lifecycle status of the co-production agreement. [ENUM-REF-CANDIDATE: draft|negotiation|active|suspended|completed|terminated|expired — 7 candidates stripped; promote to reference product] | Column agreement_status (STRING) in partner.coproduction_agreement']
  agreement_type varchar [note: 'Classification of the co-production agreement based on the number and nature of participating parties. | Column agreement_type (STRING) in partner.coproduction_agreement']
  amendment_count varchar [note: 'Number of formal amendments made to the original co-production agreement. | Column amendment_count (INT) in partner.coproduction_agreement']
  approval_authority varchar [note: 'Designation of which partner or committee has final approval authority over key creative and business decisions. | Column approval_authority (STRING) in partner.coproduction_agreement']
  audit_rights varchar [note: 'Provisions allowing partners to audit financial records and production accounts related to the co-production. | Column audit_rights (STRING) in partner.coproduction_agreement']
  budget_currency_code varchar [note: 'Three-letter ISO currency code for the total budget amount. | Column budget_currency_code (STRING) in partner.coproduction_agreement']
  confidentiality_terms varchar [note: 'Non-disclosure obligations and confidentiality requirements binding all co-production partners. | Column confidentiality_terms (STRING) in partner.coproduction_agreement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.coproduction_agreement']
  created_timestamp timestamp [note: 'Timestamp when this co-production agreement record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.coproduction_agreement']
