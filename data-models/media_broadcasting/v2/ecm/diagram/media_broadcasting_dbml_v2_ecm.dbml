  created_timestamp timestamp [note: 'Record creation timestamp']
  exchange_code varchar [note: 'Unique code identifier for the exchange']
  exchange_name varchar [note: 'Name of the exchange (e.g., Google AdX, Xandr)']
  exchange_type varchar [note: 'Type of exchange (open, private, hybrid)']
  floor_price_currency varchar [note: 'Default currency for floor prices']
  is_active boolean [note: 'Whether the exchange integration is currently active']
  minimum_bid_amount decimal(18,2) [note: 'Minimum bid amount accepted']
  programmatic_enabled boolean [note: 'Flag indicating this entity is enabled for programmatic advertising']
  supported_channels varchar [note: 'Supported channels (CTV, mobile, desktop, audio)']
  supported_formats varchar [note: 'Supported ad formats']
  supported_protocols varchar [note: 'Supported RTB protocols (OpenRTB 2.x, OpenRTB 3.0)']
  take_rate_percentage decimal(5,2) [note: 'Exchange take rate percentage']
  updated_at timestamp [note: 'Record last update timestamp']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Ad exchange master for programmatic marketplace transactions'
}

Table sales.private_marketplace_deal {
  private_marketplace_deal_id varchar [pk, note: 'Primary key for PMP deal']
  advertiser_id varchar [note: 'FK to advertiser']
  dsp_id varchar [note: 'FK to demand-side platform']
