ind:treatmentRecommendations rdf:type rdf:Property ;
    rdfs:label 'Treatment Recommendations' ;
    rdfs:comment 'Recommended treatment plan or interventions resulting from the assessment.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertFlag rdf:type rdf:Property ;
    rdfs:label 'Alert Flag' ;
    rdfs:comment 'Indicates whether the reading triggered a clinical alert based on configured thresholds.' ;
    rdfs:domain ind:RpmReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertTriggeredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Alert Triggered Timestamp' ;
    rdfs:comment 'Date and time when the alert condition was met.' ;
    rdfs:domain ind:RpmReading ;
    rdf:type owl:DatatypeProperty ;
