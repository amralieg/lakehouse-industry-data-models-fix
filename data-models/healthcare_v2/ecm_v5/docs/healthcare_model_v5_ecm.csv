order,entry_management,reconciliation,message_log_id,message_log_id,Source System ID,BIGINT,,interoperability.message_log.message_log_id,,,transactional_data,"Unique identifier for this reconciliation record in the source system, used for data lineage and reconciliation.",
order,entry_management,reconciliation,mpi_record_id,mpi_record_id,Patient ID,BIGINT,,patient.mpi_record.mpi_record_id,,,transactional_data,Reference to the patient for whom medication and order reconciliation was performed.,
order,entry_management,reconciliation,visit_id,visit_id,Visit ID,BIGINT,,encounter.visit.visit_id,,,transactional_data,Reference to the encounter or visit during which this reconciliation occurred.,
order,entry_management,reconciliation,allergy_review_indicator,allergy_review_indicator,Allergy Review Indicator,BOOLEAN,,,,,transactional_data,"Boolean flag indicating whether patient allergies were reviewed during the reconciliation process. True if reviewed, false otherwise.",
order,entry_management,reconciliation,attestation_datetime,attestation_datetime,Attestation Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when the provider attested to the accuracy and completeness of the reconciliation.,
order,entry_management,reconciliation,attestation_signature,attestation_signature,Attestation Signature,STRING,,,,,transactional_data,"Electronic signature or attestation identifier of the provider who completed the reconciliation, confirming accuracy and completeness.",
order,entry_management,reconciliation,completion_indicator,completion_indicator,Completion Indicator,BOOLEAN,,,,,transactional_data,"Boolean flag indicating whether the reconciliation was fully completed per regulatory requirements. True if completed, false otherwise.",
order,entry_management,reconciliation,compliance_indicator,compliance_indicator,Compliance Indicator,BOOLEAN,,,,,transactional_data,"Boolean flag indicating whether the reconciliation met all regulatory and accreditation requirements. True if compliant, false otherwise.",
order,entry_management,reconciliation,created_datetime,created_datetime,Created Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when this reconciliation record was first created in the system. Audit trail timestamp for record creation.,
order,entry_management,reconciliation,datetime,datetime,Reconciliation Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when the medication and order reconciliation was performed. Principal business event timestamp for this transaction.,
