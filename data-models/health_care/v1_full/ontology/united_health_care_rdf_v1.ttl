ind:technologyDependency rdf:type rdf:Property ;
    rdfs:label 'Technology Dependency' ;
    rdfs:comment 'Specific systems, applications, or technologies that the control relies upon for execution (e.g., Facets, QNXT, ServiceNow).' ;
    rdfs:domain ind:Control ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityDescription rdf:type rdf:Property ;
    rdfs:label 'Activity Description' ;
    rdfs:comment 'Narrative description of the specific activities performed as part of control execution.' ;
    rdfs:domain ind:Control ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionHandlingProcedure rdf:type rdf:Property ;
    rdfs:label 'Exception Handling Procedure' ;
    rdfs:comment 'Documented process for identifying, escalating, and resolving exceptions or deviations from the control.' ;
    rdfs:domain ind:Control ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingFrequency rdf:type rdf:Property ;
    rdfs:label 'Training Frequency' ;
    rdfs:comment 'How often personnel must complete training related to this control.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentStatusId rdf:type rdf:Property ;
    rdfs:label 'Enrollment Status Id' ;
    rdfs:comment 'Unique identifier for the enrollment status record. Primary key for the status reference table.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnrollmentStatus .

ind:allowsClaims rdf:type rdf:Property ;
    rdfs:label 'Allows Claims' ;
    rdfs:comment 'Boolean flag indicating whether claims can be adjudicated and paid when a member enrollment has this status.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationReasonRequired rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Required' ;
    rdfs:comment 'Boolean flag indicating whether a termination reason code must be provided when transitioning to this status.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsTransactionType rdf:type rdf:Property ;
    rdfs:label 'Cms Transaction Type' ;
    rdfs:comment 'CMS-specific transaction type code used for Medicare Advantage and Part D enrollment reporting (e.g., Add, Change, Delete, Reinstate).' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSystemGenerated rdf:type rdf:Property ;
    rdfs:label 'Is System Generated' ;
    rdfs:comment 'Boolean flag indicating whether this status is automatically assigned by system processes (e.g., auto-termination for non-payment) versus manually assigned by enrollment staff.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sepQualifying rdf:type rdf:Property ;
    rdfs:label 'Sep Qualifying' ;
    rdfs:comment 'Boolean flag indicating whether transitioning to this status qualifies as a qualifying life event that triggers a special enrollment period.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mlrIncluded rdf:type rdf:Property ;
    rdfs:label 'Mlr Included' ;
    rdfs:comment 'Boolean flag indicating whether member months with this status should be included in Medical Loss Ratio calculations for ACA compliance.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:idCardIssued rdf:type rdf:Property ;
    rdfs:label 'Id Card Issued' ;
    rdfs:comment 'Boolean flag indicating whether member ID cards should be issued or remain valid when enrollment has this status.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerRosterIncluded rdf:type rdf:Property ;
    rdfs:label 'Provider Roster Included' ;
    rdfs:comment 'Boolean flag indicating whether members with this status should be included in provider rosters and eligibility files sent to network providers.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exchangeReportable rdf:type rdf:Property ;
    rdfs:label 'Exchange Reportable' ;
    rdfs:comment 'Boolean flag indicating whether enrollments with this status must be reported to health insurance exchanges (FFM/SBM) for reconciliation.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irs1095Reportable rdf:type rdf:Property ;
    rdfs:label 'Irs 1095 Reportable' ;
    rdfs:comment 'Boolean flag indicating whether member months with this status should be included in IRS Form 1095-B or 1095-C reporting for minimum essential coverage.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextStatusCode rdf:type rdf:Property ;
    rdfs:label 'Next Status Code' ;
    rdfs:comment 'Default status code that enrollments should transition to after this status, used for automated workflow progression.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalAllowed rdf:type rdf:Property ;
    rdfs:label 'Reversal Allowed' ;
    rdfs:comment 'Boolean flag indicating whether a status change can be reversed or undone after being applied to an enrollment.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialImpact rdf:type rdf:Property ;
    rdfs:label 'Financial Impact' ;
    rdfs:comment 'Category describing the financial impact when enrollment transitions to this status (e.g., premium due, premium waived, refund due, adjustment required).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openEnrollmentOnly rdf:type rdf:Property ;
    rdfs:label 'Open Enrollment Only' ;
    rdfs:comment 'Boolean flag indicating whether this status can only be assigned during open enrollment periods (OEP) or annual election periods (AEP).' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qleRequired rdf:type rdf:Property ;
    rdfs:label 'Qle Required' ;
    rdfs:comment 'Boolean flag indicating whether a qualifying life event must be documented to assign this status outside of open enrollment periods.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealsEligible rdf:type rdf:Property ;
    rdfs:label 'Appeals Eligible' ;
    rdfs:comment 'Boolean flag indicating whether members can appeal or request reconsideration when their enrollment is assigned this status.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grievanceCategory rdf:type rdf:Property ;
    rdfs:label 'Grievance Category' ;
    rdfs:comment 'Category code used for tracking member grievances and complaints related to this enrollment status.' ;
    rdfs:domain ind:EnrollmentStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualifyingLifeEventId rdf:type rdf:Property ;
    rdfs:label 'Qualifying Life Event Id' ;
    rdfs:comment 'Unique identifier for the qualifying life event type in the reference list.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:QualifyingLifeEvent .

ind:retroactiveDaysMaximum rdf:type rdf:Property ;
    rdfs:label 'Retroactive Days Maximum' ;
    rdfs:comment 'Maximum number of days coverage can be backdated from the enrollment date when retroactive coverage is allowed.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentationTypes rdf:type rdf:Property ;
    rdfs:label 'Documentation Types' ;
    rdfs:comment 'List of acceptable document types that can be submitted to verify the qualifying life event occurrence.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationTimeframeDays rdf:type rdf:Property ;
    rdfs:label 'Verification Timeframe Days' ;
    rdfs:comment 'Number of days allowed for the member to submit required documentation to verify the qualifying life event.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicableToIndividual rdf:type rdf:Property ;
    rdfs:label 'Applicable To Individual' ;
    rdfs:comment 'Indicates whether this qualifying life event applies to individual market health insurance plans.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:applicableToGroup rdf:type rdf:Property ;
    rdfs:label 'Applicable To Group' ;
    rdfs:comment 'Indicates whether this qualifying life event applies to employer-sponsored group health insurance plans.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:applicableToMedicare rdf:type rdf:Property ;
    rdfs:label 'Applicable To Medicare' ;
    rdfs:comment 'Indicates whether this qualifying life event applies to Medicare Advantage or Medicare Part D plans.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:applicableToMedicaid rdf:type rdf:Property ;
    rdfs:label 'Applicable To Medicaid' ;
    rdfs:comment 'Indicates whether this qualifying life event applies to Medicaid managed care plans.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:applicableToMarketplace rdf:type rdf:Property ;
    rdfs:label 'Applicable To Marketplace' ;
    rdfs:comment 'Indicates whether this qualifying life event applies to Federally Facilitated Marketplace or State-Based Marketplace plans.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageTierChangeAllowed rdf:type rdf:Property ;
    rdfs:label 'Coverage Tier Change Allowed' ;
    rdfs:comment 'Indicates whether the member can change coverage tier (e.g., from individual to family) during the special enrollment period.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dependentAdditionAllowed rdf:type rdf:Property ;
    rdfs:label 'Dependent Addition Allowed' ;
    rdfs:comment 'Indicates whether dependents can be added to coverage during the special enrollment period triggered by this QLE.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
