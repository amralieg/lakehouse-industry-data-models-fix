ind:trainingRunModelVersionId rdf:type rdf:Property ;
    rdfs:label 'Training Run Model Version Id' ;
    rdfs:comment 'Foreign key linking to clinical_ai.model_version. Business justification: A training run produces a specific model version. Adding FK to model_version links training execution to its output artifact. Removing model_version STRING column as it becomes redundant once the FK t' ;
    rdfs:domain ind:ModelTrainingRun ;
