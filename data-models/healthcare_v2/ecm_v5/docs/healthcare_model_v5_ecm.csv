reference,clinical_terminology,condition_code,short_description,short_description,Short Description,STRING,,,,,reference_data,Abbreviated description for display in constrained UI contexts and reports. Typically 30-50 characters.,
reference,clinical_terminology,condition_code,source_system,source_system,Source System,STRING,,,,,reference_data,"The operational system or authoritative source from which this code was loaded. Examples: 3M HIS Grouper, CMS Code Maintenance Files, AMA CPT Database.",
reference,clinical_terminology,condition_code,telehealth_eligible_flag,telehealth_eligible_flag,Telehealth Eligible Flag,BOOLEAN,,,,,reference_data,"For place of service (POS) codes, indicates whether the location is eligible for telehealth service delivery and reimbursement.",
reference,clinical_terminology,condition_code,termination_date,termination_date,Termination Date,DATE,,,,,reference_data,The date on which this code was retired or became invalid for use on claims. Null if the code is currently active. Format: yyyy-MM-dd.,
reference,clinical_terminology,condition_code,ub04_form_locator,ub04_form_locator,UB-04 Form Locator,STRING,,,,,reference_data,"The specific field location on the UB-04 claim form where this code appears. Examples: FL 18-28 for condition codes, FL 31-36 for occurrence codes, FL 39-41 for value codes, FL 42 for revenue codes.",
reference,clinical_terminology,condition_code,usage_notes,usage_notes,Usage Notes,STRING,,,,,reference_data,"Additional guidance, constraints, or special instructions for proper use of this code on claims. May include payer-specific requirements or coding scenarios.",
