    rdfs:comment 'The unique identifier for the member\'s assigned primary care physician, required for HMO and POS plan types.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Profile .

ind:primaryCarePhysicianNpi rdf:type rdf:Property ;
