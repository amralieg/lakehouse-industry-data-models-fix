    rdfs:comment 'Indicates whether this intervention type is specifically designed for or applicable to Special Needs Plan members including D-SNP, C-SNP, or I-SNP populations.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
