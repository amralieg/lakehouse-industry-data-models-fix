    rdfs:comment 'External reference identifier from the source system for traceability and reconciliation.' ;
    rdfs:domain ind:Lineup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startingPlayers rdf:type rdf:Property ;
