ind:authorizationDurationDays rdf:type rdf:Property ;
    rdfs:label 'Authorization Duration Days' ;
    rdfs:comment 'Number of days for which an approved authorization remains valid under this rule.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationTimeframeHours rdf:type rdf:Property ;
    rdfs:label 'Notification Timeframe Hours' ;
    rdfs:comment 'Number of hours within which the authorization decision must be communicated to the requesting provider or member.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:urgentReviewTimeframeHours rdf:type rdf:Property ;
    rdfs:label 'Urgent Review Timeframe Hours' ;
    rdfs:comment 'Number of hours within which an urgent authorization request must be reviewed and decided under this rule.' ;
    rdfs:domain ind:AuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standardReviewTimeframeDays rdf:type rdf:Property ;
    rdfs:label 'Standard Review Timeframe Days' ;
    rdfs:comment 'Number of days within which a standard (non-urgent) authorization request must be reviewed and decided under this rule.' ;
    rdfs:domain ind:AuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appealAllowed rdf:type rdf:Property ;
    rdfs:label 'Appeal Allowed' ;
    rdfs:comment 'Indicates whether members or providers can appeal a denial decision made under this authorization rule.' ;
    rdfs:domain ind:AuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealTimeframeDays rdf:type rdf:Property ;
    rdfs:label 'Appeal Timeframe Days' ;
    rdfs:comment 'Number of days within which an appeal must be filed following a denial under this authorization rule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providerSpecialtyRequired rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Required' ;
    rdfs:comment 'Specific provider specialty or credential required to perform the service subject to this authorization rule.' ;
    rdfs:domain ind:AuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepTherapyCriteria rdf:type rdf:Property ;
    rdfs:label 'Step Therapy Criteria' ;
    rdfs:comment 'Detailed criteria defining the step therapy requirements, including which treatments must be tried first.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCriteria rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Criteria' ;
    rdfs:comment 'Detailed criteria describing the required diagnosis or clinical condition for authorization under this rule.' ;
    rdfs:domain ind:AuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Threshold Amount' ;
    rdfs:comment 'Dollar amount threshold above which this authorization rule is triggered for cost management purposes.' ;
    rdfs:domain ind:AuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costThresholdCurrency rdf:type rdf:Property ;
    rdfs:label 'Cost Threshold Currency' ;
    rdfs:comment 'Currency code for the cost threshold amount.' ;
    rdfs:domain ind:AuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryMandate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandate' ;
    rdfs:comment 'Regulatory requirement or mandate that necessitates this authorization rule.' ;
    rdfs:domain ind:AuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionProcessAvailable rdf:type rdf:Property ;
    rdfs:label 'Exception Process Available' ;
    rdfs:comment 'Indicates whether an exception or override process is available for cases that do not meet the standard rule criteria.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionCriteria rdf:type rdf:Property ;
    rdfs:label 'Exception Criteria' ;
    rdfs:comment 'Criteria under which an exception to this authorization rule may be granted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSpecific rdf:type rdf:Property ;
    rdfs:label 'State Specific' ;
    rdfs:comment 'Indicates whether this authorization rule applies only to specific states due to state-level regulations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:applicableStates rdf:type rdf:Property ;
    rdfs:label 'Applicable States' ;
    rdfs:comment 'Comma-separated list of state codes where this authorization rule is applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsCoverageDetermination rdf:type rdf:Property ;
    rdfs:label 'Cms Coverage Determination' ;
    rdfs:comment 'Type of CMS coverage determination (National Coverage Determination or Local Coverage Determination) associated with this rule.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsDeterminationNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Determination Number' ;
    rdfs:comment 'Official CMS determination number for the NCD or LCD associated with this authorization rule.' ;
    rdfs:domain ind:AuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteId rdf:type rdf:Property ;
    rdfs:label 'Note Id' ;
    rdfs:comment 'Unique identifier for the clinical or care management note record.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:title rdf:type rdf:Property ;
    rdfs:label 'Title' ;
    rdfs:comment 'Brief descriptive title or subject line summarizing the content or purpose of the note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:content rdf:type rdf:Property ;
    rdfs:label 'Content' ;
    rdfs:comment 'Free-text or structured body of the note containing clinical observations, assessments, care plans, member interactions, and provider recommendations. May contain Protected Health Information (PHI).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityLevel rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Level' ;
    rdfs:comment 'Confidentiality classification of the note content, indicating special handling requirements for sensitive health information such as substance abuse treatment or mental health records.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorNpi rdf:type rdf:Property ;
    rdfs:label 'Author Npi' ;
    rdfs:comment 'National Provider Identifier of the healthcare provider or care manager who authored the note, if applicable.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorRole rdf:type rdf:Property ;
    rdfs:label 'Author Role' ;
    rdfs:comment 'Professional role or job function of the individual who authored the note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorDepartment rdf:type rdf:Property ;
    rdfs:label 'Author Department' ;
    rdfs:comment 'Department or organizational unit to which the note author belongs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signedDate rdf:type rdf:Property ;
    rdfs:label 'Signed Date' ;
    rdfs:comment 'Date when the note was electronically signed or approved by the author or reviewing provider.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:signedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Signed Timestamp' ;
    rdfs:comment 'Precise date and time when the note was electronically signed or approved by the author or reviewing provider.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:signedByName rdf:type rdf:Property ;
    rdfs:label 'Signed By Name' ;
    rdfs:comment 'Full name of the individual who electronically signed or approved the note.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signedByNpi rdf:type rdf:Property ;
    rdfs:label 'Signed By Npi' ;
    rdfs:comment 'National Provider Identifier of the healthcare provider who signed or approved the note.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encounterDate rdf:type rdf:Property ;
    rdfs:label 'Encounter Date' ;
    rdfs:comment 'Date of the clinical encounter, member interaction, or care event to which this note pertains.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:encounterType rdf:type rdf:Property ;
    rdfs:label 'Encounter Type' ;
    rdfs:comment 'Type of clinical encounter or member interaction documented in the note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programName rdf:type rdf:Property ;
    rdfs:label 'Program Name' ;
    rdfs:comment 'Name of the care management or disease management program under which this note was created (e.g., Diabetes Management, CHF Program, Behavioral Health).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chiefComplaint rdf:type rdf:Property ;
    rdfs:label 'Chief Complaint' ;
    rdfs:comment 'Primary reason for the member\'s contact or the main health concern documented in the note.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectiveFindings rdf:type rdf:Property ;
    rdfs:label 'Subjective Findings' ;
    rdfs:comment 'Subjective information reported by the member, including symptoms, concerns, and self-reported health status.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectiveFindings rdf:type rdf:Property ;
    rdfs:label 'Objective Findings' ;
    rdfs:comment 'Objective clinical observations, measurements, and assessment findings documented by the care manager or provider.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentSummary rdf:type rdf:Property ;
    rdfs:label 'Assessment Summary' ;
    rdfs:comment 'Clinical assessment and evaluation of the member\'s condition, including diagnosis and clinical judgment.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planOfCare rdf:type rdf:Property ;
    rdfs:label 'Plan Of Care' ;
    rdfs:comment 'Documented care plan, treatment recommendations, interventions, and follow-up actions for the member.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventions rdf:type rdf:Property ;
    rdfs:label 'Interventions' ;
    rdfs:comment 'Specific care management interventions, actions, or services provided to the member as documented in the note.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goals rdf:type rdf:Property ;
    rdfs:label 'Goals' ;
    rdfs:comment 'Documented care goals and objectives established for the member\'s treatment and health improvement.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adherenceStatus rdf:type rdf:Property ;
    rdfs:label 'Adherence Status' ;
    rdfs:comment 'Member\'s adherence to prescribed medications, treatment plans, or care recommendations as documented in the note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextContactDate rdf:type rdf:Property ;
    rdfs:label 'Next Contact Date' ;
    rdfs:comment 'Planned date for the next scheduled contact or interaction with the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contactMethod rdf:type rdf:Property ;
    rdfs:label 'Contact Method' ;
    rdfs:comment 'Method of communication or contact used for the member interaction documented in the note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Contact Duration Minutes' ;
    rdfs:comment 'Duration of the member contact or interaction in minutes, used for time tracking and billing purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:location rdf:type rdf:Property ;
    rdfs:label 'Location' ;
    rdfs:comment 'Physical or virtual location where the care management service or member interaction took place.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralMade rdf:type rdf:Property ;
    rdfs:label 'Referral Made' ;
    rdfs:comment 'Indicator of whether a referral to another provider, specialist, or service was made as documented in the note.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralToSpecialty rdf:type rdf:Property ;
    rdfs:label 'Referral To Specialty' ;
    rdfs:comment 'Medical specialty or service type to which the member was referred as documented in the note.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationList rdf:type rdf:Property ;
    rdfs:label 'Medication List' ;
    rdfs:comment 'List of current medications documented in the note, including prescription drugs, over-the-counter medications, and supplements.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationChanges rdf:type rdf:Property ;
    rdfs:label 'Medication Changes' ;
    rdfs:comment 'Documentation of any changes to the member\'s medication regimen, including new prescriptions, discontinuations, or dosage adjustments.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allergies rdf:type rdf:Property ;
    rdfs:label 'Allergies' ;
    rdfs:comment 'Documented allergies or adverse reactions to medications, foods, or environmental factors.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vitalSigns rdf:type rdf:Property ;
    rdfs:label 'Vital Signs' ;
    rdfs:comment 'Documented vital signs measurements such as blood pressure, heart rate, temperature, respiratory rate, and oxygen saturation.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:labResults rdf:type rdf:Property ;
    rdfs:label 'Lab Results' ;
    rdfs:comment 'Summary of relevant laboratory test results documented in the note.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMeasureMet rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Met' ;
    rdfs:comment 'Indicator of whether a quality measure or performance metric was met based on the care documented in the note.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gapInCare rdf:type rdf:Property ;
    rdfs:label 'Gap In Care' ;
    rdfs:comment 'Identified gap in care or missed preventive service documented in the note, such as overdue screenings or immunizations.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialDeterminants rdf:type rdf:Property ;
    rdfs:label 'Social Determinants' ;
    rdfs:comment 'Documentation of social determinants of health factors affecting the member, such as housing instability, food insecurity, transportation barriers, or social isolation.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:behavioralHealthConcerns rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Concerns' ;
    rdfs:comment 'Documented behavioral health or mental health concerns, including depression, anxiety, substance use, or other psychological conditions.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caregiverInvolvement rdf:type rdf:Property ;
    rdfs:label 'Caregiver Involvement' ;
    rdfs:comment 'Documentation of caregiver or family member involvement in the member\'s care, including their role and level of support.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargePlan rdf:type rdf:Property ;
    rdfs:label 'Discharge Plan' ;
    rdfs:comment 'Documented discharge plan for members transitioning from inpatient or facility-based care to home or community settings.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionOfCare rdf:type rdf:Property ;
    rdfs:label 'Transition Of Care' ;
    rdfs:comment 'Documentation of care transitions between care settings, providers, or levels of care, including coordination activities.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionRisk rdf:type rdf:Property ;
    rdfs:label 'Readmission Risk' ;
    rdfs:comment 'Assessed risk level for hospital readmission based on the member\'s condition and documented factors.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyDepartmentVisit rdf:type rdf:Property ;
    rdfs:label 'Emergency Department Visit' ;
    rdfs:comment 'Indicator of whether the note documents an emergency department visit or encounter.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalization rdf:type rdf:Property ;
    rdfs:label 'Hospitalization' ;
    rdfs:comment 'Indicator of whether the note documents an inpatient hospitalization or admission.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalNoteId rdf:type rdf:Property ;
    rdfs:label 'External Note Id' ;
    rdfs:comment 'Unique identifier for the note in the source system, used for cross-system reconciliation and integration.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentFormat rdf:type rdf:Property ;
    rdfs:label 'Document Format' ;
    rdfs:comment 'Format or structure of the note content, indicating whether it is plain text, structured data, or a specific clinical document standard.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentReason rdf:type rdf:Property ;
    rdfs:label 'Amendment Reason' ;
    rdfs:comment 'Reason for amending or revising the note after initial creation and signature.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addendum rdf:type rdf:Property ;
    rdfs:label 'Addendum' ;
    rdfs:comment 'Additional information or clarification added to the note after initial completion, documented separately from the original content.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedDate rdf:type rdf:Property ;
    rdfs:label 'Reviewed Date' ;
    rdfs:comment 'Date when the note was reviewed by a supervisor or quality assurance reviewer.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cosignedByName rdf:type rdf:Property ;
    rdfs:label 'Cosigned By Name' ;
    rdfs:comment 'Full name of the individual who cosigned the note, typically a supervising provider or clinical reviewer.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cosignedDate rdf:type rdf:Property ;
    rdfs:label 'Cosigned Date' ;
    rdfs:comment 'Date when the note was cosigned by a supervising provider or clinical reviewer.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deletedDate rdf:type rdf:Property ;
    rdfs:label 'Deleted Date' ;
    rdfs:comment 'Date when the note was marked as deleted or voided in the system.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deletedReason rdf:type rdf:Property ;
    rdfs:label 'Deleted Reason' ;
    rdfs:comment 'Reason for deleting or voiding the note, such as duplicate entry or entered in error.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archivedDate rdf:type rdf:Property ;
    rdfs:label 'Archived Date' ;
    rdfs:comment 'Date when the note was archived for long-term retention and removed from active use.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalHold rdf:type rdf:Property ;
    rdfs:label 'Legal Hold' ;
    rdfs:comment 'Indicator of whether the note is subject to a legal hold or preservation order, preventing deletion or modification.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authStatusId rdf:type rdf:Property ;
    rdfs:label 'Auth Status Id' ;
    rdfs:comment 'Unique identifier for the authorization status record. Primary key for the authorization status reference data.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuthStatus .

ind:isFinal rdf:type rdf:Property ;
    rdfs:label 'Is Final' ;
    rdfs:comment 'Indicates whether this status represents a final determination in the authorization process (e.g., Approved, Denied). Final statuses typically trigger downstream actions such as notification generation and claims processing enablement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresNotification rdf:type rdf:Property ;
    rdfs:label 'Requires Notification' ;
    rdfs:comment 'Indicates whether a status change to this value requires notification to the member, provider, or both. Used to trigger automated notification workflows and ensure compliance with regulatory notification timeframes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsPartialApproval rdf:type rdf:Property ;
    rdfs:label 'Allows Partial Approval' ;
    rdfs:comment 'Indicates whether this status supports partial approval scenarios where some requested services are approved while others are denied. Used in complex authorization requests involving multiple services or units.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresPeerToPeer rdf:type rdf:Property ;
    rdfs:label 'Requires Peer To Peer' ;
    rdfs:comment 'Indicates whether this status requires or allows peer-to-peer consultation between the requesting provider and a plan medical director. Typically applicable to statuses where initial clinical review suggests denial but provider input is needed before final determination.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaHours rdf:type rdf:Property ;
    rdfs:label 'Sla Hours' ;
    rdfs:comment 'Maximum number of hours an authorization can remain in this status before breaching service level agreement commitments. Used for monitoring turnaround time performance and ensuring regulatory compliance with prompt determination requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationRequired rdf:type rdf:Property ;
    rdfs:label 'Escalation Required' ;
    rdfs:comment 'Indicates whether authorizations in this status require escalation to senior clinical staff or management. Used for complex cases, high-risk determinations, or situations requiring additional oversight.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:denialReasonRequired rdf:type rdf:Property ;
    rdfs:label 'Denial Reason Required' ;
    rdfs:comment 'Indicates whether a denial reason code and explanation must be provided when an authorization is assigned this status. Ensures compliance with regulatory requirements for transparent denial communications.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsRetroAuthorization rdf:type rdf:Property ;
    rdfs:label 'Allows Retro Authorization' ;
    rdfs:comment 'Indicates whether this status can be applied to retrospective authorization requests (authorizations requested after service delivery). Used to distinguish between prospective and retrospective authorization workflows.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:x12278StatusCode rdf:type rdf:Property ;
    rdfs:label 'X12 278 Status Code' ;
    rdfs:comment 'Standard ANSI X12 278 transaction set status code corresponding to this authorization status. Used for Electronic Data Interchange (EDI) transactions with providers and ensures interoperability with industry-standard authorization request and response formats.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hl7StatusCode rdf:type rdf:Property ;
    rdfs:label 'Hl7 Status Code' ;
    rdfs:comment 'HL7 standard status code corresponding to this authorization status. Used for integration with Electronic Health Record (EHR) systems and Health Information Exchange (HIE) platforms supporting HL7 messaging standards.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncpdpStatusCode rdf:type rdf:Property ;
    rdfs:label 'Ncpdp Status Code' ;
    rdfs:comment 'NCPDP standard status code for pharmacy prior authorization transactions. Used when this status applies to pharmacy benefit management authorization workflows and ensures compliance with pharmacy industry EDI standards.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsStatusCategory rdf:type rdf:Property ;
    rdfs:label 'Cms Status Category' ;
    rdfs:comment 'CMS-defined status category for Medicare Advantage and Part D authorization reporting. Used for regulatory reporting and compliance with CMS organization determination and coverage determination requirements.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateReportingCode rdf:type rdf:Property ;
    rdfs:label 'State Reporting Code' ;
    rdfs:comment 'State-specific authorization status code used for regulatory reporting to state departments of insurance. Varies by state and supports compliance with state-specific utilization management reporting requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncqaHedisReportable rdf:type rdf:Property ;
    rdfs:label 'Ncqa Hedis Reportable' ;
    rdfs:comment 'Indicates whether authorizations in this status should be included in HEDIS quality measure reporting. Used to ensure accurate quality reporting and NCQA accreditation compliance.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impactsMedicalLossRatio rdf:type rdf:Property ;
    rdfs:label 'Impacts Medical Loss Ratio' ;
    rdfs:comment 'Indicates whether authorizations in this status impact Medical Loss Ratio calculations for ACA compliance. Final approved statuses typically impact MLR as they represent committed medical expenses.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggersClaimsProcessing rdf:type rdf:Property ;
    rdfs:label 'Triggers Claims Processing' ;
    rdfs:comment 'Indicates whether this status enables or triggers claims processing for the authorized services. Approved statuses typically trigger claims processing, while denied or pending statuses prevent claim payment.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsConcurrentReview rdf:type rdf:Property ;
    rdfs:label 'Allows Concurrent Review' ;
    rdfs:comment 'Indicates whether authorizations in this status are eligible for concurrent review (ongoing review during service delivery, typically for inpatient stays). Used to manage continued stay reviews and ensure appropriate length of stay.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsRetrospectiveReview rdf:type rdf:Property ;
    rdfs:label 'Allows Retrospective Review' ;
    rdfs:comment 'Indicates whether authorizations in this status can undergo retrospective review after service delivery. Used for post-service medical necessity determinations and payment recovery scenarios.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberPortalVisible rdf:type rdf:Property ;
    rdfs:label 'Member Portal Visible' ;
    rdfs:comment 'Indicates whether this status should be displayed to members in self-service portals and mobile applications. Some internal workflow statuses may be hidden from member view to avoid confusion.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerPortalVisible rdf:type rdf:Property ;
    rdfs:label 'Provider Portal Visible' ;
    rdfs:comment 'Indicates whether this status should be displayed to providers in provider portals and through Availity or other provider-facing systems. Used to control information sharing with network providers.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interqualStatusMapping rdf:type rdf:Property ;
    rdfs:label 'Interqual Status Mapping' ;
    rdfs:comment 'Mapping to corresponding status values in InterQual clinical decision support system. Used for integration with InterQual medical necessity guidelines and automated determination workflows.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mcgStatusMapping rdf:type rdf:Property ;
    rdfs:label 'Mcg Status Mapping' ;
    rdfs:comment 'Mapping to corresponding status values in MCG (Milliman Care Guidelines) clinical decision support system. Used for integration with MCG care guidelines and evidence-based determination workflows.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pegaStatusCode rdf:type rdf:Property ;
    rdfs:label 'Pega Status Code' ;
    rdfs:comment 'Status code used in Pegasystems Healthcare platform for care management and utilization management workflows. Enables integration with Pega case management and business process automation.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facetsStatusCode rdf:type rdf:Property ;
    rdfs:label 'Facets Status Code' ;
    rdfs:comment 'Status code used in TriZetto Facets claims administration system. Enables integration with Facets authorization module and ensures consistent status representation across core administration platforms.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qnxtStatusCode rdf:type rdf:Property ;
    rdfs:label 'Qnxt Status Code' ;
    rdfs:comment 'Status code used in TriZetto QNXT core administration platform. Supports integration with QNXT membership, claims, and provider network modules for end-to-end authorization processing.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresSupervisorApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Supervisor Approval' ;
    rdfs:comment 'Indicates whether transitioning an authorization to this status requires supervisor or manager approval. Used for high-risk determinations, large dollar amounts, or sensitive cases requiring additional oversight.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grievanceEligible rdf:type rdf:Property ;
    rdfs:label 'Grievance Eligible' ;
    rdfs:comment 'Indicates whether authorizations in this status can trigger member grievance filing. Used to identify statuses that may result in member dissatisfaction and require grievance tracking.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expeditedReviewEligible rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Eligible' ;
    rdfs:comment 'Indicates whether authorizations in this status can be processed through expedited review timeframes when the standard timeframe could seriously jeopardize the member\'s life, health, or ability to regain maximum function.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standardReviewHours rdf:type rdf:Property ;
    rdfs:label 'Standard Review Hours' ;
    rdfs:comment 'Maximum number of hours allowed for standard (non-expedited) review when an authorization is in this status. Used to ensure compliance with regulatory requirements for timely authorization determinations.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expeditedReviewHours rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Hours' ;
    rdfs:comment 'Maximum number of hours allowed for expedited review when an authorization is in this status and meets expedited criteria. Typically 72 hours or less per regulatory requirements.' ;
    rdfs:domain ind:AuthStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:userSelectable rdf:type rdf:Property ;
    rdfs:label 'User Selectable' ;
    rdfs:comment 'Indicates whether this status can be manually selected by users in authorization workflows. Some statuses may be system-only and not available for manual assignment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalReasonId rdf:type rdf:Property ;
    rdfs:label 'Approval Reason Id' ;
    rdfs:comment 'Unique identifier for the approval reason record. Primary key for the approval reason catalog.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApprovalReason .

ind:guidelineVersion rdf:type rdf:Property ;
    rdfs:label 'Guideline Version' ;
    rdfs:comment 'Version number or edition of the clinical guideline referenced for this approval reason. Ensures traceability to specific guideline releases.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryBasis rdf:type rdf:Property ;
    rdfs:label 'Regulatory Basis' ;
    rdfs:comment 'The regulatory requirement or mandate that supports this approval reason. References specific laws, regulations, or compliance requirements (e.g., ACA, HIPAA, state mandates).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTypeCategory rdf:type rdf:Property ;
    rdfs:label 'Service Type Category' ;
    rdfs:comment 'The category of healthcare service for which this approval reason is applicable. Defines the scope of services covered by this reason.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptCodeApplicability rdf:type rdf:Property ;
    rdfs:label 'Cpt Code Applicability' ;
    rdfs:comment 'Comma-separated list or range of CPT codes for which this approval reason is applicable. Defines specific procedures covered by this reason.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10CodeApplicability rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code Applicability' ;
    rdfs:comment 'Comma-separated list or range of ICD-10 diagnosis codes for which this approval reason is applicable. Defines specific diagnoses covered by this reason.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hcpcsCodeApplicability rdf:type rdf:Property ;
    rdfs:label 'Hcpcs Code Applicability' ;
    rdfs:comment 'Comma-separated list or range of HCPCS codes for which this approval reason is applicable. Defines specific supplies, equipment, or services covered by this reason.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgApplicability rdf:type rdf:Property ;
    rdfs:label 'Drg Applicability' ;
    rdfs:comment 'Comma-separated list of DRG codes for which this approval reason is applicable. Used for inpatient authorization decisions.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardTatHours rdf:type rdf:Property ;
    rdfs:label 'Standard Tat Hours' ;
    rdfs:comment 'The standard turnaround time in hours for processing authorization requests with this approval reason. Used for SLA tracking and performance monitoring.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expeditedTatHours rdf:type rdf:Property ;
    rdfs:label 'Expedited Tat Hours' ;
    rdfs:comment 'The expedited turnaround time in hours for urgent authorization requests with this approval reason. Used when member condition requires faster processing.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:replacementReasonCode rdf:type rdf:Property ;
    rdfs:label 'Replacement Reason Code' ;
    rdfs:comment 'The code of the approval reason that replaces this one if retired. Used for mapping and transition management.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudRiskIndicator rdf:type rdf:Property ;
    rdfs:label 'Fraud Risk Indicator' ;
    rdfs:comment 'Risk level for potential fraud, waste, or abuse associated with this approval reason. Used to trigger enhanced scrutiny or Special Investigations Unit (SIU) review.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costImpactLevel rdf:type rdf:Property ;
    rdfs:label 'Cost Impact Level' ;
    rdfs:comment 'The typical cost impact level of services approved using this reason. Used for financial forecasting and utilization management prioritization.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilizationThresholdFlag rdf:type rdf:Property ;
    rdfs:label 'Utilization Threshold Flag' ;
    rdfs:comment 'Indicates whether this approval reason is subject to utilization thresholds or frequency limits. True if usage monitoring and controls apply.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retrospectiveReviewEligible rdf:type rdf:Property ;
    rdfs:label 'Retrospective Review Eligible' ;
    rdfs:comment 'Indicates whether services approved with this reason are eligible for retrospective review after service delivery. True if post-service review may occur.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkRestriction rdf:type rdf:Property ;
    rdfs:label 'Network Restriction' ;
    rdfs:comment 'Network requirements associated with this approval reason. Specifies whether services must be delivered by in-network, out-of-network, or specialized providers.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerSpecialtyRequirement rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Requirement' ;
    rdfs:comment 'Required provider specialty or credential for services approved with this reason. Comma-separated list of specialty codes or descriptions.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityTypeRequirement rdf:type rdf:Property ;
    rdfs:label 'Facility Type Requirement' ;
    rdfs:comment 'Required facility type or accreditation for services approved with this reason. Examples: acute care hospital, ambulatory surgery center (ASC), skilled nursing facility (SNF).' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxUnitsPerAuthorization rdf:type rdf:Property ;
    rdfs:label 'Max Units Per Authorization' ;
    rdfs:comment 'Maximum number of service units (visits, procedures, days) that can be approved in a single authorization using this reason. Null if no limit applies.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:extensionAllowed rdf:type rdf:Property ;
    rdfs:label 'Extension Allowed' ;
    rdfs:comment 'Indicates whether authorizations using this approval reason can be extended beyond the initial duration. True if extensions are permitted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconsiderationAllowed rdf:type rdf:Property ;
    rdfs:label 'Reconsideration Allowed' ;
    rdfs:comment 'Indicates whether providers can request reconsideration of authorization decisions using this approval reason. True if reconsideration process is available.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberCostShareImpact rdf:type rdf:Property ;
    rdfs:label 'Member Cost Share Impact' ;
    rdfs:comment 'Indicates how this approval reason affects member cost-sharing (copay, coinsurance, deductible). Used for benefit determination and member communication.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthWaiverEligible rdf:type rdf:Property ;
    rdfs:label 'Prior Auth Waiver Eligible' ;
    rdfs:comment 'Indicates whether this approval reason can be used to waive prior authorization requirements in specific circumstances. True if PA waiver is possible.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:goldCardEligible rdf:type rdf:Property ;
    rdfs:label 'Gold Card Eligible' ;
    rdfs:comment 'Indicates whether this approval reason is eligible for gold card or auto-approval programs for high-performing providers. True if gold card benefits apply.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careCoordinationRequired rdf:type rdf:Property ;
    rdfs:label 'Care Coordination Required' ;
    rdfs:comment 'Indicates whether care coordination or case management involvement is required for services approved with this reason. True if care management engagement is needed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueBasedCareIndicator rdf:type rdf:Property ;
    rdfs:label 'Value Based Care Indicator' ;
    rdfs:comment 'Indicates whether this approval reason is associated with value-based care arrangements, alternative payment models (APM), or accountable care organizations (ACO). True if VBC alignment exists.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Approval Authority Level' ;
    rdfs:comment 'The level of authority required to approve authorization requests using this reason. Defines who can make the approval decision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hl7Code rdf:type rdf:Property ;
    rdfs:label 'Hl7 Code' ;
    rdfs:comment 'The HL7 or FHIR code used when transmitting this approval reason in interoperability exchanges. Used for health information exchange (HIE) and EHR integration.' ;
    rdfs:domain ind:ApprovalReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityLevelId rdf:type rdf:Property ;
    rdfs:label 'Priority Level Id' ;
    rdfs:comment 'Unique identifier for the priority level record. Primary key for the priority level entity.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PriorityLevel .

ind:severityRank rdf:type rdf:Property ;
    rdfs:label 'Severity Rank' ;
    rdfs:comment 'Numeric ranking indicating the relative urgency or severity of this priority level. Lower numbers indicate higher urgency (e.g., 1=most urgent).' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaResponseHours rdf:type rdf:Property ;
    rdfs:label 'Sla Response Hours' ;
    rdfs:comment 'Target number of hours within which an initial response must be provided for authorization requests at this priority level.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDecisionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Decision Hours' ;
    rdfs:comment 'Target number of hours within which a final authorization decision must be rendered for requests at this priority level.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaBusinessDays rdf:type rdf:Property ;
    rdfs:label 'Sla Business Days' ;
    rdfs:comment 'Target number of business days for authorization decision completion at this priority level, excluding weekends and holidays.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresImmediateReview rdf:type rdf:Property ;
    rdfs:label 'Requires Immediate Review' ;
    rdfs:comment 'Indicates whether authorization requests at this priority level require immediate clinical review without queuing delays.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoEscalationEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Escalation Enabled' ;
    rdfs:comment 'Indicates whether authorization requests at this priority level are automatically escalated if SLA thresholds are approaching or breached.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationThresholdHours rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Hours' ;
    rdfs:comment 'Number of hours before SLA breach at which automatic escalation is triggered for this priority level.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationFrequencyHours rdf:type rdf:Property ;
    rdfs:label 'Notification Frequency Hours' ;
    rdfs:comment 'Frequency in hours at which status notifications are sent to stakeholders for authorization requests at this priority level.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Clinical Review Required' ;
    rdfs:comment 'Indicates whether authorization requests at this priority level must undergo clinical review by a licensed healthcare professional.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerToPeerEligible rdf:type rdf:Property ;
    rdfs:label 'Peer To Peer Eligible' ;
    rdfs:comment 'Indicates whether providers can request peer-to-peer clinical discussions for authorization requests at this priority level.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expeditedAppealEligible rdf:type rdf:Property ;
    rdfs:label 'Expedited Appeal Eligible' ;
    rdfs:comment 'Indicates whether denials at this priority level are eligible for expedited appeal processes due to urgency.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:afterHoursProcessing rdf:type rdf:Property ;
    rdfs:label 'After Hours Processing' ;
    rdfs:comment 'Indicates whether authorization requests at this priority level are processed outside standard business hours (evenings, weekends, holidays).' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weekendProcessing rdf:type rdf:Property ;
    rdfs:label 'Weekend Processing' ;
    rdfs:comment 'Indicates whether authorization requests at this priority level are processed on weekends.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holidayProcessing rdf:type rdf:Property ;
    rdfs:label 'Holiday Processing' ;
    rdfs:comment 'Indicates whether authorization requests at this priority level are processed on company holidays.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToInpatient rdf:type rdf:Property ;
    rdfs:label 'Applies To Inpatient' ;
    rdfs:comment 'Indicates whether this priority level applies to inpatient hospital admissions and services.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToOutpatient rdf:type rdf:Property ;
    rdfs:label 'Applies To Outpatient' ;
    rdfs:comment 'Indicates whether this priority level applies to outpatient procedures and services.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToPharmacy rdf:type rdf:Property ;
    rdfs:label 'Applies To Pharmacy' ;
    rdfs:comment 'Indicates whether this priority level applies to pharmacy benefit prior authorizations.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToDme rdf:type rdf:Property ;
    rdfs:label 'Applies To Dme' ;
    rdfs:comment 'Indicates whether this priority level applies to durable medical equipment authorization requests.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToBehavioralHealth rdf:type rdf:Property ;
    rdfs:label 'Applies To Behavioral Health' ;
    rdfs:comment 'Indicates whether this priority level applies to behavioral health and mental health service authorizations.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToHomeHealth rdf:type rdf:Property ;
    rdfs:label 'Applies To Home Health' ;
    rdfs:comment 'Indicates whether this priority level applies to home health service authorization requests.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToLtss rdf:type rdf:Property ;
    rdfs:label 'Applies To Ltss' ;
    rdfs:comment 'Indicates whether this priority level applies to long-term services and supports authorization requests.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryTimeframeDays rdf:type rdf:Property ;
    rdfs:label 'Regulatory Timeframe Days' ;
    rdfs:comment 'Regulatory maximum number of days allowed for authorization decision at this priority level, as mandated by CMS or state regulations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:displayColorCode rdf:type rdf:Property ;
    rdfs:label 'Display Color Code' ;
    rdfs:comment 'Hexadecimal color code used for visual display of this priority level in user interfaces (e.g., red for urgent, yellow for routine).' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayIcon rdf:type rdf:Property ;
    rdfs:label 'Display Icon' ;
    rdfs:comment 'Icon identifier or name used for visual representation of this priority level in user interfaces.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interqualMappingCode rdf:type rdf:Property ;
    rdfs:label 'Interqual Mapping Code' ;
    rdfs:comment 'Code used to map this priority level to InterQual clinical decision support criteria and urgency classifications.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mcgMappingCode rdf:type rdf:Property ;
    rdfs:label 'Mcg Mapping Code' ;
    rdfs:comment 'Code used to map this priority level to MCG clinical guidelines and urgency classifications.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsPriorityIndicator rdf:type rdf:Property ;
    rdfs:label 'Cms Priority Indicator' ;
    rdfs:comment 'CMS-defined priority classification (standard or expedited) that aligns with federal regulatory requirements for authorization timeframes.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateRegulatoryCode rdf:type rdf:Property ;
    rdfs:label 'State Regulatory Code' ;
    rdfs:comment 'State-specific regulatory code or classification for this priority level, supporting compliance with state insurance department requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncqaComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Ncqa Compliance Flag' ;
    rdfs:comment 'Indicates whether this priority level definition meets NCQA utilization management accreditation standards.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uracComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Urac Compliance Flag' ;
    rdfs:comment 'Indicates whether this priority level definition meets URAC utilization review accreditation standards.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToMedicare rdf:type rdf:Property ;
    rdfs:label 'Applies To Medicare' ;
    rdfs:comment 'Indicates whether this priority level applies to Medicare Advantage and Medicare Part D authorization requests.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToMedicaid rdf:type rdf:Property ;
    rdfs:label 'Applies To Medicaid' ;
    rdfs:comment 'Indicates whether this priority level applies to Medicaid managed care authorization requests.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToCommercial rdf:type rdf:Property ;
    rdfs:label 'Applies To Commercial' ;
    rdfs:comment 'Indicates whether this priority level applies to commercial health insurance authorization requests.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToExchange rdf:type rdf:Property ;
    rdfs:label 'Applies To Exchange' ;
    rdfs:comment 'Indicates whether this priority level applies to Affordable Care Act (ACA) marketplace/exchange plan authorization requests.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concurrentReviewIntervalHours rdf:type rdf:Property ;
    rdfs:label 'Concurrent Review Interval Hours' ;
    rdfs:comment 'Frequency in hours at which concurrent review must be performed for ongoing services authorized at this priority level.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationTemplateId rdf:type rdf:Property ;
    rdfs:label 'Notification Template Id' ;
    rdfs:comment 'Identifier for the communication template used for member and provider notifications at this priority level.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NotificationTemplate .

ind:workflowRoutingRule rdf:type rdf:Property ;
    rdfs:label 'Workflow Routing Rule' ;
    rdfs:comment 'Business rule or logic identifier that determines how authorization requests at this priority level are routed to review queues and staff.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalDirectorReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Medical Director Review Required' ;
    rdfs:comment 'Indicates whether authorization requests at this priority level require review and approval by a medical director.' ;
    rdfs:domain ind:PriorityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizationDenialReasonId rdf:type rdf:Property ;
    rdfs:label 'Authorization Denial Reason Id' ;
    rdfs:comment 'Unique identifier for the denial reason record. Primary key for the denial reason catalog.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuthorizationDenialReason .

ind:cmsDenialCode rdf:type rdf:Property ;
    rdfs:label 'Cms Denial Code' ;
    rdfs:comment 'Standard CMS denial code mapping for Medicare and Medicaid claims processing and reporting compliance.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carcCode rdf:type rdf:Property ;
    rdfs:label 'Carc Code' ;
    rdfs:comment 'Standard CARC code used in ANSI X12 835 remittance advice transactions to communicate claim adjustment reasons to providers.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rarcCode rdf:type rdf:Property ;
    rdfs:label 'Rarc Code' ;
    rdfs:comment 'Standard RARC code providing additional explanation or information about claim adjustments in remittance advice transactions.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialType rdf:type rdf:Property ;
    rdfs:label 'Denial Type' ;
    rdfs:comment 'Classification indicating whether the denial is permanent (hard), correctable (soft), or applies to a portion of the request (partial).' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealableFlag rdf:type rdf:Property ;
    rdfs:label 'Appealable Flag' ;
    rdfs:comment 'Indicator of whether the denial reason allows for member or provider appeal under plan terms and regulatory requirements.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconsiderationAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Reconsideration Allowed Flag' ;
    rdfs:comment 'Indicator of whether the denial can be reconsidered with additional clinical documentation or information without formal appeal.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Notification Required Flag' ;
    rdfs:comment 'Indicator of whether the provider must be formally notified of this denial reason per contractual or regulatory requirements.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Member Notification Required Flag' ;
    rdfs:comment 'Indicator of whether the member must receive formal notification of this denial reason per plan terms and regulatory requirements.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eobDisplayText rdf:type rdf:Property ;
    rdfs:label 'Eob Display Text' ;
    rdfs:comment 'Member-friendly text to be displayed on the Explanation of Benefits document explaining the denial reason in plain language.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerDisplayText rdf:type rdf:Property ;
    rdfs:label 'Provider Display Text' ;
    rdfs:comment 'Provider-facing text explaining the denial reason and any corrective actions or documentation needed for reconsideration.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Medical Policy Number' ;
    rdfs:comment 'Identifier of the internal medical policy document that defines the coverage criteria related to this denial reason.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialLevel rdf:type rdf:Property ;
    rdfs:label 'Denial Level' ;
    rdfs:comment 'The level at which this denial reason is applied (entire claim, individual service line, authorization request, etc.).' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Flag' ;
    rdfs:comment 'Indicator of whether this denial reason results in financial adjustment (payment reduction or denial) versus informational only.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberLiabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Member Liability Flag' ;
    rdfs:comment 'Indicator of whether the member may be held financially liable for services denied under this reason.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerLiabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Liability Flag' ;
    rdfs:comment 'Indicator of whether the provider must absorb the cost and cannot bill the member for services denied under this reason.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Reporting Flag' ;
    rdfs:comment 'Indicator of whether denials using this reason must be reported for quality measurement or regulatory reporting (HEDIS, NCQA).' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudWasteAbuseIndicator rdf:type rdf:Property ;
    rdfs:label 'Fraud Waste Abuse Indicator' ;
    rdfs:comment 'Flag indicating whether this denial reason is associated with potential fraud, waste, or abuse requiring special investigations unit review.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Peer Review Required Flag' ;
    rdfs:comment 'Indicator of whether this denial reason requires physician peer-to-peer review before final determination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoDenialEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Denial Eligible Flag' ;
    rdfs:comment 'Indicator of whether this denial reason can be applied through automated system rules without manual review.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Override Allowed Flag' ;
    rdfs:comment 'Indicator of whether authorized personnel can override this denial reason with appropriate justification and approval.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:replacementCode rdf:type rdf:Property ;
    rdfs:label 'Replacement Code' ;
    rdfs:comment 'The denial reason code that supersedes this code when it is deprecated, facilitating historical mapping and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalCodeMapping rdf:type rdf:Property ;
    rdfs:label 'External Code Mapping' ;
    rdfs:comment 'Mapping to external payer or clearinghouse denial codes for interoperability and data exchange with trading partners.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialPriority rdf:type rdf:Property ;
    rdfs:label 'Denial Priority' ;
    rdfs:comment 'Priority classification indicating the urgency or importance of addressing denials with this reason for operational management.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionGuidance rdf:type rdf:Property ;
    rdfs:label 'Resolution Guidance' ;
    rdfs:comment 'Detailed instructions for providers or members on how to resolve or appeal denials with this reason, including required documentation.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expeditedReviewEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Eligible Flag' ;
    rdfs:comment 'Indicator of whether denials with this reason qualify for expedited appeal or reconsideration when member health is at risk.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateSpecificFlag rdf:type rdf:Property ;
    rdfs:label 'State Specific Flag' ;
    rdfs:comment 'Indicator of whether this denial reason applies only to specific states due to state-specific regulations or mandates.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Reportable Flag' ;
    rdfs:comment 'Indicator of whether denials with this reason must be reported to CMS for Medicare Advantage or Part D oversight and monitoring.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncqaReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Ncqa Reportable Flag' ;
    rdfs:comment 'Indicator of whether denials with this reason must be included in NCQA accreditation or HEDIS quality reporting.' ;
    rdfs:domain ind:AuthorizationDenialReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestTypeId rdf:type rdf:Property ;
    rdfs:label 'Request Type Id' ;
    rdfs:comment 'Unique identifier for the authorization request type classification.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RequestType .

ind:standardTurnaroundTimeHours rdf:type rdf:Property ;
    rdfs:label 'Standard Turnaround Time Hours' ;
    rdfs:comment 'Expected number of hours for processing and decision on this request type under normal circumstances, used for Service Level Agreement (SLA) tracking.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expeditedTurnaroundTimeHours rdf:type rdf:Property ;
    rdfs:label 'Expedited Turnaround Time Hours' ;
    rdfs:comment 'Accelerated processing timeframe in hours when the request type is flagged for expedited review due to clinical urgency.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresMedicalDirectorReview rdf:type rdf:Property ;
    rdfs:label 'Requires Medical Director Review' ;
    rdfs:comment 'Indicates whether requests of this type require escalation to a Medical Director for final determination, typically for denials or complex cases.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresSupportingDocumentation rdf:type rdf:Property ;
    rdfs:label 'Requires Supporting Documentation' ;
    rdfs:comment 'Indicates whether clinical documentation, medical records, or other supporting materials must be submitted with requests of this type.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:applicableServiceTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Service Types' ;
    rdfs:comment 'Comma-separated list of healthcare service types that can be requested under this request type (e.g., inpatient, outpatient, DME, home health).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableLinesOfBusiness rdf:type rdf:Property ;
    rdfs:label 'Applicable Lines Of Business' ;
    rdfs:comment 'Comma-separated list of insurance product lines where this request type is valid (e.g., Commercial, Medicare Advantage, Medicaid, Exchange).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retroactiveReviewAllowed rdf:type rdf:Property ;
    rdfs:label 'Retroactive Review Allowed' ;
    rdfs:comment 'Indicates whether this request type can be submitted for services already rendered, allowing retrospective authorization review.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxAuthorizationDurationDays rdf:type rdf:Property ;
    rdfs:label 'Max Authorization Duration Days' ;
    rdfs:comment 'Default maximum number of days an authorization can be valid for this request type before renewal is required.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalRequired rdf:type rdf:Property ;
    rdfs:label 'Renewal Required' ;
    rdfs:comment 'Indicates whether authorizations granted under this request type require periodic renewal or can be open-ended.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerTypeRestrictions rdf:type rdf:Property ;
    rdfs:label 'Provider Type Restrictions' ;
    rdfs:comment 'Comma-separated list of provider types or specialties authorized to submit requests of this type (e.g., PCP, specialist, facility).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMeasureApplicable rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Applicable' ;
    rdfs:comment 'Indicates whether authorizations of this type are tracked for Healthcare Effectiveness Data and Information Set (HEDIS) or other quality reporting measures.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureName rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Name' ;
    rdfs:comment 'Name of the specific Healthcare Effectiveness Data and Information Set (HEDIS) or quality measure associated with this request type.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careManagementIntegration rdf:type rdf:Property ;
    rdfs:label 'Care Management Integration' ;
    rdfs:comment 'Indicates whether requests of this type trigger automatic integration with care management programs or case management workflows.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Fraud Risk Level' ;
    rdfs:comment 'Assessment of the fraud, waste, and abuse risk associated with this request type, determining level of scrutiny and audit frequency.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberCostShareApplicable rdf:type rdf:Property ;
    rdfs:label 'Member Cost Share Applicable' ;
    rdfs:comment 'Indicates whether member cost-sharing (copay, coinsurance, deductible) information should be calculated and communicated for this request type.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyBenefitType rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Benefit Type' ;
    rdfs:comment 'Indicates whether this request type is specific to pharmacy benefits and Pharmacy Benefit Manager (PBM) processing rather than medical benefits.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthType rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Type' ;
    rdfs:comment 'Indicates whether this request type is specific to behavioral health, mental health, or substance use disorder services requiring specialized review.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemGeneratedOnly rdf:type rdf:Property ;
    rdfs:label 'System Generated Only' ;
    rdfs:comment 'Indicates whether this request type is exclusively created by automated system processes rather than manual user submission.' ;
    rdfs:domain ind:RequestType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authOverrideId rdf:type rdf:Property ;
    rdfs:label 'Auth Override Id' ;
    rdfs:comment 'Unique identifier for the authorization override record.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overrideType rdf:type rdf:Property ;
    rdfs:label 'Override Type' ;
    rdfs:comment 'Category of override indicating the reason for bypassing standard authorization rules.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalDecision rdf:type rdf:Property ;
    rdfs:label 'Original Decision' ;
    rdfs:comment 'The initial determination made by the standard authorization process before override.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Original Decision Date' ;
    rdfs:comment 'Date when the initial authorization decision was made prior to override.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overrideDecision rdf:type rdf:Property ;
    rdfs:label 'Override Decision' ;
    rdfs:comment 'Final determination after the override was applied to the authorization request.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Override Decision Date' ;
    rdfs:comment 'Date when the override decision was finalized and documented.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overrideDecisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Override Decision Timestamp' ;
    rdfs:comment 'Precise date and time when the override decision was recorded in the system.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approverTitle rdf:type rdf:Property ;
    rdfs:label 'Approver Title' ;
    rdfs:comment 'Professional title or role of the individual who granted the override (e.g., Medical Director, Chief Medical Officer).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverCredentials rdf:type rdf:Property ;
    rdfs:label 'Approver Credentials' ;
    rdfs:comment 'Professional credentials of the approver (e.g., MD, DO, RN, PharmD) demonstrating clinical qualification.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverSpecialty rdf:type rdf:Property ;
    rdfs:label 'Approver Specialty' ;
    rdfs:comment 'Clinical specialty or area of expertise of the approving clinician.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverNpi rdf:type rdf:Property ;
    rdfs:label 'Approver Npi' ;
    rdfs:comment 'Ten-digit National Provider Identifier of the clinical professional who approved the override.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingProviderProviderProfileId rdf:type rdf:Property ;
    rdfs:label 'Requesting Provider Provider Profile Id' ;
    rdfs:comment 'Unique identifier of the healthcare provider who submitted the original authorization request.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Profile .

ind:authorizedUnits rdf:type rdf:Property ;
    rdfs:label 'Authorized Units' ;
    rdfs:comment 'Number of service units approved through the override (e.g., visits, days, procedures).' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizedAmount rdf:type rdf:Property ;
    rdfs:label 'Authorized Amount' ;
    rdfs:comment 'Maximum dollar amount approved for the service through the authorization override.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peerReviewConducted rdf:type rdf:Property ;
    rdfs:label 'Peer Review Conducted' ;
    rdfs:comment 'Indicates whether a peer-to-peer review was conducted before granting the override.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReviewerName rdf:type rdf:Property ;
    rdfs:label 'Peer Reviewer Name' ;
    rdfs:comment 'Name of the clinical peer reviewer who participated in the override evaluation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerReviewerSpecialty rdf:type rdf:Property ;
    rdfs:label 'Peer Reviewer Specialty' ;
    rdfs:comment 'Medical specialty of the peer reviewer, ideally matching the service specialty.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuityOfCareFlag rdf:type rdf:Property ;
    rdfs:label 'Continuity Of Care Flag' ;
    rdfs:comment 'Indicates whether the override was granted to maintain continuity of care for the member.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transitionOfCareFlag rdf:type rdf:Property ;
    rdfs:label 'Transition Of Care Flag' ;
    rdfs:comment 'Indicates whether the override supports a transition of care scenario (e.g., new member, plan change).' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Flag' ;
    rdfs:comment 'Indicates whether the override was granted due to emergency medical circumstances.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifeThreateningCondition rdf:type rdf:Property ;
    rdfs:label 'Life Threatening Condition' ;
    rdfs:comment 'Indicates whether the member\'s condition was deemed life-threatening, warranting the override.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:experimentalTreatmentFlag rdf:type rdf:Property ;
    rdfs:label 'Experimental Treatment Flag' ;
    rdfs:comment 'Indicates whether the override involved approval of an experimental or investigational treatment.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offLabelUseFlag rdf:type rdf:Property ;
    rdfs:label 'Off Label Use Flag' ;
    rdfs:comment 'Indicates whether the override approved off-label use of a medication or device.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Override Effective Date' ;
    rdfs:comment 'Date from which the override decision becomes effective for claims processing.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overrideExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Override Expiration Date' ;
    rdfs:comment 'Date when the override authorization expires and standard rules resume.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentationAttached rdf:type rdf:Property ;
    rdfs:label 'Documentation Attached' ;
    rdfs:comment 'Indicates whether clinical documentation supporting the override is attached to the record.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentReferenceId rdf:type rdf:Property ;
    rdfs:label 'Document Reference Id' ;
    rdfs:comment 'Reference identifier to the document management system where supporting documentation is stored.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Date' ;
    rdfs:comment 'Date when the override was revoked or rescinded, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditOutcome rdf:type rdf:Property ;
    rdfs:label 'Audit Outcome' ;
    rdfs:comment 'Result of the quality or compliance audit review of the override decision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAdjustmentImpact rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Impact' ;
    rdfs:comment 'Description of how the override affects risk adjustment scoring or Hierarchical Condition Category (HCC) coding.' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mlrImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Mlr Impact Flag' ;
    rdfs:comment 'Indicates whether the override has material impact on the plan\'s Medical Loss Ratio calculation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diagnosisCodeId rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code Id' ;
    rdfs:comment 'Unique system identifier for the diagnosis code record in the data product.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DiagnosisCode .

ind:categoryCode rdf:type rdf:Property ;
    rdfs:label 'Category Code' ;
    rdfs:comment 'Three-character ICD-10 category code representing the broader disease classification to which this diagnosis belongs.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:categoryDescription rdf:type rdf:Property ;
    rdfs:label 'Category Description' ;
    rdfs:comment 'Description of the three-character category code providing context for the disease grouping.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chapterCode rdf:type rdf:Property ;
    rdfs:label 'Chapter Code' ;
    rdfs:comment 'The ICD-10 chapter code range (e.g., A00-B99) indicating the highest-level classification grouping for this diagnosis.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chapterDescription rdf:type rdf:Property ;
    rdfs:label 'Chapter Description' ;
    rdfs:comment 'Description of the ICD-10 chapter providing the broadest disease classification context (e.g., Certain infectious and parasitic diseases).' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockCode rdf:type rdf:Property ;
    rdfs:label 'Block Code' ;
    rdfs:comment 'The ICD-10 block code range representing a sub-grouping within a chapter (e.g., A00-A09 for intestinal infectious diseases).' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockDescription rdf:type rdf:Property ;
    rdfs:label 'Block Description' ;
    rdfs:comment 'Description of the ICD-10 block providing intermediate-level disease classification context.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isHeader rdf:type rdf:Property ;
    rdfs:label 'Is Header' ;
    rdfs:comment 'Indicates whether this code is a non-billable header code used for organizational hierarchy purposes only.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hccDescription rdf:type rdf:Property ;
    rdfs:label 'Hcc Description' ;
    rdfs:comment 'Description of the HCC category providing clinical context for the risk adjustment grouping.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccWeight rdf:type rdf:Property ;
    rdfs:label 'Hcc Weight' ;
    rdfs:comment 'The numeric weight assigned to the HCC category for RAF score calculation. Higher weights indicate greater expected healthcare costs.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rxhccCategory rdf:type rdf:Property ;
    rdfs:label 'Rxhcc Category' ;
    rdfs:comment 'The RxHCC category code assigned to this diagnosis for Medicare Part D risk adjustment purposes.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxhccDescription rdf:type rdf:Property ;
    rdfs:label 'Rxhcc Description' ;
    rdfs:comment 'Description of the RxHCC category providing clinical context for Part D risk adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxhccWeight rdf:type rdf:Property ;
    rdfs:label 'Rxhcc Weight' ;
    rdfs:comment 'The numeric weight assigned to the RxHCC category for Part D risk score calculation.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isChronicCondition rdf:type rdf:Property ;
    rdfs:label 'Is Chronic Condition' ;
    rdfs:comment 'Indicates whether this diagnosis represents a chronic condition requiring ongoing care management and disease management program eligibility.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isManifestationCode rdf:type rdf:Property ;
    rdfs:label 'Is Manifestation Code' ;
    rdfs:comment 'Indicates whether this code represents a manifestation of an underlying disease and must be sequenced after the underlying condition code per ICD-10 coding guidelines.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEtiologyCode rdf:type rdf:Property ;
    rdfs:label 'Is Etiology Code' ;
    rdfs:comment 'Indicates whether this code represents the underlying cause or etiology of a condition and should be sequenced before manifestation codes.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresAdditionalCharacter rdf:type rdf:Property ;
    rdfs:label 'Requires Additional Character' ;
    rdfs:comment 'Indicates whether this code requires additional characters (4th, 5th, 6th, or 7th) to be valid for billing purposes.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seventhCharacterOptions rdf:type rdf:Property ;
    rdfs:label 'Seventh Character Options' ;
    rdfs:comment 'Pipe-separated list of valid seventh character extensions for this diagnosis code (e.g., A|D|S for initial encounter, subsequent encounter, sequela).' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderSpecific rdf:type rdf:Property ;
    rdfs:label 'Gender Specific' ;
    rdfs:comment 'Indicates whether this diagnosis code is specific to male patients, female patients, or applicable to both genders.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageLow rdf:type rdf:Property ;
    rdfs:label 'Age Low' ;
    rdfs:comment 'The minimum age in years for which this diagnosis code is clinically applicable. Null indicates no lower age restriction.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageHigh rdf:type rdf:Property ;
    rdfs:label 'Age High' ;
    rdfs:comment 'The maximum age in years for which this diagnosis code is clinically applicable. Null indicates no upper age restriction.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bodySystem rdf:type rdf:Property ;
    rdfs:label 'Body System' ;
    rdfs:comment 'The primary body system or organ system affected by this diagnosis (e.g., cardiovascular, respiratory, musculoskeletal).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrincipalDiagnosisOnly rdf:type rdf:Property ;
    rdfs:label 'Is Principal Diagnosis Only' ;
    rdfs:comment 'Indicates whether this diagnosis code can only be used as a principal diagnosis and not as a secondary diagnosis on claims.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSecondaryDiagnosisOnly rdf:type rdf:Property ;
    rdfs:label 'Is Secondary Diagnosis Only' ;
    rdfs:comment 'Indicates whether this diagnosis code can only be used as a secondary diagnosis and not as a principal diagnosis on claims.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:presentOnAdmissionExempt rdf:type rdf:Property ;
    rdfs:label 'Present On Admission Exempt' ;
    rdfs:comment 'Indicates whether this diagnosis code is exempt from Present on Admission reporting requirements for inpatient claims.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalAcquiredCondition rdf:type rdf:Property ;
    rdfs:label 'Hospital Acquired Condition' ;
    rdfs:comment 'Indicates whether this diagnosis is classified as a hospital-acquired condition that may affect reimbursement when not present on admission.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complicationComorbidityFlag rdf:type rdf:Property ;
    rdfs:label 'Complication Comorbidity Flag' ;
    rdfs:comment 'Indicates whether this diagnosis is classified as a Complication or Comorbidity (CC), Major Complication or Comorbidity (MCC), or neither for DRG assignment purposes.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsStarRatingIndicator rdf:type rdf:Property ;
    rdfs:label 'Cms Star Rating Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis code is used in CMS Star Rating calculations for Medicare Advantage plans.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventableAdmissionIndicator rdf:type rdf:Property ;
    rdfs:label 'Preventable Admission Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis is classified as a potentially preventable hospital admission for care management purposes.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readmissionRiskIndicator rdf:type rdf:Property ;
    rdfs:label 'Readmission Risk Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis is associated with high risk of hospital readmission within 30 days.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseManagementTrigger rdf:type rdf:Property ;
    rdfs:label 'Case Management Trigger' ;
    rdfs:comment 'Indicates whether this diagnosis automatically triggers case management outreach and intervention.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substanceUseDisorderIndicator rdf:type rdf:Property ;
    rdfs:label 'Substance Use Disorder Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis represents a substance use disorder requiring specialized treatment and reporting.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maternityIndicator rdf:type rdf:Property ;
    rdfs:label 'Maternity Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis is related to pregnancy, childbirth, or postpartum care.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pediatricIndicator rdf:type rdf:Property ;
    rdfs:label 'Pediatric Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis is specific to pediatric populations and pediatric care services.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveCareIndicator rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis is associated with preventive care services that may be covered at 100% under ACA requirements.' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:socialDeterminantsIndicator rdf:type rdf:Property ;
    rdfs:label 'Social Determinants Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis code represents a social determinant of health factor (e.g., housing insecurity, food insecurity).' ;
    rdfs:domain ind:DiagnosisCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diagnosisRecordId rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Record Id' ;
    rdfs:comment 'Unique identifier for each diagnosis record captured from a claim or encounter submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DiagnosisRecord .

ind:diagnosisCodeVersion rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code Version' ;
    rdfs:comment 'The version of the diagnosis coding system used (ICD-9 or ICD-10).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Sequence Number' ;
    rdfs:comment 'The sequential position of this diagnosis on the claim (1=primary, 2=secondary, etc.), indicating clinical priority.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:diagnosisType rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Type' ;
    rdfs:comment 'Classification of the diagnosis indicating its role in the clinical encounter (e.g., principal diagnosis, secondary diagnosis, admitting diagnosis).' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisDate rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Date' ;
    rdfs:comment 'The specific date when the diagnosis was clinically established or documented by the provider.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rxhccCode rdf:type rdf:Property ;
    rdfs:label 'Rxhcc Code' ;
    rdfs:comment 'The RxHCC code assigned to this diagnosis for Medicare Part D risk adjustment purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRiskAdjustable rdf:type rdf:Property ;
    rdfs:label 'Is Risk Adjustable' ;
    rdfs:comment 'Indicates whether this diagnosis code is eligible for risk adjustment under the CMS HCC model.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rafContribution rdf:type rdf:Property ;
    rdfs:label 'Raf Contribution' ;
    rdfs:comment 'The incremental contribution of this diagnosis to the member\'s overall RAF score for payment calculation.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diagnosisSource rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Source' ;
    rdfs:comment 'The source system or method through which this diagnosis was captured (e.g., claim submission, encounter data, chart review, supplemental data).' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renderingProviderType rdf:type rdf:Property ;
    rdfs:label 'Rendering Provider Type' ;
    rdfs:comment 'The type of healthcare professional who rendered the service and documented this diagnosis.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberMemberProfileId rdf:type rdf:Property ;
    rdfs:label 'Member Member Profile Id' ;
    rdfs:comment 'The unique identifier for the health plan member to whom this diagnosis applies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberProfile .

ind:dataCollectionPeriod rdf:type rdf:Property ;
    rdfs:label 'Data Collection Period' ;
    rdfs:comment 'The time period during which this diagnosis was collected for risk adjustment purposes (typically the prior calendar year).' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionType rdf:type rdf:Property ;
    rdfs:label 'Submission Type' ;
    rdfs:comment 'Indicates whether this diagnosis record is an initial submission, replacement, void, or correction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionFileId rdf:type rdf:Property ;
    rdfs:label 'Submission File Id' ;
    rdfs:comment 'The unique identifier of the RAPS or EDPS submission file containing this diagnosis record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SubmissionFile .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'The code indicating why this diagnosis record was rejected by CMS, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Description' ;
    rdfs:comment 'The descriptive text explaining why this diagnosis record was rejected by CMS.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isChartReviewed rdf:type rdf:Property ;
    rdfs:label 'Is Chart Reviewed' ;
    rdfs:comment 'Indicates whether this diagnosis has been validated through a medical chart review process.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chartReviewDate rdf:type rdf:Property ;
    rdfs:label 'Chart Review Date' ;
    rdfs:comment 'The date when the medical chart review was completed for this diagnosis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chartReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Chart Review Status' ;
    rdfs:comment 'The outcome of the chart review process indicating whether the diagnosis was validated or invalidated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encounterId rdf:type rdf:Property ;
    rdfs:label 'Encounter Id' ;
    rdfs:comment 'The unique identifier for the clinical encounter during which this diagnosis was documented.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Encounter .

ind:claimReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Claim Received Date' ;
    rdfs:comment 'The date when the claim containing this diagnosis was received by the health plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:claimPaidDate rdf:type rdf:Property ;
    rdfs:label 'Claim Paid Date' ;
    rdfs:comment 'The date when payment was issued for the claim containing this diagnosis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:diagnosisPointer rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Pointer' ;
    rdfs:comment 'The letter code (A-L) linking this diagnosis to specific service lines on the CMS-1500 claim form.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryDiagnosis rdf:type rdf:Property ;
    rdfs:label 'Is Primary Diagnosis' ;
    rdfs:comment 'Indicates whether this is the primary (principal) diagnosis for the encounter or claim.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPreventable rdf:type rdf:Property ;
    rdfs:label 'Is Preventable' ;
    rdfs:comment 'Indicates whether this diagnosis represents a potentially preventable condition or complication.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isComplication rdf:type rdf:Property ;
    rdfs:label 'Is Complication' ;
    rdfs:comment 'Indicates whether this diagnosis represents a complication of care or treatment.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isComorbidity rdf:type rdf:Property ;
    rdfs:label 'Is Comorbidity' ;
    rdfs:comment 'Indicates whether this diagnosis represents a comorbid condition existing alongside the primary diagnosis.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHospitalAcquired rdf:type rdf:Property ;
    rdfs:label 'Is Hospital Acquired' ;
    rdfs:comment 'Indicates whether this diagnosis represents a hospital-acquired condition that was not present on admission.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gapInCareIndicator rdf:type rdf:Property ;
    rdfs:label 'Gap In Care Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis represents a gap in care that requires follow-up or intervention.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suspectingIndicator rdf:type rdf:Property ;
    rdfs:label 'Suspecting Indicator' ;
    rdfs:comment 'Indicates whether this diagnosis is suspected but not yet confirmed, which may affect risk adjustment eligibility.' ;
    rdfs:domain ind:DiagnosisRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careSettingId rdf:type rdf:Property ;
    rdfs:label 'Care Setting Id' ;
    rdfs:comment 'Unique identifier for the care setting code record. Primary key for the care setting reference data.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSetting .

ind:posCode rdf:type rdf:Property ;
    rdfs:label 'Pos Code' ;
    rdfs:comment 'Two-digit CMS Place of Service code that identifies the location where healthcare services are provided. Used in claims adjudication and prior authorization.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationUrgencyLevel rdf:type rdf:Property ;
    rdfs:label 'Authorization Urgency Level' ;
    rdfs:comment 'Default urgency level for prior authorization requests associated with this care setting, determining review timeframes per regulatory requirements.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardReviewTimeframeHours rdf:type rdf:Property ;
    rdfs:label 'Standard Review Timeframe Hours' ;
    rdfs:comment 'Maximum number of hours allowed for standard prior authorization review for this care setting, per regulatory requirements.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expeditedReviewTimeframeHours rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Timeframe Hours' ;
    rdfs:comment 'Maximum number of hours allowed for expedited prior authorization review for this care setting when member\'s health could be seriously jeopardized.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalGuidelineSet rdf:type rdf:Property ;
    rdfs:label 'Clinical Guideline Set' ;
    rdfs:comment 'Primary clinical decision support guideline set used for medical necessity determinations for this care setting (e.g., InterQual, MCG, internal criteria).' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFacilityBased rdf:type rdf:Property ;
    rdfs:label 'Is Facility Based' ;
    rdfs:comment 'Indicates whether this care setting represents a facility-based location (hospital, SNF) versus non-facility (office, home).' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isInstitutional rdf:type rdf:Property ;
    rdfs:label 'Is Institutional' ;
    rdfs:comment 'Indicates whether this care setting is considered institutional for billing purposes, requiring UB-04 claim forms rather than CMS-1500.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsTelehealth rdf:type rdf:Property ;
    rdfs:label 'Supports Telehealth' ;
    rdfs:comment 'Indicates whether telehealth or telemedicine services can be delivered in this care setting per regulatory and coverage policies.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acuityLevel rdf:type rdf:Property ;
    rdfs:label 'Acuity Level' ;
    rdfs:comment 'General acuity or intensity level of care typically associated with this care setting.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typicalLengthOfStayDays rdf:type rdf:Property ;
    rdfs:label 'Typical Length Of Stay Days' ;
    rdfs:comment 'Average or typical length of stay in days for this care setting, used for authorization duration planning and utilization benchmarking.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresPhysicianOrder rdf:type rdf:Property ;
    rdfs:label 'Requires Physician Order' ;
    rdfs:comment 'Indicates whether services in this care setting require a physician order or referral as part of the authorization process.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresFacilityCertification rdf:type rdf:Property ;
    rdfs:label 'Requires Facility Certification' ;
    rdfs:comment 'Indicates whether the facility providing services in this care setting must hold specific certifications or accreditations for coverage.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defaultAuthorizationUnits rdf:type rdf:Property ;
    rdfs:label 'Default Authorization Units' ;
    rdfs:comment 'Standard unit of measure for authorizations in this care setting (e.g., days for inpatient, visits for outpatient, hours for home health).' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxInitialAuthorizationUnits rdf:type rdf:Property ;
    rdfs:label 'Max Initial Authorization Units' ;
    rdfs:comment 'Maximum number of units that can be authorized in an initial authorization request for this care setting before requiring extension or continuation review.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allowsAutoApproval rdf:type rdf:Property ;
    rdfs:label 'Allows Auto Approval' ;
    rdfs:comment 'Indicates whether authorization requests for this care setting can be auto-approved based on predefined criteria without manual clinical review.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresPeerToPeerReview rdf:type rdf:Property ;
    rdfs:label 'Requires Peer To Peer Review' ;
    rdfs:comment 'Indicates whether adverse determinations for this care setting require a peer-to-peer discussion between the reviewing medical director and requesting provider before final denial.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationRequiredTimeframeHours rdf:type rdf:Property ;
    rdfs:label 'Notification Required Timeframe Hours' ;
    rdfs:comment 'Number of hours within which the health plan must be notified of services in this care setting (e.g., 24-hour notification for emergency admissions).' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appealsAllowed rdf:type rdf:Property ;
    rdfs:label 'Appeals Allowed' ;
    rdfs:comment 'Indicates whether members or providers can appeal adverse authorization decisions for this care setting.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transitionOfCareEligible rdf:type rdf:Property ;
    rdfs:label 'Transition Of Care Eligible' ;
    rdfs:comment 'Indicates whether this care setting is eligible for transition of care protocols when members move between care settings or providers.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costSharingApplies rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Applies' ;
    rdfs:comment 'Indicates whether member cost sharing (copay, coinsurance, deductible) typically applies to services in this care setting.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:typicalCostSharingType rdf:type rdf:Property ;
    rdfs:label 'Typical Cost Sharing Type' ;
    rdfs:comment 'Most common type of member cost sharing applied to services in this care setting.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outOfNetworkAllowed rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Allowed' ;
    rdfs:comment 'Indicates whether services in this care setting can be authorized and covered when delivered by out-of-network providers.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyServicesClassification rdf:type rdf:Property ;
    rdfs:label 'Emergency Services Classification' ;
    rdfs:comment 'Classification of whether this care setting is considered emergency, urgent, or non-urgent for purposes of coverage and authorization requirements.' ;
    rdfs:domain ind:CareSetting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDefault rdf:type rdf:Property ;
    rdfs:label 'Is Default' ;
    rdfs:comment 'Indicates whether this care setting should be used as the default selection in authorization workflows when no specific setting is specified.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authQueueId rdf:type rdf:Property ;
    rdfs:label 'Auth Queue Id' ;
    rdfs:comment 'Unique identifier for the authorization queue entry. Primary key for the authorization queue.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:queueEntryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Queue Entry Timestamp' ;
    rdfs:comment 'Date and time when the authorization request was added to the queue for review.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lengthOfStay rdf:type rdf:Property ;
    rdfs:label 'Length Of Stay' ;
    rdfs:comment 'Number of days requested or approved for inpatient stay.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assignment Timestamp' ;
    rdfs:comment 'Date and time when the authorization request was assigned to a reviewer.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:slaDueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sla Due Timestamp' ;
    rdfs:comment 'Date and time by which the authorization decision must be completed per regulatory or contractual service level agreements.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:holdReason rdf:type rdf:Property ;
    rdfs:label 'Hold Reason' ;
    rdfs:comment 'Reason why the authorization request is on hold pending additional information or action.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:additionalInfoRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Additional Info Requested Flag' ;
    rdfs:comment 'Indicates whether additional clinical documentation or information has been requested from the provider.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:infoRequestDate rdf:type rdf:Property ;
    rdfs:label 'Info Request Date' ;
    rdfs:comment 'Date when additional information was requested from the provider.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:infoDueDate rdf:type rdf:Property ;
    rdfs:label 'Info Due Date' ;
    rdfs:comment 'Date by which the requested additional information must be received.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submitterContactName rdf:type rdf:Property ;
    rdfs:label 'Submitter Contact Name' ;
    rdfs:comment 'Name of the provider office contact who submitted the authorization request.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterFax rdf:type rdf:Property ;
    rdfs:label 'Submitter Fax' ;
    rdfs:comment 'Fax number for the provider office contact who submitted the authorization request.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationCategory rdf:type rdf:Property ;
    rdfs:label 'Authorization Category' ;
    rdfs:comment 'Clinical category of the service requiring authorization.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseManagementFlag rdf:type rdf:Property ;
    rdfs:label 'Case Management Flag' ;
    rdfs:comment 'Indicates whether the member is enrolled in a case management program.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:highRiskFlag rdf:type rdf:Property ;
    rdfs:label 'High Risk Flag' ;
    rdfs:comment 'Indicates whether the member is classified as high-risk based on clinical or utilization criteria.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyBenefitFlag rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Benefit Flag' ;
    rdfs:comment 'Indicates whether the authorization request involves pharmacy benefits or specialty medications.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialtyDrugFlag rdf:type rdf:Property ;
    rdfs:label 'Specialty Drug Flag' ;
    rdfs:comment 'Indicates whether the authorization involves a specialty pharmaceutical product.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dmeFlag rdf:type rdf:Property ;
    rdfs:label 'Dme Flag' ;
    rdfs:comment 'Indicates whether the authorization request is for durable medical equipment.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:homeHealthFlag rdf:type rdf:Property ;
    rdfs:label 'Home Health Flag' ;
    rdfs:comment 'Indicates whether the authorization request is for home health services.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ltssFlag rdf:type rdf:Property ;
    rdfs:label 'Ltss Flag' ;
    rdfs:comment 'Indicates whether the authorization request is for long-term services and supports.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transplantFlag rdf:type rdf:Property ;
    rdfs:label 'Transplant Flag' ;
    rdfs:comment 'Indicates whether the authorization request is for organ or tissue transplant services.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalTrialFlag rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Flag' ;
    rdfs:comment 'Indicates whether the service is part of an approved clinical trial.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfAreaFlag rdf:type rdf:Property ;
    rdfs:label 'Out Of Area Flag' ;
    rdfs:comment 'Indicates whether the service will be provided outside the member\'s service area.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Flag' ;
    rdfs:comment 'Indicates whether notification of queue status has been sent to the provider or member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Timestamp' ;
    rdfs:comment 'Date and time when the most recent notification was sent.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:queueAgeDays rdf:type rdf:Property ;
    rdfs:label 'Queue Age Days' ;
    rdfs:comment 'Number of days the authorization request has been in the queue since entry.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Breach Flag' ;
    rdfs:comment 'Indicates whether the authorization request has exceeded the required turnaround time service level agreement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoApprovalEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Approval Eligible Flag' ;
    rdfs:comment 'Indicates whether the authorization request meets criteria for automated approval without manual review.' ;
    rdfs:domain ind:AuthQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workflowStep rdf:type rdf:Property ;
    rdfs:label 'Workflow Step' ;
    rdfs:comment 'Current step in the authorization review workflow process.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Auth Assignment Id' ;
    rdfs:comment 'Unique identifier for the authorization assignment record. Primary key for tracking the assignment of an authorization request to a specific authorizer or workgroup.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedToUserName rdf:type rdf:Property ;
    rdfs:label 'Assigned To User Name' ;
    rdfs:comment 'Full name of the individual user to whom the authorization request is assigned for review and determination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToWorkgroupId rdf:type rdf:Property ;
    rdfs:label 'Assigned To Workgroup Id' ;
    rdfs:comment 'Unique identifier of the workgroup, team, or queue to which the authorization request is assigned (e.g., Cardiology UM Team, Inpatient Review Queue).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Workgroup .

ind:assignedToWorkgroupName rdf:type rdf:Property ;
    rdfs:label 'Assigned To Workgroup Name' ;
    rdfs:comment 'Name of the workgroup, team, or queue to which the authorization request is assigned for processing.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Date' ;
    rdfs:comment 'Calendar date when the authorization request was assigned, used for daily workload reporting and date-based analytics.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignedByUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Assigned By User Agent Id' ;
    rdfs:comment 'Unique identifier of the user (supervisor, system administrator, or automated process) who performed the assignment action.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:assignedByUserName rdf:type rdf:Property ;
    rdfs:label 'Assigned By User Name' ;
    rdfs:comment 'Name of the user or system process that performed the assignment of the authorization request.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assignment Notes' ;
    rdfs:comment 'Free-text notes or instructions provided at the time of assignment to guide the assigned user or workgroup in processing the authorization request.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acceptedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Accepted Timestamp' ;
    rdfs:comment 'Date and time when the assigned user or workgroup accepted the authorization request assignment, indicating acknowledgment and intent to process.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:startedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Started Timestamp' ;
    rdfs:comment 'Date and time when the assigned user began actively working on the authorization request review, used to calculate actual processing time.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Target date by which the authorization request must be reviewed and determined to meet regulatory and contractual service level agreements (SLA). Typically 14 calendar days for standard requests, 72 hours for expedited requests per CMS regulations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Due Timestamp' ;
    rdfs:comment 'Precise date and time by which the authorization request must be completed, used for real-time SLA monitoring and alerting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:timeToAcceptHours rdf:type rdf:Property ;
    rdfs:label 'Time To Accept Hours' ;
    rdfs:comment 'Elapsed time in hours between assignment and acceptance by the assigned user or workgroup, used to measure responsiveness.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeToStartHours rdf:type rdf:Property ;
    rdfs:label 'Time To Start Hours' ;
    rdfs:comment 'Elapsed time in hours between assignment and the start of active work on the authorization request, used to identify delays in processing initiation.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeToCompleteHours rdf:type rdf:Property ;
    rdfs:label 'Time To Complete Hours' ;
    rdfs:comment 'Total elapsed time in hours from assignment to completion, used to measure turnaround time (TAT) and SLA compliance.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:activeWorkHours rdf:type rdf:Property ;
    rdfs:label 'Active Work Hours' ;
    rdfs:comment 'Actual time in hours spent actively working on the authorization request, excluding time on hold or awaiting additional information.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isSlaMet rdf:type rdf:Property ;
    rdfs:label 'Is Sla Met' ;
    rdfs:comment 'Boolean flag indicating whether the authorization request was completed within the required SLA timeframe (true) or exceeded the SLA (false).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEscalated rdf:type rdf:Property ;
    rdfs:label 'Is Escalated' ;
    rdfs:comment 'Boolean flag indicating whether the authorization request was escalated to a higher level of review or management during this assignment (true) or processed normally (false).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Escalation Timestamp' ;
    rdfs:comment 'Date and time when the authorization request was escalated during this assignment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:escalatedToUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Escalated To User Agent Id' ;
    rdfs:comment 'Unique identifier of the user (typically a supervisor, medical director, or senior reviewer) to whom the authorization request was escalated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:escalatedToUserName rdf:type rdf:Property ;
    rdfs:label 'Escalated To User Name' ;
    rdfs:comment 'Name of the user to whom the authorization request was escalated for higher-level review or decision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isReassigned rdf:type rdf:Property ;
    rdfs:label 'Is Reassigned' ;
    rdfs:comment 'Boolean flag indicating whether the authorization request was reassigned from the original assignee to a different user or workgroup during this assignment (true) or remained with the original assignee (false).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reassignmentReason rdf:type rdf:Property ;
    rdfs:label 'Reassignment Reason' ;
    rdfs:comment 'Reason for reassigning the authorization request to a different user or workgroup, such as assignee unavailability, workload balancing, or specialized expertise required.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reassignmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reassignment Timestamp' ;
    rdfs:comment 'Date and time when the authorization request was reassigned to a different user or workgroup.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reassignedFromUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Reassigned From User Agent Id' ;
    rdfs:comment 'Unique identifier of the original user from whom the authorization request was reassigned.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:reassignedFromUserName rdf:type rdf:Property ;
    rdfs:label 'Reassigned From User Name' ;
    rdfs:comment 'Name of the original user from whom the authorization request was reassigned.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerLicenseType rdf:type rdf:Property ;
    rdfs:label 'Reviewer License Type' ;
    rdfs:comment 'Type of professional license held by the assigned reviewer (Medical Doctor, Doctor of Osteopathy, Registered Nurse, Licensed Practical Nurse, Doctor of Pharmacy, Doctor of Dental Surgery, Doctor of Dental Medicine, Doctor of Philosophy, Licensed Clinical Social Worker, Licensed Marriage and Family Therapist, or other).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Reviewer License Number' ;
    rdfs:comment 'Professional license number of the assigned reviewer, required for regulatory reporting and audit trails of clinical determinations.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerLicenseState rdf:type rdf:Property ;
    rdfs:label 'Reviewer License State' ;
    rdfs:comment 'State in which the assigned reviewer holds their professional license, relevant for multi-state operations and regulatory compliance.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerNpi rdf:type rdf:Property ;
    rdfs:label 'Reviewer Npi' ;
    rdfs:comment 'National Provider Identifier (NPI) of the assigned reviewer if they are a licensed healthcare provider, used for regulatory reporting and audit trails.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workgroupType rdf:type rdf:Property ;
    rdfs:label 'Workgroup Type' ;
    rdfs:comment 'Type or category of the assigned workgroup based on the service line or specialty area (inpatient, outpatient, pharmacy, behavioral health, dental, durable medical equipment, home health, skilled nursing, or general).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workgroupLocation rdf:type rdf:Property ;
    rdfs:label 'Workgroup Location' ;
    rdfs:comment 'Physical or virtual location of the assigned workgroup, relevant for distributed operations and workforce management (e.g., Minneapolis Office, Remote Team, Offshore Center).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentSourceSystemId rdf:type rdf:Property ;
    rdfs:label 'Assignment Source System Id' ;
    rdfs:comment 'Unique identifier of the assignment record in the source system, used for data lineage and reconciliation.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPeerToPeerRequired rdf:type rdf:Property ;
    rdfs:label 'Is Peer To Peer Required' ;
    rdfs:comment 'Boolean flag indicating whether a peer-to-peer discussion between the assigned medical director and the requesting provider is required or requested for this authorization (true) or not (false).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerToPeerScheduledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Peer To Peer Scheduled Timestamp' ;
    rdfs:comment 'Date and time when a peer-to-peer discussion is scheduled between the assigned medical director and the requesting provider.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isExpeditedReview rdf:type rdf:Property ;
    rdfs:label 'Is Expedited Review' ;
    rdfs:comment 'Boolean flag indicating whether the authorization request requires expedited review (decision within 72 hours) due to urgency of the member\'s medical condition (true) or follows standard review timeframes (false).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignmentChannel rdf:type rdf:Property ;
    rdfs:label 'Assignment Channel' ;
    rdfs:comment 'Channel or interface through which the authorization request was received and subsequently assigned (provider portal, phone, fax, electronic data interchange, application programming interface, internal system, or other).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessUnit rdf:type rdf:Property ;
    rdfs:label 'Business Unit' ;
    rdfs:comment 'Business unit or division within UnitedHealthcare responsible for processing this authorization assignment (e.g., Commercial Operations, Medicare Operations, Medicaid Operations).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAutoAssigned rdf:type rdf:Property ;
    rdfs:label 'Is Auto Assigned' ;
    rdfs:comment 'Boolean flag indicating whether the authorization request was automatically assigned by the system (true) or manually assigned by a user (false).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignmentRuleName rdf:type rdf:Property ;
    rdfs:label 'Assignment Rule Name' ;
    rdfs:comment 'Name or description of the business rule or routing logic used to automatically assign the authorization request.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workloadScore rdf:type rdf:Property ;
    rdfs:label 'Workload Score' ;
    rdfs:comment 'Calculated score representing the complexity or effort required for this authorization review, used for workload balancing and capacity planning.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAppeal rdf:type rdf:Property ;
    rdfs:label 'Is Appeal' ;
    rdfs:comment 'Boolean flag indicating whether this assignment is for an appeal of a previous authorization denial (true) or an initial authorization request (false).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalDenialDate rdf:type rdf:Property ;
    rdfs:label 'Original Denial Date' ;
    rdfs:comment 'Date of the original authorization denial if this assignment is for an appeal, used to track appeal timeliness and patterns.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isExternalReview rdf:type rdf:Property ;
    rdfs:label 'Is External Review' ;
    rdfs:comment 'Boolean flag indicating whether this assignment is for an external independent review (true) or internal review (false).' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReviewOrganization rdf:type rdf:Property ;
    rdfs:label 'External Review Organization' ;
    rdfs:comment 'Name of the independent review organization (IRO) conducting the external review if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Assignment Sequence Number' ;
    rdfs:comment 'Sequential number indicating the order of this assignment if the authorization request has been assigned multiple times (1 for initial assignment, 2 for first reassignment, etc.).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:previousAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Previous Assignment Id' ;
    rdfs:comment 'Unique identifier of the previous assignment record if this authorization request was reassigned, creating an assignment history chain.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BrokerCampaignAssignment .

ind:cancellationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancellation Timestamp' ;
    rdfs:comment 'Date and time when the assignment was cancelled, if applicable (e.g., authorization request withdrawn, duplicate request identified).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cancelledByUserId rdf:type rdf:Property ;
    rdfs:label 'Cancelled By User Id' ;
    rdfs:comment 'Unique identifier of the user who cancelled the assignment if applicable.' ;
    rdfs:domain ind:AuthAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:memberRiskProfileId rdf:type rdf:Property ;
    rdfs:label 'Member Risk Profile Id' ;
    rdfs:comment 'Unique identifier for the member risk profile record, serving as the primary key for risk adjustment tracking and analysis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberRiskProfile .

ind:hicn rdf:type rdf:Property ;
    rdfs:label 'Hicn' ;
    rdfs:comment 'Medicare beneficiary identifier used for claims processing and risk adjustment submissions prior to MBI implementation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mbi rdf:type rdf:Property ;
    rdfs:label 'Mbi' ;
    rdfs:comment 'New Medicare beneficiary identifier replacing HICN for improved privacy and security in risk adjustment processing.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageAsOfPaymentYear rdf:type rdf:Property ;
    rdfs:label 'Age As Of Payment Year' ;
    rdfs:comment 'Member\'s age calculated as of February 1st of the payment year, used for demographic risk factor determination.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicaidDualStatus rdf:type rdf:Property ;
    rdfs:label 'Medicaid Dual Status' ;
    rdfs:comment 'Indicates whether the member is dually eligible for both Medicare and Medicaid benefits, affecting risk adjustment model selection.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:institutionalStatus rdf:type rdf:Property ;
    rdfs:label 'Institutional Status' ;
    rdfs:comment 'Classification of member\'s residential setting (community vs institutional) used for risk model segmentation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originallyDisabledIndicator rdf:type rdf:Property ;
    rdfs:label 'Originally Disabled Indicator' ;
    rdfs:comment 'Flag indicating whether the member originally qualified for Medicare due to disability rather than age.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospiceIndicator rdf:type rdf:Property ;
    rdfs:label 'Hospice Indicator' ;
    rdfs:comment 'Flag indicating whether the member is enrolled in hospice care, affecting risk adjustment payment calculations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskModelVersion rdf:type rdf:Property ;
    rdfs:label 'Risk Model Version' ;
    rdfs:comment 'Version identifier of the CMS risk adjustment model applied to calculate the member\'s risk score.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataYear rdf:type rdf:Property ;
    rdfs:label 'Data Year' ;
    rdfs:comment 'Calendar year during which diagnosis data was collected for risk score calculation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:demographicRafScore rdf:type rdf:Property ;
    rdfs:label 'Demographic Raf Score' ;
    rdfs:comment 'Component of RAF score based solely on demographic factors (age, gender, dual status, institutional status).' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diseaseRafScore rdf:type rdf:Property ;
    rdfs:label 'Disease Raf Score' ;
    rdfs:comment 'Component of RAF score based on documented chronic conditions and HCC categories.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:normalizedRafScore rdf:type rdf:Property ;
    rdfs:label 'Normalized Raf Score' ;
    rdfs:comment 'RAF score adjusted by CMS normalization factor to ensure budget neutrality across the Medicare Advantage program.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hccCount rdf:type rdf:Property ;
    rdfs:label 'Hcc Count' ;
    rdfs:comment 'Total number of distinct HCC categories assigned to the member based on documented diagnoses.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeHccList rdf:type rdf:Property ;
    rdfs:label 'Active Hcc List' ;
    rdfs:comment 'Comma-separated list of HCC codes currently active for the member after hierarchy processing.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionFactors rdf:type rdf:Property ;
    rdfs:label 'Interaction Factors' ;
    rdfs:comment 'List of interaction terms applied in risk score calculation when specific combinations of conditions or demographics exist.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCount rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Count' ;
    rdfs:comment 'Total number of ICD-10 diagnoses documented for the member during the data collection period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:chronicConditionCount rdf:type rdf:Property ;
    rdfs:label 'Chronic Condition Count' ;
    rdfs:comment 'Number of distinct chronic conditions identified for the member based on diagnosis history.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskScoreStatus rdf:type rdf:Property ;
    rdfs:label 'Risk Score Status' ;
    rdfs:comment 'Current processing status of the member\'s risk score calculation and submission to CMS.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rapsSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Raps Submission Status' ;
    rdfs:comment 'Status of diagnosis data submission to CMS via the RAPS system for risk adjustment payment.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:edpsSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Edps Submission Status' ;
    rdfs:comment 'Status of encounter data submission to CMS via EDPS for risk adjustment and payment reconciliation.' ;
