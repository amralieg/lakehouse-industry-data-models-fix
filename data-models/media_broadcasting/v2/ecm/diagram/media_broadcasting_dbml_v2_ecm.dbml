  other_deductions_amount decimal(18,2) [note: 'Other contractual deductions.']
  overhead_deduction varchar
  participable_amount decimal(18,2) [note: 'Net amount subject to participation after deductions.']
  participation_amount decimal(18,2)
  participation_earned_amount decimal(18,2) [note: 'Participation amount earned this period.']
  participation_pool decimal(18,2) [note: 'Net pool after deductions']
  payment_date date [note: 'Date payment was made.']
  payment_due_date date
  prior_payments_amount decimal(18,2) [note: 'Cumulative prior participation payments.']
  production_costs_amount decimal(18,2) [note: 'Production costs deducted (for net participation).']
  statement_date date [note: 'Date statement was generated.']
  statement_period_end varchar
  statement_period_end_date date [note: 'End date of the accounting period covered.']
  statement_period_start varchar
  statement_period_start_date date [note: 'Start date of the accounting period covered.']
  statement_status varchar [note: 'Status: draft, issued, disputed, paid, adjusted.']
  total_deductions decimal(18,2) [note: 'Total deductions applied']
  updated_at timestamp
  updated_timestamp timestamp [note: 'Record last update timestamp.']

  Note: 'Periodic participation statement showing revenue, deductions, and talent share for backend deals'
}

