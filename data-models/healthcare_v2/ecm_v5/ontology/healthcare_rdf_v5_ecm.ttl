    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PatientSafetyEvent .

ind:actionDueDate rdf:type rdf:Property ;
    rdfs:label 'Action Due Date' ;
    rdfs:comment 'Target date for completion of the corrective action plan.' ;
