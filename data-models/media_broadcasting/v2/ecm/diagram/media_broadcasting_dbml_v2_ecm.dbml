  author_name varchar [note: 'Name of the individual who created or authored the knowledge article. | Column author_name (STRING) in technology.knowledge_article']
  average_rating decimal(3,2) [note: 'Average rating score provided by users, typically on a scale of 1 to 5. | Column average_rating (DECIMAL(3,2)) in technology.knowledge_article']
  compliance_flag boolean [note: 'Indicates whether the knowledge article has undergone compliance review for regulatory or policy adherence. | Column compliance_flag (BOOLEAN) in technology.knowledge_article']
  content_body varchar [note: 'The main content of the knowledge article containing detailed information, instructions, or solutions. | Column content_body (STRING) in technology.knowledge_article']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.knowledge_article']
  created_date date [note: 'Date when the knowledge article record was first created in the system. | Column created_date (DATE) in technology.knowledge_article']
  created_timestamp timestamp [note: 'Timestamp when the knowledge article record was first created in the system, including time of day. | Column created_timestamp (TIMESTAMP) in technology.knowledge_article']
  expiration_date date [note: 'Date when the knowledge article is scheduled to expire or be archived if not renewed. | Column expiration_date (DATE) in technology.knowledge_article']
  helpful_count varchar [note: 'Number of users who marked the article as helpful or useful. | Column helpful_count (BIGINT) in technology.knowledge_article']
  is_featured boolean [note: 'Indicates whether the knowledge article is featured or highlighted for prominent display. | Column is_featured (BOOLEAN) in technology.knowledge_article']
  is_searchable boolean [note: 'Indicates whether the knowledge article is included in search indexes and discoverable through search. | Column is_searchable (BOOLEAN) in technology.knowledge_article']
  keywords varchar [note: 'Comma-separated list of keywords and tags to improve searchability and discoverability of the article. | Column keywords (STRING) in technology.knowledge_article']
  knowledge_article_category varchar [note: 'Primary business category or domain that the knowledge article addresses within technology operations. | Column category (STRING) in technology.knowledge_article']
  knowledge_article_status varchar [note: 'Current lifecycle status of the knowledge article indicating its availability and approval state. | Column status (STRING) in technology.knowledge_article']
  language_code varchar [note: 'Two-letter ISO 639-1 language code indicating the language in which the article is written. | Column language_code (STRING) in technology.knowledge_article']
  last_modified_date date [note: 'Date when the knowledge article was last updated or revised. | Column last_modified_date (DATE) in technology.knowledge_article']
  next_review_date date [note: 'Scheduled date for the next periodic review of the knowledge article to ensure content remains current. | Column next_review_date (DATE) in technology.knowledge_article']
  not_helpful_count varchar [note: 'Number of users who marked the article as not helpful or inadequate. | Column not_helpful_count (BIGINT) in technology.knowledge_article']
  priority varchar [note: 'Business priority level indicating the importance or urgency of the knowledge article topic. | Column priority (STRING) in technology.knowledge_article']
  problem_description varchar [note: 'Description of the problem, issue, or question that the knowledge article resolves. | Column problem_description (STRING) in technology.knowledge_article']
  published_date date [note: 'Date when the knowledge article was officially published and made available to its intended audience. | Column published_date (DATE) in technology.knowledge_article']
  related_equipment_type varchar [note: 'Type of broadcast or IT equipment that the knowledge article pertains to. | Column related_equipment_type (STRING) in technology.knowledge_article']
