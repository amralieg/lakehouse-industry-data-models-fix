  review_start_date date [note: 'Date on which the standards review process officially began for the submitted ad creative. | Column review_start_date (DATE) in compliance.ad_standards_clearance']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.ad_standards_clearance']
  standards_body varchar [note: 'Regulatory or self-regulatory organization conducting the clearance review (e.g., NAB, CARU, IAB, internal broadcast standards department). | Column standards_body (STRING) in compliance.ad_standards_clearance']
  submission_date date [note: 'Date on which the ad creative was submitted for standards clearance review. | Column submission_date (DATE) in compliance.ad_standards_clearance']
