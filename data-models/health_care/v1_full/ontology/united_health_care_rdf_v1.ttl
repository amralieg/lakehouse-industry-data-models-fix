    rdfs:comment 'Indicates whether the specialty drug has received FDA breakthrough therapy designation for serious conditions with preliminary clinical evidence of substantial improvement.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
