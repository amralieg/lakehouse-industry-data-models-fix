ind:disabledIndicator rdf:type rdf:Property ;
    rdfs:label 'Disabled Indicator' ;
    rdfs:comment 'Indicator whether the member is entitled to Medicare due to disability status.' ;
    rdfs:domain ind:ProgramRiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditSampleId rdf:type rdf:Property ;
    rdfs:label 'Audit Sample Id' ;
    rdfs:comment 'Unique identifier for the RADV audit sample if this record was selected.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditSample .

ind:correctedHccCode rdf:type rdf:Property ;
    rdfs:label 'Corrected Hcc Code' ;
    rdfs:comment 'Corrected HCC code after audit or chart review validation.' ;
    rdfs:domain ind:ProgramRiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Attestation Provider Npi' ;
    rdfs:comment 'NPI of the provider who attested to the diagnosis documentation.' ;
    rdfs:domain ind:ProgramRiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastResubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Last Resubmission Date' ;
    rdfs:comment 'Date of the most recent resubmission to CMS.' ;
    rdfs:domain ind:ProgramRiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsResponseDate rdf:type rdf:Property ;
    rdfs:label 'Cms Response Date' ;
    rdfs:comment 'Date when CMS provided a response or acknowledgment for this submission.' ;
    rdfs:domain ind:ProgramRiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deletedFlag rdf:type rdf:Property ;
    rdfs:label 'Deleted Flag' ;
    rdfs:comment 'Indicator whether this risk adjustment record has been logically deleted.' ;
    rdfs:domain ind:ProgramRiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerProgramParticipationId rdf:type rdf:Property ;
    rdfs:label 'Provider Program Participation Id' ;
    rdfs:comment 'Unique identifier for each provider\'s participation record in a government program. Primary key for the provider program participation entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderProgramParticipation .

ind:participationEndDate rdf:type rdf:Property ;
    rdfs:label 'Participation End Date' ;
    rdfs:comment 'The date on which the provider\'s participation in the government program ended or will end. Null if participation is ongoing.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerSpecialtyDescription rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Description' ;
    rdfs:comment 'Human-readable description of the provider\'s primary medical specialty or service type for this government program participation.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaState rdf:type rdf:Property ;
    rdfs:label 'Service Area State' ;
    rdfs:comment 'Two-letter state code indicating the primary state where the provider delivers services under this government program participation.' ;
    rdfs:domain ind:Government ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaCounty rdf:type rdf:Property ;
    rdfs:label 'Service Area County' ;
    rdfs:comment 'County name where the provider delivers services under this government program participation. Used for network adequacy and access analysis.' ;
    rdfs:domain ind:Government ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaZipCodes rdf:type rdf:Property ;
    rdfs:label 'Service Area Zip Codes' ;
    rdfs:comment 'Comma-separated list of ZIP codes that define the geographic service area where the provider accepts government program members.' ;
    rdfs:domain ind:Government ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityTierStatus rdf:type rdf:Property ;
    rdfs:label 'Quality Tier Status' ;
    rdfs:comment 'Classification of the provider\'s quality performance tier within the government program, based on Healthcare Effectiveness Data and Information Set (HEDIS) measures, Consumer Assessment of Healthcare Providers and Systems (CAHPS) scores, and other quality metrics.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareOptOutFlag rdf:type rdf:Property ;
    rdfs:label 'Medicare Opt Out Flag' ;
    rdfs:comment 'Indicates whether the provider has opted out of Medicare participation entirely. If true, provider cannot bill Medicare or Medicare Advantage plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Medicaid Enrolled Flag' ;
    rdfs:comment 'Indicates whether the provider is enrolled in the state Medicaid program, which may be required for Medicaid managed care participation.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dualEligibleSpecialistFlag rdf:type rdf:Property ;
    rdfs:label 'Dual Eligible Specialist Flag' ;
    rdfs:comment 'Indicates whether the provider has specialized training or designation to serve dual-eligible members (Medicare and Medicaid) in Dual Eligible Special Needs Plans (D-SNP).' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:snpTypeEligibility rdf:type rdf:Property ;
    rdfs:label 'Snp Type Eligibility' ;
    rdfs:comment 'Indicates which types of Special Needs Plans the provider is eligible to serve: Dual Eligible Special Needs Plan (D-SNP), Chronic Condition Special Needs Plan (C-SNP), Institutional Special Needs Plan (I-SNP), or all types.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ltssProviderFlag rdf:type rdf:Property ;
    rdfs:label 'Ltss Provider Flag' ;
    rdfs:comment 'Indicates whether the provider delivers Long Term Services and Supports for government program members requiring assistance with Activities of Daily Living (ADL) or Instrumental Activities of Daily Living (IADL).' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthProviderFlag rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Provider Flag' ;
    rdfs:comment 'Indicates whether the provider specializes in behavioral health, mental health, or substance use disorder services for government program members.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyNetworkFlag rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Network Flag' ;
    rdfs:comment 'Indicates whether the provider (pharmacy) participates in the Medicare Part D or Medicaid pharmacy network for prescription drug benefits.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dmeSupplierFlag rdf:type rdf:Property ;
    rdfs:label 'Dme Supplier Flag' ;
    rdfs:comment 'Indicates whether the provider is an approved supplier of Durable Medical Equipment for government program members.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:homeHealthProviderFlag rdf:type rdf:Property ;
    rdfs:label 'Home Health Provider Flag' ;
    rdfs:comment 'Indicates whether the provider delivers home health services to government program members in their residences.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:snfProviderFlag rdf:type rdf:Property ;
    rdfs:label 'Snf Provider Flag' ;
    rdfs:comment 'Indicates whether the provider operates a Skilled Nursing Facility participating in government programs.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pcmhCertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Pcmh Certified Flag' ;
    rdfs:comment 'Indicates whether the provider practice is certified as a Patient Centered Medical Home by National Committee for Quality Assurance (NCQA) or equivalent body.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electronicRemittanceFlag rdf:type rdf:Property ;
    rdfs:label 'Electronic Remittance Flag' ;
    rdfs:comment 'Indicates whether the provider receives electronic remittance advice (835 transactions) for government program claim payments.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:participationAgreementSignedDate rdf:type rdf:Property ;
    rdfs:label 'Participation Agreement Signed Date' ;
    rdfs:comment 'The date on which the provider signed the participation agreement for the government program.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Certification Number' ;
    rdfs:comment 'The CMS certification number assigned to institutional providers (hospitals, Skilled Nursing Facilities (SNF), home health agencies) for Medicare participation.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateMedicaidProviderId rdf:type rdf:Property ;
    rdfs:label 'State Medicaid Provider Id' ;
    rdfs:comment 'The state-specific Medicaid provider identifier assigned by the state Medicaid agency for providers participating in Medicaid managed care programs.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:sanctionsFlag rdf:type rdf:Property ;
    rdfs:label 'Sanctions Flag' ;
    rdfs:comment 'Indicates whether the provider has any active sanctions, corrective action plans, or quality improvement requirements imposed by CMS or state agencies.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsDescription rdf:type rdf:Property ;
    rdfs:label 'Sanctions Description' ;
    rdfs:comment 'Detailed description of any active sanctions, penalties, or corrective actions imposed on the provider by government program regulators.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerDirectoryDisplayFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Directory Display Flag' ;
    rdfs:comment 'Indicates whether the provider should be displayed in the public-facing provider directory for government program members to search and select.' ;
    rdfs:domain ind:ProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:programProviderContractId rdf:type rdf:Property ;
    rdfs:label 'Program Provider Contract Id' ;
    rdfs:comment 'Unique identifier for the program provider contract record. Primary key for the contract between UnitedHealth and a provider for participation in a specific government program.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProgramProviderContract .

ind:governmentProgramType rdf:type rdf:Property ;
    rdfs:label 'Government Program Type' ;
    rdfs:comment 'Type of government healthcare program covered by this contract. Determines regulatory requirements and reimbursement rules.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractPlanType rdf:type rdf:Property ;
    rdfs:label 'Contract Plan Type' ;
    rdfs:comment 'Specific plan type designation for the government program. HMO (Health Maintenance Organization), PPO (Preferred Provider Organization), EPO (Exclusive Provider Organization), POS (Point of Service), PFFS (Private Fee-For-Service), SNP (Special Needs Plan), D-SNP (Dual Eligible Special Needs Plan), C-SNP (Chronic Condition Special Needs Plan), I-SNP (Institutional Special Needs Plan), PDP (Prescription Drug Plan), MAPD (Medicare Advantage Prescription Drug).' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareReimbursementPercent rdf:type rdf:Property ;
    rdfs:label 'Medicare Reimbursement Percent' ;
    rdfs:comment 'Percentage of Medicare allowable amount paid to provider. Typically expressed as percent of Medicare fee schedule.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityIncentiveEligible rdf:type rdf:Property ;
    rdfs:label 'Quality Incentive Eligible' ;
    rdfs:comment 'Indicates whether the provider is eligible for quality-based incentive payments under this contract.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskCorridorLowerPercent rdf:type rdf:Property ;
    rdfs:label 'Risk Corridor Lower Percent' ;
    rdfs:comment 'Lower threshold percentage for risk corridor calculations in shared risk arrangements.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskCorridorUpperPercent rdf:type rdf:Property ;
    rdfs:label 'Risk Corridor Upper Percent' ;
    rdfs:comment 'Upper threshold percentage for risk corridor calculations in shared risk arrangements.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:malpracticeInsuranceRequired rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Required' ;
    rdfs:comment 'Indicates whether the provider must maintain malpractice insurance as a contract requirement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electronicFundsTransferRequired rdf:type rdf:Property ;
    rdfs:label 'Electronic Funds Transfer Required' ;
    rdfs:comment 'Indicates whether provider payments must be made via electronic funds transfer. EFT (Electronic Funds Transfer).' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electronicRemittanceAdviceRequired rdf:type rdf:Property ;
    rdfs:label 'Electronic Remittance Advice Required' ;
    rdfs:comment 'Indicates whether remittance advice must be delivered electronically via 835 transaction. ERA (Electronic Remittance Advice), 835 (Healthcare Payment/Remittance Advice).' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalRecordAccessRequired rdf:type rdf:Property ;
    rdfs:label 'Medical Record Access Required' ;
    rdfs:comment 'Indicates whether the provider must grant UnitedHealth access to member medical records for quality and utilization review.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ehrIntegrationRequired rdf:type rdf:Property ;
    rdfs:label 'Ehr Integration Required' ;
    rdfs:comment 'Indicates whether the provider must integrate their EHR system with UnitedHealth systems. EHR (Electronic Health Record).' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hieParticipationRequired rdf:type rdf:Property ;
    rdfs:label 'Hie Participation Required' ;
    rdfs:comment 'Indicates whether the provider must participate in health information exchange networks. HIE (Health Information Exchange).' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthServicesAllowed rdf:type rdf:Property ;
    rdfs:label 'Telehealth Services Allowed' ;
    rdfs:comment 'Indicates whether the provider is authorized to deliver telehealth services under this contract.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberGrievanceResponseDays rdf:type rdf:Property ;
    rdfs:label 'Member Grievance Response Days' ;
    rdfs:comment 'Number of days within which the provider must respond to member grievances.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceAuditFrequency rdf:type rdf:Property ;
    rdfs:label 'Compliance Audit Frequency' ;
    rdfs:comment 'Frequency at which UnitedHealth conducts compliance audits of the provider under this contract.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudWasteAbuseTrainingRequired rdf:type rdf:Property ;
    rdfs:label 'Fraud Waste Abuse Training Required' ;
    rdfs:comment 'Indicates whether the provider must complete fraud, waste, and abuse training. FWA (Fraud Waste and Abuse).' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Hipaa Compliance Required' ;
    rdfs:comment 'Indicates whether the provider must maintain HIPAA compliance as a contract requirement. HIPAA (Health Insurance Portability and Accountability Act).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessAssociateAgreementSigned rdf:type rdf:Property ;
    rdfs:label 'Business Associate Agreement Signed' ;
    rdfs:comment 'Indicates whether a HIPAA Business Associate Agreement has been executed with the provider. BAA (Business Associate Agreement).' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:culturalCompetencyTrainingRequired rdf:type rdf:Property ;
    rdfs:label 'Cultural Competency Training Required' ;
    rdfs:comment 'Indicates whether the provider must complete cultural competency training for serving diverse populations.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageServicesRequired rdf:type rdf:Property ;
    rdfs:label 'Language Services Required' ;
    rdfs:comment 'Indicates whether the provider must offer language interpretation services to members.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accessibilityComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Accessibility Compliance Required' ;
    rdfs:comment 'Indicates whether the provider must comply with ADA accessibility requirements for facilities and services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Contract Approval Date' ;
    rdfs:comment 'Date when the contract was approved by UnitedHealth management.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateMedicaidContractNumber rdf:type rdf:Property ;
    rdfs:label 'State Medicaid Contract Number' ;
    rdfs:comment 'State-assigned contract number for Medicaid managed care programs.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Contract Document Url' ;
    rdfs:comment 'URL or file path to the stored contract document.' ;
    rdfs:domain ind:ProgramProviderContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitDesignId rdf:type rdf:Property ;
    rdfs:label 'Benefit Design Id' ;
    rdfs:comment 'Unique identifier for the benefit design configuration within government programs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenefitDesign .

ind:annualDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Deductible Amount' ;
    rdfs:comment 'Annual deductible amount the member must pay before plan benefits begin covering services.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicalDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Medical Deductible Amount' ;
    rdfs:comment 'Annual deductible specific to medical services excluding pharmacy benefits.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moopAmount rdf:type rdf:Property ;
    rdfs:label 'Moop Amount' ;
    rdfs:comment 'Maximum annual out-of-pocket cost sharing limit for covered services, after which plan pays 100%.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryCareCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Primary Care Copay Amount' ;
    rdfs:comment 'Fixed copayment amount for primary care physician office visits.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialistCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Specialist Copay Amount' ;
    rdfs:comment 'Fixed copayment amount for specialist physician office visits.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyRoomCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Emergency Room Copay Amount' ;
    rdfs:comment 'Fixed copayment amount for emergency room visits, may be waived if admitted.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:urgentCareCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Urgent Care Copay Amount' ;
    rdfs:comment 'Fixed copayment amount for urgent care facility visits.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inpatientHospitalCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Inpatient Hospital Copay Amount' ;
    rdfs:comment 'Copayment or coinsurance amount per admission or per day for inpatient hospital stays.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inpatientHospitalDaysCovered rdf:type rdf:Property ;
    rdfs:label 'Inpatient Hospital Days Covered' ;
    rdfs:comment 'Number of inpatient hospital days covered per benefit period or plan year.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:skilledNursingFacilityCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Skilled Nursing Facility Copay Amount' ;
    rdfs:comment 'Daily copayment amount for skilled nursing facility care.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:skilledNursingFacilityDaysCovered rdf:type rdf:Property ;
    rdfs:label 'Skilled Nursing Facility Days Covered' ;
    rdfs:comment 'Maximum number of skilled nursing facility days covered per benefit period.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:homeHealthCareCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Home Health Care Copay Amount' ;
    rdfs:comment 'Copayment amount per visit for home health care services.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outpatientSurgeryCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Outpatient Surgery Copay Amount' ;
    rdfs:comment 'Copayment or coinsurance amount for outpatient surgical procedures.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diagnosticTestCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Diagnostic Test Copay Amount' ;
    rdfs:comment 'Copayment amount for diagnostic tests and laboratory services.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:imagingCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Imaging Copay Amount' ;
    rdfs:comment 'Copayment amount for diagnostic imaging services such as X-rays, CT scans, and MRIs.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durableMedicalEquipmentCoinsurancePct rdf:type rdf:Property ;
    rdfs:label 'Durable Medical Equipment Coinsurance Pct' ;
    rdfs:comment 'Percentage of cost member pays for durable medical equipment after deductible.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:physicalTherapyCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Physical Therapy Copay Amount' ;
    rdfs:comment 'Copayment amount per visit for physical therapy, occupational therapy, and speech therapy services.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mentalHealthOutpatientCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Mental Health Outpatient Copay Amount' ;
    rdfs:comment 'Copayment amount for outpatient mental health and behavioral health visits.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mentalHealthInpatientCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Mental Health Inpatient Copay Amount' ;
    rdfs:comment 'Copayment or coinsurance for inpatient psychiatric hospital stays.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:substanceAbuseTreatmentCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Substance Abuse Treatment Copay Amount' ;
    rdfs:comment 'Copayment amount for substance abuse and addiction treatment services.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ambulanceCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Ambulance Copay Amount' ;
    rdfs:comment 'Copayment amount per trip for emergency and non-emergency ambulance services.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transportationBenefitAmount rdf:type rdf:Property ;
    rdfs:label 'Transportation Benefit Amount' ;
    rdfs:comment 'Maximum annual benefit amount for non-emergency medical transportation services.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dentalCoverageType rdf:type rdf:Property ;
    rdfs:label 'Dental Coverage Type' ;
    rdfs:comment 'Level of dental benefits included in the plan, ranging from preventive to comprehensive services.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dentalAnnualMaximum rdf:type rdf:Property ;
    rdfs:label 'Dental Annual Maximum' ;
    rdfs:comment 'Maximum annual benefit amount for dental services if coverage is included.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:visionCoverageType rdf:type rdf:Property ;
