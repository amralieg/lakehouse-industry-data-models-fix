ind:targetDimensionType rdf:type rdf:Property ;
    rdfs:label 'Target Dimension Type' ;
    rdfs:comment 'The type of financial dimension to which costs or revenues are allocated (cost center, department, line of business, product, geography, legal entity, business unit, service line, plan type, or network type).' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationWeight rdf:type rdf:Property ;
    rdfs:label 'Allocation Weight' ;
    rdfs:comment 'The weighting factor applied in the allocation calculation. Used for weighted allocation methods where weights may not sum to 100%.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Allocation Amount' ;
    rdfs:comment 'The minimum dollar amount threshold below which the allocation rule will not be applied.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Allocation Amount' ;
    rdfs:comment 'The maximum dollar amount cap that can be allocated under this rule in a single allocation cycle.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographyCode rdf:type rdf:Property ;
    rdfs:label 'Geography Code' ;
    rdfs:comment 'The geographic region or state code to which this allocation rule applies (ISO 3166 country codes or US state codes).' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isReciprocal rdf:type rdf:Property ;
    rdfs:label 'Is Reciprocal' ;
    rdfs:comment 'Indicates whether this allocation rule participates in reciprocal allocation where costs are allocated back and forth between cost centers.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoPostFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Post Flag' ;
    rdfs:comment 'Indicates whether allocation transactions generated by this rule are automatically posted to the general ledger without manual intervention.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Allowed Flag' ;
    rdfs:comment 'Indicates whether allocation transactions generated by this rule can be reversed or adjusted after posting.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ruleFormula rdf:type rdf:Property ;
    rdfs:label 'Rule Formula' ;
    rdfs:comment 'The mathematical formula or expression used to calculate the allocation amount. May reference allocation basis metrics and weighting factors.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationPrecision rdf:type rdf:Property ;
    rdfs:label 'Calculation Precision' ;
    rdfs:comment 'The number of decimal places to which allocation calculations are rounded.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statutoryFilingFlag rdf:type rdf:Property ;
    rdfs:label 'Statutory Filing Flag' ;
    rdfs:comment 'Indicates whether allocations generated by this rule are included in statutory financial filings with state insurance departments.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

