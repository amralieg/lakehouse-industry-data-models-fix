  parent_calendar_id varchar [note: 'Self-referencing FK on calendar (parent_calendar_id) | Column parent_calendar_id (BIGINT) in compliance.calendar']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Compliance calendar entries track specific filing deadlines. This FK links calendar deadlines to the actual regulatory filing records, enabling tracking of whether filings were submitted on time. | Column regulatory_filing_id (BIGINT) in compliance.calendar']
  regulatory_obligation_id varchar [note: 'Reference to the underlying regulatory obligation that this calendar entry tracks. Links to the master obligation registry. | Column regulatory_obligation_id (BIGINT) in compliance.calendar']
  responsible_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Compliance calendar deadlines must be assigned to specific employees for accountability and workload management. Responsible owner contact data should reference employee record. | Column responsible_owner_employee_id (BIGINT) in workforce.calendar']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Scheduled equipment testing and certification deadlines (annual transmitter testing, EAS equipment verification) tracked in compliance calendar. Real broadcast operations workflow for regulatory deadl | Column transmission_equipment_id (BIGINT) in technology.calendar']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.calendar']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.calendar']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.calendar']
