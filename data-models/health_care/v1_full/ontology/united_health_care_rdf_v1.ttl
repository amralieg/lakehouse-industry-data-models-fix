    rdfs:comment 'Flag indicating whether the member is enrolled under COBRA continuation coverage following a qualifying event such as job loss or reduction in hours.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraQualifyingEvent rdf:type rdf:Property ;
    rdfs:label 'Cobra Qualifying Event' ;
    rdfs:comment 'The specific qualifying event that entitled the member to elect COBRA continuation coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraElectionDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Election Date' ;
    rdfs:comment 'The date when the member elected to continue coverage under COBRA following a qualifying event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobraMaxMonths rdf:type rdf:Property ;
    rdfs:label 'Cobra Max Months' ;
    rdfs:comment 'The maximum number of months the member is entitled to COBRA continuation coverage based on the qualifying event type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicareIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicare Indicator' ;
    rdfs:comment 'Flag indicating whether the member has Medicare coverage, affecting coordination of benefits and secondary payer determination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicarePartAEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Medicare Part A Effective Date' ;
    rdfs:comment 'The date when the member\'s Medicare Part A hospital insurance coverage became effective.' ;
