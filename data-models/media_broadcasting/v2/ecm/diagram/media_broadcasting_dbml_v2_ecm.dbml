  dispute_notes varchar [note: 'Notes regarding any disputes.']
  distribution_fees varchar
  distribution_fees_amount decimal(18,2) [note: 'Distribution fees deducted.']
  gross_receipts_amount decimal(18,2) [note: 'Total gross receipts for the period.']
  gross_revenue varchar
