    rdfs:range xsd:string .

ind:socialMediaHandle rdf:type rdf:Property ;
    rdfs:label 'Social Media Handle' ;
    rdfs:comment 'Social media account handle or username if the channel is social media-based (e.g., @UnitedHealthcare).' ;
