    rdfs:range xsd:string .

ind:statusReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Status Reason Description' ;
    rdfs:comment 'Detailed text description explaining the reason for the eligibility status change, providing context for audit and member inquiry purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageStartDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Start Date' ;
    rdfs:comment 'The original date when the member\'s coverage under this plan first began, used for calculating continuous coverage and waiting periods.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'The date when the eligibility transaction was processed and recorded in the enrollment system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'The type of enrollment transaction that triggered this eligibility history record, indicating the nature of the status change.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeReasonCode rdf:type rdf:Property ;
    rdfs:label 'Change Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for the eligibility change, such as life event, open enrollment, or involuntary termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Change Reason Description' ;
    rdfs:comment 'Detailed description of the reason for the eligibility change, providing additional context beyond the standardized code.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualifyingEventCode rdf:type rdf:Property ;
    rdfs:label 'Qualifying Event Code' ;
    rdfs:comment 'Code identifying the qualifying life event that triggered a special enrollment period or coverage change outside of open enrollment.' ;
    rdfs:domain ind:History ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraIndicator rdf:type rdf:Property ;
