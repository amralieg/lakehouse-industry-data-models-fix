    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionOutcome rdf:type rdf:Property ;
    rdfs:label 'Decision Outcome' ;
    rdfs:comment 'Final outcome of the underwriting evaluation process.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthQuestionnaireCompleted rdf:type rdf:Property ;
    rdfs:label 'Health Questionnaire Completed' ;
    rdfs:comment 'Indicates whether the applicant completed a health questionnaire as part of the underwriting process.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preExistingConditionsIdentified rdf:type rdf:Property ;
    rdfs:label 'Pre Existing Conditions Identified' ;
    rdfs:comment 'Indicates whether pre-existing medical conditions were identified during underwriting review.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tobaccoRatedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Tobacco Rated Premium Amount' ;
    rdfs:comment 'Additional premium amount applied due to tobacco use rating.' ;
