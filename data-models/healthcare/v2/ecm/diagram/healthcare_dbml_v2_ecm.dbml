  cost_center_code varchar [note: 'Cost center code for financial allocation.']
  created_timestamp timestamp [note: 'Timestamp when the position was created.']
  effective_date date [note: 'Date the position becomes effective.']
  employment_category varchar [note: 'Employment category (regular, temporary, etc.).']
  end_date date [note: 'End date if the position is time-limited.']
  flsa_classification varchar [note: 'FLSA classification for the position.']
  fte_allocation decimal(5,2) [note: 'FTE allocation for the position.']
  headcount_count varchar [note: 'Number of headcount slots for this position.']
  is_clinical boolean [note: 'Whether this is a clinical position.']
  is_critical_role boolean [note: 'Whether this position is designated as critical.']
  is_management boolean [note: 'Whether this is a management position.']
  is_provider boolean [note: 'Whether this position is a provider role.']
  is_union_eligible boolean [note: 'Whether this position is union eligible.']
  job_family varchar [note: 'Job family grouping for the position.']
  location_type varchar [note: 'Location type (on-site, remote, hybrid).']
  osha_job_hazard_category varchar [note: 'OSHA job hazard category for safety compliance.']
  pay_grade varchar [note: 'Pay grade level for the position.']
  pay_range_max decimal(12,2) [note: 'Maximum pay range for the position.']
  pay_range_min decimal(12,2) [note: 'Minimum pay range for the position.']
  position_code varchar [note: 'Unique position code identifier.']
  position_status varchar [note: 'Current status of the position (open, filled, frozen, closed).']
  position_type varchar [note: 'Type of position (permanent, temporary, contract).']
  required_certification varchar [note: 'Required certifications for the position.']
  required_education_level varchar [note: 'Minimum education level required.']
  required_license_type varchar [note: 'Type of license required for the position.']
  shift_type varchar [note: 'Shift type (day, night, rotating, etc.).']
  source_system_code varchar [note: 'Source system code for integration.']
  source_system_position_code varchar [note: 'Position code in the source system.']
  standard_hours_per_week decimal(5,2) [note: 'Standard hours per week for the position.']
  title varchar [note: 'Position title.']
  union_code varchar [note: 'Union code if applicable.']
  updated_timestamp timestamp [note: 'Timestamp of last update.']
  vacancy_reason varchar [note: 'Reason for vacancy if position is open.']
  vibe_added_flag boolean [note: 'Added by VIBE mutator']

  Note: 'Defines authorized positions within the organization including clinical and non-clinical roles with associated requirements.'
}

Table workforce.job_profile {
  job_profile_id varchar [pk, note: 'Unique identifier for the job profile.']
  scope_cpt_code_id varchar [note: 'FK to CPT code defining scope of practice.']
  background_check_required boolean [note: 'Whether background check is required.']
  certification_required boolean [note: 'Whether certification is required.']
