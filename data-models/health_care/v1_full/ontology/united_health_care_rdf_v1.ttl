    rdfs:range xsd:string .

ind:internationalCoverageCoordination rdf:type rdf:Property ;
    rdfs:label 'International Coverage Coordination' ;
    rdfs:comment 'Rule defining how international or out-of-country coverage is coordinated between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costSharingTypeId rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Type Id' ;
    rdfs:comment 'Unique identifier for the cost sharing type. Primary key for the cost sharing type lookup table.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appliesToMoopIndicator rdf:type rdf:Property ;
    rdfs:label 'Applies To Moop Indicator' ;
    rdfs:comment 'Indicates whether amounts paid under this cost sharing type count toward the member\'s annual maximum out-of-pocket limit.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToDeductibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Applies To Deductible Indicator' ;
    rdfs:comment 'Indicates whether amounts paid under this cost sharing type count toward satisfying the member\'s deductible requirement.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberResponsibilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Member Responsibility Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type represents a direct financial obligation for the member at point of service.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkTierApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Network Tier Applicable Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type varies based on provider network tier (in-network, out-of-network, preferred, etc.).' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceTypeSpecificIndicator rdf:type rdf:Property ;
    rdfs:label 'Service Type Specific Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type is defined differently for specific service categories (e.g., office visit copay vs. specialist copay).' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accumulatorType rdf:type rdf:Property ;
    rdfs:label 'Accumulator Type' ;
    rdfs:comment 'Defines how cost sharing amounts accumulate: individual member level, family aggregate, embedded (individual within family), or other structure.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resetFrequency rdf:type rdf:Property ;
    rdfs:label 'Reset Frequency' ;
    rdfs:comment 'Defines how often the cost sharing accumulator resets (e.g., annually on plan renewal, calendar year, per benefit period).' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acaCompliantIndicator rdf:type rdf:Property ;
    rdfs:label 'Aca Compliant Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type structure meets ACA requirements for qualified health plans and essential health benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicare Applicable Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type is used in Medicare Advantage, Medicare Supplement, or Part D plans.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicaid Applicable Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type is permitted under Medicaid managed care regulations and state plan requirements.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Commercial Applicable Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type is used in commercial fully-insured or self-funded employer group plans.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exchangeQhpApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Exchange Qhp Applicable Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type is used in Qualified Health Plans offered on federal or state-based marketplaces.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveCareWaivedIndicator rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Waived Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type is waived for ACA-mandated preventive services with A or B USPSTF rating.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorAuthorizationRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Required Indicator' ;
    rdfs:comment 'Indicates whether services subject to this cost sharing type require prior authorization before the cost sharing applies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transparencyReportingRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Transparency Reporting Required Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type must be disclosed in machine-readable files per Transparency in Coverage Rule.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryFilingReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Reference' ;
    rdfs:comment 'Reference number or identifier for the state insurance department filing that approved this cost sharing type structure.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialValueImpactPercentage rdf:type rdf:Property ;
    rdfs:label 'Actuarial Value Impact Percentage' ;
    rdfs:comment 'Estimated percentage impact this cost sharing type has on the overall actuarial value calculation for metal tier classification.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCommunicationLabel rdf:type rdf:Property ;
    rdfs:label 'Member Communication Label' ;
    rdfs:comment 'Consumer-friendly label used in member-facing documents, EOBs, and digital tools to describe this cost sharing type.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eobDisplayCode rdf:type rdf:Property ;
    rdfs:label 'Eob Display Code' ;
    rdfs:comment 'Standardized code used on Explanation of Benefits statements to identify this cost sharing type in claim payment details.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimAdjustmentReasonCode rdf:type rdf:Property ;
