ind:cfr42EmployeeId rdf:type rdf:Property ;
    rdfs:label 'Cfr42 Employee Id' ;
    rdfs:comment 'Identifier of the user who created the consent record.' ;
    rdfs:domain ind:Cfr42ConsentWorkflow ;
