ind:errorsAndOmissionsExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Errors And Omissions Expiration Date' ;
    rdfs:comment 'Expiration date of the brokers errors and omissions liability insurance policy.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:errorsAndOmissionsInsuranceCarrier rdf:type rdf:Property ;
    rdfs:label 'Errors And Omissions Insurance Carrier' ;
    rdfs:comment 'Name of the insurance carrier providing errors and omissions liability coverage for the broker.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorsAndOmissionsPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Errors And Omissions Policy Number' ;
    rdfs:comment 'Policy number for the brokers errors and omissions liability insurance coverage.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Hipaa Certification Date' ;
    rdfs:comment 'Date when the broker completed HIPAA privacy and security certification training.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Boolean flag indicating whether the broker is currently active and eligible to transact business.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Modified Timestamp' ;
    rdfs:comment 'Date and time when the broker record was most recently updated in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'The official legal name of the broker or brokerage firm as registered with regulatory authorities.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'License Expiration Date' ;
    rdfs:comment 'Date when the brokers primary insurance producer license expires and requires renewal.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseIssueDate rdf:type rdf:Property ;
    rdfs:label 'License Issue Date' ;
    rdfs:comment 'Date when the brokers primary insurance producer license was originally issued.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseNumber rdf:type rdf:Property ;
    rdfs:label 'License Number' ;
    rdfs:comment 'Primary state-issued insurance producer license number for the brokers home state of domicile.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseState rdf:type rdf:Property ;
    rdfs:label 'License State' ;
    rdfs:comment 'Two-letter state code where the broker holds their primary insurance producer license.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketSegment rdf:type rdf:Property ;
    rdfs:label 'Market Segment' ;
    rdfs:comment 'Primary market segment or line of business that the broker specializes in selling.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalProducerNumber rdf:type rdf:Property ;
    rdfs:label 'National Producer Number' ;
    rdfs:comment 'Unique 10-digit identifier assigned by the National Insurance Producer Registry (NIPR) to licensed insurance producers and brokers in the United States.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideCommissionRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Override Commission Rate Percentage' ;
    rdfs:comment 'Additional override commission rate percentage for managing general agents or agency principals.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceTier rdf:type rdf:Property ;
    rdfs:label 'Performance Tier' ;
    rdfs:comment 'Performance classification tier assigned to the broker based on sales volume and quality metrics.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactName rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Name' ;
    rdfs:comment 'Full name of the primary contact person at the brokerage firm for operational communications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Email' ;
    rdfs:comment 'Primary email address for official communications with the broker or brokerage firm.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Phone' ;
    rdfs:comment 'Primary telephone number for contacting the broker or brokerage firm.' ;
