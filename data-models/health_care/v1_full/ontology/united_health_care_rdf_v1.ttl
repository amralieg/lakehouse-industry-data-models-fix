ind:confidentialJustification rdf:type rdf:Property ;
    rdfs:label 'Confidential Justification' ;
    rdfs:comment 'Justification or rationale for requesting confidential treatment of filing information.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentRepositoryPath rdf:type rdf:Property ;
    rdfs:label 'Document Repository Path' ;
    rdfs:comment 'File path or URL to the repository location where filing documents are stored.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingFeeAmount rdf:type rdf:Property ;
