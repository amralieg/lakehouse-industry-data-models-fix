    rdfs:comment 'Table storing trial eligibility criteria' .

ind:PatientEligibility rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalTrialMatching ;
    rdfs:label 'Patient Eligibility' ;
    rdfs:comment 'Table linking patients to trial eligibility results' .

ind:ClinicalAiGovernanceModelCard rdf:type rdfs:Class ;
