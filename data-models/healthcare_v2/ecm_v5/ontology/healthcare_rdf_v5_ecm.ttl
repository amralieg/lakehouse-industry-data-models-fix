    rdfs:comment 'Primary key for eligibility_criteria_evaluation' ;
    rdfs:domain ind:EligibilityCriteriaEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibilityEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Evaluation Id' ;
    rdfs:comment 'Foreign key linking to clinical_trial_matching.eligibility_evaluation. Business justification: Individual criteria evaluations belong to an overall eligibility evaluation session. This links the detail to the header.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EligibilityEvaluation .

ind:trialEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Trial Enrollment Id' ;
    rdfs:comment 'Primary key for trial_enrollment' ;
    rdfs:domain ind:TrialEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modelFeatureMappingId rdf:type rdf:Property ;
    rdfs:label 'Model Feature Mapping Id' ;
    rdfs:comment 'Unique surrogate key for the model-feature mapping record.' ;
    rdfs:domain ind:ModelFeatureMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:importanceScore rdf:type rdf:Property ;
    rdfs:label 'Importance Score' ;
    rdfs:comment 'SHAP or LIME feature importance score indicating how much this feature contributes to the specific model\'s predictions. Value between 0 and 1.' ;
    rdfs:domain ind:ModelFeatureMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rank rdf:type rdf:Property ;
    rdfs:label 'Rank' ;
    rdfs:comment 'Ordinal rank of this feature\'s importance within the model\'s feature set (1 = most important).' ;
    rdfs:domain ind:ModelFeatureMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Program Assignment Id' ;
    rdfs:comment 'System-generated unique identifier for each clinician-to-RPM-program assignment record' ;
    rdfs:domain ind:ProgramAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientPanelCapacity rdf:type rdf:Property ;
    rdfs:label 'Patient Panel Capacity' ;
    rdfs:comment 'Maximum number of patients this clinician can manage within this specific RPM program, reflecting workload allocation and program staffing model' ;
    rdfs:domain ind:ProgramAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programMonitoringRequirementId rdf:type rdf:Property ;
    rdfs:label 'Program Monitoring Requirement Id' ;
    rdfs:comment 'System-generated unique identifier for the program monitoring requirement record.' ;
    rdfs:domain ind:ProgramMonitoringRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monitoringIntervalDays rdf:type rdf:Property ;
    rdfs:label 'Monitoring Interval Days' ;
    rdfs:comment 'Number of days between required test administrations for this program-test combination. Provides numeric precision for scheduling and compliance tracking.' ;
    rdfs:domain ind:ProgramMonitoringRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drugMonitoringProtocolId rdf:type rdf:Property ;
    rdfs:label 'Drug Monitoring Protocol Id' ;
    rdfs:comment 'Primary key for the drug_monitoring_protocol association' ;
    rdfs:domain ind:DrugMonitoringProtocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drugMonitoringProtocolStatus rdf:type rdf:Property ;
    rdfs:label 'Drug Monitoring Protocol Status' ;
    rdfs:comment 'Current lifecycle status of this drug monitoring protocol within the RPM program.' ;
    rdfs:domain ind:DrugMonitoringProtocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringParameter rdf:type rdf:Property ;
    rdfs:label 'Monitoring Parameter' ;
    rdfs:comment 'The specific physiological or laboratory parameter being monitored for this drug within this RPM program (e.g., INR for warfarin, blood glucose for metformin).' ;
    rdfs:domain ind:DrugMonitoringProtocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetRangeHigh rdf:type rdf:Property ;
    rdfs:label 'Target Range High' ;
    rdfs:comment 'The upper bound of the acceptable range for the monitored parameter specific to this drug-program combination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetRangeLow rdf:type rdf:Property ;
    rdfs:label 'Target Range Low' ;
    rdfs:comment 'The lower bound of the acceptable range for the monitored parameter specific to this drug-program combination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:featureContributionId rdf:type rdf:Property ;
    rdfs:label 'Feature Contribution Id' ;
    rdfs:comment 'Primary key for the feature_contribution association' ;
    rdfs:domain ind:FeatureContribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:featureRank rdf:type rdf:Property ;
    rdfs:label 'Feature Rank' ;
    rdfs:comment 'Ordinal rank of this lab result among all input features for this specific risk score computation. Rank 1 indicates the most influential feature. Used for clinical display of top-N contributing factors.' ;
    rdfs:domain ind:FeatureContribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCriticalFeature rdf:type rdf:Property ;
    rdfs:label 'Is Critical Feature' ;
    rdfs:comment 'Boolean flag indicating whether this lab result was among the top-N most influential features for this risk score. Used to filter explainability displays for clinicians who need concise decision support summaries.' ;
    rdfs:domain ind:FeatureContribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueAtScoringTime rdf:type rdf:Property ;
    rdfs:label 'Value At Scoring Time' ;
    rdfs:comment 'Snapshot of the lab result value as it was presented to the ML model at inference time. Stored as STRING to accommodate numeric, coded, and text result types. Critical for reproducibility audits and model debugging.' ;
    rdfs:domain ind:FeatureContribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:carePlanMedicationId rdf:type rdf:Property ;
    rdfs:label 'Care Plan Medication Id' ;
    rdfs:comment 'System-generated surrogate primary key for the care plan medication association record' ;
    rdfs:domain ind:CarePlanMedication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dosageInstructions rdf:type rdf:Property ;
    rdfs:label 'Dosage Instructions' ;
    rdfs:comment 'Specific dosage and administration instructions for this medication within this care plan (e.g., \'25mg PO BID with food\')' ;
    rdfs:domain ind:CarePlanMedication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationPlan rdf:type rdf:Property ;
    rdfs:label 'Medication Plan' ;
    rdfs:comment 'Prescribed medication regimen and administration instructions for the post-acute period. [Moved from post_acute_care_plan: The medication_plan free-text field on post_acute_care_plan contains unstructured medication data that should be decomposed into discrete care_plan_medication records for each drug. Once normalized, this field becomes redundant or serves only as a legacy narrative summary.]' ;
    rdfs:domain ind:CarePlanMedication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringRequired rdf:type rdf:Property ;
    rdfs:label 'Monitoring Required' ;
    rdfs:comment 'Flag indicating whether this medication requires laboratory or clinical monitoring during the post-acute episode (e.g., INR for warfarin, renal function for vancomycin)' ;
    rdfs:domain ind:CarePlanMedication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacogenomicInteractionId rdf:type rdf:Property ;
    rdfs:label 'Pharmacogenomic Interaction Id' ;
    rdfs:comment 'Primary key for the pharmacogenomic_interaction association' ;
    rdfs:domain ind:PharmacogenomicInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interactionType rdf:type rdf:Property ;
    rdfs:label 'Interaction Type' ;
    rdfs:comment 'Classification of the pharmacogenomic interaction mechanism - how the genetic variant affects the drug (e.g., altered metabolism via CYP enzymes, drug transport changes, receptor sensitivity differences)' ;
    rdfs:domain ind:PharmacogenomicInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:staffingAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Staffing Assignment Id' ;
    rdfs:comment 'System-generated surrogate primary key for the staffing assignment record.' ;
    rdfs:domain ind:StaffingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentRole rdf:type rdf:Property ;
    rdfs:label 'Assignment Role' ;
    rdfs:comment 'The specific clinical or administrative role the employee fills at this post-acute location. An employee may hold different roles at different locations.' ;
    rdfs:domain ind:StaffingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceSupplyRequirementId rdf:type rdf:Property ;
    rdfs:label 'Service Supply Requirement Id' ;
    rdfs:comment 'Unique surrogate key for each service-supply requirement record' ;
    rdfs:domain ind:ServiceSupplyRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isOptional rdf:type rdf:Property ;
    rdfs:label 'Is Optional' ;
    rdfs:comment 'Indicates whether this supply item is optional (true) or mandatory (false) for delivering the service' ;
    rdfs:domain ind:ServiceSupplyRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantityRequired rdf:type rdf:Property ;
    rdfs:label 'Quantity Required' ;
    rdfs:comment 'Number of units of the supply item required per single session of the post-acute service' ;
    rdfs:domain ind:ServiceSupplyRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:substitutionAllowed rdf:type rdf:Property ;
    rdfs:label 'Substitution Allowed' ;
    rdfs:comment 'Indicates whether an alternative supply item may be substituted if this item is unavailable' ;
    rdfs:domain ind:ServiceSupplyRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:programMeasureAlignmentId rdf:type rdf:Property ;
    rdfs:label 'Program Measure Alignment Id' ;
    rdfs:comment 'System-generated unique identifier for the program-measure alignment record.' ;
    rdfs:domain ind:ProgramMeasureAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programMeasureAlignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Program Measure Alignment Status' ;
    rdfs:comment 'Current lifecycle status of this alignment (active, suspended, retired).' ;
    rdfs:domain ind:ProgramMeasureAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetThreshold rdf:type rdf:Property ;
    rdfs:label 'Target Threshold' ;
    rdfs:comment 'Program-specific performance target for this measure, which may differ from the measure\'s global benchmark threshold (e.g., 85% vs global 90%).' ;
    rdfs:domain ind:ProgramMeasureAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureModelValidationId rdf:type rdf:Property ;
    rdfs:label 'Measure Model Validation Id' ;
    rdfs:comment 'System-generated unique identifier for the measure-model validation record' ;
    rdfs:domain ind:MeasureModelValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modelRole rdf:type rdf:Property ;
    rdfs:label 'Model Role' ;
    rdfs:comment 'Classification of how the AI model contributes to the quality measure calculation (e.g., prediction, NLP extraction, scoring)' ;
    rdfs:domain ind:MeasureModelValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceContributionWeight rdf:type rdf:Property ;
    rdfs:label 'Performance Contribution Weight' ;
    rdfs:comment 'Numeric weight representing how much this model contributes to the overall measure calculation (0.0000 to 1.0000)' ;
    rdfs:domain ind:MeasureModelValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measureApplicabilityId rdf:type rdf:Property ;
    rdfs:label 'Measure Applicability Id' ;
    rdfs:comment 'System-generated unique surrogate key for each measure-service applicability record.' ;
    rdfs:domain ind:MeasureApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Applicability Flag' ;
    rdfs:comment 'Indicates whether the quality measure currently applies to this post-acute service for reporting purposes.' ;
    rdfs:domain ind:MeasureApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:programMetricId rdf:type rdf:Property ;
    rdfs:label 'Program Metric Id' ;
    rdfs:comment 'System-generated unique identifier for the program metric configuration record.' ;
    rdfs:domain ind:ProgramMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isPrimaryMetric rdf:type rdf:Property ;
    rdfs:label 'Is Primary Metric' ;
    rdfs:comment 'Indicates whether this LOINC-coded metric is the primary monitored metric for the program (true) or a secondary/supplementary metric (false).' ;
    rdfs:domain ind:ProgramMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementFrequency rdf:type rdf:Property ;
    rdfs:label 'Measurement Frequency' ;
    rdfs:comment 'Required frequency of measurement capture for this metric within this program (e.g., twice_daily, daily, weekly).' ;
    rdfs:domain ind:ProgramMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyGenomicEligibilityId rdf:type rdf:Property ;
    rdfs:label 'Study Genomic Eligibility Id' ;
    rdfs:comment 'System-generated unique identifier for each study-genomic eligibility mapping record.' ;
    rdfs:domain ind:StudyGenomicEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:biomarkerRequirementType rdf:type rdf:Property ;
    rdfs:label 'Biomarker Requirement Type' ;
    rdfs:comment 'Classification of the biomarker criterion type the study requires (e.g., mutation, amplification, expression level, fusion, MSI status).' ;
    rdfs:domain ind:StudyGenomicEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Inclusion Exclusion Flag' ;
    rdfs:comment 'Indicates whether this genomic finding serves as an inclusion criterion or exclusion criterion for the study.' ;
    rdfs:domain ind:StudyGenomicEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredVariant rdf:type rdf:Property ;
    rdfs:label 'Required Variant' ;
    rdfs:comment 'The specific genetic variant or biomarker value the study protocol requires for eligibility (e.g., EGFR L858R, BRCA1 pathogenic, PD-L1 >= 50%).' ;
    rdfs:domain ind:StudyGenomicEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceIndicationId rdf:type rdf:Property ;
    rdfs:label 'Service Indication Id' ;
    rdfs:comment 'Unique surrogate key for each service indication record. Primary key.' ;
    rdfs:domain ind:ServiceIndication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:diagnosisRelatedIcd10 rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Related Icd10' ;
    rdfs:comment 'Comma-separated list of ICD-10 diagnosis codes that commonly justify the service. [Moved from post_acute_service: This comma-separated list of ICD-10 codes is a denormalized representation of the M:N relationship between services and diagnoses. It should be replaced by proper rows in the service_indication association table, providing referential integrity, temporal validity, and queryable coverage attributes per diagnosis-service combination.]' ;
    rdfs:domain ind:ServiceIndication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryIndication rdf:type rdf:Property ;
    rdfs:label 'Is Primary Indication' ;
    rdfs:comment 'True if this diagnosis is a primary clinical indication for the service; false if it is a secondary or supporting indication.' ;
    rdfs:domain ind:ServiceIndication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planServiceCoverageId rdf:type rdf:Property ;
    rdfs:label 'Plan Service Coverage Id' ;
    rdfs:comment 'Unique surrogate key for each plan-service coverage record' ;
    rdfs:domain ind:PlanServiceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benefitLimitDays rdf:type rdf:Property ;
    rdfs:label 'Benefit Limit Days' ;
    rdfs:comment 'Maximum number of days or sessions covered per episode of care for this service under this plan\'s benefit structure' ;
    rdfs:domain ind:PlanServiceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:criteriaMatchEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Criteria Match Evaluation Id' ;
    rdfs:comment 'Surrogate primary key for each criteria match evaluation record' ;
    rdfs:domain ind:CriteriaMatchEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cohortProgramAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Cohort Program Assignment Id' ;
    rdfs:comment 'System-generated unique identifier for the cohort-program assignment record.' ;
    rdfs:domain ind:CohortProgramAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoEnrollEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Enroll Enabled' ;
    rdfs:comment 'Indicates whether patients entering this cohort are automatically enrolled in the linked RPM program without manual intervention.' ;
    rdfs:domain ind:CohortProgramAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modelTagAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Model Tag Assignment Id' ;
    rdfs:comment 'Unique surrogate key for the model tag assignment record' ;
    rdfs:domain ind:ModelTagAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appliedBy rdf:type rdf:Property ;
    rdfs:label 'Applied By' ;
    rdfs:comment 'Identity of the user or service principal who applied the tag to the model, required for HIPAA audit compliance' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Applied Timestamp' ;
    rdfs:comment 'Date-time when the tag was applied to the model card, supporting governance audit trail' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isInherited rdf:type rdf:Property ;
    rdfs:label 'Is Inherited' ;
    rdfs:comment 'Indicates whether the tag was inherited from a parent model or catalog-level policy rather than explicitly assigned to this model card' ;
    rdfs:domain ind:ModelTagAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tagValue rdf:type rdf:Property ;
    rdfs:label 'Tag Value' ;
    rdfs:comment 'The specific value assigned from the tag definition\'s allowed_values list (e.g., \'true\', \'high\', \'cardiology\')' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:featureTagApplicationId rdf:type rdf:Property ;
    rdfs:label 'Feature Tag Application Id' ;
    rdfs:comment 'Primary key for the feature_tag_application association' ;
    rdfs:domain ind:FeatureTagApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isSensitiveOverride rdf:type rdf:Property ;
    rdfs:label 'Is Sensitive Override' ;
    rdfs:comment 'Indicates whether this specific tag application overrides the default sensitivity classification derived from the tag definition, allowing per-feature exceptions to standard governance rules.' ;
    rdfs:domain ind:FeatureTagApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genomicCohortQualificationId rdf:type rdf:Property ;
    rdfs:label 'Genomic Cohort Qualification Id' ;
    rdfs:comment 'Unique surrogate key for the genomic cohort qualification record' ;
    rdfs:domain ind:GenomicCohortQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicRiskScore rdf:type rdf:Property ;
    rdfs:label 'Genomic Risk Score' ;
    rdfs:comment 'Risk score calculated in the context of this specific cohort qualification, derived from the genomic profile data' ;
    rdfs:domain ind:GenomicCohortQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inclusionConfidence rdf:type rdf:Property ;
    rdfs:label 'Inclusion Confidence' ;
    rdfs:comment 'Confidence level (0-1) that the genomic profile truly meets the cohort inclusion criteria' ;
    rdfs:domain ind:GenomicCohortQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualificationCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Qualification Criteria Met' ;
    rdfs:comment 'Specific inclusion criteria from the cohort definition that this genomic profile satisfies' ;
    rdfs:domain ind:GenomicCohortQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualificationDate rdf:type rdf:Property ;
    rdfs:label 'Qualification Date' ;
    rdfs:comment 'Date when the patient genomic profile was determined to qualify for the cohort' ;
    rdfs:domain ind:GenomicCohortQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:genomicCohortInclusionId rdf:type rdf:Property ;
    rdfs:label 'Genomic Cohort Inclusion Id' ;
    rdfs:comment 'Unique surrogate key for the genomic cohort inclusion record' ;
    rdfs:domain ind:GenomicCohortInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Genomic Criteria Met' ;
    rdfs:comment 'Description of which specific genomic findings (variants, mutations, markers) triggered cohort inclusion' ;
    rdfs:domain ind:GenomicCohortInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionDate rdf:type rdf:Property ;
    rdfs:label 'Inclusion Date' ;
    rdfs:comment 'Date when the genomic profile was determined to meet cohort criteria and was included' ;
    rdfs:domain ind:GenomicCohortInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskScoreAtInclusion rdf:type rdf:Property ;
    rdfs:label 'Risk Score At Inclusion' ;
    rdfs:comment 'The patient risk stratification score captured at the time of cohort inclusion, providing a temporal snapshot' ;
    rdfs:domain ind:GenomicCohortInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:genomicsTrialEligibilityMatchId rdf:type rdf:Property ;
    rdfs:label 'Genomics Trial Eligibility Match Id' ;
    rdfs:comment 'Primary key for genomics_trial_eligibility_match' ;
    rdfs:domain ind:GenomicsTrialEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:criterionMetFlag rdf:type rdf:Property ;
    rdfs:label 'Criterion Met Flag' ;
    rdfs:comment 'Indicates whether the genomic test result definitively satisfies the eligibility criterion after clinical review' ;
    rdfs:domain ind:GenomicsTrialEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalTrialMatchingTrialEligibilityMatchId rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Matching Trial Eligibility Match Id' ;
    rdfs:comment 'Primary key for clinical_trial_matching_trial_eligibility_match' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:biomarkerMatchType rdf:type rdf:Property ;
    rdfs:label 'Biomarker Match Type' ;
    rdfs:comment 'Classification of how the genomic finding matches the trial\'s biomarker criteria — exact variant match, partial match, inferred from pathway, etc.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchDate rdf:type rdf:Property ;
    rdfs:label 'Match Date' ;
    rdfs:comment 'Timestamp when the eligibility match was evaluated by the matching algorithm or coordinator' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:postAcuteCareCohortMembershipId rdf:type rdf:Property ;
    rdfs:label 'Post Acute Care Cohort Membership Id' ;
    rdfs:comment 'Primary key for post_acute_care_cohort_membership' ;
    rdfs:domain ind:PostAcuteCareCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cohortMembershipCode rdf:type rdf:Property ;
    rdfs:label 'Cohort Membership Code' ;
    rdfs:comment 'Unique surrogate key for the cohort membership record' ;
    rdfs:domain ind:PostAcuteCareCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetOutcome rdf:type rdf:Property ;
    rdfs:label 'Target Outcome' ;
    rdfs:comment 'Specific clinical or financial outcome target for this episode within this cohort program' ;
    rdfs:domain ind:PostAcuteCareCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:psychiatricClinicianId rdf:type rdf:Property ;
    rdfs:label 'Psychiatric Clinician Id' ;
    rdfs:comment 'The clinician (psychiatrist, psychologist, LCSW, or other qualified provider) who conducted the psychiatric assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:psychiatricCosigningProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Psychiatric Cosigning Provider Clinician Id' ;
    rdfs:comment 'The supervising or attending provider who cosigned this assessment when performed by a trainee or mid-level provider requiring supervision.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:affectDescription rdf:type rdf:Property ;
    rdfs:label 'Affect Description' ;
    rdfs:comment 'Clinician\'s objective observation of the patient\'s emotional expression including range, congruence, intensity, and reactivity.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentDatetime rdf:type rdf:Property ;
    rdfs:label 'Assessment Datetime' ;
    rdfs:comment 'The date and time when the psychiatric assessment was conducted with the patient. This is the principal clinical event timestamp.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assessmentSetting rdf:type rdf:Property ;
    rdfs:label 'Assessment Setting' ;
    rdfs:comment 'The clinical setting or environment in which the psychiatric assessment was conducted.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityToConsent rdf:type rdf:Property ;
    rdfs:label 'Capacity To Consent' ;
    rdfs:comment 'Clinician\'s determination of the patient\'s decisional capacity to provide informed consent for treatment at the time of assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalFormulation rdf:type rdf:Property ;
    rdfs:label 'Clinical Formulation' ;
    rdfs:comment 'The clinician\'s integrative summary explaining the patient\'s presentation through biopsychosocial factors, linking history, symptoms, and diagnosis into a coherent clinical narrative.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cognitiveFunctionAssessment rdf:type rdf:Property ;
    rdfs:label 'Cognitive Function Assessment' ;
    rdfs:comment 'Summary of cognitive evaluation findings including orientation, attention, memory, language, and executive function observations.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralInformationSource rdf:type rdf:Property ;
    rdfs:label 'Collateral Information Source' ;
    rdfs:comment 'Sources of collateral information consulted during the assessment (e.g., family members, prior records, referring provider, law enforcement).' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityRestriction rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Restriction' ;
    rdfs:comment 'Special confidentiality restrictions applied to this assessment record beyond standard HIPAA protections, such as 42 CFR Part 2 substance use restrictions or court-sealed records.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentMedicationsReviewed rdf:type rdf:Property ;
    rdfs:label 'Current Medications Reviewed' ;
    rdfs:comment 'Indicates whether the patient\'s current medication list was reviewed during this assessment for psychotropic and non-psychotropic medications.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dsm5DiagnosticCategory rdf:type rdf:Property ;
    rdfs:label 'Dsm5 Diagnostic Category' ;
    rdfs:comment 'The broad DSM-5 diagnostic category applicable to the primary diagnosis (e.g., Depressive Disorders, Schizophrenia Spectrum, Anxiety Disorders, Substance-Related Disorders).' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:familyPsychiatricHistory rdf:type rdf:Property ;
    rdfs:label 'Family Psychiatric History' ;
    rdfs:comment 'Summary of relevant psychiatric conditions in the patient\'s family members, contributing to diagnostic formulation and risk assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gafScore rdf:type rdf:Property ;
    rdfs:label 'Gaf Score' ;
    rdfs:comment 'Clinician-rated score (1-100) reflecting the patient\'s overall psychological, social, and occupational functioning at the time of assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:historyOfPresentIllness rdf:type rdf:Property ;
    rdfs:label 'History Of Present Illness' ;
    rdfs:comment 'Narrative description of the current psychiatric symptoms, their onset, duration, severity, and progression leading to this assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homicidalIdeationPresent rdf:type rdf:Property ;
    rdfs:label 'Homicidal Ideation Present' ;
    rdfs:comment 'Indicates whether the patient endorsed any homicidal ideation or intent to harm others during this assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insightLevel rdf:type rdf:Property ;
    rdfs:label 'Insight Level' ;
    rdfs:comment 'Clinician\'s assessment of the patient\'s awareness and understanding of their psychiatric condition and need for treatment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:involuntaryHoldIndicated rdf:type rdf:Property ;
    rdfs:label 'Involuntary Hold Indicated' ;
    rdfs:comment 'Indicates whether the assessment findings meet criteria for involuntary psychiatric hold (e.g., danger to self or others, gravely disabled).' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:judgmentLevel rdf:type rdf:Property ;
    rdfs:label 'Judgment Level' ;
    rdfs:comment 'Clinician\'s assessment of the patient\'s capacity for sound decision-making and ability to manage daily affairs.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalStatus rdf:type rdf:Property ;
    rdfs:label 'Legal Status' ;
    rdfs:comment 'The patient\'s legal status with respect to psychiatric treatment at the time of assessment (voluntary admission, involuntary hold, court-ordered evaluation, or conditional release).' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mentalStatusExam rdf:type rdf:Property ;
    rdfs:label 'Mental Status Exam' ;
    rdfs:comment 'Structured clinical documentation of the mental status examination including appearance, behavior, speech, mood, affect, thought process, thought content, perception, cognition, insight, and judgment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moodDescription rdf:type rdf:Property ;
    rdfs:label 'Mood Description' ;
    rdfs:comment 'The patient\'s self-reported subjective emotional state at the time of assessment (e.g., depressed, anxious, euphoric, irritable).' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:part2ConsentObtained rdf:type rdf:Property ;
    rdfs:label 'Part2 Consent Obtained' ;
    rdfs:comment 'Indicates whether specific consent under 42 CFR Part 2 was obtained for disclosure of substance use disorder information documented in this assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:psychiatricAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Psychiatric Assessment Status' ;
    rdfs:comment 'Current state of the psychiatric assessment in its documentation workflow lifecycle.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:psychiatricHistorySummary rdf:type rdf:Property ;
    rdfs:label 'Psychiatric History Summary' ;
    rdfs:comment 'Summary of the patient\'s prior psychiatric diagnoses, hospitalizations, treatments, and medication trials relevant to the current assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:psychosisSymptomsPresent rdf:type rdf:Property ;
    rdfs:label 'Psychosis Symptoms Present' ;
    rdfs:comment 'Indicates whether the patient exhibited or reported psychotic symptoms (hallucinations, delusions, disorganized thinking) during this assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recommendedLevelOfCare rdf:type rdf:Property ;
    rdfs:label 'Recommended Level Of Care' ;
    rdfs:comment 'The clinically recommended level of behavioral health care based on assessment findings (outpatient, Intensive Outpatient Program, Partial Hospitalization Program, residential, or inpatient).' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyPlanCompleted rdf:type rdf:Property ;
    rdfs:label 'Safety Plan Completed' ;
    rdfs:comment 'Indicates whether a safety plan was developed with the patient during or as a result of this assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signedDatetime rdf:type rdf:Property ;
    rdfs:label 'Signed Datetime' ;
    rdfs:comment 'The date and time when the assessing clinician electronically signed and finalized this psychiatric assessment documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:substanceUseHistory rdf:type rdf:Property ;
    rdfs:label 'Substance Use History' ;
    rdfs:comment 'Documentation of the patient\'s history of alcohol, tobacco, and illicit substance use including patterns, duration, and prior treatment episodes.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suicidalIdeationPresent rdf:type rdf:Property ;
    rdfs:label 'Suicidal Ideation Present' ;
    rdfs:comment 'Indicates whether the patient endorsed any suicidal ideation during this assessment. Critical for safety planning and risk stratification.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suicideRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Suicide Risk Level' ;
    rdfs:comment 'Clinician-determined level of suicide risk based on structured assessment of ideation, plan, intent, means, and protective factors.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:traumaHistoryScreened rdf:type rdf:Property ;
    rdfs:label 'Trauma History Screened' ;
    rdfs:comment 'Indicates whether a trauma history screening was conducted as part of this psychiatric assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:treatmentRecommendation rdf:type rdf:Property ;
    rdfs:label 'Treatment Recommendation' ;
    rdfs:comment 'Clinician\'s recommended treatment plan resulting from this assessment, including therapy modality, medication considerations, and level of care.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violenceRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Violence Risk Level' ;
    rdfs:comment 'Clinician-determined level of risk for violence toward others based on structured risk assessment.' ;
    rdfs:domain ind:PsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:abstinenceDaysAtDischarge rdf:type rdf:Property ;
    rdfs:label 'Abstinence Days At Discharge' ;
    rdfs:comment 'Number of consecutive days of abstinence from the primary substance at the time of discharge.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualLengthOfStayDays rdf:type rdf:Property ;
    rdfs:label 'Actual Length Of Stay Days' ;
    rdfs:comment 'Actual number of days from admission to discharge. Null if episode is still active.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageAtFirstUse rdf:type rdf:Property ;
    rdfs:label 'Age At First Use' ;
    rdfs:comment 'Patient-reported age in years when they first used the primary substance. Used for chronicity assessment.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:asamLevelOfCare rdf:type rdf:Property ;
    rdfs:label 'Asam Level Of Care' ;
    rdfs:comment 'ASAM criteria level of care placement recommendation or actual placement (0.5=Early Intervention through 4.0=Medically Managed Intensive Inpatient). [ENUM-REF-CANDIDATE: 0.5|1.0|2.1|2.5|3.1|3.3|3.5|3.7|4.0 — promote to reference product]' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cfr42ConsentDate rdf:type rdf:Property ;
    rdfs:label 'Cfr42 Consent Date' ;
    rdfs:comment 'Date the patient provided or revoked consent under 42 CFR Part 2 for disclosure of SUD treatment records.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cfr42ConsentStatus rdf:type rdf:Property ;
    rdfs:label 'Cfr42 Consent Status' ;
    rdfs:comment 'Status of patient consent under 42 CFR Part 2 regulations governing confidentiality of substance use disorder patient records.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coOccurringDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Co Occurring Diagnosis Code' ;
    rdfs:comment 'ICD-10-CM diagnosis code for the co-occurring mental health condition, if present.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coOccurringMentalHealthIndicator rdf:type rdf:Property ;
    rdfs:label 'Co Occurring Mental Health Indicator' ;
    rdfs:comment 'Indicates whether the patient has a co-occurring mental health diagnosis alongside the substance use disorder (dual diagnosis).' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confidentialityFlag rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Flag' ;
    rdfs:comment 'Flag indicating this record is subject to heightened confidentiality protections under 42 CFR Part 2 and must not be disclosed without specific patient consent.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crisisEpisodeIndicator rdf:type rdf:Property ;
    rdfs:label 'Crisis Episode Indicator' ;
    rdfs:comment 'Indicates whether this episode was initiated due to a behavioral health crisis (e.g., overdose, acute intoxication, suicidal ideation with substance use).' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dsm5DiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Dsm5 Diagnosis Code' ;
    rdfs:comment 'ICD-10-CM code corresponding to the DSM-5 substance use disorder diagnosis (F10-F19 range).' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedLengthOfStayDays rdf:type rdf:Property ;
    rdfs:label 'Expected Length Of Stay Days' ;
    rdfs:comment 'Projected duration of the treatment episode in days based on ASAM level of care and clinical assessment.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyOfUse rdf:type rdf:Property ;
    rdfs:label 'Frequency Of Use' ;
    rdfs:comment 'Self-reported frequency of primary substance use at the time of admission to treatment.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ivDrugUseIndicator rdf:type rdf:Property ;
    rdfs:label 'Iv Drug Use Indicator' ;
    rdfs:comment 'Indicates whether the patient has a history of intravenous drug use, relevant for infectious disease screening and harm reduction planning.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matIndicator rdf:type rdf:Property ;
    rdfs:label 'Mat Indicator' ;
    rdfs:comment 'Indicates whether the patient is receiving medication-assisted treatment (e.g., buprenorphine, methadone, naltrexone) as part of this episode.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:narcanAdministeredIndicator rdf:type rdf:Property ;
    rdfs:label 'Narcan Administered Indicator' ;
    rdfs:comment 'Indicates whether naloxone was administered to reverse an opioid overdose in connection with this episode.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:otpEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Otp Enrollment Indicator' ;
    rdfs:comment 'Indicates whether the patient is enrolled in a federally certified Opioid Treatment Program for methadone or buprenorphine dispensing.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcomeAtDischarge rdf:type rdf:Property ;
    rdfs:label 'Outcome At Discharge' ;
    rdfs:comment 'Clinician-assessed outcome of the patient at the time of discharge from the SUD treatment episode.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overdoseHistoryIndicator rdf:type rdf:Property ;
    rdfs:label 'Overdose History Indicator' ;
    rdfs:comment 'Indicates whether the patient has a documented history of substance overdose prior to or during this episode.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pregnancyIndicator rdf:type rdf:Property ;
    rdfs:label 'Pregnancy Indicator' ;
    rdfs:comment 'Indicates whether the patient was pregnant at the time of admission. Critical for treatment planning and medication safety.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryPayerType rdf:type rdf:Property ;
    rdfs:label 'Primary Payer Type' ;
    rdfs:comment 'Primary source of payment for the SUD treatment episode.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryRouteOfAdministration rdf:type rdf:Property ;
    rdfs:label 'Primary Route Of Administration' ;
    rdfs:comment 'The primary method by which the patient administers the primary substance of use.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorTreatmentEpisodesCount rdf:type rdf:Property ;
    rdfs:label 'Prior Treatment Episodes Count' ;
    rdfs:comment 'Number of prior substance use disorder treatment episodes the patient has had, used for relapse risk assessment and treatment planning.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referralSourceType rdf:type rdf:Property ;
    rdfs:label 'Referral Source Type' ;
    rdfs:comment 'Category of the entity that referred the patient to SUD treatment (e.g., self-referral, court/criminal justice, healthcare provider, employer).' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondarySubstance rdf:type rdf:Property ;
    rdfs:label 'Secondary Substance' ;
    rdfs:comment 'Secondary substance the patient reports using, if applicable. Coded per SAMHSA substance categories.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tertiarySubstance rdf:type rdf:Property ;
    rdfs:label 'Tertiary Substance' ;
    rdfs:comment 'Third substance the patient reports using, if applicable. Coded per SAMHSA substance categories.' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentModality rdf:type rdf:Property ;
    rdfs:label 'Treatment Modality' ;
    rdfs:comment 'Primary therapeutic modality employed during the episode. MAT refers to Medication-Assisted Treatment. [ENUM-REF-CANDIDATE: individual_therapy|group_therapy|family_therapy|mat|detoxification|peer_support|cbt|dbt|contingency_management|12_step — promote to reference product]' ;
    rdfs:domain ind:SudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentPlanGoal rdf:type rdf:Property ;
    rdfs:label 'Treatment Plan Goal' ;
    rdfs:comment 'Primary treatment goal established in the individualized treatment plan (e.g., abstinence, harm reduction, stabilization).' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentSetting rdf:type rdf:Property ;
    rdfs:label 'Treatment Setting' ;
    rdfs:comment 'The physical or programmatic setting in which SUD treatment is delivered. OTP refers to Opioid Treatment Program.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matClinicianId rdf:type rdf:Property ;
    rdfs:label 'Mat Clinician Id' ;
    rdfs:comment 'Identifier of the provider authorized to prescribe MAT medications (must hold DATA 2000 waiver or DEA X-license for buprenorphine).' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:matSupervisingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Mat Supervising Provider Clinician Id' ;
    rdfs:comment 'Identifier of the medical director or supervising physician overseeing the MAT program at the OTP.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:adverseReactionFlag rdf:type rdf:Property ;
    rdfs:label 'Adverse Reaction Flag' ;
    rdfs:comment 'Indicates whether the patient experienced a clinically significant adverse reaction to the MAT medication during this treatment episode.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consecutiveNegativeScreens rdf:type rdf:Property ;
    rdfs:label 'Consecutive Negative Screens' ;
    rdfs:comment 'Count of consecutive negative urine drug screens, used to determine eligibility for take-home privilege advancement.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consent42cfrPart2Obtained rdf:type rdf:Property ;
    rdfs:label 'Consent 42cfr Part2 Obtained' ;
    rdfs:comment 'Indicates whether the patient has provided written consent for disclosure of substance use disorder treatment records per federal confidentiality regulations.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:counselingFrequency rdf:type rdf:Property ;
    rdfs:label 'Counseling Frequency' ;
    rdfs:comment 'Required frequency of behavioral health counseling sessions as part of the comprehensive MAT treatment plan.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deaWaiverNumber rdf:type rdf:Property ;
    rdfs:label 'Dea Waiver Number' ;
    rdfs:comment 'DEA X-waiver number of the prescribing provider authorizing buprenorphine prescribing under DATA 2000 Act.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dosingFrequency rdf:type rdf:Property ;
    rdfs:label 'Dosing Frequency' ;
    rdfs:comment 'Frequency at which the MAT medication is administered or taken by the patient.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inductionDate rdf:type rdf:Property ;
    rdfs:label 'Induction Date' ;
    rdfs:comment 'Date on which the initial induction dose of MAT medication was administered under clinical observation.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastDoseDate rdf:type rdf:Property ;
    rdfs:label 'Last Dose Date' ;
    rdfs:comment 'Date of the most recent dose administration, critical for tracking adherence and missed doses.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUdsDate rdf:type rdf:Property ;
    rdfs:label 'Last Uds Date' ;
    rdfs:comment 'Date of the most recent urine drug screen performed for treatment compliance monitoring.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUdsResult rdf:type rdf:Property ;
    rdfs:label 'Last Uds Result' ;
    rdfs:comment 'Result of the most recent urine drug screen for the patient in this MAT episode.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matTreatmentStatus rdf:type rdf:Property ;
    rdfs:label 'Mat Treatment Status' ;
    rdfs:comment 'Current lifecycle status of the medication assisted treatment episode.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationNdcCode rdf:type rdf:Property ;
    rdfs:label 'Medication Ndc Code' ;
    rdfs:comment 'National Drug Code identifying the specific MAT medication product, strength, and package.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledVisitDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Visit Date' ;
    rdfs:comment 'Date of the next scheduled MAT clinic visit for dosing, counseling, or drug screening.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:observedDosingRequired rdf:type rdf:Property ;
    rdfs:label 'Observed Dosing Required' ;
    rdfs:comment 'Indicates whether the patient is required to take medication under direct clinical observation (typical during induction and early stabilization).' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peakDosageAmount rdf:type rdf:Property ;
    rdfs:label 'Peak Dosage Amount' ;
    rdfs:comment 'Highest dosage amount reached during the treatment episode, used for clinical review and taper planning.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pregnancyFlag rdf:type rdf:Property ;
    rdfs:label 'Pregnancy Flag' ;
    rdfs:comment 'Indicates whether the patient is pregnant during MAT, which affects medication selection (methadone or buprenorphine monoproduct preferred).' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorTreatmentEpisodes rdf:type rdf:Property ;
    rdfs:label 'Prior Treatment Episodes' ;
    rdfs:comment 'Number of prior MAT or SUD treatment episodes the patient has had, indicating treatment history complexity.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:takeHomeDosesPerWeek rdf:type rdf:Property ;
    rdfs:label 'Take Home Doses Per Week' ;
    rdfs:comment 'Number of take-home doses authorized per week for the patient based on their privilege level and treatment compliance.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:takeHomePrivilegeLevel rdf:type rdf:Property ;
    rdfs:label 'Take Home Privilege Level' ;
    rdfs:comment 'OTP take-home medication privilege level (0-6) indicating the number of unsupervised doses permitted based on time in treatment and compliance.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taperStartDate rdf:type rdf:Property ;
    rdfs:label 'Taper Start Date' ;
    rdfs:comment 'Date on which medication taper was initiated for planned dose reduction toward discontinuation.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:treatmentPhase rdf:type rdf:Property ;
    rdfs:label 'Treatment Phase' ;
    rdfs:comment 'Current phase of the medication assisted treatment protocol indicating progression through the treatment continuum.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urineDrugScreenFrequency rdf:type rdf:Property ;
    rdfs:label 'Urine Drug Screen Frequency' ;
    rdfs:comment 'Required frequency of urine drug screening to monitor treatment compliance and detect illicit substance use.' ;
    rdfs:domain ind:MatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otpClinicianId rdf:type rdf:Property ;
    rdfs:label 'Otp Clinician Id' ;
    rdfs:comment 'Identifier of the primary prescribing physician or medical director overseeing the patient\'s OTP treatment.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:otpCounselorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Otp Counselor Clinician Id' ;
    rdfs:comment 'Identifier of the substance use disorder counselor assigned to the patient for ongoing behavioral health support.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:consent42cfrPart2Indicator rdf:type rdf:Property ;
    rdfs:label 'Consent 42cfr Part2 Indicator' ;
    rdfs:comment 'Indicates whether the patient has provided written consent for disclosure of substance use disorder treatment records per 42 CFR Part 2 federal confidentiality regulations.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:courtOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Court Order Number' ;
    rdfs:comment 'Reference number of the court order mandating the patient\'s participation in the opioid treatment program, when applicable.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentDoseMg rdf:type rdf:Property ;
    rdfs:label 'Current Dose Mg' ;
    rdfs:comment 'Current daily dose of the MAT medication in milligrams as of the most recent dose adjustment.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initialDoseMg rdf:type rdf:Property ;
    rdfs:label 'Initial Dose Mg' ;
    rdfs:comment 'Initial daily dose of the MAT medication in milligrams prescribed at the start of treatment.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intakeAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Intake Assessment Date' ;
    rdfs:comment 'Date the initial comprehensive substance use disorder assessment was completed as part of the OTP intake process.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastCounselingDate rdf:type rdf:Property ;
    rdfs:label 'Last Counseling Date' ;
    rdfs:comment 'Date of the patient\'s most recent counseling session within the OTP.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastDrugScreenDate rdf:type rdf:Property ;
    rdfs:label 'Last Drug Screen Date' ;
    rdfs:comment 'Date of the most recent urine drug screen or toxicology test performed as part of treatment monitoring.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastDrugScreenResult rdf:type rdf:Property ;
    rdfs:label 'Last Drug Screen Result' ;
    rdfs:comment 'Result of the most recent urine drug screen indicating presence or absence of illicit substances.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationType rdf:type rdf:Property ;
    rdfs:label 'Medication Type' ;
    rdfs:comment 'Type of medication prescribed for the patient\'s medication-assisted treatment within the OTP.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phaseLevel rdf:type rdf:Property ;
    rdfs:label 'Phase Level' ;
    rdfs:comment 'Current treatment phase indicating the patient\'s progression through the OTP program stages from induction to maintenance.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samhsaCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Samhsa Certification Number' ;
    rdfs:comment 'SAMHSA certification number of the opioid treatment program under which this enrollment is administered.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:takeHomeApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Take Home Approved Date' ;
    rdfs:comment 'Date the current take-home medication privilege level was approved by the program physician.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:yearsOfOpioidUse rdf:type rdf:Property ;
    rdfs:label 'Years Of Opioid Use' ;
    rdfs:comment 'Self-reported number of years the patient has been using opioids, captured at intake assessment.' ;
    rdfs:domain ind:OtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crisisClinicianId rdf:type rdf:Property ;
    rdfs:label 'Crisis Clinician Id' ;
    rdfs:comment 'The provider or clinician assigned for post-crisis follow-up care.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Clinician Id' ;
    rdfs:comment 'The primary behavioral health clinician or crisis counselor responsible for managing this crisis episode.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:cfrPart2ConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Cfr Part2 Consent Flag' ;
    rdfs:comment 'Indicates whether the patient has provided consent for disclosure of substance use disorder information under 42 CFR Part 2 regulations.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactMethod rdf:type rdf:Property ;
    rdfs:label 'Contact Method' ;
    rdfs:comment 'The method by which the crisis service was initially contacted or the patient presented for crisis care.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargePlanDescription rdf:type rdf:Property ;
    rdfs:label 'Discharge Plan Description' ;
    rdfs:comment 'Summary of the safety plan and discharge instructions provided to the patient upon crisis resolution.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpWithin24hFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Within 24h Flag' ;
    rdfs:comment 'Indicates whether a follow-up contact was made within 24 hours of crisis resolution, per best practice guidelines.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holdType rdf:type rdf:Property ;
    rdfs:label 'Hold Type' ;
    rdfs:comment 'The specific type of involuntary hold or commitment statute applied, varying by state jurisdiction.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionSummary rdf:type rdf:Property ;
    rdfs:label 'Intervention Summary' ;
    rdfs:comment 'Summary of clinical interventions performed during the crisis episode including de-escalation techniques, medications, and therapeutic approaches.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:involuntaryHoldFlag rdf:type rdf:Property ;
    rdfs:label 'Involuntary Hold Flag' ;
    rdfs:comment 'Indicates whether an involuntary psychiatric hold (e.g., 5150, Baker Act) was initiated during this crisis episode.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRepeatCrisis rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Crisis' ;
    rdfs:comment 'Indicates whether this crisis episode is a recurrence within a defined lookback period for the same patient.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawEnforcementInvolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Involved Flag' ;
    rdfs:comment 'Indicates whether law enforcement was involved in the crisis response or transport.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicationAdministeredFlag rdf:type rdf:Property ;
    rdfs:label 'Medication Administered Flag' ;
    rdfs:comment 'Indicates whether emergency or PRN medication was administered during the crisis episode.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onsetDatetime rdf:type rdf:Property ;
    rdfs:label 'Onset Datetime' ;
    rdfs:comment 'The date and time when the crisis episode began or was first reported, representing the principal business event timestamp.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:outcomeRating rdf:type rdf:Property ;
    rdfs:label 'Outcome Rating' ;
    rdfs:comment 'Clinical assessment of the outcome effectiveness at the conclusion of the crisis episode.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:presentingComplaint rdf:type rdf:Property ;
    rdfs:label 'Presenting Complaint' ;
    rdfs:comment 'Chief complaint or presenting problem as described by the patient, family, or first responder at the time of crisis contact.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCrisisCount12m rdf:type rdf:Property ;
    rdfs:label 'Prior Crisis Count 12m' ;
    rdfs:comment 'Number of prior crisis episodes for this patient in the preceding 12-month period, used for recidivism tracking and care planning.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingPeriodDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Date' ;
    rdfs:comment 'The reporting period date used for state and federal behavioral health crisis reporting submissions.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionDatetime rdf:type rdf:Property ;
    rdfs:label 'Resolution Datetime' ;
    rdfs:comment 'The date and time when the crisis episode was clinically resolved or the patient was stabilized.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Time Minutes' ;
    rdfs:comment 'Time in minutes from initial crisis contact to first clinical intervention or team arrival.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:restraintUsedFlag rdf:type rdf:Property ;
    rdfs:label 'Restraint Used Flag' ;
    rdfs:comment 'Indicates whether physical or chemical restraints were used during the crisis episode. Subject to CMS Conditions of Participation reporting.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyPlanCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Plan Completed Flag' ;
    rdfs:comment 'Indicates whether a formal safety plan was completed with the patient during or after the crisis episode.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seclusionUsedFlag rdf:type rdf:Property ;
    rdfs:label 'Seclusion Used Flag' ;
    rdfs:comment 'Indicates whether seclusion was used during the crisis episode. Subject to CMS Conditions of Participation reporting.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondaryDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Secondary Diagnosis Code' ;
    rdfs:comment 'ICD-10-CM diagnosis code for a secondary or co-occurring condition relevant to the crisis episode.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substanceInvolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Substance Involved Flag' ;
    rdfs:comment 'Indicates whether substance use or intoxication was a contributing factor in the crisis episode. Subject to 42 CFR Part 2 protections.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substanceType rdf:type rdf:Property ;
    rdfs:label 'Substance Type' ;
    rdfs:comment 'Primary substance involved in the crisis if substance use is a contributing factor. Subject to 42 CFR Part 2 protections. [ENUM-REF-CANDIDATE: alcohol|opioid|stimulant|benzodiazepine|cannabis|polysubstance|hallucinogen|inhalant — promote to reference product]' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suicideRiskScore rdf:type rdf:Property ;
    rdfs:label 'Suicide Risk Score' ;
    rdfs:comment 'Standardized suicide risk assessment score (e.g., C-SSRS score) assigned during the crisis evaluation.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:triggerDescription rdf:type rdf:Property ;
    rdfs:label 'Trigger Description' ;
    rdfs:comment 'Narrative description of the precipitating event or stressor that triggered the crisis episode.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violenceRiskScore rdf:type rdf:Property ;
    rdfs:label 'Violence Risk Score' ;
    rdfs:comment 'Standardized violence or aggression risk score assigned during crisis evaluation.' ;
    rdfs:domain ind:CrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:courtOrderReference rdf:type rdf:Property ;
    rdfs:label 'Court Order Reference' ;
    rdfs:comment 'Reference number or citation of the court order authorizing disclosure, if applicable.' ;
    rdfs:domain ind:Cfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureScope rdf:type rdf:Property ;
    rdfs:label 'Disclosure Scope' ;
    rdfs:comment 'Defines the extent of SUD records authorized for disclosure—whether all records, specific treatment episodes, a date range, or specific categories of information.' ;
    rdfs:domain ind:Cfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStorageLocation rdf:type rdf:Property ;
    rdfs:label 'Document Storage Location' ;
    rdfs:comment 'Reference path or URI to the scanned or electronic copy of the signed consent form in the document management system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationCondition rdf:type rdf:Property ;
    rdfs:label 'Expiration Condition' ;
    rdfs:comment 'Description of the event or condition upon which the consent expires if not a fixed date (e.g., completion of treatment episode).' ;
    rdfs:domain ind:Cfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informationDisclosed rdf:type rdf:Property ;
    rdfs:label 'Information Disclosed' ;
    rdfs:comment 'Description of the specific kind and amount of SUD information authorized for disclosure (e.g., diagnosis, treatment dates, medications, lab results).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCourtOrdered rdf:type rdf:Property ;
    rdfs:label 'Is Court Ordered' ;
    rdfs:comment 'Indicates whether this disclosure is authorized by court order rather than patient consent, subject to 42 CFR Part 2 Subpart E requirements.' ;
    rdfs:domain ind:Cfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMinorConsent rdf:type rdf:Property ;
    rdfs:label 'Is Minor Consent' ;
    rdfs:comment 'Indicates whether this consent involves a minor patient, which may require additional guardian authorization per state law.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matProgramIndicator rdf:type rdf:Property ;
    rdfs:label 'Mat Program Indicator' ;
    rdfs:comment 'Indicates whether this consent specifically covers Medication-Assisted Treatment (MAT) or Opioid Treatment Program (OTP) records.' ;
    rdfs:domain ind:Cfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:purposeOfDisclosure rdf:type rdf:Property ;
    rdfs:label 'Purpose Of Disclosure' ;
    rdfs:comment 'Statement of the purpose for which the patient is consenting to disclosure of SUD treatment information, as required by 42 CFR Part 2.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redisclosureProhibitionAcknowledged rdf:type rdf:Property ;
    rdfs:label 'Redisclosure Prohibition Acknowledged' ;
    rdfs:comment 'Indicates whether the required prohibition on redisclosure statement was included and acknowledged per 42 CFR Part 2 requirements.' ;
    rdfs:domain ind:Cfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substanceCategory rdf:type rdf:Property ;
    rdfs:label 'Substance Category' ;
    rdfs:comment 'Category of substance use disorder to which this consent applies, used to scope the disclosure appropriately.' ;
    rdfs:domain ind:Cfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentEpisodeReference rdf:type rdf:Property ;
    rdfs:label 'Treatment Episode Reference' ;
    rdfs:comment 'Reference to the specific SUD treatment episode(s) covered by this consent, if disclosure scope is limited to specific episodes.' ;
    rdfs:domain ind:Cfr42Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientClinicianId rdf:type rdf:Property ;
    rdfs:label 'Patient Clinician Id' ;
    rdfs:comment 'Reference to the ordering or responsible provider who requested or is accountable for the risk assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:patientReviewedByProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Patient Reviewed By Provider Clinician Id' ;
    rdfs:comment 'Reference to the clinician who reviewed and acknowledged this risk score in the clinical workflow.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:actualOutcomeOccurred rdf:type rdf:Property ;
    rdfs:label 'Actual Outcome Occurred' ;
    rdfs:comment 'Indicates whether the predicted adverse event actually occurred within the prediction horizon, used for model accuracy measurement.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertGenerated rdf:type rdf:Property ;
    rdfs:label 'Alert Generated' ;
    rdfs:comment 'Indicates whether this risk score triggered a clinical alert or notification in the EHR system.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:biasAssessmentFlag rdf:type rdf:Property ;
    rdfs:label 'Bias Assessment Flag' ;
    rdfs:comment 'Indicates whether algorithmic bias assessment was performed for this model version against the patients demographic group.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calculationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Timestamp' ;
    rdfs:comment 'The date and time when this risk score was computed by the AI/ML model.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataCompletenessPct rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Pct' ;
    rdfs:comment 'Percentage of required input data elements that were available at the time of score calculation, indicating data quality.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:explanationText rdf:type rdf:Property ;
    rdfs:label 'Explanation Text' ;
    rdfs:comment 'Human-readable explanation of the risk score factors and reasoning, generated for clinical transparency. May contain PHI references.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaRetentionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Hipaa Retention Expiry Date' ;
    rdfs:comment 'The date after which this record may be purged per HIPAA minimum necessary and organizational retention policies.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:icd10PrimaryCode rdf:type rdf:Property ;
    rdfs:label 'Icd10 Primary Code' ;
    rdfs:comment 'The primary ICD-10 diagnosis code most relevant to this risk assessment, providing clinical context for the score.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inputFeatureCount rdf:type rdf:Property ;
    rdfs:label 'Input Feature Count' ;
    rdfs:comment 'Number of clinical and demographic features used as inputs for this particular score calculation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interventionRecommended rdf:type rdf:Property ;
    rdfs:label 'Intervention Recommended' ;
    rdfs:comment 'Indicates whether the risk score triggered a recommendation for clinical intervention or care management outreach.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modelRegulatoryClass rdf:type rdf:Property ;
    rdfs:label 'Model Regulatory Class' ;
    rdfs:comment 'FDA regulatory classification of the AI/ML model as a Software as Medical Device (SaMD), governing oversight requirements.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeValidated rdf:type rdf:Property ;
    rdfs:label 'Outcome Validated' ;
    rdfs:comment 'Indicates whether the predicted outcome has been retrospectively validated against actual patient outcomes for model performance tracking.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcomeValidationDate rdf:type rdf:Property ;
    rdfs:label 'Outcome Validation Date' ;
    rdfs:comment 'The date when the actual outcome was assessed against the prediction for model performance evaluation.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patientRiskScoreStatus rdf:type rdf:Property ;
    rdfs:label 'Patient Risk Score Status' ;
    rdfs:comment 'Current lifecycle status of this risk score record indicating whether it is the active score or has been replaced.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohort rdf:type rdf:Property ;
    rdfs:label 'Population Cohort' ;
    rdfs:comment 'The reference population or patient cohort against which this score was calibrated (e.g., Medicare 65+, general adult, pediatric).' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predictionHorizonDays rdf:type rdf:Property ;
    rdfs:label 'Prediction Horizon Days' ;
    rdfs:comment 'The number of days into the future that this risk score predicts (e.g., 30-day readmission, 90-day mortality).' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryContributingFactor rdf:type rdf:Property ;
    rdfs:label 'Primary Contributing Factor' ;
    rdfs:comment 'The single most influential clinical factor driving this risk score, derived from model explainability (e.g., SHAP values).' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorScoreValue rdf:type rdf:Property ;
    rdfs:label 'Prior Score Value' ;
    rdfs:comment 'The most recent previous risk score value for the same patient and score type, enabling trend analysis.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreChangeDirection rdf:type rdf:Property ;
    rdfs:label 'Score Change Direction' ;
    rdfs:comment 'Direction of change compared to the prior score, supporting clinical trend monitoring and alerting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scorePercentile rdf:type rdf:Property ;
    rdfs:label 'Score Percentile' ;
    rdfs:comment 'The percentile rank of this score relative to the reference population, indicating where this patient falls in the distribution.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreType rdf:type rdf:Property ;
    rdfs:label 'Score Type' ;
    rdfs:comment 'Classification of the type of clinical risk being assessed. [ENUM-REF-CANDIDATE: readmission|mortality|sepsis|fall|deterioration|chronic_disease|suicide|pressure_injury|venous_thromboembolism — promote to reference product]' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohFactorIncluded rdf:type rdf:Property ;
    rdfs:label 'Sdoh Factor Included' ;
    rdfs:comment 'Indicates whether social determinants of health data was incorporated into the risk score calculation.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondaryContributingFactor rdf:type rdf:Property ;
    rdfs:label 'Secondary Contributing Factor' ;
    rdfs:comment 'The second most influential clinical factor contributing to this risk score, supporting clinical decision-making transparency.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validFromTimestamp rdf:type rdf:Property ;
    rdfs:label 'Valid From Timestamp' ;
    rdfs:comment 'SCD Type 2 timestamp marking when this version of the record became the active version in the data lakehouse.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validToTimestamp rdf:type rdf:Property ;
    rdfs:label 'Valid To Timestamp' ;
    rdfs:comment 'SCD Type 2 timestamp marking when this version of the record was superseded. NULL indicates the current active version.' ;
    rdfs:domain ind:PatientRiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clinicalClinicianId rdf:type rdf:Property ;
    rdfs:label 'Clinical Clinician Id' ;
    rdfs:comment 'The authoring provider of the source clinical document that was processed by NLP.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:clinicalValidatedByProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Clinical Validated By Provider Clinician Id' ;
    rdfs:comment 'The provider who clinically reviewed and validated or rejected this NLP extraction result.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:assertionStatus rdf:type rdf:Property ;
    rdfs:label 'Assertion Status' ;
    rdfs:comment 'The contextual assertion status of the extracted concept indicating whether the condition is affirmed, negated, or uncertain in the clinical narrative.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdiOpportunityFlag rdf:type rdf:Property ;
    rdfs:label 'Cdi Opportunity Flag' ;
    rdfs:comment 'Indicates whether this extraction identifies a potential CDI opportunity for more specific clinical documentation or coding.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:codingSystem rdf:type rdf:Property ;
    rdfs:label 'Coding System' ;
    rdfs:comment 'The clinical terminology or coding system to which the concept_code belongs.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contextWindowSize rdf:type rdf:Property ;
    rdfs:label 'Context Window Size' ;
    rdfs:comment 'The number of tokens or characters in the context window used by the NLP model for this extraction.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:experiencer rdf:type rdf:Property ;
    rdfs:label 'Experiencer' ;
    rdfs:comment 'Identifies who experiences the clinical concept — the patient themselves or a family member (relevant for family history).' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extractedText rdf:type rdf:Property ;
    rdfs:label 'Extracted Text' ;
    rdfs:comment 'The exact text span extracted from the clinical document by the NLP engine, representing the identified clinical concept.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActionable rdf:type rdf:Property ;
    rdfs:label 'Is Actionable' ;
    rdfs:comment 'Indicates whether the NLP extraction represents an actionable clinical finding requiring follow-up or intervention.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isClinicallyRelevant rdf:type rdf:Property ;
    rdfs:label 'Is Clinically Relevant' ;
    rdfs:comment 'Indicates whether the extracted concept has been determined to be clinically relevant for the patient\'s care.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:normalizedConcept rdf:type rdf:Property ;
    rdfs:label 'Normalized Concept' ;
    rdfs:comment 'The standardized clinical concept label after normalization against a controlled terminology (e.g., SNOMED CT preferred term).' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineVersion rdf:type rdf:Property ;
    rdfs:label 'Pipeline Version' ;
    rdfs:comment 'The semantic version of the NLP processing pipeline that generated this result, supporting reproducibility and model governance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationType rdf:type rdf:Property ;
    rdfs:label 'Relation Type' ;
    rdfs:comment 'For relation-type results, the semantic relationship between two entities (e.g., treats, causes, administered_via, located_at).' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionName rdf:type rdf:Property ;
    rdfs:label 'Section Name' ;
    rdfs:comment 'The clinical document section from which the extraction was made (e.g., History of Present Illness, Assessment and Plan, Medications).' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sentenceText rdf:type rdf:Property ;
    rdfs:label 'Sentence Text' ;
    rdfs:comment 'The full sentence from the clinical document containing the extracted concept, providing context for clinical review.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spanEndOffset rdf:type rdf:Property ;
    rdfs:label 'Span End Offset' ;
    rdfs:comment 'The character position in the source document where the extracted text span ends.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:spanStartOffset rdf:type rdf:Property ;
    rdfs:label 'Span Start Offset' ;
    rdfs:comment 'The character position in the source document where the extracted text span begins, enabling precise text highlighting.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suggestedCptCode rdf:type rdf:Property ;
    rdfs:label 'Suggested Cpt Code' ;
    rdfs:comment 'The CPT code suggested by the NLP model for procedure-related extractions, supporting coding workflows.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suggestedIcdCode rdf:type rdf:Property ;
    rdfs:label 'Suggested Icd Code' ;
    rdfs:comment 'The ICD-10-CM code suggested by the NLP model based on the extracted clinical concept, supporting computer-assisted coding.' ;
    rdfs:domain ind:ClinicalNlpResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careGapStatus rdf:type rdf:Property ;
    rdfs:label 'Care Gap Status' ;
    rdfs:comment 'Current lifecycle status of the care gap indicating whether it is open, being addressed, resolved, or excluded from measurement.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careProgramName rdf:type rdf:Property ;
    rdfs:label 'Care Program Name' ;
    rdfs:comment 'Name of the population health or disease management program under which this care gap is tracked (e.g., Diabetes Management, Preventive Wellness).' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysOpen rdf:type rdf:Property ;
    rdfs:label 'Days Open' ;
    rdfs:comment 'Number of days the care gap has remained in open status since detection, used for aging analysis and escalation workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:denominatorEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Denominator Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient is eligible for inclusion in the quality measure denominator based on age, gender, diagnosis, and enrollment criteria.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOverdue rdf:type rdf:Property ;
    rdfs:label 'Is Overdue' ;
    rdfs:comment 'Indicates whether the care gap has exceeded its due date without being closed, triggering escalation protocols.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPatientNotified rdf:type rdf:Property ;
    rdfs:label 'Is Patient Notified' ;
    rdfs:comment 'Indicates whether the patient has been notified about this care gap through any communication channel.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isProviderNotified rdf:type rdf:Property ;
    rdfs:label 'Is Provider Notified' ;
    rdfs:comment 'Indicates whether the attributed provider has been alerted about this care gap for clinical action.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numeratorComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Numerator Compliance Flag' ;
    rdfs:comment 'Indicates whether the patient currently meets the numerator criteria for the associated quality measure, meaning the gap is effectively closed.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outreachChannel rdf:type rdf:Property ;
    rdfs:label 'Outreach Channel' ;
    rdfs:comment 'Communication channel used for the most recent outreach attempt to the patient regarding this care gap.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachCount rdf:type rdf:Property ;
    rdfs:label 'Outreach Count' ;
    rdfs:comment 'Number of outreach attempts made to the patient to address this care gap, including phone calls, letters, portal messages, and text notifications.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualityProgram rdf:type rdf:Property ;
    rdfs:label 'Quality Program' ;
    rdfs:comment 'Quality reporting program under which this care gap is measured, such as HEDIS, MIPS, Medicare Stars, Value-Based Purchasing, or ACO shared savings.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohBarrierFlag rdf:type rdf:Property ;
    rdfs:label 'Sdoh Barrier Flag' ;
    rdfs:comment 'Indicates whether social determinants of health barriers (transportation, food insecurity, housing instability) have been identified as contributing to this care gap.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suppressionEndDate rdf:type rdf:Property ;
    rdfs:label 'Suppression End Date' ;
    rdfs:comment 'Date when the care gap suppression expires and the gap returns to active worklists for follow-up.' ;
    rdfs:domain ind:CareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:alertAcknowledged rdf:type rdf:Property ;
    rdfs:label 'Alert Acknowledged' ;
    rdfs:comment 'Indicates whether a clinician acknowledged the alert or recommendation generated by this inference.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertOverridden rdf:type rdf:Property ;
    rdfs:label 'Alert Overridden' ;
    rdfs:comment 'Indicates whether the clinician overrode or dismissed the model recommendation, critical for measuring alert fatigue and model utility.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:batchRunIdentifier rdf:type rdf:Property ;
    rdfs:label 'Batch Run Identifier' ;
    rdfs:comment 'Identifier for the batch execution run when inference was performed in batch mode, null for real-time inferences.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalActionTaken rdf:type rdf:Property ;
    rdfs:label 'Clinical Action Taken' ;
    rdfs:comment 'The downstream clinical action triggered by this inference result within the clinical workflow.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataDriftFlag rdf:type rdf:Property ;
    rdfs:label 'Data Drift Flag' ;
    rdfs:comment 'Indicates whether input data drift was detected for this inference relative to the model\'s training distribution.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fairnessGroup rdf:type rdf:Property ;
    rdfs:label 'Fairness Group' ;
    rdfs:comment 'The demographic or clinical subgroup used for bias and fairness monitoring of this inference (e.g., age_group, race_ethnicity category). Stored as category label, not individual PHI.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedbackLabel rdf:type rdf:Property ;
    rdfs:label 'Feedback Label' ;
    rdfs:comment 'Post-hoc ground truth label assigned after clinical outcome is known, used for model performance monitoring and retraining.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedbackTimestamp rdf:type rdf:Property ;
    rdfs:label 'Feedback Timestamp' ;
    rdfs:comment 'Date and time when ground truth feedback was recorded for this inference event.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:hipaaMinimumNecessary rdf:type rdf:Property ;
    rdfs:label 'Hipaa Minimum Necessary' ;
    rdfs:comment 'Confirms that only the minimum necessary PHI was accessed for this inference per HIPAA minimum necessary standard.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inferenceType rdf:type rdf:Property ;
    rdfs:label 'Inference Type' ;
    rdfs:comment 'Category of AI/ML inference performed, indicating the nature of the model output.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inputFeatureHash rdf:type rdf:Property ;
    rdfs:label 'Input Feature Hash' ;
    rdfs:comment 'SHA-256 hash of the input feature vector used for this inference, enabling reproducibility verification without storing raw PHI features.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRealTime rdf:type rdf:Property ;
    rdfs:label 'Is Real Time' ;
    rdfs:comment 'Indicates whether this inference was executed in real-time (synchronous) versus batch (asynchronous) mode.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latencyMs rdf:type rdf:Property ;
    rdfs:label 'Latency Ms' ;
    rdfs:comment 'Total elapsed time in milliseconds from inference request to response, critical for monitoring real-time clinical decision support SLAs.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modelFramework rdf:type rdf:Property ;
    rdfs:label 'Model Framework' ;
    rdfs:comment 'The ML framework used to train and serve the model (e.g., MLflow, TensorFlow, PyTorch, scikit-learn, Spark MLlib).' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predictionClassLabel rdf:type rdf:Property ;
    rdfs:label 'Prediction Class Label' ;
    rdfs:comment 'For classification models, the predicted class label (e.g., positive, negative, or specific condition codes).' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predictionOutput rdf:type rdf:Property ;
    rdfs:label 'Prediction Output' ;
    rdfs:comment 'The primary output value or label produced by the model inference. May contain clinical predictions classified as PHI.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestIdentifier rdf:type rdf:Property ;
    rdfs:label 'Request Identifier' ;
    rdfs:comment 'Unique UUID for this inference request enabling end-to-end traceability across distributed systems.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryOutputJson rdf:type rdf:Property ;
    rdfs:label 'Secondary Output Json' ;
    rdfs:comment 'JSON-serialized secondary outputs from the model such as multi-class probabilities, NLP entity extractions, or care gap lists. Stored as string for Delta compatibility.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servingEndpoint rdf:type rdf:Property ;
    rdfs:label 'Serving Endpoint' ;
    rdfs:comment 'The deployment endpoint or service URL that served this inference request, supporting infrastructure traceability.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:topContributingFeatures rdf:type rdf:Property ;
    rdfs:label 'Top Contributing Features' ;
    rdfs:comment 'JSON-serialized list of the top contributing features and their importance weights that drove this prediction, supporting model interpretability.' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:useCase rdf:type rdf:Property ;
    rdfs:label 'Use Case' ;
    rdfs:comment 'The specific clinical or operational use case this inference supports (e.g., sepsis_early_warning, readmission_risk, care_gap_detection, clinical_documentation_improvement, medication_interaction).' ;
    rdfs:domain ind:ModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containsPhiFlag rdf:type rdf:Property ;
    rdfs:label 'Contains Phi Flag' ;
    rdfs:comment 'Indicates whether any feature in this entity contains Protected Health Information subject to HIPAA privacy and security rules.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataClassificationLevel rdf:type rdf:Property ;
    rdfs:label 'Data Classification Level' ;
    rdfs:comment 'Highest data classification level among features in this entity, driving access control policies and HIPAA compliance requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driftDetectionMethod rdf:type rdf:Property ;
    rdfs:label 'Drift Detection Method' ;
    rdfs:comment 'Statistical method used to detect distribution drift in features over time, critical for maintaining clinical AI model reliability.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driftThreshold rdf:type rdf:Property ;
    rdfs:label 'Drift Threshold' ;
    rdfs:comment 'Numeric threshold value above which feature drift triggers an alert for model retraining evaluation (e.g., PSI > 0.2 indicates significant drift).' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:featureCount rdf:type rdf:Property ;
    rdfs:label 'Feature Count' ;
    rdfs:comment 'Total number of features currently registered under this entity, reflecting the breadth of signals available for ML model consumption.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:featureStoreEntityCode rdf:type rdf:Property ;
    rdfs:label 'Feature Store Entity Code' ;
    rdfs:comment 'Unique business code assigned to the feature store entity for programmatic reference across ML training and serving pipelines.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureStoreEntityDescription rdf:type rdf:Property ;
    rdfs:label 'Feature Store Entity Description' ;
    rdfs:comment 'Detailed business description of the feature store entity, explaining its clinical or operational purpose and intended use cases in AI/ML workflows.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureStoreEntityName rdf:type rdf:Property ;
    rdfs:label 'Feature Store Entity Name' ;
    rdfs:comment 'Human-readable name of the feature store entity, used for discovery and reference in ML pipelines and analytics workflows.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureStoreEntityStatus rdf:type rdf:Property ;
    rdfs:label 'Feature Store Entity Status' ;
    rdfs:comment 'Current lifecycle status of the feature store entity indicating whether it is available for use in production ML models and analytics.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastDriftCheckAt rdf:type rdf:Property ;
    rdfs:label 'Last Drift Check At' ;
    rdfs:comment 'Timestamp of the most recent feature drift analysis execution for this entity.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastMaterializedAt rdf:type rdf:Property ;
    rdfs:label 'Last Materialized At' ;
    rdfs:comment 'Timestamp of the most recent successful feature materialization run, used to monitor freshness and trigger alerts on stale data.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:materializationStrategy rdf:type rdf:Property ;
    rdfs:label 'Materialization Strategy' ;
    rdfs:comment 'Method by which features are computed and written to the feature table — batch for scheduled pipelines, streaming for real-time, on_demand for inference-time computation.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onlineStoreEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Online Store Enabled Flag' ;
    rdfs:comment 'Indicates whether this entity is published to an online feature store for low-latency real-time inference serving (e.g., clinical decision support at point of care).' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryKeyColumns rdf:type rdf:Property ;
    rdfs:label 'Primary Key Columns' ;
    rdfs:comment 'Comma-separated list of column names that form the primary key for this entity, used for point lookups during model inference (e.g., patient_id, encounter_id).' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refreshFrequencyMinutes rdf:type rdf:Property ;
    rdfs:label 'Refresh Frequency Minutes' ;
    rdfs:comment 'Expected interval in minutes between feature materialization runs, defining the staleness tolerance for downstream ML models.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rlsPredicateExpression rdf:type rdf:Property ;
    rdfs:label 'Rls Predicate Expression' ;
    rdfs:comment 'SQL predicate expression applied as a row-level security filter in Unity Catalog, restricting feature access based on user attributes (e.g., care team membership).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowCount rdf:type rdf:Property ;
    rdfs:label 'Row Count' ;
    rdfs:comment 'Approximate number of rows in the materialized feature table, indicating entity population size for capacity planning and cost estimation.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:servingEndpointName rdf:type rdf:Property ;
    rdfs:label 'Serving Endpoint Name' ;
    rdfs:comment 'Name of the Databricks model serving endpoint or feature serving endpoint that exposes this entity for real-time lookups.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCatalog rdf:type rdf:Property ;
    rdfs:label 'Source Catalog' ;
    rdfs:comment 'Name of the Databricks Unity Catalog catalog where the underlying feature table is physically stored.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSchema rdf:type rdf:Property ;
    rdfs:label 'Source Schema' ;
    rdfs:comment 'Name of the schema (database) within Unity Catalog containing the feature table for this entity.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stewardEmail rdf:type rdf:Property ;
    rdfs:label 'Steward Email' ;
    rdfs:comment 'Email address of the designated data steward accountable for data quality and governance of this feature entity.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagsJson rdf:type rdf:Property ;
    rdfs:label 'Tags Json' ;
    rdfs:comment 'JSON-encoded key-value pairs representing Unity Catalog governance tags applied to this entity (e.g., domain, sensitivity, regulatory_framework).' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timestampKeyColumn rdf:type rdf:Property ;
    rdfs:label 'Timestamp Key Column' ;
    rdfs:comment 'Name of the timestamp column used for point-in-time lookups, enabling time-travel feature retrieval to prevent data leakage in training datasets.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralManagementId rdf:type rdf:Property ;
    rdfs:label 'Referral Management Id' ;
    rdfs:comment 'Primary key for referral_management' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReferralManagement .

ind:referralMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Referral Mpi Record Id' ;
    rdfs:comment 'Foreign key linking to patient.mpi_record. Business justification: Referral management records belong to a patient. patient_id exists but has no FK defined. Adding mpi_record_id FK for proper patient linkage.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:referralPatientMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Referral Patient Mpi Record Id' ;
    rdfs:comment 'The patient for whom this SDOH referral was created.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:acceptedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Accepted Timestamp' ;
    rdfs:comment 'Date and time the receiving community-based organization acknowledged and accepted the referral.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:firstContactDate rdf:type rdf:Property ;
    rdfs:label 'First Contact Date' ;
    rdfs:comment 'Actual date of first successful contact between the patient and the assigned CHW or CBO representative.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followupAttempts rdf:type rdf:Property ;
    rdfs:label 'Followup Attempts' ;
    rdfs:comment 'Number of follow-up contact attempts made to the patient or CBO to track referral progress.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:icd10ZCode rdf:type rdf:Property ;
    rdfs:label 'Icd10 Z Code' ;
    rdfs:comment 'ICD-10-CM Z-code capturing the social determinant factor (e.g., Z59.0 Homelessness, Z56.0 Unemployment).' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isClosedLoop rdf:type rdf:Property ;
    rdfs:label 'Is Closed Loop' ;
    rdfs:comment 'Indicates whether the referral has achieved closed-loop status with confirmed outcome feedback from the receiving organization.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastFollowupDate rdf:type rdf:Property ;
    rdfs:label 'Last Followup Date' ;
    rdfs:comment 'Most recent date a follow-up contact was attempted or completed for this referral.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patientPreferredLanguage rdf:type rdf:Property ;
    rdfs:label 'Patient Preferred Language' ;
    rdfs:comment 'ISO 639 language code for the patients preferred communication language, critical for CBO service matching.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientSatisfactionRating rdf:type rdf:Property ;
    rdfs:label 'Patient Satisfaction Rating' ;
    rdfs:comment 'Patient-reported satisfaction score (1-5 scale) with the referral experience and services received.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskStratificationLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Level' ;
    rdfs:comment 'Patient risk tier derived from screening results and clinical context, used to prioritize CHW outreach and resource allocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledContactDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Contact Date' ;
    rdfs:comment 'Date the CHW or CBO is scheduled to make initial contact with the patient regarding this referral.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningToolCode rdf:type rdf:Property ;
    rdfs:label 'Screening Tool Code' ;
    rdfs:comment 'Identifier for the validated screening instrument used to identify the need (e.g., PRAPARE, AHC-HRSN, HUNT).' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningToolResponses rdf:type rdf:Property ;
    rdfs:label 'Screening Tool Responses' ;
    rdfs:comment 'Serialized patient responses to the SDOH screening questionnaire items used to generate the referral.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTaxonomyCode rdf:type rdf:Property ;
    rdfs:label 'Service Taxonomy Code' ;
    rdfs:comment 'Standardized service taxonomy code from the AIRS/211 LA classification system identifying the type of community service.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transportationBarrier rdf:type rdf:Property ;
    rdfs:label 'Transportation Barrier' ;
    rdfs:comment 'Indicates whether the patient has identified transportation as a barrier to accessing the referred service.' ;
    rdfs:domain ind:ReferralManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:needClosureTrackingId rdf:type rdf:Property ;
    rdfs:label 'Need Closure Tracking Id' ;
    rdfs:comment 'Primary key for need_closure_tracking' ;
    rdfs:domain ind:NeedClosureTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:needMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Need Mpi Record Id' ;
    rdfs:comment 'Foreign key linking to patient.mpi_record. Business justification: Need closure tracking records belong to a patient. patient_id exists as BIGINT but has no FK defined. Adding proper mpi_record_id FK. Not removing patient_id as it may serve as a legacy identifier.' ;
    rdfs:domain ind:NeedClosureTracking ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:needPatientMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Need Patient Mpi Record Id' ;
    rdfs:comment 'The patient whose SDOH need is being tracked for closure. Links to the master patient record.' ;
    rdfs:domain ind:NeedClosureTracking ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:priorClosureTrackingNeedClosureTrackingId rdf:type rdf:Property ;
    rdfs:label 'Prior Closure Tracking Need Closure Tracking Id' ;
    rdfs:comment 'Reference to a previous need closure tracking record for the same need category if this is a recurrence.' ;
    rdfs:domain ind:NeedClosureTracking ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NeedClosureTracking .

ind:actualClosureDate rdf:type rdf:Property ;
    rdfs:label 'Actual Closure Date' ;
    rdfs:comment 'Date when the SDOH need was confirmed as resolved or formally closed. Null if still open or in progress.' ;
    rdfs:domain ind:NeedClosureTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:barrierToClosure rdf:type rdf:Property ;
    rdfs:label 'Barrier To Closure' ;
    rdfs:comment 'Primary barrier preventing successful closure of the SDOH need (e.g., waitlist, eligibility, transportation, language, documentation).' ;
    rdfs:domain ind:NeedClosureTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Follow Up Frequency Days' ;
    rdfs:comment 'Number of days between scheduled follow-up contacts for this need, based on priority and engagement level.' ;
    rdfs:domain ind:NeedClosureTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:needSubcategory rdf:type rdf:Property ;
    rdfs:label 'Need Subcategory' ;
    rdfs:comment 'Detailed subcategory further classifying the SDOH need within the primary category (e.g., homelessness risk, utility shutoff, food desert access).' ;
    rdfs:domain ind:NeedClosureTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeMeasure rdf:type rdf:Property ;
    rdfs:label 'Outcome Measure' ;
    rdfs:comment 'Assessment of the outcome achieved at closure or reassessment, measuring whether the patient\'s situation improved relative to the identified need.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientEngagementLevel rdf:type rdf:Property ;
    rdfs:label 'Patient Engagement Level' ;
    rdfs:comment 'Assessment of the patient\'s level of engagement and participation in addressing their identified SDOH need.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStratificationTier rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Tier' ;
    rdfs:comment 'Population health risk tier assigned to the patient for this need, used to determine intervention intensity and resource allocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningToolUsed rdf:type rdf:Property ;
    rdfs:label 'Screening Tool Used' ;
    rdfs:comment 'Name of the validated screening instrument used to identify the need (e.g., PRAPARE, AHC-HRSN, SDOH-2, WellRx).' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetClosureDate rdf:type rdf:Property ;
    rdfs:label 'Target Closure Date' ;
    rdfs:comment 'Expected date by which the SDOH need should be resolved based on care plan goals and resource availability.' ;
    rdfs:domain ind:NeedClosureTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chwInterventionsId rdf:type rdf:Property ;
    rdfs:label 'Chw Interventions Id' ;
    rdfs:comment 'Primary key for chw_interventions' ;
    rdfs:domain ind:ChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:chwMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Chw Mpi Record Id' ;
    rdfs:comment 'Foreign key linking to patient.mpi_record. Business justification: CHW interventions are performed for a specific patient. patient_id exists but has no FK. Adding mpi_record_id FK for proper patient linkage.' ;
    rdfs:domain ind:ChwInterventions ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:chwNeedClosureTrackingId rdf:type rdf:Property ;
    rdfs:label 'Chw Need Closure Tracking Id' ;
    rdfs:comment 'Identifier of the specific SDOH need being addressed by this intervention (e.g., food insecurity, housing instability).' ;
    rdfs:domain ind:ChwInterventions ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NeedClosureTracking .

ind:chwNeedNeedClosureTrackingId rdf:type rdf:Property ;
    rdfs:label 'Chw Need Need Closure Tracking Id' ;
    rdfs:comment 'Foreign key linking to patient.need_closure_tracking. Business justification: CHW interventions have need_id (BIGINT) linking to the specific need being addressed. Connecting to need_closure_tracking.' ;
    rdfs:domain ind:ChwInterventions ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NeedClosureTracking .

ind:chwPatientMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Chw Patient Mpi Record Id' ;
    rdfs:comment 'The patient who is the recipient of the community health worker intervention.' ;
    rdfs:domain ind:ChwInterventions ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:attemptCount rdf:type rdf:Property ;
    rdfs:label 'Attempt Count' ;
    rdfs:comment 'Number of contact attempts made to reach the patient for this intervention, used for outreach effectiveness analysis.' ;
    rdfs:domain ind:ChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:barrierIdentified rdf:type rdf:Property ;
    rdfs:label 'Barrier Identified' ;
    rdfs:comment 'Description of barriers encountered during the intervention that prevented or limited successful need closure (e.g., language, transportation, eligibility).' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chwInterventionsStatus rdf:type rdf:Property ;
    rdfs:label 'Chw Interventions Status' ;
    rdfs:comment 'Current lifecycle status of the intervention indicating its progress from planning through completion or closure.' ;
    rdfs:domain ind:ChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryMode rdf:type rdf:Property ;
    rdfs:label 'Delivery Mode' ;
    rdfs:comment 'The modality through which the intervention was delivered to the patient or community member.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalProgressNotes rdf:type rdf:Property ;
    rdfs:label 'Goal Progress Notes' ;
    rdfs:comment 'Documentation of progress toward patient-defined health or social goals as part of the care plan.' ;
    rdfs:domain ind:ChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionCategory rdf:type rdf:Property ;
    rdfs:label 'Intervention Category' ;
    rdfs:comment 'Broad category grouping the intervention by the health domain it addresses, used for population health analytics and program evaluation.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionNumber rdf:type rdf:Property ;
    rdfs:label 'Intervention Number' ;
    rdfs:comment 'Business-facing unique number assigned to this intervention for tracking and communication purposes.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceProvided rdf:type rdf:Property ;
    rdfs:label 'Resource Provided' ;
    rdfs:comment 'Description of the specific community resource, service, or material provided to the patient during the intervention.' ;
    rdfs:domain ind:ChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStratificationId rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Id' ;
    rdfs:comment 'Primary key for risk_stratification' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskAttributedPcpClinicianId rdf:type rdf:Property ;
    rdfs:label 'Risk Attributed Pcp Clinician Id' ;
    rdfs:comment 'Identifier of the primary care physician attributed to the patient for population health management and care coordination.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:riskClinicianId rdf:type rdf:Property ;
    rdfs:label 'Risk Clinician Id' ;
    rdfs:comment 'Identifier of the provider or community health worker who performed the risk assessment.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:riskMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Risk Mpi Record Id' ;
    rdfs:comment 'Foreign key linking to patient.mpi_record. Business justification: Risk stratification records belong to a patient. patient_id exists but has no FK. Adding mpi_record_id FK.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:riskPatientMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Risk Patient Mpi Record Id' ;
    rdfs:comment 'Identifier of the patient being assessed for social determinants of health risk.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:assessmentToolCode rdf:type rdf:Property ;
    rdfs:label 'Assessment Tool Code' ;
    rdfs:comment 'Code identifying the standardized screening tool used for SDOH risk assessment (e.g., PRAPARE, AHC-HRSN, WE-CARE, IHELP, or custom instrument).' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusTractCode rdf:type rdf:Property ;
    rdfs:label 'Census Tract Code' ;
    rdfs:comment '11-digit FIPS census tract code for the patient\'s residence, used for geographic SDOH analysis and community resource mapping.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeRiskScore rdf:type rdf:Property ;
    rdfs:label 'Composite Risk Score' ;
    rdfs:comment 'Numeric composite score representing the aggregate SDOH risk level, typically on a 0-100 scale where higher values indicate greater social risk burden.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consentToShare rdf:type rdf:Property ;
    rdfs:label 'Consent To Share' ;
    rdfs:comment 'Indicates whether the patient consented to share their SDOH information with community-based organizations for referral purposes.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:edUtilizationRisk rdf:type rdf:Property ;
    rdfs:label 'Ed Utilization Risk' ;
    rdfs:comment 'Predicted risk level for avoidable emergency department utilization based on SDOH factors, supporting care management outreach prioritization.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:educationBarrierFlag rdf:type rdf:Property ;
    rdfs:label 'Education Barrier Flag' ;
    rdfs:comment 'Indicates whether the patient reports educational attainment barriers or health literacy challenges affecting care engagement.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employmentStatusConcern rdf:type rdf:Property ;
    rdfs:label 'Employment Status Concern' ;
    rdfs:comment 'Patient\'s employment status as it relates to SDOH risk, capturing unemployment or underemployment as social risk factors.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRiskIndex rdf:type rdf:Property ;
    rdfs:label 'Geographic Risk Index' ;
    rdfs:comment 'Area-level deprivation or risk index score based on patient\'s census tract or ZIP code, incorporating Area Deprivation Index or Social Vulnerability Index data.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interpersonalSafetyFlag rdf:type rdf:Property ;
    rdfs:label 'Interpersonal Safety Flag' ;
    rdfs:comment 'Indicates whether the patient screens positive for interpersonal violence or safety concerns in the home environment.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageBarrierNoted rdf:type rdf:Property ;
    rdfs:label 'Language Barrier Noted' ;
    rdfs:comment 'Indicates whether a language barrier was identified during the screening that may affect assessment accuracy or care navigation.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryIcd10ZCode rdf:type rdf:Property ;
    rdfs:label 'Primary Icd10 Z Code' ;
    rdfs:comment 'Primary ICD-10-CM Z-code representing the dominant social determinant identified during screening, used for clinical documentation and billing.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorRiskScore rdf:type rdf:Property ;
    rdfs:label 'Prior Risk Score' ;
    rdfs:comment 'Composite risk score from the most recent previous assessment, enabling trend analysis and intervention effectiveness measurement.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programEnrollmentCode rdf:type rdf:Property ;
    rdfs:label 'Program Enrollment Code' ;
    rdfs:comment 'Code identifying the population health or value-based care program under which this risk stratification was performed (e.g., ACO, PCMH, Medicaid waiver).' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionRisk rdf:type rdf:Property ;
    rdfs:label 'Readmission Risk' ;
    rdfs:comment 'Predicted risk level for 30-day hospital readmission attributable to unmet social needs, used for discharge planning and transitions of care.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Referral Organization Name' ;
    rdfs:comment 'Name of the community-based organization or social service agency to which the patient was referred for SDOH need resolution.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStratificationStatus rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Status' ;
    rdfs:comment 'Lifecycle status of the risk stratification record indicating whether it is finalized, amended, or voided.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningCompletionPct rdf:type rdf:Property ;
    rdfs:label 'Screening Completion Pct' ;
    rdfs:comment 'Percentage of screening questions answered by the patient, indicating completeness of the assessment data used for scoring.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:secondaryIcd10ZCode rdf:type rdf:Property ;
    rdfs:label 'Secondary Icd10 Z Code' ;
    rdfs:comment 'Secondary ICD-10-CM Z-code for an additional social determinant identified, supporting comprehensive SDOH documentation.' ;
    rdfs:domain ind:RiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalDocumentationGuidance rdf:type rdf:Property ;
    rdfs:label 'Clinical Documentation Guidance' ;
    rdfs:comment 'Guidance text for clinical documentation improvement specialists and coders on when and how to assign this Z-code based on patient encounter documentation.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsFiscalYear rdf:type rdf:Property ;
    rdfs:label 'Cms Fiscal Year' ;
    rdfs:comment 'The CMS fiscal year in which this Z-code was introduced or last updated in the ICD-10-CM code set. Used for version tracking and annual code set reconciliation.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:codeDescription rdf:type rdf:Property ;
    rdfs:label 'Code Description' ;
    rdfs:comment 'The official ICD-10-CM long description of the Z-code as published by CMS, used for clinical documentation and coding reference.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Code Range End' ;
    rdfs:comment 'The ending code in the ICD-10-CM Z-code range that this mapping covers. Used in conjunction with code_range_start to define inclusive code groupings.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeRangeStart rdf:type rdf:Property ;
    rdfs:label 'Code Range Start' ;
    rdfs:comment 'The starting code in the ICD-10-CM Z-code range that this mapping covers. Enables grouping of related codes under a single SDOH category for bulk classification.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeVersion rdf:type rdf:Property ;
    rdfs:label 'Code Version' ;
    rdfs:comment 'The specific ICD-10-CM code set version (e.g., FY2024, FY2025) in which this mapping was validated. Ensures traceability to the authoritative code set release.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityMeasureFlag rdf:type rdf:Property ;
    rdfs:label 'Equity Measure Flag' ;
    rdfs:comment 'Indicates whether this Z-code is referenced in CMS health equity quality measures or stratification requirements for disparities reporting.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fhirConditionCategory rdf:type rdf:Property ;
    rdfs:label 'Fhir Condition Category' ;
    rdfs:comment 'The FHIR Condition resource category value used when representing this SDOH finding in FHIR-based health information exchanges and interoperability transactions.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirValueSetUri rdf:type rdf:Property ;
    rdfs:label 'Fhir Value Set Uri' ;
    rdfs:comment 'The canonical URI of the FHIR ValueSet that includes this Z-code, enabling automated terminology validation in FHIR-based clinical decision support and data exchange.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gravityCode rdf:type rdf:Property ;
    rdfs:label 'Gravity Code' ;
    rdfs:comment 'The corresponding code from the HL7 Gravity Project SDOH Clinical Care standard, enabling interoperability between SDOH screening tools, EHR systems, and community-based organizations via FHIR resources.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10Block rdf:type rdf:Property ;
    rdfs:label 'Icd10 Block' ;
    rdfs:comment 'The ICD-10-CM block grouping (e.g., Z55-Z65 for persons with potential health hazards related to socioeconomic and psychosocial circumstances) for hierarchical classification.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10Chapter rdf:type rdf:Property ;
    rdfs:label 'Icd10 Chapter' ;
    rdfs:comment 'The ICD-10-CM chapter designation (Chapter 21: Factors influencing health status and contact with health services) for hierarchical code navigation and reporting grouping.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryDiagnosisEligible rdf:type rdf:Property ;
    rdfs:label 'Is Primary Diagnosis Eligible' ;
    rdfs:comment 'Indicates whether this Z-code can be reported as the principal or first-listed diagnosis on a claim. Some Z-codes are only valid as secondary diagnoses per ICD-10-CM coding guidelines.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loincPanelCode rdf:type rdf:Property ;
    rdfs:label 'Loinc Panel Code' ;
    rdfs:comment 'The LOINC code for the SDOH screening panel or assessment instrument (e.g., AHC-HRSN, PRAPARE, HUNT) that typically generates this Z-code finding.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mappingConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Mapping Confidence Level' ;
    rdfs:comment 'The confidence level of the semantic mapping between the Z-code and the SDOH category, following HL7 concept map equivalence conventions (exact, broad, narrow, partial).' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerAcceptanceNotes rdf:type rdf:Property ;
    rdfs:label 'Payer Acceptance Notes' ;
    rdfs:comment 'Notes regarding payer-specific acceptance or rejection patterns for this Z-code, including known commercial payer limitations or Medicare/Medicaid coverage policies.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationPrevalenceTier rdf:type rdf:Property ;
    rdfs:label 'Population Prevalence Tier' ;
    rdfs:comment 'Relative prevalence tier of this SDOH factor in the general patient population, used for population health analytics, resource planning, and community health needs assessments.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralResourceType rdf:type rdf:Property ;
    rdfs:label 'Referral Resource Type' ;
    rdfs:comment 'The type of community-based organization or resource typically associated with addressing this SDOH need (e.g., food bank, housing authority, transportation service, legal aid, employment agency).' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskDomain rdf:type rdf:Property ;
    rdfs:label 'Risk Domain' ;
    rdfs:comment 'The specific risk domain this Z-code addresses for risk stratification purposes. Aligns with CMS quality measure stratification and Accountable Health Communities (AHC) model domains.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityTier rdf:type rdf:Property ;
    rdfs:label 'Severity Tier' ;
    rdfs:comment 'The severity classification tier assigned to this Z-code for risk stratification and intervention prioritization. Determines urgency of community health worker outreach and referral management.' ;
    rdfs:domain ind:ZCodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rpmDeviceReadingsId rdf:type rdf:Property ;
    rdfs:label 'Rpm Device Readings Id' ;
    rdfs:comment 'Primary key for rpm_device_readings' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rpmClinicianId rdf:type rdf:Property ;
    rdfs:label 'Rpm Clinician Id' ;
    rdfs:comment 'Identifier of the provider who ordered the RPM monitoring that generated this reading.' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:rpmReviewingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Rpm Reviewing Provider Clinician Id' ;
    rdfs:comment 'Identifier of the clinical provider who reviewed and acknowledged this reading.' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:bodyPosition rdf:type rdf:Property ;
    rdfs:label 'Body Position' ;
    rdfs:comment 'Patient body position during measurement capture, which can significantly affect readings such as blood pressure.' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceModel rdf:type rdf:Property ;
    rdfs:label 'Device Model' ;
    rdfs:comment 'Model name or number of the RPM device that generated this reading.' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalReadingCode rdf:type rdf:Property ;
    rdfs:label 'External Reading Code' ;
    rdfs:comment 'Unique identifier assigned to this reading by the originating RPM device platform, used for deduplication and source traceability.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementContext rdf:type rdf:Property ;
    rdfs:label 'Measurement Context' ;
    rdfs:comment 'Clinical context or condition under which the measurement was taken, important for proper interpretation of results.' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationCode rdf:type rdf:Property ;
    rdfs:label 'Observation Code' ;
    rdfs:comment 'The LOINC code identifying the specific clinical observation or measurement type (e.g., 8867-4 for heart rate, 2339-0 for glucose).' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationDisplayName rdf:type rdf:Property ;
    rdfs:label 'Observation Display Name' ;
    rdfs:comment 'Human-readable display name for the observation code (e.g., Heart Rate, Blood Glucose, Systolic Blood Pressure).' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingType rdf:type rdf:Property ;
    rdfs:label 'Reading Type' ;
    rdfs:comment 'High-level classification of the type of physiological measurement captured by the device. [ENUM-REF-CANDIDATE: vital_sign|glucose|weight|activity|sleep|oxygen_saturation|blood_pressure|heart_rate|temperature|respiratory_rate|peak_flow|ecg — promote to reference product]' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryNumericValue rdf:type rdf:Property ;
    rdfs:label 'Secondary Numeric Value' ;
    rdfs:comment 'Secondary numeric measurement value for compound readings (e.g., diastolic blood pressure of 80 when primary is systolic 120, or post-meal glucose paired with fasting glucose).' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signalStrength rdf:type rdf:Property ;
    rdfs:label 'Signal Strength' ;
    rdfs:comment 'Signal strength indicator (e.g., RSSI in dBm) at the time of data transmission from device to gateway, affecting data reliability.' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stringValue rdf:type rdf:Property ;
    rdfs:label 'String Value' ;
    rdfs:comment 'Non-numeric observation value for readings that produce categorical or textual results (e.g., ECG rhythm classification, sleep stage label).' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdHighValue rdf:type rdf:Property ;
    rdfs:label 'Threshold High Value' ;
    rdfs:comment 'The upper threshold limit that was active at the time of this reading, used to determine if the reading exceeded normal parameters.' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdLowValue rdf:type rdf:Property ;
    rdfs:label 'Threshold Low Value' ;
    rdfs:comment 'The lower threshold limit that was active at the time of this reading, used to determine if the reading fell below normal parameters.' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionLatencySeconds rdf:type rdf:Property ;
    rdfs:label 'Transmission Latency Seconds' ;
    rdfs:comment 'Time difference in seconds between when the reading was captured on the device and when it was received by the platform, used for monitoring connectivity issues.' ;
    rdfs:domain ind:RpmDeviceReadings ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:promResponsesId rdf:type rdf:Property ;
    rdfs:label 'Prom Responses Id' ;
    rdfs:comment 'Primary key for prom_responses' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:episodeOfCareVisitId rdf:type rdf:Property ;
    rdfs:label 'Episode Of Care Visit Id' ;
    rdfs:comment 'Identifier linking this PROM response to a specific episode of care for longitudinal outcome tracking.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Visit .

ind:administrationDate rdf:type rdf:Property ;
    rdfs:label 'Administration Date' ;
    rdfs:comment 'Clinical date on which the PROM was administered, which may differ from submission date for paper-based or delayed entries.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assistedBy rdf:type rdf:Property ;
    rdfs:label 'Assisted By' ;
    rdfs:comment 'Indicates who assisted the patient in completing the PROM, relevant for data quality and proxy response identification.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeFromBaseline rdf:type rdf:Property ;
    rdfs:label 'Change From Baseline' ;
    rdfs:comment 'Difference between this response\'s total score and the patient\'s baseline score for the same instrument, indicating clinical improvement or decline.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicallyMeaningfulChange rdf:type rdf:Property ;
    rdfs:label 'Clinically Meaningful Change' ;
    rdfs:comment 'Indicates whether the change from baseline exceeds the minimally important difference (MID) threshold for the instrument.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:completionDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Completion Duration Seconds' ;
    rdfs:comment 'Total time in seconds the patient spent completing the PROM questionnaire from start to submission.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conditionCode rdf:type rdf:Property ;
    rdfs:label 'Condition Code' ;
    rdfs:comment 'ICD-10-CM diagnosis code for the condition being assessed by this PROM, enabling condition-specific outcome analysis.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domainCategory rdf:type rdf:Property ;
    rdfs:label 'Domain Category' ;
    rdfs:comment 'Health domain measured by this response (e.g., physical function, pain interference, mental health, fatigue, social participation). [ENUM-REF-CANDIDATE: physical_function|pain_interference|mental_health|fatigue|social_participation|sleep_disturbance|anxiety|depression|global_health — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalQuestionnaireCode rdf:type rdf:Property ;
    rdfs:label 'External Questionnaire Code' ;
    rdfs:comment 'Identifier from the source system linking this response to the specific questionnaire instance or session.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBaseline rdf:type rdf:Property ;
    rdfs:label 'Is Baseline' ;
    rdfs:comment 'Indicates whether this response represents the baseline measurement for the patient\'s treatment episode.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemsAdministered rdf:type rdf:Property ;
    rdfs:label 'Items Administered' ;
    rdfs:comment 'Number of individual questionnaire items presented to and answered by the patient in this session.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:itemsCompleted rdf:type rdf:Property ;
    rdfs:label 'Items Completed' ;
    rdfs:comment 'Number of items the patient actually completed, used to assess response completeness.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rawScore rdf:type rdf:Property ;
    rdfs:label 'Raw Score' ;
    rdfs:comment 'Sum of individual item responses before any standardization or T-score conversion.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewedByProvider rdf:type rdf:Property ;
    rdfs:label 'Reviewed By Provider' ;
    rdfs:comment 'Indicates whether a clinician has reviewed this PROM response and acknowledged the results.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standardError rdf:type rdf:Property ;
    rdfs:label 'Standard Error' ;
    rdfs:comment 'Standard error associated with the computed score, indicating measurement precision for CAT-administered instruments.' ;
    rdfs:domain ind:PromResponses ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portalEngagementEventsId rdf:type rdf:Property ;
    rdfs:label 'Portal Engagement Events Id' ;
    rdfs:comment 'Primary key for portal_engagement_events' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sessionId rdf:type rdf:Property ;
    rdfs:label 'Session Id' ;
    rdfs:comment 'Unique session identifier linking multiple events within a single patient portal login session.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentSession .

ind:accessibilityModeFlag rdf:type rdf:Property ;
    rdfs:label 'Accessibility Mode Flag' ;
    rdfs:comment 'Indicates whether the patient was using accessibility features (screen reader, high contrast, large text) during this portal event.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actionDetail rdf:type rdf:Property ;
    rdfs:label 'Action Detail' ;
    rdfs:comment 'Descriptive detail of the specific action taken within the event type, such as the specific lab test viewed or message subject category.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:browserOrAppVersion rdf:type rdf:Property ;
    rdfs:label 'Browser Or App Version' ;
    rdfs:comment 'Version of the web browser or mobile application used for the portal interaction.' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentReference rdf:type rdf:Property ;
    rdfs:label 'Content Reference' ;
    rdfs:comment 'Identifier of the specific content item accessed during the event, such as a lab result ID, message thread ID, or educational material ID.' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentType rdf:type rdf:Property ;
    rdfs:label 'Content Type' ;
    rdfs:comment 'Type of clinical or administrative content accessed or interacted with during the portal event. [ENUM-REF-CANDIDATE: lab_result|radiology_report|clinical_note|medication_list|immunization_record|billing_statement|discharge_summary|care_plan|allergy_list|vital_signs|referral|prescription — promote to reference product]' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataDownloadFlag rdf:type rdf:Property ;
    rdfs:label 'Data Download Flag' ;
    rdfs:comment 'Indicates whether the patient downloaded health data during this event, relevant to Meaningful Use and information blocking compliance.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:downloadFormat rdf:type rdf:Property ;
    rdfs:label 'Download Format' ;
    rdfs:comment 'File format of the data downloaded by the patient during this portal event.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventCategory rdf:type rdf:Property ;
    rdfs:label 'Event Category' ;
    rdfs:comment 'High-level functional category grouping the portal event for analytics and reporting purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventChannel rdf:type rdf:Property ;
    rdfs:label 'Event Channel' ;
    rdfs:comment 'Digital channel or interface through which the patient accessed the portal for this event.' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Outcome status indicating whether the portal engagement action was successfully completed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geolocationRegion rdf:type rdf:Property ;
    rdfs:label 'Geolocation Region' ;
    rdfs:comment 'Geographic region or state derived from the access location, used for access pattern analytics without storing precise coordinates.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFirstTimeAction rdf:type rdf:Property ;
    rdfs:label 'Is First Time Action' ;
    rdfs:comment 'Indicates whether this is the first time the patient has performed this specific type of action on the portal, useful for adoption tracking.' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:messageRecipientType rdf:type rdf:Property ;
    rdfs:label 'Message Recipient Type' ;
    rdfs:comment 'Category of the recipient when the event involves sending a portal message.' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationReference rdf:type rdf:Property ;
    rdfs:label 'Notification Reference' ;
    rdfs:comment 'Identifier of the notification or alert that triggered this portal visit, linking engagement back to outreach campaigns.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingSystem rdf:type rdf:Property ;
    rdfs:label 'Operating System' ;
    rdfs:comment 'Operating system of the device used for the portal interaction.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pageOrSectionName rdf:type rdf:Property ;
    rdfs:label 'Page Or Section Name' ;
    rdfs:comment 'Name of the specific portal page, module, or section where the engagement event took place.' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiAccessedFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Accessed Flag' ;
    rdfs:comment 'Indicates whether the portal event involved viewing or downloading Protected Health Information, triggering HIPAA audit requirements.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:portalVersion rdf:type rdf:Property ;
    rdfs:label 'Portal Version' ;
    rdfs:comment 'Version of the patient portal application at the time of the event, supporting A/B testing and feature rollout analysis.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Proxy Access Flag' ;
    rdfs:comment 'Indicates whether this portal event was performed by an authorized proxy (caregiver, guardian, or legal representative) on behalf of the patient.' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceEventReference rdf:type rdf:Property ;
    rdfs:label 'Source Event Reference' ;
    rdfs:comment 'Original event identifier from the source patient portal system for traceability and deduplication.' ;
    rdfs:domain ind:PortalEngagementEvents ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:variantInterpretationId rdf:type rdf:Property ;
    rdfs:label 'Variant Interpretation Id' ;
    rdfs:comment 'Primary key for variant_interpretation' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicTestOrderId rdf:type rdf:Property ;
    rdfs:label 'Genomic Test Order Id' ;
    rdfs:comment 'Identifier of the laboratory or genomic test order that produced the variant data being interpreted.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicTestOrder .

ind:variantClinicianId rdf:type rdf:Property ;
    rdfs:label 'Variant Clinician Id' ;
    rdfs:comment 'Identifier of the provider who ordered the genomic test leading to this interpretation.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:variantInterpretingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Variant Interpreting Provider Clinician Id' ;
    rdfs:comment 'Identifier of the clinical geneticist or molecular pathologist who performed the variant interpretation.' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:acmgClassification rdf:type rdf:Property ;
    rdfs:label 'Acmg Classification' ;
    rdfs:comment 'Five-tier clinical significance classification per ACMG/AMP guidelines: pathogenic, likely pathogenic, variant of uncertain significance (VUS), likely benign, or benign.' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associatedCondition rdf:type rdf:Property ;
    rdfs:label 'Associated Condition' ;
    rdfs:comment 'Primary clinical condition or disease phenotype associated with the interpreted variant (e.g., Hereditary Breast and Ovarian Cancer Syndrome).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chromosome rdf:type rdf:Property ;
    rdfs:label 'Chromosome' ;
    rdfs:comment 'Chromosome on which the variant is located (e.g., chr17, chrX).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cliaLabNumber rdf:type rdf:Property ;
    rdfs:label 'Clia Lab Number' ;
    rdfs:comment 'CLIA certification number of the performing laboratory, required for regulatory compliance of clinical genomic testing.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalSignificanceSummary rdf:type rdf:Property ;
    rdfs:label 'Clinical Significance Summary' ;
    rdfs:comment 'Free-text narrative summarizing the clinical significance of the variant in the context of the patient\'s phenotype and family history.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinvarAccession rdf:type rdf:Property ;
    rdfs:label 'Clinvar Accession' ;
    rdfs:comment 'ClinVar submission accession number linking this interpretation to the NCBI ClinVar public archive of variant-disease relationships.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:computationalScore rdf:type rdf:Property ;
    rdfs:label 'Computational Score' ;
    rdfs:comment 'Numeric pathogenicity score from the primary computational prediction tool used (e.g., CADD PHRED score, REVEL score).' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:computationalToolUsed rdf:type rdf:Property ;
    rdfs:label 'Computational Tool Used' ;
    rdfs:comment 'Name and version of the primary computational prediction tool used to generate the pathogenicity score (e.g., CADD v1.6, REVEL, AlphaMissense).' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cosmicAccession rdf:type rdf:Property ;
    rdfs:label 'Cosmic Accession' ;
    rdfs:comment 'COSMIC identifier for somatic variants found in cancer genomes, applicable to tumor-related interpretations.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dbsnpRsid rdf:type rdf:Property ;
    rdfs:label 'Dbsnp Rsid' ;
    rdfs:comment 'dbSNP reference SNP cluster identifier (rsID) for the variant, enabling cross-referencing with public genomic databases.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceCriteriaApplied rdf:type rdf:Property ;
    rdfs:label 'Evidence Criteria Applied' ;
    rdfs:comment 'Comma-separated list of ACMG/AMP evidence criteria codes applied to reach the classification (e.g., PVS1, PM2, PP3).' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:familySegregationData rdf:type rdf:Property ;
    rdfs:label 'Family Segregation Data' ;
    rdfs:comment 'Summary of family segregation analysis data indicating whether the variant co-segregates with disease in affected family members.' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalImpactPrediction rdf:type rdf:Property ;
    rdfs:label 'Functional Impact Prediction' ;
    rdfs:comment 'Consensus in silico prediction of functional impact from computational tools such as SIFT, PolyPhen-2, CADD, or REVEL.' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneticCounselingRecommended rdf:type rdf:Property ;
    rdfs:label 'Genetic Counseling Recommended' ;
    rdfs:comment 'Indicates whether genetic counseling is recommended for the patient and/or family members based on this interpretation.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genomicPosition rdf:type rdf:Property ;
    rdfs:label 'Genomic Position' ;
    rdfs:comment 'Genomic coordinate position of the variant on the reference genome assembly.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hgvsCodingNotation rdf:type rdf:Property ;
    rdfs:label 'Hgvs Coding Notation' ;
    rdfs:comment 'HGVS-formatted coding DNA sequence notation describing the variant at the nucleotide level (e.g., c.5266dupC).' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hgvsProteinNotation rdf:type rdf:Property ;
    rdfs:label 'Hgvs Protein Notation' ;
    rdfs:comment 'HGVS-formatted protein-level notation describing the predicted amino acid change (e.g., p.Gln1756ProfsTer74).' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inheritancePattern rdf:type rdf:Property ;
    rdfs:label 'Inheritance Pattern' ;
    rdfs:comment 'Mode of inheritance for the condition associated with the variant.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSecondaryFinding rdf:type rdf:Property ;
    rdfs:label 'Is Secondary Finding' ;
    rdfs:comment 'Indicates whether this variant represents an ACMG-recommended secondary finding unrelated to the primary test indication.' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performingLaboratoryName rdf:type rdf:Property ;
    rdfs:label 'Performing Laboratory Name' ;
    rdfs:comment 'Name of the CLIA-certified laboratory that performed the genomic sequencing and initial variant calling.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationDatabaseSource rdf:type rdf:Property ;
    rdfs:label 'Population Database Source' ;
    rdfs:comment 'Reference population database from which the allele frequency was obtained.' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceGenomeBuild rdf:type rdf:Property ;
    rdfs:label 'Reference Genome Build' ;
    rdfs:comment 'Human reference genome assembly version used for variant coordinate mapping.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportIssuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Issued Timestamp' ;
    rdfs:comment 'Timestamp when the finalized variant interpretation report was officially issued and made available to the ordering provider.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:testMethodology rdf:type rdf:Property ;
    rdfs:label 'Test Methodology' ;
    rdfs:comment 'Laboratory methodology used to detect the variant (whole genome sequencing, whole exome sequencing, targeted gene panel, single gene test, FISH, or array CGH). [ENUM-REF-CANDIDATE: WGS|WES|targeted_panel|single_gene|FISH|array_CGH|RNA_seq — promote to reference product]' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testPanelName rdf:type rdf:Property ;
    rdfs:label 'Test Panel Name' ;
    rdfs:comment 'Name of the specific gene panel or test assay used (e.g., Comprehensive Cancer Panel, Hereditary Cardiac Panel).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticImplication rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Implication' ;
    rdfs:comment 'Summary of therapeutic implications including targeted therapy eligibility, drug sensitivity or resistance, and clinical trial candidacy based on the variant.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierClassification rdf:type rdf:Property ;
    rdfs:label 'Tier Classification' ;
    rdfs:comment 'Four-tier classification for somatic variants per AMP/ASCO/CAP guidelines indicating level of clinical evidence for actionability. [ENUM-REF-CANDIDATE: tier_I_A|tier_I_B|tier_II_C|tier_II_D|tier_III|tier_IV — promote to reference product]' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tumorMutationalBurden rdf:type rdf:Property ;
    rdfs:label 'Tumor Mutational Burden' ;
    rdfs:comment 'Tumor mutational burden measured in mutations per megabase, relevant for somatic variant interpretations and immunotherapy eligibility assessment.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variantAlleleFraction rdf:type rdf:Property ;
    rdfs:label 'Variant Allele Fraction' ;
    rdfs:comment 'Proportion of sequencing reads supporting the variant allele at this position, indicating clonality in somatic contexts or confirming zygosity in germline contexts.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variantClass rdf:type rdf:Property ;
    rdfs:label 'Variant Class' ;
    rdfs:comment 'Structural classification of the genomic variant (single nucleotide variant, insertion, deletion, indel, copy number variant, or structural variant).' ;
    rdfs:domain ind:VariantInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zygosity rdf:type rdf:Property ;
    rdfs:label 'Zygosity' ;
    rdfs:comment 'Zygosity state of the variant in the patient (heterozygous, homozygous, hemizygous, or compound heterozygous).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Employee Id' ;
    rdfs:comment 'Identifier of the clinical or quality leader who approved this cohort definition for production use.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:owningOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Owning Organization Id' ;
    rdfs:comment 'Organization or department that owns and maintains this cohort definition, responsible for clinical validity and updates.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:code rdf:type rdf:Property ;
    rdfs:label 'Code' ;
    rdfs:comment 'Externally-known unique business identifier code for this cohort definition, used across Epic Healthy Planet registries and analytics platforms.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:description rdf:type rdf:Property ;
    rdfs:label 'Description' ;
    rdfs:comment 'Detailed narrative describing the clinical or operational purpose of this cohort, including target patient population and intended use cases.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCodeSet rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code Set' ;
    rdfs:comment 'Comma-separated list or value set identifier of ICD-10 diagnosis codes used as primary clinical criteria for cohort inclusion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationFrequency rdf:type rdf:Property ;
    rdfs:label 'Evaluation Frequency' ;
    rdfs:comment 'How often the dynamic cohort membership is re-evaluated against the underlying patient data to refresh the population.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionCriteriaExpression rdf:type rdf:Property ;
    rdfs:label 'Exclusion Criteria Expression' ;
    rdfs:comment 'Structured logical expression defining the exclusion rules that remove patients from cohort membership even if inclusion criteria are met.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirMeasureResourceUrl rdf:type rdf:Property ;
    rdfs:label 'Fhir Measure Resource Url' ;
    rdfs:comment 'URL reference to the HL7 FHIR Measure or Library resource that formally represents this cohort definition for interoperability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderCriteria rdf:type rdf:Property ;
    rdfs:label 'Gender Criteria' ;
    rdfs:comment 'Gender-based eligibility filter for the cohort. Value of \'all\' indicates no gender restriction; \'specific\' indicates complex gender logic in the inclusion criteria expression.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaMinimumNecessaryFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Minimum Necessary Flag' ;
    rdfs:comment 'Indicates whether the cohort definition has been reviewed to ensure it adheres to HIPAA minimum necessary standard for data access.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inclusionCriteriaExpression rdf:type rdf:Property ;
    rdfs:label 'Inclusion Criteria Expression' ;
    rdfs:comment 'Structured logical expression defining the inclusion rules for patient membership, expressed in a query-compatible format (e.g., SQL predicate, CQL, or FHIR ClinicalReasoning expression).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIrbApproved rdf:type rdf:Property ;
    rdfs:label 'Is Irb Approved' ;
    rdfs:comment 'Indicates whether this cohort definition has received IRB approval for use in research contexts.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:labResultCriteria rdf:type rdf:Property ;
    rdfs:label 'Lab Result Criteria' ;
    rdfs:comment 'LOINC-based laboratory result criteria expression defining lab value thresholds or patterns required for cohort membership.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastEvaluationDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Last Evaluation Duration Seconds' ;
    rdfs:comment 'Execution time in seconds for the most recent cohort evaluation run, used for performance monitoring and optimization.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastEvaluationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Evaluation Timestamp' ;
    rdfs:comment 'Timestamp of the most recent execution of the cohort evaluation logic against the patient population.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:medicationCodeSet rdf:type rdf:Property ;
    rdfs:label 'Medication Code Set' ;
    rdfs:comment 'Comma-separated list or value set identifier of NDC or RxNorm codes defining medication-based criteria for cohort membership.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumEncounterCount rdf:type rdf:Property ;
    rdfs:label 'Minimum Encounter Count' ;
    rdfs:comment 'Minimum number of qualifying encounters a patient must have within the lookback period to be included in the cohort.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:name rdf:type rdf:Property ;
    rdfs:label 'Name' ;
    rdfs:comment 'Human-readable display name for the dynamic cohort definition, used in clinical dashboards and population health reports.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Enabled Flag' ;
    rdfs:comment 'Indicates whether automated notifications are triggered when patients enter or exit this cohort, supporting care gap closure workflows.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payerTypeFilter rdf:type rdf:Property ;
    rdfs:label 'Payer Type Filter' ;
    rdfs:comment 'Optional filter restricting cohort membership to patients with specific insurance/payer types (e.g., Medicare, Medicaid, Commercial).' ;
    rdfs:domain ind:PopulationHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureCodeSet rdf:type rdf:Property ;
    rdfs:label 'Procedure Code Set' ;
    rdfs:comment 'Comma-separated list or value set identifier of CPT/HCPCS procedure codes used as criteria for cohort inclusion.' ;
    rdfs:domain ind:PopulationHealthDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDueDate rdf:type rdf:Property ;
    rdfs:label 'Review Due Date' ;
    rdfs:comment 'Date by which this cohort definition must be reviewed for continued clinical relevance and accuracy per governance policy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskModelName rdf:type rdf:Property ;
    rdfs:label 'Risk Model Name' ;
    rdfs:comment 'Name of the risk stratification model used for score-based cohort criteria (e.g., HCC, LACE, Charlson Comorbidity Index).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScoreThreshold rdf:type rdf:Property ;
    rdfs:label 'Risk Score Threshold' ;
    rdfs:comment 'Minimum risk stratification score (e.g., HCC risk score) a patient must meet to qualify for this cohort.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sdohCriteriaFlag rdf:type rdf:Property ;
    rdfs:label 'Sdoh Criteria Flag' ;
    rdfs:comment 'Indicates whether this cohort definition incorporates Social Determinants of Health factors in its membership logic.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:status rdf:type rdf:Property ;
    rdfs:label 'Status' ;
    rdfs:comment 'Current lifecycle state of the cohort definition indicating whether it is actively generating patient membership or is inactive.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalLabReference rdf:type rdf:Property ;
    rdfs:label 'External Lab Reference' ;
    rdfs:comment 'Reference number assigned by an external reference laboratory if the sequencing was performed by a send-out lab.' ;
    rdfs:domain ind:GenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirDiagnosticReportReference rdf:type rdf:Property ;
    rdfs:label 'Fhir Diagnostic Report Reference' ;
    rdfs:comment 'FHIR resource identifier for the genomic diagnostic report, enabling interoperability with external systems.' ;
    rdfs:domain ind:GenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genePanelName rdf:type rdf:Property ;
    rdfs:label 'Gene Panel Name' ;
    rdfs:comment 'Name of the targeted gene panel used for sequencing, if applicable (e.g., hereditary cancer panel, cardiac panel).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genesTestedCount rdf:type rdf:Property ;
    rdfs:label 'Genes Tested Count' ;
    rdfs:comment 'Total number of genes included in the sequencing panel or analysis.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicSequenceStatus rdf:type rdf:Property ;
    rdfs:label 'Genomic Sequence Status' ;
    rdfs:comment 'Current lifecycle status of the genomic sequencing result within the laboratory workflow.' ;
    rdfs:domain ind:GenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaMinimumNecessaryApplied rdf:type rdf:Property ;
    rdfs:label 'Hipaa Minimum Necessary Applied' ;
    rdfs:comment 'Indicates whether the HIPAA minimum necessary standard was applied when disclosing or using the genomic data.' ;
    rdfs:domain ind:GenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpretingGeneticist rdf:type rdf:Property ;
    rdfs:label 'Interpreting Geneticist' ;
    rdfs:comment 'Name or identifier of the board-certified clinical geneticist or molecular pathologist who interpreted and signed out the results.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meanCoverageDepth rdf:type rdf:Property ;
    rdfs:label 'Mean Coverage Depth' ;
    rdfs:comment 'Average sequencing read depth across the targeted regions, indicating the quality and reliability of the sequencing data.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:microsatelliteInstabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Microsatellite Instability Status' ;
    rdfs:comment 'Microsatellite instability status determined from sequencing data, a biomarker for immunotherapy response in oncology.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallInterpretation rdf:type rdf:Property ;
    rdfs:label 'Overall Interpretation' ;
    rdfs:comment 'Overall clinical interpretation of the genomic sequencing results categorizing the finding at a high level.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passedQualityControl rdf:type rdf:Property ;
    rdfs:label 'Passed Quality Control' ;
    rdfs:comment 'Indicates whether the sequencing run met all quality control thresholds required for clinical reporting.' ;
    rdfs:domain ind:GenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pathogenicityClassification rdf:type rdf:Property ;
    rdfs:label 'Pathogenicity Classification' ;
    rdfs:comment 'ACMG five-tier classification of the most clinically significant variant identified in the sequencing results.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentBasesAbove20x rdf:type rdf:Property ;
    rdfs:label 'Percent Bases Above 20x' ;
    rdfs:comment 'Percentage of targeted bases with sequencing coverage depth of 20x or greater, a key quality metric for clinical-grade sequencing.' ;
    rdfs:domain ind:GenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:platform rdf:type rdf:Property ;
    rdfs:label 'Platform' ;
    rdfs:comment 'The sequencing technology platform used to generate the data (e.g., Illumina NovaSeq, PacBio Sequel, Oxford Nanopore). [ENUM-REF-CANDIDATE: illumina_novaseq|illumina_hiseq|pacbio_sequel|oxford_nanopore|ion_torrent|bgi_dnbseq|element_aviti — promote to reference product]' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qcFailureReason rdf:type rdf:Property ;
    rdfs:label 'Qc Failure Reason' ;
    rdfs:comment 'Description of the reason for quality control failure, if the sequencing run did not pass QC thresholds.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedFollowup rdf:type rdf:Property ;
    rdfs:label 'Recommended Followup' ;
    rdfs:comment 'Clinical follow-up actions recommended based on the genomic sequencing results, such as genetic counseling, cascade testing, or targeted therapy.' ;
    rdfs:domain ind:GenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchUseAuthorized rdf:type rdf:Property ;
    rdfs:label 'Research Use Authorized' ;
    rdfs:comment 'Indicates whether the patient has authorized use of their genomic data for research purposes.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultSummary rdf:type rdf:Property ;
    rdfs:label 'Result Summary' ;
    rdfs:comment 'High-level narrative summary of the genomic sequencing findings, including key variants and clinical significance.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Retention Expiry Date' ;
    rdfs:comment 'Date after which the genomic sequencing record is eligible for archival or deletion per HIPAA retention policy and state regulations.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tumorNormalIndicator rdf:type rdf:Property ;
    rdfs:label 'Tumor Normal Indicator' ;
    rdfs:comment 'Indicates whether the sequencing was performed on tumor tissue only, paired tumor-normal, germline, or somatic analysis context.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnaroundDays rdf:type rdf:Property ;
    rdfs:label 'Turnaround Days' ;
    rdfs:comment 'Number of calendar days from specimen receipt to final report issuance, measuring laboratory operational efficiency.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:variantsDetectedCount rdf:type rdf:Property ;
    rdfs:label 'Variants Detected Count' ;
    rdfs:comment 'Total number of reportable variants detected in the sequencing analysis.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:variantAnnotationId rdf:type rdf:Property ;
    rdfs:label 'Variant Annotation Id' ;
    rdfs:comment 'Primary key for variant_annotation' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:variantReviewedByProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Variant Reviewed By Provider Clinician Id' ;
    rdfs:comment 'Identifier of the molecular pathologist or geneticist who reviewed and approved this annotation.' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:acmgClassificationCriteria rdf:type rdf:Property ;
    rdfs:label 'Acmg Classification Criteria' ;
    rdfs:comment 'Comma-separated list of ACMG/AMP evidence criteria codes applied (e.g., PVS1, PM2, PP3) supporting the clinical significance determination.' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionabilityLevel rdf:type rdf:Property ;
    rdfs:label 'Actionability Level' ;
    rdfs:comment 'Level of clinical actionability evidence per ClinGen framework indicating strength of gene-disease-intervention relationship.' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alleleFrequencyGnomad rdf:type rdf:Property ;
    rdfs:label 'Allele Frequency Gnomad' ;
    rdfs:comment 'Population allele frequency from the gnomAD database used to assess variant rarity.' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alleleFrequencyPopulation rdf:type rdf:Property ;
    rdfs:label 'Allele Frequency Population' ;
    rdfs:comment 'Population or ethnic subgroup from which the allele frequency was derived (e.g., European, African, East Asian).' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allelicDepth rdf:type rdf:Property ;
    rdfs:label 'Allelic Depth' ;
    rdfs:comment 'Number of sequencing reads supporting the alternate allele at this position.' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alternateAllele rdf:type rdf:Property ;
    rdfs:label 'Alternate Allele' ;
    rdfs:comment 'The observed alternate allele differing from the reference at this position.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annotationNotes rdf:type rdf:Property ;
    rdfs:label 'Annotation Notes' ;
    rdfs:comment 'Additional free-text notes from the annotator or reviewer regarding variant context, limitations, or follow-up recommendations.' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annotationSource rdf:type rdf:Property ;
    rdfs:label 'Annotation Source' ;
    rdfs:comment 'Name and version of the annotation tool or pipeline used (e.g., VEP, ANNOVAR, SnpEff).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annotationSourceVersion rdf:type rdf:Property ;
    rdfs:label 'Annotation Source Version' ;
    rdfs:comment 'Version of the reference databases used during annotation (e.g., ClinVar release date, gnomAD version).' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalTrialRelevance rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Relevance' ;
    rdfs:comment 'Description of any clinical trial eligibility implications based on this variant, supporting precision medicine enrollment.' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diseaseAssociation rdf:type rdf:Property ;
    rdfs:label 'Disease Association' ;
    rdfs:comment 'Disease or clinical condition associated with this variant per curated databases and literature.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalConsequence rdf:type rdf:Property ;
    rdfs:label 'Functional Consequence' ;
    rdfs:comment 'Predicted functional consequence of the variant on the gene product. [ENUM-REF-CANDIDATE: missense|nonsense|frameshift|splice_site|synonymous|intronic|start_loss|stop_loss|inframe_insertion|inframe_deletion|UTR — promote to reference product]' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicPositionEnd rdf:type rdf:Property ;
    rdfs:label 'Genomic Position End' ;
    rdfs:comment 'End position of the variant on the chromosome; equals start position for single nucleotide variants.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicPositionStart rdf:type rdf:Property ;
    rdfs:label 'Genomic Position Start' ;
    rdfs:comment 'Start position of the variant on the chromosome in the reference genome coordinate system.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hgvsCoding rdf:type rdf:Property ;
    rdfs:label 'Hgvs Coding' ;
    rdfs:comment 'HGVS nomenclature describing the variant at the coding DNA level (c. notation).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hgvsProtein rdf:type rdf:Property ;
    rdfs:label 'Hgvs Protein' ;
    rdfs:comment 'HGVS nomenclature describing the predicted protein-level change (p. notation).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceAllele rdf:type rdf:Property ;
    rdfs:label 'Reference Allele' ;
    rdfs:comment 'The reference genome allele at the variant position.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedDate rdf:type rdf:Property ;
    rdfs:label 'Reported Date' ;
    rdfs:comment 'Date when this variant annotation was included in the final clinical genomics report.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sampleType rdf:type rdf:Property ;
    rdfs:label 'Sample Type' ;
    rdfs:comment 'Indicates whether the variant was detected in germline (constitutional) or somatic (tumor) tissue.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalReadDepth rdf:type rdf:Property ;
    rdfs:label 'Total Read Depth' ;
    rdfs:comment 'Total number of sequencing reads covering this genomic position, used to assess call confidence.' ;
    rdfs:domain ind:VariantAnnotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transcriptAccession rdf:type rdf:Property ;
    rdfs:label 'Transcript Accession' ;
    rdfs:comment 'RefSeq or Ensembl transcript identifier used as the reference for annotation.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:variantType rdf:type rdf:Property ;
    rdfs:label 'Variant Type' ;
    rdfs:comment 'Classification of the type of genomic variant detected (e.g., single nucleotide variant, insertion, deletion, copy number variant).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicVariantId rdf:type rdf:Property ;
    rdfs:label 'Genomic Variant Id' ;
    rdfs:comment 'Primary key for genomic_variant' ;
    rdfs:domain ind:GenomicVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionabilityTier rdf:type rdf:Property ;
    rdfs:label 'Actionability Tier' ;
    rdfs:comment 'AMP/ASCO/CAP tier classification indicating the level of clinical evidence supporting actionability of the variant in treatment decisions.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alleleFrequencySource rdf:type rdf:Property ;
    rdfs:label 'Allele Frequency Source' ;
    rdfs:comment 'Reference population database from which the allele frequency was obtained.' ;
    rdfs:domain ind:GenomicVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allelicDepthAlt rdf:type rdf:Property ;
    rdfs:label 'Allelic Depth Alt' ;
    rdfs:comment 'Number of sequencing reads supporting the alternate allele at this position.' ;
    rdfs:domain ind:GenomicVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:callDate rdf:type rdf:Property ;
    rdfs:label 'Call Date' ;
    rdfs:comment 'Date on which the variant was initially called by the bioinformatics pipeline.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dbsnpAccession rdf:type rdf:Property ;
    rdfs:label 'Dbsnp Accession' ;
    rdfs:comment 'NCBI dbSNP reference SNP cluster identifier (rsID) for known variants.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filterStatus rdf:type rdf:Property ;
    rdfs:label 'Filter Status' ;
    rdfs:comment 'Quality filter status indicating whether the variant passed bioinformatics pipeline quality thresholds.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalImpact rdf:type rdf:Property ;
    rdfs:label 'Functional Impact' ;
    rdfs:comment 'Predicted functional consequence of the variant on the gene product.' ;
    rdfs:domain ind:GenomicVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionEnd rdf:type rdf:Property ;
    rdfs:label 'Position End' ;
    rdfs:comment 'End position of the variant on the chromosome; equals position_start for single nucleotide variants.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:positionStart rdf:type rdf:Property ;
    rdfs:label 'Position Start' ;
    rdfs:comment 'Start position of the variant on the chromosome in 1-based coordinate system.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:somaticOrGermline rdf:type rdf:Property ;
    rdfs:label 'Somatic Or Germline' ;
    rdfs:comment 'Classification of whether the variant is of somatic (tumor-acquired) or germline (inherited) origin.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tumorType rdf:type rdf:Property ;
    rdfs:label 'Tumor Type' ;
    rdfs:comment 'Specific tumor or cancer type context in which this somatic variant was identified, if applicable.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:variantCaller rdf:type rdf:Property ;
    rdfs:label 'Variant Caller' ;
    rdfs:comment 'Name and version of the variant calling software used (e.g., GATK HaplotypeCaller, Mutect2, Strelka2).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalRunSequencingRunId rdf:type rdf:Property ;
    rdfs:label 'Original Run Sequencing Run Id' ;
    rdfs:comment 'Reference to the original sequencing run that this repeat run is intended to replace, if applicable.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SequencingRun .

ind:baseCallingSoftwareVersion rdf:type rdf:Property ;
    rdfs:label 'Base Calling Software Version' ;
    rdfs:comment 'Version of the base calling software (e.g., RTA, MinKNOW) used to convert raw signals to base calls.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clusterDensity rdf:type rdf:Property ;
    rdfs:label 'Cluster Density' ;
    rdfs:comment 'Density of clusters per square millimeter on the flow cell, a key metric for Illumina-based sequencing run optimization.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataSizeGb rdf:type rdf:Property ;
    rdfs:label 'Data Size Gb' ;
    rdfs:comment 'Total size of the sequencing run output data in gigabytes, relevant for storage planning and data transfer.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demultiplexingStatus rdf:type rdf:Property ;
    rdfs:label 'Demultiplexing Status' ;
    rdfs:comment 'Status of the demultiplexing process that separates pooled sample reads based on index sequences.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorRatePercent rdf:type rdf:Property ;
    rdfs:label 'Error Rate Percent' ;
    rdfs:comment 'Estimated error rate as a percentage, calculated from PhiX spike-in or other control metrics.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flowCellBarcode rdf:type rdf:Property ;
    rdfs:label 'Flow Cell Barcode' ;
    rdfs:comment 'Unique identifier of the flow cell or chip used in this sequencing run, enabling lot traceability and quality correlation.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowCellType rdf:type rdf:Property ;
    rdfs:label 'Flow Cell Type' ;
    rdfs:comment 'Type or model of the flow cell used (e.g., S1, S2, S4 for NovaSeq; R9, R10 for Nanopore), affecting throughput and read characteristics.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexType rdf:type rdf:Property ;
    rdfs:label 'Index Type' ;
    rdfs:comment 'Type of indexing strategy used for sample demultiplexing in this sequencing run.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Instrument Serial Number' ;
    rdfs:comment 'Manufacturer serial number of the sequencing instrument used for this run, supporting equipment traceability and maintenance tracking.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPairedEnd rdf:type rdf:Property ;
    rdfs:label 'Is Paired End' ;
    rdfs:comment 'Indicates whether the sequencing run uses paired-end reads (true) or single-end reads (false).' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRepeatRun rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Run' ;
    rdfs:comment 'Indicates whether this run is a repeat of a previously failed or suboptimal run.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadingConcentrationPm rdf:type rdf:Property ;
    rdfs:label 'Loading Concentration Pm' ;
    rdfs:comment 'Library loading concentration in picomolar (pM) used for this sequencing run.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfLanes rdf:type rdf:Property ;
    rdfs:label 'Number Of Lanes' ;
    rdfs:comment 'Total number of lanes on the flow cell utilized in this sequencing run.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outputFolderPath rdf:type rdf:Property ;
    rdfs:label 'Output Folder Path' ;
    rdfs:comment 'File system or cloud storage path where the raw sequencing output (BCL/FASTQ files) is stored.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentAlignedPhix rdf:type rdf:Property ;
    rdfs:label 'Percent Aligned Phix' ;
    rdfs:comment 'Percentage of reads aligned to the PhiX control genome, used for quality monitoring and error rate estimation.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentClustersPassingFilter rdf:type rdf:Property ;
    rdfs:label 'Percent Clusters Passing Filter' ;
    rdfs:comment 'Percentage of clusters that pass the quality filter, indicating the proportion of usable data from the run.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentUndeterminedReads rdf:type rdf:Property ;
    rdfs:label 'Percent Undetermined Reads' ;
    rdfs:comment 'Percentage of reads that could not be assigned to a sample during demultiplexing, indicating index hopping or contamination.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readConfiguration rdf:type rdf:Property ;
    rdfs:label 'Read Configuration' ;
    rdfs:comment 'Configuration of the sequencing reads (e.g., 2x150, 1x100, 2x250), specifying paired-end or single-end and read lengths.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reagentKitExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Reagent Kit Expiration Date' ;
    rdfs:comment 'Expiration date of the reagent kit used, relevant for compliance and quality assurance.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reagentKitLotNumber rdf:type rdf:Property ;
    rdfs:label 'Reagent Kit Lot Number' ;
    rdfs:comment 'Lot number of the reagent kit used for this sequencing run, supporting supply chain traceability and quality investigations.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runDurationHours rdf:type rdf:Property ;
    rdfs:label 'Run Duration Hours' ;
    rdfs:comment 'Total elapsed time of the sequencing run in hours from start to completion.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:runEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run End Timestamp' ;
    rdfs:comment 'Date and time when the sequencing run completed or was terminated on the instrument.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:runStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run Start Timestamp' ;
    rdfs:comment 'Date and time when the sequencing run was initiated on the instrument.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sequencingRunStatus rdf:type rdf:Property ;
    rdfs:label 'Sequencing Run Status' ;
    rdfs:comment 'Current lifecycle status of the sequencing run, tracking its progression from planning through completion or failure.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalBasesGenerated rdf:type rdf:Property ;
    rdfs:label 'Total Bases Generated' ;
    rdfs:comment 'Total number of bases (nucleotides) sequenced in this run, representing overall data yield.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalReadsGenerated rdf:type rdf:Property ;
    rdfs:label 'Total Reads Generated' ;
    rdfs:comment 'Total number of sequencing reads generated by this run, a primary throughput metric.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalSamples rdf:type rdf:Property ;
    rdfs:label 'Total Samples' ;
    rdfs:comment 'Total number of samples (libraries) loaded onto this sequencing run.' ;
    rdfs:domain ind:SequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientInterpretingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Patient Interpreting Provider Clinician Id' ;
    rdfs:comment 'Identifier of the provider or genetic counselor who interpreted the genomic results.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:actionableVariantsCount rdf:type rdf:Property ;
    rdfs:label 'Actionable Variants Count' ;
    rdfs:comment 'Number of clinically actionable variants identified that may influence treatment decisions or surveillance recommendations.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageCoverageDepth rdf:type rdf:Property ;
    rdfs:label 'Average Coverage Depth' ;
    rdfs:comment 'Mean sequencing coverage depth achieved across the targeted regions, indicating data quality.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carePathwayRecommendation rdf:type rdf:Property ;
    rdfs:label 'Care Pathway Recommendation' ;
    rdfs:comment 'Recommended clinical care pathway based on genomic findings, such as enhanced surveillance, targeted therapy, or prophylactic intervention.' ;
    rdfs:domain ind:PatientGenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalTrialEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Eligible Flag' ;
    rdfs:comment 'Indicates whether the genomic profile qualifies the patient for enrollment in relevant clinical trials.' ;
    rdfs:domain ind:PatientGenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:familyHistoryRelevantFlag rdf:type rdf:Property ;
    rdfs:label 'Family History Relevant Flag' ;
    rdfs:comment 'Indicates whether the patient has a relevant family history that contributed to the decision to order genomic testing.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geneticCounselingCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Genetic Counseling Completed Flag' ;
    rdfs:comment 'Indicates whether the patient received genetic counseling before or after genomic testing.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hereditaryRiskCategory rdf:type rdf:Property ;
    rdfs:label 'Hereditary Risk Category' ;
    rdfs:comment 'Categorization of the patients hereditary risk level based on genomic findings and family history.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicationIcdCode rdf:type rdf:Property ;
    rdfs:label 'Indication Icd Code' ;
    rdfs:comment 'ICD-10-CM diagnosis code representing the clinical indication for the genomic test.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceAuthorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Insurance Authorization Status' ;
    rdfs:comment 'Status of insurance prior authorization for the genomic test.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performingLaboratoryCliaNumber rdf:type rdf:Property ;
    rdfs:label 'Performing Laboratory Clia Number' ;
    rdfs:comment 'CLIA certification number of the laboratory that performed the genomic test, ensuring regulatory compliance.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryConditionIndication rdf:type rdf:Property ;
    rdfs:label 'Primary Condition Indication' ;
    rdfs:comment 'Primary clinical condition or indication for which the genomic test was ordered (e.g., suspected hereditary breast cancer, pharmacogenomic dosing).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportDeliveredDate rdf:type rdf:Property ;
    rdfs:label 'Report Delivered Date' ;
    rdfs:comment 'Date on which the final genomic report was delivered to the ordering provider or integrated into the EHR.' ;
    rdfs:domain ind:PatientGenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:specimenCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Specimen Collection Date' ;
    rdfs:comment 'Date on which the biological specimen was collected from the patient for genomic testing.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetedTherapyEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Targeted Therapy Eligible Flag' ;
    rdfs:comment 'Indicates whether the genomic findings suggest eligibility for a targeted therapy or precision medicine treatment.' ;
    rdfs:domain ind:PatientGenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:variantsIdentifiedCount rdf:type rdf:Property ;
    rdfs:label 'Variants Identified Count' ;
    rdfs:comment 'Total number of reportable variants identified in the genomic analysis.' ;
    rdfs:domain ind:PatientGenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sequencingResultId rdf:type rdf:Property ;
    rdfs:label 'Sequencing Result Id' ;
    rdfs:comment 'Primary key for sequencing_result' ;
    rdfs:domain ind:SequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorResultSequencingResultId rdf:type rdf:Property ;
    rdfs:label 'Prior Result Sequencing Result Id' ;
    rdfs:comment 'Reference to a previous sequencing result that this test is repeating, amending, or reflexing from.' ;
    rdfs:domain ind:SequencingResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SequencingResult .

ind:sequencingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Sequencing Clinician Id' ;
    rdfs:comment 'Identifier of the provider who ordered the genomic sequencing test.' ;
    rdfs:domain ind:SequencingResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:sequencingInterpretingGeneticistClinicianId rdf:type rdf:Property ;
    rdfs:label 'Sequencing Interpreting Geneticist Clinician Id' ;
    rdfs:comment 'Identifier of the clinical geneticist or molecular pathologist who interpreted and signed out the sequencing result.' ;
    rdfs:domain ind:SequencingResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:indicationCode rdf:type rdf:Property ;
    rdfs:label 'Indication Code' ;
    rdfs:comment 'ICD-10 diagnosis code representing the clinical indication for ordering the genomic sequencing test.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicationDescription rdf:type rdf:Property ;
    rdfs:label 'Indication Description' ;
    rdfs:comment 'Free-text description of the clinical reason for ordering the sequencing test (e.g., suspected hereditary breast cancer, acute myeloid leukemia).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isReflexTest rdf:type rdf:Property ;
    rdfs:label 'Is Reflex Test' ;
    rdfs:comment 'Indicates whether this sequencing was triggered as a reflex test based on a prior laboratory result (e.g., IHC loss triggering MSI sequencing).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRepeatTest rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Test' ;
    rdfs:comment 'Indicates whether this sequencing was a repeat of a prior test due to quality failure, insufficient specimen, or clinical need for confirmation.' ;
    rdfs:domain ind:SequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:percentBasesAboveThreshold rdf:type rdf:Property ;
    rdfs:label 'Percent Bases Above Threshold' ;
    rdfs:comment 'Percentage of targeted bases that achieved the minimum required coverage depth (typically 20x or 30x), indicating analytical completeness.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportPdfUrl rdf:type rdf:Property ;
    rdfs:label 'Report Pdf Url' ;
    rdfs:comment 'Storage location or URL for the final clinical genomics report document in PDF format.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleAdequacy rdf:type rdf:Property ;
    rdfs:label 'Sample Adequacy' ;
    rdfs:comment 'Assessment of whether the specimen provided sufficient quantity and quality of nucleic acid for reliable sequencing.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryFindingsReported rdf:type rdf:Property ;
    rdfs:label 'Secondary Findings Reported' ;
    rdfs:comment 'Indicates whether ACMG-recommended secondary (incidental) findings were included in the report per patient consent preferences.' ;
    rdfs:domain ind:SequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sequencingResultStatus rdf:type rdf:Property ;
    rdfs:label 'Sequencing Result Status' ;
    rdfs:comment 'Current lifecycle status of the sequencing result within the laboratory workflow.' ;
    rdfs:domain ind:SequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specimenReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Specimen Received Date' ;
    rdfs:comment 'Date the specimen was received by the performing laboratory.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:therapyRecommendation rdf:type rdf:Property ;
    rdfs:label 'Therapy Recommendation' ;
    rdfs:comment 'Summary of targeted therapy or treatment recommendations based on the genomic findings, linking molecular results to precision medicine pathways.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tumorContentPercent rdf:type rdf:Property ;
    rdfs:label 'Tumor Content Percent' ;
    rdfs:comment 'Estimated percentage of tumor cells in the specimen, critical for interpreting variant allele frequencies in oncology sequencing.' ;
    rdfs:domain ind:SequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalAiPopulationHealthCohortId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Cohort Id' ;
    rdfs:comment 'Primary key for clinical_ai_population_health_cohort' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measureSetId rdf:type rdf:Property ;
    rdfs:label 'Measure Set Id' ;
    rdfs:comment 'Reference to the quality measure set (e.g., HEDIS, MIPS, CMS Star Rating) that this cohort supports as a denominator or numerator population.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeasureSet .

ind:clinicalAiPopulationHealthCohortDescription rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Cohort Description' ;
    rdfs:comment 'Detailed narrative description of the cohort\'s clinical purpose, target population characteristics, and intended use in population health programs.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiPopulationHealthCohortStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Cohort Status' ;
    rdfs:comment 'Current lifecycle state of the cohort definition indicating whether it is actively being used for patient identification and outreach.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalDomain rdf:type rdf:Property ;
    rdfs:label 'Clinical Domain' ;
    rdfs:comment 'Primary clinical specialty or disease domain that the cohort addresses. [ENUM-REF-CANDIDATE: cardiology|endocrinology|oncology|pulmonology|nephrology|behavioral_health|neurology|orthopedics|obstetrics|pediatrics — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cohortName rdf:type rdf:Property ;
    rdfs:label 'Cohort Name' ;
    rdfs:comment 'Human-readable name identifying the cohort for clinical and operational use, such as \'Diabetic Patients with HbA1c > 9\' or \'High-Risk Heart Failure Readmission\'.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuousEnrollmentDays rdf:type rdf:Property ;
    rdfs:label 'Continuous Enrollment Days' ;
    rdfs:comment 'Minimum number of days of continuous health plan enrollment required for a patient to be eligible for cohort membership, per quality measure specifications.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataSourceSystems rdf:type rdf:Property ;
    rdfs:label 'Data Source Systems' ;
    rdfs:comment 'Clinical and administrative data systems contributing to cohort criteria evaluation, such as EHR, claims, pharmacy, lab, and HIE data feeds.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedMemberCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Member Count' ;
    rdfs:comment 'Approximate number of patients currently meeting the cohort criteria as of the last refresh, used for resource planning and program capacity management.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exclusionCriteriaLogic rdf:type rdf:Property ;
    rdfs:label 'Exclusion Criteria Logic' ;
    rdfs:comment 'Structured expression or CQL defining the exclusion criteria that remove patients from cohort membership, such as hospice enrollment, terminal diagnosis, or age limits.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionCriteriaLogic rdf:type rdf:Property ;
    rdfs:label 'Inclusion Criteria Logic' ;
    rdfs:comment 'Structured expression or CQL (Clinical Quality Language) defining the inclusion criteria for patient membership in this cohort, including diagnosis codes, lab values, demographics, and utilization patterns.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelConfidenceThreshold rdf:type rdf:Property ;
    rdfs:label 'Model Confidence Threshold' ;
    rdfs:comment 'Minimum confidence score from the AI/ML model output required for a patient to be included in the cohort, ensuring prediction quality meets clinical standards.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nlpCriteriaEnabled rdf:type rdf:Property ;
    rdfs:label 'Nlp Criteria Enabled' ;
    rdfs:comment 'Indicates whether natural language processing of unstructured clinical notes is used as part of the cohort identification criteria.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcomeMeasureDefinition rdf:type rdf:Property ;
    rdfs:label 'Outcome Measure Definition' ;
    rdfs:comment 'Definition of the primary clinical or operational outcome being measured for this cohort, such as readmission rate reduction, HbA1c control, or ED utilization decrease.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerAlignment rdf:type rdf:Property ;
    rdfs:label 'Payer Alignment' ;
    rdfs:comment 'Payer programs or value-based contracts that this cohort aligns with, such as Medicare Advantage Star Ratings, Medicaid managed care, or commercial ACO arrangements.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryProgramReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Program Reference' ;
    rdfs:comment 'Specific regulatory program or mandate requiring this cohort, such as MIPS measure ID, HEDIS measure code, or state reporting requirement identifier.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskModelAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Risk Model Algorithm' ;
    rdfs:comment 'Name or identifier of the AI/ML risk stratification algorithm used to score or segment patients within this cohort, such as Johns Hopkins ACG, HCC, or proprietary models.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScoreThresholdMax rdf:type rdf:Property ;
    rdfs:label 'Risk Score Threshold Max' ;
    rdfs:comment 'Upper bound of the risk score range for cohort inclusion. Null indicates no upper limit (open-ended high-risk capture).' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskScoreThresholdMin rdf:type rdf:Property ;
    rdfs:label 'Risk Score Threshold Min' ;
    rdfs:comment 'Lower bound of the risk score range that qualifies patients for inclusion in this cohort when risk stratification is part of the criteria.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sdohFactorsIncluded rdf:type rdf:Property ;
    rdfs:label 'Sdoh Factors Included' ;
    rdfs:comment 'Social determinants of health factors incorporated into cohort criteria, such as food insecurity, housing instability, transportation barriers, or health literacy levels.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetConditionIcd10Codes rdf:type rdf:Property ;
    rdfs:label 'Target Condition Icd10 Codes' ;
    rdfs:comment 'Comma-separated list of ICD-10-CM diagnosis codes that define the primary clinical conditions targeted by this cohort for disease registry or quality measure purposes.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetMedicationClasses rdf:type rdf:Property ;
    rdfs:label 'Target Medication Classes' ;
    rdfs:comment 'Therapeutic drug classes relevant to the cohort criteria, used to identify patients on specific medication regimens (e.g., insulin, ACE inhibitors, statins).' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetOutcomeValue rdf:type rdf:Property ;
    rdfs:label 'Target Outcome Value' ;
    rdfs:comment 'Quantitative target for the cohort\'s primary outcome measure, such as a target readmission rate of 12% or HbA1c below 8.0.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allowsBiobankStorage rdf:type rdf:Property ;
    rdfs:label 'Allows Biobank Storage' ;
    rdfs:comment 'Indicates whether the patient consents to long-term storage of their biological specimens in a biobank for future genomic studies.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsCommercialUse rdf:type rdf:Property ;
    rdfs:label 'Allows Commercial Use' ;
    rdfs:comment 'Indicates whether the patient consents to their genomic data or specimens being used for commercial product development.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsDataSharing rdf:type rdf:Property ;
    rdfs:label 'Allows Data Sharing' ;
    rdfs:comment 'Indicates whether the patient consents to sharing their genomic data with external institutions, registries, or databases.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsFamilySharing rdf:type rdf:Property ;
    rdfs:label 'Allows Family Sharing' ;
    rdfs:comment 'Indicates whether the patient consents to sharing relevant genomic findings with biological family members who may be at risk.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsRecontact rdf:type rdf:Property ;
    rdfs:label 'Allows Recontact' ;
    rdfs:comment 'Indicates whether the patient consents to being recontacted about incidental or secondary findings from genomic analysis.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsResearchUse rdf:type rdf:Property ;
    rdfs:label 'Allows Research Use' ;
    rdfs:comment 'Indicates whether the patient consents to their genomic data being used for research purposes beyond immediate clinical care.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsSecondaryFindings rdf:type rdf:Property ;
    rdfs:label 'Allows Secondary Findings' ;
    rdfs:comment 'Indicates whether the patient wishes to receive secondary or incidental genomic findings unrelated to the primary test indication.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataDestructionRequested rdf:type rdf:Property ;
    rdfs:label 'Data Destruction Requested' ;
    rdfs:comment 'Indicates whether the patient has requested destruction of their genomic data and specimens upon consent withdrawal.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataUseRestriction rdf:type rdf:Property ;
    rdfs:label 'Data Use Restriction' ;
    rdfs:comment 'Specific restrictions or limitations placed by the patient on how their genomic data may be used, beyond the standard consent scope.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneticCounselingProvided rdf:type rdf:Property ;
    rdfs:label 'Genetic Counseling Provided' ;
    rdfs:comment 'Indicates whether the patient received genetic counseling prior to or as part of the consent process.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genomicConsentStatus rdf:type rdf:Property ;
    rdfs:label 'Genomic Consent Status' ;
    rdfs:comment 'Current lifecycle state of the genomic consent record indicating whether it is currently in force.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ginaProtectionsDisclosed rdf:type rdf:Property ;
    rdfs:label 'Gina Protections Disclosed' ;
    rdfs:comment 'Indicates whether the patient was informed about GINA protections against genetic discrimination in employment and health insurance.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:representativeRelationship rdf:type rdf:Property ;
    rdfs:label 'Representative Relationship' ;
    rdfs:comment 'Relationship of the authorized representative to the patient, establishing legal authority to consent.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signingMethod rdf:type rdf:Property ;
    rdfs:label 'Signing Method' ;
    rdfs:comment 'Method by which the patient or authorized representative executed the consent document.' ;
    rdfs:domain ind:GenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Employee Id' ;
    rdfs:comment 'Reference to the provider (research coordinator or principal investigator) who performed or reviewed the eligibility evaluation.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:eligibilityOverrideProviderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Override Provider Employee Id' ;
    rdfs:comment 'Reference to the principal investigator or authorized provider who approved the eligibility override.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:eligibilityReferringProviderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Referring Provider Employee Id' ;
    rdfs:comment 'Reference to the provider who referred the patient for clinical trial screening, enabling referral pathway analytics.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorEvaluationEligibilityEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Prior Evaluation Eligibility Evaluation Id' ;
    rdfs:comment 'Reference to the previous eligibility evaluation for the same patient-trial combination, enabling longitudinal tracking of re-screening attempts.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EligibilityEvaluation .

ind:protocolVersionId rdf:type rdf:Property ;
    rdfs:label 'Protocol Version Id' ;
    rdfs:comment 'Reference to the specific version of the trial protocol used for this eligibility evaluation, ensuring criteria alignment with the active protocol amendment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProtocolVersion .

ind:clinicalDataCutoffDate rdf:type rdf:Property ;
    rdfs:label 'Clinical Data Cutoff Date' ;
    rdfs:comment 'The date through which clinical data (labs, vitals, imaging) was considered for this eligibility evaluation, establishing the temporal boundary of evidence.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:criteriaNotAssessableCount rdf:type rdf:Property ;
    rdfs:label 'Criteria Not Assessable Count' ;
    rdfs:comment 'Number of eligibility criteria that could not be evaluated due to missing clinical data, pending lab results, or insufficient documentation.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:diseaseStage rdf:type rdf:Property ;
    rdfs:label 'Disease Stage' ;
    rdfs:comment 'The patient\'s disease stage or severity classification relevant to trial eligibility (e.g., cancer staging, NYHA class, GOLD stage), as documented in the clinical record.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityEvaluationStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Evaluation Status' ;
    rdfs:comment 'Current lifecycle status of the eligibility evaluation workflow, tracking progression from initiation through final determination.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationNumber rdf:type rdf:Property ;
    rdfs:label 'Evaluation Number' ;
    rdfs:comment 'Human-readable business identifier for the eligibility evaluation, used for tracking and communication across research coordinators and principal investigators.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationType rdf:type rdf:Property ;
    rdfs:label 'Evaluation Type' ;
    rdfs:comment 'Classification of how the eligibility evaluation was performed: automated (algorithm-driven), manual (clinician review), hybrid (algorithm with clinician override), or re-evaluation (repeat assessment).' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionCriteriaTotalCount rdf:type rdf:Property ;
    rdfs:label 'Exclusion Criteria Total Count' ;
    rdfs:comment 'Total number of exclusion criteria defined in the trial protocol that were evaluated for this patient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exclusionCriteriaTriggeredCount rdf:type rdf:Property ;
    rdfs:label 'Exclusion Criteria Triggered Count' ;
    rdfs:comment 'Number of exclusion criteria that the patient triggers, indicating disqualifying conditions identified during evaluation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inclusionCriteriaMetCount rdf:type rdf:Property ;
    rdfs:label 'Inclusion Criteria Met Count' ;
    rdfs:comment 'Number of inclusion criteria that the patient satisfies for the clinical trial, used to calculate match percentage.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inclusionCriteriaTotalCount rdf:type rdf:Property ;
    rdfs:label 'Inclusion Criteria Total Count' ;
    rdfs:comment 'Total number of inclusion criteria defined in the trial protocol that were evaluated for this patient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ineligibilityNarrative rdf:type rdf:Property ;
    rdfs:label 'Ineligibility Narrative' ;
    rdfs:comment 'Detailed clinical narrative explaining why the patient does not meet eligibility criteria, supporting screen failure documentation and protocol deviation tracking.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ineligibilityReasonCode rdf:type rdf:Property ;
    rdfs:label 'Ineligibility Reason Code' ;
    rdfs:comment 'Coded reason for patient ineligibility when the overall result is ineligible, enabling structured reporting on screen failure reasons. [ENUM-REF-CANDIDATE: age_out_of_range|comorbidity|prior_therapy|lab_abnormal|consent_declined|geographic|capacity_full|other — promote to reference product]' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informedConsentStatus rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Status' ;
    rdfs:comment 'Status of the patient\'s informed consent for trial participation at the time of eligibility evaluation. Consent is a prerequisite for enrollment.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Irb Approval Status' ;
    rdfs:comment 'Status of IRB approval for the trial at the evaluating site, which must be active for patient enrollment to proceed.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingAlgorithmVersion rdf:type rdf:Property ;
    rdfs:label 'Matching Algorithm Version' ;
    rdfs:comment 'Semantic version of the eligibility matching algorithm or decision support tool used for automated evaluation, supporting reproducibility and audit.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallResult rdf:type rdf:Property ;
    rdfs:label 'Overall Result' ;
    rdfs:comment 'The final determination of the patient\'s eligibility for the clinical trial based on evaluation of all inclusion and exclusion criteria.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideIndicator rdf:type rdf:Property ;
    rdfs:label 'Override Indicator' ;
    rdfs:comment 'Indicates whether the principal investigator exercised clinical judgment to override an automated eligibility determination (e.g., waiving a borderline criterion).' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorTreatmentStatus rdf:type rdf:Property ;
    rdfs:label 'Prior Treatment Status' ;
    rdfs:comment 'Classification of the patient\'s treatment history relative to the trial\'s therapeutic area, a common eligibility criterion for oncology and specialty trials.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:randomizationEligible rdf:type rdf:Property ;
    rdfs:label 'Randomization Eligible' ;
    rdfs:comment 'Indicates whether the patient has cleared all eligibility gates and is ready for randomization into the trial, representing the final enrollment readiness state.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reEvaluationIndicator rdf:type rdf:Property ;
    rdfs:label 'Re Evaluation Indicator' ;
    rdfs:comment 'Indicates whether this evaluation is a repeat assessment following a prior evaluation that was indeterminate, expired, or resulted in a protocol amendment.' ;
    rdfs:domain ind:EligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:screeningVisitDate rdf:type rdf:Property ;
    rdfs:label 'Screening Visit Date' ;
    rdfs:comment 'Date of the formal screening visit associated with this eligibility evaluation, if a dedicated visit was scheduled.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:washoutPeriodMet rdf:type rdf:Property ;
    rdfs:label 'Washout Period Met' ;
    rdfs:comment 'Indicates whether the patient has completed the required washout period from prior therapies as specified by the trial protocol.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:precisionMedicineTrialId rdf:type rdf:Property ;
    rdfs:label 'Precision Medicine Trial Id' ;
    rdfs:comment 'Primary key for precision_medicine_trial' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:precisionClinicianId rdf:type rdf:Property ;
    rdfs:label 'Precision Clinician Id' ;
    rdfs:comment 'Reference to the provider who ordered or initiated the precision medicine trial enrollment for the patient.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:precisionPrincipalInvestigatorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Precision Principal Investigator Clinician Id' ;
    rdfs:comment 'Reference to the principal investigator overseeing this precision medicine trial.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:researchProtocolId rdf:type rdf:Property ;
    rdfs:label 'Research Protocol Id' ;
    rdfs:comment 'Reference to the research protocol governing this precision medicine trial.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Protocol .

ind:adverseEventGrade rdf:type rdf:Property ;
    rdfs:label 'Adverse Event Grade' ;
    rdfs:comment 'Highest grade of adverse event experienced by the patient during the trial per CTCAE classification.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicaltrialsGovNctNumber rdf:type rdf:Property ;
    rdfs:label 'Clinicaltrials Gov Nct Number' ;
    rdfs:comment 'National Clinical Trial identifier registered on ClinicalTrials.gov for public disclosure and regulatory compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cohortDesignation rdf:type rdf:Property ;
    rdfs:label 'Cohort Designation' ;
    rdfs:comment 'Identifier for the patient cohort or subgroup within the trial, often based on biomarker or molecular profile.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companionDiagnosticTest rdf:type rdf:Property ;
    rdfs:label 'Companion Diagnostic Test' ;
    rdfs:comment 'Name or identifier of the FDA-approved companion diagnostic test used to determine trial eligibility.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataMonitoringFlag rdf:type rdf:Property ;
    rdfs:label 'Data Monitoring Flag' ;
    rdfs:comment 'Indicates whether this enrollment has been flagged for review by the Data Safety Monitoring Board (DSMB).' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dosageRegimen rdf:type rdf:Property ;
    rdfs:label 'Dosage Regimen' ;
    rdfs:comment 'Prescribed dosage schedule and regimen for the trial intervention as defined by the protocol.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria Met' ;
    rdfs:comment 'Description of the specific inclusion criteria satisfied by the patient for trial enrollment.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informedConsentVersion rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Version' ;
    rdfs:comment 'Version identifier of the informed consent form signed by the patient for this trial enrollment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionName rdf:type rdf:Property ;
    rdfs:label 'Intervention Name' ;
    rdfs:comment 'Name of the precision medicine intervention, drug, or therapy being administered in the trial.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBlinded rdf:type rdf:Property ;
    rdfs:label 'Is Blinded' ;
    rdfs:comment 'Indicates whether the trial enrollment is blinded (single or double-blind) versus open-label.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPlaceboControlled rdf:type rdf:Property ;
    rdfs:label 'Is Placebo Controlled' ;
    rdfs:comment 'Indicates whether the trial includes a placebo control arm.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:molecularProfileSummary rdf:type rdf:Property ;
    rdfs:label 'Molecular Profile Summary' ;
    rdfs:comment 'High-level summary of the patient\'s molecular or genomic profile relevant to trial eligibility and treatment selection.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextVisitDate rdf:type rdf:Property ;
    rdfs:label 'Next Visit Date' ;
    rdfs:comment 'Date of the next scheduled protocol visit for the enrolled patient.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseAssessment rdf:type rdf:Property ;
    rdfs:label 'Response Assessment' ;
    rdfs:comment 'Clinical assessment of patient response to the precision medicine intervention per RECIST or equivalent criteria.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectNumber rdf:type rdf:Property ;
    rdfs:label 'Subject Number' ;
    rdfs:comment 'De-identified subject number assigned to the patient within the trial for regulatory reporting and data management.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetBiomarker rdf:type rdf:Property ;
    rdfs:label 'Target Biomarker' ;
    rdfs:comment 'Primary molecular biomarker or genomic alteration targeted by the trial intervention (e.g., EGFR, BRCA1, PD-L1).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalProtocolVisits rdf:type rdf:Property ;
    rdfs:label 'Total Protocol Visits' ;
    rdfs:comment 'Total number of protocol-required visits completed by the patient to date.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatmentArm rdf:type rdf:Property ;
    rdfs:label 'Treatment Arm' ;
    rdfs:comment 'Name or code of the treatment arm to which the patient was assigned within the trial protocol.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Treatment Start Date' ;
    rdfs:comment 'Date the patient began receiving the precision medicine intervention or therapy.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trialNumber rdf:type rdf:Property ;
    rdfs:label 'Trial Number' ;
    rdfs:comment 'Externally-known business identifier for the precision medicine trial enrollment, used for cross-system tracking and regulatory correspondence.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trialPhase rdf:type rdf:Property ;
    rdfs:label 'Trial Phase' ;
    rdfs:comment 'Phase of the clinical trial per FDA regulatory classification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trialType rdf:type rdf:Property ;
    rdfs:label 'Trial Type' ;
    rdfs:comment 'Classification of the precision medicine trial by therapeutic approach or study design.' ;
    rdfs:domain ind:PrecisionMedicineTrial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCmsMeasureId rdf:type rdf:Property ;
    rdfs:label 'Population Cms Measure Id' ;
    rdfs:comment 'CMS electronic clinical quality measure (eCQM) identifier when this cohort supports Medicare/Medicaid quality reporting.' ;
    rdfs:domain ind:PopulationHealthCohortDefinition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Measure .

ind:populationQualityMeasureId rdf:type rdf:Property ;
    rdfs:label 'Population Quality Measure Id' ;
    rdfs:comment 'Identifier linking this cohort to a specific quality measure (e.g., HEDIS measure ID, CMS eCQM identifier) when the cohort supports quality reporting.' ;
    rdfs:domain ind:PopulationHealthCohortDefinition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Measure .

ind:careGapIdentificationFlag rdf:type rdf:Property ;
    rdfs:label 'Care Gap Identification Flag' ;
    rdfs:comment 'Indicates whether this cohort definition is used to identify patients with care gaps requiring outreach or intervention.' ;
    rdfs:domain ind:PopulationHealthCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criteriaLanguage rdf:type rdf:Property ;
    rdfs:label 'Criteria Language' ;
    rdfs:comment 'The formal language or notation system used to express the inclusion and exclusion criteria logic.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceBasis rdf:type rdf:Property ;
    rdfs:label 'Evidence Basis' ;
    rdfs:comment 'Clinical evidence or guideline reference supporting the cohort criteria (e.g., AHA guidelines, USPSTF recommendations, peer-reviewed literature citations).' ;
    rdfs:domain ind:PopulationHealthCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:labValueCriteria rdf:type rdf:Property ;
    rdfs:label 'Lab Value Criteria' ;
    rdfs:comment 'Laboratory result-based criteria for cohort membership, including LOINC codes, value thresholds, and observation windows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastExecutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Execution Timestamp' ;
    rdfs:comment 'Timestamp of the most recent execution of the cohort criteria logic to refresh patient membership.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:medicationCriteria rdf:type rdf:Property ;
    rdfs:label 'Medication Criteria' ;
    rdfs:comment 'Medication-based criteria for cohort membership, expressed as NDC codes, therapeutic classes, or medication name patterns.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:owningProgramName rdf:type rdf:Property ;
    rdfs:label 'Owning Program Name' ;
    rdfs:comment 'Name of the population health program, quality initiative, or care management program that owns and maintains this cohort definition.' ;
    rdfs:domain ind:PopulationHealthCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationHealthCohortDefinitionDescription rdf:type rdf:Property ;
    rdfs:label 'Population Health Cohort Definition Description' ;
    rdfs:comment 'Detailed narrative describing the clinical or operational purpose of the cohort, target population characteristics, and intended use cases.' ;
    rdfs:domain ind:PopulationHealthCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohFactors rdf:type rdf:Property ;
    rdfs:label 'Sdoh Factors' ;
    rdfs:comment 'Specific SDOH factors considered in cohort criteria such as food insecurity, housing instability, transportation barriers, or health literacy.' ;
    rdfs:domain ind:PopulationHealthCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilizationCriteria rdf:type rdf:Property ;
    rdfs:label 'Utilization Criteria' ;
    rdfs:comment 'Healthcare utilization-based criteria such as ED visit frequency, hospitalization count, or readmission history used for cohort stratification.' ;
    rdfs:domain ind:PopulationHealthCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientEligibilityMatchId rdf:type rdf:Property ;
    rdfs:label 'Patient Eligibility Match Id' ;
    rdfs:comment 'Primary key for patient_eligibility_match' ;
    rdfs:domain ind:PatientEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientReferringProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Patient Referring Provider Clinician Id' ;
    rdfs:comment 'Identifier of the provider who referred the patient for clinical trial screening.' ;
    rdfs:domain ind:PatientEligibilityMatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:ageEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Age Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient\'s age at evaluation falls within the trial\'s age range requirements.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:biomarkerMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Biomarker Match Flag' ;
    rdfs:comment 'Indicates whether the patient\'s biomarker profile matches the trial\'s biomarker-based eligibility requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:distanceToSiteKm rdf:type rdf:Property ;
    rdfs:label 'Distance To Site Km' ;
    rdfs:comment 'Calculated distance in kilometers between the patient\'s residence and the nearest trial site, used for feasibility assessment.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibilityDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Determination Date' ;
    rdfs:comment 'Business date on which the final eligibility determination was made for the patient-trial combination.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentOutcome rdf:type rdf:Property ;
    rdfs:label 'Enrollment Outcome' ;
    rdfs:comment 'Final outcome of the eligibility match in terms of actual trial enrollment.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Genomic Match Flag' ;
    rdfs:comment 'Indicates whether the patient\'s genomic or molecular profiling results satisfy the trial\'s genetic eligibility criteria.' ;
    rdfs:domain ind:PatientEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:labValuesEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Lab Values Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient\'s laboratory test results fall within the acceptable ranges defined by the trial protocol.' ;
    rdfs:domain ind:PatientEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:missingDataElements rdf:type rdf:Property ;
    rdfs:label 'Missing Data Elements' ;
    rdfs:comment 'Comma-separated list of data element categories that were unavailable during evaluation and may affect match accuracy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallEligibilityScore rdf:type rdf:Property ;
    rdfs:label 'Overall Eligibility Score' ;
    rdfs:comment 'Composite numeric score representing the degree of patient match to trial eligibility criteria, expressed as a percentage (0.00 to 100.00).' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientPreferenceMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Preference Match Flag' ;
    rdfs:comment 'Indicates whether the trial aligns with the patient\'s stated preferences regarding treatment type, visit frequency, or travel requirements.' ;
    rdfs:domain ind:PatientEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorTreatmentEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Treatment Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient\'s prior treatment history (lines of therapy, washout periods) satisfies the trial\'s treatment history requirements.' ;
    rdfs:domain ind:PatientEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:randomizationEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Randomization Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient has cleared all screening requirements and is eligible for randomization into the trial.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reEvaluationCount rdf:type rdf:Property ;
    rdfs:label 'Re Evaluation Count' ;
    rdfs:comment 'Number of times this patient-trial eligibility match has been re-evaluated due to protocol amendments or patient condition changes.' ;
    rdfs:domain ind:PatientEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Review Completed Timestamp' ;
    rdfs:comment 'Date and time when a human reviewer completed their assessment of the eligibility match result.' ;
    rdfs:domain ind:PatientEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:screeningFailureReason rdf:type rdf:Property ;
    rdfs:label 'Screening Failure Reason' ;
    rdfs:comment 'Primary reason for screening failure or ineligibility determination, referencing the specific criterion not met.' ;
    rdfs:domain ind:PatientEligibilityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Requested Flag' ;
    rdfs:comment 'Indicates whether a protocol deviation waiver was requested for a criterion the patient does not fully meet.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdohSubdomainId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Subdomain Id' ;
    rdfs:comment 'Primary key for sdoh_subdomain' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sdohMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Mpi Record Id' ;
    rdfs:comment 'Foreign key linking to patient.mpi_record. Business justification: SDOH subdomain records belong to a patient. patient_id exists but has no FK. Adding mpi_record_id FK.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:sdohPatientMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Patient Mpi Record Id' ;
    rdfs:comment 'The patient for whom this SDOH need, referral, or intervention is documented.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:associatedDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Associated Diagnosis Code' ;
    rdfs:comment 'ICD-10-CM diagnosis code for the clinical condition that is exacerbated by or related to this SDOH need (e.g., diabetes complicated by food insecurity).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicBarrierFlag rdf:type rdf:Property ;
    rdfs:label 'Geographic Barrier Flag' ;
    rdfs:comment 'Indicates whether the patient faces geographic barriers (e.g., rural location, food desert, transportation desert) that compound their SDOH needs.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:goalTargetDate rdf:type rdf:Property ;
    rdfs:label 'Goal Target Date' ;
    rdfs:comment 'Target date by which the SDOH-related goal is expected to be achieved.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identifiedByRole rdf:type rdf:Property ;
    rdfs:label 'Identified By Role' ;
    rdfs:comment 'Role of the person who identified or documented the SDOH need during the care process.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionOutcome rdf:type rdf:Property ;
    rdfs:label 'Intervention Outcome' ;
    rdfs:comment 'Outcome of the Community Health Worker intervention indicating whether the social need was successfully addressed.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRecurringNeed rdf:type rdf:Property ;
    rdfs:label 'Is Recurring Need' ;
    rdfs:comment 'Indicates whether this social determinant need is a recurring or chronic issue for the patient, requiring ongoing monitoring and intervention.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Preferred Language Code' ;
    rdfs:comment 'ISO 639 language code for the patient\'s preferred language, used to match with linguistically appropriate community resources.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralClosedDate rdf:type rdf:Property ;
    rdfs:label 'Referral Closed Date' ;
    rdfs:comment 'Date on which the SDOH referral was closed, either through successful service delivery, patient declination, or inability to contact.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referredOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Referred Organization Name' ;
    rdfs:comment 'Name of the community-based organization, social service agency, or resource to which the patient was referred for SDOH need resolution.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningInstrumentCode rdf:type rdf:Property ;
    rdfs:label 'Screening Instrument Code' ;
    rdfs:comment 'Code identifying the validated screening tool used to assess social needs (e.g., PRAPARE, AHC-HRSN, HITS, PHQ-2). Maps to LOINC panel codes.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningScoreRaw rdf:type rdf:Property ;
    rdfs:label 'Screening Score Raw' ;
    rdfs:comment 'Raw numeric score from the validated screening instrument before risk stratification interpretation.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Service Delivery Method' ;
    rdfs:comment 'Method by which the SDOH intervention or service was delivered to the patient.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snomedConditionCode rdf:type rdf:Property ;
    rdfs:label 'Snomed Condition Code' ;
    rdfs:comment 'SNOMED CT concept ID representing the SDOH condition or finding identified during screening.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeToFirstContactDays rdf:type rdf:Property ;
    rdfs:label 'Time To First Contact Days' ;
    rdfs:comment 'Number of days between referral initiation and first contact with the patient by the community-based organization or CHW.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timeToResolutionDays rdf:type rdf:Property ;
    rdfs:label 'Time To Resolution Days' ;
    rdfs:comment 'Number of days from SDOH need identification to resolution or closure, measuring the effectiveness of the intervention pathway.' ;
    rdfs:domain ind:SdohSubdomain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:previousMatchTrialMatchId rdf:type rdf:Property ;
    rdfs:label 'Previous Match Trial Match Id' ;
    rdfs:comment 'Reference to a prior match record if this is a re-evaluation or re-screening of a previously assessed match.' ;
    rdfs:domain ind:TrialMatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrialMatch .

ind:trialClinicianId rdf:type rdf:Property ;
    rdfs:label 'Trial Clinician Id' ;
    rdfs:comment 'Reference to the provider who referred or identified the patient as a potential trial candidate.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:trialPrincipalInvestigatorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Trial Principal Investigator Clinician Id' ;
    rdfs:comment 'Reference to the principal investigator responsible for the clinical trial at the matching site.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:declineReason rdf:type rdf:Property ;
    rdfs:label 'Decline Reason' ;
    rdfs:comment 'Reason provided by the patient for declining participation in the matched clinical trial.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hasExclusionCriteriaTriggered rdf:type rdf:Property ;
    rdfs:label 'Has Exclusion Criteria Triggered' ;
    rdfs:comment 'Indicates whether any exclusion criteria were triggered that would disqualify the patient from enrollment.' ;
    rdfs:domain ind:TrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isInclusionCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Is Inclusion Criteria Met' ;
    rdfs:comment 'Indicates whether all mandatory inclusion criteria were satisfied by the patient.' ;
    rdfs:domain ind:TrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Is Re Screening Required' ;
    rdfs:comment 'Indicates whether the patient requires re-screening due to elapsed time or changed clinical status since initial evaluation.' ;
    rdfs:domain ind:TrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Match Expiration Date' ;
    rdfs:comment 'Date after which this match result is no longer valid due to trial enrollment window closure or clinical status changes.' ;
    rdfs:domain ind:TrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:matchNumber rdf:type rdf:Property ;
    rdfs:label 'Match Number' ;
    rdfs:comment 'Human-readable business identifier for the trial match result, used in clinical research communications and tracking.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchType rdf:type rdf:Property ;
    rdfs:label 'Match Type' ;
    rdfs:comment 'Method by which the patient-trial match was identified: automated algorithm, manual screening, hybrid approach, or direct referral.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachDate rdf:type rdf:Property ;
    rdfs:label 'Outreach Date' ;
    rdfs:comment 'Date when the patient was first contacted about this trial match opportunity.' ;
    rdfs:domain ind:TrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outreachStatus rdf:type rdf:Property ;
    rdfs:label 'Outreach Status' ;
    rdfs:comment 'Status of patient outreach and communication regarding the trial match opportunity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:databricksGovernanceUcTagDefinitions2Id rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Uc Tag Definitions2 Id' ;
    rdfs:comment 'Primary key for uc_tag_definitions' ;
    rdfs:domain ind:DatabricksGovernanceUcTagDefinitions2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catalogName rdf:type rdf:Property ;
    rdfs:label 'Catalog Name' ;
    rdfs:comment 'The Unity Catalog catalog where this tag definition is registered. Supports multi-catalog governance in environments with separate catalogs per domain or environment.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:columnMaskFunction rdf:type rdf:Property ;
    rdfs:label 'Column Mask Function' ;
    rdfs:comment 'Fully qualified name of the Unity Catalog column mask function to apply when this tag is present on a column. Used for dynamic data masking of PHI/PII columns based on user privileges.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deltaTblpropertyKey rdf:type rdf:Property ;
    rdfs:label 'Delta Tblproperty Key' ;
    rdfs:comment 'The Delta TBLPROPERTIES key that this tag maps to when applied to a table. Enables automatic propagation of governance metadata into Delta table properties (e.g., \'delta.deletedFileRetentionDuration\', \'delta.logRetentionDuration\').' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deltaTblpropertyValue rdf:type rdf:Property ;
    rdfs:label 'Delta Tblproperty Value' ;
    rdfs:comment 'The default value to set for the associated Delta TBLPROPERTIES key when this tag is applied. Supports automated governance enforcement through table property configuration.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceDomain rdf:type rdf:Property ;
    rdfs:label 'Governance Domain' ;
    rdfs:comment 'The healthcare data domain this tag definition is primarily associated with (e.g., patient, clinical, billing, pharmacy). Aligns with the 22 enterprise data domains for domain-level governance reporting.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaRelevance rdf:type rdf:Property ;
    rdfs:label 'Hipaa Relevance' ;
    rdfs:comment 'Maps this tag to a HIPAA data protection category, indicating whether the tag is used to identify Protected Health Information (PHI), Personally Identifiable Information (PII), Payment Card Industry (PCI) data, other sensitive data, or is not privacy-related.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isInheritable rdf:type rdf:Property ;
    rdfs:label 'Is Inheritable' ;
    rdfs:comment 'Indicates whether this tag value propagates automatically from parent securables (catalog to schema, schema to table, table to column) in Unity Catalog hierarchy.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSystemManaged rdf:type rdf:Property ;
    rdfs:label 'Is System Managed' ;
    rdfs:comment 'Indicates whether this tag is automatically managed by the platform (true) or manually assigned by data stewards (false). System-managed tags are populated by automated governance pipelines.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liquidClusteringHint rdf:type rdf:Property ;
    rdfs:label 'Liquid Clustering Hint' ;
    rdfs:comment 'Comma-separated list of recommended clustering columns when this tag is applied to a table. Guides Delta liquid clustering configuration for optimal query performance on healthcare workloads (e.g., \'patient_id,encounter_date\').' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metastoreIdentifier rdf:type rdf:Property ;
    rdfs:label 'Metastore Identifier' ;
    rdfs:comment 'Identifier of the Unity Catalog metastore where this tag definition resides. Enables cross-metastore governance coordination in multi-region healthcare deployments.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationOnViolation rdf:type rdf:Property ;
    rdfs:label 'Notification On Violation' ;
    rdfs:comment 'Indicates whether a governance alert should be triggered when an object within scope is missing this required tag or has an invalid tag value.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownerGroup rdf:type rdf:Property ;
    rdfs:label 'Owner Group' ;
    rdfs:comment 'The organizational group or team responsible for maintaining this tag definition (e.g., Data Governance Office, Privacy Office, Security Team, Clinical Informatics). Establishes accountability for tag lifecycle management.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:owningTeam rdf:type rdf:Property ;
    rdfs:label 'Owning Team' ;
    rdfs:comment 'The data governance team or stewardship group responsible for maintaining this tag definition and its allowed values.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propagationPolicy rdf:type rdf:Property ;
    rdfs:label 'Propagation Policy' ;
    rdfs:comment 'Defines how tag values behave when inherited across the Unity Catalog hierarchy. Inherit copies parent value; override allows child to replace; merge combines parent and child values; none prevents propagation.' ;
    rdfs:domain ind:DatabricksGovernanceUcTagDefinitions2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propagationRule rdf:type rdf:Property ;
    rdfs:label 'Propagation Rule' ;
    rdfs:comment 'Defines how this tag propagates through data lineage in Unity Catalog. Downstream propagation ensures derived datasets inherit PHI/PII classifications from source tables.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionDays rdf:type rdf:Property ;
    rdfs:label 'Retention Days' ;
    rdfs:comment 'Default data retention period in days associated with this tag for HIPAA compliance. When applied to a table, signals the minimum retention requirement (e.g., 2555 days for 7-year medical record retention).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retentionPolicyCode rdf:type rdf:Property ;
    rdfs:label 'Retention Policy Code' ;
    rdfs:comment 'Code referencing the applicable HIPAA data retention policy when this tag is applied. Links to organizational retention schedules (e.g., 6-year minimum for PHI under HIPAA).' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rlsPredicateTemplate rdf:type rdf:Property ;
    rdfs:label 'Rls Predicate Template' ;
    rdfs:comment 'Optional SQL predicate template associated with this tag for Row-Level Security enforcement. When this tag is applied to a table, the RLS predicate is activated to filter rows based on user context (e.g., facility access, care team membership).' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagName rdf:type rdf:Property ;
    rdfs:label 'Tag Name' ;
    rdfs:comment 'The unique machine-readable name of the tag as registered in Unity Catalog. Must conform to UC naming rules (lowercase alphanumeric with underscores, max 128 characters).' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagScope rdf:type rdf:Property ;
    rdfs:label 'Tag Scope' ;
    rdfs:comment 'The Unity Catalog securable object level at which this tag can be applied (e.g., catalog, schema, table, column, volume, or registered model).' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ucTagDefinitionsDescription rdf:type rdf:Property ;
    rdfs:label 'Uc Tag Definitions Description' ;
    rdfs:comment 'Detailed business description of the tag\'s purpose, usage guidelines, and governance implications. Displayed to data stewards and analysts when applying or reviewing tags in Unity Catalog.' ;
    rdfs:domain ind:DatabricksGovernanceUcTagDefinitions2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ucTagDefinitionsStatus rdf:type rdf:Property ;
    rdfs:label 'Uc Tag Definitions Status' ;
    rdfs:comment 'Current lifecycle status of the tag definition. Active tags can be applied to securables; deprecated tags are being phased out; draft tags are under review; retired tags are no longer available for new assignments.' ;
    rdfs:domain ind:DatabricksGovernanceUcTagDefinitions2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageGuidance rdf:type rdf:Property ;
    rdfs:label 'Usage Guidance' ;
    rdfs:comment 'Prescriptive instructions for data stewards on when and how to apply this tag, including examples of correct and incorrect usage in the healthcare data context.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueType rdf:type rdf:Property ;
    rdfs:label 'Value Type' ;
    rdfs:comment 'The expected data type for values assigned to this tag, constraining what values are valid when the tag is applied to a securable object.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:databricksGovernanceRlsPredicates2Id rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Rls Predicates2 Id' ;
    rdfs:comment 'Primary key for rls_predicates' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditLogEnabled rdf:type rdf:Property ;
    rdfs:label 'Audit Log Enabled' ;
    rdfs:comment 'Indicates whether access attempts filtered by this predicate are logged to the Unity Catalog audit log for compliance monitoring.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:columnMaskFunctionName rdf:type rdf:Property ;
    rdfs:label 'Column Mask Function Name' ;
    rdfs:comment 'Fully qualified name of the SQL function registered in Unity Catalog that implements column masking logic for sensitive attributes.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataDomain rdf:type rdf:Property ;
    rdfs:label 'Data Domain' ;
    rdfs:comment 'The healthcare data domain this predicate protects (e.g., patient, clinical, billing, pharmacy, laboratory, radiology).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentScope rdf:type rdf:Property ;
    rdfs:label 'Department Scope' ;
    rdfs:comment 'Department-level scope restriction defining which clinical or administrative departments this predicate covers.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityScope rdf:type rdf:Property ;
    rdfs:label 'Facility Scope' ;
    rdfs:comment 'Comma-separated list of facility identifiers or wildcard pattern defining the organizational scope of this predicate (e.g., specific hospitals, clinics, or care sites).' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filterFunctionName rdf:type rdf:Property ;
    rdfs:label 'Filter Function Name' ;
    rdfs:comment 'Fully qualified name of the SQL function registered in Unity Catalog that implements the row filter logic.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaCategory rdf:type rdf:Property ;
    rdfs:label 'Hipaa Category' ;
    rdfs:comment 'HIPAA data classification category that this predicate is designed to protect, aligning with PHI, PII, PCI, or general sensitive data.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaDataCategory rdf:type rdf:Property ;
    rdfs:label 'Hipaa Data Category' ;
    rdfs:comment 'The HIPAA data classification category that this predicate is designed to protect, aligning with organizational data governance policies.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDefaultPredicate rdf:type rdf:Property ;
    rdfs:label 'Is Default Predicate' ;
    rdfs:comment 'Indicates whether this predicate serves as the default row filter when no more specific predicate matches the requesting principal.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:justification rdf:type rdf:Property ;
    rdfs:label 'Justification' ;
    rdfs:comment 'Business rationale documenting why this RLS predicate was created, supporting HIPAA minimum necessary compliance and audit requirements.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predicateName rdf:type rdf:Property ;
    rdfs:label 'Predicate Name' ;
    rdfs:comment 'Human-readable unique name identifying this RLS predicate rule within the Unity Catalog governance framework.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predicateType rdf:type rdf:Property ;
    rdfs:label 'Predicate Type' ;
    rdfs:comment 'Classification of the predicate behavior indicating whether it filters rows, masks column values, redacts PHI, restricts access, or applies conditional logic.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalIdentifier rdf:type rdf:Property ;
    rdfs:label 'Principal Identifier' ;
    rdfs:comment 'The specific user, group name, service principal application ID, or role name that this predicate targets. Supports wildcards for group-based policies.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rlsPredicatesDescription rdf:type rdf:Property ;
    rdfs:label 'Rls Predicates Description' ;
    rdfs:comment 'Business-friendly explanation of what this RLS predicate does, why it exists, and which compliance requirement it satisfies.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rlsPredicatesStatus rdf:type rdf:Property ;
    rdfs:label 'Rls Predicates Status' ;
    rdfs:comment 'Current lifecycle state of the RLS predicate indicating whether it is actively enforced, in draft, pending approval, deprecated, or inactive.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schemaName rdf:type rdf:Property ;
    rdfs:label 'Schema Name' ;
    rdfs:comment 'Name of the schema (database) within the Unity Catalog where the target table resides.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scope rdf:type rdf:Property ;
    rdfs:label 'Scope' ;
    rdfs:comment 'The hierarchical scope at which this predicate is enforced: individual table, entire schema, full catalog, or logical business domain.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePolicyReference rdf:type rdf:Property ;
    rdfs:label 'Source Policy Reference' ;
    rdfs:comment 'Reference to the organizational data governance policy or HIPAA policy document that mandates this row-level security control.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tableName rdf:type rdf:Property ;
    rdfs:label 'Table Name' ;
    rdfs:comment 'Name of the table to which this row-level security predicate is applied for data access filtering.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCatalog rdf:type rdf:Property ;
    rdfs:label 'Target Catalog' ;
    rdfs:comment 'The Databricks Unity Catalog catalog name to which this RLS predicate applies (e.g., healthcare_silver, healthcare_gold).' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetPrincipalName rdf:type rdf:Property ;
    rdfs:label 'Target Principal Name' ;
    rdfs:comment 'Name or identifier of the security principal (user, group, or service principal) that this predicate governs.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetPrincipalType rdf:type rdf:Property ;
    rdfs:label 'Target Principal Type' ;
    rdfs:comment 'Type of security principal (user, group, or service principal) to which this RLS predicate applies.' ;
    rdfs:domain ind:DatabricksGovernanceRlsPredicates2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetSchema rdf:type rdf:Property ;
    rdfs:label 'Target Schema' ;
    rdfs:comment 'The schema (database) within the Unity Catalog catalog to which this RLS predicate is bound.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetTable rdf:type rdf:Property ;
    rdfs:label 'Target Table' ;
    rdfs:comment 'The specific table or view within the target schema to which this RLS predicate is applied for row-level filtering.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unityCatalogTag rdf:type rdf:Property ;
    rdfs:label 'Unity Catalog Tag' ;
    rdfs:comment 'Key-value tag string applied to this predicate within Unity Catalog for governance classification, searchability, and policy grouping (e.g., compliance=hipaa, domain=clinical).' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoCompactEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Compact Enabled' ;
    rdfs:comment 'Indicates whether automatic compaction is enabled to consolidate small files after writes.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:changeDataFeedEnabled rdf:type rdf:Property ;
    rdfs:label 'Change Data Feed Enabled' ;
    rdfs:comment 'Indicates whether Delta Change Data Feed is enabled, allowing downstream consumers to track row-level changes for incremental processing.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:columnMaskingPolicy rdf:type rdf:Property ;
    rdfs:label 'Column Masking Policy' ;
    rdfs:comment 'Name of the column masking policy applied to sensitive columns in this table (e.g., masking SSN, MRN, or other PHI identifiers for non-privileged users).' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containsPhi rdf:type rdf:Property ;
    rdfs:label 'Contains Phi' ;
    rdfs:comment 'Indicates whether this table contains Protected Health Information subject to HIPAA Privacy and Security Rules.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:containsPii rdf:type rdf:Property ;
    rdfs:label 'Contains Pii' ;
    rdfs:comment 'Indicates whether this table contains Personally Identifiable Information requiring privacy protections.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataOwner rdf:type rdf:Property ;
    rdfs:label 'Data Owner' ;
    rdfs:comment 'Business data owner responsible for the table content, quality, and access authorization decisions.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSteward rdf:type rdf:Property ;
    rdfs:label 'Data Steward' ;
    rdfs:comment 'Technical data steward responsible for day-to-day data quality monitoring and issue resolution for this table.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deletedFileRetentionDuration rdf:type rdf:Property ;
    rdfs:label 'Deleted File Retention Duration' ;
    rdfs:comment 'Duration for which deleted data files are retained before VACUUM can remove them. Must align with HIPAA retention requirements for PHI tables.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAppliedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Applied Timestamp' ;
    rdfs:comment 'Timestamp when this property was last successfully applied to the Delta table via ALTER TABLE SET TBLPROPERTIES.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:liquidClusteringColumns rdf:type rdf:Property ;
    rdfs:label 'Liquid Clustering Columns' ;
    rdfs:comment 'Comma-separated list of column names used for liquid clustering on this table (e.g., \'patient_id,encounter_date\').' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidClusteringEnabled rdf:type rdf:Property ;
    rdfs:label 'Liquid Clustering Enabled' ;
    rdfs:comment 'Indicates whether Databricks liquid clustering is enabled for this table, replacing traditional partitioning and ZORDER for improved query performance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:logRetentionDuration rdf:type rdf:Property ;
    rdfs:label 'Log Retention Duration' ;
    rdfs:comment 'Duration for which Delta transaction log entries are retained (e.g., \'interval 30 days\'). Controls time-travel capability window.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minReaderVersion rdf:type rdf:Property ;
    rdfs:label 'Min Reader Version' ;
    rdfs:comment 'Minimum Delta Lake reader protocol version required to read this table. Higher versions enable features like column mapping and deletion vectors.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minWriterVersion rdf:type rdf:Property ;
    rdfs:label 'Min Writer Version' ;
    rdfs:comment 'Minimum Delta Lake writer protocol version required to write to this table. Higher versions enable features like change data feed and generated columns.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:propertyCategory rdf:type rdf:Property ;
    rdfs:label 'Property Category' ;
    rdfs:comment 'Classification of the property by governance function: retention for data lifecycle, versioning for protocol versions, optimization for performance tuning, security for access controls, compliance for regulatory settings, clustering for liquid clustering configuration.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionPolicyName rdf:type rdf:Property ;
    rdfs:label 'Retention Policy Name' ;
    rdfs:comment 'Name of the organizational data retention policy governing this table (e.g., \'HIPAA_6_Year\', \'CMS_10_Year\', \'Operational_3_Year\').' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rlsPredicateFunction rdf:type rdf:Property ;
    rdfs:label 'Rls Predicate Function' ;
    rdfs:comment 'Name or expression of the row-level security predicate function applied to this table for fine-grained access control based on user attributes (e.g., restricting PHI access by care team membership).' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetFileSizeMb rdf:type rdf:Property ;
    rdfs:label 'Target File Size Mb' ;
    rdfs:comment 'Target file size in megabytes for OPTIMIZE operations, balancing read performance with write amplification.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unityCatalogTagJson rdf:type rdf:Property ;
    rdfs:label 'Unity Catalog Tag Json' ;
    rdfs:comment 'JSON string containing Unity Catalog key-value tags applied to this table for governance classification, lineage tracking, and discovery (e.g., domain, data_owner, sensitivity_level).' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vacuumFrequencyHours rdf:type rdf:Property ;
    rdfs:label 'Vacuum Frequency Hours' ;
    rdfs:comment 'Recommended frequency in hours for running VACUUM operations on this table to reclaim storage while respecting retention requirements.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annotationCode rdf:type rdf:Property ;
    rdfs:label 'Annotation Code' ;
    rdfs:comment 'Unique business code identifying this retention annotation rule, used as a Unity Catalog tag key for Delta tables.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annotationDescription rdf:type rdf:Property ;
    rdfs:label 'Annotation Description' ;
    rdfs:comment 'Detailed explanation of the retention annotation\'s purpose, scope, and applicability to PHI data assets within the Databricks lakehouse.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annotationName rdf:type rdf:Property ;
    rdfs:label 'Annotation Name' ;
    rdfs:comment 'Human-readable name of the HIPAA retention annotation, displayed in Unity Catalog governance dashboards and compliance reports.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableDomain rdf:type rdf:Property ;
    rdfs:label 'Applicable Domain' ;
    rdfs:comment 'The healthcare data domain(s) this retention annotation targets (e.g., patient, clinical, billing, pharmacy, radiology, laboratory). Supports comma-separated multi-domain assignment.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableRecordType rdf:type rdf:Property ;
    rdfs:label 'Applicable Record Type' ;
    rdfs:comment 'The type of health record this annotation applies to (e.g., medical record, billing record, consent form, radiology image, lab result, prescription).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToMinors rdf:type rdf:Property ;
    rdfs:label 'Applies To Minors' ;
    rdfs:comment 'Indicates whether this retention annotation includes extended retention rules for records of minor patients, which often require retention until age of majority plus standard period.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disposalAction rdf:type rdf:Property ;
    rdfs:label 'Disposal Action' ;
    rdfs:comment 'The action to be taken when the retention period expires: physical deletion, anonymization, archival to cold storage, pseudonymization, or encrypted archival.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Disposal Verification Required' ;
    rdfs:comment 'Indicates whether disposal of data under this annotation requires formal verification and sign-off by a compliance officer or privacy officer.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Exception Approval Required' ;
    rdfs:comment 'Indicates whether any deviation from this retention annotation (early disposal or extended retention) requires formal approval from the Privacy Officer or compliance committee.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaRetentionAnnotationsStatus rdf:type rdf:Property ;
    rdfs:label 'Hipaa Retention Annotations Status' ;
    rdfs:comment 'Current lifecycle status of this retention annotation definition within the governance framework.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalHoldOverride rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Override' ;
    rdfs:comment 'Indicates whether this annotation can be overridden by a legal hold, suspending the retention clock during litigation or regulatory investigation.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liquidClusteringRecommendation rdf:type rdf:Property ;
    rdfs:label 'Liquid Clustering Recommendation' ;
    rdfs:comment 'Recommended liquid clustering columns for Delta tables under this retention annotation, optimizing query performance for compliance audit and retention lifecycle queries.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDaysBeforeExpiry rdf:type rdf:Property ;
    rdfs:label 'Notification Days Before Expiry' ;
    rdfs:comment 'Number of days before retention period expiration that automated notifications are sent to data stewards and compliance officers for review.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retentionStartEvent rdf:type rdf:Property ;
    rdfs:label 'Retention Start Event' ;
    rdfs:comment 'The business event that triggers the start of the retention clock (e.g., date of last encounter, date of patient death, date of record creation, date of discharge).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersedesAnnotationCode rdf:type rdf:Property ;
    rdfs:label 'Supersedes Annotation Code' ;
    rdfs:comment 'The annotation_code of the previous version that this annotation supersedes, enabling traceability of retention policy evolution.' ;
    rdfs:domain ind:HipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unityCatalogTagKey rdf:type rdf:Property ;
    rdfs:label 'Unity Catalog Tag Key' ;
    rdfs:comment 'The exact tag key name applied to Delta tables and columns in Databricks Unity Catalog to enforce this retention annotation programmatically.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unityCatalogTagValue rdf:type rdf:Property ;
    rdfs:label 'Unity Catalog Tag Value' ;
    rdfs:comment 'The tag value assigned in Unity Catalog when this retention annotation is applied (e.g., \'6_years\', \'10_years_from_last_encounter\').' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalAiCohortMembershipId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Cohort Membership Id' ;
    rdfs:comment 'Primary key for clinical_ai_cohort_membership' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalOverrideProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Clinical Override Provider Clinician Id' ;
    rdfs:comment 'Identifier of the provider who performed the manual override of the AI-generated cohort membership decision.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:cohortClinicalAiCohortDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Cohort Clinical Ai Cohort Definition Id' ;
    rdfs:comment 'Foreign key linking to clinical_ai.clinical_ai_cohort_definition. Business justification: clinical_ai_cohort_membership has a cohort_id BIGINT column with no FK. This links membership records to their cohort definition. A membership record belongs to exactly one cohort definition.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalAiCohortDefinition .

ind:cohortEntryEventType rdf:type rdf:Property ;
    rdfs:label 'Cohort Entry Event Type' ;
    rdfs:comment 'Type of clinical event that triggered cohort entry, such as diagnosis, lab result, admission, or risk score change.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criteriaMatchCount rdf:type rdf:Property ;
    rdfs:label 'Criteria Match Count' ;
    rdfs:comment 'Number of cohort inclusion criteria that the patient currently satisfies, used to assess strength of cohort fit.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:criteriaTotalCount rdf:type rdf:Property ;
    rdfs:label 'Criteria Total Count' ;
    rdfs:comment 'Total number of inclusion criteria defined for the cohort at the time of the patient\'s enrollment or last evaluation.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:effectiveEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective End Timestamp' ;
    rdfs:comment 'Timestamp marking when this cohort membership record ceased to be the current version. Null for the current active record. Supports SCD Type 2 historization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectiveStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Start Timestamp' ;
    rdfs:comment 'Timestamp marking when this cohort membership record became effective, supporting SCD Type 2 historization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:evaluationFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Evaluation Frequency Days' ;
    rdfs:comment 'Number of days between scheduled re-evaluations of the patient\'s cohort membership eligibility.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inclusionScoreThreshold rdf:type rdf:Property ;
    rdfs:label 'Inclusion Score Threshold' ;
    rdfs:comment 'The minimum score threshold that was applied at the time of enrollment to determine cohort eligibility.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interventionEligible rdf:type rdf:Property ;
    rdfs:label 'Intervention Eligible' ;
    rdfs:comment 'Indicates whether the patient is currently eligible for clinical interventions associated with this cohort.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isConsentObtained rdf:type rdf:Property ;
    rdfs:label 'Is Consent Obtained' ;
    rdfs:comment 'Indicates whether patient consent has been obtained for inclusion in this AI-driven cohort, as required by institutional policy and applicable regulations.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isManuallyOverridden rdf:type rdf:Property ;
    rdfs:label 'Is Manually Overridden' ;
    rdfs:comment 'Indicates whether a clinician or administrator manually overrode the AI-generated cohort membership decision.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:membershipType rdf:type rdf:Property ;
    rdfs:label 'Membership Type' ;
    rdfs:comment 'Classification of the patient\'s role within the cohort, distinguishing between primary study/intervention members, control group members, and comparison populations.' ;
    rdfs:domain ind:ClinicalAiCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trialEligibilityId rdf:type rdf:Property ;
    rdfs:label 'Trial Eligibility Id' ;
    rdfs:comment 'Primary key for trial_eligibility' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrialEligibility .

ind:priorEvaluationTrialEligibilityId rdf:type rdf:Property ;
    rdfs:label 'Prior Evaluation Trial Eligibility Id' ;
    rdfs:comment 'Reference to a previous eligibility evaluation for the same patient-trial combination, used for rescreening tracking.' ;
    rdfs:domain ind:TrialEligibility ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrialEligibility .

ind:ageEligible rdf:type rdf:Property ;
    rdfs:label 'Age Eligible' ;
    rdfs:comment 'Indicates whether the patient\'s age falls within the trial\'s specified age range at the time of evaluation.' ;
    rdfs:domain ind:TrialEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibilityScore rdf:type rdf:Property ;
    rdfs:label 'Eligibility Score' ;
    rdfs:comment 'Composite numeric score representing the degree of patient match to trial criteria, typically expressed as a percentage (0.00 to 100.00).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ineligibilityReason rdf:type rdf:Property ;
    rdfs:label 'Ineligibility Reason' ;
    rdfs:comment 'Primary reason the patient was determined ineligible, referencing the specific criterion or clinical condition that disqualified them.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:labCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Lab Criteria Met' ;
    rdfs:comment 'Indicates whether the patient meets all laboratory value requirements specified in the trial eligibility criteria.' ;
    rdfs:domain ind:TrialEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rescreeningIndicator rdf:type rdf:Property ;
    rdfs:label 'Rescreening Indicator' ;
    rdfs:comment 'Indicates whether this evaluation is a rescreening attempt after a prior screen failure for the same trial.' ;
    rdfs:domain ind:TrialEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverApproved rdf:type rdf:Property ;
    rdfs:label 'Waiver Approved' ;
    rdfs:comment 'Indicates whether the eligibility waiver was approved by the sponsor or principal investigator.' ;
    rdfs:domain ind:TrialEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverRequested rdf:type rdf:Property ;
    rdfs:label 'Waiver Requested' ;
    rdfs:comment 'Indicates whether a protocol deviation waiver was requested to enroll the patient despite not meeting all criteria.' ;
    rdfs:domain ind:TrialEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acceptsHealthyVolunteers rdf:type rdf:Property ;
    rdfs:label 'Accepts Healthy Volunteers' ;
    rdfs:comment 'Indicates whether the trial accepts participants without the condition being studied.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acronym rdf:type rdf:Property ;
    rdfs:label 'Acronym' ;
    rdfs:comment 'Short acronym or abbreviation commonly used to refer to the trial in clinical communications.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:briefTitle rdf:type rdf:Property ;
    rdfs:label 'Brief Title' ;
    rdfs:comment 'Short descriptive title of the trial used for display and quick reference in matching interfaces.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionStudied rdf:type rdf:Property ;
    rdfs:label 'Condition Studied' ;
    rdfs:comment 'Primary disease, disorder, or condition that the trial is investigating, expressed as a clinical term.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleSex rdf:type rdf:Property ;
    rdfs:label 'Eligible Sex' ;
    rdfs:comment 'Sex-based eligibility criterion for the trial, used in patient matching filters.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Estimated Duration Months' ;
    rdfs:comment 'Estimated total duration of the trial from first enrollment to study completion, in months.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fdaRegulatedDevice rdf:type rdf:Property ;
    rdfs:label 'Fda Regulated Device' ;
    rdfs:comment 'Indicates whether the trial involves a medical device regulated by the FDA.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fdaRegulatedDrug rdf:type rdf:Property ;
    rdfs:label 'Fda Regulated Drug' ;
    rdfs:comment 'Indicates whether the trial involves a drug product regulated by the FDA.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:firstPostedDate rdf:type rdf:Property ;
    rdfs:label 'First Posted Date' ;
    rdfs:comment 'Date the trial record was first made publicly available on ClinicalTrials.gov.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hasDataMonitoringCommittee rdf:type rdf:Property ;
    rdfs:label 'Has Data Monitoring Committee' ;
    rdfs:comment 'Indicates whether an independent data monitoring committee oversees the trial for safety.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isActivelyMatching rdf:type rdf:Property ;
    rdfs:label 'Is Actively Matching' ;
    rdfs:comment 'Indicates whether the trial is currently enabled in the patient matching engine for automated screening.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMultiCenter rdf:type rdf:Property ;
    rdfs:label 'Is Multi Center' ;
    rdfs:comment 'Indicates whether the trial is conducted at more than one clinical site.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUpdatePostedDate rdf:type rdf:Property ;
    rdfs:label 'Last Update Posted Date' ;
    rdfs:comment 'Date of the most recent update to the trial record on the public registry.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maskingType rdf:type rdf:Property ;
    rdfs:label 'Masking Type' ;
    rdfs:comment 'Level of blinding applied in the trial to reduce bias in outcome assessment.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingPriorityScore rdf:type rdf:Property ;
    rdfs:label 'Matching Priority Score' ;
    rdfs:comment 'Institutional priority score assigned to the trial for patient matching algorithms, reflecting strategic importance and enrollment urgency.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumAgeYears rdf:type rdf:Property ;
    rdfs:label 'Maximum Age Years' ;
    rdfs:comment 'Maximum age in years for participant eligibility, critical for patient matching algorithms.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumAgeYears rdf:type rdf:Property ;
    rdfs:label 'Minimum Age Years' ;
    rdfs:comment 'Minimum age in years for participant eligibility, critical for patient matching algorithms.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfArms rdf:type rdf:Property ;
    rdfs:label 'Number Of Arms' ;
    rdfs:comment 'Count of distinct intervention groups or arms defined in the trial protocol.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfSites rdf:type rdf:Property ;
    rdfs:label 'Number Of Sites' ;
    rdfs:comment 'Total count of participating clinical sites or facilities conducting the trial.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Primary Completion Date' ;
    rdfs:comment 'Date on which the last participant was examined or received intervention for primary outcome measurement.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryPurpose rdf:type rdf:Property ;
    rdfs:label 'Primary Purpose' ;
    rdfs:comment 'Main objective of the trial intervention in relation to the condition being studied.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordCreatedAt rdf:type rdf:Property ;
    rdfs:label 'Record Created At' ;
    rdfs:comment 'Timestamp when this trial record was first created in the clinical trial matching platform.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedAt rdf:type rdf:Property ;
    rdfs:label 'Record Updated At' ;
    rdfs:comment 'Timestamp of the most recent modification to this trial record in the platform.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resultsAvailable rdf:type rdf:Property ;
    rdfs:label 'Results Available' ;
    rdfs:comment 'Indicates whether trial results have been posted to the public registry.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studyCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Study Completion Date' ;
    rdfs:comment 'Date on which the final participant completed the last visit or all data collection concluded.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trialStatus rdf:type rdf:Property ;
    rdfs:label 'Trial Status' ;
    rdfs:comment 'Current recruitment and operational status of the clinical trial per ClinicalTrials.gov definitions.' ;
    rdfs:domain ind:Trial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientEligibilityEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Patient Eligibility Evaluation Id' ;
    rdfs:comment 'Primary key for patient_eligibility_evaluation' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientWaiverApprovedByProviderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Patient Waiver Approved By Provider Employee Id' ;
    rdfs:comment 'Identifier of the principal investigator or authorized delegate who approved the criterion waiver.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:previousEvaluationPatientEligibilityEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Previous Evaluation Patient Eligibility Evaluation Id' ;
    rdfs:comment 'Reference to the prior version of this evaluation, enabling audit trail of eligibility re-assessments over time.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PatientEligibilityEvaluation .

ind:criterionOperator rdf:type rdf:Property ;
    rdfs:label 'Criterion Operator' ;
    rdfs:comment 'Logical operator used to compare the patient value against the criterion threshold (e.g., equals, greater_than, between, contains).' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criterionThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Criterion Threshold Value' ;
    rdfs:comment 'The threshold or target value defined by the trial protocol for this criterion (e.g., >=18, <7.0, present). Stored as string to accommodate ranges and operators.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataCompletenessFlag rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Flag' ;
    rdfs:comment 'Indicates whether sufficient clinical data was available to perform a definitive evaluation: complete, partial (some data gaps), or missing (criterion could not be evaluated).' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationNotes rdf:type rdf:Property ;
    rdfs:label 'Evaluation Notes' ;
    rdfs:comment 'Free-text clinical notes or observations recorded by the evaluator during the eligibility assessment process.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationVersion rdf:type rdf:Property ;
    rdfs:label 'Evaluation Version' ;
    rdfs:comment 'Version number of this evaluation, incremented when the evaluation is re-performed due to updated patient data or protocol amendments.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hipaaAuthorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Status' ;
    rdfs:comment 'Status of HIPAA authorization for using the patient\'s PHI in this research eligibility evaluation.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLatestEvaluation rdf:type rdf:Property ;
    rdfs:label 'Is Latest Evaluation' ;
    rdfs:comment 'Indicates whether this is the most current evaluation for this patient-criterion combination, supporting SCD Type 2 history tracking.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isProtocolDeviationAllowed rdf:type rdf:Property ;
    rdfs:label 'Is Protocol Deviation Allowed' ;
    rdfs:comment 'Indicates whether a protocol deviation or waiver is permitted for this criterion per the principal investigator\'s discretion and IRB approval.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchingDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Matching Diagnosis Code' ;
    rdfs:comment 'ICD-10 diagnosis code from the patient record that matched or was evaluated against the trial criterion, when the criterion is diagnosis-based.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingLoincCode rdf:type rdf:Property ;
    rdfs:label 'Matching Loinc Code' ;
    rdfs:comment 'LOINC code identifying the laboratory test or clinical observation used to evaluate this criterion.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingMedicationCode rdf:type rdf:Property ;
    rdfs:label 'Matching Medication Code' ;
    rdfs:comment 'NDC code of the medication from the patient record evaluated against the trial criterion, when the criterion is medication-based.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:missingDataDescription rdf:type rdf:Property ;
    rdfs:label 'Missing Data Description' ;
    rdfs:comment 'Description of what clinical data is missing or incomplete that prevents a definitive eligibility determination for this criterion.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideComment rdf:type rdf:Property ;
    rdfs:label 'Override Comment' ;
    rdfs:comment 'Free-text clinical justification provided when a provider manually overrides the automated eligibility determination.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientValue rdf:type rdf:Property ;
    rdfs:label 'Patient Value' ;
    rdfs:comment 'The actual clinical value observed for the patient relevant to this criterion (e.g., lab result value, age, diagnosis code). Stored as string for heterogeneous data types.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientValueNumeric rdf:type rdf:Property ;
    rdfs:label 'Patient Value Numeric' ;
    rdfs:comment 'Numeric representation of the patient\'s clinical value when the criterion involves a quantitative measurement (e.g., hemoglobin level, BMI, age).' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientValueUnit rdf:type rdf:Property ;
    rdfs:label 'Patient Value Unit' ;
    rdfs:comment 'Unit of measure for the patient\'s numeric value (e.g., mg/dL, kg/m2, years). Uses UCUM coding system where applicable.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rescreeningDueDate rdf:type rdf:Property ;
    rdfs:label 'Rescreening Due Date' ;
    rdfs:comment 'Date by which rescreening must be completed if the evaluation result has expired or requires re-confirmation per protocol timelines.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rescreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Rescreening Required' ;
    rdfs:comment 'Indicates whether the patient needs to be rescreened for this criterion due to data staleness, protocol amendment, or indeterminate result.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultIndicator rdf:type rdf:Property ;
    rdfs:label 'Result Indicator' ;
    rdfs:comment 'Outcome of the evaluation for this specific criterion: met (patient satisfies), not_met (patient does not satisfy), indeterminate (insufficient data), pending_data, or waived (PI discretion).' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningWindowEndDate rdf:type rdf:Property ;
    rdfs:label 'Screening Window End Date' ;
    rdfs:comment 'End date of the protocol-defined screening window after which this evaluation expires and rescreening is required.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningWindowStartDate rdf:type rdf:Property ;
    rdfs:label 'Screening Window Start Date' ;
    rdfs:comment 'Start date of the protocol-defined screening window during which this evaluation is valid.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceDataDate rdf:type rdf:Property ;
    rdfs:label 'Source Data Date' ;
    rdfs:comment 'Date when the patient clinical data used for this evaluation was originally recorded, indicating data freshness.' ;
    rdfs:domain ind:PatientEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:controlCode rdf:type rdf:Property ;
    rdfs:label 'Control Code' ;
    rdfs:comment 'Unique business code for referencing this control in policies and audit trails (e.g., \'RLS-001\', \'RET-042\').' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlName rdf:type rdf:Property ;
    rdfs:label 'Control Name' ;
    rdfs:comment 'Human-readable name of the governance control definition (e.g., \'PHI Column Masking\', \'HIPAA 6-Year Retention\').' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlStatus rdf:type rdf:Property ;
    rdfs:label 'Control Status' ;
    rdfs:comment 'Current lifecycle status of this governance control definition.' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deltaTblpropertiesJson rdf:type rdf:Property ;
    rdfs:label 'Delta Tblproperties Json' ;
    rdfs:comment 'JSON object containing Delta Lake TBLPROPERTIES key-value pairs to apply (e.g., {\'delta.deletedFileRetentionDuration\': \'interval 180 days\', \'delta.logRetentionDuration\': \'interval 2190 days\'}).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domainScope rdf:type rdf:Property ;
    rdfs:label 'Domain Scope' ;
    rdfs:comment 'The healthcare data domain(s) this control applies to (e.g., \'patient\', \'clinical\', \'billing\'). Supports comma-separated values for cross-domain controls.' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionPolicyReference rdf:type rdf:Property ;
    rdfs:label 'Retention Policy Reference' ;
    rdfs:comment 'Citation to the specific regulatory or organizational retention policy governing this control (e.g., \'HIPAA 45 CFR 164.530(j)\', \'State of CA H&S Code 123145\').' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rlsFilterFunction rdf:type rdf:Property ;
    rdfs:label 'Rls Filter Function' ;
    rdfs:comment 'Fully qualified name of the SQL function implementing the RLS filter logic, registered in Unity Catalog.' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scdTrackingColumns rdf:type rdf:Property ;
    rdfs:label 'Scd Tracking Columns' ;
    rdfs:comment 'Comma-separated list of columns monitored for changes that trigger SCD Type 2 versioning (e.g., \'status, address, insurance_plan_id\').' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagAllowedValues rdf:type rdf:Property ;
    rdfs:label 'Tag Allowed Values' ;
    rdfs:comment 'Pipe-delimited list of permitted values for the Unity Catalog tag (e.g., \'restricted|confidential|internal|public\'). Empty for free-text tags.' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagKey rdf:type rdf:Property ;
    rdfs:label 'Tag Key' ;
    rdfs:comment 'The key portion of a Unity Catalog tag definition (e.g., \'phi_classification\', \'data_owner\', \'retention_days\'). Applicable when control_type is \'uc_tag\'.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetObjectPattern rdf:type rdf:Property ;
    rdfs:label 'Target Object Pattern' ;
    rdfs:comment 'Regex or glob pattern identifying the tables, views, or columns this control targets (e.g., \'*.patient.*\', \'clinical.note_*\').' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:universalControlsDescription rdf:type rdf:Property ;
    rdfs:label 'Universal Controls Description' ;
    rdfs:comment 'Detailed narrative explaining the purpose, scope, and business rationale for this governance control.' ;
    rdfs:domain ind:UniversalControls ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralSdohReferralManagementId rdf:type rdf:Property ;
    rdfs:label 'Referral Sdoh Referral Management Id' ;
    rdfs:comment 'Foreign key linking to patient.sdoh_referral_management. Business justification: SDOH need closure has referral_id (BIGINT) linking to the SDOH referral that initiated the need. Connecting to sdoh_referral_management.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SdohReferralManagement .

ind:barrierToResolution rdf:type rdf:Property ;
    rdfs:label 'Barrier To Resolution' ;
    rdfs:comment 'Primary barrier encountered during the intervention process that impeded or delayed need resolution (e.g., language barrier, lack of transportation to services).' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cboName rdf:type rdf:Property ;
    rdfs:label 'Cbo Name' ;
    rdfs:comment 'Name of the community-based organization that provided services leading to need closure.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysToClosure rdf:type rdf:Property ;
    rdfs:label 'Days To Closure' ;
    rdfs:comment 'Number of calendar days between the initial SDOH need identification and formal closure, used for operational performance tracking.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:externalReferralTrackingNumber rdf:type rdf:Property ;
    rdfs:label 'External Referral Tracking Number' ;
    rdfs:comment 'Tracking number assigned by the external community-based organization or referral platform for cross-system reconciliation.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalAchievementStatus rdf:type rdf:Property ;
    rdfs:label 'Goal Achievement Status' ;
    rdfs:comment 'Status indicating whether the care plan goal associated with this SDOH need was achieved at the time of closure.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionId rdf:type rdf:Property ;
    rdfs:label 'Intervention Id' ;
    rdfs:comment 'Identifier of the community health worker intervention that contributed to need closure.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isEquityFlagged rdf:type rdf:Property ;
    rdfs:label 'Is Equity Flagged' ;
    rdfs:comment 'Indicates whether this closure is flagged for health equity analysis, identifying disparities in SDOH need resolution across populations.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPatientConsentObtained rdf:type rdf:Property ;
    rdfs:label 'Is Patient Consent Obtained' ;
    rdfs:comment 'Indicates whether patient consent was obtained for sharing SDOH information with community organizations during the closure process.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientReportedOutcome rdf:type rdf:Property ;
    rdfs:label 'Patient Reported Outcome' ;
    rdfs:comment 'Patient\'s self-reported assessment of whether their social need has improved following intervention, captured during follow-up.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceCount rdf:type rdf:Property ;
    rdfs:label 'Recurrence Count' ;
    rdfs:comment 'Number of times this same category of SDOH need has been identified for the patient, supporting risk stratification.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskLevelAtClosure rdf:type rdf:Property ;
    rdfs:label 'Risk Level At Closure' ;
    rdfs:comment 'Patient\'s SDOH risk stratification level at the time of need closure, indicating residual social vulnerability.' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceDelivered rdf:type rdf:Property ;
    rdfs:label 'Service Delivered' ;
    rdfs:comment 'Description of the specific service or resource delivered to the patient that addressed the identified social need (e.g., food pantry enrollment, housing voucher).' ;
    rdfs:domain ind:SdohNeedClosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohZcodeMappingId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Zcode Mapping Id' ;
    rdfs:comment 'Primary key for sdoh_zcode_mapping' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageApplicability rdf:type rdf:Property ;
    rdfs:label 'Age Applicability' ;
    rdfs:comment 'The patient age range for which this Z-code is clinically applicable (e.g., pediatric, adult, all ages), supporting clinical decision support and coding validation edits.' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ahcDomain rdf:type rdf:Property ;
    rdfs:label 'Ahc Domain' ;
    rdfs:comment 'The CMS Accountable Health Communities model domain classification for this Z-code, aligning with the five core AHC screening domains for health-related social needs.' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billableCodeFlag rdf:type rdf:Property ;
    rdfs:label 'Billable Code Flag' ;
    rdfs:comment 'Indicates whether this Z-code is a valid billable diagnosis code that can be submitted on claims (UB-04 or CMS-1500) as a primary or secondary diagnosis.' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:codeCategoryRange rdf:type rdf:Property ;
    rdfs:label 'Code Category Range' ;
    rdfs:comment 'The ICD-10-CM chapter/block range this Z-code belongs to (e.g., Z55-Z65 for persons with potential health hazards related to socioeconomic and psychosocial circumstances).' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeSpecificityLevel rdf:type rdf:Property ;
    rdfs:label 'Code Specificity Level' ;
    rdfs:comment 'The level of specificity of the Z-code: category (3-character), subcategory (4-5 character), or full_code (maximum specificity required for claims).' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codingGuidelineReference rdf:type rdf:Property ;
    rdfs:label 'Coding Guideline Reference' ;
    rdfs:comment 'Reference to the specific ICD-10-CM Official Coding Guideline section applicable to this Z-code (e.g., Section I.C.21 for factors influencing health status).' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYearIntroduced rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year Introduced' ;
    rdfs:comment 'The CMS fiscal year in which this Z-code was first introduced into the ICD-10-CM code set (e.g., FY2022), supporting version tracking and historical analysis.' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderApplicability rdf:type rdf:Property ;
    rdfs:label 'Gender Applicability' ;
    rdfs:comment 'The patient gender for which this Z-code is applicable, used in coding validation edits to prevent inappropriate code assignment.' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthyPeople2030Objective rdf:type rdf:Property ;
    rdfs:label 'Healthy People 2030 Objective' ;
    rdfs:comment 'The corresponding Healthy People 2030 objective identifier that this SDOH Z-code aligns with, supporting national health improvement priority tracking.' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationHealthPriority rdf:type rdf:Property ;
    rdfs:label 'Population Health Priority' ;
    rdfs:comment 'The organizational priority level assigned to this SDOH factor for population health management initiatives, risk stratification, and community health worker intervention targeting.' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryDiagnosisEligible rdf:type rdf:Property ;
    rdfs:label 'Primary Diagnosis Eligible' ;
    rdfs:comment 'Indicates whether this Z-code can be reported as the principal/primary diagnosis on a claim or encounter, per ICD-10-CM coding guidelines.' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskAdjustmentEligible rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Eligible' ;
    rdfs:comment 'Indicates whether this Z-code is eligible for inclusion in CMS Hierarchical Condition Category (HCC) risk adjustment models or Medicare Advantage risk scoring.' ;
    rdfs:domain ind:SdohZcodeMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentWorkflowTblId rdf:type rdf:Property ;
    rdfs:label 'Consent Workflow Tbl Id' ;
    rdfs:comment 'Primary key for consent_workflow_tbl' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentAssignedToEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Consent Assigned To Employee Id' ;
    rdfs:comment 'Identifier of the staff member currently responsible for processing the next action in this workflow.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:consentCompletedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Consent Completed By Employee Id' ;
    rdfs:comment 'Identifier of the staff member who completed or closed the consent workflow.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:consentDelegatedToEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Consent Delegated To Employee Id' ;
    rdfs:comment 'Identifier of the surrogate or legal representative to whom consent authority has been delegated.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:consentEscalatedToEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Consent Escalated To Employee Id' ;
    rdfs:comment 'Identifier of the staff member or supervisor to whom the workflow was escalated.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:educationMaterialId rdf:type rdf:Property ;
    rdfs:label 'Education Material Id' ;
    rdfs:comment 'Reference to the specific patient education material provided during the consent workflow.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EducationMaterial .

ind:workflowTemplateId rdf:type rdf:Property ;
    rdfs:label 'Workflow Template Id' ;
    rdfs:comment 'Reference to the predefined workflow template that governs the steps, rules, and routing for this consent workflow instance.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkflowTemplate .

ind:consentWorkflowTblStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Workflow Tbl Status' ;
    rdfs:comment 'Current lifecycle state of the consent workflow instance indicating its processing stage.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentStepName rdf:type rdf:Property ;
    rdfs:label 'Current Step Name' ;
    rdfs:comment 'Name of the current active step in the consent workflow process, indicating where processing currently stands.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentStepSequence rdf:type rdf:Property ;
    rdfs:label 'Current Step Sequence' ;
    rdfs:comment 'Ordinal position of the current step within the total workflow sequence.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decisionOutcome rdf:type rdf:Property ;
    rdfs:label 'Decision Outcome' ;
    rdfs:comment 'Final decision outcome of the consent workflow indicating the patient\'s or representative\'s determination.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Due Timestamp' ;
    rdfs:comment 'Target date and time by which the consent workflow should be completed per SLA requirements.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:emergencyOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Emergency Override Reason' ;
    rdfs:comment 'Clinical justification for emergency consent override when standard consent workflow cannot be completed due to patient condition.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDelegated rdf:type rdf:Property ;
    rdfs:label 'Is Delegated' ;
    rdfs:comment 'Indicates whether the consent workflow has been delegated to a surrogate decision-maker or legal representative.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEmergencyOverride rdf:type rdf:Property ;
    rdfs:label 'Is Emergency Override' ;
    rdfs:comment 'Indicates whether the consent workflow was bypassed or expedited due to an emergency clinical situation per EMTALA requirements.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSlaBreached rdf:type rdf:Property ;
    rdfs:label 'Is Sla Breached' ;
    rdfs:comment 'Indicates whether the workflow has exceeded its SLA target completion time.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReminderTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Reminder Timestamp' ;
    rdfs:comment 'Date and time when the most recent reminder was sent for this consent workflow.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:outcomeReason rdf:type rdf:Property ;
    rdfs:label 'Outcome Reason' ;
    rdfs:comment 'Explanation or justification for the workflow outcome, particularly for denials or deferrals.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresLegalGuardian rdf:type rdf:Property ;
    rdfs:label 'Requires Legal Guardian' ;
    rdfs:comment 'Indicates whether a legal guardian or authorized representative must provide consent on behalf of the patient (e.g., minors, incapacitated patients).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresWitness rdf:type rdf:Property ;
    rdfs:label 'Requires Witness' ;
    rdfs:comment 'Indicates whether a witness signature is required for the consent to be valid per policy or regulation.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaHours rdf:type rdf:Property ;
    rdfs:label 'Sla Hours' ;
    rdfs:comment 'Number of hours allocated for workflow completion per the applicable service level agreement.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceWorkflowReference rdf:type rdf:Property ;
    rdfs:label 'Source Workflow Reference' ;
    rdfs:comment 'Native identifier of this workflow in the originating operational system, enabling traceability back to the source EHR.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalStepCount rdf:type rdf:Property ;
    rdfs:label 'Total Step Count' ;
    rdfs:comment 'Total number of steps defined in this workflow instance, used to calculate completion percentage.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalSteps rdf:type rdf:Property ;
    rdfs:label 'Total Steps' ;
    rdfs:comment 'Total number of steps defined in this consent workflow template, used for progress percentage calculation.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:witnessObtained rdf:type rdf:Property ;
    rdfs:label 'Witness Obtained' ;
    rdfs:comment 'Indicates whether the required witness signature has been obtained for this consent workflow.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workflowNumber rdf:type rdf:Property ;
    rdfs:label 'Workflow Number' ;
    rdfs:comment 'Human-readable business identifier for the consent workflow instance, used for tracking and communication across departments.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowStatus rdf:type rdf:Property ;
    rdfs:label 'Workflow Status' ;
    rdfs:comment 'Current state of the consent workflow in its lifecycle from initiation through completion or cancellation.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowType rdf:type rdf:Property ;
    rdfs:label 'Workflow Type' ;
    rdfs:comment 'Classification of the workflow purpose indicating what consent action is being processed.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderSetTblId rdf:type rdf:Property ;
    rdfs:label 'Order Set Tbl Id' ;
    rdfs:comment 'Primary key for order_set_tbl' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approverProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Approver Provider Clinician Id' ;
    rdfs:comment 'Identifier of the provider or committee chair who approved the order set for clinical use.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:orderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Order Clinician Id' ;
    rdfs:comment 'Identifier of the provider (physician or clinical pharmacist) who originally authored the order set.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:supersededByOrderSetOrderSetTblId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Order Set Order Set Tbl Id' ;
    rdfs:comment 'Identifier of the newer order set that replaces this one, enabling clinicians to be redirected to the current version.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrderSetTbl .

ind:alertOnInteraction rdf:type rdf:Property ;
    rdfs:label 'Alert On Interaction' ;
    rdfs:comment 'Indicates whether clinical decision support alerts for drug-drug or drug-allergy interactions are enabled for this order set.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:associatedProcedureCode rdf:type rdf:Property ;
    rdfs:label 'Associated Procedure Code' ;
    rdfs:comment 'Primary CPT procedure code associated with this order set for surgical or procedural contexts.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalPathwayName rdf:type rdf:Property ;
    rdfs:label 'Clinical Pathway Name' ;
    rdfs:comment 'Name of the clinical pathway or care protocol this order set supports, linking it to broader care standardization initiatives.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displaySortOrder rdf:type rdf:Property ;
    rdfs:label 'Display Sort Order' ;
    rdfs:comment 'Numeric value controlling the display sequence of this order set within category listings in the CPOE interface.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCustomizable rdf:type rdf:Property ;
    rdfs:label 'Is Customizable' ;
    rdfs:comment 'Indicates whether clinicians can modify, add, or remove individual orders within the set at the time of ordering.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDefaultForDiagnosis rdf:type rdf:Property ;
    rdfs:label 'Is Default For Diagnosis' ;
    rdfs:comment 'Indicates whether this order set is the default recommended set when the associated diagnosis is documented.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEvidenceBased rdf:type rdf:Property ;
    rdfs:label 'Is Evidence Based' ;
    rdfs:comment 'Indicates whether the order set is derived from published clinical evidence, guidelines, or best practice protocols.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPowerplan rdf:type rdf:Property ;
    rdfs:label 'Is Powerplan' ;
    rdfs:comment 'Indicates whether this order set functions as a Cerner PowerPlan with phase-based ordering logic and time-sequenced components.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderSetTblCategory rdf:type rdf:Property ;
    rdfs:label 'Order Set Tbl Category' ;
    rdfs:comment 'Clinical category or specialty grouping for the order set (e.g., cardiology, orthopedics, general medicine). Used for navigation and filtering in CPOE interfaces. [ENUM-REF-CANDIDATE: cardiology|orthopedics|general_medicine|oncology|pediatrics|neurology|pulmonology|gastroenterology — promote to reference product]' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderSetTblDescription rdf:type rdf:Property ;
    rdfs:label 'Order Set Tbl Description' ;
    rdfs:comment 'Detailed narrative description of the order set\'s clinical purpose, intended patient population, and usage guidelines.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderSetTblStatus rdf:type rdf:Property ;
    rdfs:label 'Order Set Tbl Status' ;
    rdfs:comment 'Current lifecycle status of the order set indicating whether it is available for clinical use.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresCosign rdf:type rdf:Property ;
    rdfs:label 'Requires Cosign' ;
    rdfs:comment 'Indicates whether orders placed from this set require co-signature by an attending physician or supervising provider.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restrictionCriteria rdf:type rdf:Property ;
    rdfs:label 'Restriction Criteria' ;
    rdfs:comment 'Description of access restrictions defining which provider roles or specialties may use this order set.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:setCode rdf:type rdf:Property ;
    rdfs:label 'Set Code' ;
    rdfs:comment 'Unique business identifier code assigned to the order set for cross-system reference and integration.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:setName rdf:type rdf:Property ;
    rdfs:label 'Set Name' ;
    rdfs:comment 'Human-readable name of the order set used for display and search in CPOE systems.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:setType rdf:type rdf:Property ;
    rdfs:label 'Set Type' ;
    rdfs:comment 'Classification of the order set by its clinical purpose or trigger context.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:setting rdf:type rdf:Property ;
    rdfs:label 'Setting' ;
    rdfs:comment 'Clinical care setting where this order set is intended to be used.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetPatientPopulation rdf:type rdf:Property ;
    rdfs:label 'Target Patient Population' ;
    rdfs:comment 'Description of the intended patient population for this order set (e.g., adult inpatient, pediatric ED, post-surgical).' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageCountLast90Days rdf:type rdf:Property ;
    rdfs:label 'Usage Count Last 90 Days' ;
    rdfs:comment 'Number of times this order set was utilized by clinicians in the last 90-day rolling period, used for governance and retirement decisions.' ;
    rdfs:domain ind:OrderSetTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trialEligibilityStatusId rdf:type rdf:Property ;
    rdfs:label 'Trial Eligibility Status Id' ;
    rdfs:comment 'Primary key for trial_eligibility_status' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorEligibilityStatusTrialEligibilityStatusId rdf:type rdf:Property ;
    rdfs:label 'Prior Eligibility Status Trial Eligibility Status Id' ;
    rdfs:comment 'Reference to the previous eligibility evaluation record for this patient-trial combination, enabling tracking of rescreening history.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrialEligibilityStatus .

ind:comorbidityEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Comorbidity Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient\'s comorbid conditions are acceptable per the trial\'s exclusion criteria for concurrent diseases.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataCompletenessPercent rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Percent' ;
    rdfs:comment 'Percentage of required eligibility data elements that are available in the patient\'s EHR for automated or manual evaluation.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diagnosisEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient\'s confirmed diagnosis meets the trial\'s disease-specific inclusion criteria.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentDecision rdf:type rdf:Property ;
    rdfs:label 'Enrollment Decision' ;
    rdfs:comment 'Final enrollment decision made following the eligibility determination, indicating the next action for the patient.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Decision Date' ;
    rdfs:comment 'Date on which the final enrollment decision was made by the investigator or study team.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ineligibilityReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Ineligibility Reason Description' ;
    rdfs:comment 'Free-text narrative describing why the patient was determined ineligible, which may contain clinical details about the patient\'s health conditions.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCurrentRecord rdf:type rdf:Property ;
    rdfs:label 'Is Current Record' ;
    rdfs:comment 'Indicates whether this is the most current eligibility status record for the patient-trial combination, supporting SCD Type 2 history.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:labEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Lab Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient\'s laboratory results meet the trial\'s lab-based inclusion and exclusion criteria.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicationEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Medication Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient\'s current and prior medication history satisfies the trial\'s washout and concomitant medication criteria.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pendingCriteriaDetails rdf:type rdf:Property ;
    rdfs:label 'Pending Criteria Details' ;
    rdfs:comment 'Description of criteria still pending evaluation or awaiting additional clinical data (e.g., pending lab results, imaging), which may contain PHI.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceStatusEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Status Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient\'s functional/performance status (e.g., ECOG, Karnofsky) meets the trial\'s minimum threshold.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rescreeningAttemptNumber rdf:type rdf:Property ;
    rdfs:label 'Rescreening Attempt Number' ;
    rdfs:comment 'Sequential number indicating which rescreening attempt this evaluation represents (1 for first screen, 2+ for rescreens).' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rescreeningFlag rdf:type rdf:Property ;
    rdfs:label 'Rescreening Flag' ;
    rdfs:comment 'Indicates whether this evaluation represents a rescreening attempt after a prior screening failure or withdrawal.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statusExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Status Expiration Date' ;
    rdfs:comment 'Date on which the current eligibility determination expires and requires re-evaluation per protocol requirements.' ;
    rdfs:domain ind:TrialEligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:genomicCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Genomic Care Site Id' ;
    rdfs:comment 'The reference laboratory or facility responsible for performing the genomic sequencing analysis.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:genomicOrderingFacilityCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Genomic Ordering Facility Care Site Id' ;
    rdfs:comment 'The healthcare facility or clinic from which the genomic order was placed.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:referringDiagnosisId rdf:type rdf:Property ;
    rdfs:label 'Referring Diagnosis Id' ;
    rdfs:comment 'Reference to the primary diagnosis record that prompted the genomic testing order.' ;
    rdfs:domain ind:GenomicOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Diagnosis .

ind:actionableFindingsFlag rdf:type rdf:Property ;
    rdfs:label 'Actionable Findings Flag' ;
    rdfs:comment 'Indicates whether the genomic test identified clinically actionable findings that may influence treatment decisions or care pathways.' ;
    rdfs:domain ind:GenomicOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost' ;
    rdfs:comment 'The estimated cost of the genomic sequencing test as quoted to the patient or payer at the time of order.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedTurnaroundDays rdf:type rdf:Property ;
    rdfs:label 'Expected Turnaround Days' ;
    rdfs:comment 'The expected number of calendar days from specimen receipt to result availability, based on test type and laboratory SLA.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:externalOrderReference rdf:type rdf:Property ;
    rdfs:label 'External Order Reference' ;
    rdfs:comment 'External reference number from the performing laboratory\'s system for cross-system order tracking and reconciliation.' ;
    rdfs:domain ind:GenomicOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:familyHistoryRelevant rdf:type rdf:Property ;
    rdfs:label 'Family History Relevant' ;
    rdfs:comment 'Indicates whether the patient has a relevant family history of genetic conditions that supports the clinical indication for testing.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genesOfInterest rdf:type rdf:Property ;
    rdfs:label 'Genes Of Interest' ;
    rdfs:comment 'Comma-separated list of specific gene names targeted for analysis in the genomic order, relevant for targeted panel tests.' ;
    rdfs:domain ind:GenomicOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneticCounselingCompleted rdf:type rdf:Property ;
    rdfs:label 'Genetic Counseling Completed' ;
    rdfs:comment 'Indicates whether pre-test genetic counseling was completed with the patient prior to order submission, as recommended by ACMG guidelines.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentalFindingsReported rdf:type rdf:Property ;
    rdfs:label 'Incidental Findings Reported' ;
    rdfs:comment 'Indicates whether secondary or incidental findings unrelated to the primary indication were identified and reported per ACMG recommendations.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderReasonText rdf:type rdf:Property ;
    rdfs:label 'Order Reason Text' ;
    rdfs:comment 'Free-text clinical justification provided by the ordering provider explaining why genomic testing is medically necessary.' ;
    rdfs:domain ind:GenomicOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderingDepartment rdf:type rdf:Property ;
    rdfs:label 'Ordering Department' ;
    rdfs:comment 'The clinical department or service line from which the genomic order originated (e.g., Oncology, Genetics, Neurology).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Status' ;
    rdfs:comment 'Current status of the insurance prior authorization request for the genomic test order.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Report Delivery Method' ;
    rdfs:comment 'The method by which the genomic test report is delivered to the ordering provider.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultAvailableDatetime rdf:type rdf:Property ;
    rdfs:label 'Result Available Datetime' ;
    rdfs:comment 'The date and time when the genomic test results became available for clinical review by the ordering provider.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:specimenAccessionNumber rdf:type rdf:Property ;
    rdfs:label 'Specimen Accession Number' ;
    rdfs:comment 'The unique laboratory-assigned accession number for tracking the specimen through the sequencing workflow.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specimenCollectedDatetime rdf:type rdf:Property ;
    rdfs:label 'Specimen Collected Datetime' ;
    rdfs:comment 'The date and time when the biological specimen was collected from the patient for genomic analysis.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:precisionMedicineReportId rdf:type rdf:Property ;
    rdfs:label 'Precision Medicine Report Id' ;
    rdfs:comment 'Primary key for precision_medicine_report' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:precisionInterpretingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Precision Interpreting Provider Clinician Id' ;
    rdfs:comment 'The clinical geneticist or molecular pathologist who interpreted the genomic findings and authored the report.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:clinicalTrialEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Eligibility Flag' ;
    rdfs:comment 'Indicates whether the genomic findings suggest potential eligibility for one or more clinical trials.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalTrialMatchesCount rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Matches Count' ;
    rdfs:comment 'Number of clinical trials identified as potentially relevant based on the genomic findings in this report.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentForResearchFlag rdf:type rdf:Property ;
    rdfs:label 'Consent For Research Flag' ;
    rdfs:comment 'Indicates whether the patient consented to use of their genomic data for research purposes.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geneticCounselingRecommendedFlag rdf:type rdf:Property ;
    rdfs:label 'Genetic Counseling Recommended Flag' ;
    rdfs:comment 'Indicates whether genetic counseling is recommended based on the findings in this report, particularly for germline results.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genomicInstabilityScore rdf:type rdf:Property ;
    rdfs:label 'Genomic Instability Score' ;
    rdfs:comment 'Homologous recombination deficiency (HRD) or genomic instability score indicating DNA repair pathway deficiency.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:her2Status rdf:type rdf:Property ;
    rdfs:label 'Her2 Status' ;
    rdfs:comment 'HER2 amplification or overexpression status if assessed, relevant for targeted therapy selection.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentalFindingsFlag rdf:type rdf:Property ;
    rdfs:label 'Incidental Findings Flag' ;
    rdfs:comment 'Indicates whether medically actionable incidental (secondary) findings were identified per ACMG SF list.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meanSequencingDepth rdf:type rdf:Property ;
    rdfs:label 'Mean Sequencing Depth' ;
    rdfs:comment 'Average sequencing depth (coverage) achieved across the targeted regions, indicating data quality and variant detection sensitivity.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:molecularTumorBoardDate rdf:type rdf:Property ;
    rdfs:label 'Molecular Tumor Board Date' ;
    rdfs:comment 'Date when the molecular tumor board reviewed this precision medicine report.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:molecularTumorBoardReviewedFlag rdf:type rdf:Property ;
    rdfs:label 'Molecular Tumor Board Reviewed Flag' ;
    rdfs:comment 'Indicates whether this report was reviewed by a molecular tumor board for multidisciplinary treatment planning.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pathogenicVariantsCount rdf:type rdf:Property ;
    rdfs:label 'Pathogenic Variants Count' ;
    rdfs:comment 'Number of pathogenic or likely pathogenic variants identified in this precision medicine report.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pdl1ExpressionScore rdf:type rdf:Property ;
    rdfs:label 'Pdl1 Expression Score' ;
    rdfs:comment 'PD-L1 expression score (tumor proportion score or combined positive score) if assessed as part of the genomic panel.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryDiagnosisIcdCode rdf:type rdf:Property ;
    rdfs:label 'Primary Diagnosis Icd Code' ;
    rdfs:comment 'ICD-10 code for the primary clinical diagnosis that prompted the genomic testing.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedTherapy rdf:type rdf:Property ;
    rdfs:label 'Recommended Therapy' ;
    rdfs:comment 'Primary targeted therapy or treatment recommendation based on the genomic findings in this report.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportReceivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Received Timestamp' ;
    rdfs:comment 'Timestamp when the precision medicine report was received into the EHR system from the testing laboratory.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:specimenAdequacy rdf:type rdf:Property ;
    rdfs:label 'Specimen Adequacy' ;
    rdfs:comment 'Assessment of whether the submitted specimen met quality and quantity requirements for reliable genomic analysis.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testingLaboratoryCliaNumber rdf:type rdf:Property ;
    rdfs:label 'Testing Laboratory Clia Number' ;
    rdfs:comment 'CLIA certification number of the laboratory that performed the genomic test, ensuring regulatory compliance.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testingLaboratoryName rdf:type rdf:Property ;
    rdfs:label 'Testing Laboratory Name' ;
    rdfs:comment 'Name of the external or internal laboratory that performed the genomic sequencing and analysis.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tumorCellularityPercent rdf:type rdf:Property ;
    rdfs:label 'Tumor Cellularity Percent' ;
    rdfs:comment 'Percentage of tumor cells in the specimen, critical for assessing the reliability of variant allele frequency measurements.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variantsOfUnknownSignificanceCount rdf:type rdf:Property ;
    rdfs:label 'Variants Of Unknown Significance Count' ;
    rdfs:comment 'Number of variants of uncertain significance identified in this report requiring potential future reclassification.' ;
    rdfs:domain ind:PrecisionMedicineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:variantId rdf:type rdf:Property ;
    rdfs:label 'Variant Id' ;
    rdfs:comment 'Primary key for variant' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Variant .

ind:testOrderId rdf:type rdf:Property ;
    rdfs:label 'Test Order Id' ;
    rdfs:comment 'Identifier of the genomic test order that produced this variant call.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TestOrder .

ind:alternateReadCount rdf:type rdf:Property ;
    rdfs:label 'Alternate Read Count' ;
    rdfs:comment 'Number of sequencing reads supporting the alternate allele at this position.' ;
    rdfs:domain ind:Variant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:functionalEffect rdf:type rdf:Property ;
    rdfs:label 'Functional Effect' ;
    rdfs:comment 'Predicted functional consequence of the variant on the gene product. [ENUM-REF-CANDIDATE: missense|nonsense|frameshift|splice_site|synonymous|intronic|start_loss|stop_loss|inframe_insertion|inframe_deletion|UTR — promote to reference product]' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationFrequency rdf:type rdf:Property ;
    rdfs:label 'Population Frequency' ;
    rdfs:comment 'Frequency of this variant in the general population from gnomAD or similar reference databases.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingNotes rdf:type rdf:Property ;
    rdfs:label 'Reporting Notes' ;
    rdfs:comment 'Free-text clinical notes or comments included in the genomic report regarding this variant finding.' ;
    rdfs:domain ind:Variant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomeSequenceId rdf:type rdf:Property ;
    rdfs:label 'Genome Sequence Id' ;
    rdfs:comment 'Primary key for genome_sequence' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomeCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Genome Care Site Id' ;
    rdfs:comment 'Identifier of the laboratory facility that performed the genome sequencing.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:genomeOrderingFacilityCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Genome Ordering Facility Care Site Id' ;
    rdfs:comment 'Identifier of the healthcare facility from which the genome sequencing test was ordered.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:clinicallySignificantVariantCount rdf:type rdf:Property ;
    rdfs:label 'Clinically Significant Variant Count' ;
    rdfs:comment 'Number of variants classified as pathogenic or likely pathogenic per ACMG guidelines found in this genome sequence.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contaminationEstimatePercent rdf:type rdf:Property ;
    rdfs:label 'Contamination Estimate Percent' ;
    rdfs:comment 'Estimated percentage of DNA contamination from other samples detected during quality control analysis.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataFileFormat rdf:type rdf:Property ;
    rdfs:label 'Data File Format' ;
    rdfs:comment 'Primary file format in which the sequencing data is stored (e.g., FASTQ for raw reads, BAM/CRAM for aligned reads, VCF for variants).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataFileSizeGb rdf:type rdf:Property ;
    rdfs:label 'Data File Size Gb' ;
    rdfs:comment 'Total size of the primary sequencing data file in gigabytes for storage planning and data management.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ethnicityReported rdf:type rdf:Property ;
    rdfs:label 'Ethnicity Reported' ;
    rdfs:comment 'Self-reported ethnicity of the patient, relevant for population frequency interpretation of genomic variants.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowcellBarcode rdf:type rdf:Property ;
    rdfs:label 'Flowcell Barcode' ;
    rdfs:comment 'Identifier of the flowcell used in the sequencing run, critical for batch-level quality tracking and troubleshooting.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomeSequenceStatus rdf:type rdf:Property ;
    rdfs:label 'Genome Sequence Status' ;
    rdfs:comment 'Current lifecycle status of the genome sequencing workflow from order through completion.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10IndicationCode rdf:type rdf:Property ;
    rdfs:label 'Icd10 Indication Code' ;
    rdfs:comment 'ICD-10-CM diagnosis code representing the primary clinical indication for the genomic test order.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCurrentFlag rdf:type rdf:Property ;
    rdfs:label 'Is Current Flag' ;
    rdfs:comment 'Boolean flag indicating whether this is the most current version of the genome sequence record in the SCD Type 2 history.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:libraryPreparationMethod rdf:type rdf:Property ;
    rdfs:label 'Library Preparation Method' ;
    rdfs:comment 'Method used for DNA library preparation prior to sequencing (e.g., PCR-free, PCR-based, tagmentation).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mappedReadsPercent rdf:type rdf:Property ;
    rdfs:label 'Mapped Reads Percent' ;
    rdfs:comment 'Percentage of total reads that successfully aligned to the reference genome assembly.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pairedEndFlag rdf:type rdf:Property ;
    rdfs:label 'Paired End Flag' ;
    rdfs:comment 'Indicates whether paired-end sequencing was performed (true) versus single-end sequencing (false).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:q30BasesPercent rdf:type rdf:Property ;
    rdfs:label 'Q30 Bases Percent' ;
    rdfs:comment 'Percentage of bases with a Phred quality score of 30 or higher, indicating 99.9% base call accuracy.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readLengthBp rdf:type rdf:Property ;
    rdfs:label 'Read Length Bp' ;
    rdfs:comment 'Length of individual sequencing reads in base pairs (e.g., 150bp for short-read, 10000+ for long-read).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referenceGenomeAssembly rdf:type rdf:Property ;
    rdfs:label 'Reference Genome Assembly' ;
    rdfs:comment 'Human reference genome assembly version used for alignment and variant calling (e.g., GRCh38/hg38).' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchUseConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Research Use Consent Flag' ;
    rdfs:comment 'Indicates whether the patient consented to use of their genomic data for research purposes beyond clinical care.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sequencingInstrumentModel rdf:type rdf:Property ;
    rdfs:label 'Sequencing Instrument Model' ;
    rdfs:comment 'Specific model of the sequencing instrument used (e.g., NovaSeq 6000, HiSeq X Ten, MinION).' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sexAtBirth rdf:type rdf:Property ;
    rdfs:label 'Sex At Birth' ;
    rdfs:comment 'Biological sex assigned at birth, required for accurate interpretation of sex-linked genomic variants.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalBasesGigabases rdf:type rdf:Property ;
    rdfs:label 'Total Bases Gigabases' ;
    rdfs:comment 'Total number of bases sequenced expressed in gigabases (Gb), representing the data yield of the sequencing run.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tumorNormalFlag rdf:type rdf:Property ;
    rdfs:label 'Tumor Normal Flag' ;
    rdfs:comment 'Indicates whether the sample is from tumor tissue, normal tissue, or part of a paired tumor-normal analysis for somatic variant detection.' ;
    rdfs:domain ind:GenomeSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tumorPurityPercent rdf:type rdf:Property ;
    rdfs:label 'Tumor Purity Percent' ;
    rdfs:comment 'Estimated percentage of tumor cells in the sample, relevant for somatic variant calling sensitivity in oncology genomics.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geneExpressionId rdf:type rdf:Property ;
    rdfs:label 'Gene Expression Id' ;
    rdfs:comment 'Primary key for gene_expression' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionabilityCategory rdf:type rdf:Property ;
    rdfs:label 'Actionability Category' ;
    rdfs:comment 'Tier classification indicating whether the expression finding has direct therapeutic implications per AMP/ASCO/CAP guidelines.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustedPValue rdf:type rdf:Property ;
    rdfs:label 'Adjusted P Value' ;
    rdfs:comment 'Multiple testing corrected p-value (e.g., Benjamini-Hochberg False Discovery Rate) to control for family-wise error rate in genome-wide analyses.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assayMethod rdf:type rdf:Property ;
    rdfs:label 'Assay Method' ;
    rdfs:comment 'Laboratory method used to quantify gene expression levels.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assayPlatform rdf:type rdf:Property ;
    rdfs:label 'Assay Platform' ;
    rdfs:comment 'Technology platform used for gene expression measurement (e.g., Illumina HiSeq, Affymetrix GeneChip, NanoString nCounter, RT-qPCR).' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associatedIcd10Code rdf:type rdf:Property ;
    rdfs:label 'Associated Icd10 Code' ;
    rdfs:comment 'ICD-10 diagnosis code linked to the clinical condition for which this gene expression result is relevant.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biomarkerName rdf:type rdf:Property ;
    rdfs:label 'Biomarker Name' ;
    rdfs:comment 'Name of the clinical biomarker this gene expression measurement contributes to (e.g., HER2, EGFR, PD-L1, BRCA1).' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceIntervalHigh rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval High' ;
    rdfs:comment 'Upper bound of the 95% confidence interval for the expression measurement.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceIntervalLow rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Low' ;
    rdfs:comment 'Lower bound of the 95% confidence interval for the expression measurement.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ensemblGeneAccession rdf:type rdf:Property ;
    rdfs:label 'Ensembl Gene Accession' ;
    rdfs:comment 'Ensembl stable identifier for the gene, used for cross-referencing genomic databases.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expressionStatus rdf:type rdf:Property ;
    rdfs:label 'Expression Status' ;
    rdfs:comment 'Categorical classification of the expression level relative to normal reference ranges for clinical interpretation.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expressionUnit rdf:type rdf:Property ;
    rdfs:label 'Expression Unit' ;
    rdfs:comment 'Unit of measurement for the expression value indicating the normalization method applied (Transcripts Per Million, Fragments Per Kilobase Million, etc.).' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expressionValue rdf:type rdf:Property ;
    rdfs:label 'Expression Value' ;
    rdfs:comment 'Quantitative measurement of gene expression level, representing the abundance of mRNA transcripts detected in the sample.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geneEndPosition rdf:type rdf:Property ;
    rdfs:label 'Gene End Position' ;
    rdfs:comment 'Genomic end coordinate of the gene on the reference genome assembly.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geneName rdf:type rdf:Property ;
    rdfs:label 'Gene Name' ;
    rdfs:comment 'Full descriptive name of the gene as approved by HGNC.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneStartPosition rdf:type rdf:Property ;
    rdfs:label 'Gene Start Position' ;
    rdfs:comment 'Genomic start coordinate of the gene on the reference genome assembly.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interpretationNotes rdf:type rdf:Property ;
    rdfs:label 'Interpretation Notes' ;
    rdfs:comment 'Free-text clinical interpretation notes provided by the molecular pathologist or geneticist regarding the expression finding.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:log2FoldChange rdf:type rdf:Property ;
    rdfs:label 'Log2 Fold Change' ;
    rdfs:comment 'Log base 2 of the ratio of expression in the sample versus a reference or control, indicating up-regulation (positive) or down-regulation (negative).' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:normalizationMethod rdf:type rdf:Property ;
    rdfs:label 'Normalization Method' ;
    rdfs:comment 'Statistical normalization method applied to raw expression data (e.g., DESeq2, TMM, quantile normalization, housekeeping gene).' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pValue rdf:type rdf:Property ;
    rdfs:label 'P Value' ;
    rdfs:comment 'Statistical significance p-value for the differential expression measurement, indicating the probability of observing the result by chance.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pathwayName rdf:type rdf:Property ;
    rdfs:label 'Pathway Name' ;
    rdfs:comment 'Name of the biological signaling or metabolic pathway in which the gene participates, relevant for pathway-level analysis.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceSampleType rdf:type rdf:Property ;
    rdfs:label 'Reference Sample Type' ;
    rdfs:comment 'Type of reference or control sample used for comparative expression analysis.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rnaIntegrityNumber rdf:type rdf:Property ;
    rdfs:label 'Rna Integrity Number' ;
    rdfs:comment 'RNA Integrity Number (scale 1-10) indicating the quality of RNA extracted from the sample, where higher values indicate less degradation.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tissueType rdf:type rdf:Property ;
    rdfs:label 'Tissue Type' ;
    rdfs:comment 'Anatomical tissue type from which the sample was derived (e.g., breast, lung, colon, liver).' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zScore rdf:type rdf:Property ;
    rdfs:label 'Z Score' ;
    rdfs:comment 'Standard score indicating how many standard deviations the expression value is from the population mean for this gene.' ;
    rdfs:domain ind:GeneExpression ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalGenomicsReportId rdf:type rdf:Property ;
    rdfs:label 'Clinical Genomics Report Id' ;
    rdfs:comment 'Primary key for clinical_genomics_report' ;
    rdfs:domain ind:ClinicalGenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalInterpretingGeneticistClinicianId rdf:type rdf:Property ;
    rdfs:label 'Clinical Interpreting Geneticist Clinician Id' ;
    rdfs:comment 'Identifier of the clinical geneticist or molecular pathologist who interpreted and signed the report.' ;
    rdfs:domain ind:ClinicalGenomicsReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:genesAnalyzedCount rdf:type rdf:Property ;
    rdfs:label 'Genes Analyzed Count' ;
    rdfs:comment 'Total number of genes included in the analysis panel or sequencing scope.' ;
    rdfs:domain ind:ClinicalGenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geneticFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Genetic Findings Summary' ;
    rdfs:comment 'Narrative summary of the key genetic findings identified in the report, including gene names and variant classifications.' ;
    rdfs:domain ind:ClinicalGenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaRetentionEndDate rdf:type rdf:Property ;
    rdfs:label 'Hipaa Retention End Date' ;
    rdfs:comment 'Date after which this genomic report record may be eligible for archival or destruction per HIPAA medical record retention requirements.' ;
    rdfs:domain ind:ClinicalGenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pathogenicVariantCount rdf:type rdf:Property ;
    rdfs:label 'Pathogenic Variant Count' ;
    rdfs:comment 'Number of variants classified as pathogenic or likely pathogenic per ACMG criteria.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recommendations rdf:type rdf:Property ;
    rdfs:label 'Recommendations' ;
    rdfs:comment 'Clinical recommendations provided by the interpreting geneticist, such as follow-up testing, genetic counseling, or surveillance guidelines.' ;
    rdfs:domain ind:ClinicalGenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportAmendedDate rdf:type rdf:Property ;
    rdfs:label 'Report Amended Date' ;
    rdfs:comment 'Date on which the report was last amended, if applicable.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testingMethodology rdf:type rdf:Property ;
    rdfs:label 'Testing Methodology' ;
    rdfs:comment 'Description of the sequencing or analysis methodology used (e.g., Next-Generation Sequencing, Sanger Sequencing, FISH, Microarray).' ;
    rdfs:domain ind:ClinicalGenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapyImplicationFlag rdf:type rdf:Property ;
    rdfs:label 'Therapy Implication Flag' ;
    rdfs:comment 'Indicates whether the genomic findings have direct implications for targeted therapy or drug selection in precision medicine.' ;
    rdfs:domain ind:ClinicalGenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalAiCohortDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Cohort Definition Id' ;
    rdfs:comment 'Primary key for clinical_ai_cohort_definition' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalApprovedByProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Clinical Approved By Provider Clinician Id' ;
    rdfs:comment 'Identifier of the clinical leader or governance committee member who approved the cohort definition for production use.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:clinicalAiCohortDefinitionCode rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Cohort Definition Code' ;
    rdfs:comment 'Unique business identifier code assigned to the cohort definition for cross-system referencing and cataloging.' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiCohortDefinitionDescription rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Cohort Definition Description' ;
    rdfs:comment 'Detailed narrative explanation of the cohort\'s clinical intent, target population characteristics, and expected use cases.' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiCohortDefinitionName rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Cohort Definition Name' ;
    rdfs:comment 'Human-readable name of the cohort definition used for display and search purposes across population health management tools.' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiCohortDefinitionStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Cohort Definition Status' ;
    rdfs:comment 'Current lifecycle state of the cohort definition governing whether it can be used for patient identification and analytics.' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criteriaExpression rdf:type rdf:Property ;
    rdfs:label 'Criteria Expression' ;
    rdfs:comment 'Formal logical expression defining inclusion and exclusion criteria using Clinical Quality Language (CQL) or equivalent structured query syntax. May reference diagnosis codes, lab values, or medication histories.' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criteriaLogicType rdf:type rdf:Property ;
    rdfs:label 'Criteria Logic Type' ;
    rdfs:comment 'The formal language or framework used to express the cohort selection criteria.' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10Category rdf:type rdf:Property ;
    rdfs:label 'Icd10 Category' ;
    rdfs:comment 'Primary ICD-10 diagnosis category or code range that anchors the cohort definition\'s clinical focus.' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelAlgorithmName rdf:type rdf:Property ;
    rdfs:label 'Model Algorithm Name' ;
    rdfs:comment 'Name of the AI/ML algorithm or predictive model used to identify or score patients for cohort membership when applicable.' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohInclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Sdoh Inclusion Flag' ;
    rdfs:comment 'Indicates whether social determinants of health factors are incorporated into the cohort selection criteria.' ;
    rdfs:domain ind:ClinicalAiCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genomicTestId rdf:type rdf:Property ;
    rdfs:label 'Genomic Test Id' ;
    rdfs:comment 'Primary key for genomic_test' ;
    rdfs:domain ind:GenomicTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicClinicianId rdf:type rdf:Property ;
    rdfs:label 'Genomic Clinician Id' ;
    rdfs:comment 'The provider who placed the genomic test order.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:genomicGeneticCounselorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Genomic Genetic Counselor Clinician Id' ;
    rdfs:comment 'The genetic counselor involved in pre-test or post-test counseling for this order.' ;
    rdfs:domain ind:GenomicTest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:parentTestGenomicTestId rdf:type rdf:Property ;
    rdfs:label 'Parent Test Genomic Test Id' ;
    rdfs:comment 'Reference to the original genomic test that triggered this reflex or follow-up test.' ;
    rdfs:domain ind:GenomicTest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicTest .

ind:estimatedChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Charge Amount' ;
    rdfs:comment 'Estimated charge amount for the genomic test based on the charge description master (CDM).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interpretationNarrative rdf:type rdf:Property ;
    rdfs:label 'Interpretation Narrative' ;
    rdfs:comment 'Free-text clinical interpretation and summary of genomic findings authored by the laboratory geneticist or genetic counselor.' ;
    rdfs:domain ind:GenomicTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:panelVersion rdf:type rdf:Property ;
    rdfs:label 'Panel Version' ;
    rdfs:comment 'Version identifier of the gene panel used, reflecting updates to gene content over time.' ;
    rdfs:domain ind:GenomicTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportReleasedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Released Timestamp' ;
    rdfs:comment 'Date and time when the final genomic test report was released to the ordering provider.' ;
    rdfs:domain ind:GenomicTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rpmDeviceReadingId rdf:type rdf:Property ;
    rdfs:label 'Rpm Device Reading Id' ;
    rdfs:comment 'Primary key for rpm_device_reading' ;
    rdfs:domain ind:RpmDeviceReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicianReviewedFlag rdf:type rdf:Property ;
    rdfs:label 'Clinician Reviewed Flag' ;
    rdfs:comment 'Indicates whether a clinician has reviewed this reading, relevant for CPT 99457/99458 billing which requires interactive communication time.' ;
    rdfs:domain ind:RpmDeviceReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deviceBatteryPct rdf:type rdf:Property ;
    rdfs:label 'Device Battery Pct' ;
    rdfs:comment 'Battery level of the monitoring device at the time of reading capture, used for proactive device maintenance and patient outreach when battery is low.' ;
    rdfs:domain ind:RpmDeviceReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAlertTriggered rdf:type rdf:Property ;
    rdfs:label 'Is Alert Triggered' ;
    rdfs:comment 'Indicates whether this reading triggered a clinical alert based on the patient\'s configured threshold parameters in the RPM program.' ;
    rdfs:domain ind:RpmDeviceReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isManuallyEntered rdf:type rdf:Property ;
    rdfs:label 'Is Manually Entered' ;
    rdfs:comment 'Indicates whether this reading was manually entered by the patient rather than automatically transmitted by the device, affecting data reliability assessment.' ;
    rdfs:domain ind:RpmDeviceReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityIndicator rdf:type rdf:Property ;
    rdfs:label 'Quality Indicator' ;
    rdfs:comment 'Assessment of the signal quality or measurement confidence reported by the device, indicating reliability of the captured value for clinical decision-making.' ;
    rdfs:domain ind:RpmDeviceReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdHigh rdf:type rdf:Property ;
    rdfs:label 'Threshold High' ;
    rdfs:comment 'The upper threshold value that was active at the time of this reading, against which the measurement was evaluated for alert generation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdLow rdf:type rdf:Property ;
    rdfs:label 'Threshold Low' ;
    rdfs:comment 'The lower threshold value that was active at the time of this reading, against which the measurement was evaluated for alert generation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueSecondaryNumeric rdf:type rdf:Property ;
    rdfs:label 'Value Secondary Numeric' ;
    rdfs:comment 'A secondary numeric value for compound measurements such as diastolic blood pressure (when value_numeric holds systolic), or a secondary axis reading.' ;
    rdfs:domain ind:RpmDeviceReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:genomicSequencingResultId rdf:type rdf:Property ;
    rdfs:label 'Genomic Sequencing Result Id' ;
    rdfs:comment 'Primary key for genomic_sequencing_result' ;
    rdfs:domain ind:GenomicSequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalTrialEligibility rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Eligibility' ;
    rdfs:comment 'Indicates whether the genomic findings suggest potential eligibility for one or more clinical trials.' ;
    rdfs:domain ind:GenomicSequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalLabName rdf:type rdf:Property ;
    rdfs:label 'External Lab Name' ;
    rdfs:comment 'Name of the external reference laboratory if the sequencing was performed by a send-out lab rather than in-house.' ;
    rdfs:domain ind:GenomicSequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicationForTesting rdf:type rdf:Property ;
    rdfs:label 'Indication For Testing' ;
    rdfs:comment 'The clinical reason or diagnosis prompting the genomic sequencing order (e.g., suspected hereditary cancer, undiagnosed rare disease).' ;
    rdfs:domain ind:GenomicSequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientConsentForResearch rdf:type rdf:Property ;
    rdfs:label 'Patient Consent For Research' ;
    rdfs:comment 'Indicates whether the patient consented to use of their genomic data for research purposes.' ;
    rdfs:domain ind:GenomicSequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultReleasedToPatient rdf:type rdf:Property ;
    rdfs:label 'Result Released To Patient' ;
    rdfs:comment 'Indicates whether the genomic result has been released to the patient, per 21st Century Cures Act information blocking rules.' ;
    rdfs:domain ind:GenomicSequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sequencingMethod rdf:type rdf:Property ;
    rdfs:label 'Sequencing Method' ;
    rdfs:comment 'The molecular methodology used: Whole Genome Sequencing (WGS), Whole Exome Sequencing (WES), targeted gene panel, RNA sequencing, or methylation analysis.' ;
    rdfs:domain ind:GenomicSequencingResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precisionTreatmentPlanId rdf:type rdf:Property ;
    rdfs:label 'Precision Treatment Plan Id' ;
    rdfs:comment 'Primary key for precision_treatment_plan' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:precisionReviewingPathologistClinicianId rdf:type rdf:Property ;
    rdfs:label 'Precision Reviewing Pathologist Clinician Id' ;
    rdfs:comment 'The molecular pathologist who reviewed the genomic results and contributed to the treatment plan interpretation.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:alternativeTherapyConsidered rdf:type rdf:Property ;
    rdfs:label 'Alternative Therapy Considered' ;
    rdfs:comment 'Alternative precision therapies that were considered but not selected, with brief rationale for exclusion.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bestResponse rdf:type rdf:Property ;
    rdfs:label 'Best Response' ;
    rdfs:comment 'Best overall response achieved during the precision treatment plan as assessed by the chosen response criteria.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancerStage rdf:type rdf:Property ;
    rdfs:label 'Cancer Stage' ;
    rdfs:comment 'AJCC/TNM cancer stage at the time of precision treatment plan creation, informing treatment intensity. [ENUM-REF-CANDIDATE: I|IA|IB|II|IIA|IIB|III|IIIA|IIIB|IIIC|IV|IVA|IVB — promote to reference product]' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contraindicationNotes rdf:type rdf:Property ;
    rdfs:label 'Contraindication Notes' ;
    rdfs:comment 'Documentation of any genomic or clinical contraindications identified that influenced treatment selection or exclusion of alternatives.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dosageAdjustmentRationale rdf:type rdf:Property ;
    rdfs:label 'Dosage Adjustment Rationale' ;
    rdfs:comment 'Clinical rationale for any dosage adjustments made based on pharmacogenomic findings or biomarker levels.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedResponseRatePercent rdf:type rdf:Property ;
    rdfs:label 'Expected Response Rate Percent' ;
    rdfs:comment 'Published or evidence-based expected objective response rate for the selected therapy in the patient\'s biomarker-defined population.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hereditaryRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Hereditary Risk Flag' ;
    rdfs:comment 'Indicates whether the genomic findings suggest a hereditary cancer predisposition syndrome requiring family counseling.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:informedConsentObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Obtained Flag' ;
    rdfs:comment 'Indicates whether informed consent for genomic-guided precision treatment was obtained from the patient.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineOfTherapy rdf:type rdf:Property ;
    rdfs:label 'Line Of Therapy' ;
    rdfs:comment 'Numeric indicator of the treatment line (1=first-line, 2=second-line, etc.) representing how many prior systemic regimens the patient has received.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monitoringPlanSummary rdf:type rdf:Property ;
    rdfs:label 'Monitoring Plan Summary' ;
    rdfs:comment 'Summary of the planned monitoring approach including biomarker reassessment intervals, imaging schedule, and liquid biopsy frequency.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pdl1ExpressionPercent rdf:type rdf:Property ;
    rdfs:label 'Pdl1 Expression Percent' ;
    rdfs:comment 'PD-L1 tumor proportion score as a percentage, used to determine immunotherapy eligibility.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacogenomicConsideration rdf:type rdf:Property ;
    rdfs:label 'Pharmacogenomic Consideration' ;
    rdfs:comment 'Summary of pharmacogenomic factors affecting drug metabolism or toxicity risk relevant to the treatment plan (e.g., DPYD deficiency, UGT1A1 polymorphism).' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planRationale rdf:type rdf:Property ;
    rdfs:label 'Plan Rationale' ;
    rdfs:comment 'Clinical narrative explaining why this specific precision treatment was selected based on the patient\'s genomic profile and clinical context.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precisionTreatmentPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Precision Treatment Plan Status' ;
    rdfs:comment 'Current lifecycle state of the precision treatment plan within the clinical workflow.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseAssessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Response Assessment Method' ;
    rdfs:comment 'The standardized criteria used to assess treatment response (e.g., RECIST for solid tumors, Lugano for lymphoma).' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticAgentName rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Agent Name' ;
    rdfs:comment 'Name of the primary therapeutic agent or drug recommended in the precision treatment plan based on genomic findings.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticAgentNdc rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Agent Ndc' ;
    rdfs:comment 'NDC code of the primary therapeutic agent prescribed in the precision treatment plan.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentCycleCount rdf:type rdf:Property ;
    rdfs:label 'Treatment Cycle Count' ;
    rdfs:comment 'Number of treatment cycles planned or completed as part of this precision treatment plan.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatmentDurationDays rdf:type rdf:Property ;
    rdfs:label 'Treatment Duration Days' ;
    rdfs:comment 'Planned or actual duration of the precision treatment regimen in calendar days.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tumorBoardReviewDate rdf:type rdf:Property ;
    rdfs:label 'Tumor Board Review Date' ;
    rdfs:comment 'Date when the molecular tumor board reviewed and discussed this precision treatment plan.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tumorMutationBurden rdf:type rdf:Property ;
    rdfs:label 'Tumor Mutation Burden' ;
    rdfs:comment 'Tumor mutation burden score (mutations per megabase) used to inform immunotherapy eligibility in the treatment plan.' ;
    rdfs:domain ind:PrecisionTreatmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sdohChwInterventionsId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Chw Interventions Id' ;
    rdfs:comment 'Primary key for sdoh_chw_interventions' ;
    rdfs:domain ind:SdohChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activityDescription rdf:type rdf:Property ;
    rdfs:label 'Activity Description' ;
    rdfs:comment 'Detailed narrative of the activities performed during this CHW intervention.' ;
    rdfs:domain ind:SdohChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaAuthorizationType rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Type' ;
    rdfs:comment 'Type of HIPAA authorization obtained for sharing patient information with external community organizations.' ;
    rdfs:domain ind:SdohChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isInitialContact rdf:type rdf:Property ;
    rdfs:label 'Is Initial Contact' ;
    rdfs:comment 'Indicates whether this is the first CHW contact with the patient for this particular SDOH need.' ;
    rdfs:domain ind:SdohChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationAddress rdf:type rdf:Property ;
    rdfs:label 'Location Address' ;
    rdfs:comment 'The physical address where the intervention was conducted, particularly for home visits and community outreach.' ;
    rdfs:domain ind:SdohChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceConnectionConfirmed rdf:type rdf:Property ;
    rdfs:label 'Resource Connection Confirmed' ;
    rdfs:comment 'Indicates whether the patient successfully connected with the referred community resource (closed-loop referral confirmation).' ;
    rdfs:domain ind:SdohChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resourceReferralMade rdf:type rdf:Property ;
    rdfs:label 'Resource Referral Made' ;
    rdfs:comment 'Indicates whether a referral to a community resource or social service was made as part of this intervention.' ;
    rdfs:domain ind:SdohChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdohChwInterventionsStatus rdf:type rdf:Property ;
    rdfs:label 'Sdoh Chw Interventions Status' ;
    rdfs:comment 'Current lifecycle status of the CHW intervention indicating its progress through the workflow.' ;
    rdfs:domain ind:SdohChwInterventions ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohortDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Definition Id' ;
    rdfs:comment 'Primary key for population_cohort_definition' ;
    rdfs:domain ind:PopulationCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastExecutionMemberCount rdf:type rdf:Property ;
    rdfs:label 'Last Execution Member Count' ;
    rdfs:comment 'Number of patients identified as cohort members during the most recent execution run, used for trending and capacity planning.' ;
    rdfs:domain ind:PopulationCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payerProgramAlignment rdf:type rdf:Property ;
    rdfs:label 'Payer Program Alignment' ;
    rdfs:comment 'Identifies the payer-sponsored program (e.g., Medicare Advantage Star Ratings, Medicaid managed care, commercial value-based contract) that this cohort supports.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohortDefinitionCode rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Definition Code' ;
    rdfs:comment 'Unique business identifier code for the cohort definition, used for cross-system referencing and registry alignment.' ;
    rdfs:domain ind:PopulationCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohortDefinitionDescription rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Definition Description' ;
    rdfs:comment 'Detailed narrative description of the cohort\'s clinical intent, target population characteristics, and intended use cases for care management teams.' ;
    rdfs:domain ind:PopulationCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohortDefinitionName rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Definition Name' ;
    rdfs:comment 'Human-readable name of the population cohort definition, such as \'Diabetic Adults Age 18-75 with HbA1c > 9%\' or \'Heart Failure Readmission Risk\'.' ;
    rdfs:domain ind:PopulationCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohortDefinitionStatus rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Definition Status' ;
    rdfs:comment 'Current lifecycle state of the cohort definition indicating whether it is available for use in population health programs and reporting.' ;
    rdfs:domain ind:PopulationCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohCriteriaDetail rdf:type rdf:Property ;
    rdfs:label 'Sdoh Criteria Detail' ;
    rdfs:comment 'Narrative description of specific SDOH factors used in cohort criteria, such as Z-codes for social risk factors or area deprivation index thresholds.' ;
    rdfs:domain ind:PopulationCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensitivityScore rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Score' ;
    rdfs:comment 'Statistical sensitivity (true positive rate) of the cohort definition measured during validation, indicating how well it captures all eligible patients.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specificityScore rdf:type rdf:Property ;
    rdfs:label 'Specificity Score' ;
    rdfs:comment 'Statistical specificity (true negative rate) of the cohort definition measured during validation, indicating how well it excludes non-eligible patients.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stewardDepartment rdf:type rdf:Property ;
    rdfs:label 'Steward Department' ;
    rdfs:comment 'Name of the organizational department (e.g., Population Health, Quality, Clinical Analytics) responsible for maintaining and validating this cohort definition.' ;
    rdfs:domain ind:PopulationCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohortMembershipId rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Membership Id' ;
    rdfs:comment 'Primary key for population_cohort_membership' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cohortPopulationCohortDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Cohort Population Cohort Definition Id' ;
    rdfs:comment 'Foreign key linking to clinical_ai.population_cohort_definition. Business justification: population_cohort_membership has cohort_id (BIGINT) with no FK. This links membership records to their population cohort definition. A membership belongs to exactly one cohort definition.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PopulationCohortDefinition .

ind:populationClinicianId rdf:type rdf:Property ;
    rdfs:label 'Population Clinician Id' ;
    rdfs:comment 'Identifier of the care manager or care coordinator responsible for managing this patient within the cohort.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:populationCohortId rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Id' ;
    rdfs:comment 'Identifier of the population health cohort to which the patient is assigned (e.g., diabetes management, heart failure, high-risk pregnancy).' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PopulationCohort .

ind:populationPcpProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Population Pcp Provider Clinician Id' ;
    rdfs:comment 'Identifier of the patient\'s primary care physician at the time of cohort enrollment, used for attribution and care coordination.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:assignmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assignment Method' ;
    rdfs:comment 'Method by which the patient was assigned to the cohort, distinguishing between AI/ML algorithm-driven, clinician-referred, registry-based, or claims-based identification.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason Code' ;
    rdfs:comment 'Coded reason for the patient\'s inclusion in the cohort, typically referencing a diagnosis code (ICD-10), risk factor, or qualifying clinical criterion.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason Description' ;
    rdfs:comment 'Human-readable narrative describing why the patient qualifies for cohort membership, including clinical criteria met or risk factors identified.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicianOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Clinician Override Flag' ;
    rdfs:comment 'Indicates whether a clinician manually overrode the algorithmic cohort assignment decision (either to include or exclude the patient).' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cohortPriorityRank rdf:type rdf:Property ;
    rdfs:label 'Cohort Priority Rank' ;
    rdfs:comment 'Numeric rank indicating the patient\'s priority within the cohort for outreach and intervention, with lower numbers indicating higher priority.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:comorbidityCount rdf:type rdf:Property ;
    rdfs:label 'Comorbidity Count' ;
    rdfs:comment 'Number of comorbid conditions identified for the patient at the time of cohort assessment, influencing care complexity and resource needs.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysSinceLastEncounter rdf:type rdf:Property ;
    rdfs:label 'Days Since Last Encounter' ;
    rdfs:comment 'Number of days elapsed since the patient\'s last clinical encounter related to the cohort condition, used for lost-to-follow-up identification.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:edUtilizationFlag rdf:type rdf:Property ;
    rdfs:label 'Ed Utilization Flag' ;
    rdfs:comment 'Indicates whether the patient has had emergency department visits related to the cohort condition during the current measurement period.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:engagementLevel rdf:type rdf:Property ;
    rdfs:label 'Engagement Level' ;
    rdfs:comment 'Assessment of the patient\'s level of engagement with the cohort\'s care management program, based on response to outreach and adherence to care plans.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospitalizationFlag rdf:type rdf:Property ;
    rdfs:label 'Hospitalization Flag' ;
    rdfs:comment 'Indicates whether the patient has had inpatient hospitalizations related to the cohort condition during the current measurement period.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastEncounterDate rdf:type rdf:Property ;
    rdfs:label 'Last Encounter Date' ;
    rdfs:comment 'Date of the patient\'s most recent clinical encounter relevant to the cohort condition, used to identify patients overdue for follow-up.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastRiskAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Risk Assessment Date' ;
    rdfs:comment 'Date of the most recent risk score calculation or clinical risk assessment for this patient within the cohort.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End Date' ;
    rdfs:comment 'End date of the current quality measurement period applicable to this cohort membership.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start Date' ;
    rdfs:comment 'Start date of the current quality measurement period applicable to this cohort membership, aligning with HEDIS or CMS reporting cycles.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicationAdherencePct rdf:type rdf:Property ;
    rdfs:label 'Medication Adherence Pct' ;
    rdfs:comment 'Proportion of days covered (PDC) for prescribed medications related to the cohort condition, a key quality measure for chronic disease management.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Model Confidence Score' ;
    rdfs:comment 'Confidence score (0-1) from the AI/ML model that identified this patient for cohort membership, supporting clinical validation and threshold tuning.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextScheduledOutreachDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Outreach Date' ;
    rdfs:comment 'Date of the next planned care management outreach or follow-up contact for this patient within the cohort.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualifyingConditionCode rdf:type rdf:Property ;
    rdfs:label 'Qualifying Condition Code' ;
    rdfs:comment 'Primary ICD-10-CM diagnosis code that qualifies the patient for cohort membership, representing the principal clinical condition being managed.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMeasureCompliancePct rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Compliance Pct' ;
    rdfs:comment 'Percentage of applicable quality measures for which the patient is compliant within the cohort\'s measure set, supporting HEDIS and MIPS reporting.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskScoreAtEnrollment rdf:type rdf:Property ;
    rdfs:label 'Risk Score At Enrollment' ;
    rdfs:comment 'Patient\'s calculated risk score at the time of cohort enrollment, used to stratify patients within the cohort for care management prioritization.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sdohRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Sdoh Risk Flag' ;
    rdfs:comment 'Indicates whether the patient has identified social determinants of health risk factors (housing instability, food insecurity, transportation barriers) that may impact cohort outcomes.' ;
    rdfs:domain ind:PopulationCohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalAiPopulationHealthCohortManagementId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Cohort Management Id' ;
    rdfs:comment 'Primary key for clinical_ai_population_health_cohort_management' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:biasAssessmentCompleted rdf:type rdf:Property ;
    rdfs:label 'Bias Assessment Completed' ;
    rdfs:comment 'Indicates whether an algorithmic bias assessment has been completed for the cohort definition criteria to ensure equitable patient identification across demographic groups.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalAiPopulationHealthCohortManagementStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Cohort Management Status' ;
    rdfs:comment 'Current lifecycle state of the cohort definition indicating whether it is actively being used for patient identification and care management.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deIdentificationLevel rdf:type rdf:Property ;
    rdfs:label 'De Identification Level' ;
    rdfs:comment 'Level of patient de-identification applied to cohort data when shared externally or used for research purposes.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:definitionVersion rdf:type rdf:Property ;
    rdfs:label 'Definition Version' ;
    rdfs:comment 'Semantic version number of the cohort definition criteria, supporting SCD Type 2 tracking of definition changes over time.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapClosureRatePercent rdf:type rdf:Property ;
    rdfs:label 'Gap Closure Rate Percent' ;
    rdfs:comment 'Percentage of identified care gaps that have been closed for members of this cohort, measuring intervention effectiveness.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelGovernanceStatus rdf:type rdf:Property ;
    rdfs:label 'Model Governance Status' ;
    rdfs:comment 'Governance approval status of the AI/ML model or algorithm used to define or score this cohort, ensuring responsible AI practices.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledRefresh rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Refresh' ;
    rdfs:comment 'Timestamp when the next cohort membership recalculation is scheduled to execute based on the defined refresh frequency.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:notificationEnabled rdf:type rdf:Property ;
    rdfs:label 'Notification Enabled' ;
    rdfs:comment 'Indicates whether automated notifications are sent to care teams when patients enter or exit this cohort, supporting proactive care management.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcomeCurrentValue rdf:type rdf:Property ;
    rdfs:label 'Outcome Current Value' ;
    rdfs:comment 'Most recently calculated value of the primary outcome measure for this cohort, enabling performance tracking against targets.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outcomeMeasureName rdf:type rdf:Property ;
    rdfs:label 'Outcome Measure Name' ;
    rdfs:comment 'Primary clinical or operational outcome measure tracked for this cohort, such as HbA1c control rate, readmission rate, or ED utilization.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeTargetValue rdf:type rdf:Property ;
    rdfs:label 'Outcome Target Value' ;
    rdfs:comment 'Target value for the primary outcome measure that defines success for this cohort\'s population health intervention.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payerLineOfBusiness rdf:type rdf:Property ;
    rdfs:label 'Payer Line Of Business' ;
    rdfs:comment 'Insurance line of business filter applied to cohort membership, enabling payer-specific population health strategies and value-based contract alignment.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStratificationModel rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Model' ;
    rdfs:comment 'Name or identifier of the AI/ML risk stratification model used to score and segment patients within this cohort for care prioritization.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetMemberCount rdf:type rdf:Property ;
    rdfs:label 'Target Member Count' ;
    rdfs:comment 'Expected or planned number of patients for this cohort based on epidemiological estimates, used to identify under-identification of at-risk populations.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetPopulationDescription rdf:type rdf:Property ;
    rdfs:label 'Target Population Description' ;
    rdfs:comment 'Narrative description of the intended patient population for this cohort, providing clinical context for care managers and analysts.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientTrialMatchId rdf:type rdf:Property ;
    rdfs:label 'Patient Trial Match Id' ;
    rdfs:comment 'Primary key for patient_trial_match' ;
    rdfs:domain ind:PatientTrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientPrincipalInvestigatorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Patient Principal Investigator Clinician Id' ;
    rdfs:comment 'Identifier of the principal investigator responsible for the clinical trial at the site.' ;
    rdfs:domain ind:PatientTrialMatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:distanceToSiteMiles rdf:type rdf:Property ;
    rdfs:label 'Distance To Site Miles' ;
    rdfs:comment 'Calculated distance in miles between the patient\'s residence and the trial site, used to assess feasibility of participation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibilityDeterminationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Eligibility Determination Timestamp' ;
    rdfs:comment 'Timestamp when the final eligibility determination was made for this patient-trial combination.' ;
    rdfs:domain ind:PatientTrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isDiversityCandidate rdf:type rdf:Property ;
    rdfs:label 'Is Diversity Candidate' ;
    rdfs:comment 'Indicates whether the patient contributes to the trial\'s diversity enrollment goals as required by FDA guidance on clinical trial diversity.' ;
    rdfs:domain ind:PatientTrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReScreeningAllowed rdf:type rdf:Property ;
    rdfs:label 'Is Re Screening Allowed' ;
    rdfs:comment 'Indicates whether the patient is permitted to be re-screened for this trial after an initial screen failure, per protocol allowances.' ;
    rdfs:domain ind:PatientTrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isScreenFailure rdf:type rdf:Property ;
    rdfs:label 'Is Screen Failure' ;
    rdfs:comment 'Indicates whether the patient failed the screening process after initial match identification, meaning they did not proceed to enrollment.' ;
    rdfs:domain ind:PatientTrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchIdentifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Match Identified Timestamp' ;
    rdfs:comment 'Timestamp when the patient was first identified as a potential match for the clinical trial, representing the business event time.' ;
    rdfs:domain ind:PatientTrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:patientNotifiedDate rdf:type rdf:Property ;
    rdfs:label 'Patient Notified Date' ;
    rdfs:comment 'Date on which the patient was informed about the potential clinical trial opportunity.' ;
    rdfs:domain ind:PatientTrialMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screenFailureReason rdf:type rdf:Property ;
    rdfs:label 'Screen Failure Reason' ;
    rdfs:comment 'Specific clinical or administrative reason for screen failure, used for reporting and process improvement.' ;
    rdfs:domain ind:ClinicalTrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequencingDataId rdf:type rdf:Property ;
    rdfs:label 'Sequencing Data Id' ;
    rdfs:comment 'Primary key for sequencing_data' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alignerSoftware rdf:type rdf:Property ;
    rdfs:label 'Aligner Software' ;
    rdfs:comment 'Software tool and version used for read alignment (e.g., BWA-MEM2 v2.2.1, STAR v2.7.10).' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analysisCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Analysis Completion Timestamp' ;
    rdfs:comment 'Timestamp when the bioinformatics analysis pipeline completed processing for this sample.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:captureKit rdf:type rdf:Property ;
    rdfs:label 'Capture Kit' ;
    rdfs:comment 'The hybridization capture kit or panel used for targeted sequencing (e.g., Agilent SureSelect, IDT xGen).' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataFilePath rdf:type rdf:Property ;
    rdfs:label 'Data File Path' ;
    rdfs:comment 'Storage location path for the primary sequencing data files (FASTQ, BAM, CRAM) in the institutional data lake or object store.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateRatePercent rdf:type rdf:Property ;
    rdfs:label 'Duplicate Rate Percent' ;
    rdfs:comment 'Percentage of reads identified as PCR or optical duplicates, indicating library complexity and potential bias.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fileSizeGb rdf:type rdf:Property ;
    rdfs:label 'File Size Gb' ;
    rdfs:comment 'Total file size of the sequencing data output in gigabytes, relevant for storage planning and data transfer.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gcBiasPercent rdf:type rdf:Property ;
    rdfs:label 'Gc Bias Percent' ;
    rdfs:comment 'Measure of GC content bias in the sequencing data, which can affect coverage uniformity.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insertSizeMeanBp rdf:type rdf:Property ;
    rdfs:label 'Insert Size Mean Bp' ;
    rdfs:comment 'Average insert size of the sequencing library fragments in base pairs, a library quality metric.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:instrumentModel rdf:type rdf:Property ;
    rdfs:label 'Instrument Model' ;
    rdfs:comment 'Specific model of the sequencing instrument used (e.g., NovaSeq 6000, HiSeq X, MinION).' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laneNumber rdf:type rdf:Property ;
    rdfs:label 'Lane Number' ;
    rdfs:comment 'The lane number on the flow cell where this sample was sequenced, relevant for quality control and demultiplexing.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meanBaseQualityScore rdf:type rdf:Property ;
    rdfs:label 'Mean Base Quality Score' ;
    rdfs:comment 'Average Phred quality score across all bases in the sequencing run, indicating base call accuracy.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:onTargetRatePercent rdf:type rdf:Property ;
    rdfs:label 'On Target Rate Percent' ;
    rdfs:comment 'Percentage of mapped reads that fall within the intended target regions, relevant for panel and exome sequencing efficiency.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentBasesAbove30x rdf:type rdf:Property ;
    rdfs:label 'Percent Bases Above 30x' ;
    rdfs:comment 'Percentage of targeted bases with at least 30x coverage depth, a clinical adequacy threshold for variant calling.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentQ30Bases rdf:type rdf:Property ;
    rdfs:label 'Percent Q30 Bases' ;
    rdfs:comment 'Percentage of bases with a Phred quality score of 30 or higher (99.9% accuracy), a standard sequencing quality metric.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readsMapped rdf:type rdf:Property ;
    rdfs:label 'Reads Mapped' ;
    rdfs:comment 'Number of reads that successfully aligned to the reference genome after bioinformatics processing.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sampleCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Sample Collection Date' ;
    rdfs:comment 'Date when the biological sample was collected from the patient.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sequencingCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sequencing Completion Timestamp' ;
    rdfs:comment 'Timestamp when the sequencing instrument run completed for this sample.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sequencingDataStatus rdf:type rdf:Property ;
    rdfs:label 'Sequencing Data Status' ;
    rdfs:comment 'Current lifecycle status of the sequencing data record from order through completion.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequencingStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sequencing Start Timestamp' ;
    rdfs:comment 'Timestamp when the sequencing instrument run began for this sample.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sequencingType rdf:type rdf:Property ;
    rdfs:label 'Sequencing Type' ;
    rdfs:comment 'Classification of the genomic sequencing methodology used for this run.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tissueSource rdf:type rdf:Property ;
    rdfs:label 'Tissue Source' ;
    rdfs:comment 'Anatomical site or tissue type from which the sample was obtained (e.g., blood, bone marrow, lung biopsy).' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalYieldGb rdf:type rdf:Property ;
    rdfs:label 'Total Yield Gb' ;
    rdfs:comment 'Total sequencing data yield in gigabases generated for this sample.' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variantCallerSoftware rdf:type rdf:Property ;
    rdfs:label 'Variant Caller Software' ;
    rdfs:comment 'Software tool and version used for variant calling (e.g., GATK HaplotypeCaller v4.4, DeepVariant v1.5).' ;
    rdfs:domain ind:SequencingData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchGrantRecordId rdf:type rdf:Property ;
    rdfs:label 'Research Grant Record Id' ;
    rdfs:comment 'Primary key for research_grant_record' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awardDate rdf:type rdf:Property ;
    rdfs:label 'Award Date' ;
    rdfs:comment 'Date on which the grant was officially awarded by the funding agency, establishing the formal start of the award relationship.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetPeriodNumber rdf:type rdf:Property ;
    rdfs:label 'Budget Period Number' ;
    rdfs:comment 'Current budget period (year) number within the total project period (e.g., year 3 of a 5-year grant).' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cfdaNumber rdf:type rdf:Property ;
    rdfs:label 'Cfda Number' ;
    rdfs:comment 'Federal program identification number from the Assistance Listings (formerly CFDA) used for federal grant tracking and Single Audit compliance.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalTrialFlag rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Flag' ;
    rdfs:comment 'Indicates whether the grant funds a clinical trial as defined by NIH, requiring registration on ClinicalTrials.gov.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closeoutDate rdf:type rdf:Property ;
    rdfs:label 'Closeout Date' ;
    rdfs:comment 'Date on which the grant was formally closed out with all final reports submitted and financial reconciliation completed.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conflictOfInterestDisclosed rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Disclosed' ;
    rdfs:comment 'Indicates whether all required financial conflict of interest disclosures have been completed for key personnel on this grant.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costSharingAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Amount' ;
    rdfs:comment 'Total institutional cost sharing or matching funds committed to the grant as required by the sponsor.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costSharingRequired rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Required' ;
    rdfs:comment 'Indicates whether the grant requires mandatory cost sharing or matching funds from the institution as a condition of the award.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currentYearBudget rdf:type rdf:Property ;
    rdfs:label 'Current Year Budget' ;
    rdfs:comment 'Approved budget amount for the current fiscal/budget year of the grant, representing the annual funding allocation.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataSharingPlanRequired rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Plan Required' ;
    rdfs:comment 'Indicates whether the grant requires a data management and sharing plan per NIH DMS Policy or sponsor requirements.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:directCostAmount rdf:type rdf:Property ;
    rdfs:label 'Direct Cost Amount' ;
    rdfs:comment 'Total direct costs budgeted for the grant, including personnel, supplies, equipment, travel, and other costs directly attributable to the research project.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effortPercentPi rdf:type rdf:Property ;
    rdfs:label 'Effort Percent Pi' ;
    rdfs:comment 'Percentage of the principal investigator\'s professional effort committed to this grant, used for effort reporting and salary cap compliance.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fdaRegulated rdf:type rdf:Property ;
    rdfs:label 'Fda Regulated' ;
    rdfs:comment 'Indicates whether the research involves FDA-regulated products (drugs, devices, biologics) requiring IND/IDE compliance.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingAgencyName rdf:type rdf:Property ;
    rdfs:label 'Funding Agency Name' ;
    rdfs:comment 'Name of the external organization or government agency providing the grant funding (e.g., NIH, NSF, AHRQ, PCORI, private foundation).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingMechanism rdf:type rdf:Property ;
    rdfs:label 'Funding Mechanism' ;
    rdfs:comment 'Specific funding mechanism or activity code under which the grant is awarded (e.g., R01, R21, U01, K23, T32, P30). Determines allowable costs and reporting requirements.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantAccountCode rdf:type rdf:Property ;
    rdfs:label 'Grant Account Code' ;
    rdfs:comment 'Internal financial account code or fund code assigned to the grant in the institution\'s general ledger for expenditure tracking.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantNumber rdf:type rdf:Property ;
    rdfs:label 'Grant Number' ;
    rdfs:comment 'Externally-assigned unique grant identifier issued by the funding agency (e.g., NIH grant number, NSF award number). Used for regulatory reporting and financial tracking.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:humanSubjectsInvolved rdf:type rdf:Property ;
    rdfs:label 'Human Subjects Involved' ;
    rdfs:comment 'Indicates whether the research involves human subjects, triggering IRB oversight and informed consent requirements.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:iacucProtocolNumber rdf:type rdf:Property ;
    rdfs:label 'Iacuc Protocol Number' ;
    rdfs:comment 'IACUC protocol number for animal research conducted under this grant, required for compliance with PHS Policy on Humane Care.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indirectCostAmount rdf:type rdf:Property ;
    rdfs:label 'Indirect Cost Amount' ;
    rdfs:comment 'Total indirect (F&A) costs budgeted for the grant, representing institutional overhead recovery for facilities and administration.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:multiSiteFlag rdf:type rdf:Property ;
    rdfs:label 'Multi Site Flag' ;
    rdfs:comment 'Indicates whether the research is conducted across multiple institutional sites, requiring coordinated oversight.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noCostExtensionEndDate rdf:type rdf:Property ;
    rdfs:label 'No Cost Extension End Date' ;
    rdfs:comment 'Extended end date granted through a no-cost extension, allowing additional time to complete research without additional funding.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patentFiledCount rdf:type rdf:Property ;
    rdfs:label 'Patent Filed Count' ;
    rdfs:comment 'Number of patent applications filed as a result of inventions made under this grant, tracked for Bayh-Dole Act compliance.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:publicationCount rdf:type rdf:Property ;
    rdfs:label 'Publication Count' ;
    rdfs:comment 'Number of peer-reviewed publications resulting from research funded by this grant, used for productivity tracking and reporting.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:researchCategory rdf:type rdf:Property ;
    rdfs:label 'Research Category' ;
    rdfs:comment 'Classification of the research type funded by the grant, used for institutional reporting and strategic research portfolio analysis.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapApplicable rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Applicable' ;
    rdfs:comment 'Indicates whether the NIH or sponsor salary cap applies to personnel costs on this grant, affecting allowable compensation charges.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorAwardNumber rdf:type rdf:Property ;
    rdfs:label 'Sponsor Award Number' ;
    rdfs:comment 'Award number assigned by the sponsoring agency, which may differ from the internal grant number. Used for external correspondence and compliance reporting.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrecipientFlag rdf:type rdf:Property ;
    rdfs:label 'Subrecipient Flag' ;
    rdfs:comment 'Indicates whether the grant includes subawards to other institutions, triggering additional monitoring and reporting requirements.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalAwardedAmount rdf:type rdf:Property ;
    rdfs:label 'Total Awarded Amount' ;
    rdfs:comment 'Total monetary value awarded by the funding agency for the entire project period across all budget years.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalProjectPeriods rdf:type rdf:Property ;
    rdfs:label 'Total Project Periods' ;
    rdfs:comment 'Total number of budget periods (years) approved for the grant project, defining the overall project duration.' ;
    rdfs:domain ind:ResearchGrantRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalTrialMatchingTrialEligibilityCriteriaId rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Matching Trial Eligibility Criteria Id' ;
    rdfs:comment 'Primary key for clinical_trial_matching_trial_eligibility_criteria' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:automationConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Automation Confidence Score' ;
    rdfs:comment 'Confidence score (0.0000 to 1.0000) indicating the reliability of automated evaluation for this criterion based on data availability and matching algorithm performance.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:comparisonOperator rdf:type rdf:Property ;
    rdfs:label 'Comparison Operator' ;
    rdfs:comment 'The logical comparison operator used to evaluate the criterion against patient data (equals, not equals, greater than, greater than or equal, less than, less than or equal).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criterionCode rdf:type rdf:Property ;
    rdfs:label 'Criterion Code' ;
    rdfs:comment 'Unique business code identifying this specific eligibility criterion within the trial protocol, used for cross-referencing with protocol documents.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criterionDescription rdf:type rdf:Property ;
    rdfs:label 'Criterion Description' ;
    rdfs:comment 'Detailed narrative description of the eligibility criterion as stated in the clinical trial protocol, including any qualifying conditions or exceptions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criterionStatus rdf:type rdf:Property ;
    rdfs:label 'Criterion Status' ;
    rdfs:comment 'Current lifecycle status of this eligibility criterion indicating whether it is actively used for patient matching.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criterionTitle rdf:type rdf:Property ;
    rdfs:label 'Criterion Title' ;
    rdfs:comment 'Short human-readable title summarizing the eligibility criterion for display in matching interfaces and protocol summaries.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationLogicExpression rdf:type rdf:Property ;
    rdfs:label 'Evaluation Logic Expression' ;
    rdfs:comment 'Machine-readable logical expression or rule defining how this criterion is computationally evaluated against patient data (e.g., CQL or FHIR PathExpression).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirSearchParameter rdf:type rdf:Property ;
    rdfs:label 'Fhir Search Parameter' ;
    rdfs:comment 'The FHIR search parameter expression used to query patient data for this criterion evaluation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupLogicalOperator rdf:type rdf:Property ;
    rdfs:label 'Group Logical Operator' ;
    rdfs:comment 'The logical operator (AND, OR, NOT) defining how this criterion combines with other criteria in the same group.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Irb Approval Required' ;
    rdfs:comment 'Indicates whether changes to this criterion require separate IRB approval before implementation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAutomatable rdf:type rdf:Property ;
    rdfs:label 'Is Automatable' ;
    rdfs:comment 'Indicates whether this criterion can be automatically evaluated against structured EHR data without manual clinical review.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:naturalLanguageText rdf:type rdf:Property ;
    rdfs:label 'Natural Language Text' ;
    rdfs:comment 'The original free-text eligibility criterion as written in the trial protocol, prior to structured decomposition, used for NLP-based matching and audit trail.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceProtocolSection rdf:type rdf:Property ;
    rdfs:label 'Source Protocol Section' ;
    rdfs:comment 'Reference to the specific section or page of the trial protocol document from which this criterion was extracted.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorCriterionCode rdf:type rdf:Property ;
    rdfs:label 'Sponsor Criterion Code' ;
    rdfs:comment 'The trial sponsors original identifier or reference number for this criterion as provided in the sponsor protocol package.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDataElement rdf:type rdf:Property ;
    rdfs:label 'Target Data Element' ;
    rdfs:comment 'The specific EHR data element or clinical observation that must be evaluated to assess this criterion (e.g., hemoglobin A1c, ejection fraction, tumor stage).' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdLowerBound rdf:type rdf:Property ;
    rdfs:label 'Threshold Lower Bound' ;
    rdfs:comment 'The lower numeric boundary for range-based criteria evaluation (e.g., minimum age, minimum lab value).' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdUpperBound rdf:type rdf:Property ;
    rdfs:label 'Threshold Upper Bound' ;
    rdfs:comment 'The upper numeric boundary for range-based criteria evaluation (e.g., maximum age, maximum lab value).' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverAllowed rdf:type rdf:Property ;
    rdfs:label 'Waiver Allowed' ;
    rdfs:comment 'Indicates whether the principal investigator may grant a waiver for this criterion under documented clinical justification.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverJustificationRequired rdf:type rdf:Property ;
    rdfs:label 'Waiver Justification Required' ;
    rdfs:comment 'Indicates whether a documented justification must be provided when a waiver is granted for this criterion.' ;
    rdfs:domain ind:ClinicalTrialMatchingTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sequenceDataId rdf:type rdf:Property ;
    rdfs:label 'Sequence Data Id' ;
    rdfs:comment 'Primary key for sequence_data' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicallySignificantVariants rdf:type rdf:Property ;
    rdfs:label 'Clinically Significant Variants' ;
    rdfs:comment 'Number of variants classified as pathogenic or likely pathogenic per ACMG guidelines that have clinical significance for patient care.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dnaConcentrationNgUl rdf:type rdf:Property ;
    rdfs:label 'Dna Concentration Ng Ul' ;
    rdfs:comment 'Concentration of extracted DNA in nanograms per microliter, used to assess specimen adequacy for sequencing.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:duplicateReadsPercent rdf:type rdf:Property ;
    rdfs:label 'Duplicate Reads Percent' ;
    rdfs:comment 'Percentage of reads identified as PCR or optical duplicates, which are excluded from variant calling to avoid bias.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gcContentPercent rdf:type rdf:Property ;
    rdfs:label 'Gc Content Percent' ;
    rdfs:comment 'Percentage of guanine-cytosine bases in the sequenced data, used to assess potential sequencing bias.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geneticCounselorReviewed rdf:type rdf:Property ;
    rdfs:label 'Genetic Counselor Reviewed' ;
    rdfs:comment 'Indicates whether a certified genetic counselor has reviewed the sequencing results prior to reporting to the patient.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:libraryPrepMethod rdf:type rdf:Property ;
    rdfs:label 'Library Prep Method' ;
    rdfs:comment 'Method used for sequencing library preparation (e.g., PCR-based, hybrid capture, amplicon-based), which affects coverage uniformity and bias.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onTargetPercent rdf:type rdf:Property ;
    rdfs:label 'On Target Percent' ;
    rdfs:comment 'Percentage of reads that map to the intended target regions for panel or exome sequencing, indicating capture efficiency.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallResultClassification rdf:type rdf:Property ;
    rdfs:label 'Overall Result Classification' ;
    rdfs:comment 'High-level classification of the sequencing result indicating whether clinically actionable findings were identified.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:q30Percent rdf:type rdf:Property ;
    rdfs:label 'Q30 Percent' ;
    rdfs:comment 'Percentage of bases with a Phred quality score of 30 or higher (99.9% base call accuracy), a key quality metric for sequencing data.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resultReportedDate rdf:type rdf:Property ;
    rdfs:label 'Result Reported Date' ;
    rdfs:comment 'Date when the final sequencing results were reported and made available to the ordering provider.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:runCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run Completion Timestamp' ;
    rdfs:comment 'Timestamp when the sequencing instrument run completed data generation.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sequencingStatus rdf:type rdf:Property ;
    rdfs:label 'Sequencing Status' ;
    rdfs:comment 'Current lifecycle status of the genomic sequencing workflow from order through completion or failure.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalVariantsDetected rdf:type rdf:Property ;
    rdfs:label 'Total Variants Detected' ;
    rdfs:comment 'Total number of genomic variants identified in the sequencing analysis, including SNVs, indels, and structural variants.' ;
    rdfs:domain ind:SequenceData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:databricksGovernanceDeltaTblproperties2Id rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Delta Tblproperties2 Id' ;
    rdfs:comment 'Primary key for databricks_governance_delta_tblproperties2' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:databricksGovernanceDeltaTblproperties2Status rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Delta Tblproperties2 Status' ;
    rdfs:comment 'Current status of this table property configuration record.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domainName rdf:type rdf:Property ;
    rdfs:label 'Domain Name' ;
    rdfs:comment 'The healthcare business domain this table belongs to (e.g., patient, encounter, clinical, billing, pharmacy) for governance and ownership tracking.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDriftDetected rdf:type rdf:Property ;
    rdfs:label 'Is Drift Detected' ;
    rdfs:comment 'Indicates whether a discrepancy was detected between the configured property value and the actual Delta table property during the last validation.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLiquidClusteringEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Liquid Clustering Enabled' ;
    rdfs:comment 'Indicates whether liquid clustering is enabled for this Delta table to support automatic data layout optimization.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRlsEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Rls Enabled' ;
    rdfs:comment 'Indicates whether row-level security predicates are actively enforced on this Delta table.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetFileSizeBytes rdf:type rdf:Property ;
    rdfs:label 'Target File Size Bytes' ;
    rdfs:comment 'Target file size in bytes for Delta optimize operations, balancing read performance with write amplification.' ;
    rdfs:domain ind:DatabricksGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sequenceId rdf:type rdf:Property ;
    rdfs:label 'Sequence Id' ;
    rdfs:comment 'Primary key for sequence' ;
    rdfs:domain ind:Sequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorSequenceId rdf:type rdf:Property ;
    rdfs:label 'Prior Sequence Id' ;
    rdfs:comment 'Reference to the original sequence record when this is a repeat run, enabling lineage tracking.' ;
    rdfs:domain ind:Sequence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Sequence .

ind:externalAccessionNumber rdf:type rdf:Property ;
    rdfs:label 'External Accession Number' ;
    rdfs:comment 'Accession identifier assigned by an external reference laboratory or genomic testing vendor (e.g., Foundation Medicine, Tempus, Guardant).' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneCount rdf:type rdf:Property ;
    rdfs:label 'Gene Count' ;
    rdfs:comment 'Number of genes covered by the sequencing panel or assay.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nucleicAcidType rdf:type rdf:Property ;
    rdfs:label 'Nucleic Acid Type' ;
    rdfs:comment 'Type of nucleic acid extracted and sequenced (DNA, RNA, cell-free DNA, or circulating tumor DNA).' ;
    rdfs:domain ind:Sequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readDepthMean rdf:type rdf:Property ;
    rdfs:label 'Read Depth Mean' ;
    rdfs:comment 'Average sequencing read depth (coverage) across all targeted regions, indicating data quality and confidence level.' ;
    rdfs:domain ind:Sequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readDepthMinimum rdf:type rdf:Property ;
    rdfs:label 'Read Depth Minimum' ;
    rdfs:comment 'Minimum sequencing read depth observed across targeted regions, used to assess coverage uniformity.' ;
    rdfs:domain ind:Sequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sequenceStatus rdf:type rdf:Property ;
    rdfs:label 'Sequence Status' ;
    rdfs:comment 'Current lifecycle status of the genomic sequence from order through completion or failure.' ;
    rdfs:domain ind:Sequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assayId rdf:type rdf:Property ;
    rdfs:label 'Assay Id' ;
    rdfs:comment 'Primary key for assay' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assayCode rdf:type rdf:Property ;
    rdfs:label 'Assay Code' ;
    rdfs:comment 'Externally-known unique alphanumeric code identifying this assay in laboratory information systems and order catalogs.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assayDescription rdf:type rdf:Property ;
    rdfs:label 'Assay Description' ;
    rdfs:comment 'Detailed narrative description of the assay purpose, scope, and clinical utility for ordering providers and patients.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assayName rdf:type rdf:Property ;
    rdfs:label 'Assay Name' ;
    rdfs:comment 'Human-readable name of the genomic assay as displayed in clinical ordering systems and reports.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assayStatus rdf:type rdf:Property ;
    rdfs:label 'Assay Status' ;
    rdfs:comment 'Current lifecycle state of the assay indicating whether it is available for clinical ordering.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capAccreditationRequired rdf:type rdf:Property ;
    rdfs:label 'Cap Accreditation Required' ;
    rdfs:comment 'Indicates whether performing this assay requires CAP laboratory accreditation.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fdaClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Fda Clearance Status' ;
    rdfs:comment 'FDA regulatory clearance or approval status. LDT indicates laboratory-developed test not requiring FDA clearance.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurancePriorAuthRequired rdf:type rdf:Property ;
    rdfs:label 'Insurance Prior Auth Required' ;
    rdfs:comment 'Indicates whether most insurance payers require prior authorization before this assay can be ordered.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpretationGuideline rdf:type rdf:Property ;
    rdfs:label 'Interpretation Guideline' ;
    rdfs:comment 'Clinical interpretation framework applied to variants detected by this assay (e.g., ACMG/AMP 2015 guidelines).' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isResearchUseOnly rdf:type rdf:Property ;
    rdfs:label 'Is Research Use Only' ;
    rdfs:comment 'Indicates whether this assay is designated for research use only (RUO) and not for clinical diagnostic purposes.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:limitations rdf:type rdf:Property ;
    rdfs:label 'Limitations' ;
    rdfs:comment 'Known analytical and clinical limitations of the assay that must be communicated in the test report.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:listPrice rdf:type rdf:Property ;
    rdfs:label 'List Price' ;
    rdfs:comment 'Standard list price for performing this assay before insurance adjustments or contractual discounts.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumCoverageDepth rdf:type rdf:Property ;
    rdfs:label 'Minimum Coverage Depth' ;
    rdfs:comment 'Minimum sequencing read depth required across target regions to meet quality standards for clinical reporting.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumDnaInputNg rdf:type rdf:Property ;
    rdfs:label 'Minimum Dna Input Ng' ;
    rdfs:comment 'Minimum quantity of extracted DNA required to perform the assay, measured in nanograms.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proficiencyTestingProgram rdf:type rdf:Property ;
    rdfs:label 'Proficiency Testing Program' ;
    rdfs:comment 'External proficiency testing program in which the laboratory participates for this assay (e.g., CAP Surveys, ACMG PT).' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reflexTestingAvailable rdf:type rdf:Property ;
    rdfs:label 'Reflex Testing Available' ;
    rdfs:comment 'Indicates whether this assay supports automatic reflex testing to confirmatory or expanded panels based on initial findings.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportableVariantClasses rdf:type rdf:Property ;
    rdfs:label 'Reportable Variant Classes' ;
    rdfs:comment 'Comma-separated list of variant classes this assay is validated to detect and report (e.g., SNV, indel, CNV, fusion, MSI).' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensitivityThreshold rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Threshold' ;
    rdfs:comment 'Validated analytical sensitivity (detection rate) of the assay expressed as a decimal fraction (e.g., 0.9950 for 99.50%).' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specificityThreshold rdf:type rdf:Property ;
    rdfs:label 'Specificity Threshold' ;
    rdfs:comment 'Validated analytical specificity (true negative rate) of the assay expressed as a decimal fraction.' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetRegionSizeKb rdf:type rdf:Property ;
    rdfs:label 'Target Region Size Kb' ;
    rdfs:comment 'Total size of the genomic target region covered by the assay, measured in kilobases (kb).' ;
    rdfs:domain ind:Assay ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validationDate rdf:type rdf:Property ;
    rdfs:label 'Validation Date' ;
    rdfs:comment 'Date on which the assay completed analytical and clinical validation and was approved for clinical use.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:genomicsClinicianId rdf:type rdf:Property ;
    rdfs:label 'Genomics Clinician Id' ;
    rdfs:comment 'Identifier of the provider who ordered the genomic test.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:genomicsInterpretingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Genomics Interpreting Provider Clinician Id' ;
    rdfs:comment 'Identifier of the clinical geneticist or molecular pathologist who interpreted and signed out the genomics report.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:actionableFindingFlag rdf:type rdf:Property ;
    rdfs:label 'Actionable Finding Flag' ;
    rdfs:comment 'Indicates whether the report contains clinically actionable findings that may influence treatment decisions or clinical management.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalLabReportReference rdf:type rdf:Property ;
    rdfs:label 'External Lab Report Reference' ;
    rdfs:comment 'Report identifier assigned by an external reference laboratory (e.g., Foundation Medicine, Tempus, Guardant Health) when testing is performed externally.' ;
    rdfs:domain ind:GenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicsReportStatus rdf:type rdf:Property ;
    rdfs:label 'Genomics Report Status' ;
    rdfs:comment 'Current lifecycle status of the genomics report indicating its clinical validity and completeness.' ;
    rdfs:domain ind:GenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pdfDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Pdf Document Url' ;
    rdfs:comment 'Storage location or URL reference to the full PDF version of the genomics report for clinical review.' ;
    rdfs:domain ind:GenomicsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phenotypeAssociationId rdf:type rdf:Property ;
    rdfs:label 'Phenotype Association Id' ;
    rdfs:comment 'Primary key for phenotype_association' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ancestryGroup rdf:type rdf:Property ;
    rdfs:label 'Ancestry Group' ;
    rdfs:comment 'Population or ancestry group in which this phenotype association was characterized or is most prevalent.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assertionMethod rdf:type rdf:Property ;
    rdfs:label 'Assertion Method' ;
    rdfs:comment 'Method or guideline framework used to assert the clinical significance (e.g., ACMG 2015 criteria, ClinGen SOP).' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associationType rdf:type rdf:Property ;
    rdfs:label 'Association Type' ;
    rdfs:comment 'Classification of the relationship between the variant and the phenotype.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionIcd10Code rdf:type rdf:Property ;
    rdfs:label 'Condition Icd10 Code' ;
    rdfs:comment 'ICD-10 diagnosis code corresponding to the clinical condition or phenotype in this association.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceIntervalLower rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Lower' ;
    rdfs:comment 'Lower bound of the 95% confidence interval for the odds ratio or effect size.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceIntervalUpper rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Upper' ;
    rdfs:comment 'Upper bound of the 95% confidence interval for the odds ratio or effect size.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curationSource rdf:type rdf:Property ;
    rdfs:label 'Curation Source' ;
    rdfs:comment 'Organization or consortium that curated this association (e.g., ClinGen, OMIM, institutional lab).' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diseaseMechanism rdf:type rdf:Property ;
    rdfs:label 'Disease Mechanism' ;
    rdfs:comment 'Molecular mechanism by which the variant leads to the associated phenotype.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalImpactPredictor rdf:type rdf:Property ;
    rdfs:label 'Functional Impact Predictor' ;
    rdfs:comment 'Name of the in-silico prediction tool used to generate the functional impact score.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalImpactScore rdf:type rdf:Property ;
    rdfs:label 'Functional Impact Score' ;
    rdfs:comment 'Computational prediction score (e.g., CADD, REVEL) indicating the functional impact of the variant on the gene product.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hpoCode rdf:type rdf:Property ;
    rdfs:label 'Hpo Code' ;
    rdfs:comment 'Standardized HPO term code representing the phenotype in this association.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oddsRatio rdf:type rdf:Property ;
    rdfs:label 'Odds Ratio' ;
    rdfs:comment 'Statistical odds ratio quantifying the strength of association between the variant and phenotype from case-control studies.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:omimNumber rdf:type rdf:Property ;
    rdfs:label 'Omim Number' ;
    rdfs:comment 'OMIM catalog number for the Mendelian condition or phenotype linked to this variant.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onsetCategory rdf:type rdf:Property ;
    rdfs:label 'Onset Category' ;
    rdfs:comment 'Typical age of onset category for the phenotype when associated with this variant. [ENUM-REF-CANDIDATE: prenatal|neonatal|infantile|childhood|juvenile|adult|variable — promote to reference product]' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penetrance rdf:type rdf:Property ;
    rdfs:label 'Penetrance' ;
    rdfs:comment 'Proportion of individuals carrying the variant who express the associated phenotype.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phenotypeCode rdf:type rdf:Property ;
    rdfs:label 'Phenotype Code' ;
    rdfs:comment 'Reference to the clinical phenotype (observable trait or disease) associated with the variant.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationAlleleFrequency rdf:type rdf:Property ;
    rdfs:label 'Population Allele Frequency' ;
    rdfs:comment 'Frequency of the variant allele in the general population or relevant sub-population from gnomAD or similar databases.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pubmedAccession rdf:type rdf:Property ;
    rdfs:label 'Pubmed Accession' ;
    rdfs:comment 'PubMed article identifier for the primary literature citation supporting this association.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceStudyType rdf:type rdf:Property ;
    rdfs:label 'Source Study Type' ;
    rdfs:comment 'Type of research study that established or supports this phenotype-variant association.' ;
    rdfs:domain ind:PhenotypeAssociation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:databricksGovernanceDeltaTblproperties3Id rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Delta Tblproperties3 Id' ;
    rdfs:comment 'Primary key for databricks_governance_delta_tblproperties3' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoOptimizeWriteEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Optimize Write Enabled' ;
    rdfs:comment 'Whether Delta auto-optimize for write operations is enabled, coalescing small files automatically during writes.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:checkpointInterval rdf:type rdf:Property ;
    rdfs:label 'Checkpoint Interval' ;
    rdfs:comment 'Number of Delta commits between automatic checkpoints. Controls metadata read performance for large tables.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:containsPiiFlag rdf:type rdf:Property ;
    rdfs:label 'Contains Pii Flag' ;
    rdfs:comment 'Indicates whether this table contains Personally Identifiable Information requiring enhanced access controls and audit logging.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:databricksGovernanceDeltaTblproperties3Status rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Delta Tblproperties3 Status' ;
    rdfs:comment 'Current status of this TBLPROPERTIES configuration record indicating whether it is actively enforced.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enableDeletionVectors rdf:type rdf:Property ;
    rdfs:label 'Enable Deletion Vectors' ;
    rdfs:comment 'Whether deletion vectors are enabled for this table to improve DELETE/UPDATE/MERGE performance without rewriting entire files.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rlsPolicyName rdf:type rdf:Property ;
    rdfs:label 'Rls Policy Name' ;
    rdfs:comment 'Name of the row-level security policy applied to this table within Unity Catalog for HIPAA minimum necessary access enforcement.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vacuumRetentionHours rdf:type rdf:Property ;
    rdfs:label 'Vacuum Retention Hours' ;
    rdfs:comment 'Number of hours of data file retention before VACUUM can permanently remove unreferenced files. Must align with HIPAA retention requirements for PHI tables.' ;
    rdfs:domain ind:DatabricksGovernanceDeltaTblproperties3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:implementationHipaaRetentionAnnotationsId rdf:type rdf:Property ;
    rdfs:label 'Implementation Hipaa Retention Annotations Id' ;
    rdfs:comment 'Primary key for implementation_hipaa_retention_annotations' ;
    rdfs:domain ind:ImplementationHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appliesToHistoricalData rdf:type rdf:Property ;
    rdfs:label 'Applies To Historical Data' ;
    rdfs:comment 'Indicates whether this retention annotation applies retroactively to existing historical data or only to data created after the effective date.' ;
    rdfs:domain ind:ImplementationHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditTrailRequired rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Required' ;
    rdfs:comment 'Indicates whether access to data governed by this annotation must be logged in an audit trail per HIPAA Security Rule requirements.' ;
    rdfs:domain ind:ImplementationHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataProductName rdf:type rdf:Property ;
    rdfs:label 'Data Product Name' ;
    rdfs:comment 'The specific data product (table) within the domain that this retention annotation governs, aligned with Unity Catalog naming conventions.' ;
    rdfs:domain ind:ImplementationHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deIdentificationMethod rdf:type rdf:Property ;
    rdfs:label 'De Identification Method' ;
    rdfs:comment 'The HIPAA-approved de-identification method to be applied when data transitions from active retention to anonymized archive (Safe Harbor removes 18 identifiers; Expert Determination uses statistical methods).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encryptionAtRestRequired rdf:type rdf:Property ;
    rdfs:label 'Encryption At Rest Required' ;
    rdfs:comment 'Indicates whether data governed by this annotation must be encrypted at rest per HIPAA Security Rule addressable implementation specifications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionCriteria rdf:type rdf:Property ;
    rdfs:label 'Exception Criteria' ;
    rdfs:comment 'Description of conditions under which the standard retention period may be extended or shortened (e.g., ongoing litigation, research protocols, minor patient records).' ;
    rdfs:domain ind:ImplementationHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationHipaaRetentionAnnotationsStatus rdf:type rdf:Property ;
    rdfs:label 'Implementation Hipaa Retention Annotations Status' ;
    rdfs:comment 'Current lifecycle status of this retention annotation indicating whether it is actively enforced, in draft, under review, deprecated, or archived.' ;
    rdfs:domain ind:ImplementationHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumNecessaryApplies rdf:type rdf:Property ;
    rdfs:label 'Minimum Necessary Applies' ;
    rdfs:comment 'Indicates whether the HIPAA minimum necessary standard applies to disclosures of data governed by this annotation, limiting access to only the information needed for a specific purpose.' ;
    rdfs:domain ind:ImplementationHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientAgeGroup rdf:type rdf:Property ;
    rdfs:label 'Patient Age Group' ;
    rdfs:comment 'Indicates whether the retention rule applies to adult records, minor records (which often have extended retention until age of majority plus standard period), or all patient records.' ;
    rdfs:domain ind:ImplementationHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiClassification rdf:type rdf:Property ;
    rdfs:label 'Phi Classification' ;
    rdfs:comment 'Data classification level indicating whether the governed data contains PHI, PII, PCI, sensitive business data, or is public, driving retention and access control requirements.' ;
    rdfs:domain ind:ImplementationHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentWorkflowId rdf:type rdf:Property ;
    rdfs:label 'Consent Workflow Id' ;
    rdfs:comment 'Primary key for consent_workflow' ;
    rdfs:domain ind:ConsentWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:competencyAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Competency Assessment Status' ;
    rdfs:comment 'Status of the patient\'s decision-making capacity assessment when competency is in question.' ;
    rdfs:domain ind:ConsentWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEmergentOverride rdf:type rdf:Property ;
    rdfs:label 'Is Emergent Override' ;
    rdfs:comment 'Indicates whether consent was bypassed or deferred under emergency treatment provisions (EMTALA) with intent to obtain consent post-stabilization.' ;
    rdfs:domain ind:ConsentWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMinorPatient rdf:type rdf:Property ;
    rdfs:label 'Is Minor Patient' ;
    rdfs:comment 'Indicates whether the patient is a minor requiring parental or guardian consent per state law.' ;
    rdfs:domain ind:ConsentWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientEducationCompleted rdf:type rdf:Property ;
    rdfs:label 'Patient Education Completed' ;
    rdfs:comment 'Indicates whether the patient education component of the informed consent process has been completed.' ;
    rdfs:domain ind:ConsentWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientQuestionsAddressed rdf:type rdf:Property ;
    rdfs:label 'Patient Questions Addressed' ;
    rdfs:comment 'Indicates whether the patient\'s questions about the consent topic have been addressed by the provider.' ;
    rdfs:domain ind:ConsentWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresLegalRepresentative rdf:type rdf:Property ;
    rdfs:label 'Requires Legal Representative' ;
    rdfs:comment 'Indicates whether consent must be obtained from a legal representative (e.g., minor patient, incapacitated adult, power of attorney).' ;
    rdfs:domain ind:ConsentWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemWorkflowReference rdf:type rdf:Property ;
    rdfs:label 'Source System Workflow Reference' ;
    rdfs:comment 'The native workflow identifier from the originating EHR or consent management system for cross-system traceability.' ;
    rdfs:domain ind:ConsentWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchClinicianId rdf:type rdf:Property ;
    rdfs:label 'Research Clinician Id' ;
    rdfs:comment 'Identifier of the principal investigator responsible for the scientific and technical direction of the grant.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:researchCoInvestigatorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Research Co Investigator Clinician Id' ;
    rdfs:comment 'Identifier of the co-principal investigator sharing responsibility for the grant\'s scientific direction.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:currentBudgetPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Current Budget Period End' ;
    rdfs:comment 'End date of the current budget period within the overall project period.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:currentBudgetPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Current Budget Period Start' ;
    rdfs:comment 'Start date of the current budget period (annual segment) within the overall project period.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:currentYearNumber rdf:type rdf:Property ;
    rdfs:label 'Current Year Number' ;
    rdfs:comment 'Current budget year number within the total project period (e.g., year 3 of 5).' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fain rdf:type rdf:Property ;
    rdfs:label 'Fain' ;
    rdfs:comment 'Unique federal award identification number assigned by the awarding agency, required for FFATA reporting.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Funding Agency Code' ;
    rdfs:comment 'Standardized code identifying the funding agency (e.g., NIH, NSF, DOD, AHA) used for federal reporting.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantAbstract rdf:type rdf:Property ;
    rdfs:label 'Grant Abstract' ;
    rdfs:comment 'Public abstract summarizing the research aims and significance of the grant-funded project.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:involvesHumanSubjects rdf:type rdf:Property ;
    rdfs:label 'Involves Human Subjects' ;
    rdfs:comment 'Indicates whether the grant-funded research involves human subjects, triggering IRB oversight requirements.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:involvesVertebrateAnimals rdf:type rdf:Property ;
    rdfs:label 'Involves Vertebrate Animals' ;
    rdfs:comment 'Indicates whether the grant-funded research involves vertebrate animals, triggering IACUC oversight.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastProgressReportDate rdf:type rdf:Property ;
    rdfs:label 'Last Progress Report Date' ;
    rdfs:comment 'Date the most recent research progress report (RPPR) was submitted to the funding agency.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noCostExtensionFlag rdf:type rdf:Property ;
    rdfs:label 'No Cost Extension Flag' ;
    rdfs:comment 'Indicates whether a no-cost extension has been granted to extend the project period without additional funding.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:researchGrantStatus rdf:type rdf:Property ;
    rdfs:label 'Research Grant Status' ;
    rdfs:comment 'Current lifecycle status of the grant from proposal through closeout.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalProjectYears rdf:type rdf:Property ;
    rdfs:label 'Total Project Years' ;
    rdfs:comment 'Total number of years approved for the grant project period.' ;
    rdfs:domain ind:ResearchGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:variantCallId rdf:type rdf:Property ;
    rdfs:label 'Variant Call Id' ;
    rdfs:comment 'Primary key for variant_call' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:variantInterpretingPathologistClinicianId rdf:type rdf:Property ;
    rdfs:label 'Variant Interpreting Pathologist Clinician Id' ;
    rdfs:comment 'Identifier of the molecular pathologist or clinical geneticist who performed the clinical interpretation and classification.' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:acmgCriteria rdf:type rdf:Property ;
    rdfs:label 'Acmg Criteria' ;
    rdfs:comment 'Comma-separated list of ACMG/AMP evidence criteria codes applied during variant classification (e.g., PVS1, PM2, PP3).' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateAlleleDepth rdf:type rdf:Property ;
    rdfs:label 'Alternate Allele Depth' ;
    rdfs:comment 'Number of sequencing reads supporting the alternate allele at this position.' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:callTimestamp rdf:type rdf:Property ;
    rdfs:label 'Call Timestamp' ;
    rdfs:comment 'Date and time when the variant calling pipeline completed analysis and generated this variant call record.' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:endPosition rdf:type rdf:Property ;
    rdfs:label 'End Position' ;
    rdfs:comment '1-based coordinate of the end position of the variant on the reference genome, relevant for structural variants and indels spanning multiple bases.' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genotype rdf:type rdf:Property ;
    rdfs:label 'Genotype' ;
    rdfs:comment 'Genotype call for this variant position expressed in VCF format (e.g., 0/1 for heterozygous, 1/1 for homozygous alternate).' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpretationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interpretation Timestamp' ;
    rdfs:comment 'Date and time when the clinical interpretation and classification of this variant was finalized by the molecular pathologist.' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:somaticGermlineStatus rdf:type rdf:Property ;
    rdfs:label 'Somatic Germline Status' ;
    rdfs:comment 'Classification of whether the variant originated in somatic (tumor) tissue or is present in the germline (inherited), critical for treatment decisions.' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strandBiasScore rdf:type rdf:Property ;
    rdfs:label 'Strand Bias Score' ;
    rdfs:comment 'Statistical measure of strand bias indicating whether the variant is supported equally by forward and reverse reads, used as a quality metric.' ;
    rdfs:domain ind:VariantCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geneticCounselingFlag rdf:type rdf:Property ;
    rdfs:label 'Genetic Counseling Flag' ;
    rdfs:comment 'Indicates whether pre-test or post-test genetic counseling was provided to the patient in conjunction with this genomic test order.' ;
    rdfs:domain ind:GenomicTestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reasonForCancellation rdf:type rdf:Property ;
    rdfs:label 'Reason For Cancellation' ;
    rdfs:comment 'Documented reason if the genomic test order was cancelled, such as patient refusal, specimen inadequacy, duplicate order, or insurance denial.' ;
    rdfs:domain ind:GenomicTestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultReportUrl rdf:type rdf:Property ;
    rdfs:label 'Result Report Url' ;
    rdfs:comment 'Secure URL or document reference to the full genomic test report in the laboratory portal or document management system.' ;
    rdfs:domain ind:GenomicTestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Treatment Impact Flag' ;
    rdfs:comment 'Indicates whether the genomic test results directly influenced or changed the patient\'s treatment plan, supporting precision medicine outcomes tracking.' ;
    rdfs:domain ind:GenomicTestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:turnaroundDaysActual rdf:type rdf:Property ;
    rdfs:label 'Turnaround Days Actual' ;
    rdfs:comment 'Actual number of calendar days from specimen receipt to result finalization, used for laboratory performance monitoring and SLA compliance.' ;
    rdfs:domain ind:GenomicTestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:turnaroundDaysExpected rdf:type rdf:Property ;
    rdfs:label 'Turnaround Days Expected' ;
    rdfs:comment 'Expected number of calendar days from specimen receipt to result delivery, based on the performing laboratory\'s stated turnaround time for the test type.' ;
    rdfs:domain ind:GenomicTestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentRecordTblId rdf:type rdf:Property ;
    rdfs:label 'Consent Record Tbl Id' ;
    rdfs:comment 'Primary key for consent_record_tbl' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorConsentRecordTblId rdf:type rdf:Property ;
    rdfs:label 'Prior Consent Record Tbl Id' ;
    rdfs:comment 'Reference to the previous version of this consent record when the current record supersedes an earlier consent.' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentRecordTbl .

ind:consentRecordTblStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Record Tbl Status' ;
    rdfs:comment 'Current lifecycle state of the consent record indicating whether it is draft, active, revoked, expired, rejected, or superseded by a newer version.' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRecipientName rdf:type rdf:Property ;
    rdfs:label 'Data Recipient Name' ;
    rdfs:comment 'Name of the organization or entity authorized to receive disclosed information under this consent (for data sharing and HIPAA authorizations).' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorName rdf:type rdf:Property ;
    rdfs:label 'Grantor Name' ;
    rdfs:comment 'Full legal name of the person who granted (signed) the consent, which may differ from the patient if signed by a representative.' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorRelationship rdf:type rdf:Property ;
    rdfs:label 'Grantor Relationship' ;
    rdfs:comment 'Relationship of the consent grantor to the patient when the grantor is not the patient themselves.' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorType rdf:type rdf:Property ;
    rdfs:label 'Grantor Type' ;
    rdfs:comment 'Role of the person granting consent: the patient themselves, a legal guardian, power of attorney, parent (for minors), or court-appointed representative.' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchProtocolNumber rdf:type rdf:Property ;
    rdfs:label 'Research Protocol Number' ;
    rdfs:comment 'IRB-approved research protocol number associated with this consent, applicable for research consent types.' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationDatetime rdf:type rdf:Property ;
    rdfs:label 'Revocation Datetime' ;
    rdfs:comment 'Timestamp when the patient revoked this consent. Null if consent has not been revoked.' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:risksDisclosed rdf:type rdf:Property ;
    rdfs:label 'Risks Disclosed' ;
    rdfs:comment 'Indicates whether material risks, benefits, and alternatives were disclosed to the patient as part of the informed consent process.' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:witnessDatetime rdf:type rdf:Property ;
    rdfs:label 'Witness Datetime' ;
    rdfs:comment 'Timestamp when the witness observed and attested to the consent signing.' ;
    rdfs:domain ind:ConsentRecordTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consentEventTblId rdf:type rdf:Property ;
    rdfs:label 'Consent Event Tbl Id' ;
    rdfs:comment 'Primary key for consent_event_tbl' ;
    rdfs:domain ind:ConsentEventTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorEventConsentEventTblId rdf:type rdf:Property ;
    rdfs:label 'Prior Event Consent Event Tbl Id' ;
    rdfs:comment 'Reference to the previous consent event in the chain, enabling full consent history and audit trail reconstruction.' ;
    rdfs:domain ind:ConsentEventTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentEventTbl .

ind:captureChannel rdf:type rdf:Property ;
    rdfs:label 'Capture Channel' ;
    rdfs:comment 'The interface or channel through which the consent event was captured.' ;
    rdfs:domain ind:ConsentEventTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:captureMethod rdf:type rdf:Property ;
    rdfs:label 'Capture Method' ;
    rdfs:comment 'The method by which consent was captured during this event: written signature, verbal acknowledgment, electronic signature, or implied consent.' ;
    rdfs:domain ind:ConsentEventTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competencyAssessmentFlag rdf:type rdf:Property ;
    rdfs:label 'Competency Assessment Flag' ;
    rdfs:comment 'Indicates whether a competency or capacity assessment was performed to confirm the patient\'s ability to provide informed consent.' ;
    rdfs:domain ind:ConsentEventTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataUsePurpose rdf:type rdf:Property ;
    rdfs:label 'Data Use Purpose' ;
    rdfs:comment 'Description of the specific purpose for which patient data may be used or disclosed under this consent event.' ;
    rdfs:domain ind:ConsentEventTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiCategoriesAuthorized rdf:type rdf:Property ;
    rdfs:label 'Phi Categories Authorized' ;
    rdfs:comment 'Comma-separated list of PHI categories authorized for disclosure (e.g., mental health, substance abuse, HIV, genetic).' ;
    rdfs:domain ind:ConsentEventTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Effective Date' ;
    rdfs:comment 'The date on which a consent revocation or withdrawal becomes effective. Only populated for revoke/withdraw event types.' ;
    rdfs:domain ind:ConsentEventTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemEventReference rdf:type rdf:Property ;
    rdfs:label 'Source System Event Reference' ;
    rdfs:comment 'The native identifier of this consent event in the originating source system for traceability.' ;
    rdfs:domain ind:ConsentEventTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentExceptionTblId rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Tbl Id' ;
    rdfs:comment 'Primary key for consent_exception_tbl' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentExceptionTblDescription rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Tbl Description' ;
    rdfs:comment 'Free-text narrative describing the specific nature and scope of the consent exception in business terms.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentExceptionTblStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Tbl Status' ;
    rdfs:comment 'Current lifecycle status of the consent exception indicating whether it is currently in effect.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionCategory rdf:type rdf:Property ;
    rdfs:label 'Exception Category' ;
    rdfs:comment 'Broad category of what the exception applies to, such as specific data types excluded, providers restricted, or purposes limited.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionNumber rdf:type rdf:Property ;
    rdfs:label 'Exception Number' ;
    rdfs:comment 'Externally-known business identifier for the consent exception, used for tracking and correspondence.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionType rdf:type rdf:Property ;
    rdfs:label 'Exception Type' ;
    rdfs:comment 'Classification of the exception indicating the nature of the consent limitation or modification applied.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedDataClass rdf:type rdf:Property ;
    rdfs:label 'Excluded Data Class' ;
    rdfs:comment 'Specific data classification or sensitivity category that the patient has excluded from the consent scope (e.g., substance abuse, mental health, HIV/AIDS, genetic information).' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedPurpose rdf:type rdf:Property ;
    rdfs:label 'Excluded Purpose' ;
    rdfs:comment 'Specific purpose of use that is excluded from the consent authorization (e.g., marketing, research, fundraising).' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedRecipientType rdf:type rdf:Property ;
    rdfs:label 'Excluded Recipient Type' ;
    rdfs:comment 'Type of recipient or entity excluded from receiving information under this consent exception (e.g., employer, insurer, family member).' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirConsentProvisionType rdf:type rdf:Property ;
    rdfs:label 'Fhir Consent Provision Type' ;
    rdfs:comment 'Maps to the HL7 FHIR Consent.provision.type element indicating whether this exception denies or permits a specific action within the broader consent.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirSecurityLabel rdf:type rdf:Property ;
    rdfs:label 'Fhir Security Label' ;
    rdfs:comment 'HL7 FHIR security label code (e.g., ETH, PSY, HIV, SDV) identifying the sensitivity category of data this exception protects.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAbsolute rdf:type rdf:Property ;
    rdfs:label 'Is Absolute' ;
    rdfs:comment 'Indicates whether this exception is absolute (cannot be overridden even in emergencies) or conditional (may be overridden under specific clinical circumstances).' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEmergencyOverridable rdf:type rdf:Property ;
    rdfs:label 'Is Emergency Overridable' ;
    rdfs:comment 'Indicates whether this exception can be overridden in life-threatening emergency situations per EMTALA or state emergency treatment laws.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastOverrideDate rdf:type rdf:Property ;
    rdfs:label 'Last Override Date' ;
    rdfs:comment 'Date of the most recent override of this consent exception, for compliance tracking purposes.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overrideCount rdf:type rdf:Property ;
    rdfs:label 'Override Count' ;
    rdfs:comment 'Number of times this exception has been overridden (e.g., for emergency access), used for compliance monitoring and audit.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestedDate rdf:type rdf:Property ;
    rdfs:label 'Requested Date' ;
    rdfs:comment 'Date on which the patient or authorized representative formally requested this exception.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestorType rdf:type rdf:Property ;
    rdfs:label 'Requestor Type' ;
    rdfs:comment 'Role of the individual who requested this consent exception on behalf of or as the patient.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revokedDate rdf:type rdf:Property ;
    rdfs:label 'Revoked Date' ;
    rdfs:comment 'Date on which this consent exception was revoked by the patient or superseded by a new consent directive.' ;
    rdfs:domain ind:ConsentExceptionTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentTranslationTblId rdf:type rdf:Property ;
    rdfs:label 'Consent Translation Tbl Id' ;
    rdfs:comment 'Primary key for consent_translation_tbl' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By Employee Id' ;
    rdfs:comment 'Identifier of the employee (compliance officer or department head) who approved this translation for active use.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:replacesTranslationConsentTranslationTblId rdf:type rdf:Property ;
    rdfs:label 'Replaces Translation Consent Translation Tbl Id' ;
    rdfs:comment 'Reference to the previous translation version that this record supersedes, enabling version chain traceability.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentTranslationTbl .

ind:accessibilityCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Accessibility Compliant Flag' ;
    rdfs:comment 'Indicates whether the translated document meets ADA Section 508 and WCAG accessibility standards for patients with disabilities.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backTranslationCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Back Translation Completed Flag' ;
    rdfs:comment 'Indicates whether a back-translation (re-translation to source language by independent translator) was performed for quality assurance validation.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certifiedByName rdf:type rdf:Property ;
    rdfs:label 'Certified By Name' ;
    rdfs:comment 'Name of the certified translator or language services professional who attested to the accuracy of this translation.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalReviewCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Clinical Review Completed Flag' ;
    rdfs:comment 'Indicates whether a clinical subject matter expert reviewed the translation for medical accuracy and appropriate terminology.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:culturalAdaptationFlag rdf:type rdf:Property ;
    rdfs:label 'Cultural Adaptation Flag' ;
    rdfs:comment 'Indicates whether the translation includes cultural adaptations beyond literal language conversion to improve comprehension for the target population.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentStorageUri rdf:type rdf:Property ;
    rdfs:label 'Document Storage Uri' ;
    rdfs:comment 'Storage location URI for the translated consent document file within the enterprise content management system.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDefaultForLanguage rdf:type rdf:Property ;
    rdfs:label 'Is Default For Language' ;
    rdfs:comment 'Indicates whether this is the default (preferred) translation to present for the target language when multiple translations exist.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:literacyStandard rdf:type rdf:Property ;
    rdfs:label 'Literacy Standard' ;
    rdfs:comment 'Readability assessment standard used to evaluate the reading level of the translated consent document.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingLevelGrade rdf:type rdf:Property ;
    rdfs:label 'Reading Level Grade' ;
    rdfs:comment 'Estimated reading comprehension grade level of the translated content, used to ensure health literacy accessibility for diverse patient populations.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Source Language Code' ;
    rdfs:comment 'ISO 639-1 language code (with optional ISO 3166-1 region) of the original consent document before translation.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:translatedContent rdf:type rdf:Property ;
    rdfs:label 'Translated Content' ;
    rdfs:comment 'Full text content of the translated consent document. May contain references to Protected Health Information (PHI) in the consent scope description.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:translationCode rdf:type rdf:Property ;
    rdfs:label 'Translation Code' ;
    rdfs:comment 'Unique business identifier code assigned to this translation for tracking and reference across systems.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:translationMethod rdf:type rdf:Property ;
    rdfs:label 'Translation Method' ;
    rdfs:comment 'Method used to produce the translation, distinguishing between human professional translation, machine translation, hybrid approaches, or certified human translation.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:translationStatus rdf:type rdf:Property ;
    rdfs:label 'Translation Status' ;
    rdfs:comment 'Current lifecycle status of the translation indicating its readiness for patient-facing use.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:translationType rdf:type rdf:Property ;
    rdfs:label 'Translation Type' ;
    rdfs:comment 'Classification of the translation scope indicating whether it is a full verbatim translation, partial translation, summary, simplified version, or plain language adaptation.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:translatorOrganization rdf:type rdf:Property ;
    rdfs:label 'Translator Organization' ;
    rdfs:comment 'Name of the translation services organization or vendor that produced this translation.' ;
    rdfs:domain ind:ConsentTranslationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentVerificationTblId rdf:type rdf:Property ;
    rdfs:label 'Consent Verification Tbl Id' ;
    rdfs:comment 'Primary key for consent_verification_tbl' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentScopeConfirmed rdf:type rdf:Property ;
    rdfs:label 'Consent Scope Confirmed' ;
    rdfs:comment 'The specific scope or category of consent that was verified during this event. Aligns with enterprise consent categories.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentVerificationTblStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Verification Tbl Status' ;
    rdfs:comment 'Current lifecycle state of the verification event workflow. Tracks whether the verification process has been completed or is still in progress.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialReason rdf:type rdf:Property ;
    rdfs:label 'Denial Reason' ;
    rdfs:comment 'Free-text or coded reason when the patient denies or revokes consent during the verification process. Populated only when outcome is denied or unable_to_verify.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationReviewed rdf:type rdf:Property ;
    rdfs:label 'Documentation Reviewed' ;
    rdfs:comment 'Indicates whether the original consent documentation was reviewed with the patient during the verification event.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electronicSignatureCaptured rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Captured' ;
    rdfs:comment 'Indicates whether an electronic signature was captured from the patient or surrogate during the verification event.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:identityMethod rdf:type rdf:Property ;
    rdfs:label 'Identity Method' ;
    rdfs:comment 'The method used to confirm patient identity during the consent verification process, per Joint Commission National Patient Safety Goals.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'The method used to verify the patient\'s consent. Indicates how the verification was conducted (e.g., verbal confirmation, written re-signature, electronic acknowledgment).' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientCompetencyAssessed rdf:type rdf:Property ;
    rdfs:label 'Patient Competency Assessed' ;
    rdfs:comment 'Indicates whether the patient\'s decision-making capacity or competency was assessed as part of the verification process.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientIdentityConfirmed rdf:type rdf:Property ;
    rdfs:label 'Patient Identity Confirmed' ;
    rdfs:comment 'Indicates whether the patient\'s identity was positively confirmed as part of the verification process using approved identification methods.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:questionsAsked rdf:type rdf:Property ;
    rdfs:label 'Questions Asked' ;
    rdfs:comment 'Indicates whether the patient or surrogate asked questions during the verification process, documenting informed consent engagement.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:questionsResolved rdf:type rdf:Property ;
    rdfs:label 'Questions Resolved' ;
    rdfs:comment 'Indicates whether all patient or surrogate questions were satisfactorily resolved during the verification process.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signatureReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Signature Reference Code' ;
    rdfs:comment 'Reference identifier linking to the electronic signature record or document management system where the captured signature is stored.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surrogateDecisionMaker rdf:type rdf:Property ;
    rdfs:label 'Surrogate Decision Maker' ;
    rdfs:comment 'Indicates whether a surrogate decision maker (legal guardian, healthcare proxy, power of attorney) provided the verification on behalf of the patient.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:understandingConfirmed rdf:type rdf:Property ;
    rdfs:label 'Understanding Confirmed' ;
    rdfs:comment 'Indicates whether the verifier confirmed that the patient or surrogate demonstrated understanding of the consent terms during verification.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verificationNumber rdf:type rdf:Property ;
    rdfs:label 'Verification Number' ;
    rdfs:comment 'Externally-known business identifier for this verification event, used for audit trails and cross-system reference.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationType rdf:type rdf:Property ;
    rdfs:label 'Verification Type' ;
    rdfs:comment 'Classification of the verification event indicating the trigger or reason for verification. Initial is at consent creation, periodic is scheduled re-verification, event_triggered is based on clinical workflow.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifierName rdf:type rdf:Property ;
    rdfs:label 'Verifier Name' ;
    rdfs:comment 'Full name of the person who performed the verification, captured at time of event for audit immutability even if provider record changes.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifierRole rdf:type rdf:Property ;
    rdfs:label 'Verifier Role' ;
    rdfs:comment 'The professional role of the person who performed the consent verification, used for compliance reporting and role-based audit.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessPresent rdf:type rdf:Property ;
    rdfs:label 'Witness Present' ;
    rdfs:comment 'Indicates whether a witness was present during the consent verification event, as may be required by policy for certain consent types.' ;
    rdfs:domain ind:ConsentVerificationTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientGenomicStudyId rdf:type rdf:Property ;
    rdfs:label 'Patient Genomic Study Id' ;
    rdfs:comment 'Primary key for patient_genomic_study' ;
    rdfs:domain ind:PatientGenomicStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cancelledReason rdf:type rdf:Property ;
    rdfs:label 'Cancelled Reason' ;
    rdfs:comment 'Reason for cancellation if the genomic study was cancelled, such as patient withdrawal, specimen inadequacy, or insurance denial.' ;
    rdfs:domain ind:PatientGenomicStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carePathwayDescription rdf:type rdf:Property ;
    rdfs:label 'Care Pathway Description' ;
    rdfs:comment 'Description of the precision medicine care pathway or treatment protocol activated based on genomic study findings.' ;
    rdfs:domain ind:PatientGenomicStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carePathwayLinkedFlag rdf:type rdf:Property ;
    rdfs:label 'Care Pathway Linked Flag' ;
    rdfs:comment 'Indicates whether the genomic study results have been linked to a precision medicine care pathway or treatment protocol.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geneticCounselingOfferedFlag rdf:type rdf:Property ;
    rdfs:label 'Genetic Counseling Offered Flag' ;
    rdfs:comment 'Indicates whether genetic counseling was offered to the patient before or after the genomic study.' ;
    rdfs:domain ind:PatientGenomicStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientGenomicStudyStatus rdf:type rdf:Property ;
    rdfs:label 'Patient Genomic Study Status' ;
    rdfs:comment 'Current lifecycle status of the patient\'s genomic study from order through completion or cancellation.' ;
    rdfs:domain ind:PatientGenomicStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platformTechnology rdf:type rdf:Property ;
    rdfs:label 'Platform Technology' ;
    rdfs:comment 'Sequencing technology or platform used for the genomic analysis, such as next-generation sequencing (NGS), microarray, or PCR-based methods.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchUseAuthorizedFlag rdf:type rdf:Property ;
    rdfs:label 'Research Use Authorized Flag' ;
    rdfs:comment 'Indicates whether the patient has authorized use of their genomic data for research purposes beyond clinical care.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultDisclosedToPatientFlag rdf:type rdf:Property ;
    rdfs:label 'Result Disclosed To Patient Flag' ;
    rdfs:comment 'Indicates whether the genomic study results have been formally disclosed and communicated to the patient.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultDisclosureDate rdf:type rdf:Property ;
    rdfs:label 'Result Disclosure Date' ;
    rdfs:comment 'Date on which the genomic study results were disclosed to the patient.' ;
    rdfs:domain ind:PatientGenomicStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resultReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Result Received Date' ;
    rdfs:comment 'Date on which the genomic study results were received from the performing laboratory.' ;
    rdfs:domain ind:PatientGenomicStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:secondaryFindingsReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Secondary Findings Reported Flag' ;
    rdfs:comment 'Indicates whether ACMG-recommended secondary (incidental) findings were reported to the patient as part of the genomic study.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specimenSourceSite rdf:type rdf:Property ;
    rdfs:label 'Specimen Source Site' ;
    rdfs:comment 'Anatomical body site from which the specimen was collected, particularly relevant for tumor profiling studies.' ;
    rdfs:domain ind:PatientGenomicStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testPanelCode rdf:type rdf:Property ;
    rdfs:label 'Test Panel Code' ;
    rdfs:comment 'Standardized code identifying the genomic test panel, often mapped to CPT or proprietary laboratory codes.' ;
    rdfs:domain ind:PatientGenomicStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vousCount rdf:type rdf:Property ;
    rdfs:label 'Vous Count' ;
    rdfs:comment 'Number of variants of uncertain significance identified in the genomic study results.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:matchResultId rdf:type rdf:Property ;
    rdfs:label 'Match Result Id' ;
    rdfs:comment 'Primary key for match_result' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:matchEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Match Employee Id' ;
    rdfs:comment 'Identifier of the ordering or referring provider who initiated or reviewed the trial match evaluation.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:matchPrincipalInvestigatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Match Principal Investigator Employee Id' ;
    rdfs:comment 'Identifier of the principal investigator responsible for the trial at the matched site.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:matchResearchCoordinatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Match Research Coordinator Employee Id' ;
    rdfs:comment 'Identifier of the clinical research coordinator assigned to follow up on this match result.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:previousMatchResultId rdf:type rdf:Property ;
    rdfs:label 'Previous Match Result Id' ;
    rdfs:comment 'Reference to a prior match result for the same patient-trial combination, enabling longitudinal tracking of eligibility changes.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MatchResult .

ind:eligibilityDetermination rdf:type rdf:Property ;
    rdfs:label 'Eligibility Determination' ;
    rdfs:comment 'Final eligibility determination outcome based on the comprehensive evaluation of all inclusion and exclusion criteria.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indeterminateCriteriaCount rdf:type rdf:Property ;
    rdfs:label 'Indeterminate Criteria Count' ;
    rdfs:comment 'Number of eligibility criteria that could not be evaluated due to missing or incomplete patient data.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isRescreen rdf:type rdf:Property ;
    rdfs:label 'Is Rescreen' ;
    rdfs:comment 'Indicates whether this evaluation is a re-screening of a previously evaluated patient-trial combination.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUrgent rdf:type rdf:Property ;
    rdfs:label 'Is Urgent' ;
    rdfs:comment 'Indicates whether this match is flagged as urgent due to patient condition severity or trial enrollment deadline proximity.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryIneligibilityReason rdf:type rdf:Property ;
    rdfs:label 'Primary Ineligibility Reason' ;
    rdfs:comment 'Primary reason for patient ineligibility when the determination is ineligible, often referencing specific clinical conditions or demographic factors.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiPopulationHealthCohortMgmtId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Cohort Mgmt Id' ;
    rdfs:comment 'Primary key for clinical_ai_population_health_cohort_mgmt' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortMgmt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalAiPopulationHealthCohortMgmtDescription rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Cohort Mgmt Description' ;
    rdfs:comment 'Detailed narrative describing the clinical rationale, target population characteristics, and intended use of the cohort in population health programs.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortMgmt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiPopulationHealthCohortMgmtStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Cohort Mgmt Status' ;
    rdfs:comment 'Current lifecycle state of the cohort definition indicating whether it is actively being used for patient identification and intervention targeting.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortMgmt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptCodeSet rdf:type rdf:Property ;
    rdfs:label 'Cpt Code Set' ;
    rdfs:comment 'Comma-separated list of CPT procedure codes relevant to the cohort definition for identifying patients by procedure history.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10CodeSet rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code Set' ;
    rdfs:comment 'Comma-separated list of ICD-10 diagnosis codes that define the clinical conditions targeted by this cohort.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loincCodeSet rdf:type rdf:Property ;
    rdfs:label 'Loinc Code Set' ;
    rdfs:comment 'Comma-separated list of LOINC codes for laboratory observations used in cohort inclusion or exclusion criteria.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortMgmt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managingCareTeam rdf:type rdf:Property ;
    rdfs:label 'Managing Care Team' ;
    rdfs:comment 'Name of the care management team or population health department responsible for operationalizing interventions for this cohort.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortMgmt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationClassFilter rdf:type rdf:Property ;
    rdfs:label 'Medication Class Filter' ;
    rdfs:comment 'Therapeutic drug class or NDC-based medication filter used to identify patients by active prescriptions or medication history.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortMgmt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelValidationStatus rdf:type rdf:Property ;
    rdfs:label 'Model Validation Status' ;
    rdfs:comment 'Status of the AI/ML model validation process that underpins the cohort criteria, ensuring clinical accuracy and bias assessment.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortMgmt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refreshMethod rdf:type rdf:Property ;
    rdfs:label 'Refresh Method' ;
    rdfs:comment 'Technical approach used to refresh cohort membership: full rebuild recalculates all members, incremental processes only changes, streaming evaluates in near-real-time.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortMgmt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohFactor rdf:type rdf:Property ;
    rdfs:label 'Sdoh Factor' ;
    rdfs:comment 'Social determinants of health factors incorporated into cohort criteria, such as food insecurity, housing instability, transportation barriers, or health literacy.' ;
    rdfs:domain ind:ClinicalAiPopulationHealthCohortMgmt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueBasedContractFlag rdf:type rdf:Property ;
    rdfs:label 'Value Based Contract Flag' ;
    rdfs:comment 'Indicates whether this cohort is directly tied to a value-based purchasing or alternative payment model contract with financial implications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalAiGovernanceId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Governance Id' ;
    rdfs:comment 'Primary key for clinical_ai_clinical_ai_governance' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Clinical Employee Id' ;
    rdfs:comment 'Reference to the internal governance committee or individual with authority to approve clinical deployment of this AI model.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:clinicalResponsibleDataScientistEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Clinical Responsible Data Scientist Employee Id' ;
    rdfs:comment 'Reference to the data scientist or ML engineer accountable for the technical development and maintenance of this AI model.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:governedClinicalAiModelCardId rdf:type rdf:Property ;
    rdfs:label 'Governed Clinical Ai Model Card Id' ;
    rdfs:comment 'Foreign key linking to clinical_ai.clinical_ai_model_card. Business justification: clinical_ai_clinical_ai_governance has model_id, model_name, model_version as raw fields but no FK to clinical_ai_model_card. Governance records govern specific AI models — this is a fundamental relat' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalAiModelCard .

ind:governedModelVersionId rdf:type rdf:Property ;
    rdfs:label 'Governed Model Version Id' ;
    rdfs:comment 'Foreign key linking to clinical_ai.model_version. Business justification: clinical_ai_clinical_ai_governance tracks governance for specific model versions (has model_version string). Adding FK to model_version table enables joining to get full version metadata including tra' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ModelVersion .

ind:algorithmType rdf:type rdf:Property ;
    rdfs:label 'Algorithm Type' ;
    rdfs:comment 'Technical classification of the AI/ML algorithm architecture such as deep learning, random forest, NLP transformer, or ensemble method.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biasAuditOutcome rdf:type rdf:Property ;
    rdfs:label 'Bias Audit Outcome' ;
    rdfs:comment 'Result of the most recent bias audit indicating whether the model meets organizational fairness thresholds.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biasFairnessScore rdf:type rdf:Property ;
    rdfs:label 'Bias Fairness Score' ;
    rdfs:comment 'Composite fairness metric score from the most recent bias monitoring assessment, measuring equitable performance across protected demographic groups.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:biasMonitoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Bias Monitoring Frequency' ;
    rdfs:comment 'Scheduled frequency at which bias and fairness metrics are recalculated and reviewed for this clinical AI model.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceDate rdf:type rdf:Property ;
    rdfs:label 'Clearance Date' ;
    rdfs:comment 'Date on which FDA clearance or approval was granted for this clinical AI model as a medical device.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clinicianOverrideRate rdf:type rdf:Property ;
    rdfs:label 'Clinician Override Rate' ;
    rdfs:comment 'Proportion of AI model recommendations that are overridden by clinicians, serving as a signal for model calibration and clinical trust assessment.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentDriftScore rdf:type rdf:Property ;
    rdfs:label 'Current Drift Score' ;
    rdfs:comment 'Most recently calculated drift metric indicating how much the models real-world performance has deviated from its validated baseline.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataUseAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Data Use Agreement Reference' ;
    rdfs:comment 'Reference identifier for the data use agreement governing the training and inference data used by this clinical AI model.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demographicParityRatio rdf:type rdf:Property ;
    rdfs:label 'Demographic Parity Ratio' ;
    rdfs:comment 'Ratio measuring whether the AI model produces equitable positive prediction rates across racial, ethnic, and gender subgroups.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deploymentDate rdf:type rdf:Property ;
    rdfs:label 'Deployment Date' ;
    rdfs:comment 'Date when the AI model was first deployed into the clinical production environment for patient care use.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:equalizedOddsDifference rdf:type rdf:Property ;
    rdfs:label 'Equalized Odds Difference' ;
    rdfs:comment 'Maximum difference in true positive rates or false positive rates across protected groups, measuring conditional fairness of the model.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:explainabilityMethod rdf:type rdf:Property ;
    rdfs:label 'Explainability Method' ;
    rdfs:comment 'Technique used to provide model interpretability and clinical decision explanations, such as SHAP, LIME, attention maps, or feature importance.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fdaSamdClassification rdf:type rdf:Property ;
    rdfs:label 'Fda Samd Classification' ;
    rdfs:comment 'FDA device classification level for the AI/ML software when it qualifies as a Software as a Medical Device under FDA regulatory framework.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceType rdf:type rdf:Property ;
    rdfs:label 'Governance Type' ;
    rdfs:comment 'Classification of the governance activity type: model card documentation, bias monitoring audit, FDA SaMD submission, validation review, retraining approval, or decommission assessment.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaPhiExposureLevel rdf:type rdf:Property ;
    rdfs:label 'Hipaa Phi Exposure Level' ;
    rdfs:comment 'Classification of the level of PHI data the AI model accesses during inference, determining applicable HIPAA safeguard requirements.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intendedUseStatement rdf:type rdf:Property ;
    rdfs:label 'Intended Use Statement' ;
    rdfs:comment 'Formal description of the AI models intended clinical use, target patient population, and clinical workflow integration point as required for FDA SaMD submissions.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLockedAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Is Locked Algorithm' ;
    rdfs:comment 'Indicates whether the AI model is a locked algorithm (does not learn after deployment) versus an adaptive algorithm that continuously updates, per FDA predetermined change control plan requirements.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastBiasAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Bias Audit Date' ;
    rdfs:comment 'Date of the most recent formal bias and fairness audit conducted on this clinical AI model.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastValidationDate rdf:type rdf:Property ;
    rdfs:label 'Last Validation Date' ;
    rdfs:comment 'Date of the most recent clinical validation or performance evaluation conducted on the deployed model.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modelCardUrl rdf:type rdf:Property ;
    rdfs:label 'Model Card Url' ;
    rdfs:comment 'URL or document management system reference to the formal model card containing complete documentation of model purpose, performance, limitations, and ethical considerations.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelDriftThreshold rdf:type rdf:Property ;
    rdfs:label 'Model Drift Threshold' ;
    rdfs:comment 'Performance degradation threshold that triggers an automatic alert for governance review when model accuracy drops below acceptable limits.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientConsentRequired rdf:type rdf:Property ;
    rdfs:label 'Patient Consent Required' ;
    rdfs:comment 'Indicates whether explicit patient consent is required before the AI model can be applied to their clinical data or influence their care decisions.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:predeterminedChangeControlPlan rdf:type rdf:Property ;
    rdfs:label 'Predetermined Change Control Plan' ;
    rdfs:comment 'Reference to the FDA-approved predetermined change control plan that defines acceptable modifications to the AI model without requiring new regulatory submission.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorySubmissionNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Submission Number' ;
    rdfs:comment 'FDA 510(k), De Novo, or PMA submission number associated with this AI/ML device if applicable.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPredictionsCount rdf:type rdf:Property ;
    rdfs:label 'Total Predictions Count' ;
    rdfs:comment 'Cumulative number of clinical predictions or recommendations generated by this AI model since deployment, used for utilization tracking.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingDataDescription rdf:type rdf:Property ;
    rdfs:label 'Training Data Description' ;
    rdfs:comment 'Summary of the training dataset characteristics including size, demographic composition, data sources, and temporal coverage used to develop the model.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingDataSize rdf:type rdf:Property ;
    rdfs:label 'Training Data Size' ;
    rdfs:comment 'Total number of samples or records used in the model training dataset for transparency and reproducibility documentation.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationAucScore rdf:type rdf:Property ;
    rdfs:label 'Validation Auc Score' ;
    rdfs:comment 'Area Under the Receiver Operating Characteristic Curve score from the most recent model validation, measuring discriminative performance.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validationSensitivity rdf:type rdf:Property ;
    rdfs:label 'Validation Sensitivity' ;
    rdfs:comment 'Sensitivity or true positive rate from the most recent clinical validation study, critical for patient safety assessment.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validationSpecificity rdf:type rdf:Property ;
    rdfs:label 'Validation Specificity' ;
    rdfs:comment 'Specificity or true negative rate from the most recent clinical validation study, measuring false alarm rate control.' ;
    rdfs:domain ind:ClinicalAiGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalAiTrialEligibilityCriteriaId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Trial Eligibility Criteria Id' ;
    rdfs:comment 'Primary key for clinical_ai_trial_eligibility_criteria' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalAiTrialEligibilityCriteria .

ind:clinicalApprovedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Clinical Approved By User Employee Id' ;
    rdfs:comment 'Identifier of the principal investigator or authorized clinician who approved this criterion for use in patient screening.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:sponsorOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Sponsor Organization Id' ;
    rdfs:comment 'Reference to the sponsoring organization (pharmaceutical company, research institution) that defined this criterion as part of the trial protocol.' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:clinicalAiTrialEligibilityCriteriaStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Trial Eligibility Criteria Status' ;
    rdfs:comment 'Current lifecycle status of the eligibility criterion indicating whether it is actively used for patient matching, in draft, retired, or under clinical review.' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complexityLevel rdf:type rdf:Property ;
    rdfs:label 'Complexity Level' ;
    rdfs:comment 'Assessment of the computational and clinical complexity of evaluating this criterion, used for workload planning and AI model selection.' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Confidence Threshold Pct' ;
    rdfs:comment 'Minimum AI model confidence score (0-100%) required for automated criterion evaluation to be accepted without manual review.' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criterionName rdf:type rdf:Property ;
    rdfs:label 'Criterion Name' ;
    rdfs:comment 'Human-readable descriptive name of the eligibility criterion, used for display in clinical trial matching interfaces and reports.' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataElementSource rdf:type rdf:Property ;
    rdfs:label 'Data Element Source' ;
    rdfs:comment 'The source system or data domain from which the criterion evaluation data is extracted (e.g., EHR clinical documentation, laboratory information system, pharmacy system, patient-reported outcomes, or claims data).' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionAllowed rdf:type rdf:Property ;
    rdfs:label 'Exception Allowed' ;
    rdfs:comment 'Indicates whether a principal investigator may grant an exception to this criterion for individual patients based on clinical judgment.' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionJustificationRequired rdf:type rdf:Property ;
    rdfs:label 'Exception Justification Required' ;
    rdfs:comment 'Indicates whether a documented justification is required when an exception is granted for this criterion.' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAiEvaluable rdf:type rdf:Property ;
    rdfs:label 'Is Ai Evaluable' ;
    rdfs:comment 'Indicates whether this criterion can be automatically evaluated by the AI/ML matching algorithm using structured EHR data, or requires manual clinical review.' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nlpExtractionRequired rdf:type rdf:Property ;
    rdfs:label 'Nlp Extraction Required' ;
    rdfs:comment 'Indicates whether evaluation of this criterion requires NLP extraction from unstructured clinical notes rather than structured data fields.' ;
    rdfs:domain ind:ClinicalAiTrialEligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:previousEvaluationTrialEligibilityEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Previous Evaluation Trial Eligibility Evaluation Id' ;
    rdfs:comment 'Reference to the prior eligibility evaluation record if this is a re-evaluation, enabling longitudinal tracking of eligibility changes.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrialEligibilityEvaluation .

ind:reviewerProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Provider Clinician Id' ;
    rdfs:comment 'Identifier of the clinical reviewer (physician or PI) who validated or overrode the automated eligibility determination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:trialClinicalAiModelCardId rdf:type rdf:Property ;
    rdfs:label 'Trial Clinical Ai Model Card Id' ;
    rdfs:comment 'Identifier of the AI/ML model version used to generate the eligibility assessment, enabling model governance and reproducibility.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalAiModelCard .

ind:trialModelCardClinicalAiModelCardId rdf:type rdf:Property ;
    rdfs:label 'Trial Model Card Clinical Ai Model Card Id' ;
    rdfs:comment 'Foreign key linking to clinical_ai.clinical_ai_model_card. Business justification: Trial eligibility evaluation uses an ML model (ml_model_id exists as raw BIGINT). Adding model_card_id FK connects the evaluation to the governed AI model card that performed the eligibility assessmen' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalAiModelCard .

ind:ageAtEvaluation rdf:type rdf:Property ;
    rdfs:label 'Age At Evaluation' ;
    rdfs:comment 'Patient age in years at the time of eligibility evaluation, used for age-based inclusion/exclusion criteria assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enrollmentRecommendation rdf:type rdf:Property ;
    rdfs:label 'Enrollment Recommendation' ;
    rdfs:comment 'Final recommendation regarding patient enrollment into the trial based on the eligibility evaluation outcome and clinical judgment.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationPriority rdf:type rdf:Property ;
    rdfs:label 'Evaluation Priority' ;
    rdfs:comment 'Priority level assigned to the eligibility evaluation based on trial enrollment urgency, patient acuity, or study timeline constraints.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Evaluation Source System' ;
    rdfs:comment 'Name of the clinical system or AI platform that generated the eligibility evaluation (e.g., Epic Healthy Planet, custom NLP pipeline).' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingDiagnosisCodes rdf:type rdf:Property ;
    rdfs:label 'Matching Diagnosis Codes' ;
    rdfs:comment 'ICD-10 diagnosis codes from the patient record that matched trial inclusion criteria, stored as comma-separated values. Contains PHI.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingLabResultsSummary rdf:type rdf:Property ;
    rdfs:label 'Matching Lab Results Summary' ;
    rdfs:comment 'Summary of laboratory results that were evaluated against trial criteria (e.g., eGFR, HbA1c values), supporting clinical decision transparency. Contains PHI.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingMedicationCodes rdf:type rdf:Property ;
    rdfs:label 'Matching Medication Codes' ;
    rdfs:comment 'NDC or RxNorm codes of medications from the patient record relevant to trial criteria evaluation, stored as comma-separated values. Contains PHI.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nlpExtractionSummary rdf:type rdf:Property ;
    rdfs:label 'Nlp Extraction Summary' ;
    rdfs:comment 'Summary of key clinical concepts extracted via NLP from unstructured clinical notes that informed the eligibility determination. Contains PHI.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallDetermination rdf:type rdf:Property ;
    rdfs:label 'Overall Determination' ;
    rdfs:comment 'Final eligibility determination outcome for the patient against the trial criteria, representing the conclusive assessment result.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryExclusionReason rdf:type rdf:Property ;
    rdfs:label 'Primary Exclusion Reason' ;
    rdfs:comment 'Primary reason for ineligibility when the patient is determined ineligible, describing the most significant disqualifying criterion. May contain PHI related to health conditions.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Processing Duration Seconds' ;
    rdfs:comment 'Time in seconds taken to complete the eligibility evaluation computation, used for performance monitoring and SLA compliance.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reEvaluationFlag rdf:type rdf:Property ;
    rdfs:label 'Re Evaluation Flag' ;
    rdfs:comment 'Indicates whether this evaluation is a re-assessment of a previously evaluated patient, typically triggered by new clinical data or protocol amendments.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trialArmRecommendation rdf:type rdf:Property ;
    rdfs:label 'Trial Arm Recommendation' ;
    rdfs:comment 'Recommended trial arm or cohort for the patient based on the eligibility evaluation, if the trial has multiple arms with different criteria.' ;
    rdfs:domain ind:TrialEligibilityEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceHipaaRetentionAnnotationsId rdf:type rdf:Property ;
    rdfs:label 'Reference Hipaa Retention Annotations Id' ;
    rdfs:comment 'Primary key for reference_hipaa_retention_annotations' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deltaReferenceDeltaTblpropertiesId rdf:type rdf:Property ;
    rdfs:label 'Delta Reference Delta Tblproperties Id' ;
    rdfs:comment 'Foreign key linking to reference.reference_delta_tblproperties. Business justification: HIPAA retention annotations contain inline delta_tblproperty_key/value that reference Delta Lake table properties. Normalizing to a FK to reference_delta_tblproperties centralizes TBLPROPERTIES manage' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReferenceDeltaTblproperties .

ind:rlsReferenceRlsPredicatesId rdf:type rdf:Property ;
    rdfs:label 'Rls Reference Rls Predicates Id' ;
    rdfs:comment 'Foreign key linking to reference.reference_rls_predicates. Business justification: HIPAA retention annotations contain an inline rls_predicate_expression that references a Row-Level Security predicate. Normalizing to a FK to reference_rls_predicates centralizes RLS predicate managem' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReferenceRlsPredicates .

ind:ucTagReferenceUcTagDefinitionsId rdf:type rdf:Property ;
    rdfs:label 'Uc Tag Reference Uc Tag Definitions Id' ;
    rdfs:comment 'Foreign key linking to reference.reference_uc_tag_definitions. Business justification: HIPAA retention annotations reference specific Unity Catalog tag definitions (unity_catalog_tag_key/value are inline). Normalizing to a FK to reference_uc_tag_definitions allows centralized management' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReferenceUcTagDefinitions .

ind:annotationStatus rdf:type rdf:Property ;
    rdfs:label 'Annotation Status' ;
    rdfs:comment 'Current lifecycle status of this retention annotation rule within the governance framework.' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archiveStorageTier rdf:type rdf:Property ;
    rdfs:label 'Archive Storage Tier' ;
    rdfs:comment 'The cloud storage tier to which data is moved during the retention lifecycle, enabling cost optimization while maintaining HIPAA-compliant accessibility.' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditAccessLoggingRequired rdf:type rdf:Property ;
    rdfs:label 'Audit Access Logging Required' ;
    rdfs:comment 'Indicates whether all access to data governed by this annotation must be logged for HIPAA audit trail compliance.' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minorPatientExtensionYears rdf:type rdf:Property ;
    rdfs:label 'Minor Patient Extension Years' ;
    rdfs:comment 'Additional years of retention required when records pertain to minor patients. Many states require retention until the minor reaches age of majority plus standard retention period.' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:piiIndicator rdf:type rdf:Property ;
    rdfs:label 'Pii Indicator' ;
    rdfs:comment 'Indicates whether the data governed by this annotation contains Personally Identifiable Information requiring enhanced protection controls.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Policy Document Reference' ;
    rdfs:comment 'Reference identifier or URL to the organizational retention policy document that this annotation implements.' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purgeMethod rdf:type rdf:Property ;
    rdfs:label 'Purge Method' ;
    rdfs:comment 'The method used to dispose of data after the retention period expires. HIPAA requires secure destruction; method selection depends on data sensitivity and operational needs.' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tableNamePattern rdf:type rdf:Property ;
    rdfs:label 'Table Name Pattern' ;
    rdfs:comment 'Regex or glob pattern matching Delta Lake table names to which this retention annotation applies. Supports wildcard matching for bulk policy assignment across catalog schemas.' ;
    rdfs:domain ind:ReferenceHipaaRetentionAnnotations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rlsExamplesId rdf:type rdf:Property ;
    rdfs:label 'Rls Examples Id' ;
    rdfs:comment 'Primary key for rls_examples' ;
    rdfs:domain ind:RlsExamples ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accessPattern rdf:type rdf:Property ;
    rdfs:label 'Access Pattern' ;
    rdfs:comment 'The access control pattern this RLS example demonstrates, indicating the dimension along which row-level filtering is applied.' ;
    rdfs:domain ind:RlsExamples ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessRole rdf:type rdf:Property ;
    rdfs:label 'Access Role' ;
    rdfs:comment 'The security role or group to which this RLS predicate example applies (e.g., clinical_staff, billing_analyst, facility_admin).' ;
    rdfs:domain ind:RlsExamples ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableRegulation rdf:type rdf:Property ;
    rdfs:label 'Applicable Regulation' ;
    rdfs:comment 'The primary regulatory framework driving this RLS requirement (e.g., HIPAA, 42 CFR Part 2, state privacy law, HITRUST CSF).' ;
    rdfs:domain ind:RlsExamples ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exampleSql rdf:type rdf:Property ;
    rdfs:label 'Example Sql' ;
    rdfs:comment 'Complete SQL example demonstrating how to implement this RLS predicate in Databricks SQL, including CREATE FUNCTION or row filter syntax.' ;
    rdfs:domain ind:RlsExamples ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedRowCountReductionPct rdf:type rdf:Property ;
    rdfs:label 'Expected Row Count Reduction Pct' ;
    rdfs:comment 'The expected percentage of rows filtered out when this RLS predicate is applied, used for performance impact assessment and capacity planning.' ;
    rdfs:domain ind:RlsExamples ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumNecessaryScope rdf:type rdf:Property ;
    rdfs:label 'Minimum Necessary Scope' ;
    rdfs:comment 'Description of how this RLS rule implements the HIPAA minimum necessary standard, limiting access to only the PHI needed for the users role.' ;
    rdfs:domain ind:RlsExamples ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetColumn rdf:type rdf:Property ;
    rdfs:label 'Target Column' ;
    rdfs:comment 'The column name used in the RLS filter predicate expression, if the rule filters on a specific column value.' ;
    rdfs:domain ind:RlsExamples ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testQuery rdf:type rdf:Property ;
    rdfs:label 'Test Query' ;
    rdfs:comment 'SQL query used to validate that the RLS predicate is correctly filtering rows for the specified role, used in governance testing workflows.' ;
    rdfs:domain ind:RlsExamples ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaRetentionId rdf:type rdf:Property ;
    rdfs:label 'Hipaa Retention Id' ;
    rdfs:comment 'Primary key for hipaa_retention' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:automationJobName rdf:type rdf:Property ;
    rdfs:label 'Automation Job Name' ;
    rdfs:comment 'Name of the Databricks workflow or job responsible for automated enforcement of this retention policy, including archival and disposal operations.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deltaTblpropertiesKey rdf:type rdf:Property ;
    rdfs:label 'Delta Tblproperties Key' ;
    rdfs:comment 'The TBLPROPERTIES key set on the Delta table to encode HIPAA retention metadata for governance automation and compliance scanning.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deltaTblpropertiesValue rdf:type rdf:Property ;
    rdfs:label 'Delta Tblproperties Value' ;
    rdfs:comment 'The TBLPROPERTIES value encoding retention period, disposal method, and compliance references for automated governance enforcement on the Delta table.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disposalCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Disposal Certification Required' ;
    rdfs:comment 'Indicates whether formal certification of data destruction is required upon disposal, typically mandated for restricted PHI data assets.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Exception Flag' ;
    rdfs:comment 'Indicates whether this retention annotation represents an exception to the standard 7-year HIPAA retention period due to state law, research requirements, or other regulatory mandates.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionJustification rdf:type rdf:Property ;
    rdfs:label 'Exception Justification' ;
    rdfs:comment 'Documented business or regulatory justification for any deviation from the standard HIPAA retention period, required for audit purposes.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaRetentionStatus rdf:type rdf:Property ;
    rdfs:label 'Hipaa Retention Status' ;
    rdfs:comment 'Current lifecycle status of the HIPAA retention annotation, indicating whether the policy is actively enforced, under review, or has been superseded.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastScanTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Scan Timestamp' ;
    rdfs:comment 'Timestamp of the most recent automated scan that evaluated records in the governed asset against this retention policy.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalHoldFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Flag' ;
    rdfs:comment 'Indicates whether the data asset is currently under legal hold, which suspends all retention-based disposal actions regardless of retention period expiration.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalHoldReason rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Reason' ;
    rdfs:comment 'Description of the legal matter or litigation requiring the hold, documented for audit trail purposes when disposal is suspended.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumRetentionDate rdf:type rdf:Property ;
    rdfs:label 'Minimum Retention Date' ;
    rdfs:comment 'Earliest date on which data governed by this policy may be considered for disposal, calculated from the retention start event plus the applicable retention period.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minorRetentionExtensionYears rdf:type rdf:Property ;
    rdfs:label 'Minor Retention Extension Years' ;
    rdfs:comment 'Additional years of retention required for minor patient records beyond the standard period, typically extending until the patient reaches age of majority plus the base retention period.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordCountAtLastScan rdf:type rdf:Property ;
    rdfs:label 'Record Count At Last Scan' ;
    rdfs:comment 'Number of records in the governed data asset as of the most recent retention compliance scan, used for capacity planning and disposal impact assessment.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordsEligibleForDisposal rdf:type rdf:Property ;
    rdfs:label 'Records Eligible For Disposal' ;
    rdfs:comment 'Number of records identified as having exceeded their retention period and eligible for disposal at the last scan, pending legal hold and exception checks.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responsiblePrivacyOfficer rdf:type rdf:Property ;
    rdfs:label 'Responsible Privacy Officer' ;
    rdfs:comment 'Name of the HIPAA Privacy Officer or designated individual responsible for oversight and enforcement of this retention policy.' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateRetentionOverrideYears rdf:type rdf:Property ;
    rdfs:label 'State Retention Override Years' ;
    rdfs:comment 'State-mandated retention period that overrides the federal HIPAA minimum when the state requirement is longer (e.g., 10 years in some states for medical records).' ;
    rdfs:domain ind:HipaaRetention ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentCohortDefinitionClinicalAiDynamicCohortDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Parent Cohort Definition Clinical Ai Dynamic Cohort Definition Id' ;
    rdfs:comment 'Reference to a parent cohort definition from which this cohort was derived or refined, enabling hierarchical cohort relationships.' ;
    rdfs:domain ind:ClinicalAiDynamicCohortDefinition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalAiDynamicCohortDefinition .

ind:clinicalAiDynamicCohortDefinitionDescription rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Dynamic Cohort Definition Description' ;
    rdfs:comment 'Detailed narrative describing the clinical intent, target population characteristics, and intended use of the dynamic cohort.' ;
    rdfs:domain ind:ClinicalAiDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiDynamicCohortDefinitionStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Dynamic Cohort Definition Status' ;
    rdfs:comment 'Current lifecycle state of the cohort definition indicating whether it is actively computing membership or has been deactivated.' ;
    rdfs:domain ind:ClinicalAiDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositionLogic rdf:type rdf:Property ;
    rdfs:label 'Composition Logic' ;
    rdfs:comment 'Set operation used to combine child cohorts when this is a composite cohort definition.' ;
    rdfs:domain ind:ClinicalAiDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptCodeList rdf:type rdf:Property ;
    rdfs:label 'Cpt Code List' ;
    rdfs:comment 'Comma-separated list of CPT procedure codes used as criteria for cohort membership based on procedures received or ordered.' ;
    rdfs:domain ind:ClinicalAiDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10CodeList rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code List' ;
    rdfs:comment 'Comma-separated list of ICD-10 diagnosis codes that define the clinical conditions for cohort inclusion, supporting both specific codes and code ranges.' ;
    rdfs:domain ind:ClinicalAiDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isComposite rdf:type rdf:Property ;
    rdfs:label 'Is Composite' ;
    rdfs:comment 'Indicates whether this cohort is composed by combining (union, intersection, or exclusion) of other cohort definitions rather than direct clinical criteria.' ;
    rdfs:domain ind:ClinicalAiDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdohCriteria rdf:type rdf:Property ;
    rdfs:label 'Sdoh Criteria' ;
    rdfs:comment 'Social determinants of health factors used for cohort inclusion such as food insecurity, housing instability, transportation barriers, or health literacy levels.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetIntervention rdf:type rdf:Property ;
    rdfs:label 'Target Intervention' ;
    rdfs:comment 'Recommended clinical intervention or care pathway for patients identified in this cohort, such as outreach call, appointment scheduling, or medication review.' ;
    rdfs:domain ind:ClinicalAiDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationQuery rdf:type rdf:Property ;
    rdfs:label 'Validation Query' ;
    rdfs:comment 'SQL or CQL query used to validate cohort membership accuracy against known patient populations during quality assurance testing.' ;
    rdfs:domain ind:ClinicalAiDynamicCohortDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Test Care Site Id' ;
    rdfs:comment 'Identifier of the laboratory facility responsible for performing the genomic test (e.g., reference lab, in-house molecular lab).' ;
    rdfs:domain ind:TestOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:testFacilityCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Test Facility Care Site Id' ;
    rdfs:comment 'Identifier of the healthcare facility from which the genomic test order originated.' ;
    rdfs:domain ind:TestOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:actionableFinding rdf:type rdf:Property ;
    rdfs:label 'Actionable Finding' ;
    rdfs:comment 'Indicates whether the genomic test results contain clinically actionable findings that may influence treatment decisions or care pathways.' ;
    rdfs:domain ind:TestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageDepthRequested rdf:type rdf:Property ;
    rdfs:label 'Coverage Depth Requested' ;
    rdfs:comment 'Minimum sequencing coverage depth (e.g., 30x, 100x) requested for the genomic test to ensure analytical validity.' ;
    rdfs:domain ind:TestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:externalLabOrderReference rdf:type rdf:Property ;
    rdfs:label 'External Lab Order Reference' ;
    rdfs:comment 'Order identifier assigned by the external reference laboratory, used for cross-system reconciliation and result matching.' ;
    rdfs:domain ind:TestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentalFindingsPreference rdf:type rdf:Property ;
    rdfs:label 'Incidental Findings Preference' ;
    rdfs:comment 'Patient\'s stated preference regarding the reporting of secondary or incidental genomic findings unrelated to the primary indication.' ;
    rdfs:domain ind:TestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralToGenetics rdf:type rdf:Property ;
    rdfs:label 'Referral To Genetics' ;
    rdfs:comment 'Indicates whether a referral to a genetics specialist or genetic counselor was generated based on test results.' ;
    rdfs:domain ind:TestOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genomicsTestResultId rdf:type rdf:Property ;
    rdfs:label 'Genomics Test Result Id' ;
    rdfs:comment 'Primary key for genomics_test_result' ;
    rdfs:domain ind:GenomicsTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicsInterpretingGeneticistClinicianId rdf:type rdf:Property ;
    rdfs:label 'Genomics Interpreting Geneticist Clinician Id' ;
    rdfs:comment 'The clinical geneticist or molecular pathologist who interpreted and signed out the genomic test result.' ;
    rdfs:domain ind:GenomicsTestResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:consentForSecondaryFindings rdf:type rdf:Property ;
    rdfs:label 'Consent For Secondary Findings' ;
    rdfs:comment 'Indicates whether the patient consented to receive secondary/incidental genomic findings.' ;
    rdfs:domain ind:GenomicsTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalLabReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'External Lab Reference Number' ;
    rdfs:comment 'Reference number assigned by an external or send-out laboratory if the test was performed outside the health system.' ;
    rdfs:domain ind:GenomicsTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentalFindingFlag rdf:type rdf:Property ;
    rdfs:label 'Incidental Finding Flag' ;
    rdfs:comment 'Indicates whether secondary or incidental findings unrelated to the primary indication were identified per ACMG guidelines.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insurancePriorAuthNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Prior Auth Number' ;
    rdfs:comment 'Prior authorization number obtained from the payer for coverage of the genomic test.' ;
    rdfs:domain ind:GenomicsTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reanalysisRecommendedFlag rdf:type rdf:Property ;
    rdfs:label 'Reanalysis Recommended Flag' ;
    rdfs:comment 'Indicates whether periodic reanalysis of the genomic data is recommended as new evidence emerges.' ;
    rdfs:domain ind:GenomicsTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specimenCollectedDate rdf:type rdf:Property ;
    rdfs:label 'Specimen Collected Date' ;
    rdfs:comment 'Date the biological specimen was collected from the patient.' ;
    rdfs:domain ind:GenomicsTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:therapyImplicationSummary rdf:type rdf:Property ;
    rdfs:label 'Therapy Implication Summary' ;
    rdfs:comment 'Summary of therapeutic implications based on genomic findings, including potential targeted therapies or clinical trial eligibility.' ;
    rdfs:domain ind:GenomicsTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientProfileId rdf:type rdf:Property ;
    rdfs:label 'Patient Profile Id' ;
    rdfs:comment 'Primary key for patient_profile' ;
    rdfs:domain ind:PatientProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ancestryPopulation rdf:type rdf:Property ;
    rdfs:label 'Ancestry Population' ;
    rdfs:comment 'Self-reported or genomically-inferred ancestry population group used for variant frequency interpretation and risk calibration.' ;
    rdfs:domain ind:PatientProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benignVariantCount rdf:type rdf:Property ;
    rdfs:label 'Benign Variant Count' ;
    rdfs:comment 'Number of variants classified as benign or likely benign identified in this genomic profile.' ;
    rdfs:domain ind:PatientProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataSharingConsentLevel rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Consent Level' ;
    rdfs:comment 'Level of consent granted by the patient for sharing genomic data with external databases, registries, or research networks.' ;
    rdfs:domain ind:PatientProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneticCounselingDate rdf:type rdf:Property ;
    rdfs:label 'Genetic Counseling Date' ;
    rdfs:comment 'Date when genetic counseling was provided to the patient regarding their genomic profile results.' ;
    rdfs:domain ind:PatientProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patientProfileStatus rdf:type rdf:Property ;
    rdfs:label 'Patient Profile Status' ;
    rdfs:comment 'Current lifecycle status of the patient genomic profile from initial creation through completion and any subsequent amendments.' ;
    rdfs:domain ind:PatientProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequencingDepthMean rdf:type rdf:Property ;
    rdfs:label 'Sequencing Depth Mean' ;
    rdfs:comment 'Average sequencing depth (coverage) achieved across the targeted regions, indicating data quality and confidence in variant calls.' ;
    rdfs:domain ind:PatientProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:therapyRecommendationFlag rdf:type rdf:Property ;
    rdfs:label 'Therapy Recommendation Flag' ;
    rdfs:comment 'Indicates whether the genomic profile results include specific targeted therapy or treatment recommendations.' ;
    rdfs:domain ind:PatientProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attachmentPoint rdf:type rdf:Property ;
    rdfs:label 'Attachment Point' ;
    rdfs:comment 'The base data model entity to which this plugin attaches its output without modifying base tables (supports clean plugin keying per VREQ-022).' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aurocScore rdf:type rdf:Property ;
    rdfs:label 'Auroc Score' ;
    rdfs:comment 'The AUROC performance metric from the most recent model validation, indicating discriminative ability (0.5 = random, 1.0 = perfect).' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseTableTarget rdf:type rdf:Property ;
    rdfs:label 'Base Table Target' ;
    rdfs:comment 'Fully qualified name of the base model table whose primary key the plugin references for output storage (e.g., patient.patient, encounter.encounter).' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biasReviewDate rdf:type rdf:Property ;
    rdfs:label 'Bias Review Date' ;
    rdfs:comment 'Date of the most recent algorithmic fairness and bias review assessing disparate impact across demographic groups.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:executionFrequency rdf:type rdf:Property ;
    rdfs:label 'Execution Frequency' ;
    rdfs:comment 'How often the plugin is scheduled to compute or refresh its outcome scores.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryOutcomePluginCode rdf:type rdf:Property ;
    rdfs:label 'Industry Outcome Plugin Code' ;
    rdfs:comment 'Unique business identifier code for the plugin used in system integrations and API references (e.g., READMISSION_FORECAST, SEPSIS_SCORE, MORTALITY_RISK).' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryOutcomePluginDescription rdf:type rdf:Property ;
    rdfs:label 'Industry Outcome Plugin Description' ;
    rdfs:comment 'Detailed narrative describing the plugins purpose, methodology, and intended clinical or operational use case.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryOutcomePluginName rdf:type rdf:Property ;
    rdfs:label 'Industry Outcome Plugin Name' ;
    rdfs:comment 'Human-readable display name of the industry outcome plugin (e.g., 30-Day Readmission Forecast, Sepsis Early Warning Score).' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryOutcomePluginStatus rdf:type rdf:Property ;
    rdfs:label 'Industry Outcome Plugin Status' ;
    rdfs:comment 'Current lifecycle state of the plugin within the enterprise deployment pipeline.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Model Algorithm' ;
    rdfs:comment 'The machine learning or statistical algorithm used by the plugin (e.g., logistic regression, gradient boosting, neural network, rules-based).' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outputDataType rdf:type rdf:Property ;
    rdfs:label 'Output Data Type' ;
    rdfs:comment 'The data type of the plugins computed output (numeric score, probability, categorical label, binary flag, or ordinal rank).' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pluginType rdf:type rdf:Property ;
    rdfs:label 'Plugin Type' ;
    rdfs:comment 'Category of the outcome plugin indicating its analytical function (predictive model, scoring algorithm, classification engine, risk stratification, or quality measure).' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positivePredictiveValue rdf:type rdf:Property ;
    rdfs:label 'Positive Predictive Value' ;
    rdfs:comment 'Proportion of positive predictions that are true positives from the most recent validation run.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryClearanceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Clearance Flag' ;
    rdfs:comment 'Indicates whether the plugin has received FDA clearance or other regulatory approval as a clinical decision support tool.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresRealTimeDataFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Real Time Data Flag' ;
    rdfs:comment 'Indicates whether the plugin requires streaming or real-time data feeds (e.g., vital signs, lab results) versus batch historical data.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scoreRangeMax rdf:type rdf:Property ;
    rdfs:label 'Score Range Max' ;
    rdfs:comment 'The maximum possible value in the plugins output score range, used for normalization and interpretation.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreRangeMin rdf:type rdf:Property ;
    rdfs:label 'Score Range Min' ;
    rdfs:comment 'The minimum possible value in the plugins output score range, used for normalization and interpretation.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreThreshold rdf:type rdf:Property ;
    rdfs:label 'Score Threshold' ;
    rdfs:comment 'The threshold value above which the plugin output triggers a clinical alert or workflow action.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sensitivity rdf:type rdf:Property ;
    rdfs:label 'Sensitivity' ;
    rdfs:comment 'True positive rate of the model — proportion of actual positives correctly identified.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trainingCohortSize rdf:type rdf:Property ;
    rdfs:label 'Training Cohort Size' ;
    rdfs:comment 'Number of patient records or encounters used in the most recent model training cohort.' ;
    rdfs:domain ind:IndustryOutcomePlugin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:portalEngagementId rdf:type rdf:Property ;
    rdfs:label 'Portal Engagement Id' ;
    rdfs:comment 'Primary key for portal_engagement' ;
    rdfs:domain ind:PortalEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:browserApplication rdf:type rdf:Property ;
    rdfs:label 'Browser Application' ;
    rdfs:comment 'Browser or mobile application used to access the patient portal.' ;
    rdfs:domain ind:PortalEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementOutcome rdf:type rdf:Property ;
    rdfs:label 'Engagement Outcome' ;
    rdfs:comment 'Outcome of the portal engagement event indicating whether the intended action was successfully completed.' ;
    rdfs:domain ind:PortalEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFirstLogin rdf:type rdf:Property ;
    rdfs:label 'Is First Login' ;
    rdfs:comment 'Indicates whether this event represents the patient\'s first-ever login to the portal.' ;
    rdfs:domain ind:PortalEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isProxyAccess rdf:type rdf:Property ;
    rdfs:label 'Is Proxy Access' ;
    rdfs:comment 'Indicates whether this portal engagement was performed by an authorized proxy (e.g., parent, caregiver) on behalf of the patient.' ;
    rdfs:domain ind:PortalEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTaskCompleted rdf:type rdf:Property ;
    rdfs:label 'Is Task Completed' ;
    rdfs:comment 'Indicates whether the patient completed the intended task during this portal session (e.g., scheduled appointment, paid bill, submitted form).' ;
    rdfs:domain ind:PortalEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mychartActivityReference rdf:type rdf:Property ;
    rdfs:label 'Mychart Activity Reference' ;
    rdfs:comment 'Source system activity identifier from Epic MyChart or equivalent patient portal system for traceability.' ;
    rdfs:domain ind:PortalEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pageOrSection rdf:type rdf:Property ;
    rdfs:label 'Page Or Section' ;
    rdfs:comment 'Specific page, module, or section of the patient portal that was accessed during this event.' ;
    rdfs:domain ind:PortalEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:databricksGovernanceUcTagsId rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Uc Tags Id' ;
    rdfs:comment 'Primary key for databricks_governance_uc_tags' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetType rdf:type rdf:Property ;
    rdfs:label 'Asset Type' ;
    rdfs:comment 'The type of Unity Catalog securable object to which this tag definition applies. Determines the scope and applicability of the tag within the catalog hierarchy. [ENUM-REF-CANDIDATE: catalog|schema|table|view|column|volume|function|model|connection — promote to reference product]' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessDomain rdf:type rdf:Property ;
    rdfs:label 'Business Domain' ;
    rdfs:comment 'The healthcare business domain this tag is associated with (e.g., patient, encounter, clinical, billing, pharmacy). Aligns with the 22 enterprise data domains.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:columnName rdf:type rdf:Property ;
    rdfs:label 'Column Name' ;
    rdfs:comment 'The specific column name when the tag is applied at column-level granularity. Null for table-level, schema-level, or catalog-level tags.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByPrincipal rdf:type rdf:Property ;
    rdfs:label 'Created By Principal' ;
    rdfs:comment 'The identity principal (user or service principal) who originally created this tag definition. Supports accountability in governance workflows.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:databricksGovernanceUcTagsDescription rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Uc Tags Description' ;
    rdfs:comment 'Human-readable description of the tag\'s purpose, usage guidelines, and governance implications. Displayed in Unity Catalog UI for data consumers and stewards.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maskingPolicyName rdf:type rdf:Property ;
    rdfs:label 'Masking Policy Name' ;
    rdfs:comment 'Name of the Unity Catalog column masking function applied when this tag is present. Enables dynamic data masking for PHI/PII columns based on user privileges.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectName rdf:type rdf:Property ;
    rdfs:label 'Object Name' ;
    rdfs:comment 'The fully qualified name of the specific data object (table, view, column, volume, or function) to which this tag instance is applied.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerPrincipal rdf:type rdf:Property ;
    rdfs:label 'Owner Principal' ;
    rdfs:comment 'The identity principal (user, group, or service principal) responsible for maintaining this tag definition and its governance policies.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:piiSubcategory rdf:type rdf:Property ;
    rdfs:label 'Pii Subcategory' ;
    rdfs:comment 'Specific subcategory of PII classification when the tag marks personally identifiable information. Enables granular privacy controls and de-identification workflows. [ENUM-REF-CANDIDATE: pii_name|pii_email|pii_phone|pii_address|pii_identifier|pii_financial|pii_dob|pii_health|pii_biometric|pii_device — promote to reference product]' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stewardPrincipal rdf:type rdf:Property ;
    rdfs:label 'Steward Principal' ;
    rdfs:comment 'The identity principal designated as data steward for assets bearing this tag. Responsible for data quality and compliance oversight.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagStatus rdf:type rdf:Property ;
    rdfs:label 'Tag Status' ;
    rdfs:comment 'Current lifecycle status of this tag definition within the governance framework. Controls whether the tag is actively enforced, under review, or deprecated.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedByPrincipal rdf:type rdf:Property ;
    rdfs:label 'Updated By Principal' ;
    rdfs:comment 'The identity principal who last modified this tag definition. Supports change tracking and governance accountability.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationRegex rdf:type rdf:Property ;
    rdfs:label 'Validation Regex' ;
    rdfs:comment 'Regular expression pattern used to validate tag values at assignment time. Ensures data quality and consistency of governance metadata.' ;
    rdfs:domain ind:DatabricksGovernanceUcTags ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicsDataId rdf:type rdf:Property ;
    rdfs:label 'Genomics Data Id' ;
    rdfs:comment 'Primary key for genomics_data' ;
    rdfs:domain ind:GenomicsData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionableVariantCount rdf:type rdf:Property ;
    rdfs:label 'Actionable Variant Count' ;
    rdfs:comment 'Number of clinically actionable variants identified that have associated therapeutic, diagnostic, or prognostic implications.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:counselingCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Counseling Completed Flag' ;
    rdfs:comment 'Indicates whether the recommended genetic counseling session has been completed with the patient.' ;
    rdfs:domain ind:GenomicsData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:indicationDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Indication Diagnosis Code' ;
    rdfs:comment 'ICD-10-CM diagnosis code representing the clinical indication for ordering the genomic test.' ;
    rdfs:domain ind:GenomicsData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfVariantsDetected rdf:type rdf:Property ;
    rdfs:label 'Number Of Variants Detected' ;
    rdfs:comment 'Total count of reportable genomic variants identified in the analysis.' ;
    rdfs:domain ind:GenomicsData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specimenSite rdf:type rdf:Property ;
    rdfs:label 'Specimen Site' ;
    rdfs:comment 'Anatomical site from which the specimen was collected, particularly relevant for tumor biopsies.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicVariantResultId rdf:type rdf:Property ;
    rdfs:label 'Genomic Variant Result Id' ;
    rdfs:comment 'Primary key for genomic_variant_result' ;
    rdfs:domain ind:GenomicVariantResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicInterpretingPathologistClinicianId rdf:type rdf:Property ;
    rdfs:label 'Genomic Interpreting Pathologist Clinician Id' ;
    rdfs:comment 'Identifier of the molecular pathologist or geneticist who reviewed and interpreted the variant result.' ;
    rdfs:domain ind:GenomicVariantResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:exonNumber rdf:type rdf:Property ;
    rdfs:label 'Exon Number' ;
    rdfs:comment 'The exon or intron number within the gene where the variant is located, if applicable.' ;
    rdfs:domain ind:GenomicVariantResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportableFlag rdf:type rdf:Property ;
    rdfs:label 'Reportable Flag' ;
    rdfs:comment 'Indicates whether this variant meets criteria for inclusion in the final clinical report to the ordering provider.' ;
    rdfs:domain ind:GenomicVariantResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:somaticGermlineFlag rdf:type rdf:Property ;
    rdfs:label 'Somatic Germline Flag' ;
    rdfs:comment 'Classification of whether the variant is somatic (acquired in tumor) or germline (inherited), critical for treatment decisions.' ;
    rdfs:domain ind:GenomicVariantResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacogenomicsId rdf:type rdf:Property ;
    rdfs:label 'Pharmacogenomics Id' ;
    rdfs:comment 'Primary key for pharmacogenomics' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceGenomicTestId rdf:type rdf:Property ;
    rdfs:label 'Source Genomic Test Id' ;
    rdfs:comment 'Identifier linking to the original genomic test order from which this pharmacogenomic interpretation was derived.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicTest .

ind:activityScore rdf:type rdf:Property ;
    rdfs:label 'Activity Score' ;
    rdfs:comment 'Numeric activity score assigned to the diplotype used to translate genotype to phenotype per CPIC guidelines (e.g., 0, 0.5, 1.0, 1.5, 2.0).' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adverseEventRiskCategory rdf:type rdf:Property ;
    rdfs:label 'Adverse Event Risk Category' ;
    rdfs:comment 'Categorization of the patient\'s risk for adverse drug events based on their pharmacogenomic profile for the specified medication.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternativeDrugRecommendation rdf:type rdf:Property ;
    rdfs:label 'Alternative Drug Recommendation' ;
    rdfs:comment 'Recommended alternative medication(s) when the pharmacogenomic result indicates the primary drug may be ineffective or carry increased toxicity risk.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdsAlertOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Cds Alert Override Reason' ;
    rdfs:comment 'Reason documented by the provider if the clinical decision support alert based on pharmacogenomic data was overridden.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cpicGuidelineVersion rdf:type rdf:Property ;
    rdfs:label 'Cpic Guideline Version' ;
    rdfs:comment 'Version of the CPIC guideline used to generate the therapeutic recommendation for this gene-drug pair.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diplotype rdf:type rdf:Property ;
    rdfs:label 'Diplotype' ;
    rdfs:comment 'The diplotype assignment representing the combination of two haplotypes (star alleles) identified for the gene (e.g., *1/*2, *1/*17, *4/*5).' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dosingGuidance rdf:type rdf:Property ;
    rdfs:label 'Dosing Guidance' ;
    rdfs:comment 'Specific dosing guidance text derived from pharmacogenomic interpretation, including percentage adjustments or absolute dose recommendations.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugGeneInteractionLevel rdf:type rdf:Property ;
    rdfs:label 'Drug Gene Interaction Level' ;
    rdfs:comment 'CPIC evidence level classification indicating the strength of evidence for the gene-drug interaction (1A = guideline available with strong evidence, through 4 = limited evidence).' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugInteractionRisk rdf:type rdf:Property ;
    rdfs:label 'Drug Interaction Risk' ;
    rdfs:comment 'Risk level for adverse drug reactions or therapeutic failure based on the pharmacogenomic profile for the specified medication.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugMetabolismPathway rdf:type rdf:Property ;
    rdfs:label 'Drug Metabolism Pathway' ;
    rdfs:comment 'Primary metabolic pathway affected by the gene variant (e.g., CYP450 oxidation, glucuronidation, acetylation, thiopurine methylation).' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ehrIntegrationStatus rdf:type rdf:Property ;
    rdfs:label 'Ehr Integration Status' ;
    rdfs:comment 'Status indicating whether the pharmacogenomic result has been successfully integrated into the patient\'s electronic health record for clinical decision support.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethnicityContext rdf:type rdf:Property ;
    rdfs:label 'Ethnicity Context' ;
    rdfs:comment 'Self-reported ethnicity or ancestry used to contextualize allele frequency and phenotype prediction, as pharmacogenomic prevalence varies by population.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fdaLabelAnnotation rdf:type rdf:Property ;
    rdfs:label 'Fda Label Annotation' ;
    rdfs:comment 'Category of pharmacogenomic information present in the FDA-approved drug label (required testing, recommended testing, actionable, informative, or none).' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCdsAlertTriggered rdf:type rdf:Property ;
    rdfs:label 'Is Cds Alert Triggered' ;
    rdfs:comment 'Indicates whether a clinical decision support alert was triggered in the EHR based on this pharmacogenomic result when a relevant medication was ordered.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMultiGeneInteraction rdf:type rdf:Property ;
    rdfs:label 'Is Multi Gene Interaction' ;
    rdfs:comment 'Indicates whether this pharmacogenomic assessment involves interactions across multiple genes affecting the same drug metabolism pathway.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmgkbAnnotationAccession rdf:type rdf:Property ;
    rdfs:label 'Pharmgkb Annotation Accession' ;
    rdfs:comment 'Identifier from the Pharmacogenomics Knowledge Base (PharmGKB) linking to the curated annotation for this gene-drug relationship.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phenotype rdf:type rdf:Property ;
    rdfs:label 'Phenotype' ;
    rdfs:comment 'The predicted metabolizer phenotype derived from the diplotype (e.g., poor metabolizer, intermediate metabolizer, normal metabolizer, rapid metabolizer, ultrarapid metabolizer). [ENUM-REF-CANDIDATE: poor_metabolizer|intermediate_metabolizer|normal_metabolizer|rapid_metabolizer|ultrarapid_metabolizer|indeterminate|likely_poor|likely_intermediate — promote to reference product]' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendationClassification rdf:type rdf:Property ;
    rdfs:label 'Recommendation Classification' ;
    rdfs:comment 'Strength classification of the pharmacogenomic recommendation indicating how strongly the clinical action is supported by evidence.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultDisclosureStatus rdf:type rdf:Property ;
    rdfs:label 'Result Disclosure Status' ;
    rdfs:comment 'Status of whether the pharmacogenomic result has been disclosed to the patient, per genetic counseling and informed consent requirements.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testPlatform rdf:type rdf:Property ;
    rdfs:label 'Test Platform' ;
    rdfs:comment 'Name or identifier of the genotyping platform or assay used to generate the pharmacogenomic result.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticRecommendation rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Recommendation' ;
    rdfs:comment 'Clinical recommendation for drug therapy based on the pharmacogenomic result, such as dose adjustment, alternative drug selection, or standard dosing.' ;
    rdfs:domain ind:Pharmacogenomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiPopulationHealthId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Id' ;
    rdfs:comment 'Primary key for clinical_ai_population_health' ;
    rdfs:domain ind:ClinicalAiPopulationHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baselineOutcomeValue rdf:type rdf:Property ;
    rdfs:label 'Baseline Outcome Value' ;
    rdfs:comment 'Measured value of the outcome metric at cohort creation or program start, serving as the benchmark against which improvement is tracked.' ;
    rdfs:domain ind:ClinicalAiPopulationHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalAiPopulationHealthStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Population Health Status' ;
    rdfs:comment 'Current lifecycle state of the cohort definition indicating whether it is actively identifying patients.' ;
    rdfs:domain ind:ClinicalAiPopulationHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScoreModelName rdf:type rdf:Property ;
    rdfs:label 'Risk Score Model Name' ;
    rdfs:comment 'Name of the AI/ML risk stratification model used to score patients within this cohort (e.g., LACE Index, HCC Risk Adjustment, custom ML model).' ;
    rdfs:domain ind:ClinicalAiPopulationHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Months' ;
    rdfs:comment 'Lookback window in months used to evaluate patient clinical data against cohort criteria (e.g., 12 months for annual quality measures).' ;
    rdfs:domain ind:PopulationCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationCohortCode rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Code' ;
    rdfs:comment 'Externally-known unique business code assigned to this cohort for cross-system reference and reporting.' ;
    rdfs:domain ind:PopulationCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohortDescription rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Description' ;
    rdfs:comment 'Detailed narrative describing the clinical rationale, target population characteristics, and intended use of this cohort.' ;
    rdfs:domain ind:PopulationCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohortName rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Name' ;
    rdfs:comment 'Human-readable descriptive name of the population cohort (e.g., \'Diabetes Type 2 High Risk Adults 65+\').' ;
    rdfs:domain ind:PopulationCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationCohortStatus rdf:type rdf:Property ;
    rdfs:label 'Population Cohort Status' ;
    rdfs:comment 'Current lifecycle state of the cohort definition indicating whether it is actively used for patient identification and reporting.' ;
    rdfs:domain ind:PopulationCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programAffiliation rdf:type rdf:Property ;
    rdfs:label 'Program Affiliation' ;
    rdfs:comment 'Value-based care program or initiative this cohort supports (e.g., ACO REACH, MSSP, Bundled Payments, commercial VBP contract).' ;
    rdfs:domain ind:PopulationCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Retention Period Months' ;
    rdfs:comment 'Number of months cohort membership history must be retained per regulatory and organizational data governance policy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetSize rdf:type rdf:Property ;
    rdfs:label 'Target Size' ;
    rdfs:comment 'Expected or target number of patients to be enrolled in this cohort based on population estimates.' ;
    rdfs:domain ind:PopulationCohort ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acceptingNewPatients rdf:type rdf:Property ;
    rdfs:label 'Accepting New Patients' ;
    rdfs:comment 'Indicates whether the participant is currently accepting new patients or members through this network.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accessibilityFeatures rdf:type rdf:Property ;
    rdfs:label 'Accessibility Features' ;
    rdfs:comment 'ADA accessibility features available at the participant\'s service location, used for member directory and network adequacy compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRenewFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renew Flag' ;
    rdfs:comment 'Indicates whether the participation agreement automatically renews at the end of the contract term.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capitationRate rdf:type rdf:Property ;
    rdfs:label 'Capitation Rate' ;
    rdfs:comment 'Per-member-per-month (PMPM) capitation rate for capitated arrangements. Null for fee-for-service contracts.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:continuityOfCareEndDate rdf:type rdf:Property ;
    rdfs:label 'Continuity Of Care End Date' ;
    rdfs:comment 'Date through which the terminated participant must continue providing care to existing patients under continuity of care provisions.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Number' ;
    rdfs:comment 'Externally-known contract or agreement number governing this network participation arrangement.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Contract Renewal Date' ;
    rdfs:comment 'Date on which the participation contract is scheduled for renewal or renegotiation.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractType rdf:type rdf:Property ;
    rdfs:label 'Contract Type' ;
    rdfs:comment 'The reimbursement model governing this network participation arrangement.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingDate rdf:type rdf:Property ;
    rdfs:label 'Credentialing Date' ;
    rdfs:comment 'Date when the participant completed the credentialing process required for network admission.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:currentPanelSize rdf:type rdf:Property ;
    rdfs:label 'Current Panel Size' ;
    rdfs:comment 'Current number of patients or members assigned to this participant within the network.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:delegationIndicator rdf:type rdf:Property ;
    rdfs:label 'Delegation Indicator' ;
    rdfs:comment 'Indicates whether credentialing or utilization management functions are delegated to the participating entity.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:directoryDisplayName rdf:type rdf:Property ;
    rdfs:label 'Directory Display Name' ;
    rdfs:comment 'Name as it should appear in the payer\'s provider directory for member-facing searches.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directoryPublishFlag rdf:type rdf:Property ;
    rdfs:label 'Directory Publish Flag' ;
    rdfs:comment 'Indicates whether this participation record should be published in the payer\'s public provider directory.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentApplicationDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Application Date' ;
    rdfs:comment 'Date the participant submitted their application for network enrollment.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:languageCapabilities rdf:type rdf:Property ;
    rdfs:label 'Language Capabilities' ;
    rdfs:comment 'Languages in which the participant can provide services, stored as comma-separated ISO 639-1 codes for directory and access reporting.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participantIdentifier rdf:type rdf:Property ;
    rdfs:label 'Participant Identifier' ;
    rdfs:comment 'Identifier of the entity participating in the network. Refers to a provider, facility, or billing entity depending on participant_type.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:participationCategory rdf:type rdf:Property ;
    rdfs:label 'Participation Category' ;
    rdfs:comment 'Broad classification of the participation arrangement indicating in-network, out-of-network, participating (PAR), or non-participating (non-PAR) status.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaCode rdf:type rdf:Property ;
    rdfs:label 'Service Area Code' ;
    rdfs:comment 'Geographic service area code defining where the participant provides covered services within the network.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdentifierNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Identifier Number' ;
    rdfs:comment 'Federal tax identification number (EIN or SSN) of the participating entity for reimbursement and 1099 reporting purposes.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Withhold Percentage' ;
    rdfs:comment 'Percentage of reimbursement withheld pending quality or utilization performance targets.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validTo rdf:type rdf:Property ;
    rdfs:label 'Valid To' ;
    rdfs:comment 'SCD Type 2 timestamp indicating when this version of the record was superseded. Null for the current active version.' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:genomicProfileId rdf:type rdf:Property ;
    rdfs:label 'Genomic Profile Id' ;
    rdfs:comment 'Primary key for genomic_profile' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brcaStatus rdf:type rdf:Property ;
    rdfs:label 'Brca Status' ;
    rdfs:comment 'BRCA1/BRCA2 mutation status indicating presence of pathogenic variants relevant for PARP inhibitor therapy and hereditary risk counseling.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalTrialMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Match Flag' ;
    rdfs:comment 'Indicates whether the genomic findings match eligibility criteria for any active clinical trials.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSharingConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Consent Flag' ;
    rdfs:comment 'Indicates whether the patient consented to sharing de-identified genomic data for research purposes.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReportReference rdf:type rdf:Property ;
    rdfs:label 'External Report Reference' ;
    rdfs:comment 'Unique report identifier assigned by the external reference laboratory performing the genomic analysis.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneticCounselingReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Genetic Counseling Referral Flag' ;
    rdfs:comment 'Indicates whether the genomic findings triggered a referral to genetic counseling services.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genomicProfileStatus rdf:type rdf:Property ;
    rdfs:label 'Genomic Profile Status' ;
    rdfs:comment 'Current lifecycle status of the genomic profile from order through final reporting.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hl7MessageControlNumber rdf:type rdf:Property ;
    rdfs:label 'Hl7 Message Control Number' ;
    rdfs:comment 'Identifier of the HL7 or FHIR message through which the genomic results were electronically received into the EHR.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpretingPathologist rdf:type rdf:Property ;
    rdfs:label 'Interpreting Pathologist' ;
    rdfs:comment 'Name of the molecular pathologist or geneticist who signed out the genomic interpretation report.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:panelGeneCount rdf:type rdf:Property ;
    rdfs:label 'Panel Gene Count' ;
    rdfs:comment 'Number of genes included in the targeted genomic panel used for this profile.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recommendedTherapies rdf:type rdf:Property ;
    rdfs:label 'Recommended Therapies' ;
    rdfs:comment 'Comma-separated list of FDA-approved or guideline-recommended targeted therapies matched to the identified genomic alterations.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resistanceMarkers rdf:type rdf:Property ;
    rdfs:label 'Resistance Markers' ;
    rdfs:comment 'Identified genomic markers associated with resistance to specific therapeutic agents, informing treatment avoidance decisions.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultReviewedDate rdf:type rdf:Property ;
    rdfs:label 'Result Reviewed Date' ;
    rdfs:comment 'Date when the ordering provider reviewed and acknowledged the genomic profile results.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:therapyMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Therapy Match Flag' ;
    rdfs:comment 'Indicates whether the genomic profile identified at least one FDA-approved or NCCN-recommended targeted therapy option.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalVariantCount rdf:type rdf:Property ;
    rdfs:label 'Total Variant Count' ;
    rdfs:comment 'Total number of genomic variants detected across all significance tiers in this profile.' ;
    rdfs:domain ind:GenomicProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trialMatchingId rdf:type rdf:Property ;
    rdfs:label 'Trial Matching Id' ;
    rdfs:comment 'Primary key for trial_matching' ;
    rdfs:domain ind:TrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:criteriaDataCompletenessPct rdf:type rdf:Property ;
    rdfs:label 'Criteria Data Completeness Pct' ;
    rdfs:comment 'Percentage of eligibility criteria that could be evaluated based on available patient data, indicating data sufficiency for the matching decision.' ;
    rdfs:domain ind:TrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchingNumber rdf:type rdf:Property ;
    rdfs:label 'Matching Number' ;
    rdfs:comment 'Business-facing reference number assigned to this trial matching evaluation for tracking and communication purposes.' ;
    rdfs:domain ind:TrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingStatus rdf:type rdf:Property ;
    rdfs:label 'Matching Status' ;
    rdfs:comment 'Current status of the patient-to-trial matching evaluation workflow indicating eligibility determination outcome.' ;
    rdfs:domain ind:TrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingType rdf:type rdf:Property ;
    rdfs:label 'Matching Type' ;
    rdfs:comment 'Method used to perform the eligibility matching evaluation, distinguishing automated algorithmic matching from manual clinical review.' ;
    rdfs:domain ind:TrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorTreatmentMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Treatment Match Flag' ;
    rdfs:comment 'Indicates whether the patients prior treatment history satisfies the trials requirements for previous therapy lines or washout periods.' ;
    rdfs:domain ind:TrialMatching ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acceptsMedicaidFlag rdf:type rdf:Property ;
    rdfs:label 'Accepts Medicaid Flag' ;
    rdfs:comment 'Indicates whether the community resource accepts Medicaid as a form of payment or eligibility verification for services rendered.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acceptsUninsuredFlag rdf:type rdf:Property ;
    rdfs:label 'Accepts Uninsured Flag' ;
    rdfs:comment 'Indicates whether the community resource provides services to individuals without health insurance coverage, important for SDOH referral matching.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityLimit rdf:type rdf:Property ;
    rdfs:label 'Capacity Limit' ;
    rdfs:comment 'Maximum number of individuals or families the community resource can serve at any given time, used for referral load balancing and waitlist management.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closedLoopEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Closed Loop Enabled Flag' ;
    rdfs:comment 'Indicates whether this community resource supports closed-loop referral tracking, meaning they provide feedback on referral outcomes back to the referring healthcare organization.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communityResourceCategory rdf:type rdf:Property ;
    rdfs:label 'Community Resource Category' ;
    rdfs:comment 'Organizational category of the community resource provider, indicating the sector or entity type that operates the resource.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communityResourceDescription rdf:type rdf:Property ;
    rdfs:label 'Community Resource Description' ;
    rdfs:comment 'Detailed narrative description of the services, programs, and support offered by the community resource, including scope of assistance and target population served.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communityResourceName rdf:type rdf:Property ;
    rdfs:label 'Community Resource Name' ;
    rdfs:comment 'The official name of the community resource, organization, or program (e.g., \'Meals on Wheels of Greater Springfield\', \'County Housing Authority Assistance Program\').' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communityResourceStatus rdf:type rdf:Property ;
    rdfs:label 'Community Resource Status' ;
    rdfs:comment 'Current operational status of the community resource indicating whether it is available for patient referrals and community health worker (CHW) interventions.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costToClient rdf:type rdf:Property ;
    rdfs:label 'Cost To Client' ;
    rdfs:comment 'Indicates the cost structure for clients accessing this community resource, enabling care coordinators to match patients with affordable services.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentAvailabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Current Availability Flag' ;
    rdfs:comment 'Indicates whether the community resource currently has capacity to accept new referrals. True means accepting referrals; false means at capacity or temporarily unavailable.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSharingConsentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Consent Required Flag' ;
    rdfs:comment 'Indicates whether patient consent is required before sharing patient information with this community resource as part of the referral process, per HIPAA and state privacy regulations.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSeasonal rdf:type rdf:Property ;
    rdfs:label 'Is Seasonal' ;
    rdfs:comment 'Indicates whether this community resource operates only during specific seasons or time periods (e.g., winter heating assistance, summer meal programs).' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languagesOffered rdf:type rdf:Property ;
    rdfs:label 'Languages Offered' ;
    rdfs:comment 'Comma-separated list of languages in which services are available at this community resource, critical for matching patients with language-appropriate services.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partnershipAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Partnership Agreement Flag' ;
    rdfs:comment 'Indicates whether the healthcare organization has a formal partnership or memorandum of understanding (MOU) with this community resource for closed-loop referral tracking.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityRating rdf:type rdf:Property ;
    rdfs:label 'Quality Rating' ;
    rdfs:comment 'Aggregate quality or satisfaction rating for the community resource based on patient feedback, care coordinator assessments, or accreditation scores, on a scale of 0.0 to 5.0.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordCreatedDatetime rdf:type rdf:Property ;
    rdfs:label 'Record Created Datetime' ;
    rdfs:comment 'Timestamp when this community resource record was first created in the system, supporting audit trail and data governance requirements.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedDatetime rdf:type rdf:Property ;
    rdfs:label 'Record Updated Datetime' ;
    rdfs:comment 'Timestamp when this community resource record was last modified, supporting data currency tracking and SCD Type 2 change detection.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referralMethod rdf:type rdf:Property ;
    rdfs:label 'Referral Method' ;
    rdfs:comment 'Preferred or accepted method for submitting referrals to this community resource from healthcare organizations or community health workers.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralTurnaroundDays rdf:type rdf:Property ;
    rdfs:label 'Referral Turnaround Days' ;
    rdfs:comment 'Expected number of business days from referral submission to initial client contact or service initiation, used for setting patient expectations and follow-up scheduling.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalAvailabilityNotes rdf:type rdf:Property ;
    rdfs:label 'Seasonal Availability Notes' ;
    rdfs:comment 'Description of seasonal availability windows for resources that do not operate year-round (e.g., \'November through March\' for heating assistance).' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaDescription rdf:type rdf:Property ;
    rdfs:label 'Service Area Description' ;
    rdfs:comment 'Narrative description of the geographic area served by this community resource (e.g., \'All of Franklin County\', \'ZIP codes 43201-43215\'), used for eligibility determination.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transportationAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Transportation Available Flag' ;
    rdfs:comment 'Indicates whether the community resource provides or arranges transportation for clients to access services, critical for patients with transportation barriers.' ;
    rdfs:domain ind:CommunityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentRefreshLogCohortRefreshLogId rdf:type rdf:Property ;
    rdfs:label 'Parent Refresh Log Cohort Refresh Log Id' ;
    rdfs:comment 'Self-referencing identifier linking this log entry to a parent refresh execution, used when a refresh is split into sub-tasks or retried.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CohortRefreshLog .

ind:careGapRefreshFlag rdf:type rdf:Property ;
    rdfs:label 'Care Gap Refresh Flag' ;
    rdfs:comment 'Indicates whether this cohort refresh also triggered a recalculation of care gaps for the affected patient population.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cohortDefinitionVersion rdf:type rdf:Property ;
    rdfs:label 'Cohort Definition Version' ;
    rdfs:comment 'Version identifier of the cohort inclusion/exclusion criteria definition that was applied during this refresh cycle, enabling traceability of criteria changes over time.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataExtractionEnd rdf:type rdf:Property ;
    rdfs:label 'Data Extraction End' ;
    rdfs:comment 'The end of the data extraction time window used for this refresh, defining the latest clinical data considered for cohort membership evaluation.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataExtractionStart rdf:type rdf:Property ;
    rdfs:label 'Data Extraction Start' ;
    rdfs:comment 'The beginning of the data extraction time window used for this refresh, defining the earliest clinical data considered for cohort membership evaluation.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exclusionCriteriaHash rdf:type rdf:Property ;
    rdfs:label 'Exclusion Criteria Hash' ;
    rdfs:comment 'A hash value representing the specific exclusion criteria logic applied during this refresh, enabling detection of criteria changes between refresh cycles.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionCriteriaHash rdf:type rdf:Property ;
    rdfs:label 'Inclusion Criteria Hash' ;
    rdfs:comment 'A hash value representing the specific inclusion criteria logic applied during this refresh, enabling detection of criteria changes between refresh cycles.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurePeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Measure Period End' ;
    rdfs:comment 'The end date of the quality measurement period for which this cohort refresh is relevant, aligning with HEDIS or CMS reporting periods.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurePeriodStart rdf:type rdf:Property ;
    rdfs:label 'Measure Period Start' ;
    rdfs:comment 'The start date of the quality measurement period for which this cohort refresh is relevant, aligning with HEDIS or CMS reporting periods.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:membersAddedCount rdf:type rdf:Property ;
    rdfs:label 'Members Added Count' ;
    rdfs:comment 'Number of new patients or members added to the cohort during this refresh cycle based on meeting inclusion criteria.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:membersRemovedCount rdf:type rdf:Property ;
    rdfs:label 'Members Removed Count' ;
    rdfs:comment 'Number of patients or members removed from the cohort during this refresh cycle due to no longer meeting inclusion criteria or meeting exclusion criteria.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postMemberCount rdf:type rdf:Property ;
    rdfs:label 'Post Member Count' ;
    rdfs:comment 'Total number of patients or members in the cohort after the refresh completed, representing the current cohort size.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorMemberCount rdf:type rdf:Property ;
    rdfs:label 'Prior Member Count' ;
    rdfs:comment 'Total number of patients or members in the cohort immediately before this refresh was executed, used to calculate net membership changes.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordsEvaluatedCount rdf:type rdf:Property ;
    rdfs:label 'Records Evaluated Count' ;
    rdfs:comment 'Total number of patient records evaluated against the cohort inclusion and exclusion criteria during this refresh execution.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:refreshStatus rdf:type rdf:Property ;
    rdfs:label 'Refresh Status' ;
    rdfs:comment 'Current lifecycle status of the cohort refresh execution indicating whether the process completed successfully, failed, is still running, was cancelled, or partially completed.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refreshTimestamp rdf:type rdf:Property ;
    rdfs:label 'Refresh Timestamp' ;
    rdfs:comment 'The date and time when the cohort refresh process was initiated. This is the principal business event timestamp for the log entry.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:refreshType rdf:type rdf:Property ;
    rdfs:label 'Refresh Type' ;
    rdfs:comment 'Classification of the refresh operation indicating whether it was a full rebuild of the cohort membership, an incremental update, a delta-only change, a manual ad-hoc execution, or a scheduled automated run.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStratificationAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Applied Flag' ;
    rdfs:comment 'Indicates whether risk stratification scoring was applied to cohort members during this refresh cycle for care prioritization purposes.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdohCriteriaIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Sdoh Criteria Included Flag' ;
    rdfs:comment 'Indicates whether Social Determinants of Health criteria (housing, food security, transportation, etc.) were included in the cohort identification logic for this refresh.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validationNotes rdf:type rdf:Property ;
    rdfs:label 'Validation Notes' ;
    rdfs:comment 'Free-text notes from the post-refresh validation process documenting any anomalies, warnings, or observations about the refresh results.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationPassedFlag rdf:type rdf:Property ;
    rdfs:label 'Validation Passed Flag' ;
    rdfs:comment 'Indicates whether the post-refresh validation checks (membership count thresholds, data completeness, criteria consistency) all passed successfully.' ;
    rdfs:domain ind:CohortRefreshLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cohortOutcomeTrackingStatus rdf:type rdf:Property ;
    rdfs:label 'Cohort Outcome Tracking Status' ;
    rdfs:comment 'Current lifecycle status of the outcome tracking record indicating whether the patient has met, not met, or is still being evaluated against the outcome measure.' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapInCareFlag rdf:type rdf:Property ;
    rdfs:label 'Gap In Care Flag' ;
    rdfs:comment 'Indicates whether a gap in care exists for this patient-measure combination, meaning the patient has not yet received recommended services or achieved the target.' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:improvementPercentage rdf:type rdf:Property ;
    rdfs:label 'Improvement Percentage' ;
    rdfs:comment 'Percentage improvement from baseline to current outcome value, calculated as ((baseline - current) / baseline) * 100 for measures where lower is better, or inverse for higher-is-better measures.' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDenominatorEligible rdf:type rdf:Property ;
    rdfs:label 'Is Denominator Eligible' ;
    rdfs:comment 'Indicates whether the patient is eligible for inclusion in the measure denominator based on age, diagnosis, and enrollment criteria.' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNumeratorCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Numerator Compliant' ;
    rdfs:comment 'Indicates whether the patient meets the numerator criteria for the quality measure, meaning the desired outcome or service has been achieved.' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measureDomain rdf:type rdf:Property ;
    rdfs:label 'Measure Domain' ;
    rdfs:comment 'Clinical domain of the quality measure (e.g., diabetes management, cardiovascular health, behavioral health, preventive care, medication management).' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Date' ;
    rdfs:comment 'The date on which the outcome was most recently measured or assessed for this patient within the cohort.' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outcomeAchievedDate rdf:type rdf:Property ;
    rdfs:label 'Outcome Achieved Date' ;
    rdfs:comment 'Actual date when the patient first achieved the target outcome, null if not yet achieved.' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outcomeType rdf:type rdf:Property ;
    rdfs:label 'Outcome Type' ;
    rdfs:comment 'Classification of the outcome being tracked: clinical (lab values, vitals), utilization (ED visits, readmissions), cost (total cost of care), experience (patient satisfaction), or functional (ADL improvement).' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeValue rdf:type rdf:Property ;
    rdfs:label 'Outcome Value' ;
    rdfs:comment 'The actual numeric value of the outcome measurement (e.g., HbA1c level of 7.2, systolic BP of 130, number of ED visits).' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outcomeValueUnit rdf:type rdf:Property ;
    rdfs:label 'Outcome Value Unit' ;
    rdfs:comment 'Unit of measure for the outcome value (e.g., %, mg/dL, mmHg, count, days).' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Sdoh Impact Flag' ;
    rdfs:comment 'Indicates whether social determinants of health factors (food insecurity, housing instability, transportation barriers) have been identified as impacting this patient\'s outcome achievement.' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetAchievementDate rdf:type rdf:Property ;
    rdfs:label 'Target Achievement Date' ;
    rdfs:comment 'Date by which the outcome target should be achieved per the care plan or quality measure specification.' ;
    rdfs:domain ind:CohortOutcomeTracking ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:parentBundleServiceBundleId rdf:type rdf:Property ;
    rdfs:label 'Parent Bundle Service Bundle Id' ;
    rdfs:comment 'Self-referential identifier pointing to the parent service bundle when this bundle is a component of a larger composite bundle.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceBundle .

ind:ageGroupEligibility rdf:type rdf:Property ;
    rdfs:label 'Age Group Eligibility' ;
    rdfs:comment 'Patient age group for which this service bundle is clinically appropriate and approved.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationValidityDays rdf:type rdf:Property ;
    rdfs:label 'Authorization Validity Days' ;
    rdfs:comment 'Number of days a prior authorization remains valid for this service bundle once approved by the payer.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bundleCode rdf:type rdf:Property ;
    rdfs:label 'Bundle Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this service bundle in billing and clinical systems. Used for cross-system reference and payer communication.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bundleType rdf:type rdf:Property ;
    rdfs:label 'Bundle Type' ;
    rdfs:comment 'Classification of the service bundle by clinical care category. Determines applicable clinical protocols and reimbursement pathways. [ENUM-REF-CANDIDATE: rehabilitation|palliative|transitional|chronic|wound_care|cardiac|respiratory|neurological|orthopedic — promote to reference product]' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bundledPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Bundled Payment Amount' ;
    rdfs:comment 'Standard reimbursement amount for the complete service bundle under bundled payment arrangements. Used for financial planning and contract negotiations.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalPathwayReference rdf:type rdf:Property ;
    rdfs:label 'Clinical Pathway Reference' ;
    rdfs:comment 'Reference identifier linking to the evidence-based clinical pathway or protocol that governs the delivery of services within this bundle.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsEpisodeGroupCode rdf:type rdf:Property ;
    rdfs:label 'Cms Episode Group Code' ;
    rdfs:comment 'CMS-defined episode group code that this service bundle aligns with for bundled payment and episode-based cost measurement purposes.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Estimate Amount' ;
    rdfs:comment 'Estimated internal cost to deliver all services in this bundle, used for margin analysis and value-based care financial modeling.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedDurationDays rdf:type rdf:Property ;
    rdfs:label 'Expected Duration Days' ;
    rdfs:comment 'Standard expected duration in calendar days for completion of all services within this bundle under normal clinical progression.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:functionalStatusRequirement rdf:type rdf:Property ;
    rdfs:label 'Functional Status Requirement' ;
    rdfs:comment 'Minimum or target functional status criteria (e.g., mobility level, ADL independence) that patients must meet for eligibility or that the bundle aims to achieve.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hcpcsProcedureCodes rdf:type rdf:Property ;
    rdfs:label 'Hcpcs Procedure Codes' ;
    rdfs:comment 'Comma-separated list of primary HCPCS codes representing the procedures and services included in this bundle for billing and claims purposes.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaRetentionPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Hipaa Retention Period Years' ;
    rdfs:comment 'Number of years this service bundle record and associated documentation must be retained per HIPAA and state regulatory requirements.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:includesDme rdf:type rdf:Property ;
    rdfs:label 'Includes Dme' ;
    rdfs:comment 'Indicates whether this service bundle includes provision of durable medical equipment such as walkers, hospital beds, or oxygen equipment.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesNursingServices rdf:type rdf:Property ;
    rdfs:label 'Includes Nursing Services' ;
    rdfs:comment 'Indicates whether this service bundle includes skilled nursing services such as wound care, medication management, or clinical monitoring.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesSocialServices rdf:type rdf:Property ;
    rdfs:label 'Includes Social Services' ;
    rdfs:comment 'Indicates whether this service bundle includes medical social work, care coordination, or social determinants of health (SDOH) interventions.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesTelehealth rdf:type rdf:Property ;
    rdfs:label 'Includes Telehealth' ;
    rdfs:comment 'Indicates whether this service bundle incorporates telehealth or remote patient monitoring components.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesTherapyServices rdf:type rdf:Property ;
    rdfs:label 'Includes Therapy Services' ;
    rdfs:comment 'Indicates whether this service bundle includes physical therapy, occupational therapy, or speech-language pathology services.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCompositeBundle rdf:type rdf:Property ;
    rdfs:label 'Is Composite Bundle' ;
    rdfs:comment 'Indicates whether this service bundle is composed of multiple sub-bundles that can also be ordered independently.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumDurationDays rdf:type rdf:Property ;
    rdfs:label 'Minimum Duration Days' ;
    rdfs:comment 'Minimum number of days required to deliver all services in this bundle while maintaining clinical quality standards.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumStaffFte rdf:type rdf:Property ;
    rdfs:label 'Minimum Staff Fte' ;
    rdfs:comment 'Minimum full-time equivalent staffing required to deliver this service bundle to a standard patient caseload.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outcomeMeasureTarget rdf:type rdf:Property ;
    rdfs:label 'Outcome Measure Target' ;
    rdfs:comment 'Primary clinical outcome measure and target threshold used to evaluate the effectiveness of this service bundle (e.g., functional improvement score, pain reduction percentage).' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientAcuityLevel rdf:type rdf:Property ;
    rdfs:label 'Patient Acuity Level' ;
    rdfs:comment 'Target patient acuity level for which this service bundle is designed, guiding appropriate patient-bundle matching during discharge planning.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerContractCategory rdf:type rdf:Property ;
    rdfs:label 'Payer Contract Category' ;
    rdfs:comment 'Primary payer category for which this service bundle is contracted and priced. Determines applicable fee schedules and authorization requirements.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionRiskTarget rdf:type rdf:Property ;
    rdfs:label 'Readmission Risk Target' ;
    rdfs:comment 'Target readmission risk category that this bundle is designed to mitigate, supporting hospital readmission reduction program compliance.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryProgramAlignment rdf:type rdf:Property ;
    rdfs:label 'Regulatory Program Alignment' ;
    rdfs:comment 'CMS or state regulatory program(s) this service bundle is designed to comply with, such as BPCI Advanced, CJR, or state Medicaid waiver programs.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueCodeRange rdf:type rdf:Property ;
    rdfs:label 'Revenue Code Range' ;
    rdfs:comment 'Range of UB-04 revenue codes applicable to services within this bundle, used for institutional claim generation.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceBundleDescription rdf:type rdf:Property ;
    rdfs:label 'Service Bundle Description' ;
    rdfs:comment 'Detailed narrative description of the services included in this bundle, their clinical purpose, and intended patient population.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceBundleName rdf:type rdf:Property ;
    rdfs:label 'Service Bundle Name' ;
    rdfs:comment 'Human-readable name describing the service bundle, used in clinical documentation and care planning interfaces.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceBundleStatus rdf:type rdf:Property ;
    rdfs:label 'Service Bundle Status' ;
    rdfs:comment 'Current lifecycle status of the service bundle indicating whether it is available for use in care planning and ordering.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:staffingModel rdf:type rdf:Property ;
    rdfs:label 'Staffing Model' ;
    rdfs:comment 'Clinical staffing model required to deliver this service bundle, determining team composition and coordination requirements.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDiagnosisCategory rdf:type rdf:Property ;
    rdfs:label 'Target Diagnosis Category' ;
    rdfs:comment 'Primary ICD-10 diagnosis category or clinical condition group that this service bundle is designed to address in post-acute care transitions.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDrgRange rdf:type rdf:Property ;
    rdfs:label 'Target Drg Range' ;
    rdfs:comment 'Range or list of DRG codes for which this service bundle is clinically appropriate, supporting discharge planning and care transition decisions.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalVisitsIncluded rdf:type rdf:Property ;
    rdfs:label 'Total Visits Included' ;
    rdfs:comment 'Total number of clinical visits or encounters included in the standard service bundle package.' ;
    rdfs:domain ind:ServiceBundle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedRegion rdf:type rdf:Property ;
    rdfs:label 'Assigned Region' ;
    rdfs:comment 'Geographic region or territory to which the surveyor team is assigned for conducting surveys, used for logistics planning and conflict-of-interest management.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictOfInterestCleared rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Cleared' ;
    rdfs:comment 'Indicates whether the surveyor team has been cleared of any conflicts of interest with the organization being surveyed, as required by accreditation body policies.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formationDate rdf:type rdf:Property ;
    rdfs:label 'Formation Date' ;
    rdfs:comment 'Date on which the surveyor team was officially formed or assembled for a specific survey engagement or standing assignment.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:languageCapability rdf:type rdf:Property ;
    rdfs:label 'Language Capability' ;
    rdfs:comment 'Languages in which the surveyor team can conduct surveys, relevant for organizations serving diverse patient populations or located in multilingual regions.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastDeploymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Deployment Date' ;
    rdfs:comment 'Date of the most recent survey deployment for this team, used for workload balancing and scheduling optimization.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxSurveyDurationDays rdf:type rdf:Property ;
    rdfs:label 'Max Survey Duration Days' ;
    rdfs:comment 'Maximum number of days the surveyor team is authorized to spend on-site for a single survey engagement, based on organization size and complexity.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialtyFocus rdf:type rdf:Property ;
    rdfs:label 'Specialty Focus' ;
    rdfs:comment 'Primary clinical or operational specialty area the team is qualified to assess, such as nursing, pharmacy, infection control, environment of care, medical staff, or information management.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyProgram rdf:type rdf:Property ;
    rdfs:label 'Survey Program' ;
    rdfs:comment 'The specific accreditation or certification program the team is assigned to evaluate, such as Hospital Accreditation, Ambulatory Care, Behavioral Health, Home Care, or Laboratory programs.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyorTeamName rdf:type rdf:Property ;
    rdfs:label 'Surveyor Team Name' ;
    rdfs:comment 'Human-readable name or designation assigned to the surveyor team for identification during accreditation surveys and regulatory inspections.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyorTeamStatus rdf:type rdf:Property ;
    rdfs:label 'Surveyor Team Status' ;
    rdfs:comment 'Current lifecycle status of the surveyor team indicating whether it is active and available for deployment, inactive, pending formation, currently deployed on a survey, or disbanded.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamCode rdf:type rdf:Property ;
    rdfs:label 'Team Code' ;
    rdfs:comment 'Externally-known unique alphanumeric code assigned to the surveyor team for tracking and scheduling purposes across accreditation bodies.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamLeadCredential rdf:type rdf:Property ;
    rdfs:label 'Team Lead Credential' ;
    rdfs:comment 'Professional credentials or certifications held by the team lead, such as MD, RN, PharmD, or other relevant healthcare qualifications that authorize them to conduct surveys.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamLeadName rdf:type rdf:Property ;
    rdfs:label 'Team Lead Name' ;
    rdfs:comment 'Full name of the designated team leader responsible for coordinating the survey activities and serving as the primary point of contact with the surveyed organization.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalSurveysCompleted rdf:type rdf:Property ;
    rdfs:label 'Total Surveys Completed' ;
    rdfs:comment 'Cumulative count of surveys successfully completed by this team since formation, used for experience tracking and team capability assessment.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingCertificationStatus rdf:type rdf:Property ;
    rdfs:label 'Training Certification Status' ;
    rdfs:comment 'Current status of the team\'s mandatory training and certification requirements, ensuring all members meet accreditation body standards for conducting surveys.' ;
    rdfs:domain ind:SurveyorTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Root Employee Id' ;
    rdfs:comment 'Identifier of the provider or staff member designated as the lead investigator for this RCA.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:rootExecutiveSponsorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Root Executive Sponsor Employee Id' ;
    rdfs:comment 'Identifier of the executive leader or senior administrator sponsoring and accountable for the RCA and its action plan.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actionStrengthRating rdf:type rdf:Property ;
    rdfs:label 'Action Strength Rating' ;
    rdfs:comment 'Rating of the strength of corrective actions per VA National Center for Patient Safety hierarchy (strong actions like forcing functions vs. weak actions like training).' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributingFactorSummary rdf:type rdf:Property ;
    rdfs:label 'Contributing Factor Summary' ;
    rdfs:comment 'Narrative summary of the contributing factors identified during the analysis, including human, process, equipment, and environmental factors.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectivenessMeasureDescription rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Measure Description' ;
    rdfs:comment 'Description of the metrics or criteria used to measure whether corrective actions successfully prevented recurrence.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectivenessVerified rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Verified' ;
    rdfs:comment 'Indicates whether the corrective actions have been verified as effective in preventing recurrence during follow-up review.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpReviewDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Review Date' ;
    rdfs:comment 'Scheduled date for follow-up review to assess effectiveness of implemented corrective actions.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:harmScore rdf:type rdf:Property ;
    rdfs:label 'Harm Score' ;
    rdfs:comment 'Harm level classification using NCC MERP Index categories (A through I) or equivalent patient harm scale. [ENUM-REF-CANDIDATE: A|B|C|D|E|F|G|H|I — promote to reference product]' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiationDate rdf:type rdf:Property ;
    rdfs:label 'Initiation Date' ;
    rdfs:comment 'Date on which the root cause analysis was formally initiated. TJC requires RCA initiation within 72 hours of sentinel event awareness.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isNeverEvent rdf:type rdf:Property ;
    rdfs:label 'Is Never Event' ;
    rdfs:comment 'Indicates whether the event is classified as a CMS Never Event (serious reportable event that should never occur).' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportableToCms rdf:type rdf:Property ;
    rdfs:label 'Is Reportable To Cms' ;
    rdfs:comment 'Indicates whether this event qualifies as a CMS-reportable never event or serious reportable event.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportableToState rdf:type rdf:Property ;
    rdfs:label 'Is Reportable To State' ;
    rdfs:comment 'Indicates whether this event meets state department of health mandatory reporting criteria.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportableToTjc rdf:type rdf:Property ;
    rdfs:label 'Is Reportable To Tjc' ;
    rdfs:comment 'Indicates whether this event meets The Joint Commission criteria for mandatory sentinel event reporting.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSentinelEvent rdf:type rdf:Property ;
    rdfs:label 'Is Sentinel Event' ;
    rdfs:comment 'Indicates whether the triggering event qualifies as a sentinel event per TJC definition (unexpected occurrence involving death or serious harm).' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSharedOrganizationWide rdf:type rdf:Property ;
    rdfs:label 'Is Shared Organization Wide' ;
    rdfs:comment 'Indicates whether findings and lessons learned have been disseminated across the organization beyond the originating department.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numberOfCorrectiveActions rdf:type rdf:Property ;
    rdfs:label 'Number Of Corrective Actions' ;
    rdfs:comment 'Total count of distinct corrective actions identified in the action plan.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rcaNumber rdf:type rdf:Property ;
    rdfs:label 'Rca Number' ;
    rdfs:comment 'Externally-known business reference number assigned to this root cause analysis for tracking and reporting purposes.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Recurrence Risk Level' ;
    rdfs:comment 'Assessed probability of the same or similar event recurring without intervention.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedLitigationFlag rdf:type rdf:Property ;
    rdfs:label 'Related Litigation Flag' ;
    rdfs:comment 'Indicates whether there is known or anticipated litigation related to the triggering event.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rootCauseAnalysisStatus rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Status' ;
    rdfs:comment 'Current lifecycle status of the root cause analysis workflow.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseStatement rdf:type rdf:Property ;
    rdfs:label 'Root Cause Statement' ;
    rdfs:comment 'Formal statement identifying the fundamental root cause(s) determined by the analysis team. Must identify system-level causes, not individual blame.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityAssessmentCode rdf:type rdf:Property ;
    rdfs:label 'Severity Assessment Code' ;
    rdfs:comment 'Safety Assessment Code combining severity and probability to determine the level of action required (SAC-1 highest, SAC-3 lowest).' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemFactorCategory rdf:type rdf:Property ;
    rdfs:label 'System Factor Category' ;
    rdfs:comment 'Primary system-level factor category identified as the root cause, aligned with human factors engineering taxonomy.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamMembers rdf:type rdf:Property ;
    rdfs:label 'Team Members' ;
    rdfs:comment 'Comma-separated list of roles or names of the multidisciplinary team members who participated in the RCA. TJC requires involvement of leadership and subject matter experts.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tjcSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Tjc Submission Date' ;
    rdfs:comment 'Date on which the RCA findings and action plan were submitted to The Joint Commission, if applicable.' ;
    rdfs:domain ind:RootCauseAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:activeProtocolCount rdf:type rdf:Property ;
    rdfs:label 'Active Protocol Count' ;
    rdfs:comment 'Current number of active research protocols under this IRB\'s oversight, indicating board workload and capacity utilization.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualSubmissionVolume rdf:type rdf:Property ;
    rdfs:label 'Annual Submission Volume' ;
    rdfs:comment 'Total number of protocol submissions (new, amendments, continuing reviews) received by this IRB in the current calendar year.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageReviewDays rdf:type rdf:Property ;
    rdfs:label 'Average Review Days' ;
    rdfs:comment 'Average number of calendar days from protocol submission to initial IRB determination, used for researcher planning and operational performance tracking.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:boardType rdf:type rdf:Property ;
    rdfs:label 'Board Type' ;
    rdfs:comment 'Classification of the IRB by organizational structure: institutional (hospital/university-based), central (multi-site), commercial (for-profit), independent (community-based), or cooperative (shared across institutions).' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictOfInterestPolicy rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Policy' ;
    rdfs:comment 'Reference identifier or title of the IRB\'s conflict of interest policy governing member recusal and financial disclosure requirements.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuingReviewIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Continuing Review Interval Months' ;
    rdfs:comment 'Standard interval in months between required continuing reviews for approved protocols (typically 12 months maximum per federal regulations).' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Flag' ;
    rdfs:comment 'Indicates whether this IRB currently has an active corrective action plan resulting from a regulatory finding, audit, or compliance determination.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eirbSystemName rdf:type rdf:Property ;
    rdfs:label 'Eirb System Name' ;
    rdfs:comment 'Name of the electronic IRB management system used for protocol submissions, tracking, and correspondence (e.g., IRBManager, IRIS, Click Commerce).' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicSubmissionEnabled rdf:type rdf:Property ;
    rdfs:label 'Electronic Submission Enabled' ;
    rdfs:comment 'Indicates whether this IRB accepts electronic protocol submissions through an eIRB system compliant with FDA 21 CFR Part 11 electronic records requirements.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fdaRegulatedResearchFlag rdf:type rdf:Property ;
    rdfs:label 'Fda Regulated Research Flag' ;
    rdfs:comment 'Indicates whether this IRB is authorized to review FDA-regulated research (drugs, biologics, devices) subject to 21 CFR Parts 50 and 56.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fwaExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Fwa Expiration Date' ;
    rdfs:comment 'Date when the Federal-Wide Assurance expires and must be renewed with OHRP to continue conducting federally funded research.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fwaNumber rdf:type rdf:Property ;
    rdfs:label 'Fwa Number' ;
    rdfs:comment 'The Federal-Wide Assurance number issued by OHRP, required for institutions engaged in federally funded human subjects research.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hasPediatricExpertise rdf:type rdf:Property ;
    rdfs:label 'Has Pediatric Expertise' ;
    rdfs:comment 'Indicates whether this IRB has members with expertise in pediatric research as required when reviewing research involving children per Subpart D.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasPrisonerRepresentative rdf:type rdf:Property ;
    rdfs:label 'Has Prisoner Representative' ;
    rdfs:comment 'Indicates whether this IRB has a designated prisoner representative member as required when reviewing research involving prisoners per Subpart C.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasVulnerablePopulationExpertise rdf:type rdf:Property ;
    rdfs:label 'Has Vulnerable Population Expertise' ;
    rdfs:comment 'Indicates whether this IRB has members with expertise in research involving vulnerable populations (pregnant women, neonates, cognitively impaired).' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaPrivacyBoardFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Privacy Board Flag' ;
    rdfs:comment 'Indicates whether this IRB also serves as the HIPAA Privacy Board authorized to grant waivers of individual authorization for use of PHI in research.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:institutionalReviewBoardName rdf:type rdf:Property ;
    rdfs:label 'Institutional Review Board Name' ;
    rdfs:comment 'Official name of the institutional review board as registered with OHRP (Office for Human Research Protections).' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:institutionalReviewBoardStatus rdf:type rdf:Property ;
    rdfs:label 'Institutional Review Board Status' ;
    rdfs:comment 'Current operational status of the IRB indicating whether it is authorized to review and approve human subjects research protocols.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:iorgNumber rdf:type rdf:Property ;
    rdfs:label 'Iorg Number' ;
    rdfs:comment 'The OHRP-assigned organization number (IORG) that uniquely identifies the institution operating this IRB in the federal registry.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Irb Registration Number' ;
    rdfs:comment 'The OHRP-assigned IRB registration number used to identify this specific board in the federal IRB registry.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastFdaInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Fda Inspection Date' ;
    rdfs:comment 'Date of the most recent FDA inspection of this IRB under the Bioresearch Monitoring Program (BIMO).' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastOhrpDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Last Ohrp Determination Date' ;
    rdfs:comment 'Date of the most recent OHRP compliance determination letter or action regarding this IRB\'s adherence to the Common Rule.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumMemberCount rdf:type rdf:Property ;
    rdfs:label 'Minimum Member Count' ;
    rdfs:comment 'Minimum number of members required for this IRB to achieve quorum and conduct official review business per federal regulations (minimum 5 per 45 CFR 46.107).' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officeAddress rdf:type rdf:Property ;
    rdfs:label 'Office Address' ;
    rdfs:comment 'Physical mailing address of the IRB administrative office where official correspondence and regulatory submissions are directed.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeEmail rdf:type rdf:Property ;
    rdfs:label 'Office Email' ;
    rdfs:comment 'General email address for the IRB office used for protocol submissions, inquiries, and administrative communications.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officePhone rdf:type rdf:Property ;
    rdfs:label 'Office Phone' ;
    rdfs:comment 'Main telephone number for the IRB administrative office for general inquiries and researcher support.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentInstitutionName rdf:type rdf:Property ;
    rdfs:label 'Parent Institution Name' ;
    rdfs:comment 'Name of the parent institution (university, hospital system, or organization) that operates and provides oversight for this IRB.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordRetentionYears rdf:type rdf:Property ;
    rdfs:label 'Record Retention Years' ;
    rdfs:comment 'Number of years this IRB retains protocol records after study completion, per institutional policy and federal requirements (minimum 3 years per 45 CFR 46.115).' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:registrationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Registration Effective Date' ;
    rdfs:comment 'Date when the IRB registration with OHRP became effective, establishing the board\'s authority to review human subjects research.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Registration Renewal Date' ;
    rdfs:comment 'Date when the IRB registration must be renewed with OHRP (required every 3 years per federal regulations).' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relianceAgreementCount rdf:type rdf:Property ;
    rdfs:label 'Reliance Agreement Count' ;
    rdfs:comment 'Number of active IRB authorization agreements (IAAs) or reliance agreements with external institutions allowing this IRB to serve as reviewing IRB.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewScope rdf:type rdf:Property ;
    rdfs:label 'Review Scope' ;
    rdfs:comment 'The types of review this IRB is authorized to conduct: full board review, expedited review, exempt determinations, or all categories.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:singleIrbCapableFlag rdf:type rdf:Property ;
    rdfs:label 'Single Irb Capable Flag' ;
    rdfs:comment 'Indicates whether this IRB can serve as the single IRB of record for multi-site studies as required by the NIH sIRB policy and revised Common Rule.' ;
    rdfs:domain ind:InstitutionalReviewBoard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentSetId rdf:type rdf:Property ;
    rdfs:label 'Parent Set Id' ;
    rdfs:comment 'Reference to a parent measure set when this set is a subset or domain within a larger composite program (e.g., Safety domain within overall VBP).' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeasureSet .

ind:supersededBySetId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Set Id' ;
    rdfs:comment 'Reference to the newer measure set that supersedes this version when status is \'superseded\'. Enables tracking of measure set evolution across program years.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeasureSet .

ind:achievementThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Achievement Threshold Pct' ;
    rdfs:comment 'Minimum performance percentile or rate required to earn achievement points (floor threshold for scoring).' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicablePopulation rdf:type rdf:Property ;
    rdfs:label 'Applicable Population' ;
    rdfs:comment 'Description of the patient population to which this measure set applies (e.g., \'Medicare FFS beneficiaries age 65+\', \'Commercial HMO members\', \'All payer inpatient discharges\').' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkPct rdf:type rdf:Property ;
    rdfs:label 'Benchmark Pct' ;
    rdfs:comment 'Top-decile or best-in-class performance rate used as the benchmark ceiling for maximum achievement scoring.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkSource rdf:type rdf:Property ;
    rdfs:label 'Benchmark Source' ;
    rdfs:comment 'Source of benchmark data used for scoring comparisons (e.g., \'CMS National Average\', \'NCQA HEDIS Percentiles\', \'State Peer Group\').' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalUrl rdf:type rdf:Property ;
    rdfs:label 'External Url' ;
    rdfs:comment 'URL link to the official external documentation or specification for this measure set from the sponsoring organization.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Improvement Threshold Pct' ;
    rdfs:comment 'Percentage improvement from baseline required to earn improvement points within the scoring methodology.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incentiveMaximumPct rdf:type rdf:Property ;
    rdfs:label 'Incentive Maximum Pct' ;
    rdfs:comment 'Maximum payment bonus percentage achievable through high performance on this measure set.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isPayForPerformance rdf:type rdf:Property ;
    rdfs:label 'Is Pay For Performance' ;
    rdfs:comment 'Indicates whether performance on this measure set directly impacts financial incentives or penalties (e.g., VBP payment adjustments, MIPS payment modifiers).' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPublicReported rdf:type rdf:Property ;
    rdfs:label 'Is Public Reported' ;
    rdfs:comment 'Indicates whether results from this measure set are publicly reported (e.g., on CMS Hospital Compare, Healthgrades, or state transparency websites).' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measureSetCategory rdf:type rdf:Property ;
    rdfs:label 'Measure Set Category' ;
    rdfs:comment 'High-level category classifying the measure set\'s primary quality domain focus area.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureSetCode rdf:type rdf:Property ;
    rdfs:label 'Measure Set Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the measure set within the organization\'s quality management system (e.g., \'CMS-VBP-FY24\', \'HEDIS-MY2024\').' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureSetName rdf:type rdf:Property ;
    rdfs:label 'Measure Set Name' ;
    rdfs:comment 'Human-readable name of the measure set as defined by the sponsoring organization (e.g., \'CMS Hospital VBP Measure Set FY2024\', \'HEDIS Commercial HMO 2024\').' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureSetStatus rdf:type rdf:Property ;
    rdfs:label 'Measure Set Status' ;
    rdfs:comment 'Current lifecycle status of the measure set indicating whether it is actively used for reporting and scoring.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumCaseThreshold rdf:type rdf:Property ;
    rdfs:label 'Minimum Case Threshold' ;
    rdfs:comment 'Minimum number of eligible cases/encounters required for a provider or facility to be scored on this measure set. Below this threshold, the entity is excluded from scoring.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumMeasureCount rdf:type rdf:Property ;
    rdfs:label 'Minimum Measure Count' ;
    rdfs:comment 'Minimum number of individual measures within this set that must be reported to satisfy program requirements.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nqfEndorsementStatus rdf:type rdf:Property ;
    rdfs:label 'Nqf Endorsement Status' ;
    rdfs:comment 'Indicates whether the measure set (or its constituent measures) carries National Quality Forum endorsement, which is often required for CMS program inclusion.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyMaximumPct rdf:type rdf:Property ;
    rdfs:label 'Penalty Maximum Pct' ;
    rdfs:comment 'Maximum payment reduction percentage that can result from poor performance on this measure set (e.g., 2% for VBP, 9% for MIPS).' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingLevel rdf:type rdf:Property ;
    rdfs:label 'Reporting Level' ;
    rdfs:comment 'The organizational level at which this measure set is reported (e.g., individual provider, group practice, facility, health plan, Accountable Care Organization).' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodYear rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Year' ;
    rdfs:comment 'The calendar or fiscal year to which this measure set applies for regulatory reporting (e.g., 2024 for HEDIS MY2024 or CMS VBP FY2024).' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskAdjustmentMethod rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Method' ;
    rdfs:comment 'Statistical risk adjustment methodology applied to measure set scoring to account for patient acuity and case mix differences (e.g., \'CMS HCC\', \'APR-DRG severity\', \'none\').' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoringMethodology rdf:type rdf:Property ;
    rdfs:label 'Scoring Methodology' ;
    rdfs:comment 'Description of how individual measure scores within the set are aggregated into a composite or total score (e.g., weighted average, achievement/improvement points, all-or-nothing).' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Submission Deadline' ;
    rdfs:comment 'Final date by which measure set results must be submitted to the sponsoring organization or regulatory body.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalMeasureCount rdf:type rdf:Property ;
    rdfs:label 'Total Measure Count' ;
    rdfs:comment 'Total number of individual quality measures included in this measure set version.' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weightInProgram rdf:type rdf:Property ;
    rdfs:label 'Weight In Program' ;
    rdfs:comment 'The percentage weight this measure set carries within the overall quality program scoring (e.g., Safety domain = 25% of VBP Total Performance Score).' ;
    rdfs:domain ind:MeasureSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Author Employee Id' ;
    rdfs:comment 'Identifier of the individual (typically the principal investigator or medical writer) who authored this protocol version.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:blindingType rdf:type rdf:Property ;
    rdfs:label 'Blinding Type' ;
    rdfs:comment 'Level of blinding (masking) employed in the study design for this protocol version to minimize bias.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comparatorDescription rdf:type rdf:Property ;
    rdfs:label 'Comparator Description' ;
    rdfs:comment 'Description of the comparator agent (placebo, active comparator, or standard of care) used in the control arm of this protocol version.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSafetyMonitoringRequired rdf:type rdf:Property ;
    rdfs:label 'Data Safety Monitoring Required' ;
    rdfs:comment 'Indicates whether a Data Safety Monitoring Board is required for oversight of this protocol version.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentStoragePath rdf:type rdf:Property ;
    rdfs:label 'Document Storage Path' ;
    rdfs:comment 'File system or document management system path where the official PDF/document of this protocol version is stored for regulatory inspection readiness.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dosageDescription rdf:type rdf:Property ;
    rdfs:label 'Dosage Description' ;
    rdfs:comment 'Summary description of the dosage regimen including dose levels, frequency, and route of administration as specified in this version.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Irb Submission Date' ;
    rdfs:comment 'Date on which this protocol version was submitted to the IRB for review and approval.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isInternational rdf:type rdf:Property ;
    rdfs:label 'Is International' ;
    rdfs:comment 'Indicates whether this protocol version involves sites in multiple countries requiring multi-national regulatory submissions.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plannedDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Planned Duration Months' ;
    rdfs:comment 'Planned duration of the study in months as specified in this protocol version, from first subject enrolled to last subject completed.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryEndpoint rdf:type rdf:Property ;
    rdfs:label 'Primary Endpoint' ;
    rdfs:comment 'Description of the primary efficacy or safety endpoint that the study is powered to evaluate in this protocol version.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorProtocolNumber rdf:type rdf:Property ;
    rdfs:label 'Sponsor Protocol Number' ;
    rdfs:comment 'The unique protocol identification number assigned by the study sponsor for tracking across their portfolio.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyDesign rdf:type rdf:Property ;
    rdfs:label 'Study Design' ;
    rdfs:comment 'The methodological design of the clinical study as specified in this protocol version.' ;
    rdfs:domain ind:ProtocolVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formTemplateId rdf:type rdf:Property ;
    rdfs:label 'Form Template Id' ;
    rdfs:comment 'Reference to the consent form template that is presented to the patient during this workflow. Links workflow execution to the specific document.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentFormTemplate .

ind:allowsElectronicSignature rdf:type rdf:Property ;
    rdfs:label 'Allows Electronic Signature' ;
    rdfs:comment 'Indicates whether this workflow template supports electronic signature capture as a valid consent mechanism.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsVerbalConsent rdf:type rdf:Property ;
    rdfs:label 'Allows Verbal Consent' ;
    rdfs:comment 'Indicates whether verbal consent is an acceptable method within this workflow, typically for telephone or emergency scenarios.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalRole rdf:type rdf:Property ;
    rdfs:label 'Approval Role' ;
    rdfs:comment 'The role or title of the person authorized to provide final approval in this workflow (e.g., attending physician, department chair, IRB chair).' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentValidityDays rdf:type rdf:Property ;
    rdfs:label 'Consent Validity Days' ;
    rdfs:comment 'Default number of days that a consent obtained through this workflow remains valid before requiring renewal.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationTimeoutHours rdf:type rdf:Property ;
    rdfs:label 'Escalation Timeout Hours' ;
    rdfs:comment 'Number of hours after which an unresolved workflow step automatically escalates to the next approval authority.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expirationDays rdf:type rdf:Property ;
    rdfs:label 'Expiration Days' ;
    rdfs:comment 'Number of days after initiation that an incomplete workflow instance expires and must be restarted. Ensures timely consent collection.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hipaaAuthorizationRequired rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Required' ;
    rdfs:comment 'Indicates whether this workflow requires a separate HIPAA authorization form in addition to the primary consent.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDefaultTemplate rdf:type rdf:Property ;
    rdfs:label 'Is Default Template' ;
    rdfs:comment 'Indicates whether this is the default workflow template for its type and category combination. Only one template per type/category should be default.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRevocable rdf:type rdf:Property ;
    rdfs:label 'Is Revocable' ;
    rdfs:comment 'Indicates whether consent obtained through this workflow can be revoked by the patient at any time.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxReminderCount rdf:type rdf:Property ;
    rdfs:label 'Max Reminder Count' ;
    rdfs:comment 'Maximum number of reminder notifications to send before the workflow is escalated or marked as non-responsive.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientAgeMinimum rdf:type rdf:Property ;
    rdfs:label 'Patient Age Minimum' ;
    rdfs:comment 'Minimum patient age in years for which this workflow template is applicable. Used to determine if guardian consent workflow is needed.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reminderFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Reminder Frequency Days' ;
    rdfs:comment 'Number of days between automated reminder notifications sent to patients or staff for pending consent workflow actions.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supportsPartialConsent rdf:type rdf:Property ;
    rdfs:label 'Supports Partial Consent' ;
    rdfs:comment 'Indicates whether this workflow allows patients to consent to some elements while declining others (granular consent).' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workflowTemplateCategory rdf:type rdf:Property ;
    rdfs:label 'Workflow Template Category' ;
    rdfs:comment 'Operational category of the workflow template indicating the processing pathway and urgency level for consent collection.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowTemplateDescription rdf:type rdf:Property ;
    rdfs:label 'Workflow Template Description' ;
    rdfs:comment 'Detailed narrative describing the workflow template purpose, applicable consent scenarios, and expected outcomes.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowTemplateName rdf:type rdf:Property ;
    rdfs:label 'Workflow Template Name' ;
    rdfs:comment 'Human-readable name of the consent workflow template, describing its purpose and applicable consent scenario.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowTemplateStatus rdf:type rdf:Property ;
    rdfs:label 'Workflow Template Status' ;
    rdfs:comment 'Current lifecycle state of the workflow template. Only active templates can be instantiated for new consent workflows.' ;
    rdfs:domain ind:WorkflowTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageAppropriateness rdf:type rdf:Property ;
    rdfs:label 'Age Appropriateness' ;
    rdfs:comment 'Age group for which this education material is designed, ensuring developmentally appropriate content delivery.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvingAuthority rdf:type rdf:Property ;
    rdfs:label 'Approving Authority' ;
    rdfs:comment 'Name or title of the committee, department, or individual who approved this education material for use.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentContext rdf:type rdf:Property ;
    rdfs:label 'Consent Context' ;
    rdfs:comment 'The consent domain or authorization context in which this education material is presented to the patient or subject.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentSummary rdf:type rdf:Property ;
    rdfs:label 'Content Summary' ;
    rdfs:comment 'Brief narrative summary of the education material content, used for cataloging and search indexing.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copyrightHolder rdf:type rdf:Property ;
    rdfs:label 'Copyright Holder' ;
    rdfs:comment 'Entity or organization that holds the intellectual property rights for this education material content.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:culturalSensitivityReviewed rdf:type rdf:Property ;
    rdfs:label 'Cultural Sensitivity Reviewed' ;
    rdfs:comment 'Indicates whether this education material has undergone cultural sensitivity review to ensure appropriateness across diverse patient populations.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:distributionCount rdf:type rdf:Property ;
    rdfs:label 'Distribution Count' ;
    rdfs:comment 'Cumulative number of times this education material has been distributed to patients, used for utilization tracking and reprint planning.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:educationMaterialCategory rdf:type rdf:Property ;
    rdfs:label 'Education Material Category' ;
    rdfs:comment 'Subject matter category of the education material indicating the clinical or administrative domain it addresses.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:educationMaterialStatus rdf:type rdf:Property ;
    rdfs:label 'Education Material Status' ;
    rdfs:comment 'Current lifecycle status of the education material indicating whether it is approved for distribution to patients.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedReadTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Read Time Minutes' ;
    rdfs:comment 'Estimated time in minutes required for a patient to read or view the education material, supporting workflow scheduling.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:externalContentUrl rdf:type rdf:Property ;
    rdfs:label 'External Content Url' ;
    rdfs:comment 'URL link to the externally hosted or digital version of the education material for patient portal or electronic delivery.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaRelevanceFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Relevance Flag' ;
    rdfs:comment 'Indicates whether this education material specifically addresses HIPAA privacy rights, data sharing authorizations, or PHI disclosures.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAdaCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Ada Compliant' ;
    rdfs:comment 'Indicates whether this education material meets ADA accessibility requirements including screen reader compatibility and alternative text.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMultilingualAvailable rdf:type rdf:Property ;
    rdfs:label 'Is Multilingual Available' ;
    rdfs:comment 'Indicates whether translated versions of this education material exist in additional languages beyond the primary language.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRequiredForConsent rdf:type rdf:Property ;
    rdfs:label 'Is Required For Consent' ;
    rdfs:comment 'Indicates whether presentation of this education material is a mandatory prerequisite before obtaining patient consent.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialCode rdf:type rdf:Property ;
    rdfs:label 'Material Code' ;
    rdfs:comment 'Externally-known unique catalog code assigned to the education material for cross-system reference and inventory tracking.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialType rdf:type rdf:Property ;
    rdfs:label 'Material Type' ;
    rdfs:comment 'Classification of the education material format or delivery mechanism.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaFormat rdf:type rdf:Property ;
    rdfs:label 'Media Format' ;
    rdfs:comment 'Digital file format or media type of the education material content for rendering and storage purposes.' ;
    rdfs:domain ind:EducationMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Code' ;
    rdfs:comment 'Code identifying the specific regulatory requirement that mandates this education material (e.g., CMS CoP, state law, IRB protocol).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned To Employee Id' ;
    rdfs:comment 'The staff member or role currently responsible for advancing this workflow to the next step.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:completedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Completed By Employee Id' ;
    rdfs:comment 'The staff member who performed the final action to complete or close this workflow.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:escalatedToEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Escalated To Employee Id' ;
    rdfs:comment 'The supervisor or authority to whom this workflow was escalated for resolution.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:escalatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Escalated Timestamp' ;
    rdfs:comment 'Date and time when the workflow was escalated to a higher authority.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemWorkflowCode rdf:type rdf:Property ;
    rdfs:label 'Source System Workflow Code' ;
    rdfs:comment 'Native identifier of this workflow in the originating operational system, enabling cross-system traceability.' ;
    rdfs:domain ind:ConsentWorkflowTbl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .
