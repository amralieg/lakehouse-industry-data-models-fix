Table technology.broadcast_facility {
  broadcast_facility_id varchar [pk, note: 'Unique identifier for the broadcast facility. Primary key. Role: MASTER_RESOURCE. | Column broadcast_facility_id (BIGINT) in technology.broadcast_facility']
  parent_broadcast_facility_id varchar [note: 'Self-referencing FK on broadcast_facility (parent_broadcast_facility_id) | Column parent_broadcast_facility_id (BIGINT) in technology.broadcast_facility']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.broadcast_facility']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.broadcast_facility']
  access_control_system varchar [note: 'Type of physical access control system deployed: biometric (fingerprint, iris, facial recognition), card_reader (RFID badge), keypad (PIN entry), security_guard (manual verification), none (unrestricted), multi_factor (combination of methods). | Column access_control_system (STRING) in technology.broadcast_facility']
  address_line_1 varchar [note: 'Primary street address line of the facility location (street number, street name, building identifier). | Column address_line_1 (STRING) in technology.broadcast_facility']
  address_line_2 varchar [note: 'Secondary address line for additional location details (suite, floor, unit number). | Column address_line_2 (STRING) in technology.broadcast_facility']
  antenna_height_meters decimal(8,2) [note: 'Height of the primary broadcast antenna above ground level in meters. Critical for coverage area calculations and regulatory compliance. | Column antenna_height_meters (DECIMAL(8,2)) in technology.broadcast_facility']
  backup_power_duration_hours decimal(6,2) [note: 'Maximum duration in hours that backup power systems can sustain full facility operations during a primary power outage. | Column backup_power_duration_hours (DECIMAL(6,2)) in technology.broadcast_facility']
  backup_power_type varchar [note: 'Type of backup power system installed: generator (diesel or natural gas), ups (Uninterruptible Power Supply), battery (battery bank), solar (solar panels with storage), none (no backup), hybrid (combination of systems). | Column backup_power_type (STRING) in technology.broadcast_facility']
  city varchar [note: 'City or municipality where the facility is located. | Column city (STRING) in technology.broadcast_facility']
  commissioning_date date [note: 'Date when the facility was officially commissioned and became operational. Used for asset lifecycle tracking and depreciation calculations. | Column commissioning_date (DATE) in technology.broadcast_facility']
  control_room_count varchar [note: 'Number of master control rooms or playout control rooms within the facility. Used for operational capacity assessment. | Column control_room_count (INT) in technology.broadcast_facility']
  cooling_capacity_tons decimal(10,2) [note: 'Total HVAC cooling capacity in refrigeration tons. Critical for equipment reliability and data center operations. | Column cooling_capacity_tons (DECIMAL(10,2)) in technology.broadcast_facility']
  country_code varchar [note: 'Three-letter ISO country code where the facility is located (e.g., USA, GBR, CAN). | Column country_code (STRING) in technology.broadcast_facility']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.broadcast_facility']
  created_timestamp timestamp [note: 'Timestamp when this facility record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in technology.broadcast_facility']
  elevation_meters decimal(8,2) [note: 'Elevation above sea level in meters. Critical for transmission site coverage calculations and antenna height planning. | Column elevation_meters (DECIMAL(8,2)) in technology.broadcast_facility']
  facility_code varchar [note: 'Externally-known unique alphanumeric code identifying the facility across systems and external partners. Used for operational reference and integration. | Column facility_code (STRING) in technology.broadcast_facility']
  facility_manager_email varchar [note: 'Primary email address of the facility manager for operational communications and escalations. | Column facility_manager_email (STRING) in technology.broadcast_facility']
  facility_manager_name varchar [note: 'Full name of the person responsible for day-to-day facility operations and management. Business reference, not direct PII. | Column facility_manager_name (STRING) in technology.broadcast_facility']
  facility_manager_phone varchar [note: 'Primary contact phone number for the facility manager. Used for emergency notifications and operational coordination. | Column facility_manager_phone (STRING) in technology.broadcast_facility']
  facility_name varchar [note: 'Human-readable name of the broadcast facility (e.g., \'Downtown Studio A\', \'Mountain Peak Transmission Site\'). | Column facility_name (STRING) in technology.broadcast_facility']
  facility_type varchar [note: 'Classification of the facility based on its primary operational function: studio (content production), master_control (playout and channel management), noc (Network Operations Center monitoring), transmission_site (broadcast transmission), uplink_station (satellite uplink), data_center (IT infrastructure and storage). | Column facility_type (STRING) in technology.broadcast_facility']
  fire_suppression_system varchar [note: 'Type of fire suppression system installed: sprinkler (water-based), gas (clean agent like FM-200 or Novec 1230), foam (for flammable liquid areas), water_mist (fine water droplets), none (no automated system). | Column fire_suppression_system (STRING) in technology.broadcast_facility']
  last_inspection_date date [note: 'Date of the most recent regulatory or safety inspection. Used for compliance tracking and audit scheduling. | Column last_inspection_date (DATE) in technology.broadcast_facility']
  last_modified_timestamp timestamp [note: 'Timestamp when this facility record was last updated. Used for change tracking and audit purposes. | Column last_modified_timestamp (TIMESTAMP) in technology.broadcast_facility']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the facility in decimal degrees. Used for transmission coverage modeling and network planning. | Column latitude (DECIMAL(10,7)) in technology.broadcast_facility']
  lease_expiration_date date [note: 'Expiration date of the facility lease agreement if the facility is leased. Null if the facility is owned. Used for real estate planning and renewal tracking. | Column lease_expiration_date (DATE) in technology.broadcast_facility']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the facility in decimal degrees. Used for transmission coverage modeling and network planning. | Column longitude (DECIMAL(10,7)) in technology.broadcast_facility']
  network_connectivity_gbps decimal(10,3) [note: 'Total network bandwidth capacity in gigabits per second. Includes all uplink and interconnection circuits. Critical for content distribution and streaming operations. | Column network_connectivity_gbps (DECIMAL(10,3)) in technology.broadcast_facility']
  next_inspection_due_date date [note: 'Scheduled date for the next mandatory regulatory or safety inspection. Used for compliance calendar management. | Column next_inspection_due_date (DATE) in technology.broadcast_facility']
  operational_status varchar [note: 'Current lifecycle state of the facility: active (fully operational), standby (ready but not primary), maintenance (temporarily offline for service), decommissioned (permanently retired), under_construction (being built or renovated), inactive (not currently in use). | Column operational_status (STRING) in technology.broadcast_facility']
  ownership_type varchar [note: 'Legal ownership arrangement: owned (company-owned property), leased (long-term lease), colocation (shared data center space), shared (joint venture or partnership facility). | Column ownership_type (STRING) in technology.broadcast_facility']
  postal_code varchar [note: 'Postal or ZIP code for the facility address. | Column postal_code (STRING) in technology.broadcast_facility']
  power_capacity_kva decimal(10,2) [note: 'Total electrical power capacity available to the facility in kilovolt-amperes. Includes primary and backup power systems. | Column power_capacity_kva (DECIMAL(10,2)) in technology.broadcast_facility']
  redundancy_tier varchar [note: 'Uptime Institute tier classification for infrastructure redundancy and availability: tier_1 (basic), tier_2 (redundant components), tier_3 (concurrently maintainable), tier_4 (fault tolerant), not_applicable (non-data center facilities). | Column redundancy_tier (STRING) in technology.broadcast_facility']
  security_classification varchar [note: 'Physical security classification level: high (24/7 armed security, biometric access, CCTV, perimeter fencing), medium (access control, CCTV, security personnel during business hours), low (basic access control). | Column security_classification (STRING) in technology.broadcast_facility']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.broadcast_facility']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.broadcast_facility']
  state_province varchar [note: 'State, province, or regional administrative division where the facility is located. | Column state_province (STRING) in technology.broadcast_facility']
  studio_count varchar [note: 'Number of production studios within the facility. Applicable to studio and master control facility types. | Column studio_count (INT) in technology.broadcast_facility']
  time_zone varchar [note: 'IANA time zone identifier for the facility location (e.g., America/New_York, Europe/London). Used for scheduling and playout coordination. | Column time_zone (STRING) in technology.broadcast_facility']
  total_floor_area_sqm decimal(10,2) [note: 'Total usable floor space of the facility in square meters. Used for capacity planning and space utilization analysis. | Column total_floor_area_sqm (DECIMAL(10,2)) in technology.broadcast_facility']
  transmission_power_kw decimal(10,3) [note: 'Maximum authorized transmission power output in kilowatts. Applicable to transmission sites. Governed by FCC or regional broadcast authority licensing. | Column transmission_power_kw (DECIMAL(10,3)) in technology.broadcast_facility']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.broadcast_facility']

  Note: 'Master record for every physical broadcast facility operated by Media Broadcasting — studios, master control rooms, network operations centers (NOC), transmission sites, satellite uplink stations, and data centers. Captures facility name, type (studio, NOC, transmission, uplink, data center), address, geographic coordinates, operational status, capacity metrics, power infrastructure details, cooling capacity, physical security classification, and facility manager. Serves as the authoritative SSOT for all physical infrastructure locations supporting media operations. | Unity Catalog table: media_broadcasting_ecm.technology.broadcast_facility'
}

Table technology.transmission_equipment {
  transmission_equipment_id varchar [pk, note: 'Unique identifier for the transmission equipment asset. Primary key for the transmission equipment master record. | Column transmission_equipment_id (BIGINT) in technology.transmission_equipment']
  broadcast_facility_id varchar [note: 'Identifier of the broadcast facility, transmitter site, or Network Operations Center (NOC) where this transmission equipment is installed and operated. | Column broadcast_facility_id (BIGINT) in technology.transmission_equipment']
  broadcast_standard_id varchar [note: 'Foreign key linking to technology.broadcast_standard. Business justification: transmission_equipment.transmission_standard (STRING) should be normalized to FK reference to broadcast_standard master. The STRING field contains standard codes that should link to the authoritative  | Column broadcast_standard_id (BIGINT) in technology.transmission_equipment']
  equipment_procurement_id varchar [note: 'Foreign key linking to technology.equipment_procurement. Business justification: Transmission equipment should reference the procurement event that acquired it. The \'purchase_order_number\' field on transmission_equipment should be normalized by linking to the equipment_procurement | Column equipment_procurement_id (BIGINT) in technology.transmission_equipment']
  partner_id varchar [note: 'Identifier of the vendor or supplier from whom the transmission equipment was purchased. Links to vendor master data for procurement and support contact information. | Column partner_id (BIGINT) in partner.transmission_equipment']
  replaced_transmission_equipment_id varchar [note: 'Self-referencing FK on transmission_equipment (replaced_transmission_equipment_id) | Column replaced_transmission_equipment_id (BIGINT) in technology.transmission_equipment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.transmission_equipment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.transmission_equipment']
  acquisition_cost decimal(15,2) [note: 'Original purchase price paid for the transmission equipment including delivery and installation costs. Used for capital asset accounting and depreciation calculation. | Column acquisition_cost (DECIMAL(15,2)) in technology.transmission_equipment']
  asset_tag varchar [note: 'Externally visible asset identification tag assigned to the transmission equipment for physical inventory tracking and auditing. Typically affixed to the equipment chassis. | Column asset_tag (STRING) in technology.transmission_equipment']
  channel_number varchar [note: 'Assigned broadcast channel number (virtual or physical) associated with this transmission equipment. Used for Electronic Program Guide (EPG) mapping and viewer tuning. | Column channel_number (STRING) in technology.transmission_equipment']
  commissioning_date date [note: 'Date when the transmission equipment was tested, certified, and placed into active broadcast service. May differ from installation date due to testing and regulatory approval periods. | Column commissioning_date (DATE) in technology.transmission_equipment']
  compliance_certification varchar [note: 'Regulatory compliance and safety certifications held by the transmission equipment (e.g., FCC Part 15, CE Mark, UL Listed). Demonstrates conformance to technical and safety standards. | Column compliance_certification (STRING) in technology.transmission_equipment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.transmission_equipment']
  created_timestamp timestamp [note: 'Timestamp when this transmission equipment record was first created in the asset management system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in technology.transmission_equipment']
  depreciation_method varchar [note: 'Accounting method used to depreciate the transmission equipment asset over its useful life. Determines annual depreciation expense calculation. | Column depreciation_method (STRING) in technology.transmission_equipment']
  equipment_type varchar [note: 'Classification of the transmission equipment by its primary function in the broadcast signal chain. Determines operational role and maintenance requirements. [ENUM-REF-CANDIDATE: transmitter|encoder|multiplexer|modulator|satellite_uplink|rf_amplifier|antenna_system|signal_processor|exciter|combiner|filter|switch — 12 candidates stripped; promote to reference product] | Column equipment_type (STRING) in technology.transmission_equipment']
  fcc_license_number varchar [note: 'FCC broadcast license authorization number under which this transmission equipment is permitted to operate. Required for regulatory compliance and spectrum usage authorization. | Column fcc_license_number (STRING) in technology.transmission_equipment']
  firmware_version varchar [note: 'Current firmware or software version installed on the transmission equipment. Critical for security patching, feature availability, and vendor support eligibility. | Column firmware_version (STRING) in technology.transmission_equipment']
  frequency_band varchar [note: 'Radio frequency spectrum band in which the transmission equipment operates. Determines antenna requirements, propagation characteristics, and regulatory licensing. [ENUM-REF-CANDIDATE: VHF Low|VHF High|UHF|L-Band|C-Band|Ku-Band|Ka-Band — 7 candidates stripped; promote to reference product] | Column frequency_band (STRING) in technology.transmission_equipment']
  installation_date date [note: 'Date when the transmission equipment was physically installed and commissioned at the facility. Used for depreciation calculation and lifecycle tracking. | Column installation_date (DATE) in technology.transmission_equipment']
  ip_address varchar [note: 'Network IP address assigned to the transmission equipment for remote monitoring, control, and SNMP management via the Network Operations Center (NOC). | Column ip_address (STRING) in technology.transmission_equipment']
  last_maintenance_date date [note: 'Date of the most recent scheduled preventive maintenance or inspection performed on the transmission equipment. Used to calculate next service due date. | Column last_maintenance_date (DATE) in technology.transmission_equipment']
  last_updated_timestamp timestamp [note: 'Timestamp when this transmission equipment record was most recently modified. Tracks data currency and change history for audit purposes. | Column last_updated_timestamp (TIMESTAMP) in technology.transmission_equipment']
  location_description varchar [note: 'Detailed physical location description of where the transmission equipment is installed within the facility (e.g., transmitter room, rack position, tower level). Aids technicians in locating equipment for maintenance. | Column location_description (STRING) in technology.transmission_equipment']
  maintenance_contract_number varchar [note: 'Reference number for the active maintenance or service level agreement (SLA) covering this transmission equipment. Links to vendor support entitlements and response time commitments. | Column maintenance_contract_number (STRING) in technology.transmission_equipment']
  manufacturer varchar [note: 'Name of the company that manufactured the transmission equipment (e.g., Harris, Rohde & Schwarz, GatesAir, Harmonic). | Column manufacturer (STRING) in technology.transmission_equipment']
  model_number varchar [note: 'Manufacturer model designation for the transmission equipment. Identifies the specific product line and configuration. | Column model_number (STRING) in technology.transmission_equipment']
  next_maintenance_due_date date [note: 'Scheduled date for the next preventive maintenance service on the transmission equipment. Calculated based on manufacturer recommendations and operational hours. | Column next_maintenance_due_date (DATE) in technology.transmission_equipment']
  notes varchar [note: 'Free-form text field for additional notes, special configurations, known issues, or operational considerations specific to this transmission equipment unit. | Column notes (STRING) in technology.transmission_equipment']
  operating_frequency_mhz decimal(10,3) [note: 'Specific center frequency in megahertz at which the transmission equipment is configured to operate. Must align with FCC license authorization. | Column operating_frequency_mhz (DECIMAL(10,3)) in technology.transmission_equipment']
  operational_status varchar [note: 'Current operational state of the transmission equipment in the broadcast workflow. Determines whether the equipment is available for on-air use or requires intervention. | Column operational_status (STRING) in technology.transmission_equipment']
  power_output_kw decimal(10,3) [note: 'Maximum rated transmission power output of the equipment measured in kilowatts. Critical for coverage area calculation and FCC licensing compliance. | Column power_output_kw (DECIMAL(10,3)) in technology.transmission_equipment']
  redundancy_role varchar [note: 'Role of this equipment in the redundancy and failover architecture. Defines automatic switchover behavior during primary equipment failure to ensure broadcast continuity. | Column redundancy_role (STRING) in technology.transmission_equipment']
  serial_number varchar [note: 'Manufacturer-assigned unique serial number for the transmission equipment unit. Used for warranty claims, maintenance tracking, and vendor support. | Column serial_number (STRING) in technology.transmission_equipment']
  snmp_community_string varchar [note: 'Authentication credential for SNMP-based monitoring and management of the transmission equipment. Restricted access credential for NOC operations. | Column snmp_community_string (STRING) in technology.transmission_equipment']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.transmission_equipment']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.transmission_equipment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.transmission_equipment']
  useful_life_years varchar [note: 'Expected operational lifespan of the transmission equipment in years for depreciation and replacement planning purposes. Typically 7-15 years for broadcast transmission equipment. | Column useful_life_years (INT) in technology.transmission_equipment']
  warranty_expiry_date date [note: 'Date when the manufacturer warranty coverage for the transmission equipment expires. After this date, repairs and parts are billable unless covered by extended service contract. | Column warranty_expiry_date (DATE) in technology.transmission_equipment']

  Note: 'Master record for all broadcast transmission hardware assets — transmitters, encoders, multiplexers, modulators, satellite uplink equipment, RF amplifiers, antenna systems, and signal processing units. Captures equipment serial number, manufacturer, model, firmware version, transmission standard (ATSC 3.0, DVB-T2, MPEG-4), power output (kW), frequency band, assigned facility, installation date, warranty expiry, operational status, and asset tag. Authoritative inventory for transmission infrastructure supporting linear broadcast operations. | Unity Catalog table: media_broadcasting_ecm.technology.transmission_equipment'
}

Table technology.studio_facility {
  studio_facility_id varchar [pk, note: 'Unique identifier for the studio facility space. Primary key. | Column studio_facility_id (BIGINT) in technology.studio_facility']
  broadcast_facility_id varchar [note: 'Reference to the parent broadcast facility building that houses this studio space. | Column broadcast_facility_id (BIGINT) in technology.studio_facility']
  parent_studio_facility_id varchar [note: 'Self-referencing FK on studio_facility (parent_studio_facility_id) | Column parent_studio_facility_id (BIGINT) in technology.studio_facility']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.studio_facility']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.studio_facility']
  access_control_level varchar [note: 'Security access level required to enter the studio space (public, restricted, secure, or high security). | Column access_control_level (STRING) in technology.studio_facility']
  audio_configuration varchar [note: 'Audio system capability and channel configuration installed in the studio (mono, stereo, 5.1 surround, 7.1, Dolby Atmos, or immersive audio). | Column audio_configuration (STRING) in technology.studio_facility']
  backup_power_available boolean [note: 'Indicates whether the studio has backup power (UPS or generator) for continuity during outages. | Column backup_power_available (BOOLEAN) in technology.studio_facility']
  booking_availability_flag boolean [note: 'Indicates whether the studio space is currently available for booking and scheduling. | Column booking_availability_flag (BOOLEAN) in technology.studio_facility']
  building_section varchar [note: 'Named section or wing of the broadcast facility building where the studio is located (e.g., North Wing, Tower B, Production Block). | Column building_section (STRING) in technology.studio_facility']
  camera_positions varchar [note: 'Number of fixed or standard camera positions configured in the studio layout. | Column camera_positions (INT) in technology.studio_facility']
  ceiling_height_ft decimal(6,2) [note: 'Clear ceiling height of the studio space measured in feet, critical for lighting rig and set design. | Column ceiling_height_ft (DECIMAL(6,2)) in technology.studio_facility']
  commissioning_date date [note: 'Date when the studio facility was first commissioned and made operational. | Column commissioning_date (DATE) in technology.studio_facility']
  control_room_adjacent boolean [note: 'Indicates whether the studio has a dedicated control room directly adjacent or integrated. | Column control_room_adjacent (BOOLEAN) in technology.studio_facility']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.studio_facility']
  created_timestamp timestamp [note: 'Timestamp when the studio facility record was first created in the system. | Column created_timestamp (TIMESTAMP) in technology.studio_facility']
  daily_booking_rate_usd decimal(10,2) [note: 'Standard daily rate charged for booking the studio space in US dollars. Used for internal cost allocation and external rental pricing. | Column daily_booking_rate_usd (DECIMAL(10,2)) in technology.studio_facility']
  decommissioning_date date [note: 'Date when the studio facility was decommissioned and taken out of service. Null if still active. | Column decommissioning_date (DATE) in technology.studio_facility']
  fire_suppression_system varchar [note: 'Type of fire suppression system installed in the studio (sprinkler, gas-based, foam, or none). | Column fire_suppression_system (STRING) in technology.studio_facility']
  floor_area_sqft decimal(10,2) [note: 'Total usable floor area of the studio space measured in square feet. | Column floor_area_sqft (DECIMAL(10,2)) in technology.studio_facility']
  floor_number varchar [note: 'Floor level within the broadcast facility building where the studio is located. | Column floor_number (INT) in technology.studio_facility']
  green_screen_available boolean [note: 'Indicates whether the studio has permanent or semi-permanent green screen (chroma key) capability installed. | Column green_screen_available (BOOLEAN) in technology.studio_facility']
  hourly_booking_rate_usd decimal(10,2) [note: 'Standard hourly rate charged for booking the studio space in US dollars. Used for internal cost allocation and external rental pricing. | Column hourly_booking_rate_usd (DECIMAL(10,2)) in technology.studio_facility']
  hvac_type varchar [note: 'Type of heating, ventilation, and air conditioning system installed (standard, silent for audio recording, climate-controlled, or none). | Column hvac_type (STRING) in technology.studio_facility']
  last_maintenance_date date [note: 'Date when the studio facility last underwent scheduled maintenance or inspection. | Column last_maintenance_date (DATE) in technology.studio_facility']
  lighting_capacity_kw decimal(8,2) [note: 'Maximum electrical capacity available for lighting equipment measured in kilowatts. | Column lighting_capacity_kw (DECIMAL(8,2)) in technology.studio_facility']
  lighting_rig_type varchar [note: 'Type of lighting infrastructure installed in the studio (fixed grid, motorized grid, track lighting, LED panel system, hybrid, or none). | Column lighting_rig_type (STRING) in technology.studio_facility']
  network_connectivity varchar [note: 'Network bandwidth capacity available in the studio for content transfer and live streaming (1Gbps, 10Gbps, 25Gbps, 40Gbps, 100Gbps). | Column network_connectivity (STRING) in technology.studio_facility']
  next_maintenance_date date [note: 'Scheduled date for the next maintenance or inspection of the studio facility. | Column next_maintenance_date (DATE) in technology.studio_facility']
  notes varchar [note: 'Free-text field for additional operational notes, special requirements, or configuration details about the studio facility. | Column notes (STRING) in technology.studio_facility']
  operational_status varchar [note: 'Current operational state of the studio facility (active, inactive, under maintenance, under renovation, or decommissioned). | Column operational_status (STRING) in technology.studio_facility']
  power_capacity_kva decimal(10,2) [note: 'Total electrical power capacity available to the studio measured in kilovolt-amperes (kVA). | Column power_capacity_kva (DECIMAL(10,2)) in technology.studio_facility']
  seating_capacity varchar [note: 'Maximum number of audience or crew seats available in the studio space. Null for studios without seating. | Column seating_capacity (INT) in technology.studio_facility']
  soundproof_rating varchar [note: 'Level of acoustic isolation and soundproofing quality of the studio space. | Column soundproof_rating (STRING) in technology.studio_facility']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.studio_facility']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.studio_facility']
  studio_code varchar [note: 'Short alphanumeric code used for scheduling and booking systems (e.g., STA, NS1, GR3). | Column studio_code (STRING) in technology.studio_facility']
  studio_name varchar [note: 'Business name or designation of the studio space (e.g., Studio A, News Set 1, Green Room 3). | Column studio_name (STRING) in technology.studio_facility']
  studio_type varchar [note: 'Classification of the studio space by its primary function and use case. | Column studio_type (STRING) in technology.studio_facility']
  technical_specification varchar [note: 'Video resolution capability of the studio infrastructure (SD, HD, 4K, 8K, or mixed). | Column technical_specification (STRING) in technology.studio_facility']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.studio_facility']
  updated_timestamp timestamp [note: 'Timestamp when the studio facility record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in technology.studio_facility']

  Note: 'Master record for individual studio spaces within broadcast facilities — production studios, news sets, control rooms, editing suites, dubbing stages, and green rooms. Captures studio name, studio type, floor area (sq ft), technical specification (HD, 4K, 8K), audio configuration (mono, stereo, 5.1, Dolby Atmos), lighting rig type, seating/audience capacity, booking availability flag, assigned facility, and operational status. Distinct from broadcast_facility (the building) — this is the individual bookable studio space. | Unity Catalog table: media_broadcasting_ecm.technology.studio_facility'
}

Table technology.noc_monitor {
  noc_monitor_id varchar [pk, note: 'Unique identifier for the NOC monitor configuration record. Primary key. | Column noc_monitor_id (BIGINT) in technology.noc_monitor']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: NOC monitors are physically deployed at broadcast facilities to monitor equipment and signal paths. This FK links each monitor configuration to its deployment facility. No columns removed - geographic | Column broadcast_facility_id (BIGINT) in technology.noc_monitor']
  parent_noc_monitor_id varchar [note: 'Self-referencing FK on noc_monitor (parent_noc_monitor_id) | Column parent_noc_monitor_id (BIGINT) in technology.noc_monitor']
  signal_path_id varchar [note: 'Foreign key linking to technology.signal_path. Business justification: NOC monitors are configured to watch specific signal paths. The \'monitored_entity_type\' field can be \'signal_path\'. Links the monitoring configuration to the signal path being monitored for health, la | Column signal_path_id (BIGINT) in technology.noc_monitor']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: NOC monitors watch transmission equipment health (transmitters, encoders, multiplexers). The \'monitored_entity_type\' field can be \'transmission_equipment\'. Links the monitoring configuration to the sp | Column transmission_equipment_id (BIGINT) in technology.noc_monitor']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.noc_monitor']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.noc_monitor']
  alert_notification_enabled boolean [note: 'Indicates whether alert notifications are currently enabled for this monitor. When false, alerts are logged but not sent to NOC teams. | Column alert_notification_enabled (BOOLEAN) in technology.noc_monitor']
  alert_threshold_value decimal(18,4) [note: 'Numeric threshold that, when exceeded or not met, triggers an alert. Interpretation depends on threshold_metric (e.g., packet loss percentage, bitrate Mbps, uptime percentage). | Column alert_threshold_value (DECIMAL(18,4)) in technology.noc_monitor']
  assigned_noc_team varchar [note: 'Name or identifier of the NOC team responsible for responding to alerts from this monitor. Used for routing notifications and incident assignment. | Column assigned_noc_team (STRING) in technology.noc_monitor']
  auto_remediation_enabled boolean [note: 'Indicates whether automated remediation actions (e.g., service restart, failover trigger) are enabled for this monitor. When true, the NOC system may take corrective action without human intervention. | Column auto_remediation_enabled (BOOLEAN) in technology.noc_monitor']
  business_service_name varchar [note: 'Name of the business service or channel that depends on this monitored entity. Links technical monitoring to business impact analysis. | Column business_service_name (STRING) in technology.noc_monitor']
  compliance_tags varchar [note: 'Comma-separated list of regulatory or compliance frameworks this monitor supports (e.g., FCC_BROADCAST_LICENSE, ATSC_STANDARDS, SOX_CONTROLS). Used for compliance reporting and audit preparation. | Column compliance_tags (STRING) in technology.noc_monitor']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.noc_monitor']
  created_by_user varchar [note: 'Username or identifier of the NOC operator or system administrator who created this monitor configuration. Audit field for accountability. | Column created_by_user (STRING) in technology.noc_monitor']
  created_timestamp timestamp [note: 'Timestamp when this monitor configuration record was first created in the NOC system. Audit field for record lifecycle tracking. | Column created_timestamp (TIMESTAMP) in technology.noc_monitor']
  effective_end_date date [note: 'Date when this monitor configuration was deactivated or superseded. Null for currently active monitors. Used for lifecycle tracking. | Column effective_end_date (DATE) in technology.noc_monitor']
  effective_start_date date [note: 'Date when this monitor configuration became active and began generating alerts. Used for historical analysis and audit trails. | Column effective_start_date (DATE) in technology.noc_monitor']
  equipment_model varchar [note: 'Model number or product name of the monitored device. Helps identify firmware versions and known issues during incident response. | Column equipment_model (STRING) in technology.noc_monitor']
  escalation_tier varchar [note: 'Priority level for alert escalation. Determines which NOC team or management level receives notifications when this monitor triggers an alert. | Column escalation_tier (STRING) in technology.noc_monitor']
  expected_uptime_percent decimal(5,2) [note: 'Target uptime percentage defined in the SLA for this monitored service or device. Used to calculate SLA compliance and trigger breach alerts. | Column expected_uptime_percent (DECIMAL(5,2)) in technology.noc_monitor']
  firmware_version varchar [note: 'Current firmware or software version running on the monitored device. Critical for vulnerability management and compatibility tracking. | Column firmware_version (STRING) in technology.noc_monitor']
  geographic_location varchar [note: 'Physical location or data center where the monitored equipment or service endpoint resides. Used for regional outage correlation and dispatch. | Column geographic_location (STRING) in technology.noc_monitor']
  is_primary boolean [note: 'Indicates whether this monitor tracks the primary (active) instance in a redundant configuration. False indicates a backup or standby instance. | Column is_primary (BOOLEAN) in technology.noc_monitor']
  last_modified_by_user varchar [note: 'Username or identifier of the NOC operator or system administrator who last modified this monitor configuration. Audit field for change tracking. | Column last_modified_by_user (STRING) in technology.noc_monitor']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to this monitor configuration. Used to track configuration drift and change frequency. | Column last_modified_timestamp (TIMESTAMP) in technology.noc_monitor']
  monitor_category varchar [note: 'High-level functional category of the monitored entity within the broadcast infrastructure. Used for dashboard organization and reporting rollups. | Column monitor_category (STRING) in technology.noc_monitor']
  monitor_code varchar [note: 'Short alphanumeric code uniquely identifying this monitor within the NOC system. Used for system integration and API references. | Column monitor_code (STRING) in technology.noc_monitor']
  monitor_description varchar [note: 'Detailed textual description of what this monitor tracks, its business purpose, and any special configuration notes. Provides context for NOC operators. | Column monitor_description (STRING) in technology.noc_monitor']
  monitor_name varchar [note: 'Human-readable name assigned to this monitoring endpoint or service. Used for identification in NOC dashboards and alert notifications. | Column monitor_name (STRING) in technology.noc_monitor']
  monitor_status varchar [note: 'Current operational status of the monitor configuration. Active monitors generate alerts; inactive or suspended monitors do not trigger notifications. | Column monitor_status (STRING) in technology.noc_monitor']
  monitored_endpoint_url varchar [note: 'Network address or URL of the monitored service or device. May be an IP address, streaming URL, or API endpoint. Confidential as it exposes internal infrastructure topology. | Column monitored_endpoint_url (STRING) in technology.noc_monitor']
  monitored_entity_type varchar [note: 'Classification of the infrastructure component or signal path being monitored. Determines the applicable monitoring protocols and alert thresholds. | Column monitored_entity_type (STRING) in technology.noc_monitor']
  monitored_ip_address varchar [note: 'IPv4 address of the monitored device or service endpoint. Used for network-level monitoring and diagnostics. Confidential infrastructure data. | Column monitored_ip_address (STRING) in technology.noc_monitor']
  monitored_port varchar [note: 'TCP or UDP port number on which the monitored service listens. Used in conjunction with IP address for endpoint identification. | Column monitored_port (INT) in technology.noc_monitor']
  monitoring_protocol varchar [note: 'Technical protocol or method used to collect telemetry and status data from the monitored entity. Examples include SNMP (Simple Network Management Protocol) for device polling, MPEG-TS probe for transport stream analysis, SCTE-35 listener for ad insertion markers. | Column monitoring_protocol (STRING) in technology.noc_monitor']
  notes varchar [note: 'Free-form text field for additional operational notes, troubleshooting tips, or configuration context not captured in structured fields. Used by NOC teams for knowledge sharing. | Column notes (STRING) in technology.noc_monitor']
  notification_channel varchar [note: 'Communication channel or integration used to deliver alert notifications to the assigned NOC team. Multiple channels may be configured per monitor. | Column notification_channel (STRING) in technology.noc_monitor']
  polling_interval_seconds varchar [note: 'Frequency in seconds at which the NOC system queries or samples the monitored entity. Lower intervals provide faster fault detection but increase system load. | Column polling_interval_seconds (INT) in technology.noc_monitor']
  redundancy_group varchar [note: 'Identifier for the redundancy or failover group this monitor belongs to. Multiple monitors in the same group represent primary/backup configurations. | Column redundancy_group (STRING) in technology.noc_monitor']
  remediation_script_path varchar [note: 'File system path or identifier of the automated remediation script executed when this monitor triggers an alert. Confidential as it exposes automation logic. | Column remediation_script_path (STRING) in technology.noc_monitor']
  sla_tier varchar [note: 'Service level agreement tier associated with this monitored entity. Determines response time commitments and escalation procedures. | Column sla_tier (STRING) in technology.noc_monitor']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.noc_monitor']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.noc_monitor']
  threshold_metric varchar [note: 'The specific performance or quality metric being measured against the alert threshold. Examples: packet_loss_percent, bitrate_mbps, uptime_percent, latency_ms, error_rate. | Column threshold_metric (STRING) in technology.noc_monitor']
  threshold_operator varchar [note: 'Comparison operator applied to the threshold metric. Defines whether an alert is triggered when the metric exceeds, falls below, or equals the threshold value. | Column threshold_operator (STRING) in technology.noc_monitor']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.noc_monitor']
  vendor_name varchar [note: 'Name of the equipment manufacturer or service provider for the monitored entity. Used for vendor-specific troubleshooting and support escalation. | Column vendor_name (STRING) in technology.noc_monitor']

  Note: 'Master configuration record for each monitored signal path, service, or system endpoint registered in the Network Operations Center (NOC) monitoring platform. Captures monitor name, monitored entity type (channel feed, satellite link, IP stream, encoder, transmitter), monitoring protocol (SNMP, MPEG-TS probe, SCTE-35 listener), alert threshold configuration, escalation tier, assigned NOC team, polling interval, and active status. Defines WHAT the NOC watches — distinct from noc_alert which captures WHAT went wrong. | Unity Catalog table: media_broadcasting_ecm.technology.noc_monitor'
}

Table technology.noc_alert {
  noc_alert_id varchar [pk, note: 'Unique identifier for the NOC alert event. Primary key for the noc_alert product. | Column noc_alert_id (BIGINT) in technology.noc_alert']
  affected_channel_id varchar [note: 'Identifier of the broadcast channel or service impacted by the alert event. May be null for infrastructure alerts not tied to a specific channel. | Column affected_channel_id (BIGINT) in scheduling.noc_alert']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: NOC alerts escalating to compliance incidents when regulatory thresholds breached (caption accuracy drop, EAS relay failure). Real-time monitoring-to-compliance workflow for regulatory risk management | Column compliance_incident_id (BIGINT) in compliance.noc_alert']
  correlated_noc_alert_id varchar [note: 'Self-referencing FK on noc_alert (correlated_noc_alert_id) | Column correlated_noc_alert_id (BIGINT) in technology.noc_alert']
  impacted_subscriber_id varchar [note: 'Foreign key linking to subscriber.subscriber. Business justification: Critical streaming service alerts require identifying specific affected subscribers for proactive customer care outreach, SLA credit processing, and personalized service recovery. Incident management  | Column impacted_subscriber_id (BIGINT) in subscriber.noc_alert']
  noc_monitor_id varchar [note: 'Identifier of the specific monitoring probe, sensor, or system component that detected and triggered this alert event. Links to the monitoring infrastructure inventory. | Column noc_monitor_id (BIGINT) in technology.noc_alert']
  outage_record_id varchar [note: 'Foreign key linking to technology.outage_record. Business justification: NOC alerts trigger outage records when severity thresholds are breached. Links the real-time alert event to the formal outage record created for tracking, reporting, and post-incident review. Populate | Column outage_record_id (BIGINT) in technology.noc_alert']
  primary_noc_employee_id varchar [note: 'Identifier of the NOC operator or engineer who acknowledged the alert. Null if not yet acknowledged. | Column primary_noc_employee_id (BIGINT) in workforce.noc_alert']
  signal_path_id varchar [note: 'Foreign key linking to technology.signal_path. Business justification: NOC alerts monitor signal paths for broadcast feeds. The \'monitor_name\' and \'affected_channel_name\' fields suggest signal path monitoring. Adding FK to link alerts to the specific signal path experien | Column signal_path_id (BIGINT) in technology.noc_alert']
  transmission_equipment_id varchar [note: 'Identifier of the specific equipment unit (encoder, transmitter, router, server) that experienced the fault. Links to the technology asset inventory. Null if alert is not equipment-specific. | Column transmission_equipment_id (BIGINT) in technology.noc_alert']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.noc_alert']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.noc_alert']
  acknowledged_by_user_name varchar [note: 'Full name of the NOC operator or engineer who acknowledged the alert, providing audit trail for incident response. | Column acknowledged_by_user_name (STRING) in technology.noc_alert']
  acknowledged_timestamp timestamp [note: 'The date and time when a NOC operator or engineer acknowledged receipt of the alert and began investigation. Null if not yet acknowledged. | Column acknowledged_timestamp (TIMESTAMP) in technology.noc_alert']
  affected_viewer_count_estimate varchar [note: 'Estimated number of viewers or subscribers impacted by the alert event, based on audience measurement data and service reach. Used for prioritization and business impact analysis. | Column affected_viewer_count_estimate (INT) in technology.noc_alert']
  alert_severity varchar [note: 'The priority level assigned to the alert event, typically classified as P1 (critical - immediate service impact), P2 (high - significant degradation), P3 (medium - minor impact), or P4 (low - informational). Determines escalation and response urgency. | Column alert_severity (STRING) in technology.noc_alert']
  alert_status varchar [note: 'The current lifecycle state of the alert event within the NOC incident management workflow. Tracks progression from initial detection through acknowledgment, investigation, resolution, and closure. [ENUM-REF-CANDIDATE: open|acknowledged|in_progress|resolved|closed|auto_resolved|escalated — 7 candidates stripped; promote to reference product] | Column alert_status (STRING) in technology.noc_alert']
  alert_timestamp timestamp [note: 'The exact date and time when the alert event was triggered by the monitoring platform. This is the principal business event timestamp representing when the fault or anomaly was first detected. | Column alert_timestamp (TIMESTAMP) in technology.noc_alert']
  alert_type varchar [note: 'The category or classification of the alert event, indicating the nature of the fault detected by the NOC monitoring system. Examples include signal loss, encoder failure, satellite link degradation, audio dropout, SCTE-35 splice failure, IP stream interruption, or transmitter fault. [ENUM-REF-CANDIDATE: signal_loss|encoder_failure|satellite_link_degradation|audio_dropout|scte35_splice_failure|ip_stream_interruption|transmitter_fault|cdn_failure|playout_automation_error|graphics_insertion_failure — 10 candidates stripped; promote to reference product] | Column alert_type (STRING) in technology.noc_alert']
  auto_resolution_flag boolean [note: 'Boolean indicator of whether the alert was automatically resolved by the monitoring platform or automation system without human intervention (True) or required manual resolution (False). | Column auto_resolution_flag (BOOLEAN) in technology.noc_alert']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.noc_alert']
  created_timestamp timestamp [note: 'The date and time when this alert record was first inserted into the data platform. Used for data lineage and audit purposes. | Column created_timestamp (TIMESTAMP) in technology.noc_alert']
  equipment_serial_number varchar [note: 'Manufacturer serial number of the equipment unit that experienced the fault, used for warranty claims and maintenance tracking. | Column equipment_serial_number (STRING) in technology.noc_alert']
  escalation_history varchar [note: 'Chronological log of escalation events, including timestamps, escalation reasons, and personnel notified. Captures the full escalation chain for audit and process improvement. | Column escalation_history (STRING) in technology.noc_alert']
  escalation_level varchar [note: 'The current escalation tier of the alert within the NOC incident management hierarchy. 0 indicates no escalation, higher numbers indicate progressive escalation to senior engineers, management, or external vendors. | Column escalation_level (INT) in technology.noc_alert']
  fault_description varchar [note: 'Detailed textual description of the fault or anomaly detected, including technical details, error codes, and diagnostic information captured by the monitoring system at the time of alert generation. | Column fault_description (STRING) in technology.noc_alert']
  fault_location varchar [note: 'Physical or logical location where the fault was detected, such as facility name, rack identifier, transmission site, or network segment. Aids in dispatch and troubleshooting. | Column fault_location (STRING) in technology.noc_alert']
  impact_assessment varchar [note: 'Business impact classification of the alert event, assessing the scope and severity of service disruption to viewers, advertisers, or downstream systems. | Column impact_assessment (STRING) in technology.noc_alert']
  last_modified_timestamp timestamp [note: 'The date and time when this alert record was most recently updated in the data platform. Used for data lineage and audit purposes. | Column last_modified_timestamp (TIMESTAMP) in technology.noc_alert']
  monitor_name varchar [note: 'Human-readable name or label of the monitoring probe or sensor that triggered the alert, providing operational context for NOC staff. | Column monitor_name (STRING) in technology.noc_alert']
  notification_recipients varchar [note: 'Comma-separated list of personnel or distribution groups who received automated notifications for this alert event, providing audit trail for incident communication. | Column notification_recipients (STRING) in technology.noc_alert']
  notification_sent_flag boolean [note: 'Boolean indicator of whether automated notifications (email, SMS, pager) were successfully sent to on-call personnel for this alert event (True) or notification failed (False). | Column notification_sent_flag (BOOLEAN) in technology.noc_alert']
  resolution_duration_minutes varchar [note: 'The total elapsed time in minutes from alert timestamp to resolved timestamp, used for SLA compliance tracking and performance analysis. Null if not yet resolved. | Column resolution_duration_minutes (INT) in technology.noc_alert']
  resolution_notes varchar [note: 'Detailed textual notes documenting the resolution actions taken, root cause analysis, corrective measures applied, and any follow-up required. Null if not yet resolved. | Column resolution_notes (STRING) in technology.noc_alert']
  resolved_by_user_name varchar [note: 'Full name of the NOC operator, engineer, or technician who resolved the alert, providing audit trail for incident resolution. | Column resolved_by_user_name (STRING) in technology.noc_alert']
  resolved_timestamp timestamp [note: 'The date and time when the alert was marked as resolved, indicating the fault condition has been corrected and service restored. Null if not yet resolved. | Column resolved_timestamp (TIMESTAMP) in technology.noc_alert']
  root_cause_category varchar [note: 'High-level classification of the underlying root cause of the alert event, determined during or after resolution. Used for trend analysis and preventive maintenance planning. [ENUM-REF-CANDIDATE: hardware_failure|software_bug|network_issue|power_outage|human_error|third_party_vendor|environmental|configuration_error|capacity_limit|unknown — 10 candidates stripped; promote to reference product] | Column root_cause_category (STRING) in technology.noc_alert']
  sla_breach_flag boolean [note: 'Boolean indicator of whether the alert resolution exceeded the defined SLA target for the alert severity level (True) or was resolved within SLA (False). Used for performance reporting and vendor management. | Column sla_breach_flag (BOOLEAN) in technology.noc_alert']
  sla_target_minutes varchar [note: 'The contractual or operational SLA target resolution time in minutes for this alert severity level, used as the benchmark for performance measurement. | Column sla_target_minutes (INT) in technology.noc_alert']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.noc_alert']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.noc_alert']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.noc_alert']

  Note: 'Transactional record of every NOC alert event triggered by the monitoring platform — signal loss, encoder failure, satellite link degradation, audio dropout, SCTE-35 splice failure, IP stream interruption, or transmitter fault. Captures alert timestamp, alert severity (P1–P4), alert type, affected monitor, affected channel or service, fault description, auto-resolution flag, acknowledged timestamp, resolved timestamp, resolution notes, and escalation history. Operational heartbeat of NOC incident management. | Unity Catalog table: media_broadcasting_ecm.technology.noc_alert'
}

Table technology.it_asset {
  it_asset_id varchar [pk, note: 'Unique identifier for the IT asset record. Primary key for the IT asset inventory. | Column it_asset_id (BIGINT) in technology.it_asset']
  broadcast_facility_id varchar [note: 'Identifier of the physical facility, studio, broadcast center, or data center where the asset is located or deployed. | Column broadcast_facility_id (BIGINT) in technology.it_asset']
  equipment_procurement_id varchar [note: 'Foreign key linking to technology.equipment_procurement. Business justification: IT assets should reference their procurement event. The \'purchase_order_number\' field on it_asset should be normalized by linking to equipment_procurement. Same pattern as transmission_equipment - pro | Column equipment_procurement_id (BIGINT) in technology.it_asset']
  replaced_it_asset_id varchar [note: 'Self-referencing FK on it_asset (replaced_it_asset_id) | Column replaced_it_asset_id (BIGINT) in technology.it_asset']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.it_asset']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.it_asset']
  asset_category varchar [note: 'High-level classification of the IT asset type distinguishing between hardware, software, licenses, peripherals, network devices, and storage systems. | Column asset_category (STRING) in technology.it_asset']
  asset_tag varchar [note: 'Physical or logical tag identifier affixed to or assigned to the asset for tracking and inventory purposes. Unique business identifier used for asset management and audits. | Column asset_tag (STRING) in technology.it_asset']
  asset_type varchar [note: 'Detailed classification of the specific asset type within its category (e.g., server, workstation, router, switch, MAM workstation, editing system, playout server, storage array, application license, operating system license). | Column asset_type (STRING) in technology.it_asset']
  assigned_team varchar [note: 'Business unit, department, or team responsible for or using this asset (e.g., Production, Post-Production, Network Operations Center, IT Infrastructure, Playout Operations). | Column assigned_team (STRING) in technology.it_asset']
  assigned_user varchar [note: 'Name or identifier of the employee or contractor to whom this asset is currently assigned for operational use. | Column assigned_user (STRING) in technology.it_asset']
  compliance_required boolean [note: 'Indicates whether this asset is subject to specific regulatory compliance requirements (e.g., FCC equipment authorization, broadcast technical standards, data security regulations). | Column compliance_required (BOOLEAN) in technology.it_asset']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.it_asset']
  created_timestamp timestamp [note: 'Timestamp when this IT asset record was first created in the system, used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in technology.it_asset']
  criticality_level varchar [note: 'Business criticality classification of the asset based on its impact to operations if unavailable (critical for broadcast continuity, high for major workflows, medium for standard operations, low for non-essential). | Column criticality_level (STRING) in technology.it_asset']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the procurement cost (e.g., USD, GBP, EUR). | Column currency_code (STRING) in technology.it_asset']
  decommission_date date [note: 'Date when the asset was removed from active service and decommissioned, marking the end of its operational lifecycle. | Column decommission_date (DATE) in technology.it_asset']
  deployment_date date [note: 'Date when the asset was deployed into production or made available for operational use, distinct from procurement date. | Column deployment_date (DATE) in technology.it_asset']
  disposal_date date [note: 'Date when the asset was physically disposed of, sold, recycled, or otherwise removed from organizational inventory. | Column disposal_date (DATE) in technology.it_asset']
  disposal_method varchar [note: 'Method by which the asset was disposed of at end of life (sold to third party, recycled through certified e-waste program, donated, securely destroyed, or returned to vendor). | Column disposal_method (STRING) in technology.it_asset']
  hostname varchar [note: 'Network hostname or computer name assigned to the asset for identification on the network and in system management tools. | Column hostname (STRING) in technology.it_asset']
  ip_address varchar [note: 'Assigned IP address for network-connected assets, used for network management, monitoring, and troubleshooting. | Column ip_address (STRING) in technology.it_asset']
  last_audit_date date [note: 'Date of the most recent physical or logical audit verification of this asset, used for compliance and inventory accuracy tracking. | Column last_audit_date (DATE) in technology.it_asset']
  last_modified_timestamp timestamp [note: 'Timestamp when this IT asset record was last updated, used for change tracking and audit purposes. | Column last_modified_timestamp (TIMESTAMP) in technology.it_asset']
  license_key varchar [note: 'Activation or license key for software assets, required for installation and compliance verification. Highly confidential to prevent unauthorized use. | Column license_key (STRING) in technology.it_asset']
  license_type varchar [note: 'Type of software licensing model governing usage rights (perpetual ownership, time-based subscription, concurrent user, named user, site license, or enterprise agreement). | Column license_type (STRING) in technology.it_asset']
  lifecycle_status varchar [note: 'Current operational status of the asset in its lifecycle (active in production, inactive but available, spare inventory, under maintenance, decommissioned awaiting disposal, disposed, or retired from service). [ENUM-REF-CANDIDATE: active|inactive|spare|maintenance|decommissioned|disposed|retired — 7 candidates stripped; promote to reference product] | Column lifecycle_status (STRING) in technology.it_asset']
  location_description varchar [note: 'Detailed physical location within the facility (e.g., Server Room A, Rack 12, Edit Suite 3, NOC Floor 2, Studio B Control Room). | Column location_description (STRING) in technology.it_asset']
  mac_address varchar [note: 'Hardware MAC address of the network interface, unique identifier for network devices used in asset discovery and security management. | Column mac_address (STRING) in technology.it_asset']
  manufacturer varchar [note: 'Name of the company that manufactured or produced the IT asset (e.g., Dell, HP, Cisco, Adobe, Dalet, Avid). | Column manufacturer (STRING) in technology.it_asset']
  model varchar [note: 'Manufacturer\'s model number or designation for the asset, identifying the specific product line and configuration. | Column model (STRING) in technology.it_asset']
  notes varchar [note: 'Free-form text field for additional information, special configurations, known issues, or operational notes about the asset. | Column notes (STRING) in technology.it_asset']
  os_version varchar [note: 'Version of the operating system installed on hardware assets or firmware version for network devices and embedded systems. Critical for patch management and compatibility tracking. | Column os_version (STRING) in technology.it_asset']
  procurement_cost decimal(15,2) [note: 'Original purchase price or acquisition cost of the asset in the organization\'s base currency, used for financial reporting and depreciation. | Column procurement_cost (DECIMAL(15,2)) in technology.it_asset']
  procurement_date date [note: 'Date when the asset was purchased or acquired by the organization, used for depreciation calculations and lifecycle tracking. | Column procurement_date (DATE) in technology.it_asset']
  serial_number varchar [note: 'Unique serial number assigned by the manufacturer to this specific unit, used for warranty claims, support, and asset verification. | Column serial_number (STRING) in technology.it_asset']
  software_version varchar [note: 'Version number of the software application or license, used for compatibility verification, upgrade planning, and support entitlement. | Column software_version (STRING) in technology.it_asset']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.it_asset']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.it_asset']
  support_contract_number varchar [note: 'Reference number for extended support or maintenance contract covering this asset beyond standard warranty. | Column support_contract_number (STRING) in technology.it_asset']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.it_asset']
  useful_life_years varchar [note: 'Expected useful life of the asset in years, used for depreciation calculations and replacement planning. | Column useful_life_years (INT) in technology.it_asset']
  vendor_name varchar [note: 'Name of the vendor or supplier from whom the asset was purchased, used for vendor management and support escalation. | Column vendor_name (STRING) in technology.it_asset']
  warranty_expiry_date date [note: 'Date when the manufacturer or vendor warranty coverage ends, critical for maintenance planning and support contract renewal decisions. | Column warranty_expiry_date (DATE) in technology.it_asset']
  warranty_start_date date [note: 'Date when the manufacturer or vendor warranty coverage begins for this asset. | Column warranty_start_date (DATE) in technology.it_asset']

  Note: 'Master inventory record for all IT hardware and software assets supporting media operations — servers, workstations, network switches, routers, storage arrays, MAM workstations, editing systems, and licensed software. Captures asset tag, asset category (hardware/software), manufacturer, model, serial number, OS/firmware version, assigned user or team, assigned facility, procurement date, warranty expiry, depreciation schedule reference, and lifecycle status (active, decommissioned, spare). SSOT for IT asset inventory distinct from broadcast transmission_equipment. | Unity Catalog table: media_broadcasting_ecm.technology.it_asset'
}

Table technology.network_circuit {
  network_circuit_id varchar [pk, note: 'Unique identifier for the network circuit. Primary key for the network circuit master record. | Column network_circuit_id (BIGINT) in technology.network_circuit']
  redundant_network_circuit_id varchar [note: 'Self-referencing FK on network_circuit (redundant_network_circuit_id) | Column redundant_network_circuit_id (BIGINT) in technology.network_circuit']
  vendor_contract_id varchar [note: 'Foreign key linking to technology.vendor_contract. Business justification: network_circuit.contract_reference_number (STRING) should be normalized to FK to vendor_contract. Network circuits are provisioned under vendor service contracts. This links the circuit to its governi | Column vendor_contract_id (BIGINT) in technology.network_circuit']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.network_circuit']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.network_circuit']
  average_utilization_percent decimal(5,2) [note: 'Average bandwidth utilization as a percentage of provisioned capacity over the most recent measurement period (typically 30 days). Used for capacity planning and right-sizing decisions. Range 0.00 to 100.00. | Column average_utilization_percent (DECIMAL(5,2)) in technology.network_circuit']
  bandwidth_mbps decimal(12,3) [note: 'Provisioned bandwidth capacity of the circuit measured in megabits per second. For circuits with bandwidth measured in Gbps, convert to Mbps (e.g., 10 Gbps = 10000 Mbps). Critical for capacity planning and network performance management. | Column bandwidth_mbps (DECIMAL(12,3)) in technology.network_circuit']
  carrier_provider_name varchar [note: 'Name of the telecommunications carrier or service provider that provisions and maintains the circuit (e.g., AT&T, Verizon, Level 3, Comcast Business, Intelsat). | Column carrier_provider_name (STRING) in technology.network_circuit']
  carrier_trouble_ticket_url varchar [note: 'Web URL for the carriers trouble ticket or service portal where incidents and service requests for this circuit can be submitted and tracked. | Column carrier_trouble_ticket_url (STRING) in technology.network_circuit']
  circuit_identifier varchar [note: 'Business identifier or circuit ID assigned by the carrier or internal network operations team. This is the externally-known reference number used in carrier documentation, trouble tickets, and billing statements. | Column circuit_identifier (STRING) in technology.network_circuit']
  circuit_purpose varchar [note: 'Business purpose or use case for the circuit. Examples: live broadcast contribution feed, studio-to-transmitter link (STL), content distribution network (CDN) interconnect, remote production backhaul, disaster recovery link, office internet access, inter-facility MPLS backbone. | Column circuit_purpose (STRING) in technology.network_circuit']
  circuit_type varchar [note: 'Classification of the network circuit technology. MPLS (Multiprotocol Label Switching) for managed IP networks, dark fiber for unlit fiber optic infrastructure, satellite for space-based transmission, internet transit for public internet connectivity, dedicated broadcast contribution for live content feeds, ethernet for layer-2 connectivity, wavelength for DWDM optical circuits. [ENUM-REF-CANDIDATE: MPLS|dark_fiber|satellite|internet_transit|dedicated_broadcast_contribution|ethernet|wavelength — 7 candidates stripped; promote to reference product] | Column circuit_type (STRING) in technology.network_circuit']
  committed_information_rate_mbps decimal(12,3) [note: 'Guaranteed minimum bandwidth committed by the carrier under the SLA, measured in megabits per second. For burstable circuits, this is the sustained rate; peak burst rate may be higher. Equal to bandwidth_mbps for non-burstable circuits. | Column committed_information_rate_mbps (DECIMAL(12,3)) in technology.network_circuit']
  contract_expiration_date date [note: 'Date when the current service contract term expires. Triggers contract renewal or renegotiation workflows. Null for month-to-month or evergreen contracts. | Column contract_expiration_date (DATE) in technology.network_circuit']
  contract_term_months varchar [note: 'Length of the service contract term in months. Common terms are 12, 24, 36, or 60 months. Used for contract renewal tracking and financial planning. | Column contract_term_months (INT) in technology.network_circuit']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.network_circuit']
  created_timestamp timestamp [note: 'Timestamp when this network circuit record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in technology.network_circuit']
  demarcation_point varchar [note: 'Physical location description of the network demarcation point where carrier responsibility ends and customer responsibility begins. Typically a patch panel, network interface device (NID), or equipment rack location. | Column demarcation_point (STRING) in technology.network_circuit']
  destination_facility_address varchar [note: 'Physical street address of the destination facility including street, city, state/province, and postal code. Required for carrier provisioning and site access coordination. | Column destination_facility_address (STRING) in technology.network_circuit']
  destination_facility_name varchar [note: 'Name of the destination facility, remote site, transmission tower, or endpoint where the circuit terminates. This is the Z-end of the circuit. For point-to-multipoint circuits, this represents the primary destination. | Column destination_facility_name (STRING) in technology.network_circuit']
  diversity_route_indicator varchar [note: 'Identifier or description of the physical route diversity for this circuit. Used to ensure redundant circuits do not share common failure points (e.g., same conduit, same central office). Examples: Route A, Route B, North Path, South Path. | Column diversity_route_indicator (STRING) in technology.network_circuit']
  installation_cost decimal(15,2) [note: 'One-time installation or provisioning cost in USD. Includes circuit installation, equipment installation, site survey, and activation fees. Does not include monthly recurring charges. | Column installation_cost (DECIMAL(15,2)) in technology.network_circuit']
  interface_type varchar [note: 'Physical media type of the circuit interface at the customer premises. Fiber optic (single-mode or multi-mode), copper (ethernet over copper), coaxial (cable modem), wireless (microwave or radio), satellite dish (VSAT terminal). | Column interface_type (STRING) in technology.network_circuit']
  ip_address_range varchar [note: 'IP address range or subnet assigned to this circuit in CIDR notation (e.g., 10.50.100.0/24). Applicable for routed IP circuits. Null for layer-2 or non-IP circuits. | Column ip_address_range (STRING) in technology.network_circuit']
  is_primary_path boolean [note: 'Boolean flag indicating whether this circuit is the primary (active) path in a redundant configuration. True for primary circuits, false for backup/standby circuits. Null if redundancy does not apply. | Column is_primary_path (BOOLEAN) in technology.network_circuit']
  last_maintenance_date date [note: 'Date of the most recent scheduled maintenance activity performed on this circuit. Used for maintenance history tracking and preventive maintenance scheduling. | Column last_maintenance_date (DATE) in technology.network_circuit']
  last_modified_timestamp timestamp [note: 'Timestamp when this network circuit record was most recently updated. Used for change tracking and audit trail. | Column last_modified_timestamp (TIMESTAMP) in technology.network_circuit']
  monitoring_enabled boolean [note: 'Boolean flag indicating whether this circuit is actively monitored by network operations center (NOC) monitoring systems for availability, performance, and threshold alerts. True if monitored, false if not. | Column monitoring_enabled (BOOLEAN) in technology.network_circuit']
  monthly_recurring_cost decimal(15,2) [note: 'Monthly recurring charge for the circuit service in USD. Includes port fees, bandwidth charges, and managed service fees. Does not include one-time installation costs or usage-based overage charges. | Column monthly_recurring_cost (DECIMAL(15,2)) in technology.network_circuit']
  next_scheduled_maintenance_date date [note: 'Date of the next planned maintenance window for this circuit. Used for change management coordination and service availability planning. | Column next_scheduled_maintenance_date (DATE) in technology.network_circuit']
  notes varchar [note: 'Free-form text field for additional notes, special configurations, known issues, or operational considerations specific to this circuit. Used for knowledge transfer and operational documentation. | Column notes (STRING) in technology.network_circuit']
  operational_status varchar [note: 'Current operational state of the circuit. Active (in production use), inactive (provisioned but not in use), maintenance (scheduled maintenance window), degraded (operating below SLA), failed (outage condition), pending activation (ordered but not yet live), decommissioned (permanently removed from service). [ENUM-REF-CANDIDATE: active|inactive|maintenance|degraded|failed|pending_activation|decommissioned — 7 candidates stripped; promote to reference product] | Column operational_status (STRING) in technology.network_circuit']
  origin_facility_address varchar [note: 'Physical street address of the origin facility including street, city, state/province, and postal code. Required for carrier provisioning and site access coordination. | Column origin_facility_address (STRING) in technology.network_circuit']
  origin_facility_name varchar [note: 'Name of the originating facility, studio, broadcast center, or network operations center (NOC) where the circuit originates. This is the A-end of the circuit. | Column origin_facility_name (STRING) in technology.network_circuit']
  peak_utilization_percent decimal(5,2) [note: 'Peak bandwidth utilization as a percentage of provisioned capacity over the most recent measurement period (typically 30 days). Identifies capacity constraints and congestion risk. Range 0.00 to 100.00. | Column peak_utilization_percent (DECIMAL(5,2)) in technology.network_circuit']
  provisioning_date date [note: 'Date when the circuit was successfully provisioned, tested, and turned up for production use. This is the service activation date, not the order date. | Column provisioning_date (DATE) in technology.network_circuit']
  redundancy_group varchar [note: 'Identifier for the redundancy or failover group this circuit belongs to. Circuits in the same redundancy group provide backup for each other. Null if the circuit is not part of a redundant configuration. | Column redundancy_group (STRING) in technology.network_circuit']
  sla_tier varchar [note: 'Service level tier defining uptime guarantees, mean time to repair (MTTR), and support response times. Mission critical (99.99% uptime, 2-hour MTTR) for live broadcast circuits, business critical (99.9% uptime, 4-hour MTTR) for production workflows, standard (99.5% uptime, 8-hour MTTR) for office connectivity, best effort (no guarantee) for non-critical links. | Column sla_tier (STRING) in technology.network_circuit']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.network_circuit']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.network_circuit']
  technical_contact_email varchar [note: 'Email address of the internal technical contact responsible for this circuit. Used for automated alerts and incident notifications. | Column technical_contact_email (STRING) in technology.network_circuit']
  technical_contact_name varchar [note: 'Name of the internal technical contact or network engineer responsible for this circuit. Used for escalation and coordination during incidents or maintenance. | Column technical_contact_name (STRING) in technology.network_circuit']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.network_circuit']
  vlan_number varchar [note: 'VLAN identifier used for layer-2 segmentation on this circuit. Applicable for ethernet and MPLS circuits. Range 1-4094 per IEEE 802.1Q standard. Null for non-VLAN circuits. | Column vlan_number (INT) in technology.network_circuit']

  Note: 'Master record for all wide-area and local-area network circuits provisioned for Media Broadcasting — MPLS circuits, dark fiber, satellite bandwidth allocations, internet transit links, and dedicated broadcast contribution circuits. Captures circuit ID, circuit type (MPLS, fiber, satellite, internet), carrier/provider, bandwidth (Mbps/Gbps), origin facility, destination facility or endpoint, SLA tier, monthly cost, contract reference, provisioning date, and operational status. Enables network topology management and capacity planning. | Unity Catalog table: media_broadcasting_ecm.technology.network_circuit'
}

Table technology.signal_path {
  signal_path_id varchar [pk, note: 'Unique identifier for the signal path record. Primary key for the signal path entity. | Column signal_path_id (BIGINT) in technology.signal_path']
  broadcast_standard_id varchar [note: 'Foreign key linking to technology.broadcast_standard. Business justification: Signal paths conform to broadcast standards (ATSC 3.0, DVB-S2, etc.). The \'signal_format\', \'video_resolution\', \'frame_rate\' fields align with standard specifications. Links the signal path to the tech | Column broadcast_standard_id (BIGINT) in technology.signal_path']
  network_circuit_id varchar [note: 'Foreign key linking to technology.network_circuit. Business justification: Signal paths traverse network circuits for transport. The \'transport_protocol\' and \'bandwidth_mbps\' fields align with circuit characteristics. Links the logical signal path to the physical network cir | Column network_circuit_id (BIGINT) in technology.signal_path']
  redundant_signal_path_id varchar [note: 'Self-referencing FK on signal_path (redundant_signal_path_id) | Column redundant_signal_path_id (BIGINT) in technology.signal_path']
  satellite_transponder_id varchar [note: 'Foreign key linking to technology.satellite_transponder. Business justification: Signal paths can use satellite transponders for distribution (uplink/downlink). The \'path_type\' field can indicate satellite paths. Links the signal path to the specific transponder used for satellite | Column satellite_transponder_id (BIGINT) in technology.signal_path']
  source_transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Signal paths originate from transmission equipment (encoder, multiplexer). The \'source_endpoint\' field should reference specific equipment. Adding FK to link the signal path to its source equipment, e | Column source_transmission_equipment_id (BIGINT) in technology.signal_path']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.signal_path']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.signal_path']
  assigned_channel varchar [note: 'Broadcast channel, frequency, or logical channel identifier associated with this signal path for transmission or distribution purposes. | Column assigned_channel (STRING) in technology.signal_path']
  audio_channels varchar [note: 'Number of discrete audio channels carried on this signal path, such as 2 (stereo), 6 (5.1 surround), 8, or 16 channels for multi-language or immersive audio. | Column audio_channels (INT) in technology.signal_path']
  bandwidth_mbps decimal(10,2) [note: 'Allocated or measured bandwidth capacity for this signal path expressed in megabits per second (Mbps). Critical for capacity planning and quality assurance. | Column bandwidth_mbps (DECIMAL(10,2)) in technology.signal_path']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.signal_path']
  created_timestamp timestamp [note: 'Timestamp when this signal path record was first created in the system, used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in technology.signal_path']
  destination_endpoint varchar [note: 'Identifier or address of the terminating endpoint where the signal exits this path. May be a transmitter, encoder, playout server, or distribution output. | Column destination_endpoint (STRING) in technology.signal_path']
  effective_end_date date [note: 'Date when this signal path configuration is scheduled to be decommissioned or replaced. Null indicates an open-ended operational period. | Column effective_end_date (DATE) in technology.signal_path']
  effective_start_date date [note: 'Date when this signal path configuration became or will become operationally effective and available for signal routing. | Column effective_start_date (DATE) in technology.signal_path']
  encryption_enabled boolean [note: 'Boolean flag indicating whether signal encryption is enabled on this path for content protection and security compliance. | Column encryption_enabled (BOOLEAN) in technology.signal_path']
  encryption_method varchar [note: 'Encryption algorithm or method applied to the signal on this path, such as AES-128, AES-256, DRM (Digital Rights Management) system identifier, or proprietary encryption scheme. | Column encryption_method (STRING) in technology.signal_path']
  error_correction_enabled boolean [note: 'Boolean flag indicating whether forward error correction (FEC) or other error correction mechanisms are enabled on this signal path to ensure signal integrity. | Column error_correction_enabled (BOOLEAN) in technology.signal_path']
  failure_reason varchar [note: 'Description or code indicating the root cause or reason for the most recent failure event on this signal path. | Column failure_reason (STRING) in technology.signal_path']
  frame_rate decimal(18,2) [note: 'Video frame rate specification for this signal path, such as 23.976, 24, 25, 29.97, 30, 50, 59.94, or 60 frames per second. | Column frame_rate (DECIMAL(18,2)) in technology.signal_path']
  intermediate_nodes varchar [note: 'Comma-separated list or description of intermediate processing equipment, routers, switches, or nodes that the signal traverses between source and destination. | Column intermediate_nodes (STRING) in technology.signal_path']
  last_failure_timestamp timestamp [note: 'Timestamp of the most recent failure or outage event recorded for this signal path, used for reliability analysis and maintenance planning. | Column last_failure_timestamp (TIMESTAMP) in technology.signal_path']
  last_health_check_timestamp timestamp [note: 'Timestamp of the most recent automated health check or diagnostic test performed on this signal path to verify operational integrity. | Column last_health_check_timestamp (TIMESTAMP) in technology.signal_path']
  last_modified_timestamp timestamp [note: 'Timestamp when this signal path record was most recently updated or modified, used for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in technology.signal_path']
  latency_ms decimal(10,2) [note: 'Measured or target end-to-end latency for signal transmission through this path, expressed in milliseconds. Important for live broadcast synchronization and quality of service. | Column latency_ms (DECIMAL(10,2)) in technology.signal_path']
  maintenance_schedule varchar [note: 'Description or reference to the planned maintenance schedule for this signal path, including frequency and maintenance windows. | Column maintenance_schedule (STRING) in technology.signal_path']
  monitoring_enabled boolean [note: 'Boolean flag indicating whether active monitoring and alerting are enabled for this signal path in the Network Operations Center (NOC) systems. | Column monitoring_enabled (BOOLEAN) in technology.signal_path']
  notes varchar [note: 'Free-text field for operational notes, special instructions, configuration details, or historical context relevant to this signal path. | Column notes (STRING) in technology.signal_path']
  operational_status varchar [note: 'Current operational state of the signal path indicating whether it is actively routing signals, on standby, under maintenance, failed, or in testing mode. | Column operational_status (STRING) in technology.signal_path']
  owner_department varchar [note: 'Business department or operational unit responsible for managing and maintaining this signal path, such as Network Operations, Engineering, or Transmission. | Column owner_department (STRING) in technology.signal_path']
  path_code varchar [note: 'Unique business identifier or code used to reference this signal path in operational systems, scheduling, and technical documentation. | Column path_code (STRING) in technology.signal_path']
  path_name varchar [note: 'Human-readable name or label assigned to this signal routing path for operational identification and reference. | Column path_name (STRING) in technology.signal_path']
  path_type varchar [note: 'Classification of the signal path based on its operational purpose: contribution (incoming feeds), distribution (outgoing delivery), interstitial (internal routing), backhaul (remote site return), studio-to-transmitter link, or satellite uplink. | Column path_type (STRING) in technology.signal_path']
  primary_path_indicator boolean [note: 'Boolean flag indicating whether this signal path is designated as the primary (true) or backup/secondary (false) path in a redundant configuration. | Column primary_path_indicator (BOOLEAN) in technology.signal_path']
  priority_level varchar [note: 'Business priority classification for this signal path indicating its importance for operations and resource allocation during network congestion or failover scenarios. | Column priority_level (STRING) in technology.signal_path']
  redundancy_configuration varchar [note: 'Redundancy strategy configured for this signal path to ensure continuity: none (single path), primary/backup (failover), active-active (load balanced), N+1 (shared backup), or dual-path (simultaneous routing). | Column redundancy_configuration (STRING) in technology.signal_path']
  service_level_agreement varchar [note: 'Reference to the service level agreement tier or identifier governing uptime, performance, and support commitments for this signal path. | Column service_level_agreement (STRING) in technology.signal_path']
  signal_format varchar [note: 'Technical format specification of the signal carried on this path, such as HD-SDI 1080i, 4K UHD, MPEG-2 TS, H.264, H.265/HEVC, or audio format specifications. | Column signal_format (STRING) in technology.signal_path']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.signal_path']
  source_endpoint varchar [note: 'Identifier or address of the originating endpoint where the signal enters this path. May be an ingest port, satellite receiver, remote contribution feed, or studio source. | Column source_endpoint (STRING) in technology.signal_path']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.signal_path']
  technical_contact varchar [note: 'Name or identifier of the technical contact person or team responsible for troubleshooting and maintenance of this signal path. | Column technical_contact (STRING) in technology.signal_path']
  transport_protocol varchar [note: 'Technical protocol used for signal transport over this path. Common protocols include ASI (Asynchronous Serial Interface), IP/UDP, SRT (Secure Reliable Transport), RTMP (Real-Time Messaging Protocol), HLS (HTTP Live Streaming), MPEG-DASH (Dynamic Adaptive Streaming over HTTP), RTP, RTSP, NDI, or SDI (Serial Digital Interface). [ENUM-REF-CANDIDATE: ASI|IP_UDP|SRT|RTMP|HLS|MPEG_DASH|RTP|RTSP|NDI|SDI — 10 candidates stripped; promote to reference product] | Column transport_protocol (STRING) in technology.signal_path']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.signal_path']
  uptime_percentage decimal(5,2) [note: 'Calculated uptime percentage for this signal path over a defined measurement period, used for SLA compliance reporting and performance analysis. | Column uptime_percentage (DECIMAL(5,2)) in technology.signal_path']
  vendor_name varchar [note: 'Name of the equipment vendor or service provider supplying the infrastructure or managed services for this signal path. | Column vendor_name (STRING) in technology.signal_path']
  video_resolution varchar [note: 'Video resolution specification for video signals on this path, such as 1920x1080, 3840x2160 (4K), 7680x4320 (8K), or SD resolutions. | Column video_resolution (STRING) in technology.signal_path']

  Note: 'Master record defining the end-to-end logical signal routing path for a broadcast feed or contribution circuit — from ingest source through processing chain to transmission output. Captures path name, path type (contribution, distribution, interstitial), source endpoint, destination endpoint, intermediate processing nodes, transport protocol (ASI, IP/UDP, SRT, RTMP), redundancy configuration (primary/backup), assigned channel, and operational status. Complements distribution.signal_route by owning the technology-layer signal topology. | Unity Catalog table: media_broadcasting_ecm.technology.signal_path'
}

Table technology.maintenance_work_order {
  maintenance_work_order_id varchar [pk, note: 'Unique identifier for the maintenance work order. Primary key for this transactional record of planned or reactive maintenance activities on broadcast infrastructure, transmission equipment, studio facilities, or IT assets. | Column maintenance_work_order_id (BIGINT) in technology.maintenance_work_order']
  broadcast_facility_id varchar [note: 'Reference to the broadcast facility, studio location, transmission site, or Network Operations Center (NOC) where the maintenance work is to be performed. | Column broadcast_facility_id (BIGINT) in technology.maintenance_work_order']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Maintenance affecting licensed facilities requires license reference for regulatory coordination (planned outage notifications, power reduction notices). Real FCC notification workflow for licensed op | Column broadcast_license_id (BIGINT) in compliance.maintenance_work_order']
  follow_up_maintenance_work_order_id varchar [note: 'Self-referencing FK on maintenance_work_order (follow_up_maintenance_work_order_id) | Column follow_up_maintenance_work_order_id (BIGINT) in technology.maintenance_work_order']
  it_asset_id varchar [note: 'Reference to the specific broadcast infrastructure asset, transmission equipment, studio facility component, or IT system that is the subject of this maintenance work order. | Column it_asset_id (BIGINT) in technology.maintenance_work_order']
  maintenance_schedule_id varchar [note: 'Foreign key linking to technology.maintenance_schedule. Business justification: Maintenance work orders can be generated from recurring maintenance schedules (preventive maintenance) or created ad-hoc (reactive maintenance). This FK links scheduled maintenance executions back to  | Column maintenance_schedule_id (BIGINT) in technology.maintenance_work_order']
  partner_id varchar [note: 'Reference to the external vendor, contractor, or service provider assigned to perform the maintenance work. Used when work is outsourced or requires specialized third-party expertise. | Column partner_id (BIGINT) in partner.maintenance_work_order']
  primary_maintenance_employee_id varchar [note: 'Reference to the internal technician or engineer assigned primary responsibility for executing this maintenance work order. May be updated if work is reassigned during execution. | Column primary_maintenance_employee_id (BIGINT) in workforce.maintenance_work_order']
  tertiary_maintenance_approved_by_employee_id varchar [note: 'Reference to the manager, engineer, or operations supervisor who approved this work order for execution. Required when approval_required_flag is true, particularly for emergency work or work requiring broadcast service interruption. | Column tertiary_maintenance_approved_by_employee_id (BIGINT) in workforce.maintenance_work_order']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Maintenance work orders can target transmission equipment specifically (transmitters, encoders, multiplexers). Currently work orders only link to generic it_asset. Adding specific FK for broadcast tra | Column transmission_equipment_id (BIGINT) in technology.maintenance_work_order']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.maintenance_work_order']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.maintenance_work_order']
  actual_end_datetime timestamp [note: 'Actual date and time when maintenance work was completed and asset returned to operational status. Marks the end of the maintenance window and restoration of service availability. | Column actual_end_datetime (TIMESTAMP) in technology.maintenance_work_order']
  actual_start_datetime timestamp [note: 'Actual date and time when maintenance work physically commenced. Used to measure schedule adherence, calculate actual labor duration, and determine precise downtime windows for broadcast operations impact analysis. | Column actual_start_datetime (TIMESTAMP) in technology.maintenance_work_order']
  approval_required_flag boolean [note: 'Indicates whether this work order requires management or engineering approval before work can commence. True for high-cost work, critical system changes, or work requiring broadcast outage coordination. | Column approval_required_flag (BOOLEAN) in technology.maintenance_work_order']
  approval_timestamp timestamp [note: 'Date and time when the work order was formally approved for execution. Used to track approval cycle time and ensure proper authorization controls for maintenance activities. | Column approval_timestamp (TIMESTAMP) in technology.maintenance_work_order']
  completion_notes varchar [note: 'Detailed narrative documentation of work performed, findings, corrective actions taken, parts replaced, test results, and any follow-up recommendations. Serves as permanent maintenance history record for the asset. | Column completion_notes (STRING) in technology.maintenance_work_order']
  corrective_action varchar [note: 'Description of the corrective action taken to resolve the fault and restore asset to operational condition. Includes repair procedures, component replacements, configuration changes, or temporary workarounds implemented. | Column corrective_action (STRING) in technology.maintenance_work_order']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.maintenance_work_order']
  created_timestamp timestamp [note: 'Date and time when the maintenance work order was first created in the system. Represents the initial business event triggering the maintenance request, whether from automated monitoring, operator report, or scheduled maintenance plan. | Column created_timestamp (TIMESTAMP) in technology.maintenance_work_order']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this work order (parts_cost_amount, labor_cost_amount, total_cost_amount). Enables multi-currency maintenance cost tracking for global broadcast operations. | Column currency_code (STRING) in technology.maintenance_work_order']
  downtime_duration_minutes decimal(10,2) [note: 'Total duration in minutes that the asset or facility was unavailable for broadcast operations due to this maintenance activity. Critical metric for Service Level Agreement (SLA) compliance, availability reporting, and operational impact assessment. | Column downtime_duration_minutes (DECIMAL(10,2)) in technology.maintenance_work_order']
  fault_code varchar [note: 'Standardized fault classification code from organizational taxonomy or equipment manufacturer fault code library. Enables categorization, trending analysis, and root cause identification across maintenance events. | Column fault_code (STRING) in technology.maintenance_work_order']
  fault_description varchar [note: 'Detailed narrative description of the fault, issue, or maintenance requirement that triggered this work order. Includes symptoms observed, error codes, alarm messages, or condition assessment findings reported by operators or monitoring systems. | Column fault_description (STRING) in technology.maintenance_work_order']
  labor_cost_amount decimal(15,2) [note: 'Total labor cost for this maintenance work order, including internal technician time and external vendor service charges. Used for maintenance budget management and cost per asset analysis. | Column labor_cost_amount (DECIMAL(15,2)) in technology.maintenance_work_order']
  labor_hours decimal(10,2) [note: 'Total labor hours expended by technicians and engineers on this maintenance work order. Used for cost allocation, resource utilization analysis, and maintenance budget tracking. May include multiple technicians working concurrently. | Column labor_hours (DECIMAL(10,2)) in technology.maintenance_work_order']
  last_modified_timestamp timestamp [note: 'Date and time of the most recent update to any field in this work order record. Used for audit trail and change tracking throughout the work order lifecycle. | Column last_modified_timestamp (TIMESTAMP) in technology.maintenance_work_order']
  maintenance_work_order_status varchar [note: 'Current lifecycle state of the maintenance work order. Tracks progression from initial creation through assignment, execution, completion, and closure. On_hold indicates temporary suspension pending parts, approvals, or external dependencies. [ENUM-REF-CANDIDATE: draft|scheduled|assigned|in_progress|on_hold|completed|cancelled|closed — 8 candidates stripped; promote to reference product] | Column maintenance_work_order_status (STRING) in technology.maintenance_work_order']
  outage_required_flag boolean [note: 'Indicates whether this maintenance work requires taking the asset or facility offline, resulting in broadcast service interruption. True requires coordination with Network Operations Center (NOC) and scheduling during approved maintenance windows. | Column outage_required_flag (BOOLEAN) in technology.maintenance_work_order']
  parts_cost_amount decimal(15,2) [note: 'Total cost of replacement parts, components, and materials consumed during this maintenance activity. Excludes labor costs. Used for maintenance cost analysis, budget tracking, and asset lifecycle costing. | Column parts_cost_amount (DECIMAL(15,2)) in technology.maintenance_work_order']
  preventive_action varchar [note: 'Recommended preventive actions to avoid recurrence of this failure mode. May include changes to maintenance schedules, operating procedures, monitoring thresholds, or design modifications for long-term reliability improvement. | Column preventive_action (STRING) in technology.maintenance_work_order']
  priority varchar [note: 'Business priority level indicating urgency and impact of the maintenance work. Critical indicates immediate broadcast impact or safety risk; high indicates significant operational impact; medium indicates scheduled maintenance with moderate impact; low indicates routine non-urgent work. | Column priority (STRING) in technology.maintenance_work_order']
  root_cause varchar [note: 'Identified root cause of the fault or failure that necessitated this maintenance work. Used for reliability analysis, failure mode trending, and preventive maintenance program optimization to reduce future failures. | Column root_cause (STRING) in technology.maintenance_work_order']
  safety_incident_flag boolean [note: 'Indicates whether a safety incident occurred during execution of this maintenance work order. True triggers mandatory incident investigation, reporting to safety committee, and potential regulatory notification per Occupational Safety and Health Administration (OSHA) requirements. | Column safety_incident_flag (BOOLEAN) in technology.maintenance_work_order']
  scheduled_end_datetime timestamp [note: 'Planned date and time when maintenance work is expected to be completed. Used for resource planning, outage window management, and coordination with broadcast operations to minimize service disruption. | Column scheduled_end_datetime (TIMESTAMP) in technology.maintenance_work_order']
  scheduled_start_datetime timestamp [note: 'Planned date and time when maintenance work is scheduled to begin. For preventive maintenance, aligns with maintenance calendar; for corrective work, represents target response time based on priority and Service Level Agreement (SLA). | Column scheduled_start_datetime (TIMESTAMP) in technology.maintenance_work_order']
  sign_off_timestamp timestamp [note: 'Date and time when the maintenance work order was formally signed off as complete and approved for closure. Represents final quality gate before asset return to service and work order administrative closure. | Column sign_off_timestamp (TIMESTAMP) in technology.maintenance_work_order']
  sla_compliance_flag boolean [note: 'Indicates whether this work order was completed within the defined Service Level Agreement (SLA) target times for response and resolution. False indicates SLA breach requiring management review and potential customer credits or penalties. | Column sla_compliance_flag (BOOLEAN) in technology.maintenance_work_order']
  sla_target_resolution_minutes varchar [note: 'Target resolution time in minutes from work order creation to completion, as defined by Service Level Agreement (SLA) for this priority level and asset class. Critical metric for measuring maintenance effectiveness and meeting operational commitments. | Column sla_target_resolution_minutes (INT) in technology.maintenance_work_order']
  sla_target_response_minutes varchar [note: 'Target response time in minutes from work order creation to actual start of work, as defined by Service Level Agreement (SLA) for this priority level and asset class. Used to measure maintenance team responsiveness and SLA compliance. | Column sla_target_response_minutes (INT) in technology.maintenance_work_order']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.maintenance_work_order']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.maintenance_work_order']
  total_cost_amount decimal(15,2) [note: 'Total cost of this maintenance work order, including parts, labor, vendor charges, and any other direct costs. Primary metric for maintenance expense tracking and asset total cost of ownership analysis. | Column total_cost_amount (DECIMAL(15,2)) in technology.maintenance_work_order']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.maintenance_work_order']
  warranty_claim_flag boolean [note: 'Indicates whether this maintenance work is covered under manufacturer or vendor warranty, enabling cost recovery. True triggers warranty claim process and excludes costs from internal maintenance budget allocation. | Column warranty_claim_flag (BOOLEAN) in technology.maintenance_work_order']
  work_order_number varchar [note: 'Externally visible business identifier for the work order, used for tracking and communication with technicians, vendors, and operations teams. Typically follows format WO-YYYYMMDD or similar organizational standard. | Column work_order_number (STRING) in technology.maintenance_work_order']
  work_order_type varchar [note: 'Classification of the maintenance work order by nature of activity: preventive (scheduled routine maintenance), corrective (repair of known issue), emergency (unplanned critical repair), inspection (compliance or condition assessment), upgrade (enhancement or modernization), decommission (asset retirement). | Column work_order_type (STRING) in technology.maintenance_work_order']

  Note: 'Transactional record of each planned or reactive maintenance work order raised for broadcast infrastructure, transmission equipment, studio facilities, or IT assets. Captures work order number, work order type (preventive, corrective, emergency), priority, affected asset or facility, fault description, assigned technician or vendor, scheduled start/end datetime, actual start/end datetime, downtime duration, parts used, labor hours, completion status, and sign-off. Operational backbone for infrastructure maintenance management. | Unity Catalog table: media_broadcasting_ecm.technology.maintenance_work_order'
}

Table technology.maintenance_schedule {
  maintenance_schedule_id varchar [pk, note: 'Unique identifier for the maintenance schedule record. Primary key for the maintenance schedule entity. | Column maintenance_schedule_id (BIGINT) in technology.maintenance_schedule']
  it_asset_id varchar [note: 'Reference to a specific broadcast equipment or facility asset when the schedule is asset-specific rather than class-based. Links to the asset master record. | Column it_asset_id (BIGINT) in technology.maintenance_schedule']
  parent_maintenance_schedule_id varchar [note: 'Self-referencing FK on maintenance_schedule (parent_maintenance_schedule_id) | Column parent_maintenance_schedule_id (BIGINT) in technology.maintenance_schedule']
  primary_maintenance_employee_id varchar [note: 'Reference to the staff member or engineer who owns or is accountable for this maintenance schedule. Links to employee or staff master record. | Column primary_maintenance_employee_id (BIGINT) in workforce.maintenance_schedule']
  tertiary_maintenance_last_modified_by_user_employee_id varchar [note: 'Identifier of the user or system account that last modified this maintenance schedule record. Used for audit trail and accountability. | Column tertiary_maintenance_last_modified_by_user_employee_id (BIGINT) in workforce.maintenance_schedule']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Preventive maintenance schedules for transmission equipment (transmitters, encoders). Currently maintenance_schedule only links to it_asset via \'specific_asset_id\'. Adding specific FK for transmission | Column transmission_equipment_id (BIGINT) in technology.maintenance_schedule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.maintenance_schedule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.maintenance_schedule']
  asset_class varchar [note: 'Category of broadcast equipment or facility this schedule applies to (e.g., \'Transmitter\', \'Studio Camera\', \'Playout Server\', \'HVAC System\', \'UPS\', \'Antenna System\'). Used when schedule applies to a class of assets rather than a specific asset. | Column asset_class (STRING) in technology.maintenance_schedule']
  compliance_standard_reference varchar [note: 'Reference to regulatory or industry standard that mandates or guides this maintenance activity (e.g., \'FCC 47 CFR Part 73.1350\', \'ATSC A/53\', \'Manufacturer SLA\', \'OSHA 1910.147\'). | Column compliance_standard_reference (STRING) in technology.maintenance_schedule']
  cost_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the estimated cost (e.g., \'USD\', \'GBP\', \'EUR\'). | Column cost_currency_code (STRING) in technology.maintenance_schedule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.maintenance_schedule']
  created_timestamp timestamp [note: 'Date and time when this maintenance schedule record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in technology.maintenance_schedule']
  downtime_required_flag boolean [note: 'Indicates whether the maintenance activity requires taking the equipment or system offline (True) or can be performed while operational (False). Critical for broadcast continuity planning. | Column downtime_required_flag (BOOLEAN) in technology.maintenance_schedule']
  effective_end_date date [note: 'Date when this maintenance schedule expires or is no longer applicable. Null for open-ended schedules. | Column effective_end_date (DATE) in technology.maintenance_schedule']
  effective_start_date date [note: 'Date when this maintenance schedule becomes active and begins generating maintenance work orders. | Column effective_start_date (DATE) in technology.maintenance_schedule']
  estimated_cost decimal(12,2) [note: 'Estimated cost in local currency for performing the maintenance activity, including labor, parts, and vendor fees. Used for budget planning and cost tracking. | Column estimated_cost (DECIMAL(12,2)) in technology.maintenance_schedule']
  estimated_downtime_hours decimal(6,2) [note: 'Expected duration in hours that the equipment or system will be offline during maintenance. Used for broadcast scheduling and redundancy planning. | Column estimated_downtime_hours (DECIMAL(6,2)) in technology.maintenance_schedule']
  estimated_duration_hours decimal(6,2) [note: 'Expected time in hours required to complete the maintenance activity, used for resource planning and scheduling. | Column estimated_duration_hours (DECIMAL(6,2)) in technology.maintenance_schedule']
  last_modified_timestamp timestamp [note: 'Date and time when this maintenance schedule record was most recently updated. Used for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in technology.maintenance_schedule']
  last_performed_date date [note: 'Date when the maintenance activity was most recently completed. Used to calculate next due date and track maintenance history. | Column last_performed_date (DATE) in technology.maintenance_schedule']
  maintenance_procedure_reference varchar [note: 'Reference to detailed maintenance procedure document, work instruction, or manufacturer service manual that guides the execution of the maintenance activity. | Column maintenance_procedure_reference (STRING) in technology.maintenance_schedule']
  maintenance_schedule_status varchar [note: 'Current lifecycle status of the maintenance schedule: active (in use), inactive (temporarily disabled), suspended (on hold), under_review (being evaluated), or retired (no longer applicable). | Column maintenance_schedule_status (STRING) in technology.maintenance_schedule']
  maintenance_type varchar [note: 'Classification of the maintenance activity: preventive (scheduled routine), corrective (repair), predictive (data-driven), condition-based (triggered by monitoring), emergency (unplanned critical), or regulatory (compliance-driven). | Column maintenance_type (STRING) in technology.maintenance_schedule']
  next_due_date date [note: 'Calculated or scheduled date when the next maintenance activity is due. Critical for proactive maintenance planning and compliance tracking. | Column next_due_date (DATE) in technology.maintenance_schedule']
  notes varchar [note: 'Additional notes, special instructions, or contextual information about the maintenance schedule that does not fit in other structured fields. | Column notes (STRING) in technology.maintenance_schedule']
  notification_lead_time_days varchar [note: 'Number of days in advance that stakeholders (operations, engineering, management) should be notified before the scheduled maintenance activity. | Column notification_lead_time_days (INT) in technology.maintenance_schedule']
  parts_required_description varchar [note: 'Description of spare parts, consumables, or materials required for the maintenance activity (e.g., \'Transmitter tubes\', \'Air filters\', \'Cooling fluid\', \'Backup batteries\'). | Column parts_required_description (STRING) in technology.maintenance_schedule']
  preferred_maintenance_window varchar [note: 'Preferred time window for performing maintenance to minimize broadcast impact (e.g., \'Overnight 2AM-6AM\', \'Weekend\', \'Off-peak hours\'). Aligns with broadcast schedule and audience patterns. | Column preferred_maintenance_window (STRING) in technology.maintenance_schedule']
  priority_level varchar [note: 'Business priority of the maintenance schedule: critical (broadcast-critical equipment), high (significant impact), medium (standard preventive), or low (non-essential). | Column priority_level (STRING) in technology.maintenance_schedule']
  recurrence_interval varchar [note: 'Numeric interval for the recurrence pattern (e.g., \'2\' for every 2 weeks, \'3\' for every 3 months). Used in conjunction with recurrence_pattern for flexible scheduling. | Column recurrence_interval (INT) in technology.maintenance_schedule']
  recurrence_pattern varchar [note: 'Frequency at which the maintenance activity repeats: daily, weekly, biweekly, monthly, quarterly, semiannual (twice yearly), annual, or biennial (every two years). [ENUM-REF-CANDIDATE: daily|weekly|biweekly|monthly|quarterly|semiannual|annual|biennial — 8 candidates stripped; promote to reference product] | Column recurrence_pattern (STRING) in technology.maintenance_schedule']
  regulatory_requirement_flag boolean [note: 'Indicates whether this maintenance schedule is mandated by regulatory requirements (True) or is voluntary/best-practice (False). Critical for compliance prioritization. | Column regulatory_requirement_flag (BOOLEAN) in technology.maintenance_schedule']
  required_crew_size varchar [note: 'Number of technicians or engineers required to perform the maintenance activity safely and efficiently. | Column required_crew_size (INT) in technology.maintenance_schedule']
  required_skill_set varchar [note: 'Technical skills, certifications, or qualifications required to perform the maintenance (e.g., \'FCC General Radiotelephone Operator License\', \'Broadcast Engineer\', \'HVAC Technician\', \'RF Specialist\'). | Column required_skill_set (STRING) in technology.maintenance_schedule']
  responsible_department varchar [note: 'Department or organizational unit responsible for executing or overseeing the maintenance activity (e.g., \'Broadcast Engineering\', \'Transmission Operations\', \'Facilities Management\'). | Column responsible_department (STRING) in technology.maintenance_schedule']
  safety_requirements varchar [note: 'Safety protocols, personal protective equipment (PPE), or special precautions required for the maintenance activity (e.g., \'High voltage lockout/tagout\', \'RF exposure limits\', \'Confined space entry\'). | Column safety_requirements (STRING) in technology.maintenance_schedule']
  schedule_code varchar [note: 'Unique business identifier or code for the maintenance schedule used for external reference and reporting. | Column schedule_code (STRING) in technology.maintenance_schedule']
  schedule_name varchar [note: 'Human-readable name or title of the maintenance schedule (e.g., \'Quarterly Transmitter Inspection\', \'Annual Studio HVAC Service\'). | Column schedule_name (STRING) in technology.maintenance_schedule']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.maintenance_schedule']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.maintenance_schedule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.maintenance_schedule']
  vendor_service_provider varchar [note: 'Name of external vendor or service provider responsible for performing the maintenance, if not performed by internal staff (e.g., equipment manufacturer, specialized contractor). | Column vendor_service_provider (STRING) in technology.maintenance_schedule']

  Note: 'Master record defining the recurring preventive maintenance schedule for broadcast equipment, transmission systems, and studio facilities. Captures schedule name, maintenance type, target asset class or specific asset, recurrence pattern (daily, weekly, monthly, annual), estimated duration, required skill set, last performed date, next due date, compliance standard reference (e.g., FCC technical rules, manufacturer SLA), and active status. Drives proactive maintenance planning and regulatory compliance for broadcast technical standards. | Unity Catalog table: media_broadcasting_ecm.technology.maintenance_schedule'
}

Table technology.outage_record {
  outage_record_id varchar [pk, note: 'Unique identifier for the outage record. Primary key. | Column outage_record_id (BIGINT) in technology.outage_record']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Outages occur at specific broadcast facilities. This FK links the outage event to the affected facility for geographic impact analysis and facility-level SLA tracking. No columns removed - affected_ge | Column broadcast_facility_id (BIGINT) in technology.outage_record']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: Outages triggering regulatory incidents (EAS failure, extended caption outage, license violation) require compliance incident tracking. Real NOC-to-compliance escalation workflow for FCC reportable ev | Column compliance_incident_id (BIGINT) in compliance.outage_record']
  parent_outage_record_id varchar [note: 'Self-referencing FK on outage_record (related_outage_record_id) | Column related_outage_record_id (BIGINT) in technology.outage_record']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: outage_record.equipment_identifier (STRING) should be normalized to FK to transmission_equipment. Outages are often caused by specific equipment failures. This links the outage event to the failed equ | Column transmission_equipment_id (BIGINT) in technology.outage_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.outage_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.outage_record']
  affected_geographic_region varchar [note: 'Geographic area or market impacted by the outage, such as specific DMA (Designated Market Area), country, or global scope. | Column affected_geographic_region (STRING) in technology.outage_record']
  affected_service_name varchar [note: 'Specific name or identifier of the service, channel, stream, facility, or circuit affected by the outage. | Column affected_service_name (STRING) in technology.outage_record']
  affected_service_type varchar [note: 'Category of broadcast or IT service impacted by the outage: linear channel, OTT (Over-The-Top) stream, VOD (Video On Demand) platform, CDN (Content Delivery Network), playout system, uplink transmission, facility infrastructure, or network circuit. [ENUM-REF-CANDIDATE: linear_channel|ott_stream|vod_platform|cdn|playout|uplink|facility|network_circuit — 8 candidates stripped; promote to reference product] | Column affected_service_type (STRING) in technology.outage_record']
  affected_viewer_count_estimate varchar [note: 'Estimated number of subscribers or viewers impacted by the outage, based on service reach and time of day. | Column affected_viewer_count_estimate (BIGINT) in technology.outage_record']
  assigned_to_engineer varchar [note: 'Name or identifier of the engineer or technician assigned as primary owner for resolving the outage. | Column assigned_to_engineer (STRING) in technology.outage_record']
  assigned_to_team varchar [note: 'Name of the technical team or department responsible for investigating and resolving the outage (e.g., NOC, Engineering, Transmission, IT Operations). | Column assigned_to_team (STRING) in technology.outage_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.outage_record']
  created_timestamp timestamp [note: 'Date and time when this outage record was first created in the system. | Column created_timestamp (TIMESTAMP) in technology.outage_record']
  detected_by varchar [note: 'Source that first detected the outage: automated monitoring system, NOC (Network Operations Center) operator, customer complaint, or third-party notification. | Column detected_by (STRING) in technology.outage_record']
  detection_timestamp timestamp [note: 'Date and time when the outage was first detected by monitoring systems or personnel, which may differ from the actual outage start time. | Column detection_timestamp (TIMESTAMP) in technology.outage_record']
  escalation_level varchar [note: 'Current escalation tier in the incident management hierarchy, indicating the seniority of resources engaged to resolve the outage. | Column escalation_level (STRING) in technology.outage_record']
  estimated_revenue_impact_amount decimal(15,2) [note: 'Estimated financial impact of the outage in terms of lost advertising revenue, subscription credits, or contractual penalties. | Column estimated_revenue_impact_amount (DECIMAL(15,2)) in technology.outage_record']
  impact_severity varchar [note: 'Business impact severity level of the outage based on service criticality, audience reach, and revenue implications. | Column impact_severity (STRING) in technology.outage_record']
  last_modified_timestamp timestamp [note: 'Date and time when this outage record was last updated with new information or status changes. | Column last_modified_timestamp (TIMESTAMP) in technology.outage_record']
  notes varchar [note: 'Free-form text field for additional comments, observations, or context related to the outage event that do not fit structured fields. | Column notes (STRING) in technology.outage_record']
  notification_sent_flag boolean [note: 'Indicator of whether customer or stakeholder notifications were sent regarding the outage event. | Column notification_sent_flag (BOOLEAN) in technology.outage_record']
  notification_timestamp timestamp [note: 'Date and time when customer or stakeholder notifications were sent regarding the outage. | Column notification_timestamp (TIMESTAMP) in technology.outage_record']
  outage_duration_minutes decimal(10,2) [note: 'Total duration of the outage event measured in minutes, calculated from start to end timestamp. | Column outage_duration_minutes (DECIMAL(10,2)) in technology.outage_record']
  outage_end_timestamp timestamp [note: 'Date and time when the outage event ended and service was restored. Null if outage is still ongoing. | Column outage_end_timestamp (TIMESTAMP) in technology.outage_record']
  outage_reference_number varchar [note: 'Externally-known unique reference number for the outage event, used for tracking and communication with stakeholders. | Column outage_reference_number (STRING) in technology.outage_record']
  outage_start_timestamp timestamp [note: 'Date and time when the outage event began, marking the start of service disruption or planned maintenance window. | Column outage_start_timestamp (TIMESTAMP) in technology.outage_record']
  outage_status varchar [note: 'Current lifecycle status of the outage event in the incident management workflow. | Column outage_status (STRING) in technology.outage_record']
  outage_type varchar [note: 'Classification of the outage event: planned maintenance window, unplanned service disruption, or emergency intervention. | Column outage_type (STRING) in technology.outage_record']
  post_incident_review_status varchar [note: 'Status of the post-incident review process to analyze root cause, document lessons learned, and implement preventive measures. | Column post_incident_review_status (STRING) in technology.outage_record']
  regulatory_report_submission_date date [note: 'Date when the outage incident report was submitted to the regulatory authority, if required. | Column regulatory_report_submission_date (DATE) in technology.outage_record']
  regulatory_reporting_required_flag boolean [note: 'Indicator of whether the outage event must be reported to regulatory authorities such as FCC (Federal Communications Commission) or Ofcom due to severity, duration, or public safety implications. | Column regulatory_reporting_required_flag (BOOLEAN) in technology.outage_record']
  resolution_action varchar [note: 'Description of the corrective action taken to resolve the outage and restore service, including technical steps and workarounds applied. | Column resolution_action (STRING) in technology.outage_record']
  revenue_impact_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the estimated revenue impact amount. | Column revenue_impact_currency_code (STRING) in technology.outage_record']
  root_cause_category varchar [note: 'High-level classification of the underlying cause of the outage: hardware failure, software defect, network connectivity issue, power supply failure, human operational error, or third-party service disruption. | Column root_cause_category (STRING) in technology.outage_record']
  root_cause_description varchar [note: 'Detailed narrative explanation of the root cause identified during post-incident analysis, including technical details and contributing factors. | Column root_cause_description (STRING) in technology.outage_record']
  sla_breach_flag boolean [note: 'Indicator of whether the outage duration or frequency violated contractual SLA (Service Level Agreement) commitments for uptime or availability. | Column sla_breach_flag (BOOLEAN) in technology.outage_record']
  sla_target_uptime_percentage decimal(5,2) [note: 'Contractual target uptime percentage defined in the SLA (Service Level Agreement) for the affected service, typically expressed as a percentage (e.g., 99.95%). | Column sla_target_uptime_percentage (DECIMAL(5,2)) in technology.outage_record']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.outage_record']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.outage_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.outage_record']
  vendor_name varchar [note: 'Name of the third-party vendor or service provider responsible for the equipment, software, or service that experienced the outage, if applicable. | Column vendor_name (STRING) in technology.outage_record']
  vendor_ticket_number varchar [note: 'External ticket or case number assigned by the third-party vendor for tracking their investigation and resolution efforts. | Column vendor_ticket_number (STRING) in technology.outage_record']

  Note: 'Transactional record capturing each broadcast or IT service outage event — planned maintenance windows, unplanned signal loss, equipment failures, and network disruptions. Captures outage reference number, outage type (planned, unplanned), affected service (channel, stream, facility, circuit), outage start timestamp, outage end timestamp, total duration (minutes), root cause category, root cause description, impact severity, affected subscriber or viewer count estimate, resolution action, and post-incident review status. Feeds SLA compliance tracking and regulatory reporting. | Unity Catalog table: media_broadcasting_ecm.technology.outage_record'
}

Table technology.capacity_plan {
  capacity_plan_id varchar [pk, note: 'Unique identifier for the infrastructure capacity planning assessment record. Primary key for the capacity plan entity. | Column capacity_plan_id (BIGINT) in technology.capacity_plan']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Capacity plans are facility-specific (transmission bandwidth, storage, cooling capacity). The \'infrastructure_domain\' field suggests facility-level planning. Adding FK to link capacity assessments to  | Column broadcast_facility_id (BIGINT) in technology.capacity_plan']
  revised_capacity_plan_id varchar [note: 'Self-referencing FK on capacity_plan (revised_capacity_plan_id) | Column revised_capacity_plan_id (BIGINT) in technology.capacity_plan']
  tech_project_id varchar [note: 'Foreign key linking to technology.tech_project. Business justification: Capacity plans drive technology projects when capacity thresholds are breached. The \'recommended_action\', \'implementation_start_date\', and \'implementation_completion_date\' fields suggest a project is  | Column tech_project_id (BIGINT) in technology.capacity_plan']
  vendor_contract_id varchar [note: 'Foreign key linking to technology.vendor_contract. Business justification: Capacity expansion often involves vendor contracts for equipment or services. The \'vendor_name\' field should be normalized by linking to vendor_contract. Removes redundant vendor_name string in favor  | Column vendor_contract_id (BIGINT) in technology.capacity_plan']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.capacity_plan']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.capacity_plan']
  approval_date date [note: 'The date when the capacity plan received final approval from the authorized decision-making body (e.g., IT Steering Committee, CFO, CTO). Null if not yet approved. | Column approval_date (DATE) in technology.capacity_plan']
  approval_status varchar [note: 'Current approval workflow status of the capacity plan. Draft: initial preparation; Submitted: sent for review; Under_review: being evaluated by stakeholders; Approved: authorized for implementation; Rejected: not approved; On_hold: approval process paused; Implemented: plan executed and capacity changes deployed. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|on_hold|implemented — 7 candidates stripped; promote to reference product] | Column approval_status (STRING) in technology.capacity_plan']
  approved_by varchar [note: 'Name or identifier of the executive or committee that approved the capacity plan. Typically CTO, VP of Engineering, IT Steering Committee, or CFO for high-value capital investments. | Column approved_by (STRING) in technology.capacity_plan']
  business_justification varchar [note: 'Detailed narrative explaining the business drivers and strategic rationale for the capacity plan, including references to content production roadmaps, distribution expansion plans, audience growth forecasts, new platform launches (OTT, FAST channels), technology migrations (SD to HD to 4K), or regulatory requirements. | Column business_justification (STRING) in technology.capacity_plan']
  capacity_threshold_percentage decimal(5,2) [note: 'The utilization percentage threshold that triggers capacity expansion or optimization actions. Typically set based on Service Level Agreement (SLA) requirements and operational best practices (e.g., 80% for storage, 70% for network to maintain performance headroom). | Column capacity_threshold_percentage (DECIMAL(5,2)) in technology.capacity_plan']
  capacity_unit varchar [note: 'The unit of measurement for capacity and utilization values. TB/PB for storage (terabytes/petabytes), Gbps/Mbps for network bandwidth, cores/vCPU for compute, studio_hours for production facility time, channels for playout capacity, streams for concurrent delivery capacity, transcode_hours for encoding capacity. [ENUM-REF-CANDIDATE: tb|pb|gbps|mbps|cores|vcpu|studio_hours|channels|streams|transcode_hours — 10 candidates stripped; promote to reference product] | Column capacity_unit (STRING) in technology.capacity_plan']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.capacity_plan']
  created_timestamp timestamp [note: 'The date and time when this capacity plan record was first created in the system. Used for audit trail and record lifecycle tracking. | Column created_timestamp (TIMESTAMP) in technology.capacity_plan']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this capacity plan (e.g., USD, GBP, EUR). | Column currency_code (STRING) in technology.capacity_plan']
  current_capacity_value decimal(18,2) [note: 'The current total capacity available in the infrastructure domain, expressed in the unit specified by capacity_unit (e.g., terabytes for storage, gigabits per second for network, compute cores for processing). | Column current_capacity_value (DECIMAL(18,2)) in technology.capacity_plan']
  current_utilization_percentage decimal(5,2) [note: 'The current utilization expressed as a percentage of total available capacity (current_utilization_value / current_capacity_value * 100). Key metric for determining proximity to capacity thresholds. | Column current_utilization_percentage (DECIMAL(5,2)) in technology.capacity_plan']
  current_utilization_value decimal(18,2) [note: 'The current amount of capacity being consumed or utilized, expressed in the same unit as current_capacity_value. | Column current_utilization_value (DECIMAL(18,2)) in technology.capacity_plan']
  data_classification varchar [note: 'The sensitivity classification of this capacity plan document. Public: shareable externally; Internal: for employee access only; Confidential: restricted to authorized personnel; Restricted: highly sensitive, executive access only. | Column data_classification (STRING) in technology.capacity_plan']
  estimated_capex_amount decimal(15,2) [note: 'The estimated capital expenditure required to implement the recommended action, including hardware, software, installation, and integration costs. Critical for budget planning and investment approval processes. | Column estimated_capex_amount (DECIMAL(15,2)) in technology.capacity_plan']
  estimated_opex_annual_amount decimal(15,2) [note: 'The estimated annual operating expenditure impact of the recommended action, including maintenance, support, power, cooling, and licensing costs. Used for total cost of ownership (TCO) analysis. | Column estimated_opex_annual_amount (DECIMAL(15,2)) in technology.capacity_plan']
  implementation_completion_date date [note: 'The planned or actual date when implementation of the capacity plan was completed and new capacity became operational. | Column implementation_completion_date (DATE) in technology.capacity_plan']
  implementation_priority varchar [note: 'The urgency level for implementing the capacity plan. Critical: immediate action required to prevent service disruption; High: needed within current quarter; Medium: planned for next quarter; Low: long-term strategic initiative. | Column implementation_priority (STRING) in technology.capacity_plan']
  implementation_start_date date [note: 'The planned or actual date when implementation of the capacity plan began. Used for project tracking and timeline management. | Column implementation_start_date (DATE) in technology.capacity_plan']
  infrastructure_domain varchar [note: 'The category of broadcast infrastructure being assessed in this capacity plan. Network covers transmission bandwidth and connectivity; Storage covers Media Asset Management (MAM) and archive systems; Compute covers processing and rendering resources; Studio covers production facilities and equipment; Transmission covers broadcast towers and signal distribution; CDN covers Content Delivery Network edge caching; Playout covers channel automation systems; Encoding covers transcoding and ABR (Adaptive Bitrate Streaming) infrastructure. [ENUM-REF-CANDIDATE: network|storage|compute|studio|transmission|cdn|mam|playout|encoding — 9 candidates stripped; promote to reference product] | Column infrastructure_domain (STRING) in technology.capacity_plan']
  last_modified_timestamp timestamp [note: 'The date and time when this capacity plan record was most recently updated. Used for change tracking and version control. | Column last_modified_timestamp (TIMESTAMP) in technology.capacity_plan']
  last_reviewed_date date [note: 'The date when this capacity plan was last reviewed and validated by the plan owner or governance committee. Used to ensure plans remain current and aligned with business needs. | Column last_reviewed_date (DATE) in technology.capacity_plan']
  next_review_date date [note: 'The scheduled date for the next formal review of this capacity plan. Ensures periodic reassessment of assumptions, growth rates, and recommendations. | Column next_review_date (DATE) in technology.capacity_plan']
  plan_code varchar [note: 'Short alphanumeric code or identifier used for referencing the capacity plan in reports, dashboards, and cross-system communications. | Column plan_code (STRING) in technology.capacity_plan']
  plan_name varchar [note: 'Business-friendly name or title assigned to this capacity planning assessment, typically indicating the scope or focus area (e.g., \'Q1 2024 CDN Expansion Plan\', \'2024 Studio Storage Assessment\'). | Column plan_name (STRING) in technology.capacity_plan']
  plan_owner varchar [note: 'Name or identifier of the individual responsible for developing, maintaining, and executing this capacity plan. Typically an Infrastructure Manager, Network Operations Center (NOC) Manager, or Engineering Director. | Column plan_owner (STRING) in technology.capacity_plan']
  plan_owner_department varchar [note: 'The organizational department or division responsible for this capacity plan (e.g., Network Operations, Broadcast Engineering, IT Infrastructure, Media Technology, Studio Operations). | Column plan_owner_department (STRING) in technology.capacity_plan']
  planning_end_date date [note: 'The last day of the planning period covered by this capacity assessment. Defines the planning horizon endpoint. | Column planning_end_date (DATE) in technology.capacity_plan']
  planning_period_type varchar [note: 'The time horizon granularity for this capacity planning cycle (quarterly, half-yearly, annual, biennial, or multi-year strategic planning). | Column planning_period_type (STRING) in technology.capacity_plan']
  planning_start_date date [note: 'The first day of the planning period covered by this capacity assessment. Used to define the temporal scope of the plan. | Column planning_start_date (DATE) in technology.capacity_plan']
  projected_demand_value decimal(18,2) [note: 'The forecasted capacity demand at the end of the planning period, calculated by applying the projected growth rate to current utilization. Expressed in the same unit as capacity_unit. | Column projected_demand_value (DECIMAL(18,2)) in technology.capacity_plan']
  projected_growth_rate_percentage decimal(5,2) [note: 'The anticipated percentage increase in demand or utilization over the planning period, based on historical trends, content production forecasts, audience growth projections, and strategic initiatives (e.g., new channel launches, OTT expansion, 4K/8K content migration). | Column projected_growth_rate_percentage (DECIMAL(5,2)) in technology.capacity_plan']
  recommended_action varchar [note: 'The strategic recommendation for addressing capacity needs. Expand: add new infrastructure capacity; Optimize: improve efficiency of existing resources; Consolidate: merge underutilized resources; Decommission: retire obsolete infrastructure; Monitor: continue observation without immediate action; Migrate: move workloads to alternative infrastructure (e.g., cloud, CDN). | Column recommended_action (STRING) in technology.capacity_plan']
  recommended_capacity_addition decimal(18,2) [note: 'The amount of additional capacity recommended to be added, expressed in the same unit as capacity_unit. Null if the recommended action does not involve expansion. | Column recommended_capacity_addition (DECIMAL(18,2)) in technology.capacity_plan']
  risk_assessment varchar [note: 'Analysis of risks associated with the capacity plan, including risks of inaction (service degradation, SLA breaches, revenue loss), implementation risks (vendor delays, integration complexity, budget overruns), and operational risks (technology obsolescence, demand forecast accuracy). | Column risk_assessment (STRING) in technology.capacity_plan']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.capacity_plan']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.capacity_plan']
  technology_platform varchar [note: 'The specific technology platform or product being planned for capacity expansion (e.g., \'Dalet Galaxy MAM\', \'Akamai CDN\', \'Ericsson MediaFirst Playout\', \'AWS EC2\', \'NetApp FAS Storage\'). | Column technology_platform (STRING) in technology.capacity_plan']
  threshold_breach_date date [note: 'The projected date when utilization is forecasted to exceed the capacity threshold, requiring intervention. Calculated based on current utilization, growth rate, and threshold percentage. Null if no breach is anticipated within the planning period. | Column threshold_breach_date (DATE) in technology.capacity_plan']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.capacity_plan']

  Note: 'Master record for infrastructure capacity planning assessments covering transmission bandwidth, storage, compute, and studio utilization. Captures plan name, planning period (quarter/year), infrastructure domain (network, storage, compute, studio), current utilization percentage, projected growth rate, capacity threshold, recommended action (expand, optimize, decommission), estimated capex, approval status, and plan owner. Enables proactive infrastructure investment decisions aligned to content production and distribution growth. | Unity Catalog table: media_broadcasting_ecm.technology.capacity_plan'
}

Table technology.vendor_contract {
  vendor_contract_id varchar [pk, note: 'Unique identifier for the vendor contract record. Primary key for technology vendor and service provider agreements. | Column vendor_contract_id (BIGINT) in technology.vendor_contract']
  owner_employee_id varchar [note: 'FK to workforce.employee | Column owner_employee_id (BIGINT) in workforce.vendor_contract']
  partner_id varchar [note: 'Reference to the technology vendor or service provider organization supplying equipment, software, or managed services under this contract. | Column partner_id (BIGINT) in partner.vendor_contract']
  primary_vendor_employee_id varchar [note: 'Reference to the employee responsible for managing this vendor contract, monitoring performance, and coordinating renewals. Typically a technology manager or procurement specialist. | Column primary_vendor_employee_id (BIGINT) in workforce.vendor_contract']
  renewed_vendor_contract_id varchar [note: 'Self-referencing FK on vendor_contract (renewed_vendor_contract_id) | Column renewed_vendor_contract_id (BIGINT) in technology.vendor_contract']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.vendor_contract']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.vendor_contract']
  annual_value decimal(15,2) [note: 'Total annual financial commitment for the vendor contract in USD, including recurring fees, maintenance charges, and subscription costs. Used for budget planning and vendor spend analysis. | Column annual_value (DECIMAL(15,2)) in technology.vendor_contract']
  auto_renewal_flag boolean [note: 'Indicates whether the contract automatically renews for an additional term unless cancelled. True if auto-renewal clause is active, False if manual renewal required. | Column auto_renewal_flag (BOOLEAN) in technology.vendor_contract']
  compliance_requirements varchar [note: 'Regulatory, security, or industry standards the vendor must comply with (e.g., SOC 2, ISO 27001, FCC equipment certification, GDPR data processing terms). | Column compliance_requirements (STRING) in technology.vendor_contract']
  contract_document_url varchar [note: 'URL or file path to the signed contract document stored in document management system or secure file repository. | Column contract_document_url (STRING) in technology.vendor_contract']
  contract_number varchar [note: 'Externally-known unique contract reference number assigned by procurement or vendor management system. Used for vendor correspondence and invoice reconciliation. | Column contract_number (STRING) in technology.vendor_contract']
  contract_status varchar [note: 'Current lifecycle state of the vendor contract: draft (under negotiation), active (in force), suspended (temporarily paused), expired (end date reached), terminated (cancelled before expiry), renewed (extended for additional term). | Column contract_status (STRING) in technology.vendor_contract']
  contract_type varchar [note: 'Classification of the vendor contract by service delivery model: maintenance (equipment upkeep), SLA (Service Level Agreement for performance guarantees), license (software entitlements), managed_service (outsourced operations), support (technical assistance), cloud_service (hosted infrastructure), professional_services (consulting and implementation). [ENUM-REF-CANDIDATE: maintenance|sla|license|managed_service|support|cloud_service|professional_services — 7 candidates stripped; promote to reference product] | Column contract_type (STRING) in technology.vendor_contract']
  covered_assets varchar [note: 'Textual description of broadcast infrastructure equipment, IT systems, or services covered under this contract (e.g., transmission towers, studio cameras, network switches, CDN services, MAM software licenses). | Column covered_assets (STRING) in technology.vendor_contract']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.vendor_contract']
  created_timestamp timestamp [note: 'Date and time when this vendor contract record was first created in the system. Audit trail for data lineage. | Column created_timestamp (TIMESTAMP) in technology.vendor_contract']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for contract financial terms (e.g., USD, EUR, GBP). | Column currency_code (STRING) in technology.vendor_contract']
  end_date date [note: 'Date when the vendor contract expires or terminates. Null for open-ended agreements. | Column end_date (DATE) in technology.vendor_contract']
  escalation_rate_percent decimal(5,2) [note: 'Annual percentage increase in contract value for multi-year agreements. Used for budget forecasting and cost modeling. Null if fixed pricing. | Column escalation_rate_percent (DECIMAL(5,2)) in technology.vendor_contract']
  insurance_requirements varchar [note: 'Minimum insurance coverage requirements for vendor including general liability, professional indemnity, and cyber liability coverage amounts. | Column insurance_requirements (STRING) in technology.vendor_contract']
  last_review_date date [note: 'Date when the contract was last reviewed for performance, compliance, and value optimization. Used to schedule periodic contract reviews. | Column last_review_date (DATE) in technology.vendor_contract']
  modified_timestamp timestamp [note: 'Date and time when this vendor contract record was last updated. Audit trail for change tracking. | Column modified_timestamp (TIMESTAMP) in technology.vendor_contract']
  next_review_date date [note: 'Scheduled date for next contract performance review or renewal decision point. Critical for proactive contract management. | Column next_review_date (DATE) in technology.vendor_contract']
  notes varchar [note: 'Free-text field for additional contract details, special terms, negotiation history, or operational notes relevant to contract management. | Column notes (STRING) in technology.vendor_contract']
  notice_period_days varchar [note: 'Number of days advance notice required to terminate or opt-out of auto-renewal before contract end date. Critical for contract management and budget planning. | Column notice_period_days (INT) in technology.vendor_contract']
  payment_terms varchar [note: 'Payment schedule and terms for vendor invoicing: net_30/60/90 (days after invoice), advance (prepayment), milestone (project-based), monthly/quarterly/annual (recurring billing cycles). [ENUM-REF-CANDIDATE: net_30|net_60|net_90|advance|milestone|monthly|quarterly|annual — 8 candidates stripped; promote to reference product] | Column payment_terms (STRING) in technology.vendor_contract']
  penalty_provisions varchar [note: 'Description of financial penalties or service credits applicable when vendor fails to meet SLA commitments or contractual obligations. | Column penalty_provisions (STRING) in technology.vendor_contract']
  procurement_method varchar [note: 'Method used to award the contract: RFP (Request for Proposal), RFQ (Request for Quotation), sole_source (single vendor), competitive_bid (multiple bidders), framework_agreement (pre-negotiated terms), direct_award (non-competitive). | Column procurement_method (STRING) in technology.vendor_contract']
  renewal_term_months varchar [note: 'Duration in months for each automatic renewal period if auto-renewal is enabled. Null if contract does not auto-renew. | Column renewal_term_months (INT) in technology.vendor_contract']
  response_time_hours decimal(6,2) [note: 'Maximum time in hours for vendor to respond to critical incidents or support requests under SLA terms. Null if not applicable to contract type. | Column response_time_hours (DECIMAL(6,2)) in technology.vendor_contract']
  service_scope varchar [note: 'Detailed description of services provided under the contract including maintenance activities, support coverage, managed service responsibilities, or license entitlements. | Column service_scope (STRING) in technology.vendor_contract']
  sla_tier varchar [note: 'Service level tier defining response time, uptime guarantees, and support availability commitments. Higher tiers provide faster response and higher availability guarantees. | Column sla_tier (STRING) in technology.vendor_contract']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.vendor_contract']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.vendor_contract']
  start_date date [note: 'Date when the vendor contract becomes effective and service delivery or license entitlements begin. | Column start_date (DATE) in technology.vendor_contract']
  termination_clause varchar [note: 'Summary of contract termination conditions including for-cause termination rights, early exit penalties, and mutual termination provisions. Critical for risk management. | Column termination_clause (STRING) in technology.vendor_contract']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.vendor_contract']
  uptime_guarantee_percent decimal(5,2) [note: 'Contractually guaranteed system or service availability percentage (e.g., 99.9% for three-nines uptime). Used to measure vendor performance and trigger SLA credits. | Column uptime_guarantee_percent (DECIMAL(5,2)) in technology.vendor_contract']

  Note: 'Master record for technology vendor and service provider contracts governing broadcast infrastructure, IT systems, and managed services — equipment maintenance agreements, network carrier contracts, cloud service agreements, and software license contracts. Captures contract reference number, vendor name, contract type (maintenance, SLA, license, managed service), covered assets or services, contract start/end date, annual value, auto-renewal flag, notice period, SLA tier, and contract owner. Technology-domain SSOT for vendor obligations distinct from partner domain commercial agreements. | Unity Catalog table: media_broadcasting_ecm.technology.vendor_contract'
}

Table technology.tech_change_request {
  tech_change_request_id varchar [pk, note: 'Unique identifier for the technology change request. Primary key for the tech_change_request product. | Column tech_change_request_id (BIGINT) in technology.tech_change_request']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Change requests are scoped to facilities (facility-wide upgrades, infrastructure changes). The \'affected_systems\' field includes facility infrastructure. Links the change request to the facility where | Column broadcast_facility_id (BIGINT) in technology.tech_change_request']
  rollback_tech_change_request_id varchar [note: 'Self-referencing FK on tech_change_request (rollback_tech_change_request_id) | Column rollback_tech_change_request_id (BIGINT) in technology.tech_change_request']
  tech_project_id varchar [note: 'Foreign key linking to technology.tech_project. Business justification: Technology change requests are often part of larger infrastructure projects (e.g., ATSC 3.0 transition, studio upgrade). This FK links individual change requests to their parent project for portfolio  | Column tech_project_id (BIGINT) in technology.tech_change_request']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Change requests affect specific transmission equipment (firmware upgrades, configuration changes, replacements). The \'affected_systems\' field should reference specific equipment. Links the change requ | Column transmission_equipment_id (BIGINT) in technology.tech_change_request']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.tech_change_request']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.tech_change_request']
  actual_downtime_minutes varchar [note: 'Actual duration in minutes that systems or services were unavailable during the change implementation. Compared against estimated downtime to measure accuracy of planning and identify process improvements. | Column actual_downtime_minutes (INT) in technology.tech_change_request']
  actual_effort_hours decimal(10,2) [note: 'Actual number of person-hours spent on planning, implementing, testing, and validating the change. Compared against estimated effort to improve future estimation accuracy. | Column actual_effort_hours (DECIMAL(10,2)) in technology.tech_change_request']
  actual_end_timestamp timestamp [note: 'Actual date and time when the change implementation was completed. Compared against scheduled end time to measure execution efficiency and identify delays. | Column actual_end_timestamp (TIMESTAMP) in technology.tech_change_request']
  actual_start_timestamp timestamp [note: 'Actual date and time when the change implementation work began. Used for tracking schedule adherence and analyzing implementation performance. | Column actual_start_timestamp (TIMESTAMP) in technology.tech_change_request']
  affected_systems varchar [note: 'Comma-separated list or detailed description of all technology systems, applications, infrastructure components, broadcast equipment, and network elements that will be impacted by the change. Includes upstream and downstream dependencies. | Column affected_systems (STRING) in technology.tech_change_request']
  assigned_to_email varchar [note: 'Email address of the technical resource assigned to implement the change for coordination and status updates. | Column assigned_to_email (STRING) in technology.tech_change_request']
  assigned_to_name varchar [note: 'Full name of the technical resource or team lead assigned to implement the change. Responsible for executing the implementation plan and coordinating technical activities. | Column assigned_to_name (STRING) in technology.tech_change_request']
  business_justification varchar [note: 'Explanation of the business rationale and expected benefits driving the change request. Articulates why the change is necessary, what business problem it solves, and the value it delivers to media operations, audience delivery, or operational efficiency. | Column business_justification (STRING) in technology.tech_change_request']
  cab_approval_status varchar [note: 'Decision outcome from the Change Advisory Board review. Approved changes proceed to scheduling; rejected changes are closed; conditional approvals require additional information or modifications; deferred changes are postponed to future CAB meetings. | Column cab_approval_status (STRING) in technology.tech_change_request']
  cab_comments varchar [note: 'Feedback, conditions, concerns, or recommendations provided by the Change Advisory Board during their review. Captures the rationale behind approval decisions and any stipulations for implementation. | Column cab_comments (STRING) in technology.tech_change_request']
  cab_review_date date [note: 'Date when the change request was formally reviewed and evaluated by the Change Advisory Board. Records when the approval decision was made. | Column cab_review_date (DATE) in technology.tech_change_request']
  change_category varchar [note: 'Technical domain classification of the change request indicating which technology area is affected. Infrastructure includes servers and storage; broadcast includes playout and transmission systems; network includes routers and switches; software includes applications and middleware. | Column change_category (STRING) in technology.tech_change_request']
  change_request_number varchar [note: 'Externally-known unique identifier for the change request, typically formatted as CHG followed by numeric sequence. Used for tracking and communication across IT teams and business stakeholders. | Column change_request_number (STRING) in technology.tech_change_request']
  change_status varchar [note: 'Current lifecycle state of the change request in the ITIL change management workflow. Tracks progression from initial submission through CAB review, approval, implementation, and closure. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|scheduled|in_progress|implemented|closed|cancelled|rejected — 10 candidates stripped; promote to reference product] | Column change_status (STRING) in technology.tech_change_request']
  change_type varchar [note: 'Classification of the change request based on urgency and approval requirements. Standard changes are pre-approved low-risk changes; normal changes require CAB approval; emergency changes address critical incidents; expedited changes are fast-tracked normal changes. | Column change_type (STRING) in technology.tech_change_request']
  closed_timestamp timestamp [note: 'Date and time when the change request was formally closed after successful implementation and post-implementation review. Marks the end of the change request lifecycle. | Column closed_timestamp (TIMESTAMP) in technology.tech_change_request']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.tech_change_request']
  downtime_required boolean [note: 'Indicates whether the change implementation requires taking systems or broadcast services offline. Critical for scheduling changes during off-peak hours or maintenance windows to minimize audience impact. | Column downtime_required (BOOLEAN) in technology.tech_change_request']
  estimated_downtime_minutes varchar [note: 'Expected duration in minutes that systems or services will be unavailable during the change implementation. Used for planning maintenance windows and communicating impact to stakeholders. | Column estimated_downtime_minutes (INT) in technology.tech_change_request']
  estimated_effort_hours decimal(10,2) [note: 'Estimated number of person-hours required to plan, implement, test, and validate the change. Used for resource planning and cost estimation. | Column estimated_effort_hours (DECIMAL(10,2)) in technology.tech_change_request']
  impact_assessment varchar [note: 'Analysis of the expected impact of the change on broadcast systems, content delivery, audience experience, operational workflows, and dependent systems. Identifies which business functions and technical components will be affected. | Column impact_assessment (STRING) in technology.tech_change_request']
  implementation_outcome varchar [note: 'Final result of the change implementation. Successful indicates the change was implemented as planned; successful with issues indicates minor problems were encountered but resolved; failed indicates the change could not be completed; rolled back indicates the change was reverted; partially completed indicates some components were implemented. | Column implementation_outcome (STRING) in technology.tech_change_request']
  implementation_plan varchar [note: 'Step-by-step technical procedure for executing the change, including pre-implementation tasks, implementation steps, validation checkpoints, and post-implementation verification. Serves as the execution guide for technical teams. | Column implementation_plan (STRING) in technology.tech_change_request']
  post_implementation_review_date date [note: 'Date when the formal post-implementation review was conducted to assess the success of the change and capture lessons learned. | Column post_implementation_review_date (DATE) in technology.tech_change_request']
  post_implementation_review_outcome varchar [note: 'Summary findings from the post-implementation review conducted after the change is deployed. Evaluates whether the change achieved its objectives, identifies lessons learned, and documents any unexpected issues or benefits. | Column post_implementation_review_outcome (STRING) in technology.tech_change_request']
  priority varchar [note: 'Business priority level assigned to the change request based on urgency and impact. Critical priority is reserved for emergency changes affecting broadcast operations; high priority for significant business impact; medium for planned enhancements; low for minor updates. | Column priority (STRING) in technology.tech_change_request']
  requester_department varchar [note: 'Business department or organizational unit of the change request submitter. Helps identify which business function is driving the change and aids in cost allocation and reporting. | Column requester_department (STRING) in technology.tech_change_request']
  requester_email varchar [note: 'Email address of the change request submitter for communication regarding the change status, approvals, and implementation updates. | Column requester_email (STRING) in technology.tech_change_request']
  requester_name varchar [note: 'Full name of the individual who submitted the change request. Typically a business stakeholder, technical lead, or operations manager identifying a need for technology change. | Column requester_name (STRING) in technology.tech_change_request']
  risk_assessment varchar [note: 'Comprehensive evaluation of potential risks associated with implementing the change, including technical risks, operational risks, broadcast continuity risks, and mitigation strategies. Critical for CAB decision-making and approval process. | Column risk_assessment (STRING) in technology.tech_change_request']
  risk_level varchar [note: 'Overall risk rating assigned to the change request based on potential impact to broadcast operations, audience delivery, and business continuity. Critical risk changes require executive approval and extensive testing. | Column risk_level (STRING) in technology.tech_change_request']
  rollback_plan varchar [note: 'Detailed procedure for reverting the change and restoring systems to their pre-change state if the implementation fails or causes unexpected issues. Essential for minimizing broadcast disruption and ensuring business continuity. | Column rollback_plan (STRING) in technology.tech_change_request']
  scheduled_end_timestamp timestamp [note: 'Planned date and time when the change implementation is expected to be completed. Defines the maintenance window duration and helps coordinate resource allocation. | Column scheduled_end_timestamp (TIMESTAMP) in technology.tech_change_request']
  scheduled_start_timestamp timestamp [note: 'Planned date and time when the change implementation is scheduled to begin. Coordinated with broadcast schedules to minimize audience impact and avoid peak transmission periods. | Column scheduled_start_timestamp (TIMESTAMP) in technology.tech_change_request']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.tech_change_request']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.tech_change_request']
  submitted_timestamp timestamp [note: 'Date and time when the change request was formally submitted into the change management system. Marks the beginning of the change request lifecycle and is used for tracking time-to-implementation metrics. | Column submitted_timestamp (TIMESTAMP) in technology.tech_change_request']
  tech_change_request_description varchar [note: 'Detailed narrative description of the technology change being requested, including technical specifications, scope of work, and specific systems or components to be modified. Provides comprehensive context for CAB review and implementation teams. | Column tech_change_request_description (STRING) in technology.tech_change_request']
  testing_plan varchar [note: 'Comprehensive testing strategy and test cases to validate the change before and after implementation. Includes functional testing, integration testing, performance testing, and user acceptance testing criteria. | Column testing_plan (STRING) in technology.tech_change_request']
  title varchar [note: 'Brief descriptive title summarizing the nature of the technology change request. Should be concise yet informative enough for stakeholders to understand the change at a glance. | Column title (STRING) in technology.tech_change_request']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.tech_change_request']

  Note: 'Transactional record of each formal technology change request submitted through the IT change management process (ITIL CAB) for broadcast infrastructure, network, or IT systems. Captures change request number, change type (standard, normal, emergency), change category (infrastructure, software, network, broadcast), description, business justification, risk assessment, affected systems, rollback plan, CAB approval status, scheduled implementation window, actual implementation timestamp, and post-implementation review outcome. | Unity Catalog table: media_broadcasting_ecm.technology.tech_change_request'
}

Table technology.software_license {
  software_license_id varchar [pk, note: 'Unique identifier for the software license record. Primary key for the software license entity. | Column software_license_id (BIGINT) in technology.software_license']
  upgraded_software_license_id varchar [note: 'Self-referencing FK on software_license (upgraded_software_license_id) | Column upgraded_software_license_id (BIGINT) in technology.software_license']
  vendor_contract_id varchar [note: 'Foreign key linking to technology.vendor_contract. Business justification: software_license.vendor_contract_number (STRING) should be normalized to FK to vendor_contract. Software licenses are procured under vendor contracts governing pricing, support, and terms. This links  | Column vendor_contract_id (BIGINT) in technology.software_license']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.software_license']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.software_license']
  active_user_count varchar [note: 'The current number of unique users actively using this software license, tracked for compliance and utilization analysis. | Column active_user_count (INT) in technology.software_license']
  annual_maintenance_cost_usd decimal(15,2) [note: 'The yearly cost for software maintenance, support, and updates in United States Dollars. | Column annual_maintenance_cost_usd (DECIMAL(15,2)) in technology.software_license']
  assigned_department varchar [note: 'The business department or operational unit responsible for this software license (e.g., Broadcast Operations, Post-Production, IT Infrastructure, News, Engineering). | Column assigned_department (STRING) in technology.software_license']
  auto_renewal_flag boolean [note: 'Indicates whether the license is configured for automatic renewal upon expiry. True if auto-renewing, False if manual renewal required. | Column auto_renewal_flag (BOOLEAN) in technology.software_license']
  compliance_status varchar [note: 'Current license compliance state: compliant (usage within entitlement), over-deployed (usage exceeds licensed seats), under-utilized (licensed seats not fully used), audit required (pending verification), or non-compliant (violation detected). | Column compliance_status (STRING) in technology.software_license']
  cost_center_code varchar [note: 'The financial cost center or department code to which this software license expense is allocated for budgeting and chargeback purposes. | Column cost_center_code (STRING) in technology.software_license']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.software_license']
  created_timestamp timestamp [note: 'The timestamp when this software license record was first created in the system. | Column created_timestamp (TIMESTAMP) in technology.software_license']
  deployment_scope varchar [note: 'The technical deployment model for this software: on-premise (installed locally), cloud (vendor-hosted), hybrid (mixed), SaaS (Software as a Service subscription), desktop (workstation), server (data center), or mobile (device apps). [ENUM-REF-CANDIDATE: on_premise|cloud|hybrid|saas|desktop|server|mobile — 7 candidates stripped; promote to reference product] | Column deployment_scope (STRING) in technology.software_license']
  effective_start_date date [note: 'The date when the license becomes active and usage rights commence. | Column effective_start_date (DATE) in technology.software_license']
  expiry_date date [note: 'The date when the license expires and usage rights terminate. Null for perpetual licenses without maintenance expiry. | Column expiry_date (DATE) in technology.software_license']
  installed_instance_count varchar [note: 'The actual number of software installations or active instances currently deployed across Media Broadcasting infrastructure. | Column installed_instance_count (INT) in technology.software_license']
  last_compliance_audit_date date [note: 'The date when this software license was last audited for compliance with vendor terms and internal Software Asset Management (SAM) policies. | Column last_compliance_audit_date (DATE) in technology.software_license']
  license_agreement_url varchar [note: 'The URL or document repository link to the End User License Agreement (EULA) or master license contract governing this software usage. | Column license_agreement_url (STRING) in technology.software_license']
  license_cost_usd decimal(15,2) [note: 'The total cost of the software license in United States Dollars, including initial purchase or annual subscription fee. | Column license_cost_usd (DECIMAL(15,2)) in technology.software_license']
  license_key varchar [note: 'The unique license key, activation code, or entitlement identifier provided by the software vendor for activation and compliance verification. | Column license_key (STRING) in technology.software_license']
  license_notes varchar [note: 'Additional free-text notes, special terms, restrictions, or operational comments related to this software license. | Column license_notes (STRING) in technology.software_license']
  license_status varchar [note: 'Current operational state of the software license: active (in use and compliant), expired (past end date), suspended (temporarily disabled), pending renewal (approaching expiry), cancelled (terminated), trial (evaluation period), or non-compliant (usage exceeds entitlement). [ENUM-REF-CANDIDATE: active|expired|suspended|pending_renewal|cancelled|trial|non_compliant — 7 candidates stripped; promote to reference product] | Column license_status (STRING) in technology.software_license']
  license_type varchar [note: 'The licensing model governing usage rights: perpetual (one-time purchase with indefinite use), subscription (recurring payment for time-bound access), concurrent (floating licenses shared across users), named user (assigned to specific individuals), site (unlimited use at a location), enterprise (organization-wide), OEM (Original Equipment Manufacturer bundled), or trial (evaluation period). [ENUM-REF-CANDIDATE: perpetual|subscription|concurrent|named_user|site|enterprise|oem|trial — 8 candidates stripped; promote to reference product] | Column license_type (STRING) in technology.software_license']
  maintenance_included_flag boolean [note: 'Indicates whether software maintenance, support, and version updates are included in the license agreement. True if included, False if purchased separately. | Column maintenance_included_flag (BOOLEAN) in technology.software_license']
  next_compliance_audit_date date [note: 'The scheduled date for the next compliance audit or license verification review. | Column next_compliance_audit_date (DATE) in technology.software_license']
  primary_usage_category varchar [note: 'The primary functional category or business purpose for which this software is used within Media Broadcasting operations. [ENUM-REF-CANDIDATE: broadcast_automation|media_asset_management|video_editing|audio_production|graphics_design|playout_control|traffic_billing|enterprise_resource_planning|customer_relationship_management|content_delivery|digital_rights_management|cloud_infrastructure|collaboration|security|other — 15 candidates stripped; promote to reference product] | Column primary_usage_category (STRING) in technology.software_license']
  purchase_date date [note: 'The date when the software license was originally purchased or acquired by Media Broadcasting. | Column purchase_date (DATE) in technology.software_license']
  purchase_order_number varchar [note: 'The internal purchase order number used to procure this software license through Media Broadcasting\'s procurement system. | Column purchase_order_number (STRING) in technology.software_license']
  renewal_date date [note: 'The scheduled date for license renewal or subscription extension. | Column renewal_date (DATE) in technology.software_license']
  renewal_owner_email varchar [note: 'The email address of the renewal owner for license management communications and notifications. | Column renewal_owner_email (STRING) in technology.software_license']
  renewal_owner_name varchar [note: 'The name of the individual or role responsible for managing license renewal, vendor negotiations, and contract administration. | Column renewal_owner_name (STRING) in technology.software_license']
  seat_count varchar [note: 'The number of authorized users, installations, or concurrent sessions permitted under this license agreement. | Column seat_count (INT) in technology.software_license']
  software_product_name varchar [note: 'The commercial name of the licensed software product (e.g., Ericsson MediaFirst, Dalet Galaxy, Adobe Premiere Pro, Avid Media Composer). | Column software_product_name (STRING) in technology.software_license']
  software_version varchar [note: 'The specific version or release number of the licensed software product. | Column software_version (STRING) in technology.software_license']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.software_license']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.software_license']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.software_license']
  updated_timestamp timestamp [note: 'The timestamp when this software license record was last modified or updated. | Column updated_timestamp (TIMESTAMP) in technology.software_license']
  vendor_name varchar [note: 'The name of the software vendor or publisher providing the license (e.g., Ericsson, Dalet, Adobe, Avid, Microsoft, SAP). | Column vendor_name (STRING) in technology.software_license']
  vendor_support_contact varchar [note: 'The primary vendor support contact information (email, phone, or portal URL) for technical assistance and license inquiries. | Column vendor_support_contact (STRING) in technology.software_license']

  Note: 'Master record for all software licenses managed by Media Broadcasting technology operations — broadcast automation software (Ericsson MediaFirst, Dalet Galaxy), editing suites (Avid, Adobe), MAM platforms, cloud subscriptions, and enterprise IT software. Captures license key or entitlement ID, software product name, vendor, license type (perpetual, subscription, concurrent, named user), seat count, expiry date, assigned cost center, compliance status, and renewal owner. Enables software asset management (SAM) and license compliance. | Unity Catalog table: media_broadcasting_ecm.technology.software_license'
}

Table technology.tech_project {
  tech_project_id varchar [pk, note: 'Unique identifier for the technology infrastructure project. Primary key. | Column tech_project_id (BIGINT) in technology.tech_project']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Technology projects are facility-specific (ATSC 3.0 transition, studio upgrades, transmission equipment replacement). The \'impacted_facilities\' STRING field should be normalized to a FK. For projects  | Column broadcast_facility_id (BIGINT) in technology.tech_project']
