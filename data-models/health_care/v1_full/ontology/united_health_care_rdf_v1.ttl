ind:requiredCredentialType rdf:type rdf:Property ;
    rdfs:label 'Required Credential Type' ;
    rdfs:comment 'Specifies the type of professional credential or certification required to deliver this intervention. May include RN, LCSW, CCM, CHW, or other designations.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billableService rdf:type rdf:Property ;
    rdfs:label 'Billable Service' ;
    rdfs:comment 'Indicates whether this intervention type represents a billable service that may generate claims or reimbursement. Used for financial tracking and revenue cycle management.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementRate rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Rate' ;
    rdfs:comment 'Standard reimbursement rate or payment amount for this intervention type when delivered as a billable service. Amount in US dollars.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicareApplicable rdf:type rdf:Property ;
    rdfs:label 'Medicare Applicable' ;
    rdfs:comment 'Indicates whether this intervention type is applicable for Medicare Advantage members. Used for program eligibility and compliance.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidApplicable rdf:type rdf:Property ;
    rdfs:label 'Medicaid Applicable' ;
    rdfs:comment 'Indicates whether this intervention type is applicable for Medicaid managed care members. Used for program eligibility and state compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialApplicable rdf:type rdf:Property ;
    rdfs:label 'Commercial Applicable' ;
    rdfs:comment 'Indicates whether this intervention type is applicable for commercial group and individual members. Used for program eligibility and benefit design.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:snpApplicable rdf:type rdf:Property ;
