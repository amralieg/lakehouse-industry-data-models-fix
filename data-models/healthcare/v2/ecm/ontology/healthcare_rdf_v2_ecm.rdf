    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irbWaiverDate rdf:type rdf:Property ;
    rdfs:label 'Irb Waiver Date' ;
    rdfs:comment 'The date the IRB waiver or exemption was granted for this dataset.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irbWaiverReference rdf:type rdf:Property ;
    rdfs:label 'Irb Waiver Reference' ;
    rdfs:comment 'Reference number or identifier for the IRB waiver or exemption determination that permits use of this de-identified dataset without individual consent.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nihDataSharingCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Nih Data Sharing Compliant Flag' ;
    rdfs:comment 'Indicates whether the dataset meets NIH data sharing policy requirements for federally funded research.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientPopulationCount rdf:type rdf:Property ;
