ind:hedisMeasureIndicator rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Indicator' ;
    rdfs:comment 'Flag indicating whether this service line contributes to HEDIS quality measure reporting.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityProgramIndicator rdf:type rdf:Property ;
    rdfs:label 'Quality Program Indicator' ;
    rdfs:comment 'Flag indicating whether this service line is associated with a quality improvement or value-based care program.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adjustmentId rdf:type rdf:Property ;
    rdfs:label 'Adjustment Id' ;
    rdfs:comment 'Unique identifier for the claim adjustment record. Primary key for the claim adjustment entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjustment .

ind:typeCode rdf:type rdf:Property ;
    rdfs:label 'Type Code' ;
    rdfs:comment 'Classification code indicating the category of adjustment applied to the claim (e.g., financial, administrative, clinical, COB).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupCode rdf:type rdf:Property ;
    rdfs:label 'Group Code' ;
    rdfs:comment 'Code indicating the party responsible for the adjustment amount: CO (Contractual Obligation), PR (Patient Responsibility), OA (Other Adjustment), PI (Payer Initiated).' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantity rdf:type rdf:Property ;
    rdfs:label 'Quantity' ;
    rdfs:comment 'Quantity value associated with the adjustment when applicable (e.g., number of units adjusted).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalBilledAmount rdf:type rdf:Property ;
    rdfs:label 'Original Billed Amount' ;
    rdfs:comment 'The original amount billed on the claim before this adjustment was applied.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustedAllowedAmount rdf:type rdf:Property ;
    rdfs:label 'Adjusted Allowed Amount' ;
    rdfs:comment 'The allowed amount after applying this adjustment. Represents the maximum reimbursable amount post-adjustment.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustedPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Adjusted Paid Amount' ;
    rdfs:comment 'The actual paid amount after applying this adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientResponsibilityAmount rdf:type rdf:Property ;
    rdfs:label 'Patient Responsibility Amount' ;
    rdfs:comment 'Portion of the adjustment amount that is the patient\'s financial responsibility (copay, coinsurance, deductible).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postedDate rdf:type rdf:Property ;
    rdfs:label 'Posted Date' ;
    rdfs:comment 'The date on which the adjustment was posted to the financial ledger.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lineItemNumber rdf:type rdf:Property ;
    rdfs:label 'Line Item Number' ;
    rdfs:comment 'The specific line item number on the claim to which this adjustment applies. Null if adjustment applies to entire claim.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceLineAdjustmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Service Line Adjustment Indicator' ;
    rdfs:comment 'Flag indicating whether the adjustment applies to a specific service line (true) or the entire claim (false).' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:procedureModifier rdf:type rdf:Property ;
    rdfs:label 'Procedure Modifier' ;
    rdfs:comment 'Two-character modifier code(s) appended to the procedure code to provide additional information about the service.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatorType rdf:type rdf:Property ;
    rdfs:label 'Initiator Type' ;
    rdfs:comment 'The type of party that initiated or requested the adjustment.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'The method by which the adjustment was applied (automated system rule, manual intervention, or semi-automated).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Original Payment Date' ;
    rdfs:comment 'The date of the original claim payment that is being adjusted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalCheckNumber rdf:type rdf:Property ;
    rdfs:label 'Original Check Number' ;
    rdfs:comment 'The check or EFT reference number of the original payment being adjusted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoupmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Recoupment Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment represents a recoupment (recovery of previously paid funds).' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoupmentMethod rdf:type rdf:Property ;
    rdfs:label 'Recoupment Method' ;
    rdfs:comment 'The method used to recover overpaid funds when recoupment is applicable.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditIndicator rdf:type rdf:Property ;
    rdfs:label 'Audit Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment resulted from an audit finding.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditType rdf:type rdf:Property ;
    rdfs:label 'Audit Type' ;
    rdfs:comment 'The type of audit that identified the need for this adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Recovery Amount' ;
    rdfs:comment 'The amount recovered through subrogation that resulted in this adjustment.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pricingMethodology rdf:type rdf:Property ;
    rdfs:label 'Pricing Methodology' ;
    rdfs:comment 'The pricing methodology used to calculate the adjusted amount.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowedAmountCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Allowed Amount Calculation Method' ;
    rdfs:comment 'The method used to determine the allowed amount that drives the adjustment calculation.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bundlingIndicator rdf:type rdf:Property ;
    rdfs:label 'Bundling Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment is due to bundling of services under payment policy.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bundlingPolicyCode rdf:type rdf:Property ;
    rdfs:label 'Bundling Policy Code' ;
    rdfs:comment 'The specific bundling policy code that triggered this adjustment.' ;
