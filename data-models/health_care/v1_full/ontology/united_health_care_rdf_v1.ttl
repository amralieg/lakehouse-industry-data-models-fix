    rdfs:range xsd:dateTime .

ind:slotDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Slot Duration Minutes' ;
    rdfs:comment 'Length of each appointment slot in minutes.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:availableCapacity rdf:type rdf:Property ;
    rdfs:label 'Available Capacity' ;
    rdfs:comment 'Number of appointment slots available for booking.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
