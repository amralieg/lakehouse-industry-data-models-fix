  usage_count varchar [note: 'Number of content assets currently tagged with this taxonomy entry, used for analytics and taxonomy optimization. | Column usage_count (BIGINT) in content.taxonomy']
  version_number varchar [note: 'Version number of this taxonomy entry, incremented with each modification for change tracking. | Column version_number (INT) in content.taxonomy']

  Note: 'Master reference table for taxonomy. Referenced by taxonomy_id. | Unity Catalog table: media_broadcasting_ecm.content.taxonomy Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics.'
}

Table content.content_library {
  content_library_id varchar [pk, note: 'Primary key for content_library | Column content_library_id (BIGINT) in content.content_library']
  parent_content_library_id varchar [note: 'Self-referencing FK on content_library (parent_content_library_id) | Column parent_content_library_id (BIGINT) in content.content_library']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in content.content_library']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in content.content_library']
  acquisition_date date [note: 'Date when the content asset was acquired or licensed by the organization for distribution. | Column acquisition_date (DATE) in content.content_library']
  archive_location varchar [note: 'Physical or digital storage location identifier for the master content asset. Used for asset retrieval and disaster recovery. | Column archive_location (STRING) in content.content_library']
  aspect_ratio varchar [note: 'Display aspect ratio of the content asset. Critical for proper presentation across distribution platforms. | Column aspect_ratio (NUMERIC) in content.content_library']
  audio_description_available boolean [note: 'Indicates whether audio description track is available for visually impaired audiences. Supports accessibility compliance. | Column audio_description_available (BOOLEAN) in content.content_library']
  audio_tracks_available varchar [note: 'Comma-separated list of ISO 639-3 language codes for available audio tracks. Supports multi-language distribution. | Column audio_tracks_available (STRING) in content.content_library']
  closed_caption_available boolean [note: 'Indicates whether closed captioning is available for the content asset. Required for FCC compliance and accessibility. | Column closed_caption_available (BOOLEAN) in content.content_library']
  content_format varchar [note: 'Technical format specification of the content asset including resolution and dynamic range characteristics. | Column content_format (STRING) in content.content_library']
  content_owner varchar [note: 'Legal entity that owns the intellectual property rights to the content asset. Critical for rights management and licensing. | Column content_owner (STRING) in content.content_library']
  content_status varchar [note: 'Current lifecycle status of the content asset indicating availability and distribution eligibility. | Column content_status (STRING) in content.content_library']
