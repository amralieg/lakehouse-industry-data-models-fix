    rdfs:range xsd:boolean .

ind:cobraApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Cobra Applicable Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type applies to COBRA continuation coverage with same terms as active employees.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:erisaDisclosureRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Erisa Disclosure Required Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type must be disclosed in Summary Plan Descriptions for ERISA-covered group health plans.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noSurprisesActApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'No Surprises Act Applicable Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type is subject to No Surprises Act protections for emergency and out-of-network services.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benefitTypeId rdf:type rdf:Property ;
    rdfs:label 'Benefit Type Id' ;
    rdfs:comment 'Unique identifier for the benefit type category. Primary key for the benefit type lookup table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenefitType .

ind:isEssentialHealthBenefit rdf:type rdf:Property ;
    rdfs:label 'Is Essential Health Benefit' ;
    rdfs:comment 'Indicates whether this benefit type is classified as an Essential Health Benefit under the Affordable Care Act (ACA) requirements.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPreventiveCare rdf:type rdf:Property ;
    rdfs:label 'Is Preventive Care' ;
    rdfs:comment 'Indicates whether this benefit type includes preventive care services that must be covered at 100% without cost-sharing under ACA requirements.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subjectToDeductible rdf:type rdf:Property ;
    rdfs:label 'Subject To Deductible' ;
    rdfs:comment 'Indicates whether services under this benefit type are typically subject to plan deductible requirements before coverage begins.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subjectToOutOfPocketMaximum rdf:type rdf:Property ;
    rdfs:label 'Subject To Out Of Pocket Maximum' ;
    rdfs:comment 'Indicates whether cost-sharing for this benefit type counts toward the plan\'s Maximum Out-of-Pocket (MOOP) limit.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsOutOfNetworkCoverage rdf:type rdf:Property ;
    rdfs:label 'Allows Out Of Network Coverage' ;
    rdfs:comment 'Indicates whether this benefit type allows coverage for out-of-network providers, typically applicable in PPO and POS plans.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimType rdf:type rdf:Property ;
    rdfs:label 'Claim Type' ;
    rdfs:comment 'Type of claim form and processing rules typically associated with this benefit type (e.g., CMS-1500 for professional, UB-04 for institutional).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialValueCategory rdf:type rdf:Property ;
    rdfs:label 'Actuarial Value Category' ;
    rdfs:comment 'Metal tier classification for ACA-compliant plans indicating the actuarial value percentage this benefit type contributes to.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalLossRatioCategory rdf:type rdf:Property ;
    rdfs:label 'Medical Loss Ratio Category' ;
    rdfs:comment 'Classification of this benefit type for Medical Loss Ratio (MLR) reporting purposes, determining whether costs count toward the MLR numerator.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisMeasureApplicability rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Applicability' ;
    rdfs:comment 'Comma-separated list of HEDIS measure domains to which this benefit type is relevant for quality reporting (e.g., Effectiveness of Care, Access/Availability).' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyBenefitManagerApplicable rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Benefit Manager Applicable' ;
    rdfs:comment 'Indicates whether this benefit type is managed through a Pharmacy Benefit Manager (PBM) platform rather than medical claims processing.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formularyApplicable rdf:type rdf:Property ;
    rdfs:label 'Formulary Applicable' ;
    rdfs:comment 'Indicates whether this benefit type uses a formulary or preferred list to determine coverage and cost-sharing tiers.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nationalDrugCodeApplicable rdf:type rdf:Property ;
    rdfs:label 'National Drug Code Applicable' ;
    rdfs:comment 'Indicates whether services under this benefit type are identified using National Drug Code (NDC) numbers for billing and adjudication.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:procedureCodeSet rdf:type rdf:Property ;
    rdfs:label 'Procedure Code Set' ;
    rdfs:comment 'Primary procedure coding system used for services under this benefit type (CPT for medical, CDT for dental, HCPCS for supplies/DME).' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCodeSet rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code Set' ;
    rdfs:comment 'Primary diagnosis coding system used for services under this benefit type (ICD-10-CM for medical, DSM-5 for behavioral health).' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueCodeApplicable rdf:type rdf:Property ;
    rdfs:label 'Revenue Code Applicable' ;
    rdfs:comment 'Indicates whether institutional claims for this benefit type require revenue codes for billing (typically for hospital and facility services).' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:placeOfServiceRestrictions rdf:type rdf:Property ;
    rdfs:label 'Place Of Service Restrictions' ;
    rdfs:comment 'Comma-separated list of allowed Place of Service (POS) codes for this benefit type, defining where services can be rendered for coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerSpecialtyRestrictions rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Restrictions' ;
    rdfs:comment 'Comma-separated list of provider specialty codes or taxonomy codes that are authorized to deliver services under this benefit type.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresMedicalNecessityReview rdf:type rdf:Property ;
    rdfs:label 'Requires Medical Necessity Review' ;
    rdfs:comment 'Indicates whether services under this benefit type require medical necessity review using clinical guidelines (e.g., InterQual, MCG).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseManagementApplicable rdf:type rdf:Property ;
    rdfs:label 'Case Management Applicable' ;
    rdfs:comment 'Indicates whether members receiving services under this benefit type are eligible for case management or care coordination programs.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diseaseManagementApplicable rdf:type rdf:Property ;
    rdfs:label 'Disease Management Applicable' ;
    rdfs:comment 'Indicates whether this benefit type is associated with disease management programs for chronic conditions (e.g., diabetes, asthma, CHF).' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mentalHealthParityApplicable rdf:type rdf:Property ;
    rdfs:label 'Mental Health Parity Applicable' ;
    rdfs:comment 'Indicates whether this benefit type is subject to Mental Health Parity and Addiction Equity Act (MHPAEA) requirements for equivalent coverage to medical benefits.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noSurprisesActApplicable rdf:type rdf:Property ;
    rdfs:label 'No Surprises Act Applicable' ;
    rdfs:comment 'Indicates whether this benefit type is subject to No Surprises Act protections against balance billing for out-of-network emergency and certain non-emergency services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transparencyInCoverageApplicable rdf:type rdf:Property ;
    rdfs:label 'Transparency In Coverage Applicable' ;
    rdfs:comment 'Indicates whether this benefit type is subject to Transparency in Coverage Rule requirements for machine-readable pricing files and cost-sharing tools.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicarePartCoverage rdf:type rdf:Property ;
    rdfs:label 'Medicare Part Coverage' ;
    rdfs:comment 'Indicates which Medicare part(s) typically cover this benefit type (Part A hospital, Part B medical, Part C Medicare Advantage, Part D prescription drug).' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidBenefitCategory rdf:type rdf:Property ;
    rdfs:label 'Medicaid Benefit Category' ;
    rdfs:comment 'Classification of this benefit type under Medicaid program rules (mandatory state plan benefit, optional benefit, waiver service).' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialNeedsPlanApplicable rdf:type rdf:Property ;
    rdfs:label 'Special Needs Plan Applicable' ;
    rdfs:comment 'Indicates whether this benefit type is relevant for Special Needs Plans (SNP) including D-SNP, C-SNP, and I-SNP products.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskAdjustmentApplicable rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Applicable' ;
    rdfs:comment 'Indicates whether services under this benefit type contribute to risk adjustment calculations and Hierarchical Condition Category (HCC) coding.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityImprovementCategory rdf:type rdf:Property ;
    rdfs:label 'Quality Improvement Category' ;
    rdfs:comment 'Classification of this benefit type for quality improvement initiatives and reporting purposes.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudWasteAbuseRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Fraud Waste Abuse Risk Level' ;
    rdfs:comment 'Risk level classification for Fraud, Waste, and Abuse (FWA) detection and prevention activities associated with this benefit type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethodology rdf:type rdf:Property ;
    rdfs:label 'Payment Methodology' ;
    rdfs:comment 'Primary payment methodology used for reimbursing providers for services under this benefit type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkTierApplicable rdf:type rdf:Property ;
    rdfs:label 'Network Tier Applicable' ;
    rdfs:comment 'Indicates whether this benefit type uses tiered network structures with different cost-sharing levels (e.g., Tier 1 preferred, Tier 2 standard).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:centerOfExcellenceApplicable rdf:type rdf:Property ;
    rdfs:label 'Center Of Excellence Applicable' ;
    rdfs:comment 'Indicates whether this benefit type includes Center of Excellence (COE) programs with designated high-quality providers for specific services.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaPrivacyRuleCategory rdf:type rdf:Property ;
    rdfs:label 'Hipaa Privacy Rule Category' ;
    rdfs:comment 'Classification of this benefit type under HIPAA Privacy Rule permitted uses and disclosures of Protected Health Information (PHI).' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRetentionPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Data Retention Period Years' ;
    rdfs:comment 'Number of years that records related to this benefit type must be retained to comply with regulatory and legal requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:iconIdentifier rdf:type rdf:Property ;
    rdfs:label 'Icon Identifier' ;
    rdfs:comment 'Reference identifier for the visual icon or symbol used to represent this benefit type in digital applications and member portals.' ;
    rdfs:domain ind:BenefitType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberFacingLabel rdf:type rdf:Property ;
    rdfs:label 'Member Facing Label' ;
    rdfs:comment 'Simplified, consumer-friendly label for this benefit type used in member communications, ID cards, and self-service tools.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalNotes rdf:type rdf:Property ;
    rdfs:label 'Internal Notes' ;
    rdfs:comment 'Free-text field for internal operational notes, implementation guidance, or special considerations related to this benefit type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifecycleEventId rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Event Id' ;
    rdfs:comment 'Unique identifier for the plan lifecycle event record. Primary key for tracking creation, amendment, or termination events.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventType rdf:type rdf:Property ;
    rdfs:label 'Event Type' ;
    rdfs:comment 'Type of lifecycle event being recorded for the plan. Indicates whether the plan is being created, modified, terminated, renewed, reinstated, or suspended.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDate rdf:type rdf:Property ;
    rdfs:label 'Event Date' ;
    rdfs:comment 'The date on which the lifecycle event occurred or was recorded in the system.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'Precise timestamp when the lifecycle event was recorded in the system, including time zone information.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for the lifecycle event. Used for regulatory reporting and internal analytics.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Detailed textual description of the reason for the lifecycle event. Provides context beyond the standardized reason code.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Required' ;
    rdfs:comment 'Indicates whether this lifecycle event requires filing with state or federal regulatory authorities.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:filingReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Reference Number' ;
    rdfs:comment 'Reference number assigned by the regulatory authority for filings related to this lifecycle event. Used for tracking compliance submissions.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDate rdf:type rdf:Property ;
    rdfs:label 'Filing Date' ;
    rdfs:comment 'The date on which regulatory filing was submitted for this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingStatus rdf:type rdf:Property ;
    rdfs:label 'Filing Status' ;
    rdfs:comment 'Current status of the regulatory filing associated with this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeCategory rdf:type rdf:Property ;
    rdfs:label 'Change Category' ;
    rdfs:comment 'High-level category of the change being made to the plan. Used for impact analysis and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeSummary rdf:type rdf:Property ;
    rdfs:label 'Change Summary' ;
    rdfs:comment 'Brief summary of the changes being made to the plan in this lifecycle event. Provides quick reference for stakeholders.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeDetails rdf:type rdf:Property ;
    rdfs:label 'Change Details' ;
    rdfs:comment 'Comprehensive description of all changes being made to the plan. Includes specific benefit modifications, network updates, or other alterations.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorValue rdf:type rdf:Property ;
    rdfs:label 'Prior Value' ;
    rdfs:comment 'The value or state of the plan attribute before this lifecycle event. Used for audit trail and rollback capabilities.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newValue rdf:type rdf:Property ;
    rdfs:label 'New Value' ;
    rdfs:comment 'The value or state of the plan attribute after this lifecycle event. Documents the result of the change.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Member Notification Required' ;
    rdfs:comment 'Indicates whether enrolled members must be notified of this lifecycle event per regulatory or contractual requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Member Notification Date' ;
    rdfs:comment 'The date by which member notification must be completed for this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberNotificationMethod rdf:type rdf:Property ;
    rdfs:label 'Member Notification Method' ;
    rdfs:comment 'The communication channel used to notify members of this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Provider Notification Date' ;
    rdfs:comment 'The date by which provider notification must be completed for this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brokerNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Broker Notification Required' ;
    rdfs:comment 'Indicates whether brokers and agents must be notified of this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Employer Notification Required' ;
    rdfs:comment 'Indicates whether employer group sponsors must be notified of this lifecycle event. Applicable for group plans.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemUpdateRequired rdf:type rdf:Property ;
    rdfs:label 'System Update Required' ;
    rdfs:comment 'Indicates whether downstream systems (claims, enrollment, billing) require updates as a result of this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemUpdateDate rdf:type rdf:Property ;
    rdfs:label 'System Update Date' ;
    rdfs:comment 'The date on which system updates were completed to reflect this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:systemUpdateStatus rdf:type rdf:Property ;
    rdfs:label 'System Update Status' ;
    rdfs:comment 'Current status of system updates required for this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactedMembersCount rdf:type rdf:Property ;
    rdfs:label 'Impacted Members Count' ;
    rdfs:comment 'The number of enrolled members affected by this lifecycle event. Used for impact assessment and communication planning.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Amount' ;
    rdfs:comment 'Estimated financial impact of this lifecycle event in US dollars. May represent revenue, cost, or reserve adjustments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialImpactType rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Type' ;
    rdfs:comment 'Classification of the financial impact resulting from this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Actuarial Review Required' ;
    rdfs:comment 'Indicates whether actuarial review and certification is required for this lifecycle event. Typically required for benefit or pricing changes.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actuarialReviewDate rdf:type rdf:Property ;
    rdfs:label 'Actuarial Review Date' ;
    rdfs:comment 'The date on which actuarial review was completed for this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actuarialCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Actuarial Certification Number' ;
    rdfs:comment 'Reference number of the actuarial certification associated with this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Required' ;
    rdfs:comment 'Indicates whether legal and regulatory compliance review is required for this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Date' ;
    rdfs:comment 'The date on which compliance review was completed for this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Legal Review Required' ;
    rdfs:comment 'Indicates whether legal department review is required for this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractAmendmentRequired rdf:type rdf:Property ;
    rdfs:label 'Contract Amendment Required' ;
    rdfs:comment 'Indicates whether group contracts or provider agreements require amendment as a result of this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractAmendmentReference rdf:type rdf:Property ;
    rdfs:label 'Contract Amendment Reference' ;
    rdfs:comment 'Reference number or identifier of the contract amendment associated with this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sbcUpdateRequired rdf:type rdf:Property ;
    rdfs:label 'Sbc Update Required' ;
    rdfs:comment 'Indicates whether the Summary of Benefits and Coverage document must be updated as a result of this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sbcVersion rdf:type rdf:Property ;
    rdfs:label 'Sbc Version' ;
    rdfs:comment 'Version identifier of the SBC document associated with this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spdUpdateRequired rdf:type rdf:Property ;
    rdfs:label 'Spd Update Required' ;
    rdfs:comment 'Indicates whether the Summary Plan Description must be updated as a result of this lifecycle event. Applicable for ERISA-covered group plans.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formularyVersion rdf:type rdf:Property ;
    rdfs:label 'Formulary Version' ;
    rdfs:comment 'Version identifier of the pharmacy formulary associated with the plan at the time of this lifecycle event.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkVersion rdf:type rdf:Property ;
    rdfs:label 'Network Version' ;
    rdfs:comment 'Version identifier of the provider network configuration associated with the plan at the time of this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitPackageVersion rdf:type rdf:Property ;
    rdfs:label 'Benefit Package Version' ;
    rdfs:comment 'Version identifier of the benefit package design associated with the plan at the time of this lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateVersion rdf:type rdf:Property ;
    rdfs:label 'Rate Version' ;
    rdfs:comment 'Version identifier of the premium rate structure associated with the plan at the time of this lifecycle event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rollbackAllowed rdf:type rdf:Property ;
    rdfs:label 'Rollback Allowed' ;
    rdfs:comment 'Indicates whether this lifecycle event can be rolled back or reversed if needed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rollbackDate rdf:type rdf:Property ;
    rdfs:label 'Rollback Date' ;
    rdfs:comment 'The date on which this lifecycle event was rolled back or reversed, if applicable.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rollbackReason rdf:type rdf:Property ;
    rdfs:label 'Rollback Reason' ;
    rdfs:comment 'Explanation of why this lifecycle event was rolled back or reversed.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributeId rdf:type rdf:Property ;
    rdfs:label 'Attribute Id' ;
    rdfs:comment 'Unique identifier for the product attribute record. Primary key for the product attribute entity.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:key rdf:type rdf:Property ;
    rdfs:label 'Key' ;
    rdfs:comment 'The name or key of the attribute being defined. Represents the extensible characteristic not covered by fixed product columns (e.g., telehealth_coverage, wellness_program_included, maternity_waiting_period_days).' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:value rdf:type rdf:Property ;
    rdfs:label 'Value' ;
    rdfs:comment 'The value assigned to the attribute key. Stored as string to support flexible data types (numeric values, text, dates, boolean flags).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataType rdf:type rdf:Property ;
    rdfs:label 'Data Type' ;
    rdfs:comment 'The data type of the attribute value to enable proper interpretation and validation (string, integer, decimal, boolean, date, timestamp).' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayName rdf:type rdf:Property ;
    rdfs:label 'Display Name' ;
    rdfs:comment 'Human-readable display name for the attribute key, used in user interfaces and member-facing documentation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMemberVisible rdf:type rdf:Property ;
    rdfs:label 'Is Member Visible' ;
    rdfs:comment 'Indicates whether this attribute should be displayed to members in benefit summaries, Summary of Benefits and Coverage (SBC), or member portals.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryRequired rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Required' ;
    rdfs:comment 'Indicates whether this attribute is required by federal or state regulatory mandates (e.g., ACA essential health benefits, CMS coverage requirements).' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceStandard rdf:type rdf:Property ;
    rdfs:label 'Compliance Standard' ;
    rdfs:comment 'The compliance or quality standard associated with this attribute (e.g., NCQA accreditation requirement, HEDIS measure, CMS Star Rating component).' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'The source or origin of the attribute definition (e.g., product management, actuarial, compliance, sales, external vendor).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumValue rdf:type rdf:Property ;
    rdfs:label 'Minimum Value' ;
    rdfs:comment 'The minimum allowable value for numeric attributes, used for validation and business rule enforcement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumValue rdf:type rdf:Property ;
    rdfs:label 'Maximum Value' ;
    rdfs:comment 'The maximum allowable value for numeric attributes, used for validation and business rule enforcement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultValue rdf:type rdf:Property ;
    rdfs:label 'Default Value' ;
    rdfs:comment 'The default value assigned to this attribute if no explicit value is provided during product configuration.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowedValues rdf:type rdf:Property ;
    rdfs:label 'Allowed Values' ;
    rdfs:comment 'Comma-separated list of allowed values for enumerated attributes, used for validation and dropdown lists in configuration interfaces.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationRule rdf:type rdf:Property ;
    rdfs:label 'Validation Rule' ;
    rdfs:comment 'Business rule or validation logic applied to this attribute to ensure data quality and compliance (e.g., regex pattern, range check, cross-attribute dependency).' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSearchable rdf:type rdf:Property ;
    rdfs:label 'Is Searchable' ;
    rdfs:comment 'Indicates whether this attribute should be indexed and available for product search and filtering in member portals or broker tools.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:group rdf:type rdf:Property ;
    rdfs:label 'Group' ;
    rdfs:comment 'Logical grouping of related attributes for display and reporting purposes (e.g., preventive_care, specialty_services, pharmacy_benefits, cost_sharing).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCmsReportable rdf:type rdf:Property ;
    rdfs:label 'Is Cms Reportable' ;
    rdfs:comment 'Indicates whether this attribute must be reported to Centers for Medicare and Medicaid Services (CMS) for Medicare Advantage, Part D, or Medicaid managed care programs.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:starRatingDomain rdf:type rdf:Property ;
    rdfs:label 'Star Rating Domain' ;
    rdfs:comment 'The CMS Star Rating domain or category to which this attribute contributes (e.g., Staying Healthy, Managing Chronic Conditions, Member Experience, Drug Safety).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceCategory rdf:type rdf:Property ;
    rdfs:label 'Service Category' ;
    rdfs:comment 'The category of healthcare service to which this attribute applies (e.g., inpatient, outpatient, emergency, preventive, specialty, pharmacy, behavioral_health, durable_medical_equipment).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Code' ;
    rdfs:comment 'Internal benefit code or identifier that this attribute modifies or extends, linking to the core benefit structure in the product catalog.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderApplicability rdf:type rdf:Property ;
    rdfs:label 'Gender Applicability' ;
    rdfs:comment 'The gender to which this attribute applies, used for gender-specific benefits (e.g., maternity, prostate screening). All indicates no gender restriction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateMandateCode rdf:type rdf:Property ;
    rdfs:label 'State Mandate Code' ;
    rdfs:comment 'Code or identifier for state-specific insurance mandates that require this attribute (e.g., state-mandated benefits, coverage requirements).' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerGroupSize rdf:type rdf:Property ;
    rdfs:label 'Employer Group Size' ;
    rdfs:comment 'The employer group size category to which this attribute applies (Small Group 1-50, Large Group 51+, Jumbo Group 1000+, Individual). Used for group-specific product features.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFsaCompatible rdf:type rdf:Property ;
    rdfs:label 'Is Fsa Compatible' ;
    rdfs:comment 'Indicates whether this attribute is compatible with Flexible Spending Account (FSA) arrangements for pre-tax healthcare expense reimbursement.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHraCompatible rdf:type rdf:Property ;
    rdfs:label 'Is Hra Compatible' ;
    rdfs:comment 'Indicates whether this attribute is compatible with Health Reimbursement Arrangement (HRA) employer-funded accounts for healthcare expense reimbursement.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stepTherapyRequired rdf:type rdf:Property ;
    rdfs:label 'Step Therapy Required' ;
    rdfs:comment 'Indicates whether this attribute requires step therapy protocols, where members must try lower-cost treatments before higher-cost alternatives are covered.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantityLimit rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit' ;
    rdfs:comment 'The maximum quantity or number of services, visits, or units covered under this attribute within a specified time period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityLimitPeriod rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit Period' ;
    rdfs:comment 'The time period over which the quantity limit applies (Per Day, Per Week, Per Month, Per Quarter, Per Year, Per Lifetime).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionDescription rdf:type rdf:Property ;
    rdfs:label 'Exclusion Description' ;
    rdfs:comment 'Description of services, conditions, or circumstances excluded from coverage under this attribute.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitationDescription rdf:type rdf:Property ;
    rdfs:label 'Limitation Description' ;
    rdfs:comment 'Description of limitations or restrictions applied to coverage under this attribute (e.g., frequency limits, dollar limits, service-specific restrictions).' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transparencyInCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Transparency In Coverage Flag' ;
    rdfs:comment 'Indicates whether this attribute must be included in Transparency in Coverage machine-readable files for price transparency compliance.' ;
    rdfs:domain ind:Attribute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateScheduleTypeId rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Type Id' ;
    rdfs:comment 'Unique identifier for the rate schedule type classification. Primary key for the rate schedule type entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateScheduleType .

ind:ratingMethodology rdf:type rdf:Property ;
    rdfs:label 'Rating Methodology' ;
    rdfs:comment 'Specific methodology used to determine premium rates within this schedule type (age bands, geographic rating areas, group size factors, industry classification, participation rates, employer contribution levels, composite rates, tier structures, experience modification, manual rates, or custom factors).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acaCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Aca Compliant Flag' ;
    rdfs:comment 'Indicates whether this rate schedule type adheres to ACA rating requirements including age curve restrictions (3:1 ratio), tobacco use factors (1.5:1 ratio), and prohibited rating factors.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ageRatingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Age Rating Allowed Flag' ;
    rdfs:comment 'Indicates whether premium variation based on age is permitted under this rate schedule type, subject to regulatory constraints (e.g., ACA 3:1 age ratio limit).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ageBandStructure rdf:type rdf:Property ;
    rdfs:label 'Age Band Structure' ;
    rdfs:comment 'Structure of age bands used in age-based rating (single-year increments, five-year bands, ten-year bands, custom bands, or not applicable if age rating is not used).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tobaccoRatingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Tobacco Rating Allowed Flag' ;
    rdfs:comment 'Indicates whether premium surcharges for tobacco use are permitted under this rate schedule type, subject to regulatory limits (e.g., ACA 1.5:1 tobacco ratio).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tobaccoSurchargeMaxRatio rdf:type rdf:Property ;
    rdfs:label 'Tobacco Surcharge Max Ratio' ;
    rdfs:comment 'Maximum allowable ratio for tobacco use surcharges (e.g., 1.50 represents a 50% surcharge limit under ACA regulations).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicRatingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Geographic Rating Allowed Flag' ;
    rdfs:comment 'Indicates whether premium variation based on geographic location (rating areas, ZIP codes, counties) is permitted under this rate schedule type.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geographicGranularity rdf:type rdf:Property ;
    rdfs:label 'Geographic Granularity' ;
    rdfs:comment 'Level of geographic detail used for rating purposes (state-level, rating area, county, ZIP code, Metropolitan Statistical Area, multi-state region, or not applicable).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:familyTierStructure rdf:type rdf:Property ;
    rdfs:label 'Family Tier Structure' ;
    rdfs:comment 'Structure of family coverage tiers used in rating (two-tier: employee/family; three-tier: employee/employee+spouse/employee+children/family; four-tier: employee/employee+spouse/employee+children/family; five-tier or six-tier for more granular structures; composite for single blended rate; or not applicable).' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupSizeRatingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Group Size Rating Allowed Flag' ;
    rdfs:comment 'Indicates whether premium variation based on employer group size (number of enrolled employees or eligible employees) is permitted under this rate schedule type.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:groupSizeThresholdMin rdf:type rdf:Property ;
    rdfs:label 'Group Size Threshold Min' ;
    rdfs:comment 'Minimum group size (number of employees) for which this rate schedule type applies, often 1 for small group or 51 for large group markets.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:groupSizeThresholdMax rdf:type rdf:Property ;
    rdfs:label 'Group Size Threshold Max' ;
    rdfs:comment 'Maximum group size (number of employees) for which this rate schedule type applies, often 50 for small group or unlimited for large group markets.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:industryClassRatingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Industry Class Rating Allowed Flag' ;
    rdfs:comment 'Indicates whether premium variation based on employer industry classification (SIC or NAICS codes) is permitted under this rate schedule type.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:participationRateFactorFlag rdf:type rdf:Property ;
    rdfs:label 'Participation Rate Factor Flag' ;
    rdfs:comment 'Indicates whether employee participation rate (percentage of eligible employees enrolling) is used as a rating factor in this schedule type.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contributionStrategyFactorFlag rdf:type rdf:Property ;
    rdfs:label 'Contribution Strategy Factor Flag' ;
    rdfs:comment 'Indicates whether employer contribution level (percentage of premium paid by employer) is used as a rating factor in this schedule type.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:experienceRatingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Experience Rating Allowed Flag' ;
    rdfs:comment 'Indicates whether premium rates can be adjusted based on the group\'s historical claims experience (typically allowed for large groups, restricted for small groups under ACA).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communityRatingFlag rdf:type rdf:Property ;
    rdfs:label 'Community Rating Flag' ;
    rdfs:comment 'Indicates whether this rate schedule uses pure community rating where all members in a geographic area pay the same rate regardless of health status, age (except ACA-permitted factors), or other characteristics.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adjustedCommunityRatingFlag rdf:type rdf:Property ;
    rdfs:label 'Adjusted Community Rating Flag' ;
    rdfs:comment 'Indicates whether this rate schedule uses adjusted community rating where base community rates are modified by permissible factors such as age, tobacco use, geography, and family composition.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compositeRatingFlag rdf:type rdf:Property ;
    rdfs:label 'Composite Rating Flag' ;
    rdfs:comment 'Indicates whether this rate schedule uses composite rating where a single blended rate applies to all covered members regardless of age, family status, or other demographic factors.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateGuaranteePeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Rate Guarantee Period Months' ;
    rdfs:comment 'Number of months for which rates under this schedule type are guaranteed without change, typically 12 months for annual contracts or 24 months for multi-year agreements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rateAdjustmentFrequency rdf:type rdf:Property ;
    rdfs:label 'Rate Adjustment Frequency' ;
    rdfs:comment 'Frequency at which rates under this schedule type can be adjusted (monthly, quarterly, semi-annually, annually, every two years, only at renewal, or not applicable for guaranteed rates).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manualRateBasis rdf:type rdf:Property ;
    rdfs:label 'Manual Rate Basis' ;
    rdfs:comment 'Basis for calculating manual rates in this schedule type (Per Member Per Month, Per Employee Per Month, per contract, per subscriber, per covered life, or not applicable).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rafApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Raf Applicable Flag' ;
    rdfs:comment 'Indicates whether Risk Adjustment Factor scoring is applied in this rate schedule type, typically used for Medicare Advantage and ACA marketplace plans.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateFilingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Filing Required Flag' ;
    rdfs:comment 'Indicates whether rates under this schedule type must be filed with and approved by state insurance departments or CMS before use.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateReviewThresholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Rate Review Threshold Percentage' ;
    rdfs:comment 'Percentage increase threshold that triggers regulatory rate review (e.g., 10% annual increase under ACA rate review provisions).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actuarialCertificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Actuarial Certification Required Flag' ;
    rdfs:comment 'Indicates whether an actuarial certification is required for rates developed under this schedule type, typically required for filed rates and ACA-compliant products.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credibilityThreshold rdf:type rdf:Property ;
    rdfs:label 'Credibility Threshold' ;
    rdfs:comment 'Minimum credibility factor (0.00 to 1.00) required for experience rating, indicating the statistical reliability of the group\'s claims experience for rate-setting purposes.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:poolingPointAmount rdf:type rdf:Property ;
    rdfs:label 'Pooling Point Amount' ;
    rdfs:comment 'Dollar threshold above which individual large claims are pooled and excluded from experience rating calculations to protect against catastrophic claim volatility.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trendFactorPercentage rdf:type rdf:Property ;
    rdfs:label 'Trend Factor Percentage' ;
    rdfs:comment 'Annual medical cost trend percentage applied in rate projections for this schedule type, reflecting expected healthcare cost inflation.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:administrativeLoadPercentage rdf:type rdf:Property ;
    rdfs:label 'Administrative Load Percentage' ;
    rdfs:comment 'Percentage of premium allocated to administrative expenses, commissions, and profit margin in this rate schedule type.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionPercentage rdf:type rdf:Property ;
    rdfs:label 'Commission Percentage' ;
    rdfs:comment 'Standard broker or agent commission percentage included in rates under this schedule type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryApprovalNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Number' ;
    rdfs:comment 'State insurance department or CMS approval number or SERFF tracking number for this rate schedule type, if regulatory filing was required.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedStates rdf:type rdf:Property ;
    rdfs:label 'Approved States' ;
    rdfs:comment 'Comma-separated list of state postal codes where this rate schedule type has been approved for use (e.g., \'CA,NY,TX,FL\').' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsApprovedFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Approved Flag' ;
    rdfs:comment 'Indicates whether this rate schedule type has been approved by CMS for use with Medicare Advantage, Part D, or federally facilitated marketplace products.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exchangeCertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Exchange Certified Flag' ;
    rdfs:comment 'Indicates whether this rate schedule type is certified for use with ACA health insurance exchange/marketplace products.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costSharingReductionVariant rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Reduction Variant' ;
    rdfs:comment 'Cost-sharing reduction variant for ACA marketplace silver plans (standard, 73% AV, 87% AV, 94% AV for low-income enrollees, or not applicable).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aptcEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Aptc Eligible Flag' ;
    rdfs:comment 'Indicates whether rates under this schedule type are eligible for federal Advanced Premium Tax Credits on ACA marketplaces.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateDevelopmentMethod rdf:type rdf:Property ;
    rdfs:label 'Rate Development Method' ;
    rdfs:comment 'Primary actuarial method used to develop rates under this schedule type (manual rate from book rates, experience-rated from group claims, blended manual and experience, prospective projection, retrospective adjustment, or custom methodology).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingClass rdf:type rdf:Property ;
    rdfs:label 'Underwriting Class' ;
    rdfs:comment 'Underwriting approach associated with this rate schedule type (guaranteed issue with no health questions, medical underwriting with health screening, simplified issue with limited questions, or not applicable).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preExistingConditionExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Pre Existing Condition Exclusion Flag' ;
    rdfs:comment 'Indicates whether pre-existing condition exclusions are permitted under this rate schedule type (prohibited for ACA-compliant plans, may be allowed for grandfathered or excepted benefit plans).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalRatingMethod rdf:type rdf:Property ;
    rdfs:label 'Renewal Rating Method' ;
    rdfs:comment 'Method by which rates are adjusted at renewal (guaranteed renewable with rate class adjustments only, conditionally renewable with individual adjustments, optionally renewable, non-renewable, or not applicable).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateStabilityMechanism rdf:type rdf:Property ;
    rdfs:label 'Rate Stability Mechanism' ;
    rdfs:comment 'Mechanism used to stabilize rates and manage volatility (rate cap limiting increases, rate collar with min/max bounds, experience refund for favorable claims, retrospective premium adjustment, or none).' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCapPercentage rdf:type rdf:Property ;
    rdfs:label 'Rate Cap Percentage' ;
    rdfs:comment 'Maximum percentage by which rates can increase at renewal under this schedule type, if a rate cap mechanism is in place.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Premium Amount' ;
    rdfs:comment 'Minimum total premium amount required for a group to qualify for this rate schedule type, often used for small group minimum premium requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumEnrollmentCount rdf:type rdf:Property ;
    rdfs:label 'Minimum Enrollment Count' ;
    rdfs:comment 'Minimum number of enrolled members required for a group to qualify for this rate schedule type.' ;
    rdfs:domain ind:RateScheduleType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxonomyId rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Id' ;
    rdfs:comment 'Unique identifier for the provider taxonomy code record.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Taxonomy .

ind:classification rdf:type rdf:Property ;
    rdfs:label 'Classification' ;
    rdfs:comment 'The broad classification category of the provider taxonomy, such as Physician, Hospital, Behavioral Health, or Ancillary Service Provider.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialization rdf:type rdf:Property ;
    rdfs:label 'Specialization' ;
    rdfs:comment 'The specific area of specialization within the classification, such as Cardiology, Orthopedic Surgery, or Family Medicine.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:definition rdf:type rdf:Property ;
    rdfs:label 'Definition' ;
    rdfs:comment 'The official definition and description of the taxonomy code as defined by the National Uniform Claim Committee.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grouping rdf:type rdf:Property ;
    rdfs:label 'Grouping' ;
    rdfs:comment 'The high-level grouping category for the taxonomy code, such as Allopathic & Osteopathic Physicians, Dental Providers, or Hospitals.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseRequired rdf:type rdf:Property ;
    rdfs:label 'License Required' ;
    rdfs:comment 'Indicates whether a professional license is required for providers classified under this taxonomy code.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardCertificationAvailable rdf:type rdf:Property ;
    rdfs:label 'Board Certification Available' ;
    rdfs:comment 'Indicates whether board certification is available for this taxonomy specialization through recognized medical boards.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primarySpecialtyIndicator rdf:type rdf:Property ;
    rdfs:label 'Primary Specialty Indicator' ;
    rdfs:comment 'Indicates whether this taxonomy code can be designated as a provider\'s primary specialty for credentialing and network participation purposes.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pcpEligible rdf:type rdf:Property ;
    rdfs:label 'Pcp Eligible' ;
    rdfs:comment 'Indicates whether providers with this taxonomy code are eligible to serve as Primary Care Physicians for Health Maintenance Organization (HMO) and Point of Service (POS) members.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialistIndicator rdf:type rdf:Property ;
    rdfs:label 'Specialist Indicator' ;
    rdfs:comment 'Indicates whether this taxonomy code represents a specialist provider type that typically requires referrals or prior authorization.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthIndicator rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Indicator' ;
    rdfs:comment 'Indicates whether this taxonomy code represents a behavioral health or mental health provider subject to Mental Health Parity and Addiction Equity Act (MHPAEA) requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dmeProviderIndicator rdf:type rdf:Property ;
    rdfs:label 'Dme Provider Indicator' ;
    rdfs:comment 'Indicates whether this taxonomy code represents a Durable Medical Equipment provider subject to specific billing and coverage rules.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facilityBasedIndicator rdf:type rdf:Property ;
    rdfs:label 'Facility Based Indicator' ;
    rdfs:comment 'Indicates whether this taxonomy code represents a facility-based provider such as a hospital, skilled nursing facility, or ambulatory surgery center.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ancillaryServiceIndicator rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Indicator' ;
    rdfs:comment 'Indicates whether this taxonomy code represents an ancillary service provider such as laboratory, radiology, or home health services.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareEligible rdf:type rdf:Property ;
    rdfs:label 'Medicare Eligible' ;
    rdfs:comment 'Indicates whether providers with this taxonomy code are eligible to participate in Medicare Advantage (MA) and Medicare Part D networks.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidEligible rdf:type rdf:Property ;
    rdfs:label 'Medicaid Eligible' ;
    rdfs:comment 'Indicates whether providers with this taxonomy code are eligible to participate in Medicaid managed care networks.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaEssentialHealthBenefit rdf:type rdf:Property ;
    rdfs:label 'Aca Essential Health Benefit' ;
    rdfs:comment 'Indicates whether services provided under this taxonomy code are considered Essential Health Benefits under the Affordable Care Act for Qualified Health Plan (QHP) network adequacy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkAdequacyCategory rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Category' ;
    rdfs:comment 'The network adequacy category used for regulatory reporting to state departments of insurance and Centers for Medicare and Medicaid Services (CMS) to ensure sufficient provider access.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisReportingCategory rdf:type rdf:Property ;
    rdfs:label 'Hedis Reporting Category' ;
    rdfs:comment 'The Healthcare Effectiveness Data and Information Set reporting category for quality measure attribution and National Committee for Quality Assurance (NCQA) accreditation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingPriority rdf:type rdf:Property ;
    rdfs:label 'Credentialing Priority' ;
    rdfs:comment 'The priority level assigned for credentialing and recredentialing activities based on provider type and regulatory requirements.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directoryDisplayPriority rdf:type rdf:Property ;
    rdfs:label 'Directory Display Priority' ;
    rdfs:comment 'The display priority ranking for this taxonomy code in member-facing provider directories and search results, with lower numbers indicating higher priority.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimsProcessingCategory rdf:type rdf:Property ;
    rdfs:label 'Claims Processing Category' ;
    rdfs:comment 'The claims processing category that determines which adjudication rules and Electronic Data Interchange (EDI) transaction formats apply to claims from providers with this taxonomy code.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npiEnumerationType rdf:type rdf:Property ;
    rdfs:label 'Npi Enumeration Type' ;
    rdfs:comment 'The National Provider Identifier enumeration type applicable to this taxonomy code: NPI-1 for individual providers, NPI-2 for organizational providers, or both.' ;
    rdfs:domain ind:Taxonomy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caqhApplicable rdf:type rdf:Property ;
    rdfs:label 'Caqh Applicable' ;
    rdfs:comment 'Indicates whether providers with this taxonomy code can use the Council for Affordable Quality Healthcare (CAQH) ProView system for credentialing data collection.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialtyId rdf:type rdf:Property ;
    rdfs:label 'Specialty Id' ;
    rdfs:comment 'Unique identifier for the provider specialty classification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specialty .

ind:taxonomyCode rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Code' ;
    rdfs:comment 'National Uniform Claim Committee (NUCC) 10-character taxonomy code that classifies provider type, classification, and specialization area.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomyClassification rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Classification' ;
    rdfs:comment 'The classification level within the taxonomy hierarchy (e.g., Allopathic & Osteopathic Physicians, Behavioral Health & Social Service Providers).' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomySpecialization rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Specialization' ;
    rdfs:comment 'The specialization level within the taxonomy hierarchy providing granular detail on the area of clinical expertise.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardCertificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Board Certification Required Flag' ;
    rdfs:comment 'Indicates whether board certification is required for providers practicing in this specialty for network participation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardCertificationBody rdf:type rdf:Property ;
    rdfs:label 'Board Certification Body' ;
    rdfs:comment 'Name of the recognized board certification organization for this specialty (e.g., American Board of Internal Medicine, American Board of Surgery).' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCareFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Care Flag' ;
    rdfs:comment 'Indicates whether this specialty qualifies as a Primary Care Provider (PCP) designation for member assignment and referral management.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeDistanceStandardMinutes rdf:type rdf:Property ;
    rdfs:label 'Time Distance Standard Minutes' ;
    rdfs:comment 'Maximum travel time in minutes required for network adequacy compliance for this specialty type in urban/rural settings.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providerToMemberRatioStandard rdf:type rdf:Property ;
    rdfs:label 'Provider To Member Ratio Standard' ;
    rdfs:comment 'Required provider-to-member ratio for network adequacy compliance for this specialty (e.g., 1:2000 for primary care).' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recredentialingCycleMonths rdf:type rdf:Property ;
    rdfs:label 'Recredentialing Cycle Months' ;
    rdfs:comment 'Standard recredentialing cycle period in months for providers in this specialty (typically 24 or 36 months).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:telehealthEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Telehealth Eligible Flag' ;
    rdfs:comment 'Indicates whether services provided by this specialty are eligible for telehealth delivery and reimbursement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthFlag rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Flag' ;
    rdfs:comment 'Indicates whether this specialty is classified as behavioral health or mental health for parity compliance and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substanceUseDisorderFlag rdf:type rdf:Property ;
    rdfs:label 'Substance Use Disorder Flag' ;
    rdfs:comment 'Indicates whether this specialty provides substance use disorder treatment services for parity compliance and network adequacy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedisReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Hedis Reportable Flag' ;
    rdfs:comment 'Indicates whether services provided by this specialty are included in HEDIS quality measure reporting and performance evaluation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Applicable Flag' ;
    rdfs:comment 'Indicates whether this specialty is subject to quality measurement programs and performance-based reimbursement models.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueBasedCareEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Value Based Care Eligible Flag' ;
    rdfs:comment 'Indicates whether providers in this specialty are eligible to participate in value-based care arrangements and alternative payment models.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveCareFlag rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Flag' ;
    rdfs:comment 'Indicates whether this specialty primarily provides preventive care services that are covered at 100% under ACA preventive care mandates.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareAdvantageEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Medicare Advantage Eligible Flag' ;
    rdfs:comment 'Indicates whether this specialty is eligible for Medicare Advantage network participation and reimbursement.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Medicaid Eligible Flag' ;
    rdfs:comment 'Indicates whether this specialty is eligible for Medicaid managed care network participation and reimbursement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Commercial Eligible Flag' ;
    rdfs:comment 'Indicates whether this specialty is eligible for commercial insurance product network participation.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketplaceEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Marketplace Eligible Flag' ;
    rdfs:comment 'Indicates whether this specialty is eligible for ACA marketplace qualified health plan (QHP) network participation.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dmeProviderFlag rdf:type rdf:Property ;
    rdfs:label 'Dme Provider Flag' ;
    rdfs:comment 'Indicates whether this specialty classification includes durable medical equipment providers.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facilityBasedFlag rdf:type rdf:Property ;
    rdfs:label 'Facility Based Flag' ;
    rdfs:comment 'Indicates whether this specialty represents a facility-based provider type (hospital, SNF, clinic) rather than an individual practitioner.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ancillaryServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Flag' ;
    rdfs:comment 'Indicates whether this specialty provides ancillary services (lab, imaging, therapy) rather than direct patient care.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:highCostSpecialtyFlag rdf:type rdf:Property ;
    rdfs:label 'High Cost Specialty Flag' ;
    rdfs:comment 'Indicates whether this specialty is classified as high-cost for utilization management and cost containment strategies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careManagementEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Care Management Eligible Flag' ;
    rdfs:comment 'Indicates whether providers in this specialty are eligible to participate in care management and disease management programs.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chronicConditionFocusFlag rdf:type rdf:Property ;
    rdfs:label 'Chronic Condition Focus Flag' ;
    rdfs:comment 'Indicates whether this specialty primarily treats chronic conditions for special needs plan (SNP) network adequacy and care coordination.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyServicesFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Services Flag' ;
    rdfs:comment 'Indicates whether this specialty provides emergency services subject to prudent layperson standard and No Surprises Act protections.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfNetworkEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Eligible Flag' ;
    rdfs:comment 'Indicates whether this specialty is eligible for out-of-network reimbursement under certain plan designs (PPO, POS).' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:directoryDisplayFlag rdf:type rdf:Property ;
    rdfs:label 'Directory Display Flag' ;
    rdfs:comment 'Indicates whether this specialty should be displayed in member-facing provider directories and search tools.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:searchKeywords rdf:type rdf:Property ;
    rdfs:label 'Search Keywords' ;
    rdfs:comment 'Comma-separated list of search keywords and synonyms to improve provider directory search functionality for this specialty.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentSpecialtyCode rdf:type rdf:Property ;
    rdfs:label 'Parent Specialty Code' ;
    rdfs:comment 'Code of the parent specialty in a hierarchical specialty classification structure for rollup reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reimbursementTier rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Tier' ;
    rdfs:comment 'Reimbursement tier classification for this specialty used in tiered network designs and differential payment strategies.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relativeValueUnitMultiplier rdf:type rdf:Property ;
    rdfs:label 'Relative Value Unit Multiplier' ;
    rdfs:comment 'Multiplier applied to relative value units for reimbursement calculation specific to this specialty classification.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalCode rdf:type rdf:Property ;
    rdfs:label 'External Code' ;
    rdfs:comment 'External specialty code used by partner systems, clearinghouses, or regulatory bodies for data exchange and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsSpecialtyCode rdf:type rdf:Property ;
    rdfs:label 'Cms Specialty Code' ;
    rdfs:comment 'Two-digit CMS specialty code used for Medicare claims submission and provider enrollment.' ;
    rdfs:domain ind:Specialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralNetworkId rdf:type rdf:Property ;
    rdfs:label 'Referral Network Id' ;
    rdfs:comment 'Unique identifier for the referral network transaction record.' ;
    rdfs:domain ind:ReferralNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Source Provider Npi' ;
    rdfs:comment 'National Provider Identifier of the referring provider who initiated the referral.' ;
    rdfs:domain ind:ReferralNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceProviderTin rdf:type rdf:Property ;
    rdfs:label 'Source Provider Tin' ;
    rdfs:comment 'Tax Identification Number of the referring provider\'s practice or organization.' ;
    rdfs:domain ind:ReferralNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceProviderTaxonomyCode rdf:type rdf:Property ;
    rdfs:label 'Source Provider Taxonomy Code' ;
    rdfs:comment 'Healthcare Provider Taxonomy Code identifying the specialty and classification of the referring provider.' ;
