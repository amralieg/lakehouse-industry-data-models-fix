    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:turnaroundTimeDays rdf:type rdf:Property ;
    rdfs:label 'Turnaround Time Days' ;
    rdfs:comment 'The number of days between claim receipt and adjudication, used to measure processing efficiency.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interestAmount rdf:type rdf:Property ;
    rdfs:label 'Interest Amount' ;
    rdfs:comment 'The amount of interest paid to the provider for late payment beyond the prompt pay timeframe.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineId rdf:type rdf:Property ;
    rdfs:label 'Line Id' ;
    rdfs:comment 'Unique identifier for the individual service line within a claim. Primary key for the claim line entity.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Sequential number identifying the order of this service line within the claim. Used to maintain line ordering and uniqueness within a claim.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:procedureCodeType rdf:type rdf:Property ;
    rdfs:label 'Procedure Code Type' ;
    rdfs:comment 'The coding system used for the procedure code. Identifies whether the code is CPT, HCPCS, ICD-10-PCS (for inpatient procedures), CDT (dental), or NDC (pharmacy).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifier1 rdf:type rdf:Property ;
    rdfs:label 'Modifier 1' ;
    rdfs:comment 'First procedure code modifier providing additional information about the service performed (e.g., bilateral procedure, multiple procedures, assistant surgeon).' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifier2 rdf:type rdf:Property ;
    rdfs:label 'Modifier 2' ;
    rdfs:comment 'Second procedure code modifier providing additional information about the service performed.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifier3 rdf:type rdf:Property ;
    rdfs:label 'Modifier 3' ;
    rdfs:comment 'Third procedure code modifier providing additional information about the service performed.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifier4 rdf:type rdf:Property ;
    rdfs:label 'Modifier 4' ;
    rdfs:comment 'Fourth procedure code modifier providing additional information about the service performed.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCode2 rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code 2' ;
    rdfs:comment 'Second diagnosis code associated with this service line, providing additional clinical context.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCode3 rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code 3' ;
    rdfs:comment 'Third diagnosis code associated with this service line, providing additional clinical context.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCode4 rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code 4' ;
    rdfs:comment 'Fourth diagnosis code associated with this service line, providing additional clinical context.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceUnits rdf:type rdf:Property ;
    rdfs:label 'Service Units' ;
    rdfs:comment 'The quantity of services or units provided for this line item (e.g., number of visits, days, miles, units of anesthesia).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitType rdf:type rdf:Property ;
    rdfs:label 'Unit Type' ;
    rdfs:comment 'The type of unit being measured for service units (e.g., UN=Unit, MJ=Minutes, DA=Days, HR=Hours, MI=Miles, FL=Floor, VS=Visit).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billedAmount rdf:type rdf:Property ;
    rdfs:label 'Billed Amount' ;
    rdfs:comment 'The total amount billed by the provider for this service line before any adjustments or payments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allowedAmount rdf:type rdf:Property ;
    rdfs:label 'Allowed Amount' ;
    rdfs:comment 'The maximum amount the health plan will reimburse for this service line based on contracted rates, fee schedules, or usual and customary charges.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Amount' ;
    rdfs:comment 'The actual amount paid by the health plan to the provider for this service line after all adjustments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remarkCode rdf:type rdf:Property ;
    rdfs:label 'Remark Code' ;
    rdfs:comment 'Additional remark code providing supplemental information about the line adjudication. Maps to standard remittance advice remark codes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renderingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Rendering Provider Npi' ;
    rdfs:comment 'The National Provider Identifier of the individual provider who rendered the service for this line.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renderingProviderName rdf:type rdf:Property ;
    rdfs:label 'Rendering Provider Name' ;
    rdfs:comment 'The name of the individual provider who rendered the service for this line.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renderingProviderSpecialty rdf:type rdf:Property ;
    rdfs:label 'Rendering Provider Specialty' ;
    rdfs:comment 'The medical specialty or taxonomy code of the rendering provider for this service line.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apcCode rdf:type rdf:Property ;
    rdfs:label 'Apc Code' ;
    rdfs:comment 'The APC code assigned to this service line for outpatient hospital claims, used for prospective payment system reimbursement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndcCode rdf:type rdf:Property ;
    rdfs:label 'Ndc Code' ;
    rdfs:comment 'The 11-digit National Drug Code identifying the specific drug product dispensed for pharmacy claims.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
