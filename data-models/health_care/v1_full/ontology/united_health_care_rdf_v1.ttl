    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFwaDetectionEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Fwa Detection Enabled' ;
    rdfs:comment 'Flag indicating if fraud, waste, and abuse detection is active for the plan.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
