Table compliance.broadcast_license {
  broadcast_license_id varchar [pk, note: 'Unique identifier for the broadcast license record. Primary key for the broadcast license entity. | Column broadcast_license_id (BIGINT) in compliance.broadcast_license']
  broadcast_facility_id varchar [note: 'Unique facility identifier assigned by the regulatory authority to distinguish between multiple licenses held by the same licensee or at the same location. | Column broadcast_facility_id (BIGINT) in technology.broadcast_license']
  responsible_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: FCC broadcast licenses require a designated responsible party employee for regulatory accountability and correspondence. Licensee contact information should reference employee record rather than dupli | Column responsible_employee_id (BIGINT) in workforce.broadcast_license']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: FCC licenses authorize specific transmission equipment operation. Compliance audits require equipment-level tracking for power output, frequency, and technical parameter verification. Real-world Form  | Column transmission_equipment_id (BIGINT) in technology.broadcast_license']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.broadcast_license']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.broadcast_license']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.broadcast_license']
  annual_fee_amount decimal(12,2) [note: 'Annual regulatory fee assessed by the governing authority for maintaining this broadcast license. | Column annual_fee_amount (DECIMAL(12,2)) in compliance.broadcast_license']
  antenna_height_meters decimal(10,2) [note: 'Height of the transmitting antenna above average terrain, measured in meters. Critical factor in determining coverage area. | Column antenna_height_meters (DECIMAL(10,2)) in compliance.broadcast_license']
  broadcast_license_status varchar [note: 'Current lifecycle status of the broadcast license indicating its operational validity and regulatory standing. [ENUM-REF-CANDIDATE: Active|Pending|Suspended|Expired|Revoked|Cancelled|Under Renewal — 7 candidates stripped; promote to reference product] | Column broadcast_license_status (STRING) in compliance.broadcast_license']
  call_sign varchar [note: 'Unique station identifier assigned by the regulatory authority (e.g., WABC, KPIX-TV). Used for station identification during broadcasts. | Column call_sign (STRING) in compliance.broadcast_license']
  channel_number varchar [note: 'Assigned broadcast channel number for television licenses (e.g., Channel 2, Channel 7). May include virtual channel numbers for digital broadcasts. | Column channel_number (STRING) in compliance.broadcast_license']
  closed_captioning_required boolean [note: 'Indicates whether this license requires closed captioning for accessibility compliance. | Column closed_captioning_required (BOOLEAN) in compliance.broadcast_license']
  community_of_license varchar [note: 'City or community that the broadcast station is licensed to serve. Determines local content and public interest obligations. | Column community_of_license (STRING) in compliance.broadcast_license']
  compliance_obligations varchar [note: 'Summary of specific regulatory compliance requirements attached to this license (e.g., closed captioning, EAS participation, local content quotas, children\'s programming). | Column compliance_obligations (STRING) in compliance.broadcast_license']
  coverage_area_contour varchar [note: 'Geographic boundary of the licensed coverage area, typically defined by signal strength contours (e.g., 60 dBu for FM, Grade A/B for TV). May be expressed as coordinates or geographic description. | Column coverage_area_contour (STRING) in compliance.broadcast_license']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.broadcast_license']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  eas_participation_required boolean [note: 'Indicates whether this license requires participation in the Emergency Alert System for public safety broadcasts. | Column eas_participation_required (BOOLEAN) in compliance.broadcast_license']
  effective_date date [note: 'Date when the broadcast license becomes legally effective and operational broadcasting is authorized. | Column effective_date (DATE) in compliance.broadcast_license']
  expiration_date date [note: 'Date when the current license term expires and renewal is required to continue operations. | Column expiration_date (DATE) in compliance.broadcast_license']
  frequency_band varchar [note: 'Spectrum frequency band allocated to this license (e.g., 88.1 MHz for FM, 470-608 MHz for UHF TV). Expressed in MHz or GHz. | Column frequency_band (STRING) in compliance.broadcast_license']
  grant_date date [note: 'Date when the broadcast license was originally granted or issued by the regulatory authority. | Column grant_date (DATE) in compliance.broadcast_license']
  jurisdiction_country_code varchar [note: 'Three-letter ISO country code of the jurisdiction where this license is valid (e.g., USA, GBR, AUS). | Column jurisdiction_country_code (STRING) in compliance.broadcast_license']
  last_inspection_date date [note: 'Date of the most recent regulatory inspection or audit of the licensed facility and operations. | Column last_inspection_date (DATE) in compliance.broadcast_license']
  last_modification_date date [note: 'Date of the most recent modification or amendment to the license terms, technical parameters, or ownership. | Column last_modification_date (DATE) in compliance.broadcast_license']
  license_class varchar [note: 'Regulatory classification of the license indicating power level, coverage area, and operational constraints (e.g., Class A, Class B, Class C for FM; Full-Power, Low-Power for TV). | Column license_class (STRING) in compliance.broadcast_license']
  license_number varchar [note: 'Official license number or authorization code issued by the regulatory authority. This is the externally-known unique identifier for the broadcast license. | Column license_number (STRING) in compliance.broadcast_license']
  license_type varchar [note: 'Classification of the broadcast license by service type and transmission technology. [ENUM-REF-CANDIDATE: AM Radio|FM Radio|TV Full-Power|TV Low-Power|TV Translator|Satellite|Cable Franchise|IPTV — 8 candidates stripped; promote to reference product] | Column license_type (STRING) in compliance.broadcast_license']
  licensee_type varchar [note: 'Legal structure of the licensee organization. | Column licensee_type (STRING) in compliance.broadcast_license']
  modification_type varchar [note: 'Nature of the most recent license modification (e.g., Technical Change, Ownership Transfer, Power Increase, Frequency Change). | Column modification_type (STRING) in compliance.broadcast_license']
  notes varchar [note: 'Additional notes, conditions, or special provisions attached to this broadcast license by the regulatory authority. | Column notes (STRING) in compliance.broadcast_license']
  ownership_attribution varchar [note: 'Details of attributable ownership interests in the licensee entity, required for regulatory ownership reporting and concentration limits. | Column ownership_attribution (STRING) in compliance.broadcast_license']
  power_output_erp_watts decimal(12,2) [note: 'Maximum authorized effective radiated power output for the transmitter, measured in watts. Determines the coverage area and signal strength. | Column power_output_erp_watts (DECIMAL(12,2)) in compliance.broadcast_license']
  public_inspection_file_location varchar [note: 'Physical or online location where the stations public inspection file is maintained, as required by regulatory authorities. | Column public_inspection_file_location (STRING) in compliance.broadcast_license']
  regulatory_authority varchar [note: 'Governing body that issued and oversees this broadcast license (e.g., FCC for United States, Ofcom for United Kingdom). [ENUM-REF-CANDIDATE: FCC|Ofcom|ACMA|CRTC|ANATEL|IFT|Other — 7 candidates stripped; promote to reference product] | Column regulatory_authority (STRING) in compliance.broadcast_license']
  renewal_application_date date [note: 'Date when the license renewal application was filed with the regulatory authority. | Column renewal_application_date (DATE) in compliance.broadcast_license']
  renewal_status varchar [note: 'Current status of the license renewal process, tracking whether renewal application has been filed and its disposition. | Column renewal_status (STRING) in compliance.broadcast_license']
  service_type varchar [note: 'Nature of the broadcast service provided under this license, indicating the operational and content obligations. | Column service_type (STRING) in compliance.broadcast_license']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.broadcast_license']
  transmitter_address varchar [note: 'Physical street address of the licensed transmitter facility. Organizational contact data classified as confidential. | Column transmitter_address (STRING) in compliance.broadcast_license']
  transmitter_location_latitude decimal(10,7) [note: 'Geographic latitude coordinate of the licensed transmitter site in decimal degrees. | Column transmitter_location_latitude (DECIMAL(10,7)) in compliance.broadcast_license']
  transmitter_location_longitude decimal(10,7) [note: 'Geographic longitude coordinate of the licensed transmitter site in decimal degrees. | Column transmitter_location_longitude (DECIMAL(10,7)) in compliance.broadcast_license']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.broadcast_license']

  Note: 'Master record for all broadcast licenses and spectrum authorizations issued by regulatory bodies (FCC, Ofcom, ACMA, CRTC) held by the organization. Tracks license type (AM, FM, TV full-power, TV low-power, satellite, cable franchise, IPTV), call sign, facility ID, frequency band, channel number, power output (ERP), coverage area (contour), community of license, license class, grant date, expiration date, renewal status, modification history, and the governing regulatory authority. Serves as the authoritative registry of all spectrum and broadcast operating authorities and the anchor entity for per-station compliance obligations. | Unity Catalog table: media_broadcasting_ecm.compliance.broadcast_license'
}

Table compliance.license_renewal {
  license_renewal_id varchar [pk, note: 'Unique identifier for the broadcast license renewal application record. | Column license_renewal_id (BIGINT) in compliance.license_renewal']
  broadcast_license_id varchar [note: 'Reference to the underlying broadcast license being renewed. | Column broadcast_license_id (BIGINT) in compliance.license_renewal']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: License renewals ARE regulatory filings - the renewal application is submitted as a formal filing to the FCC/Ofcom. This FK links the renewal record to its regulatory filing record. Removes duplicate  | Column regulatory_filing_id (BIGINT) in compliance.license_renewal']
  responsible_party_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: FCC license renewals require named responsible employee for filing preparation and regulatory correspondence. Responsible party contact data should reference employee record. | Column responsible_party_employee_id (BIGINT) in workforce.license_renewal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.license_renewal']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.license_renewal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.license_renewal']
  approval_date date [note: 'The date the regulatory authority officially granted the license renewal. | Column approval_date (DATE) in compliance.license_renewal']
  compliance_certification_submitted boolean [note: 'Indicates whether the required compliance certifications (EEO, children\'s programming, political file, etc.) were submitted as part of the renewal application. | Column compliance_certification_submitted (BOOLEAN) in compliance.license_renewal']
  conditions_imposed varchar [note: 'Any special conditions, restrictions, or requirements imposed by the regulatory authority as part of the renewal grant (e.g., compliance reporting, technical upgrades, programming commitments). | Column conditions_imposed (STRING) in compliance.license_renewal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.license_renewal']
  created_timestamp timestamp [note: 'The timestamp when this license renewal record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.license_renewal']
  denial_date date [note: 'The date the regulatory authority officially denied the license renewal application. | Column denial_date (DATE) in compliance.license_renewal']
  denial_reason varchar [note: 'The regulatory authority\'s stated reason for denying the license renewal (e.g., failure to meet public interest standard, character qualifications, technical violations). | Column denial_reason (STRING) in compliance.license_renewal']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  fee_payment_date date [note: 'The date the renewal filing fee was paid to the regulatory authority. | Column fee_payment_date (DATE) in compliance.license_renewal']
  fee_payment_status varchar [note: 'The current status of the renewal fee payment obligation. | Column fee_payment_status (STRING) in compliance.license_renewal']
  filing_deadline date [note: 'The regulatory deadline by which the renewal application must be submitted to avoid license lapse (typically 4 months prior to expiration for FCC). | Column filing_deadline (DATE) in compliance.license_renewal']
  final_disposition varchar [note: 'The ultimate outcome of the license renewal application process. | Column final_disposition (STRING) in compliance.license_renewal']
  last_modified_timestamp timestamp [note: 'The timestamp when this license renewal record was most recently updated. | Column last_modified_timestamp (TIMESTAMP) in compliance.license_renewal']
  license_type varchar [note: 'The category of broadcast license being renewed (television station, radio station, cable system, satellite carrier, Multichannel Video Programming Distributor). | Column license_type (STRING) in compliance.license_renewal']
  new_license_term_end_date date [note: 'The expiration date of the renewed license term, establishing the next renewal cycle. | Column new_license_term_end_date (DATE) in compliance.license_renewal']
  new_license_term_start_date date [note: 'The effective start date of the renewed license term following approval. | Column new_license_term_start_date (DATE) in compliance.license_renewal']
  notes varchar [note: 'Free-text notes capturing additional context, issues, or observations related to the renewal application process. | Column notes (STRING) in compliance.license_renewal']
  petition_count varchar [note: 'The total number of petitions to deny filed against this renewal application. | Column petition_count (INT) in compliance.license_renewal']
  petition_to_deny_filed boolean [note: 'Indicates whether any party filed a formal petition to deny the license renewal during the public comment period. | Column petition_to_deny_filed (BOOLEAN) in compliance.license_renewal']
  public_comment_deadline date [note: 'The deadline by which the public may file comments or petitions to deny the renewal application. | Column public_comment_deadline (DATE) in compliance.license_renewal']
  public_inspection_file_updated boolean [note: 'Indicates whether the station\'s public inspection file has been updated with the renewal application and related documents as required by regulation. | Column public_inspection_file_updated (BOOLEAN) in compliance.license_renewal']
  public_notice_date date [note: 'The date the regulatory body published public notice of the renewal application, opening the period for public comment and petitions to deny. | Column public_notice_date (DATE) in compliance.license_renewal']
  regulatory_body varchar [note: 'The governing regulatory authority to which the renewal application is submitted (Federal Communications Commission, Office of Communications, etc.). | Column regulatory_body (STRING) in compliance.license_renewal']
  renewal_cycle_end_date date [note: 'The date marking the expiration of the current license term, triggering the renewal requirement. | Column renewal_cycle_end_date (DATE) in compliance.license_renewal']
  renewal_cycle_start_date date [note: 'The date marking the beginning of the current license term that is subject to renewal. | Column renewal_cycle_start_date (DATE) in compliance.license_renewal']
  renewal_fee_amount decimal(15,2) [note: 'The regulatory filing fee amount required for processing the license renewal application. | Column renewal_fee_amount (DECIMAL(15,2)) in compliance.license_renewal']
  renewal_fee_currency varchar [note: 'The three-letter ISO 4217 currency code for the renewal fee (e.g., USD, GBP, CAD). | Column renewal_fee_currency (STRING) in compliance.license_renewal']
  renewal_status varchar [note: 'Current lifecycle status of the license renewal application in the regulatory review process. [ENUM-REF-CANDIDATE: Draft|Submitted|Under Review|Public Notice Issued|Petition Filed|Approved|Denied|Withdrawn — 8 candidates stripped; promote to reference product] | Column renewal_status (STRING) in compliance.license_renewal']
  review_completion_date date [note: 'The date the regulatory authority completed its review and issued a final decision on the renewal application. | Column review_completion_date (DATE) in compliance.license_renewal']
  review_start_date date [note: 'The date the regulatory authority formally commenced substantive review of the renewal application. | Column review_start_date (DATE) in compliance.license_renewal']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.license_renewal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.license_renewal']

  Note: 'Tracks the lifecycle of broadcast license renewal applications submitted to the FCC, Ofcom, or other regulatory bodies. Captures renewal cycle, filing deadline, submission date, application status, renewal fee, public notice period, petitions to deny, and final disposition. Ensures no license lapses due to missed renewal windows. | Unity Catalog table: media_broadcasting_ecm.compliance.license_renewal'
}

Table compliance.regulatory_filing {
  regulatory_filing_id varchar [pk, note: 'Unique identifier for the regulatory filing record. Primary key. | Column regulatory_filing_id (BIGINT) in compliance.regulatory_filing']
  broadcast_facility_id varchar [note: 'The unique facility identifier assigned by the regulatory body to the broadcast station or transmission facility covered by this filing. | Column broadcast_facility_id (BIGINT) in technology.regulatory_filing']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Regulatory filings are often associated with specific broadcast licenses. The filing has license_number (STRING) which should be replaced by FK to broadcast_license. This allows joining to get call_si | Column broadcast_license_id (BIGINT) in compliance.regulatory_filing']
  filed_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Regulatory filings (FCC Form 323, 396, etc.) require audit trail of which employee submitted the filing for compliance verification and accountability. Responsible party data should reference employee | Column filed_by_employee_id (BIGINT) in workforce.regulatory_filing']
  original_filing_regulatory_filing_id varchar [note: 'Reference to the original regulatory filing identifier if this submission is an amendment or correction, establishing the lineage of filing revisions. | Column original_filing_regulatory_filing_id (BIGINT) in compliance.regulatory_filing']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: FCC Form 301/302 filings reference specific transmission equipment for power changes, frequency modifications, and technical upgrades. Real regulatory filing workflow requires equipment-level granular | Column transmission_equipment_id (BIGINT) in technology.regulatory_filing']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.regulatory_filing']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.regulatory_filing']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.regulatory_filing']
  amendment_flag boolean [note: 'Boolean indicator specifying whether this filing is an amendment or correction to a previously submitted filing. | Column amendment_flag (BOOLEAN) in compliance.regulatory_filing']
  approval_date date [note: 'The date on which the regulatory body officially approved or accepted the filing, marking successful completion of the compliance obligation. | Column approval_date (DATE) in compliance.regulatory_filing']
  audit_trail_reference varchar [note: 'Reference identifier linking this filing to detailed audit trail records capturing all preparation, review, approval, and submission activities for compliance verification. | Column audit_trail_reference (STRING) in compliance.regulatory_filing']
  ccpa_applicable boolean [note: 'Boolean indicator specifying whether this filing is subject to California Consumer Privacy Act (CCPA) viewer data privacy requirements for California residents. | Column ccpa_applicable (BOOLEAN) in compliance.regulatory_filing']
  compliance_category varchar [note: 'The primary regulatory compliance domain or category that this filing addresses, such as broadcast licensing, content standards, data privacy, financial reporting, accessibility mandates, or technical standards. | Column compliance_category (STRING) in compliance.regulatory_filing']
  confirmation_number varchar [note: 'The unique confirmation or receipt number issued by the regulatory body upon successful submission of the filing, serving as proof of receipt. | Column confirmation_number (STRING) in compliance.regulatory_filing']
  coppa_applicable boolean [note: 'Boolean indicator specifying whether this filing is subject to Children\'s Online Privacy Protection Act (COPPA) requirements for children\'s content and data collection practices. | Column coppa_applicable (BOOLEAN) in compliance.regulatory_filing']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.regulatory_filing']
  created_timestamp timestamp [note: 'The timestamp when this regulatory filing record was first created in the system, supporting audit trail and data lineage requirements. | Column created_timestamp (TIMESTAMP) in compliance.regulatory_filing']
  document_url varchar [note: 'The Uniform Resource Locator (URL) or file path to the digital copy of the filed document stored in the Media Asset Management (MAM) system or document repository. | Column document_url (STRING) in compliance.regulatory_filing']
  due_date date [note: 'The regulatory deadline by which the filing must be submitted to remain in compliance with governing body requirements. | Column due_date (DATE) in compliance.regulatory_filing']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  filing_date date [note: 'The date on which the regulatory filing was officially submitted to the governing body. This is the principal business event timestamp for the filing. | Column filing_date (DATE) in compliance.regulatory_filing']
  filing_description varchar [note: 'A detailed textual description of the filing content, purpose, and scope, providing context for the regulatory submission. | Column filing_description (STRING) in compliance.regulatory_filing']
  filing_fee_amount decimal(15,2) [note: 'The monetary fee charged by the regulatory body for processing this filing, expressed in the broadcaster\'s reporting currency. | Column filing_fee_amount (DECIMAL(15,2)) in compliance.regulatory_filing']
  filing_fee_currency varchar [note: 'The three-letter International Organization for Standardization (ISO) 4217 currency code for the filing fee amount (e.g., USD, GBP, EUR). | Column filing_fee_currency (STRING) in compliance.regulatory_filing']
  filing_number varchar [note: 'The externally-known unique filing number or reference code assigned by the broadcaster or regulatory body for tracking and identification purposes. | Column filing_number (STRING) in compliance.regulatory_filing']
  filing_status varchar [note: 'Current lifecycle status of the regulatory filing indicating its progress through the submission and approval workflow. [ENUM-REF-CANDIDATE: draft|submitted|accepted|rejected|under_review|pending_correction|completed — 7 candidates stripped; promote to reference product] | Column filing_status (STRING) in compliance.regulatory_filing']
  filing_type varchar [note: 'The category or type of regulatory filing being submitted, such as Equal Employment Opportunity (EEO) report, ownership report, political file, children\'s programming report, annual report, license renewal application, or public inspection file entry. [ENUM-REF-CANDIDATE: eeo_report|ownership_report|political_file|childrens_programming_report|annual_report|license_renewal|public_inspection_file — 7 candidates stripped; promote to reference product] | Column filing_type (STRING) in compliance.regulatory_filing']
  form_number varchar [note: 'The official form number or identifier designated by the regulatory body for this filing type (e.g., FCC Form 323, FCC Form 396, Ofcom Form 1). | Column form_number (STRING) in compliance.regulatory_filing']
  gdpr_applicable boolean [note: 'Boolean indicator specifying whether this filing is subject to General Data Protection Regulation (GDPR) data privacy and protection requirements for European Union (EU) audience data. | Column gdpr_applicable (BOOLEAN) in compliance.regulatory_filing']
  market_designation varchar [note: 'The designated market area or geographic market served by the broadcast facility, as defined by Nielsen or equivalent measurement authority. | Column market_designation (STRING) in compliance.regulatory_filing']
  modified_timestamp timestamp [note: 'The timestamp when this regulatory filing record was last modified or updated, supporting change tracking and audit requirements. | Column modified_timestamp (TIMESTAMP) in compliance.regulatory_filing']
  next_filing_due_date date [note: 'The anticipated due date for the next recurring filing of this type, supporting proactive compliance planning and calendar management. | Column next_filing_due_date (DATE) in compliance.regulatory_filing']
  payment_confirmation_number varchar [note: 'The confirmation or transaction number for the filing fee payment, linking the financial transaction to the regulatory submission. | Column payment_confirmation_number (STRING) in compliance.regulatory_filing']
  public_inspection_required boolean [note: 'Boolean indicator specifying whether this filing must be made available for public inspection as required by regulatory transparency mandates. | Column public_inspection_required (BOOLEAN) in compliance.regulatory_filing']
  regulatory_body varchar [note: 'The governing body or regulatory authority to which this filing was submitted, such as Federal Communications Commission (FCC), Office of Communications (Ofcom), Motion Picture Association (MPA), Interactive Advertising Bureau (IAB), Advanced Television Systems Committee (ATSC), Digital Video Broadcasting (DVB), Nielsen Media Research, Society of Cable Telecommunications Engineers (SCTE), International Organization for Standardization (ISO), General Data Protection Regulation (GDPR) authority, California Consumer Privacy Act (CCPA) authority, Sarbanes-Oxley Act (SOX) auditor, Payment Card Industry (PCI) council, or Children\'s Online Privacy Protection Act (COPPA) Federal Trade Commission (FTC). [ENUM-REF-CANDIDATE: fcc|ofcom|mpa|iab|atsc|dvb|nielsen|scte|iso|gdpr_authority|ccpa_authority|sox_auditor|pci_council|coppa_ftc — 14 candidates stripped; promote to reference product] | Column regulatory_body (STRING) in compliance.regulatory_filing']
  rejection_reason varchar [note: 'Detailed explanation provided by the regulatory body for rejecting or requesting corrections to the filing, guiding remediation efforts. | Column rejection_reason (STRING) in compliance.regulatory_filing']
  reporting_period_end date [note: 'The end date of the time period covered by this regulatory filing, defining the conclusion of the reporting window for compliance data. | Column reporting_period_end (DATE) in compliance.regulatory_filing']
  reporting_period_start date [note: 'The start date of the time period covered by this regulatory filing, defining the beginning of the reporting window for compliance data. | Column reporting_period_start (DATE) in compliance.regulatory_filing']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.regulatory_filing']
  sox_applicable boolean [note: 'Boolean indicator specifying whether this filing is subject to Sarbanes-Oxley Act (SOX) financial reporting and internal control requirements. | Column sox_applicable (BOOLEAN) in compliance.regulatory_filing']
  submission_method varchar [note: 'The channel or mechanism through which the filing was submitted to the regulatory body, such as online portal, email, postal mail, fax, electronic filing system, or Application Programming Interface (API). | Column submission_method (STRING) in compliance.regulatory_filing']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.regulatory_filing']

  Note: 'Authoritative record of all regulatory filings submitted to governing bodies including FCC, Ofcom, MPA, IAB, and others. Captures filing type (EEO report, ownership report, political file, children\'s programming report, annual report), form number, filing date, due date, submission method, filing status, confirmation number, and the responsible regulatory body. Supports SOX, FCC, and Ofcom compliance obligations. | Unity Catalog table: media_broadcasting_ecm.compliance.regulatory_filing'
}

Table compliance.public_inspection_file {
  public_inspection_file_id varchar [pk, note: 'Unique identifier for the public inspection file record. Primary key for the entity. Role: MASTER_RESOURCE (regulatory document repository). | Column public_inspection_file_id (BIGINT) in compliance.public_inspection_file']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Public inspection files are maintained per broadcast license per FCC requirements. Each document in the OPIF relates to a specific licensed station. This FK enables tracking which license each documen | Column broadcast_license_id (BIGINT) in compliance.public_inspection_file']
  channel_id varchar [note: 'Reference to the FCC-licensed broadcast station that owns this public inspection file. | Column channel_id (BIGINT) in scheduling.public_inspection_file']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: FCC public inspection files may reference specific program assets for political advertising records, children\'s programming reports (issues/programs lists), or sponsorship identification documentation | Column media_asset_id (BIGINT) in mediaasset.public_inspection_file']
  original_document_public_inspection_file_id varchar [note: 'If this is an amendment, reference to the original public inspection file document being amended or corrected. | Column original_document_public_inspection_file_id (BIGINT) in compliance.public_inspection_file']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Many regulatory filings must be included in the station\'s public inspection file. This FK links public file documents to their corresponding regulatory filing records, ensuring disclosure compliance. | Column regulatory_filing_id (BIGINT) in compliance.public_inspection_file']
  uploaded_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: FCC public inspection file documents require audit trail of which employee uploaded each document for compliance verification and accountability. Compliance officer name should reference employee reco | Column uploaded_by_employee_id (BIGINT) in workforce.public_inspection_file']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.public_inspection_file']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.public_inspection_file']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.public_inspection_file']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.public_inspection_file']
  created_timestamp timestamp [note: 'The date and time when this public inspection file record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.public_inspection_file']
  document_category varchar [note: 'The FCC-mandated category of the public inspection file document. Categories include political file (advertising records), EEO reports (equal employment opportunity), ownership reports, issues/programs lists, children\'s programming reports, and contour maps. | Column document_category (STRING) in compliance.public_inspection_file']
  document_description varchar [note: 'Detailed description of the document content, purpose, and any relevant context for public inspection. | Column document_description (STRING) in compliance.public_inspection_file']
  document_file_format varchar [note: 'The file format of the stored document (e.g., PDF, DOCX, XLSX). FCC typically requires PDF format for OPIF submissions. | Column document_file_format (STRING) in compliance.public_inspection_file']
  document_file_path varchar [note: 'The storage location or URI of the document file in the media asset management system or document repository. | Column document_file_path (STRING) in compliance.public_inspection_file']
  document_file_size_bytes varchar [note: 'The size of the document file in bytes. | Column document_file_size_bytes (BIGINT) in compliance.public_inspection_file']
  document_period_end_date date [note: 'The end date of the reporting period covered by this document. | Column document_period_end_date (DATE) in compliance.public_inspection_file']
  document_period_start_date date [note: 'The start date of the reporting period covered by this document (e.g., for quarterly EEO reports or issues/programs lists). | Column document_period_start_date (DATE) in compliance.public_inspection_file']
  document_title varchar [note: 'The descriptive title or name of the public inspection file document. | Column document_title (STRING) in compliance.public_inspection_file']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  fcc_opif_sync_status varchar [note: 'Synchronization status with the FCC\'s Online Public Inspection File portal. Indicates whether the document has been successfully transmitted to and accepted by the FCC system. | Column fcc_opif_sync_status (STRING) in compliance.public_inspection_file']
  fcc_opif_sync_timestamp timestamp [note: 'The date and time of the last successful synchronization with the FCC OPIF portal. | Column fcc_opif_sync_timestamp (TIMESTAMP) in compliance.public_inspection_file']
  fcc_reference_number varchar [note: 'The unique reference or confirmation number assigned by the FCC OPIF system upon successful document submission. | Column fcc_reference_number (STRING) in compliance.public_inspection_file']
  filing_date date [note: 'The date the document was filed or added to the public inspection file. This is the official date of record for compliance purposes. | Column filing_date (DATE) in compliance.public_inspection_file']
  is_amendment boolean [note: 'Indicates whether this document is an amendment or correction to a previously filed public inspection file document. | Column is_amendment (BOOLEAN) in compliance.public_inspection_file']
  last_modified_timestamp timestamp [note: 'The date and time when this public inspection file record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in compliance.public_inspection_file']
  notes varchar [note: 'Additional notes, comments, or context about the document, its filing, or any special circumstances related to compliance. | Column notes (STRING) in compliance.public_inspection_file']
  political_advertiser_name varchar [note: 'For political file documents, the name of the candidate, campaign, or political organization that purchased advertising time. Required for political file category documents. | Column political_advertiser_name (STRING) in compliance.public_inspection_file']
  political_office_sought varchar [note: 'For political file documents, the elected office being sought by the candidate (e.g., President, Senator, Governor, Mayor). | Column political_office_sought (STRING) in compliance.public_inspection_file']
  public_access_status varchar [note: 'Indicates whether the document is currently available for public inspection. Documents may be restricted during review or removed after retention period expiration. | Column public_access_status (STRING) in compliance.public_inspection_file']
  retention_expiration_date date [note: 'The date when the regulatory retention period expires and the document may be removed from the public inspection file. | Column retention_expiration_date (DATE) in compliance.public_inspection_file']
  retention_period_years varchar [note: 'The number of years this document must be retained in the public inspection file as mandated by FCC regulations. Varies by document category (e.g., 2 years for political files, 8 years for ownership reports). | Column retention_period_years (INT) in compliance.public_inspection_file']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.public_inspection_file']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.public_inspection_file']
  upload_status varchar [note: 'Current status of the document upload to the FCC OPIF (Online Public Inspection File) portal. Tracks the lifecycle from pending submission through verification and archival. | Column upload_status (STRING) in compliance.public_inspection_file']
  upload_timestamp timestamp [note: 'The date and time when the document was successfully uploaded to the FCC OPIF portal or internal public inspection file system. | Column upload_timestamp (TIMESTAMP) in compliance.public_inspection_file']
  verification_status varchar [note: 'Internal verification status indicating whether the document has been reviewed for accuracy and compliance before public posting. | Column verification_status (STRING) in compliance.public_inspection_file']
  verification_timestamp timestamp [note: 'The date and time when the document was verified for compliance and accuracy by station staff. | Column verification_timestamp (TIMESTAMP) in compliance.public_inspection_file']

  Note: 'Manages the FCC-mandated public inspection file (OPIF) for each licensed broadcast station. Tracks document categories (political file, EEO reports, ownership disclosures, children\'s programming reports, issues/programs lists, contour maps), document upload status, retention period, public access status, and FCC OPIF portal sync status. Required for all FCC-licensed stations under 47 CFR §73.3526 and §73.3527. | Unity Catalog table: media_broadcasting_ecm.compliance.public_inspection_file'
}

Table compliance.content_rating {
  content_rating_id varchar [pk, note: 'Primary key for content_rating | Column content_rating_id (BIGINT) in compliance.content_rating']
  content_title_id varchar [note: 'Reference to the content title asset that this rating applies to. | Column content_title_id (BIGINT) in content.content_rating']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Broadcasters must track content ratings (TV-MA, TV-14, etc.) for every media asset to ensure FCC compliance, parental guidance requirements, and proper scheduling. Content rating is a regulatory attri | Column media_asset_id (BIGINT) in mediaasset.content_rating']
  submitted_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Content rating submissions to MPAA, TV Parental Guidelines, or other rating authorities require tracking which employee submitted for accountability and audit trail purposes. | Column submitted_by_employee_id (BIGINT) in workforce.content_rating']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.content_rating']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.content_rating']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.content_rating']
  accessibility_rating_notes varchar [note: 'Notes regarding accessibility features relevant to the rating, such as closed captioning compliance, audio description availability, or photosensitive epilepsy warnings. | Column accessibility_rating_notes (STRING) in compliance.content_rating']
  appeal_status varchar [note: 'Status of any appeal filed by the content producer to challenge the assigned rating. Not Appealed: no appeal has been filed; Appeal Pending: appeal is under review; Appeal Approved: rating was changed following appeal; Appeal Denied: original rating upheld. | Column appeal_status (STRING) in compliance.content_rating']
  content_descriptors varchar [note: 'Comma-separated list of content advisory descriptors that explain the reasons for the rating. Examples: violence, strong language, sexual content, drug use, nudity, adult themes, frightening scenes. | Column content_descriptors (STRING) in compliance.content_rating']
  coppa_compliant boolean [note: 'Indicates whether the content and its associated data collection practices comply with COPPA requirements for children\'s content. | Column coppa_compliant (BOOLEAN) in compliance.content_rating']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.content_rating']
  created_timestamp timestamp [note: 'The timestamp when this content rating record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.content_rating']
  drug_use_descriptor boolean [note: 'Indicates whether the content contains drug use or substance abuse that contributed to the rating. | Column drug_use_descriptor (BOOLEAN) in compliance.content_rating']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  eidr_code varchar [note: 'The EIDR identifier for the content asset, providing a globally unique reference for the audiovisual work. | Column eidr_code (STRING) in compliance.content_rating']
  language_descriptor boolean [note: 'Indicates whether the content contains strong or offensive language that contributed to the rating. | Column language_descriptor (BOOLEAN) in compliance.content_rating']
  minimum_age varchar [note: 'The minimum recommended or required age for viewers of this content, as specified by the rating authority. Null if no specific age restriction applies. | Column minimum_age (INT) in compliance.content_rating']
  parental_guidance_required boolean [note: 'Indicates whether parental guidance is recommended or required for viewers under a certain age. | Column parental_guidance_required (BOOLEAN) in compliance.content_rating']
  previous_rating_value decimal(18,2) [note: 'The rating value that was assigned before the current rating, if the content was re-rated. Null for initial ratings. | Column previous_rating_value (DECIMAL(18,2)) in compliance.content_rating']
  rating_authority varchar [note: 'The official organization or regulatory body that issued the rating. Examples: Motion Picture Association, TV Parental Guidelines Monitoring Board, British Board of Film Classification, Freiwillige Selbstkontrolle der Filmwirtschaft. | Column rating_authority (STRING) in compliance.content_rating']
  rating_certificate_number varchar [note: 'The official certificate or registration number issued by the rating authority for this content rating. | Column rating_certificate_number (STRING) in compliance.content_rating']
  rating_date date [note: 'The date on which the rating was officially assigned to the content by the rating authority. | Column rating_date (DATE) in compliance.content_rating']
  rating_expiration_date date [note: 'The date on which the rating expires or requires renewal, if applicable. Null for ratings with no expiration. | Column rating_expiration_date (DATE) in compliance.content_rating']
  rating_fee_amount decimal(15,2) [note: 'The fee charged by the rating authority for evaluating and assigning the rating to the content. | Column rating_fee_amount (DECIMAL(15,2)) in compliance.content_rating']
  rating_fee_currency varchar [note: 'Three-letter ISO 4217 currency code for the rating fee. Examples: USD, GBP, EUR, AUD, JPY. | Column rating_fee_currency (STRING) in compliance.content_rating']
  rating_notes varchar [note: 'Additional notes or comments regarding the rating, including any special conditions, context, or clarifications provided by the rating authority or compliance team. | Column rating_notes (STRING) in compliance.content_rating']
  rating_reason varchar [note: 'Detailed explanation provided by the rating authority describing the specific content elements that led to the assigned rating. | Column rating_reason (STRING) in compliance.content_rating']
  rating_review_date date [note: 'The date on which the rating was last reviewed or re-evaluated by the rating authority. | Column rating_review_date (DATE) in compliance.content_rating']
  rating_status varchar [note: 'Current lifecycle status of the rating. Active: rating is valid and in effect; Expired: rating has passed its expiration date; Revoked: rating has been withdrawn by the authority; Pending: rating application submitted but not yet approved; Under Review: rating is being re-evaluated. | Column rating_status (STRING) in compliance.content_rating']
  rating_submission_date date [note: 'The date on which the content was submitted to the rating authority for evaluation. | Column rating_submission_date (DATE) in compliance.content_rating']
  rating_system varchar [note: 'The rating authority or system that issued this rating. Examples: MPA (Motion Picture Association), TV Parental Guidelines, BBFC (British Board of Film Classification), FSK (Germany), ACB (Australia), EIRIN (Japan), KFCB (Kenya). [ENUM-REF-CANDIDATE: MPA|TV_PARENTAL_GUIDELINES|BBFC|FSK|ACB|EIRIN|KFCB — 7 candidates stripped; promote to reference product] | Column rating_system (STRING) in compliance.content_rating']
  rating_type varchar [note: 'The distribution context for which this rating was assigned. Different ratings may apply to theatrical release, television broadcast, home video, or streaming platforms. | Column rating_type (STRING) in compliance.content_rating']
  rating_value decimal(18,2) [note: 'The specific rating classification assigned to the content. Examples: G, PG, PG-13, R, NC-17 (MPA); TV-Y, TV-Y7, TV-G, TV-PG, TV-14, TV-MA (TV Parental Guidelines); U, PG, 12A, 15, 18 (BBFC). [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA|U|12A|15|18|FSK0|FSK6|FSK12|FSK16|FSK18 — promote to reference product] | Column rating_value (DECIMAL(18,2)) in compliance.content_rating']
  rating_version varchar [note: 'Version number of this rating record. Increments when the rating is re-evaluated or updated due to content changes or appeals. | Column rating_version (INT) in compliance.content_rating']
  sexual_content_descriptor boolean [note: 'Indicates whether the content contains sexual content or nudity that contributed to the rating. | Column sexual_content_descriptor (BOOLEAN) in compliance.content_rating']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.content_rating']
  territory_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code indicating the geographic territory where this rating is applicable. Examples: USA, GBR, DEU, AUS, JPN. | Column territory_code (STRING) in compliance.content_rating']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.content_rating']
  updated_timestamp timestamp [note: 'The timestamp when this content rating record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in compliance.content_rating']
  violence_descriptor boolean [note: 'Indicates whether the content contains violence that contributed to the rating. | Column violence_descriptor (BOOLEAN) in compliance.content_rating']

  Note: 'Master registry of content ratings assigned to programming assets per MPA, TV Parental Guidelines, and international rating systems (BBFC, FSK, etc.). Captures rating system, rating value (G, PG, PG-13, R, NC-17; TV-Y, TV-Y7, TV-G, TV-PG, TV-14, TV-MA), content descriptors (violence, language, sexual content, drug use), rating authority, rating date, and applicability by territory. Links to content assets in the content domain. | Unity Catalog table: media_broadcasting_ecm.compliance.content_rating'
}

Table compliance.coppa_declaration {
  coppa_declaration_id varchar [pk, note: 'Unique identifier for the COPPA compliance declaration record. | Column coppa_declaration_id (BIGINT) in compliance.coppa_declaration']
  compliance_consent_record_id varchar [note: 'Foreign key linking to compliance.consent_record. Business justification: COPPA requires verifiable parental consent for children\'s data collection. This FK links the COPPA declaration to the specific consent record that documents parental consent, supporting FTC compliance | Column compliance_consent_record_id (BIGINT) in compliance.coppa_declaration']
  declared_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: COPPA declarations require named responsible party employee for legal accountability to FTC. Reviewer name should reference employee record rather than store as text. | Column declared_by_employee_id (BIGINT) in workforce.coppa_declaration']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: COPPA compliance requires broadcasters to declare whether specific media assets are directed at children under 13. This is a direct regulatory requirement for content classification, data collection p | Column media_asset_id (BIGINT) in mediaasset.coppa_declaration']
  ott_platform_id varchar [note: 'Identifier of the OTT platform or digital service on which the content is distributed. Relevant for streaming platforms carrying children\'s programming. | Column ott_platform_id (BIGINT) in distribution.coppa_declaration']
  title_id varchar [note: 'Identifier of the digital content, service, or platform subject to this COPPA declaration. Links to the content asset being evaluated for children-directed status. | Column title_id (BIGINT) in content.coppa_declaration']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.coppa_declaration']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.coppa_declaration']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.coppa_declaration']
  actual_knowledge_flag boolean [note: 'Indicates whether the operator has actual knowledge that it is collecting personal information from children under 13, triggering COPPA compliance obligations regardless of directed-to-children status. | Column actual_knowledge_flag (BOOLEAN) in compliance.coppa_declaration']
  advertising_assessment varchar [note: 'Assessment of whether advertising or promotional materials are directed to children, including ad placement, messaging, and products advertised. | Column advertising_assessment (STRING) in compliance.coppa_declaration']
  audio_content_assessment varchar [note: 'Assessment of audio elements (music, voice talent, sound effects) that may appeal to children, per FTC child-directed determination factors. | Column audio_content_assessment (STRING) in compliance.coppa_declaration']
  audit_trail_reference varchar [note: 'Reference to detailed audit trail or supporting documentation for the COPPA declaration, including assessment worksheets and evidence. | Column audit_trail_reference (STRING) in compliance.coppa_declaration']
  child_celebrity_presence_flag boolean [note: 'Indicates whether the content features child celebrities or characters that appeal to children, a factor in FTC child-directed determination. | Column child_celebrity_presence_flag (BOOLEAN) in compliance.coppa_declaration']
  compliance_notes varchar [note: 'Additional notes, observations, or context regarding the COPPA compliance assessment, including any mitigating factors or special considerations. | Column compliance_notes (STRING) in compliance.coppa_declaration']
  consent_date date [note: 'Date on which verifiable parental consent was obtained, if applicable. Must be maintained for audit purposes. | Column consent_date (DATE) in compliance.coppa_declaration']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.coppa_declaration']
  created_timestamp timestamp [note: 'Timestamp when the COPPA declaration record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.coppa_declaration']
  data_collection_scope varchar [note: 'Description of personal information collected from users, including identifiers, location data, photos, videos, audio recordings, and persistent identifiers for behavioral advertising. | Column data_collection_scope (STRING) in compliance.coppa_declaration']
  declaration_date date [note: 'Date on which the COPPA declaration was formally made or submitted for review. | Column declaration_date (DATE) in compliance.coppa_declaration']
  declaration_number varchar [note: 'Business identifier for the COPPA declaration, formatted as COPPA-YYYY-XXXXXXXX for external reference and audit tracking. | Column declaration_number (STRING) in compliance.coppa_declaration']
  declaration_status varchar [note: 'Current lifecycle status of the COPPA declaration: draft (being prepared), active (in effect), under_review (legal/compliance review), approved (validated), rejected (non-compliant), expired (needs renewal), withdrawn (no longer applicable). [ENUM-REF-CANDIDATE: draft|active|under_review|approved|rejected|expired|withdrawn — 7 candidates stripped; promote to reference product] | Column declaration_status (STRING) in compliance.coppa_declaration']
  declaration_type varchar [note: 'Type of digital asset being declared: content (video/audio program), service (subscription offering), platform (streaming service), website, mobile app, or interactive feature (games, social features). | Column declaration_type (STRING) in compliance.coppa_declaration']
  directed_to_children_status varchar [note: 'Determination of whether the content or service is directed to children under 13: directed (primary audience is children), mixed_audience (general audience including children), not_directed (not intended for children), under_review (assessment in progress). | Column directed_to_children_status (STRING) in compliance.coppa_declaration']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_date date [note: 'Date from which the COPPA declaration and associated compliance measures become effective. | Column effective_date (DATE) in compliance.coppa_declaration']
  expiration_date date [note: 'Date on which the COPPA declaration expires and requires renewal or reassessment. Nullable for indefinite declarations. | Column expiration_date (DATE) in compliance.coppa_declaration']
  ftc_filing_reference varchar [note: 'Reference number or identifier for any filings, notifications, or correspondence with the FTC regarding this COPPA declaration or compliance matter. | Column ftc_filing_reference (STRING) in compliance.coppa_declaration']
  legal_opinion_reference varchar [note: 'Reference to any legal opinion, memo, or external counsel advice supporting the COPPA determination. | Column legal_opinion_reference (STRING) in compliance.coppa_declaration']
  next_review_date date [note: 'Scheduled date for the next compliance review or reassessment of the COPPA declaration. | Column next_review_date (DATE) in compliance.coppa_declaration']
  parental_consent_mechanism varchar [note: 'Method used to obtain verifiable parental consent: email_plus (email plus additional verification), credit_card, toll_free (phone verification), video_conference, government_id, digital_certificate, not_required (content not directed to children), under_review. [ENUM-REF-CANDIDATE: email_plus|credit_card|toll_free|video_conference|government_id|digital_certificate|not_required|under_review — 8 candidates stripped; promote to reference product] | Column parental_consent_mechanism (STRING) in compliance.coppa_declaration']
  persistent_identifier_collection_flag boolean [note: 'Indicates whether persistent identifiers (cookies, device IDs, IP addresses) are collected for purposes other than internal operations, requiring parental consent under COPPA. | Column persistent_identifier_collection_flag (BOOLEAN) in compliance.coppa_declaration']
  privacy_policy_url varchar [note: 'URL of the privacy policy that discloses data collection practices, parental rights, and COPPA compliance measures. Must be prominently displayed per COPPA requirements. | Column privacy_policy_url (STRING) in compliance.coppa_declaration']
  review_date date [note: 'Date of the most recent compliance review or reassessment of the COPPA declaration. Critical for demonstrating ongoing compliance diligence. | Column review_date (DATE) in compliance.coppa_declaration']
  reviewer_title varchar [note: 'Job title or role of the reviewer (e.g., Chief Privacy Officer, Legal Counsel, Compliance Manager). | Column reviewer_title (STRING) in compliance.coppa_declaration']
  safe_harbor_certification_number varchar [note: 'Certification number or identifier issued by the safe harbor program, if applicable. | Column safe_harbor_certification_number (STRING) in compliance.coppa_declaration']
  safe_harbor_program varchar [note: 'Name of the FTC-approved safe harbor program the operator participates in, if any (e.g., CARU, TRUSTe, iKeepSafe). Provides streamlined compliance pathway. | Column safe_harbor_program (STRING) in compliance.coppa_declaration']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.coppa_declaration']
  subject_matter_description varchar [note: 'Description of the content\'s subject matter, themes, and topics used to assess child-directed nature per FTC (Federal Trade Commission) guidelines. | Column subject_matter_description (STRING) in compliance.coppa_declaration']
  target_age_range_max varchar [note: 'Maximum age of the intended audience for the content or service. Used to assess mixed-audience scenarios. | Column target_age_range_max (INT) in compliance.coppa_declaration']
  target_age_range_min varchar [note: 'Minimum age of the intended audience for the content or service. Critical for determining COPPA applicability (under 13 threshold). | Column target_age_range_min (INT) in compliance.coppa_declaration']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.coppa_declaration']
  updated_timestamp timestamp [note: 'Timestamp when the COPPA declaration record was last modified, supporting audit trail and change tracking requirements. | Column updated_timestamp (TIMESTAMP) in compliance.coppa_declaration']
  verifiable_consent_obtained_flag boolean [note: 'Indicates whether verifiable parental consent has been obtained for data collection from children under 13, as required by COPPA. | Column verifiable_consent_obtained_flag (BOOLEAN) in compliance.coppa_declaration']
  visual_content_assessment varchar [note: 'Assessment of visual content elements (characters, animation style, color schemes) that may appeal to children, per FTC child-directed determination factors. | Column visual_content_assessment (STRING) in compliance.coppa_declaration']

  Note: 'Records COPPA (Children\'s Online Privacy Protection Act) compliance declarations for digital content, platforms, and services directed at children under 13. Captures content or service identifier, directed-to-children determination, parental consent mechanism, data collection scope, verifiable parental consent status, FTC filing reference, and review date. Critical for OTT and streaming platforms carrying children\'s programming. | Unity Catalog table: media_broadcasting_ecm.compliance.coppa_declaration'
}

Table compliance.compliance_consent_record {
  compliance_consent_record_id varchar [pk, note: 'Unique identifier for the consent record. Primary key. | Column compliance_consent_record_id (BIGINT) in compliance.compliance_consent_record']
  device_type_id varchar [note: 'Unique identifier of the device used to provide consent. May be a mobile advertising ID (IDFA, AAID), smart TV device ID, or browser fingerprint. | Column device_type_id (BIGINT) in distribution.compliance_consent_record']
  processed_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: GDPR/CCPA consent records require audit trail of which employee processed the consent for data protection compliance verification and accountability to regulatory authorities. | Column processed_by_employee_id (BIGINT) in workforce.compliance_consent_record']
  subscriber_id varchar [note: 'Unique identifier of the data subject (subscriber, registered user, or anonymous viewer) who provided or withdrew consent. May be a subscriber ID, user ID, device ID, or pseudonymized identifier depending on the subject type. | Column subscriber_id (BIGINT) in subscriber.compliance_consent_record']
  superseded_by_consent_record_compliance_consent_record_id varchar [note: 'Reference to the consent record ID that supersedes this record. Used to maintain consent history and audit trail when consent is updated or renewed. Null if this is the current active record. | Column superseded_by_consent_record_compliance_consent_record_id (BIGINT) in compliance.compliance_consent_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.compliance_consent_record']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.compliance_consent_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.compliance_consent_record']
  audit_notes varchar [note: 'Free-text field for additional audit notes, compliance annotations, or special circumstances related to this consent record. Used for regulatory audit preparation and internal compliance reviews. | Column audit_notes (STRING) in compliance.compliance_consent_record']
  compliance_subscriber_consent_record_id varchar [note: 'FK to subscriber consent record for audit linkage | Column subscriber_consent_record_id (BIGINT) in subscriber.compliance_consent_record']
  compliance_subscriber_subscriber_consent_record_id varchar [note: 'FK reference to canonical source']
  consent_channel varchar [note: 'Platform or channel through which the consent was collected. Distinguishes between web, mobile app, smart TV, email, phone, in-person, or API-driven consent capture. [ENUM-REF-CANDIDATE: web|mobile_app|smart_tv|email|phone|in_person|api — 7 candidates stripped; promote to reference product] | Column consent_channel (STRING) in compliance.compliance_consent_record']
  consent_expiry_date date [note: 'Date on which the consent expires and must be renewed. Null for consents without expiration. Used to enforce periodic re-consent requirements under certain regulations. | Column consent_expiry_date (DATE) in compliance.compliance_consent_record']
  consent_language varchar [note: 'ISO 639-1 two-letter language code indicating the language in which the consent notice was presented to the subject (e.g., en for English, es for Spanish, fr for French). | Column consent_language (STRING) in compliance.compliance_consent_record']
  consent_mechanism varchar [note: 'Method or interface through which consent was captured. Examples include Consent Management Platform (CMP) banner, registration form, opt-in email, in-app toggle, customer service call, or written form. | Column consent_mechanism (STRING) in compliance.compliance_consent_record']
  consent_proof_url varchar [note: 'URL or storage path to the archived proof of consent (e.g., screenshot, form submission, audit log entry). Used as evidence in regulatory audits. | Column consent_proof_url (STRING) in compliance.compliance_consent_record']
  consent_scope varchar [note: 'Detailed description of the specific data processing activities or purposes covered by this consent. May include specific data categories, processing purposes, or third-party sharing arrangements. | Column consent_scope (STRING) in compliance.compliance_consent_record']
  consent_source_system varchar [note: 'Name of the source system or application that captured the consent event. Examples include Adobe Experience Platform, Salesforce, Zuora, or custom Consent Management Platform (CMP). | Column consent_source_system (STRING) in compliance.compliance_consent_record']
  consent_status varchar [note: 'Current state of the consent. Indicates whether consent has been granted, withdrawn, expired, not yet provided, or is pending review. | Column consent_status (STRING) in compliance.compliance_consent_record']
  consent_timestamp timestamp [note: 'Date and time when the consent event occurred (granted, withdrawn, or modified). Recorded in ISO 8601 format with timezone. | Column consent_timestamp (TIMESTAMP) in compliance.compliance_consent_record']
  consent_transaction_code varchar [note: 'Unique transaction or session identifier from the source system that captured the consent. Used for cross-system audit trail and reconciliation. | Column consent_transaction_code (STRING) in compliance.compliance_consent_record']
  consent_type varchar [note: 'Category of consent being granted or withdrawn. Includes data processing, marketing communications, profiling, cookie usage, targeted advertising, and cross-device tracking. | Column consent_type (STRING) in compliance.compliance_consent_record']
  cookie_consent_categories varchar [note: 'Comma-separated list of cookie categories for which consent was granted (e.g., strictly_necessary, functional, analytics, advertising, social_media). Aligns with IAB Transparency and Consent Framework categories. | Column cookie_consent_categories (STRING) in compliance.compliance_consent_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.compliance_consent_record']
  created_timestamp timestamp [note: 'Date and time when this consent record was first created in the system. Recorded in ISO 8601 format with timezone. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in compliance.compliance_consent_record']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  ip_address varchar [note: 'IP address from which the consent was provided. Used for audit trail and fraud detection. May be IPv4 or IPv6 format. | Column ip_address (STRING) in compliance.compliance_consent_record']
  is_active boolean [note: 'Boolean flag indicating whether this consent record is currently active and enforceable. False if consent has been withdrawn, expired, or superseded by a newer record. | Column is_active (BOOLEAN) in compliance.compliance_consent_record']
  jurisdiction varchar [note: 'Geographic jurisdiction or regulatory region governing this consent record. Uses ISO 3166-1 alpha-3 country codes (e.g., USA, GBR, DEU) or regional codes (e.g., EEA for European Economic Area). | Column jurisdiction (STRING) in compliance.compliance_consent_record']
  last_modified_timestamp timestamp [note: 'Date and time when this consent record was last modified or updated. Recorded in ISO 8601 format with timezone. Used for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in compliance.compliance_consent_record']
  marketing_email_consent boolean [note: 'Boolean flag indicating whether the subject has consented to receive marketing communications via email. | Column marketing_email_consent (BOOLEAN) in compliance.compliance_consent_record']
  marketing_push_consent boolean [note: 'Boolean flag indicating whether the subject has consented to receive marketing push notifications on mobile or web applications. | Column marketing_push_consent (BOOLEAN) in compliance.compliance_consent_record']
  marketing_sms_consent boolean [note: 'Boolean flag indicating whether the subject has consented to receive marketing communications via SMS or text message. | Column marketing_sms_consent (BOOLEAN) in compliance.compliance_consent_record']
  parental_consent_verified boolean [note: 'Boolean flag indicating whether parental or guardian consent has been verified for subjects under the age of consent (required under Children\'s Online Privacy Protection Act (COPPA) and similar regulations). | Column parental_consent_verified (BOOLEAN) in compliance.compliance_consent_record']
  parental_verification_method varchar [note: 'Method used to verify parental consent for minors. Examples include credit card verification, government ID check, video conference, or signed consent form. Null if parental consent is not applicable. | Column parental_verification_method (STRING) in compliance.compliance_consent_record']
  privacy_policy_version varchar [note: 'Version identifier of the privacy policy or terms of service that the subject accepted when providing consent. Critical for demonstrating which terms were in effect at the time of consent. | Column privacy_policy_version (STRING) in compliance.compliance_consent_record']
  regulatory_framework varchar [note: 'Primary privacy regulation or framework under which this consent was collected. Includes General Data Protection Regulation (GDPR), California Consumer Privacy Act (CCPA), Children\'s Online Privacy Protection Act (COPPA), California Privacy Rights Act (CPRA), Lei Geral de Proteção de Dados (LGPD), Personal Information Protection and Electronic Documents Act (PIPEDA), or other applicable laws. [ENUM-REF-CANDIDATE: GDPR|CCPA|COPPA|CPRA|LGPD|PIPEDA|other — 7 candidates stripped; promote to reference product] | Column regulatory_framework (STRING) in compliance.compliance_consent_record']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.compliance_consent_record']
  subject_type varchar [note: 'Classification of the data subject providing consent. Distinguishes between authenticated subscribers, registered users, anonymous viewers, guests, or device-level consent. | Column subject_type (STRING) in compliance.compliance_consent_record']
  tcf_consent_string varchar [note: 'IAB Transparency and Consent Framework encoded consent string capturing granular vendor and purpose consents. Used for programmatic advertising consent management. | Column tcf_consent_string (STRING) in compliance.compliance_consent_record']
  third_party_sharing_consent boolean [note: 'Boolean flag indicating whether the subject has consented to sharing their data with third parties (e.g., advertising partners, analytics providers, content partners). | Column third_party_sharing_consent (BOOLEAN) in compliance.compliance_consent_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.compliance_consent_record']
  user_agent varchar [note: 'Browser or application user agent string captured at the time of consent. Provides context about the device and software used for consent capture. | Column user_agent (STRING) in compliance.compliance_consent_record']
  withdrawal_mechanism varchar [note: 'Method or interface through which consent was withdrawn. Examples include preference center, unsubscribe link, customer service request, or in-app toggle. Null if consent has not been withdrawn. | Column withdrawal_mechanism (STRING) in compliance.compliance_consent_record']
  withdrawal_timestamp timestamp [note: 'Date and time when consent was withdrawn by the subject. Null if consent has not been withdrawn. Critical for demonstrating compliance with right to withdraw consent. | Column withdrawal_timestamp (TIMESTAMP) in compliance.compliance_consent_record']

  Note: 'Authoritative log of audience and subscriber consent events for data collection, processing, and marketing under GDPR, CCPA, COPPA, and emerging state privacy laws. Captures consent subject (subscriber, registered user, or anonymous viewer), consent type (data processing, marketing, profiling, cookies, targeted advertising, cross-device tracking), consent status (granted, withdrawn, expired, not-yet-given), consent mechanism (CMP banner, registration form, opt-in email, in-app toggle), jurisdiction, consent timestamp, expiry date, version of privacy policy accepted, and withdrawal mechanism used. Serves as the legal basis record for all personal data processing and the primary evidence artifact for regulatory audits. | Unity Catalog table: media_broadcasting_ecm.compliance.compliance_consent_record'
}

Table compliance.privacy_request {
  privacy_request_id varchar [pk, note: 'Unique identifier for the privacy request. Primary key. | Column privacy_request_id (BIGINT) in compliance.privacy_request']
  assigned_handler_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: GDPR/CCPA privacy requests (access, deletion, portability) must be assigned to specific employees for fulfillment tracking and regulatory deadline compliance. Assigned handler text should be FK. | Column assigned_handler_employee_id (BIGINT) in workforce.privacy_request']
  compliance_consent_record_id varchar [note: 'Foreign key linking to compliance.consent_record. Business justification: Privacy requests (GDPR right to erasure, consent withdrawal) may involve modifying or revoking consent records. This FK links the privacy request to the consent record it affects. Using \'related_conse | Column compliance_consent_record_id (BIGINT) in compliance.privacy_request']
  subscriber_id varchar [note: 'Internal subscriber identifier linked to the requestor, if the data subject is a known subscriber in the system. | Column subscriber_id (BIGINT) in subscriber.privacy_request']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.privacy_request']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.privacy_request']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.privacy_request']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.privacy_request']
  created_timestamp timestamp [note: 'Timestamp when this privacy request record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in compliance.privacy_request']
  data_categories_involved varchar [note: 'Comma-separated list of data categories involved in the request (e.g., subscriber profile, viewing history, payment data, device identifiers). Used for scope tracking and audit. | Column data_categories_involved (STRING) in compliance.privacy_request']
  data_volume_processed decimal(15,2) [note: 'Total volume of data processed for this request in megabytes, used for operational metrics and resource planning. | Column data_volume_processed (DECIMAL(15,2)) in compliance.privacy_request']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  extended_deadline date [note: 'New deadline date if an extension was granted. GDPR allows up to 3 months total; CCPA allows up to 90 days total. | Column extended_deadline (DATE) in compliance.privacy_request']
  extension_granted boolean [note: 'Indicates whether a deadline extension was granted due to request complexity or volume. GDPR allows 2-month extension; CCPA allows 45-day extension. | Column extension_granted (BOOLEAN) in compliance.privacy_request']
  extension_reason varchar [note: 'Business justification for granting a deadline extension, such as request complexity, high volume of requests, or technical challenges. | Column extension_reason (STRING) in compliance.privacy_request']
  fulfillment_status varchar [note: 'Detailed status of request fulfillment workflow: not_started, data_collection (gathering data), data_review (validating), response_preparation (packaging), response_sent (delivered), closed (finalized). | Column fulfillment_status (STRING) in compliance.privacy_request']
  notes varchar [note: 'Free-text notes capturing additional context, special handling instructions, or communications log for the request. | Column notes (STRING) in compliance.privacy_request']
  processing_time_hours decimal(10,2) [note: 'Total staff hours spent processing this request, used for cost tracking and efficiency analysis. | Column processing_time_hours (DECIMAL(10,2)) in compliance.privacy_request']
  regulatory_deadline date [note: 'Calculated deadline for responding to the request based on regulatory requirements: 30 calendar days for GDPR, 45 calendar days for CCPA, from submission date. | Column regulatory_deadline (DATE) in compliance.privacy_request']
  regulatory_framework varchar [note: 'Primary data privacy regulation governing this request: GDPR (EU/EEA), CCPA (California), both (dual jurisdiction), or other (state-specific or international). | Column regulatory_framework (STRING) in compliance.privacy_request']
  rejection_reason varchar [note: 'Detailed explanation if the request was rejected, including legal basis (e.g., identity not verified, request manifestly unfounded or excessive, legal obligation to retain data). | Column rejection_reason (STRING) in compliance.privacy_request']
  request_number varchar [note: 'Externally-visible unique identifier for the privacy request, used in communications with data subjects and regulators. | Column request_number (STRING) in compliance.privacy_request']
  request_status varchar [note: 'Current lifecycle status of the privacy request: submitted (received), under_review (initial assessment), identity_verification (verifying requestor), in_progress (fulfilling), completed (closed successfully), rejected (denied with justification), withdrawn (cancelled by requestor). [ENUM-REF-CANDIDATE: submitted|under_review|identity_verification|in_progress|completed|rejected|withdrawn — 7 candidates stripped; promote to reference product] | Column request_status (STRING) in compliance.privacy_request']
  request_type varchar [note: 'Type of data subject rights request: access (right to know), erasure (right to delete), portability (data export), rectification (correction), restriction (processing limitation), or opt_out_sale (CCPA opt-out). | Column request_type (STRING) in compliance.privacy_request']
  requestor_email varchar [note: 'Primary email address of the data subject for request correspondence and response delivery. | Column requestor_email (STRING) in compliance.privacy_request']
  requestor_jurisdiction varchar [note: 'Three-letter ISO country code representing the data subject\'s jurisdiction, used to determine applicable privacy law (e.g., DEU for Germany/GDPR, USA for US/CCPA). | Column requestor_jurisdiction (STRING) in compliance.privacy_request']
  requestor_name varchar [note: 'Full legal name of the data subject submitting the privacy request. | Column requestor_name (STRING) in compliance.privacy_request']
  requestor_phone varchar [note: 'Contact phone number of the data subject for identity verification and request follow-up. | Column requestor_phone (STRING) in compliance.privacy_request']
  response_date date [note: 'Date when the response was delivered to the data subject, marking completion of the request. | Column response_date (DATE) in compliance.privacy_request']
  response_method varchar [note: 'Method used to deliver the response to the data subject: email (encrypted), secure_portal (download link), mail (postal), phone (verbal), or in_person. | Column response_method (STRING) in compliance.privacy_request']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.privacy_request']
  submission_channel varchar [note: 'Channel through which the privacy request was submitted: web_form (online portal), email, phone (call center), mail (postal), mobile_app, or chat (live support). | Column submission_channel (STRING) in compliance.privacy_request']
  submission_timestamp timestamp [note: 'Date and time when the privacy request was submitted by the data subject. Used to calculate regulatory deadline (30 days GDPR, 45 days CCPA). | Column submission_timestamp (TIMESTAMP) in compliance.privacy_request']
  systems_accessed varchar [note: 'Comma-separated list of internal systems queried to fulfill the request (e.g., Zuora, Adobe Experience Platform, Akamai CDN logs). Used for audit trail and completeness verification. | Column systems_accessed (STRING) in compliance.privacy_request']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.privacy_request']
  updated_timestamp timestamp [note: 'Timestamp when this privacy request record was last modified. Used for audit trail and change tracking. | Column updated_timestamp (TIMESTAMP) in compliance.privacy_request']
  verification_method varchar [note: 'Method used to verify the requestor\'s identity: email_confirmation, account_login, document_upload (ID scan), phone_verification, two_factor_auth, or manual_review. | Column verification_method (STRING) in compliance.privacy_request']
  verification_status varchar [note: 'Status of requestor identity verification process: pending (awaiting verification), verified (identity confirmed), failed (unable to verify), not_required (low-risk request). | Column verification_status (STRING) in compliance.privacy_request']
  verification_timestamp timestamp [note: 'Date and time when the requestor\'s identity was successfully verified. | Column verification_timestamp (TIMESTAMP) in compliance.privacy_request']

  Note: 'Tracks data subject rights requests submitted under GDPR (right to access, erasure, portability, rectification, restriction) and CCPA (right to know, delete, opt-out of sale). Captures request type, requestor identity, submission channel, verification status, assigned handler, regulatory deadline (30-day GDPR / 45-day CCPA), fulfillment status, and response date. Ensures timely compliance with data subject rights obligations. | Unity Catalog table: media_broadcasting_ecm.compliance.privacy_request'
}

Table compliance.closed_caption_record {
  closed_caption_record_id varchar [pk, note: 'Unique identifier for the closed caption compliance record. | Column closed_caption_record_id (BIGINT) in compliance.closed_caption_record']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Closed captioning is a specific type of accessibility obligation under FCC/Ofcom rules. This FK links each captioning record to the accessibility obligation it fulfills, enabling compliance reporting  | Column accessibility_obligation_id (BIGINT) in compliance.closed_caption_record']
  asset_version_id varchar [note: 'Foreign key linking to mediaasset.asset_version. Business justification: Closed captioning applies to specific versions/renditions of assets (broadcast master vs. streaming proxy vs. archived version). Different versions may have different caption formats (CEA-608, CEA-708 | Column asset_version_id (BIGINT) in mediaasset.closed_caption_record']
  caption_vendor_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Captioning vendor performance and FCC compliance is tracked by partner. Captioning accuracy failures, latency violations, and format errors may trigger vendor SLA breaches, disputes, or vendor substit | Column caption_vendor_partner_id (BIGINT) in partner.closed_caption_record']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: Closed captioning violations (low accuracy, missing captions, complaints) may be recorded as compliance incidents. This FK links the captioning record to any incident it triggered, supporting FCC comp | Column compliance_incident_id (BIGINT) in compliance.closed_caption_record']
  content_episode_id varchar [note: 'Reference to the specific episode that was captioned, if applicable. | Column content_episode_id (BIGINT) in content.closed_caption_record']
  content_title_id varchar [note: 'Reference to the content title that was captioned. | Column content_title_id (BIGINT) in content.closed_caption_record']
  delivery_channel_id varchar [note: 'Reference to the channel or platform where the captioned content was broadcast or streamed. | Column delivery_channel_id (BIGINT) in distribution.closed_caption_record']
  encoder_config_id varchar [note: 'Foreign key linking to technology.encoder_config. Business justification: Caption compliance audits require tracking which encoder processed each stream. Real NOC/compliance workflow for troubleshooting caption failures and demonstrating CVAA compliance to FCC. | Column encoder_config_id (BIGINT) in technology.closed_caption_record']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: FCC closed captioning compliance requires tracking which media assets have caption files, caption quality scores, and compliance status. This is mandatory for accessibility reporting, public inspectio | Column media_asset_id (BIGINT) in mediaasset.closed_caption_record']
  narrator_talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Closed caption records may reference talent for audio description, voice identification, or accessibility compliance when talent narrates or appears in content. Accessibility teams identify talent voi | Column narrator_talent_profile_id (BIGINT) in talent.closed_caption_record']
  reviewer_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: FCC closed captioning quality reviews require tracking which employee performed the review for compliance verification and audit trail. Reviewer name should reference employee record. | Column reviewer_employee_id (BIGINT) in workforce.closed_caption_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.closed_caption_record']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.closed_caption_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.closed_caption_record']
  air_date date [note: 'The date the captioned content was broadcast or made available to viewers. | Column air_date (DATE) in compliance.closed_caption_record']
  air_time timestamp [note: 'The precise timestamp when the captioned content began airing or streaming. | Column air_time (TIMESTAMP) in compliance.closed_caption_record']
  caption_accuracy_score decimal(5,2) [note: 'Percentage score representing the accuracy of the captions compared to the spoken audio, measured as a percentage from 0.00 to 100.00. | Column caption_accuracy_score (DECIMAL(5,2)) in compliance.closed_caption_record']
  caption_completeness_percentage decimal(5,2) [note: 'Percentage of the program duration that was captioned, measured from 0.00 to 100.00. | Column caption_completeness_percentage (DECIMAL(5,2)) in compliance.closed_caption_record']
  caption_file_format varchar [note: 'The technical format of the closed caption file used for this broadcast. [ENUM-REF-CANDIDATE: SRT|SCC|TTML|WebVTT|CEA-608|CEA-708|DFXP|STL — 8 candidates stripped; promote to reference product] | Column caption_file_format (STRING) in compliance.closed_caption_record']
  caption_latency_seconds decimal(6,2) [note: 'The average delay in seconds between spoken audio and caption display, critical for live programming compliance. | Column caption_latency_seconds (DECIMAL(6,2)) in compliance.closed_caption_record']
  caption_placement_compliance boolean [note: 'Indicates whether caption placement on screen met regulatory standards for visibility and non-obstruction of critical content. | Column caption_placement_compliance (BOOLEAN) in compliance.closed_caption_record']
  caption_quality_review_date date [note: 'Date when the caption quality was formally reviewed for compliance assessment. | Column caption_quality_review_date (DATE) in compliance.closed_caption_record']
  caption_synchronization_compliance boolean [note: 'Indicates whether captions were properly synchronized with the audio and video content per regulatory requirements. | Column caption_synchronization_compliance (BOOLEAN) in compliance.closed_caption_record']
  caption_type varchar [note: 'Indicates whether the captions were generated live during broadcast or pre-recorded offline. | Column caption_type (STRING) in compliance.closed_caption_record']
  captioned_duration_minutes varchar [note: 'Total duration in minutes that was actually captioned within the program. | Column captioned_duration_minutes (INT) in compliance.closed_caption_record']
  complaint_received_date date [note: 'Date when a viewer complaint regarding captioning was received by the broadcaster. | Column complaint_received_date (DATE) in compliance.closed_caption_record']
  complaint_reference_number varchar [note: 'Reference number of any viewer complaint filed regarding caption quality or availability for this broadcast. | Column complaint_reference_number (STRING) in compliance.closed_caption_record']
  complaint_type varchar [note: 'Category of the captioning complaint filed by viewers or regulatory bodies. | Column complaint_type (STRING) in compliance.closed_caption_record']
  compliance_status varchar [note: 'Current compliance status of the closed captioning for this broadcast record. | Column compliance_status (STRING) in compliance.closed_caption_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.closed_caption_record']
  created_timestamp timestamp [note: 'Timestamp when this closed caption compliance record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.closed_caption_record']
  daypart varchar [note: 'The broadcast daypart time segment during which the captioned content aired. [ENUM-REF-CANDIDATE: early_morning|morning|daytime|early_fringe|prime_access|prime_time|late_fringe|overnight — 8 candidates stripped; promote to reference product] | Column daypart (STRING) in compliance.closed_caption_record']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  exemption_basis varchar [note: 'Legal or regulatory basis for exemption from closed captioning requirements, if applicable. | Column exemption_basis (STRING) in compliance.closed_caption_record']
  exemption_category varchar [note: 'Category of exemption from captioning requirements as defined by regulatory frameworks. [ENUM-REF-CANDIDATE: primarily_textual|late_night|promotional|public_service_announcement|locally_produced|economic_burden|interstitial_material|secondary_audio — promote to reference product] | Column exemption_category (STRING) in compliance.closed_caption_record']
  language_code varchar [note: 'Three-letter ISO 639-2 language code indicating the language of the closed captions. | Column language_code (STRING) in compliance.closed_caption_record']
  last_modified_timestamp timestamp [note: 'Timestamp when this closed caption compliance record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in compliance.closed_caption_record']
  notes varchar [note: 'Additional notes or comments regarding the closed caption compliance record, quality issues, or special circumstances. | Column notes (STRING) in compliance.closed_caption_record']
  program_duration_minutes varchar [note: 'Total duration of the program in minutes for which captioning compliance is being tracked. | Column program_duration_minutes (INT) in compliance.closed_caption_record']
  program_title varchar [note: 'The title of the program that was captioned as it appeared in the broadcast schedule. | Column program_title (STRING) in compliance.closed_caption_record']
  public_inspection_file_included boolean [note: 'Indicates whether this caption record has been included in the broadcasters public inspection file as required by FCC regulations. | Column public_inspection_file_included (BOOLEAN) in compliance.closed_caption_record']
  regulatory_filing_date date [note: 'Date when the caption compliance record was filed with the regulatory authority. | Column regulatory_filing_date (DATE) in compliance.closed_caption_record']
  regulatory_filing_required boolean [note: 'Indicates whether this caption record requires formal filing with regulatory authorities such as FCC or Ofcom. | Column regulatory_filing_required (BOOLEAN) in compliance.closed_caption_record']
  remediation_completed_date date [note: 'Date when remediation actions to correct captioning issues were completed. | Column remediation_completed_date (DATE) in compliance.closed_caption_record']
  remediation_description varchar [note: 'Detailed description of the remediation actions taken to address captioning compliance issues. | Column remediation_description (STRING) in compliance.closed_caption_record']
  remediation_status varchar [note: 'Current status of remediation efforts to address captioning deficiencies or complaints. | Column remediation_status (STRING) in compliance.closed_caption_record']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.closed_caption_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.closed_caption_record']

  Note: 'Compliance record for closed captioning obligations under FCC rules (47 CFR §79.1) and Ofcom requirements. Tracks program title, air date, channel, caption file format (SRT, SCC, TTML, WebVTT), caption accuracy score, caption latency (for live programming), caption completeness percentage, complaint reference, remediation status, and exemption basis if applicable. Supports FCC caption quality standards and complaint response workflows. | Unity Catalog table: media_broadcasting_ecm.compliance.closed_caption_record'
}

Table compliance.accessibility_obligation {
  accessibility_obligation_id varchar [pk, note: 'Unique identifier for the accessibility compliance obligation record. | Column accessibility_obligation_id (BIGINT) in compliance.accessibility_obligation']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Accessibility obligations may be license-specific (e.g., closed captioning requirements vary by license type and market). This FK enables tracking which obligations apply to which licenses. | Column broadcast_license_id (BIGINT) in compliance.accessibility_obligation']
  responsible_contact_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: FCC accessibility obligations (CVAA, closed captioning, video description) require named employee owner for compliance tracking and regulatory correspondence. Contact email should reference employee r | Column responsible_contact_employee_id (BIGINT) in workforce.accessibility_obligation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.accessibility_obligation']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.accessibility_obligation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.accessibility_obligation']
  applicable_regulation varchar [note: 'Primary regulatory framework governing this obligation: CVAA (Twenty-First Century Communications and Video Accessibility Act), ADA (Americans with Disabilities Act), Ofcom Access Code, EU Audiovisual Media Services Directive, WCAG 2.1 (Web Content Accessibility Guidelines), or ATSC A/53 (Advanced Television Systems Committee standard for closed captioning). | Column applicable_regulation (STRING) in compliance.accessibility_obligation']
  compliance_deadline date [note: 'Date by which the organization must achieve full compliance with this accessibility obligation. | Column compliance_deadline (DATE) in compliance.accessibility_obligation']
  compliance_percentage decimal(5,2) [note: 'Percentage of content or platform features currently meeting this accessibility obligation (0.00 to 100.00), used for tracking progress toward full compliance. | Column compliance_percentage (DECIMAL(5,2)) in compliance.accessibility_obligation']
  compliance_status varchar [note: 'Current state of the organization\'s compliance with this obligation: compliant (fully meeting requirements), non-compliant (failing to meet requirements), in progress (actively working toward compliance), not started (no action taken), exempt (obligation does not apply), or waiver granted (temporary or permanent exemption approved by regulator). | Column compliance_status (STRING) in compliance.accessibility_obligation']
  content_type_applicability varchar [note: 'Types of content to which this obligation applies (e.g., all programming, news and emergency information, pre-recorded entertainment, live events, user-generated content exclusions). | Column content_type_applicability (STRING) in compliance.accessibility_obligation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.accessibility_obligation']
  created_timestamp timestamp [note: 'Timestamp when this accessibility obligation record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.accessibility_obligation']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_date date [note: 'Date when this accessibility obligation became or will become legally binding on the organization. | Column effective_date (DATE) in compliance.accessibility_obligation']
  estimated_compliance_cost decimal(15,2) [note: 'Estimated total cost in USD to achieve full compliance with this obligation, including technology implementation, content remediation, training, and ongoing operational costs. | Column estimated_compliance_cost (DECIMAL(15,2)) in compliance.accessibility_obligation']
  exemption_reason varchar [note: 'Explanation of why this obligation does not apply to the organization or why a waiver was granted (e.g., content category exemption, undue burden waiver, technical infeasibility). | Column exemption_reason (STRING) in compliance.accessibility_obligation']
  expiration_date date [note: 'Date when this obligation ceases to apply, if applicable (null for ongoing obligations). | Column expiration_date (DATE) in compliance.accessibility_obligation']
  geographic_jurisdiction varchar [note: 'Three-letter ISO country code representing the jurisdiction where this obligation is enforceable (e.g., USA for FCC/CVAA, GBR for Ofcom, DEU for German regulations). | Column geographic_jurisdiction (STRING) in compliance.accessibility_obligation']
  last_compliance_review_date date [note: 'Date when the organization last conducted an internal review or audit of compliance with this accessibility obligation. | Column last_compliance_review_date (DATE) in compliance.accessibility_obligation']
  last_updated_timestamp timestamp [note: 'Timestamp when this accessibility obligation record was most recently modified. | Column last_updated_timestamp (TIMESTAMP) in compliance.accessibility_obligation']
  measurement_methodology varchar [note: 'Method used to measure and verify compliance with this obligation (e.g., automated caption quality analysis, manual content audits, user testing, third-party accessibility audits). | Column measurement_methodology (STRING) in compliance.accessibility_obligation']
  next_compliance_review_date date [note: 'Scheduled date for the next internal review or audit of compliance with this accessibility obligation. | Column next_compliance_review_date (DATE) in compliance.accessibility_obligation']
  notes varchar [note: 'Additional notes, context, or special considerations related to this accessibility obligation (e.g., pending regulatory changes, coordination with other obligations, vendor dependencies). | Column notes (STRING) in compliance.accessibility_obligation']
  obligation_code varchar [note: 'Business identifier code for the accessibility obligation, used for external reference and reporting. | Column obligation_code (STRING) in compliance.accessibility_obligation']
  obligation_name varchar [note: 'Human-readable name of the accessibility obligation (e.g., Closed Captioning for Linear Broadcast, Audio Description for VOD Content). | Column obligation_name (STRING) in compliance.accessibility_obligation']
  obligation_type varchar [note: 'Category of accessibility requirement: closed captioning (CC), audio description (AD), video description, emergency alert accessibility, online video player accessibility, or keyboard navigation compliance. | Column obligation_type (STRING) in compliance.accessibility_obligation']
  penalty_for_non_compliance varchar [note: 'Description of regulatory penalties, fines, or sanctions that may be imposed for failure to meet this obligation (e.g., FCC forfeiture up to $100,000 per violation, Ofcom statutory sanctions, license suspension risk). | Column penalty_for_non_compliance (STRING) in compliance.accessibility_obligation']
  priority_level varchar [note: 'Business priority assigned to achieving compliance with this obligation: critical (regulatory deadline imminent or high penalty risk), high (significant regulatory or reputational risk), medium (standard compliance requirement), or low (minimal risk or long timeline). | Column priority_level (STRING) in compliance.accessibility_obligation']
  regulation_section varchar [note: 'Specific section, article, or clause of the regulation that mandates this obligation (e.g., 47 CFR 79.1, WCAG 2.1 Success Criterion 1.2.2). | Column regulation_section (STRING) in compliance.accessibility_obligation']
  reporting_frequency varchar [note: 'Frequency at which compliance status for this obligation must be reported to the regulator: annual, quarterly, monthly, on-demand (upon request), or not required. | Column reporting_frequency (STRING) in compliance.accessibility_obligation']
  responsible_team varchar [note: 'Name of the internal team, department, or business unit responsible for ensuring compliance with this obligation (e.g., Broadcast Operations, Digital Product, Legal Compliance, Content Production). | Column responsible_team (STRING) in compliance.accessibility_obligation']
  scope varchar [note: 'Distribution platform scope to which this obligation applies: linear broadcast, VOD (Video On Demand), SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), OTT (Over-The-Top), FAST (Free Ad-Supported Streaming Television), MVPD (Multichannel Video Programming Distributor), vMVPD (Virtual Multichannel Video Programming Distributor), or all platforms. [ENUM-REF-CANDIDATE: linear|vod|svod|avod|tvod|ott|fast|mvpd|vmvpd|all_platforms — 10 candidates stripped; promote to reference product] | Column scope (STRING) in compliance.accessibility_obligation']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.accessibility_obligation']
  target_compliance_percentage decimal(5,2) [note: 'Required percentage of content or platform features that must meet this accessibility obligation to achieve regulatory compliance (typically 100.00, but may be lower for phased implementation schedules). | Column target_compliance_percentage (DECIMAL(5,2)) in compliance.accessibility_obligation']
  technical_standard varchar [note: 'Technical standard or specification that defines how this accessibility feature must be implemented (e.g., CEA-608 for closed captioning, TTML for web captions, WCAG 2.1 AA for player accessibility). | Column technical_standard (STRING) in compliance.accessibility_obligation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.accessibility_obligation']
  waiver_expiration_date date [note: 'Date when a granted waiver or exemption expires and the obligation becomes enforceable again (null for permanent exemptions). | Column waiver_expiration_date (DATE) in compliance.accessibility_obligation']

  Note: 'Master record of accessibility compliance obligations applicable to the organization\'s content and platforms, including closed captioning, audio description (AD), video description, emergency alert accessibility, and online video player accessibility under CVAA, ADA, and Ofcom accessibility codes. Captures obligation type, applicable regulation, scope (linear, VOD, OTT), compliance deadline, responsible team, and current compliance status. | Unity Catalog table: media_broadcasting_ecm.compliance.accessibility_obligation'
}

Table compliance.eas_log {
  eas_log_id varchar [pk, note: 'Unique identifier for the EAS log entry. Primary key for the EAS log record. | Column eas_log_id (BIGINT) in compliance.eas_log']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: EAS logs track Emergency Alert System activations for FCC-licensed broadcast stations. Each log entry relates to a specific broadcast license. This FK links the operational log to the license record. | Column broadcast_license_id (BIGINT) in compliance.eas_log']
  calendar_id varchar [note: 'Foreign key linking to compliance.compliance_calendar. Business justification: Scheduled EAS tests are tracked in the compliance calendar. This FK links each EAS log entry to the calendar entry for the scheduled test, enabling verification that required tests were performed on t | Column calendar_id (BIGINT) in compliance.eas_log']
  channel_id varchar [note: 'Identifier of the broadcast station that received or transmitted the EAS alert. | Column channel_id (BIGINT) in scheduling.eas_log']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: EAS failures or non-compliance (missed tests, equipment failures) may be recorded as compliance incidents. This FK links the EAS log entry to any incident it triggered, supporting FCC compliance track | Column compliance_incident_id (BIGINT) in compliance.eas_log']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: EAS (Emergency Alert System) tests and alerts are often recorded as media assets for compliance retention, quality verification, and FCC audit purposes. Broadcasters must retain EAS logs and associate | Column media_asset_id (BIGINT) in mediaasset.eas_log']
  operator_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: FCC EAS logs must record which licensed operator was on duty during alert transmission for regulatory compliance verification. Operator on duty text should be FK. | Column operator_employee_id (BIGINT) in workforce.eas_log']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: FCC EAS compliance requires equipment-level logs showing which transmitter relayed each alert. Real public inspection file requirement and FCC audit trail for EAS participation verification. | Column transmission_equipment_id (BIGINT) in technology.eas_log']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.eas_log']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.eas_log']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.eas_log']
  alert_duration_seconds varchar [note: 'Duration of the EAS alert transmission in seconds, from start to end of the alert message. | Column alert_duration_seconds (INT) in compliance.eas_log']
  alert_text varchar [note: 'Full text content of the EAS alert message that was transmitted or received, including any instructions to the public. | Column alert_text (STRING) in compliance.eas_log']
  alert_timestamp timestamp [note: 'Date and time when the EAS alert was activated or received by the station. This is the principal business event timestamp for the alert. | Column alert_timestamp (TIMESTAMP) in compliance.eas_log']
  alert_type varchar [note: 'Classification of the EAS alert by geographic scope: national emergency, state emergency, local emergency, or test alert. | Column alert_type (STRING) in compliance.eas_log']
  attention_signal_transmitted boolean [note: 'Indicates whether the two-tone attention signal was transmitted as part of the EAS alert. | Column attention_signal_transmitted (BOOLEAN) in compliance.eas_log']
  audio_message_transmitted boolean [note: 'Indicates whether the audio message portion of the EAS alert was transmitted. | Column audio_message_transmitted (BOOLEAN) in compliance.eas_log']
  cap_message_received boolean [note: 'Indicates whether the alert was received in Common Alerting Protocol (CAP) format via IPAWS or other digital alert system. | Column cap_message_received (BOOLEAN) in compliance.eas_log']
  compliance_status varchar [note: 'Compliance status of the EAS alert or test: compliant (met all requirements), missed (alert not transmitted), late (transmitted after required time), or failed (technical failure). | Column compliance_status (STRING) in compliance.eas_log']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.eas_log']
  created_timestamp timestamp [note: 'Timestamp when this EAS log record was first created in the system for audit and compliance tracking. | Column created_timestamp (TIMESTAMP) in compliance.eas_log']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  end_of_message_transmitted boolean [note: 'Indicates whether the End of Message (EOM) code was transmitted to signal completion of the EAS alert. | Column end_of_message_transmitted (BOOLEAN) in compliance.eas_log']
  equipment_used varchar [note: 'Description or model identifier of the EAS equipment (encoder/decoder) used to process and transmit the alert. | Column equipment_used (STRING) in compliance.eas_log']
  event_code varchar [note: 'Three-letter EAS event code identifying the nature of the emergency (e.g., EAN for Emergency Action Notification, RWT for Required Weekly Test, RMT for Required Monthly Test, TOR for Tornado Warning). | Column event_code (STRING) in compliance.eas_log']
  failure_reason varchar [note: 'Detailed explanation of why an EAS alert transmission failed or was missed, including technical or operational reasons. | Column failure_reason (STRING) in compliance.eas_log']
  ipaws_message_code varchar [note: 'Unique message identifier from FEMA IPAWS system for alerts originated through the national alert infrastructure. | Column ipaws_message_code (STRING) in compliance.eas_log']
  location_code varchar [note: 'Six-digit FIPS code identifying the geographic area affected by the alert (county or equivalent subdivision). | Column location_code (STRING) in compliance.eas_log']
  modified_timestamp timestamp [note: 'Timestamp when this EAS log record was last modified, supporting audit trail requirements. | Column modified_timestamp (TIMESTAMP) in compliance.eas_log']
  notes varchar [note: 'Free-form notes entered by station personnel regarding the EAS alert, including any special circumstances, corrective actions taken, or follow-up required. | Column notes (STRING) in compliance.eas_log']
  originator_code varchar [note: 'Three-letter code identifying the entity that originated the alert (e.g., PEP for Primary Entry Point, CIV for Civil Authority, WXR for National Weather Service, EAS for EAS Participant). | Column originator_code (STRING) in compliance.eas_log']
  originator_name varchar [note: 'Full name of the authority or organization that originated the EAS alert (e.g., FEMA IPAWS, National Weather Service, State Emergency Management Agency). | Column originator_name (STRING) in compliance.eas_log']
  public_inspection_file_entry boolean [note: 'Indicates whether this EAS log entry has been included in the stations public inspection file as required by FCC regulations. | Column public_inspection_file_entry (BOOLEAN) in compliance.eas_log']
  relay_chain_position varchar [note: 'Position of this station in the EAS relay chain, indicating how many hops the alert has traveled from the originator (1 for direct receipt, 2+ for relayed). | Column relay_chain_position (INT) in compliance.eas_log']
  retention_expiry_date date [note: 'Date when this EAS log record is eligible for deletion based on FCC retention requirements (minimum 2 years for EAS logs). | Column retention_expiry_date (DATE) in compliance.eas_log']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.eas_log']
  test_compliance_type varchar [note: 'Type of EAS test compliance this log entry satisfies: Required Weekly Test (RWT), Required Monthly Test (RMT), National Periodic Test, or none if not a test. | Column test_compliance_type (STRING) in compliance.eas_log']
  test_scheduled_date date [note: 'Date when the EAS test was scheduled to occur, used for tracking compliance with required weekly and monthly test schedules. | Column test_scheduled_date (DATE) in compliance.eas_log']
  transmission_status varchar [note: 'Status of the EAS alert transmission indicating whether the station successfully transmitted, received, relayed, failed to transmit, or missed the alert. | Column transmission_status (STRING) in compliance.eas_log']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.eas_log']
  upstream_source_callsign varchar [note: 'Call sign of the upstream station or source from which this station received the EAS alert for relay. | Column upstream_source_callsign (STRING) in compliance.eas_log']
  valid_time_period varchar [note: 'Four-digit code indicating the valid time period for the alert in 15-minute increments (e.g., 0030 for 30 minutes, 0100 for 1 hour). | Column valid_time_period (STRING) in compliance.eas_log']

  Note: 'Operational log of Emergency Alert System (EAS) activations and tests for FCC-licensed broadcast stations. Captures alert type (national, state, local), alert originator (FEMA IPAWS, NWS, state/local authority), activation timestamp, relay chain, transmission status, duration, required monthly/weekly test compliance, and any missed alert incidents. Required under FCC 47 CFR Part 11 for all EAS participants. | Unity Catalog table: media_broadcasting_ecm.compliance.eas_log'
}

Table compliance.political_ad_record {
  political_ad_record_id varchar [pk, note: 'Unique identifier for the political advertising compliance record. Primary key for tracking FCC political broadcasting obligations under 47 CFR §73.1940-73.1942. | Column political_ad_record_id (BIGINT) in compliance.political_ad_record']
  ad_order_id varchar [note: 'Reference to the advertising sales order in the traffic system that originated this political ad placement. | Column ad_order_id (BIGINT) in sales.political_ad_record']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Political ad records are tied to specific broadcast licenses under FCC political broadcasting rules. The record has broadcast_station_call_sign which should be replaced by FK to broadcast_license to g | Column broadcast_license_id (BIGINT) in compliance.political_ad_record']
  compliance_officer_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: FCC political advertising records require compliance officer review for equal time and reasonable access rules. Tracking reviewer employee is essential for audit trail and accountability. | Column compliance_officer_employee_id (BIGINT) in workforce.political_ad_record']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: FCC political advertising rules require broadcasters to maintain public inspection files linking political ad orders to the specific creative assets (spots) that aired. This enables verification of sp | Column media_asset_id (BIGINT) in mediaasset.political_ad_record']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Political ad records must identify the buying partner/agency for FCC public inspection file disclosure and reasonable access/equal time administration. The advertiser entity (campaign, PAC, party comm | Column partner_id (BIGINT) in partner.political_ad_record']
  public_inspection_file_id varchar [note: 'Foreign key linking to compliance.public_inspection_file. Business justification: Political ad records must be included in the station\'s public inspection file per FCC rules. This FK links each political ad record to its corresponding public file document, ensuring disclosure compl | Column public_inspection_file_id (BIGINT) in compliance.political_ad_record']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Political ads featuring talent require disclosure of talent identity, compensation, and sponsorship identification in public inspection files. Ad clearance teams document talent appearing in political | Column talent_profile_id (BIGINT) in talent.political_ad_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.political_ad_record']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.political_ad_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.political_ad_record']
  advertiser_type varchar [note: 'Classification of the political advertiser entity type for regulatory reporting and rate determination purposes. | Column advertiser_type (STRING) in compliance.political_ad_record']
  affidavit_issued_flag boolean [note: 'Indicates whether a broadcast affidavit (proof of performance) has been issued to the advertiser confirming that this political ad aired as scheduled. | Column affidavit_issued_flag (BOOLEAN) in compliance.political_ad_record']
  air_date date [note: 'Calendar date on which the political advertisement was broadcast or is scheduled to broadcast. | Column air_date (DATE) in compliance.political_ad_record']
  air_time timestamp [note: 'Precise timestamp when the political advertisement aired or is scheduled to air, including time zone. Required for public inspection file and affidavit of performance. | Column air_time (TIMESTAMP) in compliance.political_ad_record']
  candidate_name varchar [note: 'Name of the political candidate featured or referenced in the advertisement, if applicable. Null for issue advocacy ads without candidate reference. | Column candidate_name (STRING) in compliance.political_ad_record']
  compliance_notes varchar [note: 'Free-text field for documenting compliance issues, remediation actions, equal opportunities requests, reasonable access determinations, or other regulatory notes related to this political ad placement. | Column compliance_notes (STRING) in compliance.political_ad_record']
  compliance_status varchar [note: 'Current regulatory compliance status of this political ad record indicating whether all FCC political broadcasting requirements have been met. | Column compliance_status (STRING) in compliance.political_ad_record']
  contract_number varchar [note: 'Sales contract or agreement number under which this political advertisement was purchased. Links to the traffic system sales order. | Column contract_number (STRING) in compliance.political_ad_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.political_ad_record']
  created_timestamp timestamp [note: 'Timestamp when this political ad compliance record was first created in the system. Part of audit trail for regulatory record-keeping. | Column created_timestamp (TIMESTAMP) in compliance.political_ad_record']
  daypart varchar [note: 'Broadcast daypart segment during which the ad aired (e.g., Prime Time, Early Morning, Late Fringe). Used for rate class determination and Lowest Unit Charge (LUC) comparison. | Column daypart (STRING) in compliance.political_ad_record']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  election_date date [note: 'Scheduled date of the election to which this political advertisement relates. Critical for determining Lowest Unit Charge (LUC) period applicability (45 days before primary, 60 days before general election). | Column election_date (DATE) in compliance.political_ad_record']
  election_type varchar [note: 'Type of election for which the political advertisement is being aired. | Column election_type (STRING) in compliance.political_ad_record']
  equal_opportunities_request_flag boolean [note: 'Indicates whether this ad placement was triggered by an equal opportunities request under Section 315 of the Communications Act, requiring equal treatment of opposing candidates. | Column equal_opportunities_request_flag (BOOLEAN) in compliance.political_ad_record']
  isci_code varchar [note: 'Industry Standard Commercial Identification code uniquely identifying the creative asset aired. Standard 12-character alphanumeric code used for ad tracking and affidavit verification. | Column isci_code (STRING) in compliance.political_ad_record']
  jurisdiction_level varchar [note: 'Governmental jurisdiction level of the race or ballot measure (federal, state, or local) for compliance categorization and public file organization. | Column jurisdiction_level (STRING) in compliance.political_ad_record']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to this political ad compliance record. Tracks changes for audit and compliance verification purposes. | Column last_modified_timestamp (TIMESTAMP) in compliance.political_ad_record']
  luc_period_flag boolean [note: 'Indicates whether this ad aired during the Lowest Unit Charge (LUC) period (45 days before primary or 60 days before general election) when special rate protections apply to candidate ads. | Column luc_period_flag (BOOLEAN) in compliance.political_ad_record']
  luc_rate decimal(15,2) [note: 'The lowest unit charge rate applicable to this spot based on the rate class and daypart during the pre-election window (45 days before primary, 60 days before general election). Null if outside LUC period. | Column luc_rate (DECIMAL(15,2)) in compliance.political_ad_record']
  makegood_flag boolean [note: 'Indicates whether this ad spot is a compensatory makegood placement provided due to a previous preemption or technical failure. | Column makegood_flag (BOOLEAN) in compliance.political_ad_record']
  market_name varchar [note: 'Designated Market Area (DMA) or Nielsen market name where the political advertisement aired. Used for geographic compliance tracking. | Column market_name (STRING) in compliance.political_ad_record']
  office_sought varchar [note: 'The elected office or ballot measure that the political advertisement relates to (e.g., President, U.S. Senate, Governor, State Representative, Proposition 22). | Column office_sought (STRING) in compliance.political_ad_record']
  preemption_flag boolean [note: 'Indicates whether this scheduled political ad spot was preempted and did not air as originally scheduled. Triggers makegood obligations. | Column preemption_flag (BOOLEAN) in compliance.political_ad_record']
  program_name varchar [note: 'Name of the television or radio program during which the political advertisement aired. Required for public file disclosure. | Column program_name (STRING) in compliance.political_ad_record']
  public_file_disclosure_date date [note: 'Date when this political ad record was uploaded to the stations online public inspection file as required by FCC rules. Must occur immediately upon ad placement. | Column public_file_disclosure_date (DATE) in compliance.political_ad_record']
  rate_charged decimal(15,2) [note: 'Actual dollar amount charged to the political advertiser for this spot placement. Must comply with Lowest Unit Charge (LUC) requirements during pre-election windows. | Column rate_charged (DECIMAL(15,2)) in compliance.political_ad_record']
  rate_class varchar [note: 'Commercial rate classification applied to this spot (e.g., Fixed, Preemptible-1, Preemptible-2, Run-of-Schedule). Determines Lowest Unit Charge (LUC) eligibility and comparison group. | Column rate_class (STRING) in compliance.political_ad_record']
  reasonable_access_request_flag boolean [note: 'Indicates whether this ad placement was the result of a federal candidate reasonable access request under Section 312(a)(7) of the Communications Act, requiring broadcasters to provide reasonable access to federal candidates. | Column reasonable_access_request_flag (BOOLEAN) in compliance.political_ad_record']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.political_ad_record']
  sponsor_address varchar [note: 'Mailing address of the political advertiser or sponsor. Required for public inspection file disclosure. | Column sponsor_address (STRING) in compliance.political_ad_record']
  sponsor_contact_name varchar [note: 'Name of the individual or organization contact person responsible for the political advertisement purchase. Required for public file records. | Column sponsor_contact_name (STRING) in compliance.political_ad_record']
  sponsor_email varchar [note: 'Email address of the political advertiser or sponsor contact for correspondence and compliance communication. | Column sponsor_email (STRING) in compliance.political_ad_record']
  sponsor_phone varchar [note: 'Contact telephone number for the political advertiser or sponsor. Required for public file records. | Column sponsor_phone (STRING) in compliance.political_ad_record']
  sponsorship_identification varchar [note: 'The on-air sponsorship disclosure statement identifying who paid for the advertisement (e.g., \'Paid for by Committee to Elect Jane Smith\'). Required by FCC sponsorship identification rules. | Column sponsorship_identification (STRING) in compliance.political_ad_record']
  spot_length_seconds varchar [note: 'Duration of the political advertisement spot in seconds (e.g., 15, 30, 60, 120). Used for rate calculation and inventory management. | Column spot_length_seconds (INT) in compliance.political_ad_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.political_ad_record']

  Note: 'Compliance record for political advertising under FCC political broadcasting rules (47 CFR §73.1940, §73.1941, §73.1942). Tracks candidate or issue advertiser, federal/state/local race, lowest unit charge (LUC) rate applied, equal opportunities requests, reasonable access requests, sponsorship identification, air date and time, and public file disclosure. Mandatory for all FCC-licensed stations during election periods. | Unity Catalog table: media_broadcasting_ecm.compliance.political_ad_record'
}

Table compliance.sox_control {
  sox_control_id varchar [pk, note: 'Unique identifier for the SOX control record. Primary key for the sox_control product. | Column sox_control_id (BIGINT) in compliance.sox_control']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: SOX control deficiencies are documented as audit findings. This FK links a SOX control to any audit finding that identified a deficiency in that control. Note: Using \'related_audit_finding_id\' as the  | Column audit_finding_id (BIGINT) in compliance.sox_control']
  compensating_control_id varchar [note: 'Reference to another SOX control that serves as a compensating control if this control fails or is temporarily inactive. Compensating controls provide alternative assurance over the same financial reporting risk. | Column compensating_control_id (BIGINT) in compliance.sox_control']
  control_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: SOX controls require named employee owners for accountability in financial reporting compliance. Control owner text should reference employee record for audit trail and performance tracking. | Column control_owner_employee_id (BIGINT) in workforce.sox_control']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.sox_control']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.sox_control']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.sox_control']
  assertion_category varchar [note: 'The financial statement assertion that this control addresses. Existence ensures recorded transactions occurred; completeness ensures all transactions are recorded; accuracy ensures amounts are correct; valuation ensures proper measurement; rights and obligations ensure the entity has legal claim; presentation and disclosure ensure proper classification and disclosure; cutoff ensures transactions are recorded in the correct period. [ENUM-REF-CANDIDATE: existence|completeness|accuracy|valuation|rights and obligations|presentation and disclosure|cutoff — 7 candidates stripped; promote to reference product] | Column assertion_category (STRING) in compliance.sox_control']
  auditor_notes varchar [note: 'Comments and observations from internal or external auditors regarding control design, operating effectiveness, or areas for improvement. Supports audit trail and continuous improvement. | Column auditor_notes (STRING) in compliance.sox_control']
  automated_flag boolean [note: 'Indicates whether the control is fully automated (True) or requires manual execution (False). Automated controls are typically embedded in financial systems and execute without human intervention. | Column automated_flag (BOOLEAN) in compliance.sox_control']
  control_description varchar [note: 'Comprehensive description of the control activity, including specific procedures, data sources, systems involved, thresholds, and documentation requirements. For media companies, may reference systems such as Wide Orbit (traffic and billing), Rightsline (rights management), or Zuora (subscription billing). | Column control_description (STRING) in compliance.sox_control']
  control_documentation_path varchar [note: 'File path or document management system reference to the detailed control documentation, including procedures, flowcharts, and testing workpapers. Used for audit evidence and compliance verification. | Column control_documentation_path (STRING) in compliance.sox_control']
  control_frequency varchar [note: 'How often the control is performed or operates. Continuous controls run automatically in real-time (e.g., system validations); periodic controls are executed at defined intervals; event-driven controls are triggered by specific business events (e.g., contract execution, content release). [ENUM-REF-CANDIDATE: continuous|daily|weekly|monthly|quarterly|annual|event-driven — 7 candidates stripped; promote to reference product] | Column control_frequency (STRING) in compliance.sox_control']
  control_name varchar [note: 'Short descriptive name of the control that summarizes its purpose (e.g., \'Advertising Revenue Recognition Review\', \'Subscriber Billing Reconciliation\'). | Column control_name (STRING) in compliance.sox_control']
  control_number varchar [note: 'Business identifier for the control, typically formatted as a prefix code followed by a numeric sequence (e.g., FIN-001, REV-1234). Used for external reference and audit documentation. | Column control_number (STRING) in compliance.sox_control']
  control_objective varchar [note: 'Detailed statement of what the control is designed to achieve, including the specific financial reporting assertion it addresses (existence, completeness, accuracy, valuation, rights and obligations, presentation and disclosure). | Column control_objective (STRING) in compliance.sox_control']
  control_status varchar [note: 'Current operational status of the control. Active controls are in effect; inactive controls are temporarily suspended; under remediation indicates deficiencies are being addressed; pending implementation means the control is designed but not yet operational; retired controls are no longer applicable. | Column control_status (STRING) in compliance.sox_control']
  control_type varchar [note: 'Classification of the control based on its nature and timing. Preventive controls stop errors before they occur; detective controls identify errors after occurrence; IT general controls (ITGC) govern system access and change management; IT application controls are embedded in financial systems; entity-level controls address governance and culture; management review controls involve oversight and analysis. | Column control_type (STRING) in compliance.sox_control']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.sox_control']
  created_timestamp timestamp [note: 'Timestamp when this control record was first created in the system. Part of audit trail for control lifecycle management. | Column created_timestamp (TIMESTAMP) in compliance.sox_control']
  deficiency_classification varchar [note: 'Severity classification of any identified control deficiency. No deficiency means the control is effective; control deficiency is a minor issue unlikely to result in misstatement; significant deficiency is important enough to merit attention by those charged with governance; material weakness is a deficiency or combination of deficiencies that creates a reasonable possibility of material misstatement not being prevented or detected. | Column deficiency_classification (STRING) in compliance.sox_control']
  deficiency_description varchar [note: 'Detailed explanation of any identified control deficiency, including the nature of the failure, root cause analysis, and potential impact on financial reporting. Null if no deficiency exists. | Column deficiency_description (STRING) in compliance.sox_control']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_date date [note: 'Date on which the control became operational and began addressing the identified financial reporting risk. Used to track control lifecycle and determine testing periods. | Column effective_date (DATE) in compliance.sox_control']
  financial_statement_line_item varchar [note: 'The specific financial statement account or line item that this control impacts (e.g., \'Advertising Revenue\', \'Subscription Revenue\', \'Content Amortization Expense\', \'Accounts Receivable\', \'Deferred Revenue\'). Maps control to financial reporting impact. | Column financial_statement_line_item (STRING) in compliance.sox_control']
  key_control_flag boolean [note: 'Indicates whether this is a key control (True) that directly addresses a significant risk to financial reporting, or a supporting control (False). Key controls receive more rigorous testing and documentation. | Column key_control_flag (BOOLEAN) in compliance.sox_control']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to this control record. Tracks changes to control design, ownership, status, or test results. | Column last_modified_timestamp (TIMESTAMP) in compliance.sox_control']
  last_test_date date [note: 'The most recent date on which the control was formally tested for design and operating effectiveness by internal audit, external auditors, or control owners. | Column last_test_date (DATE) in compliance.sox_control']
  management_assertion_mapping varchar [note: 'Mapping of this control to management\'s assertions under SOX Section 302 (CEO/CFO certification) and Section 404 (internal control over financial reporting). Documents how this control supports management\'s ability to assert the effectiveness of internal controls. | Column management_assertion_mapping (STRING) in compliance.sox_control']
  process_area varchar [note: 'The business process or financial cycle to which this control applies. Media-specific areas include advertising revenue recognition (CPM, GRP-based billing), carriage fee billing (MVPD/vMVPD distribution payments), subscriber billing (SVOD, TVOD), content licensing revenue (syndication, windowing), rights royalty accruals (talent residuals, music licensing), and barter transactions (ad inventory exchanges). [ENUM-REF-CANDIDATE: advertising revenue recognition|carriage fee billing|subscriber billing|content licensing revenue|rights royalty accruals|barter transactions|production cost capitalization|content amortization|deferred revenue|accounts receivable|accounts payable|payroll|treasury|tax compliance|financial close|general ledger|fixed assets|inventory|intercompany transactions — 19 candidates stripped; promote to reference product] | Column process_area (STRING) in compliance.sox_control']
  remediation_plan varchar [note: 'Action plan to address identified deficiencies, including specific corrective actions, responsible parties, and target completion dates. Null if no remediation is required. | Column remediation_plan (STRING) in compliance.sox_control']
  remediation_status varchar [note: 'Current status of remediation efforts for identified deficiencies. Not applicable if no deficiency exists; planned means remediation is designed but not started; in progress indicates active remediation; completed means actions are finished but not yet validated; validated means remediation has been tested and confirmed effective. | Column remediation_status (STRING) in compliance.sox_control']
  remediation_target_date date [note: 'Target date by which remediation activities are expected to be completed and validated. Null if no remediation is required. | Column remediation_target_date (DATE) in compliance.sox_control']
  retirement_date date [note: 'Date on which the control was retired or superseded by another control. Null for active controls. Used for historical tracking and audit trail. | Column retirement_date (DATE) in compliance.sox_control']
  risk_rating varchar [note: 'Assessment of the inherent risk level associated with the process area this control addresses. Critical and high ratings indicate areas with significant potential for material misstatement if controls fail. | Column risk_rating (STRING) in compliance.sox_control']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.sox_control']
  system_name varchar [note: 'Name of the primary financial or operational system in which the control is executed or from which control evidence is derived (e.g., \'SAP S/4HANA FI\', \'Wide Orbit Traffic\', \'Zuora Billing\', \'Rightsline Rights Management\'). | Column system_name (STRING) in compliance.sox_control']
  test_frequency varchar [note: 'How often the control is formally tested for effectiveness. Quarterly testing is typical for key controls; annual testing may suffice for lower-risk controls; event-driven testing occurs when significant changes are made to the control or underlying process. | Column test_frequency (STRING) in compliance.sox_control']
  test_result varchar [note: 'Outcome of the most recent control test. Effective means the control operated as designed with no exceptions; ineffective with exception indicates isolated failures that do not rise to a deficiency; ineffective means the control did not operate as designed; not tested means no evaluation has been performed. | Column test_result (STRING) in compliance.sox_control']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.sox_control']

  Note: 'Master registry of Sarbanes-Oxley (SOX) internal controls applicable to the organization\'s financial reporting processes, with emphasis on media-specific revenue streams. Captures control ID, control name, control objective, process area (advertising revenue recognition, carriage fee billing, subscriber billing, content licensing revenue, rights royalty accruals, barter transactions), control type (preventive, detective, IT general, IT application), frequency (continuous, daily, monthly, quarterly, annual), control owner, last test date, test result (effective, ineffective with exception, ineffective), deficiency classification (control deficiency, significant deficiency, material weakness), remediation plan, and management assertion mapping. Supports SOX Section 302 and 404 compliance for publicly traded media companies. | Unity Catalog table: media_broadcasting_ecm.compliance.sox_control'
}

Table compliance.audit_finding {
  audit_finding_id varchar [pk, note: 'Unique identifier for the audit finding record. Primary key. | Column audit_finding_id (BIGINT) in compliance.audit_finding']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Audit findings may relate to accessibility compliance (e.g., closed captioning deficiencies, audio description gaps). This FK links the finding to the specific accessibility obligation that was violat | Column accessibility_obligation_id (BIGINT) in compliance.audit_finding']
  audit_id varchar [note: 'Reference to the parent audit engagement or audit project during which this finding was identified. | Column audit_id (BIGINT) in compliance.audit_finding']
  channel_id varchar [note: 'Reference to the broadcast station or channel to which this finding applies, if the finding is station-specific (e.g., FCC license compliance, public inspection file deficiency). | Column channel_id (BIGINT) in scheduling.audit_finding']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Compliance audits (FCC, internal, SOX) often identify issues with specific media assets: rights clearance violations, indecency complaints, technical non-compliance (loudness, captioning), or content  | Column media_asset_id (BIGINT) in mediaasset.audit_finding']
  previous_finding_audit_finding_id varchar [note: 'Reference to the prior audit finding record if this is a recurrence, enabling tracking of repeat issues and corrective action effectiveness. | Column previous_finding_audit_finding_id (BIGINT) in compliance.audit_finding']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Audit findings may result in regulatory filings (e.g., corrective action reports, compliance certifications). This FK links findings to any regulatory filings they triggered, supporting audit trail re | Column regulatory_filing_id (BIGINT) in compliance.audit_finding']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Audit findings often relate to specific regulatory obligations (e.g., finding that FCC public file requirements were not met). This FK links the finding to the obligation it evaluates, supporting comp | Column regulatory_obligation_id (BIGINT) in compliance.audit_finding']
  remediation_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Audit findings require assigned employee for remediation tracking and accountability. Remediation owner text should reference employee record for workload management and performance evaluation. | Column remediation_owner_employee_id (BIGINT) in workforce.audit_finding']
  title_id varchar [note: 'Reference to the specific content asset, program, or title associated with this finding, if the finding pertains to content standards, ratings, clearance, or captioning compliance. | Column title_id (BIGINT) in content.audit_finding']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: FCC/regulatory audit findings often cite specific equipment non-compliance (power output variance, frequency deviation). Real audit workflow requires equipment-level tracking for remediation and verif | Column transmission_equipment_id (BIGINT) in technology.audit_finding']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.audit_finding']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.audit_finding']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.audit_finding']
  actual_resolution_date date [note: 'The actual date on which the remediation action was completed and verified, resulting in closure of the finding. | Column actual_resolution_date (DATE) in compliance.audit_finding']
  affected_process varchar [note: 'The business process, operational area, or functional domain impacted by this finding (e.g., Content Acquisition and Licensing, Program Scheduling and Playout, Advertising Sales and Campaign Management, Rights and Royalties Management, Subscriber and Membership Management). | Column affected_process (STRING) in compliance.audit_finding']
  affected_system varchar [note: 'The operational system, application, or platform where the non-compliance or control deficiency was identified (e.g., Dalet Galaxy, Wide Orbit, SAP S/4HANA, Salesforce Media Cloud, Nielsen Media Research Platform, Ericsson MediaFirst, Adobe Experience Platform, Rightsline, Akamai CDN, Zuora). | Column affected_system (STRING) in compliance.audit_finding']
  audit_period_end_date date [note: 'The end date of the audit period or scope during which the condition leading to this finding occurred. | Column audit_period_end_date (DATE) in compliance.audit_finding']
  audit_period_start_date date [note: 'The start date of the audit period or scope during which the condition leading to this finding occurred. | Column audit_period_start_date (DATE) in compliance.audit_finding']
  audit_type varchar [note: 'Classification of the audit engagement: internal (conducted by internal audit team), external (third-party auditor), regulatory (government agency inspection), certification (ISO/standards body), or surveillance (ongoing compliance monitoring). | Column audit_type (STRING) in compliance.audit_finding']
  auditor_name varchar [note: 'Name of the lead auditor or audit firm responsible for identifying and documenting this finding. | Column auditor_name (STRING) in compliance.audit_finding']
  auditor_type varchar [note: 'Classification of the auditor: internal (company internal audit team), external (third-party audit firm), regulatory (government agency inspector or regulator). | Column auditor_type (STRING) in compliance.audit_finding']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.audit_finding']
  created_timestamp timestamp [note: 'Timestamp when this audit finding record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.audit_finding']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  finding_category varchar [note: 'High-level categorization of the finding type. [ENUM-REF-CANDIDATE: License Compliance|Content Standards Violation|Data Privacy Breach|Financial Reporting Error|Technical Standards Non-Conformance|Accessibility Non-Compliance|Rights Clearance Issue|Consent Management Deficiency|Public File Deficiency|Affidavit Discrepancy|Process Control Weakness|Documentation Gap — promote to reference product] | Column finding_category (STRING) in compliance.audit_finding']
  finding_description varchar [note: 'Detailed narrative description of the audit finding, including the specific condition observed, the standard or requirement violated, and the evidence supporting the finding. | Column finding_description (STRING) in compliance.audit_finding']
  finding_number varchar [note: 'Business identifier or reference number assigned to this finding for tracking and reporting purposes (e.g., FCC-2024-001, SOX-Q1-042). | Column finding_number (STRING) in compliance.audit_finding']
  finding_status varchar [note: 'Current lifecycle status of the finding: open (newly identified, not yet addressed), in_remediation (corrective action underway), pending_verification (remediation complete, awaiting validation), closed (verified and resolved), deferred (accepted risk or postponed remediation). | Column finding_status (STRING) in compliance.audit_finding']
  identified_date date [note: 'The date on which the audit finding was first identified or documented during the audit engagement. | Column identified_date (DATE) in compliance.audit_finding']
  last_modified_timestamp timestamp [note: 'Timestamp when this audit finding record was last updated or modified, supporting audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in compliance.audit_finding']
  management_response varchar [note: 'Formal response or action plan provided by management in reply to the audit finding, including agreement or disagreement with the finding, proposed corrective actions, and committed timelines. | Column management_response (STRING) in compliance.audit_finding']
  notes varchar [note: 'Additional notes, comments, or supplementary information related to the finding, remediation progress, or verification activities. | Column notes (STRING) in compliance.audit_finding']
  penalty_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the potential penalty amount (e.g., USD, GBP, EUR). | Column penalty_currency_code (STRING) in compliance.audit_finding']
  potential_penalty_amount decimal(15,2) [note: 'Estimated or assessed monetary penalty, fine, or forfeiture amount that could be imposed by the regulatory authority if the finding is not remediated or if enforcement action is taken. | Column potential_penalty_amount (DECIMAL(15,2)) in compliance.audit_finding']
  recommended_remediation varchar [note: 'The corrective action or remediation plan recommended by the auditor to address the finding and prevent recurrence. | Column recommended_remediation (STRING) in compliance.audit_finding']
  recurrence_indicator boolean [note: 'Boolean flag indicating whether this finding is a repeat or recurrence of a previously identified and closed finding, suggesting ineffective corrective action or systemic control weakness. | Column recurrence_indicator (BOOLEAN) in compliance.audit_finding']
  regulatory_citation varchar [note: 'Specific regulatory rule, statute, standard, or policy section that was violated or not met (e.g., 47 CFR 73.3526 for FCC public file requirements, GDPR Article 32 for security measures, SOX Section 404 for internal controls). | Column regulatory_citation (STRING) in compliance.audit_finding']
  regulatory_domain varchar [note: 'The regulatory or compliance domain to which this finding pertains. [ENUM-REF-CANDIDATE: FCC Broadcast Licensing|Ofcom Broadcasting Standards|MPA Content Ratings|COPPA Childrens Content|GDPR Data Privacy|CCPA Consumer Privacy|SOX Financial Reporting|PCI DSS Payment Security|ATSC Technical Standards|DVB Technical Standards|Accessibility Mandates|Content Clearance|Closed Captioning|Consent Management — promote to reference product] | Column regulatory_domain (STRING) in compliance.audit_finding']
  regulatory_reference_number varchar [note: 'External reference number or citation assigned by the regulatory body or governing authority (e.g., FCC Notice of Violation number, Ofcom enforcement case reference, SOX deficiency ID). | Column regulatory_reference_number (STRING) in compliance.audit_finding']
  risk_rating varchar [note: 'Overall risk rating assigned to this finding based on likelihood of regulatory enforcement, potential financial impact, reputational damage, and operational disruption. | Column risk_rating (STRING) in compliance.audit_finding']
  root_cause varchar [note: 'Analysis of the underlying root cause or contributing factors that led to the non-compliance or control deficiency (e.g., inadequate training, process gap, system limitation, human error, policy ambiguity). | Column root_cause (STRING) in compliance.audit_finding']
  severity varchar [note: 'Severity level of the finding based on risk impact and regulatory consequence: critical (immediate regulatory action or material breach), high (significant risk or non-compliance), medium (moderate risk requiring timely remediation), low (minor issue or observation). | Column severity (STRING) in compliance.audit_finding']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.audit_finding']
  target_resolution_date date [note: 'The target or committed date by which the remediation action is expected to be completed and the finding closed. | Column target_resolution_date (DATE) in compliance.audit_finding']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.audit_finding']
  verification_date date [note: 'The date on which the remediation action was verified or validated by the auditor or compliance officer. | Column verification_date (DATE) in compliance.audit_finding']
  verification_status varchar [note: 'Status of the verification or validation process to confirm that the remediation action effectively addressed the finding: not_started (remediation not yet verified), in_progress (verification underway), completed (remediation verified and effective), failed (remediation inadequate, finding remains open). | Column verification_status (STRING) in compliance.audit_finding']
  verified_by varchar [note: 'Name or identifier of the auditor, compliance officer, or quality assurance personnel who verified the effectiveness of the remediation action. | Column verified_by (STRING) in compliance.audit_finding']

  Note: 'Records findings from internal and external compliance audits across all regulatory domains (FCC, Ofcom, SOX, GDPR, CCPA, PCI DSS, COPPA). Captures audit type, audit period, auditor (internal/external), finding category, severity (critical, high, medium, low), affected process or system, root cause, recommended remediation, remediation owner, target resolution date, and closure status. Drives the compliance remediation workflow. | Unity Catalog table: media_broadcasting_ecm.compliance.audit_finding'
}

Table compliance.regulatory_obligation {
  regulatory_obligation_id varchar [pk, note: 'Unique identifier for the regulatory obligation record. Primary key. | Column regulatory_obligation_id (BIGINT) in compliance.regulatory_obligation']
