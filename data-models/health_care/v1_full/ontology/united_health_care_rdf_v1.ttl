    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:higherScoreInterpretation rdf:type rdf:Property ;
    rdfs:label 'Higher Score Interpretation' ;
    rdfs:comment 'Indicates whether a higher measure score represents better performance, worse performance, or is not applicable.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumDenominatorSize rdf:type rdf:Property ;
    rdfs:label 'Minimum Denominator Size' ;
    rdfs:comment 'Minimum number of eligible members required in the denominator for the measure to be reportable and statistically valid.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:starsRatingApplicable rdf:type rdf:Property ;
    rdfs:label 'Stars Rating Applicable' ;
