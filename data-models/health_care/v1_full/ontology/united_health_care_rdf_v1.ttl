    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reimbursementMethodId rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Method Id' ;
    rdfs:comment 'Unique identifier for the reimbursement methodology used in provider contracts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReimbursementMethod .

ind:riskSharingIndicator rdf:type rdf:Property ;
    rdfs:label 'Risk Sharing Indicator' ;
    rdfs:comment 'Indicates whether this reimbursement method includes risk-sharing arrangements between payer and provider.' ;
    rdfs:domain ind:ReimbursementMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueBasedIndicator rdf:type rdf:Property ;
    rdfs:label 'Value Based Indicator' ;
    rdfs:comment 'Indicates whether this reimbursement method is a value-based care arrangement tied to quality metrics and outcomes.' ;
    rdfs:domain ind:ReimbursementMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calculationMethodology rdf:type rdf:Property ;
    rdfs:label 'Calculation Methodology' ;
    rdfs:comment 'Detailed explanation of how payment amounts are calculated under this reimbursement method, including formulas and adjustment factors.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseRateType rdf:type rdf:Property ;
    rdfs:label 'Base Rate Type' ;
    rdfs:comment 'The type of base rate used in payment calculation (fixed amount, percentage of charges, percentage of Medicare, percentage of billed, negotiated rate, market-based, cost-based).' ;
