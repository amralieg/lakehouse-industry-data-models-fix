    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reidentificationRiskAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Reidentification Risk Assessment Date' ;
    rdfs:comment 'The date when the re-identification risk assessment was last performed for this dataset.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reidentificationRiskScore rdf:type rdf:Property ;
