  template_name varchar [note: 'Human-readable name describing the purpose of the recurring journal entry template. | Column template_name (STRING) in finance.recurring_entry_template']
  template_type varchar [note: 'Classification of the recurring entry template by accounting treatment type. | Column template_type (STRING) in finance.recurring_entry_template']
  trading_partner_code varchar [note: 'Code identifying the intercompany trading partner entity for intercompany recurring entries. Applicable only when intercompany_flag is true. | Column trading_partner_code (STRING) in finance.recurring_entry_template']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.recurring_entry_template']

  Note: 'Master reference table for recurring_entry_template. Referenced by recurring_entry_template_id. | Unity Catalog table: media_broadcasting_ecm.finance.recurring_entry_template SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
