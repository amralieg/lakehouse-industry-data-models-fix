ind:retroactiveEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Effective Date' ;
    rdfs:comment 'The retroactive effective date if coverage was backdated after enrollment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retroactiveTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Termination Date' ;
    rdfs:comment 'The retroactive termination date if coverage was terminated retroactively.' ;
