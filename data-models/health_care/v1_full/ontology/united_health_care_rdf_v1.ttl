ind:icd10Codes rdf:type rdf:Property ;
    rdfs:label 'Icd10 Codes' ;
    rdfs:comment 'Comma-separated list of ICD-10 diagnosis codes used in numerator, denominator, or exclusion criteria.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptCodes rdf:type rdf:Property ;
    rdfs:label 'Cpt Codes' ;
    rdfs:comment 'Comma-separated list of CPT procedure codes used in numerator, denominator, or exclusion criteria.' ;
