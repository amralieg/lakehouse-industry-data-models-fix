    rdfs:range xsd:string .

ind:slaResolutionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Resolution Hours' ;
    rdfs:comment 'Target number of hours for complete resolution of service issues in this category as defined by SLA commitments.' ;
