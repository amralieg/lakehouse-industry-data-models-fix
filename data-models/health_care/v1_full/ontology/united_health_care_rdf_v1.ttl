ind:effectiveTaxRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Effective Tax Rate Percentage' ;
    rdfs:comment 'Effective tax rate calculated as total tax expense divided by pre-tax income (expressed as decimal).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
