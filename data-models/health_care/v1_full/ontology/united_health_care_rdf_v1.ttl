    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commissionFlag rdf:type rdf:Property ;
    rdfs:label 'Commission Flag' ;
    rdfs:comment 'Indicates whether this AR line item includes or relates to broker or agent commission.' ;
    rdfs:domain ind:ArLine ;
