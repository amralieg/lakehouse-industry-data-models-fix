  root_cause_analysis varchar [note: 'Documented analysis of the underlying cause of the dispute, used for process improvement and future prevention. | Column root_cause_analysis (STRING) in partner.partner_dispute']
  settlement_amount_usd decimal(18,2) [note: 'Final settlement amount agreed upon or awarded, expressed in USD. May differ from the originally disputed amount. | Column settlement_amount_usd (DECIMAL(18,2)) in partner.partner_dispute']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.partner_dispute']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.partner_dispute']
  supporting_evidence_location varchar [note: 'File path, document repository reference, or Media Asset Management (MAM) location where supporting evidence and documentation are stored. | Column supporting_evidence_location (STRING) in partner.partner_dispute']
  target_resolution_date date [note: 'Target date by which the dispute should be resolved per contractual Service Level Agreement (SLA) or internal policy. | Column target_resolution_date (DATE) in partner.partner_dispute']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.partner_dispute']
