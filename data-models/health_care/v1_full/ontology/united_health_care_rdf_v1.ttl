    rdfs:comment 'Indicates whether case resolution at this priority level requires supervisor approval before closure.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:categoryId rdf:type rdf:Property ;
    rdfs:label 'Category Id' ;
    rdfs:comment 'Unique identifier for the service issue category. Primary key for the category reference table.' ;
