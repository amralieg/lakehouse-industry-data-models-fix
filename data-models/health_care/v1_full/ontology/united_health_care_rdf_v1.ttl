ind:fcrTargetPct rdf:type rdf:Property ;
    rdfs:label 'Fcr Target Pct' ;
    rdfs:comment 'Target percentage for First Call Resolution (FCR) for cases at this priority level, measuring ability to resolve member issues on initial contact.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ahtTargetMinutes rdf:type rdf:Property ;
    rdfs:label 'Aht Target Minutes' ;
    rdfs:comment 'Target Average Handle Time (AHT) in minutes for cases at this priority level, balancing efficiency with quality resolution.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
