ind:monitoringLevel rdf:type rdf:Property ;
    rdfs:label 'Monitoring Level' ;
    rdfs:comment 'Level of ongoing monitoring assigned to the provider based on credentialing findings and risk assessment.' ;
    rdfs:domain ind:CredentialingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractExecutedFlag rdf:type rdf:Property ;
    rdfs:label 'Contract Executed Flag' ;
    rdfs:comment 'Indicator of whether the provider contract has been fully executed following credentialing approval.' ;
    rdfs:domain ind:CredentialingDecision ;
    rdf:type owl:DatatypeProperty ;
