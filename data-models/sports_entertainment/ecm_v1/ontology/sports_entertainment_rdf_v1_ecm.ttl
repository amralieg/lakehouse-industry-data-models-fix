    rdfs:comment 'The business date on which the payment proposal was created or submitted for approval.' ;
    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proposalNumber rdf:type rdf:Property ;
    rdfs:label 'Proposal Number' ;
    rdfs:comment 'Externally visible unique business identifier for the payment proposal, formatted as PP-NNNNNNNN.' ;
    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposalStatus rdf:type rdf:Property ;
    rdfs:label 'Proposal Status' ;
    rdfs:comment 'Current lifecycle status of the payment proposal in the approval and execution workflow.' ;
    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Payment Date' ;
    rdfs:comment 'The target date on which the payment is scheduled to be executed if approved.' ;
    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vendorBankAccountId rdf:type rdf:Property ;
