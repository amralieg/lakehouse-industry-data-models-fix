ind:EligibilityCriteriaEvaluation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalTrialMatching ;
    rdfs:label 'Eligibility Criteria Evaluation' ;
    rdfs:comment 'Eligibility criteria evaluation' .

ind:DigitalHealthPatientEngagement rdf:type rdfs:Class ;
