    rdfs:range xsd:string .

ind:esrdIndicator rdf:type rdf:Property ;
    rdfs:label 'Esrd Indicator' ;
    rdfs:comment 'Indicates whether the member has End Stage Renal Disease (ESRD), which affects Medicare eligibility and plan options.' ;
    rdfs:domain ind:UnitedHealthCare ;
