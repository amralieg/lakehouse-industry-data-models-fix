ind:territoryCode rdf:type rdf:Property ;
    rdfs:label 'Territory Code' ;
    rdfs:comment 'Geographic territory or region code assigned to the broker for sales and service responsibilities.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'Official website address of the broker or brokerage firm.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyAdministratorId rdf:type rdf:Property ;
    rdfs:label 'Third Party Administrator Id' ;
    rdfs:comment 'Primary key for third_party_administrator' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ThirdPartyAdministrator .

ind:electronicPayerId rdf:type rdf:Property ;
    rdfs:label 'Electronic Payer Id' ;
    rdfs:comment 'Unique payer identification number used in electronic data interchange (EDI) transactions for claims and eligibility verification.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:parentThirdPartyAdministratorId rdf:type rdf:Property ;
    rdfs:label 'Parent Third Party Administrator Id' ;
    rdfs:comment 'Self-referencing FK on third_party_administrator (parent_third_party_administrator_id)' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ThirdPartyAdministrator .

ind:accreditationStatus rdf:type rdf:Property ;
    rdfs:label 'Accreditation Status' ;
    rdfs:comment 'Current accreditation status of the TPA from recognized healthcare quality organizations such as NCQA, URAC, or AAAHC.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessContinuityPlanVerified rdf:type rdf:Property ;
    rdfs:label 'Business Continuity Plan Verified' ;
    rdfs:comment 'Indicates whether the TPAs business continuity and disaster recovery plan has been reviewed and verified to meet healthcare organization requirements.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsProcessingCapability rdf:type rdf:Property ;
    rdfs:label 'Claims Processing Capability' ;
    rdfs:comment 'Indicates whether the TPA has the capability and authorization to process medical and pharmacy claims on behalf of the health plan.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsSubmissionAddress rdf:type rdf:Property ;
    rdfs:label 'Claims Submission Address' ;
    rdfs:comment 'Mailing address where paper claims should be submitted to the TPA for processing.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerServicePhone rdf:type rdf:Property ;
    rdfs:label 'Customer Service Phone' ;
