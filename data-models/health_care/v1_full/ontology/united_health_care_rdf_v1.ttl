    rdfs:comment 'Unique identifier for the care event type. Primary key for the care event type reference catalog.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EventType .

ind:modality rdf:type rdf:Property ;
    rdfs:label 'Modality' ;
    rdfs:comment 'The delivery method or channel through which the care event is conducted (e.g., in-person, telehealth, telephonic, video, mobile app).' ;
    rdfs:domain ind:Care ;
