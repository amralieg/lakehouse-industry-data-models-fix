ind:chatbotEnabled rdf:type rdf:Property ;
    rdfs:label 'Chatbot Enabled' ;
    rdfs:comment 'Boolean flag indicating whether an automated chatbot or virtual assistant is available on this channel for initial member interactions.' ;
    rdfs:domain ind:Service ;
