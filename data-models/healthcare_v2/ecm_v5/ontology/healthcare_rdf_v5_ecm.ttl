ind:languageUsed rdf:type rdf:Property ;
    rdfs:label 'Language Used' ;
    rdfs:comment 'Language used during the assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationAllergyFlag rdf:type rdf:Property ;
    rdfs:label 'Medication Allergy Flag' ;
    rdfs:comment 'Flag indicating if patient has documented medication allergies.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
