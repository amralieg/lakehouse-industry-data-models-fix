ind:marketplaceEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Marketplace Enrollment Indicator' ;
    rdfs:comment 'Indicates whether the member enrolled through a health insurance marketplace (Federally Facilitated Marketplace (FFM) or State Based Marketplace (SBM)).' ;
    rdfs:domain ind:Coverage ;
