ind:notificationTimeframeDays rdf:type rdf:Property ;
    rdfs:label 'Notification Timeframe Days' ;
    rdfs:comment 'Number of days within which the member must notify the plan or employer of the qualifying life event occurrence.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:federalRegulationReference rdf:type rdf:Property ;
