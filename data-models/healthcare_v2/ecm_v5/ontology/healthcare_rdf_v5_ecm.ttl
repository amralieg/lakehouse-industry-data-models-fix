    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataRetentionDate rdf:type rdf:Property ;
    rdfs:label 'Data Retention Date' ;
    rdfs:comment 'Date after which the assessment record may be archived per retention policy.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:diagnosisCodes rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Codes' ;
    rdfs:comment 'Comma-separated list of diagnosis codes (ICD-10) assigned during the assessment.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
