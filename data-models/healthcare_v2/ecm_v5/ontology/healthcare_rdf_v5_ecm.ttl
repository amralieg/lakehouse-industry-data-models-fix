ind:gad7Score rdf:type rdf:Property ;
    rdfs:label 'Gad7 Score' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:insuranceCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Flag' ;
    rdfs:comment 'Indicates if patient’s insurance covers the assessment.' ;
