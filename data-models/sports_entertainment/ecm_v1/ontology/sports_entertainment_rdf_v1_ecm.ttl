    rdfs:range xsd:string .

ind:slaUptimeTargetPercent rdf:type rdf:Property ;
    rdfs:label 'Sla Uptime Target Percent' ;
    rdfs:comment 'Target uptime percentage defined in the service level agreement for brand-related digital services and platforms.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
