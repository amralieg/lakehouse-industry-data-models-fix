  completion_date date [note: 'Actual date when the compliance obligation was fulfilled and submitted or completed. Null if not yet completed. | Column completion_date (DATE) in compliance.calendar']
  completion_status varchar [note: 'Current status of the compliance obligation in its lifecycle (not started, in progress, under review, completed, submitted to regulatory body, overdue, or deferred). [ENUM-REF-CANDIDATE: not_started|in_progress|under_review|completed|submitted|overdue|deferred — 7 candidates stripped; promote to reference product] | Column completion_status (STRING) in compliance.calendar']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.calendar']
  created_timestamp timestamp [note: 'Timestamp when this compliance calendar entry was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.calendar']
  deadline_date date [note: 'The final date by which the compliance obligation must be fulfilled. This is the hard deadline for regulatory submission, renewal, or completion. | Column deadline_date (DATE) in compliance.calendar']
  deadline_description varchar [note: 'Detailed description of the compliance deadline, including specific requirements, deliverables, and any special conditions or instructions. | Column deadline_description (STRING) in compliance.calendar']
  deadline_type varchar [note: 'Category of compliance deadline being tracked (filing, license renewal, audit schedule, certification expiry, reporting period, or inspection). | Column deadline_type (STRING) in compliance.calendar']
  documentation_path varchar [note: 'File system path or document management system location where supporting documentation for this compliance deadline is stored. | Column documentation_path (STRING) in compliance.calendar']
  documentation_required boolean [note: 'Indicates whether supporting documentation, evidence, or attachments must be prepared and submitted with this compliance obligation. | Column documentation_required (BOOLEAN) in compliance.calendar']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  escalation_date date [note: 'Date when this compliance deadline was escalated to senior management or executive leadership due to risk of non-compliance. | Column escalation_date (DATE) in compliance.calendar']
  escalation_path varchar [note: 'Defined escalation hierarchy or contact chain for at-risk deadlines (e.g., Manager → Director → VP → Chief Compliance Officer). | Column escalation_path (STRING) in compliance.calendar']
  escalation_status varchar [note: 'Indicates whether this deadline is at risk of being missed and requires management escalation (none, at risk, escalated to management, or critical). | Column escalation_status (STRING) in compliance.calendar']
  jurisdiction varchar [note: 'Geographic or legal jurisdiction where this compliance obligation applies (e.g., USA, GBR, EUR, state-level, or specific market designation). | Column jurisdiction (STRING) in compliance.calendar']
  last_modified_timestamp timestamp [note: 'Timestamp when this compliance calendar entry was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in compliance.calendar']
  maximum_penalty_amount decimal(15,2) [note: 'Maximum financial penalty or fine amount that could be imposed for non-compliance with this obligation. | Column maximum_penalty_amount (DECIMAL(15,2)) in compliance.calendar']
  monitoring_system varchar [note: 'Name of the system or tool used to monitor and track progress toward this compliance deadline (e.g., GRC platform, workflow system, calendar application). | Column monitoring_system (STRING) in compliance.calendar']
  next_occurrence_date date [note: 'Date of the next scheduled occurrence of this recurring compliance obligation. Null for one-time obligations. | Column next_occurrence_date (DATE) in compliance.calendar']
  notes varchar [note: 'Additional notes, comments, or context regarding this compliance deadline, including special instructions, dependencies, or historical issues. | Column notes (STRING) in compliance.calendar']
  obligation_reference_number varchar [note: 'External reference number or code assigned by the regulatory body to this specific obligation or filing requirement. | Column obligation_reference_number (STRING) in compliance.calendar']
  penalty_currency varchar [note: 'Three-letter ISO 4217 currency code for the penalty amount (e.g., USD, GBP, EUR). | Column penalty_currency (STRING) in compliance.calendar']
  penalty_description varchar [note: 'Description of potential penalties, fines, sanctions, or consequences if this compliance deadline is missed or the obligation is not fulfilled. | Column penalty_description (STRING) in compliance.calendar']
  preparation_lead_time_days varchar [note: 'Number of days required in advance of the deadline to prepare, review, and submit the compliance deliverable. Used to calculate reminder triggers. | Column preparation_lead_time_days (INT) in compliance.calendar']
  public_disclosure_required boolean [note: 'Indicates whether this compliance obligation requires public disclosure or inclusion in the public inspection file (e.g., FCC OPIF requirements). | Column public_disclosure_required (BOOLEAN) in compliance.calendar']
  recurrence_frequency varchar [note: 'How often this compliance obligation recurs (one-time, daily, weekly, monthly, quarterly, semi-annually, annually, biennially, or triennially). [ENUM-REF-CANDIDATE: one_time|daily|weekly|monthly|quarterly|semi_annual|annual|biennial|triennial — 9 candidates stripped; promote to reference product] | Column recurrence_frequency (STRING) in compliance.calendar']
  regulatory_body varchar [note: 'The governing body or regulatory authority that mandates this compliance deadline (e.g., FCC for broadcast licensing, GDPR for data privacy, SOX for financial reporting). [ENUM-REF-CANDIDATE: FCC|Ofcom|MPA|ATSC|DVB|Nielsen|IAB|SCTE|ISO|GDPR|CCPA|SOX|PCI DSS|COPPA — 14 candidates stripped; promote to reference product] | Column regulatory_body (STRING) in compliance.calendar']
  reminder_trigger_date date [note: 'Date when automated reminders or alerts should be sent to the responsible owner to begin preparation. Calculated as deadline_date minus preparation_lead_time_days. | Column reminder_trigger_date (DATE) in compliance.calendar']
  reporting_period_end_date date [note: 'End date of the reporting or compliance period covered by this deadline (e.g., fiscal quarter end, license term end). | Column reporting_period_end_date (DATE) in compliance.calendar']
  reporting_period_start_date date [note: 'Start date of the reporting or compliance period covered by this deadline (e.g., fiscal quarter start, license term start). | Column reporting_period_start_date (DATE) in compliance.calendar']
  responsible_department varchar [note: 'Business unit or department accountable for managing and completing this compliance obligation (e.g., Legal, Compliance, Engineering, Finance). | Column responsible_department (STRING) in compliance.calendar']
  risk_level varchar [note: 'Assessed risk level associated with missing this compliance deadline, considering potential penalties, reputational impact, and operational consequences. | Column risk_level (STRING) in compliance.calendar']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.calendar']
  submission_confirmation_number varchar [note: 'Confirmation or tracking number provided by the regulatory body upon successful submission of the compliance deliverable. | Column submission_confirmation_number (STRING) in compliance.calendar']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.calendar']

  Note: 'Proactive compliance deadline and milestone tracker consolidating all regulatory filing deadlines, license renewal dates, audit schedules, certification expiries, and reporting periods into a single operational calendar. Captures deadline type, regulatory body, associated obligation, responsible owner, lead time for preparation, reminder triggers, completion status, and escalation path for at-risk deadlines. Serves as the operational heartbeat for compliance teams managing dozens of concurrent regulatory timelines across FCC, Ofcom, GDPR, SOX, and PCI obligations. | Unity Catalog table: media_broadcasting_ecm.compliance.calendar'
}

Table compliance.regulatory_change {
  regulatory_change_id varchar [pk, note: 'Unique identifier for the regulatory change record. Primary key. | Column regulatory_change_id (BIGINT) in compliance.regulatory_change']
  compliance_officer_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Regulatory changes require compliance officer ownership for impact assessment and implementation tracking. Officer contact data should reference employee record for accountability. | Column compliance_officer_employee_id (BIGINT) in workforce.regulatory_change']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Regulatory changes create, modify, or supersede regulatory obligations. This FK links a regulatory change to the primary obligation it affects, enabling impact tracking and compliance planning. | Column regulatory_obligation_id (BIGINT) in compliance.regulatory_change']
  superseded_regulatory_change_id varchar [note: 'Self-referencing FK on regulatory_change (superseded_regulatory_change_id) | Column superseded_regulatory_change_id (BIGINT) in compliance.regulatory_change']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.regulatory_change']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.regulatory_change']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.regulatory_change']
  affected_business_units varchar [note: 'Comma-separated list of business units, departments, or divisions impacted by the regulatory change (e.g., Broadcasting Operations, Digital Platforms, Legal, Finance). | Column affected_business_units (STRING) in compliance.regulatory_change']
  affected_obligations_count varchar [note: 'Number of existing regulatory obligations that are modified, superseded, or created by this change. | Column affected_obligations_count (INT) in compliance.regulatory_change']
  change_number varchar [note: 'Business identifier or reference number assigned to this regulatory change by the compliance team or regulatory body. | Column change_number (STRING) in compliance.regulatory_change']
  change_status varchar [note: 'Current lifecycle status of the regulatory change: proposed, under review, approved, effective (in force), deferred, or withdrawn. | Column change_status (STRING) in compliance.regulatory_change']
  change_type varchar [note: 'The nature of the regulatory change: new rule, amendment to existing rule, repeal, guidance update, interpretation clarification, or technical standard update. | Column change_type (STRING) in compliance.regulatory_change']
  compliance_deadline date [note: 'The date by which the organization must achieve full compliance with the regulatory change. | Column compliance_deadline (DATE) in compliance.regulatory_change']
  cost_currency varchar [note: 'Three-letter ISO 4217 currency code for the estimated cost (e.g., USD, GBP, EUR). | Column cost_currency (STRING) in compliance.regulatory_change']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.regulatory_change']
  created_timestamp timestamp [note: 'Timestamp when this regulatory change record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.regulatory_change']
  documentation_url varchar [note: 'URL link to the official regulatory documentation, Federal Register notice, or issuing body\'s publication page. | Column documentation_url (STRING) in compliance.regulatory_change']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_date date [note: 'The date when the regulatory change becomes legally binding and enforceable. | Column effective_date (DATE) in compliance.regulatory_change']
  estimated_cost_amount decimal(15,2) [note: 'Estimated financial cost to implement the regulatory change, including system modifications, training, and process updates. | Column estimated_cost_amount (DECIMAL(15,2)) in compliance.regulatory_change']
  expiration_date date [note: 'The date when the regulatory change expires or sunsets, if applicable. Null for permanent changes. | Column expiration_date (DATE) in compliance.regulatory_change']
  impact_assessment varchar [note: 'Assessment of the regulatory change\'s impact on the organization\'s operations, systems, and compliance posture: critical, high, medium, low, or minimal. | Column impact_assessment (STRING) in compliance.regulatory_change']
  impact_description varchar [note: 'Detailed narrative describing how the regulatory change affects the organization, including operational, technical, and financial implications. | Column impact_description (STRING) in compliance.regulatory_change']
  implementation_completion_date date [note: 'The date when implementation was completed and the organization achieved full compliance. | Column implementation_completion_date (DATE) in compliance.regulatory_change']
  implementation_plan varchar [note: 'Summary of the plan to implement the regulatory change, including key milestones, resource requirements, and system modifications. | Column implementation_plan (STRING) in compliance.regulatory_change']
  implementation_start_date date [note: 'The date when implementation activities for this regulatory change began. | Column implementation_start_date (DATE) in compliance.regulatory_change']
  implementation_status varchar [note: 'Current status of the organization\'s implementation efforts: not started, planning, in progress, testing, completed, or deferred. | Column implementation_status (STRING) in compliance.regulatory_change']
  issuing_body varchar [note: 'The regulatory authority or governing body that issued the change (e.g., FCC, Ofcom, European Commission, MPA, ATSC). | Column issuing_body (STRING) in compliance.regulatory_change']
  jurisdiction varchar [note: 'Geographic or legal jurisdiction where the regulatory change applies (e.g., USA, GBR, EUR, California). | Column jurisdiction (STRING) in compliance.regulatory_change']
  last_modified_timestamp timestamp [note: 'Timestamp when this regulatory change record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in compliance.regulatory_change']
  maximum_penalty_amount decimal(15,2) [note: 'Maximum financial penalty or fine that could be imposed for non-compliance with this regulatory change. | Column maximum_penalty_amount (DECIMAL(15,2)) in compliance.regulatory_change']
  notes varchar [note: 'Additional notes, comments, or context regarding the regulatory change, implementation challenges, or special considerations. | Column notes (STRING) in compliance.regulatory_change']
  organization_comment_submitted boolean [note: 'Indicates whether the organization submitted formal comments during the public comment period (True/False). | Column organization_comment_submitted (BOOLEAN) in compliance.regulatory_change']
  penalty_currency varchar [note: 'Three-letter ISO 4217 currency code for the maximum penalty amount (e.g., USD, GBP, EUR). | Column penalty_currency (STRING) in compliance.regulatory_change']
  penalty_description varchar [note: 'Description of potential penalties, fines, or sanctions for non-compliance with this regulatory change. | Column penalty_description (STRING) in compliance.regulatory_change']
  public_comment_period_end date [note: 'End date of the public comment period for proposed regulatory changes, if applicable. | Column public_comment_period_end (DATE) in compliance.regulatory_change']
  public_comment_period_start date [note: 'Start date of the public comment period for proposed regulatory changes, if applicable. | Column public_comment_period_start (DATE) in compliance.regulatory_change']
  publication_date date [note: 'The date when the regulatory change was officially published or announced by the issuing body. | Column publication_date (DATE) in compliance.regulatory_change']
  regulation_name varchar [note: 'The name or title of the regulation being changed (e.g., FCC Part 73, GDPR Article 5, ATSC 3.0 Standard). | Column regulation_name (STRING) in compliance.regulatory_change']
  regulation_reference_number varchar [note: 'Official reference number or citation of the regulation (e.g., 47 CFR 73.1201, ISO 14496-10). | Column regulation_reference_number (STRING) in compliance.regulatory_change']
  regulatory_domain varchar [note: 'The compliance domain affected by this change: broadcast licensing, content standards, data privacy, financial reporting, accessibility, technical standards, advertising, or rights management. [ENUM-REF-CANDIDATE: broadcast_licensing|content_standards|data_privacy|financial_reporting|accessibility|technical_standards|advertising|rights_management — 8 candidates stripped; promote to reference product] | Column regulatory_domain (STRING) in compliance.regulatory_change']
  related_changes varchar [note: 'Comma-separated list of related regulatory change identifiers or reference numbers that are connected to this change. | Column related_changes (STRING) in compliance.regulatory_change']
  risk_level varchar [note: 'Risk level associated with non-compliance or delayed implementation of this regulatory change: critical, high, medium, or low. | Column risk_level (STRING) in compliance.regulatory_change']
  sign_off_date date [note: 'The date when the compliance officer formally signed off on the implementation of this regulatory change. | Column sign_off_date (DATE) in compliance.regulatory_change']
  sign_off_status varchar [note: 'Status of formal sign-off by the compliance officer: pending, approved, rejected, or conditional approval. | Column sign_off_status (STRING) in compliance.regulatory_change']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.regulatory_change']
  supersedes_regulation_reference varchar [note: 'Reference number or identifier of the previous regulation that this change supersedes or replaces, if applicable. | Column supersedes_regulation_reference (STRING) in compliance.regulatory_change']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.regulatory_change']

  Note: 'Tracks new, amended, or repealed regulations and their impact on the organization\'s compliance posture. Captures regulation identifier, issuing body, change type (new rule, amendment, repeal, guidance update), effective date, impact assessment, affected business units, affected existing obligations, implementation plan, implementation status, and sign-off by compliance officer. Essential for media companies navigating rapidly evolving digital privacy laws, streaming regulations, and broadcast rule modernization (e.g., FCC ATSC 3.0 mandates, EU Digital Services Act). | Unity Catalog table: media_broadcasting_ecm.compliance.regulatory_change'
}

Table compliance.facility_compliance_obligation {
  facility_compliance_obligation_id varchar [pk, note: 'Unique identifier for this facility-obligation compliance tracking record. Primary key. | Column facility_compliance_obligation_id (BIGINT) in compliance.facility_compliance_obligation']
  accessibility_obligation_id varchar [note: 'Foreign key linking to the accessibility obligation being tracked for this facility | Column accessibility_obligation_id (BIGINT) in compliance.facility_compliance_obligation']
  broadcast_facility_id varchar [note: 'Foreign key linking to the broadcast facility where this obligation applies | Column broadcast_facility_id (BIGINT) in technology.facility_compliance_obligation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.facility_compliance_obligation']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.facility_compliance_obligation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.facility_compliance_obligation']
  compliance_percentage decimal(5,2) [note: 'Percentage of content or platform features at this facility currently meeting this accessibility requirement. Moved from accessibility_obligation because compliance percentage is facility-specific. | Column compliance_percentage (DECIMAL(5,2)) in compliance.facility_compliance_obligation']
  compliance_status varchar [note: 'Current state of this specific facility\'s compliance with this specific obligation: compliant, non_compliant, in_progress, exempt, waived, not_applicable. Moved from accessibility_obligation because compliance status varies by facility. | Column compliance_status (STRING) in compliance.facility_compliance_obligation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.facility_compliance_obligation']
  created_timestamp timestamp [note: 'Timestamp when this facility-obligation compliance tracking record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.facility_compliance_obligation']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_date date [note: 'Date when this obligation became applicable to this specific facility (may differ from the obligation\'s general effective_date if facilities were added later or have phased rollout). | Column effective_date (DATE) in compliance.facility_compliance_obligation']
  exemption_reason varchar [note: 'Explanation of why this obligation does not apply to this specific facility or why a waiver was granted for this facility-obligation combination. Moved from accessibility_obligation because exemptions are granted per facility. | Column exemption_reason (STRING) in compliance.facility_compliance_obligation']
  facility_responsible_person varchar [note: 'Name or identifier of the person at this facility responsible for ensuring compliance with this specific obligation (may differ from the corporate responsible_team). | Column facility_responsible_person (STRING) in compliance.facility_compliance_obligation']
  last_compliance_review_date date [note: 'Date when this facility last conducted an internal review or audit of compliance with this specific obligation. Moved from accessibility_obligation because review schedules are managed per facility. | Column last_compliance_review_date (DATE) in compliance.facility_compliance_obligation']
  last_updated_timestamp timestamp [note: 'Timestamp when this facility-obligation compliance tracking record was most recently modified. | Column last_updated_timestamp (TIMESTAMP) in compliance.facility_compliance_obligation']
  next_compliance_review_date date [note: 'Scheduled date for the next internal review or audit of this facility\'s compliance with this obligation. Moved from accessibility_obligation because review schedules are facility-specific. | Column next_compliance_review_date (DATE) in compliance.facility_compliance_obligation']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.facility_compliance_obligation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.facility_compliance_obligation']
  waiver_expiration_date date [note: 'Date when a granted waiver or exemption expires for this facility and the obligation becomes enforceable. Moved from accessibility_obligation because waivers are facility-specific. | Column waiver_expiration_date (DATE) in compliance.facility_compliance_obligation']

  Note: 'This association product represents the compliance tracking relationship between accessibility obligations and broadcast facilities. It captures facility-specific compliance status, review schedules, exemptions, and waivers for each accessibility requirement at each physical location. Each record links one accessibility obligation to one broadcast facility with compliance metrics and dates that exist only in the context of this specific facility-obligation pairing.. Existence Justification: In media broadcasting operations, each accessibility obligation (closed captioning, audio description, emergency alert accessibility, etc.) applies to multiple physical facilities (studios, NOCs, transmission sites), and each facility must comply with multiple accessibility obligations. Compliance is tracked and managed at the facility level because different facilities have different compliance statuses, review schedules, exemptions, and waiver expiration dates for the same obligation. The compliance team actively manages these facility-obligation pairings as part of regulatory reporting and audit preparation. | Unity Catalog table: media_broadcasting_ecm.compliance.facility_compliance_obligation'
}

Table compliance.facility_compliance {
  facility_compliance_id varchar [pk, note: 'Unique identifier for this facility-obligation compliance record. Primary key. | Column facility_compliance_id (BIGINT) in compliance.facility_compliance']
  broadcast_facility_id varchar [note: 'Foreign key linking to the broadcast facility subject to this regulatory obligation | Column broadcast_facility_id (BIGINT) in technology.facility_compliance']
  broadcast_license_id varchar [note: 'Associated broadcast license']
  regulatory_obligation_id varchar [note: 'Foreign key linking to the regulatory obligation being tracked for this facility | Column regulatory_obligation_id (BIGINT) in compliance.facility_compliance']
  responsible_employee_id varchar [note: 'Employee responsible for compliance']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.facility_compliance']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.facility_compliance']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.facility_compliance']
  audit_frequency varchar [note: 'Frequency of compliance audits']
  certification_expiry_date date [note: 'Expiry date of certification']
  certification_number varchar [note: 'Compliance certification number']
  compliance_category varchar [note: 'Category of compliance requirement']
  compliance_score decimal(5,2) [note: 'Compliance score or rating']
  compliance_status varchar [note: 'Current compliance status of this specific facility with respect to this specific obligation. Status is facility-specific because different facilities may have different compliance states for the same obligation (e.g., Studio A compliant, Transmission Site B under review). | Column compliance_status (STRING) in compliance.facility_compliance']
  compliance_type varchar [note: 'Type of compliance requirement']
  corrective_action_completed_date date [note: 'Date corrective action was completed']
  corrective_action_description varchar [note: 'Description of required corrective action']
  corrective_action_due_date date [note: 'Due date for corrective action']
  corrective_action_required boolean [note: 'Whether corrective action is required']
  corrective_action_required_flag boolean [note: 'Whether corrective action is required']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.facility_compliance']
  created_timestamp timestamp [note: 'Record creation timestamp']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  evidence_document_url varchar [note: 'URL to compliance evidence']
  exemption_reason varchar [note: 'Explanation of why this facility is exempt from this regulatory obligation, if applicable. Exemptions are facility-specific based on facility type, jurisdiction, operational scope, or regulatory waivers (e.g., transmission sites exempt from studio-specific obligations). | Column exemption_reason (STRING) in compliance.facility_compliance']
  expiration_date date
  fine_amount decimal(18,2) [note: 'Fine amount if applicable']
  fine_currency varchar [note: 'Currency of fine amount']
  first_compliance_date date [note: 'Date when this facility first achieved compliance with this obligation. Captures the historical start of the compliance relationship for audit trail and reporting purposes. | Column first_compliance_date (DATE) in compliance.facility_compliance']
  inspection_date date [note: 'Date of last inspection']
  inspection_result varchar [note: 'Result of inspection (pass, fail, conditional)']
  inspector_name varchar [note: 'Name of inspector']
  last_audit_date date [note: 'Date of last compliance audit']
  last_compliance_review_date date [note: 'Date when compliance with this obligation was last reviewed or assessed at this specific facility. Review dates vary by facility based on local audits, inspections, and facility-specific compliance activities. | Column last_compliance_review_date (DATE) in compliance.facility_compliance']
  next_audit_date date [note: 'Date of next scheduled audit']
  next_compliance_review_date date [note: 'Scheduled date for the next compliance review or assessment of this obligation at this specific facility. Review schedules may differ by facility based on risk level, past compliance history, and facility type. | Column next_compliance_review_date (DATE) in compliance.facility_compliance']
  notes varchar [note: 'Free-text notes about facility-specific compliance considerations, remediation actions, inspection findings, or other contextual information relevant to this facility-obligation relationship. | Column notes (STRING) in compliance.facility_compliance']
  responsible_party_name varchar [note: 'Name of the individual or role responsible for ensuring compliance with this obligation at this specific facility. Responsibility is facility-specific - different facility managers or compliance officers may own the same obligation at different locations. | Column responsible_party_name (STRING) in compliance.facility_compliance']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.facility_compliance']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.facility_compliance']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  violation_count varchar [note: 'Number of violations found']
  waiver_expiration_date date [note: 'Date when a regulatory waiver or exemption expires for this facility-obligation combination. Waivers are granted per-facility and have facility-specific expiration dates requiring renewal or compliance action. | Column waiver_expiration_date (DATE) in compliance.facility_compliance']

  Note: 'This association product represents the compliance relationship between regulatory obligations and broadcast facilities. It captures facility-specific compliance status, review schedules, exemptions, and responsible parties for each obligation at each facility. Each record links one regulatory obligation to one broadcast facility with attributes that exist only in the context of this specific facility-obligation compliance relationship.. Existence Justification: In media broadcasting operations, regulatory obligations apply to multiple facilities based on facility type and jurisdiction (e.g., EAS participation applies to all transmission sites, public inspection file requirements apply to all studios, tower lighting standards apply to all transmission towers), and each facility must comply with multiple obligations simultaneously (e.g., a studio must comply with EAS, public file, accessibility, content standards). Compliance officers actively manage facility-specific compliance status, review schedules, exemptions, and responsible parties for each obligation at each facility - this is an operational compliance tracking process, not an analytical correlation. | Unity Catalog table: media_broadcasting_ecm.compliance.facility_compliance'
}

