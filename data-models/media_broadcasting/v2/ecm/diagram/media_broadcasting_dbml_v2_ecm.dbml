  created_timestamp timestamp [note: 'Timestamp when the ad standards clearance record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.ad_standards_clearance']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  financial_services_flag boolean [note: 'Indicates whether the ad creative promotes financial services or products, requiring compliance with truth-in-lending and consumer protection regulations. | Column financial_services_flag (BOOLEAN) in compliance.ad_standards_clearance']
  isci_code varchar [note: 'Industry Standard Commercial Identification code uniquely identifying the commercial spot for broadcast tracking and clearance. | Column isci_code (STRING) in compliance.ad_standards_clearance']
  last_modified_timestamp timestamp [note: 'Timestamp when the ad standards clearance record was last updated, capturing any changes to review status or outcome. | Column last_modified_timestamp (TIMESTAMP) in compliance.ad_standards_clearance']
  notes varchar [note: 'Additional notes, comments, or context regarding the clearance review, including specific edits requested or special conditions imposed. | Column notes (STRING) in compliance.ad_standards_clearance']
  political_ad_flag boolean [note: 'Indicates whether the ad creative is a political advertisement requiring special disclosure and public inspection file requirements under FCC rules. | Column political_ad_flag (BOOLEAN) in compliance.ad_standards_clearance']
  political_candidate_name varchar [note: 'Name of the political candidate featured in or sponsoring the ad, required for FCC political advertising disclosure. | Column political_candidate_name (STRING) in compliance.ad_standards_clearance']
  political_office_sought varchar [note: 'Political office being sought by the candidate in the political ad, required for FCC disclosure and public inspection file. | Column political_office_sought (STRING) in compliance.ad_standards_clearance']
  prescription_drug_flag boolean [note: 'Indicates whether the ad creative promotes prescription pharmaceutical products, requiring FDA compliance and specific disclosure language. | Column prescription_drug_flag (BOOLEAN) in compliance.ad_standards_clearance']
  product_category varchar [note: 'Product or service category being advertised, used to apply category-specific advertising standards and restrictions (e.g., alcohol, pharmaceuticals, financial services, children\'s products). | Column product_category (STRING) in compliance.ad_standards_clearance']
  rejection_category varchar [note: 'High-level category of the standards violation leading to rejection or required edits (e.g., misleading claims, inappropriate content, regulatory non-compliance, children\'s advertising violation). | Column rejection_category (STRING) in compliance.ad_standards_clearance']
  rejection_reason varchar [note: 'Detailed explanation of why the ad creative was rejected or required edits, citing specific standards violations or regulatory concerns. | Column rejection_reason (STRING) in compliance.ad_standards_clearance']
