    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holidayCount rdf:type rdf:Property ;
    rdfs:label 'Holiday Count' ;
    rdfs:comment 'Number of recognized holidays falling within the pay period.' ;
