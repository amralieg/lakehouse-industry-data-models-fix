ind:adobeExperiencePlatformId rdf:type rdf:Property ;
    rdfs:label 'Adobe Experience Platform Id' ;
    rdfs:comment 'Unique identifier for the brand within Adobe Experience Platform for personalization and customer journey orchestration.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apiRateLimitPerMinute rdf:type rdf:Property ;
