    rdfs:comment 'Maximum number of API requests allowed per minute for integrations accessing brand-related data and services.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageRevenuePerUserUsd rdf:type rdf:Property ;
    rdfs:label 'Average Revenue Per User Usd' ;
    rdfs:comment 'Average revenue per user baseline metric for the brand in USD, used for digital performance measurement.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerAcquisitionCostUsd rdf:type rdf:Property ;
    rdfs:label 'Customer Acquisition Cost Usd' ;
    rdfs:comment 'Average customer acquisition cost baseline for the brand in USD, used for marketing efficiency analysis.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
