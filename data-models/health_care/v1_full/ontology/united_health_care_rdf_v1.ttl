ind:adjustmentFactorsApplicable rdf:type rdf:Property ;
    rdfs:label 'Adjustment Factors Applicable' ;
    rdfs:comment 'List of adjustment factors that may be applied to base rates (e.g., geographic, case mix, outlier, quality, readmission penalties).' ;
