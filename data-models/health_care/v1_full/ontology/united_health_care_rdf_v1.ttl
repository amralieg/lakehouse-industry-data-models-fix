    rdfs:comment 'Flag indicating whether the channel includes accessibility features for members with disabilities (e.g., TTY/TDD for hearing impaired, screen reader compatibility).' ;
    rdfs:domain ind:OutreachChannel ;
    rdf:type owl:DatatypeProperty ;
