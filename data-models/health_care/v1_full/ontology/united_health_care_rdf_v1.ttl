    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Flag' ;
    rdfs:comment 'Indicates whether the claim line is under appeal.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manualEditFlag rdf:type rdf:Property ;
    rdfs:label 'Manual Edit Flag' ;
    rdfs:comment 'True if the claim line was manually edited.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:editReason rdf:type rdf:Property ;
