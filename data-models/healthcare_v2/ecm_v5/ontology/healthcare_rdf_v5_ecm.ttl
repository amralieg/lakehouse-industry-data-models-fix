ind:visitWindowStart rdf:type rdf:Property ;
    rdfs:label 'Visit Window Start' ;
    rdfs:comment 'Planned earliest date the visit may occur according to the protocol window.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visitWindowType rdf:type rdf:Property ;
