  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.syndication_license_fee']
  business_unit varchar [note: 'Business unit or division responsible for this syndication license agreement. | Column business_unit (STRING) in billing.syndication_license_fee']
  cost_center varchar [note: 'Cost center code for internal financial allocation and reporting. | Column cost_center (STRING) in billing.syndication_license_fee']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.syndication_license_fee']
  created_timestamp timestamp [note: 'Timestamp when this syndication license fee record was first created in the system. | Column created_timestamp (TIMESTAMP) in billing.syndication_license_fee']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the fee amount. | Column currency_code (STRING) in billing.syndication_license_fee']
