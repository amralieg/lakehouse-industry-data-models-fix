ind:benefitTypeCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Type Code' ;
    rdfs:comment 'Code representing the type of benefit to which this cost sharing applies (e.g., medical, pharmacy, dental, vision, behavioral health).' ;
