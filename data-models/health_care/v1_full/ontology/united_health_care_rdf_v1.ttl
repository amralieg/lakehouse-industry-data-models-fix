ind:chartReviewScore rdf:type rdf:Property ;
    rdfs:label 'Chart Review Score' ;
    rdfs:comment 'Quality score assigned during chart review process indicating documentation completeness and accuracy.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
