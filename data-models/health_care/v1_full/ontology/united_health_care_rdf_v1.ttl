# RDFS Schema for Business:  health Care

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/health_care#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business:  health Care ---
ind:UnitedHealthCare rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label ' health Care' ;
    rdfs:comment 'nitedHealthcare is the largest health insurance carrier in the United States and a primary division of UnitedHealth Group, serving over 52 million members globally as of 2023. It provides comprehensive health benefit plans for employers, individuals, Medicare/Medicaid beneficiaries, and military families, partnering with extensive networks of doctors and hospitals. The company aims to make healthcare more affordable and accessible through diverse insurance products and digital tools.' .

# --- Domain Classes ---
ind:Claim rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Claim' ;
    rdfs:comment 'Core claims processing and adjudication including medical, pharmacy, dental, and vision claims. Manages claim submission (837), editing, pricing, payment processing (835), COB, subrogation, and appeals. Supports CPT, ICD-10, HCPCS, DRG, and APC coding standards. Central to payment accuracy and provider reimbursement.' .

ind:Member rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Member' ;
    rdfs:comment 'Central repository for all member demographics, enrollment status, eligibility periods, coverage history, and member identifiers (subscriber, dependent relationships). Serves as SSOT for all party data including individuals, families, and group associations across all LOBs (Commercial, Medicare, Medicaid). Supports 834 enrollment transactions.' .

ind:Provider rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Provider' ;
    rdfs:comment 'Provider network management including physician, hospital, ancillary provider demographics, NPI/TIN identifiers, taxonomy codes, network participation status, and contract affiliations. Supports provider directory, referral management, and network adequacy requirements.' .

ind:Eligibility rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Eligibility' ;
    rdfs:comment 'Real-time eligibility verification, benefit coverage determination, and enrollment transaction processing. Manages eligibility spans, coverage effective dates, termination processing, and COBRA/HIPAA continuation. Supports 270/271 EDI transactions for provider eligibility inquiries.' .

ind:Product rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Product' ;
    rdfs:comment 'Health plan product catalog including HMO, PPO, EPO, POS, HDHP, and government products (MA, MA-PD, PDP, SNP). Defines benefit structures, coverage rules, cost-sharing (deductible, copay, coinsurance, MOOP), formularies, and plan designs across all LOBs with ACA and CMS compliance.' .

ind:Billing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Billing' ;
    rdfs:comment 'Premium billing and revenue collection including group billing, individual billing, premium calculation (PMPM/PEPM), payment processing, grace periods, retroactive adjustments, and accounts receivable. Manages ASO billing, capitation payments, and commission processing.' .

ind:Authorization rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Authorization' ;
    rdfs:comment 'Prior authorization (PA) and utilization management (UM) including medical necessity review, service authorization requests, approval/denial workflows, concurrent review, and retrospective review. Integrates with InterQual/MCG clinical guidelines for determination logic.' .

ind:Care rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Care' ;
    rdfs:comment 'Care management and disease management programs including care plan development, case management, chronic condition management (HCC), care coordination, member outreach, and population health initiatives. Supports HEDIS quality measures and value-based care programs.' .

ind:Pharmacy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Pharmacy' ;
    rdfs:comment 'Pharmacy benefit management (PBM) including formulary management, drug utilization review (DUR), NDC-based drug catalog, pharmacy claims (NCPDP), AWP/MAC pricing, prior authorization for medications, specialty pharmacy, and mail order programs.' .

ind:Contract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Contract' ;
    rdfs:comment 'Provider contracting and network agreements including fee schedules, capitation arrangements, value-based contracts (VBC), ACO agreements, risk-sharing models, and contract terms. Manages reimbursement methodologies (DRG, APC, fee-for-service) and network adequacy.' .

ind:Enrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Enrollment' ;
    rdfs:comment 'Member enrollment processing including new enrollment, plan changes, qualifying life events (QLE), open enrollment, special enrollment periods (SEP), COBRA continuation, and group enrollment. Manages enrollment through exchanges (FFM/SBM), AEP, and direct channels.' .

ind:Quality rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Quality' ;
    rdfs:comment 'Quality measurement and reporting including HEDIS measures, CAHPS surveys, CMS Stars ratings, quality improvement programs, and accreditation compliance (NCQA, URAC). Tracks clinical quality metrics, member satisfaction, and regulatory quality reporting.' .

ind:Fraud rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Fraud' ;
    rdfs:comment 'Fraud, waste, and abuse (FWA) detection and case management including investigation workflows, Special Investigations Unit (SIU) operations, provider audit findings, overpayment recovery, payment integrity, and referrals to law enforcement.' .

ind:Risk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Risk' ;
    rdfs:comment 'Risk adjustment processing including HCC coding, RAF score calculation, RAPS/EDPS submissions for Medicare Advantage, diagnosis capture, chart reviews, and risk score reconciliation. Supports CMS risk adjustment model compliance and risk-based payment.' .

ind:Sales rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Sales' ;
    rdfs:comment 'Sales pipeline management including broker relationships, group sales opportunities, individual enrollment sales, Medicare sales (AEP/OEP), quote generation, proposal management, commission tracking, and lead management across Commercial, Medicare, and Marketplace channels.' .

ind:Service rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Service' ;
    rdfs:comment 'Member and provider customer service including case management, inquiry resolution, grievance and appeals processing, member advocacy, contact center operations, and omnichannel support. Tracks FCR, AHT, NPS, and member satisfaction metrics.' .

ind:Credentialing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Credentialing' ;
    rdfs:comment 'Provider credentialing and re-credentialing including primary source verification, license validation, board certification, malpractice insurance verification, CAQH data integration, sanctions screening (OIG, SAM), and credentialing committee review.' .

ind:Finance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Finance' ;
    rdfs:comment 'Financial accounting including general ledger (GL), accounts payable (AP), accounts receivable (AR), medical loss ratio (MLR) calculation, financial reporting, statutory filings, actuarial reserves, and regulatory financial filings. Supports GAAP/IFRS compliance and SOX controls.' .

ind:Compliance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Compliance' ;
    rdfs:comment 'Regulatory compliance management including HIPAA privacy/security compliance, ACA reporting (1095 forms), CMS program audits, state DOI examinations, ERISA compliance, anti-kickback statute, Stark Law, audit management, and policy enforcement.' .

ind:Marketing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Marketing' ;
    rdfs:comment 'Marketing campaign management including member acquisition campaigns, retention programs, digital marketing, broker marketing materials, brand management, AEP campaigns, and marketing performance. Supports Commercial, Medicare, and Marketplace marketing efforts.' .

ind:Government rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Government' ;
    rdfs:comment 'Government programs management including Medicare Advantage, Medicare Part D, Medicaid managed care, dual-eligible programs (D-SNP), and CHIP. Manages CMS regulatory compliance, government contract requirements, and program-specific enrollment and claims processing.' .

ind:Shared rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UnitedHealthCare ;
    rdfs:label 'Shared' ;
    rdfs:comment 'Cross-domain shared entities consolidated for Single Source of Truth (SSOT). Contains products that serve multiple business domains.' .

# --- Data Product Classes (Tables) ---
ind:Coverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Eligibility ;
    rdfs:label 'Coverage' ;
    rdfs:comment 'Authoritative master record of a member\'s coverage, including plan, effective/termination dates, benefit tiers, and status.' .

ind:StatusCode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Eligibility ;
    rdfs:label 'Status Code' ;
    rdfs:comment 'Standardized codes representing eligibility status (active, pending, terminated, suspended).' .

ind:BenefitPackage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Eligibility ;
    rdfs:label 'Benefit Package' ;
    rdfs:comment 'Catalog of benefit packages linked to health plans, detailing covered services, limits, and cost-share structures.' .

ind:CobroEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Eligibility ;
    rdfs:label 'Cobro Event' ;
    rdfs:comment 'Transactional record of COBRA continuation elections, including election date, coverage extension period, and payment terms.' .

ind:TerminationEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Eligibility ;
    rdfs:label 'Termination Event' ;
    rdfs:comment 'Record of coverage termination actions, capturing reason, effective termination date, and related member identifiers.' .

ind:History rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Eligibility ;
    rdfs:label 'History' ;
    rdfs:comment 'Chronological log of all eligibility status changes for a member, supporting audit and retrospective analysis.' .

ind:CobRule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Eligibility ;
    rdfs:label 'Cob Rule' ;
    rdfs:comment 'Reference data defining COB hierarchies, primary payer determination, and secondary payer processing logic.' .

ind:PlanBenefitMap rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Eligibility ;
    rdfs:label 'Plan Benefit Map' ;
    rdfs:comment 'Lookup table linking health plans to their associated benefit packages and eligibility rules.' .

ind:VerificationQueue rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Eligibility ;
    rdfs:label 'Verification Queue' ;
    rdfs:comment 'Operational queue of pending eligibility verification requests awaiting processing by the eligibility engine.' .

ind:Measure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Measure' ;
    rdfs:comment 'Standardized definition of each HEDIS quality measure including numerator, denominator, specifications, and reporting period.' .

ind:MeasureCategory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Measure Category' ;
    rdfs:comment 'Logical grouping of quality measures (e.g., Preventive Care, Chronic Disease Management).' .

ind:MeasureResult rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Measure Result' ;
    rdfs:comment 'Calculated result of a HEDIS measure for a member or member group for a specific reporting year.' .

ind:SatisfactionScore rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Satisfaction Score' ;
    rdfs:comment 'Aggregated member satisfaction metric derived from CAHPS and other feedback sources, reported per period.' .

ind:ProviderScore rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Provider Score' ;
    rdfs:comment 'Composite quality rating for a provider based on clinical metrics, patient experience, and accreditation results.' .

ind:Accreditation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Accreditation' ;
    rdfs:comment 'Master record of an entity\'s accreditation status (NCQA, URAC) including effective dates and accreditation level.' .

ind:ImprovementPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Improvement Plan' ;
    rdfs:comment 'Strategic plan outlining quality improvement initiatives, objectives, timelines, and responsible parties.' .

ind:ImprovementAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Improvement Action' ;
    rdfs:comment 'Specific action items executed under a quality improvement plan, with status and outcome tracking.' .

ind:ImprovementStatus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Improvement Status' ;
    rdfs:comment 'Reference list of possible statuses for quality improvement actions (Planned, In Progress, Completed, Closed).' .

ind:ReportSubmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Report Submission' ;
    rdfs:comment 'Record of each required quality report filed with CMS, NCQA, or other regulators, including submission date and status.' .

ind:ClinicalMetric rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Clinical Metric' ;
    rdfs:comment 'Master definition of clinical quality metrics (e.g., readmission rate, HbA1c control) with calculation logic.' .

ind:ClinicalMetricResult rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Clinical Metric Result' ;
    rdfs:comment 'Calculated result of a clinical quality metric for a provider, facility, or member cohort per reporting period.' .

ind:StarRating rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Star Rating' ;
    rdfs:comment 'Star rating assigned by CMS to a health plan based on composite quality and performance measures.' .

ind:HedisScore rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Hedis Score' ;
    rdfs:comment 'Overall HEDIS performance score for a health plan for a given year.' .

ind:GovernancePolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Governance Policy' ;
    rdfs:comment 'Reference document defining governance, roles, and responsibilities for quality management and compliance.' .

ind:DataQualityIssue rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Data Quality Issue' ;
    rdfs:comment 'Log of identified data quality problems within quality data sets, including severity and remediation actions.' .

ind:PlanVersion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Plan Version' ;
    rdfs:comment 'Historical versioning of a plan to capture changes over time such as benefit updates or pricing revisions.' .

ind:Hierarchy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Hierarchy' ;
    rdfs:comment 'Parent-child relationships between plans (e.g., family plans, group plans, supplemental riders).' .

ind:Benefit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Benefit' ;
    rdfs:comment 'Definition of medical, pharmacy, dental, vision, and wellness benefits attached to a plan, including covered services and exclusions.' .

ind:CostSharing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Cost Sharing' ;
    rdfs:comment 'Details of deductibles, copays, coinsurance, and out-of-pocket maximums for each benefit type within a plan.' .

ind:PlanNetwork rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Plan Network' ;
    rdfs:comment 'Mapping of a plan to the provider network(s) that are in-network for that product.' .

ind:EnrollmentWindow rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Enrollment Window' ;
    rdfs:comment 'Defined open and close dates (including special enrollment periods) during which members may enroll or change plans.' .

ind:RegulatoryCompliance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Regulatory Compliance' ;
    rdfs:comment 'Fields capturing ACA, CMS, and state-specific compliance requirements for each plan (e.g., minimum essential coverage, HEDIS reporting flags).' .

ind:MarketingAttribute rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Marketing Attribute' ;
    rdfs:comment 'Consumer-facing descriptors such as plan tagline, marketing segment, and promotional materials.' .

ind:Rider rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Rider' ;
    rdfs:comment 'Optional add-on coverage (e.g., vision rider, dental rider) that can be attached to a base plan.' .

ind:CoverageLimit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Coverage Limit' ;
    rdfs:comment 'Specific exclusions, service limits, or utilization caps associated with a plan.' .

ind:PlanStatus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current lifecycle state of a plan (e.g., active, pending, terminated, retired).' .

ind:PlanType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'Standard classification of plan design such as HMO, PPO, EPO, POS, HDHP, Medicare Advantage, PDP, SNP.' .

ind:BenefitType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Benefit Type' ;
    rdfs:comment 'Lookup for benefit categories: medical, pharmacy, dental, vision, wellness, behavioral health.' .

ind:CostSharingType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Cost Sharing Type' ;
    rdfs:comment 'Lookup for cost-sharing mechanisms: deductible, copay, coinsurance, out-of-pocket max.' .

ind:RateScheduleType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Rate Schedule Type' ;
    rdfs:comment 'Classification of rate schedule methodology (e.g., age-band, geographic, group size).' .

ind:Attribute rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Attribute' ;
    rdfs:comment 'Flexible key-value pairs for extensible plan characteristics not covered by fixed columns.' .

ind:LifecycleEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Lifecycle Event' ;
    rdfs:comment 'Audit record of creation, amendment, or termination events for a plan.' .

ind:EligibilityCriteria rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Eligibility Criteria' ;
    rdfs:comment 'Reference data defining criteria such as age ranges, income brackets, or employer size that drive eligibility_rule evaluation.' .

ind:Profile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Profile' ;
    rdfs:comment 'Core master entity representing each provider with demographic details, contact information, and primary identifiers.' .

ind:Identifier rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Identifier' ;
    rdfs:comment 'Unique national identifiers for providers, including NPI, TIN, and other regulatory IDs.' .

ind:Location rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Location' ;
    rdfs:comment 'Physical practice locations for providers, including address, phone, geocode, and service hours.' .

ind:Specialty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Specialty' ;
    rdfs:comment 'Standardized specialty codes that classify provider clinical expertise.' .

ind:Taxonomy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Taxonomy' ;
    rdfs:comment 'Taxonomy codes describing provider type and classification for regulatory reporting.' .

ind:NetworkAffiliation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Network Affiliation' ;
    rdfs:comment 'Transactional record of a provider\'s participation status in a specific network, including effective dates, tier, and termination flags.' .

ind:ServiceArea rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Service Area' ;
    rdfs:comment 'Geographic service area definitions for providers, used for network adequacy, routing, and member search.' .

ind:QualityMetric rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Quality Metric' ;
    rdfs:comment 'Quality performance metrics captured for each provider, such as HEDIS scores, outcome measures, and star ratings.' .

ind:ReferralNetwork rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Referral Network' ;
    rdfs:comment 'Transactional records of referral patterns between providers, including source, destination, referral dates, and referral reason codes.' .

ind:Schedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Schedule' ;
    rdfs:comment 'Scheduled availability slots for providers, supporting appointment routing, capacity planning, and time-of-day routing rules.' .

ind:GroupPractice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Group Practice' ;
    rdfs:comment 'Master record for provider group practices or affiliations, linking individual providers to a group entity and capturing group taxonomies.' .

ind:Termination rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Termination' ;
    rdfs:comment 'Record of provider termination or network removal events, including reason codes, effective date, and audit trail.' .

ind:CommunicationPreference rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Communication Preference' ;
    rdfs:comment 'Preferred communication channels and consent flags for contacting the provider, including email, fax, portal, and opt-out status.' .

ind:CredentialSummary rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Credential Summary' ;
    rdfs:comment 'Aggregated credentialing status and verification summary for a provider, sourced from the credentialing domain, including license, board certification, and malpractice coverage.' .

ind:Claim rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Claim' ;
    rdfs:comment 'Core claim record capturing submission details, member, provider, plan, claim type, total charges, and submission timestamps.' .

ind:Line rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Line' ;
    rdfs:comment 'Individual service line within a claim, including procedure code (CPT/HCPCS), diagnosis codes (ICD-10), units, charge amount, and line sequence.' .

ind:Adjustment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Adjustment' ;
    rdfs:comment 'Records adjustments applied to a claim after initial adjudication, including adjustment reason codes, amount adjustments, and effective dates.' .

ind:PaymentAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Payment Allocation' ;
    rdfs:comment 'Allocation of a claim payment to individual claim lines and to provider accounts, including allocated amount per line.' .

ind:DenialReason rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Denial Reason' ;
    rdfs:comment 'Standardized list of denial reason codes (e.g., COB, medical necessity, eligibility) used to classify claim denials.' .

ind:CobDetail rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Cob Detail' ;
    rdfs:comment 'Information on primary and secondary payer responsibilities for a claim, including payer order, responsibility percentages, and coordination flags.' .

ind:SubrogationDetail rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Subrogation Detail' ;
    rdfs:comment 'Data capturing subrogation actions for a claim, including third-party payer, recovery amount, and status of subrogation effort.' .

ind:Diagnosis rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Diagnosis' ;
    rdfs:comment 'Master list of ICD-10 diagnosis codes used on claim lines, including code, description, and clinical category.' .

ind:Procedure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Procedure' ;
    rdfs:comment 'Master list of CPT/HCPCS procedure codes applicable to claim lines, with code, description, and billing unit.' .

ind:Classification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Classification' ;
    rdfs:comment 'Reference table mapping inpatient claim diagnoses to Diagnosis-Related Group (DRG) or Ambulatory Payment Classification (APC) categories.' .

ind:Batch rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Batch' ;
    rdfs:comment 'Metadata for batches of claims processed together, including batch identifier, processing start/end timestamps, and batch status.' .

ind:Event rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Event' ;
    rdfs:comment 'Record of significant events affecting a claim (e.g., eligibility check, pricing rule applied, manual edit) with event type and timestamp.' .

ind:FwaFlag rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Fwa Flag' ;
    rdfs:comment 'Lookup of flags used to mark claims for fraud, waste, or abuse review, including flag code, description, and severity level.' .

ind:PaymentSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Payment Schedule' ;
    rdfs:comment 'Schedule of anticipated claim payments, including due dates, installment amounts, and payment method.' .

ind:Plan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Care ;
    rdfs:label 'Plan' ;
    rdfs:comment 'Master record defining a structured care plan offering, including objectives, activities, duration, eligibility criteria, and associated clinical pathways.' .

ind:PlanEnrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Care ;
    rdfs:label 'Plan Enrollment' ;
    rdfs:comment 'Transactional record of a member\'s enrollment into a specific care plan, capturing enrollment date, status, effective period, and assigned care team.' .

ind:CaseAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Care ;
    rdfs:label 'Case Assignment' ;
    rdfs:comment 'Event capturing assignment of a care team member to a case, with assignment date, role, and responsibility details.' .

ind:Team rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Care ;
    rdfs:label 'Team' ;
    rdfs:comment 'Master entity describing a multidisciplinary care team, including team name, purpose, composition rules, and service area.' .

ind:Assessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Care ;
    rdfs:label 'Assessment' ;
    rdfs:comment 'Transactional capture of a health risk or clinical assessment performed on a member, including scores, responses, and assessor.' .

ind:AssessmentType rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Care ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Reference list of assessment types (e.g., HRA, PHQ-9, ADL), with codes, descriptions, and scoring methodology.' .

ind:Intervention rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Care ;
    rdfs:label 'Intervention' ;
