ind:pharmacyRiskScore rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Risk Score' ;
    rdfs:comment 'Risk score component based on prescription drug utilization patterns and medication complexity.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilizationRiskScore rdf:type rdf:Property ;
    rdfs:label 'Utilization Risk Score' ;
    rdfs:comment 'Risk score component based on healthcare service utilization patterns including inpatient and outpatient visits.' ;
    rdfs:domain ind:MemberRiskProfile ;
