    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HccCategory .

ind:hccLabel rdf:type rdf:Property ;
    rdfs:label 'Hcc Label' ;
    rdfs:comment 'Descriptive label for the HCC category (e.g., Diabetes with Chronic Complications, Major Depressive Disorder).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diseaseCategory rdf:type rdf:Property ;
    rdfs:label 'Disease Category' ;
    rdfs:comment 'High-level disease classification grouping for the HCC (e.g., Cardiovascular, Diabetes, Mental Health, Cancer).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coefficientValue rdf:type rdf:Property ;
