ind:overflowThresholdSeconds rdf:type rdf:Property ;
    rdfs:label 'Overflow Threshold Seconds' ;
    rdfs:comment 'Wait time in seconds that triggers overflow routing to secondary queues or skill groups.' ;
    rdfs:domain ind:Queue ;
