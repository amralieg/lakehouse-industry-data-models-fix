    rdfs:range xsd:string .

ind:payerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Payer Contact Phone' ;
    rdfs:comment 'Phone number of the primary payer contact for dispute communications.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationLog rdf:type rdf:Property ;
    rdfs:label 'Communication Log' ;
    rdfs:comment 'Summary log of key communications and interactions related to the dispute resolution process.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentLocation rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Location' ;
    rdfs:comment 'File path or document management system location where supporting documents are stored.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnProviderRelationship rdf:type rdf:Property ;
    rdfs:label 'Impact On Provider Relationship' ;
    rdfs:comment 'Assessment of the dispute\'s impact on the ongoing relationship with the provider.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reputationalRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Reputational Risk Level' ;
    rdfs:comment 'Assessment of potential reputational risk associated with the dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedClaimNumbers rdf:type rdf:Property ;
    rdfs:label 'Related Claim Numbers' ;
    rdfs:comment 'Comma-separated list of claim numbers related to or affected by this contract dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedDisputeIds rdf:type rdf:Property ;
    rdfs:label 'Related Dispute Ids' ;
    rdfs:comment 'Comma-separated list of related dispute IDs that are connected to this dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Status' ;
    rdfs:comment 'Status indicating whether the dispute resolution is meeting contractual or internal service level agreement timelines.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
