  reviewer_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Advertising standards clearance reviews require tracking which employee performed the review for accountability and audit trail. Reviewer contact data should reference employee record. | Column reviewer_employee_id (BIGINT) in workforce.ad_standards_clearance']
