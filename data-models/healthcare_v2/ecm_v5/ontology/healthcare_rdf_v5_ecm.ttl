    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DatabricksGovernanceDeltaTblproperties4 .

ind:databricksGovernanceRlsPredicatesId rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Rls Predicates Id' ;
    rdfs:comment 'Foreign key linking to metadata.rls_predicates. Business justification: Feature access control requires approved RLS predicates to restrict which teams/roles can access sensitive patient features (e.g., behavioral health, substance use) per HIPAA minimum necessary.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DatabricksGovernanceRlsPredicates .

ind:databricksGovernanceUcTagDefinitionsId rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Uc Tag Definitions Id' ;
    rdfs:comment 'Foreign key linking to metadata.uc_tag_definitions. Business justification: Feature store governance requires each feature to reference approved Unity Catalog tag definitions for PHI classification, sensitivity labeling, and data lineage tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DatabricksGovernanceUcTagDefinitions .

ind:featureStoreEntityId rdf:type rdf:Property ;
    rdfs:label 'Feature Store Entity Id' ;
    rdfs:comment 'Unique surrogate identifier for the feature definition.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FeatureStoreEntity .

ind:hipaaRetentionAnnotationId rdf:type rdf:Property ;
    rdfs:label 'Hipaa Retention Annotation Id' ;
    rdfs:comment 'Foreign key linking to uc_tags.hipaa_retention_annotation. Business justification: PHI-derived features must comply with HIPAA retention/destruction schedules. Links feature lifecycle to centralized retention policy for compliance audits.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HipaaRetentionAnnotation .

ind:liquidClusteringConfigId rdf:type rdf:Property ;
    rdfs:label 'Liquid Clustering Config Id' ;
    rdfs:comment 'Foreign key linking to uc_tags.liquid_clustering_config. Business justification: Feature tables queried by patient_id/timestamp need liquid clustering. Centralizes clustering strategy with rationale and estimated improvement metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiquidClusteringConfig .

ind:rlsPredicateId rdf:type rdf:Property ;
    rdfs:label 'Rls Predicate Id' ;
    rdfs:comment 'Foreign key linking to uc_tags.rls_predicate. Business justification: Feature store entities derived from PHI (diagnoses, labs) require RLS predicates restricting access by role. HIPAA minimum-necessary principle for ML feature access.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RlsPredicate .

