    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reliabilityScore rdf:type rdf:Property ;
    rdfs:label 'Reliability Score' ;
    rdfs:comment 'Internal performance score (0-100) measuring the odds provider\'s historical reliability, uptime, and data accuracy.' ;
    rdfs:domain ind:OddsProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sportsCoverage rdf:type rdf:Property ;
    rdfs:label 'Sports Coverage' ;
    rdfs:comment 'Comma-separated list of sports and leagues covered by this odds provider (e.g., NFL, NBA, EPL, MLB).' ;
    rdfs:domain ind:OddsProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportsLiveBetting rdf:type rdf:Property ;
    rdfs:label 'Supports Live Betting' ;
    rdfs:comment 'Indicates whether the odds provider offers real-time odds updates for in-play or live betting scenarios.' ;
    rdfs:domain ind:OddsProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsPropBets rdf:type rdf:Property ;
    rdfs:label 'Supports Prop Bets' ;
    rdfs:comment 'Indicates whether the odds provider offers proposition bets (player-specific or event-specific micro-markets).' ;
    rdfs:domain ind:OddsProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:updateFrequencySeconds rdf:type rdf:Property ;
    rdfs:label 'Update Frequency Seconds' ;
    rdfs:comment 'Typical frequency in seconds at which the odds provider updates their odds data during live events.' ;
    rdfs:domain ind:OddsProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:uptimePercentage rdf:type rdf:Property ;
    rdfs:label 'Uptime Percentage' ;
    rdfs:comment 'Percentage of time the odds provider\'s service was available over the last 30 days.' ;
    rdfs:domain ind:OddsProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ecommercePlatformCode rdf:type rdf:Property ;
    rdfs:label 'Ecommerce Platform Code' ;
    rdfs:comment 'Code identifying the e-commerce platform used for online sales of this category (e.g., SHOPIFY_PLUS).' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inventoryTrackingMethod rdf:type rdf:Property ;
    rdfs:label 'Inventory Tracking Method' ;
    rdfs:comment 'Method used to track inventory for products in this category (e.g., SKU-level, batch, serial number, or no tracking).' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLicensable rdf:type rdf:Property ;
    rdfs:label 'Is Licensable' ;
    rdfs:comment 'Indicates whether products in this category are subject to licensing agreements and royalty tracking.' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User' ;
    rdfs:comment 'Username or identifier of the user who last modified this product category record.' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:merchandiseClass rdf:type rdf:Property ;
    rdfs:label 'Merchandise Class' ;
    rdfs:comment 'High-level merchandise classification for products in this category (e.g., apparel, headwear, collectibles).' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metaDescription rdf:type rdf:Property ;
    rdfs:label 'Meta Description' ;
    rdfs:comment 'Meta description text used for search engine results and social media sharing for this category.' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresIpProtection rdf:type rdf:Property ;
    rdfs:label 'Requires Ip Protection' ;
    rdfs:comment 'Indicates whether products in this category require intellectual property protection and brand compliance monitoring.' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnPolicyCode rdf:type rdf:Property ;
    rdfs:label 'Return Policy Code' ;
    rdfs:comment 'Code identifying the return policy applicable to products in this category.' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesChannelEligibility rdf:type rdf:Property ;
    rdfs:label 'Sales Channel Eligibility' ;
    rdfs:comment 'Comma-separated list of sales channels where this category is eligible for sale (e.g., venue_store, online, third_party_retail, pos).' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDemographic rdf:type rdf:Property ;
    rdfs:label 'Target Demographic' ;
    rdfs:comment 'Primary demographic segment targeted by products in this category.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Tax Category Code' ;
    rdfs:comment 'Tax classification code used for sales tax calculation and compliance reporting for products in this category.' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyEligible rdf:type rdf:Property ;
    rdfs:label 'Warranty Eligible' ;
    rdfs:comment 'Indicates whether products in this category are eligible for warranty coverage.' ;
    rdfs:domain ind:ProductCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingCycleDays rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Days' ;
    rdfs:comment 'Number of days in the billing cycle for this subscription tier (e.g., 30 for monthly, 365 for annual).' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cancellationAllowed rdf:type rdf:Property ;
    rdfs:label 'Cancellation Allowed' ;
    rdfs:comment 'Indicates whether subscribers can cancel this tier subscription before the end of the billing period.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Content Access Level' ;
    rdfs:comment 'Level of content library access granted to subscribers at this tier (e.g., basic highlights, full replays, exclusive behind-the-scenes).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerSupportLevel rdf:type rdf:Property ;
    rdfs:label 'Customer Support Level' ;
    rdfs:comment 'Level of customer support service provided to subscribers at this tier.' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:downgradeAllowed rdf:type rdf:Property ;
    rdfs:label 'Downgrade Allowed' ;
    rdfs:comment 'Indicates whether subscribers at this tier can downgrade to a lower tier during their subscription period.' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:earlyTerminationFee rdf:type rdf:Property ;
    rdfs:label 'Early Termination Fee' ;
    rdfs:comment 'Fee charged if a subscriber cancels this tier before the minimum commitment period ends. Null if no fee applies.' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:featuredTier rdf:type rdf:Property ;
    rdfs:label 'Featured Tier' ;
    rdfs:comment 'Indicates whether this subscription tier should be highlighted or featured in marketing and user interfaces.' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:merchandiseDiscountPercent rdf:type rdf:Property ;
    rdfs:label 'Merchandise Discount Percent' ;
    rdfs:comment 'Percentage discount on merchandise purchases granted to subscribers at this tier. Null if no discount applies.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceAmount rdf:type rdf:Property ;
    rdfs:label 'Price Amount' ;
    rdfs:comment 'Standard subscription price for this tier in the base currency.' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:refundEligible rdf:type rdf:Property ;
    rdfs:label 'Refund Eligible' ;
    rdfs:comment 'Indicates whether this subscription tier is eligible for refunds under the standard refund policy.' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:termsUrl rdf:type rdf:Property ;
    rdfs:label 'Terms Url' ;
    rdfs:comment 'URL link to the full terms and conditions document specific to this subscription tier.' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketPriorityAccess rdf:type rdf:Property ;
    rdfs:label 'Ticket Priority Access' ;
    rdfs:comment 'Indicates whether subscribers at this tier receive priority access to ticket sales for events.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tierDescription rdf:type rdf:Property ;
    rdfs:label 'Tier Description' ;
    rdfs:comment 'Detailed description of the subscription tier benefits, features, and value proposition for marketing and customer communication.' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upgradeAllowed rdf:type rdf:Property ;
    rdfs:label 'Upgrade Allowed' ;
    rdfs:comment 'Indicates whether subscribers at this tier can upgrade to a higher tier during their subscription period.' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:videoQualityMax rdf:type rdf:Property ;
    rdfs:label 'Video Quality Max' ;
    rdfs:comment 'Maximum video streaming quality available to subscribers at this tier (SD=Standard Definition, HD=High Definition, FHD=Full HD, 4K, 8K).' ;
    rdfs:domain ind:SubscriptionTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archiveAccessMonths rdf:type rdf:Property ;
    rdfs:label 'Archive Access Months' ;
    rdfs:comment 'Number of months of historical content archive available to subscribers. Null indicates unlimited archive access.' ;
    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exclusiveContentAccess rdf:type rdf:Property ;
    rdfs:label 'Exclusive Content Access' ;
    rdfs:comment 'Indicates whether the plan grants access to subscriber-only exclusive content such as behind-the-scenes footage and interviews.' ;
    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:featuredPlan rdf:type rdf:Property ;
    rdfs:label 'Featured Plan' ;
    rdfs:comment 'Indicates whether this plan should be highlighted or featured in marketing and subscription selection interfaces.' ;
    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hdStreamingEnabled rdf:type rdf:Property ;
    rdfs:label 'Hd Streaming Enabled' ;
    rdfs:comment 'Indicates whether the plan supports high-definition video streaming quality.' ;
    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partnerPlan rdf:type rdf:Property ;
    rdfs:label 'Partner Plan' ;
    rdfs:comment 'Indicates whether the plan is offered through a third-party partner or distribution channel.' ;
    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:promotionalPlan rdf:type rdf:Property ;
    rdfs:label 'Promotional Plan' ;
    rdfs:comment 'Indicates whether this is a limited-time promotional or special offer subscription plan.' ;
    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uhdStreamingEnabled rdf:type rdf:Property ;
    rdfs:label 'Uhd Streaming Enabled' ;
    rdfs:comment 'Indicates whether the plan supports 4K ultra-high-definition video streaming quality.' ;
    rdfs:domain ind:SubscriptionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:apiEndpoint rdf:type rdf:Property ;
    rdfs:label 'Api Endpoint' ;
    rdfs:comment 'API endpoint URL used to retrieve this variant\'s configuration for client applications.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configurationJson rdf:type rdf:Property ;
    rdfs:label 'Configuration Json' ;
    rdfs:comment 'JSON-formatted string containing the technical configuration parameters for this variant (feature flags, parameter values, content IDs).' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentVariantCode rdf:type rdf:Property ;
    rdfs:label 'Content Variant Code' ;
    rdfs:comment 'Reference to the specific content asset or template used in this variant (e.g., hero image ID, video asset ID, promotional banner ID).' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deploymentEnvironment rdf:type rdf:Property ;
    rdfs:label 'Deployment Environment' ;
    rdfs:comment 'Technical environment where this variant is currently deployed (development, staging, or production).' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedImpact rdf:type rdf:Property ;
    rdfs:label 'Expected Impact' ;
    rdfs:comment 'Anticipated business impact or performance improvement expected from this variant.' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:experienceType rdf:type rdf:Property ;
    rdfs:label 'Experience Type' ;
    rdfs:comment 'Category of digital experience being tested (UI layout, content recommendation engine, pricing display, checkout flow, personalization algorithm, or feature access).' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureFlagOverrides rdf:type rdf:Property ;
    rdfs:label 'Feature Flag Overrides' ;
    rdfs:comment 'Comma-separated list of feature flags and their override values specific to this variant.' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isControl rdf:type rdf:Property ;
    rdfs:label 'Is Control' ;
    rdfs:comment 'Boolean flag indicating whether this variant serves as the control baseline for the experiment.' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:personalizationEngineCode rdf:type rdf:Property ;
    rdfs:label 'Personalization Engine Code' ;
    rdfs:comment 'External identifier for the personalization engine configuration in Adobe Experience Platform or similar system.' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryMetrics rdf:type rdf:Property ;
    rdfs:label 'Secondary Metrics' ;
    rdfs:comment 'Comma-separated list of secondary metrics monitored for this variant (e.g., bounce_rate, session_duration, cart_abandonment).' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetAudienceSegment rdf:type rdf:Property ;
    rdfs:label 'Target Audience Segment' ;
    rdfs:comment 'Identifier or description of the fan audience segment targeted by this variant (e.g., new fans, premium subscribers, mobile users).' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficAllocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Traffic Allocation Percentage' ;
    rdfs:comment 'Percentage of total experiment traffic allocated to this variant (0.00 to 100.00).' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variantCode rdf:type rdf:Property ;
    rdfs:label 'Variant Code' ;
    rdfs:comment 'Short alphanumeric code used to identify the variant in tracking systems and analytics platforms.' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:variantName rdf:type rdf:Property ;
    rdfs:label 'Variant Name' ;
    rdfs:comment 'Human-readable name of the test variant (e.g., Control, Treatment A, Variant B).' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:variantType rdf:type rdf:Property ;
    rdfs:label 'Variant Type' ;
    rdfs:comment 'Classification of the variant role within the experiment (control baseline, treatment, challenger, or holdout).' ;
    rdfs:domain ind:AbTestVariant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowSkipFlag rdf:type rdf:Property ;
    rdfs:label 'Allow Skip Flag' ;
    rdfs:comment 'Indicates whether fans can skip this poll question without providing a response.' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:entitlementRequired rdf:type rdf:Property ;
    rdfs:label 'Entitlement Required' ;
    rdfs:comment 'Feature entitlement level required for fans to access and respond to this poll question, supporting platform feature entitlements.' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxResponseOptions rdf:type rdf:Property ;
    rdfs:label 'Max Response Options' ;
    rdfs:comment 'Maximum number of answer options a fan can select for multiple-choice questions (null for single-choice or non-applicable types).' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minResponseOptions rdf:type rdf:Property ;
    rdfs:label 'Min Response Options' ;
    rdfs:comment 'Minimum number of answer options a fan must select for multiple-choice or ranking questions (null for non-applicable question types).' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:questionCode rdf:type rdf:Property ;
    rdfs:label 'Question Code' ;
    rdfs:comment 'Business-assigned unique code for the poll question, used for external reference and integration with CRM (Salesforce) and personalization engines (Adobe Experience Platform).' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:questionText rdf:type rdf:Property ;
    rdfs:label 'Question Text' ;
    rdfs:comment 'The full text of the poll question presented to fans across digital touchpoints (mobile apps, web portals, in-venue displays).' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:questionType rdf:type rdf:Property ;
    rdfs:label 'Question Type' ;
    rdfs:comment 'Classification of the poll question format determining response structure and UI rendering logic.' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:randomizeOptionsFlag rdf:type rdf:Property ;
    rdfs:label 'Randomize Options Flag' ;
    rdfs:comment 'Indicates whether answer options should be displayed in random order to reduce response bias.' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresAuthenticationFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Authentication Flag' ;
    rdfs:comment 'Indicates whether fans must be authenticated (logged in) to respond to this poll question, supporting user authentication and session management.' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseLimit rdf:type rdf:Property ;
    rdfs:label 'Response Limit' ;
    rdfs:comment 'Maximum number of responses allowed per fan user, enforcing participation rules (null indicates unlimited responses).' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resultsDisplayType rdf:type rdf:Property ;
    rdfs:label 'Results Display Type' ;
    rdfs:comment 'Format for displaying poll results to fans (percentage distribution, raw counts, both, or none).' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:showResultsFlag rdf:type rdf:Property ;
    rdfs:label 'Show Results Flag' ;
    rdfs:comment 'Indicates whether aggregated poll results should be displayed to fans after they submit their response.' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thumbnailImageUrl rdf:type rdf:Property ;
    rdfs:label 'Thumbnail Image Url' ;
    rdfs:comment 'URL to the thumbnail image asset associated with this poll question for visual presentation in mobile apps and web portals.' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalResponsesCount rdf:type rdf:Property ;
    rdfs:label 'Total Responses Count' ;
    rdfs:comment 'Cumulative count of fan responses received for this poll question across all channels and touchpoints.' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:uniqueRespondentsCount rdf:type rdf:Property ;
    rdfs:label 'Unique Respondents Count' ;
    rdfs:comment 'Count of distinct fans who have responded to this poll question, supporting engagement analytics.' ;
    rdfs:domain ind:PollQuestion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aBTestVariant rdf:type rdf:Property ;
    rdfs:label 'A B Test Variant' ;
    rdfs:comment 'Variant identifier for A/B testing purposes when multiple versions of the same template are being tested for optimization.' ;
    rdfs:domain ind:MessageTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodyContentFormat rdf:type rdf:Property ;
    rdfs:label 'Body Content Format' ;
    rdfs:comment 'Format specification for the body content indicating markup language and rendering requirements.' ;
    rdfs:domain ind:MessageTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locale rdf:type rdf:Property ;
    rdfs:label 'Locale' ;
    rdfs:comment 'Language and regional locale code for the template content following ISO 639-1 and ISO 3166-1 standards.' ;
    rdfs:domain ind:MessageTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalizationTokens rdf:type rdf:Property ;
    rdfs:label 'Personalization Tokens' ;
    rdfs:comment 'Comma-separated list of personalization token placeholders used in the template for dynamic content substitution.' ;
    rdfs:domain ind:MessageTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresOptIn rdf:type rdf:Property ;
    rdfs:label 'Requires Opt In' ;
    rdfs:comment 'Indicates whether explicit recipient opt-in consent is required before sending messages using this template for compliance purposes.' ;
    rdfs:domain ind:MessageTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trackingEnabled rdf:type rdf:Property ;
    rdfs:label 'Tracking Enabled' ;
    rdfs:comment 'Indicates whether open tracking, click tracking, and engagement analytics are enabled for messages sent using this template.' ;
    rdfs:domain ind:MessageTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignedToUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned To User Employee Id' ;
    rdfs:comment 'Identifier of the platform engineer, developer, or team member assigned to implement this change request.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:relatedIncidentSlaIncidentId rdf:type rdf:Property ;
    rdfs:label 'Related Incident Sla Incident Id' ;
    rdfs:comment 'Reference to the incident that triggered this change request, if the change is remedial in nature.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SlaIncident .

ind:relatedProblemId rdf:type rdf:Property ;
    rdfs:label 'Related Problem Id' ;
    rdfs:comment 'Reference to the problem record that this change request aims to resolve permanently.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProblemRecord .

ind:affectedServices rdf:type rdf:Property ;
    rdfs:label 'Affected Services' ;
    rdfs:comment 'Description of fan-facing or internal services that will be impacted during or after the change implementation.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancelledDate rdf:type rdf:Property ;
    rdfs:label 'Cancelled Date' ;
    rdfs:comment 'Date when the change request was cancelled or withdrawn before implementation.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:changeAdvisoryBoardMeetingReference rdf:type rdf:Property ;
    rdfs:label 'Change Advisory Board Meeting Reference' ;
    rdfs:comment 'Reference to the CAB meeting where this change request was reviewed and approved or rejected.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:completedDate rdf:type rdf:Property ;
    rdfs:label 'Completed Date' ;
    rdfs:comment 'Date when the change request was fully implemented, tested, and closed as completed.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:downtimeRequired rdf:type rdf:Property ;
    rdfs:label 'Downtime Required' ;
    rdfs:comment 'Indicates whether the change requires planned service downtime or maintenance window for implementation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedDowntimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Downtime Minutes' ;
    rdfs:comment 'Projected duration of service downtime in minutes if downtime is required for change implementation.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:impactAssessment rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment' ;
    rdfs:comment 'Analysis of the potential impact of the change on platform services, fan experience, integrations, and dependent systems.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationNotes rdf:type rdf:Property ;
    rdfs:label 'Implementation Notes' ;
    rdfs:comment 'Detailed notes captured during change implementation including issues encountered, deviations from plan, and resolution steps.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationPlan rdf:type rdf:Property ;
    rdfs:label 'Implementation Plan' ;
    rdfs:comment 'Step-by-step procedure for executing the change, including deployment sequence, configuration steps, and validation checkpoints.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEmergency rdf:type rdf:Property ;
    rdfs:label 'Is Emergency' ;
    rdfs:comment 'Indicates whether this is an emergency change requiring expedited approval and implementation to restore critical services.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postImplementationReview rdf:type rdf:Property ;
    rdfs:label 'Post Implementation Review' ;
    rdfs:comment 'Summary of post-implementation review findings including success criteria validation, lessons learned, and improvement recommendations.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rollbackPlan rdf:type rdf:Property ;
    rdfs:label 'Rollback Plan' ;
    rdfs:comment 'Documented procedure for reverting the change if implementation fails or causes unacceptable service degradation.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successCriteria rdf:type rdf:Property ;
    rdfs:label 'Success Criteria' ;
    rdfs:comment 'Measurable criteria and acceptance conditions that define successful completion of the change implementation.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testingPlan rdf:type rdf:Property ;
    rdfs:label 'Testing Plan' ;
    rdfs:comment 'Description of testing activities, environments, and acceptance criteria required before production deployment.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactType rdf:type rdf:Property ;
