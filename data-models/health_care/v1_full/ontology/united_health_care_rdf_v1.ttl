    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:systemName rdf:type rdf:Property ;
    rdfs:label 'System Name' ;
    rdfs:comment 'The name of the information system or application where the control is executed or monitored.' ;
    rdfs:domain ind:AuditControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemModule rdf:type rdf:Property ;
    rdfs:label 'System Module' ;
    rdfs:comment 'The specific module or component within the system where the control operates.' ;
