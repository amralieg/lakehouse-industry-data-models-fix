  guild_clearance_required_flag boolean [note: 'Indicates whether guild or union clearance is required based on collective bargaining agreement terms. | Column guild_clearance_required_flag (BOOLEAN) in talent.talent_clearance']
  guild_clearance_status varchar [note: 'Current status of guild or union clearance verification for this usage. | Column guild_clearance_status (STRING) in talent.talent_clearance']
