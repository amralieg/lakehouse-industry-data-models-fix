ind:nextRiskAssessmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Risk Assessment Due Date' ;
    rdfs:comment 'Scheduled date for the next comprehensive risk assessment based on member risk tier and program requirements.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
