    rdfs:label 'Data Retention Period' ;
    rdfs:comment 'Number of days data covered by the DUA must be retained before disposal.' ;
    rdfs:domain ind:DuaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

