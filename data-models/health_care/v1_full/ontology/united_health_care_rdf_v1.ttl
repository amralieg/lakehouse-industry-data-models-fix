    rdfs:label 'Out Of Pocket Met Amount' ;
    rdfs:comment 'Amount of the out-of-pocket maximum that has been satisfied by the member as of the snapshot date.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageGapApplicable rdf:type rdf:Property ;
    rdfs:label 'Coverage Gap Applicable' ;
    rdfs:comment 'Indicates whether the member is subject to a coverage gap (donut hole) in their pharmacy benefit, typically applicable to Medicare Part D plans.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catastrophicCoverageThreshold rdf:type rdf:Property ;
    rdfs:label 'Catastrophic Coverage Threshold' ;
    rdfs:comment 'Total out-of-pocket spending threshold after which catastrophic coverage begins, applicable to Medicare Part D plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityLimitsApplicable rdf:type rdf:Property ;
    rdfs:label 'Quantity Limits Applicable' ;
    rdfs:comment 'Indicates whether the plan imposes quantity limits on certain medications.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genericSubstitutionRequired rdf:type rdf:Property ;
    rdfs:label 'Generic Substitution Required' ;
    rdfs:comment 'Indicates whether the plan requires generic substitution when a generic equivalent is available.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:copayTier3 rdf:type rdf:Property ;
    rdfs:label 'Copay Tier 3' ;
    rdfs:comment 'Fixed copayment amount for Tier 3 medications, typically non-preferred brand drugs.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayTier4 rdf:type rdf:Property ;
    rdfs:label 'Copay Tier 4' ;
    rdfs:comment 'Fixed copayment amount for Tier 4 medications, typically specialty drugs.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsuranceTier1Percent rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Tier 1 Percent' ;
    rdfs:comment 'Percentage of drug cost the member pays for Tier 1 medications when coinsurance applies instead of copayment.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsuranceTier2Percent rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Tier 2 Percent' ;
    rdfs:comment 'Percentage of drug cost the member pays for Tier 2 medications when coinsurance applies instead of copayment.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsuranceTier3Percent rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Tier 3 Percent' ;
    rdfs:comment 'Percentage of drug cost the member pays for Tier 3 medications when coinsurance applies instead of copayment.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsuranceTier4Percent rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Tier 4 Percent' ;
    rdfs:comment 'Percentage of drug cost the member pays for Tier 4 medications when coinsurance applies instead of copayment.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysSupplyRetailMax rdf:type rdf:Property ;
    rdfs:label 'Days Supply Retail Max' ;
    rdfs:comment 'Maximum number of days supply allowed for a single prescription fill at a retail pharmacy.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysSupplyMailOrderMax rdf:type rdf:Property ;
    rdfs:label 'Days Supply Mail Order Max' ;
    rdfs:comment 'Maximum number of days supply allowed for a single prescription fill through mail order pharmacy.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dualEligibleStatus rdf:type rdf:Property ;
    rdfs:label 'Dual Eligible Status' ;
    rdfs:comment 'Indicates whether the member is eligible for both Medicare and Medicaid benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Primary Coverage Indicator' ;
    rdfs:comment 'Indicates whether this pharmacy benefit is the primary coverage or secondary when multiple coverages exist.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:otherCoverageCode rdf:type rdf:Property ;
    rdfs:label 'Other Coverage Code' ;
    rdfs:comment 'Code identifying the type of other pharmacy coverage the member has, if applicable.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicarePartDContractId rdf:type rdf:Property ;
    rdfs:label 'Medicare Part D Contract Id' ;
    rdfs:comment 'CMS-assigned contract identifier for Medicare Part D plans, consisting of one letter followed by four digits.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contract .

ind:medicarePartDPlanId rdf:type rdf:Property ;
    rdfs:label 'Medicare Part D Plan Id' ;
    rdfs:comment 'Three-digit plan identifier within the Medicare Part D contract.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:medicarePartDSegmentId rdf:type rdf:Property ;
    rdfs:label 'Medicare Part D Segment Id' ;
    rdfs:comment 'Three-digit segment identifier for Medicare Part D plans, used to distinguish benefit packages within a plan.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Segment .

ind:exchangePlanIndicator rdf:type rdf:Property ;
    rdfs:label 'Exchange Plan Indicator' ;
    rdfs:comment 'Indicates whether the pharmacy benefit is part of a health insurance exchange plan.' ;
    rdfs:domain ind:EligibilityPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drugPriceId rdf:type rdf:Property ;
    rdfs:label 'Drug Price Id' ;
    rdfs:comment 'Unique identifier for each drug price record in the historical pricing table.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genericName rdf:type rdf:Property ;
    rdfs:label 'Generic Name' ;
    rdfs:comment 'The non-proprietary or generic name of the drug based on its active pharmaceutical ingredient.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:labelerName rdf:type rdf:Property ;
    rdfs:label 'Labeler Name' ;
    rdfs:comment 'The name of the company that manufactures or distributes the drug product.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageSize rdf:type rdf:Property ;
    rdfs:label 'Package Size' ;
    rdfs:comment 'The quantity and unit of measure for the drug package (e.g., 30 tablets, 100 ml).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strength rdf:type rdf:Property ;
    rdfs:label 'Strength' ;
    rdfs:comment 'The amount of active ingredient per dosage unit (e.g., 500mg, 10mg/ml).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awp rdf:type rdf:Property ;
    rdfs:label 'Awp' ;
    rdfs:comment 'The average wholesale price of the drug, commonly used as a benchmark for pharmacy reimbursement calculations. Represents the published price at which wholesalers sell to pharmacies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mac rdf:type rdf:Property ;
    rdfs:label 'Mac' ;
    rdfs:comment 'The maximum allowable cost established by the payer for reimbursing a generic drug, typically used to control costs for multi-source generic medications.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wac rdf:type rdf:Property ;
    rdfs:label 'Wac' ;
    rdfs:comment 'The manufacturer\'s list price for the drug to wholesalers or direct purchasers, excluding discounts and rebates.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nadac rdf:type rdf:Property ;
    rdfs:label 'Nadac' ;
    rdfs:comment 'The national average drug acquisition cost based on invoice prices paid by retail community pharmacies, published by CMS for Medicaid reimbursement.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitPrice rdf:type rdf:Property ;
    rdfs:label 'Unit Price' ;
    rdfs:comment 'The price per individual unit of the drug (e.g., per tablet, per ml), calculated from the package price.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceType rdf:type rdf:Property ;
    rdfs:label 'Price Type' ;
    rdfs:comment 'The type or category of pricing represented in this record (e.g., AWP, MAC, WAC, NADAC, contract price).' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceSource rdf:type rdf:Property ;
    rdfs:label 'Price Source' ;
    rdfs:comment 'The source or vendor from which the pricing data was obtained (e.g., First DataBank, Medi-Span, CMS, internal contract).' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceSourceFileDate rdf:type rdf:Property ;
    rdfs:label 'Price Source File Date' ;
    rdfs:comment 'The date of the source pricing file from which this price record was extracted.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priceChangeIndicator rdf:type rdf:Property ;
    rdfs:label 'Price Change Indicator' ;
    rdfs:comment 'Indicates whether this price represents an increase, decrease, or no change from the previous price for the same drug.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Price Change Percentage' ;
    rdfs:comment 'The percentage change in price compared to the previous price record for the same drug. Positive values indicate increases, negative values indicate decreases.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousPrice rdf:type rdf:Property ;
    rdfs:label 'Previous Price' ;
    rdfs:comment 'The price value from the immediately preceding price record for the same drug and price type, used for trend analysis.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpi rdf:type rdf:Property ;
    rdfs:label 'Gpi' ;
    rdfs:comment 'The 14-digit Generic Product Identifier that classifies drugs by therapeutic class and chemical structure, used for drug grouping and analysis.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multiSourceCode rdf:type rdf:Property ;
    rdfs:label 'Multi Source Code' ;
    rdfs:comment 'Indicates whether the drug is available from a single source (brand only) or multiple sources (generic available).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:desiCode rdf:type rdf:Property ;
    rdfs:label 'Desi Code' ;
    rdfs:comment 'Code indicating the FDA\'s evaluation of the drug\'s effectiveness under the Drug Efficacy Study Implementation program.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deaSchedule rdf:type rdf:Property ;
    rdfs:label 'Dea Schedule' ;
    rdfs:comment 'The DEA controlled substance schedule classification (I through V) indicating the drug\'s potential for abuse and accepted medical use. Non-controlled substances are not scheduled.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otcIndicator rdf:type rdf:Property ;
    rdfs:label 'Otc Indicator' ;
    rdfs:comment 'Indicates whether the drug is available over-the-counter without a prescription (true) or requires a prescription (false).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:biosimilarIndicator rdf:type rdf:Property ;
    rdfs:label 'Biosimilar Indicator' ;
    rdfs:comment 'Indicates whether the drug is a biosimilar product approved as highly similar to an FDA-approved reference biologic.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referenceBiologicNdc rdf:type rdf:Property ;
    rdfs:label 'Reference Biologic Ndc' ;
    rdfs:comment 'The NDC of the reference biologic product for which this drug is a biosimilar, if applicable.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebateEligible rdf:type rdf:Property ;
    rdfs:label 'Rebate Eligible' ;
    rdfs:comment 'Indicates whether the drug is eligible for manufacturer rebates negotiated by the PBM or health plan.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rebatePercentage rdf:type rdf:Property ;
    rdfs:label 'Rebate Percentage' ;
    rdfs:comment 'The negotiated rebate as a percentage of the drug\'s price that the manufacturer pays back to the PBM or health plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispensingFee rdf:type rdf:Property ;
    rdfs:label 'Dispensing Fee' ;
    rdfs:comment 'The fee paid to the pharmacy for dispensing the medication, separate from the drug cost.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ingredientCost rdf:type rdf:Property ;
    rdfs:label 'Ingredient Cost' ;
    rdfs:comment 'The cost of the drug ingredient itself, excluding dispensing fees and other charges.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reimbursementBasis rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Basis' ;
    rdfs:comment 'The methodology used to calculate pharmacy reimbursement for this drug (e.g., AWP minus percentage, MAC, WAC plus).' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reimbursementPercentage rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Percentage' ;
    rdfs:comment 'The percentage applied to the pricing basis for calculating pharmacy reimbursement (e.g., AWP minus 15% would be stored as -15.0000).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCopayTier1 rdf:type rdf:Property ;
    rdfs:label 'Member Copay Tier 1' ;
    rdfs:comment 'The member copayment amount for tier 1 (typically generic) drugs under standard benefit design.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCopayTier2 rdf:type rdf:Property ;
    rdfs:label 'Member Copay Tier 2' ;
    rdfs:comment 'The member copayment amount for tier 2 (typically preferred brand) drugs under standard benefit design.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCopayTier3 rdf:type rdf:Property ;
    rdfs:label 'Member Copay Tier 3' ;
    rdfs:comment 'The member copayment amount for tier 3 (typically non-preferred brand) drugs under standard benefit design.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCoinsurancePercentage rdf:type rdf:Property ;
    rdfs:label 'Member Coinsurance Percentage' ;
    rdfs:comment 'The percentage of drug cost that the member is responsible for paying as coinsurance.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mailOrderEligible rdf:type rdf:Property ;
    rdfs:label 'Mail Order Eligible' ;
    rdfs:comment 'Indicates whether the drug is eligible for dispensing through mail order pharmacy programs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maintenanceDrugIndicator rdf:type rdf:Property ;
    rdfs:label 'Maintenance Drug Indicator' ;
    rdfs:comment 'Indicates whether the drug is classified as a maintenance medication typically used for chronic conditions requiring ongoing therapy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vaccineIndicator rdf:type rdf:Property ;
    rdfs:label 'Vaccine Indicator' ;
    rdfs:comment 'Indicates whether the drug is a vaccine product used for immunization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:340bEligible rdf:type rdf:Property ;
    rdfs:label '340b Eligible' ;
    rdfs:comment 'Indicates whether the drug is eligible for purchase under the federal 340B Drug Pricing Program for covered entities.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orangeBookCode rdf:type rdf:Property ;
    rdfs:label 'Orange Book Code' ;
    rdfs:comment 'The therapeutic equivalence code from the FDA Orange Book indicating whether generic drugs are therapeutically equivalent to brand-name drugs.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patentExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Patent Expiration Date' ;
    rdfs:comment 'The date on which the drug\'s patent protection expires, potentially allowing generic competition.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketEntryDate rdf:type rdf:Property ;
    rdfs:label 'Market Entry Date' ;
    rdfs:comment 'The date on which the drug first became available in the market.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:discontinuationDate rdf:type rdf:Property ;
    rdfs:label 'Discontinuation Date' ;
    rdfs:comment 'The date on which the drug was discontinued by the manufacturer and is no longer available for purchase.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shortageIndicator rdf:type rdf:Property ;
    rdfs:label 'Shortage Indicator' ;
    rdfs:comment 'Indicates whether the drug is currently experiencing a supply shortage as reported by the FDA or manufacturer.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shortageReason rdf:type rdf:Property ;
    rdfs:label 'Shortage Reason' ;
    rdfs:comment 'The reason for the drug shortage if applicable (e.g., manufacturing issue, increased demand, raw material shortage).' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticAlternativeNdc rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Alternative Ndc' ;
    rdfs:comment 'The NDC of a therapeutically equivalent alternative drug that can be substituted if this drug is unavailable or not covered.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceUpdateTimestamp rdf:type rdf:Property ;
    rdfs:label 'Price Update Timestamp' ;
    rdfs:comment 'The timestamp when this price record was created or last updated in the system.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:priceStatus rdf:type rdf:Property ;
    rdfs:label 'Price Status' ;
    rdfs:comment 'The current status of this price record indicating whether it is active, inactive, pending implementation, or historical.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingRegion rdf:type rdf:Property ;
    rdfs:label 'Pricing Region' ;
    rdfs:comment 'The geographic region or market to which this pricing applies, as drug prices may vary by region.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Price Verification Status' ;
    rdfs:comment 'Indicates whether this price has been verified for accuracy against source data or requires review.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceNotes rdf:type rdf:Property ;
    rdfs:label 'Price Notes' ;
    rdfs:comment 'Free-text notes or comments regarding this price record, such as special pricing conditions or data quality issues.' ;
    rdfs:domain ind:DrugPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationPharmacyId rdf:type rdf:Property ;
    rdfs:label 'Location Pharmacy Id' ;
    rdfs:comment 'Unique identifier for each pharmacy location in the network.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LocationPharmacy .

ind:ncpdpId rdf:type rdf:Property ;
    rdfs:label 'Ncpdp Id' ;
    rdfs:comment 'The 7-digit NCPDP provider identifier used for pharmacy claims processing and electronic transactions.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nabpId rdf:type rdf:Property ;
    rdfs:label 'Nabp Id' ;
    rdfs:comment 'The unique 7-digit identifier assigned by NABP for pharmacy licensure and verification.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chainCode rdf:type rdf:Property ;
    rdfs:label 'Chain Code' ;
    rdfs:comment 'Identifier for the pharmacy chain or corporate parent organization, if applicable.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chainName rdf:type rdf:Property ;
    rdfs:label 'Chain Name' ;
    rdfs:comment 'The name of the pharmacy chain or corporate parent organization.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSpecialty rdf:type rdf:Property ;
    rdfs:label 'Is Specialty' ;
    rdfs:comment 'Indicates whether the pharmacy is accredited and contracted to dispense specialty medications for complex conditions.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMailOrder rdf:type rdf:Property ;
    rdfs:label 'Is Mail Order' ;
    rdfs:comment 'Indicates whether the pharmacy provides mail order prescription services for maintenance medications.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:is340b rdf:type rdf:Property ;
    rdfs:label 'Is 340b' ;
    rdfs:comment 'Indicates whether the pharmacy participates in the federal 340B drug discount program for eligible healthcare organizations.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:is24Hour rdf:type rdf:Property ;
    rdfs:label 'Is 24 Hour' ;
    rdfs:comment 'Indicates whether the pharmacy operates 24 hours per day, 7 days per week.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDriveThrough rdf:type rdf:Property ;
    rdfs:label 'Is Drive Through' ;
    rdfs:comment 'Indicates whether the pharmacy offers drive-through prescription pickup services.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCompounding rdf:type rdf:Property ;
    rdfs:label 'Is Compounding' ;
    rdfs:comment 'Indicates whether the pharmacy is licensed and equipped to perform sterile or non-sterile compounding services.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isImmunizationProvider rdf:type rdf:Property ;
    rdfs:label 'Is Immunization Provider' ;
    rdfs:comment 'Indicates whether the pharmacy is authorized and staffed to administer immunizations and vaccines.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDmeProvider rdf:type rdf:Property ;
    rdfs:label 'Is Dme Provider' ;
    rdfs:comment 'Indicates whether the pharmacy dispenses durable medical equipment in addition to medications.' ;
    rdfs:domain ind:LocationPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

