    rdfs:comment 'The general ledger account code from which the amount is being allocated.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetGlAccountCode rdf:type rdf:Property ;
    rdfs:label 'Target Gl Account Code' ;
    rdfs:comment 'The general ledger account code to which the amount is being allocated.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineOfBusinessCode rdf:type rdf:Property ;
    rdfs:label 'Line Of Business Code' ;
    rdfs:comment 'The line of business code (e.g., Commercial, Medicare, Medicaid) to which this allocation applies.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
