    rdfs:comment 'Text description of any sponsor category restrictions or exclusions for this inventory (e.g., no alcohol brands, no competing leagues, family-friendly content only).' ;
    rdfs:domain ind:InventoryCategory ;
    rdf:type owl:DatatypeProperty ;
