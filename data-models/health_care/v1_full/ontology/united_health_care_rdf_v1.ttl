    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adverseActionDescription rdf:type rdf:Property ;
    rdfs:label 'Adverse Action Description' ;
    rdfs:comment 'Description of any adverse actions disclosed by the provider or found during verification.' ;
