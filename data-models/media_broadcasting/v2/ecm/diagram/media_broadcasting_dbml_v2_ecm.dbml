  genre_id varchar [note: 'Foreign key linking to the content genre covered by this buy agreement | Column genre_id (BIGINT) in content.genre_buy_agreement']
  sales_employee_id varchar [note: 'The identifier of the sales account executive who negotiated and owns this genre buy agreement. Links to employee master data. | Column sales_employee_id (BIGINT) in workforce.genre_buy_agreement']
