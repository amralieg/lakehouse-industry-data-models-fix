    rdfs:range xsd:string .

ind:operatorName rdf:type rdf:Property ;
    rdfs:label 'Operator Name' ;
    rdfs:comment 'Legal business name of the gaming operator entity.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentProcessor rdf:type rdf:Property ;
    rdfs:label 'Payment Processor' ;
    rdfs:comment 'Name of the payment processing vendor handling financial transactions for the operator.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platformProvider rdf:type rdf:Property ;
    rdfs:label 'Platform Provider' ;
    rdfs:comment 'Name of the technology platform provider or vendor that powers the operator\'s gaming systems.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuthority rdf:type rdf:Property ;
