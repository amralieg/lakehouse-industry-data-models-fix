  total_units_available varchar [note: 'Total ad units available']
  units_remaining varchar [note: 'Number of units remaining']
  units_sold varchar [note: 'Number of units sold']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Local advertising avail inventory at affiliate stations including local breaks within network programming'
}

Table billing.invoice {
  invoice_id varchar [pk, note: 'Unique identifier for the invoice. Primary key for the invoice entity. | Column invoice_id (BIGINT) in billing.invoice']
  advertiser_id varchar [note: 'Foreign key linking to sales.advertiser. Business justification: Direct-billed advertiser invoices (no agency intermediary) require advertiser reference for AR aging, credit limit enforcement, payment terms application, and advertiser-level revenue reporting in med | Column advertiser_id (BIGINT) in sales.invoice']
  billing_account_id varchar [note: 'Reference to the billing account or subscription account associated with this invoice. | Column billing_account_id (BIGINT) in billing.invoice']
  billing_cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: Invoice is generated by ONE billing cycle run. Need to track which cycle configuration was used to generate this invoice for audit and reconciliation purposes. No redundant columns to remove. | Column billing_cycle_id (BIGINT) in billing.invoice']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Facility lease invoices, power bills, and maintenance service charges require facility tracking for cost center allocation, revenue recognition by location, and operational expense reporting in broadc | Column broadcast_facility_id (BIGINT) in technology.invoice']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Station-specific invoices (local ad sales, tower leases) must be attributable to the licensed facility for FCC financial reporting, ownership attribution calculations, and license renewal revenue disc | Column broadcast_license_id (BIGINT) in compliance.invoice']
  communication_template_id varchar [note: 'Foreign key linking to billing.communication_template. Business justification: Invoice delivery uses ONE communication template. Need to track which template was used to deliver this specific invoice for audit and customer service purposes. No redundant columns to remove. | Column communication_template_id (BIGINT) in billing.invoice']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Invoices need cost center attribution for internal cost allocation, chargeback processes, and departmental P&L. Common in media orgs where production units, channels, or business units tracked as cost | Column cost_center_id (BIGINT) in finance.invoice']
  created_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Invoices are generated by billing operations staff. Tracking which employee created each invoice is required for audit trail, compliance oversight, and operational quality control in media broadcastin | Column created_by_employee_id (BIGINT) in workforce.invoice']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Invoices must be attributed to profit centers for segment reporting, business unit P&L, and EBITDA calculation. Critical for media broadcasting where channels, platforms, or content divisions are prof | Column profit_center_id (BIGINT) in finance.invoice']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Political advertising invoices must reference FCC public file filings per 47 CFR 73.3526. Enables compliance officers to trace revenue to regulatory disclosures and auditors to verify filing completen | Column regulatory_filing_id (BIGINT) in compliance.invoice']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Invoices must classify revenue by stream for financial reporting, segment analysis, and ASC 606/IFRS 15 revenue recognition compliance. Critical for media broadcasting where revenue streams (advertisi | Column revenue_stream_id (BIGINT) in finance.invoice']
  rights_content_window_id varchar [note: 'Reference to the content license window for syndication invoices. Defines the rights period being billed. | Column license_window_id (BIGINT) in rights.invoice']
  run_id varchar [note: 'Foreign key linking to billing.run. Business justification: Invoice is generated by ONE billing run (batch process). Need to track which specific batch execution generated this invoice for operational audit trail and troubleshooting. No redundant columns to re | Column run_id (BIGINT) in billing.invoice']
  sales_agency_id varchar [note: 'Foreign key linking to sales.agency. Business justification: Agency-billed invoices require agency reference for consolidated billing, commission calculation, agency credit limit management, and agency-level AR reporting in advertising operations. | Column sales_agency_id (BIGINT) in sales.invoice']
  subscriber_id varchar [note: 'Reference to the customer, advertiser, MVPD partner, or syndication licensee being billed. | Column subscriber_id (BIGINT) in subscriber.invoice']
  subscription_plan_id varchar [note: 'Reference to the subscription plan for SVOD billing invoices. Null for non-subscription revenue categories. | Column subscription_plan_id (BIGINT) in subscriber.invoice']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.invoice']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.invoice']
  adjustment_amount decimal(18,2) [note: 'Total adjustment amount for credits, makegoods, or billing corrections. Can be positive or negative. | Column adjustment_amount (DECIMAL(18,2)) in billing.invoice']
  amount_paid decimal(18,2) [note: 'Total amount paid against this invoice to date. Used to calculate outstanding balance. | Column amount_paid (DECIMAL(18,2)) in billing.invoice']
  billing_period_end_date date [note: 'End date of the billing period covered by this invoice. Relevant for subscription and carriage fee billing. | Column billing_period_end_date (DATE) in billing.invoice']
  billing_period_start_date date [note: 'Start date of the billing period covered by this invoice. Relevant for subscription and carriage fee billing. | Column billing_period_start_date (DATE) in billing.invoice']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.invoice']
  created_timestamp timestamp [note: 'Timestamp when this invoice record was first created in the billing system. | Column created_timestamp (TIMESTAMP) in billing.invoice']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this invoice. | Column currency_code (STRING) in billing.invoice']
  discount_amount decimal(18,2) [note: 'Total discount amount applied to this invoice, including promotional discounts, volume discounts, or contractual adjustments. | Column discount_amount (DECIMAL(18,2)) in billing.invoice']
  dispute_date date [note: 'Date the invoice was disputed by the customer. Null if never disputed. | Column dispute_date (DATE) in billing.invoice']
  dispute_reason varchar [note: 'Reason provided by customer for disputing this invoice. Populated when invoice_status is disputed. | Column dispute_reason (STRING) in billing.invoice']
  due_date date [note: 'Date by which payment is expected based on payment terms. Used to calculate overdue status. | Column due_date (DATE) in billing.invoice']
  installment_number varchar [note: 'Installment sequence number for syndication license fees paid over multiple periods. Null for single-payment invoices. | Column installment_number (INT) in billing.invoice']
  invoice_date date [note: 'Date the invoice was issued to the customer, advertiser, or partner. Used as the basis for payment terms calculation. | Column invoice_date (DATE) in billing.invoice']
  invoice_number varchar [note: 'Externally-visible unique invoice number used for customer communication and payment reference. Generated by billing system (Zuora, Wide Orbit, or SAP S/4HANA). | Column invoice_number (STRING) in billing.invoice']
  invoice_status varchar [note: 'Current lifecycle status of the invoice in the billing workflow. [ENUM-REF-CANDIDATE: draft|issued|sent|paid|partially_paid|overdue|disputed|void|cancelled — 9 candidates stripped; promote to reference product] | Column invoice_status (STRING) in billing.invoice']
  isci_codes varchar [note: 'Comma-separated list of ISCI codes for ad spots included in this advertising invoice. Used for affidavit matching and proof of broadcast. | Column isci_codes (STRING) in billing.invoice']
  mvpd_subscriber_count varchar [note: 'Number of subscribers reported by the MVPD partner as the basis for carriage fee calculation. Relevant for carriage fee invoices. | Column mvpd_subscriber_count (INT) in billing.invoice']
  notes varchar [note: 'Free-text notes or comments about this invoice for internal reference or customer communication. | Column notes (STRING) in billing.invoice']
  outstanding_balance decimal(18,2) [note: 'Remaining unpaid balance on this invoice. Calculated as total_amount_due minus amount_paid. | Column outstanding_balance (DECIMAL(18,2)) in billing.invoice']
  paid_date date [note: 'Date the invoice was fully paid. Null if not yet paid or only partially paid. | Column paid_date (DATE) in billing.invoice']
  payment_method varchar [note: 'Primary payment method used or expected for this invoice. [ENUM-REF-CANDIDATE: credit_card|bank_transfer|ach|wire|check|direct_debit|paypal|other — 8 candidates stripped; promote to reference product] | Column payment_method (STRING) in billing.invoice']
  payment_terms varchar [note: 'Contractual payment terms defining when payment is due relative to invoice date. [ENUM-REF-CANDIDATE: net_15|net_30|net_45|net_60|net_90|due_on_receipt|prepaid — 7 candidates stripped; promote to reference product] | Column payment_terms (STRING) in billing.invoice']
  proration_flag boolean [note: 'Indicates whether this subscription invoice includes prorated charges due to mid-cycle changes. Relevant for SVOD billing. | Column proration_flag (BOOLEAN) in billing.invoice']
  revenue_recognition_end_date date [note: 'End date of the period over which revenue from this invoice should be recognized per ASC 606 guidelines. | Column revenue_recognition_end_date (DATE) in billing.invoice']
  revenue_recognition_start_date date [note: 'Start date of the period over which revenue from this invoice should be recognized per ASC 606 guidelines. | Column revenue_recognition_start_date (DATE) in billing.invoice']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.invoice']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.invoice']
  source_system_invoice_reference varchar [note: 'Original invoice identifier from the source billing system. Used for reconciliation and audit trail. | Column source_system_invoice_reference (STRING) in billing.invoice']
  subtotal_amount decimal(18,2) [note: 'Total amount before taxes, fees, and adjustments. Sum of all line item amounts. | Column subtotal_amount (DECIMAL(18,2)) in billing.invoice']
  tax_amount decimal(18,2) [note: 'Total tax amount applied to this invoice, including sales tax, VAT, or other applicable taxes. | Column tax_amount (DECIMAL(18,2)) in billing.invoice']
  total_amount_due decimal(18,2) [note: 'Final total amount due after all taxes, discounts, and adjustments. This is the amount the customer must pay. | Column total_amount_due (DECIMAL(18,2)) in billing.invoice']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.invoice']
  updated_timestamp timestamp [note: 'Timestamp when this invoice record was last modified in the billing system. | Column updated_timestamp (TIMESTAMP) in billing.invoice']
  void_reason varchar [note: 'Reason this invoice was voided or cancelled. Populated when invoice_status is void or cancelled. | Column void_reason (STRING) in billing.invoice']
  wide_orbit_order_reference varchar [note: 'Reference to the Wide Orbit sales order for advertising billing invoices. Null for non-advertising revenue categories. | Column wide_orbit_order_reference (STRING) in billing.invoice']

  Note: 'Master billing document representing a formal demand for payment issued to a subscriber, advertiser, MVPD partner, or syndication licensee. Captures invoice number, billing period, total amount due, currency, tax amounts, invoice status (draft, issued, paid, disputed, void), due date, payment terms, revenue category (subscription, advertising, carriage, syndication), ASC 606 revenue recognition period, and source system reference (Zuora, Wide Orbit, SAP S/4HANA). Supports stream-specific extended attributes: subscription plan/proration for SVOD billing, Wide Orbit order ID/ISCI codes for ad billing, MVPD subscriber count basis for carriage fees, and license window/installment schedule for syndication. Serves as the SSOT for all billing documents across all revenue streams. | Unity Catalog table: media_broadcasting_ecm.billing.invoice'
}

Table billing.invoice_line {
  invoice_line_id varchar [pk, note: 'Unique identifier for the invoice line item. Primary key for the invoice_line product. | Column invoice_line_id (BIGINT) in billing.invoice_line']
  ad_campaign_id varchar [note: 'Reference to the advertising campaign associated with this line item, applicable when revenue_category is advertising. Links to campaign details for ad spot billing. | Column ad_campaign_id (BIGINT) in sales.invoice_line']
  ad_order_id varchar [note: 'Reference to the advertising sales order that generated this billing line, used for tracking ad sales fulfillment and billing reconciliation. | Column ad_order_id (BIGINT) in sales.invoice_line']
  ad_order_line_id varchar [note: 'Foreign key linking to sales.ad_order_line. Business justification: Granular billing of individual ad order lines (by daypart, program, spot length) requires direct line-level link for accurate invoicing, revenue recognition, and performance reporting in media sales. | Column ad_order_line_id (BIGINT) in sales.invoice_line']
  advertising_makegood_id varchar [note: 'Foreign key linking to sales.makegood. Business justification: Makegood spot billing requires direct makegood reference for revenue recognition, fulfillment tracking, and advertiser reporting of makegood delivery in broadcast advertising operations. | Column advertising_makegood_id (BIGINT) in sales.invoice_line']
  content_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Invoice line items for content licensing, VOD rentals, or syndication fees reference specific titles for revenue attribution, royalty calculations, and content ROI analysis. Finance teams allocate rev | Column content_title_id (BIGINT) in content.invoice_line']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Each ad line item specifies the target demographic (A18-49, W25-54, etc.) that determines the CPM rate, pricing tier, and delivery verification. Demographic is the billing currency in audience-based a | Column demographic_segment_id (BIGINT) in audience.invoice_line']
  invoice_id varchar [note: 'Reference to the parent invoice header that contains this line item. Links this line to the billing invoice transaction. | Column invoice_id (BIGINT) in billing.invoice_line']
  it_asset_id varchar [note: 'Foreign key linking to technology.it_asset. Business justification: Line items for equipment leases, software licenses, and asset rentals need asset tracking for contract compliance verification, depreciation schedule reconciliation, and capital vs. operational expens | Column it_asset_id (BIGINT) in technology.invoice_line']
  license_agreement_id varchar [note: 'Reference to the content license agreement for syndication or licensing revenue line items, tracking rights fees and royalty payments. | Column license_agreement_id (BIGINT) in rights.invoice_line']
  nielsen_rating_id varchar [note: 'Foreign key linking to audience.nielsen_rating. Business justification: Ad invoice line items reference specific Nielsen ratings for the aired spot to verify CPM/GRP delivery, calculate makegood obligations, and reconcile guaranteed vs actual audience performance. Core ad | Column nielsen_rating_id (BIGINT) in audience.invoice_line']
  original_invoice_line_id varchar [note: 'Reference to the original invoice line that this line is adjusting, crediting, or replacing. Used for tracking billing corrections, credits, and makegoods. | Column original_invoice_line_id (BIGINT) in billing.invoice_line']
  performance_obligation_id varchar [note: 'Identifier for the performance obligation under ASC 606 revenue recognition standard, linking this charge to a specific contractual promise to deliver goods or services. | Column performance_obligation_id (BIGINT) in partner.invoice_line']
  political_ad_record_id varchar [note: 'Foreign key linking to compliance.political_ad_record. Business justification: Individual invoice lines for political ads must link to public file records for FCC compliance. Enables auditors to verify lowest unit charge, reasonable access, and equal time obligations at line-ite | Column political_ad_record_id (BIGINT) in compliance.invoice_line']
  product_id varchar [note: 'Reference to the product or service catalog entry that defines what is being sold on this invoice line. | Column product_id (BIGINT) in billing.invoice_line']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Line items need revenue stream classification for granular revenue recognition, commission calculation, and segment reporting. More precise than invoice-level classification, essential for mixed-reven | Column revenue_stream_id (BIGINT) in finance.invoice_line']
  subscription_id varchar [note: 'Reference to the subscriber subscription record for subscription revenue line items, linking the charge to the active subscription plan. | Column subscription_id (BIGINT) in subscriber.invoice_line']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Advertising spot delivery invoices reference specific transmission equipment for proof-of-performance documentation, FCC compliance reporting, and affidavit verification required by advertisers and ag | Column transmission_equipment_id (BIGINT) in technology.invoice_line']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.invoice_line']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.invoice_line']
  charge_description varchar [note: 'Detailed description of the charge appearing on the invoice line, explaining the service, ad spot, carriage fee period, or license fee installment being billed. | Column charge_description (STRING) in billing.invoice_line']
  cost_center varchar [note: 'Cost center or business unit responsible for this revenue line, used for internal financial reporting and profitability analysis. | Column cost_center (STRING) in billing.invoice_line']
  cpm_rate decimal(18,4) [note: 'Cost per thousand impressions rate for advertising line items, the standard pricing metric for ad inventory sales in broadcasting. | Column cpm_rate (DECIMAL(18,4)) in billing.invoice_line']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.invoice_line']
  created_timestamp timestamp [note: 'Timestamp when this invoice line record was first created in the billing system, used for audit trail and billing cycle tracking. | Column created_timestamp (TIMESTAMP) in billing.invoice_line']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this line (e.g., USD, GBP, EUR, CAD). | Column currency_code (STRING) in billing.invoice_line']
  discount_amount decimal(18,2) [note: 'Total discount applied to this line item, including promotional discounts, volume discounts, makegoods credits, or contractual rate reductions. | Column discount_amount (DECIMAL(18,2)) in billing.invoice_line']
  discount_code varchar [note: 'Code or identifier for the discount program or promotion applied to this line, used for tracking discount effectiveness and revenue impact. | Column discount_code (STRING) in billing.invoice_line']
  dispute_status varchar [note: 'Current status of any billing dispute associated with this line item, tracking customer challenges and resolution workflow. | Column dispute_status (STRING) in billing.invoice_line']
  extended_amount decimal(18,2) [note: 'Total amount for this line item including all charges, discounts, and taxes. This is the final billable amount for the line. | Column extended_amount (DECIMAL(18,2)) in billing.invoice_line']
  gl_account_code varchar [note: 'General ledger account code for posting this revenue line item to the financial system, ensuring proper revenue classification in financial statements. | Column gl_account_code (STRING) in billing.invoice_line']
  grp_delivered decimal(10,2) [note: 'Gross Rating Points delivered for this advertising line item, measuring the total audience reach and frequency achieved for the campaign. | Column grp_delivered (DECIMAL(10,2)) in billing.invoice_line']
  isci_code varchar [note: 'Industry Standard Commercial Identification code for the specific ad creative that aired, used for affidavit verification and makegood tracking. | Column isci_code (STRING) in billing.invoice_line']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent modification to this invoice line record, tracking billing adjustments and corrections for audit purposes. | Column last_modified_timestamp (TIMESTAMP) in billing.invoice_line']
  line_item_number varchar [note: 'Business-facing line item identifier displayed on customer invoices and billing statements for reference and dispute resolution. | Column line_item_number (STRING) in billing.invoice_line']
  line_number varchar [note: 'Sequential line number within the invoice, used for ordering and referencing specific charges on the invoice document. | Column line_number (INT) in billing.invoice_line']
  makegood_flag boolean [note: 'Indicates whether this line item is a makegood (compensatory ad spot) provided to an advertiser due to underdelivery or technical issues with a previous campaign. | Column makegood_flag (BOOLEAN) in billing.invoice_line']
  notes varchar [note: 'Free-form notes or comments about this invoice line, used for documenting special billing arrangements, dispute details, or billing adjustments. | Column notes (STRING) in billing.invoice_line']
  quantity decimal(18,4) [note: 'Quantity of units being charged on this line. For ad spots this is the number of impressions or spots; for subscriptions this is typically 1; for usage-based billing this is the measured consumption. | Column quantity (DECIMAL(18,4)) in billing.invoice_line']
  revenue_recognition_rule varchar [note: 'Rule or method for recognizing revenue from this line item, such as point-in-time (ad spot delivery), over-time (subscription period), or milestone-based (license installment). | Column revenue_recognition_rule (STRING) in billing.invoice_line']
  service_period_end_date date [note: 'End date of the service period covered by this line item charge. For subscriptions this is the billing cycle end; for ad campaigns this is the flight end date. | Column service_period_end_date (DATE) in billing.invoice_line']
  service_period_start_date date [note: 'Start date of the service period covered by this line item charge. For subscriptions this is the billing cycle start; for ad campaigns this is the flight start date. | Column service_period_start_date (DATE) in billing.invoice_line']
  service_type varchar [note: 'Specific type of service or product being billed on this line, such as premium channel subscription, ad pod placement, carriage agreement tier, or syndication window. | Column service_type (STRING) in billing.invoice_line']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.invoice_line']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.invoice_line']
  spot_count varchar [note: 'Number of ad spots delivered for this line item, used in advertising billing to verify delivery against the sales order commitment. | Column spot_count (INT) in billing.invoice_line']
  subtotal_amount decimal(18,2) [note: 'Line item subtotal before taxes and discounts, calculated as quantity multiplied by unit rate. | Column subtotal_amount (DECIMAL(18,2)) in billing.invoice_line']
  tax_amount decimal(18,2) [note: 'Total tax charged on this line item, including sales tax, VAT, GST, or other applicable taxes based on jurisdiction and service type. | Column tax_amount (DECIMAL(18,2)) in billing.invoice_line']
  tax_code varchar [note: 'Tax classification code that determines the tax treatment for this line item, used for tax calculation and compliance reporting. | Column tax_code (STRING) in billing.invoice_line']
  unit_of_measure varchar [note: 'Unit of measure for the quantity field, such as spot (ad placement), impression (ad view), subscriber (subscription count), stream (viewing session), or GB (data transfer). | Column unit_of_measure (STRING) in billing.invoice_line']
  unit_rate decimal(18,4) [note: 'Price per unit for this line item. For advertising this may be CPM (Cost Per Mille) rate; for subscriptions this is the plan price; for carriage this is the per-subscriber fee. | Column unit_rate (DECIMAL(18,4)) in billing.invoice_line']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.invoice_line']

  Note: 'Individual line-item detail within a billing invoice, representing a discrete charge for a specific service, ad spot, carriage fee period, or license fee installment. Captures line number, charge description, quantity, unit rate, extended amount, revenue category (subscription, advertising, carriage, syndication), performance obligation identifier per ASC 606, tax code, and discount applied. Enables granular revenue recognition and dispute resolution at the charge level. | Unity Catalog table: media_broadcasting_ecm.billing.invoice_line'
}

Table billing.payment {
  payment_id varchar [pk, note: 'Unique identifier for the payment transaction. Primary key for the payment record. | Column payment_id (BIGINT) in billing.payment']
  billing_account_id varchar [note: 'Reference to the customer or advertiser account making the payment. Links payment to account holder. | Column billing_account_id (BIGINT) in billing.payment']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Payments need cost center attribution for cash application tracking and departmental cash flow analysis. Enables media orgs to track cash collection performance by department or business unit for work | Column cost_center_id (BIGINT) in finance.payment']
  invoice_id varchar [note: 'Reference to the invoice against which this payment is applied. Links payment to billing document. | Column invoice_id (BIGINT) in billing.payment']
  payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: Payment is made using ONE payment method (stored payment instrument). Currently duplicates card and bank account details; need FK to the stored payment_method record for single source of truth. Remove | Column payment_method_id (BIGINT) in billing.payment']
  processed_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Payment processing requires employee accountability for fraud prevention, reconciliation, and audit compliance. Tracking which billing staff member processed each payment is standard financial control | Column processed_by_employee_id (BIGINT) in workforce.payment']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Payments attributed to profit centers for segment-level cash collection and DSO analysis. Critical for media broadcasters tracking cash collection performance by channel or platform for working capita | Column profit_center_id (BIGINT) in finance.payment']
  vendor_contract_id varchar [note: 'Foreign key linking to technology.vendor_contract. Business justification: Payments to technology vendors must reference contracts for payment terms validation, accrual matching, milestone-based payment verification, and audit trail compliance required in technology procurem | Column vendor_contract_id (BIGINT) in technology.payment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.payment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.payment']
  amount decimal(18,2) [note: 'The monetary amount of the payment transaction in the specified currency. Gross payment value before any adjustments. | Column amount (DECIMAL(18,2)) in billing.payment']
  applied_amount decimal(18,2) [note: 'The portion of the payment amount that has been applied against outstanding invoices or account balances. May differ from payment_amount if partial application or overpayment. | Column applied_amount (DECIMAL(18,2)) in billing.payment']
  authorization_code varchar [note: 'Authorization code returned by the payment processor or card issuer confirming approval of the transaction. | Column authorization_code (STRING) in billing.payment']
  bank_transaction_reference varchar [note: 'Reference number provided by the bank for wire transfers, ACH transactions, or check deposits. Used for bank reconciliation. | Column bank_transaction_reference (STRING) in billing.payment']
  channel varchar [note: 'The channel or interface through which the payment was submitted (web portal, mobile app, IVR, mail, in-person, API, batch import). [ENUM-REF-CANDIDATE: web_portal|mobile_app|ivr|mail|in_person|api|batch_import — 7 candidates stripped; promote to reference product] | Column channel (STRING) in billing.payment']
  check_number varchar [note: 'Check number for payments made by paper check. Used for reconciliation and tracking. | Column check_number (STRING) in billing.payment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.payment']
  created_timestamp timestamp [note: 'Timestamp when this payment record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column created_timestamp (TIMESTAMP) in billing.payment']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the payment transaction (e.g., USD, GBP, EUR, CAD). | Column currency_code (STRING) in billing.payment']
  dispute_date date [note: 'Date when the payment dispute or chargeback was initiated. Format: yyyy-MM-dd. | Column dispute_date (DATE) in billing.payment']
  failure_reason varchar [note: 'Detailed reason for payment failure if status is failed. Includes processor error codes and messages. | Column failure_reason (STRING) in billing.payment']
  gateway varchar [note: 'Name of the payment gateway or processor used to handle the transaction (e.g., Stripe, Authorize.Net, PayPal, Adyen). | Column gateway (STRING) in billing.payment']
  gateway_transaction_reference varchar [note: 'Unique transaction identifier assigned by the payment gateway or processor. Used for reconciliation and dispute resolution. | Column gateway_transaction_reference (STRING) in billing.payment']
  gl_posting_date date [note: 'Date when the payment was posted to the general ledger in the financial system. Format: yyyy-MM-dd. | Column gl_posting_date (DATE) in billing.payment']
  is_autopay boolean [note: 'Indicates whether this payment was processed automatically through a recurring payment or autopay setup. True if autopay, false if manual. | Column is_autopay (BOOLEAN) in billing.payment']
  is_disputed boolean [note: 'Indicates whether this payment is currently under dispute or chargeback. True if disputed, false otherwise. | Column is_disputed (BOOLEAN) in billing.payment']
  method_type varchar [note: 'The type of payment instrument used for the transaction. Indicates the financial mechanism (credit card, ACH, wire, check, etc.). [ENUM-REF-CANDIDATE: credit_card|debit_card|ach|wire_transfer|check|cash|paypal|direct_debit — 8 candidates stripped; promote to reference product] | Column method_type (STRING) in billing.payment']
  notes varchar [note: 'Free-text notes or comments about the payment transaction. Used for special instructions, dispute details, or reconciliation notes. | Column notes (STRING) in billing.payment']
  payment_date date [note: 'The date when the payment transaction was initiated or received by the business. Format: yyyy-MM-dd. | Column payment_date (DATE) in billing.payment']
  payment_number varchar [note: 'Externally visible unique payment transaction number used for customer communication and reconciliation. Format: PAY-XXXXXXXX. | Column payment_number (STRING) in billing.payment']
  payment_status varchar [note: 'Current lifecycle status of the payment transaction. Tracks progression from pending through cleared or failed states. [ENUM-REF-CANDIDATE: pending|processing|cleared|failed|reversed|cancelled|refunded — 7 candidates stripped; promote to reference product] | Column payment_status (STRING) in billing.payment']
  payment_timestamp timestamp [note: 'The precise date and time when the payment transaction was processed. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column payment_timestamp (TIMESTAMP) in billing.payment']
  refund_amount decimal(18,2) [note: 'Amount refunded to the customer if payment status is refunded. May be partial or full refund. | Column refund_amount (DECIMAL(18,2)) in billing.payment']
  refund_date date [note: 'Date when the refund was processed and issued to the customer. Format: yyyy-MM-dd. | Column refund_date (DATE) in billing.payment']
  reversal_reason varchar [note: 'Reason for payment reversal if status is reversed. Includes chargeback reason codes and dispute details. | Column reversal_reason (STRING) in billing.payment']
  settlement_date date [note: 'The date when the payment funds were settled and cleared in the business bank account. Format: yyyy-MM-dd. | Column settlement_date (DATE) in billing.payment']
  source varchar [note: 'Type of business relationship generating the payment (subscriber, advertiser, distributor, syndicator, licensee, other). | Column payment_source (STRING) in billing.payment']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.payment']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.payment']
  unapplied_amount decimal(18,2) [note: 'The portion of the payment amount that remains unapplied and is held as credit on the account. Calculated as payment_amount minus applied_amount. | Column unapplied_amount (DECIMAL(18,2)) in billing.payment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.payment']
  updated_timestamp timestamp [note: 'Timestamp when this payment record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column updated_timestamp (TIMESTAMP) in billing.payment']

  Note: 'Record of a payment transaction received or applied against an outstanding invoice or account balance. Captures payment date, amount, currency, payment method type (credit card, ACH, wire, check), payment status (pending, cleared, failed, reversed), PCI DSS tokenized card reference, bank transaction reference, settlement date, and applied invoice linkage. Integrates with Zuora for subscriber payments and SAP S/4HANA for financial posting. SSOT for all inbound monetary receipts. | Unity Catalog table: media_broadcasting_ecm.billing.payment'
}

Table billing.payment_method {
  payment_method_id varchar [pk, note: 'Unique identifier for the payment method record. Primary key. | Column payment_method_id (BIGINT) in billing.payment_method']
  subscriber_id varchar [note: 'Reference to the subscriber or advertiser who owns this payment method. Links to the subscriber master record in Zuora. | Column subscriber_id (BIGINT) in subscriber.payment_method']
  verified_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Payment method verification (especially for high-value advertiser/MVPD accounts) is performed by billing operations staff. Tracking verifier employee supports fraud prevention and compliance with paym | Column verified_by_employee_id (BIGINT) in workforce.payment_method']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.payment_method']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.payment_method']
  bank_account_number_last_four varchar [note: 'The last four digits of the bank account number. Used for customer identification without exposing full account details. Applicable for ACH, SEPA, and wire transfer methods. | Column bank_account_number_last_four (STRING) in billing.payment_method']
  bank_routing_number varchar [note: 'The routing number for ACH or wire transfer payment methods. Stored in masked or tokenized format per PCI DSS requirements. Used for direct debit and electronic funds transfer. | Column bank_routing_number (STRING) in billing.payment_method']
  billing_address_line1 varchar [note: 'The primary street address line associated with the payment method. Used for Address Verification Service (AVS) checks and fraud prevention. | Column billing_address_line1 (STRING) in billing.payment_method']
  billing_address_line2 varchar [note: 'Secondary address line for apartment, suite, or unit number. Optional field for complete billing address capture. | Column billing_address_line2 (STRING) in billing.payment_method']
  billing_city varchar [note: 'The city or municipality of the billing address. Used for AVS verification and tax jurisdiction determination. | Column billing_city (STRING) in billing.payment_method']
  billing_country_code varchar [note: 'Three-letter ISO country code for the billing address. Used for international payment processing and regulatory compliance (e.g., GDPR, PCI DSS regional requirements). | Column billing_country_code (STRING) in billing.payment_method']
  billing_postal_code varchar [note: 'The postal or ZIP code of the billing address. Critical for AVS verification and accurate sales tax calculation. | Column billing_postal_code (STRING) in billing.payment_method']
  billing_state_province varchar [note: 'The state, province, or region of the billing address. Used for AVS verification and regional tax compliance. | Column billing_state_province (STRING) in billing.payment_method']
  card_brand varchar [note: 'The brand or network of the payment card (e.g., Visa, Mastercard, American Express). Applicable only when payment method type is credit or debit card. [ENUM-REF-CANDIDATE: visa|mastercard|amex|discover|jcb|diners_club|unionpay — 7 candidates stripped; promote to reference product] | Column card_brand (STRING) in billing.payment_method']
  cardholder_name varchar [note: 'The name of the individual or entity as it appears on the payment card. Used for billing verification and fraud prevention. | Column cardholder_name (STRING) in billing.payment_method']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.payment_method']
  created_timestamp timestamp [note: 'The date and time when this payment method record was first created in the system. Used for audit trail and payment method age analysis. | Column created_timestamp (TIMESTAMP) in billing.payment_method']
  deactivated_timestamp timestamp [note: 'The date and time when this payment method was deactivated or closed. Null if the payment method is still active. Used for lifecycle tracking and retention analysis. | Column deactivated_timestamp (TIMESTAMP) in billing.payment_method']
  deactivation_reason varchar [note: 'The reason why the payment method was deactivated. Used for churn analysis and process improvement. | Column deactivation_reason (STRING) in billing.payment_method']
  expiry_alert_date date [note: 'The date when the system should trigger an alert to the subscriber about upcoming payment method expiration. Typically set 30-60 days before card expiry to enable proactive customer outreach and reduce involuntary churn. | Column expiry_alert_date (DATE) in billing.payment_method']
  expiry_month varchar [note: 'The month (1-12) when the payment card expires. Used to validate card validity and trigger expiry alerts for subscription renewals. | Column expiry_month (INT) in billing.payment_method']
  expiry_year varchar [note: 'The four-digit year when the payment card expires. Used in conjunction with expiry_month to determine card validity and schedule proactive customer outreach. | Column expiry_year (INT) in billing.payment_method']
  failed_transaction_count varchar [note: 'The cumulative count of failed transaction attempts using this payment method. Used to identify problematic payment methods and trigger dunning workflows. | Column failed_transaction_count (INT) in billing.payment_method']
  gateway_customer_profile_reference varchar [note: 'The unique customer profile identifier in the payment gateway system. Used to link this payment method to the gateway\'s customer vault for secure transaction processing. | Column gateway_customer_profile_reference (STRING) in billing.payment_method']
  gateway_payment_method_reference varchar [note: 'The unique payment method identifier assigned by the payment gateway. Used for transaction processing and reconciliation with gateway records. | Column gateway_payment_method_reference (STRING) in billing.payment_method']
  is_default boolean [note: 'Boolean flag indicating whether this is the default payment method for the subscriber. Used to determine which payment method to charge for recurring subscriptions and invoices. | Column is_default (BOOLEAN) in billing.payment_method']
  last_failure_date date [note: 'The date of the most recent failed transaction attempt. Used in conjunction with failed_transaction_count to manage retry logic and customer communication. | Column last_failure_date (DATE) in billing.payment_method']
  last_failure_reason varchar [note: 'The reason code or message returned by the payment gateway for the most recent failed transaction. Used for troubleshooting and customer support. | Column last_failure_reason (STRING) in billing.payment_method']
  last_four_digits varchar [note: 'The last four digits of the payment card number. Used for customer identification and verification without exposing full card details. PCI DSS permits storage of last four digits. | Column last_four_digits (STRING) in billing.payment_method']
  last_transaction_amount decimal(15,2) [note: 'The amount of the most recent successful transaction in the subscriber\'s billing currency. Used for fraud detection and transaction pattern analysis. | Column last_transaction_amount (DECIMAL(15,2)) in billing.payment_method']
  last_transaction_date date [note: 'The date of the most recent successful transaction using this payment method. Used for payment method activity tracking and dormancy analysis. | Column last_transaction_date (DATE) in billing.payment_method']
  mandate_reference varchar [note: 'The unique reference identifier for the direct debit mandate authorizing recurring payments. Required for SEPA Direct Debit and other regulated direct debit schemes. | Column mandate_reference (STRING) in billing.payment_method']
  mandate_signed_date date [note: 'The date when the customer signed the direct debit mandate. Required for regulatory compliance and dispute resolution in direct debit transactions. | Column mandate_signed_date (DATE) in billing.payment_method']
  modified_by varchar [note: 'The user or system process that last modified this payment method record. Used for audit trail and compliance reporting. | Column modified_by (STRING) in billing.payment_method']
  modified_timestamp timestamp [note: 'The date and time when this payment method record was last modified. Used for audit trail and change tracking. | Column modified_timestamp (TIMESTAMP) in billing.payment_method']
  payment_gateway varchar [note: 'The payment gateway or processor used to tokenize and process transactions for this payment method (e.g., Stripe, Adyen, Braintree, Authorize.Net). Used for routing transactions and reconciliation. | Column payment_gateway (STRING) in billing.payment_method']
  payment_method_status varchar [note: 'The current lifecycle status of the payment method. Determines whether the payment method can be used for new transactions. Inactive or expired methods require customer action to reactivate. | Column payment_method_status (STRING) in billing.payment_method']
  payment_method_type varchar [note: 'The type of payment instrument registered. Indicates the payment mechanism used for billing transactions. [ENUM-REF-CANDIDATE: credit_card|debit_card|ach|sepa|wire_transfer|paypal|apple_pay — 7 candidates stripped; promote to reference product] | Column payment_method_type (STRING) in billing.payment_method']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.payment_method']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.payment_method']
  token varchar [note: 'PCI DSS-compliant tokenized representation of the payment instrument. Never stores raw Primary Account Number (PAN). Used for secure payment processing without exposing sensitive cardholder data. | Column token (STRING) in billing.payment_method']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.payment_method']
  verification_date date [note: 'The date when the payment method was last verified. Used to track verification currency and trigger re-verification workflows. | Column verification_date (DATE) in billing.payment_method']
  verification_status varchar [note: 'The current verification status of the payment method. Indicates whether the payment instrument has been successfully validated through AVS, CVV check, or micro-deposit verification. | Column verification_status (STRING) in billing.payment_method']
  created_by varchar [note: 'The user or system process that created this payment method record. Used for audit trail and compliance reporting. | Column created_by (STRING) in billing.payment_method']

  Note: 'Stored and tokenized payment instrument registered by a subscriber or advertiser for recurring or one-time billing. Captures payment method type (credit card, debit card, ACH, SEPA, wire), PCI DSS-compliant token (never raw PAN), card brand, last four digits, expiry month/year, billing address, bank routing number (masked), mandate reference for direct debit, is_default flag, verification status, and expiry alert date. Managed in Zuora for subscriber billing. | Unity Catalog table: media_broadcasting_ecm.billing.payment_method'
}

Table billing.billing_account {
  billing_account_id varchar [pk, note: 'Unique identifier for the billing account. Primary key for the billing account entity. | Column billing_account_id (BIGINT) in billing.billing_account']
  billing_cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: Billing account belongs to ONE billing cycle schedule (monthly, quarterly, annual). Currently stores billing_cycle_code as STRING; need FK to cycle table for full cycle configuration. Remove billing_c | Column billing_cycle_id (BIGINT) in billing.billing_account']
  default_communication_template_id varchar [note: 'Foreign key linking to billing.communication_template. Business justification: Billing account can have ONE default communication template for invoice delivery (customer preference). Need FK to track account-level communication preferences. No redundant columns to remove. | Column default_communication_template_id (BIGINT) in billing.billing_account']
  default_payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: Billing account has ONE default payment method for auto-pay and recurring charges. Currently only stores payment_method_type as STRING; need FK to the actual payment_method record. Remove default_paym | Column default_payment_method_id (BIGINT) in billing.billing_account']
  manager_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Large broadcast accounts (MVPDs, major advertisers, syndication partners) have dedicated account managers from sales or client services. Tracking account manager is critical for relationship managemen | Column manager_employee_id (BIGINT) in workforce.billing_account']
  sales_account_id varchar [note: 'FK to sales account for CRM linkage | Column sales_account_id (BIGINT) in sales.billing_account']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.billing_account']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.billing_account']
  account_name varchar [note: 'Legal or business name associated with the billing account. For subscriber accounts, this is the account holder name; for corporate accounts, this is the registered business name. | Column account_name (STRING) in billing.billing_account']
  account_number varchar [note: 'Externally-visible unique account number assigned to the billing account. Used on invoices, statements, and customer correspondence. | Column account_number (STRING) in billing.billing_account']
  account_status varchar [note: 'Current lifecycle status of the billing account. Active accounts are in good standing and can transact; suspended accounts have temporary holds due to payment issues or policy violations; closed accounts are permanently terminated; pending activation accounts are awaiting initial setup completion; delinquent accounts have overdue balances and may face service interruption; write-off accounts have uncollectible balances removed from active receivables. | Column account_status (STRING) in billing.billing_account']
  account_type varchar [note: 'Classification of the billing account based on the nature of the billable relationship. Subscriber accounts are for SVOD/AVOD/TVOD end-users; advertiser accounts are for agencies and direct advertisers; MVPD accounts are for multichannel video programming distributors paying carriage fees; syndication licensee accounts are for content resale partners; production vendor accounts are for production service providers; talent accounts are for residuals and royalty payments. | Column account_type (STRING) in billing.billing_account']
  auto_pay_enabled_flag boolean [note: 'Indicates whether automatic payment processing is enabled for this account. When true, invoices are automatically charged to the default payment method on the due date. | Column auto_pay_enabled_flag (BOOLEAN) in billing.billing_account']
  billing_address_line1 varchar [note: 'Primary street address line for billing correspondence and invoice delivery. | Column billing_address_line1 (STRING) in billing.billing_account']
  billing_address_line2 varchar [note: 'Secondary address line for apartment, suite, or unit number. | Column billing_address_line2 (STRING) in billing.billing_account']
  billing_city varchar [note: 'City or municipality for the billing address. | Column billing_city (STRING) in billing.billing_account']
  billing_country_code varchar [note: 'Three-letter ISO country code for the billing address (e.g., USA, GBR, CAN). | Column billing_country_code (STRING) in billing.billing_account']
  billing_currency_code varchar [note: 'Three-letter ISO currency code in which this account is billed (e.g., USD, GBP, EUR). All invoices and payments for this account are denominated in this currency. | Column billing_currency_code (STRING) in billing.billing_account']
  billing_cycle_day varchar [note: 'Day of the month (1-31) on which recurring invoices are generated for monthly billing cycles. Null for non-monthly cycles. | Column billing_cycle_day (INT) in billing.billing_account']
  billing_postal_code varchar [note: 'Postal or ZIP code for the billing address. | Column billing_postal_code (STRING) in billing.billing_account']
  billing_state_province varchar [note: 'State, province, or region for the billing address. | Column billing_state_province (STRING) in billing.billing_account']
  closed_date date [note: 'Date on which this billing account was permanently closed. Null for active and suspended accounts. | Column closed_date (DATE) in billing.billing_account']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.billing_account']
  created_timestamp timestamp [note: 'Timestamp when this billing account record was first created in the system. | Column created_timestamp (TIMESTAMP) in billing.billing_account']
  credit_limit_amount decimal(15,2) [note: 'Maximum outstanding balance allowed for this account before credit hold is applied. Null indicates no credit limit (cash-in-advance or unlimited credit). | Column credit_limit_amount (DECIMAL(15,2)) in billing.billing_account']
  current_balance_amount decimal(15,2) [note: 'Current outstanding balance on the account, calculated as sum of unpaid invoices minus unapplied credits and payments. Positive values indicate amounts owed to the business; negative values indicate credit balances owed to the customer. | Column current_balance_amount (DECIMAL(15,2)) in billing.billing_account']
  dunning_level varchar [note: 'Current stage in the collections escalation process for overdue accounts. 0 indicates no dunning (account current); higher values indicate progressive escalation steps (e.g., 1=reminder notice, 2=warning, 3=service suspension notice, 4=final notice before write-off). | Column dunning_level (INT) in billing.billing_account']
  invoice_delivery_method varchar [note: 'Preferred method for delivering invoices to this account. Email sends PDF invoices; postal mail sends printed invoices; electronic portal makes invoices available for download in customer self-service portal; EDI transmits invoices via Electronic Data Interchange (X12 810 or EDIFACT INVOIC). | Column invoice_delivery_method (STRING) in billing.billing_account']
  last_dunning_date date [note: 'Date of the most recent dunning notice or collections contact sent to this account. | Column last_dunning_date (DATE) in billing.billing_account']
  last_invoice_date date [note: 'Date of the most recent invoice generated for this account. Used for billing cycle tracking and account activity monitoring. | Column last_invoice_date (DATE) in billing.billing_account']
  last_payment_amount decimal(15,2) [note: 'Amount of the most recent payment received. Used for payment pattern analysis. | Column last_payment_amount (DECIMAL(15,2)) in billing.billing_account']
  last_payment_date date [note: 'Date of the most recent payment received and applied to this account. Used for payment behavior analysis and credit risk assessment. | Column last_payment_date (DATE) in billing.billing_account']
  opened_date date [note: 'Date on which this billing account was first established and activated. | Column opened_date (DATE) in billing.billing_account']
  payment_terms_days varchar [note: 'Number of days from invoice date within which payment is due. Common values are 0 (immediate), 15, 30, 60, or 90 days. Used to calculate invoice due dates and aging buckets. | Column payment_terms_days (INT) in billing.billing_account']
  primary_contact_email varchar [note: 'Email address of the primary billing contact. Used for invoice delivery, payment reminders, and billing notifications. | Column primary_contact_email (STRING) in billing.billing_account']
  primary_contact_name varchar [note: 'Name of the primary billing contact or accounts payable representative for this account. Used for billing inquiries and dispute resolution. | Column primary_contact_name (STRING) in billing.billing_account']
  primary_contact_phone varchar [note: 'Phone number of the primary billing contact. Used for urgent billing inquiries and collections calls. | Column primary_contact_phone (STRING) in billing.billing_account']
  sap_customer_account_number varchar [note: 'Customer master record number in SAP S/4HANA Financial Accounting (FI) module. Used for GL posting, accounts receivable management, and financial reconciliation. This is the authoritative financial system identifier. | Column sap_customer_account_number (STRING) in billing.billing_account']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.billing_account']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.billing_account']
  tax_exempt_flag boolean [note: 'Indicates whether this account is exempt from sales tax, VAT, or other consumption taxes. True for tax-exempt organizations (e.g., non-profits, government entities, resellers with valid exemption certificates); false for standard taxable accounts. | Column tax_exempt_flag (BOOLEAN) in billing.billing_account']
  tax_exemption_certificate_number varchar [note: 'Government-issued certificate or registration number authorizing tax exemption. Required for audit trail when tax_exempt_flag is true. | Column tax_exemption_certificate_number (STRING) in billing.billing_account']
  tax_exemption_expiry_date date [note: 'Date on which the tax exemption certificate expires and must be renewed. Null for permanent exemptions. | Column tax_exemption_expiry_date (DATE) in billing.billing_account']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.billing_account']
  updated_timestamp timestamp [note: 'Timestamp when this billing account record was last modified. | Column updated_timestamp (TIMESTAMP) in billing.billing_account']
  wideorbit_account_reference varchar [note: 'Account identifier in WideOrbit traffic and billing system. Used for advertising sales order management, spot scheduling, and ad billing for advertiser and agency accounts. | Column wideorbit_account_reference (STRING) in billing.billing_account']
  zuora_account_reference varchar [note: 'Account identifier in Zuora subscription billing platform. Used for subscription lifecycle management, recurring billing, and revenue recognition for SVOD/AVOD subscriber accounts. | Column zuora_account_reference (STRING) in billing.billing_account']

  Note: 'Billing-domain representation of a billable entity — a subscriber household, an advertising agency account, an MVPD operator, or a syndication licensee. Distinct from the subscriber or advertiser master record in their respective domains; this entity owns the financial relationship: billing address, billing currency, payment terms, credit limit, account balance, billing cycle assignment, tax exemption status, dunning level, and SAP customer account number. SSOT for the financial account identity within billing. | Unity Catalog table: media_broadcasting_ecm.billing.billing_account'
}

Table billing.cycle {
  cycle_id varchar [pk, note: 'Primary key for cycle | Column cycle_id (BIGINT) in billing.cycle']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.cycle']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.cycle']
  auto_renew_enabled boolean [note: 'Indicates whether subscriptions on this billing cycle automatically renew at the end of the term. True enables automatic renewal in Zuora subscription management. | Column auto_renew_enabled (BOOLEAN) in billing.cycle']
  billing_period_end_day varchar [note: 'Day of the month (1-31) when the service period covered by the invoice ends. Used to calculate service period duration for revenue recognition. Null for non-monthly frequencies. | Column billing_period_end_day (INT) in billing.cycle']
  billing_period_start_day varchar [note: 'Day of the month (1-31) when the service period covered by the invoice begins. May differ from cycle_day for advance billing scenarios. Null for non-monthly frequencies. | Column billing_period_start_day (INT) in billing.cycle']
  billing_run_day_offset varchar [note: 'Number of days before or after the cycle day when the billing run executes. Positive values indicate days after cycle day; negative values indicate days before. Used to schedule invoice generation in advance of service period. | Column billing_run_day_offset (INT) in billing.cycle']
  billing_timing varchar [note: 'Indicates whether billing occurs in advance (invoice before service period) or in arrears (invoice after service period). Critical for revenue recognition under ASC 606. | Column billing_timing (STRING) in billing.cycle']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.cycle']
  created_by_user varchar [note: 'User identifier or system account that created this billing cycle configuration. Used for audit trail and accountability under SOX compliance requirements. | Column created_by_user (STRING) in billing.cycle']
  created_timestamp timestamp [note: 'Timestamp when this billing cycle configuration record was first created in the system. Audit trail field for data governance. | Column created_timestamp (TIMESTAMP) in billing.cycle']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for invoices generated under this billing cycle (e.g., USD, GBP, EUR). All charges in the cycle are denominated in this currency. | Column currency_code (STRING) in billing.cycle']
  cycle_code varchar [note: 'Business identifier code for the billing cycle (e.g., MONTHLY_01, QUARTERLY_Q1, ANNUAL_FY). Used in Zuora subscription billing engine for cycle identification. | Column cycle_code (STRING) in billing.cycle']
  cycle_description varchar [note: 'Detailed description of the billing cycle configuration, including business rules, special handling instructions, and usage notes for billing operations team. | Column cycle_description (STRING) in billing.cycle']
  cycle_name varchar [note: 'Human-readable name of the billing cycle (e.g., Monthly Standard, Quarterly Advance, Annual Arrears). | Column cycle_name (STRING) in billing.cycle']
  cycle_status varchar [note: 'Current lifecycle status of the billing cycle configuration. Active cycles are available for new subscriptions; inactive cycles are closed to new assignments but continue for existing subscribers; deprecated cycles are phased out; pending cycles are configured but not yet live. | Column cycle_status (STRING) in billing.cycle']
  cycle_type varchar [note: 'Classification of the billing cycle by revenue stream: subscription (SVOD/AVOD subscriber billing), advertising (ad campaign billing via Wide Orbit), carriage (MVPD/vMVPD distribution fees), syndication (content licensing fees), usage (pay-per-view/TVOD), or custom (non-standard arrangements). | Column cycle_type (STRING) in billing.cycle']
  day varchar [note: 'Day of the month (1-31) when the billing cycle starts or billing run executes. For monthly cycles, this is the anchor date. Null for non-monthly frequencies. | Column day (INT) in billing.cycle']
  effective_end_date date [note: 'Date when this billing cycle configuration is retired and no longer available for new assignments. Null for currently active cycles with no planned end date. | Column effective_end_date (DATE) in billing.cycle']
  effective_start_date date [note: 'Date when this billing cycle configuration becomes active and available for assignment to billing accounts or product plans. | Column effective_start_date (DATE) in billing.cycle']
  frequency varchar [note: 'Recurrence interval for invoice generation: daily, weekly, biweekly, monthly, quarterly, semiannual, annual, or custom. Determines how often billing runs execute in Zuora. [ENUM-REF-CANDIDATE: daily|weekly|biweekly|monthly|quarterly|semiannual|annual|custom — 8 candidates stripped; promote to reference product] | Column frequency (STRING) in billing.cycle']
  gl_account_code varchar [note: 'General ledger account code in SAP S/4HANA where revenue from this billing cycle is posted. Used for financial reconciliation and reporting. | Column gl_account_code (STRING) in billing.cycle']
  grace_period_days varchar [note: 'Number of days after payment due date before late fees or service suspension actions are triggered. Provides customer buffer for payment processing delays. | Column grace_period_days (INT) in billing.cycle']
  invoice_generation_day varchar [note: 'Specific day of the month (1-31) when invoices are generated for this cycle. Calculated from cycle_day and billing_run_day_offset. Null for non-monthly frequencies. | Column invoice_generation_day (INT) in billing.cycle']
  last_billing_date date [note: 'Most recent date when a billing run was successfully completed for this cycle. Null if no billing run has occurred yet. | Column last_billing_date (DATE) in billing.cycle']
  modified_by_user varchar [note: 'User identifier or system account that last modified this billing cycle configuration. Used for audit trail and accountability under SOX compliance requirements. | Column modified_by_user (STRING) in billing.cycle']
  modified_timestamp timestamp [note: 'Timestamp when this billing cycle configuration record was last updated. Audit trail field for change tracking and data governance. | Column modified_timestamp (TIMESTAMP) in billing.cycle']
  next_billing_date date [note: 'Next date when a billing run will execute for accounts assigned to this cycle. Updated after each billing run completion. Used by Zuora billing engine for scheduling. | Column next_billing_date (DATE) in billing.cycle']
  payment_due_days varchar [note: 'Number of days after invoice generation when payment is due. Used to calculate invoice due date. Standard terms are Net 30, Net 15, or immediate (0 days). | Column payment_due_days (INT) in billing.cycle']
  proration_enabled boolean [note: 'Indicates whether partial-period charges are prorated when subscription starts/ends mid-cycle. True enables proration calculation in Zuora. | Column proration_enabled (BOOLEAN) in billing.cycle']
  proration_method varchar [note: 'Method for calculating prorated charges: daily (per-day calculation), monthly (per-month calculation), or none (no proration). Used when proration_enabled is true. | Column proration_method (STRING) in billing.cycle']
  renewal_notice_days varchar [note: 'Number of days before cycle renewal when customer notification is sent. Used for auto-renew reminders and cancellation windows. Null if auto_renew_enabled is false. | Column renewal_notice_days (INT) in billing.cycle']
  revenue_recognition_rule varchar [note: 'Code identifying the ASC 606 revenue recognition rule applied to invoices generated under this cycle. Determines how revenue is recognized over time (e.g., straight-line, milestone-based). Maps to SAP S/4HANA revenue recognition configuration. | Column revenue_recognition_rule (STRING) in billing.cycle']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.cycle']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.cycle']
  tax_calculation_enabled boolean [note: 'Indicates whether automatic tax calculation is enabled for invoices generated under this cycle. True triggers tax engine integration (e.g., Avalara, Vertex) during invoice generation. | Column tax_calculation_enabled (BOOLEAN) in billing.cycle']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.cycle']

  Note: 'Defines the recurring billing schedule configuration for a billing account or product plan — monthly, quarterly, annual, or custom. Captures cycle name, frequency, cycle start day, billing run date, proration rules, advance vs. arrears billing flag, next bill date, and last bill date. Used by Zuora subscription billing engine to trigger invoice generation. Reference entity that governs when invoices are produced for each account. | Unity Catalog table: media_broadcasting_ecm.billing.cycle'
}

Table billing.subscription_invoice {
  subscription_invoice_id varchar [pk, note: 'Unique identifier for the subscription invoice record. Primary key for this entity. | Column subscription_invoice_id (BIGINT) in billing.subscription_invoice']
  billing_account_id varchar [note: 'External billing account identifier from Zuora. Used for multi-subscription account consolidation and billing hierarchy management. | Column billing_account_id (BIGINT) in billing.subscription_invoice']
  billing_cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: Subscription invoice follows ONE billing cycle schedule. Currently stores billing_cycle as STRING; need FK to cycle table for full cycle configuration. Remove billing_cycle string as it can be retriev | Column billing_cycle_id (BIGINT) in billing.subscription_invoice']
  processed_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Subscription billing runs are executed by billing operations staff. Tracking which employee processed each subscription invoice batch supports operational oversight, error resolution, and performance  | Column processed_by_employee_id (BIGINT) in workforce.subscription_invoice']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Subscription invoices need revenue stream classification for deferred revenue tracking, ASC 606 compliance, and subscription revenue reporting distinct from advertising. Essential for streaming platfo | Column revenue_stream_id (BIGINT) in finance.subscription_invoice']
  run_id varchar [note: 'Foreign key linking to billing.run. Business justification: Subscription invoice is generated by ONE billing run. Need to track which batch execution generated this subscription invoice for operational audit trail. No redundant columns to remove. | Column run_id (BIGINT) in billing.subscription_invoice']
  subscriber_id varchar [note: 'Reference to the subscriber (customer/account holder) who is billed by this invoice. | Column subscriber_id (BIGINT) in subscriber.subscription_invoice']
  subscription_id varchar [note: 'Reference to the parent subscription account that this invoice bills. Links to the subscription master record. | Column subscription_id (BIGINT) in subscriber.subscription_invoice']
  zuora_invoice_id varchar [note: 'Native invoice identifier from Zuora subscription billing system. Used for system reconciliation and API integration. | Column zuora_invoice_id (BIGINT) in billing.subscription_invoice']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.subscription_invoice']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.subscription_invoice']
  amount_paid decimal(15,2) [note: 'Total amount paid by subscriber against this invoice to date. Used to calculate outstanding balance and track partial payments. | Column amount_paid (DECIMAL(15,2)) in billing.subscription_invoice']
  auto_pay_enabled boolean [note: 'Indicates whether automatic payment processing is enabled for this invoice. True means payment will be attempted automatically on due date. | Column auto_pay_enabled (BOOLEAN) in billing.subscription_invoice']
  balance_due decimal(15,2) [note: 'Outstanding amount remaining to be paid on this invoice. Calculated as total_amount minus amount_paid. | Column balance_due (DECIMAL(15,2)) in billing.subscription_invoice']
  churn_risk_flag boolean [note: 'Indicates whether the subscriber was flagged as high churn risk at the time of invoice generation. Used for retention campaign targeting and revenue forecasting. | Column churn_risk_flag (BOOLEAN) in billing.subscription_invoice']
  churn_risk_score decimal(5,2) [note: 'Predictive churn probability score (0-100) calculated at invoice generation time. Higher scores indicate greater likelihood of cancellation. | Column churn_risk_score (DECIMAL(5,2)) in billing.subscription_invoice']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.subscription_invoice']
  created_timestamp timestamp [note: 'Date and time when this invoice record was first created in the billing system. Audit field for record lifecycle tracking. | Column created_timestamp (TIMESTAMP) in billing.subscription_invoice']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this invoice (e.g., USD, EUR, GBP). | Column currency_code (STRING) in billing.subscription_invoice']
  due_date date [note: 'Date by which payment is expected from the subscriber. Calculated based on invoice date plus payment terms. | Column due_date (DATE) in billing.subscription_invoice']
  invoice_delivery_method varchar [note: 'Method by which the invoice is delivered to the subscriber. Determines communication channel and delivery tracking requirements. | Column invoice_delivery_method (STRING) in billing.subscription_invoice']
  paid_timestamp timestamp [note: 'Date and time when the invoice was fully paid by the subscriber. Null if invoice is unpaid or partially paid. | Column paid_timestamp (TIMESTAMP) in billing.subscription_invoice']
  payment_gateway varchar [note: 'Name of the payment gateway or processor used for this invoice (e.g., Stripe, Adyen, Braintree). Used for reconciliation and troubleshooting. | Column payment_gateway (STRING) in billing.subscription_invoice']
  payment_method_type varchar [note: 'Type of payment instrument on file for this subscription. Indicates how the subscriber will be charged. | Column payment_method_type (STRING) in billing.subscription_invoice']
  posted_timestamp timestamp [note: 'Date and time when the invoice was posted (finalized and made available to subscriber). Marks transition from draft to official invoice. | Column posted_timestamp (TIMESTAMP) in billing.subscription_invoice']
  promotional_discount_amount decimal(15,2) [note: 'Total discount amount applied from promotional campaigns, coupon codes, or special offers. Reduces the net amount due. | Column promotional_discount_amount (DECIMAL(15,2)) in billing.subscription_invoice']
  promotional_discount_code varchar [note: 'Coupon or promotion code applied to this invoice. Used for marketing campaign tracking and discount attribution analysis. | Column promotional_discount_code (STRING) in billing.subscription_invoice']
  proration_amount decimal(15,2) [note: 'Adjustment amount for partial billing periods due to mid-cycle subscription changes, upgrades, downgrades, or cancellations. Can be positive or negative. | Column proration_amount (DECIMAL(15,2)) in billing.subscription_invoice']
  renewal_type varchar [note: 'Indicates whether this invoice represents an automatic renewal, manual renewal, trial-to-paid conversion, plan upgrade, or plan downgrade. | Column renewal_type (STRING) in billing.subscription_invoice']
  revenue_recognition_date date [note: 'Date on which revenue from this invoice was or will be recognized in financial statements per ASC 606 rules. | Column revenue_recognition_date (DATE) in billing.subscription_invoice']
  revenue_recognition_status varchar [note: 'Current status of revenue recognition for this invoice under ASC 606 accounting standards. Tracks whether revenue has been recognized in financial statements. | Column revenue_recognition_status (STRING) in billing.subscription_invoice']
  service_period_end_date date [note: 'Last date of the subscription service period covered by this invoice. Defines the performance obligation delivery window. | Column service_period_end_date (DATE) in billing.subscription_invoice']
  service_period_start_date date [note: 'First date of the subscription service period covered by this invoice. Critical for ASC 606 revenue recognition and proration calculations. | Column service_period_start_date (DATE) in billing.subscription_invoice']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.subscription_invoice']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.subscription_invoice']
  subscription_plan_name varchar [note: 'Name of the subscription plan being billed (e.g., Premium Monthly, Basic Annual, Sports Bundle). Identifies the service tier and feature set. | Column subscription_plan_name (STRING) in billing.subscription_invoice']
  subscription_type varchar [note: 'Classification of subscription model: SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), or bundled offering. | Column subscription_type (STRING) in billing.subscription_invoice']
  subtotal_amount decimal(15,2) [note: 'Base subscription charge amount before taxes, fees, discounts, and credits. Represents the gross recurring revenue component. | Column subtotal_amount (DECIMAL(15,2)) in billing.subscription_invoice']
  tax_amount decimal(15,2) [note: 'Total tax amount applied to this invoice based on subscriber location and applicable tax jurisdictions. Includes sales tax, VAT, GST as applicable. | Column tax_amount (DECIMAL(15,2)) in billing.subscription_invoice']
  total_amount decimal(15,2) [note: 'Final net amount due from subscriber after all charges, prorations, credits, discounts, and taxes. This is the amount the subscriber must pay. | Column total_amount (DECIMAL(15,2)) in billing.subscription_invoice']
  trial_period_credit decimal(15,2) [note: 'Credit amount applied for free trial period. Typically offsets the full subscription charge during trial, resulting in zero net amount due. | Column trial_period_credit (DECIMAL(15,2)) in billing.subscription_invoice']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.subscription_invoice']
  updated_timestamp timestamp [note: 'Date and time when this invoice record was last modified. Audit field for change tracking and data lineage. | Column updated_timestamp (TIMESTAMP) in billing.subscription_invoice']

  Note: 'Specialized invoice record for SVOD, AVOD, TVOD, and bundled subscription billing generated through Zuora. Extends the core invoice with subscription-specific attributes: subscription plan name, service period start/end, proration amount, trial period credit, promotional discount code, renewal type (auto-renew vs. manual), churn risk flag at time of billing, and Zuora invoice ID for system reconciliation. Supports ASC 606 revenue recognition for subscription revenue streams. | Unity Catalog table: media_broadcasting_ecm.billing.subscription_invoice'
}

Table billing.ad_billing_order {
  ad_billing_order_id varchar [pk, note: 'Unique identifier for the advertising billing order record. Primary key for this entity. | Column ad_billing_order_id (BIGINT) in billing.ad_billing_order']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Ad billing orders must link directly to source ad_order for order-to-invoice reconciliation, payment application, and revenue recognition. Critical for billing cycle processing and dispute resolution  | Column ad_order_id (BIGINT) in sales.ad_billing_order']
  advertiser_id varchar [note: 'Reference to the advertiser organization that purchased the advertising inventory. | Column advertiser_id (BIGINT) in sales.ad_billing_order']
  agency_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Ad sales in broadcasting involve agency partners as intermediaries for commission splits, co-op advertising budgets, and consolidated billing. Agency relationship management requires partner domain li | Column agency_partner_id (BIGINT) in partner.ad_billing_order']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Ad billing order is billed to ONE billing account (advertiser or agency account). Advertisers and agencies have billing accounts in the billing domain. Need FK to link ad orders to their billing accou | Column billing_account_id (BIGINT) in billing.ad_billing_order']
  billing_contact_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Ad orders have designated billing contacts within the broadcaster\'s billing team who coordinate with agencies on discrepancies, makegoods, and payment issues. Tracking billing contact employee is oper | Column billing_contact_employee_id (BIGINT) in workforce.ad_billing_order']
  billing_dispute_id varchar [note: 'Foreign key linking to billing.billing_dispute. Business justification: Ad billing order can have ONE formal billing dispute raised against it. Currently stores dispute_reason and dispute_date as STRING/DATE; need FK to the formal billing_dispute record for full dispute l | Column billing_dispute_id (BIGINT) in billing.ad_billing_order']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Ad campaigns specify broadcast facilities for geographic targeting, signal coverage verification, local vs. national spot differentiation, and delivery confirmation required in advertising sales and b | Column broadcast_facility_id (BIGINT) in technology.ad_billing_order']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Ad orders are sold against specific licensed stations. Revenue reporting, license renewal applications, and FCC ownership attribution rules require station-level revenue attribution for each order. | Column broadcast_license_id (BIGINT) in compliance.ad_billing_order']
  campaign_id varchar [note: 'Reference to the advertising campaign associated with this billing order. | Column campaign_id (BIGINT) in sales.ad_billing_order']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Ad orders attributed to sales team or channel cost centers for sales performance tracking, cost allocation, and departmental P&L. Enables media orgs to track advertising revenue against sales team cos | Column cost_center_id (BIGINT) in finance.ad_billing_order']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Ad orders specify the guaranteed target demographic for pricing, rate card application, and delivery measurement. Determines CPM/CPRP rates and is contractually binding for makegood triggers. Core ele | Column demographic_segment_id (BIGINT) in audience.ad_billing_order']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Ad billing order results in ONE invoice (the formal billing document). Currently stores invoice_number and invoice_date as STRING/DATE; need FK to the master invoice record. Remove invoice_number and  | Column invoice_id (BIGINT) in billing.ad_billing_order']
  political_ad_record_id varchar [note: 'Foreign key linking to compliance.political_ad_record. Business justification: FCC requires broadcasters to maintain public inspection files linking political ad orders to disclosure records (candidate name, rate, air dates). Essential for reasonable access and equal time compli | Column political_ad_record_id (BIGINT) in compliance.ad_billing_order']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Ad orders must be attributed to profit centers (channels, platforms) for advertising revenue segment reporting and business unit P&L. Essential for media broadcasters tracking advertising performance  | Column profit_center_id (BIGINT) in finance.ad_billing_order']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Ad orders must classify revenue by stream (linear TV, digital, programmatic) for revenue recognition, sales commission calculation, and advertising revenue reporting. Critical for media broadcasters w | Column revenue_stream_id (BIGINT) in finance.ad_billing_order']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser, if applicable. | Column sales_agency_id (BIGINT) in sales.ad_billing_order']
  sales_rep_id varchar [note: 'Reference to the sales representative who closed this advertising order. | Column sales_rep_id (BIGINT) in sales.ad_billing_order']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Ad orders specify transmission equipment for spot delivery scheduling, makegoods tracking when equipment fails, affidavit generation, and proof-of-performance documentation required by advertisers in  | Column transmission_equipment_id (BIGINT) in technology.ad_billing_order']
  upfront_deal_id varchar [note: 'Foreign key linking to sales.upfront_deal. Business justification: Upfront orders must link to parent deal for commitment tracking, pricing validation, audience guarantee monitoring, and upfront vs. scatter revenue classification in media sales. | Column upfront_deal_id (BIGINT) in sales.ad_billing_order']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.ad_billing_order']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.ad_billing_order']
  affidavit_status varchar [note: 'Status of proof-of-broadcast affidavit documentation for this order. Affidavits provide legal confirmation that contracted spots aired as scheduled. | Column affidavit_status (STRING) in billing.ad_billing_order']
  billed_amount decimal(18,2) [note: 'Total amount invoiced to the advertiser or agency for this order, including any adjustments or makegoods. | Column billed_amount (DECIMAL(18,2)) in billing.ad_billing_order']
  billing_status varchar [note: 'Current status of the billing order in the revenue cycle. Tracks progression from unbilled inventory through invoicing, payment, and dispute resolution. | Column billing_status (STRING) in billing.ad_billing_order']
  contracted_amount decimal(18,2) [note: 'Total contracted revenue amount for the advertising order as agreed in the sales contract, before any makegoods or adjustments. | Column contracted_amount (DECIMAL(18,2)) in billing.ad_billing_order']
  cpm_rate decimal(10,2) [note: 'Cost per thousand impressions rate applied to this order, if CPM pricing is used. | Column cpm_rate (DECIMAL(10,2)) in billing.ad_billing_order']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.ad_billing_order']
  created_timestamp timestamp [note: 'Timestamp when this billing order record was first created in the system. | Column created_timestamp (TIMESTAMP) in billing.ad_billing_order']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this billing order. | Column currency_code (STRING) in billing.ad_billing_order']
  daypart_breakdown varchar [note: 'Distribution of advertising spots across broadcast dayparts (time segments of the broadcast day such as Prime Time, Early Morning, Late Night). Stored as structured text or JSON showing spot count and value per daypart. | Column daypart_breakdown (STRING) in billing.ad_billing_order']
  flight_end_date date [note: 'The last date on which advertising spots for this order were scheduled to air. Defines the end of the campaign flight period. | Column flight_end_date (DATE) in billing.ad_billing_order']
  flight_start_date date [note: 'The first date on which advertising spots for this order were scheduled to air. Defines the beginning of the campaign flight period. | Column flight_start_date (DATE) in billing.ad_billing_order']
  grp_rate decimal(10,2) [note: 'Cost per gross rating point applied to this order, if GRP pricing is used. | Column grp_rate (DECIMAL(10,2)) in billing.ad_billing_order']
  isci_codes varchar [note: 'Comma-separated list of ISCI codes identifying the specific commercial creative assets that aired as part of this order. ISCI is the industry standard for uniquely identifying TV commercials. | Column isci_codes (STRING) in billing.ad_billing_order']
  makegoods_value decimal(18,2) [note: 'Total value of compensatory ad spots provided to the advertiser due to underdelivery, technical issues, or audience guarantee shortfalls. | Column makegoods_value (DECIMAL(18,2)) in billing.ad_billing_order']
  notes varchar [note: 'Free-form text field for additional comments, special instructions, or contextual information about this billing order. | Column notes (STRING) in billing.ad_billing_order']
  order_date date [note: 'The date on which the advertising order was placed or finalized in the traffic system. | Column order_date (DATE) in billing.ad_billing_order']
  outstanding_amount decimal(18,2) [note: 'Remaining unpaid balance on this billing order, calculated as billed amount minus paid amount. | Column outstanding_amount (DECIMAL(18,2)) in billing.ad_billing_order']
  paid_amount decimal(18,2) [note: 'Total amount received in payment from the advertiser or agency against this billing order. | Column paid_amount (DECIMAL(18,2)) in billing.ad_billing_order']
  payment_due_date date [note: 'Date by which payment is contractually due from the advertiser or agency. | Column payment_due_date (DATE) in billing.ad_billing_order']
  payment_terms varchar [note: 'Contractual payment terms defining when payment is due (e.g., Net 30 = payment due 30 days after invoice date). | Column payment_terms (STRING) in billing.ad_billing_order']
  rate_basis varchar [note: 'Pricing model used for this advertising order. CPM (Cost Per Mille) = cost per thousand impressions, GRP (Gross Rating Point) = reach × frequency, CPRP (Cost Per Rating Point) = cost per single rating point, flat rate = fixed campaign price, cost per spot = per-unit pricing. | Column rate_basis (STRING) in billing.ad_billing_order']
  revenue_recognition_date date [note: 'Date on which revenue from this order is recognized in financial statements, per ASC 606 revenue recognition standards. | Column revenue_recognition_date (DATE) in billing.ad_billing_order']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in billing.ad_billing_order']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in billing.ad_billing_order']
  total_spots_aired varchar [note: 'Total number of advertising spots that successfully aired as confirmed by affidavits and playout logs. | Column total_spots_aired (INT) in billing.ad_billing_order']
  total_spots_ordered varchar [note: 'Total number of advertising spots (commercial units) contracted in this order. | Column total_spots_ordered (INT) in billing.ad_billing_order']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in billing.ad_billing_order']
  updated_timestamp timestamp [note: 'Timestamp when this billing order record was last modified. | Column updated_timestamp (TIMESTAMP) in billing.ad_billing_order']
  wide_orbit_order_reference varchar [note: 'External order identifier from the Wide Orbit traffic and billing system. Business key linking this billing record to the source ad sales order. | Column wide_orbit_order_reference (STRING) in billing.ad_billing_order']

  Note: 'Advertising billing record derived from Wide Orbit traffic system representing a finalized ad sales order ready for invoicing. Captures Wide Orbit order ID, advertiser name, agency name, campaign flight dates, total contracted amount, makegoods value, affidavit status, ISCI codes for aired spots, daypart breakdown, CPM/GRP rate basis, and billing status (unbilled, invoiced, paid, disputed). Links advertising campaign execution to the financial billing process. | Unity Catalog table: media_broadcasting_ecm.billing.ad_billing_order'
}

Table billing.billing_carriage_fee_invoice {
  billing_carriage_fee_invoice_id varchar [pk, note: 'Unique identifier for the carriage fee invoice issued to MVPDs and vMVPDs. Primary key for this transaction header entity. | Column billing_carriage_fee_invoice_id (BIGINT) in billing.billing_carriage_fee_invoice']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Carriage fee invoice is billed to ONE billing account (MVPD or vMVPD account). Distribution partners have billing accounts in the billing domain. Need FK to link carriage fee invoices to their billing | Column billing_account_id (BIGINT) in billing.billing_carriage_fee_invoice']
  billing_dispute_id varchar [note: 'Foreign key linking to billing.billing_dispute. Business justification: Carriage fee invoice can have ONE formal billing dispute raised against it (common in retransmission consent negotiations). Need FK to formal billing_dispute record for dispute lifecycle tracking. No  | Column billing_dispute_id (BIGINT) in billing.billing_carriage_fee_invoice']
  carriage_agreement_id varchar [note: 'Reference to the underlying retransmission consent or must-carry agreement governing this invoice. | Column carriage_agreement_id (BIGINT) in distribution.billing_carriage_fee_invoice']
