    rdfs:comment 'Type of supplemental data source used to capture additional diagnoses for risk adjustment.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskProfileLastUpdatedDate rdf:type rdf:Property ;
