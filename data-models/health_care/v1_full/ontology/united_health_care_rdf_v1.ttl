ind:blackBoxWarningText rdf:type rdf:Property ;
    rdfs:label 'Black Box Warning Text' ;
    rdfs:comment 'The text of the FDA black box warning associated with the specialty drug, if applicable.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contraindications rdf:type rdf:Property ;
    rdfs:label 'Contraindications' ;
    rdfs:comment 'Medical conditions or situations in which the specialty drug should not be used due to risk of harm.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugInteractions rdf:type rdf:Property ;
    rdfs:label 'Drug Interactions' ;
    rdfs:comment 'Known significant drug-drug interactions that may occur when the specialty drug is used concurrently with other medications.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pregnancyLactationLabeling rdf:type rdf:Property ;
    rdfs:label 'Pregnancy Lactation Labeling' ;
    rdfs:comment 'Current FDA pregnancy and lactation labeling information for the specialty drug under the Pregnancy and Lactation Labeling Rule (PLLR).' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deaNumberRequired rdf:type rdf:Property ;
    rdfs:label 'Dea Number Required' ;
    rdfs:comment 'Indicates whether a DEA number is required for prescribing the specialty drug due to controlled substance status.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalProgramEligibility rdf:type rdf:Property ;
    rdfs:label 'Clinical Program Eligibility' ;
    rdfs:comment 'Eligibility criteria for enrollment in clinical support programs associated with the specialty drug (e.g., disease management, case management).' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturerCopayAssistanceAvailable rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Copay Assistance Available' ;
    rdfs:comment 'Indicates whether the drug manufacturer offers copay assistance or patient support programs to reduce out-of-pocket costs.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manufacturerPatientAssistanceProgram rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Patient Assistance Program' ;
    rdfs:comment 'The name or description of the manufacturer\'s patient assistance program for the specialty drug, if available.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceRequirements rdf:type rdf:Property ;
    rdfs:label 'Service Requirements' ;
    rdfs:comment 'Specific services that must be provided by the specialty pharmacy when dispensing this drug (e.g., patient education, adherence monitoring, side effect management, injection training).' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresPrescriberEnrollment rdf:type rdf:Property ;
    rdfs:label 'Requires Prescriber Enrollment' ;
    rdfs:comment 'Indicates whether prescribers must enroll in a special program or registry before prescribing the specialty drug.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresPatientEnrollment rdf:type rdf:Property ;
    rdfs:label 'Requires Patient Enrollment' ;
    rdfs:comment 'Indicates whether patients must enroll in a special program or registry before receiving the specialty drug.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresPharmacyCertification rdf:type rdf:Property ;
    rdfs:label 'Requires Pharmacy Certification' ;
    rdfs:comment 'Indicates whether pharmacies must obtain special certification to dispense the specialty drug.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wasteDisposalRequirements rdf:type rdf:Property ;
    rdfs:label 'Waste Disposal Requirements' ;
    rdfs:comment 'Special requirements for disposal of unused or expired specialty drug product to ensure environmental safety and regulatory compliance.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardousDrugClassification rdf:type rdf:Property ;
    rdfs:label 'Hazardous Drug Classification' ;
    rdfs:comment 'NIOSH hazardous drug classification group for the specialty drug, indicating level of occupational exposure risk.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresCompounding rdf:type rdf:Property ;
    rdfs:label 'Requires Compounding' ;
    rdfs:comment 'Indicates whether the specialty drug requires compounding or reconstitution before administration.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:beyondUseDateHours rdf:type rdf:Property ;
    rdfs:label 'Beyond Use Date Hours' ;
    rdfs:comment 'The maximum number of hours the specialty drug remains stable and safe for use after compounding or reconstitution.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresSterilePreparation rdf:type rdf:Property ;
    rdfs:label 'Requires Sterile Preparation' ;
    rdfs:comment 'Indicates whether the specialty drug requires sterile compounding techniques and cleanroom environment for preparation.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shippingRequirements rdf:type rdf:Property ;
    rdfs:label 'Shipping Requirements' ;
    rdfs:comment 'Special shipping and transportation requirements for the specialty drug, including temperature control, packaging, and carrier specifications.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresColdChain rdf:type rdf:Property ;
    rdfs:label 'Requires Cold Chain' ;
    rdfs:comment 'Indicates whether the specialty drug requires uninterrupted cold chain logistics from manufacturer to patient.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refillRestrictions rdf:type rdf:Property ;
    rdfs:label 'Refill Restrictions' ;
    rdfs:comment 'Any restrictions on refills for the specialty drug, including maximum number of refills or requirements for new prescriptions.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresSpecialtyBillingCode rdf:type rdf:Property ;
    rdfs:label 'Requires Specialty Billing Code' ;
    rdfs:comment 'Indicates whether the specialty drug requires special billing codes or modifiers for claims submission.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jCode rdf:type rdf:Property ;
    rdfs:label 'J Code' ;
    rdfs:comment 'The J-code (subset of HCPCS) used for billing injectable or infusible specialty drugs administered in medical settings.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyAndBillEligible rdf:type rdf:Property ;
    rdfs:label 'Buy And Bill Eligible' ;
    rdfs:comment 'Indicates whether the specialty drug is eligible for buy-and-bill reimbursement when administered in a physician office or clinic setting.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalBenefitCoverage rdf:type rdf:Property ;
    rdfs:label 'Medical Benefit Coverage' ;
    rdfs:comment 'Indicates whether the specialty drug is covered under the medical benefit rather than the pharmacy benefit.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyBenefitCoverage rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Benefit Coverage' ;
    rdfs:comment 'Indicates whether the specialty drug is covered under the pharmacy benefit.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:durRuleId rdf:type rdf:Property ;
    rdfs:label 'Dur Rule Id' ;
    rdfs:comment 'Unique identifier for the drug utilization review rule used to evaluate appropriateness of drug therapy during pharmacy claim processing.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overrideReasonRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Override Reason Required Flag' ;
    rdfs:comment 'Indicates whether a documented reason is required when overriding the DUR rule alert.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evaluationScope rdf:type rdf:Property ;
    rdfs:label 'Evaluation Scope' ;
    rdfs:comment 'Scope of data evaluated by the DUR rule, ranging from single prescription to entire patient medication profile or population-level analysis.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumAgeYears rdf:type rdf:Property ;
    rdfs:label 'Minimum Age Years' ;
    rdfs:comment 'Minimum patient age in years for which the DUR rule applies; null if no minimum age restriction.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumAgeYears rdf:type rdf:Property ;
    rdfs:label 'Maximum Age Years' ;
    rdfs:comment 'Maximum patient age in years for which the DUR rule applies; null if no maximum age restriction.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lactationRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Lactation Risk Flag' ;
    rdfs:comment 'Indicates whether the DUR rule evaluates risk for breastfeeding mothers.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formularyStatusFilter rdf:type rdf:Property ;
    rdfs:label 'Formulary Status Filter' ;
    rdfs:comment 'Formulary status of drugs to which the DUR rule applies; \'all\' indicates no formulary restriction.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugClassCode rdf:type rdf:Property ;
    rdfs:label 'Drug Class Code' ;
    rdfs:comment 'Therapeutic or pharmacologic drug class code to which the DUR rule applies (e.g., GPI, AHFS, therapeutic class).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndcList rdf:type rdf:Property ;
    rdfs:label 'Ndc List' ;
    rdfs:comment 'Comma-separated list of specific NDC codes to which the DUR rule applies; null if rule applies to drug classes rather than specific NDCs.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionDrugClass rdf:type rdf:Property ;
    rdfs:label 'Interaction Drug Class' ;
    rdfs:comment 'Drug class that interacts with the primary drug in drug-drug interaction rules.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diseaseStateCode rdf:type rdf:Property ;
    rdfs:label 'Disease State Code' ;
    rdfs:comment 'ICD-10 diagnosis code or disease state identifier for drug-disease contraindication rules.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allergyCode rdf:type rdf:Property ;
    rdfs:label 'Allergy Code' ;
    rdfs:comment 'Standardized allergy code or allergen identifier evaluated in drug-allergy rules.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumQuantity rdf:type rdf:Property ;
    rdfs:label 'Minimum Quantity' ;
    rdfs:comment 'Minimum quantity of medication that can be dispensed under the DUR rule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumQuantity rdf:type rdf:Property ;
    rdfs:label 'Maximum Quantity' ;
    rdfs:comment 'Maximum quantity of medication that can be dispensed under the DUR rule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refillIntervalDays rdf:type rdf:Property ;
    rdfs:label 'Refill Interval Days' ;
    rdfs:comment 'Minimum number of days required between prescription refills to comply with the DUR rule.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cumulativeDoseLimit rdf:type rdf:Property ;
    rdfs:label 'Cumulative Dose Limit' ;
    rdfs:comment 'Maximum cumulative dose allowed over a specified time period to prevent toxicity or overutilization.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeDosePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Cumulative Dose Period Days' ;
    rdfs:comment 'Time period in days over which the cumulative dose limit is evaluated.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dailyDoseLimit rdf:type rdf:Property ;
    rdfs:label 'Daily Dose Limit' ;
    rdfs:comment 'Maximum daily dose allowed for the medication under the DUR rule.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doseUnit rdf:type rdf:Property ;
    rdfs:label 'Dose Unit' ;
    rdfs:comment 'Unit of measure for dose-related thresholds (e.g., mg, mcg, units, mg/kg for weight-based dosing).' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailOrderRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Mail Order Restriction Flag' ;
    rdfs:comment 'Indicates whether the DUR rule restricts or requires mail order pharmacy dispensing.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prescriberSpecialtyFilter rdf:type rdf:Property ;
    rdfs:label 'Prescriber Specialty Filter' ;
    rdfs:comment 'Medical specialty code of prescribers to whom the DUR rule applies; null if no specialty restriction.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyTypeFilter rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Type Filter' ;
    rdfs:comment 'Type of pharmacy to which the DUR rule applies; \'all\' indicates no pharmacy type restriction.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planTypeFilter rdf:type rdf:Property ;
    rdfs:label 'Plan Type Filter' ;
    rdfs:comment 'Health plan type to which the DUR rule applies; \'all\' indicates no plan type restriction.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentRuleId rdf:type rdf:Property ;
    rdfs:label 'Parent Rule Id' ;
    rdfs:comment 'Identifier of the parent rule if this is a versioned or derived rule; null if this is an original rule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FraudRule .

ind:ruleSource rdf:type rdf:Property ;
    rdfs:label 'Rule Source' ;
    rdfs:comment 'Origin or source system that defined the DUR rule (e.g., internal clinical team, First DataBank, regulatory requirement).' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertMessage rdf:type rdf:Property ;
    rdfs:label 'Alert Message' ;
    rdfs:comment 'Standardized message displayed to pharmacists or prescribers when the DUR rule is triggered.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertCode rdf:type rdf:Property ;
    rdfs:label 'Alert Code' ;
    rdfs:comment 'Standardized NCPDP code representing the type of DUR alert generated when the rule is triggered.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoAdjudicationFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Adjudication Flag' ;
    rdfs:comment 'Indicates whether claims triggering this DUR rule can be automatically adjudicated without manual intervention.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedisMeasureFlag rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Flag' ;
    rdfs:comment 'Indicates whether the DUR rule supports Healthcare Effectiveness Data and Information Set (HEDIS) quality measure reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:starRatingImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Star Rating Impact Flag' ;
    rdfs:comment 'Indicates whether the DUR rule impacts CMS Star Ratings for Medicare Advantage or Part D plans.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costAvoidanceFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Avoidance Flag' ;
    rdfs:comment 'Indicates whether the DUR rule is designed to prevent unnecessary costs through appropriate utilization management.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientSafetyFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Safety Flag' ;
    rdfs:comment 'Indicates whether the primary purpose of the DUR rule is to protect patient safety and prevent adverse drug events.' ;
    rdfs:domain ind:DurRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimDenialId rdf:type rdf:Property ;
    rdfs:label 'Claim Denial Id' ;
    rdfs:comment 'Unique identifier for the claim denial record. Primary key for the claim denial entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimDenial .

ind:denialReason rdf:type rdf:Property ;
    rdfs:label 'Denial Reason' ;
    rdfs:comment 'Detailed textual explanation of why the claim was denied. Provides human-readable context for the denial code.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialTimestamp rdf:type rdf:Property ;
    rdfs:label 'Denial Timestamp' ;
    rdfs:comment 'Precise date and time when the claim denial was processed and recorded, including time zone information.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deniedAmount rdf:type rdf:Property ;
    rdfs:label 'Denied Amount' ;
    rdfs:comment 'Total dollar amount of the claim that was denied and not paid to the provider or reimbursed to the member.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submittedAmount rdf:type rdf:Property ;
    rdfs:label 'Submitted Amount' ;
    rdfs:comment 'Original amount submitted by the pharmacy on the claim before denial. Used for comparison and financial reconciliation.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drugDosageForm rdf:type rdf:Property ;
    rdfs:label 'Drug Dosage Form' ;
    rdfs:comment 'Physical form of the medication (e.g., tablet, capsule, liquid, injection). Used for formulary and coverage determination.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityDenied rdf:type rdf:Property ;
    rdfs:label 'Quantity Denied' ;
    rdfs:comment 'Number of units (tablets, milliliters, etc.) of the medication that were denied. Used for clinical and financial analysis.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysSupplyDenied rdf:type rdf:Property ;
    rdfs:label 'Days Supply Denied' ;
    rdfs:comment 'Number of days of medication supply that were denied. Used for utilization management and member impact assessment.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityLimitExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit Exceeded Flag' ;
    rdfs:comment 'Indicates whether the denial was due to exceeding plan-defined quantity limits for the medication.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumAllowedQuantity rdf:type rdf:Property ;
    rdfs:label 'Maximum Allowed Quantity' ;
    rdfs:comment 'Plan-defined maximum quantity of the medication allowed per fill or time period. Used for quantity limit denials.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalClaimClaimTxnId rdf:type rdf:Property ;
    rdfs:label 'Original Claim Claim Txn Id' ;
    rdfs:comment 'Identifier of the original claim if this denial is for a duplicate submission. Null if not a duplicate denial.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimTxn .

ind:daysFromServiceToSubmission rdf:type rdf:Property ;
    rdfs:label 'Days From Service To Submission' ;
    rdfs:comment 'Number of days elapsed between date of service and claim submission date. Used to determine timely filing compliance.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timelyFilingExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Timely Filing Exceeded Flag' ;
    rdfs:comment 'Indicates whether the claim was denied for exceeding the timely filing deadline.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:denialOverrideCode rdf:type rdf:Property ;
    rdfs:label 'Denial Override Code' ;
    rdfs:comment 'Code that could be used to override the denial if specific conditions are met. Used for exception processing.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialSeverity rdf:type rdf:Property ;
    rdfs:label 'Denial Severity' ;
    rdfs:comment 'Classification of denial severity: hard (cannot be overridden), soft (may be overridden with additional information), or informational.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genericAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Generic Available Flag' ;
    rdfs:comment 'Indicates whether a generic equivalent was available at the time of denial. Used for formulary compliance analysis.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drugSchedule rdf:type rdf:Property ;
    rdfs:label 'Drug Schedule' ;
    rdfs:comment 'DEA controlled substance schedule classification (I-V) or non-controlled. Used for regulatory compliance and monitoring.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialNotificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Denial Notification Sent Flag' ;
    rdfs:comment 'Indicates whether a formal denial notification was sent to the member and/or provider as required by regulations.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:denialNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Denial Notification Date' ;
    rdfs:comment 'Date when the denial notification was sent to the member and/or provider. Used for regulatory compliance tracking.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:denialNotificationMethod rdf:type rdf:Property ;
    rdfs:label 'Denial Notification Method' ;
    rdfs:comment 'Method used to communicate the denial to the member or provider (e.g., mail, email, member portal, EOB).' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Clinical Review Required Flag' ;
    rdfs:comment 'Indicates whether the denial requires or underwent clinical review by a pharmacist or medical director.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalNecessityMetFlag rdf:type rdf:Property ;
    rdfs:label 'Medical Necessity Met Flag' ;
    rdfs:comment 'Indicates whether the medication met medical necessity criteria based on clinical review. False indicates clinical denial.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ageRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Age Restriction Flag' ;
    rdfs:comment 'Indicates whether the denial was due to member age not meeting drug coverage criteria (e.g., pediatric or geriatric restrictions).' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genderRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Gender Restriction Flag' ;
    rdfs:comment 'Indicates whether the denial was due to member gender not matching drug coverage criteria (e.g., gender-specific medications).' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudIndicatorFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator Flag' ;
    rdfs:comment 'Indicates whether the denial was triggered by potential fraud, waste, or abuse detection algorithms.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudInvestigationId rdf:type rdf:Property ;
    rdfs:label 'Fraud Investigation Id' ;
    rdfs:comment 'Reference number of the fraud investigation case if the denial is under review by the Special Investigations Unit (SIU).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investigation .

ind:reversalEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Eligible Flag' ;
    rdfs:comment 'Indicates whether the denial can be reversed through system correction or resubmission without formal appeal.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resubmissionAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Resubmission Allowed Flag' ;
    rdfs:comment 'Indicates whether the pharmacy is allowed to resubmit the claim with corrections or additional information.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:denialSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Denial Source System' ;
    rdfs:comment 'Name of the source system or claims processing platform that generated the denial (e.g., Facets, QNXT, Optum).' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialProcessingMode rdf:type rdf:Property ;
    rdfs:label 'Denial Processing Mode' ;
    rdfs:comment 'Mode in which the denial was processed: real-time at point of sale, batch adjudication, or manual review.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialFinancialImpact rdf:type rdf:Property ;
    rdfs:label 'Denial Financial Impact' ;
    rdfs:comment 'Total financial impact of the denial on the plan, including avoided costs and potential liability if overturned.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:denialTurnaroundTimeHours rdf:type rdf:Property ;
    rdfs:label 'Denial Turnaround Time Hours' ;
    rdfs:comment 'Number of hours between claim submission and denial decision. Used for processing efficiency and SLA monitoring.' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialPeriodId rdf:type rdf:Property ;
    rdfs:label 'Financial Period Id' ;
    rdfs:comment 'Unique identifier for the financial period record. Primary key for the financial period reference data.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:periodName rdf:type rdf:Property ;
    rdfs:label 'Period Name' ;
    rdfs:comment 'Human-readable name of the financial period (e.g., \'January 2024\', \'Q1 FY2024\', \'FY2024\').' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Month' ;
    rdfs:comment 'The fiscal month number within the fiscal year (1-12).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalWeek rdf:type rdf:Property ;
    rdfs:label 'Fiscal Week' ;
    rdfs:comment 'The fiscal week number within the fiscal year (1-52 or 1-53).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarYear rdf:type rdf:Property ;
    rdfs:label 'Calendar Year' ;
    rdfs:comment 'The calendar year to which this period belongs (e.g., 2024).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarQuarter rdf:type rdf:Property ;
    rdfs:label 'Calendar Quarter' ;
    rdfs:comment 'The calendar quarter number within the calendar year (1, 2, 3, or 4).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarMonth rdf:type rdf:Property ;
    rdfs:label 'Calendar Month' ;
    rdfs:comment 'The calendar month number within the calendar year (1-12).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:periodStatus rdf:type rdf:Property ;
    rdfs:label 'Period Status' ;
    rdfs:comment 'Current status of the financial period indicating whether it is open for posting, closed, or permanently closed.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Adjustment Period Flag' ;
    rdfs:comment 'Indicates whether this is an adjustment period (typically period 13 or 14) used for year-end adjustments and accruals.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numberOfDays rdf:type rdf:Property ;
    rdfs:label 'Number Of Days' ;
    rdfs:comment 'Total number of calendar days in the financial period.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfBusinessDays rdf:type rdf:Property ;
    rdfs:label 'Number Of Business Days' ;
    rdfs:comment 'Total number of business days (excluding weekends and holidays) in the financial period.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:openingDate rdf:type rdf:Property ;
    rdfs:label 'Opening Date' ;
    rdfs:comment 'The date when the financial period was opened for transaction posting.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closingDate rdf:type rdf:Property ;
    rdfs:label 'Closing Date' ;
    rdfs:comment 'The date when the financial period was closed to prevent further transaction posting.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:yearStartDate rdf:type rdf:Property ;
    rdfs:label 'Year Start Date' ;
    rdfs:comment 'The first date of the fiscal year to which this period belongs.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:yearEndDate rdf:type rdf:Property ;
    rdfs:label 'Year End Date' ;
    rdfs:comment 'The last date of the fiscal year to which this period belongs.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:quarterStartDate rdf:type rdf:Property ;
    rdfs:label 'Quarter Start Date' ;
    rdfs:comment 'The first date of the fiscal quarter to which this period belongs.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:quarterEndDate rdf:type rdf:Property ;
    rdfs:label 'Quarter End Date' ;
    rdfs:comment 'The last date of the fiscal quarter to which this period belongs.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ledgerName rdf:type rdf:Property ;
    rdfs:label 'Ledger Name' ;
    rdfs:comment 'Name of the general ledger to which this financial period applies (e.g., \'Corporate GL\', \'Statutory GL\').' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generalLedgerId rdf:type rdf:Property ;
    rdfs:label 'General Ledger Id' ;
    rdfs:comment 'Unique identifier for the general ledger to which this financial period applies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneralLedger .

ind:periodSetName rdf:type rdf:Property ;
    rdfs:label 'Period Set Name' ;
    rdfs:comment 'Name of the period set or calendar definition to which this period belongs (e.g., \'Standard Calendar\', \'4-4-5 Calendar\').' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodNumber rdf:type rdf:Property ;
    rdfs:label 'Period Number' ;
    rdfs:comment 'Sequential number of the period within the fiscal year (1-12 for regular periods, 13-14 for adjustment periods).' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:yearToDateFlag rdf:type rdf:Property ;
    rdfs:label 'Year To Date Flag' ;
    rdfs:comment 'Indicates whether this period is included in year-to-date calculations.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quarterToDateFlag rdf:type rdf:Property ;
    rdfs:label 'Quarter To Date Flag' ;
    rdfs:comment 'Indicates whether this period is included in quarter-to-date calculations.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Flag' ;
    rdfs:comment 'Indicates whether this period is used for external financial reporting purposes.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statutoryReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Statutory Reporting Flag' ;
    rdfs:comment 'Indicates whether this period is used for statutory financial reporting to regulatory bodies.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mlrReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Mlr Reporting Flag' ;
    rdfs:comment 'Indicates whether this period is used for Medical Loss Ratio reporting to CMS under ACA requirements.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gaapReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Gaap Reporting Flag' ;
    rdfs:comment 'Indicates whether this period is used for GAAP-compliant financial reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ifrsReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Ifrs Reporting Flag' ;
    rdfs:comment 'Indicates whether this period is used for IFRS-compliant financial reporting.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorYearPeriodId rdf:type rdf:Property ;
    rdfs:label 'Prior Year Period Id' ;
    rdfs:comment 'Identifier of the corresponding financial period in the prior fiscal year for year-over-year comparisons.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:priorQuarterPeriodId rdf:type rdf:Property ;
    rdfs:label 'Prior Quarter Period Id' ;
    rdfs:comment 'Identifier of the corresponding financial period in the prior fiscal quarter for quarter-over-quarter comparisons.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:priorMonthPeriodId rdf:type rdf:Property ;
    rdfs:label 'Prior Month Period Id' ;
    rdfs:comment 'Identifier of the corresponding financial period in the prior fiscal month for month-over-month comparisons.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:enterpriseCode rdf:type rdf:Property ;
    rdfs:label 'Enterprise Code' ;
    rdfs:comment 'Code identifying the enterprise or legal entity to which this financial period applies.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityName rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Name' ;
    rdfs:comment 'Name of the legal entity to which this financial period applies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consolidationFlag rdf:type rdf:Property ;
    rdfs:label 'Consolidation Flag' ;
    rdfs:comment 'Indicates whether this period is used for consolidated financial reporting across multiple legal entities.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Budget Period Flag' ;
    rdfs:comment 'Indicates whether this period is used for budget planning and variance analysis.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:forecastPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Forecast Period Flag' ;
    rdfs:comment 'Indicates whether this period is used for financial forecasting and projections.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actuarialPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Actuarial Period Flag' ;
    rdfs:comment 'Indicates whether this period is used for actuarial reserve calculations and IBNR (Incurred But Not Reported) estimates.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumAccountingPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Accounting Period Flag' ;
    rdfs:comment 'Indicates whether this period is used for premium revenue recognition and accounting.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsAccountingPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Claims Accounting Period Flag' ;
    rdfs:comment 'Indicates whether this period is used for claims expense recognition and accounting.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costCenterId rdf:type rdf:Property ;
    rdfs:label 'Cost Center Id' ;
    rdfs:comment 'Unique identifier for the cost center. Primary key for the cost center entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:parentCostCenterCode rdf:type rdf:Property ;
    rdfs:label 'Parent Cost Center Code' ;
    rdfs:comment 'Code of the parent cost center in the organizational hierarchy, enabling roll-up reporting and hierarchical expense allocation.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Manager Employee Id' ;
    rdfs:comment 'Unique employee identifier for the cost center manager, linking to the human resources system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:companyCode rdf:type rdf:Property ;
    rdfs:label 'Company Code' ;
    rdfs:comment 'Company code in the financial system (e.g., SAP company code) to which this cost center is assigned.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:division rdf:type rdf:Property ;
    rdfs:label 'Division' ;
    rdfs:comment 'Division within the organization to which this cost center is assigned.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateProvince rdf:type rdf:Property ;
    rdfs:label 'State Province' ;
    rdfs:comment 'State or province where the cost center is located, supporting state-level financial reporting and regulatory compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedAmount rdf:type rdf:Property ;
    rdfs:label 'Committed Amount' ;
    rdfs:comment 'Total amount committed but not yet spent (e.g., purchase orders issued but not invoiced).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationBasis rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis' ;
    rdfs:comment 'Basis or driver used for cost allocation (e.g., headcount, square footage, revenue, member months).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCapital rdf:type rdf:Property ;
    rdfs:label 'Is Capital' ;
    rdfs:comment 'Indicates whether this cost center is used for capital expenditures (assets) rather than operational expenses.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOverhead rdf:type rdf:Property ;
    rdfs:label 'Is Overhead' ;
    rdfs:comment 'Indicates whether this cost center represents overhead costs that are allocated to other cost centers.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:profitCenterCode rdf:type rdf:Property ;
    rdfs:label 'Profit Center Code' ;
    rdfs:comment 'Code of the profit center to which this cost center\'s expenses are allocated for profitability analysis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalArea rdf:type rdf:Property ;
    rdfs:label 'Functional Area' ;
    rdfs:comment 'Functional area or domain of the organization that this cost center supports (e.g., Claims, Enrollment, Provider Network, Care Management).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetId rdf:type rdf:Property ;
    rdfs:label 'Budget Id' ;
    rdfs:comment 'Unique identifier for the budget record. Primary key for the budget entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Budget .

ind:accountCode rdf:type rdf:Property ;
    rdfs:label 'Account Code' ;
    rdfs:comment 'The general ledger account code to which this budget amount is assigned.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessUnitName rdf:type rdf:Property ;
    rdfs:label 'Business Unit Name' ;
    rdfs:comment 'The descriptive name of the business unit associated with this budget.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedBy rdf:type rdf:Property ;
    rdfs:label 'Submitted By' ;
    rdfs:comment 'The name or identifier of the person who submitted this budget for approval.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planningScenario rdf:type rdf:Property ;
    rdfs:label 'Planning Scenario' ;
    rdfs:comment 'The planning scenario or assumption set used for this budget (e.g., baseline, optimistic, pessimistic, best case, worst case, stretch).' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varianceThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Variance Threshold Percent' ;
    rdfs:comment 'The acceptable variance threshold as a percentage, beyond which budget deviations require investigation or corrective action.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isMlrNumerator rdf:type rdf:Property ;
    rdfs:label 'Is Mlr Numerator' ;
    rdfs:comment 'Indicates whether this budget item is included in the numerator of the MLR calculation (medical claims and quality improvement activities).' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMlrDenominator rdf:type rdf:Property ;
    rdfs:label 'Is Mlr Denominator' ;
    rdfs:comment 'Indicates whether this budget item is included in the denominator of the MLR calculation (premium revenue).' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:projectedMemberMonths rdf:type rdf:Property ;
    rdfs:label 'Projected Member Months' ;
    rdfs:comment 'The projected number of member months used as the basis for calculating this budget amount.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:projectedEnrollment rdf:type rdf:Property ;
    rdfs:label 'Projected Enrollment' ;
    rdfs:comment 'The projected average member enrollment count for the budget period.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inflationRatePercent rdf:type rdf:Property ;
    rdfs:label 'Inflation Rate Percent' ;
    rdfs:comment 'The assumed inflation rate percentage applied to this budget calculation.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trendRatePercent rdf:type rdf:Property ;
    rdfs:label 'Trend Rate Percent' ;
    rdfs:comment 'The medical cost trend rate percentage assumed for this budget, reflecting expected increases in healthcare costs.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilizationAssumption rdf:type rdf:Property ;
    rdfs:label 'Utilization Assumption' ;
    rdfs:comment 'A description of the utilization assumptions used in developing this budget (e.g., expected service utilization rates, admission rates).' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineAmount rdf:type rdf:Property ;
    rdfs:label 'Baseline Amount' ;
    rdfs:comment 'The baseline or prior year budget amount used as a reference point for comparison and variance analysis.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorYearActualAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Actual Amount' ;
    rdfs:comment 'The actual amount spent or received in the prior fiscal year for this budget line item, used for trend analysis.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastAmount rdf:type rdf:Property ;
    rdfs:label 'Forecast Amount' ;
    rdfs:comment 'The forecasted or projected amount for this budget line item based on current trends and assumptions.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reservedAmount rdf:type rdf:Property ;
    rdfs:label 'Reserved Amount' ;
    rdfs:comment 'The amount of budget that has been reserved or earmarked for specific purposes but not yet committed.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableAmount rdf:type rdf:Property ;
    rdfs:label 'Available Amount' ;
    rdfs:comment 'The remaining budget amount available for spending after accounting for committed and reserved amounts.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCapitalExpenditure rdf:type rdf:Property ;
    rdfs:label 'Is Capital Expenditure' ;
    rdfs:comment 'Indicates whether this budget item represents a capital expenditure (asset acquisition) rather than an operating expense.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDiscretionary rdf:type rdf:Property ;
    rdfs:label 'Is Discretionary' ;
    rdfs:comment 'Indicates whether this budget item is discretionary (can be adjusted or eliminated) or mandatory (required by regulation or contract).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:strategicInitiative rdf:type rdf:Property ;
    rdfs:label 'Strategic Initiative' ;
    rdfs:comment 'The name or identifier of the strategic initiative or program to which this budget is aligned.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectCode rdf:type rdf:Property ;
    rdfs:label 'Project Code' ;
    rdfs:comment 'The code identifying a specific project to which this budget is allocated, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectName rdf:type rdf:Property ;
    rdfs:label 'Project Name' ;
    rdfs:comment 'The descriptive name of the project associated with this budget, if applicable.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantCode rdf:type rdf:Property ;
    rdfs:label 'Grant Code' ;
    rdfs:comment 'The code identifying a grant or external funding source associated with this budget, if applicable.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trialBalanceId rdf:type rdf:Property ;
    rdfs:label 'Trial Balance Id' ;
    rdfs:comment 'Unique identifier for the trial balance record. Primary key for the trial balance data product.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrialBalance .

ind:ledgerType rdf:type rdf:Property ;
    rdfs:label 'Ledger Type' ;
    rdfs:comment 'The type or classification of the ledger, indicating whether it is a primary ledger, secondary ledger, adjustment ledger, consolidation ledger, statutory ledger, or management ledger.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chartOfAccountsVersion rdf:type rdf:Property ;
    rdfs:label 'Chart Of Accounts Version' ;
    rdfs:comment 'The version identifier of the chart of accounts structure used for this trial balance, enabling tracking of changes to the account structure over time.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geography rdf:type rdf:Property ;
    rdfs:label 'Geography' ;
    rdfs:comment 'The geographic region or market associated with the account, enabling regional financial analysis and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beginningBalanceDebit rdf:type rdf:Property ;
    rdfs:label 'Beginning Balance Debit' ;
    rdfs:comment 'The debit balance of the account at the beginning of the accounting period, representing the opening debit position.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beginningBalanceCredit rdf:type rdf:Property ;
    rdfs:label 'Beginning Balance Credit' ;
    rdfs:comment 'The credit balance of the account at the beginning of the accounting period, representing the opening credit position.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodDebitActivity rdf:type rdf:Property ;
    rdfs:label 'Period Debit Activity' ;
    rdfs:comment 'The total debit transactions posted to the account during the accounting period, representing increases to debit-normal accounts or decreases to credit-normal accounts.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodCreditActivity rdf:type rdf:Property ;
    rdfs:label 'Period Credit Activity' ;
    rdfs:comment 'The total credit transactions posted to the account during the accounting period, representing increases to credit-normal accounts or decreases to debit-normal accounts.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endingBalanceDebit rdf:type rdf:Property ;
    rdfs:label 'Ending Balance Debit' ;
    rdfs:comment 'The debit balance of the account at the end of the accounting period, calculated as beginning balance plus period activity, representing the closing debit position.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endingBalanceCredit rdf:type rdf:Property ;
    rdfs:label 'Ending Balance Credit' ;
    rdfs:comment 'The credit balance of the account at the end of the accounting period, calculated as beginning balance plus period activity, representing the closing credit position.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netBalance rdf:type rdf:Property ;
    rdfs:label 'Net Balance' ;
    rdfs:comment 'The net balance of the account, calculated as the difference between total debits and total credits, representing the account\'s net position.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balanceType rdf:type rdf:Property ;
    rdfs:label 'Balance Type' ;
    rdfs:comment 'Indicates whether the account has a net debit balance, net credit balance, or zero balance at the end of the period.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Functional Currency Code' ;
    rdfs:comment 'The functional currency code of the legal entity, representing the primary currency in which the entity conducts its business operations.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Reporting Currency Code' ;
    rdfs:comment 'The currency code in which the trial balance is reported for consolidated financial statements, typically the parent company\'s functional currency.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeRateType rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate Type' ;
    rdfs:comment 'The type of exchange rate applied for currency conversion, such as spot rate, average rate, historical rate, or closing rate.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balanceInReportingCurrency rdf:type rdf:Property ;
    rdfs:label 'Balance In Reporting Currency' ;
    rdfs:comment 'The account balance converted to the reporting currency using the applicable exchange rate, used for consolidated financial reporting.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentCount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Count' ;
    rdfs:comment 'The number of adjusting journal entries posted to the account during the period, providing insight into the volume of adjustments.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isBalanced rdf:type rdf:Property ;
    rdfs:label 'Is Balanced' ;
    rdfs:comment 'Boolean flag indicating whether the trial balance is in balance, meaning total debits equal total credits across all accounts.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:balanceVariance rdf:type rdf:Property ;
    rdfs:label 'Balance Variance' ;
    rdfs:comment 'The difference between total debits and total credits in the trial balance, which should be zero if the trial balance is properly balanced.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isReconciled rdf:type rdf:Property ;
    rdfs:label 'Is Reconciled' ;
    rdfs:comment 'Boolean flag indicating whether the account has been reconciled for the period, confirming that the balance has been verified against supporting documentation.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isClosed rdf:type rdf:Property ;
    rdfs:label 'Is Closed' ;
    rdfs:comment 'Boolean flag indicating whether the accounting period has been closed for this account, preventing further postings to the period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closeDate rdf:type rdf:Property ;
    rdfs:label 'Close Date' ;
    rdfs:comment 'The date on which the accounting period was officially closed for this account.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isStatutoryAccount rdf:type rdf:Property ;
    rdfs:label 'Is Statutory Account' ;
    rdfs:comment 'Boolean flag indicating whether the account is used for statutory financial reporting required by regulatory authorities.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryAccount rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Account' ;
    rdfs:comment 'Boolean flag indicating whether the account is subject to specific regulatory reporting requirements, such as CMS financial reporting or state insurance department filings.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialStatementLine rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Line' ;
    rdfs:comment 'The specific line item on the financial statements (balance sheet, income statement, cash flow statement) where this account balance is reported.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementType rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Type' ;
    rdfs:comment 'The type of financial statement on which the account is reported: balance sheet, income statement, cash flow statement, statement of equity, or not applicable.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialityThreshold rdf:type rdf:Property ;
    rdfs:label 'Materiality Threshold' ;
    rdfs:comment 'The materiality threshold amount for the account, used to determine whether variances or errors require investigation or disclosure.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isIntercompany rdf:type rdf:Property ;
    rdfs:label 'Is Intercompany' ;
    rdfs:comment 'Boolean flag indicating whether the account is used for intercompany transactions between legal entities within the UnitedHealth Group.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intercompanyPartner rdf:type rdf:Property ;
    rdfs:label 'Intercompany Partner' ;
    rdfs:comment 'The name or code of the intercompany partner entity for intercompany accounts, identifying the related legal entity in the transaction.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eliminationRequired rdf:type rdf:Property ;
    rdfs:label 'Elimination Required' ;
    rdfs:comment 'Boolean flag indicating whether the account balance requires elimination entries during consolidation to remove intercompany transactions.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveType rdf:type rdf:Property ;
    rdfs:label 'Reserve Type' ;
    rdfs:comment 'The type of insurance reserve represented by the account, such as claims reserve, Incurred But Not Reported (IBNR), premium deficiency reserve, unearned premium reserve, contingency reserve, or not applicable.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialValuationDate rdf:type rdf:Property ;
    rdfs:label 'Actuarial Valuation Date' ;
    rdfs:comment 'The date of the most recent actuarial valuation for reserve accounts, indicating when the reserve balance was last assessed by actuaries.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorPeriodAdjustment rdf:type rdf:Property ;
    rdfs:label 'Prior Period Adjustment' ;
    rdfs:comment 'The amount of adjustments made to correct errors or omissions from prior accounting periods, posted to the account in the current period.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preparedBy rdf:type rdf:Property ;
    rdfs:label 'Prepared By' ;
    rdfs:comment 'The name or identifier of the individual or system that prepared the trial balance record.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedBy rdf:type rdf:Property ;
    rdfs:label 'Reviewed By' ;
    rdfs:comment 'The name or identifier of the individual who reviewed and approved the trial balance record.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extractionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Extraction Timestamp' ;
    rdfs:comment 'The timestamp when the trial balance data was extracted from the source system for loading into the data lakehouse.' ;
    rdfs:domain ind:TrialBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:balanceSheetId rdf:type rdf:Property ;
    rdfs:label 'Balance Sheet Id' ;
    rdfs:comment 'Unique identifier for the balance sheet snapshot record.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BalanceSheet .

ind:reportingEntityCode rdf:type rdf:Property ;
    rdfs:label 'Reporting Entity Code' ;
    rdfs:comment 'Code identifying the legal entity or business unit for which this balance sheet is prepared.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingEntityName rdf:type rdf:Property ;
    rdfs:label 'Reporting Entity Name' ;
    rdfs:comment 'Full legal name of the entity for which this balance sheet is prepared.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAssets rdf:type rdf:Property ;
    rdfs:label 'Total Assets' ;
    rdfs:comment 'Sum of all current and non-current assets owned by the entity at the reporting period end.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentAssets rdf:type rdf:Property ;
    rdfs:label 'Current Assets' ;
    rdfs:comment 'Assets expected to be converted to cash or consumed within one year or the operating cycle.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashAndCashEquivalents rdf:type rdf:Property ;
    rdfs:label 'Cash And Cash Equivalents' ;
    rdfs:comment 'Liquid assets including currency, bank deposits, and short-term investments with maturities of three months or less.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shortTermInvestments rdf:type rdf:Property ;
    rdfs:label 'Short Term Investments' ;
    rdfs:comment 'Marketable securities and other investments with maturities greater than three months but less than one year.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accountsReceivable rdf:type rdf:Property ;
    rdfs:label 'Accounts Receivable' ;
    rdfs:comment 'Amounts owed to the entity by customers for goods or services provided on credit, net of allowances.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumReceivable rdf:type rdf:Property ;
    rdfs:label 'Premium Receivable' ;
    rdfs:comment 'Amounts due from policyholders and employers for insurance premiums that have been billed but not yet collected.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceRecoverable rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable' ;
    rdfs:comment 'Amounts due from reinsurers for their share of claims paid or reserves established under reinsurance agreements.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allowanceForDoubtfulAccounts rdf:type rdf:Property ;
    rdfs:label 'Allowance For Doubtful Accounts' ;
    rdfs:comment 'Contra-asset account representing estimated uncollectible receivables, reducing gross accounts receivable to net realizable value.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prepaidExpenses rdf:type rdf:Property ;
    rdfs:label 'Prepaid Expenses' ;
    rdfs:comment 'Payments made in advance for goods or services to be received in future periods.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredAcquisitionCosts rdf:type rdf:Property ;
    rdfs:label 'Deferred Acquisition Costs' ;
    rdfs:comment 'Capitalized costs directly related to acquiring new insurance contracts, amortized over the life of the policies.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherCurrentAssets rdf:type rdf:Property ;
    rdfs:label 'Other Current Assets' ;
    rdfs:comment 'Miscellaneous current assets not classified in other specific categories.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nonCurrentAssets rdf:type rdf:Property ;
    rdfs:label 'Non Current Assets' ;
    rdfs:comment 'Assets expected to provide economic benefits beyond one year or the operating cycle.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longTermInvestments rdf:type rdf:Property ;
    rdfs:label 'Long Term Investments' ;
    rdfs:comment 'Investments in securities, bonds, and other financial instruments held for periods exceeding one year.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyPlantEquipmentNet rdf:type rdf:Property ;
    rdfs:label 'Property Plant Equipment Net' ;
    rdfs:comment 'Tangible fixed assets used in operations, net of accumulated depreciation.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accumulatedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation' ;
    rdfs:comment 'Cumulative depreciation expense recognized on property, plant, and equipment since acquisition.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intangibleAssetsNet rdf:type rdf:Property ;
    rdfs:label 'Intangible Assets Net' ;
    rdfs:comment 'Non-physical assets such as patents, trademarks, software, and customer relationships, net of amortization.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:goodwill rdf:type rdf:Property ;
    rdfs:label 'Goodwill' ;
    rdfs:comment 'Excess of purchase price over fair value of identifiable net assets acquired in business combinations.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredTaxAssets rdf:type rdf:Property ;
    rdfs:label 'Deferred Tax Assets' ;
    rdfs:comment 'Future tax benefits arising from temporary differences, net operating loss carryforwards, and tax credit carryforwards.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherNonCurrentAssets rdf:type rdf:Property ;
    rdfs:label 'Other Non Current Assets' ;
    rdfs:comment 'Miscellaneous long-term assets not classified in other specific categories.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLiabilities rdf:type rdf:Property ;
    rdfs:label 'Total Liabilities' ;
    rdfs:comment 'Sum of all current and non-current obligations owed by the entity at the reporting period end.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentLiabilities rdf:type rdf:Property ;
    rdfs:label 'Current Liabilities' ;
    rdfs:comment 'Obligations expected to be settled within one year or the operating cycle.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accountsPayable rdf:type rdf:Property ;
    rdfs:label 'Accounts Payable' ;
    rdfs:comment 'Amounts owed to suppliers and vendors for goods and services purchased on credit.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimsPayable rdf:type rdf:Property ;
    rdfs:label 'Claims Payable' ;
    rdfs:comment 'Amounts owed to healthcare providers and members for claims that have been adjudicated but not yet paid.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unearnedPremiumRevenue rdf:type rdf:Property ;
    rdfs:label 'Unearned Premium Revenue' ;
    rdfs:comment 'Premiums collected in advance for coverage periods that extend beyond the reporting date.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shortTermDebt rdf:type rdf:Property ;
    rdfs:label 'Short Term Debt' ;
    rdfs:comment 'Borrowings and debt obligations due within one year, including current portion of long-term debt.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accruedExpenses rdf:type rdf:Property ;
    rdfs:label 'Accrued Expenses' ;
    rdfs:comment 'Expenses incurred but not yet paid, including salaries, interest, and other operating expenses.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incomeTaxesPayable rdf:type rdf:Property ;
    rdfs:label 'Income Taxes Payable' ;
    rdfs:comment 'Current income tax obligations owed to tax authorities for the reporting period.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherCurrentLiabilities rdf:type rdf:Property ;
    rdfs:label 'Other Current Liabilities' ;
    rdfs:comment 'Miscellaneous current obligations not classified in other specific categories.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nonCurrentLiabilities rdf:type rdf:Property ;
    rdfs:label 'Non Current Liabilities' ;
    rdfs:comment 'Obligations expected to be settled beyond one year or the operating cycle.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longTermDebt rdf:type rdf:Property ;
    rdfs:label 'Long Term Debt' ;
    rdfs:comment 'Borrowings and debt obligations with maturities exceeding one year, excluding current portion.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyReserves rdf:type rdf:Property ;
    rdfs:label 'Policy Reserves' ;
    rdfs:comment 'Actuarially determined liabilities for future policy benefits and claims under insurance contracts.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incurredButNotReportedReserves rdf:type rdf:Property ;
    rdfs:label 'Incurred But Not Reported Reserves' ;
    rdfs:comment 'Estimated liability for claims that have been incurred but not yet reported to the insurer.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredTaxLiabilities rdf:type rdf:Property ;
    rdfs:label 'Deferred Tax Liabilities' ;
    rdfs:comment 'Future tax obligations arising from temporary differences between book and tax basis of assets and liabilities.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pensionAndPostretirementObligations rdf:type rdf:Property ;
    rdfs:label 'Pension And Postretirement Obligations' ;
    rdfs:comment 'Long-term liabilities for defined benefit pension plans and other postretirement benefit obligations.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherNonCurrentLiabilities rdf:type rdf:Property ;
    rdfs:label 'Other Non Current Liabilities' ;
    rdfs:comment 'Miscellaneous long-term obligations not classified in other specific categories.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEquity rdf:type rdf:Property ;
    rdfs:label 'Total Equity' ;
    rdfs:comment 'Residual interest in assets after deducting liabilities, representing shareholders\' ownership.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commonStock rdf:type rdf:Property ;
    rdfs:label 'Common Stock' ;
    rdfs:comment 'Par or stated value of common shares issued and outstanding.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredStock rdf:type rdf:Property ;
    rdfs:label 'Preferred Stock' ;
    rdfs:comment 'Par or stated value of preferred shares issued and outstanding.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:additionalPaidInCapital rdf:type rdf:Property ;
    rdfs:label 'Additional Paid In Capital' ;
    rdfs:comment 'Amounts received from shareholders in excess of par value of stock issued.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retainedEarnings rdf:type rdf:Property ;
    rdfs:label 'Retained Earnings' ;
    rdfs:comment 'Cumulative net income retained in the business after dividends, representing reinvested profits.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accumulatedOtherComprehensiveIncome rdf:type rdf:Property ;
    rdfs:label 'Accumulated Other Comprehensive Income' ;
    rdfs:comment 'Cumulative gains and losses not included in net income, such as foreign currency translation adjustments and unrealized investment gains/losses.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:treasuryStock rdf:type rdf:Property ;
    rdfs:label 'Treasury Stock' ;
    rdfs:comment 'Cost of shares repurchased by the company and held in treasury, reducing total equity.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nonControllingInterest rdf:type rdf:Property ;
    rdfs:label 'Non Controlling Interest' ;
    rdfs:comment 'Equity in subsidiaries not attributable to the parent company, representing minority shareholders\' interests.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLiabilitiesAndEquity rdf:type rdf:Property ;
    rdfs:label 'Total Liabilities And Equity' ;
    rdfs:comment 'Sum of total liabilities and total equity, which must equal total assets per the accounting equation.' ;
    rdfs:domain ind:BalanceSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskBasedCapitalRatio rdf:type rdf:Property ;
    rdfs:label 'Risk Based Capital Ratio' ;
    rdfs:comment 'Regulatory solvency measure comparing available capital to required capital based on risk profile, used by state insurance regulators.' ;
    rdfs:domain ind:Finance ;
