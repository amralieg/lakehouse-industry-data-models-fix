ind:clinicalAiFdaSamdId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Fda Samd Id' ;
    rdfs:comment 'Primary key for clinical_ai_fda_samd' ;
    rdfs:domain ind:ClinicalAiFdaSamd ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:databricksGovernanceHipaaRetentionAnnotationsId rdf:type rdf:Property ;
    rdfs:label 'Databricks Governance Hipaa Retention Annotations Id' ;
    rdfs:comment 'Foreign key linking to metadata.hipaa_retention_annotations. Business justification: FDA SaMD regulatory submissions must demonstrate HIPAA-compliant data retention; linking to approved retention annotation ensures audit trail for 510(k)/De Novo submissions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DatabricksGovernanceHipaaRetentionAnnotations .

ind:fdaSamdId rdf:type rdf:Property ;
    rdfs:label 'Fda Samd Id' ;
    rdfs:comment 'System-generated unique identifier for the FDA SAMD submission record.' ;
    rdfs:domain ind:ClinicalAi ;
