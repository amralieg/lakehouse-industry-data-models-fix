  remediation_deadline_date date [note: 'Target date by which all identified audit findings must be remediated and corrective actions completed. | Column remediation_deadline_date (DATE) in rights.rights_audit_session']
  remediation_required_flag boolean [note: 'Boolean indicator of whether this audit session identified issues requiring formal remediation actions (True) or no remediation is needed (False). | Column remediation_required_flag (BOOLEAN) in rights.rights_audit_session']
  rights_audit_session_status varchar [note: 'Current lifecycle state of the audit session: scheduled for future execution, actively in progress, under management review, completed with findings documented, cancelled before completion, or temporarily suspended. | Column status (STRING) in rights.rights_audit_session']
  rightsline_sync_status varchar [note: 'Status of data synchronization with the Rightsline rights management system for this audit session: successfully synced, sync pending, sync failed, or not applicable for this audit type. | Column rightsline_sync_status (STRING) in rights.rights_audit_session']
  rightsline_sync_timestamp timestamp [note: 'Timestamp of the last successful synchronization of audit findings with the Rightsline rights management platform. | Column rightsline_sync_timestamp (TIMESTAMP) in rights.rights_audit_session']
  scheduled_end_date date [note: 'Planned date when the audit session is scheduled to conclude. | Column scheduled_end_date (DATE) in rights.rights_audit_session']
  scheduled_start_date date [note: 'Planned date when the audit session is scheduled to begin. | Column scheduled_start_date (DATE) in rights.rights_audit_session']
  session_number varchar [note: 'Business-facing unique identifier for the audit session, used for external reference and reporting. | Column session_number (STRING) in rights.rights_audit_session']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.rights_audit_session']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.rights_audit_session']
  territory_scope varchar [note: 'Geographic territories included in the audit scope, specified as comma-separated ISO 3166-1 alpha-3 country codes or territory groupings. | Column territory_scope (STRING) in rights.rights_audit_session']
  total_records_reviewed varchar [note: 'Total number of rights records, transactions, or data points examined during this audit session. | Column total_records_reviewed (BIGINT) in rights.rights_audit_session']
