    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tobaccoRatingAllowed rdf:type rdf:Property ;
    rdfs:label 'Tobacco Rating Allowed' ;
    rdfs:comment 'Indicates whether premium rates can vary based on tobacco use for this plan type.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geographicRatingAllowed rdf:type rdf:Property ;
    rdfs:label 'Geographic Rating Allowed' ;
    rdfs:comment 'Indicates whether premium rates can vary based on geographic location for this plan type.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumPaymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Premium Payment Frequency' ;
    rdfs:comment 'Defines the available premium payment frequency options for this plan type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayAvailable rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Available' ;
    rdfs:comment 'Indicates whether automatic premium payment options are available for this plan type.' ;
    rdfs:domain ind:PlanType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costSharingReductionEligible rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Reduction Eligible' ;
    rdfs:comment 'Indicates whether this plan type is eligible for cost-sharing reductions under ACA marketplace rules.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dbaName rdf:type rdf:Property ;
    rdfs:label 'Dba Name' ;
    rdfs:comment 'Alternate business name under which the provider operates.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomyDescription rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Description' ;
    rdfs:comment 'Human readable description of the taxonomy code.' ;
    rdfs:domain ind:Profile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySpecialty rdf:type rdf:Property ;
    rdfs:label 'Primary Specialty' ;
    rdfs:comment 'Main clinical specialty of the provider.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondarySpecialties rdf:type rdf:Property ;
    rdfs:label 'Secondary Specialties' ;
    rdfs:comment 'Pipe-separated list of additional specialties the provider holds.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseNumber rdf:type rdf:Property ;
    rdfs:label 'License Number' ;
    rdfs:comment 'Professional license number issued by the state.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseState rdf:type rdf:Property ;
    rdfs:label 'License State' ;
    rdfs:comment 'Two-letter state code where the provider\'s license was issued.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'License Expiration Date' ;
    rdfs:comment 'Date when the provider\'s state license expires.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deaNumber rdf:type rdf:Property ;
    rdfs:label 'Dea Number' ;
    rdfs:comment 'Drug Enforcement Administration registration number for prescribing controlled substances.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Credentialing Effective Date' ;
    rdfs:comment 'Date when the provider\'s credentialing became effective.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicareParticipationType rdf:type rdf:Property ;
    rdfs:label 'Medicare Participation Type' ;
    rdfs:comment 'Specific Medicare program(s) the provider participates in.' ;
    rdfs:domain ind:Profile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerStatus rdf:type rdf:Property ;
    rdfs:label 'Provider Status' ;
    rdfs:comment 'Overall operational status of the provider within the system.' ;
    rdfs:domain ind:Profile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isTelehealthEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Telehealth Enabled' ;
    rdfs:comment 'Indicates whether the provider offers telehealth services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityRatingStar rdf:type rdf:Property ;
    rdfs:label 'Quality Rating Star' ;
    rdfs:comment 'Provider\'s quality rating on a 1-5 star scale used for member decision making.' ;
    rdfs:domain ind:Profile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteriaId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria Id' ;
    rdfs:comment 'Unique identifier for the eligibility criteria record. Primary key for the eligibility criteria reference data.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EligibilityCriteria .

ind:criteriaCode rdf:type rdf:Property ;
    rdfs:label 'Criteria Code' ;
    rdfs:comment 'Unique business code identifying the specific eligibility criteria type (e.g., AGE_RANGE, INCOME_BRACKET, EMPLOYER_SIZE, GEOGRAPHIC_AREA).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criteriaName rdf:type rdf:Property ;
    rdfs:label 'Criteria Name' ;
    rdfs:comment 'Human-readable name of the eligibility criteria for display and reporting purposes.' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criteriaCategory rdf:type rdf:Property ;
    rdfs:label 'Criteria Category' ;
    rdfs:comment 'High-level classification of the eligibility criteria type to group similar criteria for configuration and reporting.' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criteriaType rdf:type rdf:Property ;
    rdfs:label 'Criteria Type' ;
    rdfs:comment 'Specific type of eligibility criteria that defines the nature of the evaluation rule (e.g., age range for Medicare eligibility, income bracket for Medicaid, employer size for group plans).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueFormat rdf:type rdf:Property ;
    rdfs:label 'Value Format' ;
    rdfs:comment 'Format specification or pattern for valid criteria values (e.g., \'MIN-MAX\' for ranges, \'ISO-3166\' for country codes, \'FIPS\' for county codes).' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comparisonOperator rdf:type rdf:Property ;
    rdfs:label 'Comparison Operator' ;
    rdfs:comment 'Logical operator used to evaluate the criteria against member or applicant data in eligibility rules (e.g., \'between\' for age ranges, \'in\' for geographic areas).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isInclusive rdf:type rdf:Property ;
    rdfs:label 'Is Inclusive' ;
    rdfs:comment 'For range-based criteria, indicates whether boundary values are included (true) or excluded (false) in the evaluation (e.g., age 65 included or excluded from age range).' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityOrder rdf:type rdf:Property ;
    rdfs:label 'Priority Order' ;
    rdfs:comment 'Numeric order in which this criteria should be evaluated within a rule set. Lower numbers are evaluated first to optimize rule processing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicablePlanTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Plan Types' ;
    rdfs:comment 'Pipe-separated list of plan types where this criteria applies (e.g., \'HMO|PPO|EPO|POS|HDHP|MA|MA-PD|PDP|SNP\'). Restricts criteria usage to specific plan designs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableMarketSegments rdf:type rdf:Property ;
    rdfs:label 'Applicable Market Segments' ;
    rdfs:comment 'Pipe-separated list of market segments where this criteria applies (e.g., \'INDIVIDUAL|SMALL_GROUP|LARGE_GROUP|ASO|GOVERNMENT\'). Defines market applicability.' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByCriteriaId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Criteria Id' ;
    rdfs:comment 'Reference to the eligibility_criteria_id that replaces this criteria when it is retired or updated. Maintains criteria lineage and version history.' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cmsComplianceIndicator rdf:type rdf:Property ;
    rdfs:label 'Cms Compliance Indicator' ;
    rdfs:comment 'Indicates whether this criteria is required for CMS compliance (true) for Medicare Advantage, Part D, or Medicaid programs. Used for regulatory reporting and audit.' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:errorMessageTemplate rdf:type rdf:Property ;
    rdfs:label 'Error Message Template' ;
    rdfs:comment 'Template for error messages displayed when this criteria is not met during eligibility evaluation. Supports member communication and customer service.' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageCount rdf:type rdf:Property ;
    rdfs:label 'Usage Count' ;
    rdfs:comment 'Number of active eligibility rules that currently reference this criteria. Indicates criteria importance and impact of changes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isConfigurable rdf:type rdf:Property ;
    rdfs:label 'Is Configurable' ;
    rdfs:comment 'Indicates whether this criteria can be configured or customized by product managers (true) or is a fixed regulatory requirement (false).' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:configurationLevel rdf:type rdf:Property ;
    rdfs:label 'Configuration Level' ;
    rdfs:comment 'Level at which this criteria can be configured or overridden (e.g., national standard, state-specific, plan-specific). Defines configuration flexibility.' ;
    rdfs:domain ind:EligibilityCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isVisibleToMember rdf:type rdf:Property ;
    rdfs:label 'Is Visible To Member' ;
    rdfs:comment 'Indicates whether this criteria should be displayed to members in eligibility communications, plan documents, or self-service portals (true) or is for internal use only (false).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationId rdf:type rdf:Property ;
    rdfs:label 'Termination Id' ;
    rdfs:comment 'Unique identifier for the provider termination event record.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialtyCode rdf:type rdf:Property ;
    rdfs:label 'Specialty Code' ;
    rdfs:comment 'Primary specialty or taxonomy code of the provider at time of termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyDescription rdf:type rdf:Property ;
    rdfs:label 'Specialty Description' ;
    rdfs:comment 'Human-readable description of the provider\'s primary specialty.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestDate rdf:type rdf:Property ;
    rdfs:label 'Request Date' ;
    rdfs:comment 'The date on which the termination was initially requested or submitted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractEndDate rdf:type rdf:Property ;
    rdfs:label 'Contract End Date' ;
    rdfs:comment 'The original contract end date prior to termination, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Notice Period Days' ;
    rdfs:comment 'Number of days of advance notice provided for the termination as required by contract or regulation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedMemberCount rdf:type rdf:Property ;
    rdfs:label 'Affected Member Count' ;
    rdfs:comment 'Number of members who had the terminated provider as their assigned or primary care provider.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:continuityOfCareRequired rdf:type rdf:Property ;
    rdfs:label 'Continuity Of Care Required' ;
    rdfs:comment 'Indicates whether continuity of care provisions must be extended to members in active treatment.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:continuityOfCareEndDate rdf:type rdf:Property ;
    rdfs:label 'Continuity Of Care End Date' ;
    rdfs:comment 'The date through which continuity of care provisions remain in effect for affected members.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:directoryRemovalDate rdf:type rdf:Property ;
    rdfs:label 'Directory Removal Date' ;
    rdfs:comment 'The date on which the provider was removed from the online and printed provider directories.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualityIssueFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Issue Flag' ;
    rdfs:comment 'Indicates whether the termination was related to quality of care concerns.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Flag' ;
    rdfs:comment 'Indicates whether the termination was related to suspected or confirmed fraud, waste, or abuse.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npdbReportable rdf:type rdf:Property ;
    rdfs:label 'Npdb Reportable' ;
    rdfs:comment 'Indicates whether the termination must be reported to the National Practitioner Data Bank.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npdbReportDate rdf:type rdf:Property ;
    rdfs:label 'Npdb Report Date' ;
    rdfs:comment 'The date on which the termination was reported to the National Practitioner Data Bank.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateBoardReportable rdf:type rdf:Property ;
    rdfs:label 'State Board Reportable' ;
    rdfs:comment 'Indicates whether the termination must be reported to the state medical or professional licensing board.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateBoardReportDate rdf:type rdf:Property ;
    rdfs:label 'State Board Report Date' ;
    rdfs:comment 'The date on which the termination was reported to the state licensing board.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsReportDate rdf:type rdf:Property ;
    rdfs:label 'Cms Report Date' ;
    rdfs:comment 'The date on which the termination was reported to CMS.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFiled rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed' ;
    rdfs:comment 'Indicates whether the provider filed an appeal or grievance regarding the termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Date' ;
    rdfs:comment 'The date on which the provider filed an appeal of the termination decision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealStatus rdf:type rdf:Property ;
    rdfs:label 'Appeal Status' ;
    rdfs:comment 'Current status of the provider\'s appeal of the termination decision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementEligible rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Eligible' ;
    rdfs:comment 'Indicates whether the provider is eligible for future reinstatement to the network.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processedByUserName rdf:type rdf:Property ;
    rdfs:label 'Processed By User Name' ;
    rdfs:comment 'Name of the user who processed and recorded the termination.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Agent Id' ;
    rdfs:comment 'Identifier of the user who approved the termination action.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:approvedByUserName rdf:type rdf:Property ;
    rdfs:label 'Approved By User Name' ;
    rdfs:comment 'Name of the user who approved the termination action.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkAdequacyImpact rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Impact' ;
    rdfs:comment 'Assessment of the impact of this termination on network adequacy standards and member access.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementProviderRequired rdf:type rdf:Property ;
    rdfs:label 'Replacement Provider Required' ;
    rdfs:comment 'Indicates whether a replacement provider must be recruited to maintain network adequacy.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialSettlementAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Settlement Amount' ;
    rdfs:comment 'Total financial settlement amount associated with the termination, if applicable.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialSettlementDate rdf:type rdf:Property ;
    rdfs:label 'Financial Settlement Date' ;
    rdfs:comment 'The date on which financial settlement related to the termination was completed.' ;
    rdfs:domain ind:Termination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outstandingClaimsCount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Claims Count' ;
    rdfs:comment 'Number of claims still pending or in process at the time of termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outstandingClaimsAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Claims Amount' ;
    rdfs:comment 'Total dollar amount of claims still pending or in process at the time of termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:identifierId rdf:type rdf:Property ;
    rdfs:label 'Identifier Id' ;
    rdfs:comment 'Unique system-generated identifier for each provider identifier record. Serves as the primary key for the provider identifier entity.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:npiType rdf:type rdf:Property ;
    rdfs:label 'Npi Type' ;
    rdfs:comment 'Classification of the NPI as either Type 1 for individual healthcare providers or Type 2 for organizational healthcare providers.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npiEnumerationDate rdf:type rdf:Property ;
    rdfs:label 'Npi Enumeration Date' ;
    rdfs:comment 'The date when the NPI was originally assigned to the provider by the National Plan and Provider Enumeration System (NPPES).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:npiLastUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Npi Last Update Date' ;
    rdfs:comment 'The most recent date when the provider\'s NPI record was updated in the NPPES system.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:npiDeactivationDate rdf:type rdf:Property ;
    rdfs:label 'Npi Deactivation Date' ;
    rdfs:comment 'The date when the NPI was deactivated or retired, if applicable. Null if the NPI is currently active.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:npiReactivationDate rdf:type rdf:Property ;
    rdfs:label 'Npi Reactivation Date' ;
    rdfs:comment 'The date when a previously deactivated NPI was reactivated, if applicable.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:npiStatus rdf:type rdf:Property ;
    rdfs:label 'Npi Status' ;
    rdfs:comment 'Current status of the NPI in the NPPES registry indicating whether it is active and valid for use in healthcare transactions.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tinType rdf:type rdf:Property ;
    rdfs:label 'Tin Type' ;
    rdfs:comment 'Classification of the TIN as either an Employer Identification Number (EIN) for organizations or Social Security Number (SSN) for individual providers.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tinName rdf:type rdf:Property ;
    rdfs:label 'Tin Name' ;
    rdfs:comment 'The legal business name or individual name associated with the TIN as registered with the IRS. Used for payment matching and validation.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tinEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Tin Effective Date' ;
    rdfs:comment 'The date when this TIN became effective for use with this provider for claims payment and tax reporting purposes.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tinTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Tin Termination Date' ;
    rdfs:comment 'The date when this TIN was terminated or is no longer valid for use with this provider. Null if currently active.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tinStatus rdf:type rdf:Property ;
    rdfs:label 'Tin Status' ;
    rdfs:comment 'Current status of the TIN indicating whether it is active and valid for claims payment processing.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'State License Number' ;
    rdfs:comment 'The license number issued by a state licensing board authorizing the provider to practice in that state. Format varies by state and profession.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateLicenseState rdf:type rdf:Property ;
    rdfs:label 'State License State' ;
    rdfs:comment 'Two-letter state code indicating the state that issued the professional license.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateLicenseType rdf:type rdf:Property ;
    rdfs:label 'State License Type' ;
    rdfs:comment 'The type or category of state license held by the provider (e.g., Medical Doctor, Registered Nurse, Physical Therapist).' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateLicenseIssueDate rdf:type rdf:Property ;
    rdfs:label 'State License Issue Date' ;
    rdfs:comment 'The date when the state license was originally issued to the provider.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateLicenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'State License Expiration Date' ;
    rdfs:comment 'The date when the state license expires and must be renewed for the provider to continue practicing legally.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateLicenseStatus rdf:type rdf:Property ;
    rdfs:label 'State License Status' ;
    rdfs:comment 'Current status of the state license indicating whether the provider is authorized to practice in the state.' ;
    rdfs:domain ind:Identifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deaScheduleAuthority rdf:type rdf:Property ;
