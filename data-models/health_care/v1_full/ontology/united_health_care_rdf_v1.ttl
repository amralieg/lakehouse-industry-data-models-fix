ind:satisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Score' ;
    rdfs:comment 'Average member satisfaction score for interactions on this channel, typically measured on a scale (e.g., 1-5 or 1-10).' ;
