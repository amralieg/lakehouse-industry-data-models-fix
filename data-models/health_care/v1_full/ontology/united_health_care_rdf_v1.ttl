    rdfs:comment 'Master reference table for communication_template. Referenced by template_id.' .

ind:BusinessAssociate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Business Associate' ;
    rdfs:comment 'Master reference table for business_associate. Referenced by business_associate_id.' .

ind:CommunicationThread rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Service ;
    rdfs:label 'Communication Thread' ;
    rdfs:comment 'Master reference table for communication_thread. Referenced by thread_id.' .

ind:KnowledgeArticle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Service ;
    rdfs:label 'Knowledge Article' ;
    rdfs:comment 'Master reference table for knowledge_article. Referenced by knowledge_article_id.' .

ind:Grievance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Service ;
    rdfs:label 'Grievance' ;
    rdfs:comment 'Master reference table for grievance. Referenced by grievance_id.' .

ind:Segment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Member ;
    rdfs:label 'Segment' ;
    rdfs:comment 'Master reference table for segment. Referenced by segment_id.' .

ind:Facility rdf:type rdfs:Class ;
