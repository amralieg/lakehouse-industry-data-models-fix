    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordCount rdf:type rdf:Property ;
    rdfs:label 'Record Count' ;
    rdfs:comment 'The total number of records or observations included in the de-identified dataset.' ;
