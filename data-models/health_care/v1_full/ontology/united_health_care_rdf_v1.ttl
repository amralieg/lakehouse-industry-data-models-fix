    rdfs:range xsd:string .

ind:affectedProviderCount rdf:type rdf:Property ;
    rdfs:label 'Affected Provider Count' ;
    rdfs:comment 'Number of healthcare providers impacted by the proposed contract change.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Review Completion Date' ;
    rdfs:comment 'Date when the review process for the change request was completed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalOutcome rdf:type rdf:Property ;
    rdfs:label 'Approval Outcome' ;
    rdfs:comment 'Final decision outcome from the approval process indicating whether the change request was approved, rejected, or conditionally approved.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationNotes rdf:type rdf:Property ;
    rdfs:label 'Implementation Notes' ;
    rdfs:comment 'Detailed notes documenting the implementation process, including any issues encountered or deviations from the plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalReviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Legal Review Outcome' ;
    rdfs:comment 'Result of the legal department review indicating approval status and any legal concerns.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalReviewComments rdf:type rdf:Property ;
    rdfs:label 'Legal Review Comments' ;
    rdfs:comment 'Comments and recommendations provided by legal counsel during their review of the change request.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Outcome' ;
    rdfs:comment 'Result of the compliance department review indicating whether the change meets regulatory and policy requirements.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReviewComments rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Comments' ;
    rdfs:comment 'Comments and findings provided by compliance department during their review of the change request.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Impact Flag' ;
    rdfs:comment 'Indicator of whether the contract change has implications for regulatory compliance or reporting requirements.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Regulatory Impact Description' ;
    rdfs:comment 'Description of how the contract change affects compliance with CMS, state insurance department, or other regulatory requirements.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkAdequacyImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Impact Flag' ;
    rdfs:comment 'Indicator of whether the contract change affects the health plan\'s ability to meet network adequacy requirements.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkAdequacyAssessment rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Assessment' ;
    rdfs:comment 'Assessment of how the contract change impacts network adequacy standards including provider availability, geographic access, and specialty coverage.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mlrImpactPercentage rdf:type rdf:Property ;
    rdfs:label 'Mlr Impact Percentage' ;
    rdfs:comment 'Estimated percentage point impact on the Medical Loss Ratio resulting from the contract change.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskAssessmentScore rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Score' ;
    rdfs:comment 'Numerical risk score assigned to the change request based on financial exposure, operational complexity, and regulatory implications, typically on a scale of 1-10.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskMitigationPlan rdf:type rdf:Property ;
    rdfs:label 'Risk Mitigation Plan' ;
    rdfs:comment 'Description of strategies and actions planned to mitigate identified risks associated with the contract change.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentCount rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Count' ;
    rdfs:comment 'Number of supporting documents attached to the change request, such as financial analyses, provider correspondence, or regulatory guidance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supportingDocumentReferences rdf:type rdf:Property ;
    rdfs:label 'Supporting Document References' ;
    rdfs:comment 'List of document identifiers or file paths for supporting documentation attached to the change request.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedChangeRequestIds rdf:type rdf:Property ;
    rdfs:label 'Related Change Request Ids' ;
    rdfs:comment 'Comma-separated list of related change request IDs that are dependent on or related to this change request.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDueDate rdf:type rdf:Property ;
    rdfs:label 'Sla Due Date' ;
    rdfs:comment 'Target date by which the change request should be reviewed and decided based on internal service level agreements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amendmentExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Amendment Execution Date' ;
    rdfs:comment 'Date when the contract amendment was formally executed and signed by all parties.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerAcknowledgmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Acknowledgment Required Flag' ;
    rdfs:comment 'Indicator of whether providers must formally acknowledge receipt and acceptance of the contract change.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerAcknowledgmentReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Acknowledgment Received Flag' ;
    rdfs:comment 'Indicator of whether required provider acknowledgments have been received for the contract change.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemUpdateRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'System Update Required Flag' ;
    rdfs:comment 'Indicator of whether the contract change requires updates to claims processing, provider network, or other operational systems.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemUpdateCompletionDate rdf:type rdf:Property ;
    rdfs:label 'System Update Completion Date' ;
    rdfs:comment 'Date when all required system updates to implement the contract change were completed and validated.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:affectedLinesOfBusiness rdf:type rdf:Property ;
    rdfs:label 'Affected Lines Of Business' ;
    rdfs:comment 'Comma-separated list of health plan lines of business impacted by the contract change, such as Commercial, Medicare Advantage, Medicaid, or Exchange.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedServiceCategories rdf:type rdf:Property ;
    rdfs:label 'Affected Service Categories' ;
    rdfs:comment 'Comma-separated list of healthcare service categories impacted by the contract change, such as inpatient, outpatient, professional services, pharmacy, or behavioral health.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueBasedArrangementType rdf:type rdf:Property ;
    rdfs:label 'Value Based Arrangement Type' ;
    rdfs:comment 'Type of value-based care arrangement if the change request involves alternative payment models or quality-based reimbursement.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMeasureImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Impact Flag' ;
    rdfs:comment 'Indicator of whether the contract change affects quality measurement programs such as HEDIS, CAHPS, or Star Ratings.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureDescription rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Description' ;
    rdfs:comment 'Description of how the contract change impacts quality measurement, reporting, or performance incentives.' ;
    rdfs:domain ind:ChangeRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalWorkflowId rdf:type rdf:Property ;
    rdfs:label 'Approval Workflow Id' ;
    rdfs:comment 'Unique identifier for the approval workflow configuration. Primary key for the approval workflow entity.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApprovalWorkflow .

ind:workflowType rdf:type rdf:Property ;
    rdfs:label 'Workflow Type' ;
    rdfs:comment 'Classification of the approval workflow based on the type of contract action requiring approval (e.g., new contract, amendment, renewal, termination).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyType rdf:type rdf:Property ;
    rdfs:label 'Specialty Type' ;
    rdfs:comment 'The medical specialty or subspecialty this approval workflow applies to (e.g., Cardiology, Orthopedics, Primary Care).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractValueThresholdMin rdf:type rdf:Property ;
    rdfs:label 'Contract Value Threshold Min' ;
    rdfs:comment 'The minimum contract value amount that triggers this approval workflow. Contracts below this threshold may follow a different or simplified approval process.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractValueThresholdMax rdf:type rdf:Property ;
    rdfs:label 'Contract Value Threshold Max' ;
    rdfs:comment 'The maximum contract value amount for which this approval workflow applies. Contracts exceeding this threshold may require escalated approval processes.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Threshold Currency Code' ;
    rdfs:comment 'The currency code for contract value thresholds, typically USD for United States operations.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalSequenceCount rdf:type rdf:Property ;
    rdfs:label 'Approval Sequence Count' ;
    rdfs:comment 'The total number of sequential approval steps configured in this workflow before a contract can be activated.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parallelApprovalAllowed rdf:type rdf:Property ;
    rdfs:label 'Parallel Approval Allowed' ;
    rdfs:comment 'Indicates whether multiple approval steps can be executed in parallel (true) or must be completed sequentially (false).' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unanimousApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Unanimous Approval Required' ;
    rdfs:comment 'Indicates whether all approvers in a parallel approval step must approve (true) or if a majority/threshold is sufficient (false).' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalThresholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Approval Threshold Percentage' ;
    rdfs:comment 'The percentage of approvers who must approve in a parallel approval step when unanimous approval is not required (e.g., 75.00 means 75% must approve).' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escalationTimeoutHours rdf:type rdf:Property ;
    rdfs:label 'Escalation Timeout Hours' ;
    rdfs:comment 'The number of hours after which an approval request is automatically escalated if no response is received from the assigned approver.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaCompletionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Completion Hours' ;
    rdfs:comment 'The target number of hours within which the entire approval workflow should be completed from initiation to final approval or rejection.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:delegationAllowed rdf:type rdf:Property ;
    rdfs:label 'Delegation Allowed' ;
    rdfs:comment 'Indicates whether an assigned approver can delegate their approval authority to another authorized individual.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reassignmentAllowed rdf:type rdf:Property ;
    rdfs:label 'Reassignment Allowed' ;
    rdfs:comment 'Indicates whether an approval task can be reassigned to a different approver by a workflow administrator or system.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commentsRequired rdf:type rdf:Property ;
    rdfs:label 'Comments Required' ;
    rdfs:comment 'Indicates whether approvers must provide comments or justification when approving or rejecting a contract in this workflow.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rejectionCommentsMandatory rdf:type rdf:Property ;
    rdfs:label 'Rejection Comments Mandatory' ;
    rdfs:comment 'Indicates whether comments are mandatory specifically when rejecting a contract approval request.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attachmentRequired rdf:type rdf:Property ;
    rdfs:label 'Attachment Required' ;
    rdfs:comment 'Indicates whether supporting documentation or attachments must be provided with the approval request for this workflow.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reminderFrequencyHours rdf:type rdf:Property ;
    rdfs:label 'Reminder Frequency Hours' ;
    rdfs:comment 'The frequency in hours at which reminder notifications are sent to approvers for pending approval requests.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:electronicSignatureRequired rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Required' ;
    rdfs:comment 'Indicates whether approvers must provide an electronic signature as part of the approval process for legal and compliance purposes.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:twoFactorAuthenticationRequired rdf:type rdf:Property ;
    rdfs:label 'Two Factor Authentication Required' ;
    rdfs:comment 'Indicates whether approvers must use two-factor authentication (2FA) when accessing and approving contracts in this workflow for enhanced security.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financeReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Finance Review Required' ;
    rdfs:comment 'Indicates whether a finance department review is required to assess financial impact, budget availability, and pricing adequacy.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkAdequacyReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Review Required' ;
    rdfs:comment 'Indicates whether a network adequacy assessment is required to ensure the contract supports regulatory network access and availability standards.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialingVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Credentialing Verification Required' ;
    rdfs:comment 'Indicates whether provider credentialing verification must be completed and current before contract approval can proceed.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backgroundCheckRequired rdf:type rdf:Property ;
    rdfs:label 'Background Check Required' ;
    rdfs:comment 'Indicates whether a background check on the provider or contracting entity is required as part of the approval process.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Exclusion Screening Required' ;
    rdfs:comment 'Indicates whether screening against federal and state exclusion lists (OIG, SAM, state Medicaid exclusions) is required before contract approval.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictOfInterestCheckRequired rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Check Required' ;
    rdfs:comment 'Indicates whether a conflict of interest assessment must be performed to identify potential conflicts between the provider and approvers or the organization.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateValidationRequired rdf:type rdf:Property ;
    rdfs:label 'Rate Validation Required' ;
    rdfs:comment 'Indicates whether contracted rates must be validated against market benchmarks, fee schedules, or internal pricing guidelines before approval.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Budget Approval Required' ;
    rdfs:comment 'Indicates whether budget availability and allocation approval is required before the contract can be approved.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:executiveApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Executive Approval Required' ;
    rdfs:comment 'Indicates whether executive leadership approval (e.g., C-suite, VP-level) is required for this contract approval workflow.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Board Approval Required' ;
    rdfs:comment 'Indicates whether Board of Directors approval is required for high-value or strategically significant contracts.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoApprovalEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Approval Enabled' ;
    rdfs:comment 'Indicates whether contracts meeting specific criteria can be automatically approved without manual intervention.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:activatedDate rdf:type rdf:Property ;
    rdfs:label 'Activated Date' ;
    rdfs:comment 'The date on which this approval workflow configuration was activated and made available for use.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deactivatedDate rdf:type rdf:Property ;
    rdfs:label 'Deactivated Date' ;
    rdfs:comment 'The date on which this approval workflow configuration was deactivated and removed from active use.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:soxCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Sox Compliant Flag' ;
    rdfs:comment 'Indicates whether this approval workflow meets Sarbanes-Oxley (SOX) Act requirements for financial controls and audit trails.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionHandlingProcess rdf:type rdf:Property ;
    rdfs:label 'Exception Handling Process' ;
    rdfs:comment 'Description of the process for handling exceptions or special cases that do not fit the standard approval workflow criteria.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resubmissionAllowed rdf:type rdf:Property ;
    rdfs:label 'Resubmission Allowed' ;
    rdfs:comment 'Indicates whether a rejected contract can be modified and resubmitted through the same approval workflow.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxResubmissionCount rdf:type rdf:Property ;
    rdfs:label 'Max Resubmission Count' ;
    rdfs:comment 'The maximum number of times a rejected contract can be resubmitted through this approval workflow before requiring escalation or alternative handling.' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:integrationSystemName rdf:type rdf:Property ;
    rdfs:label 'Integration System Name' ;
    rdfs:comment 'The name of the external or upstream system that integrates with this approval workflow (e.g., HealthEdge HealthRules, Pegasystems, Salesforce).' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowEngine rdf:type rdf:Property ;
    rdfs:label 'Workflow Engine' ;
    rdfs:comment 'The workflow automation platform or engine used to execute this approval workflow (e.g., Pegasystems, ServiceNow, custom workflow engine).' ;
    rdfs:domain ind:ApprovalWorkflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityType rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Type' ;
    rdfs:comment 'Legal structure of the contract party organization (e.g., corporation, LLC, partnership, individual practitioner).' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalBusinessName rdf:type rdf:Property ;
    rdfs:label 'Legal Business Name' ;
    rdfs:comment 'Official registered legal name of the contract party as filed with state and federal authorities. Must match IRS and state registration records.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationName rdf:type rdf:Property ;
    rdfs:label 'Organization Name' ;
    rdfs:comment 'Common name or brand name by which the contract party is known in the market and used for operational purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nameSuffix rdf:type rdf:Property ;
    rdfs:label 'Name Suffix' ;
    rdfs:comment 'Suffix or professional designation following the individual\'s name (e.g., Jr., Sr., MD, DO).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondarySpecialtyCode rdf:type rdf:Property ;
    rdfs:label 'Secondary Specialty Code' ;
    rdfs:comment 'Additional specialty or taxonomy code for providers with multiple areas of practice.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingStateCode rdf:type rdf:Property ;
    rdfs:label 'Mailing State Code' ;
    rdfs:comment 'Two-letter state code for the contract party\'s mailing address.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalGroupName rdf:type rdf:Property ;
    rdfs:label 'Medical Group Name' ;
    rdfs:comment 'Name of the medical group, IPA, or physician organization to which the provider belongs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalSchool rdf:type rdf:Property ;
    rdfs:label 'Medical School' ;
    rdfs:comment 'Name of the medical school or professional training institution from which the provider graduated.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:graduationYear rdf:type rdf:Property ;
    rdfs:label 'Graduation Year' ;
    rdfs:comment 'Year the provider graduated from medical school or professional training program.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:yearsInPractice rdf:type rdf:Property ;
    rdfs:label 'Years In Practice' ;
    rdfs:comment 'Number of years the provider has been actively practicing in their specialty.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pcmhRecognizedFlag rdf:type rdf:Property ;
    rdfs:label 'Pcmh Recognized Flag' ;
    rdfs:comment 'Indicator of whether the provider practice has achieved PCMH recognition from NCQA or similar body.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityTierScore rdf:type rdf:Property ;
    rdfs:label 'Quality Tier Score' ;
    rdfs:comment 'Composite quality performance score used for tiered network placement and value-based payment calculations.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:w9OnFileFlag rdf:type rdf:Property ;
    rdfs:label 'W9 On File Flag' ;
    rdfs:comment 'Indicator of whether a completed IRS Form W-9 is on file for tax reporting purposes.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractHierarchyId rdf:type rdf:Property ;
    rdfs:label 'Contract Hierarchy Id' ;
    rdfs:comment 'Unique identifier for the contract hierarchy relationship record.' ;
    rdfs:domain ind:ContractHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentContractNumber rdf:type rdf:Property ;
