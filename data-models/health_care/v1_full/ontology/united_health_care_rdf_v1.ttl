    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Category .

ind:parentCategoryId rdf:type rdf:Property ;
    rdfs:label 'Parent Category Id' ;
    rdfs:comment 'Identifier of the parent category in the hierarchical category structure. Null for top-level categories.' ;
    rdfs:domain ind:Category ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Category .

ind:hierarchyPath rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Path' ;
    rdfs:comment 'Full hierarchical path from root to current category using category codes separated by forward slashes (e.g., BILLING/PREMIUM/PAYMENT_ISSUE).' ;
    rdfs:domain ind:Category ;
