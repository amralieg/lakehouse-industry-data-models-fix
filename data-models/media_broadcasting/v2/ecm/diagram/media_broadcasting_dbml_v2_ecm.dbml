  created_at timestamp [note: 'Record creation timestamp']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency code for pricing']
  deal_id_external varchar [note: 'External deal ID used in bid requests']
  deal_name varchar [note: 'Name of the PMP deal']
  deal_status varchar [note: 'Deal status (draft, active, paused, expired)']
  deal_type varchar [note: 'Deal type (programmatic_guaranteed, preferred_deal, private_auction)']
  end_date date [note: 'Deal end date']
  fixed_price_cpm decimal(18,2) [note: 'Fixed price CPM for PG deals']
  floor_price decimal(18,2) [note: 'Minimum CPM floor price for the deal']
  floor_price_cpm decimal(18,2) [note: 'Floor price CPM for the deal']
  floor_price_currency varchar [note: 'Currency for floor price']
  guaranteed_impressions varchar [note: 'Guaranteed impression count for PG deals']
  impression_goal varchar [note: 'Target impression volume']
  inventory_package varchar [note: 'Inventory package included in deal']
  pmp_deal_code varchar [note: 'External deal ID used in bid requests']
  private_marketplace_deal_status varchar [note: 'Deal status (draft, active, paused, completed)']
  programmatic_enabled boolean [note: 'Flag indicating this entity is enabled for programmatic advertising']
  start_date date [note: 'Deal start date']
  targeting_criteria varchar [note: 'JSON targeting criteria for the deal']
  updated_at timestamp [note: 'Record last update timestamp']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Private Marketplace (PMP) deal entity representing programmatic-direct deals with specific deal IDs for preferred access to premium inventory.'
}

Table sales.dsp {
  dsp_id varchar [pk, note: 'Primary key for demand-side platform']
  active_flag boolean [note: 'Whether DSP is currently active']
  api_endpoint_url varchar [note: 'API endpoint for programmatic integration']
  bid_protocol varchar [note: 'Bid protocol supported (OpenRTB 2.5, 2.6, etc.)']
