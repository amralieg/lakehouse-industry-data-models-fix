    rdfs:comment 'Table storing model cards' .

ind:ClinicalAiGovernanceBiasMonitoring rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalAiGovernance ;
    rdfs:label 'Clinical Ai Governance Bias Monitoring' ;
    rdfs:comment 'Table tracking bias monitoring metrics' .

ind:ClinicalAiGovernanceFdaSamd rdf:type rdfs:Class ;
