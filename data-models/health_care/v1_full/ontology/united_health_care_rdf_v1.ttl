    rdfs:comment 'Indicates whether the specialty drug requires ongoing patient monitoring, laboratory testing, or clinical assessments during therapy.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
