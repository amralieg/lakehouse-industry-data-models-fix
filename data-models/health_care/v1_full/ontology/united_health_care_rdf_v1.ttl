ind:allocationRuleVersion rdf:type rdf:Property ;
    rdfs:label 'Allocation Rule Version' ;
    rdfs:comment 'Version number of the allocation rule applied to ensure traceability of rule changes over time.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
