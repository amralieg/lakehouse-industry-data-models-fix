    rdfs:comment 'Conditions that must be met before the patient can be discharged from post-acute care.' ;
    rdfs:domain ind:PostAcuteCarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCoverageType rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Type' ;
    rdfs:comment 'Primary payer category for the services covered by the plan.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isTelehealthAllowed rdf:type rdf:Property ;
    rdfs:label 'Is Telehealth Allowed' ;
    rdfs:comment 'Indicates whether telehealth services are permitted within this care plan.' ;
