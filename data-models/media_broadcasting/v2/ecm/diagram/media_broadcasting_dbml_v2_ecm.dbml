  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.endpoint_allocation']
  activated_timestamp timestamp [note: 'Date and time when this endpoint allocation was activated for the partner | Column activated_timestamp (TIMESTAMP) in distribution.endpoint_allocation']
  allocation_status varchar [note: 'Current operational status of this endpoint-partner allocation (Active, Suspended, Decommissioned, Pending) | Column allocation_status (STRING) in distribution.endpoint_allocation']
  bandwidth_allocation_gbps decimal(10,2) [note: 'Dedicated bandwidth in gigabits per second allocated to this partner for this endpoint. Explicitly identified in detection phase relationship data. | Column bandwidth_allocation_gbps (DECIMAL(10,2)) in distribution.endpoint_allocation']
  contract_reference varchar [note: 'Reference to the legal contract or service agreement governing this endpoint allocation. Explicitly identified in detection phase relationship data. | Column contract_reference (STRING) in distribution.endpoint_allocation']
  cost_per_gb decimal(10,4) [note: 'Partner-specific cost per gigabyte of data transferred through this endpoint. Pricing varies by partner relationship and volume commitments. Explicitly identified in detection phase relationship data. | Column cost_per_gb (DECIMAL(10,4)) in distribution.endpoint_allocation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.endpoint_allocation']
  created_timestamp timestamp [note: 'System timestamp when this allocation record was created | Column created_timestamp (TIMESTAMP) in distribution.endpoint_allocation']
  deactivated_timestamp timestamp [note: 'Date and time when this endpoint allocation was deactivated or terminated. Null if currently active. | Column deactivated_timestamp (TIMESTAMP) in distribution.endpoint_allocation']
  geo_restriction_rules varchar [note: 'Partner-specific geo-restriction rules for this endpoint allocation. Different partners may have different territorial rights requiring distinct geo-fencing. Explicitly identified in detection phase relationship data. | Column geo_restriction_rules (STRING) in distribution.endpoint_allocation']
  modified_timestamp timestamp [note: 'System timestamp when this allocation record was last modified | Column modified_timestamp (TIMESTAMP) in distribution.endpoint_allocation']
  provisioned_date date [note: 'Date when this specific endpoint was provisioned for this partner. Explicitly identified in detection phase relationship data. | Column provisioned_date (DATE) in distribution.endpoint_allocation']
  sla_tier varchar [note: 'Partner-specific SLA tier for this endpoint allocation (e.g., Platinum, Gold, Silver). Explicitly identified in detection phase relationship data. | Column sla_tier (STRING) in distribution.endpoint_allocation']
