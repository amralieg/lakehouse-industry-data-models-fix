    rdfs:range xsd:string .

ind:lobApproved rdf:type rdf:Property ;
    rdfs:label 'Lob Approved' ;
    rdfs:comment 'Comma-separated list of lines of business for which the provider is approved to participate (Commercial, Medicare Advantage, Medicaid, etc.).' ;
