    rdfs:comment 'Result of the adjudication process for the claim line.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobFlag rdf:type rdf:Property ;
    rdfs:label 'Cob Flag' ;
    rdfs:comment 'Indicates if Coordination of Benefits was applied.' ;
