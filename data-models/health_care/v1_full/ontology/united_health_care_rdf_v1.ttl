    rdfs:comment 'The primary disease state or medical condition that the specialty drug is indicated to treat (e.g., multiple sclerosis, rheumatoid arthritis, hepatitis C, oncology).' ;
    rdfs:domain ind:SpecialtyPharmacy ;
