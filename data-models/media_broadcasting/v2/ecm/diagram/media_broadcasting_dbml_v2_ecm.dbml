}

Table partner.affiliate_agreement {
  affiliate_agreement_id varchar [pk, note: 'Unique identifier for the affiliate agreement record. Primary key. | Column affiliate_agreement_id (BIGINT) in partner.affiliate_agreement']
  affiliate_channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Affiliate agreements are channel-specific contracts between networks and local stations. Core to network-affiliate relationship management, affiliation fee calculation, must-air programming compliance | Column channel_id (BIGINT) in scheduling.affiliate_agreement']
  affiliate_network_channel_id varchar [note: 'Reference to the parent network or broadcast network entity that is the counterparty to this affiliate agreement. | Column network_channel_id (BIGINT) in scheduling.affiliate_agreement']
  affiliate_station_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: affiliate_agreement.affiliate_station_id represents the affiliate station partner. Renaming to affiliate_station_partner_id for clarity (ends with partner_partner_partner_id pattern). Links to partner | Column affiliate_station_partner_id (BIGINT) in partner.affiliate_agreement']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Network-affiliate agreements are fundamentally tied to the affiliate station\'s FCC broadcast license. The agreement references the station\'s call sign, facility ID, licensed market (DMA), and coverage | Column broadcast_license_id (BIGINT) in compliance.affiliate_agreement']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: Affiliate agreements are market-specific; each affiliate station serves a specific DMA. Essential for network-affiliate relationship management and ensuring proper market coverage. Removes denormalize | Column market_coverage_id (BIGINT) in audience.affiliate_agreement']
  network_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Affiliate agreements generate intercompany transactions requiring legal entity tracking for network compensation accounting, retransmission revenue split allocation, and consolidation elimination. Cri | Column network_legal_entity_id (BIGINT) in finance.affiliate_agreement']
  primary_affiliate_station_channel_id varchar [note: 'Reference to the local broadcast station or regional affiliate partner that is party to this agreement. | Column affiliate_station_channel_id (BIGINT) in scheduling.affiliate_agreement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.affiliate_agreement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.affiliate_agreement']
  affiliation_fee_amount decimal(15,2) [note: 'Monthly or annual fee paid by the network to the affiliate station for carrying network programming, or reverse compensation paid by affiliate to network. Negative values indicate reverse compensation. | Column affiliation_fee_amount (DECIMAL(15,2)) in partner.affiliate_agreement']
  affiliation_fee_currency varchar [note: 'Three-letter ISO 4217 currency code for the affiliation fee amount (e.g., USD, CAD, GBP). | Column affiliation_fee_currency (STRING) in partner.affiliate_agreement']
  affiliation_fee_frequency varchar [note: 'Frequency at which affiliation fees are calculated and paid between network and affiliate. | Column affiliation_fee_frequency (STRING) in partner.affiliate_agreement']
  agreement_number varchar [note: 'Externally-known unique business identifier for the affiliate agreement, used in contracts, invoicing, and legal correspondence. | Column agreement_number (STRING) in partner.affiliate_agreement']
  agreement_status varchar [note: 'Current lifecycle status of the affiliate agreement indicating its operational state and enforceability. [ENUM-REF-CANDIDATE: draft|pending_approval|active|suspended|terminated|expired|renewed — 7 candidates stripped; promote to reference product] | Column agreement_status (STRING) in partner.affiliate_agreement']
  agreement_type varchar [note: 'Classification of the affiliate relationship: primary affiliation (main channel), secondary affiliation, multicast channel, digital subchannel, network-owned station, or independent affiliate. | Column agreement_type (STRING) in partner.affiliate_agreement']
  auto_renewal_flag boolean [note: 'Indicates whether the agreement automatically renews at expiration unless either party provides notice of non-renewal. | Column auto_renewal_flag (BOOLEAN) in partner.affiliate_agreement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.affiliate_agreement']
  created_timestamp timestamp [note: 'Timestamp when this affiliate agreement record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.affiliate_agreement']
  digital_rights_included_flag boolean [note: 'Indicates whether the affiliate agreement includes rights to distribute network content via digital platforms, streaming services, and Over-The-Top (OTT) channels. | Column digital_rights_included_flag (BOOLEAN) in partner.affiliate_agreement']
  dispute_resolution_method varchar [note: 'Contractually agreed method for resolving disputes between network and affiliate: litigation, binding arbitration, mediation, or good-faith negotiation. | Column dispute_resolution_method (STRING) in partner.affiliate_agreement']
  effective_date date [note: 'Date on which the affiliate agreement becomes legally binding and operational obligations commence. | Column effective_date (DATE) in partner.affiliate_agreement']
  exclusivity_flag boolean [note: 'Indicates whether the affiliate has exclusive rights to broadcast network programming within its designated territory, preventing the network from contracting with competing stations in the same market. | Column exclusivity_flag (BOOLEAN) in partner.affiliate_agreement']
  exclusivity_territory varchar [note: 'Geographic territory within which the affiliate has exclusive rights to broadcast network programming, typically defined by DMA boundaries, county lists, or signal contours. | Column exclusivity_territory (STRING) in partner.affiliate_agreement']
  expiration_date date [note: 'Date on which the affiliate agreement terminates unless renewed or extended. Nullable for evergreen agreements. | Column expiration_date (DATE) in partner.affiliate_agreement']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction and governing law that applies to the interpretation and enforcement of the affiliate agreement (e.g., State of New York, State of California). | Column governing_law_jurisdiction (STRING) in partner.affiliate_agreement']
  last_modified_timestamp timestamp [note: 'Timestamp when this affiliate agreement record was most recently updated or amended. | Column last_modified_timestamp (TIMESTAMP) in partner.affiliate_agreement']
  local_ad_avails_minutes_per_hour decimal(4,2) [note: 'Number of minutes per hour of network programming that the affiliate may use for local advertising insertion, typically 2-4 minutes per hour. | Column local_ad_avails_minutes_per_hour (DECIMAL(4,2)) in partner.affiliate_agreement']
  local_insertion_rights_flag boolean [note: 'Indicates whether the affiliate has the right to insert local advertising spots during designated network programming breaks (ad pods). | Column local_insertion_rights_flag (BOOLEAN) in partner.affiliate_agreement']
  minimum_clearance_percentage decimal(5,2) [note: 'Minimum percentage of network programming hours that the affiliate is contractually obligated to broadcast, typically 85-95% for primary affiliates. Expressed as percentage (e.g., 90.00 for 90%). | Column minimum_clearance_percentage (DECIMAL(5,2)) in partner.affiliate_agreement']
  must_air_programming_hours decimal(6,2) [note: 'Minimum number of weekly hours of network programming that the affiliate must broadcast without preemption, including prime-time, news, and sports. | Column must_air_programming_hours (DECIMAL(6,2)) in partner.affiliate_agreement']
  network_compensation_model varchar [note: 'Economic model governing compensation flow between network and affiliate: fixed fee paid to affiliate, revenue share from advertising, audience-based payments, hybrid model, or reverse compensation where affiliate pays network. | Column network_compensation_model (STRING) in partner.affiliate_agreement']
  performance_measurement_methodology varchar [note: 'Audience measurement methodology used to assess affiliate performance against contractual standards (Nielsen ratings, Comscore, proprietary measurement, or multi-source approach). | Column performance_measurement_methodology (STRING) in partner.affiliate_agreement']
  performance_standard_grp_minimum decimal(8,2) [note: 'Minimum Gross Rating Points (GRP) that the affiliate must deliver for network programming to meet performance standards and avoid penalties or compensation adjustments. | Column performance_standard_grp_minimum (DECIMAL(8,2)) in partner.affiliate_agreement']
  preemption_notice_hours varchar [note: 'Minimum number of hours advance notice the affiliate must provide to the network before preempting scheduled programming, typically 24-72 hours except for breaking news. | Column preemption_notice_hours (INT) in partner.affiliate_agreement']
  preemption_rights varchar [note: 'Extent to which the affiliate may preempt scheduled network programming for local content, special events, or breaking news. Preemption typically requires advance notice and makegoods. | Column preemption_rights (STRING) in partner.affiliate_agreement']
  renewal_notice_days varchar [note: 'Number of days prior to expiration that either party must provide written notice of intent to terminate or renegotiate, typically 90 to 180 days. | Column renewal_notice_days (INT) in partner.affiliate_agreement']
  retransmission_consent_included_flag boolean [note: 'Indicates whether the affiliate agreement includes provisions for retransmission consent negotiations with Multichannel Video Programming Distributors (MVPDs) and virtual MVPDs (vMVPDs). | Column retransmission_consent_included_flag (BOOLEAN) in partner.affiliate_agreement']
  retransmission_revenue_split_percentage decimal(5,2) [note: 'Percentage of retransmission consent fees collected from MVPDs that the affiliate must share with the network. Expressed as percentage (e.g., 30.00 for 30% to network). | Column retransmission_revenue_split_percentage (DECIMAL(5,2)) in partner.affiliate_agreement']
  revenue_share_percentage decimal(5,2) [note: 'Percentage of advertising revenue or other monetization that is shared between network and affiliate under revenue-sharing compensation models. Expressed as percentage (e.g., 15.00 for 15%). | Column revenue_share_percentage (DECIMAL(5,2)) in partner.affiliate_agreement']
  signed_date date [note: 'Date on which the affiliate agreement was executed by authorized signatories from both network and affiliate parties. | Column signed_date (DATE) in partner.affiliate_agreement']
  simulcast_requirement_flag boolean [note: 'Indicates whether the affiliate is required to simulcast network programming simultaneously across multiple platforms (linear broadcast, digital streaming, mobile apps). | Column simulcast_requirement_flag (BOOLEAN) in partner.affiliate_agreement']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.affiliate_agreement']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.affiliate_agreement']
  term_length_months varchar [note: 'Duration of the affiliate agreement term expressed in months, typically ranging from 12 to 60 months for broadcast affiliations. | Column term_length_months (INT) in partner.affiliate_agreement']
  termination_for_cause_provisions varchar [note: 'Description of conditions under which either party may terminate the agreement for cause, including breach of clearance obligations, payment defaults, license revocation, or material violations of broadcast standards. | Column termination_for_cause_provisions (STRING) in partner.affiliate_agreement']
  termination_notice_days varchar [note: 'Number of days advance written notice required for voluntary termination without cause, typically 90-180 days. | Column termination_notice_days (INT) in partner.affiliate_agreement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.affiliate_agreement']

  Note: 'Affiliate relationship agreements with local broadcast stations, regional affiliates, and network affiliate groups. Tracks affiliation fees, network compensation, programming obligations, local insertion rights, must-air requirements, and affiliate performance standards. Distinct from MVPD distribution agreements — affiliates are broadcast station partners, not pay-TV distributors. | Unity Catalog table: media_broadcasting_ecm.partner.affiliate_agreement'
}

Table partner.deal_negotiation {
  deal_negotiation_id varchar [pk, note: 'Unique identifier for the deal negotiation record. Primary key for the deal negotiation entity. | Column deal_negotiation_id (BIGINT) in partner.deal_negotiation']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Deal negotiations consume business unit resources tracked via cost centers for budget management, headcount allocation, and deal closing cost analysis. Essential for content acquisition and distributi | Column cost_center_id (BIGINT) in finance.deal_negotiation']
  opportunity_id varchar [note: 'Reference to the originating sales opportunity in Salesforce Media Cloud that initiated this deal negotiation. | Column opportunity_id (BIGINT) in sales.deal_negotiation']
