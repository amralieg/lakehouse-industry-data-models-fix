    rdfs:comment 'Method for coordinating out-of-pocket maximum accumulation between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkInheritanceRule rdf:type rdf:Property ;
    rdfs:label 'Network Inheritance Rule' ;
    rdfs:comment 'Rule defining whether the child product inherits the provider network from the parent product or maintains an independent network.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formularyInheritanceRule rdf:type rdf:Property ;
    rdfs:label 'Formulary Inheritance Rule' ;
    rdfs:comment 'Rule defining whether the child product inherits the drug formulary from the parent product or maintains an independent formulary.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityInheritanceRule rdf:type rdf:Property ;
    rdfs:label 'Eligibility Inheritance Rule' ;
    rdfs:comment 'Rule defining how eligibility criteria are inherited or derived from the parent product to the child product.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageRestrictionApplies rdf:type rdf:Property ;
    rdfs:label 'Age Restriction Applies' ;
    rdfs:comment 'Flag indicating whether age-based restrictions apply to the product hierarchy relationship (e.g., dependent child age limits).' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumAge rdf:type rdf:Property ;
    rdfs:label 'Minimum Age' ;
    rdfs:comment 'Minimum age required for enrollment in the child product within the hierarchy relationship.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumAge rdf:type rdf:Property ;
    rdfs:label 'Maximum Age' ;
    rdfs:comment 'Maximum age allowed for enrollment in the child product within the hierarchy relationship (e.g., 26 for dependent children under ACA).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:relationshipDescription rdf:type rdf:Property ;
    rdfs:label 'Relationship Description' ;
    rdfs:comment 'Detailed textual description of the product hierarchy relationship explaining the business purpose and rules.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresUnderwriting rdf:type rdf:Property ;
    rdfs:label 'Requires Underwriting' ;
    rdfs:comment 'Flag indicating whether the child product in the hierarchy requires separate underwriting approval beyond the parent product.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresSeparateApplication rdf:type rdf:Property ;
    rdfs:label 'Requires Separate Application' ;
    rdfs:comment 'Flag indicating whether enrollment in the child product requires a separate application form beyond the parent product application.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsProcessingSequence rdf:type rdf:Property ;
    rdfs:label 'Claims Processing Sequence' ;
    rdfs:comment 'Order in which products in the hierarchy are processed during claims adjudication for coordination of benefits.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mlrReportingCategory rdf:type rdf:Property ;
    rdfs:label 'Mlr Reporting Category' ;
    rdfs:comment 'Category for Medical Loss Ratio reporting purposes indicating how the product hierarchy relationship is classified for regulatory reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskPoolAssignment rdf:type rdf:Property ;
    rdfs:label 'Risk Pool Assignment' ;
    rdfs:comment 'Designation of how the product hierarchy relationship is assigned to risk pools for actuarial and financial management.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateGuaranteeInheritance rdf:type rdf:Property ;
    rdfs:label 'Rate Guarantee Inheritance' ;
    rdfs:comment 'Rule defining whether rate guarantee periods from the parent product apply to the child product in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalCoordinationRule rdf:type rdf:Property ;
    rdfs:label 'Renewal Coordination Rule' ;
    rdfs:comment 'Rule governing how renewal dates and processes are coordinated between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationCoordinationRule rdf:type rdf:Property ;
    rdfs:label 'Termination Coordination Rule' ;
    rdfs:comment 'Rule defining what happens to the child product when the parent product is terminated (e.g., automatic termination, independent continuation).' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gracePeriodCoordination rdf:type rdf:Property ;
    rdfs:label 'Grace Period Coordination' ;
    rdfs:comment 'Method for coordinating premium payment grace periods between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Required' ;
    rdfs:comment 'Flag indicating whether the product hierarchy relationship requires specific regulatory approval from state or federal authorities.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Number' ;
    rdfs:comment 'Reference number for the regulatory filing associated with the product hierarchy relationship approval.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acaComplianceIndicator rdf:type rdf:Property ;
    rdfs:label 'Aca Compliance Indicator' ;
    rdfs:comment 'Flag indicating whether the product hierarchy relationship meets ACA compliance requirements for qualified health plans.' ;
    rdfs:domain ind:Product ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:metalLevelCoordination rdf:type rdf:Property ;
    rdfs:label 'Metal Level Coordination' ;
    rdfs:comment 'Rule defining whether parent and child products must be at the same ACA metal level or can differ.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hsaEligibilityCoordination rdf:type rdf:Property ;
    rdfs:label 'Hsa Eligibility Coordination' ;
    rdfs:comment 'Rule defining HSA eligibility when parent and child products are combined in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveCareCoordination rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Coordination' ;
    rdfs:comment 'Method for coordinating preventive care benefits between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthorizationCoordination rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Coordination' ;
    rdfs:comment 'Rule defining how prior authorization requirements are coordinated between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralCoordination rdf:type rdf:Property ;
    rdfs:label 'Referral Coordination' ;
    rdfs:comment 'Method for coordinating specialist referral requirements between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careManagementCoordination rdf:type rdf:Property ;
    rdfs:label 'Care Management Coordination' ;
    rdfs:comment 'Rule defining how care management programs are coordinated between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityReportingCoordination rdf:type rdf:Property ;
    rdfs:label 'Quality Reporting Coordination' ;
    rdfs:comment 'Method for coordinating HEDIS and quality measure reporting between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberCommunicationCoordination rdf:type rdf:Property ;
    rdfs:label 'Member Communication Coordination' ;
    rdfs:comment 'Rule defining how member communications (EOBs, notices, materials) are coordinated between parent and child products.' ;
    rdfs:domain ind:Hierarchy ;
