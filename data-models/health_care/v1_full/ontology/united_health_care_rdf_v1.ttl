ind:medicalRecordReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Medical Record Review Required' ;
    rdfs:comment 'Indicates whether manual medical record review is required as part of the hybrid data collection methodology.' ;
    rdfs:domain ind:Quality ;
