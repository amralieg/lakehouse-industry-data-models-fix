    rdfs:range xsd:date .

ind:litigationCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Litigation Case Number' ;
    rdfs:comment 'Court case number if the dispute escalated to litigation.' ;
    rdfs:domain ind:Dispute ;
