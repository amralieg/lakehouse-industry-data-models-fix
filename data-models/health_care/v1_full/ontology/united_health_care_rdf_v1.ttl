    rdfs:comment 'Description of quality assurance standards or compliance requirements that sales must meet to qualify for incentive payments (e.g., complete enrollment documentation, member satisfaction scores, audit compliance).' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stackingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Stacking Allowed Flag' ;
    rdfs:comment 'Indicates whether participants can earn incentives from multiple programs simultaneously for the same sales transaction (stacking permitted or prohibited).' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
