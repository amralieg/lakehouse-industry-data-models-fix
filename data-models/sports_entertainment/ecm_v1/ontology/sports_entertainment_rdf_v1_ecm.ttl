    rdfs:comment 'Indicates whether the brand has an official fan club or membership program for dedicated supporters.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fanEngagementScore rdf:type rdf:Property ;
    rdfs:label 'Fan Engagement Score' ;
    rdfs:comment 'Composite metric measuring the level of fan interaction and engagement with the brand across all channels, scaled 0-100.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internationalExpansionFlag rdf:type rdf:Property ;
    rdfs:label 'International Expansion Flag' ;
    rdfs:comment 'Indicates whether the brand is actively pursuing or has achieved international market expansion beyond its primary market.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFeaturedFlag rdf:type rdf:Property ;
    rdfs:label 'Is Featured Flag' ;
    rdfs:comment 'Indicates whether the brand is currently featured in promotional campaigns or homepage displays.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licensingTier rdf:type rdf:Property ;
    rdfs:label 'Licensing Tier' ;
    rdfs:comment 'Classification of the brand based on its licensing value and revenue potential for merchandise and partnerships.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingBudgetUsd rdf:type rdf:Property ;
    rdfs:label 'Marketing Budget Usd' ;
    rdfs:comment 'Annual marketing budget allocated to the brand for promotional activities and fan engagement initiatives.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:merchandiseEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Merchandise Enabled Flag' ;
    rdfs:comment 'Indicates whether the brand has licensed merchandise available for sale to fans.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentBrandId rdf:type rdf:Property ;
    rdfs:label 'Parent Brand Id' ;
    rdfs:comment 'Reference to the parent brand if this brand is a sub-brand or franchise within a larger brand portfolio.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
