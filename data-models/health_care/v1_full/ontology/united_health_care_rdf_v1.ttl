    rdfs:comment 'Description of the corrective action plan implemented to address quality performance gaps or audit findings.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Timestamp when this clinical metric result record was last updated or modified.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:costSharingId rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Id' ;
    rdfs:comment 'Unique identifier for the cost sharing record. Primary key for the cost sharing data product.' ;
