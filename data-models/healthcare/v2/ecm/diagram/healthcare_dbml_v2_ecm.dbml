  updated_timestamp timestamp [note: 'Last update timestamp.']
  version_number varchar [note: 'Version number.']
  vibe_added_flag boolean [note: 'Added by VIBE mutator']

  Note: 'Defines templates for performance reviews including rating scales, competency categories, and review criteria.'
}

Table workforce.applicant {
  applicant_id varchar [pk, note: 'Unique identifier.']
  applicant_status varchar [note: 'Current applicant status.']
  application_date date [note: 'Application date']
  application_source varchar [note: 'Source of application.']
  application_status varchar [note: 'Application status']
  city varchar [note: 'City.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  current_employer varchar [note: 'Current employer.']
  current_job_title varchar [note: 'Current job title.']
  date_of_birth date [note: 'Date of birth (PII)']
  desired_salary decimal(12,2) [note: 'Desired salary.']
  education_level varchar [note: 'Education level.']
  email varchar [note: 'Email address.']
  email_address varchar [note: 'Email address (PII)']
  first_name varchar [note: 'First name.']
  last_name varchar [note: 'Last name.']
  license_number varchar [note: 'License number.']
  license_state varchar [note: 'License state.']
  license_type varchar [note: 'License type.']
  middle_name varchar [note: 'Middle name (PII)']
  phone varchar [note: 'Phone number.']
  phone_number varchar [note: 'Phone number (PII)']
  preferred_shift varchar [note: 'Preferred shift.']
  referral_source varchar [note: 'Referral source.']
  resume_url varchar [note: 'Resume URL']
  state varchar [note: 'State.']
  updated_timestamp timestamp [note: 'Last update timestamp.']
  vibe_added_flag boolean [note: 'Added by VIBE mutator']
  years_experience decimal(4,1) [note: 'Years of experience.']

  Note: 'Tracks job applicants through the recruitment process with their qualifications and application details.'
}

Table workforce.payroll_run {
  payroll_run_id varchar [pk, note: 'Unique identifier.']
  fiscal_period_id varchar [note: 'FK to fiscal period.']
  payroll_calendar_id varchar [note: 'Payroll calendar']
  approval_date date [note: 'Approval date']
  approval_timestamp timestamp [note: 'Approval timestamp.']
  approved_by varchar [note: 'Approved by.']
  check_date date [note: 'Check date.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  employee_count varchar [note: 'Number of employees in run.']
  gross_pay_total decimal(18,2) [note: 'Total gross pay.']
  net_pay_total decimal(18,2) [note: 'Total net pay.']
  pay_period_end_date date [note: 'Pay period end date.']
  pay_period_start_date date [note: 'Pay period start date.']
  payroll_frequency varchar [note: 'Payroll frequency.']
  payroll_run_number varchar [note: 'Payroll run number.']
  payroll_run_status varchar [note: 'Payroll run status']
  payroll_run_type varchar [note: 'Payroll run type']
  payroll_type varchar [note: 'Payroll type (regular, off-cycle, etc.).']
  processing_status varchar [note: 'Processing status.']
  run_date date [note: 'Run date.']
  tax_deductions_total decimal(18,2) [note: 'Total tax deductions.']
  total_gross_pay decimal(18,2) [note: 'Total gross pay']
  total_net_pay decimal(18,2) [note: 'Total net pay']
  updated_timestamp timestamp [note: 'Last update timestamp.']
  vibe_added_flag boolean [note: 'Added by VIBE mutator']

  Note: 'Tracks payroll processing runs including pay period details, totals, and processing status.'
}

Table workforce.payroll_calendar {
  payroll_calendar_id varchar [pk, note: 'Unique identifier.']
  fiscal_period_id varchar [note: 'FK to fiscal period.']
  calendar_name varchar [note: 'Calendar name.']
  calendar_year varchar [note: 'Calendar year.']
  check_date date [note: 'Check date.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  is_off_cycle boolean [note: 'Whether this is an off-cycle period.']
  pay_frequency varchar [note: 'Pay frequency.']
  pay_period_end_date date [note: 'Pay period end date.']
  pay_period_number varchar [note: 'Pay period number.']
  pay_period_start_date date [note: 'Pay period start date.']
  payroll_calendar_status varchar [note: 'Period status.']
  processing_deadline timestamp [note: 'Processing deadline.']
  timesheet_due_date date [note: 'Timesheet due date.']
  updated_timestamp timestamp [note: 'Last update timestamp.']
  vibe_added_flag boolean [note: 'Added by VIBE mutator']

  Note: 'Defines payroll calendar periods including pay dates, processing deadlines, and fiscal period alignment.'
}

Table quality.hedis_measure {
  hedis_measure_id varchar [pk, note: 'Unique identifier for the HEDIS measure definition record.']
  code_set_version_id varchar [note: 'Foreign key to the reference code set version used for this measure (e.g., ICD-10-CM 2023, CPT 2024).']
  compliance_policy_id varchar [note: 'Foreign key to the compliance policy governing this HEDIS measure reporting requirement.']
  age_range_max varchar [note: 'Maximum age (in years) for the eligible population for this HEDIS measure.']
  age_range_min varchar [note: 'Minimum age (in years) for the eligible population for this HEDIS measure.']
  allowable_gap_days varchar [note: 'Number of days allowed as a gap in continuous enrollment or medication adherence for this measure.']
  clinical_area varchar [note: 'Clinical domain or specialty area for this HEDIS measure (e.g., Diabetes, Cardiovascular, Behavioral Health).']
  collection_method varchar [note: 'Data collection methodology for this measure (e.g., Administrative, Hybrid, ECDS, Survey).']
  continuous_enrollment_days varchar [note: 'Number of days of continuous health plan enrollment required for measure eligibility.']
  cpt_code_list varchar [note: 'Comma-separated list of CPT codes used in the measure numerator or denominator logic.']
  created_timestamp timestamp [note: 'Timestamp when this HEDIS measure record was created in the system.']
  denominator_definition varchar [note: 'Textual definition of the measure denominator (eligible population) per NCQA specifications.']
  domain_category varchar [note: 'HEDIS domain category (e.g., Effectiveness of Care, Access/Availability of Care, Experience of Care, Utilization).']
  effective_end_date date [note: 'Date when this HEDIS measure version is no longer effective or was retired.']
  effective_start_date date [note: 'Date when this HEDIS measure version became effective for reporting.']
  eligible_population_description varchar [note: 'Narrative description of the eligible population for this HEDIS measure.']
  exception_criteria varchar [note: 'Criteria for denominator exceptions (patients removed from the denominator due to valid clinical reasons).']
  exclusion_criteria varchar [note: 'Criteria for denominator exclusions (patients removed from the denominator for administrative or clinical reasons).']
  hedis_ecqm_code varchar [note: 'Electronic Clinical Quality Measure (eCQM) code if this HEDIS measure has an eCQM equivalent.']
  hybrid_medical_record_required boolean [note: 'Flag indicating whether hybrid methodology (administrative + medical record review) is required for this measure.']
  icd10_code_list varchar [note: 'Comma-separated list of ICD-10 diagnosis codes used in the measure logic.']
  loinc_code_list varchar [note: 'Comma-separated list of LOINC codes for lab tests or observations used in the measure.']
  measure_code varchar [note: 'Official NCQA HEDIS measure code (e.g., CBP, CDC, COL, BCS).']
  measure_name varchar [note: 'Full official name of the HEDIS measure per NCQA specifications.']
  measure_short_name varchar [note: 'Abbreviated or short name for the HEDIS measure.']
  measure_status varchar [note: 'Current status of the measure (e.g., Active, Retired, Under Review, Proposed).']
  measure_type varchar [note: 'Type of measure (e.g., Process, Outcome, Intermediate Outcome, Structural).']
  measure_version varchar [note: 'Version number of the HEDIS measure specification (e.g., HEDIS MY 2024).']
  measurement_year varchar [note: 'Calendar year for which this HEDIS measure is being reported (e.g., 2024).']
  minimum_performance_threshold decimal(5,4) [note: 'Minimum performance rate threshold for this measure to be considered compliant or reportable.']
  mips_eligible boolean [note: 'Flag indicating whether this HEDIS measure is also eligible for MIPS (Merit-based Incentive Payment System) reporting.']
  national_average_rate decimal(5,4) [note: 'National average performance rate for this HEDIS measure across all reporting health plans.']
  national_benchmark_rate decimal(5,4) [note: 'National benchmark performance rate (e.g., 90th percentile) for this HEDIS measure.']
  ncqa_program varchar [note: 'NCQA program or accreditation type for which this measure is required (e.g., Health Plan Accreditation, PCMH).']
  ncqa_specification_url varchar [note: 'URL to the official NCQA technical specification document for this measure.']
  notes varchar [note: 'Additional notes or comments about this HEDIS measure configuration or reporting requirements.']
  numerator_definition varchar [note: 'Textual definition of the measure numerator (patients who met the measure criteria) per NCQA specifications.']
  performance_rate_direction decimal(9,4) [note: 'Direction of desired performance (e.g., Higher is Better, Lower is Better).']
  product_line varchar [note: 'Health plan product line for which this measure applies (e.g., Commercial, Medicare, Medicaid).']
  reporting_period_end_date date [note: 'End date of the measurement period for this HEDIS measure.']
  reporting_period_start_date date [note: 'Start date of the measurement period for this HEDIS measure.']
  reporting_submission_deadline date [note: 'Deadline date for submitting HEDIS measure results to NCQA or the health plan.']
  responsible_program varchar [note: 'Internal program or department responsible for this HEDIS measure reporting.']
  stratification_criteria varchar [note: 'Criteria for stratifying measure results (e.g., by age group, race/ethnicity, product line).']
  stratification_required boolean [note: 'Flag indicating whether stratified reporting is required for this measure.']
  target_performance_rate decimal(5,4) [note: 'Internal target performance rate goal for this HEDIS measure.']
  updated_timestamp timestamp [note: 'Timestamp when this HEDIS measure record was last updated.']
  value_set_oid varchar [note: 'Object Identifier (OID) for the VSAC value set used in this measure logic.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'HEDIS (Healthcare Effectiveness Data and Information Set) measure definitions from NCQA, including eligibility criteria, numerator/denominator logic, value sets, and reporting specifications for health plan quality measurement.'
}

Table quality.hedis_result {
  hedis_result_id varchar [pk, note: 'Unique identifier for the HEDIS measure result record.']
  care_site_id varchar [note: 'Foreign key to the care site where this HEDIS measure was calculated.']
  claim_id varchar [note: 'Foreign key to a representative claim used in the HEDIS measure calculation.']
  compliance_regulatory_submission_id varchar [note: 'Foreign key to the regulatory submission record for this HEDIS result.']
  cost_center_id varchar [note: 'Foreign key to the cost center responsible for this HEDIS measure reporting.']
  drg_id varchar [note: 'Foreign key to a DRG code relevant to this HEDIS measure result.']
  health_plan_id varchar [note: 'Foreign key to the health plan for which this HEDIS result was calculated.']
  hedis_measure_id varchar [note: 'Foreign key to the HEDIS measure definition for which this result was calculated.']
  interface_channel_id varchar [note: 'Foreign key to the interface channel used to submit this HEDIS result to NCQA or the health plan.']
  org_provider_id varchar [note: 'Foreign key to the organization provider responsible for this HEDIS measure result.']
  audit_status varchar [note: 'Status of external audit or validation of this HEDIS result (e.g., Pending, Audited, Validated, Discrepancy Found).']
  auditor_organization varchar [note: 'Name of the external auditor or validation organization that reviewed this HEDIS result.']
  benchmark_comparison_result varchar [note: 'Result of comparing this HEDIS performance rate to national benchmarks (e.g., Above Benchmark, Below Benchmark, At Benchmark).']
  calculation_run_timestamp timestamp [note: 'Timestamp when the HEDIS measure calculation was executed.']
  created_timestamp timestamp [note: 'Timestamp when this HEDIS result record was created.']
  data_source_type varchar [note: 'Type of data source used for this HEDIS result (e.g., Administrative, Hybrid, ECDS, Survey).']
  denominator_count varchar [note: 'Number of patients in the eligible population (denominator) for this HEDIS measure.']
  exception_count varchar [note: 'Number of patients removed from the denominator due to valid exceptions.']
  exclusion_count varchar [note: 'Number of patients removed from the denominator due to exclusions.']
  gap_count varchar [note: 'Number of patients in the denominator who did not meet the numerator criteria (care gaps).']
  hybrid_sample_size varchar [note: 'Sample size for hybrid methodology medical record review.']
  hybrid_supplemental_data_used boolean [note: 'Flag indicating whether supplemental data from medical record review was used in the hybrid calculation.']
  initial_population_count varchar [note: 'Number of patients in the initial population before applying exclusions and exceptions.']
  is_reportable boolean [note: 'Flag indicating whether this HEDIS result meets minimum reporting thresholds and is reportable to NCQA.']
  is_starred_measure boolean [note: 'Flag indicating whether this is a starred HEDIS measure (weighted more heavily in NCQA accreditation scoring).']
  measurement_year varchar [note: 'Calendar year for which this HEDIS result was calculated (e.g., 2024).']
  methodology_type varchar [note: 'Methodology used for this HEDIS result (e.g., Administrative, Hybrid, ECDS).']
  mips_quality_category varchar [note: 'MIPS quality category if this HEDIS measure is also reported for MIPS.']
  ncqa_benchmark_percentile_50 decimal(7,4) [note: 'NCQA 50th percentile benchmark rate for this HEDIS measure.']
  ncqa_benchmark_percentile_90 decimal(7,4) [note: 'NCQA 90th percentile benchmark rate for this HEDIS measure.']
  numerator_count varchar [note: 'Number of patients who met the HEDIS measure criteria (numerator).']
  performance_rate decimal(7,4) [note: 'Calculated performance rate for this HEDIS measure (numerator / denominator).']
  prior_year_performance_rate decimal(7,4) [note: 'Performance rate for this HEDIS measure in the prior measurement year.']
  product_line varchar [note: 'Health plan product line for this HEDIS result (e.g., Commercial, Medicare, Medicaid).']
  rate_change_from_prior_year decimal(7,4) [note: 'Change in performance rate compared to the prior measurement year.']
  reporting_period_end_date date [note: 'End date of the measurement period for this HEDIS result.']
  reporting_period_start_date date [note: 'Start date of the measurement period for this HEDIS result.']
  result_identifier varchar [note: 'Unique identifier or code for this HEDIS result submission.']
  result_notes varchar [note: 'Additional notes or comments about this HEDIS result.']
  result_version varchar [note: 'Version number of this HEDIS result (incremented for resubmissions or corrections).']
  star_rating_weight decimal(5,2) [note: 'Weight of this HEDIS measure in the overall Star Rating calculation.']
  stratification_category varchar [note: 'Stratification category for this HEDIS result (e.g., Age Group, Race/Ethnicity, Product Line).']
  submission_date date [note: 'Date when this HEDIS result was submitted to NCQA or the health plan.']
  submission_status varchar [note: 'Status of the HEDIS result submission (e.g., Draft, Submitted, Accepted, Rejected).']
  submission_target varchar [note: 'Target recipient of the HEDIS result submission (e.g., NCQA, CMS, Health Plan).']
  updated_timestamp timestamp [note: 'Timestamp when this HEDIS result record was last updated.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Calculated HEDIS measure results for a specific health plan, product line, and measurement year, including numerator/denominator counts, performance rates, gap counts, and submission status.'
}

Table quality.cahps_survey {
  cahps_survey_id varchar [pk, note: 'Unique identifier for the CAHPS survey administration record.']
  care_site_id varchar [note: 'Foreign key to the care site where the patient received care and was surveyed.']
  clinician_id varchar [note: 'Foreign key to the clinician who provided care to the patient (for clinician-specific CAHPS surveys).']
  health_plan_id varchar [note: 'Foreign key to the health plan for which this CAHPS survey was administered.']
  interface_channel_id varchar [note: 'Foreign key to the interface channel used to submit CAHPS survey results to CMS or the survey vendor.']
  mpi_record_id varchar [note: 'Foreign key to the patient MPI record for the survey respondent.']
  record_id varchar [note: 'Foreign key to the consent record authorizing use of patient contact information for survey administration.']
  subject_enrollment_id varchar [note: 'Foreign key to the research subject enrollment if this CAHPS survey is part of a research study.']
  unit_id varchar [note: 'Foreign key to the hospital unit where the patient received care.']
  visit_id varchar [note: 'Foreign key to the encounter/visit for which this CAHPS survey was administered.']
  administration_mode decimal(9,4) [note: 'Mode of survey administration (e.g., Mail, Phone, Web, Mixed Mode).']
  cms_certification_number varchar [note: 'CMS Certification Number (CCN) for the hospital or facility.']
  cms_submission_date date [note: 'Date when CAHPS survey results were submitted to CMS.']
  cms_submission_status varchar [note: 'Status of the CMS submission (e.g., Submitted, Accepted, Rejected, Pending).']
  created_timestamp timestamp [note: 'Timestamp when this CAHPS survey record was created.']
  discharge_date date [note: 'Date when the patient was discharged from the hospital (for HCAHPS surveys).']
  eligible_discharges varchar [note: 'Number of eligible discharges in the sampling frame for this CAHPS survey period.']
  exclusion_reason varchar [note: 'Reason for excluding this patient from the CAHPS survey sample (e.g., Deceased, No Contact Information, Court/Supervisory Care).']
  hcahps_linear_mean_score decimal(7,4) [note: 'HCAHPS linear mean score across all survey dimensions for this patient.']
  minimum_case_threshold_met boolean [note: 'Flag indicating whether the minimum case threshold for public reporting was met.']
  mode_adjustment_applied boolean [note: 'Flag indicating whether mode adjustment was applied to the survey results.']
  overall_hospital_rating varchar [note: 'Patient\'s overall rating of the hospital on a 0-10 scale.']
  patient_mix_adjustment_applied boolean [note: 'Flag indicating whether patient mix adjustment was applied to the survey results.']
  publicly_reported boolean [note: 'Flag indicating whether this CAHPS survey result is publicly reported on Hospital Compare or other public platforms.']
  recommend_hospital varchar [note: 'Patient\'s response to whether they would recommend the hospital to friends and family (e.g., Definitely Yes, Probably Yes, Probably No, Definitely No).']
  reporting_period_end date [note: 'End date of the CAHPS survey reporting period.']
  reporting_period_start date [note: 'Start date of the CAHPS survey reporting period.']
  response_date date [note: 'Date when the patient completed and returned the CAHPS survey.']
  response_language varchar [note: 'Language in which the patient completed the survey (e.g., English, Spanish).']
  response_received boolean [note: 'Flag indicating whether a response was received from the patient.']
  sample_size varchar [note: 'Number of patients sampled for this CAHPS survey period.']
  sampling_methodology varchar [note: 'Sampling methodology used for this CAHPS survey (e.g., Random, Systematic, Stratified).']
  score_care_transition decimal(5,2) [note: 'HCAHPS composite score for Care Transition domain.']
  score_cleanliness decimal(5,2) [note: 'HCAHPS composite score for Cleanliness of Hospital Environment domain.']
  score_communication_doctors decimal(5,2) [note: 'HCAHPS composite score for Communication with Doctors domain.']
  score_communication_medicines decimal(5,2) [note: 'HCAHPS composite score for Communication about Medicines domain.']
  score_communication_nurses decimal(5,2) [note: 'HCAHPS composite score for Communication with Nurses domain.']
  score_discharge_information decimal(5,2) [note: 'HCAHPS composite score for Discharge Information domain.']
  score_pain_management decimal(5,2) [note: 'HCAHPS composite score for Pain Management domain.']
  score_quietness decimal(5,2) [note: 'HCAHPS composite score for Quietness of Hospital Environment domain.']
  score_responsiveness_staff decimal(5,2) [note: 'HCAHPS composite score for Responsiveness of Hospital Staff domain.']
  star_rating varchar [note: 'Overall HCAHPS Star Rating for the hospital (1-5 stars).']
  survey_followup_date date [note: 'Date when a follow-up survey contact was made (for phone or mixed-mode surveys).']
  survey_mailed_date date [note: 'Date when the survey was mailed to the patient.']
  survey_program_code varchar [note: 'Code identifying the CAHPS survey program (e.g., HCAHPS, CAHPS Clinician & Group, CAHPS Health Plan).']
  survey_status varchar [note: 'Status of the survey (e.g., Mailed, Completed, Non-Response, Excluded).']
  survey_type varchar [note: 'Type of CAHPS survey (e.g., HCAHPS, CAHPS Clinician & Group, CAHPS Health Plan).']
  survey_version varchar [note: 'Version of the CAHPS survey instrument used.']
  updated_timestamp timestamp [note: 'Timestamp when this CAHPS survey record was last updated.']
  vbp_patient_experience_score decimal(5,2) [note: 'Value-Based Purchasing (VBP) Patient Experience of Care domain score derived from HCAHPS.']
  vendor_certification_number varchar [note: 'Certification number of the CAHPS survey vendor.']
  vendor_name varchar [note: 'Name of the CAHPS survey vendor or survey administration company.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'CAHPS (Consumer Assessment of Healthcare Providers and Systems) survey administration records, including HCAHPS hospital surveys, capturing patient experience data, survey methodology, response rates, and composite scores.'
}

Table quality.cahps_response {
  cahps_response_id varchar [pk, note: 'Unique surrogate identifier for each individual CAHPS survey response record in the silver layer lakehouse. Primary key for this transactional entity.']
  billing_coverage_id varchar [note: 'Foreign key linking to billing.coverage. Business justification: Individual survey responses must tie to patient\'s active coverage at service time for accurate payer-specific satisfaction scoring. Replaces denormalized payer_type with proper FK to coverage, enablin']
  cahps_survey_id varchar [note: 'Reference to the specific CAHPS survey instrument version administered to the patient. Links to the survey definition including question set, version, and CMS program year.']
  care_site_id varchar [note: 'Reference to the hospital or care facility where the patient received care. Used for facility-level HCAHPS reporting to CMS and internal benchmarking.']
  health_plan_id varchar [note: 'Foreign key linking to insurance.health_plan. Business justification: Individual CAHPS responses roll up to plan-level scores for CMS Star Ratings and public reporting. Payer type on response determines applicable measure set and benchmarks.']
  mpi_record_id varchar [note: 'Reference to the patient who completed or was sampled for the CAHPS survey. Links to the patient master record. Protected Health Information (PHI) under HIPAA.']
  record_cahps_survey_id varchar [note: 'Foreign key linking to consent.consent_record. Business justification: Individual survey responses must be traceable to consent documentation for vendor certification and regulatory audits. CMS requires consent verification at response level for publicly reported HCAHPS ']
  visit_id varchar [note: 'Reference to the inpatient or outpatient encounter that triggered the CAHPS survey sampling. Used to link survey responses back to the clinical episode for Value-Based Purchasing (VBP) reporting.']
  adjusted_composite_score decimal(5,2) [note: 'The overall case-mix and mode-adjusted HCAHPS composite score for this response, calculated per CMS linear mean scoring methodology. Adjusts for patient mix differences (age, education, health status, service category, language) to enable fair hospital comparisons.']
  administration_mode decimal(9,4) [note: 'The method used to administer the CAHPS survey to the patient. CMS-approved modes include mail, telephone, mail with telephone follow-up, active interactive voice response (IVR), and web. Affects response rate benchmarking and mode adjustment factors.']
  care_transition_score varchar [note: 'Patient-reported composite score for the Care Transition domain. Derived from questions about whether staff took patient preferences into account, understood the purpose of medications, and knew what to do if concerned after discharge. Scored on a 0–100 scale.']
  cms_certification_number varchar [note: 'The six-digit CMS Certification Number (CCN) identifying the hospital for HCAHPS submission to the CMS Quality Net portal. Required for regulatory reporting.']
  contact_attempt_count varchar [note: 'The total number of contact attempts made to the patient by the survey vendor (mailings sent, telephone calls placed). Used to document vendor compliance with CMS minimum contact attempt requirements.']
  created_timestamp timestamp [note: 'The timestamp when this CAHPS response record was first created in the silver layer lakehouse. Supports audit trail and data lineage requirements per HIPAA and HITRUST CSF.']
  discharge_date date [note: 'The date the patient was discharged from the inpatient encounter that triggered the CAHPS survey. CMS requires surveys to be administered between 48 hours and 6 weeks post-discharge.']
  discharge_information_score varchar [note: 'Patient-reported composite score for the Discharge Information domain. Derived from questions about whether patients received written information about symptoms to watch for and understood their care responsibilities after discharge. Scored on a 0–100 scale.']
  doctor_communication_score varchar [note: 'Patient-reported composite score for the Communication with Doctors domain of the HCAHPS survey. Derived from questions about how often doctors communicated clearly, listened carefully, and explained things in an understandable way. Scored on a 0–100 scale per CMS methodology.']
  education_level varchar [note: 'Patient\'s self-reported highest level of education completed as captured on the CAHPS survey. Used as a case-mix adjustment covariate in CMS HCAHPS linear mean score methodology. [ENUM-REF-CANDIDATE: 8th_grade_or_less|some_high_school|high_school_graduate|some_college|4_year_college_graduate|more_than_4_year_college — promote to reference product]']
  first_contact_date date [note: 'The date of the first survey contact attempt (initial mailing or first telephone call) made to the patient. Used to track the survey administration timeline and compliance with CMS contact windows.']
  hospital_environment_score varchar [note: 'Patient-reported composite score for the Hospital Environment domain covering cleanliness and quietness of the hospital environment. Scored on a 0–100 scale per CMS HCAHPS methodology.']
  ineligibility_reason varchar [note: 'The specific reason a patient was excluded from the HCAHPS survey sampling frame. Populated only when is_eligible is False. Used for sampling frame documentation and CMS audit compliance.']
  is_eligible boolean [note: 'Indicates whether the patient met all CMS eligibility criteria for HCAHPS survey inclusion (e.g., age 18+, non-psychiatric admission, non-excluded diagnosis, minimum one-night stay). Ineligible patients are excluded from the sampling frame.']
  is_sampled boolean [note: 'Indicates whether the eligible patient was selected into the HCAHPS survey sample for the reporting period. Hospitals may use census or random sampling per CMS guidelines.']
  language_of_response varchar [note: 'The ISO 639-2 three-letter language code indicating the language in which the patient completed the CAHPS survey. CMS requires survey vendors to offer surveys in multiple languages. Used for language-stratified response rate analysis.']
  length_of_stay_days varchar [note: 'The number of inpatient days for the encounter associated with this survey. Used as a case-mix adjustment covariate in HCAHPS linear mean score calculations per CMS methodology.']
  medicine_communication_score varchar [note: 'Patient-reported composite score for the Communication About Medicines domain. Derived from questions about how often staff explained the purpose of new medications and described possible side effects. Scored on a 0–100 scale per CMS methodology.']
  mrn varchar [note: 'The Medical Record Number assigned to the patient in the source Electronic Health Record (EHR) system. Used for survey sampling frame construction and de-duplication. PHI under HIPAA.']
  nurse_communication_score varchar [note: 'Patient-reported composite score for the Communication with Nurses domain of the HCAHPS survey. Derived from questions about how often nurses communicated clearly, listened carefully, and explained things in an understandable way. Scored on a 0–100 scale per CMS methodology.']
  overall_hospital_rating varchar [note: 'Patient\'s overall rating of the hospital on a 0–10 numeric scale as reported on the HCAHPS survey. A key individual measure used in CMS VBP Patient Experience of Care domain scoring.']
  pain_management_score varchar [note: 'Patient-reported composite score for the Pain Management domain. Derived from questions about how often staff did everything they could to help with pain and how often pain was well controlled. Scored on a 0–100 scale. Note: CMS removed this domain from VBP scoring in 2018 due to opioid concerns; retained for historical trending.']
  patient_service_line varchar [note: 'The clinical service line associated with the patient\'s inpatient stay (e.g., cardiology, orthopedics, oncology, obstetrics). Used for service-line-level HCAHPS performance stratification and internal benchmarking.']
  program_year varchar [note: 'The CMS fiscal year for which this CAHPS response contributes to Value-Based Purchasing (VBP) performance scoring and MIPS quality reporting.']
  recommend_hospital varchar [note: 'Patient\'s response to the HCAHPS question asking whether they would recommend the hospital to friends and family. One of four ordinal response options. Used in CMS VBP Patient Experience of Care domain.']
  reporting_quarter varchar [note: 'The CMS reporting quarter in which this survey response is included for HCAHPS public reporting and Value-Based Purchasing (VBP) scoring. Format: YYYYQn (e.g., 2024Q1).']
  response_date date [note: 'The date on which the patient completed and returned the CAHPS survey. Used to determine the survey reporting period and CMS submission quarter.']
  response_status varchar [note: 'The disposition of the survey attempt indicating whether the patient completed the survey or the reason for non-response. Used for response rate calculation and CMS non-response bias analysis.']
  sampling_date date [note: 'The date the patient was selected into the CAHPS survey sample from the eligible discharge population. Used for sampling frame documentation and CMS audit trail.']
  self_reported_health_status varchar [note: 'Patient\'s self-reported general health status as captured on the CAHPS survey. Used as a case-mix adjustment covariate in CMS HCAHPS linear mean score methodology to account for patient mix differences across hospitals.']
  service_category varchar [note: 'The CMS-defined patient service category for the inpatient stay: Medical, Surgical, or Maternity. Used as a case-mix adjustment variable in HCAHPS scoring and for CMS VBP stratified reporting.']
  staff_responsiveness_score varchar [note: 'Patient-reported composite score for the Responsiveness of Hospital Staff domain. Derived from questions about how often patients received help as soon as they wanted when using the call button or needing to use the bathroom. Scored on a 0–100 scale.']
  survey_type varchar [note: 'The specific CAHPS instrument type administered. HCAHPS is the Hospital Consumer Assessment of Healthcare Providers and Systems used for CMS VBP reporting. Other types support outpatient and specialty settings. [ENUM-REF-CANDIDATE: HCAHPS|CGCAHPS|PCMH_CAHPS|ED_CAHPS|OAS_CAHPS|ICH_CAHPS — promote to reference product]']
  top_box_doctor_communication boolean [note: 'Indicates whether the patient provided the most favorable (top-box) response for the Communication with Doctors composite domain. CMS VBP scoring uses top-box percentage rates across the patient population.']
  top_box_nurse_communication boolean [note: 'Indicates whether the patient provided the most favorable (top-box) response for the Communication with Nurses composite domain. Used in CMS VBP Patient Experience of Care domain top-box rate calculation.']
  top_box_overall_rating boolean [note: 'Indicates whether the patient gave an overall hospital rating of 9 or 10 (top-box threshold per CMS methodology). Used in CMS VBP Patient Experience of Care domain scoring.']
  top_box_recommend boolean [note: 'Indicates whether the patient responded \'Definitely Yes\' to the hospital recommendation question (top-box threshold per CMS methodology). Used in CMS VBP Patient Experience of Care domain scoring.']
  updated_timestamp timestamp [note: 'The timestamp when this CAHPS response record was last modified in the silver layer lakehouse. Used for incremental load processing and audit trail compliance.']
  vbp_patient_experience_score decimal(5,2) [note: 'The individual patient-level contribution score to the CMS Value-Based Purchasing (VBP) Patient Experience of Care domain, calculated from HCAHPS composite and global measures per CMS scoring methodology.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Individual patient responses to CAHPS surveys.'
}

Table quality.patient_safety_event {
  patient_safety_event_id varchar [pk, note: 'Unique surrogate identifier for the patient safety event record. Primary key for this data product.']
  bed_assignment_id varchar [note: 'Foreign key linking to encounter.bed_assignment. Business justification: Safety events (falls, pressure ulcers, HAIs, medication errors) are location-specific and tied to bed assignments. Real business process: Safety investigations document which bed/unit was active when ']
  bed_id varchar [note: 'Foreign key linking to facility.bed. Business justification: Bed-level tracking essential for falls (bed type, low-bed status), pressure injuries (bariatric capability, air-fluidized beds), and patient identification errors. Risk management and quality teams an']
  care_site_id varchar [note: 'Reference to the facility (hospital, clinic, outpatient center) where the patient safety event occurred. Supports multi-facility enterprise reporting and CMS Conditions of Participation compliance.']
  clinician_id varchar [note: 'Reference to the clinician or staff member who initially reported the patient safety event. Used for follow-up and reporter acknowledgment workflows.']
  contrast_admin_id varchar [note: 'Foreign key linking to radiology.contrast_admin. Business justification: Contrast administration adverse reactions (extravasation, anaphylaxis, contrast-induced nephropathy) are reportable safety events. Event investigation requires linking to the administration record for']
  critical_result_id varchar [note: 'Foreign key linking to radiology.critical_result. Business justification: Critical finding notification failures are sentinel events under TJC standards. Safety event tracking must link to the specific critical result notification to measure compliance with read-back and ac']
  disclosure_consent_record_id varchar [note: 'Foreign key linking to consent.consent_record. Business justification: TJC sentinel event standards require documented patient/family consent before disclosure of safety event details. Disclosure_status field indicates when consent is needed; this links to the actual con']
  environmental_service_request_id varchar [note: 'Foreign key linking to facility.environmental_service_request. Business justification: Healthcare-acquired infections linked to environmental cleaning failures require EVS request tracking. Infection prevention teams investigate cleaning protocol compliance, disinfectant product used, a']
  equipment_asset_id varchar [note: 'Foreign key linking to facility.equipment_asset. Business justification: Device-related adverse events (infusion pump programming errors, ventilator malfunctions, defibrillator failures) require equipment asset linkage for FDA MedWatch reporting, manufacturer recall tracki']
  hazardous_material_id varchar [note: 'Foreign key linking to facility.hazardous_material. Business justification: Hazardous material exposure events (chemotherapy spills, radioactive material incidents, chemical burns) require hazmat inventory linkage for OSHA reporting, EPA notification, and SDS documentation. S']
  hotline_report_id varchar [note: 'Foreign key linking to compliance.hotline_report. Business justification: Patient safety events are frequently reported through compliance hotlines by staff, patients, or families. Linking events to originating hotline reports enables tracking of allegation investigation, r']
  imaging_order_id varchar [note: 'Foreign key linking to radiology.imaging_order. Business justification: Imaging orders trigger safety events (wrong-site imaging, contrast reactions, radiation overexposure). TJC and CMS require linking safety events to originating orders for root cause analysis and corre']
  investigation_id varchar [note: 'Foreign key linking to compliance.investigation. Business justification: Patient safety events trigger formal compliance investigations to determine regulatory violations, root causes, disclosure requirements, and potential sanctions. Investigations assess whether events c']
  maintenance_order_id varchar [note: 'Foreign key linking to facility.maintenance_order. Business justification: Equipment failure-related adverse events (HVAC failures causing temperature excursions, medical gas system failures, emergency generator failures during procedures) require maintenance work order link']
  material_master_id varchar [note: 'Foreign key linking to supply.material_master. Business justification: Patient safety events frequently involve specific medical devices or supplies (defective equipment, wrong item administered). FDA adverse event reporting and root cause analysis require tracking which']
  mpi_record_id varchar [note: 'Reference to the patient involved in the safety event. Links to the Master Patient Index (MPI) record. Protected Health Information (PHI) under HIPAA.']
  or_suite_id varchar [note: 'Foreign key linking to facility.or_suite. Business justification: Surgical safety events (retained foreign objects, wrong-site surgery, surgical site infections) require OR suite linkage for environmental factor analysis (laminar airflow failures, sterilization issu']
  primary_patient_employee_id varchar [note: 'Reference to the risk management staff member assigned to oversee this patient safety event, coordinate disclosure, and manage potential liability. Supports risk management workflow and accountability.']
  radiation_dose_record_id varchar [note: 'Foreign key linking to radiology.dose_record. Business justification: Radiation overexposure incidents (dose alert threshold breaches, cumulative dose concerns) are patient safety events requiring investigation. Safety event reporting must link to the dose record for ph']
  radiology_study_id varchar [note: 'Foreign key linking to radiology.study. Business justification: Imaging studies are direct sources of safety events (equipment malfunction, patient falls during scan, adverse reactions). Safety event investigation and regulatory reporting require study-level trace']
  room_id varchar [note: 'Foreign key linking to facility.room. Business justification: Room-level precision critical for healthcare-acquired infection tracking, environmental hazard analysis (negative pressure room failures), and room-specific safety interventions. Infection prevention ']
  subject_enrollment_id varchar [note: 'Foreign key linking to research.subject_enrollment. Business justification: Safety events in research subjects trigger dual reporting: institutional patient safety system AND research adverse event reporting to IRB/sponsor/FDA. Linkage enables proper classification, expedited']
  triage_assessment_id varchar [note: 'Foreign key linking to encounter.triage_assessment. Business justification: Safety events (treatment delays, missed diagnoses, deterioration) often originate in ED triage. Real business process: Safety event investigations trace back to triage assessment for root cause analys']
  udi_record_id varchar [note: 'Foreign key linking to supply.udi_record. Business justification: When safety events involve implantable devices, linking to the specific UDI record provides complete device traceability required by FDA MedWatch reporting and enables correlation with manufacturer re']
  visit_id varchar [note: 'Reference to the clinical encounter (Admit-Discharge-Transfer event) during which the patient safety event occurred. Supports linkage to Admit Discharge Transfer (ADT) data for context.']
  action_plan_completion_date date [note: 'Actual date on which all corrective action plan items were completed and implemented. Used to confirm closure of the safety event lifecycle.']
  action_plan_due_date date [note: 'Target date by which all corrective action plan items must be completed. Submitted to TJC as part of the sentinel event response package.']
  action_plan_status varchar [note: 'Current completion status of the corrective action plan. Tracks progress from initiation through implementation and effectiveness verification. Drives quality management follow-up workflows.']
  action_plan_summary varchar [note: 'Narrative summary of the corrective action plan developed in response to the root cause analysis findings. Describes systemic changes, process improvements, and preventive measures to be implemented.']
  confidentiality_indicator boolean [note: 'Indicates whether this safety event record is protected under peer review or quality assurance confidentiality statutes, which may restrict discoverability in legal proceedings. Varies by state law.']
  contributing_factors_summary varchar [note: 'Narrative summary of the contributing factors identified at the time of initial event report, prior to formal Root Cause Analysis (RCA). May be updated as investigation progresses. Supports early causal analysis.']
  created_timestamp timestamp [note: 'Timestamp when this patient safety event record was first created in the data system. Audit trail field for data governance and HIPAA compliance.']
  disclosure_date date [note: 'Date on which the patient and/or family were formally informed of the safety event and its circumstances. Required for TJC accreditation and CMS Conditions of Participation compliance.']
  disclosure_status varchar [note: 'Status of the patient and/or family disclosure process for this safety event. Tracks whether disclosure has been completed per TJC and CMS requirements for transparent communication of unanticipated outcomes.']
  effectiveness_verification_date date [note: 'Date on which the effectiveness of the corrective action plan was formally verified and documented. Confirms that implemented changes achieved the intended safety improvement. Required for TJC sentinel event closure.']
  effectiveness_verified boolean [note: 'Indicates whether the corrective action plan has been formally verified as effective in preventing recurrence of the safety event. Required for TJC sentinel event final closure.']
  event_category varchar [note: 'Standardized category of the safety event per AHRQ Common Formats taxonomy (e.g., medication or other substance, fall, pressure ulcer, surgery or anesthesia, healthcare-associated infection, perinatal, device or medical/surgical supply, blood or blood product, environment or infrastructure). [ENUM-REF-CANDIDATE: medication_or_substance|fall|pressure_ulcer|surgery_or_anesthesia|healthcare_associated_infection|perinatal|device_or_supply|blood_or_blood_product|environment_or_infrastructure|other — promote to reference product]']
  event_description varchar [note: 'Free-text narrative description of what occurred during the patient safety event, including the sequence of events, conditions at the time, and immediate context. Contains Protected Health Information (PHI). Used in Root Cause Analysis (RCA) and regulatory reporting.']
  event_number varchar [note: 'Externally-known, human-readable identifier assigned to the safety event at time of report (e.g., PSE-2024-00342). Used for cross-system reference, regulatory submissions, and communication with TJC or CMS.']
  event_status varchar [note: 'Current lifecycle status of the patient safety event from initial report through investigation closure. Drives workflow routing in the safety event management system.']
  event_timestamp timestamp [note: 'Date and time when the patient safety event actually occurred (real-world event time). Distinct from the report timestamp. Critical for timeline reconstruction during Root Cause Analysis (RCA).']
  event_type varchar [note: 'Classification of the safety event by severity tier. Sentinel events require TJC review and root cause analysis (RCA). Near misses and unsafe conditions support proactive safety culture. [ENUM-REF-CANDIDATE: sentinel_event|serious_safety_event|near_miss|unsafe_condition|no_harm_event — promote to reference product if additional types are needed]']
  hai_event_type varchar [note: 'If the safety event involves a Healthcare-Associated Infection (HAI), specifies the HAI type: Central Line-Associated Bloodstream Infection (CLABSI), Catheter-Associated Urinary Tract Infection (CAUTI), Surgical Site Infection (SSI), Ventilator-Associated Pneumonia (VAP), C. difficile (CDIFF), or none. Supports CDC NHSN reporting.']
  harm_level_code varchar [note: 'Harm level assigned to the event using the National Coordinating Council for Medication Error Reporting and Prevention (NCC MERP) index or equivalent Severity of Harm scale. Categories A–I represent no harm through death. Values A–F shown; full scale: [ENUM-REF-CANDIDATE: A|B|C|D|E|F|G|H|I — promote to reference product]']
  harm_level_description varchar [note: 'Human-readable description of the harm level assigned (e.g., \'Reached the patient and required intervention to preclude harm\', \'Contributed to or resulted in permanent patient harm\'). Complements the NCC MERP code for reporting and disclosure.']
  immediate_actions_taken varchar [note: 'Free-text description of the immediate clinical and administrative actions taken at the time of the event to mitigate harm (e.g., medication reversal, code response, physician notification, patient transfer). Captured at time of initial report.']
  is_cms_reportable boolean [note: 'Indicates whether this event must be reported to the Centers for Medicare and Medicaid Services (CMS) under Conditions of Participation or Value-Based Purchasing (VBP) quality reporting requirements.']
  is_sentinel_event boolean [note: 'Indicates whether this patient safety event meets The Joint Commission (TJC) definition of a sentinel event requiring formal review and root cause analysis submission. Drives TJC reporting workflow.']
  is_state_reportable boolean [note: 'Indicates whether this event must be reported to the applicable State Department of Health under mandatory adverse event reporting laws. State reporting requirements vary by jurisdiction.']
  location_unit varchar [note: 'Clinical unit or department where the patient safety event occurred (e.g., ICU, ED, OR, Medical-Surgical Unit, Pharmacy). Supports unit-level safety performance analysis and TJC survey readiness.']
  patient_outcome varchar [note: 'Clinical outcome experienced by the patient as a result of the safety event. Drives regulatory reporting obligations and sentinel event classification. Contains Protected Health Information (PHI).']
  report_timestamp timestamp [note: 'Date and time when the patient safety event was formally reported into the safety event management system. Used to calculate reporting lag and compliance with internal reporting windows.']
  review_completion_date date [note: 'Actual date on which the formal investigation review was completed and findings were finalized. Used to calculate compliance with TJC 45-day RCA completion requirement.']
  review_due_date date [note: 'Target completion date for the formal investigation review. For TJC sentinel events, this is typically 45 days from event identification. Drives escalation and compliance tracking.']
  review_start_date date [note: 'Date on which the formal investigation review (RCA, ACA, or peer review) was initiated. TJC requires RCA completion within 45 days of sentinel event identification.']
  review_team_members varchar [note: 'Comma-separated list of names or role titles of individuals who participated in the formal investigation review team (RCA or ACA). Supports accountability tracking and TJC documentation requirements.']
  review_type varchar [note: 'Type of formal investigation review conducted for this event. Root Cause Analysis (RCA) is required for TJC sentinel events. Apparent Cause Analysis (ACA) is used for less severe events. Apparent Cause Analysis is a lighter-weight structured review.']
  root_causes_identified varchar [note: 'Narrative summary of the root causes identified through the formal Root Cause Analysis (RCA) or Apparent Cause Analysis (ACA). Documents the fundamental systemic factors that allowed the event to occur. Supports action plan development.']
  source_event_reference varchar [note: 'Original identifier of the patient safety event in the source operational system (e.g., Epic incident report ID, RL Solutions event number). Enables traceability back to the system of record.']
  tjc_acknowledgment_date date [note: 'Date on which The Joint Commission (TJC) formally acknowledged receipt and acceptance of the sentinel event RCA submission. Marks completion of the TJC reporting obligation.']
  tjc_submission_date date [note: 'Date on which the sentinel event report and Root Cause Analysis (RCA) action plan were formally submitted to The Joint Commission (TJC). Required for TJC accreditation compliance.']
  updated_timestamp timestamp [note: 'Timestamp when this patient safety event record was most recently modified. Supports audit trail, change tracking, and incremental ETL processing.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Patient safety events including falls, medication errors, HAIs, and other adverse events.'
}

Table quality.safety_event_review {
  safety_event_review_id varchar [pk, note: 'Unique surrogate identifier for the safety event review record. Primary key for the safety_event_review data product in the quality domain.']
  care_site_id varchar [note: 'Identifier of the healthcare facility (hospital, clinic, outpatient center) where the safety event and subsequent review occurred.']
  committee_id varchar [note: 'Foreign key linking to quality.committee. Business justification: Safety event reviews (RCA/ACA) are conducted by or presented to committees (e.g., Patient Safety Committee, Risk Management Committee). This FK enables tracking which committee conducted or reviewed t']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Safety event reviews generate corrective action plans that must be tracked in the compliance system for regulatory submission to CMS, TJC, and state agencies. CAPs require verification, monitoring, an']
  employee_id varchar [note: 'Identifier of the primary clinician, quality officer, or patient safety professional leading the RCA/ACA review team. Typically a physician, risk manager, or patient safety officer.']
  mpi_record_id varchar [note: 'Identifier of the patient involved in the safety event under review. Protected Health Information (PHI) per HIPAA. Links to the patient master record.']
  patient_safety_event_id varchar [note: 'Reference to the originating patient safety event that triggered this review. Links the review record back to the reported safety event.']
  prior_review_safety_event_review_id varchar [note: 'Reference to a previous safety event review of the same event type, populated when recurrence_flag is True. Enables longitudinal tracking of recurring safety issues and effectiveness of prior corrective actions.']
  visit_id varchar [note: 'Reference to the clinical encounter (inpatient admission, ED visit, outpatient visit) during which the safety event occurred.']
  action_plan_completed_date date [note: 'Actual date on which all corrective action plan items were fully implemented. Used to measure timeliness of corrective action completion against the action_plan_due_date.']
  action_plan_due_date date [note: 'Target completion date for the overall corrective action plan. TJC requires action plan submission within 45 days of sentinel event determination. Drives compliance monitoring and escalation.']
  action_plan_status varchar [note: 'Current implementation status of the corrective action plan. Tracks whether corrective actions are on track, completed, or overdue relative to the action_plan_due_date.']
  action_plan_summary varchar [note: 'Narrative summary of the corrective action plan developed in response to the identified root causes. Describes systemic improvements, process changes, and preventive measures to reduce recurrence risk.']
  care_setting varchar [note: 'Clinical care setting where the safety event occurred (e.g., Inpatient unit, Emergency Department (ED), Intensive Care Unit (ICU), Operating Room (OR), Outpatient). Used for stratified safety analytics and benchmarking. [ENUM-REF-CANDIDATE: Inpatient|Emergency Department|ICU|Operating Room|Outpatient|Ambulatory|Long-Term Care — promote to reference product]']
  cms_reportable_flag boolean [note: 'Indicates whether this safety event requires reporting to the Centers for Medicare and Medicaid Services (CMS) under Conditions of Participation or Hospital-Acquired Condition (HAC) reduction program requirements.']
  contributing_factors_summary varchar [note: 'Narrative description of contributing factors identified during the review, including human factors, communication failures, equipment issues, environmental conditions, and organizational/system factors per TJC RCA framework.']
  created_timestamp timestamp [note: 'Timestamp when this safety event review record was first created in the system. Supports audit trail and data lineage requirements.']
  department_unit varchar [note: 'Name of the specific clinical department or nursing unit where the safety event occurred (e.g., 4 North Med/Surg, MICU, OR Suite 3). Supports unit-level safety performance reporting.']
  disclosure_date date [note: 'Date on which the safety event was disclosed to the patient and/or family. Populated when disclosure_to_patient_flag is True. Supports compliance with CMS and TJC patient rights requirements.']
  disclosure_to_patient_flag boolean [note: 'Indicates whether the safety event and its findings were disclosed to the patient and/or family per CMS Conditions of Participation and TJC patient rights standards. True = disclosure completed.']
  effectiveness_verification_date date [note: 'Date on which the effectiveness of the implemented corrective actions was formally assessed and documented. Supports TJC follow-up review requirements.']
  effectiveness_verification_notes varchar [note: 'Narrative documentation of the effectiveness verification findings, including metrics used, data reviewed, and conclusions drawn about whether corrective actions achieved the intended risk reduction.']
  effectiveness_verification_status varchar [note: 'Status of the post-implementation effectiveness check confirming whether corrective actions successfully reduced or eliminated the identified risk. TJC requires evidence of effectiveness measurement for sentinel event action plans.']
  event_category varchar [note: 'Severity classification of the patient safety event under review per TJC and AHRQ taxonomy. Sentinel Events require mandatory RCA and TJC reporting. Drives review type selection and regulatory notification obligations.']
  event_date date [note: 'Calendar date on which the patient safety event occurred. Used as the principal real-world event date for regulatory reporting timelines and trending analysis.']
  event_type_code varchar [note: 'Standardized code classifying the type of patient safety event (e.g., medication error, fall, wrong-site surgery, HAI, pressure injury) per AHRQ Common Formats or NQF Serious Reportable Events taxonomy.']
  event_type_description varchar [note: 'Human-readable description of the safety event type corresponding to the event_type_code. Provides narrative context for reporting and analytics.']
  hai_event_type varchar [note: 'If the safety event involves a Healthcare-Associated Infection (HAI), specifies the HAI type: Central Line-Associated Bloodstream Infection (CLABSI), Catheter-Associated Urinary Tract Infection (CAUTI), Surgical Site Infection (SSI), Ventilator-Associated Pneumonia (VAP), C. difficile (CDIFF), MRSA, or None. Supports CDC NHSN reporting. [ENUM-REF-CANDIDATE: CLABSI|CAUTI|SSI|VAP|CDIFF|MRSA|None — 7 candidates stripped; promote to reference product]']
  harm_level varchar [note: 'Severity of harm to the patient using the National Coordinating Council for Medication Error Reporting and Prevention (NCC MERP) Index or equivalent harm scale (E through I for harm-causing events). Drives regulatory reporting thresholds and review intensity. [ENUM-REF-CANDIDATE: E - Temporary Harm|F - Temporary Harm with Intervention|G - Permanent Harm|H - Life-Sustaining Intervention|I - Death — promote to reference product]']
  icd10_diagnosis_code varchar [note: 'ICD-10-CM diagnosis code most closely associated with the patient safety event or resulting harm. Used for clinical coding, regulatory reporting, and linkage to claims data for HAC identification.']
  patient_safety_indicator_code varchar [note: 'AHRQ Patient Safety Indicator (PSI) code associated with this safety event, if applicable (e.g., PSI-03 Pressure Ulcer, PSI-06 Iatrogenic Pneumothorax, PSI-90 Composite). Used for CMS VBP and MIPS quality reporting.']
  quality_committee_review_flag boolean [note: 'Indicates whether this safety event review was escalated to and reviewed by the hospital Quality Improvement Committee or Patient Safety Committee. Required for TJC governance and CMS QAPI program compliance.']
  recurrence_flag boolean [note: 'Indicates whether this safety event represents a recurrence of a previously reviewed event type within the same department or facility. True = recurrence detected. Triggers escalated review and pattern analysis.']
  review_approved_date date [note: 'Date on which the completed review findings and action plan were formally approved by the quality committee, patient safety officer, or governing body.']
  review_completed_date date [note: 'Date on which the safety event review (RCA/ACA) was formally completed and all findings documented. Used to measure compliance with TJC 45-day completion requirement.']
  review_initiated_date date [note: 'Date on which the formal Root Cause Analysis (RCA) or Apparent Cause Analysis (ACA) review process was officially initiated. TJC requires RCA initiation within 45 days of a sentinel event.']
  review_number varchar [note: 'Externally-known, human-readable business identifier for this safety event review (e.g., RCA-2024-00123). Used for tracking, reporting, and regulatory correspondence with TJC and CMS.']
  review_status varchar [note: 'Current lifecycle state of the safety event review workflow. Tracks progression from initiation through completion and closure for TJC survey readiness and CMS reporting.']
  review_team_composition varchar [note: 'Narrative description of the multidisciplinary review team members and their roles (e.g., physician, nurse, pharmacist, risk manager, quality officer, department director). TJC requires interdisciplinary team participation in RCA.']
  review_team_size varchar [note: 'Total number of individuals who participated in the formal safety event review team. Supports TJC interdisciplinary team composition compliance verification.']
  review_type varchar [note: 'Classification of the formal review methodology applied: Root Cause Analysis (RCA) for serious/sentinel events, Apparent Cause Analysis (ACA) for less severe events, Failure Mode and Effects Analysis (FMEA) for proactive risk, Peer Review for clinical quality, Mortality Review for unexpected deaths, or Near Miss Review. [ENUM-REF-CANDIDATE: RCA|ACA|FMEA|Peer Review|Mortality Review|Near Miss Review — promote to reference product]']
  risk_score varchar [note: 'Numeric risk priority score assigned to the safety event, typically calculated as Severity × Probability × Detectability (e.g., Risk Priority Number from FMEA methodology). Ranges typically 1–1000. Drives prioritization of corrective actions.']
  root_cause_category varchar [note: 'Primary categorical classification of the root cause per TJC RCA framework (e.g., Human Factors, Communication, Training, Environment/Equipment, Rules/Policies/Procedures, Fatigue, Assessment). [ENUM-REF-CANDIDATE: Human Factors|Communication|Training|Environment|Equipment|Rules/Policies|Fatigue|Assessment — promote to reference product]']
  root_cause_summary varchar [note: 'Narrative summary of the primary root cause(s) identified through the Root Cause Analysis (RCA) or Apparent Cause Analysis (ACA) process. Documents the fundamental system or process failures that contributed to the event.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this safety event review record originated (e.g., Epic EHR, Cerner Millennium, RL Solutions patient safety event reporting system). Supports data lineage and ETL traceability. [ENUM-REF-CANDIDATE: Epic|Cerner|MEDITECH|RL Solutions|Quantros|Origami|Manual — 7 candidates stripped; promote to reference product]']
  state_reportable_flag boolean [note: 'Indicates whether this safety event meets state Department of Health mandatory adverse event reporting requirements. Reporting thresholds vary by state jurisdiction.']
  tjc_reportable_flag boolean [note: 'Indicates whether this safety event meets The Joint Commission (TJC) criteria for mandatory sentinel event reporting. True = TJC notification required within 5 business days of event determination.']
  tjc_reported_date date [note: 'Date on which the sentinel event was formally reported to The Joint Commission (TJC). Required for TJC accreditation compliance tracking. Null if tjc_reportable_flag is False.']
  updated_timestamp timestamp [note: 'Timestamp when this safety event review record was last modified. Supports audit trail, change tracking, and data lineage requirements.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Reviews and root cause analyses of patient safety events.'
}

Table quality.mortality_review {
  mortality_review_id varchar [pk, note: 'Unique surrogate identifier for each inpatient mortality review case record in the quality and peer review system. Primary key for the mortality_review data product.']
  care_site_id varchar [note: 'Reference to the facility (hospital or care site) where the patient death occurred. Supports multi-facility enterprise mortality reporting and CMS facility-level quality measure submission.']
  committee_id varchar [note: 'Reference to the peer review or quality committee responsible for conducting this mortality review. Supports committee-level workload tracking and governance reporting.']
  drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: Mortality reviews analyze DRG assignments to assess case mix impact on mortality rates and identify CMI documentation opportunities. Quality committees require DRG reference data for risk-adjusted mor']
  investigation_id varchar [note: 'Foreign key linking to compliance.investigation. Business justification: Mortality reviews identifying care quality issues, policy violations, or potential regulatory non-compliance trigger formal compliance investigations. Investigations assess whether deaths involve repo']
  mpi_record_id varchar [note: 'Reference to the patient who is the subject of this mortality review. Links to the Master Patient Index (MPI) record for demographic and identity context. Protected Health Information (PHI) under HIPAA.']
  primary_mortality_clinician_id varchar [note: 'Reference to the attending physician of record at the time of the patient\'s death. Used to associate the mortality event with the responsible clinician for peer review and quality reporting purposes.']
  review_consent_record_id varchar [note: 'Foreign key linking to consent.consent_record. Business justification: Mortality review committees requiring family interviews or extended record access beyond treatment scope need documented consent. Quality improvement activities involving patient/family contact requir']
  reviewer_provider_clinician_id varchar [note: 'Reference to the physician or clinical reviewer assigned as the primary reviewer for this mortality case. Supports peer review workload distribution and conflict-of-interest tracking.']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Mortality reviews analyze death patterns by specialty to identify specialty-specific quality improvement opportunities. CMS mortality measures and AHRQ PSIs are stratified by specialty for benchmarkin']
  subject_enrollment_id varchar [note: 'Foreign key linking to research.subject_enrollment. Business justification: Deaths of research subjects require mandatory mortality review with research-specific considerations: investigational product causality assessment, protocol adherence evaluation, and expedited reporti']
  udi_record_id varchar [note: 'Foreign key linking to supply.udi_record. Business justification: Mortality reviews involving implanted devices must trace the specific device for root cause analysis, correlation with known device issues, and potential recall investigation. Required for sentinel ev']
  unit_id varchar [note: 'Foreign key linking to facility.unit. Business justification: Mortality review committees analyze deaths by nursing unit to identify unit-specific care quality issues (ICU staffing, rapid response team effectiveness, palliative care access). Unit-level mortality']
  visit_id varchar [note: 'Reference to the inpatient encounter during which the patient death occurred. Links the mortality review to the originating clinical encounter for clinical context, LOS, and DRG data.']
  action_plan_due_date date [note: 'Target date by which the corrective action plan resulting from this mortality review must be submitted and implemented. Populated only when action_plan_required_flag is true.']
  action_plan_required_flag boolean [note: 'Indicates whether the peer review committee determined that a formal corrective action plan is required as a result of this mortality review. Triggers downstream quality improvement workflow and follow-up tracking.']
  care_quality_rating varchar [note: 'Peer review committee\'s overall rating of the quality of care provided during the encounter leading to death. Supports identification of systemic care delivery issues and drives Clinical Documentation Improvement (CDI) initiatives.']
  cdi_query_initiated_flag boolean [note: 'Indicates whether a Clinical Documentation Improvement (CDI) query was initiated as a result of this mortality review to clarify or improve clinical documentation for accurate ICD-10 coding and DRG assignment.']
  cmi_impact_flag boolean [note: 'Indicates whether this mortality case was identified as having a potential impact on the facility\'s Case Mix Index (CMI) due to coding gaps or Clinical Documentation Improvement (CDI) opportunities. Supports CDI program prioritization.']
  cms_mortality_measure_code varchar [note: 'Specific CMS mortality outcome measure identifier (e.g., MORT-30-AMI, MORT-30-HF, MORT-30-PN, MORT-30-COPD, MORT-30-STK) applicable to this mortality case. Populated when cms_mortality_measure_flag is true.']
  cms_mortality_measure_flag boolean [note: 'Indicates whether this mortality case is included in a CMS Hospital Inpatient Quality Reporting (IQR) mortality outcome measure (e.g., AMI-30-day, HF-30-day, PN-30-day mortality). Supports CMS quality program reporting and VBP scoring.']
  committee_findings_summary varchar [note: 'Narrative summary of the peer review committee\'s findings regarding the mortality case, including clinical assessment, care quality observations, and determination rationale. Protected under peer review privilege in most jurisdictions. Confidential business data.']
  committee_review_date date [note: 'Date on which the peer review committee formally convened to review this mortality case. Supports compliance tracking against medical staff bylaws and TJC peer review timeliness requirements.']
  confidentiality_protection_flag boolean [note: 'Indicates whether this mortality review record is protected under state peer review privilege statutes, restricting discoverability in legal proceedings. Critical for legal and compliance governance of peer review documentation.']
  contributing_factor_1 varchar [note: 'Primary contributing clinical factor identified by the peer review committee as having contributed to the patient\'s death (e.g., delayed diagnosis, medication error, communication failure, system failure). Supports root cause analysis and quality improvement planning.']
  contributing_factor_2 varchar [note: 'Secondary contributing clinical factor identified by the peer review committee. Captures additional systemic or clinical issues beyond the primary factor that contributed to the mortality outcome.']
  contributing_factor_3 varchar [note: 'Tertiary contributing clinical factor identified by the peer review committee. Supports comprehensive root cause analysis when multiple systemic issues are identified.']
  created_timestamp timestamp [note: 'Date and time when this mortality review record was first created in the quality management system. Supports audit trail, data lineage, and Silver layer ingestion tracking.']
  days_from_admission_to_death varchar [note: 'Number of days elapsed between the patient\'s admission date and the date of death. Supports Length of Stay (LOS) analysis, early mortality detection (death within 24-48 hours), and CMS mortality outcome measure stratification.']
  death_classification varchar [note: 'Clinical classification of the death as expected (consistent with terminal prognosis or end-of-life care plan) or unexpected (unanticipated given the patient\'s clinical condition). Core field for CMS mortality outcome measures and peer review triage.']
  death_date date [note: 'Calendar date on which the patient death occurred. Principal real-world event date for the mortality review. Used in CMS mortality outcome measure calculations and TJC accreditation reporting. PHI under HIPAA.']
  death_location_type varchar [note: 'Clinical care setting within the facility where the patient death occurred (e.g., ICU, ED, OR, inpatient unit). Supports unit-level mortality analysis and identification of high-risk care areas. [ENUM-REF-CANDIDATE: inpatient_unit|icu|ed|or|pacu|step_down|other — promote to reference product]']
  death_timestamp timestamp [note: 'Precise date and time of patient death as documented in the Electronic Health Record (EHR). Used for time-of-day analysis, shift-level mortality reporting, and clinical event sequencing. PHI under HIPAA.']
  dnr_status_at_death varchar [note: 'Patient\'s resuscitation code status at the time of death as documented in the EHR. Informs the expected vs. unexpected death classification and supports advance directive compliance review. Relevant to EMTALA and CMS Patient Rights Conditions of Participation.']
  hai_related_flag boolean [note: 'Indicates whether a Healthcare-Associated Infection (HAI) — such as CLABSI, CAUTI, or SSI — was identified as a contributing factor to the patient\'s death. Supports HAI mortality linkage reporting to CMS and CDC National Healthcare Safety Network (NHSN).']
  hai_type varchar [note: 'Specific type of Healthcare-Associated Infection (HAI) linked to this mortality case when hai_related_flag is true. Values include CLABSI (Central Line-Associated Bloodstream Infection), CAUTI (Catheter-Associated Urinary Tract Infection), SSI (Surgical Site Infection), C. diff, VAP, MRSA. [ENUM-REF-CANDIDATE: clabsi|cauti|ssi|cdiff|vap|mrsa|other — promote to reference product]']
  hospice_enrolled_flag boolean [note: 'Indicates whether the patient was enrolled in a hospice program at the time of or prior to the encounter. Supports expected death classification and CMS hospice quality reporting.']
  improvement_recommendation varchar [note: 'Narrative description of quality improvement recommendations issued by the peer review committee as a result of this mortality review. Drives performance improvement plans and TJC survey readiness activities. Protected under peer review privilege.']
  mips_reportable_flag boolean [note: 'Indicates whether this mortality case is reportable under the Merit-Based Incentive Payment System (MIPS) quality performance category for the attending provider. Supports MACRA/MIPS compliance tracking.']
  palliative_care_involved_flag boolean [note: 'Indicates whether the palliative care team was involved in the patient\'s care during the encounter. Supports expected death classification validation and end-of-life care quality metrics.']
  preventability_determination varchar [note: 'Peer review committee\'s determination of whether the death was preventable, potentially preventable, not preventable, or indeterminate based on clinical evidence review. Core outcome field for quality improvement and CMS Value-Based Purchasing (VBP) reporting.']
  primary_cause_of_death_description varchar [note: 'Plain-language description of the primary underlying cause of death corresponding to the ICD-10 code. Supports readability in committee reports and regulatory submissions without requiring code lookup.']
  primary_icd10_cause_of_death varchar [note: 'International Classification of Diseases 10th Revision (ICD-10) code representing the primary underlying cause of death as coded by Health Information Management (HIM). Used for mortality statistics, DRG grouping, and CMS quality measure reporting.']
  readmission_related_flag boolean [note: 'Indicates whether the patient was readmitted within 30 days of a prior discharge and died during the readmission encounter. Supports CMS Hospital Readmissions Reduction Program (HRRP) mortality linkage analysis.']
  review_case_number varchar [note: 'Externally-known alphanumeric case number assigned by the quality department or peer review committee to uniquely identify and track this mortality review case across systems and correspondence.']
  review_completed_date date [note: 'Date on which the mortality review was formally completed and findings were finalized by the peer review committee. Used to calculate review cycle time and SLA compliance.']
  review_initiated_date date [note: 'Date on which the formal mortality review process was initiated by the quality department. Used to measure timeliness of review initiation against TJC and internal SLA standards.']
  review_status varchar [note: 'Current workflow lifecycle state of the mortality review case. Tracks progression from initial case opening through committee review to final closure. Drives quality dashboard reporting and SLA compliance.']
  review_trigger_type varchar [note: 'Criterion or event that triggered the formal mortality review (e.g., unexpected death, post-surgical death, death within 24 hours of admission, Against Medical Advice (AMA) discharge followed by death, readmission death). Determines review pathway and committee assignment. [ENUM-REF-CANDIDATE: unexpected_death|surgical_death|icu_death|ed_death|readmission_death|ama_death|other — promote to reference product]']
  root_cause_analysis_required_flag boolean [note: 'Indicates whether a formal Root Cause Analysis (RCA) has been mandated for this mortality case, either due to sentinel event classification or internal quality policy. Triggers RCA workflow in the quality management system.']
  sentinel_event_flag boolean [note: 'Indicates whether this mortality case has been classified as a TJC Sentinel Event requiring a formal Root Cause Analysis (RCA) and corrective action plan submission to The Joint Commission.']
  surgical_case_flag boolean [note: 'Indicates whether the patient underwent a surgical procedure during the encounter associated with this mortality review. Triggers AHRQ PSI-04 (Death Among Surgical Inpatients) measure inclusion and surgical mortality peer review pathway.']
  updated_timestamp timestamp [note: 'Date and time when this mortality review record was most recently modified. Supports change tracking, audit compliance, and incremental data pipeline processing in the Databricks Silver layer.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Mortality review records for quality improvement and peer review.'
}

Table quality.vbp_program {
  vbp_program_id varchar [pk, note: 'Unique surrogate identifier for a CMS Value-Based Purchasing (VBP) program record. Primary key for this master configuration entity.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: VBP programs are payer-sponsored quality initiatives. Each program is administered by a specific payer for their contracted providers. Payer defines measure set, payment methodology, and performance t']
  quality_program_id varchar [note: 'Foreign key linking to quality.quality_program. Business justification: vbp_program represents specific VBP (Value-Based Purchasing) program instances, while quality_program is the master portfolio entity for all quality programs. This FK connects VBP programs to the broa']
  raf_score_id varchar [note: 'Vibe-added attribute for quality VBC/MIPS expansion.']
  achievement_benchmark_percentile decimal(5,2) [note: 'National performance percentile representing the benchmark (top performance) for achievement scoring. Typically set at the 95th percentile of baseline period national performance.']
  achievement_threshold_percentile decimal(5,2) [note: 'National performance percentile that a hospital must exceed to earn achievement points for a given measure. Typically set at the 50th percentile of baseline period national performance.']
  apm_participant_registry_code varchar [note: 'Vibe-added attribute for quality VBC/MIPS expansion.']
  applicable_provider_type varchar [note: 'Type of healthcare provider or facility to which this VBP program configuration applies. Determines eligibility rules, measure sets, and payment adjustment calculations. [ENUM-REF-CANDIDATE: acute_care_hospital|critical_access_hospital|psychiatric_hospital|long_term_care|skilled_nursing_facility|home_health_agency — promote to reference product]']
  approved_by varchar [note: 'Name or identifier of the quality leadership role (e.g., Chief Quality Officer, VP Quality) who approved this VBP program configuration for use in performance tracking and reporting.']
  approved_date date [note: 'Date on which the VBP program configuration was formally approved by quality leadership for operational use. Supports governance and audit trail requirements.']
  baseline_period_end date [note: 'End date of the baseline period used to establish benchmark performance scores for achievement scoring calculations.']
  baseline_period_start date [note: 'Start date of the baseline period used to establish benchmark performance scores against which the performance period is compared for achievement scoring.']
  benchmark_score decimal(5,2) [note: 'Benchmark score for comparison.']
  cahps_survey_vendor_required boolean [note: 'Indicates whether hospitals must use a CMS-approved CAHPS survey vendor to collect patient experience data for the Person and Community Engagement domain. True for HVBP programs.']
  clinical_outcomes_domain_weight decimal(5,4) [note: 'Proportional weight assigned to the Clinical Outcomes domain in the Total Performance Score (TPS) calculation, expressed as a decimal (e.g., 0.25 = 25%). Includes mortality, complications, and readmission measures.']
  cms_program_code varchar [note: 'Official CMS-assigned program identifier used in federal regulatory filings, CMS Quality Reporting systems, and QualityNet submissions. Serves as the external reference key for CMS correspondence.']
  correction_window_end date [note: 'Deadline by which hospitals must submit data corrections or reconsideration requests following the preview report release. After this date, scores are finalized for payment adjustment calculation.']
  created_timestamp timestamp [note: 'Timestamp when this VBP program configuration record was first created in the system. Supports audit trail and data lineage requirements.']
  efficiency_cost_reduction_weight decimal(5,4) [note: 'Proportional weight assigned to the Efficiency and Cost Reduction domain in the TPS calculation, expressed as a decimal (e.g., 0.25 = 25%). Includes Medicare Spending Per Beneficiary (MSPB) measure.']
  federal_register_notice varchar [note: 'Federal Register citation (volume, page, and date) for the CMS IPPS Final Rule that established this program year\'s VBP parameters (e.g., \'88 FR 49000, July 31, 2023\'). Supports regulatory audit trail.']
  final_score_publication_date date [note: 'Date on which CMS publicly releases final Total Performance Scores (TPS) and payment adjustment factors for all participating hospitals. Triggers the payment adjustment application in the payment year.']
  fiscal_year varchar [note: 'Federal fiscal year (October 1 – September 30) to which this VBP program configuration applies (e.g., 2024 for FY2024). Drives payment adjustment calculations and performance period alignment.']
  is_new_measure_set boolean [note: 'Indicates whether this program year introduces a new or substantially revised measure set compared to the prior fiscal year. Triggers additional staff education, CDI workflow updates, and quality committee review.']
  max_achievement_points varchar [note: 'Maximum number of achievement points a hospital can earn per measure under the VBP scoring methodology (typically 10 points).']
  max_domain_score varchar [note: 'Maximum possible score achievable within any single domain before weighting is applied. Used to normalize domain scores to a common scale for TPS calculation.']
  max_improvement_points varchar [note: 'Maximum number of improvement points a hospital can earn per measure under the VBP scoring methodology (typically 9 points).']
  max_payment_adjustment_factor decimal(6,4) [note: 'Maximum payment adjustment factor (multiplier) that can be applied to a hospital\'s Medicare IPPS payments under this program year. Values above 1.0000 represent a net payment bonus.']
  max_tps varchar [note: 'Maximum possible Total Performance Score (TPS) a hospital can achieve under this program year configuration. Defines the upper bound for payment adjustment factor calculations.']
  measure_set_version varchar [note: 'Version identifier of the CMS-published measure set applicable to this program year (e.g., \'FY2024-v1.2\'). Tracks changes in included measures, specifications, and exclusion criteria across program years.']
  measurement_year varchar [note: 'Performance measurement year.']
  min_case_volume_required varchar [note: 'Minimum number of eligible cases required for a measure to be scored for a hospital. Measures with case volumes below this threshold are suppressed from scoring to ensure statistical reliability.']
  min_measure_count_required varchar [note: 'Minimum number of measures a hospital must have reportable data for in order to receive a domain score and be included in VBP payment adjustment calculations. Hospitals below this threshold are excluded from VBP.']
  min_payment_adjustment_factor decimal(6,4) [note: 'Minimum payment adjustment factor (multiplier) that can be applied to a hospital\'s Medicare IPPS payments under this program year. Values below 1.0000 represent a net payment reduction.']
  nqf_alignment_flag boolean [note: 'Indicates whether all measures in this program year\'s measure set are endorsed by the National Quality Forum (NQF). NQF endorsement is a CMS requirement for VBP measure inclusion.']
  payment_adjustment_formula decimal(18,2) [note: 'Narrative or coded description of the formula used to translate the Total Performance Score (TPS) into a payment adjustment factor. Documents the linear exchange function parameters published in the CMS IPPS Final Rule.']
  payment_adjustment_rate decimal(5,4) [note: 'Payment adjustment rate based on performance.']
  payment_year decimal(18,2) [note: 'Federal fiscal year in which the VBP payment adjustment (bonus or penalty) is applied to Medicare IPPS payments. Typically lags the performance period by approximately two years.']
  performance_period_end date [note: 'End date of the performance period during which hospital quality data is collected and measured for VBP scoring.']
  performance_period_start date [note: 'Start date of the performance period during which hospital quality data is collected and measured for VBP scoring. Distinct from the baseline period.']
  performance_score decimal(5,2) [note: 'Overall program performance score.']
  person_community_engagement_weight decimal(5,4) [note: 'Proportional weight assigned to the Person and Community Engagement domain (formerly Patient Experience / CAHPS) in the TPS calculation, expressed as a decimal (e.g., 0.25 = 25%).']
  preview_report_release_date date [note: 'Date on which CMS releases preliminary VBP performance scores to hospitals for review and correction prior to final score publication. Hospitals have a defined review and correction window following this date.']
  program_code varchar [note: 'Externally-known CMS-assigned alphanumeric code uniquely identifying this VBP program configuration (e.g., VBP-IPPS-2024). Used in CMS reporting submissions and regulatory correspondence.']
  program_description varchar [note: 'Free-text narrative description of the VBP program year configuration, including key policy changes from the prior year, new measures added, measures removed, and notable methodology updates.']
  program_name varchar [note: 'Official CMS-designated name of the VBP program (e.g., \'Hospital Value-Based Purchasing Program FY2024\'). Used in regulatory reports, dashboards, and executive communications.']
  program_status varchar [note: 'Current lifecycle state of the VBP program configuration. \'active\' indicates the program is in effect for the current fiscal year; \'pending\' indicates approved but not yet effective; \'archived\' indicates a prior program year record retained for historical reference.']
  program_type varchar [note: 'Classification of the VBP program variant: HVBP (Hospital VBP), PVBP (Physician VBP), ESRD_QIP (End-Stage Renal Disease Quality Incentive Program), SNF_VBP (Skilled Nursing Facility VBP), HH_VBP (Home Health VBP). Determines applicable domain weights and scoring methodology.']
  qualitynet_program_code varchar [note: 'Program code used within the CMS QualityNet reporting portal for data submission, preview reports, and final VBP scoring. Required for electronic data interchange with CMS.']
  regulatory_rule_citation varchar [note: 'Primary federal regulatory citation governing this VBP program year (e.g., \'42 CFR Part 412 Subpart O\'). Used for compliance documentation, audit support, and regulatory reporting.']
  safety_domain_weight decimal(5,4) [note: 'Proportional weight assigned to the Safety domain in the TPS calculation, expressed as a decimal (e.g., 0.25 = 25%). Includes HAI measures such as CLABSI, CAUTI, SSI, and MRSA.']
  total_domain_weight_check decimal(5,4) [note: 'Sum of all four domain weights (clinical outcomes + person and community engagement + safety + efficiency and cost reduction). Must equal 1.0000 (100%) for a valid program configuration. Used for data quality validation and audit.']
  tps_methodology varchar [note: 'Scoring methodology used to calculate the Total Performance Score (TPS). \'achievement_improvement_higher\' selects the higher of achievement or improvement scores per measure; \'achievement_only\' uses only achievement; \'improvement_only\' uses only improvement.']
  updated_timestamp timestamp [note: 'Timestamp when this VBP program configuration record was most recently modified. Supports change tracking, audit trail, and data lineage requirements.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']
  withhold_rate decimal(5,4) [note: 'Percentage of Medicare IPPS base operating DRG payments withheld from all participating hospitals to fund the VBP incentive pool, expressed as a decimal (e.g., 0.0200 = 2.0%). Established annually by CMS per ACA mandate.']

  Note: 'Value-Based Purchasing program definitions and configurations.'
}

Table quality.measure {
  measure_id varchar [pk, note: 'Primary key for measure']
  attribution_id varchar [note: 'Vibe-added attribute for quality VBC/MIPS expansion.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Quality measures require policy documentation for implementation, data collection procedures, numerator/denominator definitions, and compliance with regulatory specifications. Policies govern how meas']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Quality measures reference CPT code sets in cpt_code_set attribute for procedure-based numerator/denominator definitions. MIPS quality category scoring and VBP clinical outcomes domain require validat']
  drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: Quality measures are stratified by DRG for risk adjustment in hospital quality reporting. CMS Hospital Compare and VBP programs require DRG-level risk adjustment to ensure fair performance comparisons']
  health_plan_id varchar [note: 'Foreign key linking to insurance.health_plan. Business justification: Quality measures are often plan-specific (HEDIS measures vary by product line: Commercial, Medicare, Medicaid). Plans report measure performance to NCQA and CMS for accreditation and Star Ratings.']
  hedis_measure_id varchar [note: 'NCQA-assigned HEDIS measure identifier (e.g., CDC, CBP, W34). Populated only for measures that are part of the HEDIS measure set. Supports NCQA accreditation and health plan reporting.']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Quality measures reference ICD-10 code sets in icd10_code_set attribute for eligible population and exclusion criteria definitions. CMS, MIPS, and TJC quality reporting require validated ICD code refe']
  loinc_code_id varchar [note: 'Foreign key linking to reference.loinc_code. Business justification: Quality measures reference LOINC code sets in loinc_code_set attribute for lab-based quality metrics (e.g., diabetes control, lipid management). eCQM reporting and clinical quality improvement initiat']
  mips_clinician_measure_id varchar [note: 'Vibe-added attribute for quality VBC/MIPS expansion.']
  active_status varchar [note: 'Current lifecycle status of the measure in the enterprise catalog: active (currently tracked and reported), inactive (temporarily suspended), retired (no longer in use), draft (under development), or under_review (specification being updated).']
  benchmark_percentile decimal(5,2) [note: 'National percentile rank corresponding to the benchmark threshold (e.g., 75.00 for the 75th percentile). Used to contextualize organizational performance against national peer comparisons in VBP and MIPS scoring.']
  benchmark_threshold decimal(5,2) [note: 'National or program-defined benchmark performance rate (expressed as a percentage, 0.00–100.00) that the organization targets or must meet for this measure (e.g., 75.00 for 75%). Used in Value-Based Purchasing (VBP) and MIPS scoring.']
  care_gap_closure_id varchar [note: 'Vibe-added attribute for quality VBC/MIPS expansion.']
  care_setting varchar [note: 'Clinical care setting to which the measure applies (e.g., inpatient, outpatient, ED, ambulatory, post-acute, home health, hospice, or all settings). Drives measure applicability filtering in reporting. [ENUM-REF-CANDIDATE: inpatient|outpatient|ED|ambulatory|post_acute|home_health|hospice|all — 8 candidates stripped; promote to reference product]']
  clinical_domain varchar [note: 'Clinical or programmatic domain the measure belongs to (e.g., Cardiovascular, Diabetes, Infection Control, Maternal Health, Behavioral Health, Patient Safety, Preventive Care). Used for grouping and filtering in quality dashboards. [ENUM-REF-CANDIDATE: cardiovascular|diabetes|infection_control|maternal_health|behavioral_health|patient_safety|preventive_care|oncology|respiratory|orthopedics — promote to reference product]']
  cms_ecqm_code varchar [note: 'CMS-assigned electronic Clinical Quality Measure (eCQM) identifier (e.g., CMS122v11). Used for electronic submission to CMS quality reporting programs including MIPS and IQR.']
  cpt_code_set varchar [note: 'Comma-separated list or value set reference of CPT procedure codes used in the measure logic (e.g., qualifying visit codes, procedure codes for numerator events). References the official value set OID where applicable.']
  created_timestamp timestamp [note: 'Timestamp when this measure record was first created in the enterprise quality catalog. Supports audit trail and data governance requirements.']
  data_source varchar [note: 'Primary source system or data type used to calculate the measure (e.g., EHR, claims, registry, survey, ADT, lab, pharmacy, manual abstraction, hybrid). Informs ETL pipeline design and data lineage. [ENUM-REF-CANDIDATE: EHR|claims|registry|survey|ADT|lab|pharmacy|manual|hybrid — 9 candidates stripped; promote to reference product]']
  denominator_definition varchar [note: 'Formal definition of the denominator population — the eligible patient or encounter population to which the measure applies (e.g., \'All patients aged 65+ with at least one qualifying visit during the measurement period\').']
  denominator_exception varchar [note: 'Criteria allowing removal of patients from the denominator for clinical or patient-choice reasons that do not constitute exclusions (e.g., \'Patient declined vaccination — documented medical reason\'). Distinct from exclusions; applies to process measures only.']
  denominator_exclusion varchar [note: 'Criteria for excluding patients or encounters from the denominator (e.g., \'Patients with documented allergy to influenza vaccine\'). Null if no exclusions apply. Critical for accurate measure calculation.']
  effective_end_date date [note: 'Date on which this measure was retired or deactivated in the enterprise quality catalog. Null for currently active measures. Enables point-in-time historical reporting.']
  effective_start_date date [note: 'Date on which this measure became effective and active in the enterprise quality catalog. Supports historical trending and measure lifecycle management.']
  eligible_population_criteria varchar [note: 'Initial patient population criteria defining who is eligible to be included in the measure calculation (age range, diagnosis codes, encounter types, payer types, etc.). Serves as the outermost filter before denominator logic is applied.']
  floor_threshold decimal(5,2) [note: 'Minimum acceptable performance rate (as a percentage) below which the organization is subject to payment penalties or accreditation risk. Distinct from the benchmark target; represents the regulatory floor.']
  hai_category varchar [note: 'For HAI-related measures, identifies the specific infection type tracked: CLABSI (Central Line-Associated Bloodstream Infection), CAUTI (Catheter-Associated Urinary Tract Infection), SSI (Surgical Site Infection), MRSA, CDI (C. difficile), VAE (Ventilator-Associated Event), or NONE for non-HAI measures. [ENUM-REF-CANDIDATE: CLABSI|CAUTI|SSI|MRSA|CDI|VAE|NONE — 7 candidates stripped; promote to reference product]']
  higher_is_better boolean [note: 'Indicates whether a higher measure rate represents better performance (True) or worse performance (False). For example, vaccination rates are higher-is-better; readmission rates are lower-is-better. Critical for correct performance scoring logic.']
  icd10_code_set varchar [note: 'Comma-separated list or value set reference of ICD-10 diagnosis codes used in the measure\'s eligible population, numerator, or denominator logic (e.g., \'E11.9, E11.65\'). References the official value set OID where applicable.']
  is_active boolean [note: 'Whether measure is currently active.']
  loinc_code_set varchar [note: 'Comma-separated list or value set reference of LOINC codes used in the measure logic for laboratory results, clinical observations, or survey instruments (e.g., HbA1c result codes for diabetes measures).']
  measure_code varchar [note: 'Internally assigned alphanumeric code uniquely identifying the measure within the enterprise catalog. Used as the business-facing key across reporting systems and dashboards.']
  measure_name varchar [note: 'Full name of the quality measure.']
  measure_type varchar [note: 'Classification of the measure by its methodological type per NQF/CMS taxonomy: process (care delivery steps), outcome (patient results), structural (organizational capacity), patient experience (CAHPS-based), efficiency (resource use), or intermediate outcome.']
  measurement_methodology varchar [note: 'Data collection and calculation methodology used for the measure: administrative (claims/ADT data), hybrid (claims + chart review), chart_abstracted (manual chart review), ecqm (electronic clinical quality measure via EHR), survey (patient-reported, e.g., CAHPS), or registry.']
  measurement_year varchar [note: 'Calendar year for which the measure is being tracked and reported (e.g., 2024). Used to version measure performance results and align with annual reporting cycles.']
  minimum_sample_size varchar [note: 'Minimum number of eligible patients or encounters required for the measure result to be reportable and statistically valid. Results below this threshold are typically suppressed in public reporting.']
  mips_category varchar [note: 'MIPS performance category to which this measure contributes: quality, promoting_interoperability, improvement_activities, cost, or NONE if not applicable to MIPS. Supports MACRA/MIPS composite score calculation for eligible clinicians.']
  nqf_number varchar [note: 'National Quality Forum (NQF) endorsement number assigned to the measure (e.g., NQF-0028). Null if the measure is not NQF-endorsed. Used for regulatory alignment and cross-program mapping.']
  numerator_definition varchar [note: 'Formal definition of the numerator population for the measure — the subset of the denominator that meets the quality criterion (e.g., \'Patients who received a flu vaccination during the measurement period\'). Derived from the official measure specification.']
  reporting_period_end date [note: 'Last date of the measurement/reporting period during which patient encounters and events are evaluated for this measure (e.g., 2024-12-31 for an annual measure).']
  reporting_period_start date [note: 'First date of the measurement/reporting period during which patient encounters and events are evaluated for this measure (e.g., 2024-01-01 for an annual measure).']
  reporting_period_type varchar [note: 'Annual, quarterly, monthly.']
  reporting_program varchar [note: 'Name of the regulatory or accreditation program under which this measure is reported (e.g., CMS IQR, CMS OQR, VBP, MIPS, HEDIS, TJC ORYX, State Medicaid, Internal). A measure may belong to multiple programs; this field captures the primary program. [ENUM-REF-CANDIDATE: CMS_IQR|CMS_OQR|VBP|MIPS|APM|HEDIS|TJC_ORYX|STATE|INTERNAL|PCMH — promote to reference product]']
  risk_adjustment_flag boolean [note: 'Indicates whether the measure requires risk adjustment to account for patient case mix before performance comparison (True = risk-adjusted). Applies to outcome measures such as mortality and readmission rates.']
  risk_adjustment_model varchar [note: 'Name or identifier of the risk adjustment model applied to this measure when risk_adjustment_flag is True (e.g., \'CMS Hierarchical Condition Category (HCC)\', \'AHRQ Elixhauser Comorbidity Index\'). Null if not risk-adjusted.']
  short_name varchar [note: 'Abbreviated or commonly used name for the measure used in dashboards, scorecards, and internal communications (e.g., \'Flu Vax — Elderly\').']
  snomed_code_set varchar [note: 'Comma-separated list or value set reference of SNOMED CT codes used in the measure logic for clinical findings, conditions, or procedures. Supports eCQM value set alignment.']
  specification_url varchar [note: 'URL link to the official published measure specification document or web page maintained by the measure steward (e.g., CMS eCQM library URL, NCQA HEDIS specification page). Enables direct reference to authoritative source.']
  steward varchar [note: 'Organization responsible for developing, maintaining, and publishing the measure specification (e.g., CMS, NCQA, TJC, NQF, AMA). Determines the authoritative source for measure updates and versioning. [ENUM-REF-CANDIDATE: CMS|NCQA|TJC|NQF|AMA|AHRQ|STATE|INTERNAL|OTHER — promote to reference product]']
  steward_organization varchar [note: 'Organization that stewards the measure.']
  stratification_criteria varchar [note: 'Defines how the measure is stratified for sub-group reporting (e.g., by race/ethnicity, payer type, age group, facility). Supports health equity reporting requirements and SDOH analytics per CMS health equity frameworks.']
  submission_deadline date [note: 'Date by which the measure results must be submitted to the applicable regulatory or accreditation body (e.g., CMS IQR submission deadline). Drives quality reporting workflow and compliance tracking.']
  title varchar [note: 'Official full title of the quality measure as published by the measure steward (e.g., \'Pneumonia Vaccination Status for Older Adults\'). Used in regulatory submissions and performance reports.']
  tjc_measure_set varchar [note: 'Name of The Joint Commission (TJC) ORYX measure set this measure belongs to (e.g., \'Perinatal Care\', \'Stroke\', \'Venous Thromboembolism\'). Null if not a TJC measure. Supports TJC accreditation survey readiness.']
  updated_timestamp timestamp [note: 'Timestamp when this measure record was last modified in the enterprise quality catalog. Tracks specification updates, benchmark changes, and status transitions.']
  vbp_domain varchar [note: 'CMS Hospital Value-Based Purchasing (VBP) program domain to which this measure is assigned: clinical_care, safety, efficiency (cost reduction), patient_experience (CAHPS), or NONE if not part of VBP. Drives VBP Total Performance Score calculation.']
  version varchar [note: 'Version number of the measure specification as published by the steward (e.g., \'11.0\', \'2024.1\'). Tracks specification changes year-over-year and ensures the correct logic version is applied during calculation.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Quality measure definitions across all programs (CMS, TJC, NCQA, etc.).'
}

Table quality.measure_result {
  measure_result_id varchar [pk, note: 'Unique surrogate identifier for each quality measure performance result record. Primary key for the measure_result data product.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: Quality measure results are subject to external audits by CMS, NCQA, TJC, and state agencies. Auditors validate data accuracy, methodology compliance, and calculation correctness. Linking results to a']
  billing_coverage_id varchar [note: 'Foreign key linking to billing.coverage. Business justification: Quality measure results are reported by payer and product line for value-based contracts. Linking enables payer-specific performance tracking, supports ACO and bundled payment reporting, and facilitat']
  care_gap_closure_id varchar [note: 'Vibe-added attribute for quality VBC/MIPS expansion.']
  care_site_id varchar [note: 'Reference to the facility (hospital, clinic, outpatient center) for which this measure result is reported.']
  claim_id varchar [note: 'Foreign key linking to claim.claim. Business justification: Quality measure results are calculated from underlying claims data. Healthcare audit and validation processes require tracing measure results back to source claims for numerator/denominator verificati']
  clinician_id varchar [note: 'Reference to the clinician or provider for whom this measure result is reported, applicable when measurement_level is \'provider\' (e.g., for MIPS individual reporting).']
  compliance_regulatory_submission_id varchar [note: 'Foreign key linking to compliance.regulatory_submission. Business justification: Quality measure results require regulatory submission to CMS (MIPS, HVBP), state agencies, TJC, and accrediting bodies. Compliance system tracks submission deadlines, attestations, acceptance status, ']
  drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: Measure results are stratified by DRG for case mix adjustment and comparative analysis in quality reporting. VBP payment adjustment calculations and Hospital Compare public reporting require DRG-level']
  health_plan_id varchar [note: 'Foreign key linking to insurance.health_plan. Business justification: Measure results are calculated at health plan level for Star Ratings, HEDIS reporting, and regulatory submissions. Plan-level results determine quality bonus payments and public ratings.']
  measure_id varchar [note: 'Reference to the quality measure definition (e.g., HEDIS, CMS IQR, MIPS measure) for which this result is recorded.']
  org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: Quality measure results are reported at organizational provider level for MIPS, VBP, and ACO programs. CMS requires organizational NPI for quality reporting submissions, distinct from facility-level c']
  payer_id varchar [note: 'Reference to the health plan or payer for which this measure result is reported, applicable when measurement_level is \'health_plan\' (e.g., HEDIS submission to a specific payer).']
  radiology_appointment_id varchar [note: 'Foreign key linking to radiology.appointment. Business justification: Imaging appointment no-show rates, wait times, and scheduling efficiency are access quality measures. Measure results must link to appointments for operational improvement and patient satisfaction tra']
  radiology_report_id varchar [note: 'Foreign key linking to radiology.report. Business justification: Report turnaround time, addendum rates, and critical finding communication timeliness are CMS and ACR quality measures. Measure results must link to reports for performance validation and peer compari']
  radiology_study_id varchar [note: 'Foreign key linking to radiology.study. Business justification: Quality measures for imaging appropriateness, turnaround time, and critical result notification are calculated from imaging studies. Measure results must trace to the studies included in numerator/den']
  raf_score_id varchar [note: 'Vibe-added attribute for quality VBC/MIPS expansion.']
  reader_assignment_id varchar [note: 'Foreign key linking to radiology.reader_assignment. Business justification: Radiologist productivity, turnaround time, and peer review scores are quality measures for OPPE/FPPE and privileging. Measure results must link to reader assignments for individual provider performanc']
  research_study_id varchar [note: 'Foreign key linking to research.research_study. Business justification: Quality measure results must exclude or separately report research subjects to prevent investigational interventions from skewing standard care performance metrics. CMS, NCQA, and TJC require research']
  service_id varchar [note: 'Foreign key linking to facility.facility_service. Business justification: Quality measure results reported at service line level (trauma, stroke, cardiac, oncology) for program-specific accreditation and CMS quality reporting. Service line leaders track program-specific mea']
  unit_id varchar [note: 'Reference to the clinical unit (e.g., ICU, ED, surgical unit) for which this measure result is reported, applicable when measurement_level is \'unit\'.']
  visit_procedure_id varchar [note: 'Foreign key linking to encounter.visit_procedure. Business justification: Quality measures require specific procedures for numerator compliance (colonoscopy for colorectal screening, HbA1c testing for diabetes control, mammography for breast cancer screening). Real business']
  benchmark_comparison_result varchar [note: 'Categorical comparison of this facility\'s performance rate against the national benchmark rate (above, at, or below benchmark). Supports executive dashboards and regulatory reporting summaries.']
  cms_submission_date date [note: 'The date on which this measure result was submitted to the Centers for Medicare and Medicaid Services (CMS) via the applicable quality reporting portal (e.g., QualityNet, MIPS submission system).']
  created_timestamp timestamp [note: 'The date and time when this measure result record was first created in the system.']
  data_completeness_rate decimal(7,4) [note: 'The proportion of eligible cases for which complete data was available for measure calculation. CMS requires a minimum data completeness threshold (typically 75%) for measure results to be publicly reported.']
  denominator_count varchar [note: 'The total number of eligible patients, encounters, or events in the initial patient population that meet the denominator criteria for this quality measure during the measurement period.']
  exception_count varchar [note: 'The number of patients or events meeting denominator exception criteria (e.g., patient declined, medical reason documented), distinct from exclusions. Applicable for MIPS and certain CMS measures.']
  exclusion_count varchar [note: 'The number of patients or events excluded from the denominator based on measure-defined exclusion criteria (e.g., medical contraindications, patient refusals, hospice enrollment).']
  gap_count varchar [note: 'The estimated number of additional patients or events that would need to meet the numerator criteria to achieve the target rate. Used for care gap closure prioritization in population health programs.']
  gap_to_target_rate decimal(7,4) [note: 'The arithmetic difference between the target_rate and the actual performance_rate (target_rate minus performance_rate). Positive values indicate underperformance; negative values indicate the target has been exceeded.']
  hai_event_type varchar [note: 'For HAI-related quality measures, specifies the type of healthcare-associated infection being tracked (Central Line-Associated Bloodstream Infection (CLABSI), Catheter-Associated Urinary Tract Infection (CAUTI), Surgical Site Infection (SSI), MRSA bacteremia, Clostridioides difficile (CDI)). Not applicable for non-HAI measures.']
  hedis_methodology_indicator boolean [note: 'For HEDIS measures, specifies whether the administrative or hybrid methodology was used for this result. The hybrid methodology supplements administrative data with medical record review to improve accuracy. Not applicable for non-HEDIS measures.']
  is_publicly_reported boolean [note: 'Indicates whether this measure result has been or is eligible to be publicly reported on CMS Care Compare, NCQA Health Plan Ratings, or other public transparency platforms.']
  measure_domain varchar [note: 'The clinical or operational domain to which the measure belongs (e.g., Patient Safety, Effectiveness of Care, Efficiency, Patient Experience, Care Coordination). [ENUM-REF-CANDIDATE: patient_safety|effectiveness|efficiency|patient_experience|care_coordination|timeliness|equity — promote to reference product]']
  measurement_level varchar [note: 'The organizational level at which this measure result is reported (facility, unit, provider, health plan, or population). Determines the granularity of the performance result.']
  measurement_methodology varchar [note: 'The data collection methodology used to calculate this measure result (administrative claims-based, hybrid combining claims and medical record review, chart-abstracted from medical records, registry-based, or direct EHR extraction). Impacts data completeness and comparability.']
  measurement_period_end_date date [note: 'The last date of the reporting/measurement period for which this quality measure result applies (e.g., December 31 of the performance year).']
  measurement_period_start_date date [note: 'The first date of the reporting/measurement period for which this quality measure result applies (e.g., January 1 of the performance year).']
  meets_reporting_threshold boolean [note: 'Indicates whether this measure result meets the minimum case volume and data completeness thresholds required for public reporting by CMS or the applicable program. Results not meeting thresholds are suppressed from public display.']
  mips_measure_category varchar [note: 'For MIPS-reported measures, the performance category under which this measure is reported (Quality, Promoting Interoperability, Improvement Activities, or Cost). Null for non-MIPS measures.']
  mips_points_earned decimal(7,2) [note: 'The number of MIPS performance points earned for this measure in the reporting period, used to calculate the composite MIPS performance score. Null for non-MIPS measures.']
  national_benchmark_rate decimal(7,4) [note: 'The national benchmark performance rate for this measure as published by the measure steward or CMS (e.g., HEDIS 90th percentile, CMS national average). Used for comparative performance analysis.']
  ncqa_submission_status varchar [note: 'The submission status of this measure result to the National Committee for Quality Assurance (NCQA) for HEDIS reporting and health plan accreditation purposes. Null for non-HEDIS measures.']
  nqf_number varchar [note: 'The National Quality Forum (NQF) endorsement number for this quality measure (e.g., NQF-0059 for Diabetes HbA1c Poor Control). Null if the measure is not NQF-endorsed.']
  numerator_count varchar [note: 'The number of patients, encounters, or events in the denominator that met the numerator criteria (i.e., received the desired care or outcome) for this quality measure.']
  payer_submission_status varchar [note: 'The submission status of this measure result to the applicable health plan or payer (e.g., commercial payer, Medicaid managed care organization). Tracks whether the result has been transmitted and acknowledged.']
  percentile_rank decimal(5,2) [note: 'The percentile rank of this facility\'s or provider\'s performance rate relative to national or peer benchmarks for this measure (e.g., 75.00 = 75th percentile nationally).']
  performance_rate decimal(7,4) [note: 'The calculated performance rate for this quality measure, expressed as a decimal proportion (numerator / adjusted denominator). For example, 0.8750 represents 87.50% compliance.']
  performance_year varchar [note: 'The calendar or fiscal year for which this quality measure result is being reported (e.g., 2024). Used for year-over-year trending and regulatory submission alignment.']
  reporting_program varchar [note: 'The quality reporting program under which this measure result is submitted (e.g., CMS Inpatient Quality Reporting (IQR), Outpatient Quality Reporting (OQR), Value-Based Purchasing (VBP), Merit-based Incentive Payment System (MIPS), HEDIS, state program, Alternative Payment Model (APM), CAHPS). [ENUM-REF-CANDIDATE: CMS_IQR|CMS_OQR|VBP|MIPS|HEDIS|STATE|APM|CAHPS — promote to reference product]']
  reporting_quarter varchar [note: 'The calendar quarter (1–4) within the performance year for which this measure result is reported, applicable for measures with quarterly reporting cycles (e.g., CMS OQR quarterly submissions).']
  result_calculated_timestamp timestamp [note: 'The date and time when this quality measure result was calculated or generated by the analytics or quality measurement system.']
  result_status varchar [note: 'Current lifecycle status of this measure result record (e.g., draft during calculation, final after internal validation, submitted to payer/CMS, accepted or rejected by the receiving entity, under_review for audit).']
  sir_value decimal(10,4) [note: 'The Standardized Infection Ratio (SIR) for HAI measures, calculated as observed infections divided by predicted infections based on national baseline data. A SIR below 1.0 indicates better-than-expected performance. Null for non-HAI measures.']
  target_rate decimal(7,4) [note: 'The internally established or externally mandated performance target rate for this measure in the given reporting period (e.g., organizational goal of 0.9000 for 90% compliance).']
  updated_timestamp timestamp [note: 'The date and time when this measure result record was last modified.']
  vbp_achievement_score decimal(7,4) [note: 'The CMS VBP domain-level achievement score for this measure, reflecting performance relative to national achievement thresholds and benchmarks. Null for non-VBP measures.']
  vbp_domain varchar [note: 'The CMS Value-Based Purchasing (VBP) program domain to which this measure belongs (e.g., Clinical Outcomes, Safety, Person and Community Engagement, Efficiency and Cost Reduction). Applicable only for VBP-reported measures. [ENUM-REF-CANDIDATE: clinical_outcomes|safety|person_community_engagement|efficiency_cost_reduction — promote to reference product]']
  vbp_improvement_score decimal(7,4) [note: 'The CMS VBP domain-level improvement score for this measure, reflecting performance improvement relative to the facility\'s own baseline performance. Null for non-VBP measures.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Calculated quality measure results for all programs.'
}

Table quality.cdi_review {
  cdi_review_id varchar [pk, note: 'Unique surrogate identifier for each CDI concurrent or retrospective chart review record. Primary key for the cdi_review data product.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: CDI reviews are subject to compliance audits for documentation integrity, query appropriateness, physician response rates, and DRG assignment accuracy. Audits by RACs, MACs, and OIG assess compliance ']
  care_site_id varchar [note: 'Reference to the hospital or care facility where the encounter and CDI review occurred.']
  cdi_worksheet_id varchar [note: 'Reference to the CDI worksheet record in the clinical.cdi_worksheet product used to document the structured review findings for this encounter.']
  clinician_id varchar [note: 'Reference to the attending physician responsible for the patient encounter being reviewed. Used for physician query response rate monitoring.']
  drg_assignment_id varchar [note: 'Foreign key linking to encounter.drg_assignment. Business justification: CDI reviews analyze specific DRG assignments to validate coding accuracy, identify documentation gaps, and track DRG changes. Real business process: CDI specialists review assigned DRGs, initiate quer']
  employee_id varchar [note: 'Reference to the CDI specialist or clinician who performed the chart review. Used for productivity tracking and reviewer credentialing.']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: CDI reviews directly impact final billing through DRG optimization and CC/MCC capture. The invoice reflects the financial outcome of CDI findings. Linking enables tracking of CDI program ROI, DRG chan']
  mpi_record_id varchar [note: 'Reference to the patient whose medical record is under CDI review. Protected Health Information (PHI) per HIPAA.']
  quality_program_id varchar [note: 'Foreign key linking to quality.quality_program. Business justification: cdi_review (Clinical Documentation Improvement reviews) currently has only cross-domain FKs and no in-domain quality relationship. CDI work is conducted under a quality/performance improvement program']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: CDI reviews target specialty-specific documentation patterns for DRG optimization. Cardiology, orthopedics, and other specialties have distinct documentation requirements for CC/MCC capture and CMI im']
  subject_enrollment_id varchar [note: 'Foreign key linking to research.subject_enrollment. Business justification: CDI reviews for research subjects require special handling because research protocols drive diagnoses, procedures, and documentation patterns that differ from standard care. Linkage prevents inappropr']
  unit_id varchar [note: 'Foreign key linking to facility.unit. Business justification: Clinical documentation improvement reviews analyzed by unit to identify unit-specific documentation gaps and physician education needs. CDI specialists target units with low CC/MCC capture rates and h']
  visit_id varchar [note: 'Reference to the inpatient or outpatient encounter being reviewed. Links the CDI review to the clinical encounter record.']
  working_drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: CDI reviews evaluate working DRG assignments during concurrent review to identify documentation improvement opportunities. CDI specialists must reference DRG definitions, relative weights, and CC/MCC ']
  admit_date date [note: 'Date the patient was admitted to the facility. Used to calculate review lag (days from admission to first CDI review) and concurrent review timeliness.']
  cc_mcc_opportunity_flag boolean [note: 'Indicates whether the CDI reviewer identified a potential CC or MCC capture opportunity requiring physician query or documentation clarification.']
  cc_mcc_status varchar [note: 'Indicates whether a Complication and Comorbidity (CC) or Major Complication and Comorbidity (MCC) was captured in the documentation at the time of review. Critical CDI metric driving DRG assignment and reimbursement.']
  clinical_indicator_summary varchar [note: 'Free-text summary of the clinical indicators identified in the medical record that support the CDI review finding or physician query. Documents the clinical basis for the query per AHIMA/ACDIS compliant query guidelines.']
  cmi_impact decimal(8,4) [note: 'Calculated difference in DRG relative weight between the working DRG and the potential or final DRG resulting from CDI review activity. Quantifies the CMI optimization contribution of this review.']
  created_timestamp timestamp [note: 'Date and time this CDI review record was first created in the data platform. Supports audit trail and data lineage requirements.']
  discharge_date date [note: 'Date the patient was discharged from the facility. Populated for post-discharge retrospective reviews. Used to calculate Length of Stay (LOS) context for CDI review.']
  documentation_impact varchar [note: 'Category of documentation improvement resulting from the CDI review and query: DRG change, CC/MCC capture, POA status change, or no impact. Used for CDI program ROI and quality reporting.']
  drg_change_flag boolean [note: 'Indicates whether the CDI review and associated query activity resulted in a change to the DRG assignment. Key CDI program outcome metric.']
  poa_status varchar [note: 'Present on Admission (POA) indicator status for the principal diagnosis at the time of CDI review. Affects HAI reporting, quality metrics, and CMS payment adjustments.']
  principal_diagnosis_code varchar [note: 'ICD-10-CM code for the principal diagnosis at the time of CDI review. Used to assess documentation specificity and identify query opportunities.']
  query_initiated_flag boolean [note: 'Indicates whether a physician query was initiated as a result of this CDI review. Used to calculate query rate and CDI program activity metrics.']
  query_method varchar [note: 'Method by which the physician query was communicated: verbal, written paper-based, or electronic (e.g., via Epic In-Basket or Cerner PowerChart message). Supports CDI workflow analysis and compliance documentation.']
  query_outcome varchar [note: 'Outcome of the physician query: whether the physician agreed with the CDI suggestion, disagreed, amended documentation, or indicated clinical undetermination. Core CDI program outcome metric.']
  query_response_date date [note: 'Date the attending physician responded to the CDI query. Used to calculate query response turnaround time and physician engagement metrics.']
  query_response_status varchar [note: 'Current status of the physician query response. Used to monitor physician query response rates, a key CDI program KPI.']
  query_type varchar [note: 'Classification of the physician query as compliant (meets AHIMA/ACDIS standards), leading (directs physician to a specific answer), or non-compliant. Supports CDI compliance monitoring and OIG audit readiness.']
  review_completion_timestamp timestamp [note: 'Date and time the CDI review was marked complete. Used to calculate review turnaround time and CDI specialist productivity.']
  review_date date [note: 'Calendar date on which the CDI specialist performed the chart review. Principal business event date for the review record.']
  review_finding_type varchar [note: 'Classification of the CDI reviewer\'s primary finding from the chart review. Drives query initiation workflow and CDI program productivity reporting.']
  review_lag_days varchar [note: 'Number of days elapsed between the patient admission date and the date of this CDI review. Used to measure concurrent review timeliness; a key CDI program performance indicator.']
  review_number varchar [note: 'Externally visible, human-readable business identifier for the CDI review record. Used for cross-system reference and audit trail. Format: CDI-YYYY-NNNNNNN.']
  review_sequence_number varchar [note: 'Sequential number of this review within the encounter (1 = initial review, 2 = first follow-up, etc.). Used to track review frequency per encounter and CDI program throughput.']
  review_status varchar [note: 'Current workflow state of the CDI chart review. Drives CDI program productivity dashboards and workqueue management.']
  review_timestamp timestamp [note: 'Precise date and time the CDI review was initiated in the CDI system. Used for concurrent review timeliness measurement and SLA tracking.']
  review_type varchar [note: 'Classification of the CDI review by timing and purpose: initial concurrent review, follow-up concurrent review, or post-discharge retrospective review. Drives CDI workflow routing and productivity metrics.']
  reviewer_credential varchar [note: 'Professional credential of the CDI reviewer performing the review (e.g., CCDS, CDIP, RN, MD). Used for CDI program staffing analytics and credential-based productivity reporting.']
  reviewer_role varchar [note: 'Functional role of the individual performing the CDI review. Distinguishes between CDI specialists, physician advisors, coders, and supervisors for productivity and workflow analysis.']
  source_review_reference varchar [note: 'Native identifier of the CDI review record in the originating operational system (e.g., 3M CDI internal review ID, Epic CDI activity ID). Supports cross-system traceability and ETL reconciliation.']
  updated_timestamp timestamp [note: 'Date and time this CDI review record was last modified in the data platform. Supports change tracking, audit trail, and incremental ETL processing.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Clinical Documentation Improvement review records.'
}

Table quality.accreditation_program {
  accreditation_program_id varchar [pk, note: 'Unique surrogate identifier for the accreditation program record. Primary key for the accreditation_program data product in the quality domain.']
  accreditation_status_id varchar [note: 'Foreign key linking to compliance.accreditation_status. Business justification: Quality accreditation programs (TJC, DNV, HFAP) must link to compliance tracking of accreditation status, deemed status for CMS certification, survey cycles, and findings resolution. Compliance system']
  care_site_id varchar [note: 'Reference to the facility or organizational entity to which this accreditation program applies.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Accreditation programs (NCQA, URAC) are often payer-sponsored for contracted facilities. Payers track facility accreditation status for network adequacy requirements and quality assurance. Payer contr']
  quality_program_id varchar [note: 'Foreign key linking to quality.quality_program. Business justification: Accreditation programs are a specialized type of quality program. This FK establishes the parent-child relationship, enabling accreditation programs to inherit program-level attributes and be included']
  accreditation_coordinator_name varchar [note: 'Name of the internal staff member or manager responsible for coordinating the accreditation program, managing survey logistics, and tracking compliance activities.']
  accreditation_cycle_years varchar [note: 'The standard duration in years of the accreditation cycle for this program (e.g., 3 years for TJC hospital accreditation, 2 years for some disease-specific certifications). Drives renewal scheduling and survey planning.']
  accreditation_decision varchar [note: 'The formal accreditation decision issued by the accrediting body following the most recent survey or review cycle (e.g., accredited, accredited_with_follow_up, conditional, preliminary_denial, denial, not_accredited). Distinct from program_status which reflects the current operational state.']
  accrediting_body varchar [note: 'The external organization responsible for granting and maintaining the accreditation or certification (e.g., TJC = The Joint Commission, CMS = Centers for Medicare and Medicaid Services, NCQA = National Committee for Quality Assurance, DNV = DNV Healthcare, HFAP = Healthcare Facilities Accreditation Program, URAC = Utilization Review Accreditation Commission).']
  cms_acceptance_status varchar [note: 'Status of CMS review and acceptance of the submitted Plan of Correction. \'accepted\' = CMS approved the PoC; \'rejected\' = CMS rejected and requires revision; \'pending\' = under CMS review; \'not_applicable\' = no CMS PoC required for this program.']
  cms_certification_number varchar [note: 'The six-digit CMS Certification Number (CCN), formerly known as the Medicare Provider Number, assigned by CMS to identify the certified provider or supplier. Required for Medicare and Medicaid participation and regulatory reporting.']
  complaint_survey_indicator boolean [note: 'Indicates whether the most recent survey was triggered by a complaint or adverse event report filed with the accrediting body or CMS. True = complaint-triggered survey; False = routine or scheduled survey.']
  condition_level_deficiency_count varchar [note: 'Number of findings classified as Condition-Level Deficiencies (CLDs) identified during the survey. Condition-level deficiencies indicate substantial non-compliance with a CMS Condition of Participation and require a Plan of Correction.']
  created_timestamp timestamp [note: 'Timestamp when this accreditation program record was first created in the system. Supports audit trail, data lineage, and compliance record-keeping requirements.']
  deemed_status boolean [note: 'Indicates whether the organization holds CMS Deemed Status through this accreditation program, meaning the accrediting body\'s standards are recognized by CMS as meeting or exceeding CMS Conditions of Participation. True = deemed status granted; False = not deemed.']
  effective_date date [note: 'The date on which the current accreditation or certification became effective and binding. Marks the start of the accreditation cycle.']
  expiration_date date [note: 'The date on which the current accreditation or certification expires and must be renewed. Used for renewal tracking, compliance monitoring, and regulatory reporting.']
  finding_compliance_status varchar [note: 'Current compliance status of the primary finding from the most recent survey. Tracks whether the organization has achieved compliance with the cited standard or condition.']
  finding_evidence varchar [note: 'Narrative description of the evidence observed or documented by surveyors that supports the primary finding or deficiency citation. Used for Plan of Correction development and compliance tracking.']
  finding_resolution_date date [note: 'The date on which the primary accreditation finding was resolved and verified as compliant by the accrediting body or internal quality team.']
  finding_resolution_status varchar [note: 'Current resolution status of the primary accreditation finding. Tracks the lifecycle from identification through corrective action to verified closure.']
  finding_standard_reference varchar [note: 'The specific accreditation standard, National Patient Safety Goal (NPSG), CMS Condition of Participation (CoP) condition, or state regulation citation associated with the primary or most significant finding from the survey (e.g., \'TJC NPSG.07.01.01\', \'CMS CoP 482.13\', \'State Health Code §405.1\'). For multi-finding surveys, this captures the lead citation.']
  finding_type varchar [note: 'Classification of the primary or most significant finding type from the survey. \'RFI\' = Requirement for Improvement (TJC); \'immediate_threat\' = Immediate Threat to Health and Safety; \'condition_level_deficiency\' = CMS Condition-Level Deficiency; \'standard_level_deficiency\' = CMS Standard-Level Deficiency; \'observation\' = non-scored observation.']
  follow_up_required boolean [note: 'Indicates whether a follow-up survey or focused review is required following the most recent survey due to unresolved findings or conditional accreditation status. True = follow-up required; False = no follow-up required.']
  follow_up_survey_date date [note: 'Scheduled or actual date of the follow-up survey or focused review required to verify correction of findings from the primary survey. Populated only when follow_up_required is True.']
  immediate_threat_count varchar [note: 'Number of findings classified as Immediate Threat to Health and Safety (ITHS) identified during the survey. These are the most severe findings requiring immediate corrective action and may trigger CMS termination proceedings.']
  is_cms_cop_applicable boolean [note: 'Indicates whether CMS Conditions of Participation apply to this accreditation program. True = CMS CoP requirements govern this program; False = program is not subject to CMS CoP (e.g., voluntary certification programs).']
  last_cms_validation_date date [note: 'Date of the most recent CMS validation survey conducted to verify that the accrediting body\'s survey process meets CMS standards for deemed status programs. CMS conducts validation surveys on a sample of accredited organizations.']
  next_survey_due_date date [note: 'The projected or scheduled date by which the next accreditation survey must occur to maintain continuous accreditation. Calculated from the accreditation cycle and effective date. Used for survey readiness planning.']
  plan_of_correction varchar [note: 'Narrative description of the organization\'s Plan of Correction (PoC) submitted to the accrediting body or CMS in response to identified findings or deficiencies. Describes corrective actions, responsible parties, and timelines.']
  poc_due_date date [note: 'The regulatory deadline by which the Plan of Correction must be submitted to the accrediting body or CMS. Drives compliance workflow and escalation management.']
  poc_submission_date date [note: 'The date on which the Plan of Correction was submitted to the accrediting body or CMS. CMS requires PoC submission within 10 calendar days of receipt of the Statement of Deficiencies (Form CMS-2567).']
  program_name varchar [note: 'Human-readable name of the accreditation or certification program (e.g., \'Hospital Accreditation\', \'Primary Stroke Center Certification\', \'Chest Pain Center Certification\', \'NCQA Health Plan Accreditation\').']
  program_number varchar [note: 'Externally assigned or internally tracked unique program identifier issued by the accrediting body (e.g., TJC organization ID, CMS certification number, NCQA organization ID). Used for cross-referencing with accrediting body portals and regulatory submissions.']
  program_status varchar [note: 'Current lifecycle status of the accreditation program. \'active\' = currently accredited; \'pending\' = application submitted, awaiting decision; \'suspended\' = accreditation temporarily suspended; \'withdrawn\' = organization voluntarily withdrew; \'expired\' = accreditation lapsed without renewal; \'denied\' = accreditation application denied.']
  program_type varchar [note: 'Classification of the accreditation or certification program by scope and purpose (e.g., hospital_accreditation, disease_specific_certification, primary_stroke_center, chest_pain_center, ambulatory_care, behavioral_health, home_care, laboratory, long_term_care). [ENUM-REF-CANDIDATE: hospital_accreditation|disease_specific_certification|primary_stroke_center|chest_pain_center|ambulatory_care|behavioral_health|home_care|laboratory|long_term_care — promote to reference product]']
  readiness_assessment_date date [note: 'The date of the most recent internal mock survey, readiness tracer, or formal readiness assessment conducted in preparation for the accreditation survey. Supports TJC survey readiness and continuous compliance programs.']
  readiness_score decimal(5,2) [note: 'Numeric score (0.00–100.00) from the most recent internal readiness assessment or mock survey, representing the organization\'s estimated compliance percentage with accreditation standards. Used for gap analysis and improvement prioritization.']
  regulatory_body_contact varchar [note: 'Name and contact information for the primary liaison or account representative at the accrediting body (e.g., TJC account executive, CMS regional office contact). Used for survey coordination and issue escalation.']
  standard_level_deficiency_count varchar [note: 'Number of findings classified as Standard-Level Deficiencies identified during the survey. These represent non-compliance at the individual standard level within a Condition of Participation.']
  standards_chapters_reviewed varchar [note: 'Comma-separated list or description of the accreditation standards chapters or domains reviewed during the survey (e.g., NPSG, EC, IC, HR, LD, MM, PC, RC, RI, TS for TJC; or CMS CoP conditions reviewed). Supports gap analysis and compliance tracking.']
  state_license_number varchar [note: 'State-issued facility license number associated with this accreditation program. Required for state regulatory reporting and cross-referencing with state department of health records.']
  state_survey_agency varchar [note: 'Name of the state survey agency responsible for conducting CMS validation surveys or state licensure surveys for this program (e.g., state department of health). Required for CMS deemed status programs.']
  survey_date date [note: 'The date on which the most recent accreditation survey or on-site review was conducted by the accrediting body. For multi-day surveys, this is the start date.']
  survey_end_date date [note: 'The date on which the most recent accreditation survey concluded. For single-day surveys, this equals survey_date. Used to calculate survey duration and schedule post-survey activities.']
  survey_scope varchar [note: 'Description of the scope of the survey including methodology applied (e.g., tracer methodology, environment of care review, life safety code survey, full organization survey, focused standards review). Free-text or structured description of areas covered.']
  survey_type varchar [note: 'Classification of the accreditation survey by its purpose and scheduling method. \'triennial\' = standard scheduled full survey; \'unannounced\' = surprise survey without advance notice; \'for_cause\' = triggered by complaint or adverse event; \'validation\' = CMS validation of deemed status; \'internal_mock\' = internal readiness simulation; \'readiness_tracer\' = internal tracer methodology readiness assessment.']
  surveyor_team varchar [note: 'Names or identifiers of the surveyors assigned to conduct the accreditation survey. May include lead surveyor and team members from the accrediting body.']
  total_findings_count varchar [note: 'Total number of accreditation findings, deficiencies, or Requirements for Improvement (RFIs) identified during the most recent survey. Used for benchmarking, trend analysis, and quality improvement prioritization.']
  updated_timestamp timestamp [note: 'Timestamp when this accreditation program record was most recently modified. Supports change tracking, audit trail, and data quality monitoring.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Accreditation program enrollment and status tracking.'
}

Table quality.accreditation_survey {
  accreditation_survey_id varchar [pk, note: 'Unique system-generated identifier for each accreditation survey or readiness assessment record. Serves as the primary key for this entity.']
  accreditation_program_id varchar [note: 'FK to quality.accreditation_program']
  care_site_id varchar [note: 'Reference to the facility or care site that is the subject of this accreditation survey.']
  cdm_entry_id varchar [note: 'Foreign key linking to billing.cdm_entry. Business justification: Accreditation surveys review charge capture processes, CDM accuracy, and pricing transparency. Findings may require specific CDM entry updates to resolve deficiencies. Linking enables tracking of CDM ']
  committee_id varchar [note: 'Foreign key linking to quality.committee. Business justification: Accreditation survey findings and corrective action plans are reviewed by committees (e.g., Accreditation Readiness Committee, Quality Council). This FK enables tracking which committee has oversight ']
  compliance_audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: Accreditation surveys are formal external audits conducted by TJC, DNV, or other accrediting bodies. Findings must be tracked in the compliance audit system for corrective action planning, regulatory ']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Accreditation survey costs (surveyor fees, staff time, corrective action implementation) are allocated to specific cost centers. Survey findings often require departmental budget adjustments for compl']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Accreditation surveys may be payer-initiated or payer-tracked for network quality assurance. Payers receive survey results to assess facility compliance with network quality standards and regulatory r']
  research_study_id varchar [note: 'Foreign key linking to research.research_study. Business justification: Accreditation surveys (TJC, CAP, AABB) include research-specific standards: human subjects protection (RI chapter), investigational product management, research laboratory operations, and informed con']
  accreditation_decision varchar [note: 'Final accreditation decision issued by the accrediting body following the survey and review of any corrective action submissions. Values include Accredited (full compliance), Conditional (compliance with corrective action required), Preliminary Denial, Denial, or Not Applicable for internal assessments.']
  accreditation_decision_date date [note: 'Date on which the accrediting body issued the official accreditation decision. Used to track decision timelines and accreditation cycle management.']
  accreditation_expiration_date date [note: 'Date on which the accreditation award resulting from this survey expires, typically three years from the decision date for TJC triennial surveys. Drives scheduling of the next survey cycle.']
  accreditation_standards_edition varchar [note: 'Version or edition year of the accreditation standards manual applied during this survey (e.g., TJC Comprehensive Accreditation Manual for Hospitals 2024 edition). Ensures findings are evaluated against the correct standards version.']
  accrediting_body varchar [note: 'Name or code of the organization conducting the accreditation survey. Examples include The Joint Commission (TJC), Centers for Medicare and Medicaid Services (CMS), DNV Healthcare, Healthcare Facilities Accreditation Program (HFAP), Center for Improvement in Healthcare Quality (CIHQ), National Committee for Quality Assurance (NCQA), or INTERNAL for mock/readiness surveys. [ENUM-REF-CANDIDATE: TJC|CMS|DNV|HFAP|CIHQ|NCQA|INTERNAL — 7 candidates stripped; promote to reference product]']
  cms_certification_number varchar [note: 'The six-digit CMS Certification Number (CCN), formerly known as the Medicare Provider Number, assigned to the facility by the Centers for Medicare and Medicaid Services. Used to link survey records to CMS certification and reimbursement records.']
  condition_level_deficiency boolean [note: 'Indicates whether any Condition-Level deficiency (as opposed to Standard-Level) was cited during a CMS survey. Condition-Level deficiencies represent systemic non-compliance with a Condition of Participation and carry the most severe regulatory consequences.']
  cop_deficiencies_cited varchar [note: 'Number of CMS Conditions of Participation (CoP) deficiencies cited during the survey. CoP deficiencies are the most serious CMS findings and may jeopardize Medicare and Medicaid participation if not corrected.']
  corrective_action_plan_status varchar [note: 'Current status of the facility\'s Corrective Action Plan (CAP) or Plan of Correction (PoC) developed in response to survey findings. Tracks whether corrective actions are required, in progress, submitted to the accrediting body, accepted, or overdue.']
  created_timestamp timestamp [note: 'Timestamp when this accreditation survey record was first created in the system. Supports audit trail and data lineage requirements.']
  environment_of_care_included boolean [note: 'Indicates whether the Environment of Care (EC) standards chapter was included in the scope of this survey, covering safety management, security, hazardous materials, fire safety, medical equipment, and utilities.']
  esc_acceptance_status varchar [note: 'Status of the accrediting body\'s review of the submitted Evidence of Standards Compliance (ESC). Indicates whether the corrective action evidence was accepted, rejected, partially accepted, or is still pending review.']
  esc_submission_date date [note: 'Actual date on which the facility submitted its Evidence of Standards Compliance (ESC) to the accrediting body. Compared against the due date to assess timeliness of corrective action response.']
  esc_submission_due_date date [note: 'Deadline by which the facility must submit its Evidence of Standards Compliance (ESC) to the accrediting body addressing all Requirements for Improvement (RFI) identified during the survey.']
  findings_count_immediate_threat varchar [note: 'Number of findings classified at the highest priority level representing an Immediate Threat to Health or Safety (ITHS). These require urgent corrective action and may trigger conditional accreditation or denial.']
  findings_count_observation varchar [note: 'Number of lower-priority findings or observations noted during the survey that do not rise to the level of a formal Requirement for Improvement but are documented for quality improvement awareness.']
  findings_count_requirement_improvement varchar [note: 'Number of findings classified as Requirements for Improvement (RFI) — standards elements that were not fully compliant but do not represent an immediate threat. Must be addressed in the Evidence of Standards Compliance (ESC) submission.']
  findings_count_total varchar [note: 'Total number of all findings across all priority levels identified during the survey. Equals the sum of immediate threat, requirement for improvement, and observation findings.']
  follow_up_survey_date date [note: 'Scheduled or actual date of the follow-up or revisit survey required to verify correction of findings from this survey. Null if no follow-up survey is required.']
  follow_up_survey_required boolean [note: 'Indicates whether the accrediting body has required a follow-up or revisit survey to verify correction of findings. Typically triggered by Immediate Threat to Health or Safety findings or Condition-Level CMS deficiencies.']
  infection_prevention_included boolean [note: 'Indicates whether Infection Prevention and Control (IC) standards were included in the survey scope. Relevant for tracking Healthcare-Associated Infection (HAI) compliance including CLABSI, CAUTI, and SSI prevention standards.']
  is_unannounced boolean [note: 'Indicates whether this survey was conducted without prior notification to the facility. Unannounced surveys are standard for TJC triennial surveys and all CMS surveys, providing an unfiltered view of day-to-day operations.']
  lead_surveyor_name varchar [note: 'Full name of the primary surveyor or lead assessor assigned by the accrediting body or internal quality team to conduct this survey. Used for accountability and follow-up communications.']
  life_safety_module_included boolean [note: 'Indicates whether the Life Safety Code (LSC) module was included in the scope of this survey. TJC surveys may include a dedicated Life Safety specialist reviewing NFPA 101 compliance.']
  national_patient_safety_goals_reviewed boolean [note: 'Indicates whether the TJC National Patient Safety Goals (NPSG) were specifically reviewed during this survey. NPSGs address critical safety areas including patient identification, medication safety, infection prevention, and fall reduction.']
  next_survey_target_date date [note: 'Projected or scheduled date for the next accreditation survey cycle. Used for continuous survey readiness planning and resource allocation.']
  notification_date date [note: 'Date on which the facility received official notification of the upcoming survey. Null for unannounced surveys. Used to calculate preparation lead time.']
  overall_readiness_score decimal(5,2) [note: 'Numeric score (typically expressed as a percentage 0.00–100.00) representing the facility\'s overall compliance or readiness level as assessed during the survey. For internal mock surveys, this reflects the percentage of standards elements found compliant.']
  preliminary_findings_summary varchar [note: 'Narrative summary of preliminary findings communicated to facility leadership at the survey exit conference before the formal report is issued. Captures key themes, high-priority concerns, and commendations noted by surveyors.']
  standards_chapters_reviewed varchar [note: 'Comma-delimited list or narrative description of the accreditation standards chapters or domains reviewed during the survey (e.g., Environment of Care, Life Safety, Infection Prevention, Medication Management, National Patient Safety Goals, Human Resources, Leadership).']
  survey_duration_days decimal(9,4) [note: 'Total number of calendar days the survey spanned from start to end date. Used for resource planning and benchmarking survey scope.']
  survey_end_date date [note: 'The date on which the on-site survey or assessment concluded. Multi-day surveys will have an end date later than the start date.']
  survey_number varchar [note: 'Externally-known alphanumeric identifier assigned by the accrediting body or internal quality department to uniquely reference this survey event (e.g., TJC survey tracking number, CMS survey ID, or internal mock survey reference number).']
  survey_report_received_date date [note: 'Date on which the facility received the official written survey report from the accrediting body. Triggers the formal corrective action response timeline.']
  survey_scope varchar [note: 'Description of the scope of the survey including which care settings, service lines, or departments were included (e.g., inpatient, emergency department, surgical services, behavioral health, ambulatory). May reference tracer methodology, environment of care, or life safety module scope.']
  survey_start_date date [note: 'The date on which the on-site survey or assessment officially commenced. For unannounced surveys, this is the date surveyors arrived on-site.']
  survey_status varchar [note: 'Current lifecycle state of the accreditation survey record, tracking progression from scheduling through completion and accreditation decision.']
  survey_type varchar [note: 'Classification of the survey by its purpose and scheduling basis. Triennial surveys are scheduled full accreditation reviews; unannounced surveys occur without prior notice; for-cause surveys are triggered by complaints or adverse events; validation surveys verify prior findings; mock surveys are internal simulations; readiness tracers are targeted internal assessments of specific standards chapters.']
  surveyor_team_composition varchar [note: 'Description of the full surveyor or assessor team including roles and specialties (e.g., physician surveyor, nurse surveyor, life safety specialist, behavioral health surveyor). Captures team size and expertise mix for survey context.']
  system_tracer_topics varchar [note: 'Comma-delimited list of system tracer topics evaluated during the survey (e.g., Medication Management, Infection Control, Data Use, Emergency Management). System tracers evaluate organization-wide processes rather than individual patient care.']
  tjc_organization_code varchar [note: 'Unique identifier assigned by The Joint Commission to the healthcare organization in the TJC Connect portal. Used to cross-reference survey records with TJC\'s accreditation management system.']
  tracer_methodology_used boolean [note: 'Indicates whether the TJC tracer methodology was employed during this survey, where surveyors follow individual patient care experiences across departments and care transitions to evaluate standards compliance in real-world context.']
  updated_timestamp timestamp [note: 'Timestamp when this accreditation survey record was most recently modified. Supports change tracking, audit trail, and incremental data pipeline processing.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Accreditation survey events and results.'
}

Table quality.standard_finding {
  standard_finding_id varchar [pk, note: 'Unique surrogate identifier for each compliance finding record. Primary key for the standard_finding data product in the quality domain.']
  accreditation_program_id varchar [note: 'FK to quality.accreditation_program']
  accreditation_survey_id varchar [note: 'Reference to the parent accreditation survey, regulatory inspection, or internal readiness assessment event that generated this finding.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Accreditation standard findings are audit findings that require compliance tracking for corrective action plans, regulatory submission to CMS, and verification of effectiveness. Compliance system mana']
  care_site_id varchar [note: 'Reference to the facility or care site where the compliance finding was identified during the survey or inspection.']
  cdm_entry_id varchar [note: 'Foreign key linking to billing.cdm_entry. Business justification: Regulatory findings often cite charge capture or pricing issues requiring CDM corrections. Linking enables tracking of specific CDM entries implicated in deficiencies, supports corrective action plans']
  committee_id varchar [note: 'Foreign key linking to quality.committee. Business justification: Standard findings (deficiencies, observations) from accreditation surveys are reviewed and addressed by committees. This FK enables tracking which committee is responsible for the plan of correction a']
  interface_downtime_id varchar [note: 'Foreign key linking to interoperability.interface_downtime. Business justification: Accreditation findings related to data exchange failures (e.g., missed lab results, delayed ADT notifications) need to reference specific downtime events as root cause. This link supports evidence-bas']
  material_master_id varchar [note: 'Foreign key linking to supply.material_master. Business justification: Accreditation survey findings frequently cite specific supplies or equipment (expired items found, improper storage conditions, missing safety equipment). Linking to material master enables targeted c']
  modality_id varchar [note: 'Foreign key linking to radiology.modality. Business justification: Accreditation survey findings (ACR, TJC, state) often cite specific imaging equipment for calibration, QC documentation, or safety deficiencies. Standard findings must link to modality for corrective ']
  prior_finding_standard_finding_id varchar [note: 'Reference to the previous standard_finding record for the same standard citation at this facility, when repeat_finding is true. Enables lineage tracking of recurring deficiencies.']
  affected_department varchar [note: 'The clinical or operational department, unit, or service line within the facility where the deficiency was identified (e.g., ICU, Emergency Department, Pharmacy, Operating Room). Supports departmental accountability tracking.']
  cms_acceptance_date date [note: 'The date on which CMS or the State Survey Agency formally accepted the Plan of Correction (POC) for this finding.']
  cms_acceptance_status varchar [note: 'The acceptance status of the Plan of Correction (POC) as determined by the Centers for Medicare and Medicaid Services (CMS) or the applicable State Survey Agency. Tracks whether CMS has formally accepted the facility\'s corrective action response.']
  cms_certification_number varchar [note: 'The CMS Certification Number (CCN), formerly known as the Medicare Provider Number, for the facility associated with this finding. Required for CMS regulatory reporting and public disclosure.']
  compliance_due_date date [note: 'The date by which the facility must achieve full compliance with the cited standard and complete all corrective actions. May differ from the POC submission due date.']
  corrective_action_description varchar [note: 'Detailed description of the specific corrective actions taken or planned to address the root cause of the finding and achieve sustained compliance.']
  corrective_action_owner varchar [note: 'Name or role title of the individual or department accountable for executing and completing the corrective actions specified in the Plan of Correction.']
  created_timestamp timestamp [note: 'The timestamp when this standard finding record was first created in the system. Supports audit trail and data lineage requirements.']
  deficiency_tag_number varchar [note: 'The CMS deficiency tag number (e.g., F-Tag for long-term care, K-Tag for life safety code) associated with this finding. Provides standardized cross-reference to the CMS regulatory citation database.']
  effectiveness_verification_date date [note: 'The date on which corrective action effectiveness was formally verified and documented, confirming that the deficiency has been sustainably resolved.']
  effectiveness_verified boolean [note: 'Indicates whether the corrective actions have been verified as effective through follow-up monitoring, re-audit, or surveyor revisit, confirming sustained compliance.']
  element_of_performance varchar [note: 'The specific Element of Performance (EP) within a TJC standard, or the equivalent sub-requirement within a CMS Condition of Participation, that was cited as deficient. Granular citation enabling targeted corrective action.']
  enforcement_action varchar [note: 'The regulatory enforcement remedy imposed as a result of this finding, if applicable (e.g., Civil Monetary Penalty, Denial of Payment for New Admissions, Temporary Management, Termination from Medicare/Medicaid). [ENUM-REF-CANDIDATE: None|Civil Monetary Penalty|Denial of Payment|Temporary Management|Termination|State Monitor|Directed Plan of Correction — promote to reference product]']
  evidence_of_deficiency varchar [note: 'Specific evidence cited by the surveyor to support the finding, including observations, document reviews, staff interviews, or patient record reviews that substantiate the deficiency.']
  finding_date date [note: 'The date on which the compliance finding was identified during the survey, inspection, or internal assessment. The principal real-world event date for this record.']
  finding_description varchar [note: 'Detailed narrative description of the compliance deficiency or observation as documented by the surveyor or internal assessor. Describes what was observed, what was missing, or what was non-compliant.']
  finding_number varchar [note: 'Human-readable, externally-known identifier assigned to this finding by the surveying body or internal tracking system (e.g., TJC finding reference number, CMS deficiency tag number). Used for cross-referencing with official survey reports.']
  finding_status varchar [note: 'Current lifecycle status of the compliance finding, tracking progression from identification through resolution and regulatory acceptance.']
  finding_type varchar [note: 'Classification of the finding severity and regulatory category as assigned by the surveying body. Drives escalation, reporting timelines, and plan of correction requirements. [ENUM-REF-CANDIDATE: Requirement for Improvement|Immediate Threat to Life|Condition-Level Deficiency|Standard-Level Deficiency|Observation — promote to reference product if additional types are needed]']
  immediate_jeopardy boolean [note: 'Indicates whether the finding has been classified as Immediate Jeopardy (IJ) — a situation in which the facility\'s noncompliance has caused, or is likely to cause, serious injury, harm, impairment, or death to a patient. Triggers mandatory expedited regulatory response.']
  monitoring_frequency varchar [note: 'Frequency at which ongoing compliance monitoring activities are conducted following corrective action implementation.']
  monitoring_method varchar [note: 'Description of the ongoing monitoring mechanism established to verify sustained compliance after corrective actions are implemented (e.g., monthly audits, staff competency checks, policy review cycles).']
  plan_of_correction varchar [note: 'The formal Plan of Correction (POC) narrative submitted by the facility in response to the finding, describing corrective actions, responsible parties, and timelines to achieve and maintain compliance.']
  poc_due_date date [note: 'The regulatory or accreditation deadline by which the Plan of Correction (POC) must be submitted to the surveying body. Drives compliance workflow prioritization.']
  poc_submission_date date [note: 'The date on which the Plan of Correction (POC) was formally submitted to the surveying body or regulatory agency.']
  repeat_finding boolean [note: 'Indicates whether this finding is a recurrence of a previously cited deficiency for the same standard at this facility. Repeat findings carry heightened regulatory scrutiny and may trigger escalated enforcement actions.']
  resolution_date date [note: 'The date on which the finding was formally resolved, corrective actions were verified as complete, and the finding was closed in the tracking system.']
  revisit_date date [note: 'The scheduled or actual date of the follow-up revisit by the surveying body to verify correction of this finding.']
  revisit_required boolean [note: 'Indicates whether a follow-up revisit by the surveying body is required to verify correction of this finding before the finding can be closed.']
  root_cause_summary varchar [note: 'Summary of the root cause analysis findings identifying the underlying systemic or process factors that contributed to the compliance deficiency.']
  scope_code varchar [note: 'CMS scope classification indicating how broadly the deficiency affects patients or residents: Isolated (limited number), Pattern (more than limited), or Widespread (majority or all). Combined with severity to determine the CMS scope-severity grid rating.']
  scope_severity_grid varchar [note: 'The combined CMS scope and severity grid rating (e.g., \'D\', \'G\', \'J\') derived from the intersection of scope and severity classifications. Determines enforcement remedies and civil monetary penalty calculations.']
  severity_code varchar [note: 'CMS severity classification (A through L on the scope-severity grid, with A-C representing no actual harm, D-F low actual harm, G-I high actual harm, J-L immediate jeopardy). Stored as the letter code. [ENUM-REF-CANDIDATE: A|B|C|D|E|F|G|H|I|J|K|L — promote to reference product]']
  standard_chapter varchar [note: 'The chapter or section grouping within the accreditation or regulatory framework to which the cited standard belongs (e.g., \'Environment of Care\', \'Infection Prevention and Control\', \'Patient Rights\'). Supports trend analysis by chapter.']
  standard_reference_code varchar [note: 'The specific regulatory standard, condition, or requirement code that was found to be deficient or at risk (e.g., TJC NPSG.07.01.01, CMS CoP 482.13, State regulation section number). The authoritative citation for the finding.']
  standard_reference_description varchar [note: 'Full descriptive title of the regulatory standard, condition, or requirement cited in this finding (e.g., \'Reduce the Risk of Health Care-Associated Infections\'). Provides human-readable context for the standard_reference_code.']
  survey_end_date date [note: 'The date the survey, inspection, or assessment concluded. Used to bound the survey window and associate findings to the correct survey event.']
  survey_start_date date [note: 'The date the survey, inspection, or assessment began. Used to associate the finding with the full survey window and calculate survey duration.']
  survey_type varchar [note: 'Type of survey or inspection that produced this finding, distinguishing between accreditation surveys, regulatory inspections, and internal assessments. [ENUM-REF-CANDIDATE: TJC Accreditation|CMS CoP|State Survey|Internal Readiness|CMS Validation|Complaint Investigation|Focused Survey — promote to reference product]']
  surveying_body varchar [note: 'The regulatory or accrediting organization that conducted the survey and issued this finding (e.g., The Joint Commission, CMS, State Department of Health, OIG). Determines applicable standards and reporting obligations. [ENUM-REF-CANDIDATE: TJC|CMS|State DOH|OIG|Internal|DNV|HFAP — 7 candidates stripped; promote to reference product]']
  tjc_npsg_number varchar [note: 'The TJC National Patient Safety Goal (NPSG) number cited in this finding, when applicable (e.g., NPSG.01.01.01 for patient identification, NPSG.07.01.01 for infection prevention). Null when the finding does not relate to an NPSG.']
  updated_timestamp timestamp [note: 'The timestamp when this standard finding record was most recently modified. Supports change tracking, audit trail, and incremental data pipeline processing.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Accreditation survey findings and deficiencies.'
}

Table quality.improvement_initiative {
  improvement_initiative_id varchar [pk, note: 'Unique surrogate identifier for the quality improvement initiative record in the lakehouse silver layer.']
  budget_id varchar [note: 'Foreign key linking to finance.budget. Business justification: Quality improvement initiatives require dedicated operational and capital funding. Healthcare organizations budget specifically for QI projects (PDSA cycles, process improvements, technology implement']
  capital_project_id varchar [note: 'Foreign key linking to finance.capital_project. Business justification: Major quality improvement initiatives (new clinical equipment, facility upgrades for accreditation, EMR enhancements) are tracked as capital projects with multi-year depreciation schedules. Finance te']
  care_site_id varchar [note: 'Identifier of the primary facility or care site where the improvement initiative is being implemented.']
  committee_id varchar [note: 'Foreign key linking to quality.committee. Business justification: Quality improvement initiatives are sponsored, overseen, or governed by committees (e.g., Quality Improvement Committee, Performance Improvement Committee). This FK enables tracking which committee ha']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Quality improvement initiatives often originate from compliance audit findings, accreditation deficiencies, or regulatory citations. Linking initiatives to formal corrective action plans enables track']
  material_master_id varchar [note: 'Foreign key linking to supply.material_master. Business justification: Supply chain improvement initiatives (reduce surgical tray waste, standardize preference cards, eliminate expired inventory) target specific items. Link to material master enables baseline measurement']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Quality improvement initiatives are often payer-driven (reducing readmissions, improving HEDIS rates) as part of VBC contracts. Payers fund initiatives and track performance against contract targets.']
  primary_improvement_employee_id varchar [note: 'Identifier of the executive or senior clinical leader who sponsors and is accountable for the initiative. Typically a Chief Medical Officer, Chief Nursing Officer, or department VP.']
  quality_program_id varchar [note: 'Foreign key linking to quality.quality_program. Business justification: Improvement initiatives are launched and managed under specific quality programs (e.g., VBP, MIPS, TJC accreditation). Currently improvement_initiative has regulatory_program as STRING, which should b']
  readmission_id varchar [note: 'Foreign key linking to encounter.readmission. Business justification: Readmission reduction is a major quality improvement focus (HRRP penalties, CMS readmission measures). Real business process: QI teams track specific readmission cases in improvement initiatives, anal']
  research_study_id varchar [note: 'Foreign key linking to research.research_study. Business justification: Quality improvement initiatives often originate from research findings or run parallel to research studies. Linkage tracks translation of research into practice improvement, supports pragmatic trial d']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Quality improvement initiatives often target specialty-specific clinical processes (surgical site infection reduction in orthopedics, door-to-balloon time in cardiology). Specialty attribution enables']
  actual_completion_date date [note: 'Date on which the initiative was formally completed or closed. Null if still active. Used to calculate on-time completion rates.']
  aim_statement varchar [note: 'Specific, measurable, time-bound goal statement for the initiative following IHI Model for Improvement format (e.g., \'By December 2024, reduce CAUTI rate from 2.1 to 1.0 per 1,000 catheter days\'). Core element of CMS quality improvement submissions.']
  baseline_period_end date [note: 'End date of the measurement period used to calculate the baseline performance value.']
  baseline_period_start date [note: 'Start date of the measurement period used to calculate the baseline performance value.']
  baseline_value decimal(18,4) [note: 'Quantitative baseline performance level for the target measure at the time the initiative was launched. Establishes the starting point for measuring improvement.']
  cms_submission_date date [note: 'Date on which initiative data was submitted to CMS for quality program reporting. Null if not yet submitted or not required.']
  cms_submission_status varchar [note: 'Status of the CMS quality program submission associated with this initiative (e.g., pending, submitted, accepted, rejected). Tracks compliance with CMS reporting obligations.']
  corrective_action_plan varchar [note: 'Narrative summary of the corrective actions and interventions planned or underway as part of this initiative. Supports TJC survey readiness and CMS Conditions of Participation documentation.']
  created_timestamp timestamp [note: 'Timestamp when this improvement initiative record was first created in the system. Supports audit trail and data lineage requirements.']
  current_performance_date date [note: 'Date on which the current performance value was last measured or updated.']
  current_performance_value decimal(18,4) [note: 'Most recently recorded performance value for the target measure. Enables real-time progress tracking against baseline and goal.']
  current_phase varchar [note: 'Current phase of the improvement cycle (e.g., Plan, Do, Study, Act, Sustain for PDSA-based initiatives). Tracks progress through the improvement methodology lifecycle.']
  department_name varchar [note: 'Name of the primary clinical or operational department where the initiative is focused (e.g., \'ICU\', \'Emergency Department\', \'Pharmacy\'). Supports departmental performance reporting.']
  goal_value decimal(18,4) [note: 'Target quantitative performance level the initiative aims to achieve by the target completion date. Defined in the aim statement and used to assess initiative success.']
  hai_event_type varchar [note: 'If the initiative targets a specific Healthcare-Associated Infection (HAI) type, identifies the HAI category (e.g., Central Line-Associated Bloodstream Infection (CLABSI), Catheter-Associated Urinary Tract Infection (CAUTI), Surgical Site Infection (SSI)). Null or \'none\' for non-HAI initiatives. [ENUM-REF-CANDIDATE: CLABSI|CAUTI|SSI|MRSA|CDI|VAP|none — 7 candidates stripped; promote to reference product]']
  improvement_methodology varchar [note: 'Formal quality improvement methodology applied to this initiative (e.g., Plan-Do-Study-Act (PDSA), Lean, Six Sigma, IHI Model for Improvement, Root Cause Analysis (RCA), Failure Mode and Effects Analysis (FMEA)). Required for TJC performance improvement chapter compliance. [ENUM-REF-CANDIDATE: PDSA|Lean|Six_Sigma|IHI_Model|RCA|FMEA|Kaizen|other — promote to reference product]']
  initiative_name varchar [note: 'Short, descriptive title of the quality improvement initiative (e.g., \'Reduce CAUTI Rate in ICU by 30%\'). Used in dashboards, reports, and TJC performance improvement documentation.']
  initiative_number varchar [note: 'Externally-known, human-readable business identifier for the initiative (e.g., QI-2024-00042). Used in regulatory submissions, TJC survey documentation, and cross-departmental communications.']
  initiative_status varchar [note: 'Current lifecycle state of the improvement initiative. Drives workflow routing, reporting filters, and CMS quality program compliance tracking.']
  initiative_type varchar [note: 'Categorical classification of the initiative by primary focus area. Supports portfolio analysis and alignment to organizational quality strategy. [ENUM-REF-CANDIDATE: patient_safety|clinical_quality|operational_efficiency|regulatory_compliance|patient_experience|workforce_development — promote to reference product]']
  is_cms_reportable boolean [note: 'Indicates whether this initiative is associated with a CMS-reportable quality measure or program (e.g., VBP, MIPS, HAI reporting). Drives inclusion in CMS submission workflows.']
  is_sentinel_event_related boolean [note: 'Indicates whether this initiative was triggered by or is directly related to a sentinel event review. Sentinel event-related initiatives require expedited TJC reporting.']
  is_tjc_reportable boolean [note: 'Indicates whether this initiative is required to be documented and reported as part of TJC performance improvement chapter compliance or survey readiness.']
  lessons_learned varchar [note: 'Narrative summary of key insights, successes, and failures identified during the initiative. Supports organizational learning, knowledge management, and future initiative planning.']
  pdsa_cycle_count varchar [note: 'Number of Plan-Do-Study-Act (PDSA) or improvement cycles completed to date for this initiative. Tracks iterative improvement progress per IHI Model for Improvement.']
  priority_level varchar [note: 'Organizational priority assigned to the initiative, used to allocate resources and sequence work across the quality improvement portfolio.']
  problem_statement varchar [note: 'Narrative description of the specific quality problem or gap being addressed. Defines the \'what\' and \'why\' of the initiative. Required for TJC performance improvement documentation.']
  reporting_period_end date [note: 'End date of the measurement or reporting period for which initiative performance data is being captured.']
  reporting_period_start date [note: 'Start date of the measurement or reporting period for which initiative performance data is being captured. Aligns with CMS and HEDIS reporting cycles.']
  service_line varchar [note: 'Clinical or operational service line associated with the initiative (e.g., \'Cardiovascular\', \'Oncology\', \'Women and Children\'). Enables service-line-level quality portfolio analysis.']
  source_system_initiative_reference varchar [note: 'Native identifier of this initiative record in the originating operational system (e.g., Epic Healthy Planet project ID). Enables reconciliation between the lakehouse and source systems.']
  start_date date [note: 'Date on which the improvement initiative formally commenced. Used for timeline tracking and regulatory reporting.']
  sustainability_plan varchar [note: 'Narrative description of the plan to sustain achieved improvements after the initiative closes, including process changes, policy updates, and monitoring mechanisms.']
  target_completion_date date [note: 'Planned date by which the initiative aims to achieve its goal performance value and transition to the sustain phase.']
  team_members varchar [note: 'Comma-separated list of names or employee IDs of multidisciplinary team members participating in the initiative. Supports accountability tracking and TJC performance improvement documentation.']
  updated_timestamp timestamp [note: 'Timestamp when this improvement initiative record was last modified. Supports change tracking, audit trail, and incremental ETL (Extract Transform Load) processing.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Quality improvement initiatives and projects.'
}

Table quality.quality_peer_review {
  quality_peer_review_id varchar [pk, note: 'Unique surrogate identifier for the physician peer review case record in the medical staff quality committee system.']
  radiology_peer_review_id varchar [pk, note: 'Unique surrogate identifier for each radiology peer review event record in the silver layer lakehouse. Primary key for this entity.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Peer review programs are audited for OPPE/FPPE compliance, ACR RadPeer standards, and medical staff bylaws adherence. Compliance verifies peer review program effectiveness and regulatory compliance.']
  care_site_id varchar [note: 'Reference to the hospital or care facility where the reviewed clinical event occurred.']
  committee_id varchar [note: 'Foreign key linking to quality.committee. Business justification: Physician peer review cases are conducted by medical staff quality committees (e.g., Peer Review Committee, Credentials Committee). This FK enables tracking which committee conducted the peer review, ']
  coordinator_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Peer review programs have administrative coordinators (QA nurses, radiology managers) who manage case selection, distribution, and follow-up. Required for OPPE/FPPE programs and accreditation.']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Peer review discrepancies trigger corrective action plans for quality improvement and patient safety. Quality/compliance departments create CAPs to address systematic issues identified through peer re']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Peer reviews evaluate appropriateness of procedure coding and clinical documentation supporting CPT code assignment. Medical staff peer review committees require validated CPT code references to asses']
  demographics_id varchar [note: 'Reference to the patient whose care episode is the subject of this peer review case. Links to the Master Patient Index (MPI).']
  drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: Peer reviews evaluate DRG assignment appropriateness and case complexity for quality of care assessment. Medical staff peer review committees require DRG reference data to assess whether clinical docu']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Peer reviews evaluate appropriateness of diagnosis coding and clinical documentation supporting ICD-10 code assignment. Medical staff peer review committees require validated ICD code references to as']
  investigation_id varchar [note: 'Foreign key linking to compliance.investigation. Business justification: Peer reviews identifying care quality issues, standard-of-care violations, or potential regulatory non-compliance trigger formal compliance investigations. Investigations assess whether findings requi']
  or_suite_id varchar [note: 'Foreign key linking to facility.or_suite. Business justification: Surgical peer review cases require OR suite linkage for surgical site infection analysis, equipment availability assessment, and OR-specific protocol compliance review. Surgical quality committees inv']
  org_unit_id varchar [note: 'Reference to the clinical department (e.g., Surgery, Emergency Medicine, Cardiology) responsible for the care under review.']
  original_report_id varchar [note: 'Reference to the radiology report that was authored by the original interpreting radiologist and is being reviewed in this peer review event.']
  primary_quality_clinician_id varchar [note: 'Reference to the clinician whose clinical performance or care decisions are under review. Used for Ongoing Professional Practice Evaluation (OPPE) and Focused Professional Practice Evaluation (FPPE) tracking.']
  quality_clinician_id varchar
  quality_measure_id varchar [note: 'Reference to a specific quality measure (e.g., HEDIS, CMS eCQM, VBP measure) that this peer review case is associated with or contributes to.']
  report_addendum_id varchar [note: 'Reference to the addendum or amended radiology report created as a result of this peer review, if applicable. Populated only when review_disposition is \'addendum_required\' or \'report_amended\'. Supports audit trail linking original and corrected reports.']
  research_study_id varchar [note: 'Foreign key linking to research.research_study. Business justification: Peer review of care involving research subjects or investigational procedures requires protocol context for proper clinical evaluation. Reviewers must assess whether research participation influenced ']
  review_consent_record_id varchar [note: 'Foreign key linking to consent.consent_record. Business justification: Peer review cases requiring patient contact for additional information or clarification need documented consent separate from treatment consent. OPPE/FPPE processes involving patient interviews requir']
  udi_record_id varchar [note: 'Foreign key linking to supply.udi_record. Business justification: Peer reviews of surgical cases with implants require device-level detail to assess appropriateness of device selection, sizing, and placement technique. Supports OPPE/FPPE evaluation of surgeon compet']
  unit_id varchar [note: 'Foreign key linking to facility.unit. Business justification: Peer review cases analyzed by unit for unit-specific clinical practice patterns and educational opportunities. Medical staff committees review unit-level peer review findings to identify system issues']
  visit_id varchar [note: 'Reference to the specific clinical encounter (inpatient admission, ED visit, outpatient visit) that triggered the peer review case.']
  visit_provider_id varchar [note: 'Foreign key linking to encounter.visit_provider. Business justification: Peer review evaluates individual provider clinical performance on specific cases. Real business process: Peer review committees assess care delivered by specific providers during visits, need visit_pr']
  accession_number varchar [note: 'The RIS-assigned accession number of the original imaging study that is the subject of this peer review. Serves as the primary business identifier linking the review to the source imaging order and PACS study.']
  acr_accreditation_cycle varchar [note: 'The ACR accreditation cycle year range (e.g., \'2023-2026\') to which this peer review event is attributed. Used to aggregate peer review volumes and discrepancy rates for ACR accreditation submission and renewal reporting.']
  acr_radpeer_score varchar [note: 'The ACR RADPEER 2.0 concordance rating assigned by the reviewing radiologist on a 1–4 scale: 1 = Agree with interpretation; 2 = Disagree, but would not have changed management; 3 = Disagree, may have changed management; 4 = Disagree, would have changed management. Drives quality reporting and radiologist performance management.']
  action_completion_date date [note: 'The actual date on which the required corrective or educational action was completed and verified by the medical staff office.']
  action_description varchar [note: 'Detailed narrative of the specific corrective or educational action taken, including any conditions, timelines, or requirements imposed on the reviewed provider.']
  action_due_date date [note: 'Target date by which the required corrective or educational action must be completed by the reviewed provider.']
  action_taken varchar [note: 'The formal action taken by the medical staff committee as a result of the peer review determination. [ENUM-REF-CANDIDATE: no_action|letter_of_concern|education_required|proctoring|privilege_restriction|privilege_suspension|privilege_revocation|referral_to_mec|voluntary_relinquishment — promote to reference product]']
  appeal_resolution_date date [note: 'The date on which the formal appeal of the peer review determination was resolved by the appellate hearing panel.']
  appeal_status varchar [note: 'Status of any formal appeal filed by the reviewed provider against the peer review determination or action taken.']
  blinded_review_flag boolean [note: 'Indicates whether the peer review was conducted in a blinded manner, meaning the reviewing radiologist did not have access to the original report at the time of review. True = blinded review (ACR RADPEER preferred methodology); False = non-blinded review.']
  body_part_examined varchar [note: 'The anatomical region or body part that was the primary subject of the imaging study under review, using SNOMED CT or DICOM body part terminology (e.g., CHEST, ABDOMEN, BRAIN, SPINE). Supports subspecialty-level peer review analytics.']
  care_determination varchar [note: 'The formal committee determination of whether the care provided was clinically appropriate: appropriate (care met standard), appropriate with suggestions (care met standard but improvement opportunities identified), not appropriate (care did not meet standard), or unable to determine (insufficient information).']
  care_event_date date [note: 'The date on which the clinical care event under review occurred (e.g., date of surgery, date of adverse event, date of the encounter being reviewed). Distinct from the case open date.']
  case_conference_flag boolean [note: 'Indicates whether this peer review case was referred to or discussed at a departmental case conference or quality committee meeting. True = case was presented at conference; False = not referred to conference. Supports TJC quality committee documentation requirements.']
  case_number varchar [note: 'Externally-known, human-readable case identifier assigned by the medical staff office or quality committee (e.g., PR-2024-00412). Used for tracking, correspondence, and committee minutes.']
  case_open_date date [note: 'The date on which the peer review case was formally opened and assigned to a reviewer by the medical staff office.']
  case_status varchar [note: 'Current workflow state of the peer review case through the medical staff quality committee process.']
  case_summary varchar [note: 'Narrative summary of the clinical case under review, including relevant clinical context, key events, and the basis for the review. Protected under peer review confidentiality statutes.']
  clinical_history_available_flag boolean [note: 'Indicates whether adequate clinical history was available to the original interpreting radiologist at the time of interpretation. Contextual factor used in assessing the fairness and validity of the peer review discrepancy rating.']
  committee_review_date date [note: 'The date on which the medical staff quality committee formally reviewed and voted on the case determination. May differ from the individual reviewer completion date.']
  confidentiality_protection_flag boolean [note: 'Indicates whether this peer review record is protected under applicable state peer review protection statutes, shielding it from discovery in civil litigation.']
  created_timestamp timestamp [note: 'The date and time when this peer review case record was first created in the system.']
  discrepancy_category varchar [note: 'Classification of the interpretation discrepancy identified during peer review. \'none\' = no discrepancy found (RADPEER score 1); \'minor\' = discrepancy unlikely to change clinical management (RADPEER score 2); \'major\' = discrepancy that may or would change clinical management (RADPEER scores 3–4). Drives escalation and reporting workflows.']
  discrepancy_description varchar [note: 'Free-text narrative describing the nature of the interpretation discrepancy identified by the reviewing radiologist. Captures the specific finding, anatomical location, and clinical significance. Protected under peer review privilege in most jurisdictions.']
  discrepancy_type varchar [note: 'Categorical classification of the type of interpretation error or discrepancy identified. \'missed_finding\' = finding present but not reported; \'mischaracterization\' = finding reported but incorrectly described; \'incorrect_recommendation\' = appropriate finding but wrong follow-up recommendation; \'incomplete_report\' = report lacks required elements; \'wrong_anatomy\' = finding attributed to incorrect anatomical location. [ENUM-REF-CANDIDATE: missed_finding|mischaracterization|incorrect_recommendation|incomplete_report|wrong_anatomy — promote to reference product]']
  educational_feedback_flag boolean [note: 'Indicates whether the peer review event generated educational feedback to be communicated to the original interpreting radiologist. True = educational feedback was provided; False = no educational feedback generated. Supports CME tracking and radiologist performance improvement programs.']
  educational_opportunity_description varchar [note: 'Narrative description of the specific educational opportunity identified for the reviewed provider (e.g., documentation improvement, clinical guideline adherence, procedural technique).']
  educational_opportunity_flag boolean [note: 'Indicates whether the peer review case identified an educational opportunity for the reviewed provider, regardless of the care determination outcome.']
  escalated_to_chair_flag boolean [note: 'Indicates whether this peer review case was escalated to the radiology department chair or medical director due to a major discrepancy or patient safety concern. True = escalated; False = not escalated. Triggers formal performance management workflow.']
  external_reviewer_organization varchar [note: 'Name of the external organization or independent review entity engaged to conduct the peer review when an internal reviewer is not available or a conflict of interest exists.']
  fppe_trigger_flag boolean [note: 'Indicates whether this peer review case resulted in the initiation of a Focused Professional Practice Evaluation (FPPE) for the reviewed provider.']
  icd10_finding_code varchar [note: 'The ICD-10-CM diagnosis code corresponding to the primary imaging finding or discrepancy identified during peer review. Supports clinical coding alignment, quality reporting, and population health analytics.']
  modality_code varchar [note: 'DICOM-standard modality code identifying the imaging technology used for the study under review (e.g., CT = Computed Tomography, MR = Magnetic Resonance Imaging, XR = X-Ray, US = Ultrasound, PT = PET). Used for subspecialty-stratified peer review reporting and ACR accreditation compliance. [ENUM-REF-CANDIDATE: CT|MR|XR|US|PT|NM|MG|FL|DX|CR — 10 candidates stripped; promote to reference product]']
  npdb_report_date date [note: 'The date on which the adverse action was reported to the National Practitioner Data Bank (NPDB). Required within 30 days of the action per HCQIA.']
  npdb_reportable_flag boolean [note: 'Indicates whether the action taken as a result of this peer review case meets the threshold for mandatory reporting to the National Practitioner Data Bank (NPDB) under HCQIA.']
  oppe_cycle varchar [note: 'The OPPE review cycle period to which this peer review case contributes (e.g., 2024-H1, 2024-Q3). Used to aggregate peer review outcomes into the provider\'s OPPE profile for reappointment decisions.']
  oppe_fppe_flag boolean [note: 'Indicates whether this peer review event is being counted toward the radiologist\'s Ongoing Professional Practice Evaluation (OPPE) or Focused Professional Practice Evaluation (FPPE) for medical staff credentialing and privileging purposes. True = counts toward OPPE/FPPE; False = routine QA only.']
  original_radiologist_npi varchar [note: 'The 10-digit National Provider Identifier (NPI) of the radiologist who authored the original interpretation being reviewed. Used for performance tracking and credentialing compliance.']
  original_radiologist_response varchar [note: 'Free-text response or rebuttal provided by the original interpreting radiologist in response to the peer review findings. Supports the formal peer review appeal and feedback loop process. Protected under peer review privilege.']
  original_report_finalized_datetime timestamp [note: 'The date and time the original radiology report was finalized (signed/attested) by the interpreting radiologist. Used to calculate the lag between report finalization and peer review, and to assess timeliness of discrepancy identification.']
  patient_outcome varchar [note: 'The clinical outcome experienced by the patient as a result of the care event under review. Used to contextualize the severity of the case and inform the care determination.']
  patient_safety_event_flag boolean [note: 'Indicates whether the discrepancy identified in this peer review was determined to constitute a patient safety event requiring reporting to the facility\'s patient safety officer or risk management. True = patient safety event; False = not a patient safety event.']
  prior_study_available_flag boolean [note: 'Indicates whether prior imaging studies were available to the original interpreting radiologist at the time of interpretation. Relevant context for assessing the reasonableness of the original interpretation and the severity of any discrepancy.']
  privileging_impact_flag boolean [note: 'Indicates whether the outcome of this peer review case has a direct impact on the reviewed provider\'s clinical privileges (restriction, suspension, or revocation).']
  protection_statute_reference varchar [note: 'The specific state or federal statute under which peer review confidentiality protection is claimed (e.g., California Evidence Code §1157, Texas Occupations Code §160.007).']
  reconciliation_source varchar [note: 'SSOT reconciliation linkage column added by cross-domain dedup vibe.']
  response_datetime timestamp [note: 'The date and time the original interpreting radiologist submitted their response or acknowledgment of the peer review findings. Used to track completion of the feedback loop and compliance with departmental peer review policy timelines.']
  review_assigned_datetime timestamp [note: 'The date and time the peer review case was assigned to the reviewing radiologist. Used to calculate turnaround time and compliance with departmental SLA targets for peer review completion.']
  review_completion_date date [note: 'The actual date on which the peer review case was completed and a determination was rendered by the reviewer or committee.']
  review_datetime timestamp [note: 'The date and time at which the peer review was performed and the concordance score was assigned by the reviewing radiologist. Principal business event timestamp for this transaction.']
  review_disposition varchar [note: 'The final action or outcome disposition resulting from the peer review. \'no_action\' = review complete, no further action needed; \'feedback_provided\' = educational feedback sent to original radiologist; \'addendum_required\' = original report requires addendum; \'report_amended\' = original report was amended; \'escalated\' = referred to department leadership; \'referred_to_committee\' = referred to quality or peer review committee. [ENUM-REF-CANDIDATE: no_action|feedback_provided|addendum_required|report_amended|escalated|referred_to_committee — promote to reference product]']
  review_due_date date [note: 'Target completion date for the peer review case as established by medical staff bylaws or committee policy (typically 30–60 days from case open date).']
  review_level varchar [note: 'The organizational level at which the review is conducted: department-level (chief review), committee-level (medical staff quality committee), external (independent third-party reviewer), or appellate (appeal hearing panel).']
  review_program_type varchar [note: 'Identifies the quality or regulatory program under which this peer review was conducted. \'acr_radpeer\' = ACR RADPEER program; \'internal_qa\' = internal departmental QA; \'mips\' = MIPS quality measure; \'vbp\' = Value-Based Purchasing; \'tjc_required\' = TJC-mandated review; \'focused_professional_practice_evaluation\' = FPPE for credentialing. [ENUM-REF-CANDIDATE: acr_radpeer|internal_qa|mips|vbp|tjc_required|focused_professional_practice_evaluation — promote to reference product]']
  review_status varchar
  review_type varchar [note: 'Classification of the review type: OPPE (Ongoing Professional Practice Evaluation) for routine periodic review, FPPE (Focused Professional Practice Evaluation) for targeted review of specific concerns, sentinel event review, or complaint-driven review. [ENUM-REF-CANDIDATE: oppe|fppe|sentinel_event|focused|routine|complaint_driven|mortality|morbidity — promote to reference product]']
  reviewer_comments varchar [note: 'Free-text comments entered by the reviewing radiologist providing additional context, clinical reasoning, or recommendations beyond the structured discrepancy description. Protected under peer review privilege statutes in most jurisdictions.']
  reviewer_findings varchar [note: 'Narrative of the peer reviewer\'s clinical findings, analysis of the care provided, and rationale supporting the care appropriateness determination.']
  reviewer_radiologist_npi varchar [note: 'The 10-digit National Provider Identifier (NPI) of the radiologist who performed the peer review. Must be a credentialed radiologist distinct from the original interpreter per ACR RADPEER blinding requirements.']
  specialty_code varchar [note: 'Medical specialty of the provider under review (e.g., General Surgery, Internal Medicine, Emergency Medicine). Used to ensure peer reviewer is of the same specialty.']
  ssot_canonical_reference varchar [note: 'Reference to the canonical SSOT record when this record is deprecated or merged']
  ssot_reconciliation_status varchar [note: 'Status indicating reconciliation state with related SSOT entity: ACTIVE, DEPRECATED, MERGED, SUPERSEDED']
  study_datetime timestamp [note: 'The date and time the imaging study was performed (acquisition datetime from PACS/DICOM metadata). Provides temporal context for the study under review and supports lag-time analytics between study acquisition and peer review.']
  subspecialty varchar [note: 'The radiology subspecialty category of the study under review. Used to ensure subspecialty-matched peer review assignments and to generate subspecialty-stratified quality metrics for ACR accreditation and departmental performance reporting. [ENUM-REF-CANDIDATE: neuroradiology|musculoskeletal|body|breast|cardiovascular|interventional|nuclear|pediatric|emergency — promote to reference product]']
  subspecialty_matched_flag boolean [note: 'Indicates whether the reviewing radiologist\'s subspecialty matches the subspecialty of the imaging study under review. True = subspecialty-matched review; False = cross-subspecialty review. ACR RADPEER recommends subspecialty-matched reviews for complex studies.']
  trigger_description varchar [note: 'Narrative description of the specific event, complaint, or indicator that triggered this peer review case (e.g., unexpected intraoperative complication, patient complaint regarding surgical outcome).']
  trigger_type varchar [note: 'The initiating event or mechanism that caused this peer review case to be opened. OPPE = Ongoing Professional Practice Evaluation; FPPE = Focused Professional Practice Evaluation.']
  updated_timestamp timestamp [note: 'The date and time when this peer review case record was most recently modified.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']
  vibe_placeholder varchar

  Note: 'Peer review records for quality and clinical performance. Quality domain peer review. For radiology-specific peer review see radiology.radiology_peer_review.'
}

Table quality.population_health_gap {
  population_health_gap_id varchar [pk, note: 'Unique surrogate identifier for each care gap record in the population health program. Primary key for this entity in the Silver Layer lakehouse.']
  billing_coverage_id varchar [note: 'Foreign key linking to billing.coverage. Business justification: Care gaps are identified and closed within specific insurance coverage contexts. Payer type drives gap closure strategies, HEDIS star ratings, and risk adjustment. Replaces denormalized payer fields w']
  care_program_enrollment_id varchar [note: 'Foreign key linking to patient.care_program_enrollment. Business justification: Gap identification triggers care program enrollment (diabetes, CHF management). Value-based contracts track gap closure within program context. Care managers use this link to prioritize interventions ']
  care_site_id varchar [note: 'Reference to the facility or care site associated with the patient\'s attributed care team and responsible for gap closure outreach.']
  clinician_id varchar [note: 'Reference to the Primary Care Physician (PCP) or care team provider to whom this patient is attributed for population health management and gap closure accountability.']
  closure_claim_id varchar [note: 'Foreign key linking to claim.claim. Business justification: Care gaps are closed when claims provide evidence of required services. Healthcare gap closure workflows require linking to the specific claim that satisfied the measure for HEDIS reporting and payer ']
  compliance_regulatory_submission_id varchar [note: 'Foreign key linking to compliance.regulatory_submission. Business justification: Care gap closure data must be submitted to CMS for HEDIS, Stars, MIPS, and ACO programs. Compliance system tracks submission of gap closure documentation, exclusion justifications, and numerator compl']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Care gaps are identified by specific CPT procedure codes for preventive services (e.g., mammography, colonoscopy, immunizations). Population health programs require validated CPT code references to id']
  demographics_id varchar [note: 'Reference to the patient for whom this care gap has been identified. Links to the patient master record in the Master Patient Index (MPI).']
  employee_id varchar [note: 'Reference to the care coordinator or population health nurse assigned to manage outreach and closure activities for this care gap. Supports workload distribution and accountability tracking.']
  follow_up_id varchar [note: 'Foreign key linking to radiology.follow_up. Business justification: Radiology follow-up recommendations (incidental findings, lung nodules requiring surveillance) create care gaps tracked in population health programs. Gap closure requires linking to the originating r']
  health_plan_id varchar [note: 'Foreign key linking to insurance.health_plan. Business justification: Care gaps are plan-specific; different plans have different measure sets and gap identification logic. Plan-level gap closure rates determine Star Ratings and quality bonus payments.']
  hedis_measure_id varchar [note: 'Foreign key linking to quality.hedis_measure. Business justification: Population health care gaps are often HEDIS-specific (e.g., gaps in diabetic eye exams, colorectal cancer screening). The existing hedis_measure_code STRING field should be replaced with a proper FK t']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Care gaps are identified by specific ICD-10 diagnosis codes for chronic condition management (e.g., diabetes, hypertension, asthma). Population health programs require validated ICD code references to']
  loinc_code_id varchar [note: 'Foreign key linking to reference.loinc_code. Business justification: Care gaps are identified by specific LOINC lab codes for screening compliance (e.g., HbA1c, cholesterol, colorectal cancer screening). Population health programs require validated LOINC code reference']
  mpi_record_id varchar
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Care gaps are identified by payer for their members to close HEDIS/Star Rating measures. Payers track gap closure rates for quality reporting and provider incentive payments.']
  pcp_attribution_id varchar [note: 'Foreign key linking to patient.pcp_attribution. Business justification: Care gap closure workflows assign outreach responsibility to attributed PCP. Provider-level gap closure rates drive HEDIS/Stars performance measurement and value-based contract reconciliation. Healthc']
  population_measure_id varchar
  population_quality_measure_id varchar [note: 'Reference to the quality measure definition (e.g., HEDIS measure, CMS eCQM) that defines the clinical criteria for this care gap. Links to the quality.measure reference product.']
  quality_program_id varchar [note: 'Reference to the population health program (e.g., ACO, HMO, PPO, PCMH, chronic disease registry) under which this care gap was identified and is being managed.']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Care gaps are specialty-specific (diabetic retinopathy screening requires ophthalmology, colorectal cancer screening requires gastroenterology). HEDIS measure closure requires routing gaps to appropri']
  visit_diagnosis_id varchar [note: 'Foreign key linking to encounter.visit_diagnosis. Business justification: Care gap closure programs track which specific documented diagnoses satisfy quality measure requirements (e.g., diabetes diagnosis for HbA1c testing gaps, depression diagnosis for screening gaps). Rea']
  visit_id varchar [note: 'Reference to the clinical encounter (visit, telehealth, or procedure) during which the care gap was satisfied. Used to validate claims-based and documentation-based gap closures.']
  care_gap_description varchar [note: 'A human-readable description of the specific care gap, including the required service or intervention (e.g., \'HbA1c test overdue — last result >12 months ago\', \'Annual mammogram not on file for patient aged 50-74\'). Used by care coordinators and providers in outreach communications.']
  clinical_note varchar [note: 'Free-text clinical notes or care coordinator comments associated with this care gap record, documenting outreach context, patient preferences, clinical rationale for exclusion, or closure documentation details. Supports CDI and care coordination workflows.']
  closure_date date [note: 'The date on which the care gap was satisfied and transitioned to \'closed\' status. Null if the gap remains open or excluded. Used to calculate gap closure rates and HEDIS numerator compliance.']
  closure_method varchar [note: 'The method by which the care gap was satisfied and closed. \'Claim\' indicates closure via a paid claims record; \'clinical_documentation\' via EHR charting; \'patient_attestation\' via patient self-report; \'lab_result\' via a qualifying lab value; \'immunization_registry\' via state registry data; \'care_plan\' via documented care plan goal achievement.']
  created_timestamp timestamp [note: 'The timestamp when this care gap record was first created in the data platform. Represents the audit trail creation event for Silver Layer lineage tracking.']
  data_source varchar [note: 'The source of data used to identify or close this care gap. Indicates whether the gap was identified or satisfied via EHR clinical documentation, administrative claims, lab feed, immunization registry, patient attestation, or care plan documentation. Supports HEDIS hybrid vs. administrative methodology tracking.']
  due_date date [note: 'The date by which the care gap must be closed to count toward the current HEDIS measurement year or quality program reporting period. Drives outreach prioritization and care coordinator workload management.']
  exclusion_reason varchar [note: 'The reason a patient has been excluded from the denominator for this care gap measure. Applies when gap_status is \'excluded\'. Examples include medical contraindication, patient refusal, hospice enrollment, patient death, or geographic ineligibility. Aligns with NCQA HEDIS denominator exclusion criteria.']
  gap_category varchar [note: 'Clinical sub-category of the care gap describing the nature of the required service (e.g., screening, immunization, lab monitoring, medication management, counseling, follow-up visit). Supports stratified reporting and outreach prioritization.']
  gap_number varchar [note: 'Business-facing unique identifier for this care gap record, used in outreach workflows, care coordinator communications, and ACO quality reporting. Sourced from Epic Healthy Planet gap tracking.']
  gap_status varchar [note: 'Current workflow status of the care gap. \'Open\' indicates the gap has not been addressed; \'closed\' indicates the gap has been satisfied; \'excluded\' indicates the patient meets a denominator exclusion criterion; \'in_progress\' indicates active outreach is underway; \'voided\' indicates the gap was identified in error.']
  gap_type varchar [note: 'Classification of the care gap by clinical category. Indicates whether the gap relates to preventive care (e.g., cancer screening), chronic disease management (e.g., diabetes HbA1c), HEDIS measure compliance, medication adherence, or behavioral health. [ENUM-REF-CANDIDATE: preventive_care|chronic_disease_management|hedis_measure|medication_adherence|behavioral_health|other — promote to reference product]']
  identified_date date [note: 'The date on which this care gap was first identified for the patient, typically generated by Epic Healthy Planet during a registry refresh or care gap analysis run. Represents the business event timestamp for gap creation.']
  is_denominator_eligible boolean [note: 'Indicates whether the patient meets the denominator eligibility criteria for the associated quality measure (True = eligible; False = ineligible). Ineligible patients are excluded from gap rate calculations.']
  is_numerator_compliant boolean [note: 'Indicates whether the patient currently meets the numerator criteria for the associated HEDIS or quality measure (True = compliant, gap closed; False = non-compliant, gap open). Directly drives HEDIS rate calculations and ACO quality score submissions.']
  last_outreach_channel varchar [note: 'The communication channel used for the most recent outreach attempt (phone call, mailed letter, patient portal message, care coordinator visit, telehealth, or SMS text). Supports outreach channel effectiveness analytics.']
  last_outreach_date date [note: 'The date of the most recent outreach attempt made to the patient or their care team regarding this care gap. Used to manage follow-up scheduling and avoid duplicate outreach.']
  measurement_year varchar [note: 'The four-digit calendar year of the HEDIS or quality program measurement period to which this care gap belongs (e.g., 2024). Used to partition gap records by reporting cycle and support year-over-year trend analysis.']
  mrn varchar [note: 'The Medical Record Number (MRN) assigned to the patient by the facility. Used for cross-system patient identification and care gap reconciliation workflows.']
  outreach_attempt_count varchar [note: 'The total number of outreach attempts made to the patient or care team to address this care gap (phone calls, letters, portal messages, care coordinator contacts). Supports outreach effectiveness analysis and escalation workflows.']
  outreach_response_status varchar [note: 'The patient\'s response to the most recent outreach attempt. Indicates whether the patient engaged, scheduled an appointment, declined the service, could not be reached, or has not yet responded. Drives next-step care coordinator actions.']
  priority_level varchar [note: 'The clinical or operational priority assigned to this care gap, used to triage outreach efforts. High priority may reflect overdue preventive services, high-risk patients, or gaps with significant quality score impact. Assigned by Epic Healthy Planet risk stratification or care coordinator review.']
  reporting_period_end date [note: 'The end date of the quality program reporting period. Care gap closures must occur on or before this date to count toward the current measurement cycle numerator.']
  reporting_period_start date [note: 'The start date of the quality program reporting period during which this care gap is eligible for closure and numerator credit. Aligns with HEDIS measurement year or CMS program-specific reporting windows.']
  reporting_program varchar [note: 'The quality reporting program under which this care gap is tracked and submitted. Examples include HEDIS (NCQA), MIPS (Merit-based Incentive Payment System), ACO MSSP (Medicare Shared Savings Program), VBP (Value-Based Purchasing), PCMH (Patient-Centered Medical Home), CMS Star Ratings, or APM (Alternative Payment Model). [ENUM-REF-CANDIDATE: HEDIS|MIPS|ACO_MSSP|VBP|PCMH|CMS_STAR|APM — 7 candidates stripped; promote to reference product]']
  risk_score decimal(10,4) [note: 'The patient\'s risk stratification score at the time this care gap was identified, derived from Epic Healthy Planet or a population health risk model (e.g., HCC risk score, ACG score). Used to prioritize high-risk patients for gap closure outreach.']
  scheduled_appointment_date date [note: 'The date of a scheduled appointment intended to address and close this care gap. Populated when outreach_response_status is \'appointment_scheduled\'. Sourced from Epic Cadence scheduling module.']
  snomed_code varchar [note: 'The SNOMED CT concept code representing the clinical finding, procedure, or condition associated with this care gap. Supports semantic interoperability with HL7 FHIR-based population health platforms.']
  source_gap_reference varchar [note: 'The native identifier for this care gap record in the originating source system (e.g., Epic Healthy Planet internal gap ID). Supports ETL reconciliation, deduplication, and upstream system traceability.']
  updated_timestamp timestamp [note: 'The timestamp when this care gap record was most recently modified in the data platform, including status changes, outreach updates, or closure events. Supports incremental ETL processing and audit compliance.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Care gaps identified for patients in quality measures.'
}

Table quality.sdoh_screening {
  sdoh_screening_id varchar [pk, note: 'Primary key for sdoh_screening']
  care_site_id varchar [note: 'Reference to the facility or care site where the SDOH screening was administered. Supports site-level quality reporting and CMS facility-based measure stratification.']
  chw_intervention_id varchar [note: 'CHW intervention triggered from the screening.']
  clinician_id varchar [note: 'Reference to the clinician or care team member who administered the SDOH screening tool. Used for provider-level quality attribution and MIPS reporting.']
  community_resource_id varchar [note: 'Community resource the screened patient was connected to.']
  compliance_regulatory_submission_id varchar [note: 'Foreign key linking to compliance.regulatory_submission. Business justification: SDOH screening data must be submitted for CMS health equity measures, HEDIS social needs screening measures, and ACO health equity reporting. Compliance system tracks submission of screening rates, po']
  health_plan_id varchar [note: 'Foreign key linking to insurance.health_plan. Business justification: SDOH screening requirements vary by plan. Plans report screening rates to CMS and state regulators for health equity measures and social determinants quality reporting.']
  loinc_code_id varchar [note: 'Foreign key linking to reference.loinc_code. Business justification: SDOH screenings use standardized LOINC codes for interoperability and quality reporting (e.g., food insecurity, housing instability, transportation needs). CMS quality measures and health equity repor']
  mpi_record_id varchar [note: 'Reference to the patient who received the SDOH screening. Links to the patient master record. Satisfies TRANSACTION_HEADER PARTY_REFERENCE minimum category.']
  need_closure_id varchar [note: 'Need closure record tracking resolution of the screened SDOH need.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: SDOH screenings are increasingly required by payers for health equity reporting and VBC contracts. Payers track screening rates and positive screen follow-up for quality measure compliance.']
  quality_measure_id varchar [note: 'Foreign key linking to quality.measure. Business justification: SDOH screenings are tracked for quality measure compliance (CMS quality programs require SDOH screening documentation). Currently sdoh_screening has cms_measure_code as STRING, which should be normali']
  referral_consent_record_id varchar [note: 'Foreign key linking to consent.consent_record. Business justification: SDOH screening programs require patient consent before sharing information with community resources or external agencies. CMS quality measures for social needs screening require documented consent for']
  sdoh_assessment_id varchar [note: 'Foreign key linking to patient.sdoh_assessment. Business justification: Quality SDOH screening tracks measure compliance (CMS eCQMs, HEDIS). Patient SDOH assessment captures clinical interventions and referrals. Linking validates screening completion against clinical docu']
  sdoh_need_closure_id varchar [note: 'FK to the need closure tracking table for monitoring resolution of identified social determinant needs.']
  sdoh_referral_id varchar [note: 'FK to the SDOH referral management table linking screening results to community resource referrals.']
  sdoh_risk_stratification_id varchar [note: 'FK to the SDOH risk stratification table for priority scoring and population segmentation.']
  sdoh_zcode_mapping_id varchar [note: 'FK to the ICD-10 Z-code mapping']
  snomed_concept_id varchar [note: 'Foreign key linking to reference.snomed_concept. Business justification: SDOH screenings use SNOMED codes for structured clinical documentation and problem list integration in EHR systems. Quality reporting and health equity stratification require validated SNOMED concept ']
  unit_id varchar [note: 'Foreign key linking to facility.unit. Business justification: Social determinants of health screening programs deployed at unit level (ED, inpatient units, outpatient clinics) with unit-specific workflows and community resource referral processes. Quality teams ']
  visit_id varchar [note: 'Reference to the clinical encounter during which the SDOH screening was administered. Supports linkage to visit context for quality reporting and population health analytics.']
  zcode_mapping_id varchar [note: 'ICD-10 Z-code mapping for the identified social need.']
  administration_mode decimal(9,4) [note: 'Method by which the SDOH screening was administered to the patient. Supports stratification of screening completion rates by modality and equity analysis.']
  community_resource_connected boolean [note: 'Indicates whether the patient was successfully connected to a community resource following a positive SDOH screen and referral. Supports close-the-loop tracking for CMS SDOH quality measures.']
  created_timestamp timestamp [note: 'Timestamp when the SDOH screening record was first created in the source system. Used for audit trail and data lineage. Satisfies TRANSACTION_HEADER RECORD_AUDIT_CREATED minimum category.']
  health_equity_stratifier varchar [note: 'Stratification category used for health equity reporting (e.g., race/ethnicity group, payer type, geographic area). Supports CMS health equity reporting requirements and SDOH disparity analysis. Value is a non-PHI aggregate category, not individual patient data.']
  interpreter_used boolean [note: 'Indicates whether a professional interpreter was used during the SDOH screening administration. Supports language access compliance reporting and health equity analytics.']
  is_denominator_eligible boolean [note: 'Indicates whether this patient-screening record meets the denominator eligibility criteria for the associated CMS SDOH quality measure. Supports automated measure calculation in the Silver layer.']
  is_numerator_compliant boolean [note: 'Indicates whether this screening record satisfies the numerator criteria for the associated CMS SDOH quality measure (i.e., screening was completed). Supports automated measure rate calculation.']
  is_positive_screen boolean [note: 'Indicates whether the patient screened positive for a social need in this SDOH domain. A positive screen triggers referral workflows and community resource connection. Core flag for CMS SDOH quality measure numerator identification.']
  is_referral_generated boolean [note: 'Indicates whether a community resource or social services referral was generated as a result of a positive SDOH screen. Key metric for CMS SDOH quality measure numerator tracking and health equity reporting.']
  language_of_administration decimal(9,4) [note: 'ISO 639-1 two-letter language code indicating the language in which the SDOH screening was administered. Supports health equity reporting and language access compliance under Title VI of the Civil Rights Act.']
  need_resolution_date date [note: 'Date on which the patient\'s social need was confirmed resolved. Supports longitudinal outcomes measurement and population health program effectiveness reporting.']
  need_resolved boolean [note: 'Indicates whether the identified social need was resolved following intervention and community resource connection. Supports longitudinal population health outcomes tracking.']
  positive_screen_reason varchar [note: 'Clinical or administrative reason code or description explaining why the patient screened positive for this SDOH domain. Supports CDI and population health care management workflows.']
  program_year varchar [note: 'Calendar year of the quality measurement program to which this SDOH screening record is attributed. Used for annual CMS quality measure reporting, HEDIS measurement year alignment, and MIPS performance period tracking.']
  question_text varchar [note: 'Verbatim text of the SDOH screening question as presented to the patient. Supports audit, quality review, and longitudinal tracking of question wording across tool versions.']
  referral_date date [note: 'Date on which the community resource or social services referral was generated following a positive SDOH screen. Used to measure timeliness of referral and close-the-loop quality metrics.']
  referral_type varchar [note: 'Category of referral generated in response to a positive SDOH screen. Supports population health program tracking and community partnership analytics.']
  refusal_reason varchar [note: 'Reason the patient declined or was unable to complete the SDOH screening. Required for denominator exclusion logic in CMS SDOH quality measures and equity reporting.']
  reporting_period_end date [note: 'End date of the quality reporting period to which this SDOH screening is attributed. Supports CMS quality measure submission windows and HEDIS measurement period alignment.']
  reporting_period_start date [note: 'Start date of the quality reporting period to which this SDOH screening is attributed. Supports CMS quality measure submission windows and HEDIS measurement period alignment.']
  resource_connection_date date [note: 'Date on which the patient was confirmed connected to the community resource. Used to calculate time-to-connection metrics and close-the-loop quality measure compliance.']
  response_code varchar [note: 'Standardized code (e.g., LOINC answer code, SNOMED CT) representing the patient\'s response to the SDOH screening question. Enables structured analytics and interoperability distinct from the free-text response value.']
  response_value decimal(18,2) [note: 'Patient\'s verbatim or coded response to the SDOH screening question. Contains Protected Health Information (PHI) as it reflects the patient\'s social needs. Satisfies TRANSACTION_HEADER QUANTITATIVE_RESULT minimum category for non-monetary clinical transactions.']
  screening_date date [note: 'Calendar date on which the SDOH screening was administered to the patient. Used as the principal event date for quality measure denominator and numerator identification. Satisfies TRANSACTION_HEADER BUSINESS_EVENT_TIMESTAMP minimum category.']
  screening_number varchar [note: 'Externally visible business identifier for the SDOH screening event, typically sourced from the EHR (Epic Healthy Planet or Cerner Millennium). Used for cross-system reconciliation and audit trail. Satisfies TRANSACTION_HEADER BUSINESS_IDENTIFIER minimum category.']
  screening_setting varchar [note: 'Clinical care setting in which the SDOH screening was administered. Supports stratification of screening rates by care setting for CMS quality reporting and health equity analytics.']
  screening_status varchar [note: 'Current workflow status of the SDOH screening record. Indicates whether the screening was fully completed, partially administered, refused by the patient, or voided. Satisfies TRANSACTION_HEADER LIFECYCLE_STATUS minimum category.']
  screening_timestamp timestamp [note: 'Precise date and time the SDOH screening was administered, including timezone offset. Supports time-of-day analytics and HL7 FHIR Observation.effectiveDateTime mapping.']
  screening_tool_code varchar [note: 'Standardized code identifying the validated SDOH screening instrument used. Common tools include AHC HRSN (Accountable Health Communities Health-Related Social Needs), PRAPARE (Protocol for Responding to and Assessing Patients\' Assets, Risks, and Experiences), and Hunger Vital Sign. [ENUM-REF-CANDIDATE: AHC_HRSN|PRAPARE|HUNGER_VITAL_SIGN|WELLCARE|ISCREEN|WE_CARE|NACHC_SDOH|EPIC_SDOH — promote to reference product]']
  screening_tool_name varchar [note: 'Human-readable name of the SDOH screening instrument administered (e.g., \'Accountable Health Communities Health-Related Social Needs Screening Tool\', \'PRAPARE\', \'Hunger Vital Sign\'). Supports display in clinical dashboards and quality reports.']
  screening_tool_version varchar [note: 'Version number or edition of the SDOH screening tool used. Important for longitudinal comparability and measure specification alignment as tools are updated.']
  sdoh_domain varchar [note: 'Primary SDOH domain assessed by this screening record. Each domain represents a distinct social need category per CMS and AHRQ SDOH frameworks. A single screening encounter may generate multiple domain-level records. [ENUM-REF-CANDIDATE: food_insecurity|housing_instability|transportation|interpersonal_safety|financial_strain|utilities|childcare|education|employment|social_isolation — promote to reference product]']
  source_system_record_reference varchar [note: 'Native identifier of the SDOH screening record in the originating operational system (e.g., Epic SmartData element ID, Cerner PowerForm instance ID). Supports cross-system reconciliation and ETL audit.']
  updated_timestamp timestamp [note: 'Timestamp when the SDOH screening record was last modified in the source system. Supports incremental ETL processing and change data capture. Satisfies TRANSACTION_HEADER RECORD_AUDIT_UPDATED minimum category.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Social Determinants of Health screening results.'
}

Table quality.corrective_action {
  corrective_action_id varchar [pk, note: 'Unique identifier for the corrective action record. Primary key for the corrective action entity.']
  accreditation_survey_id varchar [note: 'Reference to the accreditation survey that identified the deficiency requiring this corrective action, if applicable.']
  budget_id varchar [note: 'Foreign key linking to finance.budget. Business justification: Corrective actions from safety events, accreditation findings, or peer reviews require budget allocation for implementation (staff training, process redesign, monitoring systems). Finance teams track ']
  capital_expenditure_id varchar [note: 'Foreign key linking to finance.capital_expenditure. Business justification: Some corrective actions require capital purchases (equipment replacement for safety compliance, facility modifications for accreditation standards, technology upgrades for infection control). These ar']
  care_site_id varchar [note: 'Reference to the healthcare facility where the corrective action is being implemented.']
  committee_id varchar [note: 'Foreign key linking to quality.committee. Business justification: Corrective actions are often reviewed, approved, or monitored by quality committees (e.g., Patient Safety Committee, Quality Improvement Committee). This FK enables tracking which committee has oversi']
  compliance_corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Quality corrective actions originating from safety events, accreditation findings, or peer reviews must link to compliance CAP system for regulatory tracking, submission to CMS/TJC, verification of ef']
  employee_id varchar [note: 'Reference to the provider, staff member, or leader assigned primary accountability for completing the corrective action.']
  improvement_initiative_id varchar [note: 'Reference to the broader quality improvement initiative that this corrective action supports, if applicable.']
  interface_downtime_id varchar [note: 'Foreign key linking to interoperability.interface_downtime. Business justification: Corrective actions for interface failures (e.g., missed lab results causing patient safety events) reference specific downtime events as the originating incident. This link supports action plan tracki']
  material_master_id varchar [note: 'Foreign key linking to supply.material_master. Business justification: Corrective actions frequently target specific supply items (remove from formulary, change par levels, implement new storage protocol, restrict usage). Direct link to material master supports action im']
  mortality_review_id varchar [note: 'Reference to the mortality review case that identified the need for this corrective action, if applicable.']
  parent_corrective_action_id varchar [note: 'Self-referencing FK on corrective_action (parent_corrective_action_id)']
  patient_safety_event_id varchar [note: 'Reference to the patient safety event that triggered this corrective action, if applicable.']
  quality_peer_review_id varchar [note: 'Reference to the peer review case that identified the need for this corrective action, if applicable.']
  recall_notice_id varchar [note: 'Foreign key linking to supply.recall_notice. Business justification: Many corrective actions originate from product recalls (quarantine affected lots, notify patients with implants, update preference cards). Linking to recall notice enables tracking of recall-driven qu']
  standard_finding_id varchar [note: 'Reference to the specific accreditation or regulatory standard finding that requires this corrective action, if applicable.']
  acceptance_date date [note: 'Date when the regulatory or accreditation body formally accepted the corrective action plan or evidence of completion.']
  acceptance_status varchar [note: 'Status of the corrective action plan or evidence as reviewed and accepted by the regulatory or accreditation body.']
  action_description varchar [note: 'Detailed narrative description of the corrective or preventive action to be taken, including specific steps, interventions, and expected outcomes.']
  action_number varchar [note: 'Business-facing unique identifier or tracking number for the corrective action, used for external reference and communication with regulatory bodies and accreditation organizations.']
  action_status varchar [note: 'Current lifecycle status of the corrective action indicating progress through the action workflow from initiation to closure.']
  action_type varchar [note: 'Classification of the action as corrective (addressing an existing deficiency), preventive (preventing future occurrence), or both.']
  assigned_date date [note: 'Date when the corrective action was formally assigned to the responsible party.']
  completion_date date [note: 'Actual date when the corrective action was completed and implemented.']
  created_timestamp timestamp [note: 'Date and time when the corrective action record was first created in the system.']
  days_to_complete varchar [note: 'Number of calendar days elapsed from action assignment to completion, used for performance monitoring and accountability tracking.']
  department_name varchar [note: 'Name of the clinical or operational department responsible for implementing the corrective action.']
  due_date date [note: 'Target completion date for the corrective action, often driven by regulatory deadlines or accreditation requirements.']
  effectiveness_verification_date date [note: 'Date when the effectiveness of the corrective action was formally verified and documented.']
  effectiveness_verification_method varchar [note: 'Description of the method or process used to verify that the corrective action achieved its intended outcome and prevented recurrence (e.g., audits, chart reviews, process observations, outcome measurement).']
  effectiveness_verified boolean [note: 'Flag indicating whether the corrective action has been verified as effective in addressing the root cause and preventing recurrence.']
  is_cms_reportable boolean [note: 'Flag indicating whether this corrective action is required to be reported to CMS as part of a plan of correction or quality program submission.']
  is_overdue boolean [note: 'Flag indicating whether the corrective action has passed its due date without completion.']
  is_state_reportable boolean [note: 'Flag indicating whether this corrective action is required to be reported to state health department or licensing authority.']
  is_tjc_reportable boolean [note: 'Flag indicating whether this corrective action is required to be reported to The Joint Commission as part of accreditation survey response or sentinel event follow-up.']
  monitoring_frequency varchar [note: 'Frequency at which the corrective action and its sustained effectiveness will be monitored (e.g., weekly, monthly, quarterly, annually).']
  monitoring_method varchar [note: 'Description of the ongoing monitoring process or mechanism used to ensure sustained compliance and effectiveness of the corrective action.']
  originating_event_type varchar [note: 'Classification of the source event or finding that triggered the need for this corrective action. [ENUM-REF-CANDIDATE: patient_safety_event|accreditation_finding|regulatory_deficiency|peer_review|mortality_review|quality_measure_gap|complaint|audit_finding — 8 candidates stripped; promote to reference product]']
  priority_level varchar [note: 'Priority classification indicating the urgency and importance of completing the corrective action based on risk severity and regulatory requirements.']
  regulatory_program varchar [note: 'Name of the regulatory or quality program that requires or monitors this corrective action (e.g., CMS Conditions of Participation, TJC Accreditation, State Licensure, MIPS, VBP).']
  responsible_party_name varchar [note: 'Full name of the individual or role accountable for executing and completing the corrective action.']
  responsible_party_role varchar [note: 'Job title or functional role of the individual assigned responsibility for the corrective action (e.g., Nurse Manager, Quality Director, Department Chair).']
  root_cause_category varchar [note: 'High-level classification of the root cause type that the corrective action addresses, used for trending and systemic improvement. [ENUM-REF-CANDIDATE: human_factors|communication|process_design|equipment|environment|training|policy_procedure — 7 candidates stripped; promote to reference product]']
  root_cause_summary varchar [note: 'Summary of the root cause analysis findings that informed the design of this corrective action, linking the action to underlying system or process failures.']
  service_line varchar [note: 'Clinical service line or specialty area affected by or responsible for the corrective action (e.g., cardiology, surgery, emergency medicine).']
  source_system_action_reference varchar [note: 'Unique identifier for the corrective action in the originating source system, used for data lineage and reconciliation.']
  submission_date date [note: 'Date when the corrective action plan or evidence of completion was submitted to the regulatory or accreditation body.']
  updated_timestamp timestamp [note: 'Date and time when the corrective action record was last modified in the system.']
  verification_notes varchar [note: 'Detailed notes and findings from the effectiveness verification process, including evidence of sustained improvement or identification of additional actions needed.']
  verification_result varchar [note: 'Outcome of the effectiveness verification assessment, indicating whether the corrective action successfully resolved the issue.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Corrective actions for quality findings and deficiencies.'
}

Table quality.program_measure_assignment {
  program_measure_assignment_id varchar [pk, note: 'Unique surrogate identifier for the program-measure assignment record. Primary key.']
  program_measure_id varchar
  program_quality_measure_id varchar [note: 'Foreign key linking to the quality measure. Part of the composite business key (quality_program_id, quality_measure_id, measure_inclusion_start_date).']
  quality_program_id varchar [note: 'Foreign key linking to the quality program. Part of the composite business key (quality_program_id, quality_measure_id, measure_inclusion_start_date).']
  achievement_threshold decimal(10,4) [note: 'Program-specific performance threshold for this measure that defines achievement level or benchmark attainment. Thresholds vary by program even for the same measure (e.g., CMS VBP vs. internal quality program).']
  assigned_by varchar [note: 'User ID or name of the quality team member who assigned this measure to this program. Supports audit and accountability.']
  assigned_date timestamp [note: 'Timestamp when this measure was assigned to this program in the system. Supports audit trail.']
  assignment_status varchar
  created_timestamp timestamp
  improvement_threshold decimal(10,4) [note: 'Program-specific improvement threshold for this measure used in improvement scoring methodologies. Defines the performance improvement required to earn improvement points.']
  is_mandatory boolean [note: 'Indicates whether this measure is mandatory or optional within this program. Some programs allow measure selection from a menu; others require all measures.']
  last_modified_by varchar [note: 'User ID or name of the quality team member who last modified this program-measure assignment configuration.']
  last_modified_date timestamp [note: 'Timestamp of the last modification to this program-measure assignment record.']
  measure_domain_assignment varchar [note: 'Program-specific domain or category assignment for this measure (e.g., Clinical Outcomes, Safety, Efficiency for VBP; Quality, Cost, Improvement Activities for MIPS). A measure may be assigned to different domains in different programs.']
  measure_inclusion_end_date date [note: 'Date on which this measure was removed or became inactive within this quality program. Null indicates the measure is currently active in the program.']
  measure_inclusion_start_date date [note: 'Date on which this measure became active within this quality program. Supports temporal tracking of program measure composition changes across program years.']
  measure_points_available decimal(10,2) [note: 'Total points available for this measure within this program\'s scoring methodology. Used in point-based programs like MIPS.']
  measure_reporting_frequency varchar [note: 'Frequency at which this measure must be reported or calculated for this specific program. A measure may be reported quarterly for one program and annually for another.']
  measure_status_in_program varchar [note: 'Current lifecycle status of this measure within this specific program. A measure may be active in one program and inactive in another. Drives reporting and calculation logic.']
  measure_weight decimal(5,2) [note: 'Percentage weight or point value assigned to this measure within the quality program\'s total performance score calculation. Used in VBP, MIPS, and other pay-for-performance programs where measures contribute differentially to overall program score.']
  notes varchar [note: 'Free-text notes documenting rationale for measure inclusion, exclusion, or configuration decisions for this program-measure combination.']
  updated_timestamp timestamp
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Assignment of quality measures to quality programs.'
}

Table quality.initiative_measure_target {
  initiative_measure_target_id varchar [pk, note: 'Unique surrogate identifier for this initiative-measure targeting relationship']
  improvement_initiative_id varchar [note: 'Foreign key linking to the improvement initiative that is targeting this measure']
  initiative_measure_id varchar
  initiative_quality_measure_id varchar [note: 'Foreign key linking to the quality measure being targeted by this initiative']
  baseline_period_end date [note: 'End date of the measurement period used to calculate the baseline performance for this specific measure within this initiative']
  baseline_period_start date [note: 'Start date of the measurement period used to calculate the baseline performance for this specific measure within this initiative']
  baseline_value decimal(18,4) [note: 'Quantitative baseline performance level for this specific measure at the time the initiative commenced. This is measure-specific and belongs to the relationship, not to the initiative alone (which may target multiple measures with different baselines).']
  created_timestamp timestamp
  current_performance_date date [note: 'Date on which the current performance value was last measured or updated for this measure within this initiative']
  current_performance_value decimal(18,4) [note: 'Most recently recorded performance value for this specific measure within this initiative. Enables real-time tracking of progress toward the goal for each measure.']
  goal_value decimal(18,4) [note: 'Target quantitative performance level the initiative aims to achieve for this specific measure. Each measure targeted by an initiative may have different goal values.']
  is_primary_measure boolean [note: 'Indicates whether this is the primary/lead measure for the initiative (true) or a secondary/balancing measure (false). An initiative typically has one primary measure and may have multiple secondary measures.']
  measure_role_in_initiative varchar [note: 'Categorical role this measure plays within the improvement initiative (e.g., Primary outcome measure, Balancing measure, Process measure). Supports IHI Model for Improvement methodology which requires tracking multiple measure types.']
  measure_unit varchar [note: 'Unit of measurement for the target measure (e.g., \'per 1,000 catheter days\', \'percentage\', \'rate per 100 admissions\'). Required for accurate baseline and goal comparison. [Moved from improvement_initiative: This attribute stores the unit of measurement for \'the target measure\'. However, if an initiative targets multiple measures, each measure may have different units. This should come from the measure table or be stored per initiative-measure relationship, not on the initiative itself.]']
  measurement_end_date date [note: 'Date when measurement and tracking of this specific measure concluded for this initiative. Null if still actively tracked.']
  measurement_start_date date [note: 'Date when active measurement and tracking of this specific measure began for this initiative. May differ from initiative start date if measures are added during the initiative lifecycle.']
  target_rate decimal(7,4)
  target_status varchar [note: 'Current status of progress toward the goal for this specific measure (e.g., On Track, At Risk, Behind, Goal Met, Suspended). Enables status tracking per measure within an initiative.']
  updated_timestamp timestamp
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Performance targets for quality improvement initiatives.'
}

Table quality.contract_initiative {
  contract_initiative_id varchar [pk, note: 'Unique surrogate identifier for this contract-initiative linkage record. Primary key.']
  contract_created_by_employee_id varchar [note: 'Identifier of the employee who created this contract-initiative linkage record, typically a contract administrator or quality program manager.']
  contract_last_updated_by_employee_id varchar [note: 'Identifier of the employee who most recently updated this contract-initiative linkage record.']
  improvement_initiative_id varchar [note: 'Foreign key linking to the quality improvement initiative that is contractually required or incentivized by the payer contract']
  payer_contract_id varchar [note: 'Foreign key linking to the payer contract that requires or incentivizes this quality improvement initiative']
  payer_id varchar
  contract_initiative_status varchar [note: 'Current lifecycle status of this contract-initiative linkage. Tracks whether the initiative is actively being pursued for this specific contract\'s requirements.']
  contract_measure_code varchar [note: 'The specific quality measure code or identifier used in this payer contract to reference this initiative. May differ from the initiative\'s internal measure code if the payer uses a different coding system.']
  created_date timestamp [note: 'Timestamp when this contract-initiative linkage record was created in the system.']
  created_timestamp timestamp
  end_date date [note: 'Date on which this contract-initiative linkage ended or is scheduled to end. May be driven by contract termination, initiative completion, or contractual requirement sunset.']
  incentive_amount decimal(15,2) [note: 'Dollar amount of quality bonus or incentive payment available from this payer contract if the initiative achieves the contract-specific performance target.']
  incentive_earned_to_date decimal(15,2) [note: 'Cumulative dollar amount of quality incentive payments earned from this payer contract for this initiative as of the current date.']
  is_mandatory boolean [note: 'Indicates whether this initiative is contractually mandatory (required by the payer contract) or voluntary (eligible for incentive but not required).']
  last_reported_date date [note: 'Date on which performance for this contract-initiative linkage was most recently reported to the payer.']
  last_updated_date timestamp [note: 'Timestamp when this contract-initiative linkage record was most recently updated.']
  next_reporting_due_date date [note: 'Date by which the next performance report for this contract-initiative linkage is due to the payer per contractual obligations.']
  penalty_amount decimal(15,2) [note: 'Dollar amount of financial penalty or withheld payment from this payer contract if the initiative fails to meet the contract-specific performance target.']
  penalty_incurred_to_date decimal(15,2) [note: 'Cumulative dollar amount of quality penalties or withheld payments incurred from this payer contract for this initiative as of the current date.']
  performance_target decimal(18,4) [note: 'The specific quantitative performance target for this initiative as defined in this payer contract. May differ from the initiative\'s overall goal if the contract specifies a different threshold for incentive eligibility.']
  reporting_frequency varchar [note: 'Frequency at which performance on this initiative must be reported to this payer per contractual requirements.']
  start_date date [note: 'Date on which this initiative became contractually linked to this payer contract. May differ from the initiative\'s overall start date if the contract was signed after initiative launch.']
  updated_timestamp timestamp
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Quality initiatives tied to value-based contracts.'
}

Table quality.program_study_participation {
  program_study_participation_id varchar [pk, note: 'Unique surrogate identifier for this program-study participation record. Primary key.']
  primary_program_quality_program_id varchar [note: 'Foreign key linking to the quality program affected by research study participation']
  program_research_study_id varchar [note: 'Foreign key to research_study. Identifies which research study impacts quality program measures.']
  program_study_research_study_id varchar [note: 'Foreign key linking to the research study that impacts quality program measures']
  affected_measure_ids varchar [note: 'Comma-separated list of specific quality measure IDs within the program that are affected by this research study participation. Enables targeted exclusion/stratification logic application.']
  cms_reporting_flag boolean [note: 'Indicates whether this program-study relationship must be reported to CMS as part of regulatory quality data submission. Drives compliance workflow.']
  created_date timestamp [note: 'Timestamp when this program-study participation record was created in the system.']
  created_timestamp timestamp
  end_date date [note: 'The date on which this research study stopped impacting the quality program\'s measure calculation, or null if ongoing. Defines the end of the period during which exclusion/stratification rules apply. Explicitly identified in detection phase.']
  enrollment_impact_on_measures varchar [note: 'Detailed description of how patient enrollment in this research study impacts specific quality measures within the program. Documents which measures are affected and the nature of the impact. Explicitly identified in detection phase.']
  last_updated_by varchar [note: 'User or system identifier that last updated this program-study participation record.']
  last_updated_date timestamp [note: 'Timestamp of the most recent update to this program-study participation record.']
  measure_stratification_required boolean [note: 'Indicates whether CMS or the program sponsor requires separate stratified reporting of quality measures for patients enrolled in this research study versus non-enrolled patients. Drives reporting workflow and data submission requirements. Explicitly identified in detection phase.']
  participation_status varchar [note: 'Current operational status of this program-study participation relationship. Determines whether exclusion/stratification rules are currently being applied in measure calculation.']
  program_participation_type varchar [note: 'Categorical classification of how the research study participation affects quality program measure calculation. Determines the operational impact on performance scoring and reporting. Explicitly identified in detection phase.']
  reporting_exclusion_rules varchar [note: 'Specific exclusion logic and rules to be applied when calculating quality measures for patients enrolled in this research study. Defines how study participants are handled in numerator/denominator calculations. Explicitly identified in detection phase.']
  start_date date [note: 'The date on which this research study began impacting the quality program\'s measure calculation and reporting. Defines the beginning of the period during which exclusion/stratification rules apply. Explicitly identified in detection phase.']
  updated_timestamp timestamp
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']
  created_by varchar [note: 'User or system identifier that created this program-study participation record.']

  Note: 'Participation of quality programs in research studies.'
}

Table quality.measure_budget_allocation {
  measure_budget_allocation_id varchar [pk, note: 'Unique surrogate identifier for each measure-budget allocation record. Primary key.']
  budget_id varchar
  budget_line_id varchar [note: 'Foreign key linking to the budget line providing funding for this quality measure']
  primary_quality_measure_id varchar [note: 'Foreign key linking to the quality measure being funded by this budget allocation']
  allocation_amount decimal(18,2)
  allocation_notes varchar [note: 'Free-text notes explaining the rationale for this budget allocation, assumptions about improvement activities, or justification for the funding level.']
  allocation_percentage decimal(5,2) [note: 'Percentage of the budget line amount allocated to this specific quality measure. Enables proportional cost allocation when a single budget line funds multiple measures.']
  allocation_status varchar [note: 'Current status of this budget allocation in the budget approval and execution lifecycle.']
  budgeted_improvement_cost decimal(18,2) [note: 'Dollar amount budgeted specifically for improvement activities related to this quality measure (e.g., staff training, process redesign, technology enhancements). Represents the investment expected to improve measure performance.']
  created_timestamp timestamp [note: 'Timestamp when this allocation record was first created in the system. Audit trail field.']
  effective_end_date date [note: 'Date on which this budget allocation ceases to be effective. Null for ongoing allocations.']
  effective_start_date date [note: 'Date from which this budget allocation becomes effective for this measure-budget line combination.']
  fiscal_year varchar [note: 'The fiscal year for which this budget allocation applies to this quality measure. Enables year-over-year tracking of measure funding.']
  measure_target_value decimal(8,4) [note: 'The performance target or goal set for this quality measure for this fiscal year and budget allocation. Expressed as a rate, percentage, or score depending on measure type. Links financial investment to expected performance outcome.']
  modified_by varchar [note: 'User identifier or name of the individual who last modified this allocation record. Audit trail field.']
  modified_timestamp timestamp [note: 'Timestamp when this allocation record was last modified. Audit trail field.']
  performance_incentive_amount decimal(18,2) [note: 'Expected financial return or incentive payment associated with achieving the measure target (e.g., VBP bonus, MIPS positive payment adjustment, shared savings). Enables ROI calculation for quality measure investments.']
  updated_timestamp timestamp
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']
  created_by varchar [note: 'User identifier or name of the individual who created this allocation record. Audit trail field.']

  Note: 'Budget allocations for quality measure reporting and improvement.'
}

Table quality.quality_program_participation {
  quality_program_participation_id varchar [pk, note: 'Unique identifier for the quality program participation.']
  quality_program_id varchar [note: 'Foreign key linking to quality.quality_program. Business justification: quality_program_participation is completely SILOED (only has PK + vibe/ssot columns, zero inbound and zero outbound FKs). It represents participation of care sites/providers IN a quality program, so i']
  merged_with_facility_facility_program_participation varchar [note: 'SSOT reconciliation attribute added by vibe cross-domain dedup pass.']
  ssot_canonical_reference varchar [note: 'Distinct entity; counterpart facility.facility_program_participation serves a separate domain context']
  ssot_reconciliation_status varchar [note: 'SSOT review: kept distinct from facility.facility_program_participation (documented as separate business concepts)']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Participation of care sites and providers in quality programs. Quality program participation. For facility-level participation see facility.facility_program_participation.'
}

Table quality.quality_committee {
  quality_committee_id varchar [pk, note: 'Unique identifier for the committee.']
  merged_with_provider_committee varchar [note: 'SSOT reconciliation attribute added by vibe cross-domain dedup pass.']
  ssot_canonical_reference varchar [note: 'Fully-qualified reference to the canonical SSOT table that supersedes this duplicate concept.']
  ssot_reconciliation_status varchar [note: 'SSOT reconciliation status indicating this product was reconciled against its canonical source-of-truth table.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Quality and safety committees (Mortality Review, Patient Safety, etc.). Quality and patient safety committee. For provider credentialing committees see provider.committee.'
}

Table quality.quality_program {
  quality_program_id varchar [pk, note: 'Unique identifier for the quality program.']
  merged_with_compliance_compliance_program varchar [note: 'SSOT reconciliation attribute added by vibe cross-domain dedup pass.']
  ssot_canonical_reference varchar [note: 'Distinct entity; counterpart compliance.compliance_program serves a separate domain context']
  ssot_reconciliation_status varchar [note: 'SSOT review: kept distinct from compliance.compliance_program (documented as separate business concepts)']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']

  Note: 'Quality and performance improvement program definitions. Quality domain program management. For compliance programs see compliance.compliance_program.'
}

Table quality.raf_score {
  raf_score_id varchar [pk, note: 'Primary key for raf_score']
  clinician_id varchar [note: 'Identifier of the provider or care team to whom the patient (and thus this RAF) is attributed for the program period.']
  mpi_record_id varchar [note: 'Identifier of the patient (member/beneficiary) to whom this RAF score applies.']
  prior_raf_score_id varchar [note: 'Self-referencing FK on raf_score (prior_raf_score_id)']
  calculation_date date [note: 'The date on which the RAF score was computed by the risk adjustment engine.']
  calculation_source varchar [note: 'The submission/data source basis for the score (e.g., claims, encounter data EDPS, RAPS, chart review supplemental).']
  calculation_status varchar [note: 'Lifecycle status of the score calculation from draft through final reconciliation.']
  coding_intensity_adjustment decimal(6,4) [note: 'The CMS-mandated coding pattern adjustment applied to the normalized RAF value.']
  created_timestamp timestamp [note: 'Timestamp when this RAF score record was first captured in the system.']
  data_collection_year varchar [note: 'The calendar year from which diagnosis (ICD) data was collected to compute the score.']
  demographic_score_component decimal(6,4) [note: 'The portion of the RAF value derived from demographic factors (age, sex, Medicaid status, disability, institutional status).']
  disease_score_component decimal(6,4) [note: 'The portion of the RAF value derived from documented Hierarchical Condition Categories (HCCs) / disease interactions.']
  effective_end_date date [note: 'The date through which this RAF score remains effective; nullable for open-ended current scores.']
  effective_start_date date [note: 'The date from which this RAF score is effective for the payment/scoring period.']
  enrollment_status varchar [note: 'The CMS enrollment segment used in scoring (e.g., continuing enrollee, new enrollee, institutional, community, ESRD) which determines model coefficient set.']
  hcc_count varchar [note: 'The total number of distinct HCCs captured and contributing to the disease score component for the period.']
  medicaid_dual_status varchar [note: 'The dual-eligible status flag (non-dual, partial, full) impacting demographic risk coefficients.']
  member_identifier varchar [note: 'External payer/CMS member or beneficiary identifier (e.g., Medicare Beneficiary Identifier) the RAF score is attributed to under the risk-bearing contract.']
  model_version varchar [note: 'The CMS HCC risk adjustment model version used to compute the score (e.g., V24, V28, RxHCC, ESRD model).']
  normalization_factor decimal(6,4) [note: 'The CMS-published normalization factor applied to the raw RAF value for the payment year.']
  normalized_raf_value decimal(6,4) [note: 'The RAF value after applying normalization factor and coding intensity adjustment, used for final payment determination.']
  payment_year varchar [note: 'The CMS payment year for which this RAF score determines risk-adjusted payment.']
  program_type varchar [note: 'The value-based / risk-bearing program under which this RAF score is calculated and reported. [ENUM-REF-CANDIDATE: medicare_advantage|aco|aco_reach|commercial_aca|medicaid|mssp|dual_eligible_snp — promote to reference product]']
  raf_gap_value decimal(6,4) [note: 'The difference between suspected and documented RAF, representing potential risk capture opportunity from open coding gaps.']
  raf_value decimal(6,4) [note: 'The principal calculated risk adjustment factor numeric value representing the patient\'s predicted relative cost/health burden. This is PHI as it reflects aggregate health condition severity.']
  score_type varchar [note: 'The methodology timing classification of the score: prospective (predicts future cost), concurrent (explains current period), or retrospective (reconciliation).']
  submission_status varchar [note: 'Status of the underlying diagnosis data submission to CMS that backs this score.']
  suspected_raf_value decimal(6,4) [note: 'Projected RAF value including suspected but not-yet-documented conditions identified via analytics/gap-closure workflows.']
  updated_timestamp timestamp [note: 'Timestamp when this RAF score record was last modified, supporting reconciliation and audit lineage.']

  Note: 'Master reference table for raf_score. Referenced by raf_score_id.'
}

Table quality.care_gap_closure {
  care_gap_closure_id varchar [pk, note: 'Primary key for care_gap_closure']
  clinician_id varchar [note: 'Reference to the provider responsible for or credited with closing the care gap (e.g., the rendering clinician who delivered the recommended service).']
  measure_id varchar [note: 'Reference to the quality measure (e.g., HEDIS, CMS Star, MIPS) that defines the care gap being closed.']
  member_mpi_record_id varchar [note: 'Health plan member identifier associated with the patient\'s coverage at the time the care gap was tracked, used for payer attribution and HEDIS reporting.']
  mpi_record_id varchar [note: 'Reference to the patient for whom this care gap was identified and closed. Links to the enterprise patient master (MPI) for multi-facility identity resolution.']
  reopened_care_gap_closure_id varchar [note: 'Self-referencing FK on care_gap_closure (reopened_care_gap_closure_id)']
  visit_id varchar [note: 'Reference to the clinical encounter during which the care gap was addressed or closed, supporting traceability to the visit where the service was rendered.']
  attribution_payer varchar [note: 'The health plan or payer to which this gap and its closure are attributed for value-based and HEDIS reporting purposes.']
  care_gap_number varchar [note: 'Externally-known business identifier for the care gap, used by care management and population health teams to reference the gap across systems and reports.']
  clinical_condition varchar [note: 'The underlying clinical condition or chronic disease driving the care gap (e.g., diabetes, hypertension), used for chronic care management cohorting. Protected health information.']
  closure_date date [note: 'The real-world date on which the qualifying service was rendered or the gap was confirmed closed. Principal business event date for closure-rate analytics.']
  closure_method varchar [note: 'The data source or mechanism through which the care gap was confirmed closed, supporting HEDIS hybrid and administrative measure validation.']
  closure_notes varchar [note: 'Free-text clinical or care management notes documenting the circumstances of the gap closure or exclusion. May contain protected health information.']
  closure_status varchar [note: 'Current lifecycle state of the care gap closure workflow, indicating whether the gap remains open, has been satisfactorily closed, or excluded.']
  compliance_flag boolean [note: 'Indicates whether the patient is now compliant with the measure numerator following gap closure (true) or remains non-compliant (false).']
  created_timestamp timestamp [note: 'Timestamp when this care gap closure record was first created in the quality data store.']
  due_date date [note: 'The date by which the recommended service must be performed to close the gap within the measurement period.']
  exclusion_reason varchar [note: 'The reason the care gap was excluded from the eligible denominator, supporting HEDIS valid data reporting exclusions.']
  gap_type varchar [note: 'Categorical classification of the care gap by clinical domain, segmenting the gap population for targeted outreach and analytics.']
  identification_date date [note: 'The date the care gap was first identified as open for the patient, marking the start of the outreach and intervention window.']
  last_outreach_date date [note: 'The date of the most recent patient outreach activity related to this care gap.']
  measure_domain varchar [note: 'The quality program domain the measure belongs to (e.g., HEDIS Effectiveness of Care, CMS Stars, MIPS). [ENUM-REF-CANDIDATE: hedis_effectiveness_of_care|hedis_access_availability|cms_stars|mips|vbp|cahps|aco_mssp — promote to reference product]']
  measure_year varchar [note: 'The HEDIS/quality measurement year for which this care gap applies, governing the reporting period and eligibility window.']
  outreach_attempt_count varchar [note: 'Number of patient outreach attempts (calls, letters, messages) made to encourage closure of the gap, supporting care management effectiveness analysis.']
  outreach_channel varchar [note: 'The communication channel used for the most recent outreach to the patient regarding the care gap.']
  priority_level varchar [note: 'The prioritization tier assigned to the gap for care management workqueues, based on clinical urgency and risk stratification.']
  program_name varchar [note: 'The value-based or quality program under which this gap is tracked (e.g., ACO MSSP, Medicare Advantage Stars, commercial VBP contract).']
  qualifying_code varchar [note: 'The CPT, HCPCS, ICD-10, LOINC, or CVX code that satisfies the numerator criteria and closes the gap, used for administrative measure validation.']
  qualifying_code_system varchar [note: 'The terminology system to which the qualifying code belongs, enabling correct interpretation of the closure evidence.']
  risk_score decimal(7,4) [note: 'The risk stratification score (e.g., HCC/RAF-derived) associated with the patient at gap identification, used to prioritize high-risk patients for closure.']
  service_date date [note: 'The date the qualifying clinical service (e.g., screening, immunization, lab) was performed that satisfies the measure numerator.']
  supplemental_data_flag boolean [note: 'Indicates whether non-claims supplemental data (e.g., EHR extract, registry) was used as evidence to close the gap, relevant for NCQA supplemental data validation.']
  updated_timestamp timestamp [note: 'Timestamp when this care gap closure record was last modified, supporting change tracking for quality workflows.']
  validation_status varchar [note: 'The audit/validation state of the closure evidence, indicating whether the supporting data has been reviewed and accepted for quality reporting.']

  Note: 'Master reference table for care_gap_closure. Referenced by care_gap_closure_id.'
}

Table quality.chw_intervention {
  chw_intervention_id varchar [pk, note: 'Primary key for chw_intervention']
  care_site_id varchar [note: 'Identifier of the facility or site associated with the CHW program managing the intervention.']
  employee_id varchar [note: 'Identifier of the community health worker (workforce member) who delivered the intervention.']
  mpi_record_id varchar [note: 'Identifier of the patient who is the recipient of the community health worker intervention.']
  barrier_identified varchar [note: 'Description of any barrier to care or resource access identified during the intervention. [ENUM-REF-CANDIDATE: language|transportation|cost|trust|literacy|availability|none — promote to reference product]']
  completion_timestamp timestamp [note: 'The date and time the intervention was marked complete, used to measure cycle time and program throughput.']
  consent_obtained_flag boolean [note: 'Indicates whether patient consent was obtained prior to delivering the intervention, supporting compliance and consent governance.']
  duration_minutes varchar [note: 'The total length of the intervention contact in minutes, supporting workload and productivity analysis.']
  encounter_modality varchar [note: 'The channel or setting through which the intervention was delivered to the patient.']
  followup_due_date date [note: 'The target date by which any required follow-up intervention should occur.']
  followup_required_flag boolean [note: 'Indicates whether an additional follow-up intervention is needed to address the patient\'s ongoing needs.']
  interpreter_used_flag boolean [note: 'Indicates whether language interpretation services were used during the intervention, supporting health equity measurement.']
  intervention_category varchar [note: 'Broad category that segments the intervention by the type of support provided, enabling population health analytics and program mix reporting.']
  intervention_code varchar [note: 'Externally-known short code identifying the specific intervention type within the CHW program catalog, used for standardized reporting and tracking.']
  intervention_name varchar [note: 'Human-readable name of the community health worker intervention, describing the supportive action delivered to a patient or population.']
  intervention_notes varchar [note: 'Free-text clinical and social notes documenting details of the intervention; contains protected health information.']
  intervention_status varchar [note: 'Current lifecycle state of the intervention as it progresses from planning through completion or cancellation.']
  intervention_timestamp timestamp [note: 'The actual real-world date and time the intervention was delivered to the patient, distinct from record audit timestamps.']
  location_name varchar [note: 'Name of the physical or community location where the intervention took place.']
  need_severity_score varchar [note: 'Numeric severity score of the social need at the time of intervention, supporting risk stratification and population health analytics.']
  outcome_status varchar [note: 'The resulting outcome of the intervention in addressing the patient\'s health-related social need.']
  primary_language varchar [note: 'The primary spoken language of the patient at the time of intervention, supporting culturally and linguistically appropriate services (CLAS) reporting.']
  priority_level varchar [note: 'Assigned urgency level guiding scheduling and resource allocation for the intervention.']
  program_name varchar [note: 'The name of the population health or value-based care program under which the intervention is delivered.']
  record_created_timestamp timestamp [note: 'Timestamp when the intervention record was first captured in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when the intervention record was last modified.']
  referral_completed_flag boolean [note: 'Indicates whether the patient successfully connected with the referred community resource, a key program effectiveness measure.']
  referral_source varchar [note: 'The originating source that triggered the intervention, used to analyze referral pathways and program reach.']
  resource_referred_to varchar [note: 'Name of the community resource or service organization the patient was connected to as part of the intervention.']
  scheduled_date date [note: 'The planned calendar date on which the intervention was scheduled to occur.']
  sdoh_domain varchar [note: 'The social determinant of health domain targeted by the intervention (e.g., housing, food security, transportation, utilities, interpersonal safety). [ENUM-REF-CANDIDATE: housing|food_insecurity|transportation|utilities|interpersonal_safety|employment|education|financial_strain — promote to reference product]']

  Note: 'Master reference table for chw_intervention. Referenced by chw_intervention_id.'
}

Table quality.sdoh_risk_stratification {
  sdoh_risk_stratification_id varchar [pk, note: 'Primary key for sdoh_risk_stratification']
  mpi_record_id varchar [note: 'Identifier of the patient whose social determinants of health risk is being stratified.']
  reviewing_clinician_id varchar [note: 'Identifier of the provider/clinician who reviewed and validated the stratification result.']
  visit_id varchar [note: 'Identifier of the clinical encounter during which the SDOH screening was administered or captured.']
  area_deprivation_index decimal(5,2) [note: 'Geographic socioeconomic deprivation index for the patient\'s residential area, used to contextualize individual risk.']
  assessment_reference_number varchar [note: 'Externally-known business reference number assigned to the SDOH screening/stratification instance for tracking and audit.']
  care_management_priority varchar [note: 'Prioritization level assigned for care management and population-health outreach based on the risk tier.']
  composite_risk_score decimal(6,2) [note: 'Principal quantitative composite score summarizing the patient\'s overall social determinant risk burden across all assessed domains.']
  consent_to_share_flag boolean [note: 'Indicates whether the patient consented to share SDOH data with community partners and referral organizations.']
  data_completeness_pct decimal(5,2) [note: 'Percentage of screening questions answered, indicating reliability/completeness of the resulting score.']
  data_source_type varchar [note: 'Origin of the SDOH data used for stratification, supporting data provenance and confidence assessment.']
  economic_domain_score decimal(6,2) [note: 'Sub-domain score quantifying economic stability risk (income, employment, financial strain).']
  education_barrier_flag boolean [note: 'Indicates limited education or health literacy barriers identified during screening.']
  employment_status varchar [note: 'Self-reported employment status captured as part of the SDOH economic domain assessment.']
  financial_strain_flag boolean [note: 'Indicates the patient reported financial strain affecting their ability to meet basic needs.']
  food_insecurity_flag boolean [note: 'Indicates the patient screened positive for food insecurity.']
  healthcare_access_domain_score decimal(6,2) [note: 'Sub-domain score quantifying healthcare access and quality risk (coverage, transportation).']
  housing_domain_score decimal(6,2) [note: 'Sub-domain score quantifying neighborhood and built-environment/housing risk.']
  housing_instability_flag boolean [note: 'Indicates the patient screened positive for housing instability or homelessness risk.']
  identified_needs_count varchar [note: 'Number of distinct positive social-need domains identified in this stratification.']
  insurance_coverage_gap_flag boolean [note: 'Indicates the patient reported gaps or lack of health insurance coverage affecting access.']
  interpersonal_safety_flag boolean [note: 'Indicates the patient screened positive for interpersonal violence or safety concerns.']
  intervention_recommendation varchar [note: 'Narrative description of recommended interventions or community resources based on identified social needs.']
  patient_declined_flag boolean [note: 'Indicates the patient declined to complete part or all of the SDOH screening, affecting score completeness.']
  primary_language varchar [note: 'Patient\'s primary spoken language, relevant for language-access barriers and equity analytics.']
  record_created_timestamp timestamp [note: 'Timestamp when this stratification record was first captured in the system.']
  referral_indicated_flag boolean [note: 'Indicates whether the stratification result warrants a referral to community-based social services.']
  residential_zip_code varchar [note: 'Patient residential postal code used for geographic SDOH index linkage and equity stratification.']
  risk_score_methodology varchar [note: 'Method used to calculate the composite risk score, supporting transparency and model governance.']
  risk_stratification_status varchar [note: 'Current lifecycle state of the SDOH risk stratification record.']
  risk_tier varchar [note: 'Categorical risk segmentation tier derived from the composite SDOH score, used to prioritize care management outreach.']
  screening_date date [note: 'Date on which the SDOH screening was administered to the patient.']
  screening_method varchar [note: 'Method by which the SDOH screening was administered to the patient.']
  screening_tool_name varchar [note: 'Standardized screening instrument used to capture social needs data (e.g., AHC-HRSN, PRAPARE).']
  screening_tool_version varchar [note: 'Version of the screening instrument used, supporting reproducibility and longitudinal comparison of scores.']
  social_context_domain_score decimal(6,2) [note: 'Sub-domain score quantifying social and community context risk (isolation, safety, support).']
  social_isolation_flag boolean [note: 'Indicates the patient screened positive for social isolation or lack of social connection.']
  social_vulnerability_index decimal(5,4) [note: 'CDC/ATSDR Social Vulnerability Index for the patient\'s geographic area, ranging 0-1.']
  stratification_calculated_timestamp timestamp [note: 'Timestamp when the composite risk score and tier were calculated for this record.']
  transportation_barrier_flag boolean [note: 'Indicates the patient reported transportation barriers affecting access to care.']
  utility_needs_flag boolean [note: 'Indicates the patient screened positive for difficulty paying for utilities (heat, electricity, water).']
  valid_from_date date [note: 'Date from which this risk stratification result is considered effective and current.']
  valid_until_date date [note: 'Date through which this stratification remains valid before re-screening is recommended (nullable for open-ended).']

  Note: 'Master reference table for sdoh_risk_stratification. Referenced by sdoh_risk_stratification_id.'
}

Table research.irb_submission {
  irb_submission_id varchar [pk, note: 'Primary key']
  audit_id varchar [note: 'Related compliance audit']
  care_site_id varchar [note: 'Care site where study is conducted']
  consent_policy_id varchar [note: 'Consent policy governing informed consent']
  primary_condition_icd_code_id varchar [note: 'Primary condition ICD code']
  primary_irb_employee_id varchar [note: 'Primary IRB reviewer employee ID']
  protocol_amendment_id varchar [note: 'Related protocol amendment']
  research_study_id varchar [note: 'Research study']
  tertiary_irb_reviewed_by_user_employee_id varchar [note: 'Tertiary IRB reviewer employee ID']
  acknowledgment_date date [note: 'IRB acknowledgment date']
  action_due_date date [note: 'Action due date for investigator response']
  action_required_description varchar [note: 'Description of required action']
  action_required_flag boolean [note: 'Flag indicating action required']
  agency_response_letter varchar [note: 'Agency response letter reference']
  approval_date date [note: 'IRB approval date']
  approval_expiration_date date [note: 'IRB approval expiration date']
  conditions_of_approval varchar [note: 'Conditions of approval text']
  created_timestamp timestamp [note: 'Record creation timestamp']
  determination_outcome varchar [note: 'IRB determination outcome (approved, modifications required, disapproved, deferred)']
  ectd_sequence_number varchar [note: 'Electronic Common Technical Document sequence number']
  federal_agency_name varchar [note: 'Federal agency name (FDA, NIH, etc.)']
  fwa_number varchar [note: 'Federalwide Assurance number']
  ide_number varchar [note: 'Investigational Device Exemption number']
  ind_number varchar [note: 'Investigational New Drug number']
  informed_consent_version varchar [note: 'Informed consent version submitted']
  irb_board_name varchar [note: 'IRB board name']
  last_modified_timestamp timestamp [note: 'Last modification timestamp']
  nct_number varchar [note: 'ClinicalTrials.gov NCT number']
  protocol_version varchar [note: 'Protocol version submitted']
  review_meeting_date date [note: 'IRB review meeting date']
  review_type varchar [note: 'Review type (full board, expedited, exempt)']
  reviewing_body_type varchar [note: 'Reviewing body type (local IRB, central IRB, sIRB)']
  risk_level varchar [note: 'Risk level (minimal, greater than minimal)']
  sponsor_organization varchar [note: 'Sponsor organization name']
  submission_date date [note: 'Submission date']
  submission_method varchar [note: 'Submission method (electronic, paper)']
  submission_notes varchar [note: 'Submission notes']
  submission_number varchar [note: 'Submission number']
  submission_status varchar [note: 'Submission status (pending, under review, approved, disapproved)']
  submission_type varchar [note: 'Submission type (initial, continuing review, amendment, adverse event, closure)']
  vulnerable_population_flag boolean [note: 'Flag indicating vulnerable population']
  vulnerable_population_type varchar [note: 'Vulnerable population type (children, prisoners, pregnant women, cognitively impaired)']

  Note: 'IRB submission tracking for initial review, continuing review, amendments, and adverse event reporting with determination outcomes and approval dates.'
}

Table research.study_site {
  study_site_id varchar [pk, note: 'Primary key']
  accreditation_status_id varchar [note: 'Site accreditation status']
  audit_id varchar [note: 'Related audit']
  care_site_id varchar [note: 'Care site']
  clinician_id varchar [note: 'Principal investigator clinician ID']
  cms_condition_status_id varchar [note: 'CMS condition of participation status']
  cost_center_id varchar [note: 'Cost center']
  inventory_location_id varchar [note: 'Investigational product inventory location']
  research_study_id varchar [note: 'Research study']
  site_coordinator_employee_id varchar [note: 'Site coordinator employee ID']
  activation_date date [note: 'Site activation date']
  actual_enrollment_count varchar [note: 'Actual enrollment count']
  adverse_event_count varchar [note: 'Total adverse event count']
  closure_date date [note: 'Site closure date']
  corrective_action_plan_due_date date [note: 'Corrective action plan due date']
  corrective_action_plan_required_flag boolean [note: 'Corrective action plan required flag']
  corrective_action_plan_status varchar [note: 'Corrective action plan status']
  created_timestamp timestamp [note: 'Record creation timestamp']
  cro_organization_name varchar [note: 'Contract research organization name']
  data_query_count varchar [note: 'Total data query count']
  enrollment_rate_per_month decimal(10,2) [note: 'Enrollment rate per month']
  informed_consent_compliance_status varchar [note: 'Informed consent compliance status']
  investigational_product_accountability_status varchar [note: 'Investigational product accountability status']
  irb_approval_date date [note: 'IRB approval date']
  irb_approval_number varchar [note: 'IRB approval number']
  irb_expiration_date date [note: 'IRB expiration date']
  irb_of_record_name varchar [note: 'IRB of record name']
  last_monitoring_visit_date date [note: 'Last monitoring visit date']
  last_monitoring_visit_type varchar [note: 'Last monitoring visit type']
  last_updated_timestamp timestamp [note: 'Last update timestamp']
  next_monitoring_visit_scheduled_date date [note: 'Next monitoring visit scheduled date']
  open_data_query_count varchar [note: 'Open data query count']
  planned_enrollment_capacity varchar [note: 'Planned enrollment capacity']
  protocol_deviation_count varchar [note: 'Protocol deviation count']
  regulatory_binder_status varchar [note: 'Regulatory binder status']
  screen_failure_count varchar [note: 'Screen failure count']
  serious_adverse_event_count varchar [note: 'Serious adverse event count']
  serious_protocol_deviation_count varchar [note: 'Serious protocol deviation count']
  site_name varchar [note: 'Site name']
  site_notes varchar [note: 'Site notes']
  site_number varchar [note: 'Site number']
  site_performance_score decimal(5,2) [note: 'Site performance score']
  site_risk_rating varchar [note: 'Site risk rating (low, medium, high)']
  site_status varchar [note: 'Site status (pending, active, closed, suspended)']
  source_document_verification_status varchar [note: 'Source document verification status']
  sponsor_organization_name varchar [note: 'Sponsor organization name']

  Note: 'Study site activation and performance tracking including enrollment metrics, monitoring visit history, regulatory binder status, and site risk rating.'
}

Table research.subject_enrollment {
  subject_enrollment_id varchar [pk, note: 'Unique identifier for the research subject enrollment record. Primary key for this entity.']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Subjects enroll at specific facilities. Enrollment metrics, site performance dashboards, patient safety monitoring, and resource allocation all require facility-level enrollment tracking. Fundamental ']
  employee_id varchar [note: 'Reference to the principal investigator responsible for this subject enrollment at the research site.']
  material_master_id varchar [note: 'Foreign key linking to supply.material_master. Business justification: Device trials and implantable studies require tracking specific products (devices, implants) assigned to enrolled subjects. Essential for UDI capture, device accountability, adverse event reporting, a']
  mpi_record_id varchar [note: 'Reference to the patient master record. Links enrollment to the patient domain via Medical Record Number (MRN) without duplicating patient master data.']
  notice_of_privacy_practices_id varchar [note: 'Foreign key linking to compliance.notice_of_privacy_practices. Business justification: Research subjects must receive NPP at enrollment per HIPAA. NPP distribution is documented per enrollment for compliance with Privacy Rule requirements.']
  patient_account_id varchar [note: 'Foreign key linking to billing.patient_account. Business justification: Research subjects often have dedicated billing accounts to segregate research charges from clinical charges, track sponsor-covered services, and manage research-specific billing rules. Essential for r']
  patient_identity_match_id varchar [note: 'Foreign key linking to interoperability.patient_identity_match. Business justification: Research subject enrollment requires patient identity matching across systems to prevent duplicate enrollments, ensure safety monitoring, and link research data to clinical EHR. Critical for protocol ']
  phi_access_log_id varchar [note: 'Foreign key linking to compliance.phi_access_log. Business justification: Subject enrollment creates PHI access events that must be logged for HIPAA compliance auditing. Standard access monitoring for research subject records.']
  primary_subject_study_research_study_id varchar [note: 'Unique study-specific identifier assigned to the research subject, distinct from Medical Record Number (MRN). Used for de-identification and research data governance.']
  study_arm_id varchar [note: 'Foreign key linking to research.study_arm. Business justification: Enrolled subjects are randomized to study arms. Currently has randomization_arm (STRING) but no FK to study_arm master. Adding study_arm_id FK allows removal of redundant randomization_arm column whic']
  study_site_id varchar [note: 'Reference to the clinical research site or facility where the subject is enrolled and followed.']
  adverse_event_flag boolean [note: 'Indicates whether any adverse events were reported for this subject during the enrollment period. True if adverse events exist, False otherwise.']
  completion_date date [note: 'Date when the subject completed all protocol-required study activities and assessments.']
  created_timestamp timestamp [note: 'Timestamp when this enrollment record was first created in the system. Audit trail for data governance and compliance.']
  data_lock_flag boolean [note: 'Indicates whether this enrollment record has been locked for final analysis and regulatory submission. True if locked, False if still editable.']
  data_lock_timestamp timestamp [note: 'Timestamp when this enrollment record was locked for final analysis. Null if not yet locked.']
  data_monitoring_committee_review_flag boolean [note: 'Indicates whether this subject enrollment was reviewed by the Data Monitoring Committee. True if reviewed, False otherwise.']
  eligibility_confirmed_flag boolean [note: 'Indicates whether the subject met all inclusion criteria and no exclusion criteria at the time of enrollment. True if eligibility was confirmed, False otherwise.']
  enrollment_date date [note: 'Date when the subject was formally enrolled into the research study after meeting eligibility criteria and providing informed consent.']
  enrollment_notes varchar [note: 'Free-text notes or comments related to the subject enrollment, including special circumstances, protocol-specific observations, or administrative remarks.']
  enrollment_source varchar [note: 'Source or channel through which the subject was recruited into the study (e.g., direct recruitment, physician referral, patient registry, community outreach).']
  enrollment_status varchar [note: 'Current lifecycle status of the subject enrollment. Tracks progression from screening through study completion or early termination. [ENUM-REF-CANDIDATE: screened|enrolled|active|completed|withdrawn|lost_to_follow_up|screen_failed — 7 candidates stripped; promote to reference product]']
  informed_consent_date date [note: 'Date when the subject provided informed consent to participate in the research study.']
  informed_consent_version varchar [note: 'Version number or identifier of the informed consent form signed by the subject. Tracks consent document revisions.']
  investigational_product_dispensed_flag boolean [note: 'Indicates whether investigational drug or device was dispensed to this subject. True if product was dispensed, False otherwise.']
  irb_approval_number varchar [note: 'IRB approval number under which this subject enrollment was authorized. Links to the IRB approval record for the study protocol.']
  protocol_deviation_flag boolean [note: 'Indicates whether any protocol deviations occurred during this subject enrollment. True if deviations were recorded, False otherwise.']
  randomization_date date [note: 'Date when the subject was randomized to a treatment arm or cohort. Applicable for randomized controlled trials.']
  screening_date date [note: 'Date when the subject was screened for eligibility to participate in the research study. First contact date in the enrollment lifecycle.']
  serious_adverse_event_flag boolean [note: 'Indicates whether any serious adverse events were reported for this subject. True if serious adverse events exist, False otherwise.']
  stratification_factors varchar [note: 'Demographic or clinical characteristics used to stratify the subject during randomization (e.g., age group, disease stage, biomarker status). Stored as structured text or delimited values.']
  updated_timestamp timestamp [note: 'Timestamp when this enrollment record was last modified. Audit trail for data governance and compliance.']
  withdrawal_date date [note: 'Date when the subject withdrew from the study or was withdrawn by the investigator prior to completion.']
  withdrawal_reason varchar [note: 'Reason for subject withdrawal from the study (e.g., adverse event, subject request, protocol violation, lost to follow-up, investigator decision).']

  Note: 'Operational record of a research subject\'s enrollment into a specific study, capturing the full enrollment lifecycle. Includes subject study ID (distinct from MRN), screening date, enrollment date, randomization date, randomization arm/cohort assignment, stratification factors, enrollment status (screened, enrolled, active, completed, withdrawn, lost to follow-up), withdrawal reason, and completion date. Links to the patient domain via MRN without duplicating patient master data. Core transactional entity for study enrollment tracking.'
}

Table research.informed_consent {
  informed_consent_id varchar [pk, note: 'Unique identifier for the informed consent record. Primary key for the informed consent data product.']
  attestation_id varchar [note: 'Foreign key linking to compliance.attestation. Business justification: Informed consent processes require staff attestation of training and competency. Regulatory requirement for consent administrators to attest to proper training and understanding.']
  capacity_assessment_id varchar [note: 'Foreign key linking to consent.consent_capacity_assessment. Business justification: Research informed consent requires documented capacity assessment when subject\'s ability to consent is questioned. Regulatory requirement (21 CFR 50.20, ICH-GCP 4.8.9) mandates capacity determination ']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Informed consent processes must comply with institutional policies (IRB SOPs, HIPAA authorization, vulnerable population protections). Policy references are standard in consent documentation and regul']
  consent_template_id varchar [note: 'Foreign key linking to research.consent_template. Business justification: Each informed consent instance is generated FROM an IRB-approved consent form template. Linking informed_consent.consent_template_id -> research.consent_template.consent_template_id captures which ICF']
  consenting_clinician_id varchar [note: 'Foreign key linking to provider.clinician. Business justification: Consenting clinician is required for regulatory compliance (21 CFR 50, ICH-GCP) and informed consent documentation. Healthcare operations track which credentialed clinician obtained consent for audit ']
  demographics_id varchar [note: 'Foreign key linking to patient.demographics. Business justification: Research informed consent requires direct link to patient demographics for identity verification during consent process, regulatory compliance (21 CFR Part 11 electronic signatures), consent capacity ']
  form_template_id varchar [note: 'Identifier of the IRB-approved consent form template version used for this consent. Links to the consent form template master record.']
  informed_employee_id varchar [note: 'User ID of the system user who created this informed consent record. Part of audit trail for regulatory compliance.']
  informed_last_modified_by_user_employee_id varchar [note: 'User ID of the system user who last modified this informed consent record. Part of audit trail for regulatory compliance.']
  note_id varchar [note: 'Foreign key linking to clinical.clinical_note. Business justification: Informed consent discussions are documented as clinical notes in EHR per ICH-GCP requirements; linking supports regulatory audit trails, integrated documentation, and consent verification workflows. R']
  notice_of_privacy_practices_id varchar [note: 'Foreign key linking to compliance.notice_of_privacy_practices. Business justification: Informed consent processes include HIPAA authorization, which references the NPP. Often combined documents for research subjects receiving clinical care.']
  primary_informed_employee_id varchar [note: 'Identifier of the research staff member who obtained the informed consent. Must be a qualified and trained individual per protocol.']
  research_study_id varchar [note: 'Identifier of the clinical trial protocol under which this consent was obtained. Links to the protocol master record.']
  subject_enrollment_id varchar [note: 'Identifier of the research subject who provided informed consent. Links to the research subject master record.']
  capacity_assessment_performed boolean [note: 'Indicates whether a formal assessment of the subject\'s capacity to consent was performed. Required for vulnerable populations or when capacity is in question.']
  capacity_assessment_result varchar [note: 'Result of the capacity assessment. Capable indicates subject can provide informed consent; incapable indicates LAR consent required; not assessed indicates no formal assessment performed.']
  consent_comprehension_assessed boolean [note: 'Indicates whether the subject\'s comprehension of the informed consent was formally assessed (e.g., via teach-back method or comprehension quiz). Recommended for complex protocols.']
  consent_copy_provided_date date [note: 'Date on which a copy of the signed informed consent form was provided to the subject. Should match or closely follow consent date.']
  consent_copy_provided_flag boolean [note: 'Indicates whether a copy of the signed informed consent form was provided to the subject or legally authorized representative. Required by FDA and ICH guidelines.']
  consent_date date [note: 'Date on which the informed consent was obtained from the subject or legally authorized representative. Must be prior to any study procedures.']
  consent_discussion_duration_minutes varchar [note: 'Duration in minutes of the informed consent discussion with the subject. Captured to demonstrate adequate time for subject comprehension and questions.']
  consent_document_location varchar [note: 'Physical or electronic location where the original signed informed consent document is stored (e.g., regulatory binder, document management system path). Required for regulatory inspection readiness.']
  consent_method varchar [note: 'Method by which the informed consent was obtained. In-person is traditional face-to-face; electronic is via eConsent platform; telephonic is via phone with verbal consent; video conference is via remote video with electronic signature.']
  consent_status varchar [note: 'Current status of the informed consent. Active indicates valid consent; withdrawn indicates subject revoked consent; expired indicates consent past validity period; superseded indicates replaced by newer version; pending indicates consent process initiated but not completed.']
  consent_time timestamp [note: 'Precise timestamp when the informed consent was obtained, including time zone. Required for electronic consent systems and audit trails.']
  consent_type varchar [note: 'Type of informed consent obtained. Initial consent is the first consent; re-consent is obtained when protocol amendments require new consent; assent is for minors; LAR (Legally Authorized Representative) consent is for subjects unable to consent; HIPAA authorization is for PHI use; short form is for non-English speakers with witness; broad consent is for future unspecified research. [ENUM-REF-CANDIDATE: initial|re-consent|assent|lar_consent|hipaa_authorization|short_form|broad_consent — 7 candidates stripped; promote to reference product]']
  consent_version_number varchar [note: 'Version number of the consent form template used at the time of consent. Ensures traceability to the specific IRB-approved version.']
  created_timestamp timestamp [note: 'Timestamp when this informed consent record was first created in the system. Part of audit trail for regulatory compliance.']
  electronic_signature_reference varchar [note: 'Unique identifier of the electronic signature captured via eConsent platform. Null for paper-based consents. Must comply with 21 CFR Part 11 requirements.']
  hipaa_authorization_date date [note: 'Date on which HIPAA authorization was obtained. Null if HIPAA authorization was not required or not included.']
  hipaa_authorization_included boolean [note: 'Indicates whether HIPAA authorization for use and disclosure of Protected Health Information (PHI) was included in this consent. Required for research involving PHI in the United States.']
  interpreter_name varchar [note: 'Full name of the interpreter who assisted with the informed consent process. Null if no interpreter was used.']
  interpreter_used_flag boolean [note: 'Indicates whether an interpreter was used during the informed consent process. True when subject\'s primary language differs from consent form language.']
  irb_approval_date date [note: 'Date on which the IRB approved the consent form template version used. Consent date must be on or after this date.']
  irb_approval_number varchar [note: 'IRB approval number for the consent form template version used. Ensures consent was obtained using an IRB-approved document.']
  irb_expiration_date date [note: 'Date on which the IRB approval for the consent form template expires. Consent date must be before this date to be valid.']
  language_code varchar [note: 'Three-letter ISO 639-2 language code indicating the language in which the informed consent was presented and obtained (e.g., ENG for English, SPA for Spanish).']
  lar_consent_indicator boolean [note: 'Indicates whether consent was obtained from a legally authorized representative rather than the subject. True when subject lacks capacity to consent.']
  lar_name varchar [note: 'Full name of the legally authorized representative who provided consent on behalf of the subject. Null if consent was obtained directly from subject.']
  lar_relationship varchar [note: 'Relationship of the legally authorized representative to the subject (e.g., parent, guardian, healthcare proxy, power of attorney). Null if consent was obtained directly from subject.']
  last_modified_timestamp timestamp [note: 'Timestamp when this informed consent record was last modified in the system. Part of audit trail for regulatory compliance.']
  re_consent_date date [note: 'Date on which re-consent was obtained due to protocol amendments or new information. Null if no re-consent has occurred.']
  subject_questions_addressed_flag boolean [note: 'Indicates whether all subject questions were addressed during the informed consent process. True confirms subject had opportunity to ask questions and received answers.']
  subject_signature_date date [note: 'Date on which the subject signed the informed consent form. Must match or precede consent date.']
  subject_signature_indicator boolean [note: 'Indicates whether the subject provided a signature on the informed consent form. True for signed consents; false for verbal consent with witness or LAR consent.']
  withdrawal_date date [note: 'Date on which the subject withdrew their informed consent. Null if consent has not been withdrawn.']
  withdrawal_reason varchar [note: 'Free-text reason provided by the subject for withdrawing informed consent. Null if consent has not been withdrawn.']
  witness_name varchar [note: 'Full name of the individual who witnessed the informed consent process. Null if no witness was required or present.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required for this consent. True for short form consents, subjects unable to read, or per IRB requirements.']

  Note: 'Records the informed consent process for each research subject and manages IRB-approved consent form templates/versions. Subject-level consent: captures consent form version, consent date, re-consent date, consent type (initial, re-consent, assent, LAR consent), consenting staff, witness, signature indicator, capacity assessment, and language. Template/version management: captures template version number, IRB approval date, expiration date, language versions, form type (full ICF, short form, assent, HIPAA authorization), required elements checklist, and template status (draft, approved, superseded). Supports FDA 21 CFR Part 50, ICH E6(R2), and ensures subjects are consented on the current IRB-approved version. SSOT for consent documentation, template version control, and consent compliance within the research domain.'
}

Table research.protocol_amendment {
  protocol_amendment_id varchar [pk, note: 'Unique identifier for the protocol amendment record. Primary key.']
  author_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Protocol amendments are authored by institutional research staff (PIs, research coordinators, regulatory specialists). Tracking authorship supports accountability, workload assessment, and quality met']
  regulatory_change_id varchar [note: 'Foreign key linking to compliance.regulatory_change. Business justification: Protocol amendments are often triggered by regulatory changes (new FDA guidance, ICH-GCP updates, safety alerts). Tracking this linkage is essential for compliance documentation and regulatory justifi']
  research_study_id varchar [note: 'Reference to the parent research protocol that this amendment modifies.']
  superseded_by_protocol_amendment_id varchar [note: 'Reference to a subsequent amendment that supersedes this one, supporting version history tracking.']
  amendment_date date [note: 'Date when the amendment was formally created or drafted. Represents the principal business event timestamp for this amendment.']
  amendment_description varchar [note: 'Detailed narrative description of the changes introduced by this amendment, including specific sections of the protocol modified.']
  amendment_document_url varchar [note: 'URL or file path to the official amendment document stored in the document management system.']
  amendment_number varchar [note: 'Sequential or hierarchical identifier for this amendment (e.g., Amendment 1, Amendment 2.1). Serves as the business-facing amendment identifier.']
  amendment_status varchar [note: 'Current lifecycle status of the amendment (draft, submitted to IRB, IRB approved, submitted to FDA, FDA approved, sponsor approved, implemented, withdrawn, superseded). [ENUM-REF-CANDIDATE: draft|submitted_to_irb|irb_approved|submitted_to_fda|fda_approved|sponsor_approved|implemented|withdrawn|superseded — 9 candidates stripped; promote to reference product]']
  amendment_title varchar [note: 'Brief descriptive title summarizing the purpose or focus of this amendment.']
  amendment_type varchar [note: 'Classification of the amendment based on the nature and impact of the change (substantial, administrative, minor, safety-related, protocol deviation correction, eligibility criteria change).']
  amendment_version varchar [note: 'Version identifier for this amendment document, supporting full version history tracking for regulatory audit readiness.']
  comments varchar [note: 'Free-text field for additional notes, reviewer comments, or internal documentation related to this amendment.']
  created_timestamp timestamp [note: 'Timestamp when this amendment record was first created in the system. Supports audit trail and regulatory compliance under FDA 21 CFR Part 11.']
  fda_acknowledgment_date date [note: 'Date when the FDA acknowledged receipt of the IND amendment submission.']
  fda_submission_date date [note: 'Date when the amendment was submitted to the FDA as part of an Investigational New Drug (IND) amendment.']
  fda_submission_reference varchar [note: 'Reference number for the FDA submission (e.g., IND amendment number) associated with this protocol amendment.']
  impact_assessment_efficacy varchar [note: 'Assessment of the amendments impact on study efficacy endpoints, statistical power, and scientific validity.']
  impact_assessment_enrollment varchar [note: 'Assessment of the amendments impact on study enrollment, including changes to eligibility criteria, recruitment strategies, or target enrollment numbers.']
  impact_assessment_operational varchar [note: 'Assessment of the amendments impact on study operations, site procedures, data collection, and resource requirements.']
  impact_assessment_safety varchar [note: 'Assessment of the amendments impact on participant safety, including any new risks introduced or mitigated.']
  implementation_date date [note: 'Date when this amendment was implemented and became effective across study sites.']
  informed_consent_update_required_flag boolean [note: 'Indicates whether this amendment requires updates to the informed consent form and re-consenting of enrolled participants.']
  irb_approval_date date [note: 'Date when the IRB granted approval for this amendment.']
  irb_approval_number varchar [note: 'Official approval number or reference issued by the IRB for this amendment.']
  irb_submission_date date [note: 'Date when the amendment was submitted to the IRB for review and approval.']
  irb_submission_reference varchar [note: 'Reference number or identifier for the IRB submission package associated with this amendment.']
  last_modified_by varchar [note: 'User identifier or name of the individual who last modified this amendment record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this amendment record was last modified. Supports audit trail and regulatory compliance under FDA 21 CFR Part 11.']
  protocol_sections_modified varchar [note: 'List or description of specific protocol sections modified by this amendment (e.g., Section 5.2 Inclusion Criteria, Section 8.1 Dosing Schedule).']
  reason_for_amendment varchar [note: 'Business and scientific rationale explaining why this amendment was necessary (e.g., safety concerns, enrollment challenges, new scientific data, regulatory feedback).']
  reconsent_required_flag boolean [note: 'Indicates whether currently enrolled participants must be re-consented under the amended protocol.']
  regulatory_reporting_required_flag boolean [note: 'Indicates whether this amendment must be reported to regulatory authorities beyond the FDA (e.g., international regulatory bodies).']
  site_implementation_required_flag boolean [note: 'Indicates whether this amendment requires implementation actions at individual study sites (True) or is administrative only (False).']
  sponsor_approval_authority varchar [note: 'Name or role of the sponsor representative who authorized approval of this amendment.']
  sponsor_approval_date date [note: 'Date when the study sponsor formally approved this amendment for implementation.']
  created_by varchar [note: 'User identifier or name of the individual who created this amendment record in the system.']

  Note: 'Tracks all amendments to an approved research protocol, including the amendment number, amendment date, description of changes, reason for amendment, impact assessment (safety, efficacy, enrollment), IRB submission reference, FDA submission reference (IND amendment), sponsor approval date, and implementation date at each site. Maintains the full version history of the study protocol to support regulatory inspections and audit readiness under FDA 21 CFR Part 11.'
}

Table research.study_visit {
  study_visit_id varchar [pk, note: 'Unique identifier for the study visit record. Primary key.']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Research visits occur at specific facilities. Visit scheduling, facility resource allocation, staff coordination, and operational logistics require facility-level visit tracking. Essential for researc']
  clinician_id varchar [note: 'Reference to the principal investigator responsible for the study at the site where this visit occurred.']
  demographics_id varchar [note: 'Reference to the enrolled research subject (patient) participating in the study.']
  lab_order_id varchar [note: 'Foreign key linking to laboratory.lab_order. Business justification: Protocol visits include scheduled lab collections per visit schedule. Linking visit to lab orders enables visit completion tracking, protocol deviation detection (missed/late labs), and source data ve']
  message_log_id varchar [note: 'Foreign key linking to interoperability.message_log. Business justification: Study visit events generate HL7/FHIR messages to notify sponsors, update EDC systems, and trigger safety monitoring workflows. Links visit to message transmission for audit trail, troubleshooting fail']
  observation_id varchar [note: 'Foreign key linking to clinical.observation. Business justification: Study visits capture protocol-required observations (labs, assessments); linking supports protocol adherence monitoring, data completeness validation, and regulatory inspection readiness. Real process']
  primary_procedure_cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Study visits generate billable procedures that must be coded as CPT for research billing and coverage analysis. Essential for revenue cycle management and billing compliance in clinical trials.']
  primary_study_employee_id varchar [note: 'Reference to the research coordinator or clinical research associate assigned to manage and document this visit.']
  research_study_id varchar [note: 'Reference to the clinical trial or research study to which this visit belongs.']
  room_id varchar [note: 'Foreign key linking to facility.room. Business justification: Some protocols require specific room types (procedure rooms, imaging suites). Room-level scheduling, equipment availability verification, and space utilization tracking require room assignment for res']
  study_arm_id varchar [note: 'Foreign key linking to research.study_arm. Business justification: Study visits are conducted for subjects enrolled in specific study arms. Adding study_arm_id FK enables arm-specific visit scheduling and protocol compliance tracking. Nullable as screening visits occ']
  study_site_id varchar [note: 'Reference to the research site or facility where the visit was conducted. Critical for multi-site clinical trials.']
  subject_enrollment_id varchar [note: 'Foreign key linking to research.subject_enrollment. Business justification: Study visits are conducted for enrolled subjects. Currently has demographics_id but no FK to subject_enrollment. Adding subject_enrollment_id establishes the relationship between visits and the enroll']
  unit_id varchar [note: 'Foreign key linking to facility.unit. Business justification: Research visits often occur in specialized units (infusion centers, clinical research units). Unit-level scheduling, nurse staffing, and resource planning require tracking which unit hosts each visit.']
  actual_date date [note: 'The date on which the visit actually occurred. May differ from scheduled_date if the visit was rescheduled or occurred outside the protocol window.']
  adverse_event_reported_flag boolean [note: 'Boolean indicator of whether any adverse events were reported or documented during this visit. True indicates at least one adverse event was captured.']
  assessments_completed_count varchar [note: 'The number of protocol-required assessments (procedures, questionnaires, lab tests, imaging studies) that were successfully completed during this visit.']
  assessments_missed_count varchar [note: 'The number of protocol-required assessments that were not completed during this visit. Indicates potential protocol deviations.']
  cancellation_reason varchar [note: 'Reason why the visit was cancelled if visit_status is cancelled (e.g., subject withdrawal, investigator decision, adverse event, scheduling conflict, study termination).']
  compliance_percentage decimal(5,2) [note: 'Calculated percentage of protocol-required assessments and procedures that were successfully completed during this visit. Used to track subject adherence and protocol compliance.']
  created_timestamp timestamp [note: 'The date and time when this study visit record was first created in the system. Audit trail field for data governance and compliance.']
  data_entry_complete_flag boolean [note: 'Boolean indicator of whether all data from this visit has been entered into the electronic data capture (EDC) system. True indicates data entry is complete and the visit record is ready for monitoring or query resolution.']
  informed_consent_reaffirmed_flag boolean [note: 'Boolean indicator of whether informed consent was reaffirmed or re-consented during this visit (e.g., due to protocol amendments or new risks). True indicates consent was reaffirmed.']
  last_modified_timestamp timestamp [note: 'The date and time when this study visit record was last updated or modified. Audit trail field for data governance and compliance.']
  missed_visit_reason varchar [note: 'Reason why the subject missed the scheduled visit if visit_status is missed (e.g., subject no-show, illness, transportation issues, lost to follow-up).']
  protocol_deviation_description varchar [note: 'Detailed narrative description of any protocol deviations that occurred during this visit, including the nature of the deviation and any corrective actions taken.']
  protocol_deviation_flag boolean [note: 'Boolean indicator of whether any protocol deviations occurred during this visit (e.g., visit outside window, missed assessments, incorrect procedures). True indicates a deviation was documented.']
  query_open_count varchar [note: 'The number of open data queries associated with this visit that require resolution by the site. Used to track data quality and cleaning progress.']
  scheduled_date date [note: 'The date on which the visit was originally scheduled to occur according to the protocol timeline and visit windows.']
  serious_adverse_event_flag boolean [note: 'Boolean indicator of whether any serious adverse events (SAEs) were reported during this visit. SAEs require expedited reporting to regulatory authorities and IRB. True indicates at least one SAE was documented.']
  source_data_verified_flag boolean [note: 'Boolean indicator of whether the visit data has been verified against source documents by a clinical research associate or monitor. True indicates source data verification (SDV) is complete.']
  study_drug_dispensed_flag boolean [note: 'Boolean indicator of whether investigational drug or device was dispensed to the subject during this visit. True indicates study product was provided.']
  study_drug_returned_flag boolean [note: 'Boolean indicator of whether the subject returned unused investigational drug or device during this visit for accountability tracking. True indicates product was returned.']
  visit_duration_minutes varchar [note: 'The total duration of the visit in minutes, from check-in to check-out. Used for operational planning and subject burden assessment.']
  visit_location varchar [note: 'The physical or virtual location where the visit was conducted (e.g., research clinic, hospital site, subject home, telehealth platform). Important for multi-site studies and decentralized trials.']
  visit_locked_flag boolean [note: 'Boolean indicator of whether the visit data has been locked in the EDC system, preventing further edits. True indicates the visit is locked and considered final for analysis.']
  visit_locked_timestamp timestamp [note: 'The date and time when the visit data was locked in the EDC system. Null if the visit is not yet locked.']
  visit_name varchar [note: 'Human-readable name or label for the visit as defined in the protocol (e.g., Screening Visit, Baseline Assessment, Week 12 Follow-up, End of Study).']
  visit_notes varchar [note: 'Free-text clinical notes or observations documented by the study coordinator or investigator during the visit. May include subject comments, logistical issues, or contextual information.']
  visit_number varchar [note: 'Protocol-defined visit number or identifier (e.g., V1, V2, V3, Screening, Baseline, Week 4, Month 6). Corresponds to the schedule of assessments in the study protocol.']
  visit_status varchar [note: 'Current lifecycle status of the visit. Scheduled indicates the visit is planned, completed indicates all assessments were performed, missed indicates the subject did not attend, cancelled indicates the visit was removed from the schedule, in_progress indicates the visit is currently underway, and rescheduled indicates the visit was moved to a different date.']
  visit_type varchar [note: 'Classification of the visit according to its purpose in the study protocol. Screening visits assess eligibility, baseline establishes pre-treatment status, treatment visits occur during intervention, follow-up monitors post-treatment outcomes, end of study concludes participation, unscheduled visits address ad-hoc needs, safety visits monitor adverse events, and early termination visits document premature withdrawal. [ENUM-REF-CANDIDATE: screening|baseline|treatment|follow_up|end_of_study|unscheduled|safety|early_termination — 8 candidates stripped; promote to reference product]']
  visit_window_end_date date [note: 'The latest date within the protocol-defined visit window during which the visit may be conducted while remaining compliant with the study protocol.']
  visit_window_start_date date [note: 'The earliest date within the protocol-defined visit window during which the visit may be conducted while remaining compliant with the study protocol.']
  visit_window_status varchar [note: 'Indicates whether the actual visit date fell within the protocol-defined visit window. Within_window indicates compliance, early indicates the visit occurred before the window opened, late indicates the visit occurred after the window closed, and out_of_window indicates significant protocol deviation.']

  Note: 'Represents a scheduled or unscheduled study visit for an enrolled research subject, as defined by the protocol schedule of assessments. Captures visit name, visit number, visit window (planned, early, late), actual visit date, visit type (screening, baseline, treatment, follow-up, end of study, unscheduled), visit status (scheduled, completed, missed, cancelled), visit location, and coordinator assigned. Drives protocol compliance tracking and subject retention management.'
}

Table research.adverse_event {
  adverse_event_id varchar [pk, note: 'Unique identifier for the adverse event or protocol deviation record. Primary key for the adverse event data product.']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Adverse events are reported by site. Site safety profiles, regulatory reporting (FDA, IRB), site performance evaluation, and risk-based monitoring all require facility attribution of adverse events. M']
  diagnosis_id varchar [note: 'Foreign key linking to clinical.clinical_diagnosis. Business justification: Adverse events often result in clinical diagnoses documented in patient medical records; linking supports SAE causality assessment, regulatory safety reporting (FDA MedWatch), and longitudinal patient']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Adverse events are coded using ICD-10-CM for integration with clinical documentation, regulatory reporting (FDA MedWatch), and safety signal detection. Essential for pharmacovigilance and serious adve']
  investigation_id varchar [note: 'Foreign key linking to compliance.investigation. Business justification: Serious adverse events trigger compliance investigations (root cause analysis, regulatory reporting determination, protocol violation assessment). Standard safety and quality management process.']
  mpi_record_id varchar [note: 'Identifier of the research subject (patient) who experienced the adverse event or was affected by the protocol deviation.']
  public_health_report_id varchar [note: 'Foreign key linking to interoperability.public_health_report. Business justification: Serious adverse events in clinical trials trigger mandatory expedited reporting to FDA via MedWatch (21 CFR 312.32). Links AE to the actual public health report transmission for regulatory compliance ']
  reporting_clinician_id varchar [note: 'Foreign key linking to provider.clinician. Business justification: Reporting clinician is tracked for adverse event causality assessment, safety monitoring, and regulatory reporting (FDA MedWatch, IRB reporting). Healthcare operations require credentialed clinician a']
  research_study_id varchar [note: 'Identifier of the clinical trial or research study in which this adverse event or protocol deviation occurred.']
  snomed_concept_id varchar [note: 'Foreign key linking to reference.snomed_concept. Business justification: Clinical research uses SNOMED CT for precise adverse event terminology mapping to MedDRA codes in safety databases and regulatory submissions. Critical for pharmacovigilance systems and FDA/EMA report']
  study_site_id varchar [note: 'Identifier of the clinical research site where the adverse event or protocol deviation was reported.']
  study_visit_id varchar [note: 'Foreign key linking to research.study_visit. Business justification: Adverse events are often detected or reported during study visits. Adding study_visit_id as nullable FK enables linking AEs to the visit context where they were identified, supporting temporal analysi']
  subject_enrollment_id varchar [note: 'Foreign key linking to research.subject_enrollment. Business justification: Adverse events are reported for enrolled research subjects. Currently has mpi_record_id but no FK to subject_enrollment. Adding subject_enrollment_id links the AE to the specific study enrollment, ena']
  action_taken varchar [note: 'Action taken with the investigational product in response to the adverse event: none, dose reduced, dose interrupted, drug withdrawn, concomitant medication given, or other.']
  ae_term varchar [note: 'Medical term describing the adverse event using standardized medical terminology (typically MedDRA preferred term).']
  capa_completion_date date [note: 'Date when the corrective and preventive action plan was completed and verified.']
  capa_description varchar [note: 'Description of corrective and preventive actions (CAPA) taken to address the protocol deviation or quality event and prevent recurrence.']
  causality_assessment varchar [note: 'Investigator assessment of the relationship between the adverse event and the investigational product or study procedure: not related, unlikely, possible, probable, or definite.']
  created_timestamp timestamp [note: 'Timestamp when this adverse event record was first created in the research data system.']
  deviation_category varchar [note: 'Category of protocol deviation: eligibility criteria violation, informed consent issue, dosing error, visit window violation, data collection error, procedure deviation, or other. [ENUM-REF-CANDIDATE: eligibility|informed_consent|dosing|visit_window|data_collection|procedure|other — 7 candidates stripped; promote to reference product]']
  deviation_description varchar [note: 'Detailed description of the protocol deviation or violation, including what occurred and how it deviated from the approved protocol.']
  deviation_severity varchar [note: 'Severity classification of the protocol deviation: minor (no impact on subject safety or data integrity), major (potential impact), or critical (significant impact requiring immediate action).']
  discovery_date date [note: 'Date when the protocol deviation or quality event was discovered or identified.']
  event_status varchar [note: 'Current workflow status of the adverse event or protocol deviation record: open (newly reported), under review (being investigated), resolved (action taken), or closed (final disposition complete).']
  event_type varchar [note: 'Classification of the safety or quality event: adverse event (AE), serious adverse event (SAE), protocol deviation, protocol violation, quality event, or near miss.']
  expectedness varchar [note: 'Indicates whether the adverse event was expected (consistent with the investigator brochure or product labeling) or unexpected.']
  expedited_report_date date [note: 'Date when the expedited safety report was submitted to regulatory authorities or IRB.']
  expedited_reporting_flag boolean [note: 'Indicates whether this adverse event requires expedited reporting to regulatory authorities (FDA, IRB) within specified timelines (typically 7 or 15 days for serious, unexpected, and related events).']
  follow_up_date date [note: 'Date when follow-up information was obtained or is scheduled to be obtained for this adverse event.']
  follow_up_required_flag boolean [note: 'Indicates whether additional follow-up information is required for this adverse event or protocol deviation.']
  impact_on_data_integrity varchar [note: 'Assessment of the protocol deviation or quality event impact on data integrity and study results: none, minimal, moderate, or significant.']
  impact_on_subject_safety varchar [note: 'Assessment of the protocol deviation or quality event impact on subject safety: none, minimal, moderate, or significant.']
  irb_report_date date [note: 'Date when the adverse event or protocol deviation report was submitted to the IRB.']
  irb_reportable_flag boolean [note: 'Indicates whether this adverse event or protocol deviation requires reporting to the Institutional Review Board (IRB) per institutional policy and federal regulations.']
  meddra_code varchar [note: 'MedDRA code for the adverse event term, enabling standardized reporting and analysis of safety data.']
  meddra_version varchar [note: 'Version of the MedDRA dictionary used for coding the adverse event term.']
  medwatch_report_number varchar [note: 'FDA MedWatch (Form 3500A) report number if an expedited safety report was submitted to the FDA.']
  modified_by varchar [note: 'Username or identifier of the user who last modified this adverse event record.']
  modified_timestamp timestamp [note: 'Timestamp when this adverse event record was last modified or updated.']
  narrative varchar [note: 'Detailed narrative description of the adverse event or protocol deviation, including clinical course, treatment, and outcome. Used for regulatory submissions and safety reviews.']
  onset_date date [note: 'Date when the adverse event or protocol deviation first occurred or was first observed.']
  outcome varchar [note: 'Final outcome of the adverse event: recovered/resolved, recovering/resolving, not recovered/not resolved, recovered with sequelae, fatal, or unknown.']
  report_date date [note: 'Date when the adverse event or protocol deviation was initially reported to the research team or entered into the safety database.']
  reporter_role varchar [note: 'Role or title of the individual who reported the adverse event or protocol deviation (e.g., principal investigator, study coordinator, research nurse).']
  resolution_date date [note: 'Date when the adverse event resolved or ended. Null if ongoing or fatal outcome.']
  root_cause varchar [note: 'Root cause analysis of the protocol deviation or quality event, identifying underlying factors that contributed to the occurrence.']
  seriousness_criteria varchar [note: 'Specific seriousness criteria met by the adverse event: death, life-threatening, hospitalization (initial or prolonged), disability/incapacity, congenital anomaly, or other medically important condition. Multiple criteria may apply.']
  seriousness_flag boolean [note: 'Indicates whether the adverse event meets regulatory criteria for seriousness (death, life-threatening, hospitalization, disability, congenital anomaly, or other medically important condition).']
  severity_grade varchar [note: 'Severity grade of the adverse event using CTCAE scale: Grade 1 (mild), Grade 2 (moderate), Grade 3 (severe), Grade 4 (life-threatening), Grade 5 (death).']
  sponsor_report_date date [note: 'Date when the adverse event or protocol deviation report was submitted to the study sponsor.']
  sponsor_reportable_flag boolean [note: 'Indicates whether this adverse event or protocol deviation requires reporting to the study sponsor per the clinical trial agreement.']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']
  created_by varchar [note: 'Username or identifier of the user who created this adverse event record in the system.']

  Note: 'Captures all safety events and quality events reported during a clinical trial or research study. Safety events: adverse events (AEs) and serious adverse events (SAEs) with AE term (MedDRA coded), onset/resolution dates, severity grade (CTCAE 1–5), seriousness criteria, causality assessment, action taken, outcome, and expedited reporting flag. Quality events: protocol deviations and violations with deviation description, category (eligibility, dosing, visit window, consent, data collection), severity (minor, major, important protocol deviation), discovery date, root cause, impact on subject safety and data integrity, corrective and preventive action (CAPA), and IRB/sponsor reportability determination. Supports FDA MedWatch, IND safety reporting (21 CFR 312.32), GCP compliance, quality management under ICH E6(R2), and regulatory inspection readiness. SSOT for all study safety events and quality events (including protocol deviations) within the research domain.'
}

Table research.investigational_product {
  investigational_product_id varchar [pk, note: 'Unique identifier for the investigational product record. Primary key.']
  exclusion_screening_id varchar [note: 'Foreign key linking to compliance.exclusion_screening. Business justification: Investigational product manufacturers/suppliers must be screened against exclusion lists (OIG, SAM, FDA debarment). Standard procurement compliance for federally funded research.']
  material_master_id varchar [note: 'Foreign key linking to supply.material_master. Business justification: Investigational products (especially devices and biologics) are cataloged in material master for inventory management, expiration tracking, and lot control. Real business process: IP inventory account']
  osha_safety_program_id varchar [note: 'Foreign key linking to compliance.osha_safety_program. Business justification: Investigational products (hazardous drugs, devices, biologics) require OSHA safety programs (exposure control, hazard communication, PPE). Standard pharmaceutical safety compliance.']
  research_study_id varchar
  accountability_required_flag boolean [note: 'Indicates whether detailed product accountability records (receipt, dispensing, return, destruction) are required for regulatory compliance.']
  adverse_event_reporting_required_flag boolean [note: 'Indicates whether adverse events related to this investigational product must be reported to regulatory authorities and IRB per safety monitoring requirements.']
  approval_date date [note: 'Date when the investigational product received regulatory approval (IND/IDE approval) to be used in clinical trials.']
  blinding_status varchar [note: 'Blinding or masking status of the investigational product in the clinical trial (open-label, single-blind, double-blind, triple-blind, or unblinded).']
  brand_name varchar [note: 'Proprietary or brand name of the investigational product, if assigned by the sponsor or manufacturer.']
  comparator_indicator boolean [note: 'Indicates whether this investigational product serves as an active comparator or control arm product in the clinical trial.']
  controlled_substance_schedule varchar [note: 'DEA controlled substance schedule classification if the investigational product contains controlled substances (Schedule I through V, or not controlled).']
  created_timestamp timestamp [note: 'Timestamp when the investigational product record was first created in the system.']
  data_governance_classification varchar [note: 'Data governance classification level for investigational product data (e.g., identifiable, de-identified, limited dataset) per research data governance policies.']
  discontinuation_date date [note: 'Date when the investigational product was discontinued or withdrawn from clinical trial use, if applicable.']
  dosage_form varchar [note: 'Physical form of the investigational product (e.g., tablet, capsule, injection, solution, implant, topical cream).']
  expiration_management_required_flag boolean [note: 'Indicates whether expiration date tracking and management is required for this investigational product to ensure product integrity and subject safety.']
  formulation varchar [note: 'Detailed formulation description including active ingredients, excipients, and composition for drugs/biologics, or material composition for devices.']
  generic_name varchar [note: 'Generic or chemical name of the investigational product (e.g., active pharmaceutical ingredient name or device generic descriptor).']
  hazardous_material_flag boolean [note: 'Indicates whether the investigational product is classified as hazardous material requiring special handling, storage, and disposal procedures.']
  ind_ide_number varchar [note: 'FDA-assigned IND number for investigational drugs/biologics or IDE number for investigational devices. Required for clinical trial regulatory compliance.']
  indication varchar [note: 'Specific disease, condition, or indication for which the investigational product is being studied in the clinical trial.']
  informed_consent_required_flag boolean [note: 'Indicates whether informed consent is required from subjects before administration of this investigational product.']
  irb_approval_required_flag boolean [note: 'Indicates whether IRB approval is required for the use of this investigational product in the clinical trial.']
  labeling_requirements varchar [note: 'Specific labeling requirements for the investigational product including required statements, warnings, and identification information per regulatory standards.']
  lot_tracking_required_flag boolean [note: 'Indicates whether lot-level tracking and accountability is required for this investigational product per protocol and regulatory requirements.']
  manufacturer_address varchar [note: 'Physical address of the manufacturing facility where the investigational product is produced.']
  manufacturer_name varchar [note: 'Name of the manufacturer or supplier responsible for producing the investigational product.']
  notes varchar [note: 'Additional notes, comments, or special instructions related to the investigational product that do not fit in other structured fields.']
  packaging_description varchar [note: 'Description of the investigational product packaging including container type, closure system, and labeling specifications.']
  phase varchar [note: 'Phase of clinical development for the investigational product (Phase I, II, III, IV, or combined phases).']
  placebo_indicator boolean [note: 'Indicates whether this investigational product is a placebo (inactive control) used in the clinical trial.']
  product_type varchar [note: 'Classification of the investigational product: drug, biologic, medical device, combination product, placebo, or active comparator.']
  protocol_number varchar [note: 'Unique protocol number or identifier for the clinical trial in which this investigational product is being studied.']
  regulatory_status varchar [note: 'Current regulatory status of the investigational product in the clinical trial program (active, inactive, withdrawn, suspended, or approved for marketing).']
  research_billing_code varchar [note: 'Billing code or charge code used for research billing compliance to distinguish investigational product costs from standard care costs.']
  return_destruction_procedure varchar [note: 'Documented procedure for returning unused investigational product to sponsor and/or destroying expired or unused product in compliance with regulations.']
  route_of_administration varchar [note: 'Method by which the investigational product is administered to subjects (e.g., oral, intravenous, subcutaneous, topical, implantable).']
  shelf_life_months varchar [note: 'Approved shelf life of the investigational product in months from date of manufacture, based on stability testing data.']
  special_handling_instructions varchar [note: 'Detailed instructions for special handling, preparation, administration, or disposal of the investigational product to ensure safety and efficacy.']
  sponsor_name varchar [note: 'Name of the organization or individual sponsoring the clinical trial and responsible for the investigational product.']
  storage_requirements varchar [note: 'Detailed storage conditions required for the investigational product (e.g., refrigerated 2-8°C, room temperature, protect from light, frozen).']
  strength varchar [note: 'Strength or concentration of the active ingredient(s) in the investigational product, including unit of measure (e.g., 50 mg, 10 mg/mL).']
  temperature_monitoring_required_flag boolean [note: 'Indicates whether continuous or periodic temperature monitoring is required during storage and transport of the investigational product.']
  therapeutic_area varchar [note: 'Primary therapeutic area or disease category that the investigational product is intended to treat (e.g., oncology, cardiology, neurology, infectious disease).']
  updated_timestamp timestamp [note: 'Timestamp when the investigational product record was last updated or modified.']
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Master record for investigational drugs, biologics, or devices used in clinical trials. Captures IND/IDE number, NDC or device identifier, product name (generic and brand), formulation, dosage form, strength, manufacturer, lot number tracking flag, storage requirements, temperature monitoring requirements, expiration date management flag, blinding status (open-label, single-blind, double-blind), and comparator/placebo indicator. Supports FDA 21 CFR Part 312 (drugs) and 21 CFR Part 812 (devices) accountability requirements.'
}

Table research.ip_dispensation {
  ip_dispensation_id varchar [pk, note: 'Unique identifier for the investigational product dispensation record. Primary key.']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Investigational products are dispensed at specific facility pharmacies. IP inventory management, accountability audits, temperature excursion tracking, and regulatory compliance all require facility-l']
  dispensing_clinician_id varchar [note: 'Foreign key linking to provider.clinician. Business justification: Dispensing clinician is required for investigational product accountability (21 CFR 312.62), DEA compliance for controlled substances, and protocol adherence verification. Healthcare operations track ']
  employee_id varchar [note: 'Identifier of the pharmacist, research coordinator, or authorized personnel who dispensed the investigational product.']
  inventory_location_id varchar [note: 'Foreign key linking to supply.inventory_location. Business justification: IP dispensation occurs from specific controlled inventory locations (research pharmacy, secure storage) requiring chain of custody, temperature monitoring, and regulatory accountability. Real business']
  investigational_product_id varchar [note: 'Foreign key linking to research.investigational_product. Business justification: IP dispensation records must reference the investigational_product master table. Currently has ip_name, ip_code (STRING) but no FK. Adding investigational_product_id FK allows removal of redundant nam']
  research_study_id varchar [note: 'Identifier of the clinical study under which this investigational product was dispensed.']
  study_arm_id varchar [note: 'Foreign key linking to research.study_arm. Business justification: IP dispensation is arm-specific (different arms receive different treatments). Currently has treatment_arm (STRING) but no FK to study_arm master. Adding study_arm_id FK allows removal of redundant tr']
  study_site_id varchar [note: 'Identifier of the research site where the dispensation occurred.']
  study_visit_id varchar [note: 'Foreign key linking to research.study_visit. Business justification: Investigational product is dispensed to a subject at a specific study visit (study_visit has study_drug_dispensed_flag). Linking ip_dispensation.study_visit_id -> research.study_visit.study_visit_id t']
  subject_enrollment_id varchar [note: 'Identifier of the enrolled research subject who received the investigational product. Protected health information under HIPAA.']
  visit_id varchar [note: 'Identifier of the study visit during which the investigational product was dispensed.']
  accountability_status varchar [note: 'The current status of investigational product accountability for this dispensation record (pending, reconciled, discrepancy, closed).']
  administration_instructions varchar [note: 'Instructions provided to the subject regarding how to administer or take the investigational product.']
  blinding_status varchar [note: 'Indicates whether the dispensation is blinded and to what degree (open, single-blind, double-blind, triple-blind).']
  chain_of_custody_signature varchar [note: 'Electronic or physical signature capturing the chain of custody transfer from dispenser to subject.']
  compliance_status varchar [note: 'Indicates whether the subject was compliant with the investigational product administration instructions based on returned units and reported usage.']
  created_timestamp timestamp [note: 'The timestamp when this investigational product dispensation record was first created in the system.']
  discrepancy_notes varchar [note: 'Notes documenting any discrepancies found during investigational product accountability reconciliation.']
  dispensation_date date [note: 'The date on which the investigational product was dispensed to the research subject.']
  dispensation_notes varchar [note: 'Additional notes or comments recorded by the dispenser regarding this investigational product dispensation event.']
  dispensation_timestamp timestamp [note: 'The precise date and time when the investigational product was dispensed to the research subject.']
  dispensed_by_role varchar [note: 'The role of the personnel who dispensed the investigational product (e.g., pharmacist, research coordinator).']
  dose_level varchar [note: 'The dose level or strength of the investigational product dispensed (e.g., 10mg, 50mg, placebo).']
  expected_return_date date [note: 'The date by which the subject is expected to return unused investigational product for accountability reconciliation.']
  expiration_date date [note: 'The expiration date of the investigational product lot dispensed. Critical for safety and accountability.']
  informed_consent_date date [note: 'The date on which the subject provided informed consent for the clinical trial, confirming eligibility for investigational product dispensation.']
  irb_approval_number varchar [note: 'The IRB approval number under which this investigational product dispensation is authorized.']
  is_active boolean [note: 'Indicates whether this investigational product dispensation record is currently active or has been superseded or voided.']
  kit_number varchar [note: 'The unique kit number assigned to the investigational product package dispensed to the subject.']
  lot_number varchar [note: 'The manufacturing lot number of the investigational product dispensed. Critical for traceability and accountability.']
  missed_doses varchar [note: 'The number of doses the subject reported missing or not taking as instructed.']
  modified_timestamp timestamp [note: 'The timestamp when this investigational product dispensation record was last modified.']
  protocol_number varchar [note: 'The protocol number of the clinical trial under which this dispensation occurred. Business identifier for the study.']
  quantity_dispensed decimal(10,2) [note: 'The quantity of investigational product dispensed to the subject (e.g., number of tablets, vials, or units).']
  quantity_returned decimal(10,2) [note: 'The quantity of investigational product returned by the subject at the next visit or study close-out.']
  quantity_unit varchar [note: 'The unit of measure for the quantity dispensed (e.g., tablets, vials, ml). [ENUM-REF-CANDIDATE: tablets|capsules|vials|syringes|patches|units|ml|mg|grams — 9 candidates stripped; promote to reference product]']
  randomization_number varchar [note: 'The randomization number assigned to the subject that determines treatment assignment. Protected to maintain blinding.']
  return_date date [note: 'The actual date on which the subject returned unused investigational product.']
  sponsor_name varchar [note: 'The name of the organization sponsoring the clinical trial under which this investigational product was dispensed.']
  storage_instructions varchar [note: 'Instructions provided to the subject regarding proper storage conditions for the investigational product (e.g., refrigeration, room temperature).']
  subject_number varchar [note: 'The unique subject enrollment number assigned within the clinical trial. Protected health information under HIPAA.']
  subject_signature_timestamp timestamp [note: 'The timestamp when the subject signed to acknowledge receipt of the investigational product.']
  temperature_at_dispensation decimal(5,2) [note: 'The temperature recorded at the time of dispensation if temperature-sensitive investigational product. Measured in Celsius.']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Transactional record of investigational product (IP) dispensation to an enrolled research subject at a study visit. Captures dispensation date, lot number, quantity dispensed, dose level, kit number, subject compliance (returned units, missed doses), pharmacist or coordinator dispensing, and chain-of-custody signature. Supports IP accountability logs required under FDA 21 CFR Part 312.62 and ICH E6(R2) Section 8.3. Enables drug accountability reconciliation at study close-out.'
}

Table research.biospecimen {
  biospecimen_id varchar [pk, note: 'Unique identifier for the biospecimen record. Primary key for the biospecimen data product.']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Biospecimens are collected at specific facilities. Chain of custody documentation, specimen quality tracking, logistics coordination, and regulatory compliance require facility attribution. Critical f']
  cda_document_id varchar [note: 'Foreign key linking to interoperability.cda_document. Business justification: Biospecimen collection and processing documented in CDA documents for regulatory compliance and data sharing with biobanks/central labs. Required for chain of custody documentation and interoperabilit']
  collector_clinician_id varchar [note: 'Foreign key linking to provider.clinician. Business justification: Collecting clinician is required for biospecimen chain of custody, protocol compliance verification, and specimen quality assurance. Healthcare operations track credentialed clinician for invasive col']
  genetic_testing_consent_id varchar [note: 'Foreign key linking to consent.genetic_testing_consent. Business justification: Biospecimen collection for genetic analysis requires specific genetic testing consent documenting GINA disclosures, family implications, and incidental findings preferences. Real business process: bio']
  hipaa_privacy_incident_id varchar [note: 'Foreign key linking to compliance.hipaa_privacy_incident. Business justification: Biospecimen breaches (lost samples, unauthorized access, mislabeling) are PHI incidents requiring HIPAA breach analysis, risk assessment, and notification. Specimens contain identifiable health inform']
  inventory_location_id varchar [note: 'Foreign key linking to supply.inventory_location. Business justification: Biospecimens are stored in specific inventory locations (freezers, biorepositories) tracked in supply chain systems for temperature monitoring, retrieval, and regulatory compliance. Real business proc']
  lab_order_id varchar [note: 'Foreign key linking to laboratory.lab_order. Business justification: Research biospecimen collection is often ordered through lab order system for operational workflow, scheduling, phlebotomy coordination, and billing. Links research protocol schedule to lab operationa']
  mpi_record_id varchar [note: 'Reference to the research subject from whom this biospecimen was collected. May be de-identified per protocol.']
  osha_exposure_incident_id varchar [note: 'Foreign key linking to compliance.osha_exposure_incident. Business justification: Biospecimen handling incidents (needlesticks, spills, exposures) are OSHA-recordable exposure incidents. Safety compliance linkage for bloodborne pathogen exposure control plans.']
  parent_biospecimen_id varchar [note: 'Reference to the parent biospecimen if this specimen is an aliquot or derivative of another specimen.']
  procedure_event_id varchar [note: 'Foreign key linking to clinical.procedure_event. Business justification: Biospecimen collection (biopsy, blood draw) is performed as clinical procedures; linking supports research vs clinical billing determination, procedure order reconciliation, and regulatory documentati']
  research_study_id varchar [note: 'Reference to the clinical research study protocol under which this biospecimen was collected.']
  specimen_id varchar [note: 'Foreign key linking to laboratory.specimen. Business justification: Research biospecimens are laboratory specimens with additional research metadata (consent, protocol, storage). Linking to lab specimen enables chain of custody, accession tracking, and integration wit']
  specimen_type_snomed_concept_id varchar [note: 'Foreign key linking to reference.snomed_concept. Business justification: Biospecimen types and anatomical sites are standardized using SNOMED CT for interoperability with biobanks, research data sharing, and regulatory submissions. Critical for NIH data sharing compliance ']
  study_visit_id varchar [note: 'Foreign key linking to research.study_visit. Business justification: Biospecimens are collected during scheduled study visits per the protocol. Linking biospecimen.study_visit_id -> research.study_visit.study_visit_id captures the collection visit context. No reverse F']
  subject_enrollment_id varchar [note: 'Foreign key linking to research.subject_enrollment. Business justification: Biospecimens are collected from enrolled research subjects. Currently has mpi_record_id but no FK to subject_enrollment. Adding subject_enrollment_id links the specimen to the specific study enrollmen']
  visit_id varchar [note: 'Reference to the specific study visit or encounter during which the biospecimen was collected.']
  aliquot_number varchar [note: 'Sequential number identifying this aliquot if the original specimen was divided into multiple aliquots.']
  anatomical_site varchar [note: 'Anatomical location or body site from which the specimen was collected (e.g., left arm, liver, lung, colon).']
  barcode varchar [note: 'Unique barcode or label identifier affixed to the physical specimen container for tracking and chain-of-custody purposes.']
  box_position varchar [note: 'Position of the specimen within the storage box (e.g., box identifier, grid position A1, B2).']
  chain_of_custody_log varchar [note: 'Detailed log or audit trail documenting all handling, transfers, and custody changes of the specimen to ensure integrity and traceability.']
  collection_date date [note: 'Date on which the biospecimen was collected from the research subject.']
  collection_method varchar [note: 'Method or procedure used to collect the specimen (e.g., venipuncture, biopsy, swab, catheterization, surgical excision).']
  collection_time timestamp [note: 'Precise date and time when the biospecimen was collected, critical for time-sensitive assays and stability tracking.']
  collection_volume decimal(10,3) [note: 'Volume of the specimen collected, typically measured in milliliters (mL) for liquid specimens.']
  collection_volume_unit varchar [note: 'Unit of measure for the collection volume or quantity (e.g., mL, L, uL for liquids; g, mg for solids).']
  comments varchar [note: 'Additional free-text comments or notes regarding the biospecimen, its collection, processing, or any special handling requirements.']
  consent_date date [note: 'Date on which the research subject provided informed consent for specimen collection and use.']
  consent_for_future_use boolean [note: 'Indicates whether the research subject provided informed consent for future use of this specimen in additional research studies.']
  created_timestamp timestamp [note: 'Timestamp when this biospecimen record was first created in the system.']
  deidentification_status varchar [note: 'Indicates whether the specimen is identified, de-identified, anonymized, or coded per HIPAA and research protocol requirements.']
  disposition varchar [note: 'Final disposition or outcome of the specimen (e.g., stored for future use, analyzed and depleted, destroyed per protocol, shipped to external lab, transferred to another study).']
  disposition_date date [note: 'Date on which the specimen reached its final disposition (e.g., date destroyed, date fully depleted, date transferred).']
  processing_date date [note: 'Date on which the specimen was processed or prepared for storage.']
  processing_method varchar [note: 'Method used to process the specimen after collection (e.g., centrifugation, aliquoting, fixation, freezing, RNA extraction).']
  processing_time timestamp [note: 'Precise date and time when specimen processing was completed.']
  protocol_deviation_description varchar [note: 'Detailed description of any protocol deviations that occurred, including corrective actions taken.']
  protocol_deviation_flag boolean [note: 'Indicates whether any protocol deviations occurred during specimen collection, processing, or storage.']
  quality_notes varchar [note: 'Free-text notes regarding specimen quality, integrity issues, or deviations from protocol during collection or processing.']
  rack_position varchar [note: 'Position of the specimen within the storage rack or shelf (e.g., rack number, shelf level).']
  received_date date [note: 'Date on which the specimen was received at the destination facility or laboratory after shipment.']
  shipment_date date [note: 'Date on which the specimen was shipped or transferred to another location or facility.']
  shipment_tracking_number varchar [note: 'Tracking number or waybill identifier for the shipment, used to trace the specimen during transport.']
  shipped_to_facility varchar [note: 'Name or identifier of the external facility, laboratory, or institution to which the specimen was shipped.']
  specimen_quality varchar [note: 'Assessment of the specimen quality based on visual inspection, integrity, and suitability for analysis (e.g., acceptable, marginal, unacceptable, compromised).']
  specimen_status varchar [note: 'Current lifecycle status of the specimen (e.g., collected, processed, stored, in analysis, analyzed, shipped, destroyed, depleted). [ENUM-REF-CANDIDATE: collected|processed|stored|in_analysis|analyzed|shipped|destroyed|depleted — 8 candidates stripped; promote to reference product]']
  specimen_subtype varchar [note: 'Further classification or subtype of the specimen (e.g., whole blood vs. EDTA plasma, fresh tissue vs. frozen tissue).']
  specimen_type varchar [note: 'Type of biological specimen collected. Common types include blood, serum, plasma, urine, saliva, tissue, biopsy, bone marrow, cerebrospinal fluid (CSF), and other biosamples. [ENUM-REF-CANDIDATE: blood|serum|plasma|urine|saliva|tissue|biopsy|bone_marrow|csf — 9 candidates stripped; promote to reference product]']
  storage_container_type varchar [note: 'Type of storage container or environment (e.g., freezer, refrigerator, liquid nitrogen tank, ambient storage, cryogenic storage).']
  storage_temperature decimal(6,2) [note: 'Temperature at which the specimen is stored, measured in degrees Celsius (e.g., -80, -20, 4, 25).']
  updated_timestamp timestamp [note: 'Timestamp when this biospecimen record was last updated or modified.']
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Tracks biological specimens collected from research subjects as part of study protocols, including blood, tissue, urine, saliva, and other biosamples. Captures specimen type, collection date and time, collection site (anatomical), collection method, volume/quantity, processing method, storage location (biobank, freezer, rack, box, position), chain-of-custody, de-identification status, consent for future use, specimen disposition (analyzed, stored, destroyed, shipped), and shipping/transfer records. Supports biobanking operations, translational research specimen management, and specimen lifecycle tracking from collection through final disposition.'
}

Table research.data_safety_monitoring {
  data_safety_monitoring_id varchar [pk, note: 'Unique identifier for the data safety monitoring record. Primary key for this entity.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: DSMB activities are audited for independence, charter compliance, documentation quality, and unblinding procedures. Standard in FDA-regulated trials and institutional compliance reviews.']
  compliance_regulatory_submission_id varchar [note: 'Foreign key linking to compliance.regulatory_submission. Business justification: DSMB recommendations (study modifications, safety reports, stopping rules) trigger regulatory submissions to FDA/IRB. Standard safety reporting for monitored trials.']
  dsmb_committee_id varchar [note: 'Identifier of the Data Safety Monitoring Board or Data Monitoring Committee assigned to oversee this trial.']
  primary_data_employee_id varchar [note: 'Identifier of the user or system account that created this data safety monitoring record.']
  research_document_id varchar [note: 'Identifier or reference to the formal DSMB meeting minutes document stored in the document management system.']
  research_study_id varchar [note: 'Identifier of the clinical trial or study protocol being monitored by the DSMB/DMC.']
  adverse_events_reviewed varchar [note: 'Total count of adverse events reviewed by the DSMB during this meeting.']
  charter_version varchar [note: 'Version identifier of the DSMB charter document in effect at the time of this meeting.']
  confidentiality_level varchar [note: 'Confidentiality classification of the DSMB meeting: open (sponsor present), closed (DSMB only), or partially closed (sponsor present for portions).']
  created_timestamp timestamp [note: 'Timestamp when this data safety monitoring record was first created in the system.']
  data_lock_date date [note: 'Date on which the clinical trial data was locked for this interim analysis and DSMB review.']
  dsmb_recommendation varchar [note: 'Formal recommendation issued by the DSMB: continue trial as planned, modify protocol, suspend enrollment, terminate trial, or increase monitoring frequency.']
  fda_notification_date date [note: 'Date on which the FDA was formally notified of the DSMB recommendation and any safety actions taken.']
  fda_notification_required boolean [note: 'Indicates whether the DSMB recommendation requires formal notification to the FDA under IND safety reporting requirements.']
  implementation_action_taken varchar [note: 'Description of the concrete actions taken by the sponsor to implement the DSMB recommendation (e.g., protocol amendment submitted, enrollment suspended, monitoring increased).']
  implementation_date date [note: 'Date on which the sponsor\'s implementation actions were completed or became effective.']
  interim_analysis_trigger varchar [note: 'Description of the event or milestone that triggered the interim analysis (e.g., enrollment milestone, calendar-based, safety signal threshold).']
  irb_notification_date date [note: 'Date on which the IRB was formally notified of the DSMB recommendation and sponsor response.']
  irb_notification_required boolean [note: 'Indicates whether the DSMB recommendation and sponsor response require notification to the Institutional Review Board.']
  last_modified_timestamp timestamp [note: 'Timestamp when this data safety monitoring record was last modified.']
  meeting_date date [note: 'Date on which the Data Safety Monitoring Board meeting occurred to review trial safety data.']
  meeting_number varchar [note: 'Sequential or coded identifier for the DSMB meeting (e.g., DSMB-001, Meeting 3).']
  meeting_type varchar [note: 'Classification of the DSMB meeting: scheduled routine review, ad hoc safety review, interim analysis, final review, or emergency convening.']
  monitoring_status varchar [note: 'Current status of DSMB monitoring for this trial: active (ongoing), suspended (temporarily paused), completed (trial ended), or terminated (trial stopped early).']
  next_review_scheduled_date date [note: 'Scheduled date for the next DSMB review meeting as determined during this meeting.']
  notes varchar [note: 'Additional notes, observations, or context related to this DSMB meeting and safety monitoring activity.']
  protocol_modification_required boolean [note: 'Indicates whether the DSMB recommendation requires a formal protocol amendment.']
  recommendation_rationale varchar [note: 'Detailed rationale and clinical/statistical justification for the DSMB recommendation.']
  record_status varchar [note: 'Lifecycle status of this data safety monitoring record: draft (in preparation), final (approved), amended (revised after finalization), or archived (historical).']
  safety_stopping_rule_evaluated boolean [note: 'Indicates whether pre-defined safety stopping rules were formally evaluated during this DSMB meeting.']
  serious_adverse_events_reviewed varchar [note: 'Count of serious adverse events (SAEs) reviewed by the DSMB during this meeting.']
  sponsor_response varchar [note: 'Sponsor\'s formal response to the DSMB recommendation: accepted, accepted with modifications, rejected, or under review.']
  sponsor_response_date date [note: 'Date on which the sponsor formally responded to the DSMB recommendation.']
  sponsor_response_rationale varchar [note: 'Detailed explanation of the sponsor\'s response, including justification for acceptance, modification, or rejection of the DSMB recommendation.']
  statistical_report_document_code varchar [note: 'Identifier or reference to the interim statistical analysis report reviewed by the DSMB.']
  stopping_rule_threshold_met boolean [note: 'Indicates whether any safety stopping rule threshold was met or exceeded during this review.']
  subjects_completed_at_review varchar [note: 'Number of subjects who had completed the study protocol at the time of this DSMB review.']
  subjects_enrolled_at_review varchar [note: 'Total number of subjects enrolled in the trial at the time of this DSMB review.']
  unblinding_event_occurred boolean [note: 'Indicates whether treatment assignment unblinding occurred during this DSMB meeting for interim analysis purposes.']
  unblinding_justification varchar [note: 'Business and regulatory justification for unblinding, including the safety or efficacy rationale.']
  unblinding_scope varchar [note: 'Scope of unblinding performed: none, partial (selected subjects), full (all subjects), or treatment arm only (aggregate level).']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Records Data Safety Monitoring Board (DSMB) or Data Monitoring Committee (DMC) activities for a clinical trial, including meeting dates, interim analysis triggers, safety stopping rules, unblinding events, committee recommendations (continue, modify, suspend, terminate), sponsor responses, and implementation actions. Captures the formal oversight record required for Phase II–IV trials and FDA-regulated studies. Supports trial integrity and subject safety oversight.'
}

Table research.billing_event {
  billing_event_id varchar [pk, note: 'Unique identifier for the research billing event record. Primary key.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: Research billing compliance (Medicare coverage analysis, protocol vs. standard-of-care determination) is heavily audited. CMS requires documentation of billing determinations for clinical trial servic']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Research billing is facility-specific. Coverage analysis implementation, revenue cycle management, payer contract compliance, and financial reconciliation all require facility-level billing event trac']
  charge_id varchar [note: 'Reference to the underlying charge record in the billing system for this service.']
  claim_id varchar [note: 'Foreign key linking to claim.claim. Business justification: Research billing events must link to submitted claims for revenue cycle reconciliation, sponsor invoicing verification, and payer adjudication tracking. Clinical trial billing requires tracking from c']
  coverage_analysis_id varchar [note: 'Reference to the formal coverage analysis document that determined billing responsibility for this service.']
  diagnosis_icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Research billing requires diagnosis codes to support medical necessity and coverage determination for study-related services. Essential for claims processing and billing compliance under clinical tria']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Research billing events must link to actual invoices to track billing outcomes, reconcile research vs standard-of-care charges, and validate coverage determinations. Critical for CMS clinical trial bi']
  invoice_line_id varchar [note: 'Foreign key linking to billing.invoice_line. Business justification: Research billing events require line-level detail to determine which specific service line items are research vs standard-of-care. Essential for CMS NCD 310.1 compliance and accurate coverage analysis']
  journal_entry_id varchar [note: 'Foreign key linking to finance.journal_entry. Business justification: Research billing events generate accounting journal entries for revenue recognition, compliance tracking, and financial reporting. Essential for clinical trial billing compliance, Medicare coverage an']
  lab_charge_id varchar [note: 'Foreign key linking to laboratory.lab_charge. Business justification: Coverage analysis requires linking research billing events to actual lab charges for standard-of-care vs research-only determination per Medicare NCD 310.1 and payer policies. Essential for compliant ']
  line_id varchar [note: 'Foreign key linking to claim.claim_line. Business justification: Line-level linkage required for coverage analysis validation—verifying standard-of-care vs research-only service determinations match actual claim line adjudication. CMS clinical trial policy complian']
  material_master_id varchar [note: 'Foreign key linking to supply.material_master. Business justification: Research billing distinguishes standard-of-care items (billed to insurance) from investigational items (billed to sponsor). Material master provides item-level cost, NDC/HCPCS codes, and coverage dete']
  member_enrollment_id varchar [note: 'Foreign key linking to insurance.member_enrollment. Business justification: Research billing events must verify active member enrollment to determine coverage responsibility. The coverage_determination field requires real-time enrollment status, benefit verification, and coor']
  mpi_record_id varchar [note: 'Reference to the patient who received the research service.']
  performing_clinician_id varchar [note: 'Foreign key linking to provider.clinician. Business justification: Performing clinician resolves research billing coverage analysis (Medicare NCD 310.1) and charge reconciliation. Healthcare operations require credentialed clinician link to determine standard-of-care']
  procedure_event_id varchar [note: 'Foreign key linking to clinical.procedure_event. Business justification: Research billing events reference underlying clinical procedures to determine coverage per Medicare NCD 310.1 (routine costs vs research costs); linking enables clinical trial billing reconciliation a']
  research_study_id varchar [note: 'Reference to the clinical trial protocol under which this billing event occurred.']
  stark_arrangement_id varchar [note: 'Foreign key linking to compliance.stark_arrangement. Business justification: Research billing involving physician referrals must be evaluated for Stark Law compliance (DHS referrals, compensation arrangements, FMV). Required for Medicare billing compliance.']
  subject_enrollment_id varchar [note: 'Foreign key linking to research.subject_enrollment. Business justification: Research billing events are for services provided to enrolled subjects. Currently has mpi_record_id but no FK to subject_enrollment. Adding subject_enrollment_id links billing to the enrollment contex']
  visit_id varchar [note: 'Reference to the clinical encounter during which the research service was provided.']
  analysis_date date [note: 'The date on which the coverage analysis was performed to determine billing responsibility for this service.']
  analyst_name varchar [note: 'The name of the research billing compliance analyst who performed the coverage determination for this service.']
  approval_date date [note: 'The date on which the coverage determination was formally approved, allowing the charge to proceed to billing.']
  approval_status varchar [note: 'The current approval status of the coverage determination: pending initial review, approved for billing, rejected, under secondary review, or escalated to compliance.']
  approver_name varchar [note: 'The name of the compliance officer or authorized personnel who approved the coverage determination.']
  audit_trail varchar [note: 'Comprehensive audit trail capturing all changes to the coverage determination and billing status, including timestamps and user identifiers.']
  billing_date date [note: 'The date on which the charge was submitted for billing to the determined responsible party.']
  billing_status varchar [note: 'The current billing status of this research service: not yet billed, billed to sponsor, billed to insurance payer, billed to patient, absorbed by institution, on hold, or billing error. [ENUM-REF-CANDIDATE: not_billed|billed_to_sponsor|billed_to_payer|billed_to_patient|institutional_absorbed|billing_hold|billing_error — 7 candidates stripped; promote to reference product]']
  charge_amount decimal(18,2) [note: 'The gross charge amount for the service as recorded in the charge description master, before coverage determination.']
  clinical_trial_policy_number varchar [note: 'The institutional policy or procedure number governing research billing compliance for this trial, ensuring adherence to CMS and OIG guidance.']
  cms_ncd_reference varchar [note: 'Reference to the specific CMS NCD (e.g., NCD 310.1) that governs Medicare coverage for this clinical trial service.']
  compliance_flag boolean [note: 'Indicates whether this billing event has been flagged for compliance review due to potential false claims risk or policy violation.']
  compliance_notes varchar [note: 'Free-text notes documenting compliance review findings, escalations, or special handling instructions for this billing event.']
  coverage_determination varchar [note: 'The formal determination of billing responsibility for this service: sponsor-billable (research-specific), payer-billable (standard of care), institutional cost (absorbed), or patient responsibility. [ENUM-REF-CANDIDATE: sponsor_billable|medicare_billable|medicaid_billable|commercial_insurance_billable|institutional_cost|patient_responsibility|grant_funded — 7 candidates stripped; promote to reference product]']
  cpt_code varchar [note: 'The CPT code representing the procedure or service performed, used to determine billing responsibility.']
  created_timestamp timestamp [note: 'The date and time when this research billing event record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the charge amount. Typically USD for U.S. healthcare organizations.']
  data_quality_score decimal(5,2) [note: 'A calculated score (0-100) representing the completeness and accuracy of this billing event record, used for data governance and quality monitoring.']
  department_code varchar [note: 'The internal department or cost center code where the service was performed, used for financial reporting and cost allocation.']
  determination_rationale varchar [note: 'Detailed explanation of why this service was classified under the assigned coverage determination, referencing protocol requirements and payer policies.']
  event_number varchar [note: 'Human-readable business identifier for this research billing event, used for tracking and audit purposes.']
  grant_number varchar [note: 'The grant or contract number under which this research service is funded, used for financial reconciliation with sponsors.']
  hcpcs_code varchar [note: 'The HCPCS code for the service, used when CPT does not apply or for supplies and equipment.']
  irb_approval_number varchar [note: 'The IRB approval number under which this research service was conducted, ensuring ethical compliance.']
  modified_timestamp timestamp [note: 'The date and time when this research billing event record was last modified, used for audit and data lineage tracking.']
  payer_specific_determination varchar [note: 'Additional payer-specific coverage determination details, capturing nuances in Medicare, Medicaid, or commercial payer policies for research services.']
  payer_type varchar [note: 'The category of payer responsible for this service: Medicare, Medicaid, commercial insurance, sponsor, grant, institutional cost, or patient self-pay. [ENUM-REF-CANDIDATE: medicare|medicaid|commercial|self_pay|sponsor|grant|institutional — 7 candidates stripped; promote to reference product]']
  principal_investigator_npi varchar [note: 'The NPI of the principal investigator responsible for the clinical trial, used for research oversight and billing compliance.']
  procedure_description varchar [note: 'Textual description of the procedure or service performed, providing clinical context for the billing event.']
  protocol_phase varchar [note: 'The clinical trial phase designation at the time of service (e.g., Phase I, Phase II, Phase III, Phase IV).']
  protocol_version varchar [note: 'The version of the clinical trial protocol that was in effect at the time of service, used to ensure coverage analysis alignment.']
  revenue_code varchar [note: 'The UB-04 revenue code associated with this service, used for institutional billing and cost center allocation.']
  service_date date [note: 'The date on which the research-related clinical service was provided to the patient.']
  service_timestamp timestamp [note: 'The precise date and time when the research service was performed, used for detailed audit and reconciliation.']
  sponsor_name varchar [note: 'The name of the clinical trial sponsor (pharmaceutical company, academic institution, or government agency) responsible for funding research-specific costs.']
  standard_of_care_flag boolean [note: 'Indicates whether this service is considered standard of care (true) or research-specific (false) per the coverage analysis.']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Captures research billing compliance determinations, coverage analysis documents, and individual charge-level events for clinical trial services. Coverage analysis layer: records the formal determination of which protocol services are standard of care (insurance-billable) versus research-specific (sponsor/grant-billable), including protocol version analyzed, analysis date, analyst, payer-specific determinations (Medicare, Medicaid, commercial), CPT/HCPCS codes reviewed, determination rationale, and approval status. Charge event layer: captures service date, CPT/HCPCS code, charge amount, coverage determination (sponsor-billable, Medicare-billable, institutional cost), clinical trial policy number, and CMS NCD reference. Supports research billing compliance under CMS NCD 310.1 and OIG guidance to prevent false claims. SSOT for research billing compliance and coverage analysis within the research domain.'
}

Table research.grant_expenditure {
  grant_expenditure_id varchar [pk, note: 'Unique identifier for the grant expenditure transaction record.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: Grant expenditures are audited for allowability, allocability, reasonableness, and compliance with federal cost principles (Uniform Guidance 2 CFR 200). Standard research administration compliance.']
  capital_project_id varchar [note: 'Reference to the research project or study protocol associated with this expenditure.']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Grant expenditures often allocate to specific facilities for multi-site grants. Indirect cost allocation, facility-level financial reporting, grant compliance auditing, and cost center reconciliation ']
  charge_id varchar [note: 'Foreign key linking to billing.charge. Business justification: Grant expenditures for patient-oriented research must trace to specific patient charges to allocate costs correctly for NIH effort reporting, cost accounting, and grant compliance. Required for federa']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Grant expenditures must post to specific GL accounts for financial reporting and grant compliance. Currently has general_ledger_account as text. FK to chart_of_accounts enables proper financial integr']
  grant_id varchar [note: 'Reference to the research grant or contract against which this expenditure is charged.']
  primary_grant_employee_id varchar [note: 'Reference to the employee or personnel member for whom salary or fringe benefit costs are charged, applicable only to personnel and fringe benefit expense categories.']
  purchase_order_id varchar [note: 'Foreign key linking to supply.purchase_order. Business justification: Grant-funded research purchases require PO-level tracking for allowability, allocability, and audit compliance. Real business process: grant accounting, effort reporting, sponsor audit trails, and fed']
  research_study_id varchar
  study_budget_id varchar [note: 'Foreign key linking to research.study_budget. Business justification: Grant expenditures are charged against an approved study budget. Linking grant_expenditure.study_budget_id -> research.study_budget.study_budget_id enables budget vs. actual tracking. No reverse FK ex']
  vendor_id varchar [note: 'Reference to the vendor or supplier from whom goods or services were purchased, applicable to supplies, equipment, subcontract, and other direct cost categories.']
  accounting_period varchar [note: 'The accounting period or month within the fiscal year when the expenditure was recorded.']
  allocable_flag boolean [note: 'Indicates whether the expenditure is allocable to the grant according to the benefit received by the project (True if allocable, False if not allocable).']
  allowable_flag boolean [note: 'Indicates whether the expenditure is allowable under the grant terms and federal cost principles (True if allowable, False if unallowable or questioned).']
  amount decimal(18,2) [note: 'The monetary value of the expenditure transaction in the grant\'s base currency.']
  approval_date date [note: 'The date on which the expenditure transaction was approved for posting to the grant.']
  approval_status varchar [note: 'The current approval status of the expenditure transaction in the financial workflow (pending, approved, rejected, or under review by grants management).']
  approved_by varchar [note: 'The name or identifier of the individual who approved the expenditure transaction, typically a grants administrator or financial manager.']
  audit_flag boolean [note: 'Indicates whether this expenditure has been flagged for audit review or questioned cost analysis (True if flagged, False otherwise).']
  audit_notes varchar [note: 'Free-text notes or comments from auditors or compliance reviewers regarding the expenditure, including any questioned cost justifications.']
  award_number varchar [note: 'The sponsor-assigned award or grant number under which the expenditure is charged.']
  budget_period varchar [note: 'The grant budget period or project year during which the expenditure is charged (e.g., Year 1, Year 2, or specific date range for the budget period).']
  cost_center varchar [note: 'The organizational cost center or department code to which the expenditure is allocated, typically representing the principal investigator\'s department or research unit.']
  cost_share_amount decimal(18,2) [note: 'The portion of the expenditure amount that represents institutional cost sharing or matching funds, if applicable.']
  cost_share_flag boolean [note: 'Indicates whether this expenditure represents institutional cost sharing or matching funds committed to the grant (True if cost share, False if sponsor-funded).']
  created_timestamp timestamp [note: 'The date and time when the expenditure record was first created in the source system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the expenditure amount (e.g., USD for United States Dollar).']
  direct_cost_flag boolean [note: 'Indicates whether the expenditure is a direct cost that can be specifically identified with the grant project (True) or an indirect cost allocated through the facilities and administrative rate (False).']
  effort_percentage decimal(5,2) [note: 'For personnel costs, the percentage of an individual\'s total compensated effort devoted to this grant during the reporting period, used for effort certification and compliance.']
  expense_category varchar [note: 'Classification of the expenditure according to sponsor-required cost categories: personnel costs (salary and wages), fringe benefits, supplies, equipment, travel, subcontract costs, other direct costs, or indirect costs (facilities and administrative). [ENUM-REF-CANDIDATE: personnel|fringe_benefits|supplies|equipment|travel|subcontract|other_direct|indirect — 8 candidates stripped; promote to reference product]']
  fiscal_year varchar [note: 'The fiscal year in which the expenditure was posted, used for annual financial reporting and budget reconciliation.']
  fund_code varchar [note: 'The fund or account code representing the source of funds for the expenditure, used in fund accounting for sponsored research.']
  general_ledger_account varchar [note: 'The general ledger account code to which the expenditure is posted in the financial system.']
  grant_expenditure_description varchar [note: 'Detailed narrative description of the expenditure, including the purpose, justification, and business context for the charge.']
  indirect_cost_rate decimal(5,2) [note: 'The facilities and administrative (F&A) indirect cost rate applied to the expenditure, expressed as a percentage, used to calculate indirect cost recovery.']
  invoice_number varchar [note: 'The vendor invoice number or billing document number associated with the expenditure transaction.']
  modified_by varchar [note: 'The name or identifier of the user who last modified the expenditure record.']
  modified_timestamp timestamp [note: 'The date and time when the expenditure record was last modified or updated in the source system.']
  program_code varchar [note: 'The program or functional area code associated with the expenditure, used for organizational reporting and cost allocation.']
  reasonable_flag boolean [note: 'Indicates whether the expenditure is reasonable in nature and amount for the performance of the grant (True if reasonable, False if questioned).']
  source_system_code varchar [note: 'The unique identifier or primary key of the expenditure transaction in the source financial system.']
  sponsor_code varchar [note: 'The code or identifier for the funding sponsor or agency (e.g., NIH, NSF, DOD, private foundation) that provided the grant.']
  transaction_date date [note: 'The date on which the expenditure transaction was posted or incurred in the financial system.']
  transaction_number varchar [note: 'Business identifier for the expenditure transaction, typically sourced from the financial system (SAP FI document number or Workday journal entry number).']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Transactional record of expenditures charged against a research grant or contract, including personnel costs (salary, fringe), supplies, equipment, subcontract costs, travel, and indirect costs. Captures transaction date, expense category, amount, budget period, cost center, effort percentage, and sponsor-required cost classification. Supports grant financial management, budget-to-actual reporting, and compliance with 2 CFR Part 200 (Uniform Guidance) cost principles. Enables NIH Just-In-Time and progress report financial sections.'
}

Table research.study_sponsor {
  study_sponsor_id varchar [pk, note: 'Unique identifier for the study sponsor record. Primary key for the study sponsor entity.']
  business_associate_agreement_id varchar [note: 'Foreign key linking to compliance.business_associate_agreement. Business justification: External sponsors are business associates requiring BAAs when they receive PHI (subject identifiers, medical records). HIPAA compliance requirement for covered entities conducting research.']
  research_study_id varchar
  agreement_effective_date date [note: 'Date on which the master agreement or clinical trial agreement with the sponsor became effective and binding.']
  agreement_expiration_date date [note: 'Date on which the master agreement with the sponsor expires or is scheduled for renewal. Nullable for evergreen agreements.']
  budget_approval_date date [note: 'Date on which the study budget was formally approved by both the sponsor and the institution\'s research finance office.']
  budget_currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in the study budget (e.g., USD, EUR, GBP, CAD).']
  budget_version varchar [note: 'Version identifier for the study budget terms negotiated with the sponsor. Increments with each budget amendment or renegotiation (e.g., v1.0, v2.0, v2.1).']
  created_by_user varchar [note: 'Username or identifier of the research administrator or system user who created the study sponsor record.']
  created_timestamp timestamp [note: 'Timestamp when the study sponsor record was first created in the research management system. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  cro_relationship_type varchar [note: 'Describes the sponsor\'s relationship with Contract Research Organizations. Direct Sponsor: sponsor manages study directly without CRO; CRO Delegated: CRO manages study on behalf of sponsor; Hybrid: shared responsibilities between sponsor and CRO; Not Applicable: no CRO involvement.']
  duns_number varchar [note: 'Nine-digit DUNS number assigned by Dun & Bradstreet to uniquely identify the sponsor organization. Required for federal grants and contracts.']
  financial_disclosure_required_flag boolean [note: 'Indicates whether the sponsor requires investigators to complete financial disclosure forms per FDA regulations (21 CFR Part 54) to identify potential financial conflicts of interest. True if required; False if not required.']
  invoicing_contact_email varchar [note: 'Email address for submitting invoices and payment inquiries to the sponsor\'s finance department.']
  invoicing_contact_name varchar [note: 'Full name of the sponsor\'s accounts payable or invoicing contact responsible for processing study-related invoices.']
  last_modified_by_user varchar [note: 'Username or identifier of the research administrator or system user who last modified the study sponsor record.']
  last_modified_timestamp timestamp [note: 'Timestamp when the study sponsor record was last updated or modified. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  master_agreement_reference varchar [note: 'Reference number or identifier for the master clinical trial agreement (CTA) or master service agreement (MSA) governing the relationship between the sponsor and the institution. Links to institutional contract management system.']
  nda_bla_holder_flag boolean [note: 'Indicates whether the sponsor holds an NDA or BLA with the FDA for the investigational product. True if sponsor is the regulatory holder; False if sponsor is not the holder (e.g., academic sponsor using an IND from another entity).']
  negotiated_cost_flag boolean [note: 'Indicates whether the budget terms represent negotiated rates specific to this sponsor (True) or standard institutional rates (False). Used to distinguish custom sponsor agreements from standard fee schedules.']
  overhead_indirect_cost_rate decimal(5,2) [note: 'Percentage rate applied to direct study costs to cover institutional overhead and indirect costs (e.g., facilities, administration, compliance). Expressed as a percentage (e.g., 25.00 for 25%).']
  payment_milestone_terms varchar [note: 'Narrative description of payment milestones and triggers defined in the sponsor agreement (e.g., payment upon enrollment, payment upon visit completion, payment upon database lock). Free-text field capturing negotiated payment schedule terms.']
  payment_schedule_frequency varchar [note: 'Frequency at which the sponsor remits payments to the institution. Per Visit: payment after each completed visit; Monthly: consolidated monthly invoicing; Quarterly: quarterly invoicing cycle; Milestone Based: payments tied to specific study milestones; Study Completion: lump sum upon study closure.']
  per_procedure_reimbursement_rate decimal(15,2) [note: 'Standard reimbursement amount paid by the sponsor for each protocol-specified procedure (e.g., lab test, imaging study, biopsy). Expressed in the currency specified in budget_currency_code.']
  per_visit_reimbursement_rate decimal(15,2) [note: 'Standard reimbursement amount paid by the sponsor for each completed study visit per protocol. Expressed in the currency specified in budget_currency_code.']
  primary_contact_email varchar [note: 'Email address of the primary sponsor contact for official study communications, protocol amendments, and regulatory correspondence.']
  primary_contact_name varchar [note: 'Full name of the primary contact person at the sponsor organization responsible for study coordination and communication with the institution.']
  primary_contact_phone varchar [note: 'Primary telephone number for the sponsor contact, including country code and extension if applicable.']
  screen_failure_allowance_amount decimal(15,2) [note: 'Reimbursement amount paid by the sponsor for each patient who is screened but fails to meet eligibility criteria and is not enrolled. Expressed in the currency specified in budget_currency_code.']
  sponsor_address_line1 varchar [note: 'First line of the sponsor organization\'s primary business address, typically including street number and name.']
  sponsor_address_line2 varchar [note: 'Second line of the sponsor organization\'s address for suite, floor, building, or other secondary address details. Nullable.']
  sponsor_city varchar [note: 'City where the sponsor organization is headquartered or maintains its primary business address.']
  sponsor_country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the sponsor\'s primary business location (e.g., USA, GBR, CAN, DEU).']
  sponsor_name varchar [note: 'Full legal name of the entity sponsoring the clinical research study. May be a pharmaceutical company, biotechnology firm, medical device manufacturer, government agency, academic institution, or private foundation.']
  sponsor_notes varchar [note: 'Free-text field for additional notes, special instructions, or institutional knowledge about the sponsor relationship, budget terms, or payment history. Used for operational context and institutional memory.']
  sponsor_postal_code varchar [note: 'Postal or ZIP code for the sponsor\'s primary business address.']
  sponsor_state_province varchar [note: 'State, province, or region of the sponsor\'s primary address. Use standard postal abbreviations (e.g., CA, NY, ON).']
  sponsor_status varchar [note: 'Current status of the sponsor relationship with the institution. Active: currently sponsoring studies; Inactive: no active studies but relationship maintained; Suspended: temporarily halted due to compliance or contractual issues; Terminated: relationship ended.']
  sponsor_type varchar [note: 'Classification of the sponsor organization type. Pharmaceutical: drug manufacturer; Biotechnology: biotech firm; Medical Device: device manufacturer; Government: federal or state agency (e.g., NIH, CDC); Academic: university or research institution; Foundation: private or public foundation; CRO: Contract Research Organization acting as sponsor. [ENUM-REF-CANDIDATE: pharmaceutical|biotechnology|medical_device|government|academic|foundation|cro — 7 candidates stripped; promote to reference product]']
  startup_cost_amount decimal(15,2) [note: 'One-time startup cost paid by the sponsor to cover site initiation activities, including IRB submission, staff training, regulatory document preparation, and site activation. Expressed in the currency specified in budget_currency_code.']
  tax_identification_number varchar [note: 'Tax identification number (TIN), Employer Identification Number (EIN), or equivalent tax identifier for the sponsor organization. Used for institutional tax reporting and compliance (e.g., 1099 reporting).']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Master record for entities sponsoring clinical research studies, including negotiated study budgets and financial terms. Sponsor level: captures sponsor name, type (pharma, biotech, device, government, foundation), NDA/BLA holder status, CRO relationship, contact information, agreement reference, and financial disclosure requirements. Budget level: captures per-visit and per-procedure reimbursement rates, startup costs, overhead/indirect costs, screen failure allowances, payment milestones, budget version, negotiated vs institutional costs, budget approval date, and payment schedule terms. Distinct from grant — sponsors may fund studies without formal grant mechanisms (e.g., industry-sponsored CTAs). Supports research finance, sponsor invoicing, and study budget management. SSOT for sponsor identity and study budget terms within the research domain.'
}

Table research.coverage_analysis {
  coverage_analysis_id varchar [pk, note: 'Unique identifier for the coverage analysis document. Primary key.']
  analyst_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Coverage analysts are institutional employees in research billing/compliance departments performing Medicare coverage determinations and routine-vs-research cost segregation. Required for workload tra']
  cdm_entry_id varchar [note: 'Foreign key linking to billing.cdm_entry. Business justification: Coverage analysis must reference specific CDM entries to determine which charge master items are standard-of-care vs research-only. Required for protocol budget development, sponsor negotiations, and ']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Coverage analysis documents must align with institutional billing compliance policies and payer policies (Medicare NCDs, LCDs). Policy references are mandatory for billing compliance audits.']
  compliance_regulatory_submission_id varchar [note: 'Foreign key linking to compliance.regulatory_submission. Business justification: Coverage analyses are submitted to payers and CMS for clinical trial policy determinations. Medicare NCD/LCD process requires formal submission and review.']
  health_plan_id varchar [note: 'Foreign key linking to insurance.health_plan. Business justification: Coverage determinations are plan-specific (not just payer-level). Different health plans from the same payer have different coverage policies for clinical trial services. Plan-level analysis is requir']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Coverage analyses determine which trial services are billable to specific payers versus sponsor-covered. Medicare/Medicaid/commercial payer-specific determinations are documented in coverage analysis ']
  primary_cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Coverage analysis documents map study procedures to CPT codes to distinguish standard-of-care from investigational services for billing and sponsor negotiations. Critical for research billing complian']
  primary_diagnosis_icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Coverage analysis references diagnosis codes to establish medical necessity and apply payer coverage policies for clinical trial services. Required for billing compliance and payer negotiations. Remov']
  primary_hcpcs_code_id varchar [note: 'Foreign key linking to reference.hcpcs_code. Business justification: Coverage analysis includes HCPCS codes for investigational devices, drugs, and supplies to determine payer coverage and billing strategy. Essential for research billing compliance. Removes denormalize']
  protocol_amendment_id varchar [note: 'Foreign key linking to research.protocol_amendment. Business justification: Coverage analysis documents are versioned with protocol amendments. Currently has protocol_version (STRING) but no FK to protocol_amendment. Adding protocol_amendment_id as nullable FK enables trackin']
  research_study_id varchar [note: 'Foreign key reference to the clinical trial or research study for which this coverage analysis was performed.']
  superseded_by_coverage_analysis_id varchar [note: 'Foreign key reference to the coverage analysis document that supersedes this one, if applicable.']
  test_catalog_id varchar [note: 'Foreign key linking to laboratory.test_catalog. Business justification: Coverage analysis evaluates which lab tests in protocol are standard-of-care (billable to insurance) vs research-only (sponsor-covered). Must link to test catalog for CPT/HCPCS code mapping and payer ']
  analysis_date date [note: 'The date on which the coverage analysis was performed or completed.']
  analysis_document_number varchar [note: 'Formal document control number assigned to this coverage analysis for tracking and audit purposes.']
  analysis_status varchar [note: 'Current lifecycle status of the coverage analysis document.']
  analyst_title varchar [note: 'Job title or role of the analyst who performed the coverage analysis (e.g., Research Billing Analyst, Clinical Research Coordinator).']
  approval_date date [note: 'Date on which the coverage analysis was formally approved for use in research billing operations.']
  approver_name varchar [note: 'Full name of the individual who approved the coverage analysis (typically a compliance officer or research billing manager).']
  clinical_trial_agreement_flag boolean [note: 'Indicates whether a formal clinical trial agreement exists that specifies sponsor responsibility for certain costs.']
  comments varchar [note: 'Additional comments, notes, or special considerations related to the coverage analysis.']
  commercial_coverage_determination varchar [note: 'Overall commercial insurance coverage determination for services in the protocol.']
  created_timestamp timestamp [note: 'Timestamp when this coverage analysis record was first created in the system.']
  determination_rationale varchar [note: 'Detailed rationale and justification for the coverage determinations made in this analysis, including references to payer policies, clinical guidelines, and regulatory requirements.']
  effective_date date [note: 'Date from which the coverage analysis determinations become effective for billing purposes.']
  expiration_date date [note: 'Date on which the coverage analysis expires or is superseded, requiring a new analysis.']
  investigational_device_flag boolean [note: 'Indicates whether the protocol involves an investigational device subject to FDA Investigational Device Exemption (IDE) regulations.']
  investigational_drug_flag boolean [note: 'Indicates whether the protocol involves an investigational drug subject to FDA Investigational New Drug (IND) regulations.']
  last_modified_timestamp timestamp [note: 'Timestamp when this coverage analysis record was last modified.']
  lcd_reference varchar [note: 'Reference to applicable CMS Local Coverage Determination policies used in the analysis.']
  medicaid_coverage_determination varchar [note: 'Overall Medicaid coverage determination for services in the protocol.']
  medicare_coverage_determination varchar [note: 'Overall Medicare coverage determination for services in the protocol: standard of care (billable to Medicare), research only (billable to sponsor), or mixed.']
  ncd_reference varchar [note: 'Reference to applicable CMS National Coverage Determination policies used in the analysis (e.g., NCD 310.1 for routine costs in clinical trials).']
  ndc_codes_reviewed varchar [note: 'Comma-separated list of NDC codes for investigational or standard drugs reviewed in the coverage analysis.']
  off_label_use_flag boolean [note: 'Indicates whether the protocol involves off-label use of approved drugs or devices, which may affect coverage determinations.']
  payer_policy_reference varchar [note: 'Reference to specific commercial payer policies or medical policies used in the coverage determination.']
  payer_type varchar [note: 'Primary payer type for which this coverage analysis was performed. Multiple indicates analysis covers determinations for multiple payer types. [ENUM-REF-CANDIDATE: medicare|medicaid|commercial|self_pay|sponsor|grant|multiple — 7 candidates stripped; promote to reference product]']
  protocol_number varchar [note: 'The unique protocol identifier for the clinical trial being analyzed. May be institution-specific or sponsor-assigned.']
  protocol_version varchar [note: 'Version number or identifier of the protocol document that was analyzed for coverage determination.']
  protocol_version_date date [note: 'The effective date of the protocol version analyzed.']
  research_only_services_count varchar [note: 'Number of services or procedures in the protocol determined to be research-specific and billable to sponsor or grant.']
  reviewer_name varchar [note: 'Full name of the individual who reviewed and validated the coverage analysis.']
  reviewer_title varchar [note: 'Job title or role of the reviewer who validated the coverage analysis.']
  routine_cost_coverage_flag boolean [note: 'Indicates whether routine costs of care in the clinical trial are covered by Medicare per NCD 310.1.']
  sponsor_coverage_commitment varchar [note: 'Description of services or costs that the study sponsor has committed to cover per the clinical trial agreement.']
  standard_of_care_services_count varchar [note: 'Number of services or procedures in the protocol determined to be standard of care and billable to insurance.']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Formal coverage analysis (CA) document record that determines which services in a clinical trial protocol are standard of care (billable to insurance) versus research-specific (billable to sponsor/grant). Captures protocol version analyzed, analysis date, analyst, payer-specific determinations (Medicare, Medicaid, commercial), CPT/HCPCS codes reviewed, determination rationale, approval status, and effective date. Required for research billing compliance programs under CMS NCD 310.1. Distinct from research_billing_event which captures individual charge-level determinations.'
}

Table research.research_regulatory_submission {
  research_regulatory_submission_id varchar [pk, note: 'Unique identifier for the regulatory submission record. Primary key for the research regulatory submission entity.']
  clinician_id varchar [note: 'Foreign key reference to the principal investigator responsible for the research study associated with this regulatory submission.']
  compliance_regulatory_submission_id varchar [note: 'FK to compliance regulatory submission for SSOT linkage']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Regulatory submission deficiencies (FDA 483s, IRB stipulations, warning letters) require CAPAs. Standard regulatory response and quality management.']
  primary_research_employee_id varchar [note: 'Foreign key reference to the system user who prepared and submitted this regulatory submission on behalf of the organization.']
  protocol_amendment_id varchar [note: 'Foreign key linking to research.protocol_amendment. Business justification: Regulatory submissions to FDA/NIH can be for protocol amendments. Adding protocol_amendment_id as nullable FK enables tracking of amendment-specific regulatory submissions and agency responses.']
  regulatory_change_id varchar [note: 'Foreign key linking to compliance.regulatory_change. Business justification: Regulatory submissions respond to or are triggered by regulatory changes (new guidance, rule updates, safety alerts). Essential tracking for compliance officers and regulatory affairs.']
  research_study_id varchar [note: 'Foreign key reference to the research study for which this regulatory submission is made.']
  acknowledgment_date date [note: 'The date on which the regulatory agency officially acknowledged receipt of the submission.']
  action_due_date date [note: 'The deadline date by which the required action or response must be submitted to the regulatory agency.']
  action_required_description varchar [note: 'Detailed description of the specific actions, responses, or additional information required by the regulatory agency following their review of the submission.']
  action_required_flag boolean [note: 'Boolean indicator specifying whether additional action or response is required from the submitting organization following the agency review.']
  agency_division varchar [note: 'The specific division or office within the regulatory agency responsible for reviewing this submission (e.g., Center for Drug Evaluation and Research (CDER), Center for Biologics Evaluation and Research (CBER), Center for Devices and Radiological Health (CDRH)).']
  agency_response_date date [note: 'The date on which the regulatory agency provided an official response or determination regarding the submission.']
  agency_response_letter varchar [note: 'Reference identifier or document location for the official response letter or communication received from the regulatory agency regarding this submission.']
  bla_number varchar [note: 'The Biologics License Application (BLA) number assigned by the Food and Drug Administration (FDA) when seeking approval to market a biological product. Applicable for BLA submissions.']
  cfr_part_11_compliant_flag boolean [note: 'Boolean indicator specifying whether this submission was prepared and submitted in compliance with Food and Drug Administration (FDA) 21 Code of Federal Regulations (CFR) Part 11 electronic records and electronic signatures requirements.']
  created_timestamp timestamp [note: 'The timestamp when this regulatory submission record was first created in the system. Supports audit trail and compliance tracking.']
  determination_outcome varchar [note: 'The final determination or decision outcome provided by the regulatory agency in response to the submission (e.g., Approved, Approved with Conditions, Not Approved, Clinical Hold).']
  ectd_sequence_number varchar [note: 'The sequence number assigned to this submission within the electronic Common Technical Document (eCTD) lifecycle. Used to track versions and amendments in electronic submissions.']
  fda_regulated_device_flag boolean [note: 'Boolean indicator specifying whether this submission involves a Food and Drug Administration (FDA) regulated medical device.']
  fda_regulated_drug_flag boolean [note: 'Boolean indicator specifying whether this submission involves a Food and Drug Administration (FDA) regulated drug product.']
  ide_number varchar [note: 'The Investigational Device Exemption (IDE) number assigned by the Food and Drug Administration (FDA) for device studies. Applicable when submission type is related to device investigations.']
  ind_number varchar [note: 'The Investigational New Drug (IND) application number assigned by the Food and Drug Administration (FDA) for drug studies. Applicable when submission type is related to drug investigations.']
  last_modified_timestamp timestamp [note: 'The timestamp when this regulatory submission record was most recently updated or modified in the system. Supports audit trail and compliance tracking.']
  merged_with_compliance_compliance_regulatory_submission varchar [note: 'SSOT reconciliation attribute added by vibe cross-domain dedup pass.']
  nct_number varchar [note: 'The ClinicalTrials.gov identifier (NCT number) for the clinical trial associated with this regulatory submission. Provides public registry linkage.']
  nda_number varchar [note: 'The New Drug Application (NDA) number assigned by the Food and Drug Administration (FDA) when seeking approval to market a new drug. Applicable for NDA submissions.']
  principal_investigator_name varchar [note: 'The full name of the principal investigator responsible for the research study associated with this regulatory submission.']
  principal_investigator_npi varchar [note: 'The National Provider Identifier (NPI) of the principal investigator, a unique 10-digit identification number issued by the Centers for Medicare and Medicaid Services (CMS).']
  protocol_number varchar [note: 'The internal protocol number or identifier for the research study protocol associated with this regulatory submission.']
  protocol_version varchar [note: 'The version number or identifier of the research protocol that is the subject of this regulatory submission.']
  regulatory_agency varchar [note: 'The federal regulatory agency to which this submission was made (e.g., Food and Drug Administration (FDA), National Institutes of Health (NIH), Office for Human Research Protections (OHRP), Centers for Medicare and Medicaid Services (CMS), Drug Enforcement Administration (DEA)).']
  sponsor_organization varchar [note: 'The name of the organization or entity serving as the sponsor for the research study and responsible for the regulatory submission.']
  ssot_canonical_reference varchar [note: 'Reference to the canonical SSOT record when this record is deprecated or merged']
  ssot_reconciliation_status varchar [note: 'Status indicating reconciliation state with related SSOT entity: ACTIVE, DEPRECATED, MERGED, SUPERSEDED']
  submission_contact_email varchar [note: 'The email address of the primary contact person for this regulatory submission. Business-confidential organizational contact information.']
  submission_contact_name varchar [note: 'The name of the individual serving as the primary contact person for this regulatory submission.']
  submission_contact_phone varchar [note: 'The phone number of the primary contact person for this regulatory submission. Business-confidential organizational contact information.']
  submission_date date [note: 'The date on which the regulatory submission was officially submitted to the federal agency. Represents the principal business event timestamp for this transaction.']
  submission_method varchar [note: 'The method or format used to submit the regulatory documentation to the agency (e.g., electronic Common Technical Document (eCTD), paper submission, electronic gateway, agency portal).']
  submission_notes varchar [note: 'Free-text notes or comments regarding the regulatory submission, including internal tracking information, special circumstances, or additional context.']
  submission_number varchar [note: 'The official submission tracking number assigned by the submitting organization or regulatory agency. Serves as the business identifier for this submission.']
  submission_status varchar [note: 'Current lifecycle status of the regulatory submission indicating its position in the review and approval workflow. [ENUM-REF-CANDIDATE: Draft|Submitted|Under Review|Acknowledged|Approved|Rejected|Withdrawn|Action Required — 8 candidates stripped; promote to reference product]']
  submission_type varchar [note: 'The category of regulatory submission being made to the federal agency. Indicates the purpose and nature of the submission (e.g., Investigational New Drug (IND) Application, Investigational Device Exemption (IDE) Application, New Drug Application (NDA), Biologics License Application (BLA), Office for Human Research Protections (OHRP) Assurance Filing). [ENUM-REF-CANDIDATE: IND Application|IDE Application|IND Amendment|IDE Amendment|Annual Report|Safety Report|NDA Submission|BLA Submission|OHRP Assurance Filing — 9 candidates stripped; promote to reference product]']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']
  created_by varchar

  Note: 'Tracks all regulatory submissions made to federal agencies (FDA, NIH, OHRP) in connection with a research study, including IND applications, IDE applications, IND amendments, annual reports, safety reports, NDA/BLA submissions, and OHRP assurance filings. Captures submission type, submission date, agency, submission number, submission method (eCTD, paper), acknowledgment date, agency response, and action required. Supports FDA 21 CFR Part 312 and Part 812 regulatory lifecycle management.'
}

Table research.monitoring_visit {
  monitoring_visit_id varchar [pk, note: 'Unique identifier for the clinical trial monitoring visit record. Primary key.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: Monitoring visits are audit activities (source data verification, GCP compliance checks, regulatory document review). Often referenced in FDA inspections and institutional compliance reviews.']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Monitoring visits occur at specific facilities. Site audit trails, CAPA tracking, regulatory inspection preparation, and site performance evaluation require facility identification for each monitoring']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Monitoring visit findings (protocol deviations, GCP violations, data discrepancies) require CAPAs when deficiencies are identified. Quality management and regulatory compliance linkage.']
  deficiency_id varchar [note: 'Foreign key linking to consent.consent_deficiency. Business justification: Site monitoring visits identify consent deficiencies (missing signatures, expired consents, reconsent failures). ICH-GCP 5.18 requires monitors to verify consent compliance. Links monitoring visit fin']
  monitor_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: When monitors are institutional employees (vs. external CRO staff), tracking their credentials, GCP training currency, time allocation, and visit workload is required for quality assurance and resourc']
  monitoring_activity_id varchar [note: 'Foreign key linking to compliance.monitoring_activity. Business justification: Research monitoring visits are compliance monitoring activities tracked by institutional compliance programs. Operational overlap for risk-based monitoring and quality management systems.']
  research_study_id varchar [note: 'Reference to the clinical trial or research study being monitored.']
  study_site_id varchar [note: 'Foreign key linking to research.study_site. Business justification: Monitoring visits are conducted at study sites. Currently has site_name, site_number (STRING) but no FK to study_site master. Adding study_site_id FK allows removal of redundant site identification co']
  adverse_event_review_flag boolean [note: 'Indicates whether Adverse Event (AE) and Serious Adverse Event (SAE) reporting and documentation were reviewed for timeliness and completeness.']
  comments varchar [note: 'Additional comments, observations, or contextual notes regarding the monitoring visit not captured in structured fields.']
  corrective_action_plan_due_date date [note: 'Date by which the site must submit a Corrective Action Plan (CAP) or Corrective and Preventive Action (CAPA) response to the sponsor or Contract Research Organization (CRO).']
  corrective_action_plan_received_date date [note: 'Date on which the site submitted the Corrective Action Plan (CAP) or Corrective and Preventive Action (CAPA) response.']
  corrective_action_plan_required_flag boolean [note: 'Indicates whether a formal Corrective Action Plan (CAP) or Corrective and Preventive Action (CAPA) is required from the site in response to findings.']
  created_timestamp timestamp [note: 'Timestamp when this monitoring visit record was first created in the system.']
  data_discrepancies_noted_count varchar [note: 'Number of data discrepancies or queries identified between case report forms and source documents during Source Data Verification (SDV).']
  findings_summary varchar [note: 'Narrative summary of key findings, observations, protocol deviations, and data discrepancies identified during the monitoring visit.']
  follow_up_visit_required_flag boolean [note: 'Indicates whether a follow-up monitoring visit is required to verify implementation of corrective actions or address outstanding issues.']
  follow_up_visit_scheduled_date date [note: 'Scheduled date for the follow-up monitoring visit to verify corrective action implementation.']
  informed_consent_review_flag boolean [note: 'Indicates whether informed consent documents were reviewed for completeness, signatures, and regulatory compliance during this visit.']
  investigational_product_accountability_flag boolean [note: 'Indicates whether investigational drug or device accountability records (receipt, dispensing, return, destruction logs) were reviewed and reconciled.']
  last_modified_timestamp timestamp [note: 'Timestamp when this monitoring visit record was last updated or modified.']
  major_findings_count varchar [note: 'Number of major findings or critical issues identified during the visit that pose significant risk to subject safety, data integrity, or regulatory compliance.']
  minor_findings_count varchar [note: 'Number of minor findings or observations identified during the visit that require attention but do not pose immediate risk.']
  monitor_organization varchar [note: 'Organization employing the monitor: sponsor, Contract Research Organization (CRO), or internal monitoring team.']
  monitor_type varchar [note: 'Classification of the monitor: sponsor representative, CRO monitor, internal institutional monitor, or independent auditor.']
  principal_investigator_name varchar [note: 'Name of the Principal Investigator (PI) at the study site who was present or consulted during the monitoring visit.']
  protocol_deviations_identified_count varchar [note: 'Number of protocol deviations identified during the monitoring visit that require documentation and corrective action.']
  regulatory_document_review_flag boolean [note: 'Indicates whether regulatory documents (Institutional Review Board (IRB) approvals, Food and Drug Administration (FDA) Form 1572, curriculum vitae, licenses) were reviewed for currency and completeness.']
  remote_monitoring_flag boolean [note: 'Indicates whether this monitoring visit was conducted remotely (virtual) rather than on-site, using electronic systems and teleconference.']
  risk_based_monitoring_flag boolean [note: 'Indicates whether this visit was conducted under a Risk-Based Monitoring (RBM) approach with targeted review based on risk assessment.']
  sdv_percentage decimal(5,2) [note: 'Percentage of data points or subjects for which Source Data Verification (SDV) was performed during this visit.']
  site_coordinator_name varchar [note: 'Name of the site research coordinator or study coordinator who assisted during the monitoring visit.']
  source_data_verification_performed_flag boolean [note: 'Indicates whether Source Data Verification (SDV) was performed during this monitoring visit to compare case report forms against source documents.']
  subjects_enrolled_count varchar [note: 'Number of subjects enrolled at the site at the time of the monitoring visit.']
  subjects_reviewed_count varchar [note: 'Number of subject records reviewed by the monitor during this visit for source data verification and compliance.']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']
  visit_date date [note: 'The date on which the monitoring visit was conducted at the study site.']
  visit_end_time timestamp [note: 'Timestamp when the monitoring visit concluded at the site.']
  visit_number varchar [note: 'Sequential or coded identifier for this monitoring visit within the study (e.g., MV-001, MV-002).']
  visit_objectives varchar [note: 'Documented objectives and scope of the monitoring visit, including specific areas of focus (e.g., informed consent review, source data verification, regulatory document review).']
  visit_report_completion_date date [note: 'Date on which the monitoring visit report was finalized and approved for distribution.']
  visit_report_document_code varchar [note: 'Unique document identifier or reference number for the monitoring visit report in the document management system.']
  visit_report_status varchar [note: 'Current status of the monitoring visit report document: draft, in review, finalized, approved, or distributed to stakeholders.']
  visit_start_time timestamp [note: 'Timestamp when the monitoring visit commenced at the site.']
  visit_status varchar [note: 'Current lifecycle status of the monitoring visit: scheduled, in progress, completed, cancelled, or pending report finalization.']
  visit_type varchar [note: 'Classification of the monitoring visit: initiation (site activation), routine (scheduled periodic), interim (mid-study), close-out (study termination), for-cause (triggered by issue), or triggered (unscheduled).']

  Note: 'Records clinical trial monitoring visits conducted by sponsor representatives, CROs, or internal monitors at study sites. Captures visit type (initiation, routine, close-out, for-cause), visit date, monitor name, site visited, findings summary, protocol deviations identified, data discrepancies noted, corrective action plan (CAP) required flag, CAP due date, and visit report completion date. Supports ICH E6(R2) GCP monitoring requirements and sponsor oversight obligations.'
}

Table research.protocol_deviation {
  protocol_deviation_id varchar [pk, note: 'Unique identifier for the protocol deviation record. Primary key.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Protocol deviations discovered during audits become audit findings requiring corrective action. Direct operational link for quality management and regulatory compliance tracking.']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Protocol deviations are site-specific quality events. Site quality metrics, trend analysis, corrective action tracking, and regulatory reporting (IRB, sponsor) require facility attribution. Essential ']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Protocol deviations require CAPAs when they impact subject safety or data integrity. Standard quality management and regulatory compliance for GCP adherence.']
  monitoring_visit_id varchar [note: 'Foreign key linking to research.monitoring_visit. Business justification: Protocol deviations are frequently identified and documented during monitoring visits. protocol_deviation currently stores monitoring_visit_number as a STRING; replacing it with a proper FK protocol_d']
  research_study_id varchar [note: 'Foreign key reference to the research study in which this protocol deviation occurred.']
  responsible_clinician_id varchar [note: 'Foreign key linking to provider.clinician. Business justification: Responsible clinician is tracked for protocol deviation root cause analysis, corrective action plans, and credentialing impact assessment. Healthcare operations require attribution to credentialed cli']
  study_site_id varchar [note: 'Foreign key reference to the clinical trial site where the deviation occurred.']
  subject_enrollment_id varchar [note: 'Foreign key reference to the subject enrollment record associated with this deviation, if applicable.']
  audit_finding_flag boolean [note: 'Indicates whether this protocol deviation was identified as a finding during an internal or external audit or regulatory inspection.']
  capa_completion_date date [note: 'The date on which the corrective and preventive actions were completed and verified.']
  closure_date date [note: 'The date on which the protocol deviation record was formally closed after all corrective and preventive actions were completed and verified.']
  corrective_action varchar [note: 'Description of the immediate corrective action taken to address the specific protocol deviation.']
  created_timestamp timestamp [note: 'The timestamp when this protocol deviation record was first created in the system.']
  data_lock_flag boolean [note: 'Indicates whether this protocol deviation record has been locked for editing to preserve data integrity for regulatory submission or audit purposes.']
  data_lock_timestamp timestamp [note: 'The timestamp when this protocol deviation record was locked for editing, if applicable.']
  detected_by_role varchar [note: 'The role or title of the study personnel who detected or identified the protocol deviation (e.g., Clinical Research Coordinator, Principal Investigator, Monitor).']
  deviation_category varchar [note: 'Classification of the type of protocol deviation that occurred (e.g., eligibility, dosing, visit window, consent, data collection, inclusion/exclusion criteria).']
  deviation_date date [note: 'The date on which the protocol deviation actually occurred.']
  deviation_description varchar [note: 'Detailed narrative description of the protocol deviation, including what occurred and the circumstances surrounding the event.']
  deviation_notes varchar [note: 'Additional free-text notes, comments, or observations related to the protocol deviation, its investigation, or resolution.']
  deviation_number varchar [note: 'Unique business identifier assigned to this protocol deviation for tracking and reporting purposes.']
  deviation_severity varchar [note: 'Severity classification of the protocol deviation: minor (no impact on subject safety or data integrity), major (potential impact), or critical (significant impact requiring immediate action).']
  deviation_status varchar [note: 'Current lifecycle status of the protocol deviation record (e.g., open, under review, closed, pending corrective and preventive action).']
  discovery_date date [note: 'The date on which the protocol deviation was identified or discovered by study personnel.']
  fda_report_date date [note: 'The date on which the protocol deviation was reported to the Food and Drug Administration (FDA), if applicable.']
  fda_reportable_flag boolean [note: 'Indicates whether this protocol deviation meets the criteria for reporting to the Food and Drug Administration (FDA) under 21 CFR Part 312 or 21 CFR Part 812.']
  gcp_compliance_impact varchar [note: 'Assessment of the impact of this protocol deviation on overall Good Clinical Practice (GCP) compliance and regulatory inspection readiness.']
  impact_on_data_integrity varchar [note: 'Assessment of the actual or potential impact of the deviation on the reliability, validity, and integrity of the study data.']
  impact_on_subject_safety varchar [note: 'Assessment of the actual or potential impact of the deviation on the safety and well-being of the study subject.']
  irb_report_date date [note: 'The date on which the protocol deviation was reported to the Institutional Review Board (IRB), if applicable.']
  irb_reportable_flag boolean [note: 'Indicates whether this protocol deviation meets the criteria for reporting to the Institutional Review Board (IRB) per institutional policy and regulatory requirements.']
  last_modified_timestamp timestamp [note: 'The timestamp when this protocol deviation record was last modified or updated in the system.']
  preventive_action varchar [note: 'Description of the preventive action implemented to prevent recurrence of similar protocol deviations in the future.']
  protocol_section_reference varchar [note: 'Specific section, subsection, or clause of the protocol that was deviated from (e.g., Section 5.2.1).']
  protocol_version varchar [note: 'The version of the study protocol that was in effect at the time of the deviation.']
  reported_date date [note: 'The date on which the protocol deviation was formally reported to the appropriate parties (e.g., sponsor, IRB).']
  review_date date [note: 'The date on which the protocol deviation was formally reviewed and assessed by qualified study personnel.']
  reviewed_by_name varchar [note: 'The name of the individual who reviewed and assessed the protocol deviation (typically the Principal Investigator or Quality Assurance personnel).']
  root_cause varchar [note: 'Analysis of the underlying root cause that led to the protocol deviation (e.g., staff training gap, system error, patient non-compliance).']
  sponsor_report_date date [note: 'The date on which the protocol deviation was reported to the study sponsor, if applicable.']
  sponsor_reportable_flag boolean [note: 'Indicates whether this protocol deviation meets the criteria for reporting to the study sponsor per the clinical trial agreement and sponsor requirements.']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Documents protocol deviations and violations identified during a clinical trial, including the deviation description, deviation date, discovery date, deviation category (eligibility, dosing, visit window, consent, data collection), severity (minor, major, important protocol deviation), root cause, impact on subject safety and data integrity, corrective and preventive action (CAPA), and IRB/sponsor reportability determination. Supports GCP compliance, regulatory inspection readiness, and quality management under ICH E6(R2).'
}

Table research.deidentified_dataset {
  deidentified_dataset_id varchar [pk, note: 'Unique identifier for the de-identified research dataset record. Primary key for the dataset registry.']
  business_associate_agreement_id varchar [note: 'Foreign key linking to compliance.business_associate_agreement. Business justification: Deidentified dataset sharing with external parties may require BAAs if re-identification risk exists (limited datasets per HIPAA). Safe Harbor assessment determines BAA necessity.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Deidentified datasets must comply with institutional data governance policies, HIPAA Safe Harbor/Expert Determination policies, and data sharing policies. Policy compliance is mandatory for data stewa']
  fhir_endpoint_id varchar [note: 'Foreign key linking to interoperability.fhir_endpoint. Business justification: Deidentified research datasets published via FHIR endpoints for data sharing per NIH Data Sharing Policy and 21st Century Cures Act. Tracks which FHIR endpoint serves the dataset for access control an']
  primary_deidentified_employee_id varchar [note: 'Identifier of the user or system account that created this dataset record.']
  research_study_id varchar
  access_tier varchar [note: 'The access classification tier indicating the level of de-identification and corresponding access restrictions (internal, limited dataset per HIPAA, fully de-identified, public, controlled access).']
  approved_use_cases varchar [note: 'Description of the approved research use cases, purposes, or research questions for which this dataset may be accessed.']
  cfr_part_11_compliant_flag boolean [note: 'Indicates whether the dataset and its access controls meet FDA 21 CFR Part 11 requirements for electronic records and signatures, applicable to clinical trial data.']
  created_timestamp timestamp [note: 'The timestamp when this de-identified dataset record was first created in the system.']
  data_dictionary_url varchar [note: 'URL or reference to the data dictionary or codebook documenting the structure, variables, and codes in the dataset.']
  data_elements_included varchar [note: 'Description or list of the data elements, fields, or variables included in the de-identified dataset.']
  data_sharing_agreement_reference varchar [note: 'Reference number or identifier for the master data sharing agreement or data use agreement template governing access to this dataset.']
  data_steward_department varchar [note: 'The department or organizational unit to which the data steward belongs.']
  data_steward_email varchar [note: 'Email address of the data steward for dataset inquiries and access requests.']
  data_steward_name varchar [note: 'Name of the individual or role responsible for the governance and oversight of this de-identified dataset.']
  data_use_agreement_required_flag boolean [note: 'Indicates whether a signed Data Use Agreement is required before granting access to this dataset.']
  dataset_code varchar [note: 'Unique business identifier or code assigned to the dataset for external reference and tracking.']
  dataset_creation_date date [note: 'The date when this version of the de-identified dataset was created or extracted from source systems.']
  dataset_description varchar [note: 'Detailed narrative description of the dataset content, purpose, population, and key characteristics for researchers and data governance.']
  dataset_expiration_date date [note: 'The date when this dataset version expires and should no longer be used for new access requests, requiring refresh or retirement.']
  dataset_format varchar [note: 'The file format or data structure format of the dataset (e.g., CSV, Parquet, SAS, FHIR, OMOP CDM).']
  dataset_location_path varchar [note: 'The file system path, cloud storage location, or repository URL where the de-identified dataset files are stored.']
  dataset_name varchar [note: 'Human-readable name or title of the de-identified dataset for identification and cataloging purposes.']
  dataset_size_mb decimal(15,2) [note: 'The total size of the dataset in megabytes, useful for storage planning and access provisioning.']
  dataset_status varchar [note: 'Current lifecycle status of the de-identified dataset indicating its availability and governance state. [ENUM-REF-CANDIDATE: draft|under_review|approved|active|archived|retired|suspended — 7 candidates stripped; promote to reference product]']
  dataset_type varchar [note: 'Classification of the dataset based on its source and nature (e.g., clinical trial data, observational study, EHR-derived, claims-derived). [ENUM-REF-CANDIDATE: clinical_trial|observational_study|registry|biobank|genomic|imaging|ehr_derived|claims_derived — 8 candidates stripped; promote to reference product]']
  dataset_version varchar [note: 'Version number or identifier for this iteration of the dataset, supporting version control and lineage tracking.']
  date_range_end date [note: 'The latest date of data included in the dataset, defining the temporal coverage end boundary.']
  date_range_start date [note: 'The earliest date of data included in the dataset, defining the temporal coverage start boundary.']
  deidentification_date date [note: 'The date when the de-identification process was completed and certified for this dataset.']
  deidentification_method varchar [note: 'The method used to de-identify the dataset per HIPAA standards: Safe Harbor (removal of 18 identifiers), Expert Determination, or Limited Dataset approach.']
  deidentification_performed_by varchar [note: 'Name or identifier of the individual or team who performed the de-identification process.']
  expert_determination_certification_flag boolean [note: 'Indicates whether the dataset received expert determination certification per HIPAA 45 CFR 164.514(b)(1).']
  expert_name varchar [note: 'Name of the qualified statistical expert who provided the expert determination certification, if applicable.']
  hipaa_limited_dataset_flag boolean [note: 'Indicates whether this dataset qualifies as a HIPAA Limited Dataset per 45 CFR 164.514(e), which retains certain date and geographic information.']
  irb_waiver_date date [note: 'The date the IRB waiver or exemption was granted for this dataset.']
  irb_waiver_reference varchar [note: 'Reference number or identifier for the IRB waiver or exemption determination that permits use of this de-identified dataset without individual consent.']
  keywords varchar [note: 'Comma-separated list of keywords or tags for dataset discovery and cataloging (e.g., oncology, diabetes, cardiovascular, genomics).']
  last_modified_timestamp timestamp [note: 'The timestamp when this de-identified dataset record was last updated or modified.']
  nih_data_sharing_compliant_flag boolean [note: 'Indicates whether the dataset meets NIH data sharing policy requirements for federally funded research.']
  patient_population_count varchar [note: 'The number of unique de-identified patients or subjects included in the dataset.']
  phi_elements_removed varchar [note: 'Documentation of the 18 HIPAA identifiers or other PHI elements that were removed or transformed during de-identification.']
  publication_embargo_date date [note: 'The date until which the dataset or findings derived from it are under publication embargo, if applicable.']
  record_count varchar [note: 'The total number of records or observations included in the de-identified dataset.']
  reidentification_risk_assessment_date date [note: 'The date when the re-identification risk assessment was last performed for this dataset.']
  reidentification_risk_score decimal(5,2) [note: 'Quantitative risk score (0-100) representing the assessed risk of re-identification for this dataset, as determined by statistical analysis or expert determination.']
  restricted_use_cases varchar [note: 'Description of use cases or purposes that are explicitly prohibited or restricted for this dataset.']
  source_database varchar [note: 'The specific database or data repository from which the dataset was extracted.']
  therapeutic_area varchar [note: 'The primary therapeutic area or clinical domain covered by the dataset (e.g., oncology, cardiology, neurology, infectious disease).']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Master record for de-identified research datasets, access request management, and data governance. Dataset level: captures dataset name, source systems, de-identification method (Safe Harbor, Expert Determination per HIPAA 45 CFR 164.514(b)), de-identification date, data steward, approved use cases, data sharing agreement reference, IRB waiver reference, data elements, date range, and access tier (internal, limited dataset, fully de-identified). Access request level: tracks requestor name/institution, intended use, IRB approval reference, DUA status, request submission date, review date, approval/denial decision, access dates, expiration, and data destruction certification. Supports research data governance, HIPAA compliance, de-identified data access management, and NIH data sharing policy enforcement. SSOT for research data governance and de-identified data access within the research domain.'
}

Table research.data_access_request {
  data_access_request_id varchar [pk, note: 'Unique identifier for the data access request. Primary key for the data access request entity.']
  business_associate_agreement_id varchar [note: 'Foreign key linking to compliance.business_associate_agreement. Business justification: Data access requestors from external institutions require BAAs before PHI release (even limited datasets). HIPAA requirement for covered entities sharing protected health information.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Data access requests are governed by institutional policies (data use agreements, IRB review requirements, data classification policies, HIPAA minimum necessary). Policy references are mandatory.']
  data_governance_committee_id varchar [note: 'Identifier of the data governance committee or review board that evaluated the data access request.']
  deidentified_dataset_id varchar [note: 'Foreign key linking to research.deidentified_dataset. Business justification: Data access requests reference specific de-identified datasets. Currently has dataset_requested, dataset_description (STRING) but no FK to deidentified_dataset master. Adding deidentified_dataset_id F']
  dua_document_id varchar [note: 'Identifier or reference number of the executed Data Use Agreement document stored in the document management system.']
  fhir_endpoint_id varchar [note: 'Foreign key linking to interoperability.fhir_endpoint. Business justification: Data access requests specify which FHIR endpoint will be used for approved data retrieval. Essential for provisioning access, monitoring usage, and enforcing data use agreement terms in research data ']
  research_study_id varchar [note: 'Identifier of the research study for which data access is requested. Links to the research study entity.']
  access_expiration_date date [note: 'Date on which the granted data access expires and the requestor must cease using the dataset and destroy or return all copies.']
  access_granted_date date [note: 'Date on which the requestor was provided with actual access to the requested dataset following approval.']
  access_method varchar [note: 'Technical method or mechanism through which the requestor is granted access to the dataset.']
  approver_name varchar [note: 'Name of the individual with authority who provided final approval or denial of the data access request.']
  conditions_of_approval varchar [note: 'Specific conditions, restrictions, or requirements that must be met as part of the approval for data access.']
  created_timestamp timestamp [note: 'Timestamp when the data access request record was first created in the system.']
  data_classification_level varchar [note: 'Classification of the requested data based on the level of identifiability and sensitivity, determining applicable privacy protections.']
  data_destruction_certification_date date [note: 'Date on which the requestor certified that all copies of the dataset have been destroyed or returned in compliance with the Data Use Agreement.']
  data_destruction_required_flag boolean [note: 'Indicator of whether the requestor is required to destroy or return all copies of the dataset upon expiration of access or completion of research.']
  denial_reason varchar [note: 'Detailed explanation of the rationale for denying the data access request, including specific policy or regulatory concerns.']
  determination_decision varchar [note: 'Final decision outcome of the data access request review process, indicating whether access was granted or denied.']
  dua_execution_date date [note: 'Date on which the Data Use Agreement was fully executed by all parties, establishing the legal framework for data access.']
  dua_expiration_date date [note: 'Date on which the Data Use Agreement expires, after which data access must cease unless renewed.']
  dua_status varchar [note: 'Current status of the Data Use Agreement that governs the terms and conditions of data access and use.']
  hipaa_compliance_verified_flag boolean [note: 'Indicator of whether HIPAA compliance requirements have been verified and documented for this data access request.']
  intended_use varchar [note: 'Detailed description of the research purpose, analytical methods, and intended use of the requested dataset as stated by the requestor.']
  irb_approval_date date [note: 'Date on which the IRB approved or exempted the research protocol associated with this data access request.']
  irb_approval_number varchar [note: 'Reference number of the IRB approval or exemption determination that authorizes the proposed research use of the requested data.']
  irb_expiration_date date [note: 'Date on which the IRB approval expires, requiring renewal if data access extends beyond this date.']
  irb_institution_name varchar [note: 'Name of the institution whose IRB reviewed and approved the research protocol for this data access request.']
  last_modified_timestamp timestamp [note: 'Timestamp when the data access request record was last updated or modified in the system.']
  nih_data_sharing_policy_compliant_flag boolean [note: 'Indicator of whether the data access request and associated data sharing arrangements comply with NIH data sharing policy requirements.']
  publication_acknowledgment_required_flag boolean [note: 'Indicator of whether the requestor is required to acknowledge the data source in any publications or presentations resulting from use of the dataset.']
  request_notes varchar [note: 'Additional notes, comments, or special instructions related to the data access request, review process, or approval conditions.']
  request_number varchar [note: 'Business identifier for the data access request, used for tracking and reference in communications and documentation.']
  request_status varchar [note: 'Current lifecycle status of the data access request in the review and approval workflow. [ENUM-REF-CANDIDATE: submitted|under_review|pending_irb|pending_dua|approved|denied|withdrawn|expired — 8 candidates stripped; promote to reference product]']
  request_type varchar [note: 'Classification of the data access request based on the requestor relationship to the organization.']
  requestor_department varchar [note: 'Department or division within the requestor institution where the requestor is employed or affiliated.']
  requestor_email varchar [note: 'Primary email address of the requestor for communication regarding the data access request.']
  requestor_institution varchar [note: 'Name of the academic institution, research organization, or company with which the requestor is affiliated.']
  requestor_name varchar [note: 'Full name of the individual researcher or analyst requesting access to the research dataset.']
  requestor_title varchar [note: 'Professional title or role of the requestor within their institution, such as Principal Investigator, Research Fellow, or Data Analyst.']
  research_purpose_category varchar [note: 'Categorical classification of the primary research purpose for which the data access is requested.']
  review_completion_date date [note: 'Date on which the review process was completed and a determination decision was made regarding the data access request.']
  review_start_date date [note: 'Date on which the formal review process of the data access request began by the data governance committee or designated reviewers.']
  reviewer_name varchar [note: 'Name of the individual or committee member who conducted the primary review of the data access request.']
  submission_date date [note: 'Date on which the data access request was initially submitted by the requestor for review.']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Tracks requests by researchers, analysts, or external collaborators to access de-identified or limited research datasets. Captures requestor name and institution, requested dataset, intended use, IRB approval reference, data use agreement (DUA) status, request submission date, review date, approval/denial decision, access granted date, access expiration date, and data destruction certification requirement. Supports research data governance, HIPAA compliance, and NIH data sharing policy enforcement.'
}

Table research.study_budget {
  study_budget_id varchar [pk, note: 'Unique identifier for the study budget record. Primary key.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: Study budgets are audited for allowable costs, effort reporting compliance, sponsor agreement adherence, and Uniform Guidance compliance. Standard in sponsored research administration.']
  budget_coordinator_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Budget coordinators are institutional employees managing study finances, sponsor invoicing, and budget-to-actual reconciliation. Essential for effort reporting, grant compliance, and financial workloa']
  care_site_id varchar [note: 'Foreign key linking to facility.care_site. Business justification: Study budgets are negotiated per site in multi-site trials. Site feasibility assessment, contract negotiation, financial planning, and budget-to-actual variance tracking require facility-level budget ']
  cdm_entry_id varchar [note: 'Foreign key linking to billing.cdm_entry. Business justification: Study budgets reference specific CDM entries for per-procedure reimbursement rates negotiated with sponsors. Essential for clinical trial budget negotiation, feasibility analysis, and automated resear']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Study budgets are allocated to departmental cost centers for financial management, expense tracking, and budget control. Essential for departmental financial reporting, cost center budget variance ana']
  institutional_budget_id varchar [note: 'Foreign key linking to finance.budget. Business justification: Research study budgets are formal institutional budgets requiring approval, tracking, and variance analysis in the finance system. Required for institutional budget management, financial planning, spo']
  research_study_id varchar [note: 'Foreign key reference to the research study for which this budget was negotiated and approved.']
  stark_arrangement_id varchar [note: 'Foreign key linking to compliance.stark_arrangement. Business justification: Research budgets involving physician compensation must be evaluated for Stark compliance (FMV, commercial reasonableness, no volume/value referrals). Required for Medicare billing.']
  study_sponsor_id varchar [note: 'Foreign key linking to research.study_sponsor. Business justification: Study budgets reference the sponsor master table. Currently has sponsor_name, sponsor_type (STRING) but no FK to study_sponsor. Adding study_sponsor_id FK allows removal of redundant sponsor identific']
  superseded_by_study_budget_id varchar [note: 'Foreign key reference to the newer budget version that supersedes this record. Supports budget version history and audit trail.']
  amendment_reason varchar [note: 'Business justification for budget amendment or revision. Documents why budget was renegotiated or updated after initial approval.']
  budget_approval_date date [note: 'Date on which the study budget was formally approved by institutional finance and research administration. Marks transition to active status.']
  budget_approved_by_name varchar [note: 'Name of the institutional authority who approved this budget for execution. Typically research finance director or authorized signatory.']
  budget_effective_date date [note: 'Date from which the budget rates and terms become effective for billing and cost allocation purposes.']
  budget_expiration_date date [note: 'Date on which the budget terms expire or are superseded. May align with study completion or contract end date.']
  budget_negotiated_by_name varchar [note: 'Name of the institutional representative who negotiated this budget with the sponsor. Typically research administrator or grants manager.']
  budget_status varchar [note: 'Current lifecycle status of the study budget. Tracks progression from draft through approval to active use and eventual closure. [ENUM-REF-CANDIDATE: draft|pending_approval|approved|active|amended|superseded|closed — 7 candidates stripped; promote to reference product]']
  budget_type varchar [note: 'Classification of the budget based on funding source and negotiation model. Distinguishes sponsor-negotiated rates from institutional cost recovery models.']
  budget_version_number varchar [note: 'Version identifier for this budget iteration. Supports tracking of budget amendments and renegotiations over the study lifecycle.']
  closeout_cost_amount decimal(18,2) [note: 'One-time costs for study closure activities including final data reconciliation, site closeout visits, archival, and final regulatory submissions.']
  comments varchar [note: 'Free-text field for additional notes, special terms, or clarifications regarding budget negotiation, approval conditions, or payment terms.']
  contract_number varchar [note: 'Unique identifier for the clinical trial agreement or contract under which this budget was negotiated. Links budget to legal agreement.']
  coverage_analysis_required_flag boolean [note: 'Indicates whether a Medicare/Medicaid coverage analysis is required to distinguish standard-of-care costs from research costs. Required for federally-funded or Medicare-eligible patient populations.']
  created_timestamp timestamp [note: 'Timestamp when this budget record was first created in the system. Supports audit trail and data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this budget (e.g., USD, EUR, GBP).']
  enrollment_bonus_amount decimal(18,2) [note: 'Bonus payment amount per enrolled patient if enrollment targets are met. Incentivizes timely recruitment.']
  holdback_percentage decimal(5,2) [note: 'Percentage of each payment withheld by sponsor until study completion or milestone achievement. Expressed as percentage (e.g., 10.00 for 10%).']
  holdback_release_condition varchar [note: 'Conditions under which withheld funds will be released to the institution. May include study completion, data lock, or final report submission.']
  investigational_drug_cost_covered_flag boolean [note: 'Indicates whether the sponsor covers the cost of investigational drug or device. If false, institution may be responsible for procurement costs.']
  last_modified_timestamp timestamp [note: 'Timestamp when this budget record was last updated. Supports audit trail and change tracking.']
  overhead_amount decimal(18,2) [note: 'Total overhead or indirect cost amount negotiated for the study. May be calculated as percentage of direct costs or negotiated as flat amount.']
  overhead_rate_percentage decimal(5,2) [note: 'Institutional indirect cost rate applied to direct study costs. Covers facilities, administration, and institutional support. Expressed as percentage (e.g., 25.00 for 25%).']
  payment_schedule_type varchar [note: 'Defines the billing and payment frequency model. Determines when invoices are submitted and payments are expected from sponsor.']
  payment_terms_days varchar [note: 'Number of days from invoice submission to expected payment receipt. Standard terms are 30, 45, or 60 days net.']
  per_patient_budget_amount decimal(18,2) [note: 'Total budget amount allocated per enrolled patient, including all visits and procedures. Used for enrollment-based budget projections.']
  pharmacy_preparation_fee_amount decimal(18,2) [note: 'Per-dose or per-patient fee for institutional pharmacy preparation, compounding, and dispensing of investigational product. Covers pharmacy labor and overhead.']
  principal_investigator_name varchar [note: 'Name of the principal investigator responsible for the study. Budget is allocated to PI\'s department or cost center.']
  research_only_cost_amount decimal(18,2) [note: 'Estimated total cost of research-only services required by the protocol but not part of standard care. Billable to sponsor, not to patient insurance.']
  retention_bonus_amount decimal(18,2) [note: 'Bonus payment amount per patient who completes the study without early withdrawal. Incentivizes patient retention and protocol adherence.']
  screen_failure_allowance_count varchar [note: 'Number of screen failure patients for which the sponsor will reimburse screening costs. Accounts for patients who do not meet eligibility criteria.']
  screen_failure_reimbursement_amount decimal(18,2) [note: 'Per-patient reimbursement amount for screen failures. Covers costs of screening procedures for patients who do not qualify for enrollment.']
  standard_of_care_cost_amount decimal(18,2) [note: 'Estimated total cost of standard-of-care services that would be provided regardless of study participation. Not billable to sponsor; may be billed to insurance.']
  startup_cost_amount decimal(18,2) [note: 'One-time costs for study initiation activities including site activation, training, regulatory submissions, and initial supplies. Billed prior to first patient enrollment.']
  target_enrollment_count varchar [note: 'Target number of patients to be enrolled at this site under this budget. Used for budget projections and milestone tracking.']
  total_budget_amount decimal(18,2) [note: 'Total negotiated budget amount for the entire study, including all per-visit costs, procedures, startup costs, and overhead. Represents maximum sponsor commitment.']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']

  Note: 'Captures the negotiated and approved budget for a sponsored clinical trial or research study, including per-visit reimbursement rates, per-procedure rates, startup costs, overhead/indirect costs, screen failure allowances, and payment milestones. Tracks budget version, sponsor-negotiated amounts versus institutional costs, budget approval date, and payment schedule terms. Distinct from grant_expenditure (actuals) — this is the prospective budget and rate card for the study. Supports research finance and sponsor invoicing.'
}

Table research.consent_template {
  consent_template_id varchar [pk, note: 'Unique identifier for the informed consent form template record. Primary key.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Consent templates must comply with institutional policies (IRB SOPs, HIPAA authorization requirements, vulnerable population protections, reading level standards). Policy compliance is audited.']
  primary_consent_employee_id varchar [note: 'Identifier of the user who created this consent template record. Supports audit trail and accountability.']
  protocol_amendment_id varchar [note: 'Foreign key linking to research.protocol_amendment. Business justification: Consent templates are updated with protocol amendments. Adding protocol_amendment_id as nullable FK enables tracking of amendment-specific consent form versions and reconsent requirements. Nullable as']
  research_study_id varchar [note: 'Reference to the clinical research study for which this consent template is approved. Links to the research_study product.']
  superseded_by_consent_template_id varchar [note: 'Reference to the newer consent template that replaced this version. Null if this is the current active version.']
  training_id varchar [note: 'Foreign key linking to compliance.training. Business justification: Consent template updates require staff retraining on new versions. Training completion is tracked per template version for regulatory compliance and IRB requirements.']
  comments varchar [note: 'Free-text comments or notes regarding this consent template version, such as rationale for changes, special instructions, or IRB feedback. Supports operational documentation.']
  compensation_disclosure varchar [note: 'Description of compensation or reimbursement provided to subjects for participation, as disclosed in the consent template. Required element per 21 CFR 50.25.']
  contact_information varchar [note: 'Contact information for the principal investigator, study coordinator, and IRB, as provided in the consent template. Required element per 21 CFR 50.25.']
  created_timestamp timestamp [note: 'Timestamp when this consent template record was first created in the system. Audit trail field.']
  data_sharing_consent_flag boolean [note: 'Indicates whether this consent template includes permission for sharing de-identified data with external researchers or public repositories (e.g., ClinicalTrials.gov, dbGaP).']
  effective_date date [note: 'Date from which this consent template version becomes active and can be used for subject enrollment. May differ from IRB approval date if implementation is delayed.']
  future_use_consent_flag boolean [note: 'Indicates whether this consent template includes permission for future use of biospecimens or data in unspecified research. Important for biobanking and secondary research.']
  genetic_testing_consent_flag boolean [note: 'Indicates whether this consent template includes specific permission for genetic or genomic testing. Required when study involves genetic analysis.']
  hipaa_authorization_included_flag boolean [note: 'Indicates whether HIPAA authorization for use and disclosure of PHI is included in this consent template. Required for research involving PHI in the United States.']
  injury_compensation_disclosure varchar [note: 'Statement regarding availability of compensation or medical treatment for research-related injuries, as disclosed in the consent template. Required for studies with more than minimal risk.']
  irb_approval_date date [note: 'Date on which the IRB approved this consent template version. Marks the start of the templates validity period.']
  irb_approval_number varchar [note: 'Unique approval number assigned by the IRB for this consent template version. Required for regulatory compliance and audit trail.']
  irb_expiration_date date [note: 'Date on which the IRB approval for this consent template expires. After this date, the template cannot be used for new enrollments unless re-approved.']
  language_code varchar [note: 'ISO 639-1 two-letter language code for the consent template (e.g., EN for English, ES for Spanish, ZH for Chinese). Supports multilingual study sites.']
  last_modified_timestamp timestamp [note: 'Timestamp when this consent template record was last modified. Audit trail field.']
  reading_level varchar [note: 'Target reading level of the consent document, typically expressed as a grade level (e.g., 8th grade). FDA recommends 6th-8th grade reading level for informed consent documents.']
  reconsent_required_flag boolean [note: 'Indicates whether subjects who consented under a previous template version must be re-consented using this new version. True if protocol changes materially affect risk/benefit or subject rights.']
  required_elements_checklist varchar [note: 'Comma-separated list or structured checklist of required consent elements per 21 CFR 50.25 (e.g., purpose, procedures, risks, benefits, alternatives, confidentiality, voluntary participation, contact information). Used for compliance verification.']
  superseded_date date [note: 'Date on which this consent template version was replaced by a newer version. Null if the template is still active or has not been superseded.']
  template_document_hash varchar [note: 'Cryptographic hash (e.g., SHA-256) of the consent template document file. Ensures document integrity and supports 21 CFR Part 11 compliance for electronic records.']
  template_document_url varchar [note: 'URL or file path to the stored consent template document (PDF, Word, etc.). Used for document retrieval and audit trail.']
  template_number varchar [note: 'Business identifier for the consent template, typically assigned by the IRB or study sponsor. Externally-known unique code for this template version.']
  template_status varchar [note: 'Current lifecycle status of the consent template: draft (under development), irb_submitted (pending IRB review), irb_approved (approved but not yet active), active (currently in use for enrollment), superseded (replaced by newer version), expired (IRB approval lapsed), withdrawn (removed from use). [ENUM-REF-CANDIDATE: draft|irb_submitted|irb_approved|active|superseded|expired|withdrawn — 7 candidates stripped; promote to reference product]']
  template_type varchar [note: 'Type of informed consent document: full ICF (comprehensive consent), short form (abbreviated consent for emergency or limited literacy), assent form (for minors), HIPAA authorization (for PHI use), parental permission (for pediatric studies), or LAD form (legally authorized representative).']
  template_version varchar [note: 'Version number of the consent template (e.g., 1.0, 2.1, 3.0). Incremented with each IRB-approved revision.']
  updated_timestamp timestamp
  vibe_added_flag varchar [note: 'Placeholder attribute added by VIBE mutator']
  vulnerable_population_flag boolean [note: 'Indicates whether this consent template is designed for vulnerable populations (e.g., children, prisoners, pregnant women, cognitively impaired individuals). Requires additional IRB scrutiny and protections.']
  vulnerable_population_type varchar [note: 'Specific type of vulnerable population for which this consent template is designed. Null or none if not applicable.']

  Note: 'Reference master for IRB-approved informed consent form (ICF) templates associated with a study, capturing template version number, IRB approval date, expiration date, language version, consent form type (full ICF, short form, assent form, HIPAA authorization), required elements checklist, and template status (draft, IRB-approved, superseded). Distinct from informed_consent (the subject-level transactional record) — this is the document template/version master. Supports consent version control and ensures subjects are consented on the current IRB-approved version.'
}

Table research.study_arm {
  study_arm_id varchar [pk, note: 'Unique identifier for the study arm within the clinical trial protocol. Primary key.']
  primary_study_employee_id varchar [note: 'The identifier of the user or system account that created this study arm record.']
  research_study_id varchar [note: 'Reference to the parent clinical trial or research study to which this arm belongs.']
  actual_enrollment varchar [note: 'The actual number of subjects enrolled in this arm to date.']
  arm_close_date date [note: 'The date this arm was closed to enrollment, either as planned or due to early termination.']
  arm_name varchar [note: 'The descriptive name of the study arm (e.g., High Dose Experimental, Placebo Control, Standard of Care).']
  arm_notes varchar [note: 'Additional free-text notes or comments about this arm, including operational considerations, protocol deviations, or special instructions.']
  arm_number varchar [note: 'The protocol-defined arm number or code (e.g., Arm 1, Arm A, Control) used to identify this arm within the study documentation.']
  arm_open_date date [note: 'The date this arm was opened for enrollment.']
  arm_status varchar [note: 'The current operational status of the arm: open (actively enrolling), closed (enrollment complete), suspended (temporarily paused), terminated (stopped early), or completed (all subjects finished treatment).']
  arm_suspension_date date [note: 'The date this arm was suspended, if applicable.']
  arm_suspension_reason varchar [note: 'The reason for suspension of this arm (e.g., safety concern, enrollment challenges, sponsor decision).']
  arm_termination_date date [note: 'The date this arm was terminated early, if applicable.']
  arm_termination_reason varchar [note: 'The reason for early termination of this arm (e.g., futility, safety, efficacy demonstrated, sponsor decision).']
  arm_type varchar [note: 'The classification of the arm according to its role in the study: experimental (investigational intervention), active comparator (approved treatment), placebo comparator, sham comparator, no intervention, or observational.']
  blinding_status varchar [note: 'The blinding or masking status for this arm: open label (no blinding), single blind (subject blinded), double blind (subject and investigator blinded), triple blind (subject, investigator, and outcomes assessor blinded), or quadruple blind (subject, investigator, outcomes assessor, and data analyst blinded).']
  concomitant_medication_restrictions varchar [note: 'Any restrictions on concomitant medications or therapies for subjects in this arm, as specified in the protocol.']
  control_arm_flag boolean [note: 'Indicates whether this arm is the control or comparator arm in the study (True) or an experimental arm (False).']
  created_timestamp timestamp [note: 'The date and time when this study arm record was first created in the system.']
  crossover_allowed_flag boolean [note: 'Indicates whether subjects in this arm are permitted to cross over to another arm during the study (True) or not (False).']
  crossover_trigger varchar [note: 'The condition or event that triggers crossover from this arm to another (e.g., disease progression, lack of response, completion of initial treatment phase).']
  data_lock_flag boolean [note: 'Indicates whether this study arm record has been locked for regulatory or data integrity purposes (True) or remains editable (False).']
  data_lock_timestamp timestamp [note: 'The date and time when this study arm record was locked, if applicable.']
  dose_level varchar [note: 'The dose or dose range assigned to this arm (e.g., 10 mg daily, 50 mg twice daily, dose escalation cohort). Applicable for drug and biological interventions.']
  dose_unit varchar [note: 'The unit of measure for the dose (e.g., mg, mL, IU, mcg). Applicable for drug and biological interventions.']
  dosing_frequency varchar [note: 'The frequency of administration for this arm (e.g., once daily, twice daily, weekly, as needed).']
  eligibility_criteria_notes varchar [note: 'Any arm-specific inclusion or exclusion criteria that differ from the overall study eligibility criteria.']
  intervention_description varchar [note: 'Detailed description of the intervention, including formulation, route of administration, frequency, and duration as specified in the protocol.']
  intervention_name varchar [note: 'The name of the investigational product, device, procedure, or intervention being administered in this arm.']
  intervention_type varchar [note: 'The category of intervention being studied in this arm (e.g., drug, biological, device, procedure, behavioral, dietary supplement, radiation, genetic, diagnostic test). [ENUM-REF-CANDIDATE: drug|biological|device|procedure|behavioral|dietary_supplement|radiation|genetic|diagnostic_test|other — 10 candidates stripped; promote to reference product]']
  irb_approval_number varchar [note: 'The IRB approval number associated with this arm, if arm-specific IRB review was required.']
  last_modified_timestamp timestamp [note: 'The date and time when this study arm record was last modified.']
  planned_enrollment varchar [note: 'The target number of subjects planned to be enrolled in this arm according to the protocol.']
  primary_endpoint_measure varchar [note: 'The primary outcome measure or endpoint being evaluated for this arm, as defined in the protocol.']
  protocol_version varchar [note: 'The version of the protocol under which this arm definition is current. Updated when protocol amendments affect arm specifications.']
  protocol_version_date date [note: 'The effective date of the protocol version referenced for this arm.']
  randomization_ratio double [note: 'The ratio of subjects to be randomized to this arm relative to other arms (e.g., 1:1, 2:1, 1:1:1). Applicable for randomized studies.']
  record_status varchar [note: 'The current status of this record in the system: active (current and in use), inactive (superseded but retained), archived (historical), or deleted (soft delete).']
  route_of_administration varchar [note: 'The route by which the intervention is administered (e.g., oral, intravenous, subcutaneous, intramuscular, topical, inhalation). [ENUM-REF-CANDIDATE: oral|intravenous|subcutaneous|intramuscular|topical|inhalation|transdermal|rectal|ophthalmic|otic|nasal|other — 12 candidates stripped; promote to reference product]']
  safety_monitoring_plan varchar [note: 'Description of any arm-specific safety monitoring requirements, including frequency of assessments, laboratory tests, or Data Safety Monitoring Board (DSMB) reviews.']
  secondary_endpoint_measures varchar [note: 'The secondary outcome measures or endpoints being evaluated for this arm. Comma-separated list.']
  stratification_factors varchar [note: 'The factors used to stratify randomization for this arm (e.g., age group, disease stage, prior therapy). Comma-separated list.']
  treatment_duration varchar [note: 'The planned duration of treatment for subjects in this arm (e.g., 12 weeks, 6 months, until disease progression).']

  Note: 'Defines the treatment arms, cohorts, or groups within a clinical trial protocol, including arm name, arm type (experimental, active comparator, placebo, sham, observational), planned enrollment per arm, randomization ratio, dose level or intervention description, and arm status (open, closed, suspended). Supports randomization management, stratified enrollment tracking, and protocol-defined subgroup analyses. A study may have 2–10+ arms; this entity provides the reference structure for subject_enrollment arm assignments.'
}

Table research.study_partner_agreement {
  study_partner_agreement_id varchar [pk, note: 'Unique identifier for this study-partner agreement record. Primary key.']
  research_study_id varchar [note: 'Foreign key linking to the research study that has engaged this trading partner for data exchange or services.']
  trading_partner_id varchar [note: 'Foreign key linking to the external trading partner organization participating in this research study.']
  active_flag boolean [note: 'Indicates whether this study-partner relationship is currently active. A study may have multiple partners over time, with some becoming inactive as the study progresses or completes certain phases.']
  created_date timestamp [note: 'Timestamp when this study-partner agreement record was created in the system.']
  data_flow_direction varchar [note: 'Indicates the direction of data flow for this study-partner relationship: inbound (partner sends data to institution), outbound (institution sends data to partner), or bidirectional.']
  data_sharing_agreement_reference varchar [note: 'Reference identifier or document number for the executed data sharing agreement specific to this study-partner relationship. Governs what data can be exchanged, for what purposes, and under what terms.']
  effective_end_date date [note: 'The date on which this study-partner agreement ended or is scheduled to end. May be null for ongoing relationships.']
  effective_start_date date [note: 'The date on which this study-partner agreement became effective and data exchange was authorized to begin.']
  last_modified_by varchar [note: 'User or system identifier that last modified this study-partner agreement record.']
  last_modified_date timestamp [note: 'Timestamp of the most recent modification to this study-partner agreement record.']
  message_volume_monthly varchar [note: 'The average or expected monthly volume of messages (HL7, FHIR, CDA) exchanged between the institution and this trading partner for this specific study. Used for capacity planning and SLA monitoring.']
  onboarding_date date [note: 'The date on which this trading partner was onboarded and activated for data exchange with this specific research study.']
  partner_role varchar [note: 'The specific role this trading partner plays in this research study (e.g., sponsor CRO, central lab, imaging core, data coordinating center). A partner may have different roles in different studies.']
  sla_response_time_hours decimal [note: 'The service level agreement response time in hours for this study-partner relationship. Defines the maximum time allowed for the trading partner to acknowledge or respond to data requests or messages for this study.']
  created_by varchar [note: 'User or system identifier that created this study-partner agreement record.']

  Note: 'This association product represents the data sharing and interoperability agreement between a research study and an external trading partner. It captures the operational relationship when a trading partner (sponsor CRO, central lab, imaging core, data coordinating center) participates in a multi-site clinical trial. Each record links one research study to one trading partner with attributes that govern the data exchange, service level agreements, and operational status specific to that study-partner collaboration.. Existence Justification: Multi-site clinical trials operationally engage multiple external trading partners (sponsor CROs, central labs, imaging cores, data coordinating centers) for data exchange, lab services, and study coordination. Each research study has multiple trading partners serving different roles, and each trading partner supports multiple concurrent studies. The business actively manages these study-partner relationships with specific data sharing agreements, SLAs, message volume tracking, and role assignments per study-partner pair.'
}

Table research.grant_personnel {
  grant_personnel_id varchar [pk, note: 'Primary key for the grant_personnel association']
  employee_id varchar [note: 'Foreign key linking to the workforce member assigned to the grant']
  grant_id varchar [note: 'Foreign key linking to the research grant funding the personnel']
  appointment_end_date date [note: 'The date on which the employee\'s appointment to this grant ends. May be earlier than the grant project end date if personnel leave the project or transition off.']
  appointment_start_date date [note: 'The date on which the employee\'s appointment to this grant begins. May differ from the grant project start date if personnel are added mid-project.']
  appointment_status varchar [note: 'Current status of the personnel appointment on this grant. Active: currently working on grant. Pending: approved but not yet started. Completed: appointment period ended normally. Terminated: appointment ended early.']
  budget_period varchar [note: 'The specific budget period (typically Year 1, Year 2, etc.) within the grant project period to which this personnel assignment applies. Allows tracking of personnel changes across multi-year grants.']
  cost_share_percentage decimal(5,2) [note: 'The percentage of the employee\'s effort on this grant that is funded by institutional cost-share rather than direct grant funds. Required when the grant award includes mandatory or voluntary committed cost-share.']
  effort_percentage decimal(5,2) [note: 'The percentage of the employee\'s total professional effort (time and intellectual energy) devoted to this grant. Required for federal effort reporting and SF-424 compliance. Must sum to 100% across all grants and institutional commitments for each employee.']
  fte_on_grant decimal(5,4) [note: 'The Full-Time Equivalent value representing the proportion of a full-time position devoted to this grant. Calculated from effort_percentage and the employee\'s base FTE. Used for personnel cost calculations.']
  key_personnel_flag boolean [note: 'Indicates whether this employee is designated as key personnel on the grant, requiring sponsor approval for changes. Typically includes PI, Co-PIs, and other senior/key persons identified in the grant application.']
  role varchar [note: 'The specific role or position the employee holds on this grant (e.g., Principal Investigator, Co-Investigator, Research Coordinator). Required for NIH progress reports and sponsor reporting.']
  salary_charged decimal(18,2) [note: 'The dollar amount of the employee\'s salary and fringe benefits charged to this grant during the current budget period. Used for grant expenditure tracking and budget-to-actual reporting.']

  Note: 'This association product represents the personnel assignment relationship between employees and research grants. It captures effort allocation, salary distribution, and cost-share commitments required for federal effort reporting (SF-424, PHS 398), NIH/NSF grant administration, and OMB Uniform Guidance compliance. Each record links one employee to one grant with attributes that exist only in the context of this funding relationship, including role on the grant, effort percentage, appointment dates, and financial allocations.. Existence Justification: In healthcare research operations, employees (clinical staff, researchers, analysts) are routinely assigned to multiple concurrent grants with different effort allocations, roles, and salary distributions. Simultaneously, each grant funds multiple personnel including the PI, co-investigators, research coordinators, and support staff. Grant personnel assignments are actively managed operational records that research administrators create, update, and track for federal effort reporting, cost accounting, and compliance purposes.'
}

Table research.investigational_product_training {
  investigational_product_training_id varchar [pk, note: 'Primary key uniquely identifying this product-training certification record']
  investigational_clinician_id varchar [note: 'Provider who completed the investigational product training, required before they can prescribe or administer the IP.']
  investigational_competency_assessor_employee_id varchar [note: 'Employee who conducted competency assessment']
  investigational_employee_id varchar [note: 'Non-provider staff member (e.g., research coordinator, pharmacist, nurse) who completed IP training.']
  investigational_product_id varchar [note: 'Foreign key linking to the investigational product requiring training certification']
  investigational_research_study_id varchar [note: 'FK to the research study for which this IP training is required; supports protocol-specific training tracking.']
  investigational_trainee_clinician_id varchar [note: 'FK to the clinician receiving the training if the trainee is a licensed provider; supports clinical privilege linkage.']
  investigational_trainee_employee_id varchar [note: 'Employee ID of the person who completed the training']
  investigational_trainer_employee_id varchar [note: 'Employee who conducted the training']
  investigational_training_id varchar [note: 'Foreign key linking to the compliance training program required for this investigational product']
  research_study_id varchar [note: 'Clinical trial requiring the investigational product training, linking training to specific protocol requirements.']
  study_site_id varchar [note: 'FK to the study site where the trained individual is conducting research; supports site-level training compliance.']
  study_team_member_id varchar [note: 'FK to the study team member who completed the investigational product training.']
  accountability_certified_flag boolean [note: 'Whether trainee is certified in accountability and documentation procedures']
  administration_certified_flag boolean [note: 'Flag indicating certification for administration of investigational product']
  administration_competency_verified boolean [note: 'Indicates whether competency to administer this specific investigational product has been verified through practical assessment or simulation. Required for products with complex administration procedures.']
  adverse_event_recognition_certified_flag boolean [note: 'Flag indicating certification for recognizing and reporting adverse events']
  adverse_event_reporting_certified_flag boolean [note: 'Whether trainee is certified in adverse event recognition and reporting']
  assessment_score decimal(5,2) [note: 'Numeric assessment score achieved on the training competency evaluation.']
  audit_trail varchar [note: 'Audit trail of training record changes']
  certificate_document_url varchar [note: 'URL or path to the training completion certificate document for regulatory inspection readiness.']
  certification_authority varchar [note: 'Name or role of the individual who verified and certified competency for handling this investigational product (e.g., Principal Investigator, Clinical Research Coordinator, Pharmacy Director).']
  certification_expiry_days varchar [note: 'Re-derived attribute added during thin-product expansion based on business context for research.investigational_product_training.']
  certification_number varchar [note: 'Unique certification number issued upon training completion; used for regulatory documentation and audit.']
  competency_assessment_date date [note: 'Date competency assessment was completed']
  competency_assessment_required_flag boolean [note: 'Flag indicating whether hands-on competency assessment is required']
  competency_assessment_result varchar [note: 'Result of competency assessment (competent, needs improvement, not competent)']
  competency_assessment_score decimal(5,2) [note: 'Score on competency assessment (percentage or points)']
  competency_pass_flag boolean [note: 'Whether trainee passed competency assessment']
  competency_verification_date date [note: 'Date when hands-on competency was verified by the PI or delegate.']
  competency_verified_by varchar [note: 'Name of the PI or delegate who verified hands-on competency for IP administration.']
  completion_date date [note: 'Date the trainee completed the investigational product training.']
  completion_status varchar [note: 'Overall completion status of the training (e.g. complete, incomplete, failed).']
  compliance_score decimal(5,2) [note: 'Re-derived attribute added during thin-product expansion based on business context for research.investigational_product_training.']
  created_timestamp timestamp [note: 'Timestamp when the training record was created for lineage and audit tracking.']
  delegation_log_entry_flag boolean [note: 'Flag indicating whether this training is documented in study delegation log']
  delegation_log_reference varchar [note: 'Reference to the delegation log entry authorizing the trainee for product-related duties.']
  dispensation_certified_flag boolean [note: 'Whether trainee is certified to dispense investigational product']
  dispensing_certified_flag boolean [note: 'Indicates certification for IP dispensing procedures']
  documentation_reference varchar [note: 'Reference to training documentation or certificate']
  effective_date date [note: 'Date when this product-training requirement became effective. Used when new investigational products are added to trials or when training requirements change.']
  expiration_date date [note: 'Date when this product-training certification expires. May differ from recertification_due_date if product is discontinued or training requirements change.']
  fda_required_flag boolean [note: 'Indicates whether FDA regulations (e.g., 21 CFR Part 312) require this training for IND studies.']
  gcp_training_current_flag boolean [note: 'Flag indicating whether Good Clinical Practice (GCP) training is current']
  gcp_training_expiration_date decimal(9,4) [note: 'Expiration date of GCP training']
  handling_certification_date date [note: 'Date when staff member was certified to handle this specific investigational product after completing required training. Used for accountability and regulatory compliance per FDA 21 CFR Part 312/812.']
  hands_on_demonstration_flag boolean [note: 'Whether hands-on demonstration was completed']
  irb_required_flag boolean [note: 'Indicates whether the IRB requires this training as a condition of protocol approval.']
  passing_score_threshold decimal(5,2) [note: 'Minimum score required to pass the competency assessment.']
  product_specific_training_status varchar [note: 'Current status of training certification for this specific investigational product. Tracks whether staff member has completed required training for handling this particular product.']
  protocol_deviation_training_flag boolean [note: 'Flag indicating training on protocol deviation reporting']
  protocol_version_trained varchar [note: 'Protocol version for which training was completed']
  recertification_due_date date [note: 'Date by which staff member must complete recertification training for this investigational product. Calculated based on training frequency requirements and product-specific regulatory mandates.']
  regulatory_binder_filed_flag boolean [note: 'Flag indicating whether training documentation is filed in regulatory binder']
  regulatory_requirement_met_flag boolean [note: 'Whether training meets FDA/ICH regulatory requirements']
  remediation_completed_date date [note: 'Date remediation was completed; required before certification can be issued.']
  remediation_required_flag boolean [note: 'Indicates whether the trainee failed the assessment and requires remediation before certification.']
  retraining_reason varchar [note: 'Reason retraining is required (e.g., protocol amendment, new formulation, annual requirement, competency concern).']
  retraining_required_flag boolean [note: 'Indicates whether retraining is needed due to protocol amendment, IP formulation change, or competency lapse.']
  sponsor_delegation_log_flag boolean [note: 'Confirms the trained individual is listed on the sponsor delegation log for IP-related tasks.']
  sponsor_required_flag boolean [note: 'Indicates whether the study sponsor requires this specific training as a condition of site qualification.']
  sponsor_specific_training_flag boolean [note: 'Flag indicating whether sponsor-specific training was completed']
  sponsor_training_reference_number varchar [note: 'Reference number or certificate number from sponsor training']
  storage_handling_certified_flag boolean [note: 'Whether the individual is certified for proper IP storage and handling (cold chain, controlled substance, hazardous).']
  trainer_name varchar [note: 'Name of the trainer or assessor who delivered the investigational product training.']
  trainer_organization varchar [note: 'Organization of the trainer (e.g., sponsor, CRO, academic institution); supports training source documentation.']
  training_attempts varchar [note: 'Number of attempts required to pass training']
  training_certificate_url varchar [note: 'URL or path to training certificate document']
  training_completion_date date [note: 'Date training was completed']
  training_date date [note: 'Date when the training was completed.']
  training_delivery_method varchar [note: 'Method of training delivery (e.g., In-Person, eLearning, Webinar, Hands-On Simulation, Sponsor Site Visit).']
  training_documentation_url varchar [note: 'URL or path to training documentation and certificates']
  training_duration_hours decimal(5,2) [note: 'Duration of training in hours']
  training_duration_minutes decimal(9,4) [note: 'Duration of the training session in minutes.']
  training_materials_version varchar [note: 'Version of training materials used']
  training_method varchar [note: 'Delivery method (e.g., in-person, virtual, self-paced e-learning, hands-on practicum, sponsor-led).']
  training_passed_flag boolean [note: 'Flag indicating whether training was passed']
  training_provider varchar [note: 'Organization or individual who provided the training (sponsor, CRO, institutional training department, principal investigator)']
  training_score decimal(5,2) [note: 'Score achieved on training assessment (if applicable)']
  training_status_summary varchar [note: 'Re-derived attribute added during thin-product expansion based on business context for research.investigational_product_training.']
  training_type varchar [note: 'Category of training (e.g., administration, storage/handling, reconstitution, dose preparation, adverse event recognition, unblinding).']
  training_version varchar [note: 'Version of the training program completed for this investigational product. Tracks which version of product-specific training materials the staff member was certified under, important when product formulation or handling procedures change.']
  unblinding_authorized_flag boolean [note: 'Whether this individual is authorized to perform emergency unblinding procedures.']
  updated_timestamp timestamp [note: 'Timestamp when the training record was last updated for lineage and audit tracking.']
  vibe_enriched_flag boolean [note: 'Re-derived attribute added during thin-product expansion based on business context for research.investigational_product_training.']

  Note: 'This association product represents the training certification relationship between investigational products and compliance training programs. It captures product-specific training requirements, competency verification, and certification status for staff handling investigational products in clinical trials. Each record links one investigational product to one training program with attributes tracking certification dates, competency verification, training version compliance, and recertification schedules specific to that product-training combination.. Existence Justification: In clinical trial operations, investigational products require multiple types of training (handling hazardous materials, administering complex dosage forms, storage/temperature monitoring, controlled substance protocols), and each training program applies to multiple investigational products with similar characteristics. The business actively manages product-specific training certifications as operational records, tracking which staff are certified to handle which products, with certification dates, competency verification, and recertification schedules that exist only in the context of each product-training combination.'
}

Table research.dua_document {
  dua_document_id varchar [pk, note: 'Primary key for dua_document']
  employee_id varchar [note: 'Identifier of the principal investigator responsible for the research study associated with this data use agreement.']
  hie_organization_id varchar [note: 'Identifier of the external organization or institution requesting access to healthcare data under this agreement.']
  parent_dua_document_id varchar [note: 'Identifier of the parent DUA document if this is an amendment, renewal, or addendum to an existing agreement.']
  primary_superseded_dua_document_id varchar [note: 'Self-referencing FK on dua_document (superseded_dua_document_id)']
  audit_rights_description varchar [note: 'Description of Healthcare\'s audit rights to verify recipient compliance with the terms of the data use agreement.']
  breach_notification_required_flag boolean [note: 'Indicates whether the recipient is required to notify Healthcare of any data breach or unauthorized disclosure.']
  compliance_review_date date [note: 'Date of the most recent compliance review or audit of the recipient\'s adherence to the data use agreement terms.']
  compliance_status varchar [note: 'Current compliance status of the recipient organization based on audits and monitoring activities.']
  created_timestamp timestamp [note: 'Timestamp when the data use agreement record was first created in the system.']
  data_classification_level varchar [note: 'Classification level of the data being shared under this agreement, indicating sensitivity and required protection controls.']
  data_destruction_deadline_date date [note: 'Date by which the recipient must destroy or return the data if data destruction is required.']
  data_destruction_required_flag boolean [note: 'Indicates whether the recipient is required to destroy or return the data upon completion of the research or expiration of the agreement.']
  data_security_requirements varchar [note: 'Specific data security and protection requirements that the recipient must implement, including encryption, access controls, and audit logging.']
  data_type varchar [note: 'Type of data being shared indicating the level of identifiability: identified PHI, limited dataset, de-identified, aggregated, or fully anonymized.']
  document_storage_location varchar [note: 'File path or storage location reference for the signed physical or electronic copy of the data use agreement document.']
  document_type varchar [note: 'Classification of the DUA document type indicating whether it is a standard template, custom agreement, amendment, renewal, addendum, or master agreement.']
  document_version_number varchar [note: 'Version number of the data use agreement document, tracking revisions and amendments.']
  dua_document_status varchar [note: 'Current lifecycle status of the data use agreement indicating its operational state.']
  dua_number varchar [note: 'Business identifier for the data use agreement, externally referenced in research protocols and IRB submissions.']
  effective_date date [note: 'Date when the data use agreement becomes legally binding and data sharing may commence.']
  expiration_date date [note: 'Date when the data use agreement terminates and data sharing authorization ends. Nullable for agreements without fixed end dates.']
  healthcare_signatory_name varchar [note: 'Full name of the Healthcare authorized representative who signed the agreement on behalf of the organization.']
  healthcare_signatory_title varchar [note: 'Job title or role of the Healthcare authorized representative who signed the agreement.']
  irb_approval_date date [note: 'Date when the IRB approved the research protocol associated with this data use agreement.']
  irb_protocol_number varchar [note: 'IRB protocol number associated with the research study for which data access is being granted.']
  last_modified_timestamp timestamp [note: 'Timestamp when the data use agreement record was last updated or modified in the system.']
  notes varchar [note: 'Additional notes, comments, or special conditions related to the data use agreement not captured in other structured fields.']
  permitted_use_description varchar [note: 'Detailed description of the permitted uses of the data as specified in the agreement, including research objectives and scope.']
  principal_investigator_email varchar [note: 'Primary email address of the principal investigator for correspondence regarding the data use agreement.']
  principal_investigator_name varchar [note: 'Full name of the principal investigator leading the research study.']
  prohibited_use_description varchar [note: 'Description of prohibited uses of the data, including restrictions on re-identification, commercial use, or sharing with third parties.']
  publication_rights_description varchar [note: 'Description of publication rights and requirements, including manuscript review, co-authorship, and acknowledgment obligations.']
  recipient_signatory_name varchar [note: 'Full name of the authorized representative from the requesting organization who signed the agreement.']
  recipient_signatory_title varchar [note: 'Job title or role of the authorized representative from the requesting organization who signed the agreement.']
  renewal_count varchar [note: 'Number of times this data use agreement has been renewed, tracking the history of the relationship.']
  signed_date date [note: 'Date when all parties signed the data use agreement, making it legally binding.']
  termination_date date [note: 'Actual date when the data use agreement was terminated, if terminated before the scheduled expiration date.']
  termination_reason varchar [note: 'Reason for early termination of the data use agreement if terminated before the expiration date.']
  title varchar [note: 'Full title of the data use agreement document describing the scope and purpose of data sharing.']

  Note: 'Master reference table for dua_document. Referenced by dua_document_id.'
}

Table research.data_governance_committee {
  data_governance_committee_id varchar [pk, note: 'Primary key for data_governance_committee']
  data_employee_id varchar [note: 'Reference to the individual serving as the committee chairperson.']
  data_escalation_committee_id varchar [note: 'Reference to the committee to which unresolved issues or decisions are escalated.']
  data_reporting_to_committee_id varchar [note: 'Reference to the higher-level committee to which this committee reports in the governance hierarchy.']
  data_secretary_person_employee_id varchar [note: 'Reference to the individual serving as the committee secretary responsible for meeting documentation and administrative support.']
  data_vice_chair_person_employee_id varchar [note: 'Reference to the individual serving as the committee vice chairperson.']
  parent_committee_id varchar [note: 'Reference to the parent committee in a hierarchical governance structure, if applicable.']
  parent_data_governance_committee_id varchar [note: 'Self-referencing FK on data_governance_committee (parent_data_governance_committee_id)']
  authority_level varchar [note: 'Level of decision-making authority granted to the committee within the governance hierarchy.']
  budget_amount decimal(15,2) [note: 'Annual budget allocated to the committee for operations, initiatives, and resources.']
  budget_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the budget amount.']
  charter_description varchar [note: 'Detailed description of the committee\'s charter, mission, scope, and responsibilities within the data governance framework.']
  charter_effective_date date [note: 'Date when the current committee charter became effective.']
  charter_expiration_date date [note: 'Date when the current committee charter expires and requires renewal or revision.']
  committee_code varchar [note: 'Short alphanumeric code used to identify the committee in operational systems and reporting.']
  committee_name varchar [note: 'Official name of the data governance committee.']
  committee_type varchar [note: 'Classification of the committee based on its function and authority level within the governance structure.']
  contact_email varchar [note: 'Primary email address for contacting the committee or its administrative support.']
  created_timestamp timestamp [note: 'Timestamp when this committee record was first created in the system.']
  data_domain_coverage varchar [note: 'Description of the data domains and subject areas under the committee\'s governance purview, such as clinical research data, patient data, or operational data.']
  data_governance_committee_status varchar [note: 'Current operational status of the data governance committee.']
  data_steward_appointment_flag boolean [note: 'Indicates whether the committee has authority to appoint or approve data stewards for specific data domains.']
  decision_making_model varchar [note: 'Method by which the committee reaches decisions on matters within its authority.']
  dissolution_date date [note: 'Date when the committee was officially dissolved or terminated, if applicable.']
  dissolution_reason varchar [note: 'Explanation for why the committee was dissolved, including business justification and context.']
  established_date date [note: 'Date when the committee was officially established and began operations.']
  irb_alignment_flag boolean [note: 'Indicates whether the committee coordinates with or reports to the Institutional Review Board for research data governance matters.']
  issue_resolution_authority_flag boolean [note: 'Indicates whether the committee has authority to resolve data governance issues and disputes.']
  last_review_date date [note: 'Date when the committee charter, membership, or effectiveness was last formally reviewed.']
  meeting_frequency varchar [note: 'Scheduled frequency at which the committee convenes for regular meetings.']
  meeting_location varchar [note: 'Primary physical or virtual location where committee meetings are held.']
  member_count varchar [note: 'Current total number of active members serving on the committee.']
  next_review_date date [note: 'Scheduled date for the next formal review of the committee charter, membership, or effectiveness.']
  notes varchar [note: 'Additional notes, comments, or context about the committee not captured in other structured fields.']
  policy_approval_authority_flag boolean [note: 'Indicates whether the committee has authority to approve data governance policies and standards.']
  quorum_requirement varchar [note: 'Minimum number of members required to be present for the committee to conduct official business and make binding decisions.']
  regulatory_oversight_flag boolean [note: 'Indicates whether the committee has regulatory oversight responsibilities requiring compliance with external regulations such as FDA 21 CFR Part 11, HIPAA, or other healthcare regulations.']
  scope varchar [note: 'Organizational scope of the committee\'s jurisdiction and responsibilities.']
  updated_timestamp timestamp [note: 'Timestamp when this committee record was last updated in the system.']
  voting_member_count varchar [note: 'Number of committee members with voting rights on committee decisions.']

  Note: 'Master reference table for data_governance_committee. Referenced by data_governance_committee_id.'
}

Table research.dsmb_committee {
  dsmb_committee_id varchar [pk, note: 'Primary key for dsmb_committee']
  parent_dsmb_committee_id varchar [note: 'Self-referencing FK on dsmb_committee (parent_dsmb_committee_id)']
  adverse_event_review_threshold varchar [note: 'Criteria or threshold that triggers mandatory DSMB committee review of adverse events reported in studies under their oversight.']
  chair_affiliation varchar [note: 'Institutional or organizational affiliation of the committee chairperson.']
  chair_email varchar [note: 'Primary email address for contacting the committee chairperson.']
  chair_name varchar [note: 'Full name of the individual serving as the chairperson of the DSMB committee.']
  chair_phone varchar [note: 'Primary phone number for contacting the committee chairperson.']
  charter_document_reference varchar [note: 'Reference identifier or location of the committee charter document that defines the scope, responsibilities, and operating procedures.']
  committee_code varchar [note: 'Unique alphanumeric code assigned to the DSMB committee for reference and tracking purposes.']
  committee_name varchar [note: 'Official name of the DSMB committee.']
  committee_type varchar [note: 'Classification of the DSMB committee based on its formation and governance structure.']
  communication_protocol varchar [note: 'Established protocol for communication between the DSMB committee, study investigators, sponsors, and regulatory authorities.']
  confidentiality_agreement_reference varchar [note: 'Reference identifier for the confidentiality or non-disclosure agreement signed by committee members.']
  conflict_of_interest_policy varchar [note: 'Reference to or description of the conflict of interest policy governing committee members and their relationships with study sponsors.']
  created_timestamp timestamp [note: 'Timestamp when this DSMB committee record was first created in the system.']
  data_access_level varchar [note: 'Level of access to study data granted to the DSMB committee, indicating whether they review blinded, unblinded, or partially blinded data.']
  data_quality_monitoring_flag boolean [note: 'Indicates whether the DSMB committee reviews data quality and integrity as part of their oversight responsibilities. True if data quality monitoring is included, False otherwise.']
  dissolution_date date [note: 'Date when the DSMB committee was officially dissolved or terminated. Null if committee is still active.']
  dsmb_committee_status varchar [note: 'Current operational status of the DSMB committee in its lifecycle.']
  efficacy_monitoring_flag boolean [note: 'Indicates whether the DSMB committee is responsible for monitoring treatment efficacy in addition to safety. True if efficacy monitoring is included, False otherwise.']
  formation_date date [note: 'Date when the DSMB committee was officially formed and constituted.']
  independent_flag boolean [note: 'Indicates whether the DSMB committee operates independently from the study sponsor and investigators. True if independent, False otherwise.']
  interim_analysis_schedule varchar [note: 'Planned schedule for interim data analyses to be reviewed by the DSMB committee during the course of a study.']
  last_meeting_date date [note: 'Date of the most recent DSMB committee meeting.']
  meeting_frequency varchar [note: 'Scheduled frequency at which the DSMB committee convenes for regular meetings.']
  meeting_minutes_location varchar [note: 'Storage location or reference path for official meeting minutes and records of DSMB committee proceedings.']
  member_count varchar [note: 'Total number of active members currently serving on the DSMB committee.']
  modified_timestamp timestamp [note: 'Timestamp when this DSMB committee record was last modified or updated in the system.']
  next_scheduled_meeting_date date [note: 'Date of the next scheduled DSMB committee meeting.']
  notes varchar [note: 'Additional notes, comments, or contextual information about the DSMB committee.']
  oversight_scope varchar [note: 'Description of the scope of studies, trials, or research activities that fall under the oversight of this DSMB committee.']
  quorum_requirement varchar [note: 'Minimum number of members required to be present for the committee to conduct official business and make binding decisions.']
  regulatory_authority varchar [note: 'Primary regulatory authority or agency overseeing the research activities monitored by this committee (e.g., FDA, EMA, Health Canada).']
  reporting_frequency varchar [note: 'Frequency at which the DSMB committee provides formal reports and recommendations to study sponsors and regulatory authorities.']
  safety_monitoring_flag boolean [note: 'Indicates whether the DSMB committee is responsible for monitoring participant safety. True if safety monitoring is included, False otherwise.']
  statistical_support_provider varchar [note: 'Name of the organization or individual providing statistical analysis support to the DSMB committee.']
  stopping_rule_criteria varchar [note: 'Predefined statistical or clinical criteria that would trigger the DSMB committee to recommend early termination or modification of a study.']
  therapeutic_area varchar [note: 'Primary therapeutic area or medical specialty focus of the research overseen by this committee (e.g., oncology, cardiology, neurology).']

  Note: 'Master reference table for dsmb_committee. Referenced by dsmb_committee_id.'
}

Table research.research_document {
  research_document_id varchar [pk, note: 'Primary key for research_document']
  irb_submission_id varchar [note: 'Reference to the IRB that reviewed and approved this document, ensuring ethical compliance.']
  primary_research_study_id varchar [note: 'Reference to the clinical trial protocol that this document supports or is associated with.']
  primary_superseded_by_research_document_id varchar [note: 'Reference to the newer version of the document that replaces this version, establishing version lineage.']
  research_study_id varchar [note: 'Reference to the clinical study or research project that this document belongs to.']
  access_restriction_notes varchar [note: 'Special instructions or notes regarding who may access this document and under what conditions, supporting data governance and privacy compliance.']
  amendment_number varchar [note: 'Sequential number indicating which amendment this document represents for the associated protocol or study.']
  amendment_reason varchar [note: 'Explanation of why the document was amended, including scientific, safety, or regulatory justifications.']
  approval_date date [note: 'The date when the document received official approval from the designated authority or IRB.']
  approver_name varchar [note: 'Full name of the authorized individual who provided final approval for the document.']
  author_name varchar [note: 'Full name of the principal author or creator of the research document.']
  author_organization varchar [note: 'The organization or institution that the document author represents or is affiliated with.']
  checksum_value decimal(18,2) [note: 'Cryptographic hash value of the document file to ensure integrity and detect unauthorized modifications, required for FDA 21 CFR Part 11 compliance.']
  confidentiality_level varchar [note: 'Data classification level indicating the sensitivity and access restrictions for the document.']
  created_timestamp timestamp [note: 'The date and time when this document record was first created in the research document management system.']
  destruction_eligible_date date [note: 'The earliest date when the document becomes eligible for destruction based on retention policies and regulatory requirements.']
  document_description varchar [note: 'Detailed narrative description of the document content, purpose, and scope within the research context.']
  document_number varchar [note: 'Business identifier for the research document, externally visible and used for reference in communications and regulatory submissions.']
  document_status varchar [note: 'Current lifecycle status of the research document indicating its approval state and usability.']
  document_type varchar [note: 'Classification of the research document indicating its purpose and regulatory category.']
  effective_date date [note: 'The date when this version of the document becomes officially active and enforceable for research operations.']
  electronic_signature_applied boolean [note: 'Indicates whether the document has been electronically signed in compliance with FDA 21 CFR Part 11 requirements.']
  expiration_date date [note: 'The date when this document version is no longer valid or must be renewed, particularly relevant for IRB approvals and regulatory submissions.']
  file_format varchar [note: 'The digital file format of the stored document.']
  file_path varchar [note: 'Storage location or URI where the physical document file is stored in the document management system.']
  file_size_bytes varchar [note: 'The size of the document file measured in bytes for storage management and validation purposes.']
  keywords varchar [note: 'Comma-separated list of keywords or tags for document categorization, search, and retrieval.']
  language_code varchar [note: 'Two-letter ISO 639-1 language code indicating the primary language of the document content.']
  last_modified_timestamp timestamp [note: 'The date and time when this document record was last updated or modified.']
  regulatory_submission_flag boolean [note: 'Indicates whether this document is part of a regulatory submission to FDA, EMA, or other governing bodies.']
  retention_period_years varchar [note: 'The number of years this document must be retained per regulatory requirements before eligible for destruction.']
  reviewer_name varchar [note: 'Full name of the individual who reviewed the document for accuracy, compliance, and scientific validity.']
  signature_timestamp timestamp [note: 'The date and time when the electronic signature was applied to the document.']
  submission_reference_number varchar [note: 'The reference or tracking number assigned by the regulatory authority for submissions that include this document.']
  title varchar [note: 'The official title or name of the research document.']
  version_number varchar [note: 'Version identifier for the document following major.minor versioning convention to track revisions and amendments.']

  Note: 'Master reference table for research_document. Referenced by meeting_minutes_document_id.'
}

Table research.research_study {
  research_study_id varchar [pk, note: 'Primary key for research study']
  care_site_id varchar [note: 'Primary care site coordinating the study']
  compliance_program_id varchar [note: 'Compliance program governing the study']
  cost_center_id varchar [note: 'Financial cost center for study accounting']
  exchange_standard_id varchar [note: 'Data exchange standard for study data (e.g., CDISC ODM)']
  payer_id varchar [note: 'Primary payer for standard-of-care costs']
  primary_diagnosis_icd_code_id varchar [note: 'Primary diagnosis ICD code for study indication']
  primary_procedure_cpt_code_id varchar [note: 'Primary procedure CPT code for study intervention']
  therapeutic_specialty_id varchar [note: 'Therapeutic specialty of the study']
  vendor_id varchar [note: 'Primary vendor or CRO supporting the study']
  actual_enrollment varchar [note: 'Actual number of subjects enrolled']
  amendment_count varchar [note: 'Number of protocol amendments']
  blinding_type varchar [note: 'Blinding type (open-label, single-blind, double-blind, triple-blind)']
  cfr_part_11_compliant_flag boolean [note: 'Flag indicating 21 CFR Part 11 electronic records compliance']
  completion_date date [note: 'Study completion date']
  control_type varchar [note: 'Control type (placebo, active comparator, no intervention)']
  coordinating_center varchar [note: 'Coordinating center name']
  created_timestamp timestamp [note: 'Record creation timestamp']
  data_monitoring_committee_flag boolean [note: 'Flag indicating presence of data monitoring committee']
  enrollment_end_date date [note: 'Enrollment end date']
  enrollment_start_date date [note: 'Enrollment start date']
  exclusion_criteria varchar [note: 'Exclusion criteria text']
  fda_regulated_device_flag boolean [note: 'Flag indicating FDA-regulated device study']
  fda_regulated_drug_flag boolean [note: 'Flag indicating FDA-regulated drug study']
  funding_source varchar [note: 'Funding source (industry, NIH, foundation, institutional)']
  ide_number varchar [note: 'FDA Investigational Device Exemption number']
  inclusion_criteria varchar [note: 'Inclusion criteria text']
  ind_number varchar [note: 'FDA Investigational New Drug application number']
  irb_approval_date date [note: 'IRB approval date']
  irb_expiration_date decimal(9,4) [note: 'IRB approval expiration date']
  irb_protocol_number varchar [note: 'IRB protocol number']
  last_modified_timestamp timestamp [note: 'Last modification timestamp']
  merged_with_radiology_radiology_study varchar [note: 'SSOT reconciliation attribute added by vibe cross-domain dedup pass.']
  nct_identifier varchar [note: 'ClinicalTrials.gov NCT identifier']
  phase varchar [note: 'Study phase (Phase I, II, III, IV, N/A)']
  primary_completion_date date [note: 'Primary completion date']
  primary_outcome_measure varchar [note: 'Primary outcome measure description']
  protocol_number varchar [note: 'Protocol number']
  protocol_version varchar [note: 'Protocol version']
  protocol_version_date date [note: 'Protocol version date']
  randomization_flag boolean [note: 'Flag indicating randomized study']
  secondary_outcome_measures varchar [note: 'Secondary outcome measures description']
  short_title varchar [note: 'Short study title']
  sponsor_name varchar [note: 'Sponsor organization name']
  sponsor_type varchar [note: 'Sponsor type (industry, academic, government)']
  ssot_canonical_reference varchar [note: 'Distinct entity; counterpart radiology.radiology_study serves a separate domain context']
  ssot_reconciliation_status varchar [note: 'SSOT review: kept distinct from radiology.radiology_study (documented as separate business concepts)']
  start_date date [note: 'Study start date']
  study_description varchar [note: 'Study description']
  study_status varchar [note: 'Study status (recruiting, active, completed, terminated, suspended)']
  study_type varchar [note: 'Study type (interventional, observational, expanded access)']
  target_enrollment varchar [note: 'Target enrollment count']
  title varchar [note: 'Full study title']

  Note: 'Clinical research study protocol master record tracking IRB approval, enrollment targets, phase, sponsor, and regulatory identifiers (NCT, IND/IDE).'
}

Table research.grant {
  grant_id varchar [pk, note: 'Primary key for grant']
  org_unit_id varchar [note: 'Reference to the academic or clinical department/unit administering the grant.']
  parent_grant_id varchar [note: 'Self-referencing FK on grant (parent_grant_id)']
  animal_subjects_indicator boolean [note: 'Flag indicating the award involves vertebrate animal research requiring IACUC oversight.']
  award_amount_total decimal(18,2) [note: 'Total obligated funding amount awarded across the full project period (direct plus indirect costs).']
  award_notice_date date [note: 'Date the official notice of award was issued by the sponsor.']
  budget_period_end_date date [note: 'End date of the current annual budget period for the award.']
  budget_period_start_date date [note: 'Start date of the current annual budget period for the award.']
  cfda_number varchar [note: 'Catalog of Federal Domestic Assistance / Assistance Listing number identifying the federal program for financial reporting.']
  clinical_trial_indicator boolean [note: 'Flag indicating whether the grant supports human-subjects clinical trial activity, driving research billing and compliance routing.']
  clinicaltrials_gov_nct_number varchar [note: 'Registered ClinicalTrials.gov NCT identifier for the trial funded under this grant, supporting FDAAA results reporting.']
  competing_segment_number varchar [note: 'Sequence number of the competing funding segment for renewal and continuation tracking.']
  cost_share_amount decimal(18,2) [note: 'Institutional cost-sharing or matching commitment amount required by the award terms.']
  created_timestamp timestamp [note: 'Timestamp when the grant record was first captured in the system of record.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on the award.']
  direct_cost_amount decimal(18,2) [note: 'Portion of the award allocated to direct costs that can be specifically attributed to the funded project.']
  effort_committed_pct decimal(7,4) [note: 'Percentage of personnel effort committed to the project, used for effort certification compliance.']
  federal_award_identifier varchar [note: 'Federal Award Identification Number assigned to the award for federal financial reporting and audit.']
  funding_opportunity_number varchar [note: 'Identifier of the funding opportunity announcement under which the application was submitted.']
  grant_description varchar [note: 'Narrative description or scientific abstract summarizing the aims and scope of the funded research.']
  grant_number varchar [note: 'Externally-known sponsor award number or funding identifier (e.g., NIH grant number such as R01CA123456). Primary business identifier used in regulatory and financial reporting.']
  grant_status varchar [note: 'Current state of the grant within its award lifecycle for operational and financial tracking.']
  grant_type varchar [note: 'Categorical classification of the funding source/mechanism that segments the grant population for reporting and compliance.']
  human_subjects_indicator boolean [note: 'Flag indicating the award involves human subjects research requiring IRB oversight.']
  indirect_cost_amount decimal(18,2) [note: 'Portion of the award allocated to facilities and administrative (F&A) / indirect costs.']
  indirect_cost_rate_pct decimal(7,4) [note: 'Negotiated facilities and administrative rate percentage applied to the direct cost base.']
  institution_account_code varchar [note: 'Internal general-ledger fund or account code to which grant expenditures and budgets are posted.']
  irb_protocol_number varchar [note: 'Institutional Review Board protocol number linked to the human-subjects activity funded by this grant.']
  mechanism_code varchar [note: 'Sponsor activity code identifying the specific funding mechanism (e.g., R01, R21, U01, K08, P30).']
  modified_timestamp timestamp [note: 'Timestamp when the grant record was last updated, supporting Part 11 audit trail requirements.']
  next_report_due_date date [note: 'Date the next scheduled progress or financial report is due to the sponsor.']
  no_cost_extension_end_date date [note: 'Revised project end date when a no-cost extension has been granted to complete the funded work.']
  prime_sponsor_name varchar [note: 'Name of the originating prime sponsor when the award is received as a subaward through a pass-through entity.']
  project_end_date date [note: 'Date the overall project period of the award ends; nullable for open-ended awards.']
  project_start_date date [note: 'Date the overall project period of the award becomes effective.']
  reporting_frequency varchar [note: 'Required cadence for submitting progress and financial reports to the sponsor.']
  sponsor_name varchar [note: 'Name of the funding sponsor or agency providing the award (e.g., National Institutes of Health, NSF, a pharmaceutical company, or a foundation).']
  title varchar [note: 'Official title of the funded research project or program as stated in the award notice.']

  Note: 'Master reference table for grant. Referenced by grant_id.'
}

Table reference.icd_code {
  icd_code_id varchar [pk, note: 'Unique identifier for the ICD code record. Primary key.']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: ICD-10-CM and ICD-10-PCS codes are published annually by CMS with version-specific effective/expiration dates. The icd_code table has version (STRING) and status attributes that should be normalized t']
  age_high varchar [note: 'The maximum patient age (in years) for which this ICD code is clinically appropriate. Used for coding validation and quality checks. Null if no maximum age restriction applies.']
  age_low varchar [note: 'The minimum patient age (in years) for which this ICD code is clinically appropriate. Used for coding validation and quality checks. Null if no minimum age restriction applies.']
  billable_flag boolean [note: 'Indicates whether this ICD code is valid for billing and reimbursement purposes. Only billable codes may be submitted on claims to payers. Non-billable codes are typically higher-level category codes used for classification only.']
  cc_flag boolean [note: 'Indicates whether this diagnosis code is classified as a Complication or Comorbidity (CC) for DRG assignment and severity adjustment purposes.']
  chapter varchar [note: 'The ICD-10 chapter to which this code belongs, representing the highest-level clinical category (e.g., Chapter 1: Certain infectious and parasitic diseases, Chapter 9: Diseases of the circulatory system).']
  chapter_code varchar [note: 'The alphanumeric range defining the chapter boundaries (e.g., A00-B99 for infectious diseases). Used for hierarchical grouping and reporting.']
  code_type varchar [note: 'Indicates whether this code represents a diagnosis (ICD-10-CM) or a procedure (ICD-10-PCS).']
  created_timestamp timestamp [note: 'The date and time when this ICD code record was first created in the system. Used for audit trail and data lineage tracking.']
  effective_date date [note: 'The date on which this ICD code became valid for use in clinical documentation, billing, and reporting. Aligns with annual CMS ICD-10 update cycles (typically October 1).']
  etiology_code_flag boolean [note: 'Indicates whether this code represents the underlying etiology or cause of a condition and should be sequenced before manifestation codes per ICD-10-CM coding conventions.']
  expiration_date date [note: 'The date on which this ICD code was retired or replaced and is no longer valid for use. Null for currently active codes.']
  gender_specific_flag boolean [note: 'Indicates whether this ICD code is applicable only to male patients, only to female patients, or to both. Used for clinical validation and coding accuracy.']
  hac_flag boolean [note: 'Indicates whether this diagnosis code represents a Hospital-Acquired Condition (HAC) as defined by CMS. HACs may result in payment penalties under the Hospital-Acquired Condition Reduction Program.']
  icd_code_category varchar [note: 'The three-character category code representing a group of related conditions or procedures within a chapter (e.g., A01 for typhoid and paratyphoid fevers).']
  icd_code_code varchar [note: 'The full ICD-10-CM diagnosis code or ICD-10-PCS procedure code as published by WHO and maintained by CMS. Format follows alphanumeric pattern with optional decimal subdivision (e.g., A01.0, Z99.89).']
  long_description varchar [note: 'Full clinical description of the diagnosis or procedure code, providing comprehensive detail for clinical documentation, coding accuracy, and medical record completeness.']
  manifestation_code_flag boolean [note: 'Indicates whether this code represents a manifestation of an underlying disease and must be sequenced after the underlying condition code per ICD-10-CM coding conventions.']
  mcc_flag boolean [note: 'Indicates whether this diagnosis code is classified as a Major Complication or Comorbidity (MCC) for DRG assignment and severity adjustment purposes. MCCs have greater impact on reimbursement than standard CCs.']
  parent_code varchar [note: 'The immediate parent code in the ICD-10 hierarchy, enabling hierarchical rollup and drill-down navigation for reporting and analytics.']
  poa_exempt_flag boolean [note: 'Indicates whether this diagnosis code is exempt from the CMS Present on Admission (POA) reporting requirement for inpatient claims. POA-exempt codes do not require a POA indicator on UB-04 claims.']
  replacement_code varchar [note: 'The ICD code that replaces this code if the code has been retired or superseded. Used for code mapping and historical claims reprocessing.']
  short_description varchar [note: 'Abbreviated clinical description of the diagnosis or procedure code, typically used in constrained display contexts such as billing forms and summary reports.']
  snomed_ct_mapping varchar [note: 'The corresponding SNOMED CT concept identifier(s) mapped to this ICD code, enabling interoperability with clinical terminology systems and EHR platforms.']
  subcategory varchar [note: 'The four-character subcategory code providing additional clinical specificity within a category (e.g., A01.0 for typhoid fever).']
  unacceptable_principal_dx_flag boolean [note: 'Indicates whether this diagnosis code is prohibited from being used as the principal diagnosis on an inpatient claim per CMS coding guidelines.']
  updated_timestamp timestamp [note: 'The date and time when this ICD code record was last modified in the system. Used for audit trail and change tracking.']
  valid_for_coding_flag boolean [note: 'Indicates whether this code is valid for use in clinical documentation and coding. Codes may be invalid due to retirement, replacement, or administrative reasons.']

  Note: 'Authoritative master catalog of ICD-10-CM diagnosis codes and ICD-10-PCS procedure codes as published by WHO and maintained by CMS. Each record captures the full code, short and long descriptions, code category, chapter, validity dates, billable flag, and hierarchical parent code. Consumed by clinical documentation, billing, claims, and quality domains for diagnosis and procedure coding.'
}

Table reference.cpt_code {
  cpt_code_id varchar [pk, note: 'Unique identifier for the CPT code record. Primary key.']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: CPT codes are published annually by the AMA with version-specific RVU values and payment amounts. The cpt_code table tracks effective_date and termination_date but lacks explicit version tracking. Add']
  age_range_high varchar [note: 'Maximum patient age (in years) for which the CPT code is clinically appropriate. Null if no upper age restriction applies. Used for claims editing and clinical decision support.']
  age_range_low varchar [note: 'Minimum patient age (in years) for which the CPT code is clinically appropriate. Null if no lower age restriction applies. Used for claims editing and clinical decision support.']
  anesthesia_base_units decimal(6,2) [note: 'Base unit value assigned to anesthesia CPT codes, representing the complexity and risk of the anesthesia service. Used in anesthesia billing formulas along with time units and modifying factors.']
  clinical_family varchar [note: 'Grouping of clinically related CPT codes, such as all codes for a specific type of surgery or diagnostic test. Used for clinical pathway design, order sets, and utilization management.']
  conversion_factor decimal(10,4) [note: 'Dollar amount multiplied by total RVU to calculate Medicare payment. Updated annually by CMS. Used in revenue cycle forecasting and contract modeling.']
  cpt_code varchar [note: 'Five-digit numeric code published by the American Medical Association (AMA) that identifies medical, surgical, and diagnostic services. This is the authoritative business identifier used on CMS-1500 claims, in CPOE systems, and for professional billing.']
  cpt_code_category varchar [note: 'Classification of the CPT code. Category I codes describe established procedures and services. Category II codes are supplemental tracking codes for performance measurement. Category III codes are temporary codes for emerging technology, services, and procedures.']
  cpt_code_status varchar [note: 'Current lifecycle status of the CPT code. Active codes are valid for billing. Inactive codes have been retired but retained for historical claims. Deleted codes are no longer recognized. Pending codes are scheduled for future activation.']
  created_timestamp timestamp [note: 'Timestamp when this CPT code record was first created in the enterprise reference data system. Used for audit trail and data lineage.']
  effective_date date [note: 'Date on which the CPT code became valid for use in billing and clinical documentation. Typically January 1 of the release year for annual updates.']
  facility_indicator varchar [note: 'Indicates whether the CPT code is typically performed in a facility setting (hospital, ASC) or non-facility setting (physician office). Affects practice expense RVU calculation.']
  full_descriptor varchar [note: 'Complete clinical description of the procedure or service, including anatomical site, approach, and any modifiers or conditions. Used for clinical documentation, coding review, and CDI workflows.']
  gender_specific varchar [note: 'Indicates whether the procedure is anatomically or clinically specific to male or female patients. Used for claims editing and clinical decision support.']
  global_period varchar [note: 'Number of days of post-operative care included in the procedure payment. 000 = endoscopic or minor procedure with 0-day follow-up. 010 = minor procedure with 10-day follow-up. 090 = major surgery with 90-day follow-up. XXX = global concept does not apply. YYY = carrier determines global period. ZZZ = add-on code. MMM = maternity codes with global period. [ENUM-REF-CANDIDATE: 000|010|090|XXX|YYY|ZZZ|MMM — 7 candidates stripped; promote to reference product]']
  malpractice_rvu decimal(10,4) [note: 'Relative Value Unit representing the professional liability insurance component. Reflects the relative risk and cost of malpractice insurance for the service.']
  medically_unlikely_edit_value varchar [note: 'Maximum number of units of service that CMS considers medically reasonable for a single patient on a single date of service. Used for claims editing and fraud detection.']
  modifier_indicator varchar [note: 'Indicates whether bilateral surgery, assistant surgeon, or co-surgeon modifiers are applicable. 0 = not subject to modifier rules. 1 = bilateral surgery applies. 2 = assistant surgeon may not be paid. 3 = assistant surgeon and co-surgeon rules apply. 9 = concept does not apply.']
  multiple_procedure_indicator varchar [note: 'Indicates payment adjustment rules when multiple procedures are performed in the same session. 0 = no payment adjustment. 1 = standard payment adjustment applies. 2 = bilateral adjustment applies. 3 = assistant surgeon adjustment. 4 = diagnostic imaging adjustment. 5 = therapy adjustment. 9 = concept does not apply. [ENUM-REF-CANDIDATE: 0|1|2|3|4|5|9 — 7 candidates stripped; promote to reference product]']
  national_payment_amount decimal(12,2) [note: 'National average Medicare payment amount for the CPT code, calculated as total RVU multiplied by the conversion factor. Actual payment varies by geographic locality. Used for budgeting and benchmarking.']
  ncci_edit_indicator boolean [note: 'Indicates whether this CPT code is subject to National Correct Coding Initiative edits, which prevent inappropriate code combinations from being billed together. Used for claims scrubbing and compliance.']
  physician_supervision_required varchar [note: 'Level of physician supervision required for the service to be billable. Direct = physician must be present in the room. General = physician must be immediately available. Personal = physician must perform the service. None = no supervision required.']
  place_of_service_restriction varchar [note: 'Comma-separated list of valid CMS Place of Service codes where this CPT code may be performed and billed. Used for claims editing and compliance validation.']
  practice_expense_rvu decimal(10,4) [note: 'Relative Value Unit representing the practice expense component, including clinical staff, medical supplies, and equipment costs. Varies by facility vs non-facility setting.']
  section varchar [note: 'High-level section of the CPT code set to which this code belongs, such as Evaluation and Management, Anesthesia, Surgery, Radiology, Pathology and Laboratory, or Medicine. Used for reporting and analytics grouping.']
  short_descriptor varchar [note: 'Abbreviated description of the procedure or service, typically 28 characters or fewer, used in billing systems and charge capture interfaces for space-constrained displays.']
  source_system_code varchar [note: 'Unique identifier for this CPT code in the source system. Used for data lineage, reconciliation, and troubleshooting integration issues.']
  subsection varchar [note: 'Subsection within the CPT section, providing more granular classification such as Digestive System, Cardiovascular System, or Office Visits. Used for clinical analytics and charge capture workflows.']
  telemedicine_eligible boolean [note: 'Indicates whether the service can be delivered via telemedicine or telehealth platforms and remain eligible for reimbursement. Updated based on CMS and payer policies.']
  termination_date date [note: 'Date on which the CPT code was retired or deleted from the active code set. Null for currently active codes. Used to prevent billing of obsolete codes and support historical claims adjudication.']
  total_rvu decimal(10,4) [note: 'Sum of work RVU, practice expense RVU, and malpractice RVU. Used to calculate Medicare reimbursement and benchmark physician productivity.']
  updated_timestamp timestamp [note: 'Timestamp when this CPT code record was last modified in the enterprise reference data system. Used for change tracking and data quality monitoring.']
  work_rvu decimal(10,4) [note: 'Relative Value Unit representing the physician work component, including time, technical skill, physical effort, mental effort, and judgment required to perform the service. Used in MIPS reporting and physician compensation models.']

  Note: 'Authoritative master catalog of CPT (Current Procedural Terminology) codes published by the AMA. Captures CPT code, descriptor (short and full), category (Category I, II, III), work RVU, practice expense RVU, malpractice RVU, total RVU, global period, effective and termination dates. Used by professional billing (CMS-1500), MIPS reporting, and clinical order management.'
}

Table reference.hcpcs_code {
  hcpcs_code_id varchar [pk, note: 'Unique identifier for the HCPCS code record. Primary key.']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: HCPCS Level II codes are maintained by CMS with annual updates and quarterly releases. The hcpcs_code table has version_year (INT) and status attributes that should be normalized to code_set_version f']
  age_restriction varchar [note: 'Indicates any age-based coverage restrictions for this HCPCS code (e.g., pediatric only, adult only, age 65+). Defines patient age eligibility criteria.']
  anesthesia_base_units decimal(5,2) [note: 'The base unit value assigned to anesthesia-related HCPCS codes, used in calculating anesthesia reimbursement. Null for non-anesthesia codes.']
  asc_payment_indicator varchar [note: 'Indicates the payment methodology for this HCPCS code when performed in an Ambulatory Surgical Center setting. Defines whether the code is separately payable, bundled, or excluded from ASC payment.']
  assistant_surgeon_indicator varchar [note: 'Indicates whether an assistant surgeon is allowed for this HCPCS code and the applicable payment percentage for assistant surgeon services.']
  bilateral_surgery_indicator varchar [note: 'Indicates whether this HCPCS code is eligible for bilateral surgery payment adjustment when performed on both sides of the body during the same operative session.']
  co_surgeon_indicator varchar [note: 'Indicates whether co-surgeons are allowed for this HCPCS code, where two surgeons perform distinct portions of a complex procedure.']
  code_type varchar [note: 'Classification of the code lifecycle: permanent codes are established in the annual update, temporary codes are used for emerging technology or services, deleted codes are no longer valid.']
  coverage_indicator varchar [note: 'Indicates whether the HCPCS code is covered by Medicare: covered codes are reimbursable, not_covered codes are excluded, carrier_discretion allows local Medicare Administrative Contractor (MAC) determination, bundled codes are included in other services, conditional codes require specific clinical criteria.']
  diagnosis_requirement_indicator boolean [note: 'Indicates whether this HCPCS code requires specific ICD-10 diagnosis codes for coverage. True if diagnosis-based medical necessity criteria apply, false otherwise.']
  dme_indicator boolean [note: 'Indicates whether this HCPCS code represents durable medical equipment as defined by Medicare. True for DME items (typically E-codes), false for other categories.']
  drug_indicator boolean [note: 'Indicates whether this HCPCS code represents a pharmaceutical drug or biological product (typically J-codes). True for drug codes, false for equipment, supplies, and services.']
  effective_date date [note: 'The date on which this HCPCS code became valid and available for use in billing and claims submission.']
  frequency_limit varchar [note: 'The maximum frequency at which this HCPCS code can be billed (e.g., once per year, once per lifetime, twice per month). Defines time-based coverage restrictions.']
  gender_restriction varchar [note: 'Indicates any gender-based restrictions for this HCPCS code. Some codes are specific to male or female anatomy; most have no restriction.']
  global_period varchar [note: 'The number of days of post-operative care included in the payment for this HCPCS code (e.g., 000, 010, 090, XXX, YYY, ZZZ). Defines the global surgical package period.']
  hcpcs_code_category varchar [note: 'The major category of the HCPCS code based on the first letter: A=Transportation/Medical Supplies, B=Enteral/Parenteral, C=Outpatient PPS, D=Dental, E=DME, G=Temporary Procedures, H=Alcohol/Drug, J=Drugs, K=Temporary Codes, L=Orthotics/Prosthetics, M=Medical Services, P=Pathology/Lab, Q=Temporary Codes, R=Diagnostic Radiology, S=Private Payer, T=State Medicaid, V=Vision/Hearing. [ENUM-REF-CANDIDATE: A|B|C|D|E|G|H|J|K|L|M|P|Q|R|S|T|V — 17 candidates stripped; promote to reference product]']
  hcpcs_code_code varchar [note: 'The five-character alphanumeric HCPCS Level II code (e.g., E0601, J1234). First character is always a letter (A-V), followed by four digits. Used to identify durable medical equipment, prosthetics, orthotics, supplies, drugs, and non-physician services.']
  intraoperative_percentage decimal(5,2) [note: 'The percentage of the total payment allocated to intraoperative services for this HCPCS code within the global surgical package.']
  last_updated_date date [note: 'The date on which this HCPCS code record was last modified in the reference data system, reflecting the most recent change to code attributes, descriptions, or coverage indicators.']
  long_description varchar [note: 'Full detailed description of the HCPCS code, providing comprehensive information about the item, service, drug, or supply represented by the code.']
  modifier_required_indicator boolean [note: 'Indicates whether a modifier is required when billing this HCPCS code. True if a modifier is mandatory for proper claims adjudication, false otherwise.']
  multiple_procedure_indicator varchar [note: 'Indicates whether and how payment adjustments apply when this HCPCS code is billed with other procedures on the same date of service. Defines reduction percentages for subsequent procedures.']
  ndc_crosswalk_indicator boolean [note: 'Indicates whether this HCPCS code has an associated NDC crosswalk mapping. True for drug codes that map to specific NDC products, false otherwise.']
  opps_payment_indicator varchar [note: 'Indicates the payment status for this HCPCS code under the Hospital Outpatient Prospective Payment System. Defines whether the code is separately payable, packaged, or excluded from OPPS payment.']
  place_of_service_restriction varchar [note: 'Indicates any restrictions on where this HCPCS code may be performed or billed (e.g., inpatient only, outpatient only, office only). Defines valid place of service codes.']
  postoperative_percentage decimal(5,2) [note: 'The percentage of the total payment allocated to postoperative services for this HCPCS code within the global surgical package.']
  preoperative_percentage decimal(5,2) [note: 'The percentage of the total payment allocated to preoperative services for this HCPCS code within the global surgical package.']
  pricing_indicator varchar [note: 'Indicates the pricing methodology for the HCPCS code: fee_schedule uses CMS published rates, asc uses Ambulatory Surgical Center payment, reasonable_charge uses historical pricing, not_priced has no established rate, contractor_priced is determined by local MAC.']
  prior_authorization_indicator boolean [note: 'Indicates whether this HCPCS code requires prior authorization from the payer before services can be rendered. True if pre-approval is required, false otherwise.']
  professional_component_indicator varchar [note: 'Indicates whether this HCPCS code has separate professional and technical components (e.g., for radiology and pathology services). Defines billing options for split or global billing.']
  quantity_limit decimal(10,2) [note: 'The maximum allowable quantity of this HCPCS code that can be billed per claim, per day, or per time period as defined by coverage policy. Null if no limit applies.']
  short_description varchar [note: 'Abbreviated description of the HCPCS code, typically 28 characters or less, used for display on claims and billing screens.']
  superseded_by_code varchar [note: 'The HCPCS code that replaces this code if it has been superseded or deleted. Null for active codes that have not been replaced.']
  team_surgery_indicator varchar [note: 'Indicates whether team surgery is allowed for this HCPCS code, where multiple surgeons of different specialties are medically necessary.']
  technical_component_indicator varchar [note: 'Indicates whether this HCPCS code includes a technical component representing facility resources, equipment, and supplies.']
  termination_date date [note: 'The date on which this HCPCS code was discontinued or replaced. Null for currently active codes.']
  unit_of_measure varchar [note: 'The standard unit of measure for billing this HCPCS code (e.g., each, milligram, milliliter, hour, day, unit). Defines the quantity increment for claims submission.']

  Note: 'Master catalog of HCPCS (Healthcare Common Procedure Coding System) Level II codes maintained by CMS. Covers durable medical equipment, prosthetics, orthotics, supplies, drugs, and non-physician services not captured by CPT. Includes code, description, category, coverage indicator, pricing methodology, effective and termination dates. Used in facility billing (UB-04) and Medicare/Medicaid claims.'
}

Table reference.drg {
  drg_id varchar [pk, note: 'Unique identifier for the DRG record. Primary key.']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: DRG grouper systems (MS-DRG, APR-DRG, AP-DRG) are versioned annually by CMS with fiscal-year-specific relative weights and payment rules. The drg table has grouper_version (STRING), fiscal_year (INT),']
  major_diagnostic_category_id varchar [note: 'Foreign key reference to the parent Major Diagnostic Category under which this DRG is classified.']
  arithmetic_mean_los decimal(6,2) [note: 'The arithmetic mean (average) length of stay in days for cases in this DRG. Used for benchmarking and operational performance analysis.']
  bundled_payment_flag boolean [note: 'Indicates whether this DRG is included in bundled payment initiatives such as the Bundled Payments for Care Improvement (BPCI) program or Comprehensive Care for Joint Replacement (CJR) model.']
  clinical_family varchar [note: 'Grouping of related DRGs into clinical families for service line analysis (e.g., \'Cardiovascular\', \'Orthopedic\', \'Neurology\'). Facilitates portfolio management and strategic planning.']
  complication_level varchar [note: 'Indicates the severity level of complications or comorbidities included in this DRG definition: without CC/MCC, with CC (moderate complications), or with MCC (major complications). Drives relative weight differentiation.']
  cost_outlier_threshold decimal(12,2) [note: 'The dollar threshold above which a case qualifies for additional outlier payment. Calculated as: (DRG payment × fixed loss ratio) + fixed loss amount.']
  created_timestamp timestamp [note: 'The timestamp when this DRG record was first created in the reference data system. Used for data lineage and historical analysis.']
  drg_code varchar [note: 'The official numeric code assigned to this DRG by the grouper system (e.g., 470, 871). Used as the business identifier for reimbursement and case mix reporting.']
  drg_description varchar [note: 'Extended narrative description of the DRG, including clinical context, typical procedures, and coding guidance. Used for clinical documentation improvement (CDI) and coder education.']
  drg_type varchar [note: 'Classification of the DRG as medical (non-surgical), surgical, or procedure-based. Used for service line segmentation and resource planning.']
  effective_date date [note: 'The date on which this DRG definition and relative weight became effective (typically October 1 of the fiscal year).']
  expiration_date date [note: 'The date on which this DRG definition and relative weight expire (typically September 30 of the fiscal year). Null for currently active DRGs.']
  geometric_mean_los decimal(6,2) [note: 'The geometric mean length of stay in days for cases in this DRG, calculated from national claims data. Used as the threshold for identifying outlier cases and calculating outlier payments.']
  grouper_system varchar [note: 'The DRG grouper classification system under which this DRG is defined: MS-DRG (Medicare Severity), AP-DRG (All Patient), APR-DRG (All Patient Refined), or IR-DRG (International Refined).']
  last_updated_timestamp timestamp [note: 'The timestamp when this DRG record was last modified in the reference data system. Used for change tracking and audit trails.']
  national_average_charges decimal(12,2) [note: 'The national average total charges (not payments) for cases in this DRG. Used for charge benchmarking and cost-to-charge ratio analysis.']
  national_average_payment decimal(12,2) [note: 'The national average Medicare payment amount for this DRG, calculated as: national base rate × relative weight. Used for benchmarking and financial forecasting.']
  national_case_volume varchar [note: 'The total number of Medicare cases nationally that grouped to this DRG in the most recent fiscal year. Used for prevalence analysis and market sizing.']
  operating_room_procedure_flag boolean [note: 'Indicates whether this DRG is classified as an OR procedure DRG, which affects payment and resource allocation.']
  post_acute_transfer_flag boolean [note: 'Indicates whether this DRG is subject to the post-acute care transfer policy, which adjusts payment when a patient is discharged to a post-acute care setting (SNF, IRF, LTCH, HHA) before the geometric mean LOS.']
  principal_diagnosis_range_end varchar [note: 'The ending ICD-10-CM diagnosis code in the range of principal diagnoses that can group to this DRG.']
  principal_diagnosis_range_start varchar [note: 'The starting ICD-10-CM diagnosis code in the range of principal diagnoses that can group to this DRG. Used for grouper logic validation and clinical documentation improvement.']
  procedure_requirement_flag boolean [note: 'Indicates whether this DRG requires the presence of a specific ICD-10-PCS procedure code to group (true for surgical DRGs, false for medical DRGs).']
  quality_measure_flag boolean [note: 'Indicates whether this DRG is associated with specific quality measures under the Hospital Value-Based Purchasing (VBP) or Hospital-Acquired Condition (HAC) Reduction Programs.']
  readmission_penalty_flag boolean [note: 'Indicates whether this DRG is included in the Hospital Readmissions Reduction Program (HRRP) and subject to payment penalties for excess readmissions.']
  relative_weight decimal(10,4) [note: 'The DRG relative weight representing the average resource intensity for cases in this DRG compared to the national average (1.0000). Used to calculate expected reimbursement: base rate × relative weight.']
  special_pay_flag boolean [note: 'Indicates whether this DRG has special payment rules or adjustments (e.g., new technology add-on payments, device-intensive procedures).']
  title varchar [note: 'The full descriptive title of the DRG (e.g., \'Major Hip and Knee Joint Replacement or Reattachment of Lower Extremity with MCC\').']

  Note: 'Master table of Diagnosis-Related Groups (DRGs) and their parent Major Diagnostic Categories (MDCs) used for inpatient prospective payment under CMS MS-DRG, AP-DRG, and APR-DRG grouper systems. DRG records capture DRG code, title, type (medical/surgical/procedure), relative weight, geometric and arithmetic mean LOS, cost threshold, effective fiscal year, and grouper version. MDC records (included as a classification dimension) capture MDC number, title, description, principal diagnosis criteria, and associated DRG range. Central to inpatient reimbursement, CMI (Case Mix Index) calculation, case mix analysis, and service line performance management.'
}

Table reference.snomed_concept {
  snomed_concept_id varchar [pk, note: 'Unique identifier for the SNOMED CT concept as assigned by SNOMED International. This is the primary key and corresponds to the SCTID (SNOMED CT Identifier) in the SNOMED CT release files.']
  code_set_version_id varchar [note: 'The SNOMED CT release version identifier from which this concept was loaded (e.g., \'20230901\', \'2023-09-01\'). Supports version tracking and change management across SNOMED CT releases.']
  parent_concept_snomed_concept_id varchar [note: 'Identifier of the immediate parent concept in the SNOMED CT IS-A hierarchy. Used to navigate the taxonomy and determine subsumption relationships. A concept may have multiple parents in a polyhierarchy.']
  clinical_documentation_section varchar [note: 'The typical section(s) of clinical documentation where this concept is used (e.g., \'Problem List\', \'Allergies\', \'Past Medical History\', \'Assessment\', \'Plan\', \'Procedures\'). Supports context-aware search and documentation templates.']
  concept_class varchar [note: 'Additional classification of the concept beyond the semantic tag, used for grouping and filtering (e.g., \'diagnosis\', \'symptom\', \'surgical procedure\', \'medication\', \'laboratory test\'). May be derived from semantic tag or additional metadata.']
  concept_definition varchar [note: 'A formal textual definition of the concept providing clinical context and meaning. May be sourced from SNOMED International or supplemented with organizational definitions for clarity.']
  concept_status varchar [note: 'Current lifecycle status of the SNOMED CT concept. Active concepts are available for use in clinical documentation; inactive concepts are deprecated and should not be used for new entries but may appear in historical data.']
  cpt_map_target varchar [note: 'The CPT code(s) to which this SNOMED CT procedure concept is mapped, if applicable. Supports billing and revenue cycle management by linking clinical procedures to reimbursable CPT codes.']
  created_timestamp timestamp [note: 'The timestamp when this concept record was first created in the enterprise data platform. Used for audit trail and data lineage tracking.']
  definition_status varchar [note: 'Indicates whether the concept is primitive (defined only by its stated relationships) or fully defined (sufficient conditions provided for automated classification). Fully defined concepts can be automatically classified by description logic reasoners.']
  effective_time date [note: 'The date on which this version of the concept became effective in the SNOMED CT release. Represents the snapshot date of the concept state in the release cycle (typically in YYYYMMDD format in source, stored as DATE).']
  fhir_value_set_membership varchar [note: 'Comma-separated list of FHIR value set identifiers (URIs) to which this concept belongs. Used to support FHIR-based interoperability and constrain coded elements in FHIR resources.']
  fully_specified_name varchar [note: 'The complete, unambiguous name of the SNOMED CT concept including the semantic tag in parentheses (e.g., \'Pneumonia (disorder)\'). The FSN uniquely identifies the concept and includes the semantic category to distinguish homonyms.']
  hierarchy_level varchar [note: 'The depth of this concept in the SNOMED CT hierarchy, with the root concept at level 0. Used for hierarchy traversal, rollup queries, and determining concept granularity.']
  icd10_map_correlation varchar [note: 'The correlation type between the SNOMED CT concept and the ICD-10 map target, indicating the semantic equivalence of the mapping (e.g., exact match, SNOMED concept is narrower than ICD-10 code, SNOMED concept is broader, partial overlap, or not mappable).']
  icd10_map_target varchar [note: 'The ICD-10 code(s) to which this SNOMED CT concept is mapped, if applicable. Supports billing, reporting, and interoperability with systems that use ICD-10 for diagnosis coding. Multiple codes may be pipe-separated.']
  is_ehr_preferred boolean [note: 'Boolean flag indicating whether this concept is designated as a preferred term for use in the organization\'s EHR system. Preferred concepts are promoted in search results and pick lists to standardize documentation.']
  is_leaf_concept boolean [note: 'Boolean flag indicating whether this concept is a leaf node in the hierarchy (has no child concepts). Leaf concepts represent the most granular clinical terms available.']
  is_primitive boolean [note: 'Boolean flag indicating whether the concept is primitive (true) or fully defined (false). Primitive concepts require manual classification; fully defined concepts can be automatically classified by reasoners.']
  is_reportable boolean [note: 'Boolean flag indicating whether this concept represents a condition that must be reported to public health authorities (e.g., notifiable diseases, healthcare-associated infections). Used to trigger automated reporting workflows.']
  last_used_date date [note: 'The most recent date on which this concept was used in clinical documentation within the organization. Used to identify obsolete or rarely used concepts for potential retirement or training needs.']
  loinc_map_target varchar [note: 'The LOINC code(s) to which this SNOMED CT concept is mapped, if applicable. Used for laboratory and clinical observations to support interoperability with laboratory information systems and FHIR resources.']
  module_code varchar [note: 'Identifier of the SNOMED CT module (namespace) to which this concept belongs. Modules represent different editions or extensions (e.g., International Edition, US Edition, UK Edition) and control versioning and governance.']
  patient_friendly_term varchar [note: 'A simplified, patient-friendly description of the concept for use in patient portals, after-visit summaries, and patient education materials. Avoids medical jargon and uses plain language.']
  preferred_term varchar [note: 'The preferred human-readable term for the concept in the default language (typically English). This is the term most commonly used in clinical documentation and user interfaces, without the semantic tag.']
  quality_measure_inclusion varchar [note: 'Comma-separated list of quality measure identifiers (e.g., HEDIS, CMS, MIPS) for which this concept is included in the numerator, denominator, or exclusion criteria. Supports automated quality reporting and value-based care programs.']
  relationship_count varchar [note: 'The total number of active relationships (both stated and inferred) associated with this concept. Relationships define the concept\'s meaning and position in the ontology.']
  rxnorm_map_target varchar [note: 'The RxNorm code(s) to which this SNOMED CT pharmaceutical/biologic product concept is mapped, if applicable. Enables medication interoperability and e-prescribing by linking to the NLM RxNorm drug terminology.']
  semantic_tag varchar [note: 'The high-level semantic category of the concept extracted from the FSN (e.g., \'disorder\', \'procedure\', \'finding\', \'body structure\', \'substance\', \'organism\'). Used to classify concepts into broad clinical domains.']
  specialty_relevance varchar [note: 'Comma-separated list of medical specialties for which this concept is particularly relevant (e.g., \'Cardiology\', \'Oncology\', \'Pediatrics\', \'Emergency Medicine\'). Used to customize pick lists and search results by provider specialty.']
  synonym_count varchar [note: 'The number of active synonym descriptions associated with this concept. Synonyms provide alternative terms for the same concept to support varied clinical documentation styles and search.']
  top_level_hierarchy varchar [note: 'The top-level SNOMED CT hierarchy to which this concept belongs (e.g., \'Clinical Finding\', \'Procedure\', \'Body Structure\', \'Pharmaceutical / Biologic Product\', \'Organism\', \'Substance\', \'Physical Object\', \'Qualifier Value\', \'Observable Entity\', \'Situation\', \'Event\', \'Environment\', \'Social Context\', \'Staging and Scales\', \'Linkage Concept\', \'Special Concept\', \'Navigational Concept\', \'Record Artifact\'). Derived from the root ancestor in the IS-A hierarchy.']
  updated_timestamp timestamp [note: 'The timestamp when this concept record was last updated in the enterprise data platform. Used for change tracking and incremental data processing.']
  usage_frequency_rank varchar [note: 'Rank of this concept based on usage frequency in clinical documentation within the organization. Lower numbers indicate higher usage. Used to prioritize search results and optimize user interfaces.']

  Note: 'Master catalog of SNOMED CT (Systematized Nomenclature of Medicine Clinical Terms) clinical concepts as distributed by SNOMED International and the NLM. Each record captures concept ID, fully specified name, preferred term, semantic tag, concept status (active/inactive), module, effective time, and hierarchy path. Provides the clinical terminology backbone for problem lists, allergies, clinical findings, and FHIR-based interoperability.'
}

Table reference.loinc_code {
  loinc_code_id varchar [pk, note: 'Unique identifier for the LOINC code record. Primary key.']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: LOINC codes are maintained by Regenstrief Institute with biannual releases. The loinc_code table has version_first_released (STRING), version_last_changed (STRING), and status attributes that should b']
  class varchar [note: 'The high-level category or domain of the observation (e.g., CHEM=Chemistry, HEM/BC=Hematology/Blood Count, MICRO=Microbiology, RAD=Radiology, VITALS=Vital Signs).']
  component varchar [note: 'The substance or entity being measured or observed (e.g., Glucose, Hemoglobin, Creatinine). This is the analyte, the target of the measurement.']
  consumer_name varchar [note: 'A patient-friendly, lay-language name for the observation or test, used in patient portals and consumer-facing applications.']
  created_timestamp timestamp [note: 'The date and time when this LOINC code record was first created in the system. Audit trail field.']
  deprecated_date date [note: 'The date when this LOINC code was deprecated or retired. Null if the code is still active.']
  display_name varchar [note: 'The preferred display name for this LOINC code in the current implementation. May be customized by the organization while maintaining the standard LOINC number.']
  effective_date date [note: 'The date when this LOINC code became active and available for use in clinical systems.']
  example_ucum_units varchar [note: 'The standardized UCUM representation of the example units. Used for interoperability and unit conversion.']
  example_units varchar [note: 'Common units of measure for this observation (e.g., mg/dL, mmol/L, %). Provides guidance for result reporting.']
  external_copyright_notice varchar [note: 'Copyright or licensing information for LOINC codes that incorporate third-party content (e.g., SNOMED CT, CPT). Required for compliance with external terminology licenses.']
  hl7_field_subfield_code varchar [note: 'The HL7 v2.x message field identifier where this LOINC code is typically used (e.g., OBX-3 for observation identifier). Supports HL7 message mapping.']
  hl7_v3_code_system_oid varchar [note: 'The HL7 v3 object identifier for the LOINC code system (typically 2.16.840.1.113883.6.1). Used in CDA documents and HL7 v3 messages.']
  is_active boolean [note: 'Boolean flag indicating whether this LOINC code is currently active and available for use in the organization. True=active, False=inactive or deprecated locally.']
  last_verified_date date [note: 'The date when this LOINC code mapping was last reviewed and verified by clinical informatics or laboratory staff. Supports ongoing terminology governance.']
  local_code varchar [note: 'Organization-specific internal code or identifier mapped to this LOINC code. Used for legacy system integration and local terminology management.']
  loinc_number varchar [note: 'The unique LOINC code identifier assigned by Regenstrief Institute. Format: numeric-numeric (e.g., 2345-7). This is the authoritative external identifier for the observation or test.']
  long_common_name varchar [note: 'The full, human-readable display name for the LOINC code. This is the primary display term used in clinical systems and reports.']
  method_type varchar [note: 'The method or technique used to make the observation or measurement (e.g., Electrophoresis, Immunoassay, Microscopy). May be null if method is not specified.']
  order_observation_flag boolean [note: 'Indicates whether this LOINC code is used for ordering tests, recording observations, or both. Order=orderable panel or test, Observation=result only, Both=can be used for ordering and results.']
  panel_type varchar [note: 'Indicates if this LOINC code represents a panel (group of related tests), battery (predefined test group), or set (collection of observations). Null for individual observations.']
  property varchar [note: 'The characteristic or attribute of the analyte being measured (e.g., Mass Concentration, Substance Concentration, Presence, Volume).']
  related_names varchar [note: 'Synonyms, alternate names, or legacy names for this observation. Supports search and mapping from legacy systems.']
  scale_type varchar [note: 'The scale of measurement for the observation result. Qn=Quantitative (numeric), Ord=Ordinal (ranked), Nom=Nominal (named categories), Nar=Narrative (free text), Doc=Document (attached file).']
  short_name varchar [note: 'An abbreviated display name for the LOINC code, used when space is limited in user interfaces or reports.']
  survey_question_source varchar [note: 'The source instrument or questionnaire from which the survey question originates (e.g., PHQ-9, PROMIS, CAHPS).']
  survey_question_text varchar [note: 'For LOINC codes representing survey or assessment questions, this field contains the full question text as presented to the patient or clinician.']
  system varchar [note: 'The specimen or body system from which the observation was made (e.g., Blood, Serum, Urine, Plasma, Cerebrospinal fluid).']
  time_aspect varchar [note: 'The time dimension of the measurement (e.g., Point in time, 24 hour, 8 hour). Indicates whether the observation is a single point measurement or collected over a time interval.']
  updated_timestamp timestamp [note: 'The date and time when this LOINC code record was last modified. Audit trail field.']

  Note: 'Authoritative catalog of LOINC (Logical Observation Identifiers Names and Codes) codes maintained by the Regenstrief Institute. Captures LOINC number, component, property, time aspect, system, scale type, method type, long common name, short name, class, order/observation flag, status, and effective dates. Used to standardize lab results, vital signs, clinical observations, and radiology reports across LIS, RIS, and EHR systems.'
}

Table reference.ndc_drug {
  ndc_drug_id varchar [pk, note: 'Unique identifier for the NDC drug product record in the enterprise data warehouse.']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: NDC drug products are maintained by the FDA with weekly updates to the NDC Directory. The ndc_drug table has ndc_status attribute and marketing_start_date/marketing_end_date that track product lifecyc']
  active_ingredient varchar [note: 'The chemical substance or compound responsible for the therapeutic effect of the drug.']
  application_number varchar [note: 'The FDA application number associated with the drug approval (e.g., NDA number, ANDA number, BLA number).']
  atc_code varchar [note: 'The WHO Anatomical Therapeutic Chemical classification code, used internationally for drug classification.']
  biosimilar_flag boolean [note: 'Indicates whether the drug is a biosimilar product, highly similar to an already-approved biological product.']
  black_box_warning_flag boolean [note: 'Indicates whether the drug carries an FDA black box warning, the strictest warning for serious or life-threatening risks.']
  dea_schedule varchar [note: 'The controlled substance schedule classification assigned by the DEA (CI through CV), indicating the drug\'s potential for abuse and accepted medical use. Empty if not a controlled substance.']
  dosage_form varchar [note: 'The physical form in which the drug is administered (e.g., tablet, capsule, injection, solution, cream, inhaler).']
  effective_date date [note: 'The date on which this NDC drug record became effective in the enterprise reference data system.']
  expiration_date date [note: 'The date on which this NDC drug record is no longer valid or was superseded. Null if currently active.']
  fhir_medication_code varchar [note: 'The standardized medication code used in FHIR MedicationRequest and Medication resources for interoperability.']
  formulary_status varchar [note: 'Indicates whether the drug is included in the organization\'s formulary and any restrictions or preferences applied.']
  gpi_code varchar [note: 'The Medi-Span Generic Product Identifier, a 14-character hierarchical classification code used in pharmacy systems.']
  high_alert_medication_flag boolean [note: 'Indicates whether the drug is classified as a high-alert medication by ISMP, requiring special handling and verification procedures.']
  labeler_name varchar [note: 'The name of the company or entity that manufactures, repackages, or distributes the drug product.']
  marketing_category varchar [note: 'The regulatory pathway under which the drug was approved (e.g., NDA, ANDA, BLA, OTC Monograph).']
  marketing_end_date date [note: 'The date on which the drug product was discontinued or withdrawn from the market. Null if still active.']
  marketing_start_date date [note: 'The date on which the drug product was first marketed or made available for distribution.']
  ndc_code varchar [note: 'The 11-digit National Drug Code assigned by the FDA, uniquely identifying the labeler, product, and package size. Format: 5-4-2 (labeler-product-package).']
  nonproprietary_name varchar [note: 'The generic or non-proprietary name of the drug, typically the active ingredient name established by the United States Adopted Names (USAN) Council.']
  orange_book_code varchar [note: 'The therapeutic equivalence code from the FDA Orange Book, indicating whether a generic drug is therapeutically equivalent to the brand-name drug.']
  over_the_counter_flag boolean [note: 'Indicates whether the drug is available for purchase without a prescription.']
  package_description varchar [note: 'A textual description of the package size and configuration (e.g., bottle of 100 tablets, box of 10 vials).']
  package_quantity decimal(18,4) [note: 'The numeric quantity of units contained in the package.']
  package_unit varchar [note: 'The unit of measure for the package quantity (e.g., tablet, capsule, mL, vial).']
  pregnancy_category varchar [note: 'The FDA pregnancy category classification indicating the risk of fetal harm (A=safest, X=contraindicated, N=not classified). Note: FDA replaced this with narrative labeling in 2015.']
  product_name varchar [note: 'The full product name as registered with the FDA, including strength and dosage form.']
  proprietary_name varchar [note: 'The brand or trade name under which the drug is marketed to consumers and healthcare providers.']
  record_created_timestamp timestamp [note: 'The timestamp when this NDC drug record was first created in the enterprise data warehouse.']
  record_updated_timestamp timestamp [note: 'The timestamp when this NDC drug record was last updated in the enterprise data warehouse.']
  refrigeration_required_flag boolean [note: 'Indicates whether the drug requires refrigerated storage to maintain stability and efficacy.']
  route_of_administration varchar [note: 'The path by which the drug is administered into the body (e.g., oral, intravenous, topical, subcutaneous, intramuscular).']
  rxcui varchar [note: 'The RxNorm Concept Unique Identifier assigned by the National Library of Medicine, providing a normalized drug concept mapping for interoperability.']
  rxnorm_name varchar [note: 'The normalized drug name as defined in RxNorm, representing the clinical drug concept.']
  rxnorm_source_vocabulary varchar [note: 'The source vocabulary from which the RxNorm concept was derived (e.g., RXNORM, VANDF, MMSL, NDDF).']
  rxnorm_suppress_flag boolean [note: 'Indicates whether the RxNorm concept is suppressed from use (N=not suppressed, Y=suppressed, O=obsolete, E=entry term).']
  rxnorm_term_type varchar [note: 'The RxNorm term type classification (e.g., IN for ingredient, BN for brand name, SCD for semantic clinical drug, GPCK for generic pack).']
  snomed_ct_code varchar [note: 'The SNOMED CT concept code representing the drug product or substance for clinical documentation and interoperability.']
  strength varchar [note: 'The concentration or potency of the active ingredient(s) in the drug product, expressed as a numeric value with unit (e.g., 500 mg, 10 mg/mL).']
  strength_unit varchar [note: 'The unit of measure for the drug strength (e.g., mg, mL, mcg, IU, %).']
  therapeutic_class varchar [note: 'The therapeutic or pharmacological classification of the drug (e.g., antibiotic, antihypertensive, analgesic).']
  unii_code varchar [note: 'The FDA Unique Ingredient Identifier code for the active ingredient, used for substance identification.']
  vaccine_flag boolean [note: 'Indicates whether the drug product is a vaccine used for immunization.']

  Note: 'Master catalog of NDC (National Drug Code) drug products as maintained by the FDA, enriched with RxNorm normalized drug concept mappings (RxCUI, term type, ingredient/brand/clinical drug hierarchy) published by the NLM. NDC records capture the 11-digit NDC, labeler name, product name, proprietary and non-proprietary names, dosage form, route of administration, strength, unit, DEA schedule, marketing category, application number, package description, and active/inactive status. RxNorm normalization records capture RxCUI, name, term type (TTY: ingredient, brand name, clinical drug, etc.), source vocabulary, suppress flag, and effective dates, providing the canonical drug terminology layer that maps NDC codes, proprietary names, and generic names to a single clinical drug concept. Consumed by pharmacy, formulary management, MAR, medication reconciliation, FHIR MedicationRequest interoperability, and billing domains.'
}

Table reference.fhir_value_set {
  fhir_value_set_id varchar [pk, note: 'Unique identifier for the FHIR value set record. Primary key.']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: FHIR value sets are versioned by HL7 with release-specific canonical URLs and expansion timestamps. The fhir_value_set table has version (STRING) and status attributes that should be normalized to cod']
  approval_date date [note: 'Date when this value set was formally approved by the governance authority for production use. Required for regulatory compliance and change control.']
  binding_strength varchar [note: 'Defines how strictly FHIR resources must conform to this value set. Required = must use codes from this set only, Extensible = should use but may extend, Preferred = recommended but not enforced, Example = illustrative only.']
  canonical_url varchar [note: 'Globally unique canonical URL that permanently identifies this value set across all FHIR implementations. Used for terminology server lookups and resource references.']
  compose_exclude_count varchar [note: 'Number of exclude rules defined in the value set composition. Exclude rules remove specific concepts from the included set.']
  compose_include_count varchar [note: 'Number of include rules defined in the value set composition. Each include rule specifies a code system and filter criteria for selecting concepts.']
  contact_json varchar [note: 'JSON-encoded contact details for the publisher or steward of this value set, including name, email, phone, and URL. Used for support and governance inquiries.']
  copyright varchar [note: 'Legal copyright and licensing terms governing the use of this value set. Critical for code systems like SNOMED CT, CPT, and ICD-10 that require licensing agreements.']
  created_timestamp timestamp [note: 'Date and time when this value set record was first created in the enterprise terminology repository. Audit trail for data lineage.']
  effective_end_date date [note: 'Date when this value set version is retired and should no longer be used for new data entry. Null indicates the value set is currently active with no planned retirement.']
  effective_start_date date [note: 'Date when this value set version becomes active and available for use in clinical systems. Part of the temporal validity window.']
  expansion_identifier varchar [note: 'Unique identifier for the current expansion of this value set. Changes each time the value set is expanded by a terminology server to reflect the current set of member concepts.']
  expansion_offset varchar [note: 'Paging offset used when the expansion was generated. Supports large value sets that cannot be returned in a single response.']
  expansion_parameter_json varchar [note: 'JSON-encoded parameters used during the expansion operation, such as language, display variant, or active-only filters. Stored as text for auditability.']
  expansion_timestamp timestamp [note: 'Date and time when the value set was last expanded by a terminology server to produce the current list of member concepts. Critical for cache invalidation and version control.']
  expansion_total_concepts varchar [note: 'Total number of coded concepts included in the current expansion of this value set. Used for validation and performance optimization.']
  experimental_flag boolean [note: 'Indicates whether this value set is for testing or experimental purposes and should not be used in production clinical systems. True means not approved for operational use.']
  fhir_element_path varchar [note: 'Specific element path within the FHIR resource where this value set binding applies, using dot notation. Example: Observation.code, Condition.clinicalStatus, Procedure.category.']
  fhir_resource_type varchar [note: 'The FHIR resource type that this value set is bound to, such as Observation, Condition, Procedure, MedicationRequest, or AllergyIntolerance. Indicates where this terminology is applied in clinical workflows.']
  fhir_value_set_description varchar [note: 'Detailed narrative description of the value set purpose, scope, and intended use cases. Provides clinical and business context for terminology consumers.']
  immutable_flag boolean [note: 'Indicates whether the value set definition is immutable and will never change once published. True means the expansion will always produce the same set of codes.']
  jurisdiction_codes varchar [note: 'Comma-separated list of ISO 3166 country codes or jurisdiction identifiers where this value set is intended for use. Examples: USA, CAN, GBR. Supports regional terminology requirements.']
  last_review_date date [note: 'Date when this value set was last reviewed for clinical accuracy and relevance. Used to trigger periodic re-validation cycles per governance policy.']
  modified_timestamp timestamp [note: 'Date and time when this value set record was last updated in the enterprise terminology repository. Supports change tracking and cache invalidation.']
  publisher varchar [note: 'Name of the organization or individual responsible for publishing and maintaining this value set. Examples include HL7, SNOMED International, LOINC, or internal enterprise teams.']
  purpose varchar [note: 'Explanation of why this value set was created and the specific clinical or administrative problem it addresses. Helps users understand appropriate usage scenarios.']
  title varchar [note: 'Human-readable title for the value set displayed in user interfaces and documentation. May contain spaces and special characters.']
  use_context_json varchar [note: 'JSON-encoded array of usage contexts defining when and where this value set should be applied. Includes clinical specialty, care setting, patient demographics, and workflow phase.']
  value_set_name varchar [note: 'Computer-friendly name for the value set, typically used in code generation and system identifiers. Must be alphanumeric without spaces.']
  value_set_oid varchar [note: 'ISO object identifier uniquely identifying this value set in the global OID registry. Format follows ISO/IEC 8824 dotted decimal notation.']

  Note: 'Master catalog of HL7 FHIR value sets, terminology bindings, and their expanded member concepts used across the enterprise for interoperability. Value set header records capture OID, canonical URL, name, title, status, version, publisher, binding strength (required/extensible/preferred/example), FHIR resource type, and effective dates. Member detail records capture the individual coded concepts belonging to each value set: concept system (SNOMED CT, LOINC, ICD-10, CPT, etc.), concept code, display name, designation, include/exclude flag, and effective dates. Supports runtime validation of coded fields in FHIR resources, terminology server $expand operations, and clinical decision support rule evaluation.'
}

Table reference.npi_registry {
  npi_registry_id varchar [pk, note: 'Primary key for npi_registry']
  practice_location_geographic_region_id varchar [note: 'Foreign key linking to reference.geographic_region. Business justification: NPI registry contains practice location addresses with postal codes that should be normalized to geographic_region for ZIP-based analytics (RUCA codes, HSA/HRR assignments, CMS region mapping). The np']
  authorized_official_first_name varchar [note: 'The first name of the authorized official for the organizational provider (Type 2 NPIs only). Used for credentialing verification and organizational accountability.']
  authorized_official_last_name varchar [note: 'The last name of the authorized official who is legally responsible for the organizational provider (Type 2 NPIs only). This individual has authority to bind the organization and attest to the accuracy of NPI application information.']
  authorized_official_middle_name varchar [note: 'The middle name of the authorized official for the organizational provider (Type 2 NPIs only). Optional field for complete identification.']
  authorized_official_telephone_number varchar [note: 'The telephone number of the authorized official for the organizational provider. Used for credentialing verification, attestation confirmation, and regulatory inquiries.']
  authorized_official_title varchar [note: 'The job title or position of the authorized official within the organization (e.g., CEO, CFO, Administrator, President, Medical Director). Used to verify organizational authority and credentialing compliance.']
  deactivation_date date [note: 'The date the NPI was deactivated by the provider or CMS. Indicates the provider is no longer actively using this identifier. Used for claims validation, credentialing status checks, and provider directory management.']
  employer_identification_number varchar [note: 'The IRS Employer Identification Number (EIN) for organizational providers (Type 2 only). Used for tax reporting and organizational identification. Also known as Federal Tax ID.']
  entity_type_code varchar [note: 'Indicates whether the NPI is assigned to an individual provider (Type 1) or an organization (Type 2). Type 1 = Individual healthcare provider (physician, nurse, therapist). Type 2 = Healthcare organization (hospital, clinic, group practice, pharmacy).']
  enumeration_date date [note: 'The date the NPI was originally assigned to the provider by NPPES. Represents the providers initial enrollment in the national provider registry. Critical for credentialing timelines and provider history tracking.']
  last_update_date date [note: 'The date the NPI record was last updated in NPPES. Reflects the most recent change to provider demographic information, address, taxonomy, or other registry data. Used to track data freshness and trigger downstream updates.']
  mailing_address_city varchar [note: 'The city name for the providers mailing address. Used for geographic segmentation and correspondence routing.']
  mailing_address_country_code varchar [note: 'The three-letter ISO country code for the providers mailing address (e.g., USA, CAN, MEX). Used for international provider tracking and cross-border claims.']
  mailing_address_fax_number varchar [note: 'The fax number associated with the providers mailing address. Used for document transmission during credentialing, prior authorization, and claims correspondence.']
  mailing_address_line_1 varchar [note: 'The first line of the providers mailing address (street address, PO Box, or suite number). Used for official correspondence, credentialing documents, and regulatory communications.']
  mailing_address_line_2 varchar [note: 'The second line of the providers mailing address (apartment, suite, building, floor). Optional field for additional address detail.']
  mailing_address_postal_code varchar [note: 'The ZIP code or ZIP+4 code for the providers mailing address. Used for mail delivery, geographic analysis, and service area determination.']
  mailing_address_state varchar [note: 'The two-letter state or territory code for the providers mailing address (e.g., CA, NY, TX). Used for state-level reporting and regulatory compliance.']
  mailing_address_telephone_number varchar [note: 'The telephone number associated with the providers mailing address. Used for provider contact and verification during credentialing and claims inquiries.']
  npi varchar [note: 'The 10-digit National Provider Identifier assigned by CMS NPPES. Unique identifier for healthcare providers in the United States. This is the authoritative business identifier for provider lookup across claims, credentialing, and directory systems.']
  organization_name varchar [note: 'The legal business name of the healthcare organization for Type 2 (organizational) NPIs. Examples: hospital name, clinic name, group practice name, pharmacy name.']
  organization_other_name varchar [note: 'Alternate name, trade name, or doing-business-as (DBA) name for the healthcare organization. Used when the organization operates under a name different from its legal name.']
  practice_location_address_country_code varchar [note: 'The three-letter ISO country code for the providers practice location (e.g., USA, CAN, MEX). Used for international provider tracking and cross-border service delivery.']
  practice_location_address_line_1 varchar [note: 'The first line of the providers primary practice location address (street address, suite number). This is the physical location where the provider sees patients or delivers services. Used for provider directories, patient navigation, and service area mapping.']
  practice_location_address_line_2 varchar [note: 'The second line of the providers practice location address (apartment, suite, building, floor). Optional field for additional address detail.']
  practice_location_fax_number varchar [note: 'The fax number for the providers practice location. Used for medical records transmission, referral coordination, and prior authorization requests.']
  practice_location_telephone_number varchar [note: 'The telephone number for the providers practice location. Used for patient appointment scheduling, provider directory listings, and referral coordination.']
  primary_taxonomy_code varchar [note: 'The primary NUCC Health Care Provider Taxonomy code assigned to this NPI. A 10-digit alphanumeric code that classifies the providers type, classification, and specialization (e.g., 207Q00000X = Family Medicine, 208D00000X = General Practice). This is the providers main specialty for claims submission and network assignment.']
  primary_taxonomy_switch varchar [note: 'Indicates whether the taxonomy code is designated as the providers primary taxonomy. Y = Yes (primary), N = No (secondary). Used to distinguish the main specialty from additional specialties for claims routing and network credentialing.']
  provider_credential varchar [note: 'The professional credential or designation of the individual provider (e.g., MD, DO, RN, DDS, PharmD, PhD, LCSW). Indicates the providers professional qualifications and licensure type.']
  provider_first_name varchar [note: 'The legal first name (given name) of the individual healthcare provider for Type 1 NPIs. Used for provider identification, credentialing, and claims submission.']
  provider_gender_code varchar [note: 'The gender of the individual provider for Type 1 NPIs. M = Male, F = Female. Used for provider demographic reporting and patient preference matching.']
  provider_last_name varchar [note: 'The legal last name (family name or surname) of the individual healthcare provider for Type 1 NPIs. Used for provider identification, credentialing, and claims submission.']
  provider_middle_name varchar [note: 'The middle name of the individual healthcare provider for Type 1 NPIs. Optional field used for complete provider identification.']
  provider_name_prefix varchar [note: 'The name prefix or title for the individual provider (e.g., Dr., Mr., Ms., Rev.). Used for formal provider identification and correspondence.']
  provider_name_suffix varchar [note: 'The name suffix for the individual provider (e.g., Jr., Sr., II, III). Used for complete provider identification and to distinguish between providers with similar names.']
  provider_other_credential varchar [note: 'An alternate or additional professional credential for the individual provider. Used when a provider holds multiple credentials or has changed credentials.']
  provider_other_first_name varchar [note: 'An alternate or previous first name for the individual provider. Used to track provider name changes and maintain historical continuity.']
  provider_other_last_name varchar [note: 'An alternate or previous last name for the individual provider (e.g., maiden name, former married name). Used to track provider name changes and maintain historical continuity.']
  provider_other_middle_name varchar [note: 'An alternate or previous middle name for the individual provider. Used to track provider name changes and maintain historical continuity.']
  provider_other_name_prefix varchar [note: 'An alternate name prefix for the individual provider. Used to track provider name changes.']
  provider_other_name_suffix varchar [note: 'An alternate name suffix for the individual provider. Used to track provider name changes.']
  reactivation_date date [note: 'The date a previously deactivated NPI was reactivated. Indicates the provider has resumed use of this identifier. Used to track provider status changes and maintain accurate active provider lists.']
  replacement_npi varchar [note: 'The NPI that has replaced this NPI if the provider has been assigned a new identifier. Used to track provider identifier changes and maintain continuity in claims and credentialing systems.']

  Note: 'Enterprise copy of the CMS National Plan and Provider Enumeration System (NPPES) NPI registry, enriched with NUCC Health Care Provider Taxonomy code classifications. NPI records capture NPI number, entity type (individual Type 1/organization Type 2), provider name, credential, gender, enumeration date, last update date, deactivation date, reactivation date, mailing and practice addresses, phone, fax, and authorized official information. Taxonomy classification records capture taxonomy code, provider type, classification, specialization, definition, and effective dates for each NPI\'s primary and secondary taxonomy assignments. Serves as the authoritative NPI and provider taxonomy lookup for claims submission, credentialing, payer enrollment, and provider directory across all domains. Note: this is the enterprise reference copy; provider domain owns the operational provider record.'
}

Table reference.geographic_region {
  geographic_region_id varchar [pk, note: 'Unique identifier for the geographic region entity. Primary key.']
  parent_region_geographic_region_id varchar [note: 'Reference to the parent geographic region in the hierarchy (e.g., a ZIP code\'s parent county, a county\'s parent state). Null for top-level regions (e.g., country).']
  aco_service_area_flag boolean [note: 'Indicates whether this region is part of an ACO service area. True if the region is included in one or more ACO service territories; false otherwise. Used for value-based care program eligibility and population attribution.']
  cbsa_code varchar [note: 'The U.S. Census Bureau Core-Based Statistical Area code. Used for metropolitan and micropolitan statistical area analysis, market segmentation, and payer contracting territories.']
  cbsa_name varchar [note: 'The human-readable name of the CBSA (e.g., \'New York-Newark-Jersey City, NY-NJ-PA\'). Null for non-CBSA region types.']
  census_division varchar [note: 'The U.S. Census Bureau division classification, a finer granularity than census_region. Values: new_england, middle_atlantic, east_north_central, west_north_central, south_atlantic, east_south_central, west_south_central, mountain, pacific. [ENUM-REF-CANDIDATE: new_england|middle_atlantic|east_north_central|west_north_central|south_atlantic|east_south_central|west_south_central|mountain|pacific — 9 candidates stripped; promote to reference product]']
  census_region varchar [note: 'The U.S. Census Bureau region classification: northeast, midwest, south, west. Used for demographic and statistical analysis.']
  cms_region_number varchar [note: 'The CMS administrative region number (1-10). Used for regulatory reporting, Quality Payment Program (QPP) reporting, and CMS regional office alignment.']
  country_code varchar [note: 'The ISO 3166-1 alpha-3 country code (e.g., USA, CAN, MEX). Used for international patient populations and cross-border care coordination.']
  effective_end_date date [note: 'The date through which this geographic region record is effective. Null for currently active regions. Used for temporal validity and historical analysis of region definitions.']
  effective_start_date date [note: 'The date from which this geographic region record is effective. Used for temporal validity and historical analysis of region definitions (e.g., ZIP code boundary changes, CBSA redefinitions).']
  fips_code varchar [note: 'The Federal Information Processing Standards code for this region. Used for counties (5-digit) and states (2-digit). Null for non-FIPS region types.']
  hrr_code varchar [note: 'The CMS Hospital Referral Region code representing a regional health care market for tertiary medical care. Used for population health management, quality benchmarking, and regional variation analysis.']
  hsa_code varchar [note: 'The CMS Hospital Service Area code representing a collection of ZIP codes whose residents receive most of their hospitalizations from the hospitals in that area. Used for facility service area definitions and market share analysis.']
  is_active boolean [note: 'Indicates whether this geographic region record is currently active and valid for use. True if active; false if retired or superseded. Used for address validation and operational reporting.']
  last_updated_timestamp timestamp [note: 'The timestamp when this geographic region record was last updated in the data platform. Used for data lineage, change tracking, and audit purposes.']
  latitude decimal(10,7) [note: 'The geographic latitude coordinate (decimal degrees) representing the centroid or representative point of the region. Used for mapping, distance calculations, and geospatial analysis.']
  longitude decimal(10,7) [note: 'The geographic longitude coordinate (decimal degrees) representing the centroid or representative point of the region. Used for mapping, distance calculations, and geospatial analysis.']
  median_household_income decimal(12,2) [note: 'The median household income (in USD) for this region, sourced from U.S. Census or American Community Survey data. Used for Social Determinants of Health (SDOH) analysis, financial assistance program eligibility, and health equity reporting.']
  population_estimate varchar [note: 'The estimated total population residing in this geographic region, sourced from the most recent U.S. Census or American Community Survey data. Used for population health stratification, capacity planning, and per-capita rate calculations.']
  poverty_rate_percent decimal(5,2) [note: 'The percentage of the population living below the federal poverty line in this region. Used for SDOH analysis, charity care program targeting, and community health needs assessments.']
  region_code varchar [note: 'The standardized code representing this geographic region (e.g., ZIP code, FIPS code, CBSA code, HSA code, HRR code, state abbreviation). Format and length vary by region_type.']
  region_name varchar [note: 'The human-readable name of the geographic region (e.g., city name for ZIP, county name, CBSA name, state name).']
  region_type varchar [note: 'Discriminator indicating the type of geographic region: zip_code (5-digit ZIP), county, state, cbsa (Core-Based Statistical Area), hsa (Hospital Service Area), hrr (Hospital Referral Region), cms_region (CMS administrative region), aco_service_area (Accountable Care Organization service area), zcta (ZIP Code Tabulation Area), country. [ENUM-REF-CANDIDATE: zip_code|county|state|cbsa|hsa|hrr|cms_region|aco_service_area|zcta|country — 10 candidates stripped; promote to reference product]']
  ruca_code varchar [note: 'The Rural-Urban Commuting Area code classifying the region by urbanization and commuting patterns. Used for population health stratification and Social Determinants of Health (SDOH) analysis.']
  state_abbreviation varchar [note: 'The two-letter U.S. state abbreviation (e.g., CA, NY, TX). Populated for U.S. regions; null for non-U.S. or non-state region types.']
  time_zone varchar [note: 'The IANA time zone identifier for this region (e.g., America/New_York, America/Chicago). Used for scheduling, appointment management, and operational reporting across multiple facilities.']
  uninsured_rate_percent decimal(5,2) [note: 'The percentage of the population without health insurance coverage in this region. Used for access-to-care analysis, payer mix forecasting, and community benefit program planning.']
  urban_rural_classification varchar [note: 'High-level classification of the region as urban, suburban, rural, or frontier. Derived from RUCA codes or other urbanization metrics. Used for access-to-care analysis and health equity reporting.']

  Note: 'Master catalog of all geographic reference entities used across the enterprise, including ZIP codes (with city, county, FIPS, latitude/longitude, RUCA urban/rural classification), states, counties, CBSA (Core-Based Statistical Area), HSA (Hospital Service Area), HRR (Hospital Referral Region), CMS regions, ACO service areas, and ZCTA (ZIP Code Tabulation Area). Each record captures region code, name, type discriminator, parent region, FIPS code, census region, latitude/longitude (for point-level types), urban/rural classification, time zone, demographic enrichment fields, and effective dates. Used for patient address validation, population health stratification, payer contracting territories, facility service area definitions, SDOH analysis, geographic rating, and regulatory reporting.'
}

Table reference.condition_code {
  condition_code_id varchar [pk, note: 'Unique identifier for the condition code record. Primary key.']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: UB-04 condition codes and occurrence codes are maintained by NUBC with periodic updates. The condition_code table has status attribute and effective_date/termination_date that track code lifecycle. Ad']
  ama_indicator boolean [note: 'For discharge disposition codes, indicates whether the disposition represents a discharge against medical advice.']
  bilateral_indicator boolean [note: 'For CPT/HCPCS modifier codes, indicates whether the modifier designates a bilateral procedure (e.g., modifier 50).']
  claim_form_type varchar [note: 'Identifies which claim form(s) this code is applicable to: UB-04 for facility claims, CMS-1500 for professional claims, or BOTH for codes used across both forms.']
  code_type varchar [note: 'Discriminator identifying the specific code set category. Consumers filter by this field to retrieve the appropriate code set for their use case. [ENUM-REF-CANDIDATE: condition_code|occurrence_code|occurrence_span_code|value_code|admit_source|discharge_disposition|pos_code|revenue_code|modifier_code — 9 candidates stripped; promote to reference product]']
  commercial_payer_flag boolean [note: 'Indicates whether this code is commonly accepted by commercial insurance payers for claims adjudication.']
  condition_code_category varchar [note: 'Logical grouping or category for the code within its code_type. Examples: \'Patient Status\' for certain condition codes, \'Facility Services\' for revenue codes, \'Anatomical Modifiers\' for CPT modifiers.']
  condition_code_code varchar [note: 'The standardized alphanumeric code value as defined by NUBC, CMS, or AMA. Examples: \'01\' for condition code, \'A1\' for occurrence code, \'01\' for revenue code, \'LT\' for modifier code.']
  condition_code_description varchar [note: 'Full business description of the code explaining its meaning and usage context. Example: \'Patient is homeless\' for condition code 60.']
  effective_date date [note: 'The date on which this code became valid and available for use on claims. Format: yyyy-MM-dd.']
  expired_indicator boolean [note: 'For discharge disposition codes, indicates whether the disposition represents patient death (expired).']
  facility_indicator boolean [note: 'Flag indicating whether this code is applicable to facility (institutional) claims. True for codes used in hospital, SNF, hospice, and other facility settings.']
  governing_body varchar [note: 'The authoritative organization responsible for defining and maintaining this code set. NUBC for UB-04 codes, CMS for Medicare codes, AMA for CPT codes, STATE for state-specific codes.']
  hospice_indicator boolean [note: 'For discharge disposition codes, indicates whether the disposition represents a hospice discharge (home hospice or hospice facility).']
  last_updated_date date [note: 'The date when this code record was last modified in the reference system. Used for change tracking and data synchronization. Format: yyyy-MM-dd.']
  medicaid_approved_flag boolean [note: 'Indicates whether this code is recognized and accepted by Medicaid programs for claims processing and reimbursement.']
  medicare_approved_flag boolean [note: 'Indicates whether this code is recognized and accepted by Medicare for claims processing and reimbursement.']
  pricing_impact_flag boolean [note: 'Indicates whether this code affects reimbursement calculation, DRG assignment, or payment adjustment. True for codes that trigger pricing logic in claims adjudication.']
  professional_indicator boolean [note: 'Flag indicating whether this code is applicable to professional (physician) claims submitted on CMS-1500 forms.']
  replacement_code varchar [note: 'For deprecated or inactive codes, the new code value that should be used instead. Null if no direct replacement exists.']
  requires_value_flag boolean [note: 'For value codes and occurrence codes, indicates whether the code must be accompanied by a numeric value or date on the claim form.']
  short_description varchar [note: 'Abbreviated description for display in constrained UI contexts and reports. Typically 30-50 characters.']
  telehealth_eligible_flag boolean [note: 'For place of service (POS) codes, indicates whether the location is eligible for telehealth service delivery and reimbursement.']
  termination_date date [note: 'The date on which this code was retired or became invalid for use on claims. Null if the code is currently active. Format: yyyy-MM-dd.']
  ub04_form_locator varchar [note: 'The specific field location on the UB-04 claim form where this code appears. Examples: \'FL 18-28\' for condition codes, \'FL 31-36\' for occurrence codes, \'FL 39-41\' for value codes, \'FL 42\' for revenue codes.']
  usage_notes varchar [note: 'Additional guidance, constraints, or special instructions for proper use of this code on claims. May include payer-specific requirements or coding scenarios.']

  Note: 'Consolidated reference catalog of standardized billing form codes used across UB-04 facility claims and CMS-1500 professional claims. Encompasses condition codes (FL 18-28), occurrence codes (FL 31-36), occurrence span codes, value codes (FL 39-41), admit source codes, discharge disposition codes, place of service (POS) codes, revenue codes, and CPT/HCPCS modifier codes. Each record captures the code, code_type discriminator (condition_code, occurrence_code, value_code, admit_source, discharge_disposition, pos_code, revenue_code, modifier_code), description, applicable claim form (UB-04/CMS-1500), category, associated flags (facility indicator, pricing impact, hospice/AMA/expired indicators for dispositions, telehealth eligibility for POS, bilateral indicator for modifiers), and effective/termination dates. Provides a single authoritative lookup for all standardized billing form code sets governed by NUBC, CMS, and AMA guidelines. Consumers filter by code_type to retrieve the specific code set needed.'
}

Table reference.code_set_version {
  code_set_version_id varchar [pk, note: 'Unique identifier for the code set version record. Primary key.']
  superseded_by_version_code_set_version_id varchar [note: 'Reference to the code_set_version_id of the newer version that replaces this one. Nullable if this is the current active version.']
  checksum_algorithm varchar [note: 'The cryptographic hash algorithm used to generate the file_hash for integrity verification: MD5, SHA256, or SHA512.']
  code_set_name varchar [note: 'The name of the reference code set (e.g., ICD-10-CM, CPT, HCPCS, SNOMED CT, LOINC, NDC, RxNorm, DRG Grouper, HL7 Value Set, FHIR Value Set).']
  code_set_type varchar [note: 'The functional category of the code set: diagnosis (ICD-10), procedure (CPT/HCPCS), drug (NDC/RxNorm), observation (LOINC), terminology (SNOMED CT), or grouper (DRG/APR-DRG).']
  compliance_year varchar [note: 'The fiscal or calendar year for which this code set version is required for regulatory compliance and reimbursement (e.g., 2024 for FY2024 ICD-10-CM).']
  copyright_notice varchar [note: 'Legal copyright and licensing information for this code set version, including usage restrictions and attribution requirements.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code indicating the jurisdiction or country-specific variant of this code set (e.g., USA for ICD-10-CM, CAN for ICD-10-CA).']
  created_timestamp timestamp [note: 'The date and time when this code set version record was first created in the enterprise reference data repository.']
  download_timestamp timestamp [note: 'The date and time when this code set version file was downloaded from the source authority.']
  effective_date date [note: 'The date on which this code set version becomes valid and available for use in clinical documentation, billing, and reporting.']
  file_hash varchar [note: 'Cryptographic hash (SHA-256 or MD5) of the source file, used to verify data integrity and detect unauthorized modifications.']
  file_name varchar [note: 'The name of the source file or package containing this code set version (e.g., icd10cm_tabular_2024.xml, cpt_codes_2024.csv).']
  format_type varchar [note: 'The file format or data structure of the source code set: csv (comma-separated values), xml (extensible markup language), json (JavaScript object notation), fhir (FHIR CodeSystem resource), hl7 (HL7 v2 table), proprietary (vendor-specific format).']
  is_hipaa_compliant boolean [note: 'Indicates whether this code set version meets HIPAA transaction and code set standards for electronic healthcare transactions.']
  language_code varchar [note: 'ISO 639-1 two-letter language code indicating the language of the code set descriptions and labels (e.g., en for English, es for Spanish).']
  last_updated_timestamp timestamp [note: 'The date and time when this code set version record was last modified in the enterprise reference data repository.']
  license_type varchar [note: 'The licensing model governing the use of this code set: public_domain (freely available), proprietary (commercial license required), open_source (open license with attribution), restricted (limited use agreement).']
  load_status varchar [note: 'The current status of the ETL process for loading this code set version into the enterprise data platform: pending (queued), in_progress (loading), completed (successfully loaded), failed (load error), validated (post-load quality checks passed).']
  load_timestamp timestamp [note: 'The date and time when this code set version was successfully loaded into the enterprise reference data repository.']
  publication_date date [note: 'The official date on which the source authority published or released this code set version.']
  record_count varchar [note: 'The total number of individual codes or entries contained in this code set version.']
  release_notes varchar [note: 'Summary of changes, additions, deletions, and updates included in this code set version compared to the previous version.']
  source_authority varchar [note: 'The governing body or organization that publishes and maintains this code set (e.g., WHO, AMA, CMS, SNOMED International, Regenstrief Institute, FDA, NLM).']
  source_url varchar [note: 'The official download or reference URL from which this code set version was obtained.']
  termination_date date [note: 'The date on which this code set version is no longer valid for new transactions. Nullable for versions that remain active indefinitely.']
  usage_scope varchar [note: 'The primary business domain(s) for which this code set version is intended: clinical (EHR documentation), billing (claims and revenue cycle), research (clinical trials and studies), quality (HEDIS/quality reporting), or all (enterprise-wide).']
  validation_status varchar [note: 'The outcome of post-load data quality validation: not_validated (validation not yet performed), passed (all quality checks passed), failed (critical validation errors detected), warning (non-critical issues identified).']
  validation_timestamp timestamp [note: 'The date and time when data quality validation was performed on this code set version.']
  version_identifier varchar [note: 'The official version number or release identifier assigned by the source authority (e.g., 2024, v3.5, FY2024, 20240101).']
  version_status varchar [note: 'Current lifecycle status of this code set version: draft (not yet effective), active (currently in use), superseded (replaced by newer version), retired (no longer valid), deprecated (scheduled for retirement).']

  Note: 'Lifecycle and version tracking for all enterprise reference code sets (ICD-10, CPT, HCPCS, SNOMED CT, LOINC, NDC, RxNorm, DRG grouper, etc.). Each record captures code set name, version identifier, effective date, termination date, source authority, download URL, file hash, record count, load status, load timestamp, and superseded-by reference. Enables audit of which code set version was active at any point in time, supporting retrospective claims adjudication, regulatory compliance, and reproducible terminology expansion for FHIR value sets.'
}

Table reference.crosswalk {
  crosswalk_id varchar [pk, note: 'Unique identifier for the terminology crosswalk mapping record.']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: Crosswalk mappings are version-specific - ICD-10-CM to SNOMED CT mappings change with each release of both terminologies. The crosswalk table has source_code_system_version (STRING), target_code_syste']
  approximate_flag boolean [note: 'Indicates whether the mapping is an approximate or inexact match (True) requiring clinical review, or an exact semantic match (False).']
  choice_list_indicator varchar [note: 'Indicates whether the target code is one of multiple valid choices for the source code, requiring clinical judgment to select the most appropriate target.']
  combination_flag boolean [note: 'Indicates whether this mapping requires multiple target codes to fully represent the source code (True) or is a single 1:1 or 1:0 mapping (False).']
  created_timestamp timestamp [note: 'The date and time when this crosswalk mapping record was first created in the system.']
  directionality varchar [note: 'Indicates whether the mapping is valid in one direction (forward: source to target only, backward: target to source only) or both directions (bidirectional).']
  effective_date date [note: 'The date on which this crosswalk mapping becomes valid and available for use.']
  last_validated_date date [note: 'The most recent date on which this mapping was reviewed and validated by clinical or coding subject matter experts.']
  map_group varchar [note: 'Grouping identifier for related mappings that should be considered together (e.g., all mappings for a specific clinical domain or use case).']
  map_priority varchar [note: 'Numeric ranking indicating the preferred order when multiple target codes are valid for a single source code (lower numbers indicate higher priority).']
  mapping_authority varchar [note: 'The authoritative source or organization that published or validated this mapping (e.g., CMS, NLM, SNOMED International, Regenstrief Institute, internal clinical terminology team).']
  mapping_purpose varchar [note: 'The intended use case or business purpose for this mapping (e.g., claims submission, clinical documentation, quality reporting, SDOH screening, interoperability, legacy system migration).']
  mapping_quality varchar [note: 'The confidence or precision level of the mapping: exact (perfect semantic match), high (strong clinical equivalence), moderate (acceptable with context), low (weak or conditional match).']
  mapping_rule varchar [note: 'Textual description of any conditional logic, clinical context, or business rules that govern when and how this mapping should be applied.']
  mapping_type varchar [note: 'The semantic relationship between source and target codes: equivalent (1:1 exact match), broader (source is more specific than target), narrower (source is more general than target), related (associated but not hierarchical), inexact (approximate match), unmatched (no suitable target).']
  no_map_flag boolean [note: 'Indicates whether the source code has no suitable equivalent in the target code system (True) or a valid mapping exists (False).']
  notes varchar [note: 'Free-text field for additional context, clinical guidance, or special instructions related to this mapping.']
  scenario_flag boolean [note: 'Identifies specific clinical or billing scenarios where this mapping applies (e.g., inpatient vs outpatient, primary vs secondary diagnosis).']
  source_code varchar [note: 'The specific code value in the source code system being mapped from (e.g., E11.9 for ICD-10, 73211009 for SNOMED CT).']
  source_code_display varchar [note: 'Human-readable display text or description for the source code.']
  source_code_system varchar [note: 'The originating terminology or code system from which the mapping is derived (e.g., ICD-10-CM, SNOMED CT, CPT, LOINC, NDC, RxNorm).']
  target_code varchar [note: 'The specific code value in the target code system being mapped to (e.g., 73211009 for SNOMED CT, 99213 for CPT).']
  target_code_display varchar [note: 'Human-readable display text or description for the target code.']
  target_code_system varchar [note: 'The destination terminology or code system to which the mapping is made (e.g., ICD-10-CM, SNOMED CT, CPT, LOINC, NDC, RxNorm).']
  termination_date date [note: 'The date on which this crosswalk mapping is no longer valid or has been superseded. Null indicates the mapping is still active.']
  updated_timestamp timestamp [note: 'The date and time when this crosswalk mapping record was last modified.']
  usage_count varchar [note: 'The number of times this crosswalk mapping has been applied in production systems, used for mapping quality assessment and optimization.']
  validated_by varchar [note: 'The name or identifier of the clinical or coding expert who last validated this mapping.']

  Note: 'Enterprise terminology crosswalk and mapping table maintaining authoritative code-to-code translations between clinical and billing code systems. Each mapping record captures source code system, source code, target code system, target code, mapping type (equivalent, broader, narrower, related), mapping quality (exact, inexact), directionality, source and target code_set_version references, effective and termination dates, and source authority. Covers ICD-9→ICD-10 GEMs, SNOMED CT→ICD-10 maps, NDC→RxNorm, CPT→SNOMED procedure maps, LOINC→SNOMED observation maps, and SDOH code mappings (ICD-10-Z↔SNOMED↔LOINC SDOH panels). Essential for claims migration, clinical-to-billing translation, SDOH reporting, and cross-system interoperability.'
}

Table reference.major_diagnostic_category {
  major_diagnostic_category_id varchar [pk, note: 'Primary key for major_diagnostic_category']
  parent_major_diagnostic_category_id varchar [note: 'Self-referencing FK on major_diagnostic_category (parent_major_diagnostic_category_id)']
  average_length_of_stay_days decimal(6,2) [note: 'National average length of stay in days for cases grouped to this MDC. Used for benchmarking and utilization management.']
  body_system varchar [note: 'Primary anatomical body system or organ system associated with this MDC (e.g., \'Cardiovascular\', \'Respiratory\', \'Musculoskeletal\').']
  case_volume_rank varchar [note: 'National ranking of this MDC by case volume (1 = highest volume). Used for prioritization and resource planning.']
  classification_type varchar [note: 'Type of classification logic used for this MDC: organ_system (anatomical), procedure_based (surgical/procedural), condition_based (disease-focused), or special_category (pre-MDC, ungroupable).']
  clinical_notes varchar [note: 'Additional clinical context, coding guidance, or special considerations for this MDC. Used by HIM and coding staff.']
  complication_comorbidity_logic varchar [note: 'Type of CC/MCC logic applied within this MDC: standard (uses CC/MCC lists), modified (custom logic), or not_applicable (no CC partitioning).']
  drg_count varchar [note: 'Total number of DRGs contained within this MDC. Used for reference and validation.']
  effective_date date [note: 'Date when this MDC definition became effective for use in DRG grouping and reimbursement.']
  fiscal_year varchar [note: 'Federal fiscal year for which this MDC definition applies (e.g., 2024). CMS updates MDC definitions annually.']
  icd_10_cm_range_end varchar [note: 'Ending ICD-10-CM diagnosis code that maps to this MDC (e.g., \'G99\'). Used for grouper logic.']
  icd_10_cm_range_start varchar [note: 'Starting ICD-10-CM diagnosis code that maps to this MDC (e.g., \'G00\'). Used for grouper logic.']
  icd_10_pcs_range_end varchar [note: 'Ending ICD-10-PCS procedure code that maps to this MDC. Used for surgical partition assignment.']
  icd_10_pcs_range_start varchar [note: 'Starting ICD-10-PCS procedure code that maps to this MDC. Used for surgical partition assignment.']
  is_active boolean [note: 'Indicates whether this MDC is currently active and available for use in DRG grouping. False for historical or deprecated MDCs.']
  last_updated_date date [note: 'Date when this MDC record was last modified in the reference data system. Used for change tracking and audit.']
  major_diagnostic_category_description varchar [note: 'Detailed clinical and administrative description of the MDC scope, including typical diagnoses, procedures, and patient populations covered.']
  major_diagnostic_category_name varchar [note: 'Full descriptive name of the major diagnostic category (e.g., \'Diseases and Disorders of the Nervous System\').']
  major_diagnostic_category_status varchar [note: 'Current lifecycle status of this MDC in the reference system. Active MDCs are used in current grouper logic.']
  mdc_code varchar [note: 'Standard MDC code used in DRG grouping (e.g., MDC01, MDC02). This is the externally-known unique identifier for the category.']
  mdc_number varchar [note: 'Numeric representation of the MDC (1-25). Used for sorting and grouping logic.']
  pre_mdc_indicator boolean [note: 'Indicates whether this is a pre-MDC assignment (e.g., transplants, tracheostomy, ECMO) that bypasses standard MDC logic. True for special high-resource cases.']
  reimbursement_impact_level varchar [note: 'Relative financial impact of this MDC on hospital reimbursement: high (high-cost, high-volume), medium, or low.']
  relative_weight_average decimal(10,4) [note: 'Average relative weight of all DRGs within this MDC. Used for cost and resource intensity analysis.']
  short_name varchar [note: 'Abbreviated name for display and reporting purposes (e.g., \'Nervous System\').']
  surgical_medical_partition varchar [note: 'Indicates whether this MDC contains surgical DRGs, medical DRGs, or both. Not applicable for pre-MDC categories.']
  termination_date date [note: 'Date when this MDC definition was retired or superseded. Null for currently active MDCs.']
  ungroupable_indicator boolean [note: 'Indicates whether this MDC represents ungroupable cases that do not fit standard classification logic. True for error DRGs.']
  version varchar [note: 'Version identifier for this MDC definition (e.g., \'FY2024\', \'v41.0\'). Tracks annual updates to grouper logic.']

  Note: 'Master reference table for major_diagnostic_category. Referenced by mdc_id.'
}

Table reference.readme_databricks_section {
  readme_databricks_section_id varchar [pk, note: 'Primary key for readme_databricks_section']
  output_format_readme_id varchar [note: 'Foreign key linking to reference.output_format_readme. Business justification: The Databricks deployment guide section (Unity Catalog tags, RLS predicates, Delta table properties, HIPAA retention) is a section WITHIN the human-readable README output. README is the parent artifac']

  Note: 'Databricks deployment guide section covering Unity Catalog tag definitions, RLS predicate examples, Delta table property recommendations, and HIPAA data retention annotations.'
}

Table reference.output_format_readme {
  output_format_readme_id varchar [pk, note: 'Primary key for output_format_readme']

  Note: 'README representation of the model for downstream consumption.'
}

Table reference.sdoh_zcode_mapping {
  sdoh_zcode_mapping_id varchar [pk, note: 'Primary key for sdoh_zcode_mapping']
  snomed_concept_id varchar [note: 'The mapped SNOMED CT clinical concept identifier representing the equivalent social risk concept, enabling cross-terminology interoperability.']
  billable_indicator boolean [note: 'Flag indicating whether the Z-code is a valid billable/reimbursable diagnosis code for claims submission.']
  code_system varchar [note: 'The terminology code system from which the Z-code originates, supporting multi-system terminology governance.']
  code_system_version varchar [note: 'The version or release year of the source code system in which this code is valid (e.g., the ICD-10-CM fiscal year edition).']
  data_collection_method varchar [note: 'The method by which the social determinant is typically captured, informing data provenance and reliability.']
  effective_date date [note: 'The date on which this Z-code mapping becomes valid and available for use in clinical and billing workflows.']
  gravity_code varchar [note: 'The Gravity Project standardized SDOH terminology code corresponding to this social risk factor.']
  hcc_relevant_indicator boolean [note: 'Flag indicating whether the code is relevant to CMS Hierarchical Condition Category risk-adjustment models for value-based care reporting.']
  intervention_category varchar [note: 'The category of social care intervention or referral typically associated with this social risk factor (e.g., community resource referral, case management).']
  loinc_screening_code varchar [note: 'The LOINC code for the SDOH screening question or observation panel that maps to this Z-code, linking screening results to coded diagnoses.']
  mapping_confidence varchar [note: 'The equivalence/confidence rating of the crosswalk between the Z-code and its mapped SNOMED/LOINC concept, following standard map-correlation semantics.']
  notes varchar [note: 'Free-text curation and usage guidance notes documenting rationale, caveats, or interpretation guidance for this mapping.']
  reportable_to_program varchar [note: 'Identifies the quality, value-based, or population-health program to which documentation of this code is reportable (e.g., CMS Accountable Health Communities measures).']
  risk_type varchar [note: 'Indicates whether the mapped code represents an identified social risk, a self-reported social need, or a protective factor for population-health segmentation.']
  screening_tool_name varchar [note: 'The name of the standardized SDOH screening instrument that surfaces this factor (e.g., PRAPARE, AHC HRSN screening tool).']
  sdoh_domain varchar [note: 'The social determinant of health domain this code belongs to (e.g., housing instability, food insecurity, transportation, employment, education, social isolation, financial strain). [ENUM-REF-CANDIDATE: housing_instability|food_insecurity|transportation|employment|education|social_isolation|financial_strain|interpersonal_safety|utilities — promote to reference product]']
  sdoh_subcategory varchar [note: 'More granular classification within the SDOH domain that further specifies the social risk factor captured by the code.']
  sdoh_zcode_mapping_status varchar [note: 'Current lifecycle status of this Z-code mapping entry within the reference data governance process.']
  severity_level varchar [note: 'The clinical severity or acuity level associated with the social determinant when documented, supporting risk stratification.']
  source_authority varchar [note: 'The governing body or publishing authority that maintains the authoritative definition of this code (e.g., CMS/NCHS, SNOMED International).']
  termination_date date [note: 'The date on which this Z-code mapping is retired or no longer valid for use; null for currently active mappings.']
  zcode varchar [note: 'The ICD-10-CM Z-code (Z55-Z65 family) used to capture a social determinant of health factor, such as Z59.0 (Homelessness) or Z59.4 (Lack of adequate food).']
  zcode_description varchar [note: 'The official full clinical description of the ICD-10-CM Z-code as published in the code set.']
  zcode_short_description varchar [note: 'Abbreviated description of the Z-code suitable for screen display and reporting headers.']

  Note: 'Master reference table for sdoh_zcode_mapping. Referenced by sdoh_zcode_mapping_id.'
}

Table compliance.compliance_program {
  compliance_program_id varchar [pk, note: 'Unique identifier for the compliance program.']
  budget_id varchar [note: 'Link to the budget allocated for this compliance program.']
  parent_compliance_program_id varchar [note: 'Self-referential link to parent compliance program.']
  quality_program_id varchar
  accreditation_expiration_date decimal(9,4) [note: 'Date when program accreditation expires.']
  accreditation_status varchar [note: 'Current accreditation status of the program.']
  audit_frequency varchar [note: 'How often the program is audited (e.g., annually, quarterly).']
  charter_document varchar [note: 'Reference to the program charter document.']
  contact_email varchar [note: 'Email contact for the compliance program.']
  contact_phone varchar [note: 'Phone contact for the compliance program.']
  created_timestamp timestamp [note: 'When the program record was created.']
  effective_date date [note: 'Date when the program becomes effective.']
  expiration_date decimal(9,4) [note: 'Date when the program expires.']
  external_auditor_name varchar [note: 'Name of the external auditor for the program.']
  governing_body varchar [note: 'Regulatory or governing body overseeing the program.']
  last_audit_date date [note: 'Date of the most recent audit.']
  last_audit_result varchar [note: 'Outcome of the most recent audit.']
  last_review_date date [note: 'Date of the most recent program review.']
  mandatory_flag boolean [note: 'Indicates if the program is mandatory.']
  merged_with_quality_quality_program varchar
  modified_by varchar [note: 'User who last modified the program record.']
  modified_timestamp timestamp [note: 'When the program record was last modified.']
  next_audit_date date [note: 'Scheduled date for the next audit.']
  next_review_date date [note: 'Scheduled date for the next program review.']
  notes varchar [note: 'Additional notes about the compliance program.']
  objectives varchar [note: 'Objectives of the compliance program.']
  penalty_exposure_amount decimal(15,2) [note: 'Potential financial penalty exposure for non-compliance.']
  policy_count varchar [note: 'Number of policies associated with the program.']
  program_code varchar [note: 'Unique code identifying the compliance program.']
  program_name varchar [note: 'Name of the compliance program.']
  program_scope varchar [note: 'Scope of the compliance program.']
  program_status varchar [note: 'Current status of the compliance program.']
  program_type varchar [note: 'Type of compliance program (e.g., HIPAA, OSHA).']
  regulatory_framework varchar [note: 'Regulatory framework the program addresses.']
  reporting_frequency varchar [note: 'How often reporting is required.']
  reporting_required_flag boolean [note: 'Indicates if reporting is required.']
  review_frequency_months varchar [note: 'Frequency of program reviews in months.']
  risk_level varchar [note: 'Risk level associated with the program.']
  ssot_canonical_reference varchar [note: 'Distinct entity; counterpart quality.quality_program serves a separate domain context']
  ssot_reconciliation_status varchar [note: 'SSOT review: kept distinct from quality.quality_program (documented as separate business concepts)']
  training_frequency_months varchar [note: 'Frequency of required training in months.']
  training_required_flag boolean [note: 'Indicates if training is required.']
  vibe_reconciled_flag boolean
  website_url varchar [note: 'URL for program information.']
  created_by varchar [note: 'User who created the program record.']

  Note: 'Organizational compliance programs tracking regulatory frameworks, audit schedules, and program governance.'
}

Table compliance.obligation {
  obligation_id varchar [pk, note: 'Unique identifier for the compliance obligation.']
  code_set_version_id varchar [note: 'Link to the code set version applicable to this obligation.']
  compliance_program_id varchar [note: 'Link to the parent compliance program.']
  cost_center_id varchar [note: 'Cost center responsible for the obligation.']
  parent_obligation_id varchar [note: 'Self-referential link to parent obligation.']
  regulatory_change_id varchar [note: 'Link to the regulatory change that triggered this obligation.']
  regulatory_requirement_id varchar [note: 'Link to the underlying regulatory requirement.']
  training_id varchar [note: 'Link to required training for this obligation.']
  assigned_department varchar [note: 'Department assigned to fulfill the obligation.']
  assigned_role varchar [note: 'Role assigned to fulfill the obligation.']
  attestation_frequency varchar [note: 'How often attestation is required.']
  attestation_required boolean [note: 'Indicates if attestation is required.']
  completion_date date [note: 'Date when the obligation was completed.']
  compliance_percentage decimal(5,2) [note: 'Percentage of compliance achieved.']
  control_activity varchar [note: 'Control activity associated with the obligation.']
  corrective_action_required boolean [note: 'Indicates if corrective action is required.']
  created_timestamp timestamp [note: 'When the obligation record was created.']
  due_date date [note: 'Date when the obligation is due.']
  effective_date date [note: 'Date when the obligation becomes effective.']
  escalation_required boolean [note: 'Indicates if escalation is required.']
  escalation_threshold_days varchar [note: 'Number of days before escalation is triggered.']
  evidence_required boolean [note: 'Indicates if evidence is required.']
  evidence_retention_years varchar [note: 'Number of years evidence must be retained.']
  evidence_type varchar [note: 'Type of evidence required.']
  expiration_date decimal(9,4) [note: 'Date when the obligation expires.']
  external_audit_scope boolean [note: 'Indicates if the obligation is in scope for external audit.']
  finding_count varchar [note: 'Number of findings associated with the obligation.']
  is_active boolean [note: 'Indicates if the obligation is currently active.']
  last_audit_date date [note: 'Date of the most recent audit.']
  last_audit_result varchar [note: 'Outcome of the most recent audit.']
  modified_timestamp timestamp [note: 'When the obligation record was last modified.']
  next_review_date date [note: 'Scheduled date for the next review.']
  notes varchar [note: 'Additional notes about the obligation.']
  obligation_description varchar [note: 'Detailed description of the obligation.']
  obligation_name varchar [note: 'Name of the obligation.']
  obligation_number varchar [note: 'Unique number identifying the obligation.']
  obligation_status varchar [note: 'Current status of the obligation.']
  obligation_type varchar [note: 'Type of obligation.']
  policy_reference varchar [note: 'Reference to related policy.']
  priority_level varchar [note: 'Priority level of the obligation.']
  procedure_reference varchar [note: 'Reference to related procedure.']
  recurrence_pattern varchar [note: 'Pattern of recurrence for the obligation.']
  regulatory_authority varchar [note: 'Regulatory authority governing the obligation.']
  regulatory_citation varchar [note: 'Citation of the regulatory requirement.']
  risk_rating varchar [note: 'Risk rating of the obligation.']

  Note: 'Specific compliance obligations derived from regulatory requirements and program mandates.'
}

Table compliance.compliance_policy {
  compliance_policy_id varchar [pk, note: 'Unique identifier for the compliance policy.']
  code_set_version_id varchar [note: 'Link to the code set version applicable to this policy.']
  superseded_compliance_policy_id varchar [note: 'Self-referential link to the policy this one supersedes.']
  approval_authority varchar [note: 'Authority that approved the policy.']
  approval_date date [note: 'Date when the policy was approved.']
  attestation_required_flag boolean [note: 'Indicates if attestation is required.']
  author_contact_email varchar [note: 'Email of the policy author.']
  author_name varchar [note: 'Name of the policy author.']
  confidentiality_level varchar [note: 'Confidentiality level of the policy.']
  created_timestamp timestamp [note: 'When the policy record was created.']
  distribution_list varchar [note: 'List of recipients for the policy.']
  document_location_url varchar [note: 'URL where the policy document is stored.']
  effective_date date [note: 'Date when the policy becomes effective.']
  enforcement_mechanism varchar [note: 'Mechanism for enforcing the policy.']
  expiration_date decimal(9,4) [note: 'Date when the policy expires.']
  keywords varchar [note: 'Keywords for policy search and categorization.']
  last_review_date date [note: 'Date of the most recent policy review.']
  modified_timestamp timestamp [note: 'When the policy record was last modified.']
  next_review_date date [note: 'Scheduled date for the next policy review.']
  non_compliance_consequence varchar [note: 'Consequences of non-compliance with the policy.']
  owner_department varchar [note: 'Department that owns the policy.']
  owner_role varchar [note: 'Role that owns the policy.']
  policy_category varchar [note: 'Category of the policy.']
  policy_number varchar [note: 'Unique number identifying the policy.']
  policy_status varchar [note: 'Current status of the policy.']
  public_facing_flag boolean [note: 'Indicates if the policy is public-facing.']
  purpose varchar [note: 'Purpose of the policy.']
  regulatory_requirement_satisfied varchar [note: 'Regulatory requirement satisfied by the policy.']
  related_procedure_references varchar [note: 'References to related procedures.']
  related_standard_references varchar [note: 'References to related standards.']
  retired_reason varchar [note: 'Reason the policy was retired.']
  retired_timestamp timestamp [note: 'When the policy was retired.']
  review_cycle_months varchar [note: 'Frequency of policy reviews in months.']
  scope_of_application varchar [note: 'Scope of the policy application.']
  subcategory varchar [note: 'Subcategory of the policy.']
  summary varchar [note: 'Summary of the policy.']
  supersedes_policy_number varchar [note: 'Policy number that this policy supersedes.']
  title varchar [note: 'Title of the policy.']
  training_frequency_months varchar [note: 'Frequency of required training in months.']
  training_required_flag boolean [note: 'Indicates if training is required.']
  version_number varchar [note: 'Version number of the policy.']

  Note: 'Organizational compliance policies governing behavior, procedures, and regulatory adherence.'
}

Table compliance.policy_version {
  policy_version_id varchar [pk, note: 'Unique identifier for the policy version.']
  approver_employee_id varchar [note: 'Employee who approved this policy version.']
  compliance_policy_id varchar [note: 'Link to the parent compliance policy.']
  primary_policy_employee_id varchar [note: 'Employee who owns this policy version.']
  primary_superseded_version_policy_version_id varchar [note: 'Link to the policy version this one supersedes.']
  reviewer_employee_id varchar [note: 'Employee who reviewed this policy version.']
  approval_date date [note: 'Date when the version was approved.']
  attestation_required_flag boolean [note: 'Indicates if attestation is required.']
  change_summary varchar [note: 'Summary of changes in this version.']
  comment_log varchar [note: 'Log of comments on this version.']
  distribution_list varchar [note: 'List of recipients for this version.']
  document_checksum varchar [note: 'Checksum for document integrity verification.']
  document_url varchar [note: 'URL where the version document is stored.']
  effective_date date [note: 'Date when the version becomes effective.']
  expiration_date decimal(9,4) [note: 'Date when the version expires.']
  language_code varchar [note: 'Language code for the version.']
  next_review_due_date date [note: 'Scheduled date for the next review.']
  policy_type varchar [note: 'Type of policy.']
  publication_date date [note: 'Date when the version was published.']
  regulatory_citation varchar [note: 'Citation of the regulatory requirement.']
  regulatory_driver varchar [note: 'Regulatory driver for the version.']
  retirement_date date [note: 'Date when the version was retired.']
  retirement_reason varchar [note: 'Reason the version was retired.']
  review_cycle_months varchar [note: 'Frequency of reviews in months.']
  review_date date [note: 'Date of the most recent review.']
  scope_description varchar [note: 'Description of the version scope.']
  training_due_days varchar [note: 'Number of days until training is due.']
  training_required_flag boolean [note: 'Indicates if training is required.']
  version_created_timestamp timestamp [note: 'When the version record was created.']
  version_modified_timestamp timestamp [note: 'When the version record was last modified.']
  version_number varchar [note: 'Version number.']
  version_status varchar [note: 'Current status of the version.']
  version_title varchar [note: 'Title of the version.']

  Note: 'Version history and change tracking for compliance policies.'
}

Table compliance.audit {
  audit_id varchar [pk, note: 'Unique identifier for the audit.']
  audited_cost_center_id varchar [note: 'Cost center being audited.']
  care_site_id varchar [note: 'Care site where the audit is conducted.']
  follow_up_audit_id varchar [note: 'Self-referential link to follow-up audit.']
  payer_id varchar [note: 'Payer being audited.']
  accreditation_decision varchar [note: 'Decision on accreditation resulting from the audit.']
  accreditation_expiration_date date [note: 'Date when accreditation expires.']
  actual_completion_date date [note: 'Actual date when the audit was completed.']
  actual_start_date date [note: 'Actual date when the audit started.']
  audit_name varchar [note: 'Name of the audit.']
  audit_status varchar [note: 'Current status of the audit.']
  audit_type varchar [note: 'Type of audit (e.g., internal, external).']
  auditing_body varchar [note: 'Organization conducting the audit.']
  corrective_action_plan_due_date date [note: 'Due date for corrective action plan.']
  corrective_action_plan_required boolean [note: 'Indicates if corrective action plan is required.']
  corrective_action_plan_submitted_date date [note: 'Date when corrective action plan was submitted.']
  cost decimal(15,2) [note: 'Cost of the audit.']
  created_timestamp timestamp [note: 'When the audit record was created.']
  critical_findings_count varchar [note: 'Number of critical findings.']
  department_audited varchar [note: 'Department being audited.']
  external_auditor_organization varchar [note: 'Organization of the external auditor.']
  findings_count varchar [note: 'Total number of findings.']
  follow_up_completion_date date [note: 'Date when follow-up was completed.']
  follow_up_due_date date [note: 'Due date for follow-up.']
  follow_up_status varchar [note: 'Status of follow-up activities.']
  frequency varchar [note: 'Frequency of the audit.']
  is_unannounced boolean [note: 'Indicates if the audit was unannounced.']
  last_modified_timestamp timestamp [note: 'When the audit record was last modified.']
  lead_auditor_email varchar [note: 'Email of the lead auditor.']
  lead_auditor_name varchar [note: 'Name of the lead auditor.']
  methodology varchar [note: 'Methodology used for the audit.']
  modified_by_user varchar [note: 'User who last modified the audit record.']
  monetary_penalty_amount decimal(15,2) [note: 'Amount of monetary penalty.']
  notification_date date [note: 'Date when audit notification was sent.']
  overall_outcome varchar [note: 'Overall outcome of the audit.']
  period_end_date date [note: 'End date of the audit period.']
  period_start_date date [note: 'Start date of the audit period.']
  regulatory_framework varchar [note: 'Regulatory framework being audited.']
  report_document_path varchar [note: 'Path to the audit report document.']
  report_issued_date date [note: 'Date when the audit report was issued.']
  risk_level varchar [note: 'Risk level associated with the audit.']
  sample_size varchar [note: 'Sample size used in the audit.']
  scheduled_end_date date [note: 'Scheduled end date for the audit.']
  scheduled_start_date date [note: 'Scheduled start date for the audit.']
  scope varchar [note: 'Scope of the audit.']
  team_size varchar [note: 'Size of the audit team.']
  trigger varchar [note: 'Trigger that initiated the audit.']

  Note: 'Compliance audits conducted by internal or external auditors to assess adherence to regulations and policies.'
}

Table compliance.audit_finding {
  audit_finding_id varchar [pk, note: 'Unique identifier for the audit finding record. Primary key.']
  care_site_id varchar [note: 'Reference to the specific facility, hospital, clinic, or care site where the finding was identified. Links to the facility product.']
  compliance_audit_id varchar [note: 'Reference to the parent compliance audit during which this finding was identified. Links to the compliance_audit product.']
  compliance_policy_id varchar [note: 'Reference to the organizational policy that was violated or requires update as a result of this finding. Links to the policy product. Null if no specific policy is implicated.']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Audit findings reference specific CPT codes when identifying billing compliance issues, upcoding, unbundling violations, or modifier misuse. Critical for revenue cycle compliance and OIG audit respons']
  drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: DRG validation audits identify specific DRG assignments that were incorrect or unsupported by documentation. Essential for inpatient reimbursement compliance and RAC audit defense.']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Audit findings cite specific ICD codes when documenting clinical documentation deficiencies, DRG validation errors, or medical necessity issues. Essential for coding compliance audits and CAP tracking']
  interface_channel_id varchar [note: 'Foreign key linking to interoperability.interface_channel. Business justification: Audit findings frequently cite specific interface configuration issues, message validation failures, or data exchange vulnerabilities. Linking findings to the affected interface channel enables target']
  parent_audit_finding_id varchar [note: 'Self-referencing FK on audit_finding (related_audit_finding_id)']
  primary_previous_finding_audit_finding_id varchar [note: 'Reference to the prior audit finding record if this is a recurrence. Links to another audit_finding record. Null if this is not a repeat finding.']
  accreditation_impact_flag boolean [note: 'Indicates whether the finding could affect the organization\'s accreditation status with Joint Commission, DNV, HFAP, or other accrediting bodies. True if accreditation is at risk; false otherwise.']
  actual_resolution_date date [note: 'The date on which the finding was actually resolved, corrective actions were completed, and the finding was closed. Null if still open or in remediation.']
  affected_department varchar [note: 'The department, unit, or service line where the finding was identified (e.g., Emergency Department, Pharmacy, Health Information Management, Infection Control). May reference multiple departments if the finding spans areas.']
  auditor_name varchar [note: 'The name of the auditor, surveyor, or inspector who identified and documented the finding. May be internal compliance staff or external regulatory surveyor.']
  auditor_organization varchar [note: 'The organization or agency the auditor represents (e.g., Joint Commission, CMS Regional Office, State Department of Health, Internal Audit Department).']
  corrective_action_required_flag boolean [note: 'Indicates whether a formal corrective action plan is required to address the finding. True for deficiencies and condition-level findings; false for observations and informational findings.']
  created_timestamp timestamp [note: 'The timestamp when this audit finding record was first created in the system. Used for audit trail and data lineage.']
  days_to_resolution varchar [note: 'The number of calendar days between the identified date and the actual resolution date. Used for performance measurement and trend analysis of remediation effectiveness.']
  dispute_reason varchar [note: 'If the finding status is disputed, this field captures the organization\'s rationale for contesting the finding, including supporting evidence and regulatory interpretation arguments. Null if not disputed.']
  dispute_submitted_date date [note: 'The date on which a formal dispute or appeal of the finding was submitted to the regulatory authority. Null if not disputed.']
  evidence_location varchar [note: 'The file path, document management system location, or reference to where supporting evidence and documentation for the finding is stored (e.g., audit work papers, photographs, medical records reviewed).']
  financial_penalty_risk_flag boolean [note: 'Indicates whether the finding carries risk of financial penalties, fines, or reimbursement recoupment from CMS, state agencies, or other payers. True if monetary sanctions are possible; false otherwise.']
  finding_description varchar [note: 'Detailed narrative description of the deficiency, observation, or non-compliance issue identified. Includes what was observed, why it constitutes a finding, and the specific circumstances or evidence supporting the citation.']
  finding_number varchar [note: 'The externally-known unique identifier or tracking number assigned to this finding within the audit (e.g., F-2024-001, CMS-CoP-123). Used for audit documentation and regulatory correspondence.']
  finding_status varchar [note: 'Current lifecycle status of the finding. Open indicates newly identified; in remediation indicates corrective action plan is being executed; pending verification indicates awaiting auditor review; closed indicates resolved and accepted; disputed indicates organization contests the finding; deferred indicates resolution postponed.']
  finding_type varchar [note: 'Classification of the finding severity and nature. Deficiency indicates non-compliance requiring corrective action; observation is a noted concern without formal citation; opportunity for improvement is a recommendation; immediate jeopardy indicates serious threat to patient safety; condition-level deficiency is a systemic CMS compliance failure; best practice gap is advisory.']
  follow_up_audit_required_flag boolean [note: 'Indicates whether a follow-up audit or validation survey is required to verify that corrective actions have been effectively implemented. True if follow-up is mandated; false otherwise.']
  follow_up_audit_scheduled_date date [note: 'The scheduled date for the follow-up audit or validation survey to verify corrective action effectiveness. Null if no follow-up is required or not yet scheduled.']
  identified_date date [note: 'The date on which the finding was first identified during the audit or inspection. This is the principal business event timestamp for the finding.']
  mandatory_reporting_required_flag boolean [note: 'Indicates whether the finding triggers mandatory external reporting obligations to CMS, state health departments, Joint Commission, or other regulatory bodies. True if external reporting is required; false otherwise.']
  modified_by_user varchar [note: 'The username or identifier of the user who last modified this audit finding record. Used for accountability and audit trail.']
  modified_timestamp timestamp [note: 'The timestamp when this audit finding record was last modified. Used for audit trail and change tracking.']
  patient_safety_impact_flag boolean [note: 'Indicates whether the finding has direct or potential impact on patient safety. True if patient harm occurred or could occur; false if the finding is administrative or process-related without direct patient safety implications.']
  recurrence_flag boolean [note: 'Indicates whether this finding is a repeat or recurrence of a previously identified and supposedly corrected issue. True if this is a repeat finding; false if this is the first occurrence.']
  regulatory_framework varchar [note: 'The overarching regulatory framework or governing body under which the cited standard falls (e.g., HIPAA for privacy violations, CMS CoP for hospital conditions, Joint Commission for accreditation standards, OSHA for workplace safety). [ENUM-REF-CANDIDATE: hipaa|cms_cop|joint_commission|osha|state_health_department|fda|dea|emtala|stark_law|anti_kickback|other — 11 candidates stripped; promote to reference product]']
  regulatory_standard_cited varchar [note: 'The specific regulatory standard, rule, or requirement that was violated or not met (e.g., 42 CFR 482.13, Joint Commission LD.04.03.11, OSHA 29 CFR 1910.1030). May include multiple citations separated by semicolons.']
  reported_to_authority_date date [note: 'The date on which the finding was reported to the applicable regulatory authority, if mandatory reporting was required. Null if not reported or not required.']
  responsible_party_email varchar [note: 'The email address of the responsible party for follow-up communication and status updates regarding the finding remediation.']
  responsible_party_name varchar [note: 'The name of the individual, role, or department assigned ownership and accountability for remediating the finding and implementing corrective actions.']
  root_cause_category varchar [note: 'The primary root cause category identified through analysis of why the finding occurred. Used to drive systemic corrective actions and prevent recurrence. [ENUM-REF-CANDIDATE: policy_gap|training_deficiency|process_failure|resource_constraint|communication_breakdown|technology_issue|human_error|documentation_failure|other — 9 candidates stripped; promote to reference product]']
  scope_of_impact varchar [note: 'The breadth of the finding across the organization. Isolated indicates a single incident; pattern indicates multiple occurrences in one area; widespread indicates multiple areas affected; systemic indicates organization-wide process failure.']
  severity_level varchar [note: 'The assessed severity or risk level of the finding. Critical indicates immediate threat to patient safety or major regulatory violation; high indicates significant compliance risk; medium indicates moderate risk; low indicates minor issue; informational indicates advisory note without compliance impact.']
  tags_keywords varchar [note: 'Comma-separated list of tags or keywords for categorization, search, and reporting (e.g., infection_control, medication_safety, documentation, privacy, emergency_preparedness). Supports analytics and trend identification.']
  target_resolution_date date [note: 'The date by which the finding must be resolved and corrective actions completed. May be mandated by regulatory authority or set internally based on risk assessment.']
  verification_method varchar [note: 'The method used by the auditor to verify and validate the finding (e.g., document review, on-site inspection, staff interviews, medical record audit). May include multiple methods. [ENUM-REF-CANDIDATE: document_review|on_site_inspection|staff_interview|medical_record_audit|policy_review|observation|testing|other — 8 candidates stripped; promote to reference product]']

  Note: 'Transactional record of each individual deficiency, observation, or finding identified during a compliance audit. Captures finding number, finding type (deficiency, observation, opportunity for improvement, immediate jeopardy, condition-level deficiency), regulatory standard cited, finding description, severity level, affected department or facility, finding status (open, in remediation, closed, disputed), and target resolution date. Links to the parent compliance audit and drives corrective action planning. Distinct from quality.standard_finding which is accreditation-survey-specific.'
}

Table compliance.corrective_action_plan {
  corrective_action_plan_id varchar [pk, note: 'Unique identifier for the corrective action plan record. Primary key.']
  audit_finding_id varchar [note: 'Reference to the primary audit finding or compliance violation that triggered this corrective action plan.']
  budget_id varchar [note: 'Foreign key linking to finance.budget. Business justification: CAPs often require capital expenditures or operational budget allocations for remediation (system upgrades, additional staffing, consultant fees). Links denormalized financial_impact_estimate to forma']
  capital_project_id varchar [note: 'Foreign key linking to finance.capital_project. Business justification: CAPs frequently require capital investments for remediation (HVAC upgrades for infection control, IT system implementations for HIPAA compliance, facility modifications for life safety). Links CAP to ']
  compliance_policy_id varchar [note: 'Reference to the organizational policy that was updated, created, or reinforced as part of this corrective action plan.']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: CAPs remediate specific procedure code compliance issues, tracking which CPT codes require documentation improvement, modifier education, or billing practice changes to prevent recurrence.']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: CAPs address specific diagnosis code misuse patterns identified in audits, requiring remediation tied to particular ICD codes (e.g., sepsis coding education, specificity improvement for diabetes codes']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: CAPs often result from payer audits (claims audits, medical record reviews, contract compliance audits) or address payer-identified deficiencies. Tracking which payer triggered or is monitoring the CA']
  privacy_incident_hipaa_privacy_incident_id varchar [note: 'Foreign key linking to compliance.hipaa_privacy_incident. Business justification: Corrective action plans can be created in response to HIPAA privacy incidents, not just audit findings. CAP should support multiple trigger types. This FK allows tracking CAPs created to remediate pri']
  scheduling_appointment_id varchar [note: 'Foreign key linking to scheduling.scheduling_appointment. Business justification: CAPs may require appointment-level remediation including rebilling, documentation correction, or patient notification. Real remediation scope for billing and documentation findings.']
  security_risk_hipaa_security_risk_id varchar [note: 'Foreign key linking to compliance.hipaa_security_risk. Business justification: Corrective action plans can be created to mitigate HIPAA security risks identified during risk assessments. This FK allows tracking CAPs created to address security risks. N:1 relationship (many CAPs ']
  superseded_corrective_action_plan_id varchar [note: 'Self-referencing FK on corrective_action_plan (superseded_corrective_action_plan_id)']
  actual_completion_date date [note: 'Actual date when all corrective actions were fully implemented and ready for verification.']
  cap_number varchar [note: 'Business identifier for the corrective action plan, externally visible and used in regulatory submissions and audit correspondence.']
  cap_status varchar [note: 'Current lifecycle status of the corrective action plan in the regulatory response and implementation workflow. [ENUM-REF-CANDIDATE: draft|submitted|approved|in_progress|completed|verified|closed — 7 candidates stripped; promote to reference product]']
  cap_type varchar [note: 'Classification of the corrective action plan based on regulatory requirement and scope of response.']
  closed_timestamp timestamp [note: 'Timestamp when the corrective action plan was formally closed after successful verification and regulatory acceptance.']
  closure_notes varchar [note: 'Final notes documenting the closure of the corrective action plan, including lessons learned and recommendations for future compliance improvement.']
  corrective_actions_defined varchar [note: 'Detailed description of the specific corrective actions, process changes, policy updates, training programs, or system enhancements that will be implemented to address the deficiency.']
  created_by_user varchar [note: 'Username or identifier of the compliance officer or staff member who created the corrective action plan record.']
  created_timestamp timestamp [note: 'Timestamp when the corrective action plan record was first created in the compliance management system.']
  escalation_required_flag boolean [note: 'Indicates whether the corrective action plan requires escalation to executive leadership, board of directors, or external regulatory authority due to severity or complexity.']
  external_consultant_engaged_flag boolean [note: 'Indicates whether external consultants, subject matter experts, or legal counsel were engaged to support corrective action plan development or implementation.']
  implementation_milestones varchar [note: 'Key milestones, checkpoints, and deliverables defined in the corrective action plan implementation timeline.']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified the corrective action plan record.']
  modified_timestamp timestamp [note: 'Timestamp when the corrective action plan record was last modified or updated.']
  monitoring_frequency varchar [note: 'Frequency at which ongoing monitoring and auditing will be conducted to ensure sustained compliance after corrective action plan implementation.']
  patient_safety_impact_flag boolean [note: 'Indicates whether the compliance violation and corrective action plan directly impact patient safety or quality of care.']
  priority_level varchar [note: 'Priority classification of the corrective action plan based on severity of the violation, patient safety impact, and regulatory urgency.']
  recurrence_prevention_measures varchar [note: 'Specific measures, controls, monitoring mechanisms, or system changes implemented to prevent recurrence of the compliance violation.']
  regulator_approval_date date [note: 'Date when the regulatory body or accreditation agency formally approved the corrective action plan.']
  regulator_feedback varchar [note: 'Feedback, comments, or additional requirements provided by the regulatory body or accreditation agency in response to the submitted corrective action plan.']
  regulatory_requirement_reference varchar [note: 'Citation of the specific regulatory requirement, standard, or condition of participation that was violated and is being addressed by this CAP.']
  responsible_owner_department varchar [note: 'Department or organizational unit responsible for executing the corrective action plan.']
  responsible_owner_email varchar [note: 'Email contact for the individual responsible for the corrective action plan implementation.']
  responsible_owner_name varchar [note: 'Name of the individual or role accountable for implementing and completing the corrective action plan.']
  root_cause_analysis_summary varchar [note: 'Summary of the root cause analysis conducted to identify the underlying factors that led to the compliance violation or audit finding.']
  staff_affected_count varchar [note: 'Number of staff members, departments, or organizational units affected by or involved in the corrective action plan implementation.']
  submitted_to_regulator_date date [note: 'Date when the corrective action plan was formally submitted to the regulatory body or accreditation agency.']
  target_completion_date date [note: 'Planned date by which all corrective actions must be fully implemented and verified, as committed to the regulatory body or accreditation agency.']
  training_completion_target_date date [note: 'Target date by which all required staff training must be completed as part of the corrective action plan.']
  training_required_flag boolean [note: 'Indicates whether staff training or education is required as part of the corrective action plan implementation.']
  verification_date date [note: 'Date when the corrective action plan was verified as complete and effective by internal compliance or external regulatory authority.']
  verification_method varchar [note: 'Method by which the effectiveness and completion of the corrective action plan will be verified by internal compliance or external regulatory surveyors. [ENUM-REF-CANDIDATE: document_review|on_site_inspection|staff_interview|medical_record_audit|policy_review|training_records_review|system_validation — 7 candidates stripped; promote to reference product]']
  verification_notes varchar [note: 'Detailed notes from the verification process documenting findings, evidence reviewed, and any remaining concerns or recommendations.']
  verification_outcome varchar [note: 'Result of the verification process indicating whether the corrective actions were found to be effective and sustainable.']

  Note: 'Formal corrective action plan (CAP) developed in response to one or more audit findings or compliance violations. Captures CAP number, CAP type (plan of correction, corrective action plan, preventive action), root cause analysis summary, corrective actions defined, responsible owner, implementation milestones, target completion date, actual completion date, CAP status (draft, submitted, approved, in progress, completed, verified), and verification method. Required by CMS, Joint Commission, and OIG for regulatory response. Distinct from quality.corrective_action which is patient-safety-event-driven.'
}

Table compliance.hipaa_privacy_incident {
  hipaa_privacy_incident_id varchar [pk, note: 'Unique identifier for the HIPAA privacy incident record. Primary key.']
  message_log_id varchar [note: 'Foreign key linking to interoperability.message_log. Business justification: Privacy incidents often originate from or are discovered through message exchange logs (unauthorized access, improper disclosure via interface). Linking incidents to specific message logs provides evi']
  note_id varchar [note: 'Foreign key linking to clinical.clinical_note. Business justification: Privacy breach investigations frequently identify specific clinical notes that were inappropriately accessed or disclosed. HIPAA incident response requires documenting which exact note records were in']
  parent_hipaa_privacy_incident_id varchar [note: 'Self-referencing FK on hipaa_privacy_incident (related_hipaa_privacy_incident_id)']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Privacy incidents involving payer data (eligibility file breaches, claims data exposure, remittance misdirection) must track which payer\'s data was involved for breach notification, business associate']
  phi_access_log_id varchar [note: 'Foreign key linking to compliance.phi_access_log. Business justification: Privacy incidents are often discovered through access log reviews; linking the specific log entries that triggered the incident investigation is standard practice for breach determination and OCR repo']
  affected_individuals_count varchar [note: 'The number of unique individuals whose PHI was potentially or actually compromised in the incident.']
  breach_determination_date date [note: 'The date when the formal breach determination was completed.']
  breach_determination_outcome varchar [note: 'The formal determination of whether the incident constitutes a breach under HIPAA Breach Notification Rule based on the four-factor risk assessment.']
  closed_date date [note: 'The date when the incident investigation and all required actions were completed and the case was formally closed.']
  created_timestamp timestamp [note: 'The timestamp when this incident record was first created in the system.']
  disciplinary_action_taken_flag boolean [note: 'Indicates whether disciplinary action was taken against any workforce member as a result of the incident.']
  discovery_date date [note: 'The date when the organization first became aware of the potential privacy incident or breach.']
  incident_category varchar [note: 'High-level categorization of the root cause or mechanism of the incident.']
  incident_date date [note: 'The date when the unauthorized access, use, or disclosure of Protected Health Information (PHI) occurred or is estimated to have occurred.']
  incident_description varchar [note: 'Detailed narrative description of the privacy incident including circumstances, individuals involved, and sequence of events.']
  incident_number varchar [note: 'Business-facing unique identifier or case number assigned to the privacy incident for tracking and reference purposes.']
  incident_status varchar [note: 'Current lifecycle status of the privacy incident investigation and resolution process. [ENUM-REF-CANDIDATE: reported|under investigation|breach determination pending|breach confirmed|not a breach|closed|remediation in progress — 7 candidates stripped; promote to reference product]']
  incident_type varchar [note: 'Classification of the nature of the privacy incident describing how the unauthorized use or disclosure occurred. [ENUM-REF-CANDIDATE: unauthorized access|improper disclosure|lost device|stolen device|misdirected communication|insider threat|hacking|ransomware|phishing — 9 candidates stripped; promote to reference product]']
  individual_notification_date date [note: 'The date when notification letters were sent to affected individuals (must be within 60 days of discovery).']
  individual_notification_required_flag boolean [note: 'Indicates whether notification to affected individuals is required under HIPAA Breach Notification Rule.']
  investigation_summary varchar [note: 'Detailed summary of the investigation findings including root cause analysis and contributing factors.']
  law_enforcement_case_number varchar [note: 'Case or reference number assigned by law enforcement if the incident was reported to police or other authorities.']
  law_enforcement_notified_flag boolean [note: 'Indicates whether law enforcement agencies were notified of the incident.']
  lessons_learned varchar [note: 'Key lessons learned from the incident and recommendations for organizational improvement.']
  location_of_incident varchar [note: 'Physical or system location where the privacy incident occurred (e.g., facility name, department, system name).']
  media_notification_date date [note: 'The date when media notification was issued for breaches affecting 500 or more individuals.']
  media_notification_required_flag boolean [note: 'Indicates whether media notification is required (for breaches affecting 500 or more individuals in a jurisdiction).']
  mitigation_measures varchar [note: 'Description of immediate mitigation measures taken to limit harm and prevent further unauthorized access or disclosure.']
  modified_timestamp timestamp [note: 'The timestamp when this incident record was last modified or updated.']
  notification_required_flag boolean [note: 'Indicates whether breach notification to affected individuals, HHS Office for Civil Rights (OCR), and/or media is required.']
  ocr_case_number varchar [note: 'The case or reference number assigned by HHS Office for Civil Rights upon receipt of the breach report.']
  ocr_reporting_required_flag boolean [note: 'Indicates whether reporting to HHS Office for Civil Rights is required.']
  ocr_reporting_status varchar [note: 'Current status of the breach report submission to HHS Office for Civil Rights.']
  ocr_submission_date date [note: 'The date when the breach report was submitted to HHS Office for Civil Rights (within 60 days for 500+ individuals, or annually for fewer than 500).']
  phi_involved_flag boolean [note: 'Indicates whether Protected Health Information was involved in the incident.']
  phi_type varchar [note: 'Description of the type or category of PHI that was accessed, used, or disclosed (e.g., medical records, billing information, lab results, demographic data).']
  phi_volume_records varchar [note: 'The number of patient records or PHI records involved in the incident.']
  policy_violation_flag boolean [note: 'Indicates whether the incident involved a violation of organizational privacy policies or procedures.']
  privacy_officer_assigned varchar [note: 'Name of the privacy officer or compliance officer assigned to investigate and manage the incident.']
  remediation_actions_taken varchar [note: 'Description of corrective and remediation actions taken to address the incident and prevent recurrence.']
  remediation_completion_date date [note: 'The date when all remediation actions were completed.']
  reported_by_department varchar [note: 'Department or organizational unit of the individual who reported the incident.']
  reported_by_name varchar [note: 'Name of the individual who initially reported or discovered the privacy incident.']
  reported_by_role varchar [note: 'Job title or role of the individual who reported the incident.']
  risk_assessment_completed_flag boolean [note: 'Indicates whether the required four-factor risk assessment has been completed to determine breach status.']
  risk_assessment_summary varchar [note: 'Summary of the four-factor risk assessment findings including nature and extent of PHI, unauthorized person, actual acquisition or viewing, and extent of mitigation.']
  root_cause varchar [note: 'Identified root cause of the privacy incident based on investigation findings.']

  Note: 'Transactional record of every potential or confirmed HIPAA Privacy Rule incident, breach, or unauthorized use/disclosure of Protected Health Information (PHI). Captures incident date, discovery date, incident type (unauthorized access, improper disclosure, lost/stolen device, misdirected communication, insider threat), PHI involved (type, volume, affected individuals), breach determination outcome (breach, not a breach, low probability of compromise), notification obligations triggered, OCR reporting status, and remediation actions. SSOT for HIPAA breach management and OCR reporting compliance.'
}

Table compliance.hipaa_security_risk {
  hipaa_security_risk_id varchar [pk, note: 'Unique identifier for the HIPAA Security Rule risk analysis record. Primary key for the risk register.']
  audit_finding_id varchar [note: 'Reference to an internal or external audit finding that identified this risk, if applicable.']
  equipment_asset_id varchar [note: 'Reference to the specific IT asset, facility, or resource in the asset inventory that is exposed to this risk.']
  interface_channel_id varchar [note: 'Foreign key linking to interoperability.interface_channel. Business justification: HIPAA security risk assessments must evaluate interface channels as potential threat vectors for ePHI exposure. Linking risks to specific channels enables risk-based interface security controls, vulne']
  prior_hipaa_security_risk_id varchar [note: 'Self-referencing FK on hipaa_security_risk (prior_hipaa_security_risk_id)']
  related_incident_hipaa_privacy_incident_id varchar [note: 'Reference to a security incident or breach event that triggered the identification of this risk, if applicable.']
  tertiary_hipaa_identified_by_employee_id varchar [note: 'Reference to the employee, auditor, or security analyst who identified and documented this risk.']
  affected_ephi_system varchar [note: 'Name or identifier of the information system, application, or asset that contains or processes ePHI and is subject to this risk. Examples include EHR system, billing system, patient portal, or backup storage.']
  closed_timestamp timestamp [note: 'System timestamp when this risk was formally closed or resolved, indicating it is no longer an active concern.']
  control_effectiveness varchar [note: 'Assessment of how well existing controls are functioning to mitigate the risk. Rated as effective, partially effective, ineffective, or not implemented.']
  created_timestamp timestamp [note: 'System timestamp when this risk record was first created in the risk management system.']
  existing_controls varchar [note: 'Description of current safeguards, policies, procedures, or technical controls already in place that reduce the likelihood or impact of this risk.']
  identification_method varchar [note: 'Method or source through which the risk was identified, such as vulnerability scan, penetration test, internal audit, external audit, incident investigation, or self-assessment.']
  identified_date date [note: 'Date when this risk was first identified and documented in the risk register.']
  impact_rating varchar [note: 'Qualitative assessment of the potential harm or damage if the risk is realized. Considers confidentiality, integrity, and availability impact on ePHI, as well as financial, reputational, and regulatory consequences.']
  impact_score varchar [note: 'Numeric score representing the magnitude of impact if the risk occurs, typically on a scale of 1-5 or 1-10, used for quantitative risk calculation.']
  inherent_risk_level varchar [note: 'Overall risk level before considering existing controls, calculated from likelihood and impact. Categorized as critical, high, medium, or low. Represents the raw exposure.']
  inherent_risk_score varchar [note: 'Numeric inherent risk score, typically calculated as likelihood_score multiplied by impact_score, representing the risk exposure before mitigation.']
  last_review_date date [note: 'Date when this risk was last reviewed and reassessed by the risk owner or security team.']
  likelihood_rating varchar [note: 'Qualitative assessment of the probability that the threat will exploit the vulnerability. Rated as very low, low, medium, high, or very high based on threat frequency, vulnerability severity, and existing controls.']
  likelihood_score varchar [note: 'Numeric score representing the likelihood of occurrence, typically on a scale of 1-5 or 1-10, used for quantitative risk calculation.']
  mitigation_actual_completion_date date [note: 'Actual date when mitigation controls were fully implemented and verified as operational.']
  mitigation_controls_implemented varchar [note: 'List or description of new safeguards, policies, procedures, or technical controls that have been implemented to mitigate this risk.']
  mitigation_plan varchar [note: 'Detailed description of the action plan to reduce the risk, including specific controls to be implemented, responsible parties, and timelines.']
  mitigation_start_date date [note: 'Date when mitigation activities began or are scheduled to begin.']
  mitigation_target_completion_date date [note: 'Planned or target date by which mitigation controls should be fully implemented and operational.']
  modified_timestamp timestamp [note: 'System timestamp when this risk record was last updated or modified.']
  next_review_date date [note: 'Scheduled date for the next periodic review of this risk to reassess likelihood, impact, control effectiveness, and treatment decisions. HIPAA requires annual risk analysis.']
  notes varchar [note: 'Additional comments, context, or documentation related to this risk, including historical decisions, stakeholder discussions, or special considerations.']
  regulatory_citation varchar [note: 'Specific HIPAA Security Rule section or other regulatory requirement that this risk relates to, such as §164.308(a)(3) for workforce security or §164.312(a)(1) for access control.']
  residual_risk_level varchar [note: 'Overall risk level after considering existing and planned mitigation controls. Categorized as critical, high, medium, or low. Represents the remaining exposure after treatment.']
  residual_risk_score varchar [note: 'Numeric residual risk score after mitigation, calculated from adjusted likelihood and impact scores, representing the remaining risk exposure.']
  risk_acceptance_date date [note: 'Date when the risk acceptance decision was formally approved by management.']
  risk_acceptance_justification varchar [note: 'Business rationale and approval documentation for accepting a risk without further mitigation, including cost-benefit analysis and management sign-off.']
  risk_assessment_cycle_code varchar [note: 'Reference to the annual or periodic risk assessment cycle during which this risk was identified. Links to the broader compliance assessment program.']
  risk_category varchar [note: 'High-level classification of the risk aligned with HIPAA Security Rule safeguard categories: administrative, physical, technical, or organizational.']
  risk_number varchar [note: 'Business-facing unique identifier for the risk, typically formatted as a human-readable code (e.g., RISK-2024-001) for tracking and reporting purposes.']
  risk_owner_department varchar [note: 'Department or business unit responsible for managing this risk, such as IT, Compliance, Clinical Operations, or Health Information Management (HIM).']
  risk_status varchar [note: 'Current lifecycle status of the risk: open (newly identified), in progress (mitigation underway), mitigated (controls implemented), accepted (risk tolerance decision made), or closed (risk no longer applicable).']
  risk_subcategory varchar [note: 'Detailed classification of the risk within the category, such as access control, encryption, workforce security, or facility access.']
  risk_title varchar [note: 'Short descriptive title of the identified risk, summarizing the threat or vulnerability in business terms.']
  risk_treatment_decision varchar [note: 'Strategic decision on how to address the risk: accept (tolerate the risk), mitigate (implement controls to reduce risk), transfer (shift risk via insurance or contract), or avoid (eliminate the activity causing the risk).']
  threat_description varchar [note: 'Detailed description of the threat agent or event that could exploit the vulnerability and cause harm to ePHI (Electronic Protected Health Information). Examples include malware, unauthorized access, natural disaster, or insider threat.']
  vulnerability_description varchar [note: 'Detailed description of the weakness or gap in controls that could be exploited by the threat. Examples include unpatched systems, weak passwords, lack of encryption, or inadequate physical security.']

  Note: 'Master and transactional record for HIPAA Security Rule risk analysis and risk management activities. Captures risk assessment cycle, threat and vulnerability identified, likelihood rating, impact rating, overall risk level (critical, high, medium, low), affected ePHI system or asset, risk owner, risk treatment decision (accept, mitigate, transfer, avoid), mitigation controls implemented, residual risk level, and risk status. Required by HIPAA Security Rule §164.308(a)(1) as a mandatory administrative safeguard. Supports annual security risk analysis documentation.'
}

Table compliance.training {
  training_id varchar [pk, note: 'Unique identifier for the compliance training program. Primary key.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Training programs are delivered by specific departments and funded through their cost centers. Training costs (development, delivery, vendor fees) must be allocated for financial tracking, budget mana']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Compliance training modules focus on specific high-risk or frequently misused diagnosis codes (sepsis, MI, diabetes with complications), requiring direct code references for targeted coder education.']
  prerequisite_training_id varchar [note: 'Self-referencing FK on training (prerequisite_training_id)']
  accreditation_body varchar [note: 'Organization that has accredited or certified this training program. Examples: ANCC, AMA, AAFP. Null if not accredited.']
  accreditation_number varchar [note: 'Unique accreditation or certification number assigned by the accrediting body. Used for external reporting and audit.']
  approval_authority varchar [note: 'Role or individual who approved this training program for deployment. Examples: Chief Compliance Officer, Chief Medical Officer, VP Human Resources.']
  approval_date date [note: 'Date when the training program was formally approved for use by the approval authority.']
  assessment_required_flag boolean [note: 'Indicates whether the training includes a graded assessment that must be passed for completion. True if assessment is required, False if completion is based on participation only.']
  attestation_required_flag boolean [note: 'Indicates whether the learner must sign an attestation statement acknowledging understanding and commitment to comply. Common for Code of Conduct and policy-based training.']
  certificate_issued_flag boolean [note: 'Indicates whether a completion certificate is issued upon successful completion of the training. True if certificate is generated, False otherwise.']
  content_author varchar [note: 'Name of the individual or team who developed the training content.']
  content_location_url varchar [note: 'URL or file path where the training content is hosted. Used by learning management systems to launch the training.']
  content_owner varchar [note: 'Department or role responsible for maintaining the training content and ensuring accuracy and regulatory alignment. Examples: Compliance Department, Infection Prevention, Human Resources.']
  created_timestamp timestamp [note: 'Timestamp when this training program record was first created in the system. Used for audit trail and data lineage.']
  duration_minutes varchar [note: 'Expected time in minutes required to complete the training program. Used for workforce planning and scheduling.']
  effective_date date [note: 'Date when this training program version became active and available for assignment. Used to track training content versioning.']
  escalation_threshold_days varchar [note: 'Number of days past the due date after which non-completion triggers an escalation to management. Used for compliance enforcement.']
  expiration_date date [note: 'Date when this training program version is no longer valid or available for new assignments. Null if the training has no planned end date.']
  format varchar [note: 'Delivery method for the training program. Determines how learners access and complete the training. [ENUM-REF-CANDIDATE: Online|In-Person|Blended|Simulation|On-the-Job|Self-Study|Webinar|Video — 8 candidates stripped; promote to reference product]']
  frequency varchar [note: 'How often the training must be completed to maintain compliance. Drives recurrence scheduling and assignment logic. [ENUM-REF-CANDIDATE: Annual|Biennial|One-Time|Upon Hire|Upon Role Change|Quarterly|As Needed — 7 candidates stripped; promote to reference product]']
  frequency_months varchar [note: 'Numeric representation of training recurrence interval in months. Used for automated scheduling. Examples: 12 for annual, 24 for biennial, null for one-time.']
  keywords varchar [note: 'Comma-separated list of keywords and tags used for training catalog search and discovery.']
  last_review_date date [note: 'Date when the training content was last reviewed and validated for accuracy and regulatory compliance.']
  learning_objectives varchar [note: 'Summary of the key learning outcomes and competencies the training is designed to achieve. Used for curriculum mapping and competency tracking.']
  modified_timestamp timestamp [note: 'Timestamp when this training program record was last modified. Used for audit trail and change tracking.']
  next_review_date date [note: 'Scheduled date for the next content review. Used to trigger review workflows and ensure training remains current.']
  non_compliance_consequence varchar [note: 'Description of the organizational consequence for failing to complete required training. Examples: Loss of system access, disciplinary action, termination.']
  passing_score_threshold decimal(5,2) [note: 'Minimum score required to successfully complete the training, expressed as a percentage (0.00 to 100.00). Null if no assessment is required.']
  policy_reference varchar [note: 'Reference to the organizational policy or policies that this training supports. Links training to the governance framework.']
  priority_level varchar [note: 'Business priority assigned to this training program. Critical and High priority training may trigger escalation workflows for non-completion.']
  regulatory_authority varchar [note: 'The governing body or agency that mandates this training requirement. Examples: HHS Office for Civil Rights, OSHA, CMS, The Joint Commission, State Department of Health.']
  regulatory_mandate varchar [note: 'The specific regulation, statute, or accreditation standard that requires this training. Examples: HIPAA Privacy Rule 45 CFR 164.530(b), OSHA 29 CFR 1910.1030, Joint Commission HR.01.06.01.']
  retired_reason varchar [note: 'Explanation for why the training program was retired. Examples: Superseded by new version, Regulatory requirement removed, Content no longer relevant.']
  retired_timestamp timestamp [note: 'Timestamp when this training program was retired and removed from active use. Null if the training is still active or suspended.']
  review_cycle_months varchar [note: 'Frequency in months at which the training content must be reviewed for accuracy and regulatory alignment. Examples: 12, 24, 36.']
  supersedes_training_number varchar [note: 'Training program number that this version replaces. Used to track training evolution and ensure learners complete the most current version.']
  target_audience varchar [note: 'Description of the workforce population required to complete this training. May specify roles, departments, or all staff. Examples: All Staff, Clinical Staff, Physicians, Nurses, Environmental Services, IT Staff, Revenue Cycle Staff.']
  target_department varchar [note: 'Specific department or service line required to complete this training. Used for automated assignment rules.']
  target_role varchar [note: 'Specific job role or role category required to complete this training. Used for automated assignment rules.']
  training_description varchar [note: 'Detailed description of the training program content, scope, and purpose. Displayed to learners and used for catalog search.']
  training_name varchar [note: 'Full name of the compliance training program as displayed to learners and in catalogs.']
  training_number varchar [note: 'Business identifier for the training program, used for external reference and reporting. Typically follows format TRN-XXXXXX.']
  training_status varchar [note: 'Current lifecycle status of the training program. Active programs are available for assignment and completion.']
  training_type varchar [note: 'Category of compliance training program. Defines the subject matter and regulatory domain covered by the training. [ENUM-REF-CANDIDATE: HIPAA Privacy|HIPAA Security|Corporate Compliance|OSHA Bloodborne Pathogens|Fire Safety|Abuse and Neglect|Cultural Competency|Code of Conduct|Emergency Preparedness|Infection Control|Patient Rights|Workplace Violence Prevention|Hazardous Materials|Radiation Safety|Respiratory Protection|Other — 16 candidates stripped; promote to reference product]']
  vendor_course_code varchar [note: 'Unique identifier assigned by the external vendor for this training course. Used for integration and reporting with vendor learning management systems.']
  vendor_name varchar [note: 'Name of the external vendor or content provider if the training is sourced from a third party. Null for internally developed training.']
  version_number varchar [note: 'Version identifier for the training content. Incremented when training materials are updated. Format: major.minor (e.g., 2.1).']

  Note: 'Master catalog of all mandatory and elective compliance training programs required by regulation or organizational policy. Captures training program name, training type (HIPAA Privacy, HIPAA Security, Corporate Compliance, OSHA Bloodborne Pathogens, Fire Safety, Abuse/Neglect, Cultural Competency, Code of Conduct), regulatory mandate driving the requirement, target audience (role, department, all staff), training format (online, in-person, simulation), frequency (annual, biennial, one-time, upon hire), passing score threshold, and training status. Distinct from workforce.cme_activity which tracks clinical continuing education.'
}

Table compliance.training_completion {
  training_completion_id varchar [pk, note: 'Unique identifier for the training completion record. Primary key.']
  reattempted_training_completion_id varchar [note: 'Self-referencing FK on training_completion (reattempted_training_completion_id)']
  training_id varchar [note: 'Foreign key linking to compliance.training. Business justification: CRITICAL FIX: training_completion.training_program_id currently points to compliance.program.program_id, but it should point to compliance.training.training_id. Training completion records should refe']
  accreditation_body varchar [note: 'Name of the organization that accredited or approved this training program. Examples include ACCME, ANCC, state boards, or internal compliance committees.']
  assigned_date date [note: 'Date when the training program was assigned to the employee. Marks the start of the compliance obligation period.']
  attempt_number varchar [note: 'Sequential attempt number for this training completion. Increments when an employee retakes a failed training.']
  certificate_issued_date date [note: 'Date when the training certificate was officially issued. May differ from completion date for trainings requiring manual review or approval.']
  certificate_number varchar [note: 'Unique certificate or credential number issued upon successful completion. Used for external verification and audit documentation.']
  completion_date date [note: 'Date when the employee successfully completed the training program. Null if training is not yet completed.']
  completion_number varchar [note: 'Business identifier for this training completion event. May be used for certificate tracking and audit trails.']
  completion_status varchar [note: 'Current lifecycle status of the training completion record. Tracks progression from assignment through completion or expiration. [ENUM-REF-CANDIDATE: assigned|in_progress|completed|overdue|waived|expired|not_started — 7 candidates stripped; promote to reference product]']
  completion_timestamp timestamp [note: 'Precise timestamp when the training was marked complete in the Learning Management System (LMS). Used for audit trail and time-sensitive compliance verification.']
  continuing_education_credits decimal(5,2) [note: 'Number of Continuing Education (CE) or Continuing Medical Education (CME) credits awarded for this training completion. Used for professional licensure maintenance.']
  created_timestamp timestamp [note: 'Timestamp when this training completion record was first created in the data platform. Part of the audit trail.']
  credit_type varchar [note: 'Type of continuing education credit awarded. CME (Continuing Medical Education) for physicians, CEU (Continuing Education Unit) for general staff, CNE (Continuing Nursing Education) for nurses, or contact hours.']
  due_date date [note: 'Date by which the training must be completed to maintain compliance. Used for overdue tracking and escalation.']
  employee_department varchar [note: 'Department or organizational unit of the employee at the time of training completion. Captured for compliance reporting by department.']
  employee_facility varchar [note: 'Healthcare facility or location where the employee is assigned. Used for facility-level compliance reporting and Joint Commission readiness.']
  employee_role varchar [note: 'Job role or title of the employee at the time of training completion. Used for role-based compliance reporting and gap analysis.']
  escalation_date date [note: 'Date when the overdue training was escalated to management. Part of the compliance enforcement audit trail.']
  escalation_flag boolean [note: 'Indicates whether this overdue training has been escalated to management or compliance leadership. True if escalated, False otherwise.']
  expiration_date date [note: 'Date when this training completion expires and requires renewal. Null for one-time trainings that do not expire.']
  instructor_name varchar [note: 'Name of the instructor or facilitator who delivered the training. Applicable for in-person and instructor-led sessions.']
  last_reminder_sent_date date [note: 'Date when the most recent reminder notification was sent to the employee. Used for escalation timing and communication tracking.']
  modified_timestamp timestamp [note: 'Timestamp when this training completion record was last modified in the data platform. Used for change tracking and audit purposes.']
  notes varchar [note: 'Free-text notes or comments related to this training completion. May include special circumstances, technical issues, or compliance officer annotations.']
  pass_fail_status varchar [note: 'Indicates whether the employee passed or failed the training assessment. Not applicable for trainings without assessments.']
  passing_score_threshold decimal(5,2) [note: 'Minimum score required to pass the training. Captured at completion time to preserve historical pass/fail criteria.']
  regulatory_requirement_satisfied varchar [note: 'Citation or reference to the specific regulatory requirement satisfied by this training completion. Examples include HIPAA Privacy Rule, OSHA Bloodborne Pathogens Standard, Joint Commission standards.']
  reminder_sent_count varchar [note: 'Number of reminder notifications sent to the employee for this training assignment. Used for tracking engagement and escalation.']
  score_achieved decimal(5,2) [note: 'Numeric score or percentage achieved by the employee on the training assessment. Null if training does not include a scored assessment.']
  source_system_record_code varchar [note: 'Unique identifier of this training completion record in the source system. Used for data lineage and reconciliation.']
  training_duration_minutes varchar [note: 'Total time in minutes the employee spent completing the training. Captured from Learning Management System (LMS) tracking data.']
  training_location varchar [note: 'Physical or virtual location where the training was conducted. May be a facility name, room number, or online platform identifier.']
  training_method varchar [note: 'Method by which the training was delivered to the employee. Used for effectiveness analysis and compliance documentation.']
  waiver_approval_date date [note: 'Date when the training waiver was officially approved. Part of the compliance audit trail.']
  waiver_approved_by varchar [note: 'Name or identifier of the authority who approved the training waiver. Required for audit trail when waiver is granted.']
  waiver_flag boolean [note: 'Indicates whether the training requirement was waived for this employee. True if waived, False otherwise.']
  waiver_reason varchar [note: 'Business justification for waiving the training requirement. Required when waiver_flag is True. Subject to compliance review.']

  Note: 'Transactional record of each individual staff member\'s completion of a required compliance training program. Captures employee reference, training program reference, assigned date, completion date, training method, score achieved, pass/fail status, certificate number, expiration date, and completion status (assigned, in progress, completed, overdue, waived). Enables compliance reporting on training completion rates by department, role, and regulatory requirement. Supports Joint Commission HR.01.05 and OIG compliance program documentation.'
}

Table compliance.compliance_regulatory_submission {
  compliance_regulatory_submission_id varchar [pk, note: 'Unique identifier for the regulatory submission record. Primary key.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Regulatory submissions with penalties or fees must post to specific GL accounts. Currently has penalty_currency_code but no GL account FK. Enables proper financial recording of regulatory penalties, s']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: Regulatory submissions (CMS quality reporting, state claims data, HEDIS) must document which ICD/CPT/HCPCS code set versions were used for the reporting period, required for data validation and audit ']
  compliance_program_id varchar [note: 'Identifier of the enterprise compliance program under which this submission is managed.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Regulatory submissions are prepared by specific departments. The cost of preparation, external consultants, and submission fees should be tracked against the responsible cost center for budget managem']
  financial_entity_id varchar [note: 'Identifier of the healthcare facility, hospital, clinic, or organizational unit that is filing the regulatory submission.']
  obligation_id varchar [note: 'Identifier linking this submission to the specific regulatory requirement or obligation it satisfies.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Many regulatory submissions are payer-specific: CMS cost reports, Medicare Advantage quality reporting (HEDIS/Stars), network adequacy filings, MLR reporting. Tracking which payer each submission rela']
  primary_original_submission_compliance_regulatory_submission_id varchar [note: 'Identifier of the original submission record if this is a resubmission or correction. Links to the prior submission that was rejected or withdrawn.']
  public_health_report_id varchar [note: 'Foreign key linking to interoperability.public_health_report. Business justification: Many regulatory submissions to CMS, CDC, and state agencies are transmitted via public health reporting interfaces. Linking submissions to their transmission records enables tracking of submission sta']
  regulatory_change_id varchar [note: 'Foreign key linking to compliance.regulatory_change. Business justification: Regulatory submissions may be triggered by new regulatory changes (e.g., new CMS reporting requirement). Each submission should optionally link to the regulatory change that triggered it. This allows ']
  acceptance_date date [note: 'Date on which the receiving agency formally accepted the submission as complete and compliant.']
  acknowledgment_date date [note: 'Date on which the receiving agency acknowledged receipt of the submission.']
  acknowledgment_number varchar [note: 'Confirmation or tracking number provided by the receiving agency upon acknowledgment of the submission.']
  acknowledgment_received_flag boolean [note: 'Indicates whether the receiving agency has acknowledged receipt of the submission. True = acknowledgment received, False = no acknowledgment received.']
  approval_date date [note: 'Date on which the submission was internally approved for filing with the regulatory agency.']
  attestation_date date [note: 'Date on which the authorized officer attested to the accuracy and completeness of the submission.']
  attestation_officer_name varchar [note: 'Name of the authorized officer (e.g., Chief Executive Officer, Chief Compliance Officer, Chief Medical Officer) who attested to the submission.']
  attestation_required_flag boolean [note: 'Indicates whether the submission requires a formal attestation or certification by an authorized officer. True = attestation required, False = no attestation required.']
  audit_date date [note: 'Date on which the external audit or validation of the submission was conducted.']
  audit_result varchar [note: 'Outcome of the external audit or validation. PASSED = submission validated as accurate, FAILED = submission found to be inaccurate or non-compliant, CONDITIONAL = passed with conditions or corrective actions required, PENDING = audit in progress, NOT_AUDITED = no audit conducted.']
  corrective_action_due_date date [note: 'Deadline by which corrective actions must be completed and documented in response to audit findings or agency feedback.']
  corrective_action_required_flag boolean [note: 'Indicates whether corrective actions are required as a result of audit findings or agency feedback. True = corrective action required, False = no corrective action required.']
  created_timestamp timestamp [note: 'Date and time when this regulatory submission record was first created in the system.']
  document_location_url varchar [note: 'File path, URL, or document management system reference where the submitted regulatory report or supporting documentation is stored.']
  due_date date [note: 'Regulatory deadline by which the submission must be filed to remain compliant.']
  external_audit_flag boolean [note: 'Indicates whether this submission is subject to external audit or validation by the regulatory agency or third-party auditor. True = subject to external audit, False = not subject to external audit.']
  modified_timestamp timestamp [note: 'Date and time when this regulatory submission record was last updated or modified.']
  notes varchar [note: 'Free-text field for additional comments, context, or internal notes related to the regulatory submission, including special circumstances, challenges, or follow-up actions.']
  penalty_amount decimal(15,2) [note: 'Monetary penalty assessed by the regulatory agency for late, incomplete, or non-compliant submission, in US dollars.']
  penalty_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the penalty amount (e.g., USD for US dollars).']
  receiving_agency varchar [note: 'Name of the government agency, accrediting body, or regulatory authority receiving the submission (e.g., CMS, State Department of Health, OSHA, OCR, Joint Commission, CDC).']
  receiving_agency_code varchar [note: 'Standardized code or abbreviation for the receiving regulatory agency (e.g., CMS, OCR, OSHA, TJC, CDC).']
  rejection_date date [note: 'Date on which the receiving agency rejected the submission due to errors, incompleteness, or non-compliance.']
  rejection_reason varchar [note: 'Explanation or code provided by the receiving agency describing why the submission was rejected.']
  reporting_period_end_date date [note: 'End date of the time period covered by the regulatory submission.']
  reporting_period_start_date date [note: 'Start date of the time period covered by the regulatory submission (e.g., calendar quarter, fiscal year, annual period).']
  research_regulatory_submission_id varchar [note: 'FK to research regulatory submission for SSOT linkage']
  resubmission_required_flag boolean [note: 'Indicates whether the submission must be corrected and resubmitted. True = resubmission required, False = no resubmission required.']
  risk_level varchar [note: 'Assessment of the compliance risk associated with this submission, including potential penalties for non-compliance or late filing.']
  ssot_canonical_reference varchar [note: 'Reference to the canonical SSOT record when this record is deprecated or merged']
  ssot_reconciliation_status varchar [note: 'Status indicating reconciliation state with related SSOT entity: ACTIVE, DEPRECATED, MERGED, SUPERSEDED']
  submission_date date [note: 'Date on which the regulatory submission was filed or transmitted to the receiving agency.']
  submission_format varchar [note: 'Data format or file type of the regulatory submission. XML = Extensible Markup Language, JSON = JavaScript Object Notation, CSV = comma-separated values, PDF = Portable Document Format, HL7_V2 = Health Level Seven Version 2 message, FHIR = Fast Healthcare Interoperability Resources. [ENUM-REF-CANDIDATE: XML|JSON|CSV|PDF|HL7_V2|FHIR|PAPER|OTHER — 8 candidates stripped; promote to reference product]']
  submission_method varchar [note: 'Method or channel used to transmit the regulatory submission. ELECTRONIC_PORTAL = web-based agency portal, EMAIL = email transmission, FAX = facsimile, MAIL = postal mail, API = application programming interface, HL7_INTERFACE = Health Level Seven (HL7) electronic interface, SFTP = secure file transfer protocol. [ENUM-REF-CANDIDATE: ELECTRONIC_PORTAL|EMAIL|FAX|MAIL|API|HL7_INTERFACE|SFTP|OTHER — 8 candidates stripped; promote to reference product]']
  submission_number varchar [note: 'Business identifier or tracking number assigned to the regulatory submission, often used for external reference and correspondence with regulatory agencies.']
  submission_priority varchar [note: 'Priority level assigned to the regulatory submission based on urgency, risk, or regulatory importance. CRITICAL = immediate action required, HIGH = high importance, MEDIUM = standard priority, LOW = routine submission.']
  submission_status varchar [note: 'Current lifecycle status of the regulatory submission. DRAFT = being prepared, PENDING_REVIEW = awaiting internal approval, SUBMITTED = sent to regulatory agency, ACKNOWLEDGED = receipt confirmed by agency, ACCEPTED = approved by agency, REJECTED = not accepted by agency, RESUBMITTED = corrected and resubmitted after rejection, WITHDRAWN = submission cancelled. [ENUM-REF-CANDIDATE: DRAFT|PENDING_REVIEW|SUBMITTED|ACKNOWLEDGED|ACCEPTED|REJECTED|RESUBMITTED|WITHDRAWN — 8 candidates stripped; promote to reference product]']
  submission_timestamp timestamp [note: 'Precise date and time when the regulatory submission was transmitted to the receiving agency, including time zone.']
  submission_type varchar [note: 'Category of regulatory submission. CMS_IQR = Centers for Medicare and Medicaid Services (CMS) Inpatient Quality Reporting, CMS_OQR = CMS Outpatient Quality Reporting, CMS_IPFQR = CMS Inpatient Psychiatric Facility Quality Reporting, STATE_LICENSURE = State health department facility licensure reports, OSHA_300 = Occupational Safety and Health Administration (OSHA) Log of Work-Related Injuries and Illnesses, OSHA_300A = OSHA Annual Summary, OCR_BREACH = Office for Civil Rights (OCR) breach notification under HIPAA, OIG_SELF_DISCLOSURE = Office of Inspector General (OIG) self-disclosure of potential fraud or abuse, JOINT_COMMISSION_PPR = Joint Commission Periodic Performance Review, CDC_NHSN_HAI = Centers for Disease Control and Prevention (CDC) National Healthcare Safety Network (NHSN) Healthcare-Associated Infection (HAI) reporting. [ENUM-REF-CANDIDATE: CMS_IQR|CMS_OQR|CMS_IPFQR|STATE_LICENSURE|OSHA_300|OSHA_300A|OCR_BREACH|OIG_SELF_DISCLOSURE|JOINT_COMMISSION_PPR|CDC_NHSN_HAI|OTHER — 11 candidates stripped; promote to reference product]']
  submitting_entity_npi varchar [note: 'Ten-digit National Provider Identifier (NPI) of the submitting healthcare organization, as assigned by CMS.']
  vibe_reconciled_flag boolean

  Note: 'Transactional record of mandatory regulatory data submissions and reports filed with government agencies and accrediting bodies. Covers CMS quality measure reporting (IQR, OQR, IPFQR), state health department licensure reports, OSHA 300/300A annual injury logs, OCR breach notifications, OIG self-disclosures, Joint Commission periodic performance reviews, and CDC NHSN HAI reporting. Captures submission type, submitting entity, receiving agency, reporting period, submission date, submission method (electronic, paper, portal), submission status, and acknowledgment receipt. Distinct from quality.regulatory_submission which is quality-measure-specific.'
}

Table compliance.exclusion_screening {
  exclusion_screening_id varchar [pk, note: 'Unique identifier for the exclusion screening record.']
  compliance_program_id varchar [note: 'Reference to the compliance program under which this screening was performed.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Screening programs are operated by compliance departments with associated costs (vendor fees, staff time). These costs must be allocated to the responsible cost center for budget tracking, vendor spen']
  primary_exclusion_employee_id varchar [note: 'Reference to the individual being screened (employee, contractor, or medical staff member).']
  prior_exclusion_screening_id varchar [note: 'Self-referencing FK on exclusion_screening (prior_exclusion_screening_id)']
  reference_npi_registry_id varchar [note: 'Foreign key linking to reference.npi_registry. Business justification: Exclusion screening validates NPIs against the national registry to ensure screened providers are correctly identified (name, address, taxonomy) before checking OIG/SAM exclusion databases for complia']
  screened_payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Healthcare organizations must screen payers and health plans for OIG/SAM exclusions to ensure they are not contracting with excluded entities. This is a regulatory requirement for federal program part']
  audit_trail varchar [note: 'Comprehensive audit trail documenting all actions, reviews, and decisions related to this screening record.']
  created_timestamp timestamp [note: 'Timestamp when the exclusion screening record was first created in the system.']
  exclusion_authority varchar [note: 'Government agency or authority that imposed the exclusion (e.g., OIG, GSA, State Medicaid).']
  exclusion_date date [note: 'Date when the exclusion was imposed by the regulatory authority.']
  exclusion_type varchar [note: 'Type or category of exclusion found (e.g., mandatory, permissive, conviction-related, license revocation).']
  exclusion_waiver_state varchar [note: 'Two-letter state code where a waiver from the exclusion may apply, if applicable.']
  match_confidence_level varchar [note: 'Confidence level of the match found during screening (high, medium, or low) based on data quality and matching criteria.']
  match_details varchar [note: 'Detailed information about the exclusion match found, including name matched, identifier matched, and exclusion reason.']
  match_found_flag boolean [note: 'Boolean indicator of whether a match was found on any exclusion list during screening.']
  modified_timestamp timestamp [note: 'Timestamp when the exclusion screening record was last modified or updated.']
  next_screening_date date [note: 'Scheduled date for the next exclusion screening check for this individual or entity.']
  notification_sent_date date [note: 'Date when notification about the screening result was sent to relevant stakeholders.']
  notification_sent_flag boolean [note: 'Boolean indicator of whether notification was sent to relevant stakeholders about the screening result.']
  reinstatement_date date [note: 'Date when the excluded individual or entity is eligible for reinstatement to federal healthcare programs.']
  resolution_action varchar [note: 'Action taken in response to the screening result (e.g., employment terminated, contract cancelled, credentialing denied, further investigation required).']
  resolution_date date [note: 'Date when the screening result was resolved and final action was taken.']
  resolution_notes varchar [note: 'Free-text notes documenting the resolution process, investigation findings, and rationale for action taken.']
  resolution_status varchar [note: 'Current status of the resolution process for the screening result (pending review, cleared, confirmed exclusion, action taken, or escalated).']
  risk_level varchar [note: 'Risk level assigned to this screening result based on entity type, role, and match findings.']
  screened_business_name varchar [note: 'Legal business name of the vendor or organization being screened.']
  screened_date_of_birth date [note: 'Date of birth of the individual being screened, used for identity verification and matching.']
  screened_entity_type varchar [note: 'Type of entity being screened for exclusion status (employee, contractor, vendor, medical staff, volunteer, or board member).']
  screened_first_name varchar [note: 'First name of the individual being screened for exclusion status.']
  screened_last_name varchar [note: 'Last name of the individual being screened for exclusion status.']
  screened_middle_name varchar [note: 'Middle name or initial of the individual being screened.']
  screened_ssn varchar [note: 'Social Security Number of the individual being screened, used for matching against exclusion lists.']
  screened_state varchar [note: 'Two-letter state code where the screened individual or business is located or licensed.']
  screening_date date [note: 'Date when the exclusion screening check was performed.']
  screening_frequency_months varchar [note: 'Number of months between required exclusion screening checks for this entity type.']
  screening_method varchar [note: 'Method used to perform the exclusion screening (automated system, manual search, or third-party vendor service).']
  screening_result varchar [note: 'Outcome of the exclusion screening check indicating whether the entity is clear, a match was found, result is inconclusive, or an error occurred.']
  screening_source varchar [note: 'Source database used for the exclusion screening check (OIG LEIE, SAM.gov, state Medicaid exclusion list, or combined search).']
  screening_transaction_number varchar [note: 'Unique transaction identifier from the screening vendor or system for audit trail purposes.']
  screening_vendor_name varchar [note: 'Name of the third-party vendor or service used to perform the exclusion screening, if applicable.']

  Note: 'Transactional record of OIG and SAM.gov exclusion screening checks performed on employees, contractors, vendors, and medical staff to verify they are not excluded from participation in federal healthcare programs (Medicare, Medicaid). Captures screened individual or entity, screening date, screening source (OIG LEIE, SAM.gov, state Medicaid exclusion list), screening result (clear, match found, inconclusive), match details if found, resolution action, and next scheduled screening date. Required by OIG compliance program guidance and CMS enrollment rules.'
}

Table compliance.conflict_of_interest {
  conflict_of_interest_id varchar [pk, note: 'Unique identifier for the conflict of interest disclosure record.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or location where the disclosing individual is primarily assigned.']
  primary_conflict_employee_id varchar [note: 'Identifier of the employee, medical staff member, board member, or contractor submitting the disclosure.']
  prior_conflict_of_interest_id varchar [note: 'Self-referencing FK on conflict_of_interest (prior_conflict_of_interest_id)']
  reviewer_employee_id varchar [note: 'Identifier of the compliance officer or committee member who reviewed the disclosure.']
  approval_authority varchar [note: 'The role or body that has authority to approve or reject the disclosure: compliance officer, ethics committee, chief compliance officer, board of directors, or department head.']
  approval_date date [note: 'Date when the disclosure was formally approved by the designated authority.']
  attestation_date date [note: 'Date when the disclosing individual signed the attestation affirming the disclosure.']
  attestation_statement varchar [note: 'Text of the attestation statement signed by the disclosing individual affirming the accuracy and completeness of the disclosure.']
  audit_trail_notes varchar [note: 'Free-text notes capturing key events, decisions, and communications throughout the disclosure lifecycle for audit and compliance tracking purposes.']
  confidentiality_level varchar [note: 'Data classification level for the disclosure record: restricted (highest sensitivity), confidential (business-sensitive), or internal (standard operational data).']
  created_timestamp timestamp [note: 'Timestamp when the conflict of interest disclosure record was first created in the system.']
  department_name varchar [note: 'Name of the department or division where the disclosing individual works or is affiliated.']
  disclosed_entity_name varchar [note: 'Name of the external organization, vendor, research sponsor, or individual with whom the conflict of interest relationship exists.']
  disclosed_entity_type varchar [note: 'Classification of the disclosed entity: vendor, supplier, competitor, research sponsor, pharmaceutical company, device manufacturer, consulting firm, healthcare provider, or other. [ENUM-REF-CANDIDATE: vendor|supplier|competitor|research_sponsor|pharmaceutical_company|device_manufacturer|consulting_firm|healthcare_provider|other — 9 candidates stripped; promote to reference product]']
  disclosing_individual_role varchar [note: 'Role or affiliation of the individual submitting the disclosure: employee, medical staff, board member, contractor, volunteer, or vendor representative.']
  disclosure_date date [note: 'Date when the conflict of interest disclosure was submitted by the individual.']
  disclosure_number varchar [note: 'Externally-known unique business identifier for the conflict of interest disclosure.']
  disclosure_status varchar [note: 'Current lifecycle status of the conflict of interest disclosure: submitted, under review by compliance, approved without conditions, approved with mitigation plan, rejected, or withdrawn by disclosing individual.']
  disclosure_type varchar [note: 'Type of disclosure submission: initial disclosure, annual recertification, material change update, or ad-hoc disclosure.']
  estimated_value_amount decimal(15,2) [note: 'Estimated monetary value of the financial interest or relationship in US dollars.']
  expiration_date date [note: 'Date when the disclosed relationship or financial interest is expected to end or when the disclosure record expires and requires renewal.']
  last_recertification_date date [note: 'Date of the most recent annual recertification submission for this conflict of interest.']
  mitigation_effective_date date [note: 'Date when the mitigation plan became effective and enforceable.']
  mitigation_plan varchar [note: 'Detailed description of the mitigation actions, controls, or restrictions put in place to manage the conflict of interest, such as recusal from decisions, disclosure to stakeholders, or divestiture.']
  mitigation_required_flag boolean [note: 'Indicates whether a mitigation plan is required to manage the conflict of interest (True) or not (False).']
  modified_timestamp timestamp [note: 'Timestamp when the conflict of interest disclosure record was last modified or updated.']
  recertification_due_date date [note: 'Date by which the individual must submit an annual recertification or update of the conflict of interest disclosure.']
  regulatory_requirement_reference varchar [note: 'Citation of the specific regulatory requirement or compliance program element that mandates this disclosure, such as Stark Law, Anti-Kickback Statute, or OIG guidance.']
  rejection_reason varchar [note: 'Explanation provided by the compliance authority for rejecting the disclosure or determining that the conflict cannot be adequately mitigated.']
  relationship_description varchar [note: 'Detailed narrative description of the nature of the conflict of interest relationship, including roles, responsibilities, and interactions.']
  relationship_type varchar [note: 'Category of the conflict of interest relationship being disclosed: financial interest, outside employment, family relationship with vendor or employee, vendor relationship, research sponsorship, or consulting arrangement.']
  review_completion_date date [note: 'Date when the compliance review of the disclosure was completed and a determination was made.']
  review_start_date date [note: 'Date when the compliance review of the disclosure began.']
  supporting_documentation_url varchar [note: 'URL or file path to supporting documentation provided with the disclosure, such as contracts, financial statements, or correspondence.']
  value_range varchar [note: 'Categorical range of the estimated value: under $5,000, $5,000 to $25,000, $25,000 to $100,000, over $100,000, or not applicable for non-financial relationships.']

  Note: 'Master and transactional record for conflict of interest (COI) disclosures submitted by employees, medical staff, board members, and contractors. Captures disclosing individual, disclosure date, relationship type (financial interest, outside employment, family relationship, vendor relationship, research sponsorship), disclosed entity, estimated value, disclosure status (submitted, under review, approved, approved with mitigation, rejected), mitigation plan, and annual recertification date. Required by OIG compliance program guidance, Stark Law, and Anti-Kickback Statute compliance programs.'
}

Table compliance.hotline_report {
  hotline_report_id varchar [pk, note: 'Unique identifier for the compliance hotline report. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the alleged incident occurred or is relevant.']
  original_hotline_report_id varchar [note: 'Self-referencing FK on hotline_report (original_hotline_report_id)']
  primary_hotline_reporter_employee_id varchar [note: 'Employee identifier of the reporter if they are an internal employee. Null if external reporter or anonymous.']
  tertiary_hotline_employee_id varchar [note: 'Employee identifier of the compliance officer or investigator assigned to review and investigate this report.']
  allegation_category varchar [note: 'Primary category of the compliance concern or ethics violation alleged: billing fraud, privacy violation, workplace safety, abuse/neglect, conflict of interest, retaliation, or code of conduct violation. [ENUM-REF-CANDIDATE: billing_fraud|privacy_violation|workplace_safety|abuse_neglect|conflict_of_interest|retaliation|code_of_conduct|discrimination|harassment|data_breach|regulatory_violation|quality_of_care|environmental_safety — promote to reference product]']
  allegation_description varchar [note: 'Detailed narrative description of the compliance concern, potential violation, or ethics issue as reported by the submitter.']
  allegation_subcategory varchar [note: 'More specific classification of the allegation within the primary category, providing additional detail on the nature of the concern.']
  assigned_investigator_name varchar [note: 'Name of the compliance officer or investigator assigned to this case.']
  case_notes varchar [note: 'Internal notes and documentation maintained by the compliance team throughout the investigation lifecycle.']
  confidentiality_level varchar [note: 'Classification of the sensitivity and confidentiality requirements for this hotline report and investigation materials.']
  corrective_action_completion_date date [note: 'Actual date when all required corrective actions were completed and verified.']
  corrective_action_description varchar [note: 'Description of the corrective actions taken or planned in response to substantiated compliance concerns.']
  corrective_action_due_date date [note: 'Target date by which corrective actions must be completed.']
  corrective_action_required_flag boolean [note: 'Indicates whether corrective action is required as a result of the investigation findings. True if action required, False otherwise.']
  created_timestamp timestamp [note: 'System timestamp when this hotline report record was first created in the compliance management system.']
  department_implicated varchar [note: 'Name or code of the department or unit where the alleged compliance concern occurred.']
  disposition varchar [note: 'Final determination of the investigation: substantiated (violation confirmed), unsubstantiated (no violation found), inconclusive (insufficient evidence), or pending (investigation ongoing).']
  disposition_notes varchar [note: 'Detailed explanation of the investigation findings, rationale for the disposition, and any supporting evidence or context.']
  follow_up_date date [note: 'Scheduled date for follow-up communication with the reporter or additional investigation activities.']
  follow_up_required_flag boolean [note: 'Indicates whether additional follow-up with the reporter or further investigation is required. True if follow-up needed, False otherwise.']
  incident_date date [note: 'Date when the alleged incident or compliance violation occurred, as reported or estimated.']
  incident_date_range_end date [note: 'End date of the period during which the alleged incident occurred, if the incident spanned multiple dates.']
  incident_date_range_start date [note: 'Start date of the period during which the alleged incident occurred, if the incident spanned multiple dates.']
  individual_implicated_name varchar [note: 'Name of the individual(s) allegedly involved in the compliance concern, if identified in the report.']
  investigation_completion_date date [note: 'Date when the investigation was completed and findings were documented.']
  investigation_start_date date [note: 'Date when the formal investigation into the reported concern was initiated.']
  investigation_status varchar [note: 'Current status of the investigation into the reported compliance concern: new, assigned, in progress, pending additional information, completed, or closed.']
  modified_timestamp timestamp [note: 'System timestamp when this hotline report record was last updated or modified.']
  priority_level varchar [note: 'Priority assigned to the investigation and resolution of this report: urgent, high, normal, or low.']
  regulatory_authority_notified varchar [note: 'Name of the external regulatory authority or governing body that was notified of the substantiated violation (e.g., CMS, OIG, OCR, state health department).']
  regulatory_notification_date date [note: 'Date when the external regulatory authority was formally notified of the substantiated violation.']
  regulatory_reporting_required_flag boolean [note: 'Indicates whether the substantiated violation requires mandatory reporting to external regulatory authorities (CMS, OIG, state health department, etc.). True if external reporting required, False otherwise.']
  report_channel varchar [note: 'Method through which the compliance concern was reported: hotline, online portal, direct report to compliance officer, email, mail, or in-person.']
  report_date date [note: 'Date when the compliance concern or ethics report was submitted through the hotline or reporting system.']
  report_number varchar [note: 'Business identifier for the hotline report, formatted as HR- followed by 8 digits. Used for external reference and tracking.']
  report_timestamp timestamp [note: 'Precise date and time when the report was received by the compliance system.']
  reporter_anonymity_flag boolean [note: 'Indicates whether the reporter chose to remain anonymous. True if anonymous, False if reporter provided identity.']
  reporter_contact_email varchar [note: 'Email address of the reporter for follow-up communication, if provided. Null if anonymous or not provided.']
  reporter_contact_phone varchar [note: 'Phone number of the reporter for follow-up, if provided. Null if anonymous or not provided.']
  reporter_name varchar [note: 'Name of the individual who submitted the report, if not anonymous. Null if reporter chose anonymity.']
  resolution_date date [note: 'Date when the hotline report was formally closed and all required actions were completed.']
  retaliation_concern_flag boolean [note: 'Indicates whether the reporter expressed concern about potential retaliation for making the report. True if retaliation concern noted, False otherwise.']
  severity_level varchar [note: 'Initial assessment of the severity or potential impact of the alleged compliance concern: critical, high, medium, or low.']

  Note: 'Transactional record of compliance concerns, potential violations, and ethics reports submitted through the organizations compliance hotline, anonymous reporting system, or direct compliance officer reports. Captures report date, report channel (hotline, online portal, direct report, email), reporter anonymity flag, allegation category (billing fraud, privacy violation, workplace safety, abuse/neglect, conflict of interest, retaliation, code of conduct), facility or department implicated, investigation status, disposition (substantiated, unsubstantiated, inconclusive), and resolution date. Required by OIG compliance program element 4.'
}

Table compliance.investigation {
  investigation_id varchar [pk, note: 'Unique identifier for the compliance investigation record. Primary key.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Investigation can be triggered by audit_finding. When trigger_source=\'audit_finding\', the investigation should have a structured FK to audit_finding. This is in addition to the hotline_report_id FK - ']
  care_site_id varchar [note: 'Identifier of the healthcare facility or location where the alleged violation occurred, if applicable.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Investigations consume departmental resources. Investigation costs (staff time, legal fees, consultant fees) must be tracked against the responsible department\'s cost center for budget management, cos']
  hotline_report_id varchar [note: 'Foreign key linking to compliance.hotline_report. Business justification: Investigation can be triggered by hotline_report. The trigger_reference_number (STRING) should be replaced with a structured FK hotline_report_id when trigger_source=\'hotline\'. This creates a clear au']
  investigation_employee_id varchar [note: 'System user identifier of the person who last modified this investigation record. Used for audit trail and accountability.']
  investigation_investigator_employee_id varchar [note: 'Identifier of the primary compliance officer or investigator assigned to lead this investigation.']
  message_log_id varchar [note: 'Foreign key linking to interoperability.message_log. Business justification: Compliance investigations of privacy breaches, security incidents, or data integrity issues frequently require review of message exchange logs as evidence. Linking investigations to specific message l']
  parent_investigation_id varchar [note: 'Self-referencing FK on investigation (related_investigation_id)']
  phi_access_log_id varchar [note: 'Foreign key linking to compliance.phi_access_log. Business justification: Investigations into unauthorized PHI access require direct linkage to the access log entries being investigated for evidence chain, timeline reconstruction, and disciplinary action documentation.']
  privacy_incident_hipaa_privacy_incident_id varchar [note: 'Foreign key linking to compliance.hipaa_privacy_incident. Business justification: Investigation can be triggered by HIPAA privacy incident. When trigger_source=\'privacy_incident\', the investigation should have a structured FK to hipaa_privacy_incident. This completes the set of tri']
  breach_notification_required_flag boolean [note: 'Indicator of whether the investigation findings triggered mandatory breach notification to patients, HHS OCR, or media under HIPAA Breach Notification Rule. True indicates notification obligation exists.']
  close_date date [note: 'Date on which the investigation was formally concluded and final determination documented. Null for open investigations.']
  conclusion varchar [note: 'Final determination of the investigation outcome. Violation confirmed indicates substantiated compliance breach. No violation indicates allegation not supported by evidence. Inconclusive indicates insufficient evidence to make determination. Pending review indicates investigation complete but awaiting final approval or legal review.']
  confidentiality_level varchar [note: 'Data classification level governing access to and disclosure of investigation records. Restricted indicates highest sensitivity requiring need-to-know access. Confidential indicates limited distribution. Internal indicates organization-wide access. Public indicates no restriction.']
  corrective_action_required_flag boolean [note: 'Indicator of whether the investigation findings require formal corrective action plan. True indicates CAP must be developed, approved, and tracked to completion.']
  created_timestamp timestamp [note: 'System timestamp recording when this investigation record was first created in the compliance management system. Used for audit trail and data lineage.']
  department_involved varchar [note: 'Primary department or business unit where the alleged violation occurred or that is the subject of the investigation.']
  disciplinary_action_taken_flag boolean [note: 'Indicator of whether employee disciplinary action was taken as a result of investigation findings, including counseling, suspension, termination, or other personnel action.']
  external_referral_agency varchar [note: 'Name of external regulatory, law enforcement, or oversight agency to which the investigation was referred, such as HHS OIG, DOJ, FBI, OCR, state attorney general, or state health department.']
  external_referral_date date [note: 'Date on which the investigation was formally referred to external authority. Null if no external referral made.']
  financial_impact_amount decimal(15,2) [note: 'Estimated or calculated financial impact of the violation in US dollars, including overpayments, penalties, refunds, or potential liability exposure. Used for self-disclosure calculations and reserve estimation.']
  findings_summary varchar [note: 'Comprehensive narrative summary of the investigation findings, including evidence reviewed, interviews conducted, timeline of events, root cause analysis, and factual determinations. This field supports legal privilege and compliance program documentation.']
  investigation_number varchar [note: 'Business-facing unique investigation case number assigned at initiation, formatted as INV-YYYYNNNN for tracking and reference in compliance documentation and legal proceedings.']
  investigation_status varchar [note: 'Current lifecycle status of the investigation. Initiated indicates case opened but not yet assigned. Active indicates investigation in progress. Suspended indicates temporarily paused pending additional information. Closed indicates investigation concluded. Escalated indicates elevated to senior leadership or legal counsel. Referred external indicates case transferred to external authority such as OIG, OCR, or law enforcement.']
  investigation_type varchar [note: 'Classification of the investigation based on the nature of the alleged compliance violation. Privacy breach covers HIPAA violations and unauthorized PHI disclosure. Billing fraud includes upcoding, unbundling, and false claims. Workplace safety covers OSHA violations. Abuse/neglect includes patient harm and mistreatment. Anti-kickback covers illegal remuneration. Stark violation covers physician self-referral violations.']
  investigator_name varchar [note: 'Full name of the primary investigator assigned to this case for business reporting and audit trail purposes.']
  legal_privilege_asserted_flag boolean [note: 'Indicator of whether attorney-client privilege or attorney work product privilege has been asserted over investigation materials. True indicates privileged status requiring special handling and access controls.']
  modified_timestamp timestamp [note: 'System timestamp recording the most recent update to this investigation record. Used for audit trail and change tracking.']
  notes varchar [note: 'Free-form text field for investigator notes, observations, and supplementary information not captured in structured fields. May include interview summaries, document references, and investigative leads.']
  patient_count varchar [note: 'Number of distinct patients affected by or involved in the alleged violation. Used to assess breach notification requirements under HIPAA and scope of potential harm.']
  patient_involved_flag boolean [note: 'Indicator of whether the investigation involves a specific patient or patient PHI. True indicates patient-specific investigation requiring additional privacy protections and breach notification assessment.']
  priority_level varchar [note: 'Urgency classification of the investigation based on severity of alleged violation, potential financial impact, patient safety risk, and regulatory exposure. Critical indicates immediate patient safety or significant regulatory risk. High indicates substantial compliance risk. Medium indicates moderate risk. Low indicates minor or technical violation.']
  recommended_actions varchar [note: 'Detailed recommendations for corrective and preventive actions resulting from investigation findings, including policy revisions, training requirements, system controls, disciplinary actions, and process improvements.']
  regulatory_citation varchar [note: 'Specific regulatory statute, rule, or standard that was violated, including citation reference such as HIPAA 45 CFR 164.502, False Claims Act 31 USC 3729, Stark Law 42 USC 1395nn, Anti-Kickback Statute 42 USC 1320a-7b, or OSHA standard number.']
  risk_rating varchar [note: 'Assessment of the potential organizational risk exposure associated with the alleged violation, considering financial, reputational, regulatory, and patient safety dimensions.']
  scope_description varchar [note: 'Detailed narrative describing the boundaries and focus of the investigation, including specific allegations, time period under review, departments or individuals involved, and types of evidence to be examined.']
  self_disclosure_date date [note: 'Date on which voluntary self-disclosure was submitted to the applicable regulatory authority. Null if no disclosure required or not yet submitted.']
  self_disclosure_required_flag boolean [note: 'Indicator of whether the investigation findings require voluntary self-disclosure to regulatory authority such as OIG, CMS, or OCR under self-disclosure protocols. True indicates disclosure obligation exists.']
  start_date date [note: 'Date on which the formal investigation was officially opened and investigative activities commenced. Used to track timeliness of investigation response and compliance with regulatory reporting deadlines.']
  target_due_date date [note: 'Target completion date for the investigation based on regulatory timelines, internal SLA, or urgency classification. Used to monitor investigation timeliness and escalate overdue cases.']
  trigger_source varchar [note: 'Origin or channel through which the investigation was initiated. Hotline report indicates anonymous or named report through compliance hotline. Audit finding indicates discovery during internal or external audit. Self-disclosure indicates proactive identification by organization. External referral indicates notification from regulatory body, payer, or law enforcement. Patient complaint indicates grievance filed by patient or family. Employee report indicates direct report from staff member. Regulatory inquiry indicates investigation prompted by CMS, OCR, or state agency request. [ENUM-REF-CANDIDATE: hotline_report|audit_finding|self_disclosure|external_referral|patient_complaint|employee_report|regulatory_inquiry — 7 candidates stripped; promote to reference product]']
  violation_confirmed_flag boolean [note: 'Boolean indicator of whether the investigation substantiated a compliance violation. True indicates confirmed violation requiring corrective action and potential self-disclosure.']

  Note: 'Transactional record of formal compliance investigations initiated in response to hotline reports, audit findings, self-disclosures, or external referrals. Captures investigation number, investigation type (privacy breach, billing fraud, workplace safety, abuse/neglect, anti-kickback, Stark), trigger source, investigator assigned, investigation start date, investigation scope, findings summary, conclusion (violation confirmed, no violation, inconclusive), recommended actions, and investigation close date. Supports OIG compliance program documentation and legal privilege management.'
}

Table compliance.stark_arrangement {
  stark_arrangement_id varchar [pk, note: 'Unique identifier for the Stark Law financial arrangement record. Primary key for the stark_arrangement product.']
  clinician_id varchar [note: 'Identifier for the physician party to the financial arrangement. Links to the provider master record.']
  financial_entity_id varchar [note: 'Identifier for the healthcare entity party to the financial arrangement. Links to the facility or organizational unit master record.']
  reference_npi_registry_id varchar [note: 'Foreign key linking to reference.npi_registry. Business justification: Stark law compliance requires validating physician NPI details, taxonomy codes, and practice locations against the national registry for arrangement documentation, disclosure, and annual attestation p']
  renewed_stark_arrangement_id varchar [note: 'Self-referencing FK on stark_arrangement (renewed_stark_arrangement_id)']
  arrangement_number varchar [note: 'Business-assigned unique identifier or reference number for the Stark arrangement, used for tracking and reporting purposes.']
  arrangement_status varchar [note: 'Current lifecycle status of the Stark arrangement indicating whether it is in force, under compliance review, or has ended.']
  arrangement_type varchar [note: 'Classification of the financial arrangement between the physician and entity. Determines which Stark exception may apply. [ENUM-REF-CANDIDATE: employment|personal_services|fair_market_value_lease|equipment_lease|recruitment|indirect_compensation|space_rental|medical_director|call_coverage|academic_medical_center|other — 11 candidates stripped; promote to reference product]']
  commercial_reasonableness_determination varchar [note: 'Assessment of whether the arrangement is commercially reasonable and would make sense even in the absence of referrals between the parties.']
  commercial_reasonableness_rationale varchar [note: 'Business justification and rationale supporting the commercial reasonableness determination.']
  compensation_amount decimal(18,2) [note: 'Total annual or per-period compensation amount paid to the physician under the arrangement, in US dollars.']
  compensation_frequency varchar [note: 'Frequency at which compensation is paid to the physician under the arrangement.']
  compensation_structure varchar [note: 'Method by which the physician is compensated under the arrangement. Critical for determining compliance with volume or value of referrals standards. [ENUM-REF-CANDIDATE: fixed_salary|hourly_rate|per_service|percentage_of_revenue|productivity_based|hybrid|other — 7 candidates stripped; promote to reference product]']
  contract_document_location varchar [note: 'File path, URL, or document management system reference to the executed contract or agreement governing the arrangement.']
  created_timestamp timestamp [note: 'Date and time when the Stark arrangement record was first created in the compliance management system.']
  designated_health_services_involved varchar [note: 'List of designated health services (clinical lab, radiology, DME, etc.) to which the physician may refer under this arrangement, triggering Stark Law applicability.']
  disclosure_date date [note: 'Date on which the arrangement was disclosed to CMS under the Self-Referral Disclosure Protocol, if applicable.']
  disclosure_reference_number varchar [note: 'CMS-assigned reference number for the self-referral disclosure submission, if applicable.']
  disclosure_required_flag boolean [note: 'Indicates whether the arrangement must be disclosed to CMS under the Self-Referral Disclosure Protocol due to potential non-compliance.']
  effective_date date [note: 'Date on which the Stark arrangement becomes legally binding and active.']
  exception_criteria_met varchar [note: 'Detailed documentation of how the arrangement satisfies all required elements of the claimed Stark exception.']
  expiration_date date [note: 'Date on which the Stark arrangement terminates or expires. Nullable for open-ended arrangements.']
  fmv_compliant_flag boolean [note: 'Indicates whether the compensation has been determined to be consistent with fair market value based on the valuation performed.']
  fmv_determination_method varchar [note: 'Methodology used to establish that the compensation is consistent with fair market value and not determined in a manner that takes into account the volume or value of referrals.']
  fmv_opinion_date date [note: 'Date on which the FMV opinion or valuation was issued.']
  fmv_opinion_source varchar [note: 'Name of the independent valuation firm, consultant, or survey source that provided the FMV opinion or benchmark data.']
  legal_approval_status varchar [note: 'Outcome of the legal compliance review indicating whether the arrangement has been approved as Stark-compliant.']
  legal_review_date date [note: 'Date on which the arrangement was last reviewed by legal counsel or compliance department for Stark Law compliance.']
  legal_reviewer_name varchar [note: 'Name of the attorney or compliance officer who conducted the Stark Law compliance review.']
  modified_by varchar [note: 'User ID or name of the compliance staff member who last modified the Stark arrangement record.']
  modified_timestamp timestamp [note: 'Date and time when the Stark arrangement record was last updated or modified.']
  next_review_date date [note: 'Scheduled date for the next periodic compliance review of the Stark arrangement.']
  notes varchar [note: 'Additional free-text notes, comments, or special considerations related to the Stark arrangement and its compliance status.']
  referral_volume_tracking_required boolean [note: 'Indicates whether ongoing monitoring of referral volume and value is required to ensure continued compliance with the exception.']
  review_frequency_months varchar [note: 'Number of months between required compliance reviews of the arrangement.']
  risk_rating varchar [note: 'Compliance risk assessment level for the arrangement based on structure, compensation method, and exception applicability.']
  stark_exception_applied varchar [note: 'Specific Stark Law exception (by CFR citation or common name) that the arrangement relies upon for compliance, such as employment exception, personal services exception, or fair market value compensation exception.']
  termination_date date [note: 'Actual date on which the arrangement was terminated prior to the scheduled expiration date, if applicable.']
  termination_reason varchar [note: 'Business or compliance reason for early termination of the Stark arrangement.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  created_by varchar [note: 'User ID or name of the compliance staff member who created the Stark arrangement record.']

  Note: 'Master record for every physician financial arrangement reviewed and documented for Stark Law (Physician Self-Referral Law) compliance. Captures arrangement type (employment, personal services, fair market value lease, recruitment, indirect compensation), physician party, entity party, arrangement start/end dates, compensation structure, fair market value (FMV) determination, FMV opinion source, commercial reasonableness determination, applicable Stark exception relied upon, arrangement status (active, expired, under review), and legal review date. Critical for CMS enrollment and self-disclosure protocol compliance.'
}

Table compliance.osha_safety_program {
  osha_safety_program_id varchar [pk, note: 'Unique identifier for the OSHA safety program record. Primary key.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Safety programs are owned by specific departments (typically EHS or Risk Management) and require budget allocation for implementation, training, and equipment. Cost center link enables budget tracking']
  parent_osha_safety_program_id varchar [note: 'Self-referencing FK on osha_safety_program (parent_osha_safety_program_id)']
  training_id varchar [note: 'Identifier of the training course associated with this safety program, linking to the learning management system.']
  approval_authority varchar [note: 'The role or title of the individual or committee authorized to approve the safety program (e.g., Chief Medical Officer, Safety Committee, Board of Directors).']
  approval_date date [note: 'The date when the safety program was formally approved by the designated authority.']
  attestation_frequency_months varchar [note: 'The frequency in months at which attestation must be completed for this safety program. Null if attestation is one-time or not required.']
  attestation_required_flag boolean [note: 'Indicates whether employees or managers must formally attest to compliance with this safety program (True) or not (False).']
  corrective_action_required_flag boolean [note: 'Indicates whether corrective actions are required to address deficiencies identified in the most recent audit (True) or not (False).']
  created_timestamp timestamp [note: 'The timestamp when this safety program record was first created in the system.']
  document_location_url varchar [note: 'The URL or file path where the official safety program document is stored and accessible to authorized personnel.']
  effective_date date [note: 'The date when the safety program became or will become operational and enforceable within the organization.']
  enforcement_mechanism varchar [note: 'Description of how compliance with this safety program is monitored and enforced (e.g., audits, inspections, incident investigations, self-assessments).']
  expiration_date date [note: 'The date when the safety program is scheduled to expire or be retired, if applicable. Null for ongoing programs.']
  external_audit_scope_flag boolean [note: 'Indicates whether this safety program is within the scope of external regulatory audits or inspections (True) or only subject to internal review (False).']
  finding_count varchar [note: 'The number of audit findings or deficiencies identified during the most recent audit of this safety program.']
  keywords varchar [note: 'Comma-separated list of keywords or tags for search and categorization of the safety program (e.g., PPE, exposure, hazmat, ergonomics).']
  last_audit_date date [note: 'The most recent date when an internal or external audit was conducted to assess compliance with this safety program.']
  last_audit_result varchar [note: 'The outcome of the most recent audit of this safety program, indicating the level of compliance found.']
  last_review_date date [note: 'The most recent date when the safety program was formally reviewed for compliance, effectiveness, and currency.']
  modified_timestamp timestamp [note: 'The timestamp when this safety program record was last modified in the system.']
  next_review_date date [note: 'The scheduled date for the next formal review of the safety program to ensure ongoing compliance and relevance.']
  non_compliance_consequence varchar [note: 'Description of the consequences for non-compliance with this safety program, including disciplinary actions, corrective measures, or regulatory penalties.']
  notes varchar [note: 'Free-text field for additional notes, comments, or context related to the safety program that do not fit in other structured fields.']
  osha_standard_citation varchar [note: 'The specific OSHA regulatory citation (e.g., 29 CFR 1910.1030 for Bloodborne Pathogens) that mandates or guides this safety program.']
  program_name varchar [note: 'Official name of the OSHA safety program (e.g., Bloodborne Pathogens Exposure Control Plan, Hazard Communication Program, Respiratory Protection Program).']
  program_number varchar [note: 'Business identifier for the safety program, used for external reference and reporting to regulatory authorities.']
  program_owner_department varchar [note: 'The department responsible for maintaining and overseeing the safety program (e.g., Environmental Health and Safety, Infection Control, Facilities Management).']
  program_purpose varchar [note: 'Detailed statement of the business and regulatory purpose of the safety program, including the hazards or risks it addresses.']
  program_scope varchar [note: 'Description of the organizational scope and applicability of the safety program, including which facilities, departments, or employee groups are covered.']
  program_status varchar [note: 'Current lifecycle status of the safety program indicating whether it is operational, under revision, or retired.']
  program_summary varchar [note: 'A brief summary of the safety program\'s purpose, key requirements, and objectives.']
  program_type varchar [note: 'Classification of the safety program based on OSHA-mandated or voluntary program categories.']
  related_policy_references varchar [note: 'Comma-separated list of related organizational policy numbers or identifiers that support or are supported by this safety program.']
  related_procedure_references varchar [note: 'Comma-separated list of related procedure identifiers or standard operating procedures (SOPs) that implement this safety program.']
  retired_reason varchar [note: 'Explanation of why the safety program was retired (e.g., regulatory change, program consolidation, no longer applicable).']
  retired_timestamp timestamp [note: 'The timestamp when this safety program was retired or deactivated. Null if the program is still active.']
  review_cycle_months varchar [note: 'The frequency in months at which the safety program must be reviewed (e.g., 12 for annual review, 24 for biennial review).']
  risk_rating varchar [note: 'The assessed risk level associated with non-compliance or failure of this safety program, used for prioritization and resource allocation.']
  supersedes_program_number varchar [note: 'The program number of the previous version of this safety program that this version replaces, if applicable.']
  training_frequency_months varchar [note: 'The frequency in months at which employees must complete training for this safety program (e.g., 12 for annual training). Null if training is one-time or not required.']
  training_required_flag boolean [note: 'Indicates whether employee training is required as part of this safety program (True) or not (False).']
  version_number varchar [note: 'The version identifier of the safety program document, used to track revisions and updates over time.']

  Note: 'Master record for each OSHA-mandated and voluntary safety program maintained by the organization. Covers Bloodborne Pathogens Exposure Control Plan, Hazard Communication Program, Respiratory Protection Program, Ergonomics Program, Workplace Violence Prevention Program, and Emergency Action Plan. Captures program name, OSHA standard citation (29 CFR), program owner, program scope, last review date, next review date, program status, and associated training requirements. Distinct from facility.safety_incident which tracks individual safety events.'
}

Table compliance.osha_exposure_incident {
  osha_exposure_incident_id varchar [pk, note: 'Unique identifier for the occupational exposure incident record. Primary key for the OSHA exposure incident entity.']
  care_site_id varchar [note: 'Reference to the healthcare facility where the exposure incident occurred. Required for multi-facility OSHA reporting and facility-level safety benchmarking.']
  mpi_record_id varchar [note: 'Reference to the patient who was the source of the exposure, if applicable. Required for source patient testing and post-exposure prophylaxis decision-making.']
  ndc_drug_id varchar [note: 'Foreign key linking to reference.ndc_drug. Business justification: Exposure incidents involving post-exposure prophylaxis (PEP) or vaccines must document the specific NDC codes administered for workers\' compensation claims, OSHA recordkeeping, and pharmacy billing re']
  osha_safety_program_id varchar [note: 'Foreign key linking to compliance.osha_safety_program. Business justification: OSHA exposure incidents are tracked under specific OSHA safety programs (e.g., Bloodborne Pathogen Exposure Control Plan). Each incident should link to the safety program it falls under for aggregatio']
  parent_osha_exposure_incident_id varchar [note: 'Self-referencing FK on osha_exposure_incident (related_osha_exposure_incident_id)']
  primary_osha_exposed_employee_id varchar [note: 'Reference to the healthcare worker who experienced the occupational exposure incident.']
  procedure_event_id varchar [note: 'Foreign key linking to clinical.procedure_event. Business justification: Sharps injuries and exposure incidents often occur during specific surgical or invasive procedures. Root cause analysis and OSHA reporting require linking exposure incidents to the procedural context ']
  scheduling_appointment_id varchar [note: 'Foreign key linking to scheduling.scheduling_appointment. Business justification: Exposure incidents often occur during scheduled patient encounters providing context for root cause analysis, procedure identification, and prevention planning. Real incident investigation requirement']
  tertiary_osha_employee_id varchar [note: 'Reference to the employee health or safety officer responsible for investigating the exposure incident and completing required documentation.']
  treatment_ap_invoice_id varchar [note: 'Foreign key linking to finance.ap_invoice. Business justification: Exposure incidents generate invoices for post-exposure prophylaxis, laboratory testing, medical treatment, and workers\' compensation costs. This link enables incident cost tracking, workers\' comp clai']
  baseline_testing_completed_flag boolean [note: 'Indicates whether baseline bloodborne pathogen testing was completed for the exposed employee immediately following the exposure. Required to establish pre-exposure status.']
  corrective_actions_implemented varchar [note: 'Description of corrective actions implemented to prevent recurrence of similar exposure incidents. May include process changes, equipment changes, or additional training.']
  created_timestamp timestamp [note: 'Date and time when the exposure incident record was first created in the system. Audit trail for data governance and compliance verification.']
  days_away_from_work varchar [note: 'Number of calendar days the exposed employee was unable to work as a result of the exposure incident. Required for OSHA 300 log column entries.']
  days_of_job_transfer_restriction varchar [note: 'Number of calendar days the exposed employee was on restricted work activity or job transfer as a result of the exposure. Required for OSHA 300 log column entries.']
  exposed_employee_department varchar [note: 'Department or unit where the exposed employee was working at the time of the incident. Critical for departmental safety metrics and targeted training.']
  exposed_employee_job_title varchar [note: 'Job title or role of the exposed employee at the time of the incident. Used for risk analysis and prevention planning by occupational category.']
  exposure_route varchar [note: 'Route by which the exposure occurred. Percutaneous (needlestick, sharps injury) and mucous membrane exposures have different post-exposure prophylaxis protocols.']
  exposure_type varchar [note: 'Primary category of occupational exposure. Bloodborne pathogen exposures are the most common in healthcare and trigger specific OSHA Bloodborne Pathogens Standard requirements.']
  follow_up_completed_flag boolean [note: 'Indicates whether all required follow-up testing and medical evaluations have been completed for the exposed employee. Used to track compliance with post-exposure protocols.']
  follow_up_testing_schedule varchar [note: 'Scheduled follow-up testing timeline for the exposed employee (e.g., 6 weeks, 3 months, 6 months post-exposure). Protocol varies by exposure type and source patient status.']
  incident_date date [note: 'Date when the occupational exposure incident occurred. Used to determine OSHA recordability and reporting deadlines.']
  incident_location varchar [note: 'Specific location within the healthcare facility where the exposure occurred (e.g., Emergency Department Room 3, Operating Room 5, Patient Room 412). Used for environmental risk assessment.']
  incident_number varchar [note: 'Business identifier assigned to the exposure incident for tracking and reporting purposes. Used in OSHA 300 log and internal incident management systems.']
  incident_resolution_date date [note: 'Date when the exposure incident case was closed and all follow-up activities completed. Used for case closure tracking and outcome analysis.']
  incident_status varchar [note: 'Current status of the exposure incident case management. Tracks the incident through investigation, follow-up care, and final resolution.']
  incident_time timestamp [note: 'Precise date and time when the exposure incident occurred. Used for shift analysis, staffing pattern review, and post-exposure prophylaxis timing calculations.']
  investigation_notes varchar [note: 'Detailed narrative of the incident investigation findings, including circumstances leading to the exposure, witness statements, and contributing factors. Used for root cause analysis and prevention planning.']
  modified_timestamp timestamp [note: 'Date and time when the exposure incident record was last modified. Audit trail for tracking updates to incident details, status changes, and follow-up documentation.']
  osha_recordable_determination_date date [note: 'Date when the OSHA recordability determination was made. Must be within 7 calendar days of receiving information that a recordable injury or illness has occurred.']
  osha_recordable_flag boolean [note: 'Indicates whether the exposure incident meets OSHA criteria for recordability on the OSHA 300 log. Recordability determination based on whether the incident resulted in medical treatment beyond first aid, days away from work, or job transfer/restriction.']
  pep_initiated_flag boolean [note: 'Indicates whether post-exposure prophylaxis treatment was initiated for the exposed employee. Required for OSHA compliance and employee health tracking.']
  pep_start_timestamp timestamp [note: 'Date and time when post-exposure prophylaxis was initiated. Timing is critical for PEP effectiveness, particularly for HIV exposure (ideally within 2 hours, no later than 72 hours).']
  pep_type varchar [note: 'Type of post-exposure prophylaxis administered (e.g., HIV PEP antiretroviral therapy, Hepatitis B immune globulin, Hepatitis B vaccination). Free text to accommodate multiple concurrent treatments.']
  procedure_being_performed varchar [note: 'Clinical procedure or task being performed when the exposure occurred. Used for procedural risk analysis and targeted training interventions.']
  reported_timestamp timestamp [note: 'Date and time when the exposure incident was first reported to management or employee health. Used to track reporting timeliness and compliance with immediate reporting requirements.']
  root_cause_analysis_completed_flag boolean [note: 'Indicates whether a formal root cause analysis was conducted for the exposure incident. Required for serious incidents and used to drive systemic safety improvements.']
  safety_engineered_device_flag boolean [note: 'Indicates whether the device involved had safety-engineered sharps injury protection features. Critical for evaluating effectiveness of safety device adoption.']
  sharps_device_brand varchar [note: 'Manufacturer and brand name of the sharp device involved. Used for product safety evaluation and vendor performance tracking.']
  sharps_device_type varchar [note: 'Type of sharp device involved in the exposure (e.g., hollow-bore needle, suture needle, scalpel, lancet). Required for OSHA Sharps Injury Log and device evaluation.']
  source_patient_hbv_status varchar [note: 'Hepatitis B test result for the source patient. Protected health information. Determines need for Hepatitis B immune globulin and vaccination for exposed employee.']
  source_patient_hcv_status varchar [note: 'Hepatitis C test result for the source patient. Protected health information. Determines baseline and follow-up testing protocol for exposed employee.']
  source_patient_hiv_status varchar [note: 'HIV test result for the source patient. Protected health information. Critical for determining post-exposure prophylaxis regimen for the exposed employee.']
  source_patient_known_flag boolean [note: 'Indicates whether the source patient could be identified. Unknown source exposures require different post-exposure prophylaxis risk assessment.']
  source_patient_tested_flag boolean [note: 'Indicates whether the source patient was tested for bloodborne pathogens (HIV, Hepatitis B, Hepatitis C) following the exposure incident.']
  workers_comp_claim_filed_flag boolean [note: 'Indicates whether a workers compensation claim was filed for the exposure incident. Links occupational health incident to workers compensation case management.']
  workers_comp_claim_number varchar [note: 'Workers compensation claim number associated with the exposure incident, if a claim was filed. Used for cross-referencing with workers compensation system.']

  Note: 'Transactional record of occupational exposure incidents for healthcare workers, including bloodborne pathogen exposures (needlestick, sharps injury, mucous membrane exposure), chemical exposures, and respiratory exposures. Captures incident date/time, exposed employee, exposure type, source patient (if applicable), exposure route, post-exposure prophylaxis (PEP) initiated, follow-up testing schedule, OSHA recordability determination, workers compensation claim status, and incident resolution. Required for OSHA 300 log, OSHA 300A annual summary, and bloodborne pathogen standard compliance.'
}

Table compliance.cms_condition_status {
  cms_condition_status_id varchar [pk, note: 'Unique identifier for the CMS Condition of Participation or Condition for Coverage compliance status tracking record.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: CMS Condition of Participation status records are assessed during CMS surveys/audits. Each cms_condition_status record should link to the audit/survey that assessed it (last_survey_date, last_survey_t']
  care_site_id varchar [note: 'Identifier of the healthcare facility or provider location to which this CMS condition compliance status applies.']
  condition_code_id varchar [note: 'Foreign key linking to reference.condition_code. Business justification: CMS Conditions of Participation deficiencies are documented using specific condition codes (K-tags, L-tags) that map to regulatory citations, required for survey tracking and plan of correction manage']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: CMS Conditions of Participation status directly affects Medicare/Medicaid payer relationships. Deemed status through accreditation impacts which payers will contract. Tracking payer context for CoP co']
  prior_cms_condition_status_id varchar [note: 'Self-referencing FK on cms_condition_status (prior_cms_condition_status_id)']
  responsible_cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: CMS condition compliance is typically owned by specific departments (Quality, Infection Control, etc.). Remediation costs must be tracked against the responsible cost center for budget management, cos']
  certification_effective_date date [note: 'The date on which the current CMS certification status for this provider type became effective.']
  certification_expiration_date date [note: 'The date on which the current CMS certification for this provider type expires if not renewed through recertification survey.']
  certification_status varchar [note: 'The overall CMS certification status of the facility for this provider type: certified (full compliance), provisional certification (initial certification period), conditional certification (deficiencies present but correctable), decertified, or termination pending.']
  civil_monetary_penalty_amount decimal(15,2) [note: 'The total dollar amount of civil monetary penalties imposed by CMS for deficiencies cited under this Condition of Participation.']
  compliance_status varchar [note: 'The current compliance status of the facility for this specific CMS Condition of Participation: compliant (no deficiencies), deficient (standard-level deficiency), condition-level deficiency (threatens health and safety), immediate jeopardy (serious harm or death likely), plan of correction pending, or plan of correction accepted.']
  condition_category varchar [note: 'The functional category or domain of the CMS Condition of Participation (e.g., patient rights, quality assurance, infection control, nursing services, medical staff, pharmaceutical services). [ENUM-REF-CANDIDATE: patient_rights|quality_assurance|infection_control|nursing_services|medical_staff|pharmaceutical_services|dietary_services|emergency_services|surgical_services|anesthesia_services|radiologic_services|laboratory_services|medical_record_services|physical_environment|life_safety|governance|administration — 17 candidates stripped; promote to reference product]']
  condition_name varchar [note: 'The full descriptive name of the CMS Condition of Participation or Condition for Coverage (e.g., Patient Rights, Infection Prevention and Control, Nursing Services).']
  cop_citation varchar [note: 'The official CMS regulatory citation for the Condition of Participation or Condition for Coverage (e.g., 42 CFR 482.13, 42 CFR 483.10) that this status record tracks.']
  correction_completion_date date [note: 'The date by which the facility must complete all corrective actions for deficiencies cited under this condition, as specified in the accepted Plan of Correction.']
  correction_verified_date date [note: 'The date on which CMS or the state survey agency verified that all corrective actions for this condition have been successfully implemented and deficiencies resolved.']
  created_timestamp timestamp [note: 'The date and time when this CMS condition status tracking record was first created in the system.']
  deficiency_tag_numbers varchar [note: 'Comma-separated list of CMS deficiency tag numbers (e.g., K0001, K0021, A0115) cited under this Condition of Participation during the last survey.']
  enforcement_action_flag boolean [note: 'Indicates whether CMS or the state survey agency has imposed enforcement actions (remedies) on the facility related to deficiencies under this condition (True if enforcement actions are active, False otherwise).']
  enforcement_action_type varchar [note: 'The type of CMS enforcement remedy imposed for deficiencies under this condition (e.g., civil monetary penalty, denial of payment for new admissions, temporary management, termination of provider agreement). Multiple actions may be listed if applicable.']
  internal_audit_frequency_months varchar [note: 'The frequency in months at which the organization conducts internal compliance audits or self-assessments for this CMS Condition of Participation.']
  last_internal_audit_date date [note: 'The date of the most recent internal compliance audit or self-assessment conducted for this CMS Condition of Participation.']
  last_internal_audit_result varchar [note: 'The outcome of the most recent internal compliance audit for this condition: compliant, minor gaps identified, significant gaps identified, or non-compliant.']
  last_survey_date date [note: 'The date of the most recent CMS certification survey or validation survey during which this Condition of Participation was evaluated.']
  last_survey_outcome varchar [note: 'The overall outcome of the last CMS survey for this condition: no deficiencies found, deficiencies cited (standard level), condition-level deficiencies cited, immediate jeopardy cited, or termination recommended.']
  last_survey_type varchar [note: 'The type of CMS survey during which this condition was last evaluated (e.g., initial certification, recertification, complaint investigation, validation, life safety code, revisit).']
  modified_timestamp timestamp [note: 'The date and time when this CMS condition status tracking record was last updated or modified.']
  next_internal_audit_date date [note: 'The scheduled date for the next internal compliance audit or self-assessment for this CMS Condition of Participation.']
  next_survey_window_end date [note: 'The latest date within the window when the next CMS certification or recertification survey for this condition must occur to maintain compliance with survey frequency requirements.']
  next_survey_window_start date [note: 'The earliest date within the window when the next CMS certification or recertification survey for this condition is expected to occur, based on regulatory survey cycles.']
  notes varchar [note: 'Additional free-text notes, comments, or context regarding the compliance status, survey findings, corrective actions, or other relevant information for this CMS Condition of Participation.']
  open_deficiency_count varchar [note: 'The current number of open (uncorrected) deficiencies cited under this Condition of Participation that require corrective action.']
  plan_of_correction_acceptance_date date [note: 'The date on which CMS or the state survey agency formally accepted the facilitys Plan of Correction.']
  plan_of_correction_due_date date [note: 'The deadline by which the facility must submit its Plan of Correction to CMS or the state survey agency for deficiencies cited under this condition.']
  plan_of_correction_status varchar [note: 'The current status of the Plan of Correction for deficiencies cited under this condition: not required, required, submitted, under review by CMS/state agency, accepted, rejected, implemented, or verified as corrected. [ENUM-REF-CANDIDATE: not_required|required|submitted|under_review|accepted|rejected|implemented|verified — 8 candidates stripped; promote to reference product]']
  plan_of_correction_submission_date date [note: 'The date on which the facility submitted its Plan of Correction to CMS or the state survey agency.']
  provider_type varchar [note: 'The certified provider type classification under CMS regulations (e.g., hospital, SNF, home health, hospice, ASC, critical access hospital) that determines which Conditions of Participation apply.']
  responsible_department varchar [note: 'The internal department or service line responsible for maintaining compliance with this CMS Condition of Participation (e.g., Nursing, Infection Prevention, Quality, Medical Staff Services).']
  responsible_officer_name varchar [note: 'The name of the executive or director responsible for oversight of compliance with this CMS Condition of Participation.']
  responsible_officer_title varchar [note: 'The job title of the executive or director responsible for oversight of compliance with this CMS Condition of Participation (e.g., Chief Nursing Officer, Director of Quality, Chief Medical Officer).']
  risk_level varchar [note: 'The organizations internal risk assessment level for non-compliance with this CMS Condition of Participation, based on likelihood and impact of deficiencies (low, moderate, high, critical).']
  scope_and_severity_level varchar [note: 'The CMS scope and severity matrix level assigned to the most serious deficiency under this condition (A through L, where A is isolated/no harm and L is widespread/immediate jeopardy). [ENUM-REF-CANDIDATE: A|B|C|D|E|F|G|H|I|J|K|L — 12 candidates stripped; promote to reference product]']
  state_survey_agency varchar [note: 'The name of the state health department or survey agency responsible for conducting CMS certification surveys for this facility.']
  surveyor_name varchar [note: 'The name of the lead CMS or state survey agency surveyor who conducted the last survey evaluation of this condition.']

  Note: 'Operational tracking record for each CMS Condition of Participation (CoP) or Condition for Coverage (CfC) applicable to the organization\'s certified provider types (hospital, SNF, home health, hospice, ASC). Captures CoP/CfC citation, condition name, current compliance status (compliant, deficient, immediate jeopardy, condition-level deficiency), last survey date, last survey outcome, open deficiencies count, plan of correction status, and next survey window. Enables real-time CoP compliance posture monitoring across all certified provider types.'
}

Table compliance.accreditation_status {
  accreditation_status_id varchar [pk, note: 'Unique identifier for the accreditation status record. Primary key.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: Accreditation status is determined by accreditation audits/surveys. Each accreditation_status record should link to the audit that determined the status (last_survey_date, survey_type exist). This cre']
  care_site_id varchar [note: 'Reference to the healthcare facility or organizational unit that holds this accreditation. Links to the facility master record.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Accreditation (Joint Commission, NCQA, URAC) is often contractually required by specific payers. Payers reference accreditation status for contracting decisions, deemed status recognition, and quality']
  prior_accreditation_status_id varchar [note: 'Self-referencing FK on accreditation_status (prior_accreditation_status_id)']
  accreditation_award_date date [note: 'Date on which the accreditation status was officially awarded or conferred by the accrediting body following survey completion and decision.']
  accreditation_certificate_number varchar [note: 'Unique certificate or accreditation number issued by the accrediting body to identify this specific accreditation award.']
  accreditation_cost_amount decimal(15,2) [note: 'Total cost in US dollars (USD) associated with obtaining and maintaining this accreditation, including survey fees, application fees, annual fees, and consulting costs.']
  accreditation_cycle_years varchar [note: 'Number of years in the accreditation cycle before re-survey is required. Typically 3 years for hospital accreditation, may vary by program type.']
  accreditation_decision_date date [note: 'Date on which the accrediting body made the formal accreditation decision following survey review and any appeals process.']
  accreditation_level varchar [note: 'Level or tier of accreditation awarded, if the accrediting body uses tiered accreditation (e.g., gold, silver, bronze for some programs; level I, II, III for trauma centers).']
  accreditation_scope varchar [note: 'Description of the scope of services, departments, or programs covered by this accreditation (e.g., acute care hospital services, emergency department, surgical services, laboratory services, radiology services).']
  accreditation_status varchar [note: 'Current accreditation status awarded by the accrediting body. Accredited indicates full compliance; accredited with follow-up indicates minor findings requiring follow-up; conditional indicates significant findings with conditions; preliminary denial indicates intent to deny; not accredited indicates denial or loss of accreditation; withdrawn indicates voluntary withdrawal.']
  accrediting_body_code varchar [note: 'Standardized code identifying the accrediting organization (e.g., TJC for The Joint Commission, DNV for DNV GL, HFAP for Healthcare Facilities Accreditation Program, CARF for Commission on Accreditation of Rehabilitation Facilities, CAP for College of American Pathologists, ACR for American College of Radiology, AAAHC for Accreditation Association for Ambulatory Health Care).']
  accrediting_body_name varchar [note: 'Full legal name of the accrediting organization (e.g., The Joint Commission, DNV GL Healthcare, Healthcare Facilities Accreditation Program).']
  annual_maintenance_fee_amount decimal(15,2) [note: 'Annual fee in US dollars (USD) charged by the accrediting body to maintain active accreditation status between surveys.']
  appeal_filed_flag boolean [note: 'Indicates whether the organization filed an appeal of the accreditation decision or survey findings. True if appeal was filed; false otherwise.']
  appeal_outcome varchar [note: 'Outcome of the appeal process if an appeal was filed. Upheld indicates original decision stands; overturned indicates decision reversed; modified indicates decision changed; pending indicates appeal in progress; not applicable if no appeal filed.']
  cms_certification_number varchar [note: 'CMS-issued certification number (CCN) associated with this accreditation when deemed status applies. Used for Medicare and Medicaid billing and provider enrollment.']
  contact_person_email varchar [note: 'Email address of the primary organizational contact person for this accreditation.']
  contact_person_name varchar [note: 'Name of the primary organizational contact person responsible for managing this accreditation relationship and survey coordination.']
  contact_person_phone varchar [note: 'Phone number of the primary organizational contact person for this accreditation.']
  contact_person_title varchar [note: 'Job title or role of the primary organizational contact person for this accreditation (e.g., Director of Regulatory Compliance, Chief Quality Officer, Accreditation Coordinator).']
  created_timestamp timestamp [note: 'Timestamp when this accreditation status record was first created in the system.']
  critical_findings_count varchar [note: 'Number of critical or immediate threat to health and safety findings identified during the last survey. Critical findings may result in conditional accreditation or denial.']
  deemed_status_flag boolean [note: 'Indicates whether this accreditation confers deemed status for Centers for Medicare and Medicaid Services (CMS) Conditions of Participation (CoP), allowing the facility to participate in Medicare and Medicaid programs without separate CMS certification. True if deemed status is granted; false otherwise.']
  effective_date date [note: 'Date from which the accreditation status becomes effective and the organization is considered accredited.']
  exclusions varchar [note: 'Description of any services, departments, or programs explicitly excluded from the scope of this accreditation.']
  expiration_date date [note: 'Date on which the current accreditation status expires and requires renewal or re-survey. Typically 3 years for hospital accreditation.']
  follow_up_completion_date date [note: 'Date on which the required follow-up activity (evidence submission, corrective action plan, or follow-up survey) was completed and accepted by the accrediting body.']
  follow_up_due_date date [note: 'Date by which the organization must submit evidence of standards compliance, corrective action plan, or complete a follow-up survey to maintain accreditation status.']
  follow_up_required_flag boolean [note: 'Indicates whether the accrediting body requires a follow-up survey, evidence of standards compliance (ESC), or corrective action plan submission to address findings. True if follow-up is required; false otherwise.']
  last_survey_date date [note: 'Date of the most recent accreditation survey conducted by the accrediting body that resulted in the current accreditation status.']
  modified_timestamp timestamp [note: 'Timestamp when this accreditation status record was last modified or updated in the system.']
  next_survey_window_end_date date [note: 'Latest date within the window by which the next accreditation survey must be completed to maintain continuous accreditation.']
  next_survey_window_start_date date [note: 'Earliest date within the window when the next accreditation survey may be scheduled or conducted.']
  notes varchar [note: 'Free-text notes capturing additional context, special conditions, or important information about this accreditation status not captured in structured fields.']
  program_type varchar [note: 'Type of accreditation program applicable to the facility (e.g., hospital accreditation, ambulatory care accreditation, laboratory accreditation, radiology accreditation, behavioral health, rehabilitation, home health). [ENUM-REF-CANDIDATE: hospital|ambulatory|laboratory|radiology|behavioral_health|rehabilitation|home_health|other — 8 candidates stripped; promote to reference product]']
  public_disclosure_flag boolean [note: 'Indicates whether this accreditation status is publicly disclosed on the accrediting body\'s website or public database. True if publicly disclosed; false if confidential.']
  quality_report_url varchar [note: 'Web address (URL) where the public quality report or accreditation details can be accessed on the accrediting body\'s website (e.g., The Joint Commission Quality Check).']
  state_licensure_alignment_flag boolean [note: 'Indicates whether this accreditation is recognized by the state health department for facility licensure purposes or whether it satisfies state licensure requirements. True if aligned; false otherwise.']
  survey_findings_count varchar [note: 'Total number of findings, deficiencies, or requirements for improvement identified during the last accreditation survey.']
  survey_type varchar [note: 'Type of survey that resulted in this accreditation status. Initial for first-time accreditation; triennial for standard 3-year re-accreditation; mid-cycle for periodic review; unannounced for random unannounced surveys; for-cause for complaint-driven surveys; follow-up for post-finding validation.']

  Note: 'Master record tracking the current accreditation and certification status for each accrediting body and program applicable to the organization. Covers The Joint Commission (TJC) hospital accreditation, DNV GL, HFAP, CARF, CAP laboratory accreditation, ACR radiology accreditation, AAAHC, and state-specific certifications. Captures accrediting body, program type, accreditation status (accredited, accredited with follow-up, conditional, not accredited), accreditation award date, expiration date, next survey window, and deemed status for CMS. Distinct from quality.accreditation_program which tracks survey activities.'
}

Table compliance.business_associate_agreement {
  business_associate_agreement_id varchar [pk, note: 'Unique identifier for the Business Associate Agreement record. Primary key.']
  compliance_program_id varchar [note: 'Identifier linking this BAA to the overarching compliance program under which it is managed.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Payers receiving PHI (eligibility files, claims data, remittance) are business associates under HIPAA requiring executed BAAs. Healthcare organizations must track which payer each BAA covers for regul']
  renewed_business_associate_agreement_id varchar [note: 'Self-referencing FK on business_associate_agreement (renewed_business_associate_agreement_id)']
  agreement_number varchar [note: 'Externally-known unique identifier or reference number assigned to this BAA for tracking and reference purposes.']
  audit_rights_granted_flag boolean [note: 'Indicates whether the covered entity has the right to audit the business associate\'s compliance with the BAA and HIPAA requirements.']
  breach_notification_required_flag boolean [note: 'Indicates whether the business associate is required to notify the covered entity of any breach of unsecured PHI.']
  breach_notification_timeframe_days varchar [note: 'Number of days within which the business associate must notify the covered entity of a breach of unsecured PHI.']
  business_associate_address varchar [note: 'Full mailing address of the business associate organization, including street, city, state, and postal code.']
  business_associate_agreement_status varchar [note: 'Current lifecycle status of the BAA indicating whether it is in force, expired, terminated, or pending action.']
  business_associate_contact_email varchar [note: 'Email address of the primary contact person at the business associate organization for BAA-related matters.']
  business_associate_contact_name varchar [note: 'Name of the primary contact person at the business associate organization for BAA-related matters.']
  business_associate_contact_phone varchar [note: 'Phone number of the primary contact person at the business associate organization for BAA-related matters.']
  business_associate_signatory_name varchar [note: 'Name of the individual who signed the BAA on behalf of the business associate.']
  business_associate_signatory_title varchar [note: 'Job title or role of the individual who signed the BAA on behalf of the business associate.']
  business_associate_tax_number varchar [note: 'Federal tax identification number (EIN) of the business associate for legal and financial tracking.']
  covered_entity_signatory_name varchar [note: 'Name of the individual who signed the BAA on behalf of the covered entity.']
  covered_entity_signatory_title varchar [note: 'Job title or role of the individual who signed the BAA on behalf of the covered entity.']
  created_timestamp timestamp [note: 'Timestamp indicating when this BAA record was first created in the system.']
  document_location_url varchar [note: 'URL or file path to the stored copy of the executed BAA document for reference and audit purposes.']
  effective_date date [note: 'Date on which the BAA becomes legally binding and enforceable.']
  execution_date date [note: 'Date on which the BAA was signed and executed by both the covered entity and the business associate.']
  expiration_date date [note: 'Date on which the BAA expires or terminates, if applicable. Null for agreements without a defined end date.']
  indemnification_clause_included_flag boolean [note: 'Indicates whether the BAA includes an indemnification clause protecting the covered entity from liability arising from the business associate\'s actions.']
  insurance_coverage_amount decimal(15,2) [note: 'Minimum dollar amount of liability or cyber insurance coverage the business associate must maintain.']
  insurance_required_flag boolean [note: 'Indicates whether the business associate is required to maintain liability or cyber insurance as a condition of the BAA.']
  last_review_date date [note: 'Date on which the BAA was last reviewed for compliance, accuracy, and currency.']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this BAA record.']
  modified_timestamp timestamp [note: 'Timestamp indicating when this BAA record was last modified in the system.']
  next_review_date date [note: 'Scheduled date for the next review of the BAA to ensure ongoing compliance and relevance.']
  notes varchar [note: 'Additional notes, comments, or context regarding the BAA, including special terms, amendments, or historical information.']
  permitted_disclosures varchar [note: 'Specific disclosures of PHI that the business associate is permitted to make under the terms of this BAA.']
  permitted_uses varchar [note: 'Specific uses of PHI that the business associate is permitted to perform under the terms of this BAA.']
  phi_retention_period_years varchar [note: 'Number of years the business associate is permitted or required to retain PHI after termination of services, if return or destruction is not feasible.']
  phi_types_shared varchar [note: 'Categories and types of PHI that will be disclosed to or accessed by the business associate under this agreement (e.g., demographic, clinical, billing).']
  renewal_date date [note: 'Date on which the BAA was renewed or is scheduled for renewal.']
  return_or_destroy_phi_flag boolean [note: 'Indicates whether the business associate is required to return or destroy all PHI upon termination of the agreement.']
  review_frequency_months varchar [note: 'Number of months between scheduled reviews of the BAA.']
  safeguards_required varchar [note: 'Description of the administrative, physical, and technical safeguards the business associate must implement to protect PHI.']
  services_provided varchar [note: 'Detailed description of the services the business associate will provide that involve access to, use of, or disclosure of PHI.']
  subcontractor_baa_chain varchar [note: 'List or description of subcontractors with whom the business associate has executed downstream BAAs, maintaining the chain of HIPAA compliance.']
  subcontractor_baa_required_flag boolean [note: 'Indicates whether the business associate is required to obtain BAAs from any subcontractors who will have access to PHI.']
  termination_date date [note: 'Actual date on which the BAA was terminated, if applicable. Null if the agreement has not been terminated.']
  termination_reason varchar [note: 'Explanation or reason for the termination of the BAA, including breach, mutual agreement, or expiration.']

  Note: 'Master record for every Business Associate Agreement (BAA) executed between the covered entity and a business associate as required by HIPAA. Captures business associate name, business associate type (vendor, contractor, subcontractor, cloud service provider, HIE), services provided involving PHI, PHI types shared, BAA execution date, BAA expiration date, BAA status (active, expired, terminated, pending renewal), permitted uses and disclosures, and subcontractor BAA chain. Required by HIPAA Privacy Rule §164.504(e) and Security Rule §164.308(b). SSOT for HIPAA BAA inventory.'
}

Table compliance.notice_of_privacy_practices {
  notice_of_privacy_practices_id varchar [pk, note: 'Unique identifier for the Notice of Privacy Practices record. Primary key for the NPP entity tracking both document versions and patient acknowledgments.']
  care_site_id varchar [note: 'Identifier for the healthcare facility where the NPP was provided to the patient. Important for multi-facility organizations.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Notice of Privacy Practices (NPP) is a specific HIPAA-required policy document. Each NPP version/distribution should link to the underlying privacy policy it implements. This allows tracking NPP distr']
  mpi_record_id varchar [note: 'Unique identifier for the patient who received and acknowledged (or refused) the NPP. Links to the patient master record.']
  provided_by_employee_id varchar [note: 'Identifier for the employee or staff member who provided the NPP to the patient and obtained (or attempted to obtain) acknowledgment.']
  scheduling_appointment_id varchar [note: 'Foreign key linking to scheduling.scheduling_appointment. Business justification: NPP distribution often occurs at appointment check-in providing context for acknowledgment tracking and follow-up requirements. Real HIPAA distribution point in healthcare operations.']
  superseded_notice_of_privacy_practices_id varchar [note: 'Self-referencing FK on notice_of_privacy_practices (superseded_notice_of_privacy_practices_id)']
  visit_id varchar [note: 'Identifier for the clinical encounter or visit during which the NPP was provided to the patient. Null if provided outside of an encounter context.']
  acknowledgment_date date [note: 'Date when the patient acknowledged receipt of the NPP. Null if acknowledgment was refused or not obtained.']
  acknowledgment_method varchar [note: 'Specific method used to capture the patient\'s acknowledgment (e.g., wet signature on paper, electronic signature pad, portal checkbox).']
  acknowledgment_status varchar [note: 'Current status of the patient\'s acknowledgment of receipt of the NPP. Tracks compliance with HIPAA requirement to make good faith effort to obtain acknowledgment.']
  acknowledgment_timestamp timestamp [note: 'Precise date and time when the patient acknowledged receipt of the NPP, particularly important for electronic acknowledgments.']
  acknowledgment_type varchar [note: 'Type of acknowledgment received from the patient. HIPAA requires good faith effort to obtain written acknowledgment but allows documentation of refusal or inability to obtain.']
  audit_trail_notes varchar [note: 'Additional notes or comments documenting special circumstances, follow-up actions, or compliance considerations related to this NPP record.']
  available_on_website_flag boolean [note: 'Indicates whether this NPP version is available on the organization\'s website. HIPAA requires covered entities with websites to post NPP prominently.']
  department_name varchar [note: 'Name of the department or service area where the NPP was provided (e.g., Emergency Department, Registration, Outpatient Clinic).']
  device_type varchar [note: 'Type of device used for electronic NPP acknowledgment (e.g., desktop, mobile, tablet, kiosk). Supports audit trail for electronic acknowledgments.']
  distribution_date date [note: 'Date when the NPP was provided or made available to the patient. Required for compliance documentation.']
  distribution_method varchar [note: 'Method by which the NPP was provided to the patient. HIPAA requires covered entities to provide NPP at first service delivery and make good faith effort to obtain acknowledgment. [ENUM-REF-CANDIDATE: paper|electronic|portal|email|mail|in_person|kiosk — 7 candidates stripped; promote to reference product]']
  distribution_timestamp timestamp [note: 'Precise date and time when the NPP was distributed to the patient, particularly important for electronic and portal distributions.']
  emergency_exception_flag boolean [note: 'Indicates whether the NPP acknowledgment was not obtained due to emergency treatment circumstances. HIPAA allows exception for emergency situations.']
  emergency_exception_reason varchar [note: 'Description of the emergency circumstances that prevented obtaining NPP acknowledgment at the time of service.']
  follow_up_completion_date date [note: 'Date when follow-up was completed and NPP acknowledgment was obtained or final refusal documented.']
  follow_up_due_date date [note: 'Target date by which follow-up should be completed to obtain NPP acknowledgment if not obtained at initial service delivery.']
  follow_up_required_flag boolean [note: 'Indicates whether follow-up is required to obtain NPP acknowledgment (e.g., after emergency treatment, if patient was unable to acknowledge at initial visit).']
  ip_address varchar [note: 'IP address from which electronic or portal-based NPP acknowledgment was submitted. Used for audit trail and verification purposes.']
  material_change_flag boolean [note: 'Indicates whether this NPP version contains material changes to privacy practices. HIPAA requires prompt revision and redistribution if material changes occur.']
  mrn varchar [note: 'The patient\'s Medical Record Number used to identify the individual across the healthcare organization. Required for tracking NPP acknowledgment compliance.']
  npp_document_title varchar [note: 'Official title of the NPP document (e.g., \'Notice of Privacy Practices for Protected Health Information\').']
  npp_document_url varchar [note: 'Storage location or URL where the NPP document is maintained (e.g., document management system path, web portal URL).']
  npp_effective_date date [note: 'Date when this version of the NPP became effective and legally binding. Required to be printed on the notice per HIPAA regulations.']
  npp_expiration_date date [note: 'Date when this NPP version was superseded or retired. Null for the current active version.']
  npp_language_code varchar [note: 'ISO 639-2 three-letter language code for the NPP document (e.g., ENG for English, SPA for Spanish). Organizations must provide NPP in languages spoken by patient populations.']
  npp_version_number varchar [note: 'Version identifier for the NPP document (e.g., 1.0, 2.1, 3.0). Tracks revisions to the notice over time as regulations or organizational practices change.']
  posted_in_facility_flag boolean [note: 'Indicates whether this NPP version is posted prominently in the facility where patients can view it. HIPAA requires posting in clear and prominent location.']
  record_created_timestamp timestamp [note: 'Date and time when this NPP record was first created in the system. Part of the audit trail required for HIPAA compliance documentation.']
  record_modified_by varchar [note: 'Identifier or name of the user who last modified this NPP record. Required for audit trail and accountability.']
  record_modified_timestamp timestamp [note: 'Date and time when this NPP record was last modified. Supports audit trail and compliance verification.']
  refusal_documented_by varchar [note: 'Name or identifier of the staff member who documented the patient\'s refusal to acknowledge the NPP.']
  refusal_reason varchar [note: 'Documented reason why the patient refused to acknowledge receipt of the NPP. HIPAA requires documentation of good faith effort and reason for non-acknowledgment.']
  revision_reason varchar [note: 'Reason for creating a new version of the NPP (e.g., regulatory change, organizational policy update, new service offerings). Required when material changes are made.']
  signature_image_url varchar [note: 'Storage location or URL for the scanned or electronic signature image capturing the patient\'s acknowledgment.']
  website_url varchar [note: 'URL where the NPP is published on the organization\'s website for public access.']
  witness_name varchar [note: 'Name of witness present during NPP distribution and acknowledgment, if applicable (e.g., for verbal acknowledgments or special circumstances).']

  Note: 'Master and transactional record for the organization\'s HIPAA Notice of Privacy Practices (NPP) versions and patient acknowledgment tracking. Captures NPP version number, effective date, distribution method (paper, electronic, portal), acknowledgment type (signed, electronic, verbal, refused), patient acknowledgment date, and acknowledgment status. Required by HIPAA Privacy Rule §164.520 for all covered entities. Tracks both the NPP document lifecycle and individual patient acknowledgment records to demonstrate compliance with notice requirements.'
}

Table compliance.phi_access_log {
  phi_access_log_id varchar [pk, note: 'Unique identifier for each PHI access audit log entry. Primary key for compliance tracking of electronic Protected Health Information access events.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the access occurred. Supports facility-level compliance reporting and multi-site access pattern analysis.']
  fhir_resource_log_id varchar [note: 'Foreign key linking to interoperability.fhir_resource_log. Business justification: PHI access auditing must correlate with FHIR API access logs to create complete audit trails for patient data access via APIs. Required for HIPAA audit controls, patient access requests, and Cures Act']
  member_enrollment_id varchar [note: 'Foreign key linking to insurance.member_enrollment. Business justification: PHI access logs must track which specific insurance enrollment record was accessed for audit trails, break-the-glass monitoring, and inappropriate access detection. Links patient access context to the']
  note_id varchar [note: 'Foreign key linking to clinical.clinical_note. Business justification: Access audit trails must track which specific clinical notes were viewed for inappropriate access monitoring and breach investigation. Healthcare organizations audit access logs against clinical note ']
  parent_phi_access_log_id varchar [note: 'Self-referencing FK on phi_access_log (related_phi_access_log_id)']
  scheduling_appointment_id varchar [note: 'Foreign key linking to scheduling.scheduling_appointment. Business justification: PHI access logs track appointment record access for HIPAA audit trail, inappropriate access detection, and breach investigation. Required for HIPAA compliance monitoring.']
  visit_id varchar [note: 'Identifier of the clinical encounter or visit associated with the access event, if applicable. Links access to specific episodes of care for context validation.']
  access_reason varchar [note: 'Business reason or justification for accessing the PHI, either system-captured or user-provided. Used to validate legitimate treatment, payment, or healthcare operations purposes.']
  access_reason_code varchar [note: 'Standardized code representing the category of access reason. Enables systematic analysis of access patterns and compliance with minimum necessary standards. [ENUM-REF-CANDIDATE: treatment|payment|operations|research|legal|emergency|patient_request|quality_review|audit|other — 10 candidates stripped; promote to reference product]']
  access_timestamp timestamp [note: 'Date and time when the PHI access event occurred. Critical for audit trail reconstruction and compliance investigations per HIPAA Security Rule audit control requirements.']
  access_type varchar [note: 'Type of action performed on the PHI (view, print, export, modify, create, delete). Critical for assessing the nature and risk level of the access event.']
  audit_log_source varchar [note: 'Source system or mechanism that generated this audit log entry (e.g., EHR native audit, SIEM correlation, access governance tool). Identifies the technical origin of the compliance record.']
  breach_determination varchar [note: 'Determination of whether the access event constitutes a breach of unsecured PHI requiring notification under the HIPAA Breach Notification Rule. Critical for regulatory reporting obligations.']
  breach_reported_date date [note: 'Date when the breach was reported to affected individuals, HHS, or media, if applicable. Tracks compliance with breach notification timelines.']
  corrective_action_required boolean [note: 'Indicates whether corrective action or workforce sanctions are required as a result of this access event. True if the review determined policy violations requiring remediation.']
  corrective_action_taken varchar [note: 'Description of corrective actions or sanctions applied (e.g., counseling, retraining, access suspension, termination). Confidential workforce management information documenting compliance enforcement.']
  created_timestamp timestamp [note: 'Timestamp when this audit log record was created in the compliance data warehouse. Distinct from access_timestamp; represents when the compliance record was captured for reporting.']
  data_classification varchar [note: 'Classification level of the PHI accessed, indicating heightened sensitivity requiring additional protections under federal or state law (e.g., 42 CFR Part 2 substance abuse records, state mental health laws). [ENUM-REF-CANDIDATE: phi|sensitive_phi|substance_abuse|mental_health|hiv_aids|genetic|reproductive_health — 7 candidates stripped; promote to reference product]']
  disclosure_tracking_required boolean [note: 'Indicates whether this access event must be tracked as a disclosure for patient accounting of disclosures purposes under HIPAA. True for disclosures outside of treatment, payment, and operations.']
  emergency_access_flag boolean [note: 'Indicates whether this was an emergency or break-the-glass access event where normal access controls were overridden for patient safety reasons. True for emergency access requiring post-hoc review.']
  flag_reason varchar [note: 'Reason why the access was flagged for review (e.g., no patient relationship, VIP patient access, excessive access volume, after-hours access, break-the-glass override). Guides privacy officer investigation priorities.']
  flagged_for_review boolean [note: 'Indicates whether this access event was flagged by automated monitoring rules for privacy officer review. True if the access triggered compliance alerts based on access patterns, break-the-glass scenarios, or policy violations.']
  ip_address varchar [note: 'IP address of the device from which the PHI was accessed. Used for technical audit trail and security incident investigation.']
  modified_timestamp timestamp [note: 'Timestamp when this audit log record was last modified, typically during privacy officer review or investigation updates. Supports audit trail integrity and compliance record lifecycle tracking.']
  mrn varchar [note: 'The patient\'s Medical Record Number accessed during this event. Provides human-readable patient identifier for audit review and investigation workflows.']
  patient_consent_on_file boolean [note: 'Indicates whether valid patient consent or authorization was on file at the time of access, if required. Used to validate compliance with consent requirements for specific uses and disclosures.']
  patient_relationship varchar [note: 'Nature of the user\'s relationship to the patient at the time of access. Used to assess appropriateness of access based on legitimate need-to-know and minimum necessary principles. [ENUM-REF-CANDIDATE: direct_care_provider|care_team_member|consulting_provider|administrative_staff|billing_staff|no_relationship|emergency_access — 7 candidates stripped; promote to reference product]']
  record_type varchar [note: 'Type of PHI record accessed. Categorizes the nature of protected health information viewed for compliance analysis and minimum necessary reviews. [ENUM-REF-CANDIDATE: clinical_note|lab_result|radiology_report|medication_order|diagnosis|procedure|demographic|insurance|billing|appointment|immunization|allergy|vital_sign|problem_list|care_plan|discharge_summary|operative_note|pathology_report|consent_form — promote to reference product]']
  retention_period_years varchar [note: 'Number of years this audit log entry must be retained per HIPAA Security Rule requirements and organizational policy. Typically 6 years from creation or last active date per §164.316(b)(2)(i).']
  review_date date [note: 'Date when the compliance review of this access event was completed. Used to track review timeliness and compliance program effectiveness.']
  review_notes varchar [note: 'Confidential notes documented by the privacy officer during the review of this access event. Contains investigation findings, user explanations, and compliance determinations.']
  review_status varchar [note: 'Current status of the compliance review for this access event. Tracks the lifecycle of privacy officer investigation from initial flag through resolution.']
  reviewed_by varchar [note: 'Name or identifier of the privacy officer or compliance staff member who reviewed this access event. Establishes accountability for compliance review activities.']
  session_code varchar [note: 'Unique identifier for the user session during which the access occurred. Enables correlation of multiple access events within a single login session.']
  system_accessed varchar [note: 'Name or identifier of the electronic health information system accessed (e.g., Epic EHR, Cerner Millennium, PACS, LIS). Identifies the source system containing the ePHI.']
  system_module varchar [note: 'Specific module or application within the system accessed (e.g., ClinDoc, Orders, Beaker, PowerChart). Provides granular detail on the type of PHI accessed.']
  user_department varchar [note: 'Department or organizational unit to which the accessing user belongs. Supports departmental compliance reporting and access pattern analysis.']
  user_name varchar [note: 'Full name of the user who accessed the PHI. Captured for human-readable audit reporting and privacy officer investigations.']
  user_role varchar [note: 'Job role or function of the user at the time of access (e.g., Physician, Nurse, Billing Specialist, Registration Clerk). Used to assess appropriateness of access based on role-based access control policies.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  violation_type varchar [note: 'Type of HIPAA violation identified during review, if applicable (e.g., unauthorized access, snooping, minimum necessary violation, breach of confidentiality). Used for workforce sanctions and corrective action tracking.']
  workstation_code varchar [note: 'Identifier of the physical or virtual workstation from which the access occurred. Supports technical security investigations and physical safeguard compliance.']

  Note: 'Transactional audit log of PHI access events reviewed for compliance purposes, capturing access to electronic Protected Health Information (ePHI) systems for HIPAA Security Rule audit control compliance. Records user identity, access date/time, system accessed, PHI record accessed, access type (view, print, export, modify), access reason, and whether the access was flagged for review. Supports HIPAA Security Rule §164.312(b) audit control requirements and privacy officer investigations. Distinct from IT system access logs — this is the business compliance record of PHI access reviews.'
}

Table compliance.attestation {
  attestation_id varchar [pk, note: 'Unique identifier for the compliance attestation record. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or location where the attesting individual is assigned. Used for facility-level compliance reporting and tracking.']
  compliance_policy_id varchar [note: 'Identifier of the specific policy or regulatory requirement being attested to. Links the attestation to the governing policy document.']
  compliance_program_id varchar [note: 'Identifier of the compliance program under which this attestation is required. Links the attestation to the governing compliance framework.']
  obligation_id varchar [note: 'Foreign key linking to compliance.obligation. Business justification: Attestations fulfill specific regulatory obligations. Each attestation should link to the obligation it satisfies (regulatory_requirement_reference exists as STRING but should be structured FK). This ']
  reattested_attestation_id varchar [note: 'Self-referencing FK on attestation (reattested_attestation_id)']
  reviewer_employee_id varchar [note: 'Identifier of the compliance officer or manager who reviewed and approved the attestation. Links to the employee responsible for verification.']
  training_completion_id varchar [note: 'Foreign key linking to compliance.training_completion. Business justification: Attestation has training_completion_flag and training_completion_date, indicating it references a specific training completion event. When training is required for attestation, should link to the spec']
  acknowledgment_flag boolean [note: 'Indicates whether the attesting individual has acknowledged receipt and understanding of the policy or requirement. True if acknowledged, False otherwise.']
  approval_authority varchar [note: 'Name or title of the individual or role with authority to approve this attestation. Defines the governance hierarchy for compliance certifications.']
  attestation_date date [note: 'Date on which the attesting individual formally submitted or signed the attestation. Represents the principal business event timestamp for this transaction.']
  attestation_number varchar [note: 'Business-facing unique identifier or tracking number for the attestation, used for reference in compliance documentation and audit trails.']
  attestation_status varchar [note: 'Current lifecycle state of the attestation. Tracks whether the certification is awaiting submission, has been completed, is past due, or has been rejected.']
  attestation_type varchar [note: 'Category of attestation being submitted. Defines the specific compliance requirement or policy being certified.']
  attesting_individual_department varchar [note: 'Department or organizational unit to which the attesting individual belongs. Used for compliance reporting and departmental attestation tracking.']
  attesting_individual_email varchar [note: 'Email address of the person submitting the attestation. Used for communication, reminders, and audit trail documentation.']
  attesting_individual_name varchar [note: 'Full name of the person submitting the attestation. Captured for audit trail and compliance documentation purposes.']
  attesting_individual_title varchar [note: 'Job title or role of the person submitting the attestation at the time of certification. Provides context for the authority and scope of the attestation.']
  audit_trail_notes varchar [note: 'Free-text notes documenting changes, communications, or significant events related to this attestation. Provides detailed audit trail for compliance investigations.']
  created_timestamp timestamp [note: 'Date and time when this attestation record was first created in the system. Provides audit trail for record creation.']
  device_identifier varchar [note: 'Identifier of the device or workstation from which the attestation was submitted. Used for security tracking and access control verification.']
  due_date date [note: 'Deadline by which the attestation must be submitted to remain compliant. Used to track overdue attestations and trigger escalations.']
  electronic_signature_reference varchar [note: 'Reference identifier or token for the electronic signature applied to the attestation. Links to the digital signature system for non-repudiation and legal validity.']
  expiration_date date [note: 'Date on which this attestation expires and is no longer considered valid for compliance purposes. Triggers need for renewal or recertification.']
  ip_address varchar [note: 'IP address from which the attestation was submitted. Captured for security audit and fraud prevention purposes.']
  mandatory_flag boolean [note: 'Indicates whether this attestation is mandatory for the individual based on their role and responsibilities. True if required, False if voluntary.']
  modified_by_user varchar [note: 'Username or identifier of the system user who last modified this attestation record. Provides accountability for record changes.']
  modified_timestamp timestamp [note: 'Date and time when this attestation record was last modified. Tracks the most recent update to the record for audit purposes.']
  next_recertification_due_date date [note: 'Date by which the next recertification attestation must be submitted. Used to schedule and track recurring compliance certifications.']
  notification_sent_date date [note: 'Date on which the most recent notification or reminder was sent to the attesting individual. Used to track communication history.']
  notification_sent_flag boolean [note: 'Indicates whether a notification or reminder has been sent to the attesting individual regarding this attestation. True if notification sent, False otherwise.']
  period_end_date date [note: 'Ending date of the time period covered by this attestation. Defines when the compliance certification period concludes.']
  period_start_date date [note: 'Beginning date of the time period covered by this attestation. Defines the effective start of the compliance certification period.']
  recertification_frequency_months varchar [note: 'Number of months between required recertifications for this attestation type. Null if recertification is not required.']
  recertification_required_flag boolean [note: 'Indicates whether this attestation requires periodic recertification. True if recertification is required, False if it is a one-time attestation.']
  regulatory_requirement_reference varchar [note: 'Citation or reference to the specific regulatory requirement, standard, or obligation that this attestation satisfies. Examples include HIPAA sections, CMS conditions, Joint Commission standards.']
  rejection_reason varchar [note: 'Explanation for why the attestation was rejected, if applicable. Captures the rationale for non-acceptance and required corrective actions.']
  review_date date [note: 'Date on which the attestation was reviewed and approved by the compliance officer or designated authority.']
  scope varchar [note: 'Description of the scope or coverage of the attestation. Defines what activities, locations, or responsibilities are covered by this certification.']
  signature_timestamp timestamp [note: 'Precise date and time when the electronic signature was applied to the attestation. Provides legal timestamp for compliance and audit purposes.']
  statement varchar [note: 'Full text of the attestation statement or certification language that the individual is affirming. Captures the exact wording of the compliance commitment.']
  supporting_documentation_url varchar [note: 'File path or URL to supporting documentation or evidence attached to the attestation. Links to certificates, training records, or other proof of compliance.']
  training_completion_flag boolean [note: 'Indicates whether required training associated with this attestation has been completed. True if training is complete, False otherwise.']

  Note: 'Transactional record of formal compliance attestations and certifications submitted by department leaders, medical staff, and executives confirming adherence to specific regulatory requirements, policies, or compliance program elements. Captures attestation type (annual compliance certification, HIPAA workforce training attestation, code of conduct acknowledgment, conflict of interest annual recertification, CMS enrollment attestation), attesting individual, attestation date, attestation period covered, attestation status (pending, completed, overdue), and electronic signature reference. Supports OIG compliance program documentation.'
}

Table compliance.regulatory_change {
  regulatory_change_id varchar [pk, note: 'Unique identifier for the regulatory change record. Primary key.']
  compliance_program_id varchar [note: 'Reference to the primary compliance program affected by this regulatory change.']
  superseded_regulatory_change_id varchar [note: 'Self-referencing FK on regulatory_change (superseded_regulatory_change_id)']
  actual_cost_amount decimal(15,2) [note: 'Actual financial cost incurred by the organization for implementing this regulatory change.']
  affected_compliance_programs varchar [note: 'Comma-separated list or description of all compliance programs impacted by this regulatory change.']
  affected_facilities varchar [note: 'List or description of healthcare facilities affected by this regulatory change.']
  affected_systems varchar [note: 'Information systems and applications that require modification to comply with this regulatory change (e.g., EHR, billing system, reporting tools).']
  assigned_department varchar [note: 'The primary department responsible for implementing the regulatory change.']
  change_description varchar [note: 'Detailed description of the regulatory change, including what is being modified, added, or removed.']
  change_number varchar [note: 'Business identifier for the regulatory change, typically assigned by the compliance office or derived from the regulatory body\'s reference number.']
  change_title varchar [note: 'The official title or name of the regulatory change as published by the regulatory body.']
  change_type varchar [note: 'The nature of the regulatory change being tracked.']
  comment_period_end_date date [note: 'The deadline by which public comments must be submitted to the regulatory body.']
  comment_period_start_date date [note: 'The date when the public comment period opens for proposed regulatory changes.']
  comment_submission_date date [note: 'The date when organizational comments were submitted to the regulatory body.']
  comment_submitted_flag boolean [note: 'Indicates whether the organization submitted comments during the public comment period.']
  comment_summary varchar [note: 'Summary of the comments submitted by the organization during the comment period.']
  created_timestamp timestamp [note: 'The timestamp when this regulatory change record was first created in the system.']
  document_url varchar [note: 'URL or file path to the official regulatory change document or Federal Register notice.']
  effective_date date [note: 'The date when the regulatory change becomes effective and enforceable.']
  estimated_cost_amount decimal(15,2) [note: 'Estimated financial cost to the organization for implementing this regulatory change, including system modifications, training, and process changes.']
  external_consultation_required_flag boolean [note: 'Indicates whether external legal or compliance consultation was or will be required for this regulatory change.']
  impact_assessment_completion_date date [note: 'The date when the impact assessment was completed.']
  impact_assessment_status varchar [note: 'Current status of the organizational impact assessment for this regulatory change.']
  impact_summary varchar [note: 'Summary of the organizational impact including affected departments, systems, processes, and estimated effort.']
  implementation_completion_date date [note: 'The date when all implementation activities were completed and verified.']
  implementation_deadline date [note: 'The date by which the organization must have fully implemented the regulatory change to achieve compliance.']
  implementation_start_date date [note: 'The date when implementation activities began.']
  implementation_status varchar [note: 'Current status of the organization\'s implementation of the regulatory change. [ENUM-REF-CANDIDATE: identified|under review|planning|in progress|implemented|verified|closed — 7 candidates stripped; promote to reference product]']
  internal_documentation_url varchar [note: 'URL or file path to internal organizational documentation related to this regulatory change (impact assessments, implementation plans, meeting notes).']
  modified_timestamp timestamp [note: 'The timestamp when this regulatory change record was last modified.']
  monitoring_required_flag boolean [note: 'Indicates whether ongoing monitoring is required after implementation to ensure sustained compliance.']
  next_review_date date [note: 'The date when this regulatory change record should be reviewed for updates or changes in regulatory guidance.']
  notes varchar [note: 'Additional notes, observations, or context related to this regulatory change.']
  penalty_exposure_amount decimal(15,2) [note: 'Estimated financial penalty exposure if the organization fails to comply with this regulatory change.']
  policy_updates_required_flag boolean [note: 'Indicates whether organizational policies must be updated to comply with this regulatory change.']
  publication_date date [note: 'The date the regulatory change was officially published or announced by the regulatory body.']
  regulatory_body varchar [note: 'The governing body or agency issuing the regulatory change (e.g., CMS, OCR, Joint Commission, OSHA, State Department of Health, FDA).']
  regulatory_citation varchar [note: 'The official citation or reference number for the regulatory change (e.g., Federal Register citation, CFR section, Joint Commission standard number).']
  regulatory_framework varchar [note: 'The overarching regulatory framework or program under which this change falls (e.g., HIPAA, CMS Conditions of Participation, Joint Commission Standards, OSHA Healthcare Worker Safety).']
  response_actions_required varchar [note: 'Description of the specific actions the organization must take to comply with the regulatory change (e.g., policy updates, system changes, training, reporting modifications).']
  risk_level varchar [note: 'The risk level associated with non-compliance or delayed implementation of this regulatory change.']
  superseded_regulation varchar [note: 'Reference to the previous regulation or standard that this change supersedes or replaces.']
  training_required_flag boolean [note: 'Indicates whether staff training is required to implement this regulatory change.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']

  Note: 'Master record tracking regulatory and accreditation standard changes that require organizational response. Captures regulatory body, change type (new rule, amended rule, guidance update, standard revision, enforcement policy change), effective date, comment period deadline, implementation deadline, impact assessment status, affected compliance programs, assigned compliance officer, response actions required, and implementation status. Enables proactive regulatory change management and ensures the organization tracks and responds to evolving compliance obligations from CMS, OCR, OSHA, Joint Commission, and state agencies.'
}

Table compliance.monitoring_activity {
  monitoring_activity_id varchar [pk, note: 'Unique identifier for the compliance monitoring activity record. Primary key for the monitoring activity entity.']
  care_site_id varchar [note: 'Reference to the healthcare facility where the monitoring activity is being conducted or that is the subject of the review.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Monitoring activities verify policy compliance. The policy_reference (STRING) field should be replaced with a structured FK policy_id. This allows tracking which policies are being monitored and aggre']
  compliance_program_id varchar [note: 'Reference to the overarching compliance program under which this monitoring activity is conducted.']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Procedure code monitoring targets specific CPT codes for compliance review based on utilization outliers, NCCI edit violations, or high-risk procedure categories identified in compliance risk assessme']
  follow_up_monitoring_activity_id varchar [note: 'Self-referencing FK on monitoring_activity (follow_up_monitoring_activity_id)']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Compliance monitoring activities (DRG validation, coding audits, medical necessity reviews) sample specific diagnosis codes for review based on risk profiles, payer focus areas, or OIG work plans.']
  interface_channel_id varchar [note: 'Foreign key linking to interoperability.interface_channel. Business justification: Compliance monitoring activities routinely audit interface channels for message integrity, timeliness, error rates, and adherence to data exchange policies. Linking monitoring to specific channels ena']
  lead_monitor_employee_id varchar [note: 'Reference to the employee who is leading or responsible for conducting the monitoring activity.']
  monitoring_cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Monitoring activities consume departmental resources. Monitoring costs (staff time, audit tools, sampling) should be tracked against the responsible cost center\'s budget for cost allocation, program e']
  obligation_id varchar [note: 'Foreign key linking to compliance.obligation. Business justification: Monitoring activities verify compliance with specific regulatory obligations. Each monitoring activity should link to the obligation being monitored. This allows tracking obligation compliance through']
  activity_name varchar [note: 'Descriptive name or title of the monitoring activity that clearly identifies the focus and scope of the review.']
  activity_number varchar [note: 'Business-facing unique identifier or tracking number assigned to the monitoring activity for reference and reporting purposes.']
  activity_status varchar [note: 'Current lifecycle status of the monitoring activity indicating its progress through the monitoring workflow.']
  activity_type varchar [note: 'Classification of the monitoring activity by its primary focus area. Supports categorization and trend analysis of compliance monitoring efforts. [ENUM-REF-CANDIDATE: medical_record_review|hipaa_access_audit|billing_compliance_spot_check|coding_accuracy_review|policy_adherence_observation|department_self_assessment|claims_audit|documentation_review|privacy_monitoring|security_monitoring|quality_review|operational_audit — promote to reference product]']
  actual_completion_date date [note: 'The actual date when the monitoring activity was completed. Used to track schedule adherence and cycle time metrics.']
  actual_start_date date [note: 'The actual date when the monitoring activity execution began. Used to track schedule adherence and performance metrics.']
  compliance_rate_percentage decimal(5,2) [note: 'Calculated percentage representing the proportion of reviewed items that were found to be compliant with the applicable standard or requirement. Key performance indicator for compliance effectiveness.']
  confidentiality_level varchar [note: 'Classification of the sensitivity and access restrictions for the monitoring activity and its findings.']
  corrective_action_plan_required_flag boolean [note: 'Indicates whether a formal corrective action plan is required to address the issues identified during the monitoring activity.']
  created_timestamp timestamp [note: 'The date and time when this monitoring activity record was first created in the system. Supports audit trail and data lineage tracking.']
  critical_issues_count varchar [note: 'The number of issues identified that are classified as critical or high-severity, requiring immediate attention and remediation.']
  department_monitored varchar [note: 'The name of the department, unit, or functional area that is the subject of the monitoring activity.']
  external_auditor_involvement_flag boolean [note: 'Indicates whether external auditors or consultants participated in or reviewed the monitoring activity.']
  external_auditor_organization varchar [note: 'Name of the external auditing firm or consulting organization involved in the monitoring activity, if applicable.']
  findings_summary varchar [note: 'High-level summary of the key findings, observations, and results from the monitoring activity. Provides executive-level overview of compliance status.']
  follow_up_action_description varchar [note: 'Detailed description of the follow-up actions, corrective measures, or remediation steps required or recommended based on the monitoring findings.']
  follow_up_due_date date [note: 'The target date by which follow-up actions or corrective measures should be completed.']
  follow_up_required_flag boolean [note: 'Indicates whether follow-up monitoring or verification activities are required based on the findings of this monitoring activity.']
  issues_identified_count varchar [note: 'The total number of compliance issues, deficiencies, or non-conformances identified during the monitoring activity.']
  lead_monitor_name varchar [note: 'Full name of the employee leading the monitoring activity. Provides quick reference without requiring a join to the employee table.']
  modified_timestamp timestamp [note: 'The date and time when this monitoring activity record was last updated or modified. Supports audit trail and change tracking.']
  monitoring_methodology varchar [note: 'Description of the approach, techniques, and procedures used to conduct the monitoring activity (e.g., random sampling, targeted review, automated scanning, observation).']
  monitoring_period_end_date date [note: 'The ending date of the time period being reviewed or monitored for compliance. Defines the temporal scope of the monitoring activity.']
  monitoring_period_start_date date [note: 'The beginning date of the time period being reviewed or monitored for compliance. Defines the temporal scope of the monitoring activity.']
  monitoring_team_size varchar [note: 'The number of individuals involved in conducting the monitoring activity. Used for resource planning and workload analysis.']
  notes varchar [note: 'Additional free-text notes, comments, or contextual information about the monitoring activity that do not fit into structured fields.']
  population_size varchar [note: 'The total number of records, transactions, or cases in the population from which the sample was drawn.']
  process_monitored varchar [note: 'Description of the specific business process, workflow, or operational activity being monitored for compliance (e.g., patient registration, order entry, billing submission).']
  regulatory_citation varchar [note: 'Specific citation or reference to the regulatory requirement, standard section, or rule being monitored (e.g., 45 CFR 164.308, Joint Commission Standard LD.04.03.11).']
  regulatory_framework varchar [note: 'The primary regulatory framework or standard being monitored for compliance (e.g., HIPAA, CMS Conditions of Participation, Joint Commission standards, OSHA requirements).']
  report_document_path varchar [note: 'File system path or URL to the detailed monitoring activity report document for reference and audit trail purposes.']
  report_issued_date date [note: 'The date when the formal monitoring activity report was issued or published to stakeholders.']
  risk_level varchar [note: 'Assessment of the overall risk level associated with the findings from the monitoring activity, considering potential impact on patient safety, regulatory compliance, and financial exposure.']
  sample_size varchar [note: 'The number of records, transactions, or cases reviewed as part of the monitoring activity. Used to assess statistical validity and coverage.']
  scheduled_completion_date date [note: 'The planned date by which the monitoring activity is expected to be completed.']
  scheduled_start_date date [note: 'The planned date when the monitoring activity is scheduled to begin execution.']

  Note: 'Transactional record of ongoing compliance monitoring and auditing activities conducted by the compliance department outside of formal audit cycles. Covers medical record reviews for coding accuracy, HIPAA access audits, billing compliance spot checks, policy adherence observations, and department self-assessments. Captures monitoring activity type, monitoring period, sample size, methodology, department or process monitored, findings summary, compliance rate calculated, issues identified, and follow-up actions. Supports OIG compliance program element 3 (monitoring and auditing) documentation.'
}

Table compliance.program_policy_assignment {
  program_policy_assignment_id varchar [pk, note: 'Unique identifier for this program-policy assignment record. Primary key.']
  compliance_policy_id varchar [note: 'Foreign key linking to the organizational policy assigned to this compliance program']
  primary_compliance_program_id varchar [note: 'Foreign key to compliance_program. Identifies which compliance program this policy is assigned to.']
  assigned_by varchar [note: 'Name or role of the individual or committee that assigned this policy to this compliance program (e.g., Chief Compliance Officer, Compliance Committee).']
  assignment_date date [note: 'Date when this policy was formally assigned to this compliance program. Tracks the governance decision date.']
  assignment_status varchar [note: 'Current status of this program-policy assignment. Active assignments are in effect; suspended assignments are temporarily inactive; retired assignments are no longer in effect; under_review assignments are being evaluated for continued relevance.']
  audit_frequency varchar [note: 'Frequency at which compliance with this policy must be audited specifically under this compliance program. May differ from the program\'s general audit_frequency or the policy\'s review cycle, as different programs may impose different audit requirements on the same policy.']
  effective_date date [note: 'Date when this policy became governed under this specific compliance program. May differ from the policy\'s own effective_date if the policy was added to an existing program later.']
  expiration_date date [note: 'Date when this program-policy assignment expires or requires renewal. Nullable for permanent assignments.']
  last_audit_date date [note: 'Date when compliance with this policy was last audited specifically in the context of this compliance program. Tracks program-specific audit history, as the same policy may be audited at different times under different programs.']
  last_review_date date [note: 'Date when this program-policy assignment was last reviewed for continued relevance and accuracy.']
  mandatory_flag boolean [note: 'Indicates whether this policy is mandatory (true) or optional (false) specifically within the context of this compliance program. A policy may be mandatory under one program but optional under another.']
  next_audit_date date [note: 'Scheduled date for the next audit of this policy under this specific compliance program. Calculated based on the program-specific audit_frequency.']
  next_review_date date [note: 'Scheduled date for the next review of this program-policy assignment.']
  program_scope_applicability varchar [note: 'Description of how this policy applies within the scope of this specific compliance program. Captures program-specific applicability rules, exceptions, or scope limitations that may not apply when the same policy is governed under a different program.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']

  Note: 'This association product represents the formal assignment of organizational policies to compliance programs. It captures which policies are governed under which compliance programs, with program-specific enforcement requirements, audit schedules, and applicability rules. Each record links one compliance program to one policy with attributes that exist only in the context of this program-policy relationship, such as whether the policy is mandatory under that specific program, program-specific audit frequency, and effective dates for the assignment.. Existence Justification: In healthcare compliance operations, a single compliance program (e.g., HIPAA Compliance Program) governs multiple organizational policies (privacy policy, security policy, breach notification policy), and conversely, a single policy (e.g., Privacy Policy) may be governed under multiple compliance programs (HIPAA program, state privacy law program, Joint Commission accreditation program). Compliance officers actively manage these program-policy assignments, setting program-specific requirements such as mandatory vs. optional status, audit frequency, and scope applicability for each assignment.'
}

Table compliance.policy_regulatory_impact {
  policy_regulatory_impact_id varchar [pk, note: 'Unique identifier for this policy regulatory impact record. Primary key.']
  compliance_policy_id varchar [note: 'Foreign key linking to the organizational policy that was created, updated, or retired in response to the regulatory change.']
  employee_id varchar [note: 'Reference to the compliance officer responsible for managing this specific policy response to this regulatory change. May differ from the overall regulatory change owner if different officers manage different policy impacts.']
  regulatory_change_id varchar [note: 'Foreign key linking to the regulatory change that triggered the policy action.']
  change_summary varchar [note: 'Summary of the specific changes made to this policy in response to this regulatory change. Describes what was added, modified, or removed from the policy to achieve compliance.']
  created_timestamp timestamp [note: 'Timestamp when this policy regulatory impact record was created in the system.']
  effective_date date [note: 'The date when the policy change or new policy becomes effective in response to the regulatory change. This is the date when the policy update driven by this regulatory change takes effect.']
  impact_assessment_date date [note: 'The date when the impact assessment for this regulatory change on this specific policy was completed.']
  impact_assessment_status varchar [note: 'Current status of the impact assessment for this specific regulatory change on this specific policy. Tracks the workflow state of evaluating how the regulatory change affects this policy.']
  implementation_date date [note: 'The date when the policy changes required by this regulatory change were fully implemented and operationalized across the organization.']
  policy_version_created varchar [note: 'The version number of the policy that was created or updated as a result of this regulatory change. Links the regulatory change to the specific policy version it triggered.']
  response_type varchar [note: 'The type of policy action taken in response to this regulatory change. Indicates whether a new policy was created, an existing policy was updated, a policy was retired, or no policy action was required.']
  updated_timestamp timestamp [note: 'Timestamp when this policy regulatory impact record was last updated.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']

  Note: 'This association product represents the regulatory impact assessment and policy response relationship between regulatory changes and organizational policies. It captures the compliance management workflow where regulatory changes trigger policy creation, updates, or retirement. Each record links one regulatory change to one policy with attributes tracking the impact assessment, implementation timeline, and policy response actions that exist only in the context of this regulatory-driven policy lifecycle event.. Existence Justification: In healthcare compliance operations, a single regulatory change (e.g., CMS rule update) routinely triggers updates to multiple organizational policies (clinical protocols, billing policies, privacy procedures), and conversely, a single policy often incorporates requirements from multiple regulatory sources (HIPAA, state law, Joint Commission standards, CMS rules). Compliance officers actively manage this relationship through a structured workflow: regulatory change monitoring → impact assessment → policy drafting/revision → approval → implementation tracking. This is not an analytical correlation but an operational compliance management process.'
}

Table compliance.policy_payer_applicability {
  policy_payer_applicability_id varchar [pk, note: 'Unique identifier for this policy-payer applicability record. Primary key.']
  compliance_policy_id varchar [note: 'Foreign key linking to the organizational policy that applies to this payer relationship.']
  payer_id varchar [note: 'Foreign key linking to the insurance payer to whom this policy applies.']
  attestation_required boolean [note: 'Indicates whether the payer is required to formally attest to compliance with this policy as part of the contractual relationship. True for policies with regulatory or contractual attestation requirements.']
  compliance_status varchar [note: 'Current compliance status of the payer with respect to this policy. Compliant indicates the payer meets all policy requirements; non_compliant indicates violations or gaps; pending_review indicates assessment in progress; waived indicates formal exception granted; not_applicable indicates policy does not apply to this payer relationship.']
  distribution_date date [note: 'Date on which this policy was distributed or communicated to the payer. Tracks when the payer was notified of policy requirements.']
  effective_date date [note: 'Date on which this policy became applicable to this payer relationship. May differ from the policy\'s overall effective date if the payer contract was established after policy adoption.']
  last_compliance_review_date date [note: 'Date on which compliance with this policy was most recently assessed for this payer relationship. Used for audit tracking and review cycle management.']
  next_compliance_review_date date [note: 'Scheduled date for the next compliance review of this payer against this policy. Calculated based on policy review cycle and payer contract terms.']
  notes varchar [note: 'Free-text notes documenting payer-specific considerations, exceptions, or implementation details for this policy applicability. Used for operational context and audit trail.']
  payer_acknowledgment_date date [note: 'Date on which the payer formally acknowledged receipt and acceptance of this policy as part of the contractual relationship. Required for contract compliance and audit trail.']
  payer_specific_version varchar [note: 'Version identifier for the payer-specific adaptation or addendum to the base policy. Some payers require customized policy language or additional requirements beyond the base organizational policy.']
  termination_date date [note: 'Date on which this policy ceased to apply to this payer relationship. Nullable for ongoing applicability. Used when payer contracts end or policies are superseded.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  waiver_approval_authority varchar [note: 'Individual, role, or committee that approved the waiver for this payer-policy combination. Nullable if no waiver granted.']
  waiver_granted_flag boolean [note: 'Indicates whether a formal waiver or exception has been granted exempting this payer from this policy requirement. True indicates waiver in effect.']
  waiver_justification varchar [note: 'Business or regulatory justification for granting a waiver exempting this payer from this policy. Nullable if no waiver granted. Required for audit and governance documentation.']

  Note: 'This association product represents the applicability relationship between organizational policies and insurance payers. It captures which compliance policies (credentialing, claims submission, appeals, medical records retention) apply to which payer relationships, including payer-specific policy versions, acknowledgment tracking, and compliance status for contract management and regulatory audit readiness. Each record links one policy to one payer with attributes that exist only in the context of this payer-specific policy application.. Existence Justification: In healthcare operations, compliance policies (e.g., credentialing requirements, claims submission standards, appeals procedures, medical records retention) apply to multiple insurance payers, and each payer relationship is governed by multiple organizational policies. The compliance department actively manages which policies apply to which payers, tracks payer acknowledgment of policy requirements, monitors compliance status for audit readiness, and maintains payer-specific policy versions or addendums required by contract terms.'
}

Table compliance.regulatory_requirement {
  regulatory_requirement_id varchar [pk, note: 'Primary key for regulatory_requirement']
  parent_regulatory_requirement_id varchar [note: 'Self-referencing FK on regulatory_requirement (parent_regulatory_requirement_id)']
  regulatory_superseded_by_requirement_id varchar [note: 'Identifier of the regulatory requirement that supersedes this requirement, if applicable. Null if not superseded.']
  applicability_scope varchar [note: 'Description of which organizational units, facilities, or business processes this requirement applies to (e.g., all hospitals, outpatient clinics only, laboratories, covered entities).']
  audit_frequency varchar [note: 'Frequency at which audits or assessments must be conducted for this requirement, if audits are required.']
  audit_required boolean [note: 'Indicates whether periodic audits or assessments are required to verify compliance with this requirement (True) or not (False).']
  compliance_frequency varchar [note: 'Frequency at which compliance with this requirement must be demonstrated or assessed (e.g., continuous, annual, quarterly, monthly, event-driven, one-time).']
  control_framework varchar [note: 'Name of the internal control framework or compliance program that governs this requirement (e.g., HIPAA Compliance Program, Patient Safety Program, Infection Control Program).']
  created_timestamp timestamp [note: 'Timestamp when this regulatory requirement record was first created in the system.']
  documentation_retention_years varchar [note: 'Number of years that documentation demonstrating compliance with this requirement must be retained.']
  effective_date date [note: 'Date when the regulatory requirement became or will become enforceable.']
  expiration_date date [note: 'Date when the regulatory requirement is no longer enforceable or was superseded. Null for requirements that remain active indefinitely.']
  implementation_guidance varchar [note: 'Guidance notes or instructions for implementing this requirement within the organization.']
  jurisdiction varchar [note: 'Geographic or governmental scope of the requirement: federal, state, local, or international.']
  jurisdiction_detail varchar [note: 'Specific jurisdiction detail (e.g., state name, country code) when the requirement applies to a specific geographic area.']
  last_reviewed_date date [note: 'Date when this regulatory requirement record was last reviewed for accuracy and currency.']
  next_review_date date [note: 'Scheduled date for the next review of this regulatory requirement record.']
  penalty_amount_max decimal(15,2) [note: 'Maximum monetary penalty amount for noncompliance, if applicable. Null if no monetary penalty or penalty is not quantified.']
  penalty_amount_min decimal(15,2) [note: 'Minimum monetary penalty amount for noncompliance, if applicable. Null if no monetary penalty or penalty is not quantified.']
  penalty_currency_code varchar [note: 'Three-letter ISO 4217 currency code for penalty amounts (e.g., USD, EUR, GBP).']
  penalty_for_noncompliance varchar [note: 'Description of penalties, fines, sanctions, or enforcement actions that may result from noncompliance with this requirement.']
  policy_reference varchar [note: 'Reference to the internal policy or procedure document that implements this regulatory requirement.']
  regulation_citation varchar [note: 'Full legal citation or reference to the regulation section (e.g., 45 CFR 164.308(a)(1)(i), 42 CFR 482.13, 29 CFR 1910.1030).']
  regulation_name varchar [note: 'Name of the parent regulation, standard, or framework to which this requirement belongs (e.g., HIPAA Privacy Rule, CMS Conditions of Participation, Joint Commission National Patient Safety Goals).']
  regulatory_body varchar [note: 'Name of the governing body or agency that issued the requirement (e.g., HHS Office for Civil Rights, CMS, Joint Commission, OSHA, State Health Department).']
  regulatory_requirement_status varchar [note: 'Current lifecycle status of the regulatory requirement.']
  related_requirements varchar [note: 'Comma-separated list of related requirement codes or identifiers that are connected to or dependent on this requirement.']
  reporting_frequency varchar [note: 'Frequency at which reports must be submitted to the regulatory body, if reporting is required.']
  reporting_required boolean [note: 'Indicates whether this requirement mandates formal reporting to a regulatory body (True) or not (False).']
  requirement_category varchar [note: 'High-level classification of the regulatory requirement by domain (e.g., privacy, security, safety, quality, operational, financial, reporting).']
  requirement_code varchar [note: 'Externally-known unique code or identifier for the regulatory requirement (e.g., HIPAA-164.308, CMS-CoP-482.13, OSHA-1910.1030).']
  requirement_description varchar [note: 'Detailed description of the regulatory requirement, including scope, obligations, and compliance expectations.']
  requirement_title varchar [note: 'Human-readable title or name of the regulatory requirement.']
  requirement_type varchar [note: 'Classification of the requirement by enforcement level: mandatory (must comply), conditional (applies under certain conditions), recommended (best practice), or voluntary (optional).']
  responsible_role varchar [note: 'Job title or role responsible for ensuring compliance with this requirement (e.g., Chief Compliance Officer, Privacy Officer, Infection Control Director).']
  risk_level varchar [note: 'Organizational risk level associated with noncompliance with this requirement (critical, high, medium, low).']
  source_document_url varchar [note: 'URL or hyperlink to the official source document or regulatory text for this requirement.']
  training_frequency varchar [note: 'Frequency at which staff training must be completed for this requirement, if training is required.']
  training_required boolean [note: 'Indicates whether staff training is required to comply with this requirement (True) or not (False).']
  updated_by varchar [note: 'Username or identifier of the user who last modified this regulatory requirement record.']
  updated_timestamp timestamp [note: 'Timestamp when this regulatory requirement record was last modified.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  created_by varchar [note: 'Username or identifier of the user who created this regulatory requirement record.']

  Note: 'Master reference table for regulatory_requirement. Referenced by regulatory_requirement_id.'
}

Table compliance.databricks_governance {
  databricks_governance_id varchar [pk, note: 'Primary key for databricks_governance']
  applicable_domain varchar [note: 'Domain(s) this rule applies to. Use \'*\' for all domains or comma-separated domain names.']
  applicable_pii_level varchar [note: 'PII classification level this rule targets: pii_phi, pii_pii, pii_sensitive, pii_de_identified, or none.']
  created_timestamp timestamp [note: 'Timestamp when this governance rule was created.']
  delta_property_key varchar [note: 'Delta table property key (e.g., delta.enableChangeDataFeed, delta.logRetentionDuration) when rule_category is delta_property.']
  delta_property_value decimal(18,2) [note: 'Recommended value for the Delta table property.']
  effective_date date [note: 'Date this governance rule becomes effective.']
  governance_rule_code varchar [note: 'Unique identifier for each governance rule or configuration entry.']
  is_active boolean [note: 'Whether this governance rule is currently active and enforced.']
  masking_function_name varchar [note: 'Name of the dynamic data masking function for non-production environments.']
  output_format_type varchar [note: 'Output format specification: sql_ddl, rdf_turtle, dbml, metric_view, csv_excel, readme.']
  retention_duration_days decimal(9,4) [note: 'Number of days for data retention when rule_category is retention_policy. HIPAA minimum is 2190 (6 years).']
  retention_regulation varchar [note: 'Regulatory citation requiring this retention period (e.g., HIPAA 45 CFR 164.530(j), 21 CFR 312.62, state statute).']
  rls_function_name varchar [note: 'Name of the Row-Level Security function when rule_category is rls_predicate.']
  rls_predicate_sql varchar [note: 'SQL predicate body for the RLS function implementing access control logic.']
  rule_category varchar [note: 'Category of governance rule: unity_catalog_tag, rls_predicate, delta_property, retention_policy, output_format, pii_classification.']
  rule_definition varchar [note: 'Full definition or SQL/configuration snippet implementing the governance rule.']
  rule_name varchar [note: 'Human-readable name of the governance rule (e.g., pii_phi_tag, rls_care_site_filter, delta_cdf_enabled).']
  unity_catalog_tag_key varchar [note: 'Unity Catalog tag key for column-level classification (e.g., pii_phi, pii_pii, pii_sensitive).']
  unity_catalog_tag_value decimal(18,2) [note: 'Unity Catalog tag value (typically \'true\' or a classification descriptor).']
  updated_timestamp timestamp [note: 'Timestamp when this governance rule was last updated.']

  Note: 'Databricks-specific governance configuration product documenting Unity Catalog tag definitions (pii_phi, pii_pii, pii_sensitive, pii_de_identified), Row-Level Security predicate patterns, Delta table property recommendations for HIPAA compliance, data retention annotations, and multi-format output specifications (SQL DDL, RDF/Turtle, DBML, metric views, CSV/Excel, README).'
}

Table finance.general_ledger {
  general_ledger_id varchar [pk, note: 'Unique identifier for the general ledger. Primary key for the general ledger data product.']
  chart_of_accounts_id varchar [note: 'Foreign key reference to the chart of accounts structure that defines the account hierarchy and classification framework for this ledger. Determines the available GL accounts for journal entry postings.']
  financial_entity_id varchar [note: 'Foreign key reference to the legal entity that owns and operates this general ledger. Establishes the organizational boundary for financial reporting and regulatory compliance.']
  parent_general_ledger_id varchar [note: 'Self-referencing FK on general_ledger (parent_general_ledger_id)']
  accounting_basis varchar [note: 'The fundamental accounting method applied to this ledger. Accrual basis recognizes revenue when earned and expenses when incurred, cash basis recognizes transactions when cash changes hands, and modified accrual is a hybrid approach used primarily in governmental accounting.']
  audit_trail_level varchar [note: 'The level of audit trail detail maintained for this ledger. None indicates no audit logging, summary captures high-level changes, detailed tracks all field-level modifications, and comprehensive includes full before/after values and user context.']
  budget_control_enabled_flag boolean [note: 'Indicates whether budget control and funds management is enabled for this ledger. When true, transactions are validated against available budget before posting to prevent overspending.']
  consolidation_group_code varchar [note: 'The code identifying the consolidation group to which this ledger belongs. Used to aggregate financial results across multiple legal entities or business units for enterprise-wide reporting.']
  cost_center_enabled_flag boolean [note: 'Indicates whether cost center accounting is enabled for this ledger. When true, all journal entries must include cost center assignments for departmental expense tracking and allocation.']
  created_timestamp timestamp [note: 'The date and time when this general ledger record was first created in the system. Supports audit trail and data lineage tracking.']
  effective_end_date date [note: 'The date on which this general ledger was closed or deactivated. Null for currently active ledgers. Used to manage ledger lifecycle transitions and historical reporting boundaries.']
  effective_start_date date [note: 'The date on which this general ledger became active and began accepting journal entry postings. Establishes the beginning of the ledgers operational lifecycle.']
  fiscal_year_start_month varchar [note: 'The calendar month (1-12) in which the fiscal year begins for this ledger. Used to align financial periods with organizational planning cycles and regulatory reporting requirements.']
  fiscal_year_variant varchar [note: 'The fiscal calendar configuration code defining the number of periods, period lengths, and special period rules for this ledger. Aligns with enterprise resource planning system fiscal calendar structures.']
  functional_currency_code varchar [note: 'The three-letter ISO 4217 currency code representing the primary currency in which this ledger operates and reports financial results. All transactions are translated to this currency for consolidation and reporting.']
  general_ledger_description varchar [note: 'A detailed narrative description of the general ledgers purpose, scope, and usage within the healthcare organizations financial management framework. Provides context for financial analysts and auditors.']
  intercompany_enabled_flag boolean [note: 'Indicates whether intercompany transaction tracking is enabled for this ledger. When true, transactions between legal entities are identified and reconciled for consolidated financial reporting.']
  last_closed_period varchar [note: 'The most recent fiscal period (YYYY-MM format) that has been closed for this ledger. Closed periods are locked from further posting to ensure financial statement integrity.']
  last_posting_date date [note: 'The date of the most recent journal entry posted to this ledger. Used to monitor ledger activity and identify dormant or inactive ledgers.']
  leading_ledger_flag boolean [note: 'Indicates whether this is the leading (primary) ledger for the organization. The leading ledger serves as the authoritative source for financial reporting and drives consolidation processes.']
  ledger_code varchar [note: 'The unique alphanumeric code identifying this general ledger within the enterprise chart of accounts structure. Used as the business identifier for journal entry postings and financial reporting.']
  ledger_name varchar [note: 'The full descriptive name of the general ledger, providing human-readable identification for financial reporting and analysis.']
  ledger_status varchar [note: 'Current operational state of the general ledger. Active ledgers accept new postings, inactive ledgers are temporarily disabled, closed ledgers are finalized for a fiscal period, suspended ledgers are under review or audit, and archived ledgers are retained for historical reference only.']
  ledger_type varchar [note: 'Classification of the general ledger by its primary purpose. Corporate ledgers support consolidated financial statements, management ledgers support internal decision-making, statutory ledgers meet regulatory reporting requirements, consolidation ledgers aggregate multi-entity financials, budget ledgers track planned allocations, and forecast ledgers project future performance.']
  modified_timestamp timestamp [note: 'The date and time when this general ledger record was last modified. Tracks the most recent update to any attribute for change management and audit purposes.']
  mutator_marker varchar
  mutator_timestamp timestamp
  parallel_accounting_enabled_flag boolean [note: 'Indicates whether parallel accounting is enabled, allowing simultaneous posting to multiple ledgers with different accounting principles (e.g., GAAP and IFRS). Supports organizations with multi-jurisdictional reporting requirements.']
  profit_center_enabled_flag boolean [note: 'Indicates whether profit center accounting is enabled for this ledger. When true, revenue and expense transactions are tracked by profit center for segment profitability analysis.']
  project_accounting_enabled_flag boolean [note: 'Indicates whether project-based accounting is enabled for this ledger. When true, costs and revenues can be tracked at the project level for capital budgeting and grant management.']
  reporting_entity_code varchar [note: 'The code identifying the reporting entity for external financial statement preparation. Maps this ledger to the appropriate regulatory and stakeholder reporting requirements.']
  retention_period_years varchar [note: 'The number of years that ledger data must be retained to meet regulatory, legal, and business requirements. Drives archival and purge policies for historical financial records.']
  segment_reporting_enabled_flag boolean [note: 'Indicates whether segment reporting dimensions are enabled for this ledger. When true, financial results can be analyzed by business segment for FASB ASC 280 segment disclosure requirements.']

  Note: 'SSOT for the enterprise general ledger, representing the authoritative chart of accounts and ledger structure for the healthcare organization. Captures ledger ID, ledger name, ledger type (corporate, management, statutory), functional currency, accounting basis (accrual, cash, modified accrual), fiscal year start, ledger status, and associated legal entity. Serves as the master reference for all journal entry postings and financial reporting hierarchies across the integrated delivery network.'
}

Table finance.chart_of_accounts {
  chart_of_accounts_id varchar [pk, note: 'Unique identifier for the chart of accounts entry. Primary key for the chart of accounts master catalog.']
  parent_chart_of_accounts_id varchar [note: 'Self-referencing FK on chart_of_accounts (parent_chart_of_accounts_id)']
  account_category varchar [note: 'High-level grouping of accounts for reporting and analysis purposes. Examples include patient service revenue, supply expense, labor expense, administrative expense.']
  account_code varchar [note: 'The unique alphanumeric code identifying the general ledger account. This is the primary business identifier used in journal entries, budgets, and financial statements.']
  account_description varchar [note: 'Detailed textual description of the account purpose, usage guidelines, and any special instructions for posting transactions. Provides context for finance staff and auditors.']
  account_name varchar [note: 'The full descriptive name of the general ledger account. Human-readable label used in financial reports and user interfaces.']
  account_owner varchar [note: 'The name or identifier of the department, role, or individual responsible for managing and monitoring this account. Supports accountability and financial stewardship.']
  account_status varchar [note: 'Current lifecycle status of the account. Active accounts are available for use in transactions; inactive accounts are closed and cannot be used in new entries.']
  account_subcategory varchar [note: 'Detailed grouping within the account category providing additional analytical granularity. Supports drill-down reporting and variance analysis.']
  account_subtype varchar [note: 'The secondary classification providing additional granularity within the account type. Examples include current asset, fixed asset, operating expense, non-operating revenue, etc.']
  account_type varchar [note: 'The primary classification of the account according to the fundamental accounting equation. Determines which financial statement the account appears on and its natural balance.']
  alternate_account_code varchar [note: 'An alternate or legacy account code used for cross-reference purposes during system migrations or for integration with external systems.']
  approval_required_flag boolean [note: 'Indicates whether transactions posted to this account require additional approval beyond standard posting authority. True for sensitive or high-risk accounts.']
  budget_control_flag boolean [note: 'Indicates whether transactions against this account are subject to budget availability checking. True for expense accounts with budget controls.']
  consolidation_account_code varchar [note: 'The account code used in consolidated financial statements when multiple legal entities are combined. Supports multi-entity healthcare system reporting.']
  cost_center_applicable_flag boolean [note: 'Indicates whether this account requires a cost center assignment when used in journal entries or budget allocations. True for departmental expense and revenue accounts.']
  created_timestamp timestamp [note: 'The date and time when this chart of accounts entry was first created in the system. Supports audit trail and data lineage tracking.']
  currency_code varchar [note: 'The three-letter ISO 4217 currency code for this account. Supports multi-currency accounting for international healthcare operations.']
  department_applicable_flag boolean [note: 'Indicates whether this account requires a department assignment when used in transactions. Supports departmental financial reporting and cost allocation.']
  drg_cost_allocation_flag boolean [note: 'Indicates whether costs in this account are allocated to DRG-based cost accounting for case mix analysis and reimbursement optimization.']
  effective_end_date date [note: 'The date on which this account becomes inactive and is no longer available for new transactions. Null for currently active accounts with no planned closure date.']
  effective_start_date date [note: 'The date from which this account becomes active and available for use in financial transactions. Supports temporal validity and historical account structure tracking.']
  external_reporting_code varchar [note: 'The code or identifier used for external regulatory reporting such as Medicare Cost Reports, state financial reporting, or bond covenant reporting.']
  financial_statement_classification varchar [note: 'Identifies which primary financial statement this account appears on. Critical for automated financial statement generation and reporting.']
  financial_statement_line_item varchar [note: 'The specific line item or section within the financial statement where this account balance is reported. Examples include current assets, operating expenses, net patient service revenue.']
  fund_applicable_flag boolean [note: 'Indicates whether this account requires a fund assignment for fund accounting purposes. Relevant for healthcare organizations with restricted grants, endowments, or governmental funding.']
  gaap_classification varchar [note: 'The specific GAAP classification code or category for this account. Ensures compliance with US GAAP financial reporting requirements.']
  gasb_classification varchar [note: 'The GASB classification for governmental and not-for-profit healthcare entities. Applicable for public hospitals and healthcare systems.']
  intercompany_flag boolean [note: 'Indicates whether this account is used for intercompany transactions between legal entities within the healthcare system. Supports consolidation and elimination entries.']
  modified_timestamp timestamp [note: 'The date and time when this chart of accounts entry was last modified. Supports change tracking and audit compliance.']
  natural_balance decimal(18,2) [note: 'Indicates whether the account normally carries a debit or credit balance. Assets and expenses have debit natural balances; liabilities, equity, and revenue have credit natural balances.']
  posting_restriction varchar [note: 'Defines restrictions on how transactions can be posted to this account. Manual-only accounts prevent automated postings; system-only accounts prevent manual journal entries.']
  project_applicable_flag boolean [note: 'Indicates whether this account can be used for project-based accounting and requires a project code assignment. Common for capital projects, research grants, and special initiatives.']
  reconciliation_required_flag boolean [note: 'Indicates whether this account requires periodic reconciliation to external statements or subsidiary ledgers. True for cash, accounts receivable, accounts payable, and other balance sheet accounts.']
  rollup_account_code varchar [note: 'The parent or summary account code to which this account rolls up for consolidated reporting. Supports hierarchical financial statement presentation.']
  rvu_allocation_flag boolean [note: 'Indicates whether costs in this account are allocated based on relative value units for physician productivity and compensation analysis.']
  statistical_account_flag boolean [note: 'Indicates whether this is a statistical account used to track non-monetary metrics such as patient days, procedures performed, or full-time equivalents (FTEs). Statistical accounts do not carry monetary balances.']
  tax_reporting_category varchar [note: 'The tax reporting classification for this account. Used for IRS Form 990 reporting for not-for-profit healthcare entities and other tax compliance purposes.']

  Note: 'Master catalog of all GL account codes used across the healthcare enterprise. Captures account code, account name, account type (asset, liability, equity, revenue, expense), account subtype, natural balance (debit/credit), financial statement classification (balance sheet, income statement), cost center applicability flag, fund applicability flag, account status (active/inactive), effective date range, and GAAP/GASB classification. Serves as the SSOT for account code definitions used in journal entries, budgets, and cost accounting.'
}

Table finance.cost_center {
  cost_center_id varchar [pk, note: 'Unique identifier for the cost center. Primary key for the cost center master record.']
  care_site_id varchar [note: 'Reference to the healthcare facility or care site where this cost center operates. Links cost center to physical location for facility-level financial reporting and multi-site cost analysis.']
  fund_id varchar [note: 'FK to finance.fund']
  general_ledger_chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: cost_center has general_ledger_account (STRING) which should be normalized to FK to chart_of_accounts. Using \'general_ledger_chart_of_accounts_id\' as the FK name to be explicit. Enables joining to get']
  parent_cost_center_id varchar [note: 'Reference to the parent cost center in the organizational cost center hierarchy. Enables roll-up reporting and hierarchical cost allocation. Null for top-level cost centers.']
  budget_amount decimal(18,2) [note: 'The approved annual budget allocation for this cost center in US dollars. Used for budget variance analysis, financial planning, and departmental performance measurement.']
  budget_fiscal_year varchar [note: 'The fiscal year for which the budget amount is allocated. Enables multi-year budget tracking and year-over-year cost center performance comparison.']
  cms_provider_number varchar [note: 'The CMS-assigned provider number for the facility or organizational unit associated with this cost center. Used for Medicare cost reporting and regulatory compliance.']
  cost_allocation_method varchar [note: 'The methodology used to allocate indirect costs to this cost center. Direct allocation assigns costs directly, step-down allocation cascades costs through support departments, activity-based costing allocates based on resource consumption, and RVU-based allocation uses relative value units for clinical departments.']
  cost_center_category varchar [note: 'Additional categorical classification for specialized cost center grouping beyond the primary type. Examples include inpatient, outpatient, emergency, surgical, diagnostic, therapeutic, administrative. Used for detailed financial analysis and reporting.']
  cost_center_code varchar [note: 'The externally-known unique alphanumeric code identifying the cost center within the healthcare organization\'s chart of accounts. Used for financial reporting, budget tracking, and departmental cost allocation.']
  cost_center_name varchar [note: 'The full descriptive name of the cost center, representing the department, unit, or functional area for which costs are tracked and budgeted.']
  cost_center_status varchar [note: 'Current lifecycle status of the cost center. Active cost centers are operational and accepting charges, inactive cost centers are temporarily disabled, pending cost centers are awaiting approval, closed cost centers are permanently retired, and suspended cost centers are on hold pending review.']
  cost_center_type varchar [note: 'Classification of the cost center by its primary business function. Clinical cost centers provide direct patient care, administrative cost centers support operations, ancillary cost centers provide diagnostic or therapeutic services, overhead cost centers represent shared services, support cost centers provide enabling functions, and revenue cost centers generate billable services.']
  cost_per_unit decimal(12,2) [note: 'The average cost per unit of service delivered by this cost center. Unit definition varies by cost center type (e.g., cost per patient day, cost per procedure, cost per visit). Used for efficiency benchmarking and pricing analysis.']
  created_timestamp timestamp [note: 'The date and time when this cost center record was first created in the system. Used for audit trail and data lineage tracking.']
  department_code varchar [note: 'The organizational department code to which this cost center belongs. Used for departmental grouping, workforce planning, and operational reporting.']
  department_name varchar [note: 'The full name of the department to which this cost center is assigned. Provides human-readable context for departmental cost analysis and reporting.']
  drg_weight decimal(6,4) [note: 'The average DRG case mix weight for patients treated in this cost center. Used for case mix index calculation, reimbursement analysis, and clinical complexity adjustment. Applicable primarily to inpatient clinical cost centers.']
  effective_end_date date [note: 'The date on which this cost center was closed or inactivated. Null for currently active cost centers. Used for historical cost analysis and departmental lifecycle management.']
  effective_start_date date [note: 'The date on which this cost center became active and began accepting financial transactions. Used for historical cost tracking and period-based financial reporting.']
  fte_allocation decimal(8,2) [note: 'The approved number of full-time equivalent positions allocated to this cost center. Used for workforce planning, labor cost analysis, and productivity measurement.']
  is_capital_intensive boolean [note: 'Indicates whether this cost center requires significant capital equipment investment. True for departments with major medical equipment (e.g., radiology, surgical services, laboratory), false for labor-intensive departments. Used for capital budgeting and depreciation allocation.']
  is_direct_patient_care boolean [note: 'Indicates whether this cost center provides direct patient care services. True for clinical departments with patient contact, false for support and administrative departments. Used for clinical cost allocation and quality reporting.']
  is_revenue_generating boolean [note: 'Indicates whether this cost center generates billable revenue through patient services. True for clinical and ancillary departments that bill for services, false for administrative and overhead departments.']
  last_modified_by varchar [note: 'The user ID or name of the person who last modified this cost center record. Used for accountability and audit trail purposes.']
  last_modified_timestamp timestamp [note: 'The date and time when this cost center record was most recently updated. Used for change tracking and audit compliance.']
  notes varchar [note: 'Free-text field for additional comments, special instructions, or contextual information about the cost center. Used for documenting organizational changes, budget justifications, or operational considerations.']
  regulatory_reporting_required boolean [note: 'Indicates whether this cost center is subject to specific regulatory reporting requirements (e.g., CMS cost reports, state health department reporting, Joint Commission reporting). Used for compliance tracking and audit preparation.']
  rvu_target decimal(12,2) [note: 'The target number of relative value units this cost center is expected to generate annually. Used for physician productivity measurement, reimbursement forecasting, and clinical efficiency analysis. Applicable to clinical cost centers with physician services.']
  service_line varchar [note: 'The clinical or operational service line to which this cost center contributes. Examples include cardiology, orthopedics, oncology, emergency services, surgical services. Used for service line profitability analysis and strategic planning.']
  unit_of_measure varchar [note: 'The unit of service used to measure cost center activity and calculate cost per unit. Examples include patient days, procedures, visits, tests, hours, admissions. Varies by cost center type and service line.']

  Note: 'Master record for all cost centers within the healthcare organization, representing the primary financial accountability unit for departmental cost tracking and budget management. Captures cost center code, cost center name, cost center type (clinical, administrative, ancillary, overhead), responsible manager, parent cost center (for hierarchy), associated facility/care site, department code, fund code, service line, active status, and effective date range. Used for cost allocation, departmental P&L, and workforce FTE budget tracking.'
}

Table finance.journal_entry {
  journal_entry_id varchar [pk, note: 'Unique identifier for the journal entry record. Primary key for the journal entry entity.']
  cost_center_id varchar [note: 'Identifier of the primary cost center associated with this journal entry. Used for departmental and responsibility accounting.']
  financial_entity_id varchar [note: 'Identifier of the legal entity or business unit to which this journal entry belongs. Critical for multi-entity consolidation and reporting.']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: journal_entry has accounting_period (STRING) which should be normalized to FK to fiscal_period master. Enables joining to get period details (start_date, end_date, period_status, close_date) and ensur']
  primary_journal_employee_id varchar [note: 'Identifier of the user or system that prepared or created the journal entry. Used for audit trail and accountability.']
  primary_reversal_journal_entry_id varchar [note: 'Reference to the journal entry that reversed this entry, if applicable. Null if the entry has not been reversed.']
  recurring_schedule_id varchar [note: 'Identifier of the recurring schedule template from which this entry was generated, if applicable. Null for non-recurring entries.']
  adjustment_type varchar [note: 'Classification of adjustment entries. Identifies whether the entry is a standard posting, prior period adjustment, audit adjustment, reclassification, or error correction.']
  approval_date date [note: 'The date on which the journal entry was approved by the designated approver. Null for entries not requiring approval or pending approval.']
  audit_trail_reference varchar [note: 'Reference identifier linking this journal entry to external audit documentation or audit trail systems. Used for regulatory compliance and audit support.']
  batch_code varchar [note: 'Identifier for the batch or group of journal entries processed together. Used for bulk posting and batch reconciliation.']
  consolidation_indicator boolean [note: 'Boolean flag indicating whether this journal entry is included in consolidated financial reporting. True if included, False if excluded.']
  created_timestamp timestamp [note: 'System timestamp indicating when this journal entry record was first created in the system. Used for audit trail and data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the currency in which the journal entry amounts are denominated.']
  effective_date date [note: 'The business date for which the journal entry is effective. This may differ from the posting date and represents the actual accounting period impact date.']
  exchange_rate decimal(12,6) [note: 'The foreign exchange rate applied to convert foreign currency amounts to the functional currency, if applicable. Null for entries in functional currency.']
  fiscal_year varchar [note: 'The fiscal year to which this journal entry belongs. Used for annual financial reporting and multi-year analysis.']
  functional_currency_code varchar [note: 'Three-letter ISO 4217 code for the functional currency of the reporting entity. Used when the entry currency differs from the functional currency.']
  gl_interface_status varchar [note: 'Status of the journal entry in the interface process to the general ledger system. Tracks whether the entry has been successfully transmitted and accepted.']
  intercompany_indicator boolean [note: 'Boolean flag indicating whether this journal entry represents an intercompany transaction between related entities. True for intercompany, False otherwise.']
  journal_category varchar [note: 'Classification of the journal entry by accounting treatment type. Common categories include accrual entries, cash receipts, payroll postings, depreciation calculations, intercompany transactions, and adjusting entries.']
  journal_entry_description varchar [note: 'Detailed narrative description of the purpose and nature of the journal entry. Provides business context for the accounting transaction.']
  journal_entry_number varchar [note: 'Business identifier for the journal entry, typically a sequential or formatted number used for external reference and audit trails.']
  journal_source varchar [note: 'Origin or method by which the journal entry was created. Indicates whether the entry was manually entered, automatically generated by a system process, part of a recurring schedule, or a reversing entry.']
  modified_timestamp timestamp [note: 'System timestamp indicating when this journal entry record was last modified. Used for audit trail and change tracking.']
  notes varchar [note: 'Additional free-form notes or comments related to the journal entry. Used for supplementary information not captured in structured fields.']
  posted_timestamp timestamp [note: 'System timestamp indicating when this journal entry was posted to the general ledger. Null for entries not yet posted.']
  posting_date date [note: 'The date on which the journal entry was posted to the general ledger. This is the system date when the entry became part of the official accounting records.']
  posting_status varchar [note: 'Current lifecycle status of the journal entry. Tracks progression from draft through approval, posting, and potential reversal.']
  recurring_entry_indicator boolean [note: 'Boolean flag indicating whether this journal entry is part of a recurring schedule. True for recurring entries, False for one-time entries.']
  regulatory_reporting_indicator boolean [note: 'Boolean flag indicating whether this journal entry impacts regulatory reporting requirements such as CMS cost reports or state financial filings. True if reportable, False otherwise.']
  reversal_date date [note: 'The date on which this journal entry was reversed. Null if the entry has not been reversed.']
  reversal_indicator boolean [note: 'Boolean flag indicating whether this journal entry has been reversed. True if reversed, False if active.']
  reversal_reason_code varchar [note: 'Code indicating the reason for reversing this journal entry, if applicable. Examples include error correction, period adjustment, or policy change.']
  source_system_code varchar [note: 'Code identifying the originating system or module that generated this journal entry. Examples include Epic Resolute, SAP FI, Workday, or manual entry.']
  source_transaction_reference varchar [note: 'Identifier of the originating transaction in the source system that triggered this journal entry. Used for traceability and reconciliation.']
  supporting_document_reference varchar [note: 'Reference identifier or URI to supporting documentation for this journal entry, such as invoices, contracts, or approval memos. Used for audit and compliance.']
  total_credit_amount decimal(18,2) [note: 'The sum of all credit amounts across all line items in this journal entry. Must equal total debit amount for a balanced entry.']
  total_debit_amount decimal(18,2) [note: 'The sum of all debit amounts across all line items in this journal entry. Must equal total credit amount for a balanced entry.']

  Note: 'Core transactional record of every journal entry posted to the general ledger. Captures journal entry number, journal source (manual, system-generated, recurring, reversing), journal category (accrual, cash receipt, payroll, depreciation, intercompany), accounting period, fiscal year, posting date, effective date, total debit amount, total credit amount, currency code, exchange rate, preparer ID, approver ID, approval date, posting status (draft, approved, posted, reversed), reversal indicator, reversal journal entry reference, and supporting document reference. SSOT for all GL postings.'
}

Table finance.journal_entry_line {
  journal_entry_line_id varchar [pk, note: 'Unique identifier for the journal entry line. Primary key for the journal entry line product.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: journal_entry_line has gl_account_code (STRING) which should be normalized to a FK to chart_of_accounts master. This establishes referential integrity and allows joining to get account_name, account_t']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: journal_entry_line has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for journal entry line allocation.']
  drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: Healthcare finance requires linking journal entries to DRGs for Medicare cost reporting, case-mix analysis, and reimbursement reconciliation. The existing drg_code string should be replaced with a pro']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: journal_entry_line has accounting_period (STRING) which should be normalized to FK to fiscal_period master. Enables joining to get period details at the line level. Note: journal_entry already has fis']
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: journal_entry_line has fund_code (STRING) which should be normalized to FK to fund master. Enables joining to get fund details for fund accounting at the journal entry line level.']
  journal_entry_id varchar [note: 'Reference to the parent journal entry header that this line belongs to. Links the line to its containing journal entry batch.']
  primary_journal_employee_id varchar [note: 'The user ID of the person or system account that created this journal entry line. Used for audit trail and accountability.']
  primary_reversed_line_journal_entry_line_id varchar [note: 'Reference to the original journal entry line that this line reverses. Null if this is not a reversal entry. Provides audit trail for corrections.']
  tertiary_journal_approved_by_user_employee_id varchar [note: 'The user ID of the person who approved this journal entry line for posting. Null if not yet approved. Used for segregation of duties and internal controls.']
  approved_timestamp timestamp [note: 'The date and time when this journal entry line was approved for posting. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Null if not yet approved. Used for audit trail.']
  created_timestamp timestamp [note: 'The date and time when this journal entry line record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for audit trail.']
  credit_amount decimal(18,2) [note: 'The credit amount for this journal entry line in functional currency. Zero or null if this is a debit line. Credits increase liability, equity, and revenue accounts.']
  debit_amount decimal(18,2) [note: 'The debit amount for this journal entry line in functional currency. Zero or null if this is a credit line. Debits increase asset and expense accounts.']
  department_code varchar [note: 'Department segment code for detailed organizational reporting. Provides finer granularity than cost center for departmental analysis.']
  exchange_rate decimal(12,6) [note: 'The exchange rate used to convert transaction currency to functional currency. Expressed as functional currency per unit of transaction currency.']
  fiscal_year varchar [note: 'The fiscal year to which this journal entry line belongs. Used for annual financial reporting and multi-year analysis.']
  functional_currency_code varchar [note: 'The functional currency of the organization in which the debit and credit amounts are recorded. Three-letter ISO 4217 currency code.']
  intercompany_entity_code varchar [note: 'The code of the counterparty legal entity for intercompany transactions. Used for intercompany reconciliation and elimination entries during consolidation.']
  intercompany_indicator boolean [note: 'Flag indicating whether this line represents an intercompany transaction between legal entities within the healthcare system. True if intercompany, false otherwise.']
  line_description varchar [note: 'Detailed description of the purpose and nature of this specific journal entry line. Provides audit trail and business context for the posting.']
  line_number varchar [note: 'Sequential line number within the journal entry, used for ordering and referencing individual lines within the entry.']
  location_code varchar [note: 'Physical location or facility code where the transaction occurred. Used for multi-site healthcare systems to track financial activity by hospital, clinic, or facility.']
  modified_timestamp timestamp [note: 'The date and time when this journal entry line record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for audit trail and change tracking.']
  natural_account_code varchar [note: 'Natural account classification code representing the type of expense or revenue (e.g., salaries, supplies, utilities). Part of the chart of accounts structure.']
  payer_code varchar [note: 'Payer or insurance plan code for revenue and receivables tracking. Used to analyze financial performance by payer mix (Medicare, Medicaid, commercial, self-pay).']
  posting_date date [note: 'The date when this journal entry line was posted to the general ledger. Determines the accounting period for financial reporting. Format: yyyy-MM-dd.']
  posting_status varchar [note: 'Current posting status of the journal entry line. Tracks the lifecycle from draft through posting to final state. Posted lines affect the general ledger balances.']
  program_code varchar [note: 'Program or service line code for program-based reporting. Examples include cardiology, oncology, orthopedics, or community health programs.']
  project_code varchar [note: 'Project or grant identifier for project-based accounting. Used to track capital projects, research grants, and special initiatives.']
  reconciliation_date date [note: 'The date when this journal entry line was reconciled. Format: yyyy-MM-dd. Null if not yet reconciled. Used for account reconciliation tracking.']
  reconciliation_status varchar [note: 'The reconciliation status of this journal entry line. Tracks whether the line has been reconciled with supporting documentation or subsidiary ledgers.']
  reversal_indicator boolean [note: 'Flag indicating whether this line is part of a reversing journal entry. True if this line reverses a prior entry, false for original postings.']
  source_document_number varchar [note: 'The reference number of the source document that generated this journal entry line (e.g., invoice number, payment batch number, payroll run ID). Provides audit trail to originating transaction.']
  source_system_code varchar [note: 'The source system or module that originated this journal entry line. Examples include Epic (Resolute), SAP FI, Workday Financials, or manual entry. [ENUM-REF-CANDIDATE: epic|cerner|sap|workday|meditech|manual|other — 7 candidates stripped; promote to reference product]']
  statistical_amount decimal(18,4) [note: 'Non-monetary statistical quantity associated with this line, such as patient days, procedures performed, or full-time equivalents (FTE). Used for cost allocation and unit cost analysis.']
  statistical_uom varchar [note: 'The unit of measure for the statistical amount. Common healthcare units include patient days, procedures, FTE (full-time equivalents), visits, admissions, discharges, bed days, and RVUs (relative value units). [ENUM-REF-CANDIDATE: patient_days|procedures|fte|visits|admissions|discharges|bed_days|rvus|other — 9 candidates stripped; promote to reference product]']
  transaction_amount decimal(18,2) [note: 'The original transaction amount in transaction currency before conversion to functional currency. Used for foreign currency accounting and reconciliation.']
  transaction_currency_code varchar [note: 'The original transaction currency if different from functional currency. Three-letter ISO 4217 currency code. Used for foreign currency transactions.']

  Note: 'Individual debit or credit line within a journal entry, representing the atomic unit of GL posting. Captures journal entry reference, line sequence number, GL account code, cost center code, fund code, project code, debit amount, credit amount, functional currency amount, transaction currency amount, exchange rate, line description, intercompany indicator, intercompany entity, statistical amount, statistical UOM, and segment values (department, location, program). Enables full account-level drill-down for financial reporting and audit.'
}

Table finance.fiscal_period {
  fiscal_period_id varchar [pk, note: 'Unique identifier for the fiscal period record. Primary key.']
  general_ledger_id varchar [note: 'Reference to the general ledger to which this fiscal period applies. Supports multi-ledger environments (e.g., corporate ledger, statutory ledger, management ledger).']
  parent_fiscal_period_id varchar [note: 'Self-referencing FK on fiscal_period (parent_fiscal_period_id)']
  parent_period_fiscal_period_id varchar [note: 'Reference to the parent fiscal period in a hierarchical structure (e.g., a monthly period references its parent quarter, a quarter references its parent year). Null for top-level periods.']
  primary_prior_period_fiscal_period_id varchar [note: 'Reference to the immediately preceding fiscal period of the same type. Used for period-over-period comparisons and sequential processing.']
  adjustment_period_flag boolean [note: 'Indicates whether this is an adjustment period used for year-end closing entries. True if adjustment period, False otherwise.']
  budget_period_flag boolean [note: 'Indicates whether this fiscal period is used for budget planning and allocation. True if budget period, False otherwise.']
  business_days_in_period varchar [note: 'The total number of business days (excluding weekends and holidays) in the fiscal period. Used for operational and productivity metrics.']
  calendar_month varchar [note: 'The calendar month in which the fiscal period starts (1-12). Null for non-monthly periods.']
  calendar_quarter varchar [note: 'The calendar quarter in which the fiscal period starts (1, 2, 3, or 4). Null for non-monthly periods.']
  calendar_year varchar [note: 'The calendar year in which the fiscal period starts (e.g., 2024). May differ from fiscal_year for organizations with non-calendar fiscal years.']
  close_approved_by varchar [note: 'The username or identifier of the user who approved the period close. Used for segregation of duties and audit trail.']
  close_date date [note: 'The date when the fiscal period was closed. Null if the period is still open or future. Format: yyyy-MM-dd.']
  close_initiated_by varchar [note: 'The username or identifier of the user who initiated the period close process. Used for audit trail and accountability.']
  cms_reporting_period_flag boolean [note: 'Indicates whether this fiscal period is used for CMS cost reporting and reimbursement submissions. True if CMS reporting period, False otherwise.']
  created_timestamp timestamp [note: 'The date and time when this fiscal period record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  days_in_period varchar [note: 'The total number of calendar days in the fiscal period. Calculated as end_date minus start_date plus one.']
  end_date date [note: 'The last day of the fiscal period. Format: yyyy-MM-dd.']
  fiscal_period_description varchar [note: 'Additional descriptive text or notes about the fiscal period, such as special circumstances, adjustments, or business context.']
  fiscal_year varchar [note: 'The fiscal year to which this period belongs (e.g., 2024).']
  period_end_close_checklist_complete_flag boolean [note: 'Indicates whether all period-end close checklist tasks have been completed for this period. True if complete, False otherwise.']
  period_name varchar [note: 'Human-readable name of the fiscal period (e.g., \'January 2024\', \'Q1 FY2024\', \'FY2024\').']
  period_number varchar [note: 'Sequential number of the period within the fiscal year (e.g., 1 for January, 2 for February, or 1 for Q1).']
  period_status varchar [note: 'Current status of the fiscal period: future (not yet started), open (available for journal entry posting), closed (temporarily closed, can be reopened), permanently_closed (locked, no further entries allowed).']
  period_type varchar [note: 'Type of fiscal period: month (monthly period), quarter (quarterly period), year (annual period), or adjustment (adjustment period for year-end entries).']
  permanent_close_date date [note: 'The date when the fiscal period was permanently closed and locked from further entries. Null if not permanently closed. Format: yyyy-MM-dd.']
  quarter_number varchar [note: 'The fiscal quarter number within the fiscal year (1, 2, 3, or 4). Null for non-monthly periods or adjustment periods.']
  reopen_date date [note: 'The date when a previously closed period was reopened for adjustments. Null if never reopened. Format: yyyy-MM-dd.']
  reporting_period_flag boolean [note: 'Indicates whether this fiscal period is used for external financial reporting (e.g., quarterly earnings, annual reports). True if reporting period, False otherwise.']
  start_date date [note: 'The first day of the fiscal period. Format: yyyy-MM-dd.']
  updated_timestamp timestamp [note: 'The date and time when this fiscal period record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']

  Note: 'Reference master defining all fiscal periods, quarters, and fiscal years for the healthcare organization\'s financial calendar. Captures period name, period number, fiscal year, period type (month, quarter, year), start date, end date, period status (open, closed, permanently closed, future), close date, ledger association, and period-end close checklist completion flag. Controls which periods are open for journal entry posting and drives financial period-end close workflows.'
}

Table finance.budget {
  budget_id varchar [pk, note: 'Unique identifier for the budget record. Primary key.']
  care_site_id varchar [note: 'Reference to the healthcare facility (hospital, clinic, outpatient center) to which this budget applies.']
  cost_center_id varchar [note: 'Reference to the cost center or department to which this budget is assigned.']
  financial_entity_id varchar [note: 'Foreign key linking to finance.financial_entity. Business justification: budget should link to financial_entity to identify which legal entity the budget belongs to. This is essential for multi-entity healthcare organizations to track budgets by subsidiary. No existing att']
  fte_budget_id varchar [note: 'Foreign key linking to workforce.fte_budget. Business justification: Master budget consolidates detailed FTE budgets. Links operational workforce budget detail to enterprise budget for labor cost rollup, budget-to-actual variance analysis, and consolidated financial re']
  org_unit_id varchar [note: 'Reference to the organizational department responsible for this budget.']
  parent_budget_id varchar [note: 'Reference to a parent or master budget if this budget is a sub-budget or departmental allocation within a larger organizational budget.']
  position_id varchar [note: 'Foreign key linking to workforce.position. Business justification: Budgets are allocated to positions (budgeted headcount). Links budget line items to specific authorized positions for variance analysis, vacancy tracking, and position control reporting required for w']
  primary_budget_employee_id varchar [note: 'Reference to the employee or manager who owns and is accountable for this budget.']
  primary_prior_budget_id varchar [note: 'Self-referencing FK on budget (prior_budget_id)']
  approval_date date [note: 'Date when the budget was officially approved by authorized management or board.']
  assumptions varchar [note: 'Key assumptions underlying the budget (e.g., inflation rate, patient volume growth, reimbursement rate changes).']
  budget_category varchar [note: 'High-level expense category classification for the budget: personnel (salaries, benefits), supplies (medical and office), equipment (capital purchases), facilities (rent, utilities), services (contracted), overhead (indirect costs), or other. [ENUM-REF-CANDIDATE: personnel|supplies|equipment|facilities|services|overhead|other — 7 candidates stripped; promote to reference product]']
  budget_name varchar [note: 'Human-readable name or title of the budget (e.g., \'FY2024 Operating Budget - Cardiology Department\').']
  budget_number varchar [note: 'Externally-known unique business identifier for the budget, used in financial reporting and communications.']
  budget_status varchar [note: 'Current lifecycle status of the budget: draft (being prepared), submitted (awaiting review), under_review (in approval process), approved (authorized but not yet active), active (in effect), closed (fiscal period ended), cancelled (withdrawn). [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|active|closed|cancelled — 7 candidates stripped; promote to reference product]']
  budget_type varchar [note: 'Classification of the budget by its purpose: operating (day-to-day expenses), capital (long-term investments), cash flow (liquidity planning), grant (externally funded), project (specific initiative), or departmental (unit-level).']
  budgeted_cmi decimal(5,4) [note: 'Projected average case mix index reflecting the expected complexity and resource intensity of patient cases.']
  budgeted_fte_count decimal(10,2) [note: 'Total number of full-time equivalent staff positions budgeted for the period.']
  budgeted_net_income decimal(18,2) [note: 'Projected net income (revenue minus expenses) for the fiscal period, in USD.']
  budgeted_patient_volume varchar [note: 'Projected number of patient encounters or admissions for the fiscal period, used for volume-based budgeting.']
  created_timestamp timestamp [note: 'Timestamp when this budget record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this budget (e.g., USD).']
  effective_end_date date [note: 'Date when this budget period ends and the budget is closed.']
  effective_start_date date [note: 'Date when this budget becomes effective and active for financial tracking.']
  fiscal_year varchar [note: 'The fiscal year for which this budget applies (e.g., 2024 for FY2024).']
  funding_source varchar [note: 'Primary source of funding for this budget: internal operations, federal grant, state grant, private foundation, donor contribution, research contract, or other. [ENUM-REF-CANDIDATE: internal|federal_grant|state_grant|private_foundation|donor|research_contract|other — 7 candidates stripped; promote to reference product]']
  grant_number varchar [note: 'External grant or funding source identifier if this budget is associated with a specific grant award.']
  is_baseline_budget boolean [note: 'Indicates whether this is the baseline (original approved) budget used for variance analysis. True if baseline, False otherwise.']
  last_modified_timestamp timestamp [note: 'Timestamp when this budget record was last updated or modified.']
  methodology varchar [note: 'Budgeting approach used: zero_based (justify all expenses from zero), incremental (adjust prior year), activity_based (cost by activity), value_based (align with value drivers), rolling (continuous forecast).']
  narrative varchar [note: 'Detailed textual description or justification of the budget, including assumptions, strategic priorities, and key drivers.']
  notes varchar [note: 'Additional operational notes, comments, or special instructions related to the budget.']
  submission_date date [note: 'Date when the budget was formally submitted for review and approval.']
  total_budgeted_capital decimal(18,2) [note: 'Total capital expenditure amount budgeted for long-term investments (equipment, facilities, technology), in USD.']
  total_budgeted_expense decimal(18,2) [note: 'Total operating expense amount budgeted for the fiscal period, in USD.']
  total_budgeted_revenue decimal(18,2) [note: 'Total revenue amount budgeted for the fiscal period, in USD.']
  variance_threshold_percent decimal(5,2) [note: 'Acceptable variance percentage threshold for budget-to-actual monitoring; triggers review if exceeded.']
  version varchar [note: 'Version of the budget: original (initial submission), revised (mid-year adjustment), final (approved version), supplemental (additional allocation).']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']

  Note: 'Master record for each approved operating or capital budget for the healthcare organization. Captures budget name, budget type (operating, capital, cash flow, grant), fiscal year, budget version (original, revised, final), budget status (draft, submitted, approved, active, closed), approval date, approver, total budgeted revenue, total budgeted expense, total budgeted capital, budget methodology (zero-based, incremental, activity-based), associated cost center or department, and budget narrative. SSOT for all budget authorizations.'
}

Table finance.budget_line {
  budget_line_id varchar [pk, note: 'Unique identifier for the budget line item. Primary key for the budget line entity.']
  budget_id varchar [note: 'Reference to the parent budget document or master budget to which this line item belongs.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: budget_line has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata and ensures budget lines reference valid GL accounts.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: budget_line has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost_center_name, cost_center_type, and ensures referential integrity.']
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: budget_line has fund_code (STRING) which should be normalized to FK to fund master. Enables joining to get fund_name, fund_type, restriction_type, and ensures budget lines reference valid funds.']
  parent_budget_line_id varchar [note: 'Self-referencing FK on budget_line (parent_budget_line_id)']
  allocation_method varchar [note: 'Method used to allocate indirect costs or shared expenses to this budget line (e.g., direct, step-down, activity-based, proportional).']
  allocation_percentage decimal(5,2) [note: 'Percentage of total cost allocated to this budget line when using proportional or percentage-based allocation methods.']
  approval_status varchar [note: 'Current approval status of this budget line item in the budget approval workflow.']
  approved_by varchar [note: 'Name or identifier of the individual who approved this budget line item.']
  approved_date date [note: 'Date on which this budget line item was approved.']
  budgeted_amount decimal(18,2) [note: 'The approved budgeted dollar amount allocated to this line item for the specified period. Primary financial measure for variance analysis.']
  created_timestamp timestamp [note: 'Timestamp when this budget line record was first created in the system. Audit trail field.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the budgeted amount (e.g., USD, EUR, GBP). Supports multi-currency budget management.']
  effective_end_date date [note: 'Date on which this budget line ceases to be effective. Null for ongoing budget lines.']
  effective_start_date date [note: 'Date from which this budget line becomes effective and active for financial tracking.']
  fiscal_period varchar [note: 'The fiscal period within the year (e.g., Q1, Q2, M01, M02, FY for full year). Enables period-level budget tracking and variance analysis.']
  fiscal_year varchar [note: 'The fiscal year to which this budget line applies (e.g., 2024).']
  fte_count decimal(8,2) [note: 'Number of full-time equivalent positions budgeted for this line item. Applicable primarily to salary and benefits budget lines.']
  is_capital boolean [note: 'Boolean flag indicating whether this budget line represents a capital expenditure (True) or operating expenditure (False).']
  is_restricted boolean [note: 'Boolean flag indicating whether this budget line is funded by restricted funds (True) or unrestricted funds (False). Common in not-for-profit healthcare organizations.']
  line_notes varchar [note: 'Free-text notes or comments providing additional context, assumptions, or justification for this budget line item.']
  line_number varchar [note: 'Sequential line number within the parent budget document for ordering and reference purposes.']
  modified_by varchar [note: 'User identifier or name of the individual who last modified this budget line record. Audit trail field.']
  modified_timestamp timestamp [note: 'Timestamp when this budget line record was last modified. Audit trail field.']
  prior_year_actual decimal(18,2) [note: 'Actual expenditure amount for this line item in the prior fiscal year. Used for trend analysis and budget variance comparison.']
  service_line_code varchar [note: 'Clinical or operational service line code (e.g., cardiology, orthopedics, emergency services) for service line profitability and budget management.']
  statistical_basis varchar [note: 'Description of the statistical or actuarial basis used to calculate this budget line (e.g., historical trend, regression model, industry benchmark, clinical guideline).']
  variance_threshold_percent decimal(5,2) [note: 'Acceptable variance threshold percentage for this budget line. Variances exceeding this threshold trigger management review or corrective action.']
  volume_assumption decimal(12,2) [note: 'The volume metric assumption underlying this budget line (e.g., patient days, procedures, visits, admissions). Used for flexible budgeting and variance analysis.']
  volume_unit varchar [note: 'Unit of measure for the volume assumption (e.g., patient days, procedures, visits, admissions, discharges, RVUs).']
  created_by varchar [note: 'User identifier or name of the individual who created this budget line record. Audit trail field.']

  Note: 'Individual line-item detail within an approved budget, representing the granular allocation of budgeted amounts by account, cost center, and period. Captures budget reference, GL account code, cost center code, fund code, service line, fiscal period, budgeted amount, budget category (salary, benefits, supplies, purchased services, depreciation, capital), FTE count budgeted, volume assumption, statistical basis, and line notes. Enables variance analysis between actual and budgeted amounts at the account-period level.'
}

Table finance.budget_transfer {
  budget_transfer_id varchar [pk, note: 'Unique identifier for the budget transfer transaction. Primary key for the budget transfer record.']
  approver_employee_id varchar [note: 'Identifier of the employee who approved the budget transfer. Links to the employee master data for authorization tracking and compliance.']
  budget_employee_id varchar [note: 'System user identifier of the person who created this budget transfer record in the system. Part of standard audit trail.']
  budget_modified_by_user_employee_id varchar [note: 'System user identifier of the person who last modified this budget transfer record. Part of standard audit trail for accountability.']
  destination_budget_line_id varchar [note: 'Identifier of the specific budget line item to which funds are being transferred. Links to the budget line master data.']
  destination_cost_center_id varchar [note: 'Identifier of the cost center, department, or organizational unit to which budget funds are being transferred. Links to the cost center master data.']
  destination_gl_account_chart_of_accounts_id varchar [note: 'Identifier of the general ledger account to which budget funds are being transferred. Links to the chart of accounts.']
  journal_entry_id varchar [note: 'Identifier of the general ledger journal entry that recorded this budget transfer in the financial system. Links to the journal entry master data for financial reconciliation.']
  primary_budget_chart_of_accounts_id varchar [note: 'Identifier of the general ledger account from which budget funds are being transferred. Links to the chart of accounts.']
  primary_budget_requestor_employee_id varchar [note: 'Identifier of the employee who initiated or requested the budget transfer. Links to the employee master data for accountability tracking.']
  primary_original_transfer_budget_transfer_id varchar [note: 'If this transfer is a reversal or correction of a previous transfer, this field contains the budget_transfer_id of the original transfer being reversed. Null for original transfers.']
  source_budget_line_id varchar [note: 'Identifier of the specific budget line item from which funds are being transferred. Links to the budget line master data.']
  source_cost_center_id varchar [note: 'Identifier of the cost center, department, or organizational unit from which budget funds are being transferred. Links to the cost center master data.']
  approval_date date [note: 'The date when the budget transfer was formally approved by the authorized approver. Null if transfer is not yet approved.']
  approval_level varchar [note: 'The organizational level at which the budget transfer was approved, indicating the authority level required based on transfer amount and type: department_manager, director, vice_president, chief_financial_officer (CFO), or board_of_directors.']
  approver_name varchar [note: 'Full name of the employee who approved the budget transfer, captured for audit trail and accountability.']
  audit_trail_reference varchar [note: 'Reference identifier to the complete audit trail or change log for this budget transfer, linking to detailed history of all modifications and approvals.']
  batch_code varchar [note: 'Identifier for a batch or group of related budget transfers processed together, typically used for mass budget adjustments or year-end reallocations.']
  comments varchar [note: 'Additional free-text comments, notes, or context about the budget transfer that do not fit in other structured fields. Used for collaboration and documentation.']
  compliance_flag boolean [note: 'Boolean indicator of whether this budget transfer complies with all applicable financial policies, regulatory requirements, and budget constraints. True if compliant, False if exceptions exist.']
  compliance_notes varchar [note: 'Free-text notes documenting compliance review findings, exceptions, or special considerations related to regulatory or policy requirements.']
  created_timestamp timestamp [note: 'System timestamp when this budget transfer record was first created in the database. Part of standard audit trail for data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the transfer amount (e.g., USD, EUR, GBP). Required for multi-currency healthcare systems.']
  effective_date date [note: 'The date when the budget transfer becomes binding and the budget changes take effect in the financial system. May differ from transfer_date for future-dated transfers.']
  fiscal_period varchar [note: 'The fiscal period (month or quarter) within the fiscal year to which this transfer applies, typically 1-12 for monthly periods or 1-4 for quarterly periods.']
  fiscal_year varchar [note: 'The fiscal year to which this budget transfer applies, typically a four-digit year (e.g., 2024). Critical for period-based budget management and year-end reconciliation.']
  modified_timestamp timestamp [note: 'System timestamp when this budget transfer record was last modified in the database. Part of standard audit trail for change tracking.']
  requestor_department varchar [note: 'Name of the department or organizational unit of the employee who requested the transfer, for organizational analysis and reporting.']
  requestor_name varchar [note: 'Full name of the employee who requested the budget transfer, captured for audit trail and reporting purposes.']
  reversal_date date [note: 'The date when this budget transfer was reversed or undone. Null if the transfer has not been reversed.']
  reversal_flag boolean [note: 'Boolean indicator of whether this budget transfer has been reversed or undone. True if reversed, False if still in effect.']
  reversal_reason varchar [note: 'Narrative explanation of why the budget transfer was reversed, including business justification and corrective action taken.']
  supporting_document_reference varchar [note: 'Reference identifier or URI to supporting documentation for the budget transfer (e.g., memo, business case, board resolution, email approval). Critical for audit trail and compliance.']
  transfer_amount decimal(18,2) [note: 'The monetary value being transferred from the source budget line to the destination budget line. Always positive; direction is indicated by source/destination fields.']
  transfer_date date [note: 'The business date when the budget transfer was initiated or became effective. This is the principal business event timestamp for the transaction, distinct from audit timestamps.']
  transfer_number varchar [note: 'Externally-visible unique business identifier for the budget transfer, typically formatted as BT-YYYYNNNN for tracking and audit purposes.']
  transfer_reason_code varchar [note: 'Standardized code indicating the primary business reason for the budget transfer: operational_need (operational requirements changed), cost_overrun (original budget insufficient), revenue_shortfall (revenue below projections), strategic_priority (strategic initiative funding), regulatory_requirement (compliance mandate), or emergency_response (urgent unplanned need).']
  transfer_reason_description varchar [note: 'Detailed narrative explanation of the business justification for the budget transfer, including context, impact, and supporting rationale. Critical for audit trail and management review.']
  transfer_status varchar [note: 'Current lifecycle state of the budget transfer: draft (being prepared), pending_approval (submitted for review), approved (authorized to proceed), rejected (denied), in_progress (being executed), completed (fully processed), cancelled (withdrawn before completion), or reversed (undone after completion). [ENUM-REF-CANDIDATE: draft|pending_approval|approved|rejected|in_progress|completed|cancelled|reversed — 8 candidates stripped; promote to reference product]']
  transfer_type varchar [note: 'Classification of the budget modification: budget amendment (formal change to approved budget), budget transfer (movement between cost centers), budget revision (adjustment to budget assumptions), budget reallocation (redistribution within same department), supplemental appropriation (additional funding), or technical adjustment (correction without policy change).']

  Note: 'Transactional record of approved budget transfers and amendments between cost centers, accounts, or periods within an approved budget. Captures transfer date, transfer type (budget amendment, budget transfer, budget revision), source budget line, destination budget line, transfer amount, transfer reason, requestor, approver, approval date, and supporting documentation reference. Maintains a complete audit trail of all budget modifications post-approval.'
}

Table finance.ap_invoice {
  ap_invoice_id varchar [pk, note: 'Unique identifier for the accounts payable invoice record. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or location to which this invoice is allocated.']
  cost_center_id varchar [note: 'FK to finance.cost_center']
  credited_ap_invoice_id varchar [note: 'Self-referencing FK on ap_invoice (credited_ap_invoice_id)']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: Invoices must be assigned to fiscal periods for accrual accounting, expense recognition timing, period-end close, and financial statement accuracy. Complements gl_date with structured period assignmen']
  org_unit_id varchar [note: 'Identifier of the department that is responsible for this invoice expense.']
  primary_ap_employee_id varchar [note: 'Identifier of the employee who approved this invoice for payment.']
  requester_employee_id varchar [note: 'Identifier of the employee who requested the goods or services that resulted in this invoice.']
  vendor_id varchar [note: 'Identifier of the vendor who issued this invoice. Links to the vendor master record.']
  vendor_site_id varchar [note: 'Identifier of the specific vendor site or remit-to location associated with this invoice.']
  ap_invoice_description varchar [note: 'A free-text description of the goods or services covered by this invoice.']
  approval_date date [note: 'The date the invoice was approved for payment.']
  approval_status varchar [note: 'The current status of the invoice in the approval workflow: pending (awaiting approval), approved (authorized for payment), rejected (returned to requester), or escalated (sent to higher authority).']
  created_timestamp timestamp [note: 'The date and time when this invoice record was first created in the accounts payable system.']
  discount_amount decimal(18,2) [note: 'The total discount amount applied to the invoice (early payment discounts, volume discounts, or negotiated price reductions).']
  due_date date [note: 'The date by which payment is due to the vendor per the payment terms.']
  exchange_rate decimal(12,6) [note: 'The currency exchange rate used to convert the invoice amount from the invoice currency to the organization\'s functional currency, if applicable.']
  freight_amount decimal(18,2) [note: 'The shipping and freight charges included in the invoice.']
  functional_currency_amount decimal(18,2) [note: 'The total invoice amount converted to the organization\'s functional currency using the exchange rate, for consolidated financial reporting.']
  gl_account_code varchar [note: 'The general ledger account code to which this invoice is posted in the chart of accounts.']
  gl_date date [note: 'The accounting period date when this invoice is posted to the general ledger.']
  hold_date date [note: 'The date the invoice was placed on hold.']
  hold_reason_code varchar [note: 'The code indicating why the invoice is on hold (e.g., pricing variance, missing receipt, duplicate invoice, vendor on hold, budget exceeded).']
  hold_released_date date [note: 'The date the hold was released and the invoice was returned to normal processing.']
  invoice_amount decimal(18,2) [note: 'The gross total amount of the invoice before taxes and freight, representing the base charge for goods or services.']
  invoice_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the invoice is denominated (e.g., USD, EUR, GBP).']
  invoice_date date [note: 'The date the vendor issued the invoice. This is the principal business event timestamp for the invoice transaction.']
  invoice_number varchar [note: 'The externally-known vendor-assigned invoice number that uniquely identifies this invoice in the vendor\'s system and on the physical/electronic invoice document.']
  invoice_source varchar [note: 'The channel through which the invoice was received: manual_entry (keyed by AP clerk), edi (Electronic Data Interchange), email (scanned attachment), ocr (Optical Character Recognition from paper), supplier_portal (vendor self-service portal), or api (system-to-system integration).']
  invoice_status varchar [note: 'The current lifecycle status of the invoice in the accounts payable workflow: received (entered into system), validated (passed data quality checks), matched (matched to PO and receipt), approved (approved for payment), on_hold (payment hold applied), scheduled_for_payment (queued for payment run), paid (payment issued), cancelled (invoice voided), or rejected (invoice returned to vendor). [ENUM-REF-CANDIDATE: received|validated|matched|approved|on_hold|scheduled_for_payment|paid|cancelled|rejected — 9 candidates stripped; promote to reference product]']
  invoice_type varchar [note: 'The classification of the invoice transaction: standard invoice for goods/services, credit memo for returns/adjustments, debit memo for additional charges, prepayment for advance payments, expense report for employee reimbursements, or recurring for subscription-based invoices.']
  payment_method varchar [note: 'The payment instrument used to pay this invoice: check (paper check), ach (Automated Clearing House), wire_transfer (bank wire), eft (Electronic Funds Transfer), credit_card (corporate card), or virtual_card (single-use virtual card).']
  payment_reference_number varchar [note: 'The check number, ACH trace number, wire confirmation number, or other payment transaction identifier.']
  payment_terms varchar [note: 'The payment terms agreed with the vendor (e.g., Net 30, Net 60, 2/10 Net 30) that define the due date and any early payment discounts.']
  po_match_indicator boolean [note: 'Boolean flag indicating whether this invoice has been matched to a purchase order (True) or is a non-PO invoice (False).']
  po_number varchar [note: 'The purchase order number that this invoice is matched against, if applicable. Used for three-way matching (PO, receipt, invoice).']
  received_date date [note: 'The date the healthcare organization received the invoice from the vendor.']
  tax_amount decimal(18,2) [note: 'The total tax amount charged on the invoice (sales tax, VAT, GST, or other applicable taxes).']
  tax_code varchar [note: 'The tax jurisdiction or tax rate code applied to this invoice for sales tax, VAT, or GST calculation.']
  three_way_match_status varchar [note: 'The status of the three-way match process (PO, receipt, invoice): not_applicable (non-PO invoice), pending (match in progress), matched (all three documents reconciled), variance (discrepancies identified within tolerance), or failed (discrepancies exceed tolerance).']
  total_amount decimal(18,2) [note: 'The net total amount payable to the vendor, calculated as invoice_amount + tax_amount + freight_amount - discount_amount.']
  updated_timestamp timestamp [note: 'The date and time when this invoice record was last modified in the accounts payable system.']
  voucher_number varchar [note: 'The internal accounting voucher number assigned to this invoice for general ledger posting and audit trail purposes.']

  Note: 'Core accounts payable invoice record representing a vendor invoice received by the healthcare organization for goods or services. Captures invoice number, vendor ID, vendor name, invoice date, received date, due date, payment terms, invoice type (standard, credit memo, debit memo, prepayment), invoice currency, invoice amount, tax amount, freight amount, invoice status (received, matched, approved, on hold, paid, cancelled), PO match indicator, three-way match status, cost center, GL account, and approval workflow status. SSOT for all vendor payables.'
}

Table finance.ap_invoice_line {
  ap_invoice_line_id varchar [pk, note: 'Unique identifier for the accounts payable invoice line item. Primary key for this entity.']
  ap_invoice_id varchar [note: 'Reference to the parent accounts payable invoice header. Links this line item to its parent invoice document.']
  approver_employee_id varchar [note: 'Employee identifier of the manager or authorized approver who approved this line item for payment. Supports audit trail and segregation of duties.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: ap_invoice_line has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata and ensures invoice lines reference valid GL accounts for ex']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: ap_invoice_line has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for expense allocation and ensures referential integrit']
  credited_ap_invoice_line_id varchar [note: 'Self-referencing FK on ap_invoice_line (credited_ap_invoice_line_id)']
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: ap_invoice_line has fund_code (STRING) which should be normalized to FK to fund master. Enables joining to get fund details for restricted fund accounting and ensures invoice lines reference valid fun']
  goods_receipt_id varchar [note: 'Foreign key linking to supply.goods_receipt. Business justification: Invoice lines link to goods receipt for three-way match completion, quantity/quality verification, and received-not-invoiced accrual reconciliation. Required for accurate period-end accruals and AP au']
  purchase_order_line_id varchar [note: 'Foreign key linking to supply.purchase_order_line. Business justification: Invoice lines must link to PO lines for three-way match validation (PO-receipt-invoice), price variance analysis, and automated GL account inheritance from PO. Core AP matching process.']
  requester_employee_id varchar [note: 'Employee identifier of the person who requested or authorized this purchase. Supports accountability and spend analysis by requester.']
  asset_category varchar [note: 'Asset category or class for capital items. Determines depreciation method, useful life, and financial statement classification for capitalized purchases.']
  asset_flag boolean [note: 'Indicates whether this line item represents a capital asset purchase that should be capitalized rather than expensed. Triggers asset tracking and depreciation processes.']
  contract_number varchar [note: 'Vendor contract or agreement number governing the pricing and terms for this line item. Links the invoice to negotiated contract terms for compliance verification.']
  created_timestamp timestamp [note: 'Date and time when this invoice line record was first created in the system. Supports audit trail and data lineage tracking.']
  discount_amount decimal(18,2) [note: 'Discount amount applied to this line item. May represent volume discounts, promotional discounts, or negotiated contract pricing adjustments.']
  distribution_date date [note: 'Date when this line item was distributed and posted to the general ledger. Determines the accounting period in which the expense is recognized.']
  distribution_status varchar [note: 'Status of general ledger distribution for this line item. Indicates whether the expense has been posted to the general ledger and financial statements.']
  hold_flag boolean [note: 'Indicates whether this line item is on hold and blocked from payment. Used to prevent payment pending resolution of issues or additional approvals.']
  hold_reason varchar [note: 'Reason code or description explaining why this line item is on hold. Documents the issue preventing payment and guides resolution activities.']
  item_code varchar [note: 'Vendor or internal catalog item code identifying the specific product or service being purchased. Used for inventory tracking and spend analysis.']
  line_amount decimal(18,2) [note: 'Total amount for this line item before taxes and adjustments. Typically calculated as quantity multiplied by unit price.']
  line_description varchar [note: 'Detailed textual description of the goods or services being billed on this line. Provides context for the charge and supports audit and reconciliation activities.']
  line_number varchar [note: 'Sequential line number within the invoice. Determines the ordering and display sequence of line items on the invoice.']
  line_status varchar [note: 'Current processing status of this invoice line item. Tracks the line through the approval, matching, and payment workflow.']
  location_code varchar [note: 'Facility or location code where this expense will be utilized or allocated. Supports multi-site cost allocation and facility-level financial reporting.']
  match_exception_reason varchar [note: 'Reason code or description for match exceptions or variances. Documents why the invoice line does not match the PO or receipt (e.g., price variance, quantity variance).']
  match_status varchar [note: 'Status of three-way matching (PO-receipt-invoice) for this line item. Indicates whether the invoice line has been successfully matched to purchase order and goods receipt.']
  modified_timestamp timestamp [note: 'Date and time when this invoice line record was last modified. Tracks the most recent update to support change tracking and audit requirements.']
  notes varchar [note: 'Free-form notes or comments about this line item. Captures additional context, special instructions, or explanations for unusual transactions.']
  program_code varchar [note: 'Program or service line code for this expense. Used to allocate costs to specific clinical programs or service lines for profitability analysis.']
  project_code varchar [note: 'Project or capital initiative code if this line item is associated with a specific project. Enables project-based cost tracking and capital budgeting.']
  quantity decimal(18,4) [note: 'Quantity of items or units of service being billed on this line. Used in conjunction with unit price to calculate line amount.']
  service_period_end_date date [note: 'End date of the service period covered by this line item. Used with start date to determine expense allocation across accounting periods for prepaid services.']
  service_period_start_date date [note: 'Start date of the service period covered by this line item. Used for service-based invoices to determine the period of benefit and expense recognition timing.']
  tax_amount decimal(18,2) [note: 'Total tax amount applied to this line item. Includes sales tax, use tax, VAT, or other applicable taxes based on jurisdiction and item taxability.']
  tax_code varchar [note: 'Tax classification code determining the tax treatment and rate for this line item. Used to calculate applicable taxes based on jurisdiction and item type.']
  total_line_amount decimal(18,2) [note: 'Final total amount for this line item including taxes and discounts. Represents the net amount payable to the vendor for this line.']
  unit_of_measure varchar [note: 'Unit of measure for the quantity field. Defines how the quantity is counted or measured (e.g., each, box, hour, kilogram). [ENUM-REF-CANDIDATE: each|box|case|unit|hour|day|month|kg|lb|liter|gallon — 11 candidates stripped; promote to reference product]']
  unit_price decimal(18,4) [note: 'Price per unit of measure for this line item. Multiplied by quantity to derive the line amount before taxes and adjustments.']

  Note: 'Individual line-item detail on an accounts payable invoice, representing a single billable item from a vendor. Captures AP invoice reference, line number, item description, quantity, unit of measure, unit price, line amount, GL account code, cost center, fund, project, tax code, PO line reference, goods receipt reference, match status, and distribution status. Enables granular cost allocation and three-way matching (PO-receipt-invoice) for healthcare supply and service procurement.'
}

Table finance.ap_payment {
  ap_payment_id varchar [pk, note: 'Unique identifier for the accounts payable payment transaction. Primary key.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: ap_payment has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata for the cash/clearing account used in payment posting.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: ap_payment has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for payment allocation tracking.']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: ap_payment has fiscal_period (INT) which should be normalized to FK to fiscal_period master. Enables joining to get period details and ensures payments reference valid fiscal periods. Note: fiscal_yea']
  payment_batch_id varchar [note: 'Identifier of the payment batch or payment run in which this payment was processed. Used for grouping payments processed together.']
  primary_ap_employee_id varchar [note: 'Identifier of the user who approved this payment for disbursement. Links to user or employee master. Null if not yet approved.']
  primary_ap_vendor_bank_account_id varchar [note: 'Identifier of the vendor bank account to which this payment was sent. Links to vendor banking information.']
  tertiary_ap_modified_by_user_employee_id varchar [note: 'Identifier of the user who last modified this payment record. Links to user or employee master. Audit trail field.']
  vendor_id varchar [note: 'Identifier of the vendor or supplier receiving this payment. Links to the vendor master record.']
  voided_ap_payment_id varchar [note: 'Self-referencing FK on ap_payment (voided_ap_payment_id)']
  ach_trace_number varchar [note: 'ACH trace number assigned by the bank for ACH/EFT payments. Used for tracking and reconciliation. Null for non-ACH payment methods.']
  approval_status varchar [note: 'Approval workflow status for the payment. Values: pending (awaiting approval), approved (authorized for disbursement), rejected (approval denied).']
  approved_timestamp timestamp [note: 'Date and time when the payment was approved for disbursement. Null if not yet approved.']
  check_number varchar [note: 'Physical check number if payment method is check. Null for electronic payment methods.']
  cleared_date date [note: 'Date on which the payment cleared the bank and funds were successfully transferred to the vendor. Null if payment has not yet cleared.']
  created_timestamp timestamp [note: 'Date and time when this payment record was first created in the system. Audit trail field.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the payment amount (e.g., USD, EUR, GBP).']
  discount_taken_amount decimal(18,2) [note: 'Total early payment discount amount taken on this payment if vendor offered discount terms (e.g., 2% discount for payment within 10 days).']
  exchange_rate decimal(18,6) [note: 'Exchange rate applied if the payment was made in a foreign currency. Rate used to convert payment amount to the organization\'s functional currency.']
  fiscal_year varchar [note: 'Fiscal year in which the payment was issued, based on the organization\'s fiscal calendar.']
  functional_currency_amount decimal(18,2) [note: 'Payment amount converted to the organization\'s functional currency (typically USD for US-based healthcare organizations) using the exchange rate.']
  modified_timestamp timestamp [note: 'Date and time when this payment record was last modified. Audit trail field.']
  payment_amount decimal(18,2) [note: 'Total monetary amount disbursed in this payment transaction, in the payment currency.']
  payment_date date [note: 'Date on which the payment was issued or disbursed to the vendor. Principal business event timestamp for the payment transaction.']
  payment_description varchar [note: 'Free-text description or memo field providing additional context about the payment purpose or contents.']
  payment_method varchar [note: 'Method or instrument used to disburse the payment. Common values: check (paper check), ach (Automated Clearing House), eft (Electronic Funds Transfer), wire_transfer, virtual_card, cash.']
  payment_number varchar [note: 'Business-facing unique payment identifier or check number assigned by the financial system. Used for external reference and reconciliation.']
  payment_priority varchar [note: 'Priority level assigned to the payment for processing. Values: standard (normal processing), urgent (high priority), expedited (rush processing).']
  payment_reconciliation_status varchar [note: 'Bank reconciliation status of the payment. Values: unreconciled (not yet matched to bank statement), reconciled (matched and cleared), exception (discrepancy identified).']
  payment_source_system varchar [note: 'Name or identifier of the source financial system that originated this payment record (e.g., SAP S/4HANA FI, Epic Resolute PB).']
  payment_status varchar [note: 'Current lifecycle status of the payment. Values: issued (payment created and sent), cleared (payment successfully processed by bank), voided (payment cancelled before clearing), stopped (stop payment placed), cancelled (payment cancelled), pending (awaiting approval or processing).']
  payment_terms varchar [note: 'Payment terms applicable to this payment (e.g., Net 30, 2/10 Net 30). Reflects the terms under which the vendor invoices were paid.']
  payment_type varchar [note: 'Classification of the payment transaction type. Values: invoice_payment (standard vendor invoice payment), prepayment (advance payment), refund (return of funds), expense_reimbursement (employee expense reimbursement).']
  reconciled_date date [note: 'Date on which the payment was reconciled against the bank statement. Null if not yet reconciled.']
  remittance_advice_reference varchar [note: 'Reference number or identifier for the remittance advice document sent to the vendor detailing which invoices this payment settles.']
  void_date date [note: 'Date on which the payment was voided or cancelled. Null if payment has not been voided.']
  void_reason varchar [note: 'Business reason or explanation for why the payment was voided. Null if payment has not been voided.']
  wire_confirmation_number varchar [note: 'Bank confirmation or reference number for wire transfer payments. Null for non-wire payment methods.']

  Note: 'Transactional record of every payment disbursed to a vendor through the accounts payable process. Captures payment number, payment date, payment method (check, ACH/EFT, wire transfer, virtual card), vendor ID, vendor bank account, payment amount, currency, exchange rate, payment status (issued, cleared, voided, stopped), void date, void reason, bank account debited, check number (if applicable), remittance advice reference, and associated AP invoices settled. SSOT for all vendor disbursements.'
}

Table finance.ar_account {
  ar_account_id varchar [pk, note: 'Unique identifier for the accounts receivable account. Primary key for non-patient-billing receivables including grants, rental income, intercompany receivables, and physician practice management fees.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: ar_account has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata for the receivable GL account.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: ar_account has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for receivable tracking by department/service line.']
  parent_ar_account_id varchar [note: 'Self-referencing FK on ar_account (parent_ar_account_id)']
  tertiary_ar_last_modified_by_user_employee_id varchar [note: 'The system user identifier of the person or process that most recently modified this AR account record. Used for accountability, audit trail, and change management.']
  account_number varchar [note: 'The externally-known unique account number assigned to this receivable account. Used for identification in financial systems and external communications with debtors.']
  account_status varchar [note: 'Current lifecycle status of the receivable account. Open indicates active receivable with expected payment; closed indicates fully paid or resolved; written_off indicates uncollectible and removed from active AR; in_collections indicates transferred to internal or external collections; disputed indicates debtor has contested the amount; on_hold indicates temporarily suspended collection activity; pending_resolution indicates awaiting internal review or decision. [ENUM-REF-CANDIDATE: open|closed|written_off|in_collections|disputed|on_hold|pending_resolution — 7 candidates stripped; promote to reference product]']
  account_type varchar [note: 'Classification of the receivable account indicating the nature of the financial relationship. Distinguishes between payer receivables, self-pay patient receivables, intercompany transactions, grant funding, physician practice management fees, rental income, and other non-RCM receivables. Note: This is for non-patient-billing AR; patient billing AR is managed in billing.patient_account. [ENUM-REF-CANDIDATE: payer|self_pay|intercompany|grant|physician_practice_management|rental_income|other — 7 candidates stripped; promote to reference product]']
  aging_bucket varchar [note: 'Categorization of the receivable based on the number of days outstanding since the original invoice or billing date. Used for aging analysis, collection prioritization, and allowance for doubtful accounts estimation. Current indicates not yet due; subsequent buckets indicate days past due.']
  collection_agency_name varchar [note: 'Name of the external third-party collection agency to which this account has been referred, if applicable. Null if account is managed internally or not yet in collections.']
  created_timestamp timestamp [note: 'The date and time when this AR account record was first created in the system. Used for audit trail, data lineage, and account lifecycle tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency denomination of all monetary amounts on this account. Defaults to USD for domestic operations; supports multi-currency for international grants or intercompany receivables.']
  current_balance decimal(18,2) [note: 'The outstanding receivable balance as of the current date. Reflects original balance minus payments received, plus any adjustments, interest, or fees. This is the amount currently owed. Denominated in USD unless otherwise specified in currency_code.']
  days_outstanding varchar [note: 'The number of calendar days that have elapsed since the original invoice or billing date. Used to calculate aging bucket and assess collection risk. Key metric for Days Sales Outstanding (DSO) reporting.']
  debtor_name varchar [note: 'The legal or business name of the entity or individual that owes payment on this receivable account. May be a payer organization, self-pay patient, affiliated entity, grantor, or other debtor.']
  debtor_type varchar [note: 'Categorical classification of the debtor entity. Segments debtors into commercial insurance payers, government payers (Medicare, Medicaid), self-pay individuals, affiliated healthcare entities, grant-making organizations, corporate tenants, and other categories for reporting and collection strategy purposes. [ENUM-REF-CANDIDATE: commercial_payer|government_payer|self_pay_individual|affiliated_entity|grant_organization|corporate_tenant|other — 7 candidates stripped; promote to reference product]']
  dispute_date date [note: 'The date on which the debtor formally notified the organization of the dispute. Used to track dispute aging and ensure timely resolution per regulatory requirements.']
  dispute_flag boolean [note: 'Boolean indicator of whether the debtor has formally disputed the receivable amount or validity. True indicates an active dispute; false indicates no dispute. Disputed accounts typically require special handling and may be placed on hold pending resolution.']
  dispute_reason varchar [note: 'Description of the reason provided by the debtor for disputing the receivable, such as services not rendered, incorrect billing amount, duplicate invoice, or contractual disagreement. Used to guide dispute resolution process.']
  due_date date [note: 'The date by which payment is contractually due per the invoice terms or agreement. Used to determine whether the account is current or past due and to calculate late fees or interest if applicable.']
  interest_rate decimal(5,4) [note: 'The annual interest rate applied to overdue balances on this account, expressed as a decimal (e.g., 0.0500 for 5%). Null if no interest is charged. Used to calculate interest charges on past-due amounts per contractual terms or state regulations.']
  invoice_date date [note: 'The date on which the original invoice or billing statement was issued to the debtor. Serves as the starting point for aging calculations and payment term enforcement.']
  last_activity_date date [note: 'The most recent date on which any activity occurred on this account, including payments received, adjustments posted, collection calls made, correspondence sent, or status changes. Used to identify dormant accounts and prioritize follow-up.']
  last_modified_timestamp timestamp [note: 'The date and time when this AR account record was most recently updated. Used for audit trail, change tracking, and data synchronization.']
  last_payment_amount decimal(18,2) [note: 'The monetary amount of the most recent payment received on this account. Denominated in the account\'s currency_code. Used for payment trend analysis and debtor behavior assessment.']
  last_payment_date date [note: 'The date on which the most recent payment was received and posted to this account. Used to assess payment patterns and predict future payment likelihood.']
  legal_action_date date [note: 'The date on which legal action was initiated for collection of this receivable. Null if no legal action has been taken. Used for legal case tracking and statute of limitations monitoring.']
  legal_action_flag boolean [note: 'Boolean indicator of whether legal action (lawsuit, lien, garnishment) has been initiated to collect this receivable. True indicates active legal proceedings; false indicates no legal action. Used for legal department coordination and risk management.']
  notes varchar [note: 'Free-text field for recording important notes, comments, or special instructions related to this account. May include collection history, debtor communication summaries, special handling requirements, or internal coordination notes.']
  original_balance decimal(18,2) [note: 'The initial receivable amount established when the account was opened. Represents the total amount originally owed before any payments, adjustments, or write-offs. Denominated in USD unless otherwise specified in currency_code.']
  payment_terms varchar [note: 'The contractual payment terms agreed upon with the debtor, typically expressed as net days (e.g., Net 30, Net 60) or other terms such as due on receipt, installment plan, or custom terms. Defines the expected payment timeline.']
  settlement_accepted_flag boolean [note: 'Boolean indicator of whether the debtor has accepted a settlement offer. True indicates acceptance; false indicates no acceptance or no offer made. Used to track settlement negotiations and finalize account closure.']
  settlement_offer_amount decimal(18,2) [note: 'The reduced amount offered to the debtor as a settlement to close the account, if applicable. Typically less than current_balance. Null if no settlement has been offered. Denominated in the account\'s currency_code.']
  total_adjustments decimal(18,2) [note: 'The cumulative sum of all adjustments (positive or negative) applied to this account, including billing corrections, contractual allowances, courtesy adjustments, and dispute resolutions. Denominated in the account\'s currency_code.']
  total_fees_assessed decimal(18,2) [note: 'The cumulative amount of late fees, collection fees, administrative fees, or other charges assessed on this account. Included in the current_balance. Denominated in the account\'s currency_code.']
  total_interest_accrued decimal(18,2) [note: 'The cumulative amount of interest that has accrued on this account due to late payment. Included in the current_balance. Denominated in the account\'s currency_code.']
  total_payments_received decimal(18,2) [note: 'The cumulative sum of all payments received on this account since inception. Used to calculate current_balance and assess payment history. Denominated in the account\'s currency_code.']
  write_off_amount decimal(18,2) [note: 'The amount written off as uncollectible bad debt. Populated when account_status is written_off. Represents the portion of the receivable removed from active AR and recognized as a loss. Denominated in the account\'s currency_code.']
  write_off_date date [note: 'The date on which the receivable was written off as uncollectible. Null if the account has not been written off. Used for bad debt reporting and financial statement preparation.']
  write_off_reason varchar [note: 'Explanation or categorization of why the receivable was written off, such as debtor bankruptcy, inability to locate debtor, cost of collection exceeds balance, statute of limitations expired, or management decision. Used for root cause analysis and process improvement.']

  Note: 'Accounts receivable account master representing the financial receivable relationship between the healthcare organization and a payer or self-pay patient for non-patient-billing AR (e.g., grants, rental income, intercompany receivables, physician practice management fees). Captures account number, account type (payer, self-pay, intercompany, grant, other), debtor name, debtor type, original balance, current balance, aging bucket, account status (open, closed, written off, in collections), assigned collector, and last activity date. Complements billing.patient_account for non-RCM receivables.'
}

Table finance.ar_transaction {
  ar_transaction_id varchar [pk, note: 'Unique identifier for the accounts receivable transaction record. Primary key for the AR transaction subledger.']
  ar_account_id varchar [note: 'Reference to the AR account (non-RCM receivable account) associated with this transaction. Links to the AR account master for customer or entity billing relationships outside of revenue cycle management.']
  ar_applied_to_transaction_id varchar [note: 'Reference to the charge transaction that this payment, credit memo, or adjustment is applied against. Enables payment application tracking and open item reconciliation.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: ar_transaction has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata for the GL account affected by the AR transaction.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: ar_transaction has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for AR transaction allocation.']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: ar_transaction has posting_period (STRING) which should be normalized to FK to fiscal_period master. Enables joining to get period details and ensures AR transactions reference valid fiscal periods.']
  primary_ar_employee_id varchar [note: 'User identifier of the person who created or entered this AR transaction into the system. Used for audit trail and accountability.']
  primary_reversed_transaction_ar_transaction_id varchar [note: 'Reference to the original AR transaction that this entry reverses. Null for non-reversal transactions. Creates audit trail for transaction corrections.']
  transaction_batch_id varchar [note: 'Identifier for the batch or group of transactions processed together. Used for batch reconciliation and control totals validation.']
  adjustment_reason_code varchar [note: 'Standardized code indicating the business reason for adjustment transactions: billing error, pricing correction, contractual adjustment, goodwill credit. Null for non-adjustment transactions.']
  aging_bucket varchar [note: 'Calculated aging category based on days outstanding from transaction date to current date: current (0 days), 1-30 days, 31-60 days, 61-90 days, or over 90 days. Used for AR aging analysis and collection prioritization.']
  approval_date date [note: 'The date when this AR transaction was approved for posting. Null for transactions not requiring approval or still pending approval.']
  created_timestamp timestamp [note: 'System timestamp when this AR transaction record was first created in the database. Used for audit trail and data lineage tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the transaction amount. Supports multi-currency AR management and foreign exchange reconciliation.']
  due_date date [note: 'The date by which payment is expected or required for charge transactions. Used to calculate days outstanding and aging. Null for payment and adjustment transactions.']
  exchange_rate decimal(12,6) [note: 'The foreign exchange rate applied to convert transaction currency to functional currency. Null for transactions in functional currency.']
  functional_amount decimal(18,2) [note: 'The transaction amount converted to the organization\'s functional reporting currency (typically USD) using the exchange rate at transaction date. Used for consolidated financial reporting.']
  modified_timestamp timestamp [note: 'System timestamp when this AR transaction record was last modified. Used for audit trail and change tracking.']
  notes varchar [note: 'Additional free-text notes or comments about the transaction providing supplementary context for accounting staff, auditors, or management review.']
  payment_method varchar [note: 'The payment instrument or method used for payment transactions: check, wire transfer, ACH, credit card, cash, or electronic funds transfer. Null for non-payment transaction types.']
  payment_reference_number varchar [note: 'External payment reference number such as check number, wire confirmation, or ACH trace number. Used for payment reconciliation and audit trail.']
  posting_date date [note: 'The date when the transaction was posted to the general ledger and became part of the official financial record.']
  posting_status varchar [note: 'Current posting status of the AR transaction: draft (not yet posted), posted (finalized in GL), reversed (cancelled with offsetting entry), voided (cancelled before posting), or pending_approval (awaiting authorization).']
  reconciliation_date date [note: 'The date when this transaction was reconciled and cleared. Null for unreconciled transactions.']
  reconciliation_status varchar [note: 'Status of the transaction in the AR reconciliation process: unreconciled (not yet matched), reconciled (matched and cleared), disputed (discrepancy identified), or under_review (being investigated).']
  reference_document_number varchar [note: 'External reference number linking this AR transaction to source documents such as invoices, payment receipts, credit memos, or adjustment authorizations.']
  reversal_flag boolean [note: 'Boolean indicator whether this transaction is a reversal entry that offsets a previously posted transaction. True for reversal entries, False otherwise.']
  source_system_code varchar [note: 'Code identifying the originating system or module that created this AR transaction: SAP FI, Workday Financials, manual entry, interface from external system.']
  source_system_transaction_reference varchar [note: 'The unique transaction identifier from the source system. Used for data lineage tracking and reconciliation back to operational systems.']
  tax_amount decimal(18,2) [note: 'The tax component of the transaction amount for charge transactions. Used for tax reporting and reconciliation. Null for non-taxable transactions.']
  tax_code varchar [note: 'Tax jurisdiction or tax type code applied to this transaction. Used for tax reporting and compliance with state and federal tax regulations.']
  transaction_amount decimal(18,2) [note: 'The monetary value of the AR transaction in the transaction currency. Positive for charges and debits, negative for payments and credits.']
  transaction_date date [note: 'The business date when the AR transaction event occurred. This is the principal event timestamp for aging analysis and financial period assignment.']
  transaction_description varchar [note: 'Free-text business description of the AR transaction providing context about the nature of the charge, payment, or adjustment.']
  transaction_number varchar [note: 'Business-facing unique transaction number or document reference assigned to this AR transaction for external communication and reconciliation purposes.']
  transaction_type varchar [note: 'Classification of the AR transaction event: charge (new receivable), payment (cash received), credit_memo (reduction), debit_memo (increase), adjustment (correction), write_off (uncollectible), or refund (payment reversal). [ENUM-REF-CANDIDATE: charge|payment|credit_memo|debit_memo|adjustment|write_off|refund — 7 candidates stripped; promote to reference product]']
  write_off_reason_code varchar [note: 'Standardized code indicating the business reason for write-off transactions: bad debt, small balance, bankruptcy, deceased, statute of limitations. Null for non-write-off transactions.']

  Note: 'Transactional record of every accounts receivable financial event including charges, payments received, adjustments, and write-offs for non-RCM AR accounts. Captures transaction date, transaction type (charge, payment, credit memo, adjustment, write-off), AR account reference, GL account, cost center, amount, currency, reference document number, transaction description, posting period, and posting status. Provides the complete AR subledger transaction history for reconciliation and aging analysis.'
}

Table finance.fixed_asset {
  fixed_asset_id varchar [pk, note: 'Unique identifier for the fixed asset record. Primary key for the fixed asset entity.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the fixed asset is physically located and assigned for operational use.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: fixed_asset has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL asset account for the fixed asset.']
  cost_center_id varchar [note: 'Identifier of the cost center or department responsible for the fixed asset and to which depreciation expense is allocated for financial reporting and budgeting.']
  parent_fixed_asset_id varchar [note: 'Self-referencing FK on fixed_asset (parent_fixed_asset_id)']
  accumulated_depreciation decimal(18,2) [note: 'Total depreciation expense recognized to date since the asset was placed in service. Contra-asset account that reduces the gross book value. Recorded in USD.']
  acquisition_cost decimal(18,2) [note: 'Total capitalized cost of acquiring the fixed asset including purchase price, installation costs, freight, and other costs necessary to prepare the asset for its intended use. Recorded in USD.']
  acquisition_date date [note: 'Date on which the healthcare organization legally acquired ownership or control of the fixed asset through purchase, donation, or construction completion.']
  asset_category varchar [note: 'Primary classification of the fixed asset type. Medical equipment includes diagnostic and treatment devices; buildings include owned structures; land includes real property; leasehold improvements include tenant modifications; IT equipment includes servers and network infrastructure; vehicles include ambulances and transport.']
  asset_description varchar [note: 'Detailed description of the fixed asset including specifications, model information, and distinguishing characteristics.']
  asset_name varchar [note: 'Human-readable name or title of the fixed asset for identification and reporting purposes.']
  asset_status varchar [note: 'Current lifecycle status of the fixed asset. Active indicates in-service use; disposed indicates sold or scrapped; transferred indicates moved to another entity; fully depreciated indicates zero net book value but still in use; under construction indicates not yet placed in service; retired indicates removed from service.']
  asset_subcategory varchar [note: 'Secondary classification providing additional granularity within the asset category (e.g., MRI scanner, CT scanner, ultrasound machine for medical equipment category).']
  asset_tag_number varchar [note: 'Unique physical identifier affixed to the asset for tracking and inventory purposes. Externally visible barcode or RFID tag number used in physical audits.']
  capitalization_threshold_met boolean [note: 'Flag indicating whether the asset acquisition cost met or exceeded the organization\'s capitalization threshold policy. True indicates the asset was properly capitalized; False would indicate an expense treatment.']
  created_timestamp timestamp [note: 'Date and time when the fixed asset record was first created in the system. Used for audit trail and data lineage tracking.']
  depreciation_method varchar [note: 'Accounting method used to systematically allocate the cost of the fixed asset over its useful life. Straight-line allocates evenly; declining balance accelerates early depreciation; MACRS (Modified Accelerated Cost Recovery System) follows IRS tax rules; units of production bases depreciation on usage; sum of years digits accelerates depreciation.']
  disposal_date date [note: 'Date on which the fixed asset was disposed of through sale, donation, scrapping, or other removal from service. Null for active assets.']
  disposal_method varchar [note: 'Method by which the fixed asset was disposed. Sold indicates sale to third party; donated indicates charitable contribution; scrapped indicates destruction; traded in indicates exchange for new asset; returned to lessor indicates lease termination; transferred indicates internal move to another entity.']
  disposal_proceeds decimal(18,2) [note: 'Cash or fair value of consideration received from disposal of the fixed asset. Used to calculate gain or loss on disposal. Recorded in USD.']
  fda_device_class varchar [note: 'FDA classification of the medical device based on risk level. Class I is low risk; Class II is moderate risk; Class III is high risk. Not applicable for non-medical equipment.']
  fda_regulated_indicator boolean [note: 'Flag indicating whether the fixed asset is a medical device or equipment subject to FDA regulatory oversight and compliance requirements. True for FDA-regulated medical equipment.']
  insurance_coverage_amount decimal(18,2) [note: 'Maximum insured value or coverage limit for the fixed asset under the insurance policy. Recorded in USD.']
  insurance_policy_number varchar [note: 'Policy number of the insurance coverage protecting the fixed asset against loss, damage, or theft. Used for risk management and claims processing.']
  last_maintenance_date date [note: 'Date of the most recent preventive or corrective maintenance service performed on the fixed asset. Used to track maintenance compliance and schedule next service.']
  last_physical_inventory_date date [note: 'Date of the most recent physical inventory audit or verification confirming the existence and condition of the fixed asset.']
  lease_end_date date [note: 'Date on which the lease agreement for the fixed asset expires. Null for owned assets. Used for lease renewal planning and return logistics.']
  lease_indicator boolean [note: 'Flag indicating whether the fixed asset is leased (True) or owned (False). Determines accounting treatment under ASC 842 lease accounting standards.']
  lease_type varchar [note: 'Classification of the lease agreement if the asset is leased. Operating lease transfers use rights; finance/capital lease transfers substantially all risks and rewards of ownership. Not applicable for owned assets.']
  maintenance_schedule varchar [note: 'Frequency of scheduled preventive maintenance required for the fixed asset to ensure safe operation and regulatory compliance. Critical for medical equipment and life safety systems. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|as_needed — 7 candidates stripped; promote to reference product]']
  manufacturer_name varchar [note: 'Name of the original equipment manufacturer (OEM) who produced the fixed asset. May differ from vendor if purchased through a distributor.']
  model_number varchar [note: 'Manufacturer-assigned model number or designation that identifies the specific product configuration and specifications of the fixed asset.']
  modified_timestamp timestamp [note: 'Date and time when the fixed asset record was last updated in the system. Used for audit trail and change tracking.']
  net_book_value decimal(18,2) [note: 'Current carrying value of the fixed asset calculated as acquisition cost minus accumulated depreciation. Represents the undepreciated balance on the balance sheet. Recorded in USD.']
  next_maintenance_due_date date [note: 'Scheduled date for the next preventive maintenance service based on the maintenance schedule and last service date. Used for maintenance planning and compliance tracking.']
  physical_location varchar [note: 'Current physical location of the fixed asset including facility name, building, floor, room number, or department where the asset is deployed and in use.']
  placed_in_service_date date [note: 'Date on which the fixed asset was ready and available for its intended use and depreciation began. May differ from acquisition date for assets requiring installation or construction.']
  purchase_order_number varchar [note: 'Purchase order number under which the fixed asset was procured. Links the asset to the original procurement transaction and vendor contract.']
  responsible_party_name varchar [note: 'Name of the individual or role responsible for the custody, maintenance, and proper use of the fixed asset. Typically a department manager or equipment coordinator.']
  salvage_value decimal(18,2) [note: 'Estimated residual value of the fixed asset at the end of its useful life. Amount expected to be recovered through sale or disposal. Recorded in USD.']
  serial_number varchar [note: 'Manufacturer-assigned unique serial number that identifies the individual unit of the fixed asset for warranty, service, and tracking purposes.']
  useful_life_years decimal(5,2) [note: 'Estimated number of years the fixed asset is expected to provide economic benefit to the healthcare organization. Used to calculate depreciation expense.']
  vendor_name varchar [note: 'Name of the vendor, supplier, or manufacturer from whom the fixed asset was purchased or leased.']
  warranty_expiration_date date [note: 'Date on which the manufacturer or vendor warranty coverage for the fixed asset expires. Used for maintenance planning and service contract decisions.']

  Note: 'Master record for every capitalized fixed asset owned or leased by the healthcare organization, including medical equipment, buildings, land, leasehold improvements, IT infrastructure, and vehicles. Captures asset tag number, asset name, asset description, asset category (medical equipment, building, land, furniture, IT equipment, vehicle), acquisition date, placed-in-service date, acquisition cost, salvage value, useful life (years), depreciation method (straight-line, MACRS, units of production), accumulated depreciation, net book value, asset status (active, disposed, transferred, fully depreciated), physical location, responsible cost center, and vendor/manufacturer.'
}

Table finance.depreciation_schedule {
  depreciation_schedule_id varchar [pk, note: 'Unique identifier for the depreciation schedule entry. Primary key for this transactional record of periodic depreciation calculation and posting.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: depreciation_schedule has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for depreciation expense allocation.']
  depreciation_run_id varchar [note: 'Reference to the batch depreciation calculation run that generated this entry. Links all depreciation entries processed together.']
  expense_chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: depreciation_schedule has depreciation_expense_gl_account (STRING) which should be normalized to FK to chart_of_accounts. Using \'expense_chart_of_accounts_id\' as the FK name to distinguish from the ac']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: depreciation_schedule has fiscal_year (INT) and fiscal_period (INT) which should be normalized to FK to fiscal_period master. The fiscal_period INT likely represents period_number, which combined with']
  fixed_asset_id varchar [note: 'Reference to the fixed asset for which this depreciation entry is calculated. Links to the capital asset master record.']
  journal_entry_id varchar [note: 'Reference to the general ledger journal entry created for this depreciation posting. Links to the financial transaction record.']
  prior_depreciation_schedule_id varchar [note: 'Self-referencing FK on depreciation_schedule (prior_depreciation_schedule_id)']
  accumulated_depreciation_balance decimal(18,2) [note: 'The cumulative total of all depreciation expense recognized on this asset from acquisition through the current period. Contra-asset account balance.']
  accumulated_depreciation_gl_account varchar [note: 'The general ledger account code credited for accumulated depreciation. Contra-asset account that offsets the fixed asset account.']
  adjustment_flag boolean [note: 'Indicates whether this entry represents an adjustment to a previously posted depreciation calculation. True if adjustment, False if original entry.']
  adjustment_reason varchar [note: 'The business reason for the depreciation adjustment, such as asset revaluation, useful life change, or error correction. Null if not an adjustment.']
  asset_category varchar [note: 'The classification category of the fixed asset being depreciated (e.g., Medical Equipment, Building, IT Infrastructure, Furniture). Supports categorical reporting.']
  beginning_net_book_value decimal(18,2) [note: 'The net book value of the asset at the beginning of the depreciation period. Calculated as original cost minus accumulated depreciation from prior periods.']
  book_tax_difference decimal(18,2) [note: 'The difference between book depreciation expense and tax depreciation amount for this period. Used for deferred tax calculations.']
  created_timestamp timestamp [note: 'The date and time when this depreciation schedule record was first created in the system. Supports audit trail and data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this depreciation entry (e.g., USD, EUR, GBP).']
  department_code varchar [note: 'The department code responsible for the asset and associated depreciation expense. Supports organizational expense allocation.']
  depreciation_date date [note: 'The specific date on which this depreciation calculation was performed and recognized. Typically the last day of the fiscal period.']
  depreciation_expense_amount decimal(18,2) [note: 'The depreciation expense amount calculated and recognized for this period. This amount is debited to the depreciation expense account.']
  depreciation_method varchar [note: 'The depreciation calculation method applied for this period. Determines how the asset cost is allocated over its useful life.']
  ending_net_book_value decimal(18,2) [note: 'The net book value of the asset at the end of the depreciation period. Calculated as beginning net book value minus current period depreciation expense.']
  facility_code varchar [note: 'The facility or location code where the asset is deployed. Enables facility-level capital asset and depreciation reporting.']
  fiscal_period varchar [note: 'The fiscal period (month) within the fiscal year for this depreciation entry. Typically 1-12 representing January through December.']
  fiscal_year varchar [note: 'The fiscal year in which this depreciation expense is recognized. Four-digit year format (e.g., 2024).']
  impairment_adjustment_amount decimal(18,2) [note: 'Any impairment loss recognized in this period that reduces the carrying value of the asset below its recoverable amount. Zero if no impairment occurred.']
  modified_by varchar [note: 'The user ID or name of the person who last modified this depreciation schedule record. Supports audit trail and accountability.']
  modified_timestamp timestamp [note: 'The date and time when this depreciation schedule record was last modified. Tracks the most recent update for audit and change tracking.']
  notes varchar [note: 'Free-text notes or comments related to this depreciation entry. May include explanations for adjustments, impairments, or special circumstances.']
  posted_by varchar [note: 'The user ID or name of the person who posted this depreciation entry to the general ledger. Supports audit trail and accountability.']
  posted_date date [note: 'The date on which this depreciation entry was posted to the general ledger. May differ from the depreciation date for timing reasons.']
  posting_status varchar [note: 'The current posting status of this depreciation entry in the general ledger. Indicates whether the journal entry has been finalized.']
  reversal_date date [note: 'The date on which this depreciation entry was reversed, if applicable. Null if not reversed.']
  reversal_flag boolean [note: 'Indicates whether this depreciation entry has been reversed. True if reversed, False if active.']
  reversal_reason varchar [note: 'The business reason or justification for reversing this depreciation entry. Null if not reversed.']
  salvage_value decimal(18,2) [note: 'The estimated residual value of the asset at the end of its useful life. This amount is not depreciated.']
  tax_depreciation_amount decimal(18,2) [note: 'The depreciation amount calculated for tax reporting purposes, which may differ from book depreciation due to tax regulations such as MACRS.']
  useful_life_remaining_months varchar [note: 'The number of months of useful life remaining for the asset after this depreciation period. Used for forecasting future depreciation.']
  created_by varchar [note: 'The user ID or name of the person who created this depreciation schedule record. Supports accountability and audit requirements.']

  Note: 'Transactional record of periodic depreciation calculations and postings for each fixed asset. Captures asset reference, depreciation period (fiscal period/year), depreciation method applied, beginning net book value, depreciation expense amount, accumulated depreciation balance, ending net book value, GL account debited (depreciation expense), GL account credited (accumulated depreciation), cost center, posting status, and any impairment adjustments. Drives monthly depreciation journal entries and supports capital asset reporting.'
}

Table finance.capital_project {
  capital_project_id varchar [pk, note: 'Unique identifier for the capital project record. Primary key for the capital project entity.']
  capital_modified_by_employee_id varchar [note: 'Identifier of the user who last modified this capital project record. Links to the employee or user record for audit purposes.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where this capital project is located or will be deployed. Links to the facility master record.']
  cost_center_id varchar [note: 'Identifier of the cost center responsible for this capital project. Links to the organizational unit accountable for project execution and budget management.']
  financial_entity_id varchar [note: 'Foreign key linking to finance.financial_entity. Business justification: capital_project should link to financial_entity to identify which legal entity owns the capital project. This is essential for multi-entity healthcare organizations to track capital projects by subsid']
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: Capital projects funded by restricted grants or donor funds require fund linkage for grant accounting, compliance reporting, and restricted fund balance tracking. Essential for non-profit healthcare g']
  grant_id varchar [note: 'Foreign key linking to research.grant. Business justification: Capital projects can be funded by research grants requiring tracking for compliance, financial reporting, and audit trails. Essential for grant-funded capital equipment purchases, facility constructio']
  org_unit_id varchar [note: 'Identifier of the department that will utilize or benefit from this capital project. Links to the department master record.']
  parent_capital_project_id varchar [note: 'Self-referencing FK on capital_project (parent_capital_project_id)']
  primary_capital_employee_id varchar [note: 'Identifier of the employee serving as project manager, responsible for day-to-day execution, schedule, and deliverables.']
  vendor_id varchar [note: 'Identifier of the primary vendor, contractor, or supplier responsible for project execution. Links to the vendor master record.']
  actual_completion_date date [note: 'Date when the capital project was actually completed and closed. Null until project reaches completed status.']
  approval_date date [note: 'Date when the capital project budget was formally approved by the board, finance committee, or authorized approver.']
  approved_capital_budget decimal(18,2) [note: 'Total capital budget amount approved by the board or authorized approver for this project. Represents the spending authority ceiling.']
  asset_class varchar [note: 'Classification of the resulting capital asset for depreciation and financial reporting: building, building improvement, land improvement, equipment, software, or infrastructure.']
  bond_issue_number varchar [note: 'Bond issue identifier if this project is funded through bond financing. Links to the bond issuance record for debt service tracking.']
  business_justification varchar [note: 'Business case and rationale for the capital investment, including expected benefits, return on investment, and strategic alignment.']
  capitalization_status varchar [note: 'Accounting treatment status for project costs: not_capitalized (project not yet eligible), in_progress (costs accumulating in construction-in-progress), capitalized (asset placed in service and capitalized), or expensed (costs expensed rather than capitalized).']
  contract_number varchar [note: 'Primary contract number for the general contractor, vendor, or implementation partner executing this capital project.']
  created_timestamp timestamp [note: 'Date and time when this capital project record was first created in the system. Audit trail for record creation.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this project record (e.g., USD, EUR, GBP).']
  expected_annual_revenue decimal(18,2) [note: 'Projected annual revenue to be generated by this capital project once operational. Used for return on investment analysis.']
  expected_annual_savings decimal(18,2) [note: 'Projected annual cost savings or expense reduction resulting from this capital project (e.g., energy efficiency, labor reduction, supply chain optimization).']
  funding_source varchar [note: 'Primary source of capital funding for this project: bond (municipal or corporate bonds), operating cash (internal reserves), grant (government or foundation grant), lease (capital lease financing), donation (philanthropic contribution), or loan (bank financing).']
  is_regulatory_required boolean [note: 'Indicates whether this capital project is required to meet regulatory compliance, accreditation standards, or legal mandates (e.g., Joint Commission, CMS Conditions of Participation, OSHA, fire code).']
  is_revenue_generating boolean [note: 'Indicates whether this capital project is expected to generate incremental revenue (e.g., new service line, expanded capacity, revenue-producing equipment).']
  modified_timestamp timestamp [note: 'Date and time when this capital project record was last modified. Audit trail for record updates.']
  project_description varchar [note: 'Detailed narrative description of the capital project scope, objectives, and deliverables. Provides context for stakeholders and auditors.']
  project_name varchar [note: 'Descriptive name of the capital project for identification and reporting purposes.']
  project_notes varchar [note: 'Free-text field for additional notes, comments, or context about the capital project. Used for project history and knowledge transfer.']
  project_number varchar [note: 'Business identifier for the capital project, used for external reference and reporting. Unique across all capital projects.']
  project_phase varchar [note: 'Current phase of the project lifecycle: initiation (concept development), planning (detailed planning), design (architectural/engineering design), procurement (vendor selection), construction (build/implementation), testing (commissioning), or closeout (final documentation). [ENUM-REF-CANDIDATE: initiation|planning|design|procurement|construction|testing|closeout — 7 candidates stripped; promote to reference product]']
  project_priority varchar [note: 'Strategic priority level assigned to this capital project for resource allocation and scheduling: critical (immediate need), high (near-term priority), medium (planned investment), or low (deferred opportunity).']
  project_start_date date [note: 'Date when the capital project officially commenced or is scheduled to commence. Represents the beginning of the project timeline.']
  project_status varchar [note: 'Current lifecycle status of the capital project: planning (initial scoping), approved (budget authorized), in progress (active construction or implementation), on hold (temporarily suspended), completed (project closed), or cancelled (project terminated).']
  project_type varchar [note: 'Classification of the capital project by nature of investment: construction (new building), renovation (facility upgrade), equipment acquisition (medical or operational equipment), IT implementation (technology systems), leasehold improvement (tenant improvements), or infrastructure (utilities, parking, grounds).']
  projected_completion_date date [note: 'Planned or forecasted date for project completion. Updated as project progresses and schedule changes occur.']
  strategic_initiative varchar [note: 'Name or identifier of the strategic initiative or program that this capital project supports. Links project to organizational strategy.']
  total_actual_costs decimal(18,2) [note: 'Cumulative amount of actual expenditures incurred and recorded against this project. Represents cash outflows and accrued expenses.']
  total_committed_costs decimal(18,2) [note: 'Cumulative amount of costs committed through purchase orders, contracts, and other binding obligations for this project. Represents encumbered funds.']
  useful_life_years varchar [note: 'Expected useful life of the capital asset in years, used for depreciation calculation once the asset is placed in service.']
  variance_amount decimal(18,2) [note: 'Current budget variance calculated as approved budget minus total actual costs. Positive indicates under budget, negative indicates over budget.']
  variance_percent decimal(5,2) [note: 'Current budget variance expressed as a percentage of approved budget. Used for variance threshold monitoring and escalation.']

  Note: 'Master record for capital improvement and construction projects tracked within the finance domain for capital budgeting and expenditure control. Captures project number, project name, project type (construction, renovation, equipment acquisition, IT implementation, leasehold improvement), project status (planning, approved, in progress, on hold, completed, cancelled), approved capital budget, total committed costs, total actual costs, project start date, projected completion date, actual completion date, responsible cost center, project manager, funding source (bond, operating cash, grant, lease), and capitalization status. Distinct from facility.capital_project which tracks physical construction details.'
}

Table finance.capital_expenditure {
  capital_expenditure_id varchar [pk, note: 'Unique identifier for the capital expenditure transaction record.']
  capital_employee_id varchar [note: 'Reference to the user who created this capital expenditure record in the system.']
  capital_modified_by_employee_id varchar [note: 'Reference to the user who last modified this capital expenditure record.']
  capital_project_id varchar [note: 'Reference to the approved capital project against which this expenditure is charged.']
  care_site_id varchar [note: 'Reference to the healthcare facility or location where the capital asset will be deployed or used.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: capital_expenditure has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL account for capital expenditure posting.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: capital_expenditure has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for capital expenditure allocation.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period in which this capital expenditure transaction is recorded.']
  fixed_asset_id varchar [note: 'Reference to the fixed asset record created once this capital expenditure has been capitalized and the asset is placed in service.']
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: capital_expenditure has fund_code (STRING) which should be normalized to FK to fund master. Enables joining to get fund details for capital project funding tracking.']
  modality_id varchar [note: 'Foreign key linking to radiology.modality. Business justification: Capital expenditures for imaging equipment purchases must link to the resulting operational modality asset to track project-to-asset lifecycle, verify capitalization upon installation, enable acquisit']
  org_unit_id varchar [note: 'Reference to the department that will utilize or benefit from the capital asset being acquired.']
  primary_capital_employee_id varchar [note: 'Reference to the employee whose labor was charged to this capital expenditure, applicable when internal_labor_flag is true.']
  reversed_capital_expenditure_id varchar [note: 'Self-referencing FK on capital_expenditure (reversed_capital_expenditure_id)']
  vendor_id varchar [note: 'Reference to the external vendor or supplier from whom goods or services were purchased for this capital expenditure.']
  approval_status varchar [note: 'Current approval status of the capital expenditure transaction within the financial control workflow.']
  approved_date date [note: 'The date on which this capital expenditure transaction was approved.']
  asset_category varchar [note: 'High-level classification of the type of capital asset being acquired through this expenditure.']
  asset_placed_in_service_flag boolean [note: 'Indicates whether the capital asset associated with this expenditure has been placed into active service and is ready for depreciation.']
  capitalization_eligible_flag boolean [note: 'Indicates whether this expenditure meets the criteria for capitalization as a fixed asset per GAAP standards.']
  cip_category varchar [note: 'Classification of the capital expenditure within the Construction In Progress accounting category, used for tracking costs before capitalization.']
  created_timestamp timestamp [note: 'System timestamp indicating when this capital expenditure record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency in which the expenditure amount is denominated.']
  depreciation_method varchar [note: 'Depreciation method to be applied to the capital asset once placed in service.']
  expenditure_amount decimal(18,2) [note: 'Monetary value of the capital expenditure transaction in the specified currency.']
  expenditure_date date [note: 'The date on which the capital expenditure transaction occurred or was recorded.']
  expenditure_description varchar [note: 'Detailed narrative description of the capital expenditure transaction, including purpose and justification.']
  expenditure_number varchar [note: 'Business identifier for the capital expenditure transaction, used for tracking and reference.']
  expenditure_status varchar [note: 'Current lifecycle status of the capital expenditure transaction in the financial system.']
  expenditure_type varchar [note: 'Classification of the capital expenditure transaction indicating the nature of the cost incurred.']
  fiscal_year varchar [note: 'Fiscal year in which this capital expenditure transaction is recorded for financial reporting purposes.']
  grant_number varchar [note: 'Grant or funding award number if this capital expenditure is funded by an external grant or restricted funding source.']
  internal_labor_flag boolean [note: 'Indicates whether this expenditure represents internal labor costs allocated to the capital project.']
  invoice_number varchar [note: 'Vendor invoice number associated with this capital expenditure transaction, if applicable.']
  labor_hours decimal(10,2) [note: 'Number of labor hours charged to this capital expenditure for internal labor costs.']
  labor_rate decimal(10,2) [note: 'Hourly rate applied to internal labor hours for calculating the labor cost component of this capital expenditure.']
  modified_timestamp timestamp [note: 'System timestamp indicating when this capital expenditure record was last modified.']
  notes varchar [note: 'Additional free-text notes or comments related to this capital expenditure transaction.']
  payment_date date [note: 'The date on which payment was made to the vendor or internal source for this capital expenditure.']
  payment_method varchar [note: 'Method used to remit payment for this capital expenditure transaction.']
  placed_in_service_date date [note: 'The date on which the capital asset was placed into active service, triggering the start of depreciation.']
  purchase_order_number varchar [note: 'Purchase order number authorizing the procurement that resulted in this capital expenditure.']
  reversal_date date [note: 'The date on which this capital expenditure transaction was reversed, if applicable.']
  reversal_flag boolean [note: 'Indicates whether this capital expenditure transaction has been reversed or voided.']
  reversal_reason varchar [note: 'Explanation for why this capital expenditure transaction was reversed or voided.']
  salvage_value decimal(18,2) [note: 'Estimated residual value of the capital asset at the end of its useful life, used in depreciation calculations.']
  useful_life_years varchar [note: 'Expected useful life of the capital asset in years, used for depreciation calculation once the asset is capitalized.']

  Note: 'Transactional record of individual capital expenditure events charged against an approved capital project. Captures capital project reference, expenditure date, expenditure type (invoice payment, progress billing, internal labor, capitalized interest), vendor or internal source, invoice or PO reference, expenditure amount, GL account, cost center, fund, capitalization eligibility flag, asset placed-in-service indicator, and associated fixed asset record (once capitalized). Enables CIP tracking and the transition from capital project costs to fixed asset records.'
}

Table finance.cost_allocation {
  cost_allocation_id varchar [pk, note: 'Unique identifier for the cost allocation transaction record.']
  allocation_method_id varchar [note: 'FK to finance.allocation_method']
  allocation_run_id varchar [note: 'Identifier for the batch allocation run that generated this allocation record. Groups all allocations processed in a single execution cycle.']
  care_site_id varchar [note: 'Reference to the healthcare facility or hospital where this cost allocation applies. Supports multi-facility cost accounting.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: cost_allocation has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL account for cost allocation posting.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period in which this cost allocation was executed.']
  primary_cost_employee_id varchar [note: 'Reference to the finance manager or controller who approved this allocation for posting.']
  primary_original_allocation_cost_allocation_id varchar [note: 'Reference to the original cost allocation record that this entry reverses or corrects. Null if this is not a reversal.']
  source_cost_center_id varchar [note: 'The overhead or indirect cost center from which costs are being allocated. Typically represents support departments such as facilities, IT, administration, or housekeeping.']
  target_cost_center_id varchar [note: 'The direct patient care or revenue-generating cost center receiving the allocated costs. Represents departments such as surgery, emergency, radiology, or inpatient units.']
  tertiary_cost_modified_by_employee_id varchar [note: 'Reference to the user who last modified this allocation record.']
  adjustment_reason varchar [note: 'Explanation for any manual adjustment made to the allocated amount. Required for audit trail and variance analysis.']
  allocated_amount decimal(18,2) [note: 'The dollar amount of overhead or indirect cost allocated from the source cost center to the target cost center in this transaction. Calculated as source cost pool multiplied by allocation basis percentage.']
  allocation_adjustment_amount decimal(18,2) [note: 'Any manual adjustment applied to the calculated allocated amount. Used for corrections, policy adjustments, or rounding reconciliation.']
  allocation_basis varchar [note: 'The statistical or financial metric used to distribute costs from source to target cost centers. Square footage for facilities costs, FTE for HR costs, revenue for administrative overhead, RVU for clinical support, patient days for nursing, labor hours for supervision, transactions for IT, direct cost for proportional allocation, bed count for capacity-based allocation, and visits for outpatient services. [ENUM-REF-CANDIDATE: square_footage|fte|revenue|rvu|patient_days|labor_hours|transactions|direct_cost|bed_count|visits — 10 candidates stripped; promote to reference product]']
  allocation_basis_percentage decimal(7,4) [note: 'The percentage of the total allocation basis that the target cost center represents. Calculated as target quantity divided by sum of all target quantities. Used to distribute source costs proportionally.']
  allocation_basis_quantity decimal(18,4) [note: 'The numeric quantity of the allocation basis metric for the target cost center. For example, 5000 square feet, 25.5 FTEs, 1200 patient days, or 8500 RVUs.']
  allocation_category varchar [note: 'The functional category of overhead cost being allocated. Groups allocations by the type of support service provided. [ENUM-REF-CANDIDATE: facilities|information_technology|human_resources|administration|finance|legal|compliance|quality|marketing — 9 candidates stripped; promote to reference product]']
  allocation_date date [note: 'The business date on which this cost allocation was executed and recorded. Typically the last day of the fiscal period being allocated.']
  allocation_notes varchar [note: 'Free-text field for documenting special circumstances, adjustments, or explanations related to this specific allocation transaction.']
  allocation_run_status varchar [note: 'The current lifecycle status of this allocation record. Draft indicates preliminary calculation, pending approval awaits finance review, approved is ready for posting, posted means committed to GL, reversed indicates correction, and cancelled means voided.']
  allocation_sequence varchar [note: 'The order in which this allocation was processed within the allocation run. Critical for step-down methodology where sequence determines which cost centers allocate first.']
  allocation_tier varchar [note: 'The hierarchical tier or level of this allocation in multi-tier allocation methodologies. Tier 1 represents first-level overhead, tier 2 represents second-level, and so on.']
  allocation_version varchar [note: 'Version identifier for the allocation run. Supports multiple allocation scenarios such as budget, forecast, actual, or what-if analysis.']
  approval_date date [note: 'The date on which this allocation was reviewed and approved by authorized finance personnel.']
  created_timestamp timestamp [note: 'The date and time when this cost allocation record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the allocated amount. Typically USD for U.S. healthcare organizations.']
  drg_cost_allocation_flag boolean [note: 'Indicates whether this allocation contributes to DRG-based cost calculations for inpatient prospective payment system analysis.']
  is_medicare_reportable boolean [note: 'Indicates whether this allocation must be reported on the Medicare Cost Report (CMS-2552-10) for reimbursement calculation purposes.']
  is_reciprocal_allocation boolean [note: 'Indicates whether this allocation is part of a reciprocal allocation cycle where two or more cost centers provide mutual services to each other.']
  modified_timestamp timestamp [note: 'The date and time when this cost allocation record was last modified.']
  posting_date date [note: 'The date on which this allocation was posted to the general ledger. May differ from allocation date due to period-end close timing.']
  reversal_flag boolean [note: 'Indicates whether this allocation record represents a reversal of a previously posted allocation. Used for corrections and period adjustments.']
  service_line_code varchar [note: 'The clinical service line or product line to which the target cost center belongs. Examples include cardiology, orthopedics, oncology, women\'s health, or emergency services.']
  source_cost_pool_amount decimal(18,2) [note: 'The total amount of costs available in the source cost center for allocation before distribution. Represents the full overhead pool being allocated across all target cost centers.']

  Note: 'Transactional record of overhead and indirect cost allocations distributed from overhead cost centers to direct patient care cost centers using defined allocation methodologies. Captures allocation run ID, fiscal period, allocation method (step-down, direct, reciprocal, activity-based), source cost center, target cost center, allocation basis (square footage, FTEs, revenue, RVUs, patient days), allocation basis quantity, allocated amount, GL account, and allocation run status. Supports Medicare cost report preparation and departmental cost accounting.'
}

Table finance.allocation_method {
  allocation_method_id varchar [pk, note: 'Unique identifier for the cost allocation method. Primary key for the allocation method reference master.']
  allocation_employee_id varchar [note: 'Identifier of the user who created this allocation method record. Links to workforce or user management system for accountability.']
  allocation_modified_by_employee_id varchar [note: 'Identifier of the user who last modified this allocation method record. Links to workforce or user management system for accountability.']
  owner_employee_id varchar [note: 'Identifier of the cost accounting analyst or finance manager responsible for maintaining and updating this allocation method. Links to workforce or user management system.']
  primary_allocation_employee_id varchar [note: 'Identifier of the finance executive or cost accounting manager who approved this allocation method. Links to workforce or user management system for accountability and audit trail.']
  primary_superseded_method_allocation_method_id varchar [note: 'Identifier of the previous allocation method that this method replaces. Creates a lineage chain for tracking method evolution and supporting historical cost report reconstruction.']
  activity_driver_description varchar [note: 'For activity-based costing (ABC) methods, describes the specific activity or cost driver that causes costs to be incurred. Examples include number of purchase orders processed, number of patient admissions, number of surgical procedures performed. Provides transparency into ABC methodology.']
  allocation_basis_type varchar [note: 'The statistical or financial measure used as the basis for distributing costs. Square footage for facility costs; FTE (Full-Time Equivalent) count for HR costs; revenue for administrative overhead; RVU (Relative Value Unit) for physician services; patient days for nursing; procedures for surgical services; direct cost for proportional allocation; labor hours for labor-intensive departments; visits for outpatient services; discharges for inpatient services. [ENUM-REF-CANDIDATE: square_footage|fte_count|revenue|rvu|patient_days|procedures|direct_cost|labor_hours|visits|discharges — 10 candidates stripped; promote to reference product]']
  allocation_frequency varchar [note: 'How often this allocation method is executed. Monthly for routine cost accounting; quarterly for less frequent allocations; annually for year-end adjustments; as needed for special allocations; real-time for continuous allocation in advanced systems.']
  allocation_percentage_cap decimal(5,2) [note: 'Maximum percentage of source cost that can be allocated to any single target cost center. Used to prevent disproportionate allocation and ensure equitable distribution. Expressed as a percentage (e.g., 25.00 for 25%).']
  allocation_sequence varchar [note: 'The order in which this allocation method is applied in step-down or sequential allocation processes. Lower numbers are allocated first. Critical for step-down methodology where allocation order affects final cost distribution.']
  approval_date date [note: 'The date on which this allocation method was formally approved by finance leadership or the cost accounting committee. Required for audit trail and regulatory compliance documentation.']
  audit_trail_required_flag boolean [note: 'Indicates whether detailed audit trail logging is required for allocations using this method. True for regulatory or high-value allocations requiring full traceability; false for routine internal allocations.']
  basis_data_source varchar [note: 'The system, report, or data source from which the allocation basis statistics are obtained. Examples include facility management system for square footage, HR system for FTE counts, general ledger for revenue, clinical system for RVUs and patient days.']
  calculation_formula varchar [note: 'The mathematical formula or algorithm used to calculate allocation amounts. May reference basis statistics, weighting factors, and cost pools. Provides transparency and reproducibility for cost accounting calculations.']
  cms_cost_report_schedule varchar [note: 'The specific Medicare Cost Report worksheet or schedule to which this allocation method applies. Examples include Worksheet A (Reclassification and Adjustment of Trial Balance), Worksheet B (Cost Allocation), Worksheet C (Departmental Cost Allocation). Critical for regulatory compliance and reimbursement.']
  created_timestamp timestamp [note: 'The date and time when this allocation method record was first created in the system. Supports audit trail and data lineage tracking.']
  decimal_precision varchar [note: 'Number of decimal places to which allocation amounts are calculated and stored. Typically 2 for dollar amounts, but may be higher for statistical allocations or percentage calculations.']
  effective_end_date date [note: 'The date on which this allocation method ceases to be active. Null indicates the method is currently in use. Used for historical tracking and audit compliance.']
  effective_start_date date [note: 'The date from which this allocation method becomes active and applicable for cost accounting calculations. Aligns with fiscal period boundaries and Medicare Cost Report periods.']
  gaap_compliant_flag boolean [note: 'Indicates whether this allocation method complies with Generally Accepted Accounting Principles (GAAP) for financial statement preparation. True for methods acceptable under GAAP; false for methods used only for internal or regulatory purposes.']
  last_review_date date [note: 'The date on which this allocation method was last reviewed for accuracy, relevance, and compliance. Used to ensure methods are periodically validated and updated as business needs evolve.']
  method_code varchar [note: 'Short alphanumeric code uniquely identifying the allocation method for system processing and reporting. Used in cost accounting transactions and Medicare Cost Report preparation.']
  method_description varchar [note: 'Detailed narrative description of the allocation method, including business rationale, calculation approach, and any special considerations. Used for documentation, training, and audit support.']
  method_name varchar [note: 'Full descriptive name of the cost allocation method. Human-readable label used in financial reports and cost accounting documentation.']
  method_status varchar [note: 'Current lifecycle status of the allocation method. Active methods are in use; inactive methods are retired; pending approval methods await finance leadership sign-off; deprecated methods are being phased out; under review methods are being evaluated for changes.']
  method_type varchar [note: 'Classification of the cost allocation methodology. Step-down allocates overhead sequentially; direct allocates without intermediate steps; reciprocal accounts for mutual service exchanges; activity-based costing (ABC) allocates based on cost drivers; simultaneous solves all allocations concurrently; double distribution performs two-pass allocation.']
  modified_timestamp timestamp [note: 'The date and time when this allocation method record was last modified. Supports change tracking and audit compliance.']
  next_review_date date [note: 'The scheduled date for the next periodic review of this allocation method. Supports proactive governance and ensures methods remain current with regulatory and business requirements.']
  prior_period_adjustment_flag boolean [note: 'Indicates whether this allocation method supports retroactive adjustments to prior accounting periods. True for methods that allow historical corrections; false for methods that only allocate current period costs.']
  reciprocal_allocation_flag boolean [note: 'Indicates whether this method supports reciprocal allocation where departments can allocate costs to each other. True for methods that handle mutual service exchanges; false for unidirectional allocation methods.']
  regulatory_compliance_flag boolean [note: 'Indicates whether this allocation method is required for regulatory reporting compliance (CMS Medicare Cost Report, state Medicaid cost reports, or other regulatory filings). True for methods mandated by regulation; false for internal management accounting methods.']
  rounding_rule varchar [note: 'Specifies how calculated allocation amounts are rounded. Round half up rounds 0.5 and above up; round half down rounds 0.5 and below down; round up always rounds up; round down always rounds down; truncate drops decimals; no rounding preserves full precision. Critical for ensuring allocation totals reconcile to source costs.']
  source_cost_center_category varchar [note: 'Classification of the cost centers from which costs are allocated using this method. Overhead includes facilities and utilities; administrative includes finance and HR; support services includes IT and housekeeping; ancillary includes lab and radiology; clinical includes nursing and therapy; revenue-producing vs non-revenue-producing distinguishes direct patient care from support functions. [ENUM-REF-CANDIDATE: overhead|administrative|support_services|ancillary|clinical|revenue_producing|non_revenue_producing — 7 candidates stripped; promote to reference product]']
  target_cost_center_category varchar [note: 'Classification of the cost centers to which costs are allocated using this method. Defines the recipient departments for overhead distribution. Patient care only excludes further allocation to administrative departments.']
  usage_notes varchar [note: 'Free-text field for cost accounting analysts to document special instructions, exceptions, or considerations when applying this allocation method. Supports knowledge transfer and operational continuity.']
  version_number varchar [note: 'Version identifier for this allocation method configuration. Incremented when method parameters, formulas, or basis types are changed. Supports change tracking and historical analysis.']
  weighting_factor decimal(10,4) [note: 'Numeric multiplier applied to the allocation basis to adjust for intensity, complexity, or other factors. Used to refine allocation precision when raw statistics do not fully reflect cost consumption patterns.']

  Note: 'Reference master defining the cost allocation methodologies and statistical basis configurations used in the healthcare cost accounting process. Captures method code, method name, method type (step-down, direct, reciprocal, activity-based costing), allocation basis type (square footage, FTE count, revenue, RVU, patient days, procedures), basis data source, weighting factor, effective date range, and applicable cost report schedule (Medicare Cost Report Schedule). Governs how overhead costs are distributed across clinical and administrative departments.'
}

Table finance.bank_account {
  bank_account_id varchar [pk, note: 'Unique identifier for the bank account record. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or location associated with this bank account for operational and reporting purposes.']
  cash_chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: bank_account has gl_cash_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL cash account details. Using \'cash_chart_of_accounts_id\' as the FK na']
  financial_entity_id varchar [note: 'Foreign key linking to finance.financial_entity. Business justification: bank_account has legal_entity_id (BIGINT) which should be normalized to FK to financial_entity. The attribute name uses \'legal_entity\' but should point to financial_entity.financial_entity_id. Enables']
  parent_bank_account_id varchar [note: 'Self-referencing FK on bank_account (parent_bank_account_id)']
  primary_bank_employee_id varchar [note: 'Identifier of the system user who created this bank account record.']
  account_closed_date date [note: 'The date on which the bank account was officially closed and is no longer available for transactions. Null if the account is still active.']
  account_name varchar [note: 'The descriptive name or title assigned to the bank account for internal identification and reporting purposes.']
  account_notes varchar [note: 'Free-text field for capturing additional information, special instructions, or operational notes related to the bank account.']
  account_number varchar [note: 'The masked or encrypted bank account number maintained by the financial institution. Stored in masked format for security compliance per PCI DSS and organizational treasury policy.']
  account_opened_date date [note: 'The date on which the bank account was originally opened with the financial institution.']
  account_purpose varchar [note: 'The designated business purpose or functional use of the bank account within the healthcare organization\'s treasury operations.']
  account_status varchar [note: 'The current operational status of the bank account in its lifecycle, indicating whether it is available for transactions or restricted.']
  account_type varchar [note: 'The classification of the bank account based on its financial instrument characteristics and operational features.']
  ach_enabled_flag boolean [note: 'Indicates whether the account is enabled to send and receive ACH electronic funds transfers for payroll, vendor payments, and other automated transactions.']
  available_balance decimal(18,2) [note: 'The amount of funds available for immediate withdrawal or payment, accounting for pending transactions and holds.']
  bank_branch_address varchar [note: 'The physical street address of the bank branch where the account is maintained.']
  bank_branch_name varchar [note: 'The name of the specific bank branch where the account is domiciled and serviced.']
  bank_contact_email varchar [note: 'The email address of the bank relationship manager or primary contact for electronic communication regarding the account.']
  bank_contact_name varchar [note: 'The name of the primary relationship manager or contact person at the financial institution for this account.']
  bank_contact_phone varchar [note: 'The telephone number of the bank relationship manager or primary contact for account inquiries and issue resolution.']
  bank_name varchar [note: 'The legal name of the financial institution where the account is maintained.']
  bank_routing_number varchar [note: 'The nine-digit American Bankers Association (ABA) routing transit number that identifies the financial institution for electronic funds transfers and check processing.']
  bank_swift_code varchar [note: 'The Society for Worldwide Interbank Financial Telecommunication (SWIFT) Business Identifier Code (BIC) used for international wire transfers and cross-border payments.']
  created_timestamp timestamp [note: 'The date and time when this bank account record was first created in the system.']
  currency_code varchar [note: 'The three-letter ISO 4217 currency code representing the denomination in which the account balance is maintained.']
  current_balance decimal(18,2) [note: 'The most recent available balance in the bank account as of the last reconciliation or bank statement date.']
  dual_signature_required_flag boolean [note: 'Indicates whether transactions above a certain threshold require two authorized signatures for approval and execution.']
  dual_signature_threshold_amount decimal(18,2) [note: 'The monetary threshold above which dual signature authorization is required for transactions on this account.']
  fdic_certificate_number varchar [note: 'The unique FDIC certificate number assigned to the financial institution, used to verify insurance coverage.']
  fdic_insured_flag boolean [note: 'Indicates whether the bank account is covered by FDIC insurance protection up to the statutory limit.']
  grant_number varchar [note: 'The unique identifier of the grant or funding award associated with this bank account, if the account is designated for grant-funded activities.']
  interest_calculation_method varchar [note: 'The frequency and methodology used by the financial institution to calculate and credit interest to the account.']
  interest_rate decimal(5,4) [note: 'The annual percentage rate (APR) of interest earned on the account balance, expressed as a decimal (e.g., 0.0250 for 2.50%).']
  last_reconciliation_date date [note: 'The date of the most recent bank reconciliation performed for this account, ensuring alignment between bank statement and general ledger balances.']
  minimum_balance_required decimal(18,2) [note: 'The minimum account balance that must be maintained to avoid fees or meet contractual requirements with the financial institution.']
  modified_timestamp timestamp [note: 'The date and time when this bank account record was last modified or updated in the system.']
  next_reconciliation_due_date date [note: 'The scheduled date by which the next bank reconciliation must be completed per organizational policy and internal controls.']
  online_banking_enabled_flag boolean [note: 'Indicates whether online banking access and electronic transaction capabilities are enabled for this account.']
  positive_pay_enabled_flag boolean [note: 'Indicates whether positive pay fraud prevention service is enabled, requiring pre-authorization of checks and ACH transactions before they are honored by the bank.']
  primary_signatory_name varchar [note: 'The name of the primary authorized signatory who has authority to execute transactions and sign checks on this bank account.']
  primary_signatory_title varchar [note: 'The job title or position of the primary authorized signatory within the healthcare organization.']
  restricted_fund_flag boolean [note: 'Indicates whether the account holds restricted funds that are subject to donor restrictions, grant requirements, or regulatory limitations on use.']
  restriction_description varchar [note: 'A detailed description of any restrictions placed on the use of funds in this account, including donor stipulations, grant conditions, or regulatory requirements.']
  secondary_signatory_name varchar [note: 'The name of the secondary authorized signatory who has backup authority to execute transactions on this bank account.']
  wire_transfer_enabled_flag boolean [note: 'Indicates whether the account is authorized to initiate and receive domestic and international wire transfers.']

  Note: 'Master record for all bank accounts maintained by the healthcare organization for operating, payroll, investment, and restricted fund purposes. Captures bank account number (masked), bank name, bank routing number, account type (checking, savings, money market, sweep, lockbox), account purpose (operating, payroll, petty cash, restricted, investment), currency, legal entity owner, GL cash account mapping, account status (active, closed, dormant), signatory list, and bank contact information. SSOT for treasury cash management.'
}

Table finance.bank_reconciliation {
  bank_reconciliation_id varchar [pk, note: 'Unique identifier for the bank reconciliation record. Primary key for the bank reconciliation transaction.']
  approver_employee_id varchar [note: 'Reference to the manager or supervisor who provided final approval of the bank reconciliation. Represents the final sign-off in the reconciliation workflow.']
  bank_account_id varchar [note: 'Reference to the specific bank account being reconciled. Links to the bank account master data.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: bank_reconciliation has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL account being reconciled.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period for which this reconciliation is performed. Links to the fiscal calendar.']
  primary_bank_employee_id varchar [note: 'Reference to the employee who prepared and performed the bank reconciliation. Links to the workforce or employee master data for accountability and audit trail purposes.']
  primary_prior_period_reconciliation_bank_reconciliation_id varchar [note: 'Reference to the previous month\'s or period\'s bank reconciliation record. Enables tracking of reconciliation continuity and resolution of prior period outstanding items.']
  reviewer_employee_id varchar [note: 'Reference to the employee who reviewed the bank reconciliation for accuracy and completeness. Must be different from the preparer to maintain segregation of duties per SOX requirements.']
  approval_date date [note: 'The date on which the reconciliation received final approval from the designated approver. Marks the completion of the reconciliation workflow and acceptance of the reconciled balance.']
  approver_name varchar [note: 'Full name of the manager or supervisor who approved the bank reconciliation. Provides human-readable identification for reporting and audit purposes.']
  auto_reconciliation_flag boolean [note: 'Indicates whether this reconciliation was performed automatically by the system using matching algorithms or manually by an accountant. True indicates automated reconciliation, false indicates manual reconciliation.']
  bank_errors_total decimal(18,2) [note: 'Total amount of errors identified on the bank statement, such as incorrect charges, duplicate transactions, or processing mistakes by the bank. Positive values indicate bank overstatements, negative values indicate understatements.']
  bank_service_charges decimal(18,2) [note: 'Total bank fees and service charges deducted by the bank during the statement period, including monthly maintenance fees, transaction fees, and wire transfer charges.']
  book_errors_total decimal(18,2) [note: 'Total amount of errors identified in the organization\'s general ledger records, such as recording errors, duplicate entries, or omitted transactions. Requires correcting journal entries.']
  created_timestamp timestamp [note: 'System timestamp indicating when this bank reconciliation record was first created in the system. Part of the audit trail for data lineage and compliance.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the bank account being reconciled. Indicates the currency in which all monetary amounts are denominated.']
  deposits_in_transit_total decimal(18,2) [note: 'Total amount of deposits recorded in the GL but not yet reflected on the bank statement as of the statement date. Represents timing differences between internal recording and bank processing.']
  exception_flag boolean [note: 'Indicates whether this reconciliation contains exceptions or unusual items requiring management attention. True indicates exceptions exist, false indicates a clean reconciliation.']
  gl_book_balance decimal(18,2) [note: 'The cash account balance as recorded in the general ledger for the reconciliation period. This is the organization\'s internal record of the account balance.']
  interest_earned decimal(18,2) [note: 'Interest income earned on the bank account during the statement period as reported by the bank. Requires recording in the general ledger if not previously captured.']
  modified_by varchar [note: 'User identifier or name of the person who last modified this bank reconciliation record. Supports audit trail and accountability for changes to reconciliation data.']
  modified_timestamp timestamp [note: 'System timestamp indicating when this bank reconciliation record was last modified. Tracks the most recent update to the reconciliation data for audit and change tracking purposes.']
  nsf_checks_total decimal(18,2) [note: 'Total amount of checks deposited by the organization that were returned by the bank due to insufficient funds in the payer\'s account. Requires reversal of the original deposit entry.']
  other_adjustments_total decimal(18,2) [note: 'Total amount of miscellaneous adjustments not categorized elsewhere, including electronic fund transfers, automatic payments, or other reconciling items identified during the reconciliation process.']
  outstanding_checks_total decimal(18,2) [note: 'Total amount of checks issued by the organization that have been recorded in the GL but have not yet cleared the bank as of the statement date.']
  outstanding_items_count varchar [note: 'Total number of outstanding reconciling items identified during the reconciliation process, including outstanding checks, deposits in transit, and other uncleared transactions.']
  preparation_date date [note: 'The date on which the reconciliation was initially prepared and completed by the preparer. Distinct from the reconciliation date which represents the business period being reconciled.']
  preparer_name varchar [note: 'Full name of the employee who prepared the bank reconciliation. Provides human-readable identification for reporting and audit purposes.']
  reconciled_balance decimal(18,2) [note: 'The final adjusted balance after applying all reconciling items to either the bank statement balance or the GL book balance. Both adjusted balances should equal this amount when reconciliation is complete.']
  reconciliation_date date [note: 'The date on which the bank reconciliation was performed. Represents the business date of the reconciliation activity.']
  reconciliation_notes varchar [note: 'Free-text field for documenting significant findings, unusual items, explanations of variances, or other relevant information discovered during the reconciliation process. Supports audit trail and knowledge transfer.']
  reconciliation_number varchar [note: 'Business identifier for the reconciliation transaction, typically formatted as a sequential or date-based reference number used for tracking and audit purposes.']
  reconciliation_status varchar [note: 'Current workflow status of the bank reconciliation process. Tracks the reconciliation through preparation, review, and approval stages.']
  review_date date [note: 'The date on which the reconciliation was reviewed by the designated reviewer. Part of the internal control process to ensure accuracy and completeness.']
  reviewer_name varchar [note: 'Full name of the employee who reviewed the bank reconciliation. Provides human-readable identification for reporting and audit purposes.']
  statement_date date [note: 'The ending date of the bank statement being reconciled. Represents the cutoff date for transactions included in the bank statement.']
  statement_ending_balance decimal(18,2) [note: 'The ending balance as reported on the bank statement for the statement date. This is the bank\'s record of the account balance.']
  supporting_document_reference varchar [note: 'Reference identifier or file path to supporting documentation such as bank statements, reconciliation worksheets, or scanned images stored in the document management system.']
  unreconciled_variance decimal(18,2) [note: 'The remaining difference between the adjusted bank balance and adjusted book balance after all known reconciling items have been applied. A non-zero variance indicates unresolved discrepancies requiring investigation.']

  Note: 'Transactional record of monthly bank reconciliation activities performed for each bank account. Captures reconciliation period, bank account reference, statement date, bank statement ending balance, GL book balance, outstanding checks total, deposits in transit total, bank errors, book errors, reconciled balance, reconciliation status (in progress, reconciled, approved), preparer, reviewer, approval date, and unreconciled variance amount. Ensures integrity between bank statements and the general ledger cash accounts.'
}

Table finance.financial_period_close {
  financial_period_close_id varchar [pk, note: 'Unique identifier for the financial period close record. Primary key.']
  approver_employee_id varchar [note: 'Reference to the employee or user who approved the final close of this period.']
  financial_employee_id varchar [note: 'Reference to the user who created this financial period close record.']
  financial_modified_by_employee_id varchar [note: 'Reference to the user who last modified this financial period close record.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period being closed (month, quarter, or year).']
  general_ledger_id varchar [note: 'Reference to the general ledger for which this close is being performed.']
  primary_financial_employee_id varchar [note: 'Reference to the employee or user responsible for managing and completing this period close.']
  prior_financial_period_close_id varchar [note: 'Self-referencing FK on financial_period_close (prior_financial_period_close_id)']
  accounts_payable_close_status varchar [note: 'Status of accounts payable close activities, including vendor invoice processing and accrual verification.']
  accrual_completion_status varchar [note: 'Status of accrual entries for the period, ensuring all revenue and expenses are recorded in the correct period per accrual accounting.']
  actual_close_date date [note: 'Actual date when the financial period close was completed and the period was locked.']
  approval_timestamp timestamp [note: 'Date and time when the period close was formally approved.']
  approver_name varchar [note: 'Name of the individual who approved the final close of this period, for reporting convenience.']
  audit_findings_count varchar [note: 'Number of audit findings or exceptions identified during the close process that require resolution.']
  balance_sheet_reconciliation_status varchar [note: 'Status of balance sheet account reconciliations for this period, ensuring all asset, liability, and equity accounts are reconciled.']
  budget_variance_review_status varchar [note: 'Status of budget-to-actual variance analysis and review for this period.']
  close_checklist_completed_items varchar [note: 'Number of checklist items that have been completed for this period close.']
  close_checklist_completion_percentage decimal(5,2) [note: 'Percentage of close checklist items completed, calculated as (completed_items / total_items) * 100.']
  close_checklist_total_items varchar [note: 'Total number of checklist items that must be completed for this period close.']
  close_completed_timestamp timestamp [note: 'Date and time when the period close process was fully completed.']
  close_delay_reason varchar [note: 'Explanation for any delay in completing the period close beyond the planned close date.']
  close_efficiency_rating varchar [note: 'Qualitative assessment of the efficiency and timeliness of this period close process.']
  close_initiated_timestamp timestamp [note: 'Date and time when the period close process was initiated.']
  close_notes varchar [note: 'Additional notes, comments, or observations related to this period close process.']
  close_number varchar [note: 'Business identifier for the period close event, typically formatted as YYYY-MM-CLOSE or similar.']
  close_status varchar [note: 'Current status of the period close process. Soft close allows limited adjustments; hard close is final and locked.']
  close_type varchar [note: 'Type of financial close being performed: monthly, quarterly, annual, or adjustment period close.']
  cms_cost_report_status varchar [note: 'Status of CMS cost report preparation and submission for this period, required for Medicare reimbursement.']
  created_timestamp timestamp [note: 'Date and time when this financial period close record was first created in the system.']
  days_to_close varchar [note: 'Number of calendar days taken to complete the close from period end date to actual close date.']
  external_audit_status varchar [note: 'Status of external audit review for this period, typically applicable for year-end closes.']
  financial_statement_preparation_status varchar [note: 'Status of financial statement preparation for this period, including balance sheet, income statement, and cash flow statement.']
  fixed_assets_close_status varchar [note: 'Status of fixed asset close activities, including depreciation calculation and asset reconciliation.']
  hard_close_date date [note: 'Date when the period was permanently closed and locked from further adjustments.']
  intercompany_reconciliation_status varchar [note: 'Status of intercompany account reconciliation for this period, ensuring balances between entities are matched.']
  modified_timestamp timestamp [note: 'Date and time when this financial period close record was last modified.']
  open_items_count varchar [note: 'Number of outstanding issues or tasks that must be resolved before the period can be closed.']
  payroll_close_status varchar [note: 'Status of payroll close activities for this period, ensuring all payroll expenses and liabilities are properly recorded.']
  planned_close_date date [note: 'Target date by which the financial period close should be completed per the close calendar.']
  prior_period_adjustment_flag boolean [note: 'Indicates whether this close includes adjustments to prior closed periods.']
  regulatory_reporting_status varchar [note: 'Status of regulatory reporting submissions required for this period, such as CMS cost reports or state financial filings.']
  reopen_date date [note: 'Date when a previously closed period was reopened for adjustments, if applicable.']
  revenue_cycle_close_status varchar [note: 'Status of revenue cycle close activities, including patient accounts receivable reconciliation and revenue recognition.']
  soft_close_date date [note: 'Date when the period was soft closed, allowing limited adjustments before final hard close.']
  unposted_journals_count varchar [note: 'Number of journal entries that have been entered but not yet posted to the general ledger for this period.']
  vibe_mutation_marker varchar

  Note: 'Transactional record tracking the month-end, quarter-end, and year-end financial close process for the healthcare organization. Captures close period, close type (monthly, quarterly, annual), close status (open, in progress, soft close, hard close), planned close date, actual close date, close checklist completion percentage, number of open items, number of unposted journals, intercompany reconciliation status, accrual completion status, financial statement preparation status, external audit status (for year-end), and close owner. Drives the period-end close workflow and accountability.'
}

Table finance.intercompany_transaction {
  intercompany_transaction_id varchar [pk, note: 'Unique identifier for the intercompany transaction record within the integrated delivery network (IDN).']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: intercompany_transaction has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for intercompany transaction allocation.']
  elimination_journal_entry_id varchar [note: 'Reference to the consolidation elimination journal entry that offsets this intercompany transaction in the consolidated financial statements.']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: intercompany_transaction has fiscal_period (STRING) which should be normalized to FK to fiscal_period master. Enables joining to get period_name, start_date, end_date, period_status, and ensures inter']
  intercompany_agreement_id varchar [note: 'Reference to the master intercompany agreement or service level agreement that governs the terms of this transaction.']
  originating_chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: intercompany_transaction has originating_gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Using \'originating_chart_of_accounts_id\' as the FK name to distinguish from the']
  primary_intercompany_employee_id varchar [note: 'Identifier of the user or manager who approved the intercompany transaction for processing.']
  primary_intercompany_financial_entity_id varchar [note: 'Identifier of the legal entity within the IDN that initiated or is the source of the intercompany transaction.']
  primary_reversed_transaction_intercompany_transaction_id varchar [note: 'Reference to the original intercompany transaction that this record reverses, if applicable.']
  receiving_entity_financial_entity_id varchar [note: 'Identifier of the legal entity within the IDN that receives or is the destination of the intercompany transaction.']
  approval_date date [note: 'The date on which the intercompany transaction was approved by the authorized approver for processing and posting.']
  batch_code varchar [note: 'Identifier of the batch or group of intercompany transactions processed together for efficiency and control purposes.']
  created_timestamp timestamp [note: 'The date and time when the intercompany transaction record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency in which the intercompany transaction amount is denominated.']
  elimination_indicator boolean [note: 'Flag indicating whether this intercompany transaction requires elimination during the consolidated financial statement preparation process.']
  elimination_period varchar [note: 'The fiscal period identifier in which the intercompany elimination entry will be or was recorded for consolidation purposes.']
  exchange_rate decimal(12,6) [note: 'The foreign exchange rate applied to convert the transaction amount from the transaction currency to the functional currency.']
  fiscal_year varchar [note: 'The fiscal year in which the intercompany transaction was recorded for financial reporting and consolidation purposes.']
  functional_currency_amount decimal(18,2) [note: 'The transaction amount converted to the functional currency of the consolidated entity for financial reporting purposes.']
  intercompany_transaction_description varchar [note: 'Detailed narrative description of the intercompany transaction explaining the business purpose and nature of the transfer.']
  modified_timestamp timestamp [note: 'The date and time when the intercompany transaction record was last modified or updated in the system.']
  notes varchar [note: 'Additional free-text notes or comments related to the intercompany transaction for audit trail and clarification purposes.']
  originating_entity_code varchar [note: 'Business code or abbreviation of the originating legal entity for reporting and identification purposes.']
  posted_timestamp timestamp [note: 'The date and time when the intercompany transaction was posted to the general ledger systems of both entities.']
  posting_date date [note: 'The date on which the intercompany transaction was posted to the general ledger of both originating and receiving entities.']
  receiving_entity_code varchar [note: 'Business code or abbreviation of the receiving legal entity for reporting and identification purposes.']
  receiving_gl_account_code varchar [note: 'The general ledger account code in the receiving entity\'s chart of accounts to which this transaction is posted.']
  reconciliation_date date [note: 'The date on which the intercompany transaction was successfully reconciled between the originating and receiving entities.']
  reconciliation_status varchar [note: 'Status indicating whether the intercompany transaction has been successfully reconciled between the originating and receiving entities.']
  reconciliation_variance_amount decimal(18,2) [note: 'The monetary difference identified during reconciliation between the originating and receiving entity records for this transaction.']
  reversal_indicator boolean [note: 'Flag indicating whether this intercompany transaction is a reversal of a previously posted transaction.']
  service_line_code varchar [note: 'The service line or business unit code associated with the intercompany transaction for segment reporting and profitability analysis.']
  source_system_code varchar [note: 'Code identifying the originating system or application from which the intercompany transaction data was sourced (e.g., SAP, Epic, Oracle).']
  source_transaction_reference varchar [note: 'The unique transaction identifier from the source system that originated this intercompany transaction record.']
  supporting_document_reference varchar [note: 'Reference number or identifier of supporting documentation (invoices, agreements, memos) that substantiate the intercompany transaction.']
  tax_amount decimal(18,2) [note: 'The tax amount associated with the intercompany transaction, if applicable, for jurisdictions requiring intercompany taxation.']
  tax_code varchar [note: 'The tax classification code applied to the intercompany transaction for tax reporting and compliance purposes.']
  transaction_amount decimal(18,2) [note: 'The monetary value of the intercompany transaction in the specified currency, representing the gross amount transferred between entities.']
  transaction_date date [note: 'The date on which the intercompany transaction was executed or recorded in the originating entity\'s books.']
  transaction_number varchar [note: 'Business-facing unique transaction number assigned to the intercompany transaction for tracking and reference purposes.']
  transaction_status varchar [note: 'Current lifecycle status of the intercompany transaction indicating its processing state and readiness for consolidation. [ENUM-REF-CANDIDATE: draft|pending_approval|approved|posted|reconciled|eliminated|rejected — 7 candidates stripped; promote to reference product]']
  transaction_type varchar [note: 'Classification of the intercompany transaction indicating the nature of the financial activity between legal entities.']
  vibe_mutation_marker varchar

  Note: 'Transactional record of financial transactions between legal entities within the healthcare integrated delivery network (IDN), including management fees, shared service charges, intercompany loans, and cost transfers. Captures transaction date, transaction type (management fee, shared service charge, intercompany loan, cost transfer, intercompany sale), originating entity, receiving entity, transaction amount, currency, GL account (originating), GL account (receiving), cost center, elimination indicator, elimination period, and reconciliation status. Supports consolidated financial statement preparation and intercompany elimination.'
}

Table finance.financial_entity {
  financial_entity_id varchar [pk, note: 'Unique identifier for the financial entity record. Primary key.']
  parent_entity_financial_entity_id varchar [note: 'Reference to the parent financial entity in the corporate hierarchy. Null for top-level holding companies.']
  parent_financial_entity_id varchar [note: 'Self-referencing FK on financial_entity (parent_financial_entity_id)']
  accounting_basis varchar [note: 'Primary accounting framework used for financial reporting. GAAP = Generally Accepted Accounting Principles, GASB = Governmental Accounting Standards Board, IFRS = International Financial Reporting Standards.']
  cms_provider_number varchar [note: 'CMS Certification Number (CCN) assigned to Medicare-certified facilities for billing and reimbursement.']
  consolidation_method varchar [note: 'Accounting method used to consolidate this entity into parent financial statements.']
  created_timestamp timestamp [note: 'Timestamp when this financial entity record was first created in the system.']
  duns_number varchar [note: 'Nine-digit Dun & Bradstreet identifier used for business credit and vendor management.']
  effective_end_date date [note: 'Date when this entity record ceased to be effective. Null for currently active entities.']
  effective_start_date date [note: 'Date when this entity record became effective for financial reporting and consolidation purposes.']
  entity_code varchar [note: 'Unique business identifier code for the legal entity used across financial systems and reporting.']
  entity_description varchar [note: 'Detailed narrative description of the entity\'s business purpose, services, and role within the corporate structure.']
  entity_name varchar [note: 'The full legal name of the entity as registered with regulatory authorities.']
  entity_status varchar [note: 'Current operational and legal status of the entity within the corporate structure.']
  entity_subtype varchar [note: 'Additional classification detail for the entity type (e.g., acute care hospital, specialty clinic, MSSP ACO).']
  entity_type varchar [note: 'Classification of the legal entity type within the healthcare organization structure. ACO = Accountable Care Organization.']
  external_auditor_name varchar [note: 'Name of the external audit firm responsible for auditing this entity\'s financial statements.']
  fiscal_year_end_day varchar [note: 'Day of month (1-31) representing the end of the entity\'s fiscal year.']
  fiscal_year_end_month varchar [note: 'Month number (1-12) representing the end of the entity\'s fiscal year for financial reporting purposes.']
  functional_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the primary currency in which the entity conducts business and maintains its books.']
  incorporation_date date [note: 'Date the entity was legally incorporated or established.']
  intercompany_elimination_flag boolean [note: 'Indicates whether intercompany transactions involving this entity require elimination entries during consolidation.']
  joint_venture_flag boolean [note: 'Indicates whether this entity is a joint venture with external partners requiring special consolidation treatment.']
  last_audit_date date [note: 'Date of the most recent completed external financial audit for this entity.']
  legal_entity_address_line1 varchar [note: 'Primary street address line for the entity\'s legal registered address.']
  legal_entity_address_line2 varchar [note: 'Secondary address line (suite, floor, building) for the entity\'s legal registered address.']
  legal_entity_city varchar [note: 'City name for the entity\'s legal registered address.']
  legal_entity_country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the entity\'s legal registered address.']
  legal_entity_postal_code varchar [note: 'ZIP or postal code for the entity\'s legal registered address.']
  legal_entity_state varchar [note: 'Two-letter US state code for the entity\'s legal registered address.']
  medicare_cost_report_required_flag boolean [note: 'Indicates whether this entity is required to file an annual Medicare cost report with CMS.']
  modified_timestamp timestamp [note: 'Timestamp when this financial entity record was last modified.']
  npi varchar [note: 'National Provider Identifier assigned by CMS for healthcare entities that bill for services. Applicable to hospitals, physician groups, and other provider entities.']
  ownership_percentage decimal(5,2) [note: 'Percentage of ownership interest held by the parent entity, used for consolidation calculations.']
  primary_contact_email varchar [note: 'Primary email address for business contact with this entity.']
  primary_contact_name varchar [note: 'Name of the primary business contact or officer for this entity.']
  primary_contact_phone varchar [note: 'Primary phone number for business contact with this entity.']
  regulatory_reporting_tier varchar [note: 'Classification tier determining the level of regulatory reporting required for this entity based on size, revenue, or patient volume.']
  reporting_entity_flag boolean [note: 'Indicates whether this entity produces standalone financial statements for external reporting.']
  state_of_incorporation varchar [note: 'Two-letter US state code where the entity is legally incorporated or registered.']
  tax_exempt_status varchar [note: 'IRS tax-exempt classification for the entity. 501(c)(3) is common for nonprofit hospitals and foundations.']
  tax_identifier varchar [note: 'Federal Employer Identification Number (EIN) assigned by the IRS for tax reporting purposes.']
  vibe_mutation_marker varchar

  Note: 'Master record for each legal entity, subsidiary, and reporting unit within the healthcare organization\'s corporate structure. Captures entity code, entity name, entity type (hospital, physician group, foundation, ACO, health plan, holding company, joint venture), tax ID (EIN), NPI (if applicable), state of incorporation, fiscal year end, functional currency, consolidation method (full consolidation, equity method, proportional), parent entity, GAAP vs GASB reporting basis, CMS provider number, and entity status. Drives intercompany elimination and consolidated financial reporting.'
}

Table finance.fund {
  fund_id varchar [pk, note: 'Unique identifier for the fund record. Primary key for the fund entity.']
  care_site_id varchar [note: 'Reference to the primary facility or hospital associated with this fund for facility-level financial reporting.']
  donor_id varchar [note: 'Reference to the donor entity in the donor management system for restricted and endowment funds.']
  financial_entity_id varchar [note: 'Foreign key linking to finance.financial_entity. Business justification: fund has legal_entity_id (BIGINT) which should be normalized to FK to financial_entity. The attribute name uses \'legal_entity\' but should point to financial_entity.financial_entity_id. Enables joining']
  parent_fund_id varchar [note: 'Reference to a parent fund if this fund is a sub-fund or component of a larger fund structure.']
  primary_consolidation_fund_id varchar [note: 'Reference to the fund into which this fund rolls up for consolidated financial reporting.']
  approval_date date [note: 'Date when the fund was formally approved for use in financial transactions.']
  approval_status varchar [note: 'Current approval status of the fund setup, indicating whether it has been reviewed and authorized for use.']
  balance decimal(18,2) [note: 'Current balance of the fund representing the difference between fund assets and liabilities. For endowments, represents the corpus and accumulated earnings.']
  beginning_balance decimal(18,2) [note: 'Fund balance at the start of the current fiscal period, used for reconciliation and variance analysis.']
  closure_date date [note: 'Date when the fund was formally closed and all balances transferred or depleted.']
  closure_reason varchar [note: 'Explanation for why the fund was closed, such as purpose fulfilled, grant expired, or donor request.']
  cms_provider_number varchar [note: 'Six-digit CMS provider number associated with the fund for Medicare cost reporting and reimbursement tracking.']
  created_timestamp timestamp [note: 'System timestamp when the fund record was first created in the database.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the functional currency of the fund.']
  donor_restriction_indicator boolean [note: 'Flag indicating whether the fund is subject to donor-imposed restrictions requiring separate tracking and reporting.']
  effective_end_date date [note: 'Date when the fund was closed or became inactive, if applicable. Null for active funds.']
  effective_start_date date [note: 'Date when the fund became active and available for financial transactions.']
  endowment_corpus_amount decimal(18,2) [note: 'Original principal amount of an endowment fund that must be maintained in perpetuity per donor restrictions.']
  establishment_date date [note: 'Date when the fund was originally established or created in the financial system.']
  fund_category varchar [note: 'Broad category grouping for the fund used for financial statement presentation and consolidation. [ENUM-REF-CANDIDATE: operating|restricted|endowment|capital|agency|plant|debt_service — 7 candidates stripped; promote to reference product]']
  fund_code varchar [note: 'Unique alphanumeric code assigned to the fund for identification in financial transactions and reporting. This is the externally-known business identifier used across systems.']
  fund_name varchar [note: 'Full descriptive name of the fund as it appears in financial statements and reports.']
  fund_status varchar [note: 'Current lifecycle status of the fund indicating whether it is available for transactions and reporting.']
  fund_type varchar [note: 'Classification of the fund based on restriction and purpose. Determines accounting treatment and reporting requirements for not-for-profit healthcare organizations.']
  funding_source varchar [note: 'Description of the source of funds, such as federal grant, state appropriation, private donation, or operating revenue.']
  grant_number varchar [note: 'External grant or award number assigned by the funding agency for grant-type funds, used for compliance and reporting.']
  investment_policy_code varchar [note: 'Code referencing the investment policy governing how fund assets may be invested, particularly for endowment and capital funds.']
  modified_timestamp timestamp [note: 'System timestamp when the fund record was last modified.']
  notes varchar [note: 'Free-text field for additional information, special instructions, or historical context about the fund.']
  purpose varchar [note: 'Business purpose and intended use of the fund, describing the programs, services, or capital projects it supports.']
  regulatory_reporting_required boolean [note: 'Flag indicating whether this fund is subject to external regulatory reporting requirements such as CMS cost reports or state financial filings.']
  reporting_requirements varchar [note: 'Detailed description of specific reporting obligations, frequencies, and regulatory bodies to which fund activity must be reported.']
  restriction_description varchar [note: 'Detailed narrative describing the specific restrictions, donor stipulations, or regulatory requirements governing the use of fund assets.']
  restriction_type varchar [note: 'Type of restriction placed on the fund indicating the source and nature of limitations on fund usage.']
  spending_policy_rate decimal(5,4) [note: 'Annual percentage rate at which endowment earnings may be spent, as defined by board policy or donor agreement.']
  vibe_mutation_marker varchar

  Note: 'Master record for all funds used in healthcare fund accounting, including operating funds, restricted funds, endowment funds, capital funds, and grant funds. Captures fund code, fund name, fund type (unrestricted operating, temporarily restricted, permanently restricted, endowment, capital, grant, agency), restriction description, donor restriction indicator, fund purpose, fund balance, fund status (active, closed, depleted), associated legal entity, fund manager, and applicable regulatory or donor reporting requirements. Essential for not-for-profit healthcare fund accounting compliance.'
}

Table finance.financial_forecast {
  financial_forecast_id varchar [pk, note: 'Unique identifier for the financial forecast record. Primary key.']
  approver_employee_id varchar [note: 'Identifier of the executive or manager who approved this forecast. Links to the employee or workforce management system.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or entity to which this forecast applies. Supports facility-level and consolidated financial planning.']
  cost_center_id varchar [note: 'Identifier of the cost center to which this forecast applies, if the forecast is prepared at the cost center level rather than enterprise-wide.']
  financial_employee_id varchar [note: 'System user identifier of the person who created this forecast record. Supports audit trail and accountability.']
  financial_entity_id varchar [note: 'Foreign key linking to finance.financial_entity. Business justification: financial_forecast should link to financial_entity to identify which legal entity the forecast belongs to. This is essential for multi-entity healthcare organizations to track forecasts by subsidiary.']
  financial_modified_by_user_employee_id varchar [note: 'System user identifier of the person who last modified this forecast record. Supports audit trail and accountability.']
  org_unit_id varchar [note: 'Identifier of the department to which this forecast applies, if the forecast is prepared at the department level.']
  parent_financial_forecast_id varchar [note: 'Identifier of the parent forecast if this forecast is a component of a larger consolidated forecast. Supports hierarchical financial planning structures.']
  primary_financial_preparer_employee_id varchar [note: 'Identifier of the finance team member who prepared this forecast. Links to the employee or workforce management system.']
  primary_superseded_by_financial_forecast_id varchar [note: 'Identifier of the newer forecast that supersedes this one. Null if this is the current active forecast. Supports version history and audit trail.']
  approval_date date [note: 'Date on which the forecast was formally approved by the designated authority. Marks the transition to official plan of record.']
  assumptions_narrative varchar [note: 'Detailed narrative documenting the key assumptions, drivers, and rationale underlying the forecast. Includes market conditions, volume assumptions, rate assumptions, cost inflation factors, strategic initiatives, and risk factors.']
  baseline_flag boolean [note: 'Indicates whether this forecast version is the official baseline plan of record against which actual performance will be measured. True if baseline, False otherwise.']
  board_presentation_date date [note: 'Date on which this forecast was presented to the board of directors or trustees. Null if not presented.']
  board_presentation_flag boolean [note: 'Indicates whether this forecast was presented to the board of directors or trustees. True if presented, False otherwise. Used for governance and reporting tracking.']
  created_timestamp timestamp [note: 'Date and time when this forecast record was first created in the system. Supports audit trail and data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this forecast (e.g., USD for US Dollar). Ensures consistent financial reporting across multi-currency environments.']
  fiscal_year varchar [note: 'The fiscal year to which this forecast applies, represented as a four-digit year (e.g., 2024). Aligns with the organization\'s fiscal calendar.']
  forecast_methodology varchar [note: 'The forecasting technique or approach used to develop the projections. Trend analysis extrapolates historical patterns, driver-based links to operational metrics, zero-based builds from scratch, activity-based costs by activity, regression uses statistical models. [ENUM-REF-CANDIDATE: trend_analysis|driver_based|zero_based|activity_based|regression_model|scenario_planning|hybrid — 7 candidates stripped; promote to reference product]']
  forecast_name varchar [note: 'Descriptive name of the financial forecast, typically indicating the planning cycle or scenario (e.g., FY2024 Q2 Rolling Forecast, Long-Range Strategic Plan 2024-2028).']
  forecast_number varchar [note: 'Business-assigned unique identifier for the forecast, used for external reference and tracking across financial planning cycles.']
  forecast_period_end_date date [note: 'The last date of the period covered by this forecast. Defines the end of the planning horizon.']
  forecast_period_months varchar [note: 'Number of months covered by the forecast period. Typical values include 12 for annual plans, 18-24 for rolling forecasts, and 36-60 for long-range plans.']
  forecast_period_start_date date [note: 'The first date of the period covered by this forecast. Defines the beginning of the planning horizon.']
  forecast_status varchar [note: 'Current lifecycle state of the forecast. Draft indicates work in progress, submitted awaits review, approved is finalized, baseline is the official plan of record, superseded has been replaced by a newer version. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|baseline|superseded|archived — 7 candidates stripped; promote to reference product]']
  forecast_type varchar [note: 'Classification of the forecast methodology and planning horizon. Rolling forecasts update continuously, annual operating plans cover a single fiscal year, long-range plans span multiple years, and scenario analyses model alternative futures.']
  forecast_version varchar [note: 'Version identifier for the forecast, enabling tracking of iterations and revisions (e.g., V1.0, V2.1, Q2 Update). Supports audit trail and version control.']
  forecasted_cmi decimal(5,4) [note: 'Projected average case mix index for the forecast period, reflecting the expected complexity and resource intensity of patient cases. Used for revenue and cost modeling under DRG-based payment systems.']
  forecasted_fte_count decimal(10,2) [note: 'Projected total full-time equivalent staffing levels for the forecast period. Critical for labor cost planning and productivity analysis.']
  forecasted_patient_volume varchar [note: 'Projected total patient encounters or admissions for the forecast period. Key volume driver for revenue and resource planning.']
  modified_timestamp timestamp [note: 'Date and time when this forecast record was last modified. Supports audit trail and change tracking.']
  notes varchar [note: 'Free-text field for additional comments, context, or special instructions related to this forecast. Used for collaboration and documentation.']
  scenario_description varchar [note: 'Description of the scenario being modeled (e.g., base case, best case, worst case, strategic initiative impact). Used for scenario analysis and sensitivity testing.']
  service_line_code varchar [note: 'Code identifying the clinical service line to which this forecast applies (e.g., cardiology, orthopedics, oncology). Supports service line financial planning and performance management.']
  submission_date date [note: 'Date on which the forecast was submitted for review and approval. Tracks the workflow progression.']
  total_forecasted_capital_expenditure decimal(18,2) [note: 'Total projected capital spending for the forecast period, including facility construction, equipment purchases, technology investments, and major renovations.']
  total_forecasted_expense decimal(18,2) [note: 'Total projected operating expenses for the forecast period, including salaries and benefits, supplies, purchased services, depreciation, and other operating costs.']
  total_forecasted_net_income decimal(18,2) [note: 'Projected net income after all revenues, expenses, non-operating items, and taxes. Bottom line of the forecasted income statement.']
  total_forecasted_operating_income decimal(18,2) [note: 'Projected operating income (revenue minus expenses) for the forecast period. Key performance metric for financial sustainability and operational efficiency.']
  total_forecasted_revenue decimal(18,2) [note: 'Total projected operating revenue for the forecast period, including patient service revenue, capitation revenue, and other operating income. Represents the top line of the forecasted income statement.']
  vibe_mutation_marker varchar

  Note: 'Master record for rolling financial forecasts and financial planning scenarios prepared by the healthcare finance team. Captures forecast name, forecast type (rolling forecast, annual operating plan, long-range plan, scenario analysis), fiscal year, forecast version, forecast status (draft, submitted, approved, baseline), forecast period coverage (months), total forecasted revenue, total forecasted expense, total forecasted operating income, forecast methodology, assumptions narrative, preparer, approver, and approval date. Supports financial planning and analysis (FP&A) and board-level financial reporting.'
}

Table finance.forecast_line {
  forecast_line_id varchar [pk, note: 'Unique identifier for the forecast line item. Primary key for the forecast line entity.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: forecast_line has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata and ensures forecast lines reference valid GL accounts.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: forecast_line has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details and ensures referential integrity.']
  financial_forecast_id varchar [note: 'Reference to the parent financial forecast header that this line belongs to. Links to the forecast master record.']
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: forecast_line has fund_code (STRING) which should be normalized to FK to fund master. Enables joining to get fund details and ensures forecast lines reference valid funds.']
  prior_forecast_line_id varchar [note: 'Self-referencing FK on forecast_line (prior_forecast_line_id)']
  allocation_method varchar [note: 'Method used to allocate or distribute the forecasted amount across cost centers, departments, or service lines (e.g., direct assignment, proportional allocation, activity-based). Documents allocation transparency.']
  allocation_percentage decimal(5,2) [note: 'Percentage of the total forecasted amount allocated to this specific cost center or service line. Used when forecast amounts are distributed across multiple organizational units.']
  approval_status varchar [note: 'Current approval workflow status of this forecast line (draft, submitted, approved, rejected, revised). Tracks governance and authorization of forecast assumptions.']
  approved_by varchar [note: 'Name or identifier of the user or role who approved this forecast line. Provides audit trail for forecast authorization.']
  approved_date date [note: 'Date on which this forecast line was formally approved. Establishes the effective date of forecast commitment.']
  created_timestamp timestamp [note: 'Timestamp when this forecast line record was first created in the system. Provides audit trail for data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the forecasted amount (e.g., USD, EUR, GBP). Supports multi-currency financial planning.']
  current_budget_amount decimal(18,2) [note: 'The approved budget amount for the same GL account, cost center, and fiscal period. Enables forecast-to-budget variance analysis.']
  effective_end_date date [note: 'Date on which this forecast line ceases to be effective. Nullable for currently active forecast lines. Supports historical forecast analysis.']
  effective_start_date date [note: 'Date from which this forecast line becomes effective. Supports time-based forecast versioning and historical tracking.']
  fiscal_period varchar [note: 'The fiscal period (month, quarter, or other sub-annual period) within the fiscal year for which this forecast line projects financial activity.']
  fiscal_year varchar [note: 'The fiscal year to which this forecast line applies. Represents the annual financial planning period.']
  forecast_category varchar [note: 'High-level classification of the forecast line into major financial statement categories: revenue, salary expense, non-salary expense, capital expenditure, or other.']
  forecast_confidence_level varchar [note: 'Qualitative assessment of the reliability and certainty of this forecast line (high, medium, low). Reflects data quality, volatility, and external risk factors.']
  forecast_scenario varchar [note: 'Scenario or case identifier for this forecast line (e.g., base case, best case, worst case, strategic initiative). Supports scenario planning and sensitivity analysis.']
  forecast_version varchar [note: 'Version identifier for the forecast (e.g., Q1 Forecast, Mid-Year Reforecast, Year-End Projection). Tracks forecast iterations and updates throughout the fiscal year.']
  forecasted_amount decimal(18,2) [note: 'The projected financial amount for this GL account, cost center, and fiscal period combination. Represents the best estimate of future financial performance.']
  fte_count decimal(10,2) [note: 'Forecasted number of Full-Time Equivalent staff positions associated with this line, particularly relevant for salary expense forecasts. Supports workforce planning integration.']
  grant_number varchar [note: 'Grant or award identifier if this forecast line is funded by a specific grant. Links forecast to grant management and compliance tracking.']
  is_capital boolean [note: 'Boolean flag indicating whether this forecast line represents a capital expenditure (True) or an operating expense/revenue (False). Supports capital budgeting and cash flow planning.']
  is_restricted boolean [note: 'Boolean flag indicating whether this forecast line is associated with restricted funds or grants (True) or unrestricted general operating funds (False). Critical for fund accounting compliance.']
  line_notes varchar [note: 'Free-text notes or comments providing additional context, assumptions, or explanations for this forecast line. Supports collaborative planning and documentation.']
  line_number varchar [note: 'Sequential line number within the parent forecast, used for ordering and referencing specific forecast line items.']
  modified_by varchar [note: 'User identifier or name of the person who last modified this forecast line record. Supports change tracking and accountability.']
  modified_timestamp timestamp [note: 'Timestamp when this forecast line record was last modified. Tracks the most recent update to the forecast data.']
  prior_year_actual_amount decimal(18,2) [note: 'The actual financial result for the same GL account, cost center, and fiscal period in the prior year. Provides historical baseline for variance analysis.']
  project_code varchar [note: 'Project or initiative identifier for capital projects or strategic initiatives. Enables project-based financial tracking and reporting.']
  service_line_code varchar [note: 'Clinical or operational service line classification (e.g., cardiology, orthopedics, emergency services) for revenue and expense attribution.']
  statistical_basis varchar [note: 'Description of the statistical or analytical method used to derive the forecast (e.g., trend analysis, regression, historical average, zero-based). Documents forecast rigor and reliability.']
  variance_to_budget decimal(18,2) [note: 'Calculated variance between the forecasted amount and the current budget amount (forecast minus budget). Highlights deviations from the approved financial plan.']
  variance_to_prior_year decimal(18,2) [note: 'Calculated variance between the forecasted amount and the prior year actual amount (forecast minus prior year). Measures year-over-year growth or decline.']
  vibe_mutation_marker varchar
  volume_driver_assumption varchar [note: 'Description of the key volume or activity driver underlying this forecast (e.g., patient days, surgical cases, outpatient visits, Full-Time Equivalents). Provides transparency into forecast methodology.']
  volume_quantity decimal(18,2) [note: 'Numeric quantity of the volume driver assumed in this forecast line. Enables calculation of per-unit rates and variance analysis.']
  volume_unit varchar [note: 'Unit of measure for the volume driver (e.g., patient days, cases, visits, FTE, admissions). Standardizes volume metrics across forecast lines.']
  created_by varchar [note: 'User identifier or name of the person who created this forecast line record. Supports accountability and audit trail.']

  Note: 'Individual line-item detail within a financial forecast, representing the projected financial amount for a specific GL account, cost center, and fiscal period combination. Captures forecast reference, GL account code, cost center, fund, service line, fiscal period, forecasted amount, forecast category (revenue, salary expense, non-salary expense, capital), volume driver assumption, statistical basis, prior year actual amount, current budget amount, and variance to budget. Enables granular FP&A drill-down and variance analysis between forecast, budget, and actuals.'
}

Table finance.invoice_payment_application {
  invoice_payment_application_id varchar [pk, note: 'Unique identifier for this payment application record. Primary key.']
  ap_invoice_id varchar [note: 'Foreign key linking to the accounts payable invoice being paid or settled by this payment application.']
  ap_payment_id varchar [note: 'Foreign key linking to the accounts payable payment being applied to settle the invoice.']
  created_by_employee_id varchar [note: 'Identifier of the employee or system user who created this payment application record.']
  amount_applied decimal(18,2) [note: 'The monetary amount of this payment that was applied to settle this specific invoice. For partial payments, this will be less than the total payment amount. For split payments across multiple invoices, the sum of amount_applied across all applications equals the total payment amount.']
  amount_paid decimal(18,2) [note: 'The total amount that has been paid against this invoice to date. May be less than total_amount for partial payments. [Moved from ap_invoice: This attribute represents the total amount paid against an invoice, which is actually the SUM of amount_applied across all payment applications for this invoice. It is a derived/calculated value that belongs in the association layer, not as a standalone attribute on the invoice.]']
  amount_remaining decimal(18,2) [note: 'The outstanding balance remaining to be paid on this invoice, calculated as total_amount - amount_paid. [Moved from ap_invoice: This attribute represents the outstanding balance on an invoice, which is calculated as total_amount minus the sum of amount_applied from all payment applications. It is a derived value that should be calculated from the association data, not stored redundantly on the invoice.]']
  application_date date [note: 'The date on which this payment was applied to this invoice in the accounts payable system. This is the business event date for the payment allocation and may differ from the payment_date if payments are applied retroactively or in batch processes.']
  application_sequence varchar [note: 'The sequence number of this application when a single payment is applied to multiple invoices. Used to track the order in which payment funds were allocated across invoices, which is important for cash application rules and aging calculations.']
  application_status varchar [note: 'The current status of this payment application. Values: applied (payment successfully applied to invoice), reversed (application was reversed due to payment void or correction), pending (application awaiting approval or clearing), cleared (application confirmed and reconciled).']
  created_timestamp timestamp [note: 'System timestamp when this payment application record was created.']
  discount_taken decimal(18,2) [note: 'The early payment discount amount taken on this specific invoice as part of this payment application. If a payment covers multiple invoices, each invoice may have a different discount amount based on its payment terms and timing.']
  payment_date date [note: 'The date the payment was issued to the vendor. [Moved from ap_invoice: An invoice can be paid by multiple payments on different dates. The payment_date belongs to the payment entity (ap_payment), and the relationship between invoice and payment is captured through the application_date in the association. This attribute on the invoice is ambiguous when multiple payments exist.]']
  reversal_date date [note: 'The date on which this payment application was reversed or voided. Null if the application has not been reversed.']
  reversal_reason varchar [note: 'Business reason or explanation for why this payment application was reversed. Null if not reversed.']
  vibe_mutation_marker varchar

  Note: 'This association product represents the application of a payment to an invoice in the accounts payable process. It captures the specific allocation of payment funds to settle invoice balances, including partial payments, overpayments, and payment reversals. Each record links one ap_invoice to one ap_payment with attributes that exist only in the context of this payment application event.. Existence Justification: In healthcare accounts payable operations, a single vendor invoice can be paid through multiple payments (partial payments, installment payments, or corrections), and a single payment disbursement can be applied to settle multiple invoices from the same vendor (batch payment allocation). Finance teams actively manage payment applications as a distinct business process, tracking which portion of each payment settles which invoice, including discount calculations, application sequencing, and reversal handling.'
}

Table finance.fund_allocation {
  fund_allocation_id varchar [pk, note: 'Unique surrogate identifier for the fund allocation record. Primary key for the association.']
  approved_by_employee_id varchar [note: 'Reference to the employee who approved this fund allocation. Used for accountability and audit trail.']
  fund_id varchar [note: 'Foreign key linking to the fund being allocated to the organizational provider']
  org_provider_id varchar [note: 'Foreign key linking to the organizational provider receiving fund allocation']
  allocation_amount decimal(18,2) [note: 'Fixed dollar amount allocated to this organizational provider from the fund, if allocation is amount-based rather than percentage-based. Mutually exclusive with allocation_percentage in business logic.']
  allocation_percentage decimal(5,4) [note: 'Percentage of the fund allocated to this organizational provider. Used for proportional expense allocation and fund balance distribution. Must sum to 1.0000 across all allocations for a given fund.']
  allocation_purpose varchar [note: 'Specific purpose or program for which this fund is allocated to the organizational provider. May be more granular than the fund-level purpose, capturing provider-specific use cases (e.g., \'Cardiology equipment upgrade\' within a broader capital fund).']
  approval_date date [note: 'Date when this fund allocation was formally approved by the board, finance committee, or authorized approver. Required for audit trail and governance compliance.']
  effective_date date [note: 'Date when this fund allocation became active and available for transaction posting. Used for period-specific fund accounting and historical allocation tracking.']
  end_date date [note: 'Date when this fund allocation ended or was terminated. Null for currently active allocations. Used for historical tracking and fund reallocation management.']
  fund_allocation_status varchar [note: 'Current lifecycle status of the fund allocation. Drives whether transactions can be posted against this allocation.']
  notes varchar [note: 'Free-text notes capturing allocation-specific details, restrictions, or special handling instructions not captured in structured fields.']
  reporting_requirements varchar [note: 'Specific reporting obligations associated with this fund allocation, including frequency, format, and recipient (e.g., quarterly donor report, annual CMS cost report Schedule A). May differ from fund-level reporting requirements based on allocation-specific stipulations.']
  restriction_compliance_status varchar [note: 'Current compliance status of this allocation with respect to donor restrictions, grant stipulations, or regulatory requirements. Drives audit flags and reporting requirements.']
  vibe_mutation_marker varchar

  Note: 'This association product represents the allocation relationship between organizational providers and funds in healthcare fund accounting. It captures how restricted and unrestricted funds are allocated across organizational entities (hospitals, clinics, facilities) for compliance tracking, donor restriction management, and regulatory reporting. Each record links one organizational provider to one fund with allocation percentages, effective dates, and compliance status that exist only in the context of this relationship.. Existence Justification: In healthcare fund accounting, organizational providers (hospitals, clinics, facilities) participate in multiple funds simultaneously (operating funds, restricted grants, endowments, capital funds), and each fund is typically allocated across multiple organizational entities within an integrated delivery network or health system. The allocation relationship is actively managed by finance teams with specific percentages, effective dates, compliance tracking, and reporting requirements that belong to neither the provider nor the fund alone.'
}

Table finance.payment_batch {
  payment_batch_id varchar [pk, note: 'Primary key for payment_batch']
  bank_account_id varchar [note: 'Reference to the bank account used for processing this payment batch.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period in which this payment batch is recorded for financial reporting.']
  payment_created_by_user_employee_id varchar [note: 'Reference to the user who created this payment batch record.']
  payment_employee_id varchar [note: 'Reference to the user who approved this payment batch for processing.']
  payment_financial_entity_id varchar [note: 'Reference to the organization making the payments in this batch, such as an insurance company or employer.']
  payment_original_batch_id varchar [note: 'Reference to the original payment batch that this batch is reversing or correcting, if applicable.']
  payment_payee_organization_financial_entity_id varchar [note: 'Reference to the organization receiving the payments in this batch, typically the healthcare provider or facility.']
  primary_reversed_payment_batch_id varchar [note: 'Self-referencing FK on payment_batch (reversed_payment_batch_id)']
  actual_processing_timestamp timestamp [note: 'The precise date and time when the payment batch processing was completed.']
  adjustment_amount decimal(18,2) [note: 'The total value of adjustments, fees, or corrections applied to the batch amount.']
  approval_required_flag boolean [note: 'Indicates whether this payment batch requires managerial or supervisory approval before processing.']
  approval_timestamp timestamp [note: 'The date and time when the payment batch was approved for processing.']
  batch_date date [note: 'The business date on which the payment batch was created or scheduled for processing.']
  batch_number varchar [note: 'Externally-known unique business identifier for the payment batch, used for tracking and reconciliation across systems.']
  batch_type varchar [note: 'Classification of the payment batch by its purpose and source. Determines processing rules and reconciliation requirements.']
  cost_center_code varchar [note: 'The cost center or department code responsible for this payment batch for budgeting and cost allocation purposes.']
  created_timestamp timestamp [note: 'The date and time when this payment batch record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency of all monetary amounts in this batch.']
  electronic_funds_transfer_trace_number varchar [note: 'The trace number assigned by the Automated Clearing House (ACH) network for tracking electronic fund transfers.']
  error_message varchar [note: 'Detailed error message or failure reason if the payment batch processing encountered issues.']
  external_batch_reference varchar [note: 'External reference number or identifier provided by the payer or payment processor for cross-system reconciliation.']
  failed_payment_count varchar [note: 'The number of payment transactions that failed processing within this batch.']
  general_ledger_account_code varchar [note: 'The general ledger account code to which this payment batch is posted for financial reporting.']
  is_reversal boolean [note: 'Indicates whether this payment batch represents a reversal or correction of a previously processed batch.']
  lockbox_number varchar [note: 'The lockbox identifier used for processing mailed payments, typically assigned by the bank providing lockbox services.']
  modified_timestamp timestamp [note: 'The date and time when this payment batch record was last modified.']
  net_batch_amount decimal(18,2) [note: 'The final net monetary value of the payment batch after all adjustments have been applied.']
  payment_batch_status varchar [note: 'Current lifecycle status of the payment batch in the processing workflow.']
  payment_channel varchar [note: 'The interface or channel through which the payment batch was initiated or received.']
  payment_method varchar [note: 'The financial instrument or mechanism used to execute payments in this batch.']
  processing_notes varchar [note: 'Free-text notes documenting special instructions, issues, or observations related to the processing of this payment batch.']
  reconciliation_date date [note: 'The date on which the payment batch was successfully reconciled with bank records.']
  reconciliation_status varchar [note: 'Current status of the reconciliation process for this payment batch against bank statements and accounting records.']
  remittance_advice_number varchar [note: 'The unique identifier for the remittance advice document associated with this payment batch, used for payment application.']
  scheduled_processing_date date [note: 'The target date when the payment batch is scheduled to be processed and funds transferred.']
  source_system_code varchar [note: 'Identifier of the source system or module that originated this payment batch.']
  successful_payment_count varchar [note: 'The number of payment transactions that were successfully processed within this batch.']
  total_batch_amount decimal(18,2) [note: 'The total monetary value of all payments included in this batch before any adjustments.']
  total_payment_count varchar [note: 'The total number of individual payment transactions included in this batch.']
  vibe_mutation_marker varchar

  Note: 'Master reference table for payment_batch. Referenced by payment_batch_id.'
}

Table finance.transaction_batch {
  transaction_batch_id varchar [pk, note: 'Primary key for transaction_batch']
  cost_center_id varchar [note: 'Reference to the primary cost center associated with this transaction batch for cost allocation purposes.']
  financial_entity_id varchar [note: 'Reference to the legal entity or business unit to which this transaction batch belongs.']
  fiscal_period_id varchar [note: 'Reference to the accounting period (fiscal month/quarter/year) to which this batch belongs.']
  org_unit_id varchar [note: 'Reference to the department that originated or owns this transaction batch.']
  primary_reversed_transaction_batch_id varchar [note: 'Self-referencing FK on transaction_batch (reversed_transaction_batch_id)']
  recurring_schedule_id varchar [note: 'Reference to the recurring schedule template if this batch is part of a recurring series.']
  transaction_approved_by_user_employee_id varchar [note: 'Reference to the user who approved this transaction batch for posting.']
  transaction_employee_id varchar [note: 'Reference to the user who created this transaction batch.']
  transaction_modified_by_user_employee_id varchar [note: 'Reference to the user who last modified this transaction batch.']
  transaction_original_batch_id varchar [note: 'Reference to the original batch if this batch is a reversal or correction of another batch.']
  transaction_posted_by_user_employee_id varchar [note: 'Reference to the user who posted this transaction batch to the general ledger.']
  transaction_reversal_batch_id varchar [note: 'Reference to the reversal batch if this batch has been reversed, creating an audit trail of corrections.']
  approved_timestamp timestamp [note: 'The date and time when this transaction batch was approved.']
  batch_date date [note: 'The business date on which the transaction batch was created or is effective for accounting purposes.']
  batch_description varchar [note: 'Detailed textual description of the purpose and contents of the transaction batch.']
  batch_number varchar [note: 'Externally-known unique business identifier for the transaction batch, used for tracking and reconciliation across systems.']
  batch_status varchar [note: 'Current lifecycle status of the transaction batch in the approval and posting workflow.']
  batch_type varchar [note: 'Classification of the transaction batch indicating the nature of transactions contained within (e.g., journal entries, payments, adjustments).']
  control_total decimal(18,2) [note: 'Expected control total for validation purposes, used to verify batch integrity before posting.']
  created_timestamp timestamp [note: 'The date and time when this transaction batch record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the transaction batch amounts.']
  external_reference_number varchar [note: 'External reference identifier from source systems or third-party systems for cross-system reconciliation.']
  fiscal_period varchar [note: 'The fiscal period number (1-12 or 1-13) within the fiscal year for this transaction batch.']
  fiscal_year varchar [note: 'The fiscal year to which this transaction batch is assigned for financial reporting purposes.']
  is_auto_generated boolean [note: 'Indicates whether the batch was automatically generated by a system process (true) or manually created by a user (false).']
  is_balanced boolean [note: 'Indicates whether the batch debits and credits are in balance (true) or out of balance (false).']
  is_recurring boolean [note: 'Indicates whether this batch is part of a recurring batch series (true) or a one-time batch (false).']
  modified_timestamp timestamp [note: 'The date and time when this transaction batch record was last modified.']
  net_amount decimal(18,2) [note: 'The net amount of the batch (total debits minus total credits), should be zero for balanced batches.']
  notes varchar [note: 'Additional free-form notes or comments about the transaction batch for documentation purposes.']
  posted_timestamp timestamp [note: 'The date and time when this transaction batch was posted to the general ledger.']
  posting_date date [note: 'The date on which the transaction batch was posted to the general ledger.']
  rejection_reason varchar [note: 'Textual explanation of why the batch was rejected during the approval process, if applicable.']
  total_credit_amount decimal(18,2) [note: 'The sum of all credit amounts in the transaction batch, used for batch balancing and reconciliation.']
  total_debit_amount decimal(18,2) [note: 'The sum of all debit amounts in the transaction batch, used for batch balancing and reconciliation.']
  transaction_count varchar [note: 'The total number of individual transactions contained within this batch.']
  vibe_mutation_marker varchar

  Note: 'Master reference table for transaction_batch. Referenced by batch_id.'
}

Table finance.allocation_run {
  allocation_run_id varchar [pk, note: 'Primary key for allocation_run']
  allocation_approved_by_user_employee_id varchar [note: 'Reference to the user who approved this allocation run for posting to the general ledger.']
  allocation_employee_id varchar [note: 'Reference to the user or system account that initiated or triggered this allocation run.']
  allocation_method_id varchar [note: 'Reference to the allocation methodology applied in this run (e.g., direct, step-down, reciprocal, activity-based costing).']
  cost_center_id varchar [note: 'Reference to the primary cost center or cost pool from which costs are being allocated in this run.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period for which this allocation run was executed, linking to the financial calendar.']
  reversed_allocation_run_id varchar [note: 'Reference to the original allocation run that this run is reversing, if applicable.']
  transaction_batch_id varchar [note: 'Identifier for the batch processing job or financial close cycle that includes this allocation run.']
  actual_end_timestamp timestamp [note: 'Actual date and time when the allocation run execution completed or terminated.']
  actual_start_timestamp timestamp [note: 'Actual date and time when the allocation run execution commenced, representing the principal business event timestamp for this transaction.']
  allocation_basis varchar [note: 'Description of the statistical or financial basis used for cost allocation (e.g., square footage, FTE count, patient days, relative value units).']
  allocation_percentage_total decimal(5,2) [note: 'Sum of all allocation percentages applied across target cost centers, should equal 100.00 for validation purposes.']
  approval_timestamp timestamp [note: 'Date and time when the allocation run was formally approved for financial posting.']
  audit_trail_reference varchar [note: 'Reference identifier linking to detailed audit logs or supporting documentation for this allocation run.']
  created_timestamp timestamp [note: 'Date and time when this allocation run record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this allocation run.']
  error_count varchar [note: 'Number of errors encountered during the allocation run execution.']
  execution_duration_seconds varchar [note: 'Total elapsed time in seconds for the allocation run execution, used for performance monitoring and optimization.']
  gl_batch_number varchar [note: 'General ledger batch identifier associated with the journal entries created from this allocation run.']
  gl_posting_timestamp timestamp [note: 'Date and time when the allocation run results were posted to the general ledger system.']
  last_modified_timestamp timestamp [note: 'Date and time when this allocation run record was last updated or modified.']
  notes varchar [note: 'Free-text notes or comments regarding the allocation run, including special circumstances, adjustments, or explanations.']
  posted_to_gl_flag boolean [note: 'Indicator whether the allocation results have been posted to the general ledger.']
  records_processed_count varchar [note: 'Total number of allocation detail records or transactions processed in this run.']
  regulatory_reporting_flag boolean [note: 'Indicator whether this allocation run is used for regulatory cost reporting purposes (e.g., Medicare Cost Report).']
  reversal_flag boolean [note: 'Indicator whether this allocation run is a reversal of a previous allocation.']
  run_name varchar [note: 'Descriptive name assigned to the allocation run for identification and reporting purposes, often includes period and allocation type context.']
  run_number varchar [note: 'Business-facing unique identifier for the allocation run, typically formatted with prefix and sequence number for external reference and audit trails.']
  run_status varchar [note: 'Current lifecycle status of the allocation run indicating its stage in the execution and approval workflow.']
  run_type varchar [note: 'Classification of the allocation run indicating its purpose and finality within the financial close process.']
  scheduled_start_timestamp timestamp [note: 'Planned date and time when the allocation run was scheduled to begin execution.']
  simulation_flag boolean [note: 'Indicator whether this allocation run is a simulation or what-if scenario rather than an actual financial posting.']
  target_cost_centers_count varchar [note: 'Number of distinct cost centers that received allocated costs in this run.']
  total_amount_allocated decimal(18,2) [note: 'Total monetary value of costs allocated across all target cost centers in this run, representing the gross base amount for this allocation transaction.']
  variance_amount decimal(18,2) [note: 'Difference between expected and actual allocated amounts, used for reconciliation and quality control.']
  vibe_mutation_marker varchar
  warning_count varchar [note: 'Number of warnings generated during the allocation run execution.']

  Note: 'Master reference table for allocation_run. Referenced by allocation_run_id.'
}

Table finance.depreciation_run {
  depreciation_run_id varchar [pk, note: 'Primary key for depreciation_run']
  asset_book_id varchar [note: 'Reference to the asset book (corporate, tax, IFRS, etc.) for which this depreciation run is executed.']
  care_site_id varchar [note: 'Reference to the facility or location for which this depreciation run is scoped, if applicable.']
  cost_center_id varchar [note: 'Reference to the cost center for which this depreciation run is scoped, if applicable.']
  depreciation_approved_by_user_employee_id varchar [note: 'Reference to the user who approved the depreciation run for posting to the general ledger.']
  depreciation_employee_id varchar [note: 'Reference to the user who initiated or scheduled this depreciation run.']
  depreciation_reversed_run_id varchar [note: 'Reference to the original depreciation run that this run reverses, if applicable.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period for which this depreciation run is executed.']
  general_ledger_id varchar [note: 'Reference to the general ledger to which this depreciation run posts entries.']
  org_unit_id varchar [note: 'Reference to the department for which this depreciation run is scoped, if applicable.']
  primary_reversed_depreciation_run_id varchar [note: 'Self-referencing FK on depreciation_run (reversed_depreciation_run_id)']
  approval_timestamp timestamp [note: 'The date and time when the depreciation run was approved for posting.']
  asset_count varchar [note: 'The total number of assets included in this depreciation run.']
  auto_post_flag boolean [note: 'Indicates whether the depreciation entries from this run are automatically posted to the general ledger upon completion.']
  calculation_method varchar [note: 'The accounting method used to calculate depreciation in this run, such as straight-line, declining balance, or units of production.']
  created_timestamp timestamp [note: 'The date and time when this depreciation run record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the depreciation amounts in this run.']
  effective_date date [note: 'The accounting effective date for which the depreciation expense is recognized in the financial statements.']
  end_timestamp timestamp [note: 'The precise date and time when the depreciation run processing completed.']
  error_message varchar [note: 'Detailed error message if the depreciation run failed, providing diagnostic information for troubleshooting.']
  failed_asset_count varchar [note: 'The number of assets that failed processing during this depreciation run.']
  journal_batch_reference varchar [note: 'Reference to the journal batch containing the depreciation entries generated by this run.']
  modified_timestamp timestamp [note: 'The date and time when this depreciation run record was last modified.']
  posting_date date [note: 'The date on which the depreciation entries from this run were posted to the general ledger.']
  processed_asset_count varchar [note: 'The number of assets successfully processed in this depreciation run.']
  reversal_flag boolean [note: 'Indicates whether this depreciation run is a reversal of a previous run.']
  run_date date [note: 'The business date on which the depreciation run was executed or scheduled to execute.']
  run_description varchar [note: 'Free-text description providing additional context or notes about the purpose and scope of this depreciation run.']
  run_number varchar [note: 'Business-facing unique identifier for the depreciation run, used in financial reports and audit trails.']
  run_status varchar [note: 'Current lifecycle status of the depreciation run indicating its processing state.']
  run_type varchar [note: 'Classification of the depreciation run indicating whether it is a scheduled periodic run, ad-hoc calculation, adjustment, reversal, year-end closing, or interim calculation.']
  simulation_flag boolean [note: 'Indicates whether this depreciation run is a simulation or test run that does not post to the general ledger.']
  start_timestamp timestamp [note: 'The precise date and time when the depreciation run processing began.']
  total_depreciation_amount decimal(18,2) [note: 'The total depreciation expense calculated across all assets in this run.']
  vibe_mutation_marker varchar

  Note: 'Master reference table for depreciation_run. Referenced by depreciation_run_id.'
}

Table finance.donor {
  donor_id varchar [pk, note: 'Primary key for donor']
  merged_donor_id varchar [note: 'Self-referencing FK on donor (merged_donor_id)']
  acknowledgment_preference varchar [note: 'Donor\'s preference for public recognition of their contributions in donor lists, annual reports, and naming opportunities.']
  affinity_score decimal(5,2) [note: 'Quantitative score representing the donor\'s affinity and connection to the healthcare organization based on engagement history, volunteer activity, and relationship depth.']
  board_member_flag boolean [note: 'Boolean indicator of whether the donor currently serves or has served on the healthcare organization\'s board of directors or advisory board.']
  city varchar [note: 'City name of the donor\'s mailing address.']
  country_code varchar [note: 'Three-letter ISO country code representing the donor\'s country of residence or incorporation.']
  created_timestamp timestamp [note: 'Timestamp when the donor record was first created in the system, following the format yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  data_classification varchar [note: 'Classification level of the donor record indicating the sensitivity and access controls required for this data per organizational data governance policies.']
  donor_name varchar [note: 'Full legal name of the donor individual or organization providing financial contributions.']
  donor_status varchar [note: 'Current lifecycle status of the donor relationship indicating whether the donor is actively contributing, inactive, temporarily suspended, deceased, or merged with another donor record.']
  donor_type varchar [note: 'Classification of the donor entity type indicating whether the donor is an individual person, corporate entity, charitable foundation, government agency, or anonymous contributor.']
  email_address varchar [note: 'Primary email address for donor communication and correspondence regarding contributions and acknowledgments.']
  employer_name varchar [note: 'Name of the donor\'s employer organization, relevant for corporate matching gift programs and workplace giving campaigns.']
  first_gift_date date [note: 'Date when the donor made their first recorded contribution to the healthcare organization.']
  last_gift_date date [note: 'Date of the most recent contribution received from the donor.']
  lifetime_giving_amount decimal(18,2) [note: 'Total cumulative amount of all contributions made by the donor since the inception of the donor relationship, expressed in the organization\'s functional currency.']
  mailing_address_line1 varchar [note: 'First line of the donor\'s mailing address including street number and street name for correspondence and tax receipts.']
  mailing_address_line2 varchar [note: 'Second line of the donor\'s mailing address including apartment, suite, or unit number.']
  matching_gift_eligible_flag boolean [note: 'Boolean indicator of whether the donor is eligible for corporate matching gift programs through their employer.']
  memorial_honoree_name varchar [note: 'Name of the individual being honored or memorialized through the donor\'s contributions, if applicable.']
  modified_timestamp timestamp [note: 'Timestamp when the donor record was last modified or updated, following the format yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  notes varchar [note: 'Free-text notes and comments about the donor relationship, preferences, special considerations, and stewardship history for development staff reference.']
  patient_flag boolean [note: 'Boolean indicator of whether the donor is or has been a patient of the healthcare organization, relevant for grateful patient programs.']
  phone_number varchar [note: 'Primary contact phone number for the donor used for outreach, stewardship, and contribution acknowledgment.']
  planned_giving_flag boolean [note: 'Boolean indicator of whether the donor has established a planned gift commitment such as a bequest, charitable trust, or life insurance designation.']
  postal_code varchar [note: 'Postal or ZIP code of the donor\'s mailing address for correspondence delivery.']
  preferred_communication_method varchar [note: 'Donor\'s preferred method of communication for stewardship, solicitation, and acknowledgment correspondence.']
  segment varchar [note: 'Fundraising segment classification of the donor based on giving capacity and engagement level for targeted stewardship and solicitation strategies.']
  solicitation_opt_out_flag boolean [note: 'Boolean indicator of whether the donor has requested to opt out of future fundraising solicitations and appeals.']
  source varchar [note: 'Original source or channel through which the donor was acquired or first engaged with the healthcare organization\'s fundraising programs.']
  state_province varchar [note: 'State or province code of the donor\'s mailing address using standard postal abbreviations.']
  tax_id_number varchar [note: 'Tax identification number for the donor used for IRS reporting and tax-deductible contribution acknowledgment. May be SSN for individuals or EIN for organizations.']
  vibe_mutation_marker varchar
  volunteer_flag boolean [note: 'Boolean indicator of whether the donor actively volunteers or has volunteered for the healthcare organization.']
  wealth_capacity_rating varchar [note: 'Estimated wealth capacity rating or score for the donor based on wealth screening and prospect research, used for major gift identification and cultivation strategies.']

  Note: 'Master reference table for donor. Referenced by donor_id.'
}

Table finance.intercompany_agreement {
  intercompany_agreement_id varchar [pk, note: 'Primary key for intercompany_agreement']
  cost_center_id varchar [note: 'Identifier of the cost center responsible for managing or tracking costs related to this agreement.']
  employee_id varchar [note: 'Identifier of the user or approver who authorized this intercompany agreement.']
  financial_entity_id varchar [note: 'Identifier of the legal entity providing services, goods, or resources under this intercompany agreement.']
  intercompany_receiver_entity_id varchar [note: 'Identifier of the legal entity receiving services, goods, or resources under this intercompany agreement.']
  parent_intercompany_agreement_id varchar [note: 'Identifier of the parent or master agreement if this is a subsidiary or amendment agreement. Nullable for standalone agreements.']
  primary_superseded_intercompany_agreement_id varchar [note: 'Self-referencing FK on intercompany_agreement (superseded_intercompany_agreement_id)']
  agreement_name varchar [note: 'Human-readable name or title of the intercompany agreement describing its purpose or scope.']
  agreement_number varchar [note: 'Externally-known unique business identifier for the intercompany agreement, typically used in contracts and financial reporting.']
  agreement_type varchar [note: 'Classification of the intercompany agreement based on its business purpose (e.g., service agreement, cost allocation, revenue sharing, transfer pricing, licensing, or intercompany loan).']
  annual_contract_value decimal(18,2) [note: 'Total estimated or committed annual value of the intercompany agreement in the specified currency.']
  approval_date date [note: 'Date when the intercompany agreement was formally approved by authorized parties.']
  audit_required_flag boolean [note: 'Indicates whether this agreement requires periodic audit review for compliance or financial accuracy.']
  billing_frequency varchar [note: 'Frequency at which intercompany charges are billed under this agreement.']
  cost_allocation_basis varchar [note: 'Description of the basis or formula used for allocating costs between entities (e.g., headcount, revenue, square footage, usage metrics).']
  created_timestamp timestamp [note: 'Timestamp when the intercompany agreement record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all financial transactions under this agreement.']
  dispute_resolution_method varchar [note: 'Method specified in the agreement for resolving disputes between the provider and receiver entities.']
  document_reference_url varchar [note: 'URL or file path to the signed agreement document or contract repository location.']
  effective_end_date date [note: 'Date when the intercompany agreement expires or terminates. Nullable for open-ended agreements.']
  effective_start_date date [note: 'Date when the intercompany agreement becomes legally binding and operational.']
  gl_account_code varchar [note: 'General ledger account code used for posting intercompany transactions under this agreement.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of this intercompany agreement.']
  intercompany_agreement_status varchar [note: 'Current lifecycle status of the intercompany agreement indicating its operational state.']
  last_audit_date date [note: 'Date of the most recent audit or compliance review performed on this intercompany agreement.']
  last_modified_timestamp timestamp [note: 'Timestamp when the intercompany agreement record was last updated or modified.']
  next_review_date date [note: 'Scheduled date for the next periodic review or renewal evaluation of this agreement.']
  notes varchar [note: 'Additional notes, comments, or special instructions related to the intercompany agreement.']
  payment_terms_days varchar [note: 'Number of days allowed for payment after invoice date, as specified in the agreement terms.']
  pricing_method varchar [note: 'Method used to determine pricing for services or goods exchanged under this intercompany agreement.']
  renewal_flag boolean [note: 'Indicates whether the agreement is eligible for automatic renewal upon expiration.']
  renewal_notice_days varchar [note: 'Number of days prior to expiration that renewal notice must be provided, as specified in the agreement.']
  service_description varchar [note: 'Detailed description of the services, goods, or resources covered by this intercompany agreement.']
  tax_jurisdiction_code varchar [note: 'Code representing the primary tax jurisdiction governing this intercompany agreement.']
  termination_clause varchar [note: 'Summary of the conditions and procedures under which the agreement may be terminated by either party.']
  transfer_pricing_compliant_flag boolean [note: 'Indicates whether the agreement has been reviewed and approved as compliant with transfer pricing regulations.']
  version_number varchar [note: 'Version number of the agreement, incremented with each amendment or revision.']
  vibe_mutation_marker varchar

  Note: 'Master reference table for intercompany_agreement. Referenced by intercompany_agreement_id.'
}

Table finance.recurring_schedule {
  recurring_schedule_id varchar [pk, note: 'Primary key for recurring_schedule']
  chart_of_accounts_id varchar [note: 'Reference to the general ledger account to which this recurring schedule posts transactions.']
  cost_center_id varchar [note: 'Reference to the cost center responsible for or associated with this recurring schedule.']
  fiscal_period_id varchar [note: 'Reference to the fiscal year this recurring schedule is associated with.']
  owner_employee_id varchar [note: 'Reference to the employee who owns and is accountable for this recurring schedule.']
  recurring_employee_id varchar [note: 'Reference to the user who created this recurring schedule record.']
  recurring_modified_by_user_employee_id varchar [note: 'Reference to the user who last modified this recurring schedule record.']
  superseded_recurring_schedule_id varchar [note: 'Self-referencing FK on recurring_schedule (superseded_recurring_schedule_id)']
  adjustment_factor decimal(10,6) [note: 'A multiplier applied to the scheduled amount for adjustments such as inflation, escalation, or volume changes. Default is 1.0 (no adjustment).']
  allocation_method varchar [note: 'The method used to allocate or distribute the scheduled amount across periods or cost centers (equal distribution, weighted, percentage-based, activity-based costing, or custom formula).']
  approval_required_flag boolean [note: 'Indicates whether generated activities from this schedule require approval before posting (true) or can be posted automatically (false).']
  approved_timestamp timestamp [note: 'The date and time when this recurring schedule was approved for activation. Null if not yet approved or approval is not required.']
  approver_role_code varchar [note: 'Reference to the role or user group responsible for approving activities generated by this schedule. Null if approval is not required.']
  auto_generate_flag boolean [note: 'Indicates whether scheduled activities are automatically generated by the system (true) or require manual creation (false).']
  business_justification varchar [note: 'Explanation of the business rationale and need for this recurring schedule, used for audit and governance purposes.']
  created_timestamp timestamp [note: 'The date and time when this recurring schedule record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency in which the scheduled amount is denominated.']
  day_of_month varchar [note: 'For monthly or less frequent schedules, the specific day of the month when the activity occurs (1-31). Null if not applicable.']
  day_of_week varchar [note: 'For weekly or biweekly schedules, the specific day of the week when the activity occurs. Null if not applicable.']
  effective_end_date date [note: 'The date when this recurring schedule ceases to be active. Null indicates an open-ended schedule.']
  effective_start_date date [note: 'The date when this recurring schedule becomes active and begins generating scheduled activities.']
  frequency varchar [note: 'The frequency at which the scheduled activity recurs (daily, weekly, biweekly, monthly, quarterly, semiannual, or annual).']
  is_active boolean [note: 'Indicates whether this recurring schedule is currently active and eligible for generating scheduled activities (true) or inactive (false).']
  last_generated_date date [note: 'The date when the most recent scheduled activity was generated from this recurring schedule. Null if no activities have been generated yet.']
  max_occurrences varchar [note: 'The maximum number of times this schedule should generate activities before automatically completing. Null indicates unlimited occurrences.']
  modified_timestamp timestamp [note: 'The date and time when this recurring schedule record was last modified.']
  month_of_quarter varchar [note: 'For quarterly schedules, the specific month within the quarter when the activity occurs (1-3). Null if not applicable.']
  next_scheduled_date date [note: 'The date when the next scheduled activity is due to be generated from this recurring schedule.']
  notes varchar [note: 'Additional free-form notes or comments about the recurring schedule for operational reference.']
  occurrence_count varchar [note: 'The total number of times activities have been generated from this recurring schedule since its inception.']
  proration_rule varchar [note: 'The rule used to prorate amounts for partial periods (none, daily proration, monthly proration, actual days, or business days only).']
  quarter_of_year varchar [note: 'For annual schedules, the specific quarter of the year when the activity occurs (1-4). Null if not applicable.']
  recurring_schedule_description varchar [note: 'Detailed textual description of the recurring schedule, including its purpose, scope, and any special instructions or business rules.']
  recurring_schedule_status varchar [note: 'Current lifecycle status of the recurring schedule indicating whether it is in draft, actively generating activities, temporarily suspended, completed, or cancelled.']
  schedule_amount decimal(18,2) [note: 'The standard monetary amount associated with each recurrence of this schedule. Used for budgeting, allocation, or accrual purposes.']
  schedule_category varchar [note: 'High-level categorization of the schedule based on the nature of financial activities it governs.']
  schedule_code varchar [note: 'Business identifier code for the recurring schedule, used for external reference and reporting.']
  schedule_name varchar [note: 'Human-readable name describing the purpose or nature of the recurring schedule.']
  schedule_type varchar [note: 'Classification of the recurring schedule indicating its financial purpose (budget cycle, forecast period, cost allocation, accrual recognition, depreciation schedule, or amortization schedule).']
  version_number varchar [note: 'Version number of this recurring schedule record, incremented with each modification for change tracking and audit purposes.']
  vibe_mutation_marker varchar

  Note: 'Master reference table for recurring_schedule. Referenced by recurring_schedule_id.'
}

Table finance.asset_book {
  asset_book_id varchar [pk, note: 'Primary key for asset_book']
  chart_of_accounts_id varchar [note: 'Reference to the general ledger account where asset values and depreciation expenses for this book are posted.']
  cost_center_id varchar [note: 'Reference to the default cost center for assets tracked in this book, used for expense allocation and budgeting.']
  employee_id varchar [note: 'Reference to the user who created this asset book record.']
  last_modified_by_user_employee_id varchar [note: 'Reference to the user who most recently modified this asset book record.']
  organization_id varchar [note: 'Reference to the legal entity or organizational unit that owns and maintains this asset book.']
  parent_asset_book_id varchar [note: 'Self-referencing FK on asset_book (parent_asset_book_id)']
  parent_book_id varchar [note: 'Reference to a parent asset book if this book is a subsidiary or specialized book derived from a master book. Null for top-level books.']
  accounting_standard varchar [note: 'The accounting standard or framework governing depreciation and valuation rules for assets in this book.']
  allow_manual_depreciation boolean [note: 'Indicates whether manual depreciation adjustments are permitted for assets in this book, or if all depreciation must be system-calculated.']
  approval_required boolean [note: 'Indicates whether asset assignments or depreciation changes in this book require managerial or financial approval before posting.']
  approval_workflow_code varchar [note: 'Reference to the approval workflow process that governs changes to assets in this book. Null if no approval workflow is configured.']
  asset_book_description varchar [note: 'Detailed description of the asset book purpose, scope, and any special accounting rules or business context.']
  asset_book_status varchar [note: 'Current operational status of the asset book indicating whether it is actively used for asset tracking and depreciation calculations.']
  audit_trail_enabled boolean [note: 'Indicates whether detailed audit logging is enabled for all transactions and changes affecting assets in this book.']
  book_code varchar [note: 'Unique alphanumeric code identifying the asset book for external reference and reporting purposes.']
  book_name varchar [note: 'Full descriptive name of the asset book used for identification and reporting.']
  book_type varchar [note: 'Classification of the asset book based on its accounting purpose and regulatory framework.']
  consolidation_required boolean [note: 'Indicates whether asset values and depreciation from this book must be included in consolidated financial reporting.']
  created_timestamp timestamp [note: 'The date and time when this asset book record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the functional currency for asset valuations and depreciation in this book.']
  depreciation_method varchar [note: 'The default depreciation calculation method applied to assets assigned to this book.']
  effective_end_date date [note: 'The date when this asset book was closed or became inactive. Null for currently active books.']
  effective_start_date date [note: 'The date when this asset book became active and available for asset assignments and depreciation calculations.']
  fiscal_year_start_month varchar [note: 'The month number (1-12) when the fiscal year begins for this asset book, used for period-based depreciation calculations.']
  last_modified_timestamp timestamp [note: 'The date and time when this asset book record was most recently updated.']
  notes varchar [note: 'Free-form notes or comments providing additional context, special instructions, or historical information about this asset book.']
  prorate_depreciation boolean [note: 'Indicates whether depreciation is prorated based on the asset acquisition date within the fiscal period.']
  regulatory_jurisdiction varchar [note: 'The geographic or regulatory jurisdiction governing the accounting rules for this asset book (e.g., federal, state, international).']
  salvage_value_required boolean [note: 'Indicates whether assets assigned to this book must have a salvage value specified for depreciation calculations.']
  tax_reporting_required boolean [note: 'Indicates whether assets in this book are subject to tax reporting requirements and must be included in tax filings.']
  vibe_mutation_marker varchar

  Note: 'Master reference table for asset_book. Referenced by asset_book_id.'
}

Table insurance.payer {
  payer_id varchar [pk, note: 'Unique identifier for the payer organization.']
  parent_payer_id varchar [note: 'Reference to parent payer organization in a hierarchy.']
  primary_successor_payer_id varchar [note: 'Reference to the payer that succeeded this one after merger or acquisition.']
  accepts_assignment boolean [note: 'Indicates whether the payer accepts assignment of benefits.']
  active_flag boolean [note: 'Indicates whether the payer is currently active.']
  appeal_limit_days varchar [note: 'Number of days allowed for filing an appeal.']
  auto_renewal_flag boolean [note: 'Indicates whether contracts auto-renew.']
  claim_scrubbing_vendor varchar [note: 'Name of the claim scrubbing vendor used.']
  claims_inquiry_phone varchar [note: 'Phone number for claims inquiries.']
  claims_submission_endpoint varchar [note: 'URL or EDI endpoint for claim submission.']
  clearinghouse_code varchar [note: 'Code identifying the clearinghouse used.']
  coordination_of_benefits_required boolean [note: 'Indicates whether coordination of benefits is required.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  customer_service_phone varchar [note: 'Customer service phone number.']
  edi_payer_code varchar [note: 'EDI payer identification code.']
  electronic_funds_transfer_flag boolean [note: 'Indicates whether electronic funds transfer is supported.']
  eligibility_verification_method varchar [note: 'Method used for eligibility verification (e.g., real-time, batch).']
  id_external varchar [note: 'External system identifier for the payer.']
  inactivation_date date [note: 'Date when the payer was inactivated.']
  inactivation_reason varchar [note: 'Reason for payer inactivation.']
  notes varchar [note: 'Free-text notes about the payer.']
  npi varchar [note: 'National Provider Identifier for the payer organization.']
  payer_category varchar [note: 'Category of payer (e.g., commercial, government, self-pay).']
  payer_name varchar [note: 'Full legal name of the payer organization.']
  payer_type varchar [note: 'Type of payer (e.g., HMO, PPO, Medicare, Medicaid).']
  payment_terms_days varchar [note: 'Number of days for payment terms.']
  portal_url varchar [note: 'URL of the payer\'s provider portal.']
  prior_authorization_required boolean [note: 'Indicates whether prior authorization is required.']
  provider_relations_email varchar [note: 'Email address for provider relations.']
  remittance_address_line1 varchar [note: 'First line of remittance address.']
  remittance_address_line2 varchar [note: 'Second line of remittance address.']
  remittance_city varchar [note: 'City for remittance address.']
  remittance_delivery_method varchar [note: 'Method of remittance delivery (e.g., mail, electronic).']
  remittance_postal_code varchar [note: 'Postal code for remittance address.']
  remittance_state varchar [note: 'State for remittance address.']
  short_name varchar [note: 'Abbreviated name of the payer.']
  submission_method varchar [note: 'Method for claim submission (e.g., EDI, portal, paper).']
  tax_identification_number varchar [note: 'Tax ID (TIN/EIN) of the payer organization.']
  tier varchar [note: 'Tier classification of the payer.']
  timely_filing_limit_days varchar [note: 'Number of days for timely filing of claims.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Insurance payer organization master table storing health plan companies, government programs, and third-party administrators.'
}

Table insurance.health_plan {
  health_plan_id varchar [pk, note: 'Unique identifier for the health plan.']
  consent_policy_id varchar [note: 'Reference to consent policy required for this plan.']
  covered_diagnosis_icd_code_id varchar [note: 'Reference to ICD code for covered diagnoses.']
  formulary_id varchar [note: 'Reference to the drug formulary for this plan.']
  payer_id varchar [note: 'Reference to the payer offering this plan.']
  predecessor_health_plan_id varchar [note: 'Reference to the predecessor plan if this plan replaced another.']
  provider_network_id varchar [note: 'Reference to the provider network for this plan.']
  benefit_year varchar [note: 'Calendar year for which benefits apply.']
  cms_contract_number varchar [note: 'CMS contract number for Medicare Advantage or Part D plans.']
  cob_order varchar [note: 'Coordination of benefits order (primary, secondary, tertiary).']
  coinsurance_percentage decimal(5,2) [note: 'Default coinsurance percentage for the plan.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  effective_date date [note: 'Date when the plan becomes effective.']
  emergency_room_copay_amount decimal(10,2) [note: 'Copay amount for emergency room visits.']
  family_deductible_amount decimal(12,2) [note: 'Annual family deductible amount.']
  family_oop_max_amount decimal(12,2) [note: 'Annual family out-of-pocket maximum.']
  fsa_eligible boolean [note: 'Indicates whether the plan is FSA-eligible.']
  funding_type varchar [note: 'Funding type (e.g., fully insured, self-funded).']
  group_number varchar [note: 'Group number for employer-sponsored plans.']
  hra_eligible boolean [note: 'Indicates whether the plan is HRA-eligible.']
  hsa_eligible boolean [note: 'Indicates whether the plan is HSA-eligible.']
  individual_deductible_amount decimal(12,2) [note: 'Annual individual deductible amount.']
  individual_oop_max_amount decimal(12,2) [note: 'Annual individual out-of-pocket maximum.']
  inpatient_hospital_copay_amount decimal(10,2) [note: 'Copay amount for inpatient hospital stays.']
  issuer_state varchar [note: 'State where the plan is issued.']
  metal_tier varchar [note: 'ACA metal tier (Bronze, Silver, Gold, Platinum).']
  open_enrollment_end_date date [note: 'End date of open enrollment period.']
  open_enrollment_start_date date [note: 'Start date of open enrollment period.']
  out_of_network_coverage boolean [note: 'Indicates whether out-of-network coverage is available.']
  out_of_network_deductible_amount decimal(12,2) [note: 'Annual out-of-network deductible amount.']
  out_of_network_oop_max_amount decimal(12,2) [note: 'Annual out-of-network out-of-pocket maximum.']
  plan_document_url varchar [note: 'URL to the plan document or summary of benefits.']
  plan_identifier varchar [note: 'External plan identifier or code.']
  plan_name varchar [note: 'Name of the health plan.']
  plan_status varchar [note: 'Status of the plan (active, inactive, pending).']
  plan_type varchar [note: 'Type of plan (HMO, PPO, EPO, POS, HDHP).']
  prescription_tier1_copay_amount decimal(10,2) [note: 'Copay amount for tier 1 prescriptions.']
  prescription_tier2_copay_amount decimal(10,2) [note: 'Copay amount for tier 2 prescriptions.']
  prescription_tier3_copay_amount decimal(10,2) [note: 'Copay amount for tier 3 prescriptions.']
  prescription_tier4_copay_amount decimal(10,2) [note: 'Copay amount for tier 4 prescriptions.']
  preventive_care_covered boolean [note: 'Indicates whether preventive care is covered at 100%.']
  primary_care_copay_amount decimal(10,2) [note: 'Copay amount for primary care visits.']
  prior_authorization_required boolean [note: 'Indicates whether prior authorization is required.']
  requires_pcp_selection boolean [note: 'Indicates whether members must select a primary care physician.']
  requires_referral_for_specialist boolean [note: 'Indicates whether referrals are required for specialist visits.']
  service_area_description varchar [note: 'Description of the geographic service area.']
  specialist_copay_amount decimal(10,2) [note: 'Copay amount for specialist visits.']
  state_filing_number varchar [note: 'State regulatory filing number.']
  termination_date date [note: 'Date when the plan terminates.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']
  urgent_care_copay_amount decimal(10,2) [note: 'Copay amount for urgent care visits.']

  Note: 'Specific health insurance plan products offered by payers, including benefit design and coverage rules.'
}

Table insurance.benefit {
  benefit_id varchar [pk, note: 'Unique identifier for the benefit component within a health plan. Primary key for the benefit master record.']
  diagnosis_icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Benefits often require specific diagnoses for coverage (e.g., CGM for diabetes, PT for specific conditions). Medical necessity validation and claims auto-adjudication depend on diagnosis-benefit linka']
  health_plan_id varchar [note: 'Reference to the parent health plan that contains this benefit component. Links benefit to its plan container.']
  parent_benefit_id varchar [note: 'Self-referencing FK on benefit (parent_benefit_id)']
  procedure_cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Benefits are defined by specific CPT procedures with associated copays, coinsurance, and authorization requirements. Core to claims adjudication engine and member cost-sharing calculation in every pay']
  procedure_hcpcs_code_id varchar [note: 'Foreign key linking to reference.hcpcs_code. Business justification: Benefits for DME, supplies, and non-physician services are defined by HCPCS codes. Essential for benefit determination, prior authorization rules, and claims payment calculation in healthcare payer op']
  allowed_amount_basis varchar [note: 'Method used to determine the allowed amount for benefit adjudication. Defines how the plan calculates the maximum payable amount for a service.']
  benefit_category varchar [note: 'High-level classification of the healthcare service category covered by this benefit. [ENUM-REF-CANDIDATE: inpatient_hospital|outpatient_surgery|primary_care|specialist|emergency|mental_health|substance_use|preventive|durable_medical_equipment|home_health|hospice|vision|dental|pharmacy|rehabilitation|skilled_nursing — promote to reference product]']
  benefit_code varchar [note: 'Unique business identifier for the benefit component used in plan documentation, member communications, and adjudication rules. Externally visible code.']
  benefit_description varchar [note: 'Detailed narrative description of the benefit coverage, limitations, and member responsibilities. Used in Summary of Benefits and Coverage (SBC) and member materials.']
  benefit_name varchar [note: 'Human-readable name of the benefit component displayed to members and providers. Example: Inpatient Hospital Services, Primary Care Office Visit.']
  benefit_status varchar [note: 'Current lifecycle status of the benefit component. Active benefits are available for adjudication; inactive benefits are historical or discontinued.']
  coinsurance_percentage decimal(5,2) [note: 'Percentage of allowed amount the member pays after deductible is met. Expressed as percentage (e.g., 20.00 for 20%). Null if benefit uses copay instead of coinsurance.']
  copay_amount decimal(10,2) [note: 'Fixed dollar amount the member pays per service or visit as defined by the benefit. Null if benefit uses coinsurance instead of copay.']
  cost_sharing_tier varchar [note: 'Actuarial value tier of the benefit indicating the percentage of costs the plan covers on average. Used for ACA marketplace plans.']
  coverage_percentage decimal(5,2) [note: 'Percentage of allowed amount the plan pays for this benefit. Expressed as percentage (e.g., 80.00 for 80% plan payment). Inverse of coinsurance_percentage.']
  created_timestamp timestamp [note: 'Timestamp when this benefit record was first created in the system. Used for audit trail and data lineage tracking.']
  day_limit_count varchar [note: 'Maximum number of days covered per benefit period for services measured in days (e.g., 90 days skilled nursing facility per benefit period). Null if no day limit applies.']
  day_limit_period varchar [note: 'Time period over which the day limit count applies. Example: per_admission for inpatient stays, per_year for annual day limits.']
  days_supply_limit varchar [note: 'Maximum number of days supply allowed per prescription fill for pharmacy benefits. Common limits are 30, 60, or 90 days. Null if not applicable.']
  deductible_applies_flag boolean [note: 'Indicates whether the plan deductible must be met before this benefit pays. True if deductible applies, False if benefit is not subject to deductible (e.g., preventive services).']
  diagnosis_code_type varchar [note: 'Type of diagnosis coding system used for medical necessity determination and benefit eligibility. ICD-10-CM is current standard in US; ICD-9-CM is legacy.']
  dollar_limit_amount decimal(12,2) [note: 'Maximum dollar amount the plan will pay for this benefit per limit period. Null if no dollar limit applies. Note: ACA prohibits lifetime and annual dollar limits on essential health benefits.']
  dollar_limit_period varchar [note: 'Time period over which the dollar limit amount applies. Used for non-essential benefits where dollar limits are permitted.']
  effective_date date [note: 'Date when this benefit component becomes active and available for coverage. Must align with plan year or mid-year plan changes.']
  essential_health_benefit_flag boolean [note: 'Indicates whether this benefit is classified as an Essential Health Benefit under ACA. EHBs cannot have annual or lifetime dollar limits.']
  exclusions_text varchar [note: 'Narrative description of services or conditions explicitly excluded from this benefit. Critical for claims denial and member communication.']
  formulary_tier varchar [note: 'Pharmacy formulary tier for drug benefits indicating cost-sharing level. Tier 1 typically generic, Tier 2 preferred brand, Tier 3 non-preferred brand, Tier 4 specialty drugs.']
  hsa_eligible_flag boolean [note: 'Indicates whether this benefit is compatible with Health Savings Account (HSA) requirements. True if benefit meets HSA-qualified high-deductible health plan (HDHP) rules.']
  limitations_text varchar [note: 'Narrative description of limitations, restrictions, or conditions that apply to this benefit beyond the structured limit fields.']
  mail_order_available_flag boolean [note: 'Indicates whether this pharmacy benefit can be fulfilled through mail order pharmacy with potentially different cost-sharing. True if mail order option available.']
  modified_timestamp timestamp [note: 'Timestamp when this benefit record was last modified. Updated whenever any attribute changes. Used for change tracking and audit compliance.']
  network_type varchar [note: 'Indicates whether this benefit applies to in-network providers, out-of-network providers, or both. Critical for cost-sharing calculation and provider network adjudication.']
  out_of_pocket_applies_flag boolean [note: 'Indicates whether member cost-sharing for this benefit counts toward the annual out-of-pocket maximum. True if it counts, False if excluded (e.g., non-covered services).']
  place_of_service_code varchar [note: 'Standard two-digit code identifying where the service is delivered (e.g., 11=Office, 21=Inpatient Hospital, 22=Outpatient Hospital, 23=Emergency Room). Used for benefit adjudication rules.']
  preventive_care_flag boolean [note: 'Indicates whether this benefit is classified as preventive care under ACA requirements. Preventive services must be covered at 100% with no cost-sharing when delivered in-network.']
  prior_authorization_required_flag boolean [note: 'Indicates whether prior authorization from the health plan is required before the service is covered. True if PA required, False otherwise.']
  procedure_code_type varchar [note: 'Type of procedure coding system used to identify services covered by this benefit. CPT for physician services, HCPCS for supplies and equipment, ICD-10-PCS for inpatient procedures, CDT for dental.']
  quantity_limit_flag boolean [note: 'Indicates whether this benefit has quantity or frequency limits (e.g., maximum number of visits, days supply, units per fill). True if limits apply.']
  referral_required_flag boolean [note: 'Indicates whether a referral from Primary Care Physician (PCP) is required to access this benefit. Common in Health Maintenance Organization (HMO) plans.']
  service_type_code varchar [note: 'Standard code identifying the type of healthcare service covered by this benefit. Aligns with X12 837 claim service type codes for electronic transactions.']
  step_therapy_required_flag boolean [note: 'Indicates whether step therapy protocol must be followed (trying lower-cost alternatives before higher-cost treatments). Primarily used for pharmacy benefits.']
  subcategory varchar [note: 'Detailed subcategory within the benefit category providing granular service classification. Example: Acute Inpatient, Observation Stay, Ambulatory Surgery.']
  termination_date date [note: 'Date when this benefit component is no longer active. Null for currently active benefits with no planned end date.']
  tier varchar [note: 'Tiering level of the benefit indicating cost-sharing structure. Commonly used for pharmacy benefits (generic, preferred brand, non-preferred brand, specialty) and provider networks (in-network tier 1, tier 2).']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar
  visit_limit_count varchar [note: 'Maximum number of visits or services allowed per benefit period (e.g., 20 physical therapy visits per year). Null if no visit limit applies.']
  visit_limit_period varchar [note: 'Time period over which the visit limit count applies. Example: per_year for annual limits, per_lifetime for lifetime maximums.']

  Note: 'Master record defining individual benefit components within a health plan, representing the specific coverage rules for a category of healthcare services. Captures benefit category (inpatient hospital, outpatient surgery, primary care, specialist, emergency, mental health, substance use, preventive, DME, home health, hospice, vision, dental, pharmacy), benefit tier, in-network vs out-of-network rules, prior authorization requirement flag, referral requirement flag, copay amount, coinsurance percentage, deductible applicability, benefit limit (visit limits, dollar limits, day limits), and benefit effective dates. Enables granular benefit adjudication and member cost-sharing calculation.'
}

Table insurance.provider_network {
  provider_network_id varchar [pk, note: 'Unique identifier for the provider network. Primary key.']
  parent_network_provider_network_id varchar [note: 'Identifier of the parent or umbrella network if this network is a subset or regional variant. Used for hierarchical network structures where a national network has regional sub-networks. Null for top-level networks.']
  parent_provider_network_id varchar [note: 'Self-referencing FK on provider_network (parent_provider_network_id)']
  payer_id varchar [note: 'Identifier of the payer or health plan that owns and manages this provider network.']
  accepting_new_patients_flag boolean [note: 'Indicates whether the network as a whole has capacity to accept new members. True if sufficient providers are accepting new patients. False if network is at capacity. Used for enrollment management.']
  adequacy_review_date date [note: 'Date of the most recent network adequacy assessment by CMS or state regulators. Networks must be reviewed annually or when material changes occur.']
  behavioral_health_included_flag boolean [note: 'Indicates whether this network includes behavioral health and mental health providers. True if behavioral health services are covered. False if behavioral health is carved out to a separate network.']
  cms_approval_date date [note: 'Date when CMS approved the network adequacy filing. Null if not yet approved or not required.']
  cms_filing_date date [note: 'Date when the network adequacy filing was submitted to CMS. Required for Medicare Advantage and Marketplace plans.']
  cms_filing_status varchar [note: 'Status of the network adequacy filing with CMS for Medicare Advantage or Marketplace plans. Filed indicates submission. Approved indicates CMS acceptance. Rejected indicates CMS denial. Pending indicates under CMS review. Not required for non-CMS regulated plans.']
  contract_type varchar [note: 'Payment model used for provider contracts in this network. Fee-for-service pays per service. Capitation pays per member per month. Shared savings shares cost savings with providers. Bundled payment pays fixed amount for episode of care. Value-based ties payment to quality and outcomes. Hybrid combines multiple models.']
  created_timestamp timestamp [note: 'Date and time when this provider network record was first created in the system. Used for audit trail and data lineage.']
  credentialing_standard varchar [note: 'Accreditation or regulatory standard used for provider credentialing in this network. NCQA (National Committee for Quality Assurance) is most common. URAC is utilization review accreditation. AAAHC (Accreditation Association for Ambulatory Health Care) for ambulatory settings. TJC (The Joint Commission) for hospitals. State-specific for state-mandated standards. Internal for payer-defined standards.']
  dental_network_included_flag boolean [note: 'Indicates whether this network includes dental providers or if dental benefits are managed separately. True if dental is included. False if dental is carved out.']
  directory_last_updated_date date [note: 'Date when the provider directory was last updated with current network participation information. CMS requires directories to be updated at least monthly.']
  effective_date date [note: 'Date when the provider network becomes active and available for member enrollment and claim adjudication. Must align with plan year or regulatory approval dates.']
  effective_end_date date [note: 'Effective End Date for provider_network.']
  effective_start_date date [note: 'Effective Start Date for provider_network.']
  facility_count varchar [note: 'Total number of facilities (hospitals, clinics, surgery centers, imaging centers) participating in this network. Used for network adequacy assessment and member communications.']
  geographic_service_area varchar [note: 'Geographic region where the provider network operates, defined by state, county, ZIP code, or metropolitan statistical area. Used for network adequacy assessment and member eligibility determination.']
  is_active boolean [note: 'Is Active for provider_network.']
  network_adequacy_status varchar [note: 'Assessment of whether the provider network meets regulatory standards for provider availability, geographic access, and appointment wait times. Adequate networks meet all standards. Inadequate networks require corrective action. Conditionally adequate networks meet standards with exceptions.']
  network_code varchar [note: 'Business identifier for the provider network, used externally by payers, providers, and members. May be referenced on insurance cards and claim submissions.']
  network_description varchar [note: 'Detailed description of the provider network, including key features, geographic coverage, specialty availability, and member benefits. Used in plan marketing materials and member communications.']
  network_directory_url varchar [note: 'Web address of the online provider directory for this network. Members use this to search for in-network providers. Required by CMS for Medicare Advantage and Marketplace plans.']
  network_model varchar [note: 'Organizational structure of the provider network. Staff model employs providers directly. Group model contracts with multi-specialty groups. Network model contracts with multiple IPAs. IPA (Independent Practice Association) is a physician-owned network. Direct contract is payer-to-provider agreements. Rental network leases access to another payers network.']
  network_name varchar [note: 'Human-readable name of the provider network, used in member communications, plan documents, and provider directories.']
  network_status varchar [note: 'Current lifecycle status of the provider network. Active networks are available for member enrollment and claim adjudication. Pending networks are under development or regulatory review. Suspended networks are temporarily unavailable. Terminated networks are closed and no longer accepting new members.']
  network_tier varchar [note: 'Tier classification of the network for cost-sharing purposes. Preferred or Tier 1 networks offer lowest member cost-sharing. Standard or Tier 2 networks have moderate cost-sharing. Out-of-network or Tier 3 have highest cost-sharing. Used in tiered network benefit designs.']
  network_type varchar [note: 'Classification of the provider network structure. HMO (Health Maintenance Organization) requires PCP referrals and in-network care. PPO (Preferred Provider Organization) allows out-of-network care at higher cost. EPO (Exclusive Provider Organization) requires in-network care except emergencies. POS (Point of Service) combines HMO and PPO features. ACO (Accountable Care Organization) is a value-based network. Narrow network limits provider choice for lower premiums. Tiered network assigns cost-sharing levels by provider performance. [ENUM-REF-CANDIDATE: HMO|PPO|EPO|POS|ACO|narrow_network|tiered_network|exclusive_network|open_network — 9 candidates stripped; promote to reference product]']
  pcp_count varchar [note: 'Total number of primary care physicians in this network. Critical metric for HMO and POS networks that require PCP selection. Used for network adequacy assessment.']
  pharmacy_network_included_flag boolean [note: 'Indicates whether this network includes pharmacy providers or if pharmacy benefits are managed separately. True if pharmacy is included. False if pharmacy is carved out.']
  provider_count varchar [note: 'Total number of individual providers (physicians, specialists, allied health professionals) participating in this network. Used for network adequacy assessment and member communications.']
  quality_tier_methodology varchar [note: 'Description of the methodology used to assign providers to quality or performance tiers within this network. May reference HEDIS measures, patient satisfaction scores, cost efficiency, or clinical outcomes. Used in tiered network designs.']
  recredentialing_cycle_months varchar [note: 'Number of months between provider recredentialing reviews. Typically 24 or 36 months per NCQA standards. Used to schedule provider credential verification and quality reviews.']
  risk_arrangement varchar [note: 'Financial risk-sharing arrangement between payer and network providers. Full risk transfers all financial risk to providers. Shared risk splits risk between payer and providers. Upside only allows providers to share savings but not losses. Downside risk requires providers to cover losses. No risk is traditional fee-for-service.']
  service_area_type varchar [note: 'Classification of the geographic service area scope. Statewide covers entire state. Regional covers multiple counties or regions. County covers specific counties. ZIP code covers specific ZIP codes. MSA (Metropolitan Statistical Area) covers census-defined metro areas. National covers multiple states or entire country.']
  specialist_count varchar [note: 'Total number of specialist physicians in this network. Used for network adequacy assessment and member communications.']
  telehealth_enabled_flag boolean [note: 'Indicates whether this network includes telehealth or virtual care providers. True if telehealth services are available. False if only in-person care is covered.']
  termination_date date [note: 'Date when the provider network is terminated and no longer available for new member enrollment. Existing members may have a transition period. Null for open-ended networks.']
  updated_timestamp timestamp [note: 'Date and time when this provider network record was last modified. Used for audit trail and change tracking.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar
  vision_network_included_flag boolean [note: 'Indicates whether this network includes vision providers or if vision benefits are managed separately. True if vision is included. False if vision is carved out.']

  Note: 'Master record for every provider network defined and managed by a payer, representing the contracted network of providers available to plan members. Captures network name, network ID, network type (HMO, PPO, EPO, narrow network, tiered network, ACO network), geographic service area, network tier (preferred, standard, out-of-network), network effective and termination dates, network adequacy status, CMS network adequacy filing status, and the payer that owns the network. SSOT for network identity referenced by plan-network associations, provider participation records, and claim adjudication.'
}

Table insurance.plan_network {
  plan_network_id varchar [pk, note: 'Unique identifier for the plan-network association record. Primary key.']
  health_plan_id varchar [note: 'Identifier of the health plan participating in this network association. Links to the health plan master record.']
  provider_network_id varchar [note: 'Identifier of the provider network associated with this plan. Links to the provider network master record.']
  superseded_plan_network_id varchar [note: 'Self-referencing FK on plan_network (superseded_plan_network_id)']
  auto_assignment_eligible boolean [note: 'Indicates whether members can be automatically assigned to providers within this network when no explicit selection is made. Used in HMO (Health Maintenance Organization) and POS (Point of Service) plan configurations.']
  claims_processing_priority varchar [note: 'Priority level for processing claims from this network within the plan. Lower numbers indicate higher priority for adjudication workflows.']
  coinsurance_percentage decimal(5,2) [note: 'Default coinsurance percentage that members pay for services within this network under the plan. Expressed as a percentage (e.g., 20.00 for 20% member responsibility).']
  contract_number varchar [note: 'Contract or agreement number governing the relationship between the health plan and the provider network. Used for contract management and financial reconciliation.']
  copay_tier_code varchar [note: 'Code identifying the copayment tier structure applicable to this network within the plan. Links to benefit copay schedules for member cost-sharing calculations.']
  county_code varchar [note: 'Five-digit FIPS county code for granular geographic applicability of the plan-network association.']
  created_timestamp timestamp [note: 'Timestamp when this plan-network association record was first created in the system. Used for audit trails and data lineage tracking.']
  deductible_applies boolean [note: 'Indicates whether the plan deductible applies to services rendered within this network. Some plan designs waive deductibles for preferred network tiers.']
  effective_date date [note: 'Date when this plan-network association becomes active and available to plan members for benefit determination.']
  filing_reference_number varchar [note: 'Reference number assigned by the regulatory authority for the filing of this plan-network association. Used for compliance tracking and audit trails.']
  geographic_region varchar [note: 'Geographic region or service area where this network is applicable for the plan. May include state, county, or custom region codes.']
  member_communication_required boolean [note: 'Indicates whether plan members must be notified about this network association or changes to it. Used for regulatory compliance with member notification requirements.']
  network_adequacy_certification_date date [note: 'Date when network adequacy certification was granted for this plan-network association. Used for regulatory reporting and compliance tracking.']
  network_adequacy_certified boolean [note: 'Indicates whether this network has been certified as meeting network adequacy standards for the plan service area. Required for CMS (Centers for Medicare and Medicaid Services) and state regulatory compliance.']
  network_priority varchar [note: 'Numeric priority ranking of this network within the plan when multiple networks are available. Lower numbers indicate higher priority for benefit determination.']
  network_role varchar [note: 'Role or function of this network within the plan structure. Indicates whether the network serves as the primary, secondary, or specialized network for plan members.']
  network_tier varchar [note: 'Tier designation of the network within the plan benefit structure. Determines member cost-sharing levels and benefit coverage percentages.']
  network_type varchar [note: 'Type of network model used in this plan-network association. HMO (Health Maintenance Organization), PPO (Preferred Provider Organization), EPO (Exclusive Provider Organization), POS (Point of Service), HDHP (High Deductible Health Plan). [ENUM-REF-CANDIDATE: hmo|ppo|epo|pos|hdhp|medicare_advantage|medicaid_managed_care — 7 candidates stripped; promote to reference product]']
  notes varchar [note: 'Free-text notes or comments about this plan-network association. Used for documenting special configurations, exceptions, or business context.']
  out_of_network_coverage boolean [note: 'Indicates whether the plan provides any coverage for services rendered by providers outside this network. Supports PPO (Preferred Provider Organization) and POS (Point of Service) plan designs.']
  out_of_pocket_max_applies boolean [note: 'Indicates whether member cost-sharing for services in this network counts toward the plan out-of-pocket maximum. Critical for Affordable Care Act (ACA) compliance.']
  pcp_selection_required boolean [note: 'Indicates whether members enrolled in this plan-network combination must select a Primary Care Physician (PCP) from the network.']
  plan_network_status varchar [note: 'Current lifecycle status of the plan-network association. Indicates whether the association is currently in effect for benefit determination and claim adjudication.']
  referral_required boolean [note: 'Indicates whether specialist referrals are required for members using this network under the plan. Common in HMO (Health Maintenance Organization) configurations.']
  regulatory_filing_required boolean [note: 'Indicates whether this plan-network association requires filing with state insurance departments or CMS (Centers for Medicare and Medicaid Services) for approval.']
  reimbursement_method varchar [note: 'Primary reimbursement methodology used for providers in this network under the plan. DRG (Diagnosis-Related Group) for inpatient, fee-for-service, capitation, or value-based arrangements.']
  state_code varchar [note: 'Two-letter state code where this plan-network association is active. Supports multi-state plan configurations.']
  termination_date date [note: 'Date when this plan-network association ends. Null indicates an open-ended association with no planned termination.']
  updated_by varchar [note: 'Identifier of the user or system process that last updated this record. Supports audit trail requirements and change management.']
  updated_timestamp timestamp [note: 'Timestamp when this plan-network association record was last modified. Used for change tracking and audit compliance.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Association record linking a health plan to one or more provider networks, defining which networks are available to members enrolled in a given plan. Captures plan ID, network ID, network role (primary, secondary, out-of-area), geographic region applicability, effective date, termination date, and network tier designation within the plan. Supports multi-network plan configurations (e.g., tiered PPO with preferred and standard networks) and enables accurate in-network benefit determination during claim adjudication.'
}

Table insurance.coverage_policy {
  coverage_policy_id varchar [pk, note: 'Unique identifier for the coverage policy record. Primary key.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Payer coverage policies must align with organizational compliance policies governing experimental treatment, off-label use, investigational devices, and regulatory coverage requirements. This linkage ']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Coverage policies define medical necessity criteria for specific CPT procedures. Current text field \'applicable_cpt_codes\' should be normalized to proper FK for policy enforcement, prior authorization']
  drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: Coverage policies define payment rules and authorization requirements for specific DRGs in inpatient settings. Critical for bundled payment administration, outlier payment calculation, and hospital co']
  hcpcs_code_id varchar [note: 'Foreign key linking to reference.hcpcs_code. Business justification: Coverage policies govern HCPCS code reimbursement and authorization requirements. Denormalized text field \'applicable_hcpcs_codes\' should be proper FK for policy administration, utilization management']
  health_plan_id varchar [note: 'Reference to the specific health plan under which this coverage policy applies.']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Coverage policies specify diagnosis criteria for medical necessity. Text field \'applicable_icd10_codes\' should be normalized FK for automated policy evaluation, clinical documentation requirements, an']
  payer_id varchar [note: 'Reference to the insurance payer or health plan that owns this coverage policy.']
  primary_superseded_by_coverage_policy_id varchar [note: 'Reference to the coverage policy that replaces this policy when it is retired or superseded. Nullable if the policy is still active or has not been replaced.']
  required_consent_form_template_id varchar [note: 'Foreign key linking to consent.consent_form_template. Business justification: Coverage policies define consent documentation requirements for specific procedures/services (e.g., sterilization consent, experimental treatment consent). Medical policy enforcement requires linking ']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Medical policies define coverage criteria by specialty (e.g., orthopedic surgery criteria, cardiology device policies). Essential for claims adjudication, medical necessity determination, and specialt']
  taxonomy_id varchar [note: 'Foreign key linking to provider.provider_taxonomy. Business justification: Coverage policies reference taxonomy codes for provider type restrictions (e.g., only board-certified surgeons, only licensed clinical psychologists). Critical for claims auto-adjudication and provide']
  age_restrictions varchar [note: 'Age-based limitations or requirements for coverage under this policy (e.g., \'covered for patients 18 years and older\', \'pediatric use only\').']
  appeals_allowed boolean [note: 'Indicates whether coverage denials based on this policy can be appealed by the provider or patient. True = appeals allowed; False = no appeals allowed.']
  appeals_process_description varchar [note: 'Detailed description of the appeals process for coverage denials based on this policy, including timelines, required documentation, and contact information.']
  clinical_evidence_source varchar [note: 'Reference to the clinical evidence, guidelines, or literature that supports the coverage determination (e.g., \'NCCN Guidelines\', \'FDA approval\', \'peer-reviewed clinical trial\').']
  coverage_determination varchar [note: 'Final determination of whether the service, procedure, or technology is covered under this policy. Covered = reimbursable; Non-Covered = not reimbursable; Conditional = covered only if specific criteria met; Investigational/Experimental = not covered due to lack of evidence; Not Medically Necessary = does not meet medical necessity criteria.']
  created_timestamp timestamp [note: 'Timestamp when the coverage policy record was first created in the system.']
  effective_date date [note: 'Date on which the coverage policy becomes active and enforceable for claims adjudication and prior authorization decisions.']
  exclusions varchar [note: 'Specific services, procedures, diagnoses, or circumstances that are explicitly excluded from coverage under this policy.']
  expiration_date date [note: 'Date on which the coverage policy ceases to be active. Nullable for policies with no defined end date.']
  frequency_limitations varchar [note: 'Limitations on how often the service or procedure can be performed and reimbursed within a specified time period (e.g., \'once per calendar year\', \'maximum 12 visits per year\').']
  gender_restrictions varchar [note: 'Gender-based limitations or requirements for coverage under this policy (e.g., \'female patients only\', \'male patients only\', \'no gender restrictions\').']
  last_updated_date date [note: 'Date when the coverage policy was last modified or revised.']
  medical_necessity_criteria varchar [note: 'Clinical criteria defining when the service or procedure is considered medically necessary and therefore eligible for coverage under this policy.']
  network_restrictions varchar [note: 'Indicates whether the service or procedure must be performed by an in-network provider to be covered. In-Network Only = only in-network providers eligible; Out-of-Network Allowed = both in-network and out-of-network providers eligible (may have different reimbursement); No Restriction = network status does not affect coverage.']
  place_of_service_restrictions varchar [note: 'Restrictions on where the service or procedure can be performed to be eligible for coverage (e.g., \'inpatient hospital only\', \'outpatient facility or office\', \'home health setting\').']
  policy_approval_date date [note: 'Date on which the coverage policy was formally approved by the payer\'s medical policy committee or equivalent governance body.']
  policy_approved_by varchar [note: 'Name or identifier of the individual or committee that approved the coverage policy.']
  policy_category varchar [note: 'High-level categorization of the coverage policy by clinical domain or service type (e.g., \'Radiology\', \'Pharmacy\', \'Surgical Procedures\', \'Durable Medical Equipment\').']
  policy_description varchar [note: 'Detailed narrative description of the coverage policy, including the clinical rationale, scope of coverage, and any special conditions or limitations.']
  policy_number varchar [note: 'Externally-known unique identifier for the coverage policy, used in prior authorization and claims adjudication workflows.']
  policy_owner varchar [note: 'Name or identifier of the individual or department responsible for maintaining and updating this coverage policy.']
  policy_status varchar [note: 'Current lifecycle status of the coverage policy. Active = in effect and enforceable; Inactive = temporarily suspended; Draft = not yet finalized; Under Review = being evaluated or updated; Retired = no longer in use; Superseded = replaced by a newer policy version.']
  policy_title varchar [note: 'Human-readable title or name of the coverage policy, describing the service or condition covered.']
  policy_type varchar [note: 'Classification of the coverage policy. Medical Policy = internal payer medical necessity policy; Coverage Determination = specific coverage decision; LCD = Local Coverage Determination (Medicare contractor-specific); NCD = National Coverage Determination (CMS national policy); Administrative Policy = non-clinical coverage rule; Clinical Guideline = evidence-based clinical criteria.']
  policy_version varchar [note: 'Version number of the coverage policy, used to track revisions and updates over time (e.g., \'1.0\', \'2.3\').']
  prior_authorization_criteria varchar [note: 'Detailed clinical and administrative criteria that must be met to obtain prior authorization for the service or procedure covered by this policy.']
  prior_authorization_required boolean [note: 'Indicates whether prior authorization is required before the service or procedure can be performed and reimbursed under this policy. True = prior authorization required; False = no prior authorization required.']
  provider_specialty_restrictions varchar [note: 'Restrictions on which provider specialties are authorized to perform the service or procedure under this policy (e.g., \'board-certified cardiologist only\', \'licensed physical therapist\').']
  quantity_limitations varchar [note: 'Limitations on the quantity or dosage of the service, supply, or medication that can be provided and reimbursed under this policy (e.g., \'maximum 30-day supply\', \'up to 10 units per month\').']
  regulatory_basis varchar [note: 'Reference to the regulatory or statutory basis for the coverage policy (e.g., \'CMS NCD 210.1\', \'State Medicaid Manual Section 4.5\', \'ACA Essential Health Benefits\').']
  review_date date [note: 'Scheduled date for the next policy review or update cycle, ensuring the policy remains aligned with current clinical evidence and regulatory requirements.']
  step_therapy_criteria varchar [note: 'Detailed criteria defining the step therapy requirements, including which treatments must be tried first and the conditions under which step therapy can be bypassed.']
  step_therapy_required boolean [note: 'Indicates whether step therapy (trial of less expensive or less invasive treatments first) is required before the service or procedure is covered. True = step therapy required; False = no step therapy required.']
  updated_timestamp timestamp [note: 'Timestamp when the coverage policy record was last updated in the system.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record for payer coverage policies and medical policies governing whether specific services, procedures, diagnoses, or technologies are covered under a health plan. Captures policy number, policy title, policy type (medical policy, coverage determination, LCD — Local Coverage Determination, NCD — National Coverage Determination), covered/non-covered determination, applicable CPT/HCPCS codes, applicable ICD-10 diagnosis codes, prior authorization requirements, clinical criteria (medical necessity criteria, step therapy requirements), effective date, and review/expiration date. SSOT for coverage rules referenced during prior authorization and claim adjudication.'
}

Table insurance.member_enrollment {
  member_enrollment_id varchar [pk, note: 'Unique identifier for the member enrollment record. Primary key for this transactional enrollment entity.']
  compliance_policy_id varchar [note: 'Policy identifier assigned by the health insurance exchange for marketplace enrollments. Used for reconciliation with exchange data.']
  health_plan_id varchar [note: 'Unique identifier for the specific health plan product the member is enrolled in. Links to the health plan master record.']
  payer_id varchar [note: 'Unique identifier for the insurance payer or health plan organization providing coverage. Links to the payer master record.']
  primary_member_subscriber_id varchar [note: 'External subscriber identifier assigned by the payer or health plan. Used for eligibility verification and claim adjudication.']
  prior_member_enrollment_id varchar [note: 'Self-referencing FK on member_enrollment (prior_member_enrollment_id)']
  provider_network_id varchar [note: 'Unique identifier for the provider network associated with this enrollment. Determines in-network vs out-of-network benefits.']
  visit_id varchar [note: 'Foreign key linking to encounter.visit. Business justification: Real-time eligibility verification at registration links enrollment records to specific encounters. Point-of-service collections, copay determination, and benefit verification all require connecting e']
  benefit_period_end_date date [note: 'End date of the benefit period for deductible and out-of-pocket maximum tracking. Resets accumulators for next period.']
  benefit_period_start_date date [note: 'Start date of the benefit period for deductible and out-of-pocket maximum tracking. Typically calendar year or plan year.']
  cobra_indicator boolean [note: 'Indicates whether this enrollment is a COBRA continuation coverage following employment termination.']
  cobra_qualifying_event_date date [note: 'Date of the qualifying event that triggered COBRA eligibility (e.g., employment termination, divorce). Nullable for non-COBRA enrollments.']
  coverage_tier varchar [note: 'Coverage tier indicating the scope of family members covered under this enrollment. Affects premium calculation.']
  eligibility_verification_date date [note: 'Date when member eligibility was last verified with the payer. Used for real-time eligibility checks.']
  eligibility_verification_status varchar [note: 'Status of the most recent eligibility verification attempt. Used to flag potential coverage issues.']
  enrollment_channel varchar [note: 'Channel or interface through which the member completed the enrollment process.']
  enrollment_created_timestamp timestamp [note: 'Timestamp when this enrollment record was first created in the system. Used for audit and data lineage tracking.']
  enrollment_effective_date date [note: 'Date when the member coverage becomes effective and benefits are available. Used for eligibility determination.']
  enrollment_notes varchar [note: 'Free-text notes or comments related to this enrollment. Used for documenting special circumstances or exceptions.']
  enrollment_source varchar [note: 'Source system or channel through which the enrollment was initiated. [ENUM-REF-CANDIDATE: employer_group|aca_exchange|medicare_cms|medicaid_agency|direct_enrollment|broker|navigator|other — promote to reference product]']
  enrollment_source_system varchar [note: 'Name of the source system that originated this enrollment record. Used for data lineage and reconciliation.']
  enrollment_status varchar [note: 'Current lifecycle status of the member enrollment. Used for eligibility verification and claim adjudication.']
  enrollment_termination_date date [note: 'Date when the member coverage ends and benefits are no longer available. Nullable for active enrollments.']
  enrollment_type varchar [note: 'Type of enrollment event that initiated this coverage. Determines eligibility rules and enrollment period constraints.']
  enrollment_updated_timestamp timestamp [note: 'Timestamp when this enrollment record was last modified. Used for audit and change tracking.']
  group_number varchar [note: 'Employer or sponsor group number under which the member is enrolled. Used to identify the benefit group and premium structure.']
  last_premium_payment_date date [note: 'Date of the most recent premium payment received for this enrollment. Used for grace period and termination calculations.']
  medicaid_number varchar [note: 'State-assigned Medicaid identifier for dual-eligible members. Used for coordination of benefits and claim adjudication.']
  medicare_part_a_effective_date date [note: 'Effective date of Medicare Part A coverage for dual-eligible members. Used for coordination of benefits.']
  medicare_part_b_effective_date date [note: 'Effective date of Medicare Part B coverage for dual-eligible members. Used for coordination of benefits.']
  pcp_assignment_date date [note: 'Date when the primary care physician was assigned to this member. Used for continuity of care tracking.']
  premium_amount decimal(15,2) [note: 'Monthly premium amount for this member enrollment. May be employer-paid, member-paid, or split.']
  premium_payment_frequency varchar [note: 'Frequency at which premium payments are due for this enrollment.']
  premium_payment_status varchar [note: 'Current status of premium payments for this enrollment. Affects coverage eligibility and claim payment.']
  record_number varchar [note: 'Foreign key linking to consent.consent_record. Business justification: Enrollment systems must verify required consents (treatment, HIPAA authorization, plan-specific) are on file before coverage activation. Critical for regulatory compliance and service delivery authori']
  relationship_to_subscriber varchar [note: 'Relationship of the member to the primary subscriber. Determines dependent status and coverage eligibility rules.']
  subsidy_amount decimal(15,2) [note: 'Monthly premium subsidy or tax credit amount applied to this enrollment. Applicable for ACA marketplace plans.']
  subsidy_type varchar [note: 'Type of premium subsidy or cost-sharing reduction applied to this enrollment. APTC = Advanced Premium Tax Credit, CSR = Cost-Sharing Reduction.']
  termination_reason varchar [note: 'Reason for enrollment termination. [ENUM-REF-CANDIDATE: voluntary_disenrollment|employment_termination|loss_of_eligibility|non_payment|death|medicare_eligibility|medicaid_eligibility|plan_discontinuation|other — promote to reference product]']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Transactional record of a member\'s enrollment into a specific health plan, capturing the full enrollment lifecycle from initial enrollment through termination. Captures member ID (subscriber ID), payer ID, health plan ID, group number, subscriber vs dependent relationship, enrollment type (open enrollment, special enrollment period, auto-enrollment, COBRA), enrollment effective date, termination date, termination reason, premium amount, premium payment status, benefit period, and enrollment source (employer group, exchange, Medicaid agency, Medicare CMS). SSOT for member plan enrollment referenced by eligibility verification and claim adjudication.'
}

Table insurance.subscriber {
  subscriber_id varchar [pk, note: 'Unique identifier for the subscriber record. Primary key. The subscriber is the primary insured individual (policyholder) who holds the insurance contract with the payer and is responsible for premium payment.']
  employer_group_id varchar [note: 'Reference to the employer group sponsoring this coverage, if applicable. Null for individual/non-group plans.']
  health_plan_id varchar [note: 'Reference to the specific health plan product under which this subscriber is enrolled. Links to the plan master in the insurance domain.']
  payer_id varchar [note: 'Reference to the insurance payer (health plan) that issued this subscriber contract. Links to the payer master in the insurance domain.']
  prior_subscriber_id varchar [note: 'Self-referencing FK on subscriber (prior_subscriber_id)']
  address_line_1 varchar [note: 'Primary street address line for the subscriber\'s residence.']
  address_line_2 varchar [note: 'Secondary address line (apartment, suite, unit number) for the subscriber\'s residence.']
  city varchar [note: 'City of the subscriber\'s residence.']
  cobra_eligible_flag boolean [note: 'Indicates whether the subscriber is eligible for COBRA continuation coverage after employment termination. True=eligible, False=not eligible.']
  cobra_end_date date [note: 'Date when COBRA continuation coverage ends, if applicable. Null if not on COBRA or coverage is ongoing.']
  cobra_start_date date [note: 'Date when COBRA continuation coverage began, if applicable. Null if not on COBRA.']
  country_code varchar [note: 'Three-letter ISO country code of the subscriber\'s residence. Typically USA for US-based subscribers.']
  coverage_status varchar [note: 'Current lifecycle status of the subscriber\'s coverage. Active=currently covered, Inactive=coverage lapsed, Suspended=temporarily paused, Terminated=permanently ended, Pending=awaiting activation.']
  coverage_type varchar [note: 'Type of insurance coverage provided under this subscriber contract. Indicates the primary benefit category.']
  created_timestamp timestamp [note: 'Timestamp when this subscriber record was first created in the data platform.']
  date_of_birth date [note: 'Date of birth of the subscriber. Used for eligibility verification and age-based benefit determination.']
  dual_eligible_flag boolean [note: 'Indicates whether the subscriber is dually eligible for both Medicare and Medicaid. True=dual eligible, False=not dual eligible. Critical for coordination of benefits and cost-sharing determination.']
  effective_end_date date [note: 'Date when the subscriber\'s coverage terminates. Null for open-ended active coverage.']
  effective_start_date date [note: 'Date when the subscriber\'s coverage becomes effective and benefits are available.']
  email_address varchar [note: 'Email address for subscriber communication and electronic correspondence.']
  first_name varchar [note: 'Legal first name of the subscriber as registered with the payer.']
  gender varchar [note: 'Administrative gender of the subscriber. M=Male, F=Female, U=Unknown, O=Other.']
  group_number varchar [note: 'Employer or sponsor group number under which the subscriber is enrolled. Used for group billing and benefit determination.']
  last_name varchar [note: 'Legal last name (family name) of the subscriber as registered with the payer.']
  medicaid_eligible_flag boolean [note: 'Indicates whether the subscriber is eligible for Medicaid coverage. True=eligible, False=not eligible. Used for coordination of benefits and dual eligibility determination.']
  medicaid_number varchar [note: 'State-issued Medicaid identification number, if the subscriber is Medicaid-eligible. Used for coordination of benefits.']
  medicare_eligible_flag boolean [note: 'Indicates whether the subscriber is eligible for Medicare coverage. True=eligible, False=not eligible. Used for coordination of benefits.']
  medicare_number varchar [note: 'Medicare Beneficiary Identifier (MBI) assigned by CMS, if the subscriber is Medicare-eligible. Used for coordination of benefits between Medicare and commercial insurance.']
  middle_name varchar [note: 'Middle name or initial of the subscriber, if provided.']
  network_tier varchar [note: 'Network tier or level assigned to the subscriber\'s plan. Determines cost-sharing and provider access levels.']
  phone_number varchar [note: 'Primary contact phone number for the subscriber.']
  postal_code varchar [note: 'ZIP code or postal code of the subscriber\'s residence.']
  premium_amount decimal(15,2) [note: 'Monthly or periodic premium amount the subscriber is responsible for paying. Amount in USD.']
  premium_frequency varchar [note: 'Frequency at which the subscriber pays premiums.']
  primary_care_physician_npi varchar [note: 'National Provider Identifier (NPI) of the subscriber\'s designated primary care physician, if applicable. Used in managed care plans requiring PCP assignment.']
  relationship_to_insured varchar [note: 'Relationship of the subscriber to the primary insured. For subscriber records, this is typically \'self\' since the subscriber IS the insured party. Used when subscriber may be a dependent on another policy.']
  source_system_code varchar [note: 'Unique identifier for this subscriber in the source system. Used for data lineage and reconciliation.']
  ssn varchar [note: 'Social Security Number of the subscriber. Stored in masked or encrypted format per HIPAA security requirements. Used for identity verification and coordination of benefits.']
  state varchar [note: 'State or province of the subscriber\'s residence. Two-letter state code for US addresses.']
  suffix varchar [note: 'Name suffix of the subscriber (Jr, Sr, II, III, etc.), if applicable.']
  termination_reason varchar [note: 'Reason for coverage termination, if applicable. Null for active coverage.']
  updated_timestamp timestamp [note: 'Timestamp when this subscriber record was last updated in the data platform.']
  vibe_mutation_marker varchar

  Note: 'Master record for the primary insured individual (subscriber/policyholder) who holds the insurance contract with the payer. Distinct from the patient master (patient.mpi_record) — the subscriber is the contractual party responsible for premium payment and may or may not be a patient. Captures subscriber ID (member ID), payer-assigned subscriber number, subscriber name, date of birth, gender, SSN (masked), employer group, group number, relationship to dependents, premium responsibility, COBRA eligibility status, and Medicare/Medicaid dual eligibility flags. SSOT for the insurance contractual relationship owner.'
}

Table insurance.dependent {
  dependent_id varchar [pk, note: 'Unique identifier for the dependent record. Primary key.']
  clinician_id varchar [note: 'Reference to the primary care physician assigned to this dependent for managed care plans.']
  dependent_member_mpi_record_id varchar [note: 'Unique member identifier assigned by the health plan to this dependent for eligibility verification and claims processing.']
  dependent_mpi_record_id varchar [note: 'Foreign key linking to patient.mpi_record. Business justification: Dependents are patients with MPI records. Business process: dependent enrollment creates patient identity; clinical care delivery, scheduling, and medical records require linking insurance dependent t']
  primary_dependent_id varchar [note: 'Self-referencing FK on dependent (primary_dependent_id)']
  subscriber_id varchar [note: 'Reference to the primary subscriber under whose health plan this dependent is covered.']
  address_line_1 varchar [note: 'Primary street address line for the dependent.']
  address_line_2 varchar [note: 'Secondary address line for apartment, suite, or unit number.']
  city varchar [note: 'City of residence for the dependent.']
  coordination_of_benefits_indicator boolean [note: 'Indicates whether the dependent has other health insurance coverage requiring coordination of benefits.']
  country_code varchar [note: 'Three-letter ISO country code for the dependents residence.']
  coverage_effective_date date [note: 'Date when the dependents coverage under the subscribers health plan becomes effective.']
  coverage_termination_date date [note: 'Date when the dependents coverage under the subscribers health plan terminates. Null if coverage is currently active.']
  created_timestamp timestamp [note: 'Timestamp when the dependent record was first created in the system.']
  date_of_birth date [note: 'Date of birth of the dependent, used for age-based eligibility determination and coverage rules.']
  disability_status varchar [note: 'Indicates whether the dependent has a qualifying disability that extends eligibility beyond standard age or relationship limits.']
  disability_verification_date date [note: 'Date when the dependents disability status was last verified for extended eligibility purposes.']
  eligibility_status varchar [note: 'Current eligibility status of the dependent for coverage under the subscribers health plan.']
  email_address varchar [note: 'Email address for the dependent for communication and notifications.']
  enrollment_date date [note: 'Date when the dependent was enrolled in the health plan.']
  enrollment_source varchar [note: 'Source through which the dependent was enrolled in the health plan (e.g., employer, exchange, direct, Medicaid, Medicare, CHIP). [ENUM-REF-CANDIDATE: Employer|Exchange|Direct|Medicaid|Medicare|CHIP|Other — 7 candidates stripped; promote to reference product]']
  first_name varchar [note: 'Legal first name of the dependent as registered with the health plan.']
  gender varchar [note: 'Gender of the dependent as recorded for coverage and clinical purposes.']
  last_eligibility_verification_date date [note: 'Date when the dependents eligibility was last verified by the health plan.']
  last_name varchar [note: 'Legal last name (surname) of the dependent as registered with the health plan.']
  middle_name varchar [note: 'Middle name or initial of the dependent.']
  phone_number varchar [note: 'Primary contact phone number for the dependent.']
  postal_code varchar [note: 'ZIP code for the dependents residence.']
  relationship_type varchar [note: 'Type of relationship between the dependent and the subscriber (e.g., spouse, child, domestic partner, disabled dependent).']
  ssn varchar [note: 'Social Security Number of the dependent for tax reporting and identity verification purposes.']
  state varchar [note: 'Two-letter state code for the dependents residence.']
  student_status varchar [note: 'Indicates whether the dependent is a full-time or part-time student, which may extend eligibility beyond standard age limits (e.g., up to age 26).']
  student_verification_date date [note: 'Date when the dependents student status was last verified for eligibility extension purposes.']
  suffix varchar [note: 'Name suffix for the dependent (e.g., Jr, Sr, II, III).']
  termination_reason varchar [note: 'Reason for termination of the dependents coverage (e.g., aging off at 26, divorce, loss of eligibility, death).']
  tobacco_use_indicator boolean [note: 'Indicates whether the dependent uses tobacco products, which may affect premium calculations.']
  updated_timestamp timestamp [note: 'Timestamp when the dependent record was last updated in the system.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record for individuals covered under a subscriber\'s health plan as dependents, including spouses, domestic partners, and children. Captures dependent ID, subscriber ID, dependent name, date of birth, gender, relationship type (spouse, child, domestic partner, disabled dependent), dependent eligibility status, coverage effective date, termination date, termination reason (aging off at 26, divorce, loss of eligibility), and student status for age-extension eligibility. Enables accurate member-level eligibility verification and COB determination for dependents.'
}

Table insurance.employer_group {
  employer_group_id varchar [pk, note: 'Unique identifier for the employer group. Primary key for this entity. This is the system-generated surrogate key that uniquely identifies each employer group record in the master data management system.']
  broker_id varchar [note: 'Identifier for the insurance broker or agent who sold and services this employer group. Brokers receive commissions and provide ongoing account management. Null if the group was sold direct.']
  health_plan_id varchar [note: 'Identifier for the standard benefit plan design (coverage levels, deductibles, copays, coinsurance) that applies to this employer group. Links to the benefit plan master entity. Groups may have multiple plans for different employee classes.']
  parent_employer_group_id varchar [note: 'Self-referencing FK on employer_group (parent_employer_group_id)']
  payer_id varchar [note: 'Identifier for the health insurance payer (carrier) that underwrites or administers this employer group. Links to the payer master entity.']
  provider_network_id varchar [note: 'Identifier for the provider network assigned to this employer group. Determines which providers are in-network for members of this group. Links to the network master entity.']
  third_party_administrator_id varchar [note: 'Identifier for the Third Party Administrator that handles claims processing, member services, and administrative functions for this self-funded employer group. Null if the payer administers the plan directly or if the group is fully insured.']
  aca_applicable_large_employer_indicator boolean [note: 'Boolean flag indicating whether this employer group meets the ACA definition of an Applicable Large Employer (50 or more full-time equivalent employees). ALEs are subject to the employer shared responsibility mandate and must offer affordable minimum essential coverage or face penalties.']
  address_line_1 varchar [note: 'The first line of the employer group\'s primary business address. Typically includes street number and street name. Used for premium billing, regulatory correspondence, and legal notices.']
  address_line_2 varchar [note: 'The second line of the employer group\'s primary business address. Typically includes suite, floor, or building number. Optional field.']
  billing_frequency varchar [note: 'The frequency at which premium invoices are generated and sent to the employer group. Most groups are billed monthly, but some large groups may have quarterly or annual billing cycles.']
  city varchar [note: 'The city of the employer group\'s primary business address. Used for geographic rating, network assignment, and regulatory jurisdiction determination.']
  cobra_administrator varchar [note: 'The entity responsible for administering COBRA continuation coverage for terminated employees and qualifying dependents. Payer: health plan administers. Employer: employer self-administers. TPA: third party administrator handles. External vendor: specialized COBRA vendor.']
  contact_email varchar [note: 'The email address of the primary employer contact for benefits administration. Used for enrollment files, billing statements, and plan communications.']
  contact_name varchar [note: 'The name of the primary contact person at the employer organization for benefits administration, enrollment, and billing matters. Typically the HR director or benefits manager.']
  contact_phone varchar [note: 'The phone number of the primary employer contact for benefits administration. Used for urgent enrollment issues, billing inquiries, and plan support.']
  country_code varchar [note: 'The three-letter ISO country code of the employer group\'s primary business address. Typically USA for domestic groups. Used for international employer groups and regulatory jurisdiction.']
  created_timestamp timestamp [note: 'The date and time when this employer group record was first created in the system. Used for audit trail and data lineage tracking. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  effective_date date [note: 'The date on which the employer group\'s health insurance coverage becomes active and members are eligible for benefits. This is the contract start date.']
  employee_count varchar [note: 'The number of eligible employees (subscribers) in the employer group, excluding dependents. Used for group size classification, premium calculations, and regulatory reporting.']
  employer_contribution_percentage decimal(5,2) [note: 'The percentage of the employee-only premium that the employer pays. The employee pays the remainder. Typical employer contributions range from 50% to 100%. Used for ACA affordability calculations and premium billing.']
  employer_ein varchar [note: 'The federal Employer Identification Number (EIN) assigned by the IRS, also known as the Federal Tax Identification Number. This nine-digit number uniquely identifies the employer for tax reporting and regulatory purposes. Format: XX-XXXXXXX.']
  erisa_plan_indicator boolean [note: 'Boolean flag indicating whether this employer group\'s health plan is subject to ERISA federal regulations. True for most private employer plans. False for government and church plans which are ERISA-exempt.']
  funding_type varchar [note: 'The financial arrangement model for how the employer group funds its health benefits. Fully insured: payer assumes all risk. Self-funded: employer assumes claims risk. Level-funded: hybrid with predictable monthly payments. Minimum premium: employer funds expected claims, payer covers excess. Stop-loss only: employer self-funds with catastrophic reinsurance.']
  grace_period_days varchar [note: 'The number of days after the premium due date during which the employer group can make payment without coverage lapsing. Typically 30 days for group coverage. During the grace period, coverage remains active but claims may be pended.']
  group_name varchar [note: 'The legal or doing-business-as name of the employer organization that sponsors the health insurance coverage for its employees. This is the primary human-readable identifier for the group.']
  group_number varchar [note: 'The externally-known unique business identifier assigned to the employer group by the payer. This is the group number printed on member ID cards and used in all billing and claims transactions. Also known as the policy group number or contract group number.']
  group_size varchar [note: 'The total number of enrolled lives (employees and dependents) covered under this employer group. This count determines small group vs. large group classification for regulatory purposes and impacts premium rating methodologies.']
  group_status varchar [note: 'The current lifecycle status of the employer group contract. Active: coverage in force. Pending: application submitted, not yet effective. Suspended: temporarily inactive, may be reinstated. Terminated: contract ended by mutual agreement. Cancelled: contract ended by payer. Lapsed: contract ended due to non-payment.']
  hsa_eligible_indicator boolean [note: 'Boolean flag indicating whether this employer group\'s benefit plan is HSA-qualified (high deductible health plan meeting IRS requirements). If true, employees can contribute pre-tax dollars to a Health Savings Account.']
  industry_risk_class varchar [note: 'The risk classification based on the employer\'s industry and occupation mix. Used in underwriting and premium rating. Low: office/professional. Moderate: light manufacturing/retail. High: construction/transportation. Hazardous: mining/heavy industrial.']
  minimum_participation_percentage decimal(5,2) [note: 'The minimum percentage of eligible employees that must enroll in the health plan for the group to qualify for coverage. Typically 75% for small groups. Used during initial underwriting and at renewal to prevent adverse selection.']
  naics_code varchar [note: 'The six-digit NAICS code that classifies the employer\'s industry sector. NAICS has largely replaced SIC for statistical and regulatory purposes. Used for industry analysis, risk stratification, and regulatory reporting.']
  payment_method varchar [note: 'The method by which the employer group remits premium payments to the payer. ACH and wire transfer are most common for large groups. Check and credit card may be used by small groups.']
  plan_sponsor_type varchar [note: 'The category of organization that sponsors the health plan. Private employer: for-profit or non-profit business. Union trust: labor union-sponsored plan. Government employer: federal, state, or local government entity. Association: group of small employers. Taft-Hartley: jointly trusteed union-management plan. MEWA: Multiple Employer Welfare Arrangement.']
  postal_code varchar [note: 'The ZIP code or ZIP+4 code of the employer group\'s primary business address. Used for geographic rating, network assignment, and premium calculations. Format: XXXXX or XXXXX-XXXX.']
  rate_guarantee_months varchar [note: 'The number of months for which the premium rates are guaranteed not to increase. Typically 12 months (annual rate guarantee) for most groups. Some large groups may negotiate multi-year rate guarantees.']
  renewal_date date [note: 'The annual date on which the employer group\'s contract renews. Typically the anniversary of the original effective date. Used for renewal underwriting, rate adjustments, and plan design changes.']
  sic_code varchar [note: 'The four-digit Standard Industrial Classification code that categorizes the employer\'s primary line of business or industry. Used for risk assessment, underwriting, and industry benchmarking.']
  situs_state_code varchar [note: 'The state code that determines which state insurance regulations apply to this employer group. For fully insured plans, this is typically the state where the policy is issued. For self-funded ERISA plans, this may differ from the employer\'s physical location. Format: two uppercase letters.']
  state_code varchar [note: 'The two-letter state abbreviation of the employer group\'s primary business address. Determines state insurance regulations, mandated benefits, and tax jurisdiction. Format: two uppercase letters (e.g., CA, NY, TX).']
  termination_date date [note: 'The date on which the employer group\'s coverage ends. Null if the group is currently active. Once set, no new claims with service dates after this date will be paid under this group.']
  underwriting_tier varchar [note: 'The risk classification assigned to this employer group during underwriting. Standard: average risk. Preferred: lower than average risk, may receive rate discounts. Substandard: higher than average risk, may have rate loadings or exclusions. Declined: group was not accepted for coverage.']
  updated_timestamp timestamp [note: 'The date and time when this employer group record was last modified. Updated whenever any attribute changes. Used for change tracking and data synchronization. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar
  wellness_program_indicator boolean [note: 'Boolean flag indicating whether this employer group has an active wellness or health promotion program integrated with their health plan. Wellness programs may include biometric screenings, health risk assessments, smoking cessation, weight management, and premium incentives.']

  Note: 'Master record for employer groups and group sponsors that purchase health insurance coverage for their employees through a payer. Captures group name, group number, employer EIN (Tax ID), SIC/NAICS industry code, group size (number of enrolled lives), funding type (fully insured, self-funded, level-funded), plan sponsor type (private employer, union trust, government employer, association), broker/TPA relationship, renewal date, and group contract effective dates. Supports group-level benefit administration, premium billing, and employer reporting.'
}

Table insurance.payer_contract {
  payer_contract_id varchar [pk, note: 'Unique identifier for the payer contract record. Primary key for the payer contract entity.']
  group_id varchar [note: 'Foreign key linking to provider.provider_group. Business justification: Contracts executed with provider groups for network participation, VBC arrangements, and group-level reimbursement. Essential for contract management, payment reconciliation, and network operations. C']
  org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: Contracts executed with organizational providers for facility network participation and hospital reimbursement. Critical for facility contract management, claims pricing, and network adequacy. Creatin']
  payer_contact_id varchar [note: 'FK to insurance.payer_contact']
  primary_payer_id varchar [note: 'Reference to the insurance payer organization that is party to this contract.']
  renewed_payer_contract_id varchar [note: 'Self-referencing FK on payer_contract (renewed_payer_contract_id)']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Contracts specify covered specialties and carve-outs (e.g., behavioral health carved out, oncology specialty contract). Critical for network adequacy planning, specialty-specific rate negotiations, an']
  amendment_count varchar [note: 'Number of amendments or modifications made to this contract since its original execution.']
  auto_renewal_flag boolean [note: 'Indicates whether this contract automatically renews at the end of its term unless either party provides notice of termination.']
  base_reimbursement_percentage decimal(5,2) [note: 'The baseline percentage rate applied to charges or fee schedules for reimbursement calculation (e.g., 110% of Medicare rates). Null if reimbursement method is not percentage-based.']
  carve_out_services varchar [note: 'Description or list of services explicitly excluded from this contract and reimbursed under separate arrangements (e.g., behavioral health, pharmacy, transplant services).']
  claims_submission_method varchar [note: 'The method by which claims under this contract must be submitted to the payer for adjudication.']
  contract_administrator_email varchar [note: 'Email address of the internal contract administrator for operational communication regarding this contract.']
  contract_administrator_name varchar [note: 'Name of the internal staff member or department responsible for managing and administering this payer contract.']
  contract_document_location varchar [note: 'File path, URL, or document management system reference to the signed contract document for audit and reference purposes.']
  contract_name varchar [note: 'Human-readable name or title of the payer contract for identification and reporting purposes.']
  contract_number varchar [note: 'The externally-known unique business identifier for this payer contract, used in communications with the payer and internal revenue cycle operations.']
  contract_status varchar [note: 'Current lifecycle status of the payer contract. Draft indicates contract under negotiation; pending approval awaiting internal or payer sign-off; active means contract is in force; suspended indicates temporary hold; terminated means contract ended before expiration; expired means contract reached its end date.']
  contract_type varchar [note: 'Classification of the reimbursement model governing this contract. Fee-for-service pays per service rendered; capitation pays a fixed amount per member per month; bundled payment covers an episode of care; shared savings rewards cost reduction; pay-for-performance (P4P) ties payment to quality metrics; value-based combines quality and cost outcomes.']
  created_timestamp timestamp [note: 'Timestamp when this payer contract record was first created in the system.']
  credentialing_required boolean [note: 'Indicates whether individual providers must be credentialed and enrolled with the payer to bill under this contract.']
  effective_date date [note: 'The date on which this payer contract becomes binding and reimbursement terms take effect.']
  fee_schedule_reference varchar [note: 'Reference identifier to the base fee schedule or rate table that governs reimbursement rates for services under this contract (e.g., Medicare Fee Schedule, custom negotiated rates).']
  geographic_coverage varchar [note: 'Description of the geographic region or service area covered by this contract (e.g., statewide, multi-state, specific counties).']
  last_amendment_date date [note: 'Date of the most recent amendment or modification to this contract.']
  network_tier varchar [note: 'The tier or level of this provider within the payers network, affecting member cost-sharing and reimbursement rates. Tier 1 typically offers lowest member cost-sharing; out-of-network highest.']
  notes varchar [note: 'Free-text field for additional notes, special provisions, or operational guidance related to this payer contract.']
  payment_terms_days varchar [note: 'Number of days within which the payer is contractually obligated to remit payment after claim adjudication.']
  prior_authorization_required boolean [note: 'Indicates whether prior authorization is required for certain services under this contract before services are rendered.']
  quality_bonus_eligible boolean [note: 'Indicates whether this contract includes provisions for quality-based bonus payments tied to performance metrics such as Healthcare Effectiveness Data and Information Set (HEDIS) scores or Merit-based Incentive Payment System (MIPS) performance.']
  quality_measure_set varchar [note: 'Identifier or name of the quality measure set or program used to evaluate performance under this contract (e.g., HEDIS, MIPS, hospital-acquired infection rates).']
  quality_penalty_eligible boolean [note: 'Indicates whether this contract includes provisions for quality-based penalties or payment reductions for failure to meet performance thresholds.']
  reconciliation_frequency varchar [note: 'The frequency at which financial reconciliation and settlement occurs between provider and payer for shared savings, risk adjustments, or quality bonuses.']
  regulatory_filing_reference varchar [note: 'Reference number or identifier assigned by the regulatory body for this contracts filing or approval.']
  regulatory_filing_required boolean [note: 'Indicates whether this contract must be filed with state insurance departments or other regulatory bodies for approval or compliance purposes.']
  reimbursement_method varchar [note: 'The calculation method used to determine payment amounts. Percent of charges pays a percentage of billed charges; percent of Medicare pays a percentage of Medicare rates; flat rate is a fixed amount per service; per diem is a daily rate; case rate is a fixed amount per case; DRG-based uses Diagnosis-Related Group rates; capitation is a fixed per-member-per-month amount. [ENUM-REF-CANDIDATE: percent_of_charges|percent_of_medicare|flat_rate|per_diem|case_rate|drg_based|capitation — 7 candidates stripped; promote to reference product]']
  renewal_notice_days varchar [note: 'Number of days advance notice required to terminate or renegotiate the contract before auto-renewal occurs.']
  risk_arrangement_type varchar [note: 'Defines the financial risk-sharing model between provider and payer. No risk means traditional fee-for-service; upside only allows provider to share in savings; downside only exposes provider to penalties; two-sided risk includes both savings and penalties; full risk transfers all financial risk to provider.']
  state_code varchar [note: 'Two-letter state code indicating the primary state jurisdiction for this contract.']
  stop_loss_threshold_amount decimal(15,2) [note: 'The dollar amount threshold above which stop-loss or reinsurance provisions apply, protecting the provider or payer from catastrophic claims costs. Null if no stop-loss provision exists.']
  termination_date date [note: 'The date on which this payer contract ends or is scheduled to end. Null for open-ended contracts or contracts with auto-renewal.']
  timely_filing_limit_days varchar [note: 'Number of days from date of service within which claims must be submitted to the payer to be considered timely filed and eligible for reimbursement.']
  updated_by varchar [note: 'User identifier or name of the person who last updated this payer contract record.']
  updated_timestamp timestamp [note: 'Timestamp when this payer contract record was last modified in the system.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record for negotiated contracts between the healthcare organization (provider) and insurance payers, defining reimbursement terms, fee schedules, value-based care arrangements, and contractual obligations. Captures contract number, payer ID, contract type (fee-for-service, capitation, bundled payment, shared savings, P4P — Pay for Performance), contract effective date, termination date, auto-renewal terms, base fee schedule reference, carve-out provisions, quality bonus/penalty terms, risk arrangement type, and contract status. SSOT for provider-payer contractual relationships governing reimbursement.'
}

Table insurance.fee_schedule {
  fee_schedule_id varchar [pk, note: 'Unique identifier for the fee schedule record. Primary key.']
  payer_contract_id varchar [note: 'Reference to the provider-payer contract under which this fee schedule is defined. Links to the contract master entity.']
  payer_id varchar [note: 'Reference to the insurance payer or health plan that owns this fee schedule. Links to the payer master entity.']
  primary_predecessor_schedule_fee_schedule_id varchar [note: 'Reference to the previous version of this fee schedule, enabling version history tracking and audit trails.']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Fee schedules vary by specialty for differential reimbursement (primary care vs subspecialty rates, surgical vs medical specialties). Essential for specialty-specific contract rates and claims pricing']
  taxonomy_id varchar [note: 'Foreign key linking to provider.provider_taxonomy. Business justification: Fee schedules reference taxonomy codes for provider type-specific rates (e.g., different rates for MD vs NP, different facility rates by type). Critical for accurate claims pricing and contract compli']
  annual_inflation_rate decimal(5,2) [note: 'The annual percentage rate applied for inflation adjustments, if applicable. Expressed as a decimal (e.g., 3.50 for 3.5%).']
  approval_date date [note: 'The date on which this fee schedule was formally approved for implementation.']
  approved_by varchar [note: 'Name or identifier of the individual or authority who approved this fee schedule for use.']
  authorization_required boolean [note: 'Indicates whether services under this fee schedule require prior authorization before rendering care.']
  billed_charges_percentage decimal(5,2) [note: 'The percentage of billed charges used as the basis for reimbursement when rate_basis is percent_of_billed_charges. Expressed as a decimal (e.g., 80.00 for 80% of billed charges).']
  carve_out_services varchar [note: 'Description of services explicitly excluded or carved out from this fee schedule, to be reimbursed under separate arrangements.']
  claims_submission_method varchar [note: 'The required method for submitting claims under this fee schedule: electronic (EDI), paper, web portal, or clearinghouse.']
  created_timestamp timestamp [note: 'The date and time when this fee schedule record was first created in the system.']
  effective_date date [note: 'The date on which this fee schedule becomes active and applicable for reimbursement calculations.']
  facility_type varchar [note: 'The type of healthcare facility to which this fee schedule applies: inpatient, outpatient, ambulatory surgery center (ASC), skilled nursing facility (SNF), home health, or hospice.']
  fee_schedule_status varchar [note: 'Current lifecycle status of the fee schedule: draft (under development), active (in use), suspended (temporarily inactive), terminated (ended by agreement), expired (past termination date), or pending approval (awaiting authorization).']
  filing_reference_number varchar [note: 'The reference number assigned by the regulatory authority when this fee schedule was filed for approval.']
  geographic_adjustment_factor decimal(6,4) [note: 'Geographic adjustment factor applied to base rates to account for regional cost variations. Based on CMS Geographic Practice Cost Index (GPCI) methodology.']
  geographic_scope varchar [note: 'The geographic applicability of the fee schedule: national, regional, state-level, county-level, zip code-level, or facility-specific.']
  inflation_adjustment_method varchar [note: 'The method used for annual inflation adjustments to fee schedule rates: Consumer Price Index (CPI), Medical CPI, fixed percentage, none, or custom methodology.']
  interest_penalty_rate decimal(5,2) [note: 'The annual interest rate applied to late payments as a penalty for exceeding payment terms. Expressed as a decimal (e.g., 10.00 for 10%).']
  locality_code varchar [note: 'CMS locality code used for Medicare geographic adjustment purposes, defining the specific payment locality.']
  medicare_percentage decimal(5,2) [note: 'The percentage of Medicare allowable rates used as the basis for reimbursement when rate_basis is percent_of_medicare. Expressed as a decimal (e.g., 110.00 for 110% of Medicare).']
  network_tier varchar [note: 'The provider network tier to which this fee schedule applies: tier 1 (highest reimbursement), tier 2, tier 3, preferred, standard, or out-of-network.']
  notes varchar [note: 'Free-text field for additional comments, special instructions, or contextual information about the fee schedule.']
  outlier_payment_threshold decimal(15,2) [note: 'The cost threshold above which outlier payments are triggered for exceptionally high-cost cases, typically in DRG-based reimbursement.']
  payment_terms_days varchar [note: 'The number of days within which the payer is contractually obligated to remit payment after receiving a clean claim.']
  quality_adjustment_percentage decimal(5,2) [note: 'The maximum percentage adjustment (positive or negative) that can be applied to base rates based on quality performance metrics.']
  quality_incentive_eligible boolean [note: 'Indicates whether this fee schedule is eligible for quality-based incentive payments under value-based purchasing or pay-for-performance programs.']
  rate_basis varchar [note: 'The methodology used to determine reimbursement rates: percentage of Medicare rates, percentage of billed charges, case rate, per diem, fee-for-service, or capitation.']
  regulatory_filing_required boolean [note: 'Indicates whether this fee schedule must be filed with state insurance regulators or other governing bodies for approval.']
  reimbursement_model varchar [note: 'The payment model under which this fee schedule operates: fee-for-service, bundled payment, value-based, shared savings, capitation, or per diem.']
  schedule_code varchar [note: 'Unique alphanumeric code assigned to the fee schedule for system identification and cross-referencing.']
  schedule_name varchar [note: 'Business-friendly name or title of the fee schedule, used for identification and reporting purposes.']
  schedule_type varchar [note: 'Classification of the fee schedule by service category: professional services, facility services, durable medical equipment (DME), laboratory, pharmacy, or radiology.']
  service_category varchar [note: 'Broad classification of services covered by this fee schedule (e.g., surgical, medical, diagnostic, preventive, behavioral health).']
  state_code varchar [note: 'Two-letter state code indicating the primary state jurisdiction for this fee schedule, if applicable.']
  stop_loss_threshold decimal(15,2) [note: 'The dollar amount threshold above which stop-loss provisions apply, limiting payer liability for high-cost cases.']
  termination_date date [note: 'The date on which this fee schedule expires or is terminated. Null indicates an open-ended schedule.']
  timely_filing_limit_days varchar [note: 'The number of days from the date of service within which claims must be submitted to be considered timely filed.']
  updated_by varchar [note: 'Identifier of the user or system process that last updated this fee schedule record.']
  updated_timestamp timestamp [note: 'The date and time when this fee schedule record was last modified.']
  version_number varchar [note: 'Version identifier for the fee schedule, used to track revisions and amendments over time.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record for payer-specific reimbursement fee schedules defining the contracted payment rates for procedures, services, and supplies. Captures fee schedule name, payer ID, contract ID, fee schedule type (professional, facility, DME, lab, pharmacy), effective date, termination date, geographic adjustment factor (GPCI), and the basis for rates (% of Medicare, % of billed charges, case rate, per diem). Parent entity for fee schedule line items. Supports contract modeling, underpayment detection, and revenue cycle optimization.'
}

Table insurance.fee_schedule_line {
  fee_schedule_line_id varchar [pk, note: 'Unique identifier for the fee schedule line item record. Primary key for this entity.']
  drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: Fee schedules include DRG-based case rates for inpatient hospital reimbursement. Essential for hospital claims pricing, bundled payment calculation, and value-based contract administration in payer sy']
  fee_schedule_id varchar [note: 'Reference to the parent fee schedule contract that contains this line item. Links this rate to the overall fee schedule agreement.']
  hcpcs_code_id varchar [note: 'Foreign key linking to reference.hcpcs_code. Business justification: Fee schedules include HCPCS rates for DME, supplies, and ancillary services. Essential for claims auto-pricing, provider reimbursement calculation, and contract rate validation in payer financial syst']
  primary_superseded_by_fee_schedule_line_id varchar [note: 'Reference to the fee_schedule_line_id that replaces this line when status is superseded. Enables tracking of rate history and lineage.']
  anesthesia_base_units decimal(6,2) [note: 'For anesthesia services, the base unit value assigned to the procedure used in calculating anesthesia reimbursement (base units + time units + modifying units) × conversion factor.']
  assistant_surgeon_allowed boolean [note: 'Indicates whether an assistant surgeon is allowed for this procedure and will be separately reimbursed according to the fee schedule.']
  authorization_required boolean [note: 'Indicates whether prior authorization is required from the payer before performing this service at the contracted rate. True means authorization is mandatory.']
  bilateral_indicator varchar [note: 'Indicates whether the procedure can be performed bilaterally (on both sides of the body) and how it affects reimbursement.']
  bundled_indicator boolean [note: 'Indicates whether this procedure code is part of a bundled payment arrangement where multiple services are reimbursed as a single package. True means this is bundled.']
  case_rate_amount decimal(12,2) [note: 'When rate_basis is case_rate, this field contains the bundled payment amount for an entire episode of care or procedure (e.g., DRG-based payment, bundled surgical package).']
  contract_reference_number varchar [note: 'External reference number or identifier linking this fee schedule line to the source contract document or agreement section.']
  contracted_rate_amount decimal(12,2) [note: 'The negotiated reimbursement amount for this specific procedure code and modifier combination. Represents the dollar amount the payer will reimburse for the service.']
  conversion_factor decimal(10,4) [note: 'The dollar multiplier applied to total RVUs to calculate the contracted rate amount. For example, if total RVU is 2.5 and conversion factor is $40.00, the rate is $100.00.']
  created_timestamp timestamp [note: 'Timestamp when this fee schedule line record was first created in the system. Part of audit trail.']
  effective_date date [note: 'The date on which this fee schedule line item becomes active and applicable for reimbursement calculations. Part of the temporal validity period.']
  facility_type varchar [note: 'Classification of the facility setting where the service is rendered, affecting reimbursement methodology and rates. [ENUM-REF-CANDIDATE: inpatient|outpatient|ambulatory_surgery|emergency|skilled_nursing|home_health|hospice — 7 candidates stripped; promote to reference product]']
  fee_schedule_line_status varchar [note: 'Current lifecycle status of the fee schedule line item: active (in use), inactive (not in use), pending (approved but not yet effective), superseded (replaced by newer version), expired (past termination date), or suspended (temporarily disabled).']
  geographic_modifier varchar [note: 'Two-digit code representing the geographic locality for Medicare GPCI adjustments. Used to adjust RVU-based payments for regional cost variations.']
  global_period_days varchar [note: 'Number of days in the global surgical period during which follow-up care is included in the procedure payment and not separately reimbursable. Common values are 0, 10, or 90 days.']
  line_number varchar [note: 'Sequential line number within the parent fee schedule, used for ordering and reference purposes.']
  maximum_reimbursement decimal(12,2) [note: 'The ceiling amount for reimbursement regardless of calculation method. Caps the payment level for the service.']
  minimum_reimbursement decimal(12,2) [note: 'The floor amount for reimbursement regardless of calculation method. Ensures a minimum payment level for the service.']
  modifier_1 varchar [note: 'Primary two-character CPT or HCPCS modifier that provides additional information about the service performed, affecting reimbursement calculation.']
  modifier_2 varchar [note: 'Secondary two-character CPT or HCPCS modifier providing additional service context.']
  modifier_3 varchar [note: 'Tertiary two-character CPT or HCPCS modifier providing additional service context.']
  modifier_4 varchar [note: 'Quaternary two-character CPT or HCPCS modifier providing additional service context.']
  multiple_procedure_reduction decimal(5,2) [note: 'Percentage reduction applied when multiple procedures are performed in the same session (e.g., 50.00 means second procedure is reimbursed at 50% of the fee schedule rate).']
  notes varchar [note: 'Free-text field for additional information, special instructions, or clarifications about this fee schedule line item (e.g., carve-outs, special conditions, negotiation context).']
  per_diem_rate decimal(12,2) [note: 'When rate_basis is per_diem, this field contains the daily rate amount for inpatient or long-term care services.']
  percent_of_charges decimal(5,2) [note: 'When rate_basis is percent_of_charges, this field contains the percentage multiplier applied to the provider\'s billed charges (e.g., 65.00 means 65% of charges).']
  percent_of_medicare decimal(5,2) [note: 'When rate_basis is percent_of_medicare, this field contains the percentage multiplier applied to the Medicare allowable amount (e.g., 110.00 means 110% of Medicare rates).']
  place_of_service_code varchar [note: 'Two-digit code identifying the physical location where the service was rendered (e.g., 11=Office, 21=Inpatient Hospital, 22=Outpatient Hospital, 23=Emergency Department). Affects reimbursement rates.']
  procedure_code varchar [note: 'The Current Procedural Terminology (CPT) or Healthcare Common Procedure Coding System (HCPCS) code identifying the specific service, procedure, or supply item being priced. Five-character alphanumeric code.']
  procedure_code_type varchar [note: 'Classification of the procedure code system used: CPT (Current Procedural Terminology), HCPCS (Healthcare Common Procedure Coding System), CDT (Current Dental Terminology), or NDC (National Drug Code).']
  quality_reporting_required boolean [note: 'Indicates whether quality measure reporting is required for this service as part of value-based payment programs (e.g., MIPS, APM).']
  rate_basis varchar [note: 'The methodology used to calculate the contracted rate: flat_rate (fixed dollar amount), rvu_based (Relative Value Unit multiplied by conversion factor), percent_of_charges (percentage of billed charges), percent_of_medicare (percentage of Medicare allowable), per_diem (daily rate), case_rate (bundled payment), or stop_loss (threshold-based). [ENUM-REF-CANDIDATE: flat_rate|rvu_based|percent_of_charges|percent_of_medicare|per_diem|case_rate|stop_loss — 7 candidates stripped; promote to reference product]']
  rate_version varchar [note: 'Version number tracking changes to this specific fee schedule line over time. Increments with each rate update or modification.']
  revenue_code varchar [note: 'Four-digit revenue code used primarily for facility billing (UB-04 claims) to classify the type of service or accommodation provided. Used in conjunction with procedure codes for hospital outpatient and inpatient services.']
  rvu_malpractice decimal(8,2) [note: 'The malpractice component of the RVU representing professional liability insurance costs associated with the service.']
  rvu_practice_expense decimal(8,2) [note: 'The practice expense component of the RVU representing overhead costs (staff, supplies, equipment) associated with providing the service.']
  rvu_total decimal(8,2) [note: 'The total RVU value calculated as the sum of work, practice expense, and malpractice components. Used with conversion factor to determine reimbursement.']
  rvu_work decimal(8,2) [note: 'The work component of the Relative Value Unit (RVU) representing physician time, skill, and intensity required to perform the service. Used in RVU-based reimbursement calculations.']
  specialty_code varchar [note: 'Code identifying the provider specialty for which this rate applies (e.g., cardiology, orthopedics, primary care). Some contracts have specialty-specific rates.']
  stop_loss_threshold decimal(12,2) [note: 'When rate_basis is stop_loss, this field contains the dollar threshold above which different reimbursement rules apply (e.g., outlier payments for high-cost cases).']
  termination_date date [note: 'The date on which this fee schedule line item is no longer active for reimbursement. Null indicates the rate is currently active with no planned end date.']
  updated_by varchar [note: 'Identifier of the user or system process that last updated this record. Supports audit trail and accountability.']
  updated_timestamp timestamp [note: 'Timestamp when this fee schedule line record was last modified. Part of audit trail for tracking changes.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Individual line-item rate record within a fee schedule, defining the contracted reimbursement rate for a specific procedure code, service, or supply item. Captures fee schedule ID, procedure code (CPT/HCPCS), modifier applicability, revenue code (for facility), place of service, contracted rate amount, rate basis (flat rate, RVU-based, % of Medicare allowable), RVU value, conversion factor, effective date, and termination date. Enables line-level contract modeling, expected reimbursement calculation, and underpayment variance analysis.'
}

Table insurance.prior_auth_rule {
  prior_auth_rule_id varchar [pk, note: 'Unique identifier for the prior authorization rule record. Primary key.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Prior authorization rules must reference organizational clinical policies that define medical necessity criteria, coverage determination frameworks, and appeals processes. This linkage ensures PA rule']
  hcpcs_code_id varchar [note: 'Foreign key linking to reference.hcpcs_code. Business justification: PA rules govern HCPCS codes for DME, supplies, and specialty drugs. Critical for authorization workflow automation, step therapy enforcement, and utilization management in payer operations.']
  health_plan_id varchar [note: 'Reference to the specific health plan product under which this prior authorization rule applies.']
  payer_id varchar [note: 'Reference to the insurance payer organization that enforces this prior authorization requirement.']
  quality_measure_id varchar [note: 'Foreign key linking to quality.measure. Business justification: PA rules often reference quality measures (e.g., require PA for procedures not meeting HEDIS/NQF criteria). Payers align PA requirements with evidence-based quality measure specifications.']
  required_consent_form_template_id varchar [note: 'Foreign key linking to consent.consent_form_template. Business justification: PA rules specify which consent forms must be completed before authorization (e.g., experimental treatment consent, genetic testing consent). Policy enforcement mechanism linking authorization requirem']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Prior authorization rules are specialty-specific (e.g., cardiology procedures, oncology treatments, orthopedic surgery). Critical for PA determination engines and clinical criteria application. Creati']
  superseded_prior_auth_rule_id varchar [note: 'Self-referencing FK on prior_auth_rule (superseded_prior_auth_rule_id)']
  taxonomy_id varchar [note: 'Foreign key linking to provider.provider_taxonomy. Business justification: PA rules reference NUCC taxonomy codes to determine which provider types can perform services (e.g., only board-certified surgeons for certain procedures). Essential for PA auto-adjudication and provi']
  age_maximum varchar [note: 'Maximum patient age in years for which this prior authorization rule applies. Null if no age restriction.']
  age_minimum varchar [note: 'Minimum patient age in years for which this prior authorization rule applies. Null if no age restriction.']
  appeal_process_description varchar [note: 'Description of the process for appealing a prior authorization denial under this rule, including timelines and contact information.']
  auto_approval_criteria varchar [note: 'Description of the criteria that must be met for automated approval of the prior authorization request.']
  auto_approval_eligible boolean [note: 'Indicates whether this prior authorization rule supports automated approval based on predefined criteria without manual review.']
  clinical_criteria_reference varchar [note: 'Reference to the clinical guideline, medical policy, or evidence-based criteria document that defines the medical necessity standards for this prior authorization rule.']
  contact_fax varchar [note: 'Payer fax number for prior authorization document submission related to this rule.']
  contact_phone varchar [note: 'Payer contact phone number for prior authorization inquiries and submissions related to this rule.']
  created_timestamp timestamp [note: 'Date and time when this prior authorization rule record was first created in the system.']
  diagnosis_code varchar [note: 'International Classification of Diseases 10th Revision (ICD-10) diagnosis code that qualifies or triggers the prior authorization requirement. May be null if rule applies regardless of diagnosis.']
  documentation_required varchar [note: 'List or description of clinical documentation that must be submitted with the prior authorization request (e.g., chart notes, lab results, imaging reports).']
  effective_date date [note: 'Date on which this prior authorization rule becomes active and enforceable by the payer.']
  exception_criteria varchar [note: 'Description of circumstances under which exceptions to the prior authorization requirement may be granted (e.g., emergency situations, continuity of care).']
  frequency_limit varchar [note: 'Maximum number of times the service can be performed within the frequency period without prior authorization. Null if no frequency limit applies.']
  frequency_limit_period_days varchar [note: 'Time period in days over which the frequency limit is measured. Null if no period applies.']
  gender_restriction varchar [note: 'Gender-specific applicability of the prior authorization rule. Values: male, female, all (no restriction), or other.']
  medical_policy_number varchar [note: 'Payer-specific medical policy document number or identifier that governs this prior authorization rule.']
  notes varchar [note: 'Free-text field for additional comments, clarifications, or special instructions related to this prior authorization rule.']
  pa_requirement_type varchar [note: 'Classification of the prior authorization requirement level: required (mandatory PA), not required, clinical review (medical necessity review), peer-to-peer (physician discussion), notification only, or retrospective review.']
  place_of_service_code varchar [note: 'Two-digit CMS Place of Service code identifying the location where the service is rendered (e.g., 11=office, 21=inpatient hospital, 22=outpatient hospital).']
  portal_url varchar [note: 'Web address of the payer portal for electronic prior authorization submission, if applicable.']
  prior_auth_rule_status varchar [note: 'Current lifecycle status of the prior authorization rule: active (in effect), inactive (not enforced), pending (scheduled for activation), suspended (temporarily paused), or retired (permanently discontinued).']
  procedure_code varchar [note: 'Current Procedural Terminology (CPT) or Healthcare Common Procedure Coding System (HCPCS) code identifying the procedure, service, or supply subject to prior authorization.']
  procedure_code_type varchar [note: 'Classification of the procedure code system used (CPT, HCPCS, or ICD-10-PCS).']
  quantity_limit decimal(10,2) [note: 'Maximum quantity or units of service allowed without prior authorization under this rule. Null if no quantity limit applies.']
  quantity_limit_period_days varchar [note: 'Time period in days over which the quantity limit is measured (e.g., 30 days, 90 days). Null if no period applies.']
  regulatory_basis varchar [note: 'Citation of the regulatory or statutory authority that permits or requires this prior authorization rule (e.g., CMS National Coverage Determination, state insurance law).']
  rule_code varchar [note: 'Unique business identifier code for this prior authorization rule, used for external reference and reporting.']
  rule_name varchar [note: 'Human-readable descriptive name of the prior authorization rule for display and reporting purposes.']
  service_category varchar [note: 'Broad classification of the healthcare service type subject to prior authorization (e.g., inpatient, outpatient, surgical, pharmacy, durable medical equipment). [ENUM-REF-CANDIDATE: inpatient|outpatient|emergency|surgical|diagnostic|therapeutic|pharmacy|dme|home_health|behavioral_health — 10 candidates stripped; promote to reference product]']
  step_therapy_criteria varchar [note: 'Description of the step therapy requirements, including which alternative treatments must be tried first and failure criteria.']
  step_therapy_required boolean [note: 'Indicates whether step therapy (trial of alternative treatments before approval) is required as part of the prior authorization criteria.']
  submission_method varchar [note: 'Allowed method(s) for submitting the prior authorization request: payer portal, fax, phone, EDI 278 transaction, email, or postal mail.']
  termination_date date [note: 'Date on which this prior authorization rule is no longer active. Null indicates the rule is currently in effect with no planned end date.']
  turnaround_time_hours varchar [note: 'Standard turnaround time in hours for the payer to respond to a prior authorization request under this rule.']
  updated_by varchar [note: 'Identifier of the user or system process that last updated this prior authorization rule record.']
  updated_timestamp timestamp [note: 'Date and time when this prior authorization rule record was last modified.']
  urgent_turnaround_time_hours varchar [note: 'Expedited turnaround time in hours for urgent or emergent prior authorization requests under this rule.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record defining payer-specific prior authorization (PA) requirements for procedures, services, medications, and care settings. Captures payer ID, health plan ID, procedure code (CPT/HCPCS), diagnosis code applicability, service category, place of service, PA requirement type (required, not required, clinical review, peer-to-peer), clinical criteria reference, turnaround time standard (urgent vs standard), submission method (portal, fax, phone, EDI 278), effective date, and termination date. SSOT for PA requirement rules used by utilization management and order authorization workflows.'
}

Table insurance.utilization_review {
  utilization_review_id varchar [pk, note: 'Unique identifier for the utilization review record. Primary key.']
  appeal_id varchar [note: 'Identifier of the associated appeal record if an appeal was filed following the utilization review decision.']
  appealed_utilization_review_id varchar [note: 'Self-referencing FK on utilization_review (appealed_utilization_review_id)']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the service or admission occurred.']
  clinician_id varchar [note: 'Identifier of the physician or provider who rendered the service being reviewed.']
  employee_id varchar [note: 'Identifier of the clinical reviewer (nurse, physician advisor, or UM specialist) who conducted the utilization review.']
  encounter_authorization_id varchar [note: 'Identifier of the associated prior authorization request, if this review is linked to a pre-certification or authorization workflow.']
  mpi_record_id varchar [note: 'Identifier of the health plan member (patient) whose care is being reviewed.']
  payer_id varchar [note: 'Identifier of the insurance payer or health plan conducting or requesting the utilization review.']
  quality_measure_id varchar [note: 'Foreign key linking to quality.measure. Business justification: UR decisions reference clinical quality measures for medical necessity determination. Payers use quality measure criteria (e.g., HEDIS, NQF) to define appropriateness and approve/deny services.']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Utilization review applies specialty-specific clinical criteria (e.g., cardiology UR criteria, oncology treatment protocols). Essential for peer-to-peer matching, clinical appropriateness review, and ']
  visit_id varchar [note: 'Identifier of the clinical encounter (admission, visit, or service episode) subject to utilization review.']
  admission_date date [note: 'Date the patient was admitted to the facility, applicable for inpatient utilization reviews.']
  appeal_filed boolean [note: 'Indicates whether an appeal was filed by the member or provider in response to the utilization review decision.']
  appeal_rights_notified boolean [note: 'Indicates whether the member and provider were notified of their rights to appeal the utilization review decision, as required by ERISA and state regulations.']
  approved_length_of_stay varchar [note: 'Number of inpatient days approved by the utilization review, which may differ from the requested length of stay.']
  clinical_criteria_applied varchar [note: 'Name of the clinical guideline or criteria set used to evaluate medical necessity (e.g., InterQual, MCG, Milliman Care Guidelines).']
  clinical_documentation_reviewed varchar [note: 'Summary or list of clinical documentation reviewed during the UM process (e.g., H&P, progress notes, lab results, imaging reports).']
  created_timestamp timestamp [note: 'Timestamp when the utilization review record was first created in the system.']
  criteria_version varchar [note: 'Version number or edition of the clinical criteria applied during the review.']
  denial_reason_code varchar [note: 'Standardized code indicating the reason for denial or modification of the service request (e.g., not medically necessary, experimental treatment, lack of documentation).']
  denial_reason_description varchar [note: 'Detailed narrative explanation of the reason for denial or modification, provided to the member and provider.']
  diagnosis_code varchar [note: 'Primary diagnosis code (ICD-10) associated with the service or admission being reviewed.']
  discharge_date date [note: 'Date the patient was discharged from the facility, applicable for inpatient utilization reviews.']
  medical_record_number varchar [note: 'Patient\'s medical record number at the facility where the service was provided.']
  notification_method varchar [note: 'Method used to notify the member and provider of the review decision (mail, fax, email, patient portal, phone).']
  notification_sent_date date [note: 'Date the review decision notification was sent to the member and provider.']
  peer_to_peer_date date [note: 'Date the peer-to-peer review discussion occurred between the treating provider and the payer\'s medical reviewer.']
  peer_to_peer_requested boolean [note: 'Indicates whether the treating provider requested a peer-to-peer discussion with the medical director or physician reviewer to appeal or discuss the initial review decision.']
  place_of_service_code varchar [note: 'Two-digit code indicating the setting where the service was provided (e.g., 21 for inpatient hospital, 11 for office).']
  procedure_code varchar [note: 'Procedure code (CPT or HCPCS) for the service or treatment being reviewed for medical necessity.']
  record_number varchar [note: 'Foreign key linking to consent.consent_record. Business justification: UR reviewers must verify appropriate consent exists for the service under review (especially for experimental treatments, research procedures, genetic testing). Regulatory requirement for authorizatio']
  regulatory_timeframe_met boolean [note: 'Indicates whether the utilization review was completed within the regulatory timeframe mandated by state or federal law (e.g., 72 hours for urgent pre-service, 30 days for retrospective).']
  rendering_provider_npi varchar [note: 'Ten-digit National Provider Identifier (NPI) of the rendering provider.']
  requested_length_of_stay varchar [note: 'Number of inpatient days requested or initially authorized for the admission.']
  review_completion_date date [note: 'Date the utilization review was completed and a final decision was rendered.']
  review_decision varchar [note: 'Final determination of the utilization review: approved (medical necessity met), denied (not medically necessary), modified (approved with changes), pended (additional information required), or partially approved.']
  review_initiation_date date [note: 'Date the utilization review process was initiated or the review request was received.']
  review_number varchar [note: 'Business identifier or case number assigned to this utilization review for tracking and reference by payers, providers, and UM teams.']
  review_status varchar [note: 'Current lifecycle status of the utilization review process.']
  review_type varchar [note: 'Type of utilization management review conducted: pre-certification (prospective), concurrent review (during stay), retrospective review (post-service), discharge planning, or continued stay review.']
  reviewer_credentials varchar [note: 'Professional credentials of the reviewer (e.g., RN, MD, DO, NP) to demonstrate clinical qualifications for conducting the review.']
  reviewer_notes varchar [note: 'Free-text notes or comments entered by the clinical reviewer documenting the rationale for the review decision.']
  service_date date [note: 'Date of the service, procedure, or admission being reviewed for medical necessity.']
  turnaround_time_hours varchar [note: 'Number of hours elapsed between review initiation and completion, used to measure UM process efficiency and compliance with regulatory timeframes.']
  updated_by varchar [note: 'User ID or name of the person who last updated the utilization review record.']
  updated_timestamp timestamp [note: 'Timestamp when the utilization review record was last updated.']
  vibe_mutation_marker varchar

  Note: 'Transactional record of utilization management (UM) review activities conducted by payers or internal UM teams to evaluate medical necessity for inpatient admissions, continued stays, procedures, and high-cost services. Captures review type (pre-certification, concurrent review, retrospective review, discharge planning), payer ID, member ID, admission/service date, clinical criteria applied (InterQual, MCG), review decision (approved, denied, modified, pended), denial reason code, peer-to-peer review request flag, appeal rights notification, and reviewer credentials. Supports UM compliance, denial management, and length-of-stay optimization.'
}

Table insurance.eligibility_span {
  eligibility_span_id varchar [pk, note: 'Unique identifier for the eligibility span record. Primary key for the eligibility span entity.']
  clinician_id varchar [note: 'Unique identifier for the primary care physician assigned to or selected by the member. Populated when pcp_required_indicator is true.']
  eligibility_id varchar [note: 'Reference to the X12 270/271 eligibility verification transaction that confirmed or established this eligibility span. Links to real-time eligibility verification events.']
  health_plan_id varchar [note: 'Unique identifier for the specific health plan product under which this eligibility span is established. Defines the benefit structure and coverage rules.']
  mpi_record_id varchar [note: 'Unique identifier for the member (patient) who holds this insurance coverage. Links to the patient domain master record.']
  payer_id varchar [note: 'Unique identifier for the insurance payer organization responsible for adjudicating and paying claims under this coverage.']
  prior_eligibility_span_id varchar [note: 'Self-referencing FK on eligibility_span (prior_eligibility_span_id)']
  provider_network_id varchar [note: 'Unique identifier for the provider network associated with this eligibility span. Defines which providers are in-network for this coverage.']
  subscriber_id varchar [note: 'Unique identifier for the primary subscriber (policyholder) of the insurance plan. May be the same as member_id if the member is the subscriber, or different if the member is a dependent.']
  benefit_period_end_date date [note: 'The end date of the benefit period for deductible and out-of-pocket maximum accumulation. Deductibles and accumulators reset after this date.']
  benefit_period_start_date date [note: 'The start date of the benefit period for deductible and out-of-pocket maximum accumulation. Typically aligns with plan year or calendar year.']
  cobra_indicator boolean [note: 'Indicates whether this eligibility span represents COBRA continuation coverage. True if the member is continuing coverage under COBRA provisions after a qualifying event.']
  cobra_qualifying_event varchar [note: 'The qualifying event that triggered COBRA continuation coverage eligibility. Populated only when cobra_indicator is true.']
  cobra_qualifying_event_date date [note: 'The date on which the COBRA qualifying event occurred. Used to determine COBRA continuation period limits.']
  coordination_of_benefits_indicator boolean [note: 'Indicates whether coordination of benefits rules apply because the member has multiple insurance coverages. True if this is a secondary or tertiary payer.']
  coverage_level varchar [note: 'The tier of coverage indicating whether the plan covers only the subscriber or includes dependents.']
  coverage_order varchar [note: 'Indicates the order of liability when multiple coverages exist. Primary coverage pays first; secondary and tertiary coverages pay after primary according to COB rules.']
  coverage_type varchar [note: 'The type of healthcare services covered under this eligibility span. Defines the scope of benefits available to the member.']
  created_timestamp timestamp [note: 'The timestamp when this eligibility span record was first created in the system. Represents the audit trail for record creation.']
  dual_eligibility_indicator boolean [note: 'Indicates whether the member is dually eligible for both Medicare and Medicaid. True if the member qualifies for both programs simultaneously.']
  dual_eligibility_type varchar [note: 'Specifies the type of dual eligibility status. QMB (Qualified Medicare Beneficiary), SLMB (Specified Low-Income Medicare Beneficiary), QI (Qualifying Individual), QDWI (Qualified Disabled and Working Individual). Populated only when dual_eligibility_indicator is true.']
  eligibility_end_date date [note: 'The date on which the member\'s insurance coverage terminates under this eligibility span. Null indicates open-ended active coverage.']
  eligibility_start_date date [note: 'The date on which the member\'s insurance coverage becomes effective under this eligibility span. Represents the beginning of the continuous eligibility period.']
  eligibility_status varchar [note: 'Current lifecycle status of the eligibility span. Active indicates coverage is in force; terminated indicates coverage has ended; suspended indicates temporary hold; COBRA indicates continuation coverage under COBRA provisions; pending indicates coverage not yet effective.']
  eligibility_verification_date date [note: 'The date on which eligibility was last verified with the payer through a 270/271 transaction or other verification method.']
  eligibility_verification_status varchar [note: 'The status of the most recent eligibility verification attempt. Verified indicates successful confirmation; unverified indicates no recent verification; failed indicates verification was attempted but unsuccessful.']
  enrollment_method varchar [note: 'The method by which the enrollment was submitted. Distinguishes between online enrollment, paper application, phone enrollment, in-person enrollment, or automatic enrollment.']
  enrollment_source varchar [note: 'The source or channel through which the member enrolled in this coverage. Indicates whether enrollment was through an employer, exchange, direct purchase, broker, or government program.']
  exchange_indicator boolean [note: 'Indicates whether this coverage was purchased through a health insurance exchange (marketplace) established under the Affordable Care Act.']
  group_number varchar [note: 'Employer or sponsor group number under which the member is covered. Used to identify the employer or organization sponsoring the coverage.']
  medicaid_indicator boolean [note: 'Indicates whether the member has Medicaid coverage. True if the member is enrolled in a state Medicaid program.']
  medicare_indicator boolean [note: 'Indicates whether the member has Medicare coverage. True if the member is enrolled in Medicare Part A, B, C, or D.']
  notes varchar [note: 'Free-text field for additional notes, comments, or special instructions related to this eligibility span. Used to capture context not represented in structured fields.']
  pcp_assignment_date date [note: 'The date on which the current primary care physician was assigned to or selected by the member.']
  pcp_required_indicator boolean [note: 'Indicates whether the member is required to select and maintain a primary care physician under this plan. True for HMO and POS plans that require PCP designation.']
  premium_amount decimal(15,2) [note: 'The premium amount charged for this coverage, typically per billing period. Represents the member or employer contribution for maintaining coverage.']
  premium_payment_frequency varchar [note: 'The frequency at which premium payments are due for this coverage.']
  prior_authorization_required_indicator boolean [note: 'Indicates whether certain services under this plan require prior authorization from the payer before services are rendered.']
  referral_required_indicator boolean [note: 'Indicates whether the member must obtain a referral from their PCP before seeing a specialist. True for HMO plans with referral requirements.']
  relationship_to_subscriber varchar [note: 'Defines the relationship of the member to the primary subscriber. Determines dependent status and eligibility rules. [ENUM-REF-CANDIDATE: self|spouse|child|other_dependent|life_partner|domestic_partner|parent|other — 8 candidates stripped; promote to reference product]']
  subsidy_amount decimal(15,2) [note: 'The amount of premium subsidy or tax credit applied to reduce the member\'s premium cost. Applicable for exchange plans with Advanced Premium Tax Credits (APTC).']
  subsidy_type varchar [note: 'The type of subsidy applied to this coverage. APTC (Advanced Premium Tax Credit), CSR (Cost-Sharing Reduction), employer subsidy, state subsidy, or none.']
  termination_reason varchar [note: 'The reason for termination of the eligibility span, if applicable. Populated only when eligibility_status is terminated. [ENUM-REF-CANDIDATE: voluntary|involuntary|employment_ended|non_payment|death|divorce|age_limit|other — 8 candidates stripped; promote to reference product]']
  updated_by varchar [note: 'The user or system identifier that last updated this eligibility span record. Used for audit and accountability purposes.']
  updated_timestamp timestamp [note: 'The timestamp when this eligibility span record was last modified. Represents the audit trail for record updates.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record representing a continuous period of insurance eligibility for a member under a specific health plan, serving as the SSOT for eligibility determination within the insurance domain. Captures member ID, subscriber ID, payer ID, health plan ID, group number, eligibility start date, eligibility end date, eligibility status (active, terminated, suspended, COBRA), coverage type (medical, dental, vision, pharmacy, behavioral health), Medicare/Medicaid dual eligibility indicator, and the 270/271 eligibility transaction reference. Distinct from patient.patient_eligibility_verification which tracks real-time verification transactions.'
}

Table insurance.accumulator {
  accumulator_id varchar [pk, note: 'Unique identifier for the accumulator record. Primary key for tracking member benefit accumulation.']
  health_plan_id varchar [note: 'Unique identifier for the health plan under which benefits are being accumulated. References the plan configuration and benefit structure.']
  last_claim_id varchar [note: 'Identifier of the most recent claim transaction that contributed to this accumulator. Provides audit trail for accumulation calculations.']
  mpi_record_id varchar [note: 'Unique identifier for the health plan member whose benefits are being accumulated. Links to the member master record.']
  payer_id varchar [note: 'Unique identifier for the insurance payer organization responsible for the health plan and benefit adjudication.']
  prior_accumulator_id varchar [note: 'Self-referencing FK on accumulator (prior_accumulator_id)']
  subscriber_id varchar [note: 'Unique identifier for the primary subscriber of the health plan. May differ from member_id for dependents.']
  accumulated_amount decimal(15,2) [note: 'The year-to-date dollar amount or count that has been accumulated toward the benefit threshold. Represents member cost-sharing contributions or service utilization.']
  accumulator_status varchar [note: 'Current operational status of the accumulator: active (accumulating), suspended (temporarily paused), closed (benefit period ended), or pending reset (awaiting new benefit year initialization).']
  accumulator_type varchar [note: 'The category of benefit accumulation being tracked: individual deductible, family deductible, individual out-of-pocket (OOP) maximum, family OOP maximum, visit limit, or service-specific dollar limit.']
  adjustment_amount decimal(15,2) [note: 'Total dollar amount of manual adjustments applied to this accumulator due to claim reversals, appeals, or administrative corrections. May be positive or negative.']
  adjustment_count varchar [note: 'The number of adjustment transactions applied to this accumulator. Used for audit trail and data quality monitoring.']
  benefit_period_end_date date [note: 'The date when the benefit accumulation period ends. Typically December 31 or the plan termination date.']
  benefit_period_start_date date [note: 'The date when the benefit accumulation period begins. Typically January 1 or the plan effective date for mid-year enrollments.']
  benefit_year varchar [note: 'Calendar year for which the accumulator is tracking benefit utilization. Accumulators typically reset annually on the plan renewal date.']
  carryover_amount decimal(15,2) [note: 'Dollar amount carried over from the previous benefit period, if the plan allows deductible or OOP carryover for services rendered near year-end.']
  carryover_indicator boolean [note: 'Boolean flag indicating whether this accumulator includes carryover amounts from a prior benefit period. True if carryover_amount is greater than zero.']
  coverage_level varchar [note: 'The tier of coverage for which the accumulator applies: individual, family, employee plus spouse, employee plus children, or full family.']
  created_timestamp timestamp [note: 'The date and time when this accumulator record was first created in the system. Typically at the start of a new benefit period or upon member enrollment.']
  cross_accumulation_indicator boolean [note: 'Boolean flag indicating whether amounts in this accumulator also count toward other accumulator types. For example, deductible amounts may also count toward OOP max.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this accumulator. Typically USD for US-based healthcare plans.']
  embedded_deductible_indicator boolean [note: 'Boolean flag indicating whether this family-level accumulator uses embedded individual deductibles. True means each family member has an individual deductible within the family deductible.']
  last_adjustment_date date [note: 'The date of the most recent adjustment transaction applied to this accumulator. Null if no adjustments have been made.']
  last_claim_date date [note: 'Service date of the most recent claim that updated this accumulator. Used for recency tracking and accumulator aging analysis.']
  last_updated_timestamp timestamp [note: 'The date and time when this accumulator record was last modified. Critical for real-time benefit calculation and member portal display.']
  network_type varchar [note: 'Indicates whether the accumulator tracks in-network services, out-of-network services, or a combined bucket for both network types.']
  notes varchar [note: 'Free-text field for additional context, special circumstances, or administrative notes related to this accumulator. May include explanations for manual adjustments or unusual accumulation patterns.']
  plan_year_sequence varchar [note: 'Sequential counter indicating which plan year this accumulator represents for the member. Value of 1 for first year, 2 for second year, etc. Used for multi-year trend analysis.']
  remaining_amount decimal(15,2) [note: 'The remaining balance before the threshold is met. Calculated as threshold_amount minus accumulated_amount. Critical for member cost-sharing estimates.']
  reset_date date [note: 'The date when this accumulator was last reset to zero, typically at the start of a new benefit period or upon plan change.']
  service_category varchar [note: 'The category of healthcare services to which this accumulator applies: medical, pharmacy, dental, vision, behavioral health, or all services combined.']
  threshold_amount decimal(15,2) [note: 'The plan-defined maximum amount or limit for this accumulator type. Once reached, benefit rules change (e.g., deductible met, OOP max reached).']
  threshold_met_date date [note: 'The date on which the member first met the benefit threshold. Null if threshold has not been met. Used for benefit transition tracking and member communication.']
  threshold_met_indicator boolean [note: 'Boolean flag indicating whether the member has met or exceeded the benefit threshold for this accumulator type. True when accumulated_amount >= threshold_amount.']
  transaction_count varchar [note: 'The total number of claim transactions that have contributed to this accumulator balance. Used for utilization pattern analysis.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Transactional record tracking a member\'s year-to-date accumulation of deductible, out-of-pocket maximum, and benefit limit utilization against their health plan thresholds. Captures member ID, health plan ID, benefit year, accumulator type (individual deductible, family deductible, individual OOP max, family OOP max, visit limit, dollar limit), in-network vs out-of-network bucket, accumulated amount to date, plan threshold amount, remaining balance, last updated date, and the claim transactions contributing to the accumulation. Critical for member cost-sharing calculation and benefit exhaustion determination.'
}

Table insurance.capitation_contract {
  capitation_contract_id varchar [pk, note: 'Unique identifier for the capitation contract record. Primary key for the capitation contract entity.']
  group_id varchar [note: 'Foreign key linking to provider.provider_group. Business justification: Capitation contracts are executed with provider groups for PMPM payments and risk-sharing arrangements. Essential for VBC contract management, payment reconciliation, and performance tracking. No exis']
  org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: Capitation contracts executed with organizational providers (hospitals, health systems) for bundled payments and episode-based reimbursement. Critical for hospital VBC arrangements and payment reconci']
  payer_id varchar [note: 'Reference to the insurance payer or health plan organization that is party to this capitation contract.']
  renewed_capitation_contract_id varchar [note: 'Self-referencing FK on capitation_contract (renewed_capitation_contract_id)']
  attributed_member_count varchar [note: 'The current number of members attributed to this capitation contract for payment calculation purposes.']
  attributed_population_definition varchar [note: 'Textual description of the criteria and methodology used to define which members are attributed to this capitation contract for payment and performance measurement purposes.']
  auto_assignment_eligible boolean [note: 'Indicates whether members can be automatically assigned or attributed to this capitation contract based on utilization patterns and attribution logic.']
  benchmark_methodology varchar [note: 'Description of the methodology used to establish the cost and quality benchmarks against which performance is measured for shared savings and risk calculations.']
  carve_out_services varchar [note: 'List or description of specific high-cost or specialized services carved out from the capitation arrangement and reimbursed separately (e.g., transplants, oncology, behavioral health).']
  contract_name varchar [note: 'Human-readable name or title of the capitation contract for identification and reporting purposes.']
  contract_number varchar [note: 'Externally-known unique business identifier for the capitation contract, used for reference in billing, claims, and financial reporting.']
  contract_owner varchar [note: 'Name or identifier of the individual or department within the healthcare organization responsible for managing this capitation contract.']
  contract_signed_date date [note: 'The date on which the capitation contract was executed and signed by authorized representatives of both parties.']
  contract_status varchar [note: 'Current lifecycle status of the capitation contract indicating its operational state and enforceability. [ENUM-REF-CANDIDATE: draft|pending_approval|active|suspended|terminated|expired|renewed — 7 candidates stripped; promote to reference product]']
  contract_type varchar [note: 'Classification of the capitation arrangement defining the scope of services covered under the per-member-per-month payment structure. [ENUM-REF-CANDIDATE: global_capitation|professional_capitation|specialty_capitation|partial_capitation|primary_care_capitation|hospital_capitation — promote to reference product]']
  covered_services_description varchar [note: 'Comprehensive textual description of the scope of clinical services and care management activities covered under the capitation payment arrangement.']
  created_timestamp timestamp [note: 'The date and time when this capitation contract record was first created in the system.']
  effective_date date [note: 'The date on which the capitation contract becomes binding and payment arrangements take effect.']
  excluded_services_description varchar [note: 'Textual description of services explicitly excluded from the capitation arrangement and subject to separate fee-for-service or other payment mechanisms.']
  filing_reference_number varchar [note: 'The reference number assigned by the regulatory authority for the contract filing submission.']
  geographic_service_area varchar [note: 'Description of the geographic region, counties, or zip codes covered by this capitation contract for member attribution and service delivery.']
  last_amendment_date date [note: 'The date of the most recent amendment or modification to the capitation contract terms.']
  maximum_shared_loss_cap decimal(12,2) [note: 'The maximum dollar amount of shared losses that the healthcare organization is responsible for in a performance period, expressed in USD.']
  maximum_shared_savings_cap decimal(12,2) [note: 'The maximum dollar amount of shared savings that the healthcare organization can earn in a performance period, expressed in USD.']
  minimum_savings_rate decimal(5,2) [note: 'The minimum percentage of cost savings below the benchmark that must be achieved before shared savings payments are triggered, expressed as a percentage.']
  notes varchar [note: 'Free-text field for additional notes, comments, or special instructions related to the capitation contract administration and management.']
  performance_year varchar [note: 'The calendar year during which performance is measured for quality metrics and financial reconciliation under this capitation contract.']
  pmpm_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the PMPM rate. Typically USD for US healthcare organizations.']
  pmpm_rate decimal(12,2) [note: 'The fixed monthly payment amount per attributed member that the payer pays to the healthcare organization under the capitation arrangement, expressed in USD.']
  quality_measure_set varchar [note: 'The standardized set of quality performance measures used to evaluate care delivery and determine quality withhold return and incentive payments (e.g., HEDIS, MIPS, ACO quality measures).']
  quality_withhold_amount decimal(12,2) [note: 'The total dollar amount withheld from capitation payments for quality performance measurement, expressed in USD.']
  quality_withhold_percentage decimal(5,2) [note: 'The percentage of capitation payments withheld by the payer pending achievement of quality performance targets, to be returned upon meeting quality benchmarks.']
  regulatory_filing_required boolean [note: 'Indicates whether this capitation contract requires filing with state insurance departments or CMS for regulatory approval and oversight.']
  renewal_date date [note: 'The date on which the contract is eligible for or scheduled for renewal negotiation.']
  risk_adjustment_methodology varchar [note: 'The clinical risk stratification model used to adjust capitation payments based on member acuity and complexity. HCC (Hierarchical Condition Category) is the most common model in Medicare and commercial populations.']
  risk_corridor_lower_threshold decimal(5,2) [note: 'The lower percentage threshold defining the risk corridor below which the healthcare organization is protected from losses. Expressed as a percentage of target costs.']
  risk_corridor_upper_threshold decimal(5,2) [note: 'The upper percentage threshold defining the risk corridor above which the healthcare organization shares in savings. Expressed as a percentage of target costs.']
  settlement_frequency varchar [note: 'The frequency at which financial reconciliation and settlement of capitation payments, shared savings, and quality withholds occurs between the payer and healthcare organization.']
  shared_loss_percentage decimal(5,2) [note: 'The percentage of cost overruns above the target benchmark that the healthcare organization is responsible for under the risk-sharing arrangement.']
  shared_savings_percentage decimal(5,2) [note: 'The percentage of cost savings below the target benchmark that the healthcare organization retains as shared savings under the value-based care arrangement.']
  stop_loss_threshold decimal(12,2) [note: 'The per-member cost threshold above which stop-loss insurance or reinsurance protection applies to limit the healthcare organizations financial exposure for high-cost cases, expressed in USD.']
  termination_date date [note: 'The date on which the capitation contract ends or is scheduled to end. Null for open-ended or evergreen contracts.']
  termination_notice_days varchar [note: 'The number of days advance notice required by either party to terminate the capitation contract.']
  updated_by varchar [note: 'Identifier of the user or system process that last updated this capitation contract record.']
  updated_timestamp timestamp [note: 'The date and time when this capitation contract record was last modified in the system.']
  vbc_model varchar [note: 'The value-based care payment model framework governing financial risk and reward sharing between the healthcare organization and payer.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record for capitation and value-based care (VBC) contracts between the healthcare organization and payers, defining per-member-per-month (PMPM) payment arrangements, risk pool structures, and shared savings/risk parameters. Captures contract ID, payer ID, capitation type (global capitation, professional capitation, specialty capitation), attributed population definition, PMPM rate, risk adjustment methodology (HCC — Hierarchical Condition Category), risk corridor parameters, quality withhold percentage, shared savings/loss split, contract effective dates, and settlement frequency. Supports VBC financial modeling and capitation payment reconciliation.'
}

Table insurance.capitation_payment {
  capitation_payment_id varchar [pk, note: 'Unique identifier for the capitation payment transaction record. Primary key for the capitation payment entity.']
  adjusted_capitation_payment_id varchar [note: 'Self-referencing FK on capitation_payment (adjusted_capitation_payment_id)']
  ar_transaction_id varchar [note: 'The unique transaction identifier from the payment processing system or bank for the electronic funds transfer or check deposit.']
  capitation_contract_id varchar [note: 'Reference to the capitation or value-based care contract governing this payment arrangement.']
  care_site_id varchar [note: 'Reference to the primary service location or facility receiving the capitation payment for the attributed member population.']
  group_id varchar [note: 'Reference to the provider group or practice organization receiving the capitation payment under the value-based care arrangement.']
  payer_id varchar [note: 'Reference to the insurance payer or health plan making the capitation payment under the value-based care contract.']
  adjustment_amount decimal(15,2) [note: 'Additional positive or negative adjustments applied to the capitation payment for retroactive attribution changes, prior period corrections, or contract amendments.']
  adjustment_reason varchar [note: 'Detailed explanation for any adjustment amount applied to the capitation payment, including retroactive attribution changes or contract modifications.']
  attributed_member_count varchar [note: 'The number of health plan members attributed to the provider organization for the payment period under the capitation contract.']
  contract_year varchar [note: 'The contract year of the capitation agreement to which this payment applies, used for multi-year contract tracking and performance measurement.']
  cost_center varchar [note: 'The organizational cost center or department to which the capitation payment revenue is allocated for internal financial management.']
  created_timestamp timestamp [note: 'The date and time when this capitation payment record was first created in the system, used for audit trail and data lineage tracking.']
  currency_code varchar [note: 'The three-letter ISO 4217 currency code for the capitation payment. Typically USD for US healthcare organizations.']
  days_to_payment varchar [note: 'The number of days between the payment due date and the actual payment received date, used to track payer payment timeliness performance.']
  general_ledger_account varchar [note: 'The general ledger account code to which the capitation payment revenue is posted for financial reporting and accounting purposes.']
  gross_capitation_amount decimal(15,2) [note: 'The total gross capitation payment amount calculated as attributed member count multiplied by PMPM rate, before any adjustments or withholds.']
  net_payment_amount decimal(15,2) [note: 'The final net capitation payment amount received after all adjustments, risk factors, and quality withholds have been applied.']
  notes varchar [note: 'Free-text notes or comments regarding the capitation payment, including special circumstances, disputes, or follow-up actions required.']
  payment_due_date date [note: 'The contractually agreed date by which the payer is required to remit the capitation payment to the provider organization.']
  payment_method varchar [note: 'The payment instrument or mechanism used by the payer to remit the capitation payment.']
  payment_period_month varchar [note: 'The month (1-12) for which this capitation payment applies, representing the coverage period for attributed members.']
  payment_period_year varchar [note: 'The calendar year for which this capitation payment applies, representing the coverage period for attributed members.']
  payment_received_date date [note: 'The date on which the capitation payment was actually received by the provider organization, used for cash flow tracking and revenue recognition.']
  payment_reference_number varchar [note: 'External payment reference number or remittance identifier provided by the payer for reconciliation and tracking purposes.']
  payment_status varchar [note: 'Current lifecycle status of the capitation payment transaction indicating processing state and reconciliation progress.']
  pmpm_rate decimal(12,4) [note: 'The contracted capitation rate paid per attributed member per month, expressed in dollars. This is the base rate before adjustments.']
  quality_withhold_amount decimal(15,2) [note: 'The dollar amount withheld by the payer from the capitation payment pending achievement of quality performance metrics under the value-based care contract.']
  quality_withhold_percentage decimal(5,2) [note: 'The percentage of the gross capitation amount withheld for quality performance, typically ranging from 0% to 20%.']
  reconciliation_date date [note: 'The date on which the capitation payment was successfully reconciled against expected amounts and attributed member rosters.']
  reconciliation_status varchar [note: 'Current status of the reconciliation process comparing the received capitation payment against expected amounts based on attributed member counts and contract terms.']
  remittance_advice_date date [note: 'The date on which the remittance advice document was received from the payer, used for payment reconciliation and audit trail purposes.']
  remittance_advice_received boolean [note: 'Indicates whether a formal remittance advice document (835 ERA or paper EOB) was received from the payer with the capitation payment.']
  revenue_recognition_date date [note: 'The accounting date on which the capitation payment revenue is recognized in the general ledger according to GAAP revenue recognition principles.']
  revenue_recognition_period varchar [note: 'The accounting period (month and year) in which the capitation payment revenue is recognized for financial reporting purposes.']
  risk_adjusted_amount decimal(15,2) [note: 'The capitation payment amount after applying the risk adjustment factor to account for population health complexity.']
  risk_adjustment_factor decimal(6,4) [note: 'The risk adjustment multiplier applied to the capitation payment based on the attributed population\'s health acuity and complexity. Values typically range from 0.5 to 3.0.']
  updated_by varchar [note: 'The user identifier or system account that last modified this capitation payment record, used for audit trail and accountability purposes.']
  updated_timestamp timestamp [note: 'The date and time when this capitation payment record was last modified, used for audit trail and change tracking purposes.']
  variance_amount decimal(15,2) [note: 'The dollar difference between the expected capitation payment and the actual payment received, used to identify discrepancies requiring investigation.']
  variance_reason varchar [note: 'Explanation for any variance between expected and actual capitation payment amounts, including attribution differences or rate discrepancies.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Transactional record of monthly capitation payments received from payers under capitation and value-based care contracts. Captures payment period (month/year), payer ID, capitation contract ID, attributed member count, PMPM rate applied, gross capitation amount, risk adjustment factor, quality withhold amount, net payment amount, payment receipt date, payment method (EFT, check), payer remittance reference, and reconciliation status. Enables capitation revenue recognition, attributed population reconciliation, and VBC financial performance tracking.'
}

Table insurance.risk_adjustment {
  risk_adjustment_id varchar [pk, note: 'Unique identifier for the risk adjustment submission record.']
  clinician_id varchar [note: 'Unique identifier for the healthcare provider who documented the diagnosis codes submitted for risk adjustment.']
  corrected_risk_adjustment_id varchar [note: 'Self-referencing FK on risk_adjustment (corrected_risk_adjustment_id)']
  diagnosis_id varchar [note: 'Foreign key linking to clinical.clinical_diagnosis. Business justification: Risk adjustment submissions must reference source clinical diagnoses for RADV audits and medical record validation. CMS requires linking HCC codes back to documented diagnoses. Essential for Medicare ']
  employee_id varchar [note: 'Unique identifier for the clinical coder or health information management professional who reviewed the medical record to validate this diagnosis submission.']
  health_plan_id varchar [note: 'Unique identifier for the specific health plan under which the member is enrolled and for which risk adjustment applies.']
  mpi_record_id varchar [note: 'Unique identifier for the health plan member whose diagnoses are being submitted for risk adjustment.']
  org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: Risk adjustment submissions track which organizational provider documented the HCC diagnosis for RADV audit trails and medical record retrieval. Essential for Medicare Advantage and ACA risk adjustmen']
  payer_id varchar [note: 'Unique identifier for the insurance payer organization responsible for the risk adjustment submission.']
  visit_id varchar [note: 'Unique identifier for the clinical encounter that generated the diagnosis codes submitted for risk adjustment.']
  acceptance_date date [note: 'The date on which CMS or the payer accepted this risk adjustment submission as valid and included it in payment calculations.']
  chart_review_date date [note: 'The date on which the medical chart supporting this diagnosis was reviewed for risk adjustment coding accuracy and completeness.']
  contract_number varchar [note: 'The CMS-assigned contract identifier for the Medicare Advantage or Part D plan under which this risk adjustment submission is made.']
  created_timestamp timestamp [note: 'The date and time when this risk adjustment record was first created in the system.']
  data_collection_period_end date [note: 'The end date of the period during which diagnosis data was collected for this risk adjustment submission, typically December 31 of the service year.']
  data_collection_period_start date [note: 'The start date of the period during which diagnosis data was collected for this risk adjustment submission, typically January 1 of the service year.']
  deleted_flag boolean [note: 'Boolean flag indicating whether this risk adjustment submission has been deleted or voided, typically due to coding errors or medical record review findings.']
  deletion_date date [note: 'The date on which this risk adjustment submission was deleted or voided from the payment calculation.']
  deletion_reason varchar [note: 'The explanation for why this risk adjustment submission was deleted, such as coding error, insufficient documentation, or duplicate submission.']
  demographic_score decimal(10,4) [note: 'The portion of the total risk score attributable to demographic factors such as age, gender, Medicaid eligibility, and disability status.']
  diagnosis_present_on_admission boolean [note: 'Boolean flag indicating whether the diagnosis was present at the time of inpatient admission, required for certain risk adjustment and quality reporting programs.']
  diagnosis_type varchar [note: 'The classification of the diagnosis within the encounter documentation, indicating whether it was the principal reason for the encounter or a secondary condition.']
  disease_score decimal(10,4) [note: 'The portion of the total risk score attributable to the submitted HCC categories representing chronic and acute conditions.']
  hcc_code varchar [note: 'The HCC category code to which the submitted diagnosis maps, representing a clinically and financially homogeneous group of conditions used in risk score calculation.']
  hcc_description varchar [note: 'The descriptive label for the HCC category, providing clinical context for the condition group (e.g., Diabetes with Chronic Complications, Congestive Heart Failure).']
  interaction_score decimal(10,4) [note: 'The portion of the total risk score attributable to disease interaction factors, where the presence of multiple conditions results in higher expected costs than the sum of individual conditions.']
  medical_record_review_status varchar [note: 'The status of medical record documentation review supporting this diagnosis submission, critical for RADV audit compliance and internal quality assurance.']
  model varchar [note: 'The specific risk adjustment methodology applied to calculate the risk score. CMS-HCC (Hierarchical Condition Category) for Medicare Advantage, RxHCC for Part D, HHS-HCC for ACA marketplace plans, ESRD for end-stage renal disease, PACE for Program of All-Inclusive Care for the Elderly, CDPS for Chronic Illness and Disability Payment System. [ENUM-REF-CANDIDATE: CMS-HCC|RxHCC|HHS-HCC|ESRD|PACE|CDPS|Other — 7 candidates stripped; promote to reference product]']
  model_version varchar [note: 'The version year or release identifier of the risk adjustment model used for this submission (e.g., V24, V28 for CMS-HCC models).']
  payment_amount decimal(15,2) [note: 'The dollar amount of risk adjustment payment associated with this submission, calculated by multiplying the risk score by the base payment rate for the plan and geographic area.']
  payment_impact_amount decimal(15,2) [note: 'The incremental payment impact of this specific HCC submission compared to baseline, representing the marginal revenue contribution of capturing this diagnosis.']
  payment_year varchar [note: 'The calendar year for which the risk adjustment payment applies, typically the year following the data collection year.']
  plan_benefit_package varchar [note: 'The specific benefit package identifier within the contract that applies to this member and risk adjustment submission.']
  radv_audit_date date [note: 'The date on which this submission was selected for or completed a RADV audit by CMS.']
  radv_audit_status varchar [note: 'The status of this submission in the CMS Risk Adjustment Data Validation audit process, which validates the accuracy of submitted diagnosis codes through medical record review.']
  recapture_flag boolean [note: 'Boolean flag indicating whether this diagnosis represents a recapture of a chronic condition that was documented in a prior year but not yet documented in the current payment year.']
  rejection_date date [note: 'The date on which CMS or the payer rejected this risk adjustment submission due to validation errors or policy violations.']
  rejection_reason varchar [note: 'The detailed explanation provided by CMS or the payer for why this risk adjustment submission was rejected, including error codes and corrective action guidance.']
  risk_score decimal(10,4) [note: 'The calculated risk score (also known as RAF - Risk Adjustment Factor) for the member based on demographic factors and submitted HCC categories. A score of 1.0 represents average risk; higher scores indicate higher expected costs.']
  service_date date [note: 'The date of service on which the diagnosis was documented during the clinical encounter, used to determine eligibility for the risk adjustment payment year.']
  submission_date date [note: 'The date on which this risk adjustment submission was transmitted to CMS EDGE server or payer risk adjustment system.']
  submission_number varchar [note: 'Externally-known unique business identifier for this risk adjustment submission, used for tracking and reconciliation with CMS or payer systems.']
  submission_status varchar [note: 'The current processing status of the risk adjustment submission in the workflow from creation through final reconciliation with CMS or payer systems.']
  submission_timestamp timestamp [note: 'The precise date and time when this risk adjustment submission was transmitted, used for audit trail and reconciliation purposes.']
  submission_type varchar [note: 'The type of risk adjustment submission. Initial for first-time submission, Supplemental for additional diagnoses, Deletion for removing previously submitted diagnoses, Correction for fixing errors, RAPS for Risk Adjustment Processing System (legacy), EDPS for Encounter Data Processing System (current).']
  suspect_flag boolean [note: 'Boolean flag indicating whether this diagnosis has been identified as a suspect condition that should be documented and submitted for risk adjustment but has not yet been confirmed in the current year.']
  updated_timestamp timestamp [note: 'The date and time when this risk adjustment record was last modified.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Transactional record of risk adjustment submissions and reconciliations under CMS risk adjustment programs (HCC — Hierarchical Condition Category for Medicare Advantage, EDGE server submissions for ACA plans) and payer-specific risk adjustment methodologies. Captures member ID, payer ID, health plan ID, risk adjustment model (CMS-HCC, RxHCC, HHS-HCC), diagnosis codes submitted (HCC-mapped ICD-10), risk score, RAF (Risk Adjustment Factor), submission period, submission type (initial, supplemental, deletion), RADV audit status, and payment impact amount. Supports risk adjustment revenue optimization and CMS compliance.'
}

Table insurance.coordination_of_benefits {
  coordination_of_benefits_id varchar [pk, note: 'Unique identifier for the coordination of benefits record. Primary key.']
  cob_vendor_id varchar [note: 'Identifier for the third-party vendor providing COB data services, if applicable (e.g., Availity, Change Healthcare COB services).']
  coordination_member_mpi_record_id varchar [note: 'Unique identifier for the member with multiple insurance coverages. Links to the patient/member master record.']
  coordination_mpi_record_id varchar [note: 'Foreign key linking to patient.mpi_record. Business justification: COB determination for claims adjudication with multiple payers requires patient identity linkage. Business process: primary/secondary payer sequencing depends on patient-specific coverage relationship']
  primary_coordination_health_plan_id varchar [note: 'Unique identifier for the health plan designated as primary coverage.']
  primary_payer_id varchar [note: 'Unique identifier for the insurance payer designated as primary in the coordination of benefits hierarchy.']
  subscriber_id varchar [note: 'Unique identifier for the primary subscriber on the insurance policy.']
  superseded_coordination_of_benefits_id varchar [note: 'Self-referencing FK on coordination_of_benefits (superseded_coordination_of_benefits_id)']
  tertiary_payer_id varchar [note: 'Unique identifier for the insurance payer designated as tertiary in the coordination of benefits hierarchy, if applicable.']
  tertiary_plan_health_plan_id varchar [note: 'Unique identifier for the health plan designated as tertiary coverage, if applicable.']
  auto_cob_update_enabled boolean [note: 'Boolean flag indicating whether automatic updates to COB information are enabled through eligibility feeds or third-party vendors. True when automated updates are active.']
  cob_agreement_type varchar [note: 'The type of coordination agreement between payers. Standard COB allows combined benefits up to 100% of charges; non-duplication pays only what primary did not cover; carve-out excludes certain services; maintenance of benefits pays as if primary regardless of other coverage.']
  cob_determination_method varchar [note: 'The method or rule used to determine the order of benefit responsibility among multiple coverages. Common methods include birthday rule (parent with earlier birthday is primary for dependent children), gender rule (deprecated method using father as primary), NAIC COB rules, court order, separation agreement, or active/inactive employment status.']
  cob_effective_date date [note: 'The date when the coordination of benefits arrangement becomes effective and the payer order applies for claim adjudication.']
  cob_notes varchar [note: 'Free-text notes documenting special circumstances, exceptions, or additional context regarding the coordination of benefits arrangement.']
  cob_priority_sequence varchar [note: 'Numeric sequence indicating the order of benefit responsibility. 1 = primary, 2 = secondary, 3 = tertiary. Used for claim adjudication sequencing.']
  cob_questionnaire_response_date date [note: 'The date when the member returned the completed COB questionnaire with updated coverage information.']
  cob_questionnaire_sent_date date [note: 'The date when a COB questionnaire was sent to the member to verify or update other insurance coverage information.']
  cob_status varchar [note: 'Current lifecycle status of the coordination of benefits arrangement.']
  cob_termination_date date [note: 'The date when the coordination of benefits arrangement ends, typically due to loss of one coverage or change in member circumstances.']
  cob_verification_date date [note: 'The date when the coordination of benefits information was last verified with the member or through external sources.']
  cob_verification_source varchar [note: 'The source or method used to verify the coordination of benefits information, such as member attestation, employer report, eligibility file feed, claims data analysis, third-party COB vendor, or manual research.']
  court_order_date date [note: 'The date of the court order that specifies the coordination of benefits arrangement, if applicable.']
  court_order_indicator boolean [note: 'Boolean flag indicating whether a court order specifies the coordination of benefits order, overriding standard COB rules. True when court order exists.']
  created_timestamp timestamp [note: 'The timestamp when this coordination of benefits record was first created in the system.']
  crossover_claim_indicator boolean [note: 'Boolean flag indicating whether this COB arrangement involves automatic crossover claims between Medicare and Medicaid or other secondary payers. True indicates crossover claims are processed automatically.']
  custody_arrangement varchar [note: 'The custody arrangement for dependent children when parents are separated or divorced, which may override standard birthday rule COB determination per court order or separation agreement.']
  dependent_relationship_code varchar [note: 'The relationship of the member to the subscriber, used in determining COB order under birthday rule or other dependent coverage rules.']
  last_cob_inquiry_date date [note: 'The date when the most recent COB inquiry or verification was performed with external sources or the member.']
  medicare_primary_indicator boolean [note: 'Boolean flag indicating whether Medicare is the primary payer in this coordination of benefits arrangement. True when Medicare pays first.']
  msp_type varchar [note: 'The type of Medicare Secondary Payer situation, if applicable. Identifies the reason Medicare is secondary: working aged (group health plan coverage), ESRD (end-stage renal disease coordination period), disability (large group health plan), no-fault insurance, workers compensation, or liability insurance. [ENUM-REF-CANDIDATE: working_aged|esrd|disability|no_fault|workers_comp|liability|not_applicable — 7 candidates stripped; promote to reference product]']
  next_cob_verification_due_date date [note: 'The date when the next periodic COB verification is scheduled to ensure accuracy of payer order information.']
  other_subscriber_birth_date date [note: 'Date of birth of the other parent or subscriber on the secondary coverage, used in birthday rule calculations for dependent COB determination.']
  primary_coverage_type varchar [note: 'The type of insurance coverage designated as primary in the COB hierarchy. [ENUM-REF-CANDIDATE: group|individual|medicare|medicaid|tricare|va|workers_comp|auto_insurance|other — 9 candidates stripped; promote to reference product]']
  secondary_coverage_type varchar [note: 'The type of insurance coverage designated as secondary in the COB hierarchy. [ENUM-REF-CANDIDATE: group|individual|medicare|medicaid|tricare|va|workers_comp|auto_insurance|other — 9 candidates stripped; promote to reference product]']
  subscriber_birth_date date [note: 'Date of birth of the primary subscriber, used in birthday rule calculations for dependent COB determination.']
  updated_by varchar [note: 'The user ID or system identifier of the person or process that last updated this coordination of benefits record.']
  updated_timestamp timestamp [note: 'The timestamp when this coordination of benefits record was last modified.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record managing coordination of benefits (COB) rules and active COB relationships for members with multiple insurance coverages. Captures member ID, primary payer ID, primary plan ID, secondary payer ID, secondary plan ID, tertiary payer information, COB determination method (birthday rule, gender rule, NAIC COB rules), COB effective date, COB verification date, COB verification source, and crossover claim indicator (Medicare/Medicaid crossover). SSOT for COB order determination referenced during claim adjudication to prevent duplicate payment and ensure correct primary/secondary billing sequencing.'
}

Table insurance.network_adequacy {
  network_adequacy_id varchar [pk, note: 'Unique identifier for the network adequacy assessment record. Primary key for this transactional record of regulatory compliance assessment.']
  health_plan_id varchar [note: 'Identifier of the specific health plan product associated with this network adequacy assessment.']
  payer_id varchar [note: 'Identifier of the insurance payer organization responsible for this network. Links to payer master data.']
  prior_network_adequacy_id varchar [note: 'Self-referencing FK on network_adequacy (prior_network_adequacy_id)']
  provider_network_id varchar [note: 'Identifier of the provider network being assessed for adequacy. Links to the provider network master data.']
  actual_average_appointment_wait_time_days varchar [note: 'Measured average number of days members wait for an appointment with providers in this specialty.']
  actual_average_distance_miles decimal(8,2) [note: 'Measured average distance in miles that members must travel to reach the nearest contracted provider in this specialty.']
  actual_average_travel_time_minutes varchar [note: 'Measured average travel time in minutes that members must travel to reach the nearest contracted provider in this specialty.']
  actual_provider_to_member_ratio decimal(10,4) [note: 'Measured ratio of contracted providers to enrolled members for this specialty and service area at the time of assessment.']
  adequacy_determination varchar [note: 'Final determination of whether the provider network meets regulatory adequacy standards for this specialty and service area.']
  assessment_date timestamp [note: 'Date and time when the network adequacy assessment was performed or completed. Principal business event timestamp for this transaction.']
  assessment_methodology varchar [note: 'Description of the methodology used to conduct the network adequacy assessment, including data sources, calculation methods, and geographic analysis techniques.']
  assessment_number varchar [note: 'Business identifier for this network adequacy assessment, used for tracking and regulatory filing reference.']
  assessment_period_end_date date [note: 'Ending date of the time period covered by this network adequacy assessment.']
  assessment_period_start_date date [note: 'Beginning date of the time period covered by this network adequacy assessment.']
  assessment_status varchar [note: 'Current lifecycle status of the network adequacy assessment in the regulatory review and approval workflow. [ENUM-REF-CANDIDATE: draft|in_progress|completed|submitted|approved|deficient|remediation_required — 7 candidates stripped; promote to reference product]']
  assessor_name varchar [note: 'Name of the individual or team responsible for conducting the network adequacy assessment.']
  county_code varchar [note: 'County FIPS code or county name for the geographic area being assessed. Used for county-level adequacy standards.']
  created_timestamp timestamp [note: 'Date and time when this network adequacy assessment record was first created in the system.']
  deficiency_description varchar [note: 'Detailed description of any network adequacy deficiencies identified during the assessment, including specific gaps and affected populations.']
  essential_community_provider_flag boolean [note: 'Indicates whether this assessment includes evaluation of Essential Community Provider participation, required for marketplace plans to serve vulnerable populations.']
  filing_reference_number varchar [note: 'Regulatory filing reference number or tracking identifier assigned by CMS or state Department of Insurance for this adequacy submission.']
  geographic_service_area varchar [note: 'Geographic region or service area covered by this adequacy assessment (e.g., county, ZIP code cluster, metropolitan statistical area).']
  maximum_appointment_wait_time_days varchar [note: 'Regulatory standard for maximum number of days members must wait for an appointment with this specialty.']
  maximum_distance_miles decimal(8,2) [note: 'Regulatory standard for maximum distance in miles that members must travel to access this specialty.']
  maximum_time_distance_standard varchar [note: 'Regulatory standard for maximum travel time or distance members must travel to access this specialty (e.g., 30 minutes or 30 miles for primary care).']
  maximum_travel_time_minutes varchar [note: 'Regulatory standard for maximum travel time in minutes that members must travel to access this specialty.']
  member_count varchar [note: 'Total number of enrolled members in the health plan within the assessed geographic service area.']
  notes varchar [note: 'Additional notes, comments, or context regarding the network adequacy assessment, including special circumstances or exceptions.']
  percentage_members_within_standard decimal(5,2) [note: 'Percentage of enrolled members who have access to a contracted provider within the time-and-distance standard for this specialty.']
  provider_count varchar [note: 'Total number of contracted providers in this specialty category within the assessed geographic service area.']
  regulatory_approval_date date [note: 'Date when the regulatory authority approved the network adequacy assessment and certified compliance.']
  regulatory_body varchar [note: 'Regulatory authority to which this network adequacy assessment is submitted (CMS for Medicare Advantage, state Department of Insurance for commercial plans, exchange for marketplace plans).']
  regulatory_submission_date date [note: 'Date when the network adequacy assessment was submitted to the regulatory authority for review and approval.']
  remediation_due_date date [note: 'Target date by which network adequacy deficiencies must be corrected to meet regulatory requirements.']
  remediation_plan varchar [note: 'Corrective action plan to address identified network adequacy deficiencies, including recruitment targets and timelines.']
  required_provider_to_member_ratio decimal(10,4) [note: 'Regulatory standard for the minimum ratio of providers to enrolled members for this specialty and service area (e.g., 1 PCP per 2000 members).']
  reviewer_name varchar [note: 'Name of the individual or team responsible for reviewing and approving the network adequacy assessment before regulatory submission.']
  specialty_category varchar [note: 'Provider specialty or service category being assessed for adequacy (e.g., primary care, cardiology, behavioral health, pediatrics). May reference specialty taxonomy codes.']
  specialty_code varchar [note: 'Standardized code representing the provider specialty being assessed, typically from NUCC taxonomy or CMS specialty codes.']
  state_code varchar [note: 'Two-letter state code for the geographic area being assessed. Used for state-level regulatory reporting.']
  telehealth_included_flag boolean [note: 'Indicates whether telehealth providers were included in the adequacy assessment calculations. True if telehealth access was counted toward meeting adequacy standards.']
  updated_by varchar [note: 'User identifier or system account that last modified this network adequacy assessment record.']
  updated_timestamp timestamp [note: 'Date and time when this network adequacy assessment record was last modified in the system.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Transactional record of network adequacy assessments and CMS/state regulatory filings documenting that a payer\'s provider network meets time-and-distance and provider-to-member ratio standards. Captures network ID, payer ID, health plan ID, assessment period, specialty category assessed, geographic service area, required provider-to-member ratio, actual ratio, maximum time-to-appointment standard, actual average time-to-appointment, adequacy status (adequate, deficient), deficiency remediation plan, regulatory submission date, and regulatory body (CMS, state DOI). Supports network adequacy compliance and regulatory reporting.'
}

Table insurance.formulary_tier {
  formulary_tier_id varchar [pk, note: 'Unique identifier for the formulary tier record. Primary key for the formulary tier entity.']
  formulary_id varchar [note: 'Reference to the parent formulary that contains this tier structure. Links to the pharmacy formulary master data.']
  health_plan_id varchar [note: 'Reference to the health plan to which this formulary tier structure applies. Links to the health plan master data.']
  ndc_drug_id varchar [note: 'Foreign key linking to reference.ndc_drug. Business justification: Formulary tiers assign specific NDC drugs to cost-sharing levels (tier 1-4). Essential for pharmacy benefit administration, member cost calculation, and formulary management in payer pharmacy operatio']
  primary_superseded_by_formulary_tier_id varchar [note: 'Reference to the formulary tier record that replaces this tier structure. Used for tracking tier evolution and managing transitions during formulary updates. Null if this is the current active tier.']
  cms_tier_category varchar [note: 'CMS-defined tier category classification for Medicare Part D reporting and compliance. Maps internal tier structure to CMS standard tier definitions for regulatory submissions.']
  created_timestamp timestamp [note: 'Date and time when this formulary tier record was first created in the system. Used for audit trail and data lineage tracking.']
  days_supply_mail_order varchar [note: 'Standard number of days supply allowed per prescription fill for medications in this tier through mail order pharmacies. Typically 90 days to encourage mail order utilization.']
  days_supply_standard varchar [note: 'Standard number of days supply allowed per prescription fill for medications in this tier at retail pharmacies. Common values are 30, 60, or 90 days.']
  deductible_applies boolean [note: 'Indicates whether the plan deductible must be met before cost-sharing for this tier takes effect. True if deductible applies; False if tier cost-sharing is immediate.']
  effective_date date [note: 'Date when this formulary tier structure becomes active and applicable for member cost-sharing calculations. Aligns with benefit year or mid-year formulary updates.']
  mail_order_eligible boolean [note: 'Indicates whether medications in this tier are eligible for mail order pharmacy fulfillment, typically with extended days supply and potentially different cost-sharing. True if mail order is available; False otherwise.']
  member_coinsurance_percentage decimal(5,2) [note: 'Percentage of the drug cost the member pays for medications in this tier. Represents percentage-based cost-sharing structure. Null if flat copay applies instead.']
  member_communication_text varchar [note: 'Standardized text used in member-facing communications to explain this tier, including Summary of Benefits and Coverage (SBC) documents, formulary guides, and member portals.']
  member_copay_amount decimal(10,2) [note: 'Fixed dollar amount the member pays per prescription fill for medications in this tier. Represents flat copayment cost-sharing structure. Null if coinsurance applies instead.']
  notes varchar [note: 'Free-text field for additional comments, special instructions, or contextual information about this formulary tier that does not fit into structured fields. Used for operational notes and exception documentation.']
  out_of_pocket_applies boolean [note: 'Indicates whether member cost-sharing for this tier counts toward the annual out-of-pocket maximum. True if costs accumulate toward OOP max; False otherwise.']
  preferred_tier_flag boolean [note: 'Indicates whether this tier represents a preferred cost-sharing level, typically associated with lower member costs and plan-preferred medications. True for preferred tiers; False otherwise.']
  preventive_tier_flag boolean [note: 'Indicates whether this tier is designated for preventive medications covered at zero or minimal cost-sharing under Affordable Care Act (ACA) preventive care requirements. True for preventive tiers; False otherwise.']
  prior_authorization_required boolean [note: 'Indicates whether medications in this tier require prior authorization approval from the health plan before coverage is provided. True if PA is required; False otherwise.']
  provider_communication_text varchar [note: 'Standardized text used in provider-facing communications to explain this tier structure, cost-sharing rules, and utilization management requirements for prescribing decisions.']
  quantity_limit_applies boolean [note: 'Indicates whether medications in this tier are subject to quantity limits per fill or per time period. True if quantity limits apply; False otherwise. Specific limits are defined at the drug level.']
  regulatory_approval_date date [note: 'Date when the formulary tier structure received regulatory approval from CMS or other governing bodies. Null if no regulatory approval is required or if approval is pending.']
  regulatory_filing_required boolean [note: 'Indicates whether this tier structure requires submission to regulatory bodies such as CMS for approval before implementation. True for Medicare Part D plans; may be False for commercial plans.']
  retail_network_eligible boolean [note: 'Indicates whether medications in this tier can be filled at retail network pharmacies. True if retail network access is available; False if restricted to specialty or mail order only.']
  specialty_tier_flag boolean [note: 'Indicates whether this tier is designated for specialty medications, which typically have higher costs and may require special handling, distribution, or clinical management. True for specialty tiers; False otherwise.']
  step_therapy_required boolean [note: 'Indicates whether medications in this tier are subject to step therapy protocols, requiring members to try lower-cost alternatives before coverage is approved. True if step therapy applies; False otherwise.']
  termination_date date [note: 'Date when this formulary tier structure is no longer active. Null for open-ended tiers. Used for historical tracking and transition management during formulary updates.']
  tier_code varchar [note: 'Standardized code representing the formulary tier, used for system integration and claims processing. May align with NCPDP or internal coding standards.']
  tier_description varchar [note: 'Detailed explanation of the tier structure, including the types of medications covered, cost-sharing philosophy, and member guidance for understanding tier placement.']
  tier_display_order varchar [note: 'Numeric value controlling the display sequence of tiers in member-facing materials, formulary documents, and system interfaces. Lower values appear first.']
  tier_name varchar [note: 'Business-friendly name of the formulary tier that describes the category of medications and associated cost-sharing level. Common values include Generic, Preferred Brand, Non-Preferred Brand, Specialty, and Preventive.']
  tier_number varchar [note: 'Numeric sequence of the tier within the formulary structure, typically ranging from 1 (lowest cost-sharing) to 5 or 6 (highest cost-sharing). Used for ordering and display purposes.']
  tier_status varchar [note: 'Current lifecycle status of the formulary tier. Active tiers are in use for member cost-sharing; Inactive or Retired tiers are no longer applicable; Pending tiers are awaiting regulatory approval.']
  tier_version varchar [note: 'Version identifier for this tier structure configuration, used to track changes over time and manage mid-year formulary updates. Follows internal versioning conventions.']
  updated_by varchar [note: 'User identifier or system account that last modified this formulary tier record. Used for audit trail and accountability tracking.']
  updated_timestamp timestamp [note: 'Date and time when this formulary tier record was last modified. Used for audit trail, change tracking, and data synchronization.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record defining the pharmacy formulary tier structure for a health plan, establishing the cost-sharing tiers for covered medications. Captures health plan ID, formulary ID, tier number, tier name (Generic, Preferred Brand, Non-Preferred Brand, Specialty, Preventive), member copay amount, member coinsurance percentage, prior authorization requirement, step therapy requirement, quantity limit, and tier effective dates. Distinct from pharmacy.formulary which manages the drug-level formulary listing — this entity defines the tier structure and cost-sharing rules that govern member cost responsibility.'
}

Table insurance.premium_billing {
  premium_billing_id varchar [pk, note: 'Unique identifier for the premium billing invoice record. Primary key for the premium billing transaction.']
  adjusted_premium_billing_id varchar [note: 'Self-referencing FK on premium_billing (adjusted_premium_billing_id)']
  employer_group_id varchar [note: 'Reference to the employer group being billed for group health plan coverage. Null for individual or COBRA billing.']
  health_plan_id varchar [note: 'Reference to the specific health plan product for which premium is being billed.']
  payer_id varchar [note: 'Reference to the insurance payer or carrier issuing the health plan for which premium is being billed.']
  subscriber_id varchar [note: 'Reference to the individual subscriber or primary member responsible for premium payment. Null for employer group billing.']
  adjustment_amount decimal(12,2) [note: 'Any adjustments applied to the premium billing such as retroactive enrollment changes, rate corrections, or credits from prior periods. Positive for additional charges, negative for credits. Expressed in USD.']
  administrative_fee_amount decimal(12,2) [note: 'Additional administrative fee charged for premium processing, billing, or plan administration services. Expressed in USD.']
  billing_address_line1 varchar [note: 'First line of the mailing address to which premium billing invoices and statements are sent.']
  billing_address_line2 varchar [note: 'Second line of the billing mailing address for suite, apartment, or additional address details.']
  billing_city varchar [note: 'City component of the billing mailing address.']
  billing_contact_email varchar [note: 'Email address of the billing contact for electronic invoice delivery and payment correspondence.']
  billing_contact_name varchar [note: 'Name of the individual or organization contact responsible for premium payment and billing inquiries.']
  billing_contact_phone varchar [note: 'Phone number of the billing contact for premium payment inquiries and collection activities.']
  billing_country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the billing address (e.g., USA, CAN, MEX).']
  billing_due_date date [note: 'Date by which premium payment must be received to maintain active coverage and avoid grace period or lapse.']
  billing_frequency varchar [note: 'Frequency at which premium is billed to the responsible party: monthly, quarterly, semi-annually, or annually.']
  billing_period_end_date date [note: 'Last date of the coverage period for which premium is being billed.']
  billing_period_start_date date [note: 'First date of the coverage period for which premium is being billed.']
  billing_postal_code varchar [note: 'Postal code or ZIP code component of the billing mailing address.']
  billing_state varchar [note: 'State or province component of the billing mailing address. Two-letter state code for US addresses.']
  billing_status varchar [note: 'Current status of the premium billing invoice in its payment lifecycle: billed (invoice issued, payment pending), paid (fully paid), partially paid (partial payment received), delinquent (past due), lapsed (coverage terminated due to non-payment), cancelled (invoice voided), or refunded (payment returned). [ENUM-REF-CANDIDATE: billed|paid|partially_paid|delinquent|lapsed|cancelled|refunded — 7 candidates stripped; promote to reference product]']
  billing_type varchar [note: 'Classification of the premium billing arrangement indicating whether this is employer group, individual subscriber, COBRA continuation, Medicare Advantage, or Medicaid managed care billing.']
  cobra_premium_amount decimal(12,2) [note: 'Premium amount charged to COBRA participants, typically 102% of the group rate to cover administrative costs. Null for non-COBRA billing. Expressed in USD.']
  created_timestamp timestamp [note: 'Timestamp when this premium billing record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this billing record. Typically USD for US-based healthcare payers.']
  delinquency_date date [note: 'Date on which this premium billing became delinquent due to non-payment past the due date. Null if payment is current or received.']
  employee_contribution_amount decimal(12,2) [note: 'Portion of the total premium paid by the employee or subscriber through payroll deduction or direct payment. Expressed in USD.']
  employer_contribution_amount decimal(12,2) [note: 'Portion of the total premium paid by the employer group on behalf of enrolled members. Zero for individual and COBRA billing. Expressed in USD.']
  enrolled_member_count varchar [note: 'Total number of covered members (subscriber plus dependents) enrolled under this billing arrangement during the billing period.']
  grace_period_end_date date [note: 'Last date of the grace period during which coverage remains active despite non-payment. After this date, coverage may lapse. Typically 30-90 days per plan terms.']
  invoice_generated_date date [note: 'Date on which this premium billing invoice was generated and issued to the responsible party.']
  invoice_number varchar [note: 'Externally visible unique invoice number assigned to this premium billing statement for tracking and payment reconciliation.']
  invoice_sent_date date [note: 'Date on which the premium billing invoice was transmitted or mailed to the responsible party.']
  lapse_date date [note: 'Date on which health plan coverage lapsed or was terminated due to non-payment of premium. Null if coverage remains active or payment was received.']
  net_premium_due decimal(12,2) [note: 'Net premium amount due after applying all contributions, subsidies, and adjustments. This is the amount the responsible party must remit. Expressed in USD.']
  notes varchar [note: 'Free-text notes or comments regarding this premium billing invoice, such as special payment arrangements, billing disputes, or administrative annotations.']
  outstanding_balance decimal(12,2) [note: 'Remaining unpaid balance on this premium invoice after applying all payments. Zero indicates invoice is paid in full. Expressed in USD.']
  payment_amount decimal(12,2) [note: 'Total amount of premium payment received and applied to this invoice. May differ from net premium due in cases of partial payment or overpayment. Expressed in USD.']
  payment_method varchar [note: 'Method by which premium payment was received: ACH, wire transfer, check, credit card, payroll deduction, or electronic funds transfer.']
  payment_received_date date [note: 'Date on which premium payment was received and posted to the account. Null if payment has not been received.']
  payment_reference_number varchar [note: 'External reference number or transaction identifier for the premium payment, such as check number, ACH trace number, or credit card authorization code.']
  premium_rate_per_member decimal(12,2) [note: 'The per-member-per-month premium rate applied to calculate total premium for this billing period. Expressed in USD.']
  reinstatement_eligible boolean [note: 'Indicates whether the lapsed coverage is eligible for reinstatement upon payment of outstanding premium and any applicable fees. True if reinstatement is allowed per plan terms.']
  subsidy_amount decimal(12,2) [note: 'Government subsidy or premium tax credit amount applied to reduce the net premium owed by the subscriber. Applicable to exchange plans. Expressed in USD.']
  total_premium_amount decimal(12,2) [note: 'Total premium amount billed for the coverage period before applying employer or subscriber contributions. Expressed in USD.']
  updated_by varchar [note: 'User identifier or system account that last updated this premium billing record.']
  updated_timestamp timestamp [note: 'Timestamp when this premium billing record was last modified or updated.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Transactional record of premium billing invoices generated for employer groups, individual subscribers, and COBRA participants for health plan coverage. Captures billing period, employer group ID or subscriber ID, health plan ID, enrolled member count, premium rate per member, total premium billed, employer contribution amount, employee contribution amount, COBRA premium amount (102% of group rate), billing due date, payment received date, payment amount, outstanding balance, and billing status (billed, paid, partially paid, delinquent, lapsed). Supports premium revenue tracking and coverage lapse management.'
}

Table insurance.payer_contact {
  payer_contact_id varchar [pk, note: 'Unique identifier for the payer contact record. Primary key for the payer contact entity.']
  primary_payer_id varchar [note: 'Reference to the insurance payer organization this contact represents. Links to the payer master record.']
  primary_replacement_contact_payer_contact_id varchar [note: 'Reference to the payer contact record that supersedes this contact. Used to maintain continuity when contacts are replaced or reorganized.']
  accepts_electronic_submission boolean [note: 'Indicates whether this contact accepts electronic document submission via portal, EDI, or email. True when electronic methods are supported.']
  city varchar [note: 'City name for the payer contact\'s mailing address.']
  clearinghouse_name varchar [note: 'Name of the clearinghouse intermediary used for electronic transactions with this payer contact. Applicable for EDI submission workflows.']
  contact_name varchar [note: 'Full name of the individual or department contact at the payer organization. May be a person name or department name depending on contact type.']
  contact_status varchar [note: 'Current operational status of this payer contact. Indicates whether the contact is currently available and should be used for outreach.']
  contact_type varchar [note: 'Functional area or department this contact serves. Categorizes the contact by their operational responsibility within the payer organization. [ENUM-REF-CANDIDATE: claims_submission|prior_authorization|provider_relations|credentialing|network_contracting|edi_clearinghouse|appeals|member_services|utilization_management|quality_reporting|billing_inquiries|technical_support — promote to reference product]']
  country_code varchar [note: 'Three-letter ISO country code for the payer contact\'s mailing address. Primarily USA for domestic payers.']
  created_timestamp timestamp [note: 'Date and time when this payer contact record was first created in the system. Supports audit trail and data lineage tracking.']
  effective_date date [note: 'Date when this payer contact became active and available for operational use. Marks the start of the contact\'s validity period.']
  email_address varchar [note: 'Email address for electronic communication with this payer contact. Used for non-urgent inquiries, document exchange, and operational correspondence.']
  escalation_contact_flag boolean [note: 'Indicates whether this contact should be used for escalated issues or urgent matters. True for supervisory or management contacts designated for escalation workflows.']
  fax_number varchar [note: 'Fax number for document transmission to this payer contact. Commonly used for prior authorization submissions and medical records transmission.']
  hours_of_operation varchar [note: 'Business hours during which this payer contact is available for communication. Typically includes days of week and time ranges with time zone.']
  language_preference varchar [note: 'Primary language for communication with this payer contact. Supports multilingual provider relations and operational workflows.']
  last_contact_date date [note: 'Date of the most recent communication or interaction with this payer contact. Used to track contact currency and relationship maintenance.']
  last_verified_date date [note: 'Date when the contact information was last verified as accurate and current. Supports data quality and contact maintenance workflows.']
  mailing_address_line1 varchar [note: 'First line of the mailing address for this payer contact. Used for physical mail correspondence and document submission.']
  mailing_address_line2 varchar [note: 'Second line of the mailing address including suite, department, or unit information for the payer contact.']
  notes varchar [note: 'Free-text field for additional information about this payer contact. May include special instructions, communication preferences, or operational context.']
  npi varchar [note: 'National Provider Identifier for the payer organization or contact entity. Used for identification in HIPAA-compliant transactions.']
  phone_extension varchar [note: 'Telephone extension number for direct routing to the contact within the payer organization\'s phone system.']
  phone_number varchar [note: 'Primary telephone number to reach this payer contact. Used for operational outreach including claims inquiries, prior authorization submissions, and provider relations.']
  portal_login_instructions varchar [note: 'Special instructions or notes for accessing the payer portal associated with this contact. May include registration requirements or access procedures.']
  portal_url varchar [note: 'Web address for the payer\'s online portal or system associated with this contact function. Used for electronic submissions and inquiries.']
  postal_code varchar [note: 'ZIP code or postal code for the payer contact\'s mailing address. May include ZIP+4 format.']
  preferred_contact_method varchar [note: 'The payer contact\'s preferred communication channel for routine inquiries and operational workflows. Guides provider staff on optimal outreach method.']
  primary_contact_flag boolean [note: 'Indicates whether this is the primary or default contact for the specified contact type at this payer. True when this contact should be used first for the given function.']
  requires_appointment boolean [note: 'Indicates whether this contact requires scheduled appointments for meetings or calls. True when advance scheduling is necessary.']
  service_level_agreement_days varchar [note: 'Number of business days within which this contact commits to respond to inquiries or requests. Defines expected turnaround time for operational workflows.']
  state varchar [note: 'Two-letter state or territory code for the payer contact\'s mailing address. Follows USPS state abbreviation standards.']
  termination_date date [note: 'Date when this payer contact was deactivated or replaced. Null for currently active contacts. Marks the end of the contact\'s validity period.']
  termination_reason varchar [note: 'Explanation for why this payer contact was deactivated. May include staff departure, role change, department reorganization, or contact consolidation.']
  time_zone varchar [note: 'Time zone for the payer contact\'s business hours. Used to coordinate communication timing across geographic regions.']
  title varchar [note: 'Job title or role designation of the contact person within the payer organization. Provides context for the contact\'s authority and scope.']
  updated_by varchar [note: 'Identifier of the user or system process that last modified this payer contact record. Supports audit trail and accountability.']
  updated_timestamp timestamp [note: 'Date and time when this payer contact record was last modified. Tracks the most recent change to any field in the record.']
  verification_method varchar [note: 'Method used to verify the accuracy of this contact information during the last verification cycle. Documents the validation approach.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master record for operational contacts at insurance payers, capturing the individuals and departments responsible for specific payer functions. Captures payer ID, contact type (claims submission, prior authorization, provider relations, credentialing, network contracting, EDI/clearinghouse, appeals, member services), contact name, title, phone number, fax number, email address, mailing address, hours of operation, and preferred contact method. Supports operational workflows requiring payer outreach for claims resolution, PA submission, and contract negotiations.'
}

Table insurance.vbc_performance {
  vbc_performance_id varchar [pk, note: 'Unique identifier for the value-based care performance measurement record.']
  group_id varchar [note: 'Foreign key linking to provider.provider_group. Business justification: Value-based care performance is measured at provider group level for shared savings/losses, quality scores, and TCOC benchmarking. Essential for VBC settlement calculations and performance reporting. ']
  org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: VBC performance measured for organizational providers in bundled payment and episode-based arrangements (e.g., hospital joint replacement bundles). Critical for facility-level VBC settlement and quali']
  payer_contract_id varchar [note: 'Reference to the value-based care contract under which this performance is measured.']
  payer_id varchar [note: 'Reference to the insurance payer or health plan associated with this VBC performance measurement.']
  prior_vbc_performance_id varchar [note: 'Self-referencing FK on vbc_performance (prior_vbc_performance_id)']
  quality_program_id varchar [note: 'Foreign key linking to quality.quality_program. Business justification: VBC performance is measured against quality programs (MIPS, MSSP, Hospital VBP). Quality program defines the measure set, scoring methodology, and payment adjustment formula for VBC contracts.']
  settlement_cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Value-based care shared savings and losses are allocated to specific cost centers for performance reporting, budget variance analysis, and departmental accountability. Finance teams track VBC settleme']
  adjustment_reason varchar [note: 'Explanation for any adjustments made to the performance calculation or settlement amounts after initial calculation.']
  attributed_member_count varchar [note: 'The total number of health plan members attributed to the provider organization for this performance period under the VBC contract.']
  benchmark_tcoc_amount decimal(18,2) [note: 'The target or benchmark total cost of care established by the payer for the attributed population, used to calculate savings or losses.']
  calculation_methodology varchar [note: 'Description of the methodology used to calculate performance metrics, savings, and quality scores for this measurement period.']
  created_timestamp timestamp [note: 'The date and time when this VBC performance record was first created in the system.']
  data_completeness_score decimal(5,2) [note: 'A score representing the completeness and quality of data submitted for performance measurement, expressed as a percentage.']
  dispute_date date [note: 'The date on which the provider organization formally disputed the performance settlement.']
  dispute_flag boolean [note: 'Indicates whether the provider organization has disputed the performance calculation or settlement amounts.']
  dispute_resolution_date date [note: 'The date on which the dispute was resolved between the payer and provider organization.']
  measurement_year varchar [note: 'The calendar year in which the performance measurement period falls, used for reporting and trending.']
  notes varchar [note: 'Additional notes, comments, or context regarding this VBC performance measurement record.']
  performance_period_end_date date [note: 'The ending date of the measurement period for this VBC performance evaluation.']
  performance_period_start_date date [note: 'The beginning date of the measurement period for this VBC performance evaluation.']
  performance_year_type varchar [note: 'The type of year used for performance measurement: calendar year, contract year, or benefit year.']
  quality_measure_set varchar [note: 'The specific set of quality measures used to evaluate performance (e.g., HEDIS, MIPS, ACO quality measures).']
  quality_score decimal(5,2) [note: 'The composite quality performance score achieved during the measurement period, typically expressed as a percentage or points out of 100.']
  quality_withhold_amount decimal(18,2) [note: 'The dollar amount withheld by the payer from shared savings distribution pending achievement of quality performance thresholds.']
  quality_withhold_earned_amount decimal(18,2) [note: 'The portion of the quality withhold amount earned back by the provider organization based on achieved quality performance.']
  quality_withhold_forfeited_amount decimal(18,2) [note: 'The portion of the quality withhold amount forfeited due to failure to meet quality performance thresholds.']
  reconciliation_period varchar [note: 'The frequency at which performance is measured and reconciled under the VBC contract: quarterly, semi-annual, or annual.']
  reporting_entity varchar [note: 'The name or identifier of the entity responsible for reporting this VBC performance data (e.g., ACO, medical group, hospital system).']
  risk_arrangement_type varchar [note: 'The type of financial risk arrangement under the VBC contract: one-sided (upside only), two-sided (upside and downside), or other risk-sharing model.']
  risk_corridor_applied_flag boolean [note: 'Indicates whether risk corridor provisions were applied to limit the provider organization\'s financial exposure to savings or losses.']
  risk_corridor_lower_threshold_amount decimal(18,2) [note: 'The minimum savings or loss amount that must be achieved before shared savings or losses are triggered, as defined in the contract.']
  risk_corridor_upper_threshold_amount decimal(18,2) [note: 'The maximum savings or loss amount beyond which additional savings or losses are capped or shared at a different rate.']
  savings_loss_amount decimal(18,2) [note: 'The calculated difference between benchmark TCOC and actual TCOC. Positive values indicate savings; negative values indicate losses.']
  settlement_approval_date date [note: 'The date on which the settlement calculation was approved by both the payer and provider organization for payment processing.']
  settlement_calculation_date date [note: 'The date on which the performance settlement amounts were calculated by the payer or third-party administrator.']
  settlement_payment_date date [note: 'The date on which the shared savings distribution or loss payment was processed and funds were transferred.']
  settlement_payment_method varchar [note: 'The method used to transfer settlement funds: electronic funds transfer (EFT), check, wire transfer, or offset against other payments.']
  settlement_status varchar [note: 'The current status of the performance settlement process: pending calculation, calculated, approved for payment, paid, disputed, or adjusted.']
  shared_loss_amount decimal(18,2) [note: 'The dollar amount of losses for which the provider organization is financially responsible under a two-sided risk arrangement.']
  shared_loss_percentage decimal(5,2) [note: 'The percentage of total losses for which the provider organization is responsible as defined in the VBC contract terms.']
  shared_savings_distribution_amount decimal(18,2) [note: 'The final dollar amount of shared savings distributed to the provider organization after applying quality adjustments and risk corridor rules.']
  shared_savings_percentage decimal(5,2) [note: 'The percentage of total savings shared with the provider organization as defined in the VBC contract terms.']
  stop_loss_applied_flag boolean [note: 'Indicates whether stop-loss provisions were triggered to limit the provider organization\'s financial exposure to catastrophic losses.']
  stop_loss_threshold_amount decimal(18,2) [note: 'The maximum loss amount the provider organization is responsible for before stop-loss protection is activated.']
  total_cost_of_care_amount decimal(18,2) [note: 'The actual total cost of care incurred for attributed members during the performance period, including all medical and pharmacy claims.']
  updated_by varchar [note: 'The user or system identifier that last modified this VBC performance record.']
  updated_timestamp timestamp [note: 'The date and time when this VBC performance record was last modified in the system.']
  vibe_mutation_marker varchar

  Note: 'Transactional record capturing performance measurement results under value-based care (VBC) contracts, including shared savings calculations, quality measure performance, and risk pool settlements. Captures contract ID, payer ID, performance period, attributed member count, total cost of care (TCOC), benchmark TCOC, savings/loss amount, quality score, quality withhold earned/forfeited, shared savings distribution amount, risk corridor application, settlement status, and settlement payment date. Supports VBC contract performance monitoring, shared savings reconciliation, and population health financial management.'
}

Table insurance.member_attribution {
  member_attribution_id varchar [pk, note: 'Unique identifier for the member attribution record. Primary key for this transactional entity tracking value-based care and ACO attribution assignments.']
  attribution_cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Attributed member panels drive cost center revenue forecasting and budget planning in capitated and value-based arrangements. Finance teams use attribution data to allocate capitation revenue, forecas']
  care_team_id varchar [note: 'Identifier for the care team to which the member is attributed, if attribution is at the team level rather than individual provider level.']
  health_plan_id varchar [note: 'Identifier for the specific health plan under which the member is attributed.']
  payer_contract_id varchar [note: 'Identifier for the value-based care, ACO, or managed care contract governing this attribution. May reference capitation or VBC contract.']
  payer_id varchar [note: 'Identifier for the insurance payer responsible for this attribution arrangement.']
  prior_member_attribution_id varchar [note: 'Self-referencing FK on member_attribution (prior_member_attribution_id)']
  quality_program_id varchar [note: 'Foreign key linking to quality.quality_program. Business justification: Member attribution determines which provider is accountable for quality program performance (ACO, PCMH, VBC). Attribution method and eligibility criteria are defined by the quality program.']
  subscriber_id varchar [note: 'Unique identifier for the health plan member being attributed. Links to the member master data.']
  visit_id varchar [note: 'Foreign key linking to encounter.visit. Business justification: Attribution algorithms use visit patterns (plurality of care) to assign members to providers. Performance measurement and shared savings calculations require linking attribution records to specific en']
  assignment_reason varchar [note: 'Free-text or coded reason explaining why the member was attributed to this provider. Examples include highest visit count, patient selection, geographic proximity, or continuity of care.']
  attributed_provider_npi varchar [note: 'National Provider Identifier of the attributed primary care provider. Ten-digit unique identifier assigned by CMS.']
  attribution_algorithm_version varchar [note: 'Version identifier of the attribution algorithm or business rules used to calculate this attribution assignment. Used for audit trail and reproducibility.']
  attribution_change_reason varchar [note: 'Reason for change in attribution from previous provider to current provider. Examples include member request, provider termination, change in utilization pattern, or annual re-attribution.']
  attribution_confidence_score decimal(5,2) [note: 'Numeric score representing the confidence level or strength of the attribution assignment, typically ranging from 0.00 to 100.00. Higher scores indicate stronger attribution based on visit frequency, continuity of care, or other factors.']
  attribution_effective_date date [note: 'Date when the member attribution assignment becomes effective and the attributed provider assumes responsibility for care coordination and performance measurement.']
  attribution_end_date date [note: 'Date when the member attribution assignment ends. Null for open-ended attributions. May be populated due to member disenrollment, provider termination, or contract end.']
  attribution_lock_date date [note: 'Date when the attribution assignment was locked for the performance year and can no longer be changed. Used to ensure stable attribution for performance measurement.']
  attribution_method varchar [note: 'Method used to assign the member to the attributed provider. Prospective attribution occurs before the performance period; retrospective attribution occurs after using claims data; voluntary attribution is patient-selected; claims-based uses utilization patterns; enrollment-based uses plan enrollment data; patient-designated is explicit patient choice; hybrid combines multiple methods. [ENUM-REF-CANDIDATE: prospective|retrospective|voluntary|claims_based|enrollment_based|patient_designated|hybrid — 7 candidates stripped; promote to reference product]']
  attribution_period_end_date date [note: 'End date of the measurement period used to calculate the attribution assignment. Typically the end of the performance year or lookback period.']
  attribution_period_start_date date [note: 'Start date of the measurement period used to calculate the attribution assignment. Typically the beginning of the performance year or lookback period.']
  attribution_source varchar [note: 'Source system or method that generated the attribution assignment. Claims-based uses historical utilization; enrollment-based uses plan enrollment data; patient-designated is explicit patient selection; provider-roster uses provider panel lists; ACO-assignment is CMS ACO attribution; manual-override is administrative assignment; system-calculated is algorithmic. [ENUM-REF-CANDIDATE: claims_based|enrollment_based|patient_designated|provider_roster|aco_assignment|manual_override|system_calculated — 7 candidates stripped; promote to reference product]']
  attribution_status varchar [note: 'Current lifecycle status of the attribution assignment. Active indicates the attribution is currently in effect; inactive indicates it is no longer valid; pending indicates it is awaiting approval or effective date; terminated indicates it was ended; suspended indicates temporary hold.']
  attribution_type varchar [note: 'Type of value-based care or managed care program under which the attribution is made. ACO is Accountable Care Organization; MSSP is Medicare Shared Savings Program; NextGen ACO is Next Generation ACO Model; managed care is HMO/PPO attribution; capitation is capitated payment model; VBC is value-based care contract; PCMH is Patient-Centered Medical Home; bundled payment is episode-based attribution. [ENUM-REF-CANDIDATE: aco|mssp|nextgen_aco|managed_care|capitation|vbc|pcmh|bundled_payment — 8 candidates stripped; promote to reference product]']
  capitation_amount decimal(12,2) [note: 'Per-member per-month (PMPM) or per-member per-year (PMPY) capitation payment amount for this attributed member under the contract. Null if the contract is not capitated.']
  capitation_frequency varchar [note: 'Frequency at which capitation payments are made for this attributed member. Monthly is per-member per-month; quarterly is per-member per-quarter; annually is per-member per-year.']
  county_code varchar [note: 'Five-digit FIPS county code where the member resides. Used for county-level performance reporting and geographic analysis.']
  created_timestamp timestamp [note: 'Timestamp when this attribution record was first created in the system. Used for audit trail and data lineage.']
  geographic_service_area varchar [note: 'Geographic region or service area code where the member resides and receives care. Used for network adequacy and regional performance reporting.']
  notes varchar [note: 'Free-text notes or comments about this attribution assignment. Used for documenting special circumstances, manual overrides, or additional context.']
  opt_out_date date [note: 'Date when the member opted out of attribution or data sharing. Null if opt-out indicator is false.']
  opt_out_indicator boolean [note: 'Boolean flag indicating whether the member has opted out of attribution or data sharing for performance measurement. True indicates opt-out; false indicates consent.']
  performance_year varchar [note: 'Calendar year for which this attribution is used for performance measurement and shared savings calculation. Four-digit year (e.g., 2023).']
  plurality_of_care_indicator boolean [note: 'Boolean flag indicating whether the attributed provider delivered a plurality (most) of the member\'s primary care services during the measurement period. True indicates plurality was met; false indicates it was not.']
  primary_care_visit_count varchar [note: 'Number of primary care visits the member had with the attributed provider during the attribution measurement period. Used to calculate plurality and attribution strength.']
  quality_measure_set varchar [note: 'Name or identifier of the quality measure set applicable to this attribution for performance measurement. Examples include MSSP quality measures, HEDIS measures, or custom contract measures.']
  risk_score decimal(6,3) [note: 'Hierarchical Condition Category (HCC) risk score or other risk adjustment score for the member at the time of attribution. Used for risk-adjusted performance measurement and capitation payment calculation.']
  shared_savings_eligible boolean [note: 'Boolean flag indicating whether this attributed member is eligible for inclusion in shared savings calculations. True indicates eligible; false indicates excluded (e.g., due to insufficient claims history or enrollment duration).']
  state_code varchar [note: 'Two-letter US state code where the member resides. Used for state-level reporting and regulatory compliance.']
  tin varchar [note: 'Tax Identification Number of the provider organization or practice to which the member is attributed. Used for payment and performance reporting at the TIN level.']
  total_visit_count varchar [note: 'Total number of primary care visits the member had with all providers during the attribution measurement period. Used to calculate plurality percentage.']
  updated_by varchar [note: 'User ID or system identifier of the person or process that last updated this attribution record. Used for audit trail and accountability.']
  updated_timestamp timestamp [note: 'Timestamp when this attribution record was last updated. Used for audit trail and change tracking.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Transactional record of member attribution assignments under value-based care, ACO, and managed care contracts, linking members to a responsible primary care provider or care team for performance measurement and capitation purposes. Captures member ID, payer ID, health plan ID, capitation or VBC contract ID, attributed PCP NPI, attribution method (prospective, retrospective, voluntary), attribution effective date, attribution end date, attribution confidence score, plurality of care indicator, and attribution source (claims-based, enrollment-based, patient-designated). SSOT for VBC attributed population management.'
}

Table insurance.insurance_payer_enrollment {
  insurance_payer_enrollment_id varchar [pk, note: 'Primary key for the payer_enrollment association']
  ar_account_id varchar [note: 'Foreign key linking to finance.ar_account. Business justification: Payer enrollments enable revenue collection; AR accounts track receivables by payer. Links enrollment status to AR aging for collectability analysis, payer performance tracking, and revenue cycle opti']
  care_site_id varchar [note: 'Facility where the provider is enrolled with the payer, as enrollment is often site-specific.']
  clinician_id varchar [note: 'Foreign key linking to the clinician enrolled with this payer']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Payer enrollment activities incur costs (application fees, credentialing services, staff time) tracked by cost center for revenue cycle budgeting and enrollment cost-per-payer analysis.']
  credentialing_application_id varchar [note: 'FK to the credentialing application submitted to this payer; links enrollment to the credentialing workflow.']
  fee_schedule_id varchar [note: 'Fee schedule applicable to this enrollment']
  health_plan_id varchar [note: 'Specific health plan within the payer that the provider is enrolled in.']
  insurance_edi_payer_id varchar [note: 'EDI payer ID for electronic claims submission']
  insurance_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Payer enrollment for employed providers billing under organizational NPIs. Real business need: revenue cycle - ensuring employed clinicians can bill, tracking enrollment status for compensation/produc']
  insurance_enrollment_coordinator_employee_id varchar [note: 'FK to the employee managing this enrollment; supports workflow assignment and accountability.']
  insurance_enrollment_owner_employee_id varchar [note: 'Re-derived attribute added during thin-product expansion based on business context for workforce.insurance_payer_enrollment.']
  insurance_payer_contract_id varchar [note: 'The identifier of the payer contract or fee schedule agreement associated with this enrollment. Links the enrollment to the specific contractual terms governing reimbursement rates and billing rules. Sourced from Symplr or the payer contracting system.']
  insurance_payer_id varchar [note: 'Foreign key linking to the payer with whom the clinician is enrolled']
  org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: Organizational providers enroll with payers separately from individual clinicians. FK will be NULL for clinician-only enrollments. No redundant columns to remove.']
  payer_contract_id varchar [note: 'Associated payer contract for this enrollment']
  provider_location_id varchar [note: 'Reference to the specific practice location or facility address associated with this payer enrollment. A provider may have multiple enrollments at different locations with the same payer. Links to the facility or location master entity.']
  provider_network_id varchar [note: 'Network the provider participates in under this enrollment.']
  reference_npi_registry_id varchar [note: 'Foreign key linking to reference.npi_registry. Business justification: Payer enrollment validation requires NPI registry verification for active status, taxonomy code accuracy, and practice location matching. Healthcare operations perform monthly NPI validation during re']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Payer enrollment is specialty-specific. payer_enrollment.specialty_code should reference specialty table as authoritative source.']
  taxonomy_id varchar [note: 'Foreign key linking to provider.provider_taxonomy. Business justification: Payer enrollment\'s taxonomy code should reference provider_taxonomy table. Removes taxonomy_code STRING.']
  accepting_new_patients_flag boolean [note: 'Whether the provider is currently accepting new patients under this payer enrollment.']
  appeal_date date [note: 'Date appeal was filed']
  appeal_decision varchar [note: 'Decision on appeal (approved, denied, partially approved)']
  appeal_decision_date date [note: 'Date appeal decision was made']
  appeal_filed_flag boolean [note: 'Flag indicating whether an appeal was filed for denial']
  application_approved_date date [note: 'Date the payer approved the enrollment application; used for enrollment processing time reporting.']
  application_date date [note: 'Date when the enrollment application was submitted to the payer.']
  application_method varchar [note: 'Method of application (CAQH, payer portal, paper application, PECOS for Medicare)']
  application_reference_number varchar [note: 'Payer-assigned reference number for the enrollment application; used for status inquiries and follow-up.']
  application_submitted_date date [note: 'The date on which the provider enrollment application was formally submitted to the payer. Used to track application processing timelines, SLA compliance, and identify delayed enrollments impacting revenue.']
  approval_date date [note: 'The date on which the payer formally approved the provider\'s enrollment application. May differ from the effective date if retroactive enrollment is granted. Used for lifecycle tracking and RCM gap analysis.']
  billing_npi varchar [note: 'The NPI used specifically for billing purposes under this enrollment, which may be the group/organizational NPI rather than the rendering provider\'s individual NPI. Determines the pay-to entity on claims.']
  capitation_rate decimal(10,2) [note: 'Per-member-per-month capitation rate if applicable']
  caqh_provider_number varchar [note: 'CAQH provider ID used for credentialing']
  claims_runout_period_days varchar [note: 'Claims runout period after termination in days']
  claims_submission_method varchar [note: 'Method for claims submission (EDI, payer portal, clearinghouse, paper)']
  clearinghouse_code varchar [note: 'Clearinghouse used for claims submission']
  created_timestamp timestamp [note: 'The timestamp when this payer enrollment record was first created in the source system (Symplr). Represents the audit trail creation event. Formatted as yyyy-MM-ddTHH:mm:ss.SSSXXX per platform convention.']
  credentialing_completion_date date [note: 'Date payer credentialing was completed']
  credentialing_decision varchar [note: 'Credentialing decision (approved, denied, approved with restrictions, pending additional information)']
  credentialing_decision_date date [note: 'Date credentialing decision was made']
  credentialing_expiration_date date [note: 'The date on which the provider\'s credentialing with this payer expires and must be renewed. Payer credentialing typically requires renewal every 2-3 years. Expiration without renewal may result in claims denial.']
  credentialing_restrictions varchar [note: 'Restrictions placed on credentialing (e.g., limited to specific procedures, requires supervision)']
  credentialing_start_date date [note: 'Date payer credentialing process began']
  credentialing_status varchar [note: 'Status of the payer-specific credentialing review for this clinician. Distinct from the clinician\'s internal credentialing_status - this reflects the payer\'s own credentialing decision.']
  credentialing_tier varchar [note: 'Payer-assigned credentialing tier that may affect reimbursement rates, network designation, or quality incentive eligibility. Tier classifications vary by payer but generally reflect quality metrics, board certification, and practice standards. Sourced from Symplr credentialing module.']
  dea_number varchar [note: 'DEA registration number of the provider, required for enrollment with payers that cover controlled substance prescribing. Format: two letters followed by seven digits. Sensitive identifier subject to DEA regulatory oversight.']
  delegation_flag boolean [note: 'Whether credentialing for this enrollment is delegated to the provider organization.']
  denial_reason varchar [note: 'Reason provided by the payer if the enrollment application was denied.']
  edi_submitter_code varchar [note: 'The EDI submitter identifier assigned by the payer for electronic claims submission (HIPAA 837 transactions) under this enrollment. Required for electronic billing setup and clearinghouse routing.']
  effective_date date [note: 'Date on which this clinician\'s enrollment with this payer became or will become active for billing purposes.']
  eft_enrolled boolean [note: 'Indicates whether the provider has enrolled in Electronic Funds Transfer (EFT) with this payer for direct deposit of claim payments. EFT enrollment is required by CMS for Medicare providers under the ACA. True = EFT active; False = paper check.']
  enrollment_age_days varchar [note: 'Re-derived attribute added during thin-product expansion based on business context for insurance.insurance_payer_enrollment.']
  enrollment_category varchar [note: 'Category of enrollment (participating provider, non-participating, opt-out, limited participation)']
  enrollment_notes varchar [note: 'Free-text notes about enrollment terms or special conditions']
  enrollment_number varchar [note: 'Unique identifier assigned by the payer to this specific clinician enrollment. Used in claim submissions and eligibility verification.']
  enrollment_source varchar [note: 'The system or channel through which the enrollment application was submitted. \'Symplr\' indicates submission via the Symplr provider enrollment module. \'PECOS\' indicates direct submission via CMS Provider Enrollment, Chain, and Ownership System. Used for data lineage and process analytics.']
  enrollment_status varchar [note: 'Current lifecycle status of this clinician\'s enrollment with this specific payer. Determines billing eligibility and claim submission rights.']
  enrollment_type varchar [note: 'Indicates the nature of the provider\'s participation agreement with the payer. \'Participating\' providers accept payer-negotiated rates as payment in full. \'Non-participating\' providers may balance-bill patients. \'Opt-out\' applies to Medicare providers who have formally opted out. \'Reassignment\' indicates benefits are reassigned to a group or facility.']
  exclusion_check_date date [note: 'Date of the most recent OIG/SAM exclusion check for this provider-payer combination; required for compliance.']
  exclusion_check_status varchar [note: 'Result of the most recent exclusion check (e.g., Clear, Excluded, Pending); triggers enrollment suspension if excluded.']
  fee_schedule_assignment varchar [note: 'Fee schedule tier or category assigned to this provider by the payer.']
  group_enrollment_number varchar [note: 'Identifier linking the clinician enrollment to a group or reassignment enrollment.']
  group_npi varchar [note: 'The 10-digit NPI of the group practice or organizational entity under which the individual provider is enrolled with this payer. Relevant for reassignment of benefits and group billing scenarios. Distinct from the individual provider\'s NPI.']
  last_credentialing_update_date date [note: 'Date of most recent credentialing information update']
  last_recredentialing_date date [note: 'Date of the most recent successful recredentialing with this payer.']
  last_revalidation_date date [note: 'Date of most recent revalidation']
  last_roster_submission_date date [note: 'Date of last roster submission']
  license_state varchar [note: 'Two-letter US state abbreviation for the state in which the provider holds the license submitted for this enrollment. Used to validate licensure jurisdiction against the payer\'s service area.']
  medicaid_enrolled_flag boolean [note: 'Whether provider is enrolled in Medicaid']
  medicaid_provider_number varchar [note: 'State-assigned Medicaid provider identification number issued upon successful Medicaid enrollment. Required for Medicaid claims submission. Varies by state Medicaid program. Null for non-Medicaid enrollments.']
  medicare_opt_out_flag boolean [note: 'Whether provider has opted out of Medicare']
  medicare_provider_number varchar [note: 'Medicare provider ID (PTAN or other)']
  network_status varchar [note: 'Indicates whether the provider is currently in-network or out-of-network with this payer. In-network status means the provider has a contracted rate agreement. Critical for patient cost-sharing calculations, referral management, and network adequacy reporting.']
  network_tier varchar [note: 'The network participation tier assigned to this clinician by this payer. Determines reimbursement rates and patient cost-sharing levels.']
  notes varchar [note: 'Free-text field for enrollment coordinators to capture supplemental information, payer-specific instructions, follow-up actions, or exceptions related to this enrollment record. Not used for structured data. Sourced from Symplr enrollment notes field.']
  notice_period_days varchar [note: 'Notice period in days for termination']
  npi varchar [note: 'National Provider Identifier used for this enrollment.']
  oig_exclusion_check_date date [note: 'The most recent date on which the provider was screened against the OIG List of Excluded Individuals and Entities (LEIE). CMS mandates monthly screening for all enrolled providers. Used for compliance audit documentation.']
  oig_exclusion_checked boolean [note: 'Indicates whether the provider has been verified against the OIG List of Excluded Individuals and Entities (LEIE) as part of the enrollment process. CMS requires monthly OIG exclusion screening. True = checked and cleared; False = not yet checked.']
  ordering_referring_enrolled_flag boolean [note: 'Indicates enrollment as an ordering/referring provider; required for CMS ordering and referring provider validation.']
  panel_status varchar [note: 'Status of the providers patient panel for this payer (e.g., open, closed, limited).']
  par_status varchar [note: 'Participating provider status (e.g., participating, non-participating, out-of-network).']
  participating_provider_flag boolean [note: 'Indicates if provider is participating (in-network) with this payer']
  pay_to_address_line1 varchar [note: 'Primary street address to which the payer remits payments (Electronic Remittance Advice / ERA and paper checks) for claims submitted under this enrollment. May differ from the service address.']
  payer_plan_name varchar [note: 'Name of the specific insurance plan or product line within the payer organization for which the provider is enrolled (e.g., \'Medicare Part B\', \'Medicaid Managed Care\', \'PPO Gold Plan\'). A single payer may have multiple plans requiring separate enrollments.']
  payer_portal_username varchar [note: 'Username for payer portal access']
  payer_provider_number varchar [note: 'Payer-specific provider identifier']
  payer_type varchar [note: 'Classification of the payer by program type. Drives billing rules, fee schedules, and regulatory requirements. [ENUM-REF-CANDIDATE: Medicare|Medicaid|Commercial|Tricare|Marketplace|Workers_Compensation|Other — promote to reference product]']
  pecos_enrollment_number varchar [note: 'PECOS enrollment ID for Medicare enrollment']
  prescribing_enrolled_flag boolean [note: 'Indicates whether the provider is enrolled for prescribing privileges under this payer (relevant for Part D).']
  provider_type varchar [note: 'Indicates whether the enrollment is for an individual clinician (physician, NP, PA), a group practice, a facility (hospital, clinic), or an ancillary service provider (lab, imaging center). Determines the applicable enrollment form (CMS-855I, CMS-855B, CMS-855A) and billing rules.']
  ptan varchar [note: 'CMS-issued PTAN (Provider Transaction Access Number) for Medicare billing. Specific to this clinician-payer enrollment relationship.']
  quality_incentive_eligible_flag boolean [note: 'Whether provider is eligible for quality incentive payments']
  recredentialing_due_date date [note: 'Date by which recredentialing must be completed to maintain active enrollment status.']
  reimbursement_method varchar [note: 'Reimbursement method (fee-for-service, capitation, bundled, value-based)']
  rendering_npi varchar [note: 'Rendering NPI for this enrollment']
  retroactive_effective_date date [note: 'Backdated effective date if payer granted retroactive enrollment for claims filing purposes.']
  revalidation_due_date date [note: 'The date by which the provider must complete CMS-mandated revalidation of their Medicare or Medicaid enrollment to maintain active billing privileges. Failure to revalidate results in deactivation. Sourced from CMS revalidation lookup and Symplr tracking.']
  risk_arrangement varchar [note: 'Risk arrangement (full-risk, shared-risk, no-risk)']
  roster_submission_frequency varchar [note: 'Frequency of roster submission (monthly, quarterly, annually)']
  roster_submission_required_flag boolean [note: 'Whether provider must submit patient roster']
  sam_exclusion_checked boolean [note: 'Indicates whether the provider has been verified against the federal SAM.gov exclusions database (formerly EPLS) as part of enrollment compliance screening. Required for providers participating in federally-funded programs. True = checked and cleared; False = not yet checked.']
  service_address_line1 varchar [note: 'Primary street address of the practice location where services are rendered under this enrollment. Submitted to the payer for network directory listings and claims adjudication. Required for CMS enrollment forms.']
  service_city varchar [note: 'City of the practice location where services are rendered under this enrollment. Used for network directory, geographic network adequacy analysis, and payer service area validation.']
  service_state varchar [note: 'Two-letter US state abbreviation for the state where services are rendered under this enrollment. Used for state-specific billing rules, Medicaid jurisdiction, and network adequacy reporting.']
  service_zip_code varchar [note: 'ZIP code of the practice location where services are rendered under this enrollment. Used for geographic network adequacy analysis, payer locality-based fee schedule assignment, and CMS Geographic Practice Cost Index (GPCI) determination.']
  specialty_enrolled varchar [note: 'Specialty or specialties for which provider is enrolled']
  ssot_canonical_reference varchar [note: 'Fully-qualified reference to the canonical SSOT table that supersedes this duplicate concept.']
  ssot_reconciliation_status varchar [note: 'SSOT reconciliation status indicating this product was reconciled against its canonical source-of-truth table.']
  state_license_number varchar [note: 'The state-issued medical or professional license number of the provider as submitted in the enrollment application. Payers verify active licensure as part of credentialing. May differ from the license number in the provider master if enrollment is in a different state.']
  submission_date date [note: 'Date the enrollment application was submitted to the payer.']
  tax_identification_number varchar [note: 'Federal Tax Identification Number (TIN) or Employer Identification Number (EIN) associated with the enrolling provider or group practice. Used for payer remittance, 1099 reporting, and claims adjudication. Sensitive financial identifier.']
  taxonomy_code_enrolled varchar [note: 'Taxonomy code(s) under which provider is enrolled']
  telehealth_enrolled_flag boolean [note: 'Indicates whether the provider is enrolled to deliver telehealth services under this payer enrollment.']
  termination_date date [note: 'Date on which this clinician\'s enrollment with this payer ended or will end. Null for active enrollments.']
  termination_initiated_by varchar [note: 'Party who initiated termination (provider, payer, mutual agreement)']
  termination_notice_date date [note: 'Date termination notice was given']
  termination_notice_period_days varchar [note: 'Notice period required for termination in days']
  termination_reason varchar [note: 'The reason code for enrollment termination. \'Voluntary_withdrawal\' indicates provider-initiated termination. \'Payer_initiated\' indicates the payer terminated the enrollment. \'Sanction\' indicates OIG or CMS exclusion. Required for compliance reporting and audit trails. Null for active enrollments. [ENUM-REF-CANDIDATE: voluntary_withdrawal|payer_initiated|non_renewal|sanction|death|retirement|other — promote to reference product]']
  tin varchar [note: 'Tax identification number used for billing']
  updated_timestamp timestamp [note: 'The timestamp when this payer enrollment record was most recently modified in the source system (Symplr). Used for change detection, incremental ETL processing, and audit trail maintenance. Formatted as yyyy-MM-ddTHH:mm:ss.SSSXXX per platform convention.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_enriched_flag boolean [note: 'Re-derived attribute added during thin-product expansion based on business context for insurance.insurance_payer_enrollment.']

  Note: 'This association product represents the enrollment relationship between a clinician and an insurance payer. It captures the operational enrollment status, credentialing requirements, network participation tier, and provider-specific identifiers (PTAN, enrollment number) that exist only in the context of this clinician-payer relationship. Each record links one clinician to one payer with attributes that govern billing eligibility, claim submission rights, and network participation terms.. Existence Justification: In healthcare operations, clinicians must enroll with multiple insurance payers (Medicare, Medicaid, commercial plans) to bill for services, and each payer maintains enrollment relationships with thousands of clinicians across their network. The enrollment relationship is an operational business entity actively managed by credentialing and billing departments, with payer-specific identifiers (PTAN, enrollment numbers), credentialing approvals, network tier assignments, and lifecycle status tracking.'
}

Table insurance.payer_compliance_requirement {
  payer_compliance_requirement_id varchar [pk, note: 'Unique identifier for this payer-program compliance requirement record. Primary key.']
  compliance_program_id varchar [note: 'Foreign key linking to the compliance program that governs this payer relationship']
  payer_id varchar [note: 'Foreign key linking to the payer subject to this compliance program']
  audit_frequency varchar [note: 'Frequency at which compliance audits specific to this payer-program combination must be conducted. May be driven by payer contract terms or regulatory requirements specific to the payer type (e.g., Medicare requires annual HIPAA audits).']
  compliance_status varchar [note: 'Current compliance status for this payer under this program. Tracks whether the organization is meeting all requirements for this specific payer-program combination.']
  findings_count varchar [note: 'Number of open compliance findings or deficiencies identified for this payer under this program. Used to track remediation progress.']
  last_audit_date date [note: 'Date of the most recent compliance audit conducted for this specific payer-program combination.']
  last_report_date date [note: 'Date when the most recent compliance report was submitted for this payer-program combination.']
  last_status_change_date date [note: 'Date when the compliance_status was last updated for this payer-program combination.']
  next_audit_date date [note: 'Scheduled date for the next compliance audit for this payer-program combination, calculated based on audit_frequency and last_audit_date.']
  next_report_due_date date [note: 'Date by which the next compliance report must be submitted for this payer-program combination.']
  notes varchar [note: 'Free-text notes capturing additional context, historical issues, or special considerations for this payer-program compliance relationship.']
  payer_program_scope varchar [note: 'Detailed description of how this compliance program applies specifically to this payer relationship. May include specific service lines, facilities, or transaction types covered (e.g., \'Applies to all Medicare Advantage claims submitted through EDI; excludes paper claims\').']
  payer_specific_requirements varchar [note: 'Free-text field capturing any additional compliance requirements, attestations, certifications, or documentation that this specific payer requires beyond the standard program requirements. Examples: \'Payer requires quarterly attestation from Chief Compliance Officer\', \'Annual HIPAA certification required for provider portal access\'.']
  program_effective_date date [note: 'Date when this compliance program became applicable to this specific payer relationship. May differ from the general program effective date if the payer contract was signed later or requirements phased in.']
  program_expiration_date date [note: 'Date when this compliance program ceases to apply to this payer, typically aligned with contract termination or regulatory sunset provisions.']
  reporting_frequency varchar [note: 'Frequency at which compliance reports must be submitted to this payer or regulatory body overseeing this payer relationship.']
  reporting_requirements varchar [note: 'Detailed description of compliance reporting obligations specific to this payer under this program. Includes report types, submission frequency, recipient (payer, CMS, state agency), and format requirements.']
  responsible_party varchar [note: 'Name or identifier of the individual or department responsible for ensuring compliance with this program for this specific payer relationship. May be a payer relationship manager, compliance officer, or department head.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'This association product represents the compliance obligations between a specific payer relationship and a compliance program. It captures payer-specific compliance requirements, audit schedules, reporting obligations, and program scope as they apply to each unique payer-program combination. Each record links one compliance program to one payer with attributes that exist only in the context of this regulatory relationship.. Existence Justification: Healthcare organizations must apply multiple compliance programs (HIPAA, Stark Law, Anti-Kickback, False Claims Act, Medicare Conditions of Participation) across their entire payer portfolio, and each payer relationship is governed by multiple overlapping compliance programs. The compliance requirements, audit schedules, reporting obligations, and program scope vary by payer type (Medicare vs. commercial vs. Medicaid) and by specific contract terms, creating a genuine many-to-many operational relationship that compliance teams actively manage.'
}

Table insurance.plan_consent_requirement {
  plan_consent_requirement_id varchar [pk, note: 'Unique identifier for this plan consent requirement record. Primary key.']
  form_template_id varchar [note: 'Foreign key linking to the consent form template required by this health plan']
  health_plan_id varchar [note: 'Foreign key linking to the health insurance plan that has this consent requirement']
  created_date timestamp [note: 'Timestamp when this plan consent requirement record was created in the system.']
  effective_date date [note: 'Date when this consent form became required for this health plan. Typically aligns with benefit year start, regulatory change effective date, or plan amendment date.']
  enrollment_trigger_flag boolean [note: 'Indicates whether this consent form must be presented and completed during the initial enrollment process for this health plan. True means the form is part of the enrollment workflow.']
  last_updated_by varchar [note: 'User ID or system identifier of the person or process that last modified this plan consent requirement record.']
  last_updated_date timestamp [note: 'Timestamp when this plan consent requirement record was last modified.']
  mandatory_flag boolean [note: 'Indicates whether this consent form is mandatory (true) or optional (false) for members of this health plan. Mandatory forms must be completed before enrollment can be finalized or services accessed.']
  renewal_trigger_flag boolean [note: 'Indicates whether this consent form must be re-presented and re-signed during annual plan renewal. True means members must re-consent each benefit year.']
  requirement_basis varchar [note: 'The legal or business basis for why this consent form is required for this plan. Values: federal_regulation (HIPAA, ACA mandate), state_law (state-specific consent requirements), plan_policy (payer business rule), payer_requirement (employer group requirement), accreditation_standard (NCQA, URAC requirement).']
  requirement_notes varchar [note: 'Free-text notes explaining special circumstances, exceptions, or additional context about why this consent form is required for this plan or how the requirement should be applied.']
  termination_date date [note: 'Date when this consent form is no longer required for this health plan. May occur due to regulatory changes, plan redesign, or form supersession by a newer version.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar
  created_by varchar [note: 'User ID or system identifier of the person or process that created this plan consent requirement record.']

  Note: 'This association product represents the regulatory and operational requirement linking health insurance plans to the specific consent form templates that members must complete. It captures when each consent form became required for a plan, whether the consent is mandatory for enrollment or optional, and the business rules governing when the form must be presented (at enrollment, renewal, or triggered by specific events). Each record links one health_plan to one consent_form_template with attributes that exist only in the context of this plan-specific consent requirement.. Existence Justification: In healthcare operations, health insurance plans require multiple consent forms to comply with federal regulations (HIPAA), state laws, treatment protocols, and specialized services (telehealth, genetic testing, research participation). Conversely, a single consent form template (e.g., HIPAA authorization) applies across multiple health plans offered by different payers and plan types. Plan administrators actively manage these requirements, specifying which forms are mandatory vs optional, when they must be presented (enrollment, renewal, or event-triggered), and the regulatory basis for each requirement.'
}

Table insurance.broker {
  broker_id varchar [pk, note: 'Primary key for broker']
  parent_broker_id varchar [note: 'Self-referencing FK on broker (parent_broker_id)']
  address_line_1 varchar [note: 'Primary street address line for the broker\'s business location.']
  address_line_2 varchar [note: 'Secondary address line for suite, unit, or building information.']
  appointment_date date [note: 'Date when the broker was formally appointed to sell the healthcare organization\'s insurance products.']
  appointment_status varchar [note: 'Status indicating whether the broker is formally appointed to represent the healthcare organization\'s insurance products.']
  background_check_date date [note: 'Date when the most recent background check was completed for the broker.']
  background_check_status varchar [note: 'Status of the background check conducted on the broker for compliance and risk management purposes.']
  broker_status varchar [note: 'Current operational status of the broker within the healthcare organization\'s network.']
  broker_type varchar [note: 'Classification of the broker entity based on organizational structure and business model.']
  city varchar [note: 'City name for the broker\'s business address.']
  commission_rate_percentage decimal(5,2) [note: 'Standard commission rate percentage paid to the broker for new business sales.']
  compliance_training_completion_date date [note: 'Date when the broker completed required compliance and regulatory training programs.']
  country_code varchar [note: 'Three-letter ISO country code for the broker\'s business address.']
  created_timestamp timestamp [note: 'Date and time when the broker record was first created in the system.']
  doing_business_as_name varchar [note: 'Trade name or fictitious business name under which the broker operates, if different from legal name.']
  errors_and_omissions_coverage_amount decimal(15,2) [note: 'Total coverage amount in US dollars for the broker\'s errors and omissions liability insurance policy.']
  errors_and_omissions_expiration_date date [note: 'Expiration date of the broker\'s errors and omissions liability insurance policy.']
  errors_and_omissions_insurance_carrier varchar [note: 'Name of the insurance carrier providing errors and omissions liability coverage for the broker.']
  errors_and_omissions_policy_number varchar [note: 'Policy number for the broker\'s errors and omissions liability insurance coverage.']
  hipaa_certification_date date [note: 'Date when the broker completed HIPAA privacy and security certification training.']
  is_active boolean [note: 'Boolean flag indicating whether the broker is currently active and eligible to transact business.']
  last_modified_timestamp timestamp [note: 'Date and time when the broker record was most recently updated in the system.']
  legal_name varchar [note: 'The official legal name of the broker or brokerage firm as registered with regulatory authorities.']
  license_expiration_date date [note: 'Date when the broker\'s primary insurance producer license expires and requires renewal.']
  license_issue_date date [note: 'Date when the broker\'s primary insurance producer license was originally issued.']
  license_number varchar [note: 'Primary state-issued insurance producer license number for the broker\'s home state of domicile.']
  license_state varchar [note: 'Two-letter state code where the broker holds their primary insurance producer license.']
  market_segment varchar [note: 'Primary market segment or line of business that the broker specializes in selling.']
  national_producer_number varchar [note: 'Unique 10-digit identifier assigned by the National Insurance Producer Registry (NIPR) to licensed insurance producers and brokers in the United States.']
  notes varchar [note: 'Free-form text field for additional comments, special instructions, or important information about the broker.']
  override_commission_rate_percentage decimal(5,2) [note: 'Additional override commission rate percentage for managing general agents or agency principals.']
  payment_method varchar [note: 'Preferred method for disbursing commission payments to the broker.']
  performance_tier varchar [note: 'Performance classification tier assigned to the broker based on sales volume and quality metrics.']
  postal_code varchar [note: 'ZIP code or postal code for the broker\'s business address.']
  primary_contact_name varchar [note: 'Full name of the primary contact person at the brokerage firm for operational communications.']
  primary_email varchar [note: 'Primary email address for official communications with the broker or brokerage firm.']
  primary_phone varchar [note: 'Primary telephone number for contacting the broker or brokerage firm.']
  secondary_phone varchar [note: 'Alternate telephone number for contacting the broker, such as mobile or fax.']
  state varchar [note: 'Two-letter state code for the broker\'s business address.']
  tax_identification_number varchar [note: 'Federal Employer Identification Number (FEIN) or Social Security Number (SSN) for tax reporting purposes.']
  termination_date date [note: 'Date when the broker\'s appointment or relationship with the healthcare organization was terminated.']
  termination_reason varchar [note: 'Explanation or code describing the reason for termination of the broker relationship.']
  territory_code varchar [note: 'Geographic territory or region code assigned to the broker for sales and service responsibilities.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar
  website_url varchar [note: 'Official website address of the broker or brokerage firm.']

  Note: 'Master reference table for broker. Referenced by broker_id.'
}

Table insurance.third_party_administrator {
  third_party_administrator_id varchar [pk, note: 'Primary key for third_party_administrator']
  electronic_payer_id varchar [note: 'Unique payer identification number used in electronic data interchange (EDI) transactions for claims and eligibility verification.']
  parent_third_party_administrator_id varchar [note: 'Self-referencing FK on third_party_administrator (parent_third_party_administrator_id)']
  accreditation_status varchar [note: 'Current accreditation status of the TPA from recognized healthcare quality organizations such as NCQA, URAC, or AAAHC.']
  address_line_1 varchar [note: 'First line of the TPAs primary business address including street number and street name.']
  address_line_2 varchar [note: 'Second line of the TPAs business address for suite, floor, or building information.']
  business_continuity_plan_verified boolean [note: 'Indicates whether the TPAs business continuity and disaster recovery plan has been reviewed and verified to meet healthcare organization requirements.']
  city varchar [note: 'City name of the TPAs primary business location.']
  claims_processing_capability boolean [note: 'Indicates whether the TPA has the capability and authorization to process medical and pharmacy claims on behalf of the health plan.']
  claims_submission_address varchar [note: 'Mailing address where paper claims should be submitted to the TPA for processing.']
  contract_effective_date date [note: 'Date when the administrative services agreement between the healthcare organization and the TPA became effective.']
  contract_termination_date date [note: 'Date when the administrative services agreement with the TPA is scheduled to terminate or was actually terminated.']
  country_code varchar [note: 'Three-letter ISO country code of the TPAs primary business location.']
  created_timestamp timestamp [note: 'Timestamp when the TPA record was first created in the master data management system.']
  customer_service_phone varchar [note: 'Toll-free or direct phone number for member and provider customer service inquiries handled by the TPA.']
  data_breach_history varchar [note: 'Summary of any reported data breaches or security incidents involving the TPA including dates, scope, and remediation actions taken.']
  financial_rating varchar [note: 'Credit or financial strength rating assigned to the TPA by independent rating agencies such as AM Best, Moodys, or Standard & Poors.']
  hipaa_compliance_certified boolean [note: 'Indicates whether the TPA has been certified as compliant with HIPAA privacy and security regulations through independent audit or attestation.']
  last_updated_timestamp timestamp [note: 'Timestamp when the TPA record was most recently modified in the master data management system.']
  last_verification_date date [note: 'Date when the TPA information was last verified for accuracy and completeness through outreach or data quality review process.']
  license_effective_date date [note: 'Date when the TPAs license became effective and the TPA was authorized to begin operations.']
  license_expiration_date date [note: 'Date when the TPAs current license expires and must be renewed to continue operations.']
  license_number varchar [note: 'State-issued license number authorizing the TPA to conduct administrative services for health plans in the jurisdiction.']
  license_state varchar [note: 'State or jurisdiction that issued the TPA license using standard two-letter state abbreviations.']
  member_services_capability boolean [note: 'Indicates whether the TPA provides member-facing services including enrollment support, benefit inquiries, and grievance handling.']
  national_provider_identifier varchar [note: 'Ten-digit NPI assigned to the TPA if registered as a healthcare entity under HIPAA administrative simplification standards.']
  network_management_capability boolean [note: 'Indicates whether the TPA manages provider networks including credentialing, contracting, and network adequacy monitoring.']
  notes varchar [note: 'Free-text field for capturing additional administrative notes, special instructions, or contextual information about the TPA relationship.']
  parent_organization_name varchar [note: 'Name of the parent company or holding organization if the TPA is a subsidiary or division of a larger corporate entity.']
  performance_guarantee_terms varchar [note: 'Description of contractual performance guarantees and service level agreements (SLAs) the TPA must meet including claims turnaround time, accuracy rates, and customer service metrics.']
  postal_code varchar [note: 'Postal or ZIP code of the TPAs primary business address.']
  primary_contact_email varchar [note: 'Email address of the primary business contact at the TPA for electronic communication and notifications.']
  primary_contact_name varchar [note: 'Full name of the primary business contact person at the TPA organization for operational coordination and issue resolution.']
  primary_contact_phone varchar [note: 'Primary telephone number for reaching the TPA business contact during normal business operations.']
  service_scope_description varchar [note: 'Detailed description of the administrative services the TPA is contracted to provide including claims processing, utilization review, network management, and member services.']
  soc2_certified boolean [note: 'Indicates whether the TPA has achieved SOC 2 Type II certification demonstrating controls for security, availability, processing integrity, confidentiality, and privacy.']
  state_province varchar [note: 'State or province code of the TPAs primary business location using standard two-letter abbreviations.']
  tax_identification_number varchar [note: 'Federal tax identification number (EIN) for the TPA organization used for tax reporting and regulatory compliance.']
  third_party_administrator_status varchar [note: 'Current operational status of the TPA relationship indicating whether the TPA is actively servicing plans or has been suspended, terminated, or is pending approval.']
  tpa_code varchar [note: 'Unique business identifier code assigned to the TPA for operational reference and system integration.']
  tpa_name varchar [note: 'Legal business name of the third party administrator organization.']
  tpa_type varchar [note: 'Classification of the TPA based on the scope of administrative services provided (full service, claims processing only, utilization management, network management, specialty services, or hybrid).']
  utilization_management_capability boolean [note: 'Indicates whether the TPA provides utilization management services including prior authorization, concurrent review, and case management.']
  vibe_mutation_marker varchar
  website_url varchar [note: 'Public website URL of the TPA organization for member and provider information access.']

  Note: 'Master reference table for third_party_administrator. Referenced by tpa_id.'
}

Table insurance.accountable_care_organization {
  accountable_care_organization_id varchar [pk, note: 'Primary key for accountable_care_organization']
  parent_accountable_care_organization_id varchar [note: 'Self-referencing FK on accountable_care_organization (parent_accountable_care_organization_id)']
  parent_organization_id varchar [note: 'Identifier of the parent health system, integrated delivery network, or corporate entity that owns or governs the ACO, if applicable.']
  payer_id varchar [note: 'Identifier of the primary payer or health plan with which the ACO has contracted for value-based care arrangements.']
  accountable_care_organization_status varchar [note: 'Current operational status of the ACO in its lifecycle with the payer or regulatory program.']
  aco_identifier varchar [note: 'External business identifier assigned by CMS or other regulatory body for the ACO. Used for regulatory reporting and cross-system identification.']
  aco_name varchar [note: 'Official legal name of the accountable care organization as registered with regulatory authorities.']
  aco_type varchar [note: 'Classification of the ACO based on the program model and payer type it operates under.']
  actual_expenditure_amount decimal(15,2) [note: 'Actual per-beneficiary expenditure amount incurred by the ACO during the performance period.']
  address_line_1 varchar [note: 'First line of the ACO primary business address including street number and name.']
  address_line_2 varchar [note: 'Second line of the ACO primary business address for suite, floor, or building information.']
  advance_payment_eligible boolean [note: 'Indicates whether the ACO is eligible to receive advance or upfront payments to support care coordination infrastructure.']
  agreement_end_date date [note: 'Date when the ACO agreement or contract with the payer expires or is scheduled to terminate. Null for open-ended agreements.']
  agreement_start_date date [note: 'Date when the ACO agreement or contract with the payer becomes effective and the organization begins operating under the program.']
  attributed_beneficiary_count varchar [note: 'Number of Medicare or other payer beneficiaries attributed to the ACO for the current performance period.']
  benchmark_expenditure_amount decimal(15,2) [note: 'Target per-beneficiary expenditure amount established as the cost benchmark for the ACO performance evaluation.']
  city varchar [note: 'City name of the ACO primary business address.']
  country_code varchar [note: 'Three-letter ISO country code for the ACO primary business address.']
  created_timestamp timestamp [note: 'Date and time when the ACO record was first created in the system.']
  legal_entity_name varchar [note: 'Full legal name of the corporate or organizational entity that holds the ACO agreement, which may differ from the ACO operating name.']
  national_provider_identifier varchar [note: 'Ten-digit NPI assigned to the ACO as an organizational provider for healthcare transactions and identification.']
  organization_structure varchar [note: 'Governance and ownership structure of the ACO indicating the primary organizational model and leadership.']
  participating_provider_count varchar [note: 'Total number of healthcare providers (physicians, specialists, facilities) participating in the ACO network.']
  performance_year varchar [note: 'Calendar year for which the ACO is currently being measured and evaluated for quality and cost performance.']
  postal_code varchar [note: 'Five or nine-digit ZIP code for the ACO primary business address.']
  primary_contact_email varchar [note: 'Email address of the primary administrative or executive contact for official ACO communications.']
  primary_contact_name varchar [note: 'Full name of the primary administrative or executive contact person for the ACO.']
  primary_contact_phone varchar [note: 'Primary telephone number for reaching the ACO administrative or executive contact.']
  program_model varchar [note: 'Specific CMS or commercial program model under which the ACO operates, defining risk-sharing and payment arrangements.']
  quality_score decimal(5,2) [note: 'Composite quality performance score for the ACO based on CMS or payer-defined quality measures, typically expressed as a percentage.']
  risk_adjustment_methodology varchar [note: 'Name or description of the risk adjustment model used to normalize cost and quality performance for the ACO population case mix.']
  service_area_description varchar [note: 'Textual description of the geographic service area covered by the ACO, including counties, regions, or states served.']
  shared_loss_amount decimal(15,2) [note: 'Dollar amount of shared losses owed by the ACO in the most recent performance period for two-sided risk models, if applicable.']
  shared_savings_amount decimal(15,2) [note: 'Dollar amount of shared savings earned by the ACO in the most recent performance period, if applicable.']
  shared_savings_eligible boolean [note: 'Indicates whether the ACO is currently eligible to receive shared savings payments based on performance against cost and quality benchmarks.']
  state_code varchar [note: 'Two-letter state or territory code for the ACO primary business address.']
  tax_identification_number varchar [note: 'Federal tax identification number (EIN) for the ACO legal entity used for financial and regulatory reporting.']
  termination_date date [note: 'Date when the ACO agreement was terminated or the organization ceased operations under the program, if applicable.']
  termination_reason varchar [note: 'Reason code or description explaining why the ACO agreement was terminated, such as voluntary withdrawal, performance issues, or regulatory action.']
  track_level varchar [note: 'Risk track or level within the program model indicating the degree of financial risk and reward sharing.']
  updated_timestamp timestamp [note: 'Date and time when the ACO record was last modified in the system.']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']
  vibe_mutation_marker varchar

  Note: 'Master reference table for accountable_care_organization. Referenced by aco_id.'
}

Table insurance.insurance_network_participation {
  insurance_network_participation_id varchar [pk, note: 'Surrogate primary key for insurance_network_participation.']
  merged_with_insurance_network_participation varchar [note: 'Superseded by insurance.network_participation (participant_type discriminator)']
  ssot_canonical_reference varchar [note: 'Canonical SSOT table: insurance.network_participation']
  ssot_reconciliation_status varchar [note: 'SSOT reconciliation: consolidated into insurance.network_participation via participant_type']
  vibe_added_flag boolean [note: 'Flag added by VIBE mutator to ensure change']

  Note: ' [SSOT: consolidated into insurance.network_participation with participant_type discriminator; retained as deprecated alias.]'
}

Table insurance.insurance_network_participation2 {
  insurance_network_participation2_id varchar [pk]
  participant_type varchar
  ssot_canonical_reference varchar [note: 'SSOT reconciliation attribute added by vibe cross-domain dedup pass.']
  ssot_reconciliation_status varchar [note: 'SSOT reconciliation attribute added by vibe cross-domain dedup pass.']
}

Table consent.form_template {
  form_template_id varchar [pk, note: 'Surrogate primary key']
  compliance_policy_id varchar [note: 'FK to compliance policy']
  consent_policy_id varchar [note: 'FK to consent policy']
  exchange_standard_id varchar [note: 'FK to exchange standard if form is exchanged electronically']
  primary_superseded_by_form_template_id varchar [note: 'FK to newer version of this form template']
  applicable_facility_types varchar [note: 'Facility types where this form applies']
  applicable_service_lines varchar [note: 'Service lines where this form applies']
  approval_authority varchar [note: 'Authority that approved this form']
  approval_date date [note: 'Date form was approved']
  consent_category varchar [note: 'Category: treatment, research, HIE, HIPAA']
  consent_subcategory varchar [note: 'Subcategory within category']
  created_by_user varchar [note: 'User who created form template']
  created_timestamp timestamp [note: 'Record creation timestamp']
  effective_date date [note: 'Date form becomes effective']
  electronic_signature_enabled_flag boolean [note: 'True if electronic signature is allowed']
  expiration_date decimal(9,4) [note: 'Date form expires']
  form_checksum varchar [note: 'Checksum for form integrity verification']
  form_code varchar [note: 'Unique code for form template']
  form_document_url varchar [note: 'URL to form document']
  form_name varchar [note: 'Name of form template']
  form_purpose varchar [note: 'Purpose of consent form']
  form_status varchar [note: 'Status: draft, active, retired']
  interpreter_required_flag boolean [note: 'True if interpreter is required']
  irb_approval_date date [note: 'IRB approval date for research forms']
  irb_approval_number varchar [note: 'IRB approval number']
  irb_expiration_date decimal(9,4) [note: 'IRB approval expiration date']
  language_code varchar [note: 'Language of form']
  legal_representative_allowed_flag boolean [note: 'True if legal representative can sign']
  minimum_age_requirement varchar [note: 'Minimum age to consent']
  minor_assent_required_flag boolean [note: 'True if minor assent is required']
  modified_by_user varchar [note: 'User who last modified form']
  modified_timestamp timestamp [note: 'Last modification timestamp']
  reading_level varchar [note: 'Reading level of form']
  regulatory_basis varchar [note: 'Regulatory basis for form']
  retention_period_years varchar [note: 'Years to retain signed forms']
  revocation_allowed_flag boolean [note: 'True if consent can be revoked']
  revocation_instructions varchar [note: 'Instructions for revoking consent']
  scope_of_consent varchar [note: 'Scope of consent covered by form']
  version_number varchar [note: 'Version number of form']
  witness_required_flag boolean [note: 'True if witness is required']

  Note: 'Consent form template library storing approved consent form versions with regulatory basis, IRB approval, language translations, and versioning. Supports form lifecycle management and compliance tracking.'
}

Table consent.hipaa_authorization {
  hipaa_authorization_id varchar [pk, note: 'Surrogate primary key']
  care_site_id varchar [note: 'FK to care site']
  compliance_policy_id varchar [note: 'FK to compliance policy']
  demographics_id varchar [note: 'FK to patient demographics']
  employee_id varchar [note: 'FK to employee']
  record_id varchar [note: 'FK to consent record']
  research_study_id varchar [note: 'FK to research study']
  superseded_hipaa_authorization_id varchar [note: 'Self-FK to prior version']
  transmitted_cda_document_id varchar [note: 'FK to CDA document']
  visit_id varchar [note: 'FK to visit']
  authorization_purpose varchar [note: 'Purpose of authorization']
  authorization_purpose_description varchar [note: 'Detailed purpose description']
  compensation_disclosure_flag boolean [note: 'True if compensation was disclosed']
  created_timestamp timestamp [note: 'Record creation timestamp']
  disclosing_party_name varchar [note: 'Name of disclosing party']
  disclosing_party_npi varchar [note: 'NPI of disclosing party']
  document_reference varchar [note: 'Reference to authorization document']
  expiration_event decimal(9,4) [note: 'Event that triggers expiration']
  form_version varchar [note: 'Version of authorization form']
  irb_approval_number varchar [note: 'IRB approval number']
  language_code varchar [note: 'Language code']
  last_updated_by varchar [note: 'User who last updated record']
  last_updated_timestamp timestamp [note: 'Last update timestamp']
  mrn varchar [note: 'Patient MRN']
  notes varchar [note: 'Free-text notes']
  personal_representative_flag boolean [note: 'True if personal representative signed']
  personal_representative_name varchar [note: 'Name of personal representative']
  personal_representative_relationship varchar [note: 'Relationship to patient']
  phi_category varchar [note: 'Category of PHI to be disclosed']
  phi_description varchar [note: 'Description of PHI']
  recipient_address varchar [note: 'Address of recipient']
  recipient_name varchar [note: 'Name of recipient']
  recipient_organization varchar [note: 'Organization of recipient']
  redisclosure_statement varchar [note: 'Statement about redisclosure']
  right_to_revoke_statement varchar [note: 'Statement about right to revoke']
  signature_date date [note: 'Date of signature']
  signature_method varchar [note: 'Method of signature']
  signature_obtained_flag boolean [note: 'True if signature was obtained']
  witness_name varchar [note: 'Name of witness']
  witness_signature_date date [note: 'Date of witness signature']
  created_by varchar [note: 'User who created record']

  Note: 'HIPAA authorization for use and disclosure of PHI beyond treatment/payment/operations. Captures recipient, purpose, PHI categories, expiration, and right to revoke per 45 CFR 164.508.'
}

Table consent.hie_directive {
  hie_directive_id varchar [pk, note: 'Unique identifier for the HIE directive record. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where this HIE directive was captured.']
  clinician_id varchar [note: 'Identifier of the healthcare provider or staff member who captured this HIE directive.']
  demographics_id varchar [note: 'Identifier of the patient who issued this HIE directive.']
  hie_participation_id varchar [note: 'Foreign key linking to interoperability.hie_participation. Business justification: HIE directives are scoped to specific organizational HIE participation agreements. Business needs to enforce which HIE network participation governs each patient directive, especially when organizatio']
  record_id varchar [note: 'Foreign key linking to consent.record. Business justification: HIE directives are a type of consent record governing health information exchange. Linking to the core record table enables unified consent management and reporting. Core consent lifecycle attributes ']
  superseded_hie_directive_id varchar [note: 'Self-referencing FK on hie_directive (superseded_hie_directive_id)']
  trading_partner_id varchar [note: 'Foreign key linking to interoperability.trading_partner. Business justification: HIE directives specify which trading partners (specific hospitals, health systems, HIEs) can access patient data. Required for operational enforcement of patient restrictions—when patient opts out of ']
  visit_id varchar [note: 'Identifier of the clinical encounter during which this HIE directive was captured, if applicable.']
  audit_log_reference varchar [note: 'Reference identifier linking this directive to detailed audit logs of HIE access events.']
  break_glass_events_count varchar [note: 'Number of times emergency break-glass access has been invoked to override this directive.']
  consent_form_version varchar [note: 'Version identifier of the consent form or template used to capture this directive.']
  consent_method varchar [note: 'Method by which the patient provided this HIE directive: written form, verbal communication, electronic signature, or implied consent.']
  created_timestamp timestamp [note: 'Timestamp when this HIE directive record was first created in the system.']
  data_type_restrictions varchar [note: 'Comma-separated list of specific data types or categories the patient has restricted from sharing (e.g., mental health, substance abuse, HIV status, genetic information).']
  directive_type varchar [note: 'Type of HIE directive: opt-in (patient consents to share), opt-out (patient declines to share), opt-out with exceptions (patient declines except for specified cases), or conditional (patient sets specific conditions).']
  emergency_access_override boolean [note: 'Indicates whether emergency access provisions allow providers to override this directive in life-threatening situations.']
  federal_override_applicable boolean [note: 'Indicates whether federal regulations (e.g., 42 CFR Part 2 for substance abuse) override state HIE consent laws for this directive.']
  interpreter_used boolean [note: 'Indicates whether a medical interpreter was used to explain the HIE directive to the patient.']
  language_code varchar [note: 'ISO 639-1 two-letter language code indicating the language in which the directive was presented to and understood by the patient.']
  last_break_glass_date timestamp [note: 'Timestamp of the most recent emergency break-glass access event.']
  last_updated_timestamp timestamp [note: 'Timestamp when this HIE directive record was last modified.']
  last_verified_timestamp timestamp [note: 'Timestamp when the directive was last verified with the patient or confirmed as still valid.']
  legal_representative_name varchar [note: 'Name of the legal representative (guardian, power of attorney) who provided consent on behalf of the patient, if applicable.']
  legal_representative_relationship varchar [note: 'Relationship of the legal representative to the patient (e.g., parent, guardian, healthcare proxy, power of attorney).']
  mrn varchar [note: 'The patient\'s medical record number associated with this directive.']
  next_review_date date [note: 'Scheduled date for the next review or reconfirmation of this HIE directive with the patient.']
  notes varchar [note: 'Additional free-text notes or comments about this HIE directive, including any special circumstances or clarifications.']
  patient_education_provided boolean [note: 'Indicates whether educational materials about HIE participation were provided to the patient.']
  patient_instructions varchar [note: 'Free-text field capturing any additional instructions or conditions specified by the patient regarding HIE participation.']
  provider_restrictions varchar [note: 'Comma-separated list of specific provider organizations or individuals the patient has restricted from accessing their data via HIE.']
  purpose_of_use_restrictions varchar [note: 'Comma-separated list of purposes for which data sharing is restricted or permitted (e.g., treatment, payment, operations, research, public health).']
  scope_of_sharing varchar [note: 'Defines the breadth of data sharing permitted: all records, specific data types only, specific providers only, emergency situations only, or treatment purposes only.']
  source_system_code varchar [note: 'Unique identifier of this directive in the source system.']
  state_jurisdiction varchar [note: 'Two-letter state code indicating the jurisdiction whose HIE consent laws govern this directive.']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'Name of the witness who observed the patient signing the HIE directive, if applicable.']
  witness_signature_date date [note: 'Date when the witness signed the HIE directive form.']

  Note: 'Master record for patient Health Information Exchange (HIE) opt-in and opt-out directives governing participation in regional and statewide HIE networks. Captures HIE network name, directive type (opt-in, opt-out, opt-out with exceptions), effective date, expiration date, scope of data sharing (all records, specific data types, specific providers), patient-specified restrictions, and directive status. Supports compliance with state HIE consent laws and CommonWell/Carequality participation rules.'
}

Table consent.treatment_consent {
  treatment_consent_id varchar [pk, note: 'Unique identifier for the treatment consent record. Primary key.']
  care_site_id varchar [note: 'Reference to the healthcare facility where this treatment consent was obtained.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Treatment consent forms are governed by policies defining informed consent requirements, documentation standards, and regulatory compliance. Essential for demonstrating that consent practices meet org']
  cpt_code_id varchar [note: 'The CPT or ICD-10-PCS code identifying the specific procedure or treatment being consented to. Applicable for procedure-specific consent types.']
  mpi_record_id varchar [note: 'Reference to the patient who is the subject of this treatment consent.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Treatment consents often require payer-specific authorization and documentation. Some procedures require payer pre-authorization before consent can be finalized. Links consent management to insurance ']
  primary_treatment_clinician_id varchar [note: 'Reference to the provider who performed the clinical assessment of the patient\'s decision-making capacity.']
  primary_treatment_employee_id varchar [note: 'Identifier of the system user who created this treatment consent record.']
  record_id varchar [note: 'Foreign key linking to consent.record. Business justification: Treatment consent is a specialized type of consent record for medical procedures. Linking to the core record table enables unified consent management and reporting. Core consent lifecycle attributes (']
  superseded_treatment_consent_id varchar [note: 'Self-referencing FK on treatment_consent (superseded_treatment_consent_id)']
  tertiary_treatment_performing_provider_clinician_id varchar [note: 'Reference to the provider who will perform the procedure or treatment for which consent was obtained.']
  visit_id varchar [note: 'Reference to the clinical encounter during which this consent was obtained.']
  alternatives_documented varchar [note: 'Narrative documentation of alternative treatment options that were disclosed to and discussed with the patient or authorized representative.']
  benefits_documented varchar [note: 'Narrative documentation of the expected benefits of the procedure or treatment that were disclosed to and discussed with the patient or authorized representative.']
  capacity_determination varchar [note: 'Clinical determination of whether the patient has decision-making capacity to provide informed consent for the treatment or procedure.']
  consent_document_location varchar [note: 'Reference to the location or system where the signed consent document is stored (e.g., EMR document ID, scanned document repository path).']
  consent_form_number varchar [note: 'The externally-known unique identifier or form number for this treatment consent document.']
  consent_method varchar [note: 'The method by which consent was obtained and documented (written signature, verbal consent documented by provider, electronic signature, telephonic consent with witness).']
  consent_version varchar [note: 'Version identifier of the consent form template used, for tracking form revisions and ensuring compliance with current organizational policies.']
  created_datetime timestamp [note: 'The date and time when this treatment consent record was first created in the system.']
  emergency_exception_flag boolean [note: 'Indicates whether treatment was provided under emergency exception provisions when informed consent could not be obtained due to the patient\'s condition and no authorized representative was available.']
  emergency_exception_justification varchar [note: 'Clinical documentation justifying why treatment was provided without informed consent under emergency exception provisions.']
  interpreter_language varchar [note: 'The language in which interpretation services were provided during the consent process.']
  interpreter_name varchar [note: 'Full name of the medical interpreter who facilitated the consent discussion.']
  interpreter_required_flag boolean [note: 'Indicates whether a medical interpreter was required to facilitate the consent discussion due to language barriers or communication needs.']
  last_updated_datetime timestamp [note: 'The date and time when this treatment consent record was last modified in the system.']
  legal_representative_name varchar [note: 'Full name of the legal representative or authorized decision-maker who provided consent on behalf of the patient.']
  legal_representative_phone varchar [note: 'Contact phone number for the legal representative or authorized decision-maker.']
  legal_representative_relationship varchar [note: 'The legal or familial relationship of the representative to the patient (e.g., parent, legal guardian, healthcare proxy, durable power of attorney for healthcare, spouse, next of kin).']
  legal_representative_required_flag boolean [note: 'Indicates whether a legal representative or authorized decision-maker was required to provide consent on behalf of the patient due to lack of capacity.']
  patient_questions_addressed_flag boolean [note: 'Indicates whether the patient or authorized representative had the opportunity to ask questions and all questions were addressed prior to obtaining consent.']
  patient_questions_notes varchar [note: 'Free-text documentation of specific questions asked by the patient or authorized representative and the responses provided.']
  revoked_by_name varchar [note: 'Name of the individual (patient or authorized representative) who revoked the consent.']
  risks_documented varchar [note: 'Narrative documentation of the material risks of the procedure or treatment that were disclosed to and discussed with the patient or authorized representative.']
  special_instructions varchar [note: 'Any special instructions, limitations, or conditions specified by the patient or authorized representative as part of the consent (e.g., no blood products, specific anesthesia preferences).']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'Full name of the witness who observed the consent process and signed the consent form.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required on the consent form per organizational policy or regulatory requirement.']
  witness_role varchar [note: 'The role or title of the witness (e.g., registered nurse, social worker, patient advocate).']

  Note: 'Master record for general and procedure-specific treatment consent obtained from patients or their authorized representatives prior to clinical care. Captures consent type (general treatment, surgical, anesthesia, blood transfusion, chemotherapy, ECT, restraint), procedure or treatment being consented to, risks and benefits documented, alternatives discussed, patient questions addressed, capacity determination, and legal representative details when patient lacks decision-making capacity. Distinct from HIPAA authorization — governs clinical care delivery.'
}

Table consent.research_consent {
  research_consent_id varchar [pk, note: 'Unique identifier for the research consent record. Primary key.']
  clinician_id varchar [note: 'Identifier of the healthcare provider or research coordinator who obtained informed consent from the subject.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Research consents must comply with IRB-approved policies and organizational research governance policies. Links consent instances to governing policies for audit trails, regulatory compliance verifica']
  mpi_record_id varchar [note: 'Identifier of the patient or research subject who provided consent.']
  record_id varchar [note: 'Foreign key linking to consent.record. Business justification: Research consent is a specialized type of consent record for clinical research. Linking to the core record table enables unified consent management and reporting. Core consent lifecycle attributes (st']
  research_study_id varchar [note: 'Identifier of the clinical trial or research study for which consent was obtained.']
  superseded_research_consent_id varchar [note: 'Self-referencing FK on research_consent (superseded_research_consent_id)']
  biospecimen_collection_authorized boolean [note: 'Indicates whether the subject authorized collection and storage of biospecimens (blood, tissue, DNA) for research purposes.']
  comprehension_assessment_method varchar [note: 'Method used to assess subject comprehension (e.g., teach-back, quiz, verbal confirmation).']
  comprehension_assessment_result varchar [note: 'Result of the comprehension assessment indicating whether the subject demonstrated adequate understanding of the study.']
  consent_discussion_duration_minutes varchar [note: 'Duration in minutes of the informed consent discussion between the consenting provider and the research subject.']
  consent_document_url varchar [note: 'URL or file path to the signed consent document stored in the document management system.']
  consent_form_version varchar [note: 'Version identifier of the IRB-approved informed consent form used for this consent event.']
  consent_language varchar [note: 'Language in which the informed consent form was presented and discussed with the subject (e.g., English, Spanish, Mandarin).']
  consent_location varchar [note: 'Physical location or facility where the consent process took place (e.g., clinic name, hospital unit, research center).']
  consent_method varchar [note: 'Method by which consent was obtained (e.g., in-person, telehealth, electronic signature, written signature).']
  consenting_provider_npi varchar [note: 'National Provider Identifier of the provider who obtained consent. 10-digit unique identifier.']
  contact_for_future_studies_authorized boolean [note: 'Indicates whether the subject authorized being contacted for participation in future research studies.']
  created_timestamp timestamp [note: 'Timestamp when this research consent record was first created in the system.']
  data_sharing_authorized boolean [note: 'Indicates whether the subject authorized sharing of their de-identified research data with external researchers or repositories.']
  electronic_signature_code varchar [note: 'Unique identifier of the electronic signature captured during the consent process, if applicable.']
  future_research_authorized boolean [note: 'Indicates whether the subject authorized use of their data and biospecimens for future unspecified research studies.']
  genetic_testing_authorized boolean [note: 'Indicates whether the subject authorized genetic testing and analysis of their biospecimens.']
  hipaa_authorization_included boolean [note: 'Indicates whether HIPAA authorization for use and disclosure of protected health information was included in the research consent.']
  interpreter_used boolean [note: 'Indicates whether a medical interpreter was used during the consent process to facilitate communication with the subject.']
  irb_protocol_number varchar [note: 'IRB protocol number under which this consent was obtained. Links consent to the approved research protocol.']
  lar_contact_phone varchar [note: 'Contact phone number of the legally authorized representative.']
  lar_name varchar [note: 'Full name of the legally authorized representative who provided consent on behalf of the subject.']
  lar_relationship varchar [note: 'Relationship of the LAR to the research subject (e.g., parent, guardian, healthcare proxy, power of attorney).']
  lar_used boolean [note: 'Indicates whether a legally authorized representative provided consent on behalf of an incapacitated or minor subject.']
  last_updated_timestamp timestamp [note: 'Timestamp when this research consent record was last modified in the system.']
  minor_assent_date date [note: 'Date on which assent was obtained from the minor subject.']
  minor_assent_obtained boolean [note: 'Indicates whether assent was obtained from a minor subject in addition to parental consent, as required by IRB protocol.']
  mrn varchar [note: 'Medical record number of the research subject. Unique patient identifier within the healthcare system.']
  reconsent_date date [note: 'Date on which reconsent was obtained following a protocol amendment or other triggering event.']
  reconsent_reason varchar [note: 'Reason for requiring reconsent (e.g., protocol amendment, new safety information, change in study procedures).']
  reconsent_required boolean [note: 'Indicates whether reconsent is required due to protocol amendment, new risks identified, or other changes to the study.']
  return_of_results_requested boolean [note: 'Indicates whether the subject requested to receive individual research results or incidental findings from the study.']
  study_arm varchar [note: 'The specific arm or cohort of the study to which the subject was assigned (e.g., treatment, control, placebo).']
  subject_comprehension_assessed boolean [note: 'Indicates whether the research subjects comprehension of the study risks, benefits, and procedures was formally assessed during the consent process.']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'Full name of the witness who observed the consent process and signed the consent form.']
  witness_required boolean [note: 'Indicates whether a witness signature was required for the consent process (e.g., for illiterate subjects or per IRB protocol).']

  Note: 'Master record for informed consent obtained from research subjects prior to enrollment in clinical trials and research studies. Captures IRB-approved consent form version, study arm, consent process details (who obtained consent, where, how long discussion lasted), subject comprehension assessment, legally authorized representative (LAR) details for incapacitated subjects, assent documentation for minors, re-consent events for protocol amendments, and withdrawal of consent. Governed by 45 CFR 46 (Common Rule) and 21 CFR 50 (FDA). Complements research.informed_consent with enterprise consent SSOT linkage.'
}

Table consent.telehealth_consent {
  telehealth_consent_id varchar [pk, note: 'Unique identifier for the telehealth consent record. Primary key.']
  clinician_id varchar [note: 'Unique identifier for the healthcare provider who will deliver telehealth services under this consent.']
  mpi_record_id varchar [note: 'Unique identifier for the patient providing telehealth consent. Links to the patient master record.']
  record_id varchar [note: 'Foreign key linking to consent.record. Business justification: Telehealth consent is a specialized type of consent record for virtual care. Linking to the core record table enables unified consent management and reporting. Core consent lifecycle attributes (statu']
  superseded_telehealth_consent_id varchar [note: 'Self-referencing FK on telehealth_consent (superseded_telehealth_consent_id)']
  visit_id varchar [note: 'Identifier for the clinical encounter or visit associated with this telehealth consent, if applicable.']
  cms_condition_met boolean [note: 'Indicates whether this telehealth consent satisfies CMS Conditions of Participation for telehealth service delivery and reimbursement.']
  consent_document_code varchar [note: 'Unique identifier or reference to the scanned or electronically signed consent document stored in the document management system.']
  consent_form_version varchar [note: 'Version identifier of the telehealth consent form template used. Enables tracking of consent language changes over time.']
  consent_language varchar [note: 'Two-letter ISO 639-1 language code indicating the language in which the telehealth consent was presented to the patient.']
  consent_obtained_by varchar [note: 'Name or identifier of the staff member, provider, or system that obtained and documented the telehealth consent.']
  consent_obtained_method varchar [note: 'The method by which the patient\'s telehealth consent was captured (e.g., signed paper form, electronic signature, verbal consent documented in EHR).']
  created_timestamp timestamp [note: 'Timestamp when this telehealth consent record was first created in the system. Audit trail for record creation.']
  data_retention_period_days varchar [note: 'Number of days that telehealth session recordings and data will be retained, as disclosed to and consented by the patient.']
  emergency_override_applicable boolean [note: 'Indicates whether this telehealth consent was obtained under emergency circumstances where standard consent procedures were modified per EMTALA or state emergency laws.']
  hipaa_authorization_included boolean [note: 'Indicates whether this telehealth consent includes a HIPAA authorization for use and disclosure of Protected Health Information (PHI) during virtual care.']
  interpreter_used boolean [note: 'Indicates whether a medical interpreter was used during the telehealth consent process to ensure patient understanding.']
  interstate_compact_applicable boolean [note: 'Indicates whether an interstate medical licensure compact (e.g., IMLC) applies to this telehealth consent, allowing cross-state practice.']
  legal_guardian_name varchar [note: 'Name of the legal guardian who provided consent on behalf of a minor or incapacitated patient.']
  legal_guardian_relationship varchar [note: 'The relationship of the legal guardian to the patient (e.g., parent, court-appointed guardian, healthcare proxy).']
  minor_consent_applicable boolean [note: 'Indicates whether this consent involves a minor patient and requires parental or guardian authorization.']
  mrn varchar [note: 'The patient\'s medical record number as assigned by the healthcare organization. Used for clinical identification and consent tracking.']
  notes varchar [note: 'Free-text field for additional notes, comments, or special circumstances related to this telehealth consent.']
  patient_location_state varchar [note: 'Two-letter state code where the patient will be physically located during telehealth services. Determines applicable state telehealth laws.']
  provider_licensure_state varchar [note: 'Two-letter state code where the provider holds active medical licensure. Critical for interstate telehealth compliance.']
  provider_npi varchar [note: 'The 10-digit National Provider Identifier of the provider delivering telehealth services. Required for billing and licensure verification.']
  recording_consent_provided boolean [note: 'Indicates whether the patient consented to audio or video recording of telehealth sessions for quality, training, or medical record purposes.']
  right_to_refuse_disclosed boolean [note: 'Indicates whether the patient was informed of their right to refuse telehealth services and receive in-person care instead.']
  scope_of_services varchar [note: 'Description of the types of clinical services covered under this telehealth consent (e.g., primary care visits, behavioral health, chronic disease management).']
  state_specific_requirements_met boolean [note: 'Flag indicating whether all state-specific telehealth consent requirements have been satisfied (e.g., informed consent elements, parental consent for minors).']
  technology_risks_disclosed boolean [note: 'Indicates whether the patient was informed of technology risks including potential for technical failure, privacy breaches, and limitations of virtual examination.']
  telehealth_modality varchar [note: 'The type of telehealth technology and interaction method the patient consents to use. Determines the mode of virtual care delivery.']
  telehealth_platform varchar [note: 'Name or identifier of the telehealth technology platform the patient will use for virtual visits (e.g., Epic MyChart Video, Zoom for Healthcare, Doxy.me).']
  third_party_disclosure_authorized boolean [note: 'Indicates whether the patient authorized disclosure of telehealth session information to third parties such as family members, caregivers, or other providers.']
  updated_timestamp timestamp [note: 'Timestamp when this telehealth consent record was last modified. Audit trail for record changes.']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'Name of the witness present during consent signing, if required by state law or organizational policy.']

  Note: 'Master record for patient consent to receive care via telehealth and virtual care modalities. Captures telehealth platform, modality type (video, audio-only, asynchronous), state-specific consent requirements met, technology risks disclosed, patient right to refuse telehealth and receive in-person care, provider licensure state, and interstate compact applicability. Required by CMS and most state telehealth laws as a condition of telehealth service delivery.'
}

Table consent.minor_consent {
  minor_consent_id varchar [pk, note: 'Unique identifier for the minor consent record. Primary key.']
  clinician_id varchar [note: 'Reference to the healthcare provider who obtained and documented the consent.']
  delegation_id varchar [note: 'Reference to the parent or legal guardian providing consent on behalf of the minor, if applicable.']
  employee_id varchar [note: 'Identifier of the system user who last updated this consent record, for audit trail purposes.']
  mpi_record_id varchar [note: 'Reference to the minor patient for whom this consent record applies.']
  record_id varchar [note: 'Foreign key linking to consent.record. Business justification: Minor consent is a specialized type of consent record with additional legal requirements for minors. Linking to the core record table enables unified consent management. Core consent lifecycle attribu']
  superseded_minor_consent_id varchar [note: 'Self-referencing FK on minor_consent (superseded_minor_consent_id)']
  visit_id varchar [note: 'Reference to the clinical encounter during which this consent was obtained, if applicable.']
  basis varchar [note: 'The legal basis under which consent is being obtained or documented: mature minor doctrine, emancipated minor status, state-specific minor consent laws (e.g., STI treatment, substance abuse, mental health, reproductive health), parental/guardian consent, or court-ordered consent.']
  confidentiality_obligation_to_minor_flag boolean [note: 'Indicates whether the healthcare provider has a legal or ethical obligation to maintain confidentiality of the minor\'s health information from parents/guardians (e.g., when minor consents independently under state law for sensitive services).']
  consent_document_reference varchar [note: 'Reference identifier or storage location of the signed consent document in the document management system.']
  consent_form_version varchar [note: 'Version identifier of the consent form or template used to obtain consent, for audit and compliance tracking.']
  consent_language varchar [note: 'ISO 639-3 three-letter language code indicating the language in which consent was obtained and documented.']
  consent_method varchar [note: 'The method by which consent was obtained: written signature, verbal consent (documented), electronic signature, or implied consent.']
  consent_scope_description varchar [note: 'Detailed description of what the consent covers, including specific treatments, procedures, data sharing purposes, or research protocols.']
  court_order_reference_number varchar [note: 'Reference number or case number of the court order governing consent authority or restrictions, if applicable.']
  court_ordered_consent_restriction_flag boolean [note: 'Indicates whether there are court-ordered restrictions on who may provide consent for the minor (e.g., one parent prohibited from consenting due to custody order).']
  created_timestamp timestamp [note: 'Timestamp when this consent record was first created in the system.']
  custodial_parent_verified_flag boolean [note: 'Indicates whether the consenting parent has been verified as having legal custody and authority to consent on behalf of the minor, particularly important in cases of divorce or separation.']
  custody_documentation_type varchar [note: 'The type of documentation reviewed to verify custodial parent or guardian status.']
  data_sharing_scope varchar [note: 'Description of the scope and purpose of data sharing authorized by this consent (e.g., specific recipients, purposes, data elements).']
  emancipated_minor_flag boolean [note: 'Indicates whether the minor has been legally emancipated and therefore has full consent rights as an adult.']
  emancipation_documentation_type varchar [note: 'The type of documentation provided to verify emancipated minor status, if applicable.']
  hie_participation_status varchar [note: 'Indicates whether the minor (or parent/guardian on their behalf) has opted in or out of Health Information Exchange participation.']
  hipaa_authorization_flag boolean [note: 'Indicates whether this consent includes a HIPAA authorization for use and disclosure of Protected Health Information (PHI) beyond treatment, payment, and healthcare operations.']
  interpreter_used_flag boolean [note: 'Indicates whether a medical interpreter was used during the consent process to ensure understanding.']
  irb_protocol_number varchar [note: 'The IRB protocol number associated with research consent, if applicable.']
  last_updated_timestamp timestamp [note: 'Timestamp when this consent record was last modified.']
  minor_age_at_consent varchar [note: 'The age of the minor patient at the time consent was obtained, used to determine applicability of age-based consent rules.']
  minor_assent_obtained_flag boolean [note: 'Indicates whether the minor\'s assent (agreement) was obtained in addition to parental consent, particularly relevant for research participation and certain clinical procedures.']
  minor_consenting_independently_flag boolean [note: 'Indicates whether the minor is providing consent independently without parental/guardian involvement, based on mature minor doctrine, emancipation, or state-specific minor consent rights.']
  parent_guardian_name varchar [note: 'Full name of the parent or legal guardian providing consent, if applicable.']
  parental_consent_required_flag boolean [note: 'Indicates whether parental or guardian consent is required for the treatment or service being provided.']
  parental_notification_permitted_flag boolean [note: 'Indicates whether parental notification of the minor\'s care is permitted under applicable law and the minor\'s consent preferences.']
  research_consent_flag boolean [note: 'Indicates whether this consent is for participation in research and is subject to Common Rule and IRB oversight.']
  revocation_reason varchar [note: 'Free-text explanation of why the consent was revoked, if provided.']
  revoked_by varchar [note: 'Identifies who revoked the consent: the minor themselves, parent, guardian, court order, or system (e.g., automatic expiration).']
  state_specific_minor_consent_category varchar [note: 'The specific category of care for which state law permits minors to consent independently without parental involvement (e.g., sexually transmitted infection treatment, reproductive health services, substance abuse treatment, mental health services). [ENUM-REF-CANDIDATE: sti_treatment|reproductive_health|substance_abuse|mental_health|prenatal_care|sexual_assault|not_applicable — 7 candidates stripped; promote to reference product]']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'Full name of the witness who observed the consent process, if applicable.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required for this consent per organizational policy or legal requirement.']

  Note: 'Master record for consent situations involving minor patients, capturing the complex legal landscape of minor consent rights. Tracks whether the minor is consenting independently (mature minor doctrine, emancipated minor, state-specific minor consent for STI/reproductive health/substance use/mental health), parental/guardian consent details, custodial parent verification, court-ordered consent restrictions, and confidentiality obligations to the minor. Critical for compliance with state minor consent statutes and HIPAA minor exception rules.'
}

Table consent.delegation {
  delegation_id varchar [pk, note: 'Unique identifier for the consent delegation record. Primary key for the consent delegation entity.']
  delegation_delegate_person_mpi_record_id varchar [note: 'Identifier of the individual authorized to provide consent on behalf of the patient. May link to person or contact master record.']
  delegation_mpi_record_id varchar [note: 'Identifier of the patient for whom consent delegation authority is being granted. Links to the patient master record.']
  primary_delegation_created_by_user_employee_id varchar [note: 'Identifier of the user or staff member who created the consent delegation record.']
  quaternary_delegation_revoked_by_user_employee_id varchar [note: 'Identifier of the staff member or user who processed the revocation of the delegation authority.']
  superseded_delegation_id varchar [note: 'Self-referencing FK on delegation (superseded_delegation_id)']
  tertiary_delegation_last_updated_by_user_employee_id varchar [note: 'Identifier of the user or staff member who last modified the consent delegation record.']
  applies_to_minor boolean [note: 'Boolean flag indicating whether this delegation applies to a minor patient. True if the patient is a minor and the delegate has parental or guardian authority.']
  created_timestamp timestamp [note: 'Timestamp when the consent delegation record was first created in the system. Used for audit trail and data lineage.']
  delegate_address_line1 varchar [note: 'First line of the delegates mailing address (street address, PO Box).']
  delegate_address_line2 varchar [note: 'Second line of the delegates mailing address (apartment, suite, unit number). Nullable if not applicable.']
  delegate_city varchar [note: 'City of the delegates mailing address.']
  delegate_contact_email varchar [note: 'Primary email address for the delegate. Used for electronic communication regarding consent matters.']
  delegate_contact_phone varchar [note: 'Primary contact phone number for the delegate. Used to reach the authorized representative for consent decisions.']
  delegate_country varchar [note: 'Country of the delegates mailing address. Three-letter ISO 3166-1 alpha-3 country code.']
  delegate_name varchar [note: 'Full legal name of the authorized representative or surrogate decision-maker.']
  delegate_postal_code varchar [note: 'Postal code or ZIP code of the delegates mailing address.']
  delegate_relationship varchar [note: 'Relationship of the delegate to the patient (e.g., spouse, parent, legal guardian, healthcare proxy). [ENUM-REF-CANDIDATE: spouse|parent|adult_child|sibling|legal_guardian|healthcare_proxy|power_of_attorney|court_appointed_guardian|next_of_kin|other — 10 candidates stripped; promote to reference product]']
  delegate_state varchar [note: 'State or province of the delegates mailing address. Two-letter state code for US addresses.']
  delegation_status varchar [note: 'Current lifecycle status of the delegation authority. Indicates whether the delegation is currently in effect, has been revoked, has expired, or is pending verification.']
  delegation_type varchar [note: 'Type of legal authority granted to the delegate. Distinguishes between healthcare proxy, durable power of attorney for healthcare (DPOA-HC), legal guardianship, court-appointed guardianship, next-of-kin surrogate per state law, and parental authority for minors.']
  effective_end_date date [note: 'Date when the delegation authority expires or terminates. Nullable for open-ended delegations. The delegate is no longer authorized to provide consent after this date.']
  effective_start_date date [note: 'Date when the delegation authority becomes effective. The delegate is authorized to provide consent on or after this date.']
  emergency_contact_flag boolean [note: 'Boolean flag indicating whether the delegate should also be contacted in medical emergencies. True if the delegate is designated as an emergency contact.']
  last_updated_timestamp timestamp [note: 'Timestamp when the consent delegation record was last modified. Used for audit trail and change tracking.']
  legal_document_date date [note: 'Date the legal document was executed, signed, or issued by the court. Establishes the legal validity timeline.']
  legal_document_reference varchar [note: 'Reference identifier or location of the supporting legal documentation (e.g., document ID in document management system, court case number, file path). Used to retrieve the original legal instrument.']
  legal_document_type varchar [note: 'Type of legal documentation supporting the delegation authority (e.g., advance directive, healthcare proxy form, durable power of attorney document, guardianship court order, birth certificate for parental authority). [ENUM-REF-CANDIDATE: advance_directive|healthcare_proxy_form|power_of_attorney_document|guardianship_order|court_order|birth_certificate|other — 7 candidates stripped; promote to reference product]']
  limitations_description varchar [note: 'Free-text description of any limitations or restrictions on the delegates authority (e.g., cannot consent to experimental treatments, cannot authorize organ donation, specific procedures excluded).']
  notes varchar [note: 'Additional free-text notes or comments about the delegation authority, verification process, or special circumstances.']
  priority_order varchar [note: 'Priority ranking when multiple delegates exist for the same patient. Lower numbers indicate higher priority. Used to determine which delegate has primary authority when conflicts arise.']
  revocation_date date [note: 'Date when the delegation authority was revoked by the patient, delegate, or legal authority. Nullable if delegation has not been revoked.']
  revocation_reason varchar [note: 'Free-text explanation of why the delegation authority was revoked (e.g., patient request, delegate resignation, legal change, death of delegate).']
  scope varchar [note: 'Scope of authority granted to the delegate. Defines what types of consent decisions the delegate is authorized to make (e.g., full medical decisions, treatment consent only, research consent, data sharing, financial decisions, emergency-only). [ENUM-REF-CANDIDATE: full_medical_decisions|treatment_consent_only|research_consent_only|data_sharing_authorization|financial_decisions|limited_scope|emergency_only — 7 candidates stripped; promote to reference product]']
  source_system_code varchar [note: 'Unique identifier of the delegation record in the source system. Used for data lineage and reconciliation.']
  verification_date date [note: 'Date when the delegation authority was verified by authorized staff. Used for audit and compliance tracking.']
  verification_status varchar [note: 'Status of verification of the delegation authority and supporting documentation. Indicates whether the legal authority has been confirmed by appropriate staff or legal review.']
  vibe_mutation_marker varchar

  Note: 'Master record for authorized representatives, legal surrogates, and healthcare proxies who have legal authority to provide consent on behalf of a patient. Captures delegate type (healthcare proxy, durable power of attorney for healthcare, legal guardian, court-appointed guardian, next-of-kin surrogate per state law), delegation scope, effective period, supporting legal documentation reference, and priority order when multiple delegates exist. Distinct from patient.proxy_access which governs portal access — this governs clinical consent authority.'
}

Table consent.revocation {
  revocation_id varchar [pk, note: 'Unique identifier for the consent revocation record. Primary key for the consent revocation entity.']
  delegation_id varchar [note: 'Reference to the authorized representative who submitted the revocation on behalf of the patient, if applicable. Null if patient revoked directly.']
  mpi_record_id varchar [note: 'Reference to the patient who is revoking consent or on whose behalf consent is being revoked.']
  primary_revocation_employee_id varchar [note: 'Reference to the staff member or system user who received and recorded the consent revocation.']
  prior_revocation_id varchar [note: 'Self-referencing FK on revocation (prior_revocation_id)']
  record_id varchar [note: 'Reference to the original consent record being revoked. Links to the parent consent that this revocation applies to.']
  audit_trail_reference varchar [note: 'Reference identifier linking to detailed audit trail records for all actions taken in response to this revocation, maintained for regulatory compliance.']
  compliance_notes varchar [note: 'Internal notes regarding compliance considerations, special handling requirements, or regulatory reporting obligations related to this revocation.']
  data_access_restricted_flag boolean [note: 'Indicates whether data access controls have been updated to restrict access based on the revoked consent.']
  data_access_restricted_timestamp timestamp [note: 'The date and time when data access restrictions were implemented in response to the consent revocation.']
  disclosures_halted_flag boolean [note: 'Indicates whether ongoing or future disclosures of Protected Health Information (PHI) have been halted as a result of this revocation.']
  disclosures_halted_timestamp timestamp [note: 'The date and time when disclosure processes were halted in response to the consent revocation.']
  document_reference varchar [note: 'Reference identifier or file path to the scanned or electronic copy of the signed revocation document, if applicable.']
  effective_timestamp timestamp [note: 'The date and time when the revocation became legally effective and operational systems began enforcing the withdrawal of consent. May differ from revocation_timestamp due to processing delays.']
  irrevocable_actions_description varchar [note: 'Free-text description of any actions taken under the original consent that cannot be reversed or undone despite the revocation (e.g., data already shared with third parties, research already conducted).']
  legal_review_completed_flag boolean [note: 'Indicates whether required legal review has been completed for this revocation.']
  legal_review_required_flag boolean [note: 'Indicates whether this revocation requires legal review before being processed (e.g., complex partial revocations, disputes, or high-risk scenarios).']
  legal_review_timestamp timestamp [note: 'The date and time when legal review of the revocation was completed.']
  legal_reviewer_notes varchar [note: 'Confidential notes from legal counsel regarding the revocation review, including any special handling instructions or risk assessments.']
  method varchar [note: 'The method or channel through which the patient submitted the consent revocation (e.g., written form, verbal communication, patient portal, email, fax, in-person). [ENUM-REF-CANDIDATE: written|verbal|electronic|portal|email|fax|in_person — 7 candidates stripped; promote to reference product]']
  notification_sent_flag boolean [note: 'Indicates whether notification of the revocation was sent to relevant parties (providers, research teams, business associates, etc.).']
  notification_sent_timestamp timestamp [note: 'The date and time when notifications regarding the consent revocation were sent to affected parties.']
  partial_revocation_details varchar [note: 'Free-text description of which specific portions of the consent are being revoked when revocation_scope is partial. Null when revocation is full.']
  patient_notification_sent_flag boolean [note: 'Indicates whether confirmation notification was sent to the patient acknowledging receipt and processing of their revocation.']
  patient_notification_timestamp timestamp [note: 'The date and time when confirmation notification was sent to the patient regarding their consent revocation.']
  prior_disclosures_count varchar [note: 'The number of disclosures that occurred under the original consent prior to revocation and that cannot be undone or recalled.']
  prior_disclosures_summary varchar [note: 'Summary description of disclosures that occurred prior to revocation and cannot be undone, maintained for legal audit trail and patient notification.']
  reason varchar [note: 'Optional free-text explanation provided by the patient describing why they are revoking consent. May be blank if patient chose not to provide a reason.']
  reason_code varchar [note: 'Standardized categorical code representing the reason for consent revocation, used for reporting and analytics.']
  record_created_timestamp timestamp [note: 'The date and time when this consent revocation record was first created in the data warehouse or lakehouse.']
  record_updated_timestamp timestamp [note: 'The date and time when this consent revocation record was last updated in the data warehouse or lakehouse.']
  rejection_reason varchar [note: 'Explanation of why the revocation was rejected, if applicable (e.g., invalid signature, unauthorized submitter, incomplete documentation).']
  revocation_date date [note: 'The calendar date on which the patient submitted the consent revocation. This is the effective date from which the consent is considered withdrawn.']
  revocation_number varchar [note: 'Business-facing unique identifier or tracking number assigned to this consent revocation for reference and audit purposes.']
  revocation_status varchar [note: 'Current processing status of the consent revocation within the organization\'s workflow (e.g., pending review, processed and effective, rejected due to invalid submission).']
  revocation_timestamp timestamp [note: 'The precise date and time when the consent revocation was submitted or recorded in the system. Provides exact temporal audit trail for legal compliance.']
  scope varchar [note: 'Indicates whether the revocation applies to the entire consent (full) or only specific portions of the consent (partial).']
  source_system_code varchar [note: 'The unique identifier for this revocation record in the source operational system.']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'Name of the witness who was present when the revocation was submitted, if applicable (e.g., for verbal revocations or in-person submissions).']
  witness_signature_flag boolean [note: 'Indicates whether a witness signature was obtained on the revocation document.']

  Note: 'Transactional record of every consent revocation submitted by a patient or their authorized representative. Captures revocation date and time, revocation method (written, verbal, electronic), reason for revocation (if provided), scope of revocation (full or partial), actions taken in response (notifications sent, data access restricted, disclosures halted), and any disclosures that occurred prior to revocation that cannot be undone. Provides the legal audit trail required by HIPAA and state law for consent withdrawal.'
}

Table consent.npp_acknowledgment {
  npp_acknowledgment_id varchar [pk, note: 'Unique identifier for the NPP acknowledgment transaction. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the NPP acknowledgment was obtained.']
  mpi_record_id varchar [note: 'Identifier of the patient who acknowledged or was presented with the NPP.']
  notice_of_privacy_practices_id varchar [note: 'Foreign key linking to compliance.notice_of_privacy_practices. Business justification: Direct relationship - NPP acknowledgments in consent domain track patient acknowledgment of the NPP document managed in compliance domain. Essential for HIPAA compliance, demonstrating good faith effo']
  org_unit_id varchar [note: 'Identifier of the department within the facility where the NPP acknowledgment was obtained (e.g., registration, emergency department, outpatient clinic).']
  primary_npp_employee_id varchar [note: 'Identifier of the staff member or system user who obtained or recorded the NPP acknowledgment.']
  primary_previous_npp_acknowledgment_id varchar [note: 'Identifier of the previous NPP acknowledgment record for this patient, if this is a re-acknowledgment following a material change.']
  visit_id varchar [note: 'Identifier of the clinical encounter during which the NPP acknowledgment was obtained, if applicable.']
  accessibility_accommodation varchar [note: 'Description of any accessibility accommodations provided (e.g., large print, Braille, audio recording, sign language interpreter).']
  acknowledgment_date date [note: 'Date on which the patient acknowledged receipt of the NPP.']
  acknowledgment_location varchar [note: 'Physical or virtual location where the acknowledgment was obtained. [ENUM-REF-CANDIDATE: registration_desk|patient_room|emergency_department|outpatient_clinic|patient_portal|home|other — 7 candidates stripped; promote to reference product]']
  acknowledgment_method varchar [note: 'Method by which the patient provided acknowledgment (paper signature, electronic signature, patient portal click-through, email confirmation, kiosk acceptance, verbal acknowledgment documented by staff).']
  acknowledgment_status varchar [note: 'Current status of the NPP acknowledgment transaction. Acknowledged indicates patient signed or electronically accepted; unable_to_obtain indicates good-faith effort was made but acknowledgment could not be secured per regulatory allowance.']
  acknowledgment_timestamp timestamp [note: 'Precise date and time when the patient acknowledged receipt of the NPP, particularly important for electronic acknowledgments.']
  created_timestamp timestamp [note: 'Date and time when this acknowledgment record was first created in the system.']
  delivery_method varchar [note: 'Method by which the NPP was delivered to the patient (paper handout, electronic via patient portal, email, kiosk, verbal explanation).']
  device_type varchar [note: 'Type of device used for electronic acknowledgment (desktop computer, mobile phone, tablet, kiosk).']
  good_faith_effort_documentation varchar [note: 'Free-text documentation of the good-faith effort made to obtain acknowledgment when it could not be secured.']
  good_faith_effort_reason varchar [note: 'Reason why acknowledgment could not be obtained despite good-faith effort, as permitted under 45 CFR 164.520(c)(2)(ii).']
  interpreter_used boolean [note: 'Indicates whether an interpreter was used to explain the NPP to the patient.']
  ip_address varchar [note: 'IP address from which the electronic acknowledgment was submitted, for audit trail purposes.']
  is_first_service_acknowledgment boolean [note: 'Indicates whether this acknowledgment was obtained at the first service delivery as required by 45 CFR 164.520(c)(1).']
  language_code varchar [note: 'ISO 639-2 three-letter language code indicating the language in which the NPP was provided to the patient.']
  last_updated_timestamp timestamp [note: 'Date and time when this acknowledgment record was last modified.']
  material_change_acknowledgment boolean [note: 'Indicates whether this acknowledgment was obtained following a material change to the NPP, requiring re-acknowledgment.']
  notes varchar [note: 'Additional free-text notes or comments regarding the NPP acknowledgment transaction.']
  patient_portal_session_code varchar [note: 'Session identifier from the patient portal if the acknowledgment was obtained electronically via the portal.']
  representative_authority_documented boolean [note: 'Indicates whether the authority of a personal representative to act on behalf of the patient was documented and verified.']
  retention_expiration_date date [note: 'Date after which this acknowledgment record may be destroyed per retention policy.']
  retention_period_years varchar [note: 'Number of years this acknowledgment record must be retained per HIPAA record retention requirements (minimum 6 years from creation or last effective date).']
  revocation_date date [note: 'Date on which the acknowledgment was revoked or voided, if applicable.']
  revocation_reason varchar [note: 'Reason why the acknowledgment was revoked or voided (e.g., administrative error, duplicate entry, patient request).']
  signature_captured boolean [note: 'Indicates whether a patient or representative signature was captured as part of the acknowledgment.']
  signature_type varchar [note: 'Type of signature captured (wet ink on paper, electronic stylus, digital certificate-based, biometric, or none if acknowledgment was obtained without signature).']
  signer_name varchar [note: 'Full name of the individual who signed the acknowledgment (patient or authorized representative).']
  signer_relationship varchar [note: 'Relationship of the signer to the patient (self if patient signed, or representative role). [ENUM-REF-CANDIDATE: self|parent|legal_guardian|power_of_attorney|healthcare_proxy|personal_representative|other — 7 candidates stripped; promote to reference product]']
  source_system_code varchar [note: 'Unique identifier of this acknowledgment record in the source system.']
  vibe_mutation_marker varchar

  Note: 'Transactional record of patient acknowledgment of receipt of the organization\'s HIPAA Notice of Privacy Practices (NPP). Captures acknowledgment date, delivery method (paper, electronic, patient portal), NPP version acknowledged, patient or representative signature, and documentation of good-faith efforts when acknowledgment could not be obtained. Distinct from compliance.notice_of_privacy_practices which tracks the NPP document itself — this tracks the patient-level acknowledgment transaction required by 45 CFR 164.520.'
}

Table consent.restriction_request {
  restriction_request_id varchar [pk, note: 'Unique identifier for the patient consent restriction request record. Primary key.']
  blocked_hie_query_id varchar [note: 'Foreign key linking to interoperability.hie_query. Business justification: Patient restriction requests may block specific HIE queries in real-time. When patient restricts disclosure to certain recipients, system must log which HIE queries were denied due to restriction. Req']
  care_site_id varchar [note: 'The healthcare facility where the restriction request was received and processed. Links to the facility master record.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Restriction requests are evaluated against organizational policies defining when restrictions must be honored vs. can be denied. Links requests to governing policies for decision documentation, audit ']
  employee_id varchar [note: 'The identifier of the privacy officer or Health Information Management (HIM) professional responsible for processing and overseeing the restriction request. Links to the workforce/provider master record.']
  insurance_coverage_id varchar [note: 'Foreign key linking to patient.insurance_coverage. Business justification: HIPAA permits patients paying out-of-pocket to request disclosure restrictions to their health plan. Attribute out_of_pocket_payment_verified documents this business requirement. Link enables verifica']
  mpi_record_id varchar [note: 'Unique identifier for the patient who submitted the restriction request. Links to the patient master record.']
  record_id varchar [note: 'Foreign key linking to consent.consent_record. Business justification: Consent restriction requests are patient requests to restrict PHI use beyond standard consent. While some restriction requests are general (not tied to specific consent), many relate to a specific con']
  superseded_restriction_request_id varchar [note: 'Self-referencing FK on restriction_request (superseded_restriction_request_id)']
  visit_id varchar [note: 'The encounter during which the restriction request was submitted, if applicable. Links to the encounter master record.']
  audit_trail_reference varchar [note: 'Reference identifier to the detailed audit trail of all actions taken on this restriction request, including reviews, decisions, notifications, and enforcement activities.']
  compliance_review_date date [note: 'The date of the most recent compliance review of this restriction request to ensure ongoing adherence to HIPAA and HITECH requirements.']
  created_timestamp timestamp [note: 'The timestamp when this restriction request record was first created in the system. Used for audit and data lineage purposes.']
  decision_date date [note: 'The date the covered entity made the decision to accept or deny the restriction request.']
  decision_made_by varchar [note: 'The name or role of the individual or committee who made the decision on the restriction request (e.g., Privacy Officer, HIM Director).']
  decision_rationale varchar [note: 'The business and regulatory rationale for the organization\'s decision to accept or deny the restriction request. Required for audit and patient communication.']
  effective_date date [note: 'The date from which the restriction becomes effective and must be honored by the covered entity.']
  expiration_date date [note: 'The date on which the restriction expires, if applicable. Null indicates an indefinite restriction until revoked by the patient or terminated by the organization per regulatory provisions.']
  last_updated_timestamp timestamp [note: 'The timestamp when this restriction request record was last modified. Used for audit and data lineage purposes.']
  mrn varchar [note: 'The patient\'s medical record number as recorded at the time of the restriction request. Provides business-level traceability.']
  notes varchar [note: 'Additional free-text notes or comments related to the restriction request, including patient concerns, special handling instructions, or escalation details.']
  operational_instructions varchar [note: 'Detailed operational instructions for clinical, billing, and administrative staff on how to honor the restriction across Electronic Health Record (EHR), Revenue Cycle Management (RCM), Health Information Exchange (HIE), and other systems.']
  organization_decision varchar [note: 'The covered entity\'s decision on whether to accept or deny the restriction request. HITECH out-of-pocket restrictions must be accepted; other restrictions are discretionary.']
  out_of_pocket_payment_verified boolean [note: 'Indicates whether the patient\'s claim of out-of-pocket payment has been verified for HITECH mandatory restrictions. True if verified, False if not applicable or not verified.']
  patient_notification_date date [note: 'The date the patient was notified of the organization\'s decision on the restriction request or any subsequent changes to the restriction status.']
  patient_notification_method varchar [note: 'The method used to notify the patient of the decision or status change. [ENUM-REF-CANDIDATE: mail|email|patient_portal|phone|in_person|secure_message|other — 7 candidates stripped; promote to reference product]']
  payment_verification_date date [note: 'The date the out-of-pocket payment was verified for HITECH mandatory restrictions, if applicable.']
  request_date date [note: 'The date the patient submitted the restriction request to the covered entity.']
  request_method varchar [note: 'The method by which the patient submitted the restriction request. [ENUM-REF-CANDIDATE: written_form|verbal|patient_portal|email|fax|mail|in_person|other — 8 candidates stripped; promote to reference product]']
  request_number varchar [note: 'Business-assigned unique identifier for the restriction request, used for tracking and reference in correspondence and workflows.']
  request_timestamp timestamp [note: 'The precise date and time the restriction request was received and recorded in the system.']
  requesting_party_relationship varchar [note: 'The relationship of the individual submitting the restriction request to the patient, if not the patient themselves.']
  restricted_phi_category varchar [note: 'The category of Protected Health Information (PHI) the patient is requesting to restrict. Used for operational filtering and enforcement. [ENUM-REF-CANDIDATE: all_phi|diagnosis_codes|procedure_codes|lab_results|radiology_reports|medication_records|mental_health_records|substance_abuse_records|genetic_information|other — 10 candidates stripped; promote to reference product]']
  restricted_purpose varchar [note: 'The purpose of use or disclosure that the patient is requesting to restrict (e.g., restrict disclosure for payment purposes to a specific payer). [ENUM-REF-CANDIDATE: treatment|payment|healthcare_operations|research|public_health|all_purposes|other — 7 candidates stripped; promote to reference product]']
  restricted_recipient_name varchar [note: 'The specific name of the individual, organization, or health plan to whom the restriction applies, if identified by the patient.']
  restricted_recipient_type varchar [note: 'The type of recipient or entity to whom the patient is requesting disclosure restrictions apply. [ENUM-REF-CANDIDATE: health_plan|family_member|employer|specific_provider|health_information_exchange|research_entity|public_health_authority|other — 8 candidates stripped; promote to reference product]']
  restriction_scope varchar [note: 'Detailed narrative describing the scope of the requested restriction, including specific Protected Health Information (PHI) data elements, recipients, purposes, or time periods the patient wishes to restrict.']
  restriction_status varchar [note: 'The current lifecycle status of the restriction. Active restrictions must be enforced across all clinical and administrative systems.']
  restriction_type varchar [note: 'The category of restriction requested by the patient. HITECH out-of-pocket payer restriction is mandatory per 45 CFR 164.522(a)(1)(vi); other types are discretionary.']
  revocation_date date [note: 'The date the patient revoked the restriction request, if applicable. Patients may revoke restrictions at any time per HIPAA.']
  revocation_method varchar [note: 'The method by which the patient revoked the restriction, if applicable. [ENUM-REF-CANDIDATE: written_form|verbal|patient_portal|email|fax|mail|in_person|other — 8 candidates stripped; promote to reference product]']
  supporting_documentation_reference varchar [note: 'Reference identifier or location of supporting documentation submitted with the restriction request (e.g., signed forms, proof of out-of-pocket payment for HITECH restrictions).']
  system_enforcement_flag boolean [note: 'Indicates whether the restriction is actively enforced through automated system controls (True) or requires manual staff intervention (False).']
  termination_date date [note: 'The date the covered entity terminated the restriction, if applicable. Organizations may terminate restrictions under specific circumstances per HIPAA.']
  termination_reason varchar [note: 'The reason the covered entity terminated the restriction, including regulatory justification and patient notification details.']
  vibe_mutation_marker varchar

  Note: 'Master record for patient requests to restrict uses and disclosures of their PHI beyond HIPAA\'s standard permissions. Captures restriction type (restrict disclosure to specific payer when patient paid out-of-pocket per HITECH, restrict sharing with family members, restrict specific data types), requested restriction scope, organization\'s decision to accept or deny the restriction, effective date, and operational instructions for honoring the restriction across clinical systems. Governed by HITECH Act amendment to HIPAA 45 CFR 164.522.'
}

Table consent.disclosure_log {
  disclosure_log_id varchar [pk, note: 'Unique identifier for the consent disclosure log entry. Primary key for the consent disclosure log product.']
  care_site_id varchar [note: 'Reference to the healthcare facility or location where the disclosure was made. Links to the facility product.']
  disclosure_consent_record_id varchar [note: 'Foreign key linking to consent.consent_record. Business justification: The consent_record product description explicitly states it is \'Referenced by disclosure_consent_record_id\', and disclosure_log records every PHI disclosure made under a patient consent or authorizati']
  hipaa_authorization_id varchar [note: 'Foreign key linking to consent.hipaa_authorization. Business justification: PHI disclosures are frequently made under specific HIPAA authorizations. The disclosure_log currently has authorization_reference (STRING) which should be replaced with a proper FK to hipaa_authorizat']
  message_log_id varchar [note: 'Foreign key linking to interoperability.message_log. Business justification: HIPAA accounting of disclosures requires linking each disclosure log entry to the actual message transmission event. When PHI is disclosed via HL7/FHIR/Direct, the message_log provides technical proof']
  mpi_record_id varchar [note: 'Reference to the patient whose Protected Health Information (PHI) was disclosed. Links to the patient master product.']
  parent_disclosure_log_id varchar [note: 'Self-referencing FK on disclosure_log (related_disclosure_log_id)']
  phi_access_log_id varchar [note: 'Foreign key linking to compliance.phi_access_log. Business justification: Disclosures based on consent should be traceable to access logs for complete audit trail of PHI movement. Essential for accounting of disclosures, breach investigation, and demonstrating that disclosu']
  record_id varchar [note: 'Reference to the consent or authorization record under which this disclosure was made. Links to the consent product.']
  visit_id varchar [note: 'Reference to the clinical encounter or visit associated with this disclosure, if applicable. Links to the encounter product.']
  created_timestamp timestamp [note: 'The date and time when this disclosure log record was first created in the system. Supports audit trail and data lineage.']
  department_code varchar [note: 'The code or identifier of the department or unit within the facility that made the disclosure. Supports departmental accountability and reporting.']
  disclosure_date date [note: 'The date on which the Protected Health Information (PHI) disclosure occurred. Required for HIPAA Accounting of Disclosures per 45 CFR 164.528.']
  disclosure_initiated_by varchar [note: 'The name or identifier of the individual or system that initiated the disclosure. Supports audit trail and accountability.']
  disclosure_initiated_by_role varchar [note: 'The role or job title of the individual who initiated the disclosure, such as physician, nurse, HIM specialist, or system administrator. Supports role-based access auditing.']
  disclosure_method varchar [note: 'The method or channel by which the Protected Health Information (PHI) was disclosed. Supports security analysis and breach risk assessment. [ENUM-REF-CANDIDATE: electronic|paper|verbal|fax|secure_email|hie|api|other — 8 candidates stripped; promote to reference product]']
  disclosure_notes varchar [note: 'Additional notes, comments, or context regarding the disclosure. Provides supplementary information for audit and compliance review.']
  disclosure_purpose varchar [note: 'The stated purpose or reason for the Protected Health Information (PHI) disclosure. Required for HIPAA Accounting of Disclosures per 45 CFR 164.528.']
  disclosure_purpose_category varchar [note: 'The standardized category of the disclosure purpose. Enables aggregation and reporting of disclosures by purpose type for compliance and analytics. [ENUM-REF-CANDIDATE: treatment|payment|operations|research|public_health|legal|patient_request|court_order|law_enforcement|other — 10 candidates stripped; promote to reference product]']
  disclosure_status varchar [note: 'The current status of the disclosure transaction. Tracks the lifecycle state of the disclosure event.']
  disclosure_timestamp timestamp [note: 'The precise date and time when the Protected Health Information (PHI) disclosure occurred. Provides granular audit trail for compliance and security investigations.']
  is_accounting_required boolean [note: 'Indicates whether this disclosure must be included in the HIPAA Accounting of Disclosures report provided to patients upon request. Non-TPO disclosures are subject to accounting per 45 CFR 164.528.']
  is_tpo_disclosure boolean [note: 'Indicates whether the disclosure was made for Treatment, Payment, or Operations (TPO) purposes. TPO disclosures are exempt from HIPAA Accounting of Disclosures requirements per 45 CFR 164.528.']
  legal_basis varchar [note: 'The legal or regulatory basis that permitted or required the disclosure, such as court order, subpoena, public health reporting requirement, or patient authorization.']
  minimum_necessary_applied boolean [note: 'Indicates whether the minimum necessary standard was applied to limit the Protected Health Information (PHI) disclosed to only what was reasonably necessary for the stated purpose, as required by 45 CFR 164.502(b).']
  modified_by varchar [note: 'The user ID or system identifier that last modified this disclosure log record. Supports audit trail and accountability.']
  modified_timestamp timestamp [note: 'The date and time when this disclosure log record was last modified. Supports audit trail and change tracking.']
  patient_notification_date date [note: 'The date on which the patient was notified of the disclosure, if notification was required. Supports compliance tracking.']
  patient_notification_required boolean [note: 'Indicates whether the patient must be notified of this disclosure under HIPAA or organizational policy. Certain disclosures require patient notification.']
  phi_elements_disclosed varchar [note: 'Description of the specific Protected Health Information (PHI) elements or data categories that were disclosed. Required for HIPAA Accounting of Disclosures.']
  recipient_address varchar [note: 'The mailing or physical address of the recipient to whom the Protected Health Information (PHI) was disclosed. Required for HIPAA Accounting of Disclosures.']
  recipient_identifier varchar [note: 'The unique identifier for the recipient, such as National Provider Identifier (NPI), Tax ID, or organizational identifier. Enables precise tracking of disclosure recipients.']
  recipient_name varchar [note: 'The name of the individual, organization, or entity to whom the Protected Health Information (PHI) was disclosed. Required for HIPAA Accounting of Disclosures.']
  recipient_type varchar [note: 'The category of recipient to whom the Protected Health Information (PHI) was disclosed. Supports classification and reporting of disclosure patterns. [ENUM-REF-CANDIDATE: individual|organization|government_agency|health_plan|clearinghouse|business_associate|research_institution|public_health_authority|law_enforcement|other — 10 candidates stripped; promote to reference product]']
  system_source varchar [note: 'The name or identifier of the source system or application that recorded the disclosure event, such as Epic EHR, Cerner Millennium, or HIE platform.']
  vibe_mutation_marker varchar
  created_by varchar [note: 'The user ID or system identifier that created this disclosure log record. Supports audit trail and accountability.']

  Note: 'Transactional record of every PHI disclosure made under a patient consent or authorization, providing the accounting of disclosures required by HIPAA. Captures disclosure date, recipient identity and type, purpose of disclosure, PHI elements disclosed, consent or authorization reference, and whether the disclosure was for TPO (exempt from accounting) or non-TPO (subject to accounting). Enables generation of the HIPAA Accounting of Disclosures report provided to patients upon request per 45 CFR 164.528.'
}

Table consent.capacity_assessment {
  capacity_assessment_id varchar [pk, note: 'Unique identifier for the consent capacity assessment record. Primary key for this entity.']
  assessing_clinician_id varchar [note: 'Identifier of the clinician who performed the capacity assessment. Typically a physician, psychiatrist, or psychologist qualified to assess decision-making capacity.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Capacity assessments follow organizational policies defining when assessments are required, who can perform them, and documentation standards. Links assessments to governing policies for audit trails,']
  delegation_id varchar [note: 'Identifier of the surrogate decision-maker engaged for this patient, if applicable.']
  mpi_record_id varchar [note: 'Identifier of the patient whose decision-making capacity is being assessed.']
  primary_capacity_employee_id varchar [note: 'Identifier of the witness present during the assessment, if applicable.']
  prior_capacity_assessment_id varchar [note: 'Self-referencing FK on capacity_assessment (prior_capacity_assessment_id)']
  record_id varchar [note: 'Identifier of the consent record for which this capacity assessment was performed. Links the assessment to the specific consent being sought.']
  visit_id varchar [note: 'Identifier of the clinical encounter during which the capacity assessment was conducted.']
  amendment_reason varchar [note: 'Reason for amendment if the assessment record was modified after initial completion.']
  appreciation_ability varchar [note: 'Assessment of the patient\'s ability to appreciate how the information applies to their own situation.']
  assessing_clinician_specialty varchar [note: 'Medical specialty of the clinician who performed the assessment (e.g., Psychiatry, Neurology, Internal Medicine).']
  assessment_date date [note: 'Date on which the capacity assessment was performed.']
  assessment_duration_minutes varchar [note: 'Duration of the capacity assessment in minutes.']
  assessment_location varchar [note: 'Physical location where the capacity assessment was conducted (e.g., patient room, consultation room, emergency department).']
  assessment_status varchar [note: 'Current status of the capacity assessment record.']
  assessment_timestamp timestamp [note: 'Precise date and time when the capacity assessment was completed.']
  assessment_tool_used varchar [note: 'Name of the standardized assessment instrument or tool used to evaluate capacity (e.g., MacCAT-T, Aid to Capacity Evaluation, UBACC).']
  assessment_tool_version varchar [note: 'Version number or edition of the assessment tool used.']
  capacity_determination varchar [note: 'Overall determination of the patient\'s decision-making capacity resulting from the assessment.']
  capacity_score decimal(5,2) [note: 'Numerical score from the assessment tool, if applicable. Range and interpretation depend on the specific tool used.']
  choice_expression_ability varchar [note: 'Assessment of the patient\'s ability to express a clear and consistent choice.']
  clinical_basis_for_determination varchar [note: 'Clinical rationale and evidence supporting the capacity determination, including relevant medical history, mental status findings, and observed behaviors.']
  contributing_conditions varchar [note: 'Medical or psychiatric conditions that may be affecting the patient\'s decision-making capacity (e.g., dementia, delirium, depression, psychosis).']
  contributing_medications varchar [note: 'Medications that may be affecting the patient\'s cognitive function or decision-making capacity.']
  created_timestamp timestamp [note: 'Timestamp when this capacity assessment record was first created in the system.']
  documentation_reference_code varchar [note: 'Reference identifier to the full clinical documentation of the capacity assessment in the Electronic Health Record (EHR).']
  ethics_consultation_obtained_flag boolean [note: 'Indicates whether an ethics committee consultation was obtained regarding this capacity assessment.']
  interpreter_required_flag boolean [note: 'Indicates whether a language interpreter was required for the capacity assessment.']
  language_code varchar [note: 'ISO 639 language code for the language in which the assessment was conducted.']
  last_updated_timestamp timestamp [note: 'Timestamp when this capacity assessment record was last modified in the system.']
  legal_authority_type varchar [note: 'Type of legal authority the surrogate decision-maker holds, if applicable.']
  legal_consultation_obtained_flag boolean [note: 'Indicates whether legal consultation was obtained regarding this capacity assessment.']
  reasoning_ability varchar [note: 'Assessment of the patient\'s ability to reason about treatment options and their consequences.']
  reassessment_recommended_flag boolean [note: 'Indicates whether a follow-up capacity reassessment is recommended.']
  reassessment_timeframe varchar [note: 'Recommended timeframe for reassessment if indicated (e.g., 24 hours, 72 hours, after treatment of delirium).']
  source_system_record_code varchar [note: 'Unique identifier of this capacity assessment record in the source system.']
  specific_deficits_identified varchar [note: 'Detailed description of specific cognitive or decision-making deficits identified during the assessment.']
  surrogate_decision_maker_engaged_flag boolean [note: 'Indicates whether a surrogate decision-maker was identified and engaged as a result of this capacity assessment.']
  surrogate_relationship varchar [note: 'Relationship of the surrogate decision-maker to the patient (e.g., spouse, adult child, legal guardian, healthcare proxy).']
  understanding_ability varchar [note: 'Assessment of the patient\'s ability to understand relevant information about the treatment or decision.']
  vibe_mutation_marker varchar
  witness_present_flag boolean [note: 'Indicates whether a witness was present during the capacity assessment.']

  Note: 'Transactional record of formal clinical assessments of a patient\'s decision-making capacity to provide informed consent. Captures assessment date, assessing clinician, assessment tool used (MacCAT-T, Aid to Capacity Evaluation), capacity determination (full capacity, diminished capacity, lacks capacity), specific deficits identified, clinical basis for determination, and whether a surrogate decision-maker was engaged. Required when capacity is in question and critical for legal defensibility of consent obtained from vulnerable populations.'
}

Table consent.consent_policy {
  consent_policy_id varchar [pk, note: 'Unique identifier for the consent policy record. Primary key.']
  exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Consent policies define which exchange standards are used for consent transmission (HL7 v2.5.1 CON segment, C-CDA Consent Directive, FHIR Consent). Governance requirement to ensure organizational cons']
  parent_compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Consent-specific policies are often subordinate to or reference broader organizational compliance policies. Establishes policy hierarchy for governance, ensures consent policies align with enterprise ']
  primary_superseded_by_consent_policy_id varchar [note: 'Reference to the consent policy that supersedes this policy. Populated when policy status is \'superseded\'. Null for active policies.']
  tertiary_consent_last_updated_by_user_employee_id varchar [note: 'Identifier of the user who last modified this consent policy record.']
  applicable_facility_types varchar [note: 'Comma-separated list of facility types where this consent policy applies (e.g., hospital, clinic, outpatient center, research facility, telehealth platform).']
  applicable_service_lines varchar [note: 'Comma-separated list of clinical service lines or departments where this consent policy applies (e.g., surgery, oncology, cardiology, behavioral health, radiology).']
  approval_authority varchar [note: 'Name of the organizational body, committee, or individual who approved this consent policy (e.g., Institutional Review Board, Legal Department, Chief Medical Officer, Compliance Committee).']
  approval_date date [note: 'Date when the consent policy was formally approved by the designated approval authority.']
  capacity_assessment_required_flag boolean [note: 'Indicates whether a formal capacity assessment is required before obtaining consent under this policy. True if capacity assessment is mandatory, False otherwise.']
  capacity_assessment_triggers varchar [note: 'Specific conditions or circumstances that trigger the requirement for a capacity assessment (e.g., cognitive impairment, altered mental status, high-risk procedure). Multiple triggers separated by semicolons.']
  consent_category varchar [note: 'Primary category of consent governed by this policy: treatment consent, research consent, data sharing authorization, HIPAA authorization, Health Information Exchange (HIE) opt-in/opt-out, or telehealth consent.']
  consent_subcategory varchar [note: 'Specific subcategory or type within the primary consent category, providing additional classification granularity (e.g., surgical consent, clinical trial consent, genetic data sharing).']
  created_timestamp timestamp [note: 'Timestamp when this consent policy record was first created in the system.']
  documentation_requirements varchar [note: 'Detailed description of documentation requirements for consent obtained under this policy, including required forms, signatures, attestations, and supporting materials.']
  effective_date date [note: 'Date when the consent policy becomes active and enforceable across the organization.']
  electronic_signature_enabled_flag boolean [note: 'Indicates whether electronic signatures are permitted for consent obtained under this policy. True if electronic signatures are allowed, False if only wet signatures are accepted.']
  expiration_date date [note: 'Date when the consent policy expires and is no longer valid. Null for policies without a defined end date.']
  interpreter_required_flag boolean [note: 'Indicates whether a qualified interpreter must be provided when the patient\'s primary language differs from the consent form language. True if interpreter is mandatory, False otherwise.']
  irb_approval_date date [note: 'Date when the IRB approved this research consent policy. Null for non-research consent policies.']
  irb_approval_number varchar [note: 'IRB approval number for research consent policies. Null for non-research consent policies.']
  irb_expiration_date date [note: 'Date when the IRB approval for this research consent policy expires and requires renewal. Null for non-research consent policies.']
  last_updated_timestamp timestamp [note: 'Timestamp when this consent policy record was last modified.']
  legal_representative_allowed_flag boolean [note: 'Indicates whether a legally authorized representative (LAR) may provide consent on behalf of the patient under this policy. True if LAR consent is permitted, False otherwise.']
  minimum_age_requirement varchar [note: 'Minimum age (in years) at which an individual can provide independent consent under this policy without parental or guardian authorization. Null if no age restriction applies.']
  minor_assent_required_flag boolean [note: 'Indicates whether assent from a minor patient is required in addition to parental consent under this policy. True if minor assent is mandatory, False otherwise.']
  policy_code varchar [note: 'Unique business identifier code for the consent policy, used for external reference and system integration.']
  policy_description varchar [note: 'Detailed description of the consent policy purpose, scope, and business context.']
  policy_name varchar [note: 'Human-readable name of the consent policy, used in user interfaces and documentation.']
  policy_status varchar [note: 'Current lifecycle status of the consent policy: draft (under development), active (in use), suspended (temporarily inactive), retired (no longer used), or superseded (replaced by newer policy).']
  reconsent_interval_months varchar [note: 'Number of months after which consent must be renewed if time-based re-consent is required. Null if time-based re-consent does not apply.']
  reconsent_trigger_new_risk boolean [note: 'Indicates whether the discovery of significant new risks triggers the requirement for re-consent under this policy. True if new risk requires re-consent, False otherwise.']
  reconsent_trigger_protocol_amendment boolean [note: 'Indicates whether a protocol amendment triggers the requirement for re-consent under this policy (primarily applicable to research consent). True if protocol amendment requires re-consent, False otherwise.']
  reconsent_trigger_time_based boolean [note: 'Indicates whether consent expires after a defined time period and requires renewal under this policy. True if time-based re-consent is required, False otherwise.']
  regulatory_basis varchar [note: 'Primary regulatory framework or legal requirement that mandates or governs this consent policy (e.g., HIPAA Privacy Rule, FDA 21 CFR Part 50, state-specific consent laws).']
  regulatory_citations varchar [note: 'Specific regulatory citations, statutes, or code sections that apply to this consent policy (e.g., 45 CFR 164.508, 21 CFR 50.25). Multiple citations separated by semicolons.']
  required_consent_elements varchar [note: 'Comma-separated list of mandatory elements that must be included in consent documentation governed by this policy (e.g., purpose, risks, benefits, alternatives, right to refuse, right to revoke).']
  retention_period_years varchar [note: 'Number of years that consent documentation governed by this policy must be retained to meet regulatory and legal requirements.']
  revocation_allowed_flag boolean [note: 'Indicates whether patients have the right to revoke consent obtained under this policy. True if revocation is permitted, False otherwise.']
  revocation_instructions varchar [note: 'Instructions and procedures that patients must follow to revoke consent obtained under this policy, including contact information and required documentation.']
  version_number varchar [note: 'Version identifier for the consent policy, following semantic versioning convention (e.g., 1.0, 2.1, 3.0.1).']
  vibe_mutation_marker varchar
  witness_required_flag boolean [note: 'Indicates whether a witness signature is required for consent obtained under this policy. True if witness is mandatory, False otherwise.']

  Note: 'Reference master defining the organization\'s enterprise consent policies, rules, and requirements governing each consent type. Captures policy name, consent category governed, required consent elements, minimum age for independent consent, capacity assessment triggers, re-consent triggers (protocol amendment, significant new risk, time-based expiration), documentation requirements, and applicable regulatory citations. Drives consent workflow configuration and ensures consistent consent practice across all care settings and facilities.'
}

Table consent.deficiency {
  deficiency_id varchar [pk, note: 'Unique identifier for the consent deficiency record. Primary key.']
  alt5_deficiency_waiver_approved_by_user_employee_id varchar [note: 'Reference to the user or authority who approved the waiver of the consent deficiency.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Consent deficiencies discovered during operations often become formal audit findings requiring corrective action plans. Natural progression from operational issue to compliance finding. Essential for ']
  care_site_id varchar [note: 'Reference to the facility where the consent deficiency occurred or was identified.']
  clinician_id varchar [note: 'Reference to the provider responsible for obtaining the consent or addressing the deficiency.']
  consent_policy_id varchar [note: 'Foreign key linking to consent.consent_policy. Business justification: Consent deficiencies represent violations of consent policies. Adding consent_policy_id FK links each deficiency to the specific policy that was violated, enabling policy-based deficiency reporting an']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Deficiencies requiring remediation link to CAPs that document resolution actions, timelines, and verification. Essential for tracking remediation progress, demonstrating systematic issue resolution, a']
  form_template_id varchar [note: 'Reference to the consent form template that was required but deficient.']
  mpi_record_id varchar [note: 'Reference to the patient for whom the consent deficiency was identified.']
  parent_deficiency_id varchar [note: 'Self-referencing FK on deficiency (related_deficiency_id)']
  primary_deficiency_created_by_user_employee_id varchar [note: 'Reference to the user who created the consent deficiency record.']
  quaternary_deficiency_last_updated_by_user_employee_id varchar [note: 'Reference to the user who last updated the consent deficiency record.']
  quinary_deficiency_remediated_by_user_employee_id varchar [note: 'Reference to the user or staff member who performed the remediation action.']
  record_id varchar [note: 'Reference to the related consent record if one exists but is deficient.']
  tertiary_deficiency_escalated_to_user_employee_id varchar [note: 'Reference to the user or authority to whom the consent deficiency was escalated.']
  visit_id varchar [note: 'Reference to the clinical encounter during which the consent deficiency was identified or occurred.']
  workflow_id varchar [note: 'Foreign key linking to consent.workflow. Business justification: Consent deficiencies often occur when required workflow steps are not followed or completed. Linking deficiency to workflow enables tracking which workflow process was violated or incomplete, supporti']
  audit_reference_number varchar [note: 'Reference number linking the consent deficiency to a formal audit or accreditation survey.']
  created_timestamp timestamp [note: 'Date and time when the consent deficiency record was first created in the system.']
  deficiency_category varchar [note: 'High-level category of the consent deficiency aligned with consent management domains.']
  deficiency_description varchar [note: 'Detailed narrative description of the consent deficiency, including specific issues identified.']
  deficiency_number varchar [note: 'Business identifier for the consent deficiency, used for tracking and reporting purposes.']
  deficiency_status varchar [note: 'Current lifecycle status of the consent deficiency in the remediation workflow.']
  deficiency_type varchar [note: 'Classification of the type of consent deficiency identified. [ENUM-REF-CANDIDATE: not_obtained|improperly_documented|expired|incomplete|missing_signature|missing_witness|invalid_representative|capacity_not_assessed|language_barrier_not_addressed — promote to reference product]']
  discovered_by_role varchar [note: 'Role or job function of the individual who discovered the deficiency (e.g., HIM Specialist, Nurse, Compliance Officer).']
  discovery_date date [note: 'Date on which the consent deficiency was identified.']
  discovery_method varchar [note: 'Method or process by which the consent deficiency was identified. [ENUM-REF-CANDIDATE: pre_procedure_checklist|him_audit|accreditation_survey|patient_complaint|peer_review|quality_audit|compliance_review|incident_report — promote to reference product]']
  discovery_timestamp timestamp [note: 'Precise date and time when the consent deficiency was identified.']
  escalation_date date [note: 'Date on which the consent deficiency was escalated for higher-level review.']
  escalation_required_flag boolean [note: 'Indicates whether the consent deficiency requires escalation to senior management or compliance leadership.']
  last_updated_timestamp timestamp [note: 'Date and time when the consent deficiency record was last modified.']
  mrn varchar [note: 'The patient\'s medical record number associated with this consent deficiency.']
  patient_safety_impact_flag boolean [note: 'Indicates whether the consent deficiency posed a risk to patient safety or care quality.']
  procedure_code varchar [note: 'CPT or HCPCS code for the procedure or service for which consent was required but deficient.']
  procedure_description varchar [note: 'Textual description of the procedure or service associated with the consent deficiency.']
  regulatory_impact_flag boolean [note: 'Indicates whether the consent deficiency has potential regulatory or accreditation implications.']
  remediation_action_taken varchar [note: 'Description of the corrective action taken to remediate the consent deficiency.']
  remediation_date date [note: 'Date on which the consent deficiency was remediated or corrected.']
  remediation_required_flag boolean [note: 'Indicates whether remediation action is required to address the consent deficiency.']
  remediation_timestamp timestamp [note: 'Precise date and time when the consent deficiency was remediated.']
  resolution_date date [note: 'Date on which the consent deficiency was fully resolved (either remediated, waived, or closed).']
  resolution_notes varchar [note: 'Additional notes or comments regarding the resolution of the consent deficiency.']
  responsible_department_code varchar [note: 'Code identifying the department or service line responsible for the consent deficiency.']
  scheduled_procedure_date date [note: 'Date on which the procedure requiring consent was scheduled or performed.']
  severity_level varchar [note: 'Severity classification of the consent deficiency based on risk and regulatory impact.']
  source_system_deficiency_code varchar [note: 'Unique identifier for the consent deficiency in the source system.']
  vibe_mutation_marker varchar
  waiver_date date [note: 'Date on which the consent deficiency waiver was approved.']
  waiver_reason varchar [note: 'Explanation or justification for waiving the consent deficiency without remediation.']

  Note: 'Transactional record of identified consent deficiencies — instances where required consent was not obtained, was improperly documented, expired, or is otherwise incomplete at the time of care delivery or audit. Captures deficiency type, discovery method (pre-procedure checklist, HIM audit, accreditation survey, patient complaint), responsible provider or department, deficiency status (open, remediated, waived), remediation action taken, and resolution date. Supports HIM, compliance, and quality improvement workflows for consent management.'
}

Table consent.substance_use_consent {
  substance_use_consent_id varchar [pk, note: 'Unique identifier for the substance use disorder consent record. Primary key.']
  care_site_id varchar [note: 'Unique identifier for the healthcare facility or substance use disorder treatment program where this consent authorization was obtained.']
  clinician_id varchar [note: 'Unique identifier for the healthcare provider or staff member who obtained this substance use disorder consent authorization from the patient.']
  mpi_record_id varchar [note: 'Unique identifier for the patient who is the subject of this substance use disorder consent.']
  part2_consent_workflow_id varchar [note: 'FK to behavioral_health.part2_consent_workflow; links this 42 CFR Part 2 consent record to the disclosure governance workflow that controls redisclosure of SUD/behavioral health treatment data.']
  record_id varchar [note: 'Foreign key linking to consent.record. Business justification: Substance use consent is a specialized type of consent record governed by 42 CFR Part 2. Linking to the core record table enables unified consent management. Core consent lifecycle attributes (status,']
  superseded_substance_use_consent_id varchar [note: 'Self-referencing FK on substance_use_consent (superseded_substance_use_consent_id)']
  visit_id varchar [note: 'Unique identifier for the clinical encounter during which this substance use disorder consent authorization was obtained, if applicable.']
  capacity_assessment_performed_flag boolean [note: 'Indicates whether a formal assessment of the patient capacity to provide informed consent was performed prior to obtaining this substance use disorder consent authorization.']
  capacity_assessment_result varchar [note: 'The result of the capacity assessment, indicating whether the patient was deemed to have the capacity to provide informed consent for substance use disorder information disclosure.']
  cares_act_compliant_flag boolean [note: 'Indicates whether this substance use disorder consent authorization complies with the 2020 CARES Act amendments to 42 CFR Part 2, which permit disclosure for treatment, payment, and healthcare operations.']
  created_timestamp timestamp [note: 'The date and time when this substance use disorder consent record was first created in the system.']
  disclosure_purpose varchar [note: 'The specific purpose for which substance use disorder treatment information may be disclosed, as required by 42 CFR Part 2 Section 2.31(a)(4).']
  disclosure_purpose_category varchar [note: 'High-level categorization of the disclosure purpose, aligned with CARES Act 2020 amendments allowing disclosure for treatment, payment, and healthcare operations.']
  document_reference varchar [note: 'Reference identifier or URI to the scanned or electronically stored copy of the signed substance use disorder consent authorization document.']
  expiration_event varchar [note: 'Description of the event that will terminate this consent authorization if expiration is event-based rather than date-based, as permitted by 42 CFR Part 2 Section 2.31(a)(8).']
  form_version varchar [note: 'The version identifier of the substance use disorder consent form template used to capture this authorization.']
  information_disclosed_description varchar [note: 'Detailed description of the specific substance use disorder treatment information to be disclosed, as required by 42 CFR Part 2 Section 2.31(a)(3).']
  interpreter_name varchar [note: 'The name of the interpreter who assisted the patient in understanding this substance use disorder consent authorization, if applicable.']
  interpreter_required_flag boolean [note: 'Indicates whether a language interpreter was required to facilitate the patient understanding and signing of this substance use disorder consent authorization.']
  language_code varchar [note: 'The ISO 639-1 language code indicating the language in which this substance use disorder consent authorization was presented to and signed by the patient.']
  last_updated_timestamp timestamp [note: 'The date and time when this substance use disorder consent record was most recently updated in the system.']
  mrn varchar [note: 'The medical record number of the patient as recorded in the substance use disorder treatment program.']
  notes varchar [note: 'Additional free-text notes or comments regarding this substance use disorder consent authorization, including special circumstances or clarifications.']
  personal_representative_flag boolean [note: 'Indicates whether this consent authorization was signed by a personal representative on behalf of the patient rather than by the patient directly.']
  personal_representative_name varchar [note: 'The name of the personal representative who signed this substance use disorder consent authorization on behalf of the patient, if applicable.']
  personal_representative_relationship varchar [note: 'The relationship of the personal representative to the patient, such as parent, legal guardian, or healthcare power of attorney.']
  recipient_address varchar [note: 'The mailing or physical address of the recipient authorized to receive substance use disorder treatment information.']
  recipient_name varchar [note: 'The name of the person or organization to whom substance use disorder treatment information may be disclosed, as required by 42 CFR Part 2 Section 2.31(a)(5).']
  recipient_npi varchar [note: 'The National Provider Identifier of the recipient organization or provider authorized to receive substance use disorder treatment information.']
  recipient_organization varchar [note: 'The organization or entity name of the recipient authorized to receive substance use disorder treatment information.']
  redisclosure_prohibition_included_flag boolean [note: 'Indicates whether the required redisclosure prohibition notice was included with this consent authorization, as mandated by 42 CFR Part 2 Section 2.32.']
  redisclosure_prohibition_notice varchar [note: 'The required notice to recipients that substance use disorder treatment information is protected by federal law and cannot be redisclosed without patient consent, as mandated by 42 CFR Part 2 Section 2.32.']
  right_to_revoke_statement varchar [note: 'The statement informing the patient of their right to revoke this consent authorization and the procedure for doing so, as required by 42 CFR Part 2 Section 2.31(a)(9).']
  signature_date date [note: 'The date on which the patient signed this substance use disorder consent authorization, as required by 42 CFR Part 2 Section 2.31(a)(10).']
  signature_method varchar [note: 'The method by which the patient signature was captured for this substance use disorder consent authorization.']
  signature_obtained_flag boolean [note: 'Indicates whether the patient signature was obtained on this substance use disorder consent authorization, as required by 42 CFR Part 2 Section 2.31(a)(10).']
  source_system_code varchar [note: 'The unique identifier for this substance use disorder consent record in the source system from which it was extracted.']
  sud_program_name varchar [note: 'The specific name of the substance use disorder treatment program or facility making the disclosure, as required by 42 CFR Part 2.']
  sud_program_npi varchar [note: 'The National Provider Identifier of the substance use disorder treatment program or facility.']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'The name of the witness who observed the patient signing this substance use disorder consent authorization, if applicable.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required for this substance use disorder consent authorization based on program policy or patient capacity.']
  witness_signature_date date [note: 'The date on which the witness signed this substance use disorder consent authorization, if applicable.']

  Note: 'Specialized master record for consent and authorization governing disclosure of substance use disorder (SUD) treatment records, which carry heightened federal confidentiality protections beyond standard HIPAA. Captures consent elements required by 42 CFR Part 2 including specific program name, patient name, specific information to be disclosed, purpose of disclosure, recipient, expiration, and right to revoke. Tracks re-disclosure prohibition notices and patient-permitted disclosures for treatment, payment, and operations under the 2020 CARES Act amendments.'
}

Table consent.behavioral_health_consent {
  behavioral_health_consent_id varchar [pk, note: 'Unique identifier for the behavioral health consent record. Primary key.']
  care_site_id varchar [note: 'Unique identifier of the healthcare facility where this consent was obtained.']
  clinician_id varchar [note: 'Unique identifier of the healthcare provider or staff member who obtained this behavioral health consent from the patient.']
  mpi_record_id varchar [note: 'Unique identifier for the patient who is the subject of this behavioral health consent.']
  part2_consent_workflow_id varchar [note: 'FK to behavioral_health.part2_consent_workflow; links this 42 CFR Part 2 consent record to the disclosure governance workflow that controls redisclosure of SUD/behavioral health treatment data.']
  superseded_behavioral_health_consent_id varchar [note: 'Self-referencing FK on behavioral_health_consent (superseded_behavioral_health_consent_id)']
  visit_id varchar [note: 'Unique identifier of the clinical encounter during which this behavioral health consent was obtained, if applicable.']
  authorized_recipient_address varchar [note: 'Mailing or physical address of the authorized recipient organization or individual.']
  authorized_recipient_name varchar [note: 'Name of the individual, organization, or entity authorized to receive the behavioral health information under this consent.']
  authorized_recipient_npi varchar [note: 'National Provider Identifier of the authorized recipient if the recipient is a healthcare provider or organization.']
  authorized_recipient_type varchar [note: 'Classification of the authorized recipient (individual provider, healthcare organization, insurance payer, legal entity, research institution).']
  capacity_assessment_performed_flag boolean [note: 'Indicates whether a formal assessment of the patient\'s decision-making capacity was performed prior to obtaining this consent.']
  capacity_determination varchar [note: 'The clinical determination of the patient\'s decision-making capacity at the time this consent was obtained.']
  consent_number varchar [note: 'Externally-known unique identifier or tracking number for this behavioral health consent authorization.']
  consent_status varchar [note: 'Current lifecycle status of the behavioral health consent authorization.']
  consent_type varchar [note: 'The category of behavioral health consent being granted (disclosure authorization, treatment consent, research participation, data sharing, HIE participation).']
  created_timestamp timestamp [note: 'The date and time when this behavioral health consent record was first created in the system.']
  disclosure_purpose varchar [note: 'The specific purpose for which the behavioral health information may be disclosed (e.g., continuity of care, legal proceedings, disability determination, insurance underwriting).']
  disclosure_purpose_category varchar [note: 'High-level category of the disclosure purpose for reporting and analytics. [ENUM-REF-CANDIDATE: treatment|payment|legal|research|personal|disability|other — 7 candidates stripped; promote to reference product]']
  document_reference_code varchar [note: 'Reference identifier or URI to the scanned or electronically stored copy of the signed consent form document.']
  effective_date date [note: 'The date on which this behavioral health consent authorization becomes effective and enforceable.']
  expiration_date date [note: 'The date on which this behavioral health consent authorization expires. Null if no expiration date is specified.']
  expiration_event varchar [note: 'Description of the event or condition that will cause this consent to expire (e.g., end of treatment episode, completion of legal proceeding, patient request).']
  form_version varchar [note: 'Version identifier of the behavioral health consent form template used for this authorization.']
  interpreter_name varchar [note: 'Name of the language interpreter who assisted in obtaining this consent, if applicable.']
  interpreter_required_flag boolean [note: 'Indicates whether a language interpreter was required to obtain this consent due to patient language preference or limited English proficiency.']
  language_code varchar [note: 'ISO 639-1 two-letter code indicating the language in which this consent was presented and obtained.']
  last_updated_timestamp timestamp [note: 'The date and time when this behavioral health consent record was most recently modified.']
  legal_authority_type varchar [note: 'The type of legal authority under which the representative is acting on behalf of the patient.']
  legal_representative_flag boolean [note: 'Indicates whether this consent was signed by a legal representative or surrogate decision-maker on behalf of the patient.']
  legal_representative_name varchar [note: 'Name of the legal representative or surrogate decision-maker who signed this consent on behalf of the patient.']
  legal_representative_relationship varchar [note: 'The legal relationship of the representative to the patient (e.g., parent, legal guardian, healthcare power of attorney, conservator).']
  mental_health_data_elements_covered varchar [note: 'Specific categories of behavioral health information covered by this consent (e.g., psychotherapy notes, psychiatric hospitalization records, mental illness medications, substance abuse treatment records). Pipe-delimited list.']
  mrn varchar [note: 'The medical record number assigned to the patient by the healthcare organization.']
  notes varchar [note: 'Free-text field for additional notes, comments, or context regarding this behavioral health consent authorization.']
  obtaining_provider_npi varchar [note: 'National Provider Identifier of the provider who obtained this consent.']
  patient_imposed_restrictions varchar [note: 'Free-text description of any specific restrictions or limitations the patient has placed on the disclosure of their behavioral health information.']
  psychotherapy_notes_included_flag boolean [note: 'Indicates whether HIPAA-protected psychotherapy notes are explicitly included in the scope of this consent authorization.']
  redisclosure_prohibition_statement varchar [note: 'Statement informing the recipient that the disclosed behavioral health information is protected by state and federal law and may not be redisclosed without patient authorization.']
  revocation_date date [note: 'The date on which the patient revoked this behavioral health consent authorization. Null if not revoked.']
  revocation_method varchar [note: 'The method by which the patient communicated their revocation of this consent (written notice, verbal request, electronic submission, in-person notification).']
  revocation_reason varchar [note: 'Free-text explanation of the reason the patient provided for revoking this consent, if documented.']
  right_to_revoke_statement varchar [note: 'Statement informing the patient of their right to revoke this consent authorization and the process for doing so.']
  signature_date date [note: 'The date on which the patient or authorized representative signed this behavioral health consent authorization.']
  signature_method varchar [note: 'The method used to capture the patient or representative signature (wet ink, electronic signature, digital signature, biometric, recorded verbal consent).']
  signature_obtained_flag boolean [note: 'Indicates whether a valid patient or authorized representative signature was obtained for this consent authorization.']
  source_system_code varchar [note: 'The unique identifier for this consent record in the source operational system.']
  state_jurisdiction varchar [note: 'The U.S. state whose mental health confidentiality laws apply to this consent (two-letter state code).']
  state_law_basis varchar [note: 'Citation of the specific state statute or regulation governing heightened confidentiality protections for behavioral health records in the applicable jurisdiction.']
  substance_abuse_records_included_flag boolean [note: 'Indicates whether substance abuse treatment records subject to 42 CFR Part 2 protections are included in this consent.']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'Name of the individual who witnessed the signing of this behavioral health consent authorization, if applicable.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required for this consent under applicable state law or organizational policy.']
  witness_signature_date date [note: 'The date on which the witness signed this consent authorization, if applicable.']

  Note: 'Specialized master record for consent governing disclosure of behavioral health, mental health, and psychiatric treatment records, which are subject to state-specific heightened confidentiality protections beyond standard HIPAA. Captures state law basis, specific mental health data elements covered (psychotherapy notes, psychiatric hospitalization, medication for mental illness), authorized recipients, purpose, expiration, and patient-imposed restrictions. Manages the complex intersection of HIPAA psychotherapy note protections and state mental health confidentiality statutes.'
}

Table consent.expiration_alert {
  expiration_alert_id varchar [pk, note: 'Unique identifier for the consent expiration alert record. Primary key for the consent expiration alert operational tracking entity.']
  employee_id varchar [note: 'Reference to the staff member or provider assigned responsibility for resolving this consent expiration alert. May be consent coordinator, case manager, or clinical staff depending on consent type and organizational workflow.']
  expiring_consent_record_id varchar [note: 'Foreign key linking to consent.consent_record. Business justification: expiration_alert tracks consent records approaching or past their expiration date that require proactive renewal. Each alert is generated for a specific consent record. consent_record is the generic S']
  mpi_record_id varchar [note: 'Reference to the patient whose consent is expiring. Enables patient-centric alert routing and notification workflows.']
  org_unit_id varchar [note: 'Reference to the department or care team responsible for consent renewal action. Enables departmental worklist routing and accountability tracking.']
  prior_expiration_alert_id varchar [note: 'Self-referencing FK on expiration_alert (prior_expiration_alert_id)']
  record_id varchar [note: 'Reference to the consent record that is approaching or past expiration. Links this alert to the specific consent requiring renewal action.']
  visit_id varchar [note: 'Reference to a scheduled patient encounter or appointment that requires the expiring consent. Links alert to specific care event at risk of delay or cancellation.']
  workflow_id varchar [note: 'Foreign key linking to consent.workflow. Business justification: Expiration alerts trigger consent renewal workflows. Linking expiration_alert to workflow enables tracking which renewal workflow should be initiated for each alert, supporting automated workflow trig']
  alert_generation_date date [note: 'The date on which this expiration alert was generated by the consent monitoring system. Establishes alert creation timeline for SLA tracking.']
  alert_generation_timestamp timestamp [note: 'Precise date and time when the alert was created by the automated consent expiration monitoring process. Used for audit trail and alert latency analysis.']
  alert_number varchar [note: 'Human-readable business identifier for the consent expiration alert. Format: CEA-XXXXXXXXXX where X is a digit. Used for tracking and reference in workflows and communications.']
  alert_priority varchar [note: 'Business priority level assigned to the alert based on consent type, patient care impact, and time to expiration. Drives workflow routing and staff assignment.']
  alert_status varchar [note: 'Current lifecycle status of the consent expiration alert. Open indicates new alert requiring attention; acknowledged indicates staff awareness; in progress indicates renewal workflow initiated; resolved indicates consent renewed or issue addressed; escalated indicates elevated priority; cancelled indicates alert no longer applicable.']
  alert_type varchar [note: 'Classification of the expiration alert based on urgency and timing. Approaching expiration indicates consent nearing end date; expired indicates consent has lapsed; renewal required indicates proactive action needed; grace period indicates post-expiration window; critical indicates immediate action required to prevent care disruption.']
  auto_renewal_eligible_flag boolean [note: 'Indicates whether the consent is eligible for automatic renewal without patient re-signature based on consent type and organizational policy. True if auto-renewal allowed; false if patient action required.']
  care_impact_flag boolean [note: 'Indicates whether the expiring consent has direct impact on patient care delivery. True if consent expiration would delay or prevent scheduled treatment, procedures, or services; false if administrative only.']
  consent_expiration_date date [note: 'The date on which the referenced consent record expires or expired. Denormalized from consent record for alert processing efficiency and historical tracking.']
  consent_scope varchar [note: 'The scope or coverage of the expiring consent. Denormalized from consent record to inform renewal urgency. Examples: General Treatment, Specific Procedure, Research Study Participation, Broad Data Sharing, Limited Disclosure.']
  consent_type varchar [note: 'The category of consent that is expiring. Denormalized from consent record for alert filtering and prioritization. Examples: Treatment Consent, Research Consent, HIPAA Authorization, HIE Opt-In, Telehealth Consent, Data Sharing Authorization.']
  created_timestamp timestamp [note: 'Date and time when this alert record was first created in the data platform. Used for audit trail and data lineage tracking.']
  days_until_expiration varchar [note: 'Number of days remaining until consent expiration at the time of alert generation. Negative values indicate days since expiration. Used for alert prioritization and workflow routing.']
  escalation_date date [note: 'The date on which the alert was escalated. Null if no escalation occurred.']
  escalation_flag boolean [note: 'Indicates whether this alert has been escalated to higher authority or management due to unresolved status, patient unreachability, or care impact. True if escalated; false if standard workflow.']
  escalation_reason varchar [note: 'The reason or justification for escalating the alert. Examples: Patient unreachable after multiple attempts, consent critical for scheduled procedure, regulatory compliance risk, patient dispute.']
  last_reminder_date date [note: 'The date of the most recent reminder notification sent for this alert. Used to schedule follow-up reminders and assess communication frequency.']
  last_updated_timestamp timestamp [note: 'Date and time when this alert record was most recently modified. Tracks alert lifecycle changes and status updates.']
  next_action_due_date date [note: 'The target date by which the next action (patient contact, escalation, resolution) should be completed. Drives workflow task scheduling and SLA monitoring.']
  notification_channel varchar [note: 'Primary communication channel used to deliver the expiration alert notification. Patient portal for patient-facing alerts; staff worklist for clinical team alerts; EHR alert for in-system notifications; email, SMS, phone, mail for direct outreach; none if alert is internal only. [ENUM-REF-CANDIDATE: patient_portal|staff_worklist|ehr_alert|email|sms|phone|mail|none — 8 candidates stripped; promote to reference product]']
  notification_delivery_status varchar [note: 'Detailed status of notification delivery attempt. Pending indicates queued; sent indicates transmitted; delivered indicates confirmed receipt; failed indicates delivery error; bounced indicates invalid recipient; read indicates recipient opened notification.']
  notification_sent_flag boolean [note: 'Indicates whether an alert notification has been successfully sent through the designated channel. True if notification delivered; false if pending or failed.']
  notification_sent_timestamp timestamp [note: 'Date and time when the alert notification was successfully delivered to the recipient. Null if notification not yet sent or failed.']
  patient_contact_attempted_flag boolean [note: 'Indicates whether staff have attempted to contact the patient regarding consent renewal. True if outreach initiated; false if no contact attempt made.']
  patient_contact_date date [note: 'The date on which staff successfully contacted the patient regarding the expiring consent. Null if contact not yet made or unsuccessful.']
  patient_response varchar [note: 'The patients response to the consent renewal request. Agreed to renew indicates patient consent to continue; declined renewal indicates patient wishes to revoke or not extend; requested modification indicates patient wants changes; no response indicates patient has not replied; unreachable indicates contact attempts failed.']
  regulatory_compliance_flag boolean [note: 'Indicates whether the expiring consent is required for regulatory compliance (HIPAA, research IRB, state law). True if regulatory mandate; false if organizational policy only.']
  reminder_count varchar [note: 'The number of reminder notifications sent to patient or staff regarding this expiring consent. Used to track outreach intensity and prevent notification fatigue.']
  renewal_method varchar [note: 'The method or channel through which consent renewal should be obtained. In-person for clinic visit; patient portal for electronic signature; telehealth for virtual visit; mail for postal forms; phone for verbal consent; email for electronic forms; not applicable if renewal not required. [ENUM-REF-CANDIDATE: in_person|patient_portal|telehealth|mail|phone|email|not_applicable — 7 candidates stripped; promote to reference product]']
  renewal_required_flag boolean [note: 'Indicates whether the expiring consent requires active patient re-consent or renewal action. True if patient signature or new authorization needed; false if consent can be administratively extended or is not renewable.']
  resolution_date date [note: 'The date on which the consent expiration alert was resolved or closed. Null if alert remains open.']
  resolution_notes varchar [note: 'Free-text notes documenting the actions taken to resolve the alert, patient interactions, barriers encountered, and final outcome. Supports audit trail and quality improvement.']
  resolution_status varchar [note: 'The outcome or resolution of the consent expiration alert. Pending indicates unresolved; consent renewed indicates patient re-consented; consent revoked indicates patient declined continuation; consent expired indicates lapsed without renewal; administrative extension indicates organizational extension granted; patient unreachable indicates contact failure; no action required indicates alert cancelled or superseded. [ENUM-REF-CANDIDATE: pending|consent_renewed|consent_revoked|consent_expired|administrative_extension|patient_unreachable|no_action_required — 7 candidates stripped; promote to reference product]']
  resolution_timestamp timestamp [note: 'Precise date and time when the alert was resolved or closed. Used for alert resolution time analysis and Service Level Agreement (SLA) compliance tracking.']
  responsible_staff_role varchar [note: 'The functional role or job title of the staff member assigned to this alert. Examples: Consent Coordinator, Case Manager, Primary Care Physician (PCP), Nurse Navigator, Health Information Management (HIM) Specialist.']
  scheduled_procedure_date date [note: 'The date of a scheduled procedure or service that requires the expiring consent. Used to assess urgency and care impact of unresolved alert.']
  sla_breach_flag boolean [note: 'Indicates whether the alert resolution exceeded the SLA target resolution time. True if SLA breached; false if resolved within target.']
  sla_target_resolution_hours varchar [note: 'The number of hours within which this alert should be resolved per organizational Service Level Agreement (SLA). Based on alert priority and consent type.']
  vibe_mutation_marker varchar

  Note: 'Operational record tracking consent records approaching or past their expiration date that require patient re-consent or renewal action. Captures consent reference, expiration date, alert generation date, alert type (approaching expiration, expired, renewal required), notification channel used (patient portal, staff worklist, EHR alert), responsible staff member, and resolution status. Drives proactive consent renewal workflows to prevent care delays and compliance gaps from expired consents.'
}

Table consent.genetic_testing_consent {
  genetic_testing_consent_id varchar [pk, note: 'Unique identifier for the genetic testing consent record. Primary key for this entity.']
  care_site_id varchar [note: 'Reference to the healthcare facility where the genetic testing consent was obtained. Links to the facility master record.']
  clinician_id varchar [note: 'Reference to the healthcare provider who obtained the genetic testing consent from the patient. Links to the provider master record.']
  employee_id varchar [note: 'Reference to the genetic counselor who provided pre-test counseling and education to the patient. May be null if genetic counseling was not provided.']
  form_template_id varchar [note: 'Reference to the standardized consent form template used for this genetic testing consent. Links to the template that defines the structure and regulatory requirements.']
  mpi_record_id varchar [note: 'Reference to the patient who is providing consent for genetic testing. Links to the patient master record.']
  record_id varchar [note: 'Foreign key linking to consent.record. Business justification: Genetic testing consent is a specialized type of consent record. It should link to the core consent.record table to maintain referential integrity and enable unified consent reporting. The specialized']
  research_study_id varchar [note: 'Reference to the research study if the genetic testing is being performed as part of a research protocol. Null for clinical testing not associated with research.']
  superseded_genetic_testing_consent_id varchar [note: 'Self-referencing FK on genetic_testing_consent (superseded_genetic_testing_consent_id)']
  visit_id varchar [note: 'Reference to the clinical encounter during which the genetic testing consent was obtained. May be null for consents obtained outside of a specific encounter.']
  authorized_representative_flag boolean [note: 'Indicates whether the consent was obtained from an authorized representative rather than the patient directly. True if representative signed, false if patient signed.']
  authorized_representative_name varchar [note: 'The full name of the authorized representative who provided consent on behalf of the patient. Null if patient provided consent directly.']
  authorized_representative_relationship varchar [note: 'The relationship of the authorized representative to the patient. Examples include parent, legal guardian, healthcare proxy, power of attorney. Null if patient provided consent directly.']
  biobank_storage_consent varchar [note: 'The patients authorization for their biological samples to be stored in a biobank for future use. Defines duration and conditions of sample storage.']
  capacity_assessment_performed_flag boolean [note: 'Indicates whether a formal assessment of the patients decision-making capacity was performed prior to obtaining consent. True if assessment occurred, false otherwise.']
  capacity_assessment_result varchar [note: 'The outcome of the capacity assessment. Indicates whether the patient was determined to have full, partial, or no decision-making capacity. Null if assessment was not performed.']
  commercial_use_consent varchar [note: 'The patients authorization for their genetic data or samples to be used for commercial purposes such as drug development or diagnostic test development. Defines scope of commercial use.']
  consent_decision varchar [note: 'The patients decision regarding the genetic testing consent. Indicates whether the patient agreed to, declined, or partially consented to the testing.']
  consent_scope varchar [note: 'The breadth of authorization provided by the patient. Defines whether consent covers only the immediate test or extends to future research, biobanking, or data sharing.']
  counseling_date date [note: 'The date on which genetic counseling was provided to the patient. Null if counseling was not provided.']
  counseling_provided_flag boolean [note: 'Indicates whether genetic counseling was provided to the patient prior to obtaining consent. True if counseling occurred, false otherwise.']
  created_timestamp timestamp [note: 'The date and time when this genetic testing consent record was first created in the system. Used for audit trail and data lineage tracking.']
  data_retention_period_years varchar [note: 'The number of years for which the genetic data and samples will be retained. May be null for indefinite retention or as specified by patient preference.']
  document_reference_code varchar [note: 'Reference to the stored consent document in the document management system. Used for retrieving the signed consent form for audit or legal purposes.']
  family_implications_disclosed_flag boolean [note: 'Indicates whether the patient was informed that genetic test results may have implications for biological family members. True if disclosure occurred, false otherwise.']
  family_notification_consent varchar [note: 'The patients authorization for the healthcare provider to contact biological family members if test results reveal hereditary conditions. Defines scope of family outreach.']
  form_version varchar [note: 'The version identifier of the genetic testing consent form used. Used for tracking form revisions and ensuring regulatory compliance.']
  gina_disclosure_flag boolean [note: 'Indicates whether the patient was informed about GINA protections and limitations regarding genetic discrimination by health insurers and employers. True if disclosure occurred, false otherwise.']
  incidental_findings_consent varchar [note: 'The patients preference regarding the return of incidental or secondary findings discovered during genetic testing. Defines what types of unexpected findings should be disclosed.']
  insurance_discrimination_risk_disclosed_flag boolean [note: 'Indicates whether the patient was informed about potential risks of genetic discrimination by life, disability, or long-term care insurers not covered by GINA. True if disclosure occurred, false otherwise.']
  interpreter_required_flag boolean [note: 'Indicates whether a language interpreter was required to facilitate the consent process. True if interpreter was used, false otherwise.']
  irb_approval_number varchar [note: 'The approval number assigned by the Institutional Review Board if the genetic testing is part of a research study. Null for clinical testing not subject to IRB oversight.']
  language_code varchar [note: 'The ISO 639-1 two-letter code representing the language in which the genetic testing consent was provided to the patient. Used for language access compliance.']
  last_updated_timestamp timestamp [note: 'The date and time when this genetic testing consent record was most recently modified. Used for audit trail and change tracking.']
  mrn varchar [note: 'The unique medical record number assigned to the patient by the healthcare organization. Used for patient identification and record linkage.']
  notes varchar [note: 'Free-text field for capturing additional information, special circumstances, or clarifications related to the genetic testing consent process.']
  obtaining_provider_npi varchar [note: 'The National Provider Identifier of the healthcare provider who obtained the genetic testing consent. Used for provider identification and credentialing.']
  recontact_consent varchar [note: 'The patients authorization for the healthcare provider or research team to recontact them in the future if new clinically significant findings emerge from their genetic data. Defines scope of future communication.']
  research_registry_sharing_consent varchar [note: 'The patients authorization for their genetic data to be shared with external research registries or databases. Defines scope of data sharing permissions.']
  research_use_consent varchar [note: 'The patients authorization for their genetic data and samples to be used in future research studies. Defines scope and limitations of research use.']
  signature_date date [note: 'The date on which the patient signed the genetic testing consent form. May differ from obtained date if form was signed and processed on different dates.']
  signature_method varchar [note: 'The method by which the patients signature was obtained. Indicates whether signature was electronic, physical, verbal, or obtained through an authorized representative.']
  signature_obtained_flag boolean [note: 'Indicates whether the patients signature was obtained on the genetic testing consent form. True if signature was captured, false otherwise.']
  source_system_code varchar [note: 'The unique identifier for this genetic testing consent record in the source system. Used for data reconciliation and troubleshooting.']
  state_jurisdiction varchar [note: 'The two-letter US state code or jurisdiction where the consent was obtained. Used for applying state-specific genetic privacy laws and regulations.']
  test_name varchar [note: 'The specific name or description of the genetic test to be performed. May include gene panel names, specific gene targets, or test methodology.']
  test_purpose varchar [note: 'The primary clinical or research purpose for performing the genetic test. Defines the intended use of the test results. [ENUM-REF-CANDIDATE: clinical_diagnosis|risk_assessment|treatment_selection|family_planning|research|ancestry|other — 7 candidates stripped; promote to reference product]']
  test_type varchar [note: 'The category of genetic testing for which consent is being obtained. Defines the scope and purpose of the genetic analysis to be performed. [ENUM-REF-CANDIDATE: diagnostic|predictive|carrier|pharmacogenomic|whole_genome_sequencing|whole_exome_sequencing|targeted_panel|prenatal|newborn_screening|other — 10 candidates stripped; promote to reference product]']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'The full name of the witness who observed the consent process and signed the form. Null if witness was not required or not present.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required for this genetic testing consent based on regulatory requirements or organizational policy. True if witness required, false otherwise.']
  witness_signature_date date [note: 'The date on which the witness signed the genetic testing consent form. Null if witness was not required or not present.']

  Note: 'Specialized master record for informed consent governing genetic testing, genomic sequencing, and biobanking. Captures test type (diagnostic, predictive, carrier, pharmacogenomic, whole genome sequencing), scope of consent (specific test only, future research use, biobank storage, return of incidental findings), family member implications disclosure, insurance discrimination risk disclosure per GINA, data sharing permissions for research registries, and consent for re-contact as new findings emerge. Governed by GINA, state genetic privacy laws, and ACMG guidelines.'
}

Table consent.photography_media_consent {
  photography_media_consent_id varchar [pk, note: 'Unique identifier for the photography and media consent record. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the photography and media consent was obtained. Links to the facility master record.']
  clinician_id varchar [note: 'Identifier of the healthcare provider or staff member who obtained the photography and media consent from the patient. Links to the provider master record.']
  form_template_id varchar [note: 'Identifier of the consent form template used for this photography and media consent. Links to the consent form template master record.']
  mpi_record_id varchar [note: 'Unique identifier for the patient who is the subject of the photography or media consent. Links to the patient master record.']
  record_id varchar [note: 'Foreign key linking to consent.record. Business justification: Photography/media consent is a specialized type of consent record. Linking to the core record table enables unified consent management and reporting. Core consent lifecycle attributes (status, dates, ']
  research_study_id varchar [note: 'Identifier of the research study for which the photography and media consent was obtained, if applicable. Links to the research study master record. Null if not research-related.']
  superseded_photography_media_consent_id varchar [note: 'Self-referencing FK on photography_media_consent (superseded_photography_media_consent_id)']
  visit_id varchar [note: 'Identifier of the clinical encounter or visit during which the photography and media consent was obtained. Links to the encounter master record.']
  capacity_assessment_performed_flag boolean [note: 'Indicates whether a formal capacity assessment was performed to determine the patient\'s ability to provide informed consent for photography and media use. True if assessment performed; False otherwise.']
  capacity_assessment_result varchar [note: 'The outcome of the capacity assessment indicating whether the patient has capacity, lacks capacity, has partial capacity, or was not assessed.']
  compensation_description varchar [note: 'Description of any compensation, payment, or consideration provided to the patient in exchange for consent to use their images or media.']
  compensation_disclosure_flag boolean [note: 'Indicates whether the patient was informed of any compensation, remuneration, or consideration related to the use of their images or media. True if compensation was disclosed; False otherwise.']
  created_timestamp timestamp [note: 'The date and time when this photography and media consent record was first created in the system.']
  distribution_channels varchar [note: 'Comma-separated list or description of authorized distribution channels where the media may be shared, such as internal presentations, peer-reviewed journals, conferences, websites, social media platforms, or educational materials.']
  document_reference varchar [note: 'Reference identifier, URL, or file path to the scanned or electronic copy of the signed photography and media consent form stored in the document management system.']
  form_version varchar [note: 'Version number or identifier of the photography and media consent form used at the time consent was obtained.']
  identifiable_flag boolean [note: 'Indicates whether the patient will be identifiable in the media. True if patient identity is visible or disclosed; False if media will be de-identified or anonymized.']
  intended_use varchar [note: 'The primary intended purpose for which the patient images or media will be used, such as clinical documentation, medical education, research, publication, marketing, social media, quality improvement, or legal proceedings. [ENUM-REF-CANDIDATE: clinical_documentation|medical_education|research|publication|marketing|social_media|quality_improvement|legal_proceedings — 8 candidates stripped; promote to reference product]']
  interpreter_name varchar [note: 'Full name of the interpreter who assisted with the consent process.']
  interpreter_required_flag boolean [note: 'Indicates whether a language interpreter was required to facilitate the consent process. True if interpreter was used; False otherwise.']
  irb_approval_number varchar [note: 'The approval number assigned by the Institutional Review Board for research studies involving photography or media use. Applicable only for research-related consents.']
  language_code varchar [note: 'ISO 639-1 two-letter language code (optionally with ISO 3166-1 alpha-2 country code) indicating the language in which the consent form was presented to the patient.']
  last_updated_timestamp timestamp [note: 'The date and time when this photography and media consent record was last modified or updated in the system.']
  legal_representative_flag boolean [note: 'Indicates whether consent was provided by a legal representative or authorized surrogate on behalf of the patient. True if representative signed; False if patient signed directly.']
  legal_representative_name varchar [note: 'Full name of the legal representative or authorized surrogate who provided consent on behalf of the patient.']
  legal_representative_relationship varchar [note: 'The relationship of the legal representative to the patient, such as parent, guardian, power of attorney, healthcare proxy, spouse, legal custodian, or other authorized relationship. [ENUM-REF-CANDIDATE: parent|guardian|power_of_attorney|healthcare_proxy|spouse|legal_custodian|other — 7 candidates stripped; promote to reference product]']
  media_type varchar [note: 'Type of media for which consent is granted, such as photography, video recording, audio recording, digital imaging, or mixed media formats.']
  mrn varchar [note: 'The medical record number assigned to the patient by the healthcare organization. Used for patient identification and record linkage.']
  notes varchar [note: 'Free-text notes or comments related to the photography and media consent, including special instructions, restrictions, or contextual information.']
  right_to_withdraw_statement varchar [note: 'Text of the statement provided to the patient explaining their right to withdraw or revoke consent at any time and the process for doing so.']
  scope_description varchar [note: 'Detailed description of the scope of consent, including what body parts, procedures, or contexts are covered by the photography or media authorization.']
  signature_date date [note: 'The date on which the patient signed the photography and media consent form.']
  signature_method varchar [note: 'The method by which the patient signature was captured, such as electronic signature, wet signature on paper, verbal consent, biometric signature, or digital certificate.']
  signature_obtained_flag boolean [note: 'Indicates whether a patient signature was obtained on the photography and media consent form. True if signature was captured; False otherwise.']
  source_system_code varchar [note: 'Unique identifier of this photography and media consent record in the source system, used for data lineage and reconciliation.']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'Full name of the witness who observed the patient signing the photography and media consent form.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required for this photography and media consent based on institutional policy or regulatory requirements. True if witness required; False otherwise.']
  witness_signature_date date [note: 'The date on which the witness signed the photography and media consent form.']

  Note: 'Master record for patient consent to photography, video recording, audio recording, and use of patient images or likeness for clinical, educational, marketing, or research purposes. Captures media type, intended use (clinical documentation, medical education, publication, marketing, social media), scope of consent (identifiable vs. de-identified), distribution channels authorized, expiration, and right to withdraw. Required by HIPAA for any use of patient images beyond direct treatment and by institutional policies governing patient privacy.'
}

Table consent.amendment_request {
  amendment_request_id varchar [pk, note: 'Unique identifier for the consent amendment request. Primary key for this entity.']
  care_site_id varchar [note: 'Unique identifier for the healthcare facility where the amendment request was received or processed. Links to the facility master record.']
  mpi_record_id varchar [note: 'Unique identifier for the patient who submitted the amendment request. Links to the patient master record.']
  org_unit_id varchar [note: 'Unique identifier for the department responsible for processing the amendment request (e.g., Health Information Management, Privacy Office). Links to the department record.']
  original_amendment_request_id varchar [note: 'Self-referencing FK on amendment_request (original_amendment_request_id)']
  primary_amendment_employee_id varchar [note: 'Unique identifier for the staff member or privacy officer who made the final decision on the amendment request. Links to the user or provider record.']
  record_id varchar [note: 'Unique identifier for the consent record that is the subject of this amendment request. Links to the consent record being amended.']
  visit_id varchar [note: 'Unique identifier for the clinical encounter during which the amendment request was submitted, if applicable. Links to the encounter record.']
  amendment_applied_timestamp timestamp [note: 'The precise date and time when the amendment was actually applied to the consent record or PHI documentation in the system.']
  amendment_scope varchar [note: 'The scope of the amendment request: whether it applies to the consent record itself, associated PHI documentation, authorization details, consent restrictions, disclosure log, or all related records.']
  amendment_type varchar [note: 'The type of amendment being requested: correction of inaccurate information, addition of missing information, clarification, deletion, or general update.']
  audit_trail_reference varchar [note: 'Reference to the detailed audit trail for this amendment request, capturing all review activities, decision points, and system changes. Supports compliance and integrity verification.']
  compliance_review_date date [note: 'The date on which the amendment request and decision were reviewed for HIPAA compliance by the privacy officer or compliance team.']
  created_timestamp timestamp [note: 'The date and time when this amendment request record was first created in the data system. Used for audit and data lineage purposes.']
  decision_date date [note: 'The date on which the organization made its decision regarding the amendment request. Must be within 60 days of receipt per HIPAA, or 90 days if extension granted.']
  decision_rationale varchar [note: 'Detailed explanation of the organization\'s decision, including the basis for acceptance or denial. For denials, must cite the specific reason per 45 CFR 164.526(a)(2).']
  decision_timestamp timestamp [note: 'The precise date and time when the organization\'s decision was finalized and recorded in the system.']
  denial_reason_code varchar [note: 'Standardized code representing the reason for denial if the amendment request was denied. Maps to permissible denial reasons under HIPAA (e.g., record not created by organization, record not part of designated record set, record accurate and complete).']
  denial_reason_description varchar [note: 'Detailed description of the reason for denial, providing context and explanation to the patient. Required for denied amendment requests.']
  effective_date date [note: 'The date on which the accepted amendment becomes effective and is applied to the consent record or associated PHI documentation.']
  extension_granted_flag boolean [note: 'Indicates whether the organization granted itself a 30-day extension to respond to the amendment request, as permitted under HIPAA when unable to respond within the initial 60-day period.']
  extension_notification_date date [note: 'The date on which the patient was notified of the extension. Must occur within the initial 60-day period.']
  extension_reason varchar [note: 'The reason provided to the patient for granting an extension to the response timeframe. Required when an extension is granted.']
  last_updated_timestamp timestamp [note: 'The date and time when this amendment request record was last modified in the data system. Tracks the most recent change to any field in the record.']
  mrn varchar [note: 'The patient\'s medical record number as recorded in the healthcare system. Used for patient identification and cross-referencing.']
  notes varchar [note: 'Additional notes, comments, or context related to the amendment request, decision process, or implementation. Used for internal documentation and case management.']
  organization_decision varchar [note: 'The organization\'s final decision on the amendment request: accepted (amendment will be made), denied (amendment will not be made), or partially accepted (some but not all requested changes will be made).']
  organization_rebuttal varchar [note: 'The organization\'s rebuttal to the patient\'s statement of disagreement, if applicable. Must be prepared and maintained with the patient\'s statement.']
  patient_notification_date date [note: 'The date on which the patient was notified of the organization\'s decision regarding their amendment request. Required within 60 days of receipt per HIPAA.']
  patient_notification_method varchar [note: 'The method by which the patient was notified of the decision (e.g., mail, email, patient portal, phone call, in-person).']
  patient_statement_of_disagreement varchar [note: 'If the amendment request was denied, the patient\'s statement of disagreement with the denial. Patient has the right to submit a statement of disagreement per HIPAA.']
  reason_for_amendment varchar [note: 'The patient\'s stated reason or justification for requesting the amendment. Required to support the amendment request under HIPAA.']
  request_channel varchar [note: 'The specific channel or interface through which the amendment request was submitted (e.g., patient portal, mobile app, mail). [ENUM-REF-CANDIDATE: patient_portal|hie|mobile_app|web|phone|mail|fax|in_person|email — 9 candidates stripped; promote to reference product]']
  request_date date [note: 'The date on which the patient submitted the amendment request. Used to track timeliness of organizational response per HIPAA requirements.']
  request_method varchar [note: 'The method by which the patient submitted the amendment request (e.g., written form, patient portal, email, in-person). [ENUM-REF-CANDIDATE: written|electronic|portal|email|fax|in_person|mail — 7 candidates stripped; promote to reference product]']
  request_number varchar [note: 'Business-friendly unique identifier for the amendment request, used for tracking and reference in communications with the patient.']
  request_status varchar [note: 'Current status of the amendment request in the review and decision workflow. Tracks the lifecycle from submission through final disposition. [ENUM-REF-CANDIDATE: submitted|under_review|accepted|denied|partially_accepted|withdrawn|pending_information — 7 candidates stripped; promote to reference product]']
  request_timestamp timestamp [note: 'The precise date and time when the amendment request was received by the organization, including time zone information.']
  requested_change_description varchar [note: 'Detailed description of the specific change the patient is requesting to their consent record or associated PHI documentation. Captures the nature and rationale for the amendment.']
  source_system_code varchar [note: 'The unique identifier for this amendment request in the source system. Used for cross-system reconciliation and traceability.']
  supporting_documentation_reference varchar [note: 'Reference to any supporting documentation provided by the patient with the amendment request (e.g., medical records from another provider, test results, correspondence). Points to document storage location.']
  third_party_notification_date date [note: 'The date on which third parties who received the original consent-based disclosure were notified of the amendment to the consent record.']
  third_party_notification_required_flag boolean [note: 'Indicates whether notification to third parties who received the original consent-based disclosure is required as part of the amendment process.']
  third_party_recipients_notified varchar [note: 'List or description of third-party recipients who were notified of the amendment. Supports compliance with requirement to inform persons identified by the patient and those who may have relied on the original information.']
  vibe_mutation_marker varchar
  withdrawal_date date [note: 'The date on which the patient withdrew their amendment request, if applicable. Captures voluntary withdrawal before a decision was made.']
  withdrawal_reason varchar [note: 'The reason provided by the patient for withdrawing their amendment request, if applicable.']

  Note: 'Transactional record of patient requests to amend their consent records or associated PHI documentation. Captures amendment request date, specific consent record targeted, nature of requested amendment, organization\'s decision (accepted, denied with reason), amendment effective date, and notification to third parties who received the original consent-based disclosure. Supports HIPAA right to amend under 45 CFR 164.526 and maintains the integrity of the consent audit trail.'
}

Table consent.consent_session {
  consent_session_id varchar [pk, note: 'Primary key for consent_session']
  care_site_id varchar [note: 'Reference to the healthcare facility where the consent session took place. Null for remote or electronic sessions not tied to a physical location.']
  employee_id varchar [note: 'Reference to the healthcare staff member who facilitated or witnessed the consent session. Null for fully self-service electronic sessions.']
  mpi_record_id varchar [note: 'Reference to the patient who is the subject of this consent session.']
  resumed_consent_session_id varchar [note: 'Self-referencing FK on consent_session (resumed_consent_session_id)']
  visit_id varchar [note: 'Reference to the clinical encounter associated with this consent session. Null if consent was collected outside of an encounter context.']
  all_consents_obtained_flag boolean [note: 'Indicates whether all required consents were successfully obtained during this session. True if all required consents collected, False if any required consent was declined or not completed.']
  audit_trail_reference varchar [note: 'Reference identifier to detailed audit trail records for this consent session, including all user actions, timestamps, and system events.']
  consent_collection_channel varchar [note: 'Interface or location through which the consent session was conducted: patient portal, mobile application, self-service kiosk, clinic, hospital, call center, or mail.']
  consent_collection_method varchar [note: 'Method by which consent was collected during this session: in-person (face-to-face), electronic (patient portal or kiosk), telephonic (phone call), written (paper form), or verbal (oral consent documented by staff).']
  consent_count varchar [note: 'Total number of individual consent items collected during this session. A single session may capture multiple consent decisions.']
  consent_document_url varchar [note: 'Secure URL or document management system reference to the signed consent document(s) associated with this session.']
  consent_form_version varchar [note: 'Version identifier of the consent form template used during this session. Critical for audit trails and ensuring patients received current consent language.']
  consent_language varchar [note: 'Three-letter ISO 639-2 language code indicating the language in which consent materials were presented and consent was obtained (e.g., ENG for English, SPA for Spanish).']
  consenting_party_name varchar [note: 'Full name of the individual who provided consent during this session. May differ from patient name if consent was provided by a legal representative.']
  consenting_party_relationship varchar [note: 'Relationship of the consenting party to the patient: self (patient consenting for themselves), spouse, parent, child, sibling, legal guardian, attorney, or other authorized relationship.']
  consenting_party_type varchar [note: 'Classification of the individual providing consent: patient (self-consent), legal guardian, power of attorney, parent (for minor), or authorized representative.']
  created_timestamp timestamp [note: 'Date and time when this consent session record was first created in the system. System audit field.']
  device_type varchar [note: 'Type of device used to complete the electronic consent session: desktop computer, tablet, mobile phone, kiosk, or other. Null for non-electronic sessions.']
  electronic_signature_method varchar [note: 'Method used to capture electronic signature during the session: typed name, drawn signature (stylus or touch), biometric (fingerprint/facial), digital certificate, PIN, or none (paper signature).']
  interpreter_language varchar [note: 'Language for which interpretation services were provided during the consent session. Null if no interpreter was used.']
  interpreter_name varchar [note: 'Full name of the interpreter who provided language services during the consent session. Null if no interpreter was used.']
  interpreter_required_flag boolean [note: 'Indicates whether language interpretation services were required during the consent session. True if interpreter was used, False otherwise.']
  ip_address varchar [note: 'IP address from which the electronic consent session was initiated. Used for audit and security purposes. Null for non-electronic sessions.']
  modified_timestamp timestamp [note: 'Date and time when this consent session record was last modified. System audit field.']
  regulatory_compliance_flag boolean [note: 'Indicates whether this consent session met all applicable regulatory requirements at the time of collection. True if compliant, False if deficiencies identified.']
  session_duration_minutes varchar [note: 'Total duration of the consent session in minutes, calculated from start to end timestamp. Used for compliance tracking and session timeout management.']
  session_end_timestamp timestamp [note: 'Date and time when the consent session was completed, cancelled, or expired. Null for active sessions.']
  session_notes varchar [note: 'Free-text notes documenting special circumstances, patient questions, clarifications provided, or other relevant details about the consent session.']
  session_number varchar [note: 'Human-readable business identifier for the consent session, formatted as CS- followed by 10 digits.']
  session_start_timestamp timestamp [note: 'Date and time when the consent session was initiated. Represents the business event time when the patient or authorized representative began the consent process.']
  session_status varchar [note: 'Current lifecycle status of the consent session: initiated (session started), in_progress (consent being collected), completed (all consents finalized), cancelled (session terminated before completion), expired (session timed out), or withdrawn (patient withdrew from session).']
  session_timeout_minutes varchar [note: 'Configured timeout period in minutes for this consent session. Session automatically expires if not completed within this timeframe.']
  session_type varchar [note: 'Classification of the consent session indicating the primary purpose: treatment consent, research consent, data sharing authorization, HIPAA authorization, Health Information Exchange (HIE) participation, or telehealth consent.']
  source_system_code varchar [note: 'Unique identifier for this consent session in the source system. Used for data lineage and reconciliation.']
  staff_role varchar [note: 'Role of the staff member who facilitated the consent session: physician, nurse, research coordinator, consent specialist, administrative staff, or other.']
  user_agent varchar [note: 'Browser or application user agent string captured during electronic consent session. Used for technical audit and troubleshooting. Null for non-electronic sessions.']
  vibe_mutation_marker varchar
  witness_name varchar [note: 'Full name of the witness who observed the consent process. Required for certain research consents and high-risk procedures. Null if no witness was required or present.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required for this consent session based on consent type and regulatory requirements. True if witness required, False otherwise.']
  witness_signature_timestamp timestamp [note: 'Date and time when the witness signed or acknowledged the consent. Null if no witness was required.']

  Note: 'Master reference table for consent_session. Referenced by session_id.'
}

Table consent.consent_record {
  consent_record_id varchar [pk, note: 'Primary key for consent_record']
  care_site_id varchar [note: 'Reference to the facility or care site where the consent was obtained, supporting multi-facility health system governance.']
  consent_policy_id varchar [note: 'Reference to the governing consent policy that defines the rules, scope, and legal basis under which this consent record was captured.']
  form_template_id varchar [note: 'Reference to the consent form template version presented to the patient, ensuring traceability to the exact wording and disclosures the patient agreed to.']
  superseded_by_consent_record_id varchar [note: 'Self-reference to the consent record that replaces this one when a patient re-consents or updates their authorization, preserving consent version lineage.']
  supersedes_consent_record_id varchar [note: 'Self-referencing FK on consent_record (supersedes_consent_record_id)']
  visit_id varchar [note: 'Reference to the clinical encounter during which the consent was obtained, when applicable, supporting episode-of-care context for treatment consent.']
  applies_to_minor boolean [note: 'Indicates whether the consent pertains to a minor patient, triggering guardian-consent and age-of-majority transition handling.']
  can_revoke boolean [note: 'Indicates whether the patient retains the right to revoke this consent, noting that some research and prior-disclosure consents are not fully revocable.']
  consent_category varchar [note: 'Higher-level business grouping of the consent that drives downstream access control and policy application, including specially-protected categories such as behavioral health and substance use.']
  consent_direction varchar [note: 'Indicates whether the consent grants (permit) or restricts (deny) the described activity, supporting opt-in versus opt-out semantics for HIE and data sharing.']
  consent_number varchar [note: 'Externally-known human-readable business reference number for the consent record, used on documents and in patient communications.']
  consent_record_status varchar [note: 'Current lifecycle state of the consent record, driving whether the consent is enforceable for data access, treatment, or disclosure decisions.']
  consent_type varchar [note: 'Classifies the fundamental kind of consent captured, distinguishing treatment consent, research consent, data sharing authorization, HIPAA authorization, HIE opt-in/opt-out, and telehealth consent.']
  created_timestamp timestamp [note: 'Timestamp when this consent record was first captured in the system of record.']
  document_uri varchar [note: 'Storage location reference for the scanned or electronic signed consent document, enabling retrieval of the original legal artifact.']
  effective_date date [note: 'Date on which the consent becomes legally binding and enforceable for the described activities.']
  expiration_date date [note: 'Date on which the consent automatically lapses; nullable for consents that remain in effect until explicitly revoked.']
  expiration_event varchar [note: 'Description of an event-based expiration condition (e.g., end of research study) used when a consent terminates on an event rather than a fixed date, per HIPAA authorization requirements.']
  includes_sensitive_data boolean [note: 'Indicates whether the consent covers specially-protected sensitive information such as substance use, behavioral health, or HIV status requiring heightened controls.']
  interpreter_used boolean [note: 'Indicates whether an interpreter assisted the patient during the consent process, supporting language-access compliance documentation.']
  is_legally_authorized_representative boolean [note: 'Indicates whether the consent was provided by a legally authorized representative on behalf of the patient, requiring documentation of authority.']
  language_code varchar [note: 'ISO 639-1 language code in which the consent form was presented and signed, documenting that the patient consented in a language they understand.']
  last_updated_timestamp timestamp [note: 'Timestamp when this consent record was most recently modified, supporting change auditing and data lineage.']
  purpose_of_use varchar [note: 'Authorized purpose for which the protected health information may be used or disclosed under this consent, aligned with HIPAA permitted-purpose categories.']
  scope_description varchar [note: 'Narrative description of the specific information categories, purposes, and recipients covered by this consent, defining the permitted use boundary.']
  signature_method varchar [note: 'Method by which the patient signature or assent was captured, supporting validity assessment and e-signature compliance auditing.']
  signed_date date [note: 'Date the patient or authorized representative signed and executed the consent, establishing the principal real-world consent event.']
  signer_name varchar [note: 'Full legal name of the individual who signed the consent, which may be the patient or a legally authorized representative.']
  signer_relationship varchar [note: 'Relationship of the signer to the patient, identifying whether consent was self-given or provided by an authorized representative.']
  verification_status varchar [note: 'Status of the verification process confirming the validity and completeness of the consent before it is treated as enforceable.']
  withdrawal_date date [note: 'Date on which the patient revoked or withdrew the consent; nullable while consent remains active.']
  withdrawal_method varchar [note: 'Channel through which the patient communicated their revocation, supporting validity verification of the withdrawal.']
  withdrawal_reason varchar [note: 'Documented reason the patient provided for revoking the consent, supporting audit and patient-rights reporting.']
  witness_name varchar [note: 'Full name of the witness who attested to the patient signature, required for certain treatment and research consents.']
  witness_signed_date date [note: 'Date the witness signed and attested to the consent execution.']

  Note: 'Master reference table for consent_record. Referenced by disclosure_consent_record_id.'
}

Table consent.workflow {
  workflow_id varchar [pk, note: 'Primary key for workflow']
  allows_electronic_signature boolean [note: 'Indicates whether the workflow permits electronic signature capture for consent, governed by ESIGN Act and 21 CFR Part 11 requirements.']
  allows_proxy_consent boolean [note: 'Indicates whether the workflow permits consent by a legally authorized representative, guardian, or healthcare proxy on behalf of the patient.']
  allows_revocation boolean [note: 'Indicates whether patients may revoke consent captured through this workflow, a mandatory right under HIPAA authorization rules.']
  applicable_facility_scope varchar [note: 'Organizational scope at which the workflow applies, indicating whether it is enterprise-wide or restricted to a specific facility, department, or service line.']
  approval_date date [note: 'Date the workflow definition version was formally approved for use.']
  approved_by_role varchar [note: 'Role or committee that approved this workflow definition version for production use, supporting governance audit trails.']
  auto_routing_enabled boolean [note: 'Indicates whether the workflow automatically routes consent tasks to the appropriate role or queue without manual assignment.']
  consent_context_type varchar [note: 'Categorical classification of the consent context the workflow governs (patient treatment consent, research consent, data sharing authorization, HIPAA authorization, HIE opt-in/opt-out, telehealth consent). CLASSIFICATION_OR_TYPE category.']
  consent_policy_id varchar [note: 'Reference to the consent policy that this workflow operationalizes and enforces, linking the process definition to its governing rule set.']
  created_timestamp timestamp [note: 'Timestamp when this workflow definition record was first captured in the consent system of record.']
  data_retention_years varchar [note: 'Number of years consent records produced by this workflow must be retained to satisfy HIPAA and applicable state retention requirements.']
  default_language_code varchar [note: 'Default ISO 639-1 language code in which consent materials are presented within this workflow when no patient preference is specified.']
  effective_from_date date [note: 'Date on which this workflow definition version becomes effective and available for consent capture.']
  effective_until_date date [note: 'Date on which this workflow definition version ceases to be effective; null for open-ended active workflows.']
  escalation_threshold_hours varchar [note: 'Number of hours a pending consent task may remain incomplete before the workflow triggers escalation to a supervisor or compliance officer.']
  expiration_period_days varchar [note: 'Default number of days after capture for which consent obtained via this workflow remains valid before requiring renewal.']
  form_template_id varchar [note: 'Reference to the default consent form template presented to the patient or subject within this workflow.']
  is_current_version boolean [note: 'Indicates whether this row represents the currently active version of the workflow definition among all versions sharing the same workflow_code.']
  last_modified_timestamp timestamp [note: 'Timestamp when this workflow definition record was last modified, supporting change tracking and governance.']
  minimum_age_requirement varchar [note: 'Minimum age in years at which a patient may self-consent within this workflow, controlling routing to proxy or guardian consent paths for minors.']
  notification_channel varchar [note: 'Primary channel used to notify patients or subjects of consent tasks and renewal reminders within this workflow.']
  owner_role varchar [note: 'The accountable role or governance body responsible for maintaining this workflow definition (e.g., Compliance Office, Research IRB, Privacy Officer).']
  regulatory_basis varchar [note: 'Primary regulatory framework that mandates or governs the consent captured by this workflow, driving compliance controls and retention rules.']
  renewal_required boolean [note: 'Indicates whether consent captured through this workflow must be periodically renewed rather than remaining open-ended.']
  requires_interpreter boolean [note: 'Indicates whether the workflow requires interpreter involvement and documentation when the patient has limited English proficiency, supporting language-access compliance.']
  requires_legal_review boolean [note: 'Indicates whether the workflow mandates a legal or compliance review step before consent is finalized.']
  requires_witness boolean [note: 'Indicates whether the workflow mandates a witness signature for valid consent capture, a key compliance control for high-risk procedures and research.']
  step_count varchar [note: 'Total number of discrete steps defined in the workflow, used for process configuration validation and completion tracking.']
  superseded_by_consent_workflow_id varchar [note: 'Self-reference to the consent workflow definition that supersedes this version when it is deprecated or replaced, supporting version lineage. Renamed per next_vibes P5-P20 disambiguation pass to remove table-name stutter.']
  version_number varchar [note: 'Semantic version identifier of the consent workflow definition, enabling controlled change management and reproducibility of which workflow version governed a given consent capture.']
  workflow_category varchar [note: 'Higher-level functional category segmenting the workflow population for governance and analytics. Secondary CLASSIFICATION_OR_TYPE category distinct from consent_context_type.']
  workflow_code varchar [note: 'Externally-known business code uniquely identifying the consent workflow definition (e.g., TREAT-CONSENT-V2, RESEARCH-IC-001). Used by source systems and integration interfaces to reference the workflow. BUSINESS_IDENTIFIER category.']
  workflow_description varchar [note: 'Detailed narrative explaining the purpose and scope of the consent workflow, the steps it orchestrates, and the consent context it governs. Supports governance documentation and self-service understanding.']
  workflow_name varchar [note: 'Human-readable name of the consent workflow (e.g., \'Inpatient Treatment Consent Process\'). IDENTITY_LABEL category supporting business user navigation and reporting.']
  workflow_status varchar [note: 'Current lifecycle state of the workflow definition indicating whether it is available for use, under development, or retired. LIFECYCLE_STATUS category.']

  Note: 'Master reference table for workflow. '
}

Table interoperability.exchange_standard {
  exchange_standard_id varchar [pk, note: 'Unique identifier for each healthcare data exchange standard version.']
  superseded_exchange_standard_id varchar [note: 'FK to the prior version of this standard that this version replaces.']
  backward_compatibility boolean [note: 'True if this version is backward compatible with prior versions.']
  certification_date date [note: 'Date the organization achieved certification for this standard.']
  certification_status varchar [note: 'ONC or other certification status for this standard.']
  character_set varchar [note: 'Character encoding (e.g., UTF-8, ASCII).']
  conformance_profile varchar [note: 'Implementation guide or profile name (e.g., US Core, C-CDA 2.1).']
  contact_email varchar [note: 'Email address of the internal contact.']
  contact_person varchar [note: 'Internal contact for questions about this standard.']
  created_timestamp timestamp [note: 'Timestamp when this record was created.']
  documentation_url varchar [note: 'URL to implementation documentation and guides.']
  effective_date date [note: 'Date the standard becomes effective for use.']
  encoding_format varchar [note: 'Data encoding format (e.g., ER7, XML, JSON).']
  end_date date [note: 'Date the standard is deprecated or retired.']
  exchange_standard_status varchar [note: 'Current status: draft, active, deprecated, retired.']
  governing_body varchar [note: 'Organization that maintains the standard (e.g., HL7 International, X12, NCPDP).']
  hie_participation varchar [note: 'HIE networks that require or support this standard.']
  interface_engine_support varchar [note: 'Interface engines that support this standard (e.g., Rhapsody, Mirth, Corepoint).']
  is_mandatory boolean [note: 'True if the standard is required by regulation (e.g., ONC certification).']
  message_types_supported varchar [note: 'Comma-separated list of message types supported (e.g., ADT, ORM, ORU for HL7 v2).']
  migration_path decimal(9,4) [note: 'Guidance for migrating from prior versions.']
  notes varchar [note: 'Additional notes or implementation guidance.']
  publication_date date [note: 'Date the standard version was officially published.']
  regulatory_requirement varchar [note: 'Regulatory mandate requiring this standard (e.g., 21st Century Cures Act, HIPAA 5010).']
  resource_types_supported varchar [note: 'Comma-separated list of FHIR resource types or CDA sections supported.']
  security_profile varchar [note: 'Security requirements (e.g., SMART on FHIR, OAuth 2.0, TLS 1.2).']
  specification_url varchar [note: 'URL to the official standard specification document.']
  standard_code varchar [note: 'Short code for the standard (e.g., HL7V2, FHIR, CDA).']
  standard_name varchar [note: 'Name of the exchange standard (e.g., HL7 v2.5.1, FHIR R4, CDA R2).']
  standard_type varchar [note: 'Category of standard: messaging, document, API, transaction.']
  terminology_binding varchar [note: 'Required terminology standards (e.g., SNOMED CT, LOINC, RxNorm).']
  testing_tool varchar [note: 'Recommended testing or validation tool (e.g., NIST validator, Inferno).']
  transport_protocol varchar [note: 'Supported transport protocols (e.g., MLLP, HTTPS, SMTP).']
  updated_timestamp timestamp [note: 'Timestamp when this record was last updated.']
  use_case_description varchar [note: 'Primary use cases for this standard (e.g., patient summary exchange, lab results).']
  validation_rules varchar [note: 'Validation rules or schematron references for conformance checking.']
  version varchar [note: 'Version number of the standard (e.g., 2.5.1, R4, 5010).']

  Note: 'Registry of healthcare data exchange standards (HL7 v2, FHIR, CDA, X12) with version tracking, conformance profiles, and certification status. Supports ONC certification requirements and regulatory compliance tracking.'
}

Table interoperability.trading_partner {
  trading_partner_id varchar [pk, note: 'Unique identifier for each trading partner organization.']
  interface_engine_id varchar [note: 'FK to the interface engine that manages connections to this trading partner.']
  org_provider_id varchar [note: 'FK to provider.org_provider if this trading partner is also a provider in the system.']
  parent_trading_partner_id varchar [note: 'FK to parent trading partner for hierarchical organizations.']
  active_flag boolean [note: 'True if the trading partner relationship is currently active.']
  address_line_1 varchar [note: 'Street address line 1 of the trading partner.']
  address_line_2 varchar [note: 'Street address line 2 of the trading partner.']
  cda_endpoint_url varchar [note: 'CDA document exchange endpoint URL.']
  certification_expiration_date decimal(9,4) [note: 'Date the trading partner\'s certification expires.']
  certification_status varchar [note: 'Certification status of the trading partner (e.g., ONC certified, HIE certified).']
  city varchar [note: 'City of the trading partner.']
  country_code varchar [note: 'ISO country code of the trading partner.']
  created_timestamp timestamp [note: 'Timestamp when this record was created.']
  data_sharing_agreement_reference varchar [note: 'Reference to the executed data sharing agreement document.']
  data_transformation_mapping_reference varchar [note: 'Reference to data transformation mapping documentation for this partner.']
  direct_address varchar [note: 'Direct secure messaging address for this trading partner.']
  effective_end_date date [note: 'Date the trading partner relationship ended or will end.']
  effective_start_date date [note: 'Date the trading partner relationship became active.']
  exchange_volume_last_30_days varchar [note: 'Number of messages or transactions exchanged with this partner in the last 30 days.']
  fhir_endpoint_url varchar [note: 'FHIR API base URL for this trading partner.']
  hie_network_name varchar [note: 'Name of the HIE network this partner participates in.']
  hie_participation_flag boolean [note: 'True if this trading partner participates in a Health Information Exchange.']
  hl7v2_endpoint_url varchar [note: 'HL7 v2 MLLP endpoint URL or IP:port.']
  last_successful_exchange_timestamp timestamp [note: 'Timestamp of the last successful data exchange with this trading partner.']
  last_updated_timestamp timestamp [note: 'Timestamp when this record was last updated.']
  message_tracking_enabled_flag boolean [note: 'True if message-level tracking is enabled for this trading partner.']
  notes varchar [note: 'Additional notes about this trading partner.']
  npi varchar [note: 'National Provider Identifier of the trading partner organization.']
  oid varchar [note: 'Object Identifier (OID) for the trading partner in HIE transactions.']
  onboarding_status varchar [note: 'Current onboarding status: planning, testing, live, suspended, terminated.']
  operational_contact_email decimal(9,4) [note: 'Email address of the operational contact.']
  operational_contact_name varchar [note: 'Name of the operational contact at the trading partner.']
  operational_contact_phone decimal(9,4) [note: 'Phone number of the operational contact.']
  partner_name varchar [note: 'Legal name of the trading partner organization.']
  partner_type varchar [note: 'Type of partner: HIE, payer, lab, referring_provider, pharmacy, public_health, other.']
  postal_code varchar [note: 'Postal code of the trading partner.']
  sla_response_time_hours decimal(5,2) [note: 'Service level agreement response time in hours for this trading partner.']
  state_province varchar [note: 'State or province of the trading partner.']
  supported_standards varchar [note: 'Comma-separated list of exchange standards supported by this partner.']
  technical_contact_email varchar [note: 'Email address of the technical contact.']
  technical_contact_name varchar [note: 'Name of the technical contact at the trading partner.']
  technical_contact_phone varchar [note: 'Phone number of the technical contact.']

  Note: 'Registry of external organizations that exchange healthcare data with the health system. Includes HIE participants, referring providers, payers, labs, and other trading partners with connection details and SLA tracking.'
}

Table interoperability.interface_engine {
  interface_engine_id varchar [pk, note: 'Unique identifier for each interface engine instance.']
  care_site_id varchar [note: 'FK to the care site this interface engine primarily serves.']
  replaced_interface_engine_id varchar [note: 'FK to the prior interface engine that this engine replaced.']
  admin_url varchar [note: 'URL to the administrative console for the interface engine.']
  audit_logging_enabled boolean [note: 'True if comprehensive audit logging is enabled.']
  cloud_provider varchar [note: 'Cloud provider if hosted in cloud (e.g., AWS, Azure, GCP).']
  created_timestamp timestamp [note: 'Timestamp when this record was created.']
  decommission_date date [note: 'Date the interface engine was or will be decommissioned.']
  deployment_environment varchar [note: 'Environment: production, test, development, disaster_recovery.']
  disaster_recovery_enabled boolean [note: 'True if disaster recovery failover is configured.']
  encryption_enabled boolean [note: 'True if data-at-rest and data-in-transit encryption is enabled.']
  engine_code varchar [note: 'Short code for the interface engine (e.g., PROD_RHAP_01).']
  engine_name varchar [note: 'Descriptive name of the interface engine instance.']
  fhir_version_support varchar [note: 'Comma-separated list of FHIR versions supported.']
  go_live_date date [note: 'Date the interface engine went live in production.']
  high_availability_enabled boolean [note: 'True if high availability clustering is enabled.']
  hipaa_compliant boolean [note: 'True if the interface engine is configured to meet HIPAA requirements.']
  hitrust_certified boolean [note: 'True if the interface engine is HITRUST certified.']
  hl7_version_support varchar [note: 'Comma-separated list of HL7 v2 versions supported.']
  hosting_model varchar [note: 'Hosting model: on_premise, cloud, hybrid.']
  installation_date date [note: 'Date the interface engine was installed.']
  last_maintenance_date date [note: 'Date of the last scheduled maintenance.']
  last_updated_timestamp timestamp [note: 'Timestamp when this record was last updated.']
  license_expiration_date decimal(9,4) [note: 'Date the software license expires.']
  license_type varchar [note: 'License type: perpetual, subscription, open_source.']
  max_concurrent_connections varchar [note: 'Maximum number of concurrent connections supported.']
  message_throughput_capacity varchar [note: 'Maximum messages per hour the engine can process.']
  next_scheduled_maintenance_date date [note: 'Date of the next scheduled maintenance.']
  notes varchar [note: 'Additional notes about this interface engine.']
  operational_status varchar [note: 'Current operational status: active, maintenance, offline, decommissioned.']
  primary_contact_email varchar [note: 'Email address of the primary technical contact.']
  primary_contact_name varchar [note: 'Name of the primary technical contact for this interface engine.']
  primary_contact_phone varchar [note: 'Phone number of the primary technical contact.']
  primary_hostname varchar [note: 'Primary hostname or FQDN of the interface engine.']
  primary_ip_address varchar [note: 'Primary IP address of the interface engine.']
  product_name varchar [note: 'Vendor product name (e.g., Rhapsody, Mirth Connect, Corepoint, Ensemble).']
  responsible_team varchar [note: 'IT team responsible for this interface engine (e.g., Integration Team, IT Operations).']
  support_contract_expiration_date decimal(9,4) [note: 'Date the vendor support contract expires.']
  support_contract_status varchar [note: 'Status of the vendor support contract: active, expired, not_applicable.']
  supported_protocols varchar [note: 'Comma-separated list of supported transport protocols (e.g., MLLP, HTTPS, SFTP, SMTP).']
  vendor_name varchar [note: 'Name of the interface engine vendor.']
  version varchar [note: 'Software version of the interface engine.']

  Note: 'Registry of interface engines (integration middleware) that route and transform healthcare data messages. Tracks engine configuration, capacity, uptime, and maintenance schedules for operational monitoring.'
}

Table interoperability.interface_channel {
  interface_channel_id varchar [pk, note: 'Unique identifier for each interface channel.']
  exchange_standard_id varchar [note: 'FK to the exchange standard used by this channel.']
  replaced_interface_channel_id varchar [note: 'FK to the prior interface channel that this channel replaced.']
  acknowledgment_required boolean [note: 'True if message acknowledgment (ACK) is required.']
  acknowledgment_timeout_seconds varchar [note: 'Timeout in seconds for waiting for an acknowledgment.']
  audit_logging_enabled boolean [note: 'True if audit logging is enabled for this channel.']
  authentication_method varchar [note: 'Authentication method: none, basic, certificate, OAuth2, SAML.']
  business_owner_name varchar [note: 'Name of the business owner responsible for this channel.']
  channel_code varchar [note: 'Short code for the interface channel (e.g., ADT_EPIC_TO_LAB).']
  channel_name varchar [note: 'Descriptive name of the interface channel.']
  channel_status varchar [note: 'Current status: active, inactive, testing, suspended, decommissioned.']
  channel_type varchar [note: 'Type of channel: inbound, outbound, bidirectional.']
  connection_host varchar [note: 'Hostname or IP address for the connection.']
  connection_port varchar [note: 'Port number for the connection.']
  created_timestamp timestamp [note: 'Timestamp when this record was created.']
  decommission_date date [note: 'Date the channel was or will be decommissioned.']
  destination_facility_identifier varchar [note: 'Facility identifier for the destination system (e.g., MSH-6 receiving facility).']
  destination_system_identifier varchar [note: 'Unique identifier for the destination system (e.g., MSH-5 receiving application).']
  destination_system_name varchar [note: 'Name of the destination system receiving data.']
  encryption_enabled boolean [note: 'True if encryption (TLS/SSL) is enabled for this channel.']
  encryption_protocol varchar [note: 'Encryption protocol used (e.g., TLS 1.2, TLS 1.3).']
  go_live_date date [note: 'Date the channel went live in production.']
  hie_network_name varchar [note: 'Name of the HIE network this channel participates in.']
  hie_participant_flag boolean [note: 'True if this channel is part of a Health Information Exchange.']
  last_tested_date date [note: 'Date the channel was last tested.']
  max_message_size_kb varchar [note: 'Maximum message size in kilobytes allowed on this channel.']
  message_archival_days varchar [note: 'Number of days to retain message logs for this channel.']
  message_encoding varchar [note: 'Message encoding format: ER7, XML, JSON.']
  message_event_type varchar [note: 'HL7 message type or FHIR event (e.g., ADT^A01, ORM^O01, Patient-create).']
  message_retry_count varchar [note: 'Number of retry attempts for failed messages.']
  next_review_date date [note: 'Date of the next scheduled review of this channel.']
  notes varchar [note: 'Additional notes about this interface channel.']
  phi_transmitted_flag boolean [note: 'True if this channel transmits protected health information (PHI).']
  retry_interval_seconds varchar [note: 'Interval in seconds between retry attempts.']
  sla_tier varchar [note: 'Service level agreement tier: critical, high, medium, low.']
  sla_uptime_target_percent decimal(5,2) [note: 'Target uptime percentage for this channel per SLA.']
  source_facility_identifier varchar [note: 'Facility identifier for the source system (e.g., MSH-4 sending facility).']
  source_system_identifier varchar [note: 'Unique identifier for the source system (e.g., MSH-3 sending application).']
  source_system_name varchar [note: 'Name of the source system sending data.']
  support_contact_email varchar [note: 'Email address for support contact for this channel.']
  support_contact_phone varchar [note: 'Phone number for support contact for this channel.']
  technical_owner_name varchar [note: 'Name of the technical owner responsible for this channel.']
  transformation_map_name varchar [note: 'Name of the data transformation map applied to messages on this channel.']
  transport_protocol varchar [note: 'Transport protocol used: MLLP, HTTPS, SFTP, SMTP, REST.']
  updated_timestamp timestamp [note: 'Timestamp when this record was last updated.']

  Note: 'Configuration and operational metadata for individual interface channels (connections) that send or receive healthcare data messages. Each channel represents a specific data flow between systems with routing, transformation, and SLA tracking.'
}

Table interoperability.message_log {
  message_log_id varchar [pk, note: 'Unique identifier for the message log entry.']
  interface_channel_id varchar [note: 'Link to the interface channel that processed this message.']
  mapping_rule_id varchar [note: 'Link to the transformation rule applied.']
  original_message_log_id varchar [note: 'Link to the original message if this is a duplicate or retry.']
  primary_message_care_site_id varchar [note: 'Link to the care site associated with the message.']
  receiving_facility_care_site_id varchar [note: 'Link to the receiving facility care site.']
  scheduling_appointment_id varchar [note: 'Link to the appointment if the message is scheduling-related.']
  visit_id varchar [note: 'Link to the visit if the message is encounter-related.']
  ack_code varchar [note: 'Acknowledgment code (AA, AE, AR).']
  ack_timestamp timestamp [note: 'Timestamp when acknowledgment was received.']
  business_event_type varchar [note: 'Business event type (admission, discharge, order, result).']
  created_timestamp timestamp [note: 'Timestamp when the log entry was created.']
  destination_ip_address varchar [note: 'Destination IP address of the message.']
  duplicate_check_performed boolean [note: 'Flag indicating if duplicate check was performed.']
  encryption_applied boolean [note: 'Flag indicating if encryption was applied.']
  error_code varchar [note: 'Error code if processing failed.']
  error_description varchar [note: 'Error description if processing failed.']
  error_severity varchar [note: 'Error severity (fatal, error, warning).']
  hie_transaction_code varchar [note: 'HIE transaction code if part of an HIE exchange.']
  is_duplicate boolean [note: 'Flag indicating if the message is a duplicate.']
  message_control_number varchar [note: 'HL7 message control ID (MSH-10).']
  message_priority varchar [note: 'Message priority (high, normal, low).']
  message_sequence_number varchar [note: 'Sequence number for ordered message processing.']
  message_standard varchar [note: 'Message standard (HL7 v2, FHIR, CDA, X12).']
  message_timestamp timestamp [note: 'Timestamp from the message header (MSH-7).']
  message_type varchar [note: 'HL7 message type (e.g., ADT^A01, ORM^O01).']
  message_version varchar [note: 'Version of the message standard.']
  patient_mrn varchar [note: 'Patient MRN extracted from the message.']
  payload_size_bytes varchar [note: 'Size of the message payload in bytes.']
  phi_present boolean [note: 'Flag indicating if PHI is present in the message.']
  processing_end_timestamp timestamp [note: 'Timestamp when message processing completed.']
  processing_latency_ms varchar [note: 'Processing latency in milliseconds.']
  processing_start_timestamp timestamp [note: 'Timestamp when message processing started.']
  processing_status varchar [note: 'Processing status (success, error, pending, retry).']
  received_timestamp timestamp [note: 'Timestamp when the message was received by the interface engine.']
  receiving_application varchar [note: 'Receiving application (MSH-5).']
  retry_count varchar [note: 'Number of retry attempts.']
  sending_application varchar [note: 'Sending application (MSH-3).']
  sla_met boolean [note: 'Flag indicating if SLA was met.']
  sla_threshold_ms varchar [note: 'SLA threshold in milliseconds.']
  source_ip_address varchar [note: 'Source IP address of the message.']
  transformation_applied boolean [note: 'Flag indicating if transformation was applied.']
  transport_protocol varchar [note: 'Transport protocol used (MLLP, HTTPS, SFTP).']
  updated_timestamp timestamp [note: 'Timestamp when the log entry was last updated.']
  validation_errors varchar [note: 'Validation errors if validation failed.']
  validation_status varchar [note: 'Validation status (passed, failed, warning).']

  Note: 'Audit log of all messages processed through interface channels. Captures message metadata, processing status, latency, errors, and SLA compliance for operational monitoring and troubleshooting.'
}

Table interoperability.message_error {
  message_error_id varchar [pk, note: 'Unique identifier for the message error record.']
  employee_id varchar [note: 'Link to the employee assigned to resolve the error.']
  interface_channel_id varchar [note: 'Link to the interface channel where the error occurred.']
  message_log_id varchar [note: 'Link to the message log entry that encountered the error.']
  mpi_record_id varchar [note: 'Link to the patient MPI record if the message contains patient data.']
  parent_message_error_id varchar [note: 'Link to a related error record.']
  visit_id varchar [note: 'Link to the visit if the message is encounter-related.']
  acknowledgment_code varchar [note: 'Acknowledgment code from the destination system.']
  actual_resolution_minutes varchar [note: 'Actual resolution time in minutes.']
  business_impact_description varchar [note: 'Description of the business impact of the error.']
  created_timestamp timestamp [note: 'Timestamp when the error record was created.']
  error_category varchar [note: 'Error category (connection, transformation, validation, timeout).']
  error_code varchar [note: 'Error code or identifier.']
  error_description varchar [note: 'Detailed error description.']
  error_severity varchar [note: 'Error severity (fatal, error, warning).']
  error_stack_trace varchar [note: 'Stack trace or detailed error log.']
  error_timestamp timestamp [note: 'Timestamp when the error occurred.']
  escalation_flag boolean [note: 'Flag indicating if the error was escalated.']
  escalation_timestamp timestamp [note: 'Timestamp when the error was escalated.']
  field_position_error varchar [note: 'Field position where the error occurred (e.g., PID-5).']
  interface_engine_version varchar [note: 'Version of the interface engine at the time of the error.']
  message_segment_error varchar [note: 'HL7 segment where the error occurred (e.g., PID, OBX).']
  modified_timestamp timestamp [note: 'Timestamp when the error record was last modified.']
  notification_sent_flag boolean [note: 'Flag indicating if notification was sent.']
  patient_mrn varchar [note: 'Patient MRN extracted from the message.']
  raw_message_payload varchar [note: 'Raw message payload for troubleshooting (may be truncated or hashed for PHI protection).']
  resolution_notes varchar [note: 'Notes describing the resolution.']
  resolution_status varchar [note: 'Resolution status (open, in progress, resolved, closed).']
  resolution_timestamp timestamp [note: 'Timestamp when the error was resolved.']
  retry_count varchar [note: 'Number of retry attempts.']
  retry_eligible_flag boolean [note: 'Flag indicating if the message is eligible for retry.']
  root_cause_category varchar [note: 'Root cause category (configuration, data quality, network, system).']
  sla_breach_flag boolean [note: 'Flag indicating if SLA was breached.']
  sla_target_resolution_minutes varchar [note: 'SLA target resolution time in minutes.']
  validation_rule_violated varchar [note: 'Validation rule that was violated.']

  Note: 'Detailed error tracking for failed interface messages. Captures error details, root cause, resolution status, and SLA breach tracking for operational support and continuous improvement.'
}

Table interoperability.fhir_endpoint {
  fhir_endpoint_id varchar [pk, note: 'Unique identifier for the FHIR API endpoint record. Primary key for the FHIR endpoint registry.']
  data_sharing_agreement_id varchar [note: 'Identifier of the legal data sharing agreement or Business Associate Agreement (BAA) governing data exchange through this endpoint. Links to compliance and legal documentation.']
  org_provider_id varchar [note: 'Identifier of the organization responsible for managing and maintaining this FHIR endpoint. Links to the organization master data.']
  superseded_fhir_endpoint_id varchar [note: 'Self-referencing FK on fhir_endpoint (superseded_fhir_endpoint_id)']
  trading_partner_id varchar [note: 'Foreign key linking to interoperability.trading_partner. Business justification: Many FHIR endpoints are partner-specific (payer APIs, HIE endpoints, provider directories). Link to trading_partner enables tracking which partner owns/operates each endpoint, managing partner-specifi']
  authentication_method varchar [note: 'The authentication and authorization mechanism required to access this FHIR endpoint (e.g., OAuth2, SMART on FHIR, API key, basic authentication, mutual TLS, or none for public endpoints).']
  average_response_time_ms varchar [note: 'Average response time in milliseconds for API requests to this endpoint over a defined measurement period. Used for performance monitoring and optimization.']
  bulk_data_export_support_flag boolean [note: 'Indicates whether this endpoint supports FHIR Bulk Data Access (Flat FHIR) for large-scale data export operations. True if bulk export is supported, False otherwise.']
  capability_statement_url varchar [note: 'URL to the FHIR CapabilityStatement resource that describes the functionality and supported operations of this endpoint. Typically accessed via [base_url]/metadata.']
  cms_compliance_flag boolean [note: 'Indicates whether this endpoint is compliant with CMS Interoperability and Patient Access Final Rule requirements (21st Century Cures Act). True if compliant, False otherwise.']
  connection_type varchar [note: 'The protocol or connection type used by this endpoint (e.g., HL7 FHIR REST, HL7 FHIR Messaging, Direct messaging, IHE XDS, HL7 v2, custom integration).']
  contact_email varchar [note: 'Email address of the technical contact for this endpoint. Used for notifications, alerts, and support communications.']
  contact_name varchar [note: 'Name of the technical contact person responsible for this endpoint. Used for operational support and issue resolution.']
  contact_phone varchar [note: 'Phone number of the technical contact for this endpoint. Used for urgent operational issues and escalations.']
  created_timestamp timestamp [note: 'Timestamp when this endpoint record was first created in the system. Used for audit trail and data lineage.']
  deprecation_date date [note: 'Date when this endpoint was marked as deprecated and scheduled for retirement. Used for migration planning and stakeholder communication.']
  documentation_url varchar [note: 'URL to the technical documentation, developer guide, or API reference for this FHIR endpoint. Used by developers and integration partners.']
  endpoint_name varchar [note: 'Human-readable name or label for the FHIR endpoint, used for identification and management purposes.']
  endpoint_type varchar [note: 'Classification of the FHIR endpoint based on its primary use case and audience (e.g., patient-facing SMART on FHIR apps, payer FHIR APIs for CMS Interoperability Rule, provider directory endpoints, internal FHIR server instances, HIE gateways).']
  endpoint_url varchar [note: 'The full URL of the FHIR API endpoint, including protocol, domain, and base path. This is the technical address where FHIR requests are sent.']
  environment varchar [note: 'The deployment environment of this FHIR endpoint (e.g., production, staging, testing, development, sandbox). Used to distinguish live endpoints from test environments.']
  fhir_version varchar [note: 'The version of the FHIR specification that this endpoint implements (e.g., R4, STU3, DSTU2, R5).']
  hie_network_name varchar [note: 'Name of the Health Information Exchange network that this endpoint participates in, if applicable. Used for tracking HIE partnerships and data sharing agreements.']
  hie_participant_flag boolean [note: 'Indicates whether this endpoint participates in a Health Information Exchange network. True if the endpoint is registered with an HIE, False otherwise.']
  last_availability_check_timestamp timestamp [note: 'Timestamp of the most recent automated availability or health check performed on this endpoint. Used for monitoring and alerting.']
  last_availability_status varchar [note: 'Result of the most recent availability check (e.g., available, unavailable, degraded, timeout, error). Used for operational monitoring and incident response.']
  last_updated_timestamp timestamp [note: 'Timestamp when this endpoint record was last modified. Used for change tracking and audit purposes.']
  notes varchar [note: 'Free-text field for additional notes, comments, or special instructions related to this FHIR endpoint. Used for operational context and knowledge transfer.']
  oauth_authorization_url varchar [note: 'The OAuth 2.0 authorization endpoint URL used for user authorization flows when authentication_method is OAuth2 or SMART on FHIR.']
  oauth_token_url varchar [note: 'The OAuth 2.0 token endpoint URL used for obtaining access tokens when authentication_method is OAuth2 or SMART on FHIR.']
  onc_certification_flag boolean [note: 'Indicates whether this endpoint is part of an ONC-certified Health IT Module under the 21st Century Cures Act certification criteria.']
  operational_status varchar [note: 'Current operational state of the FHIR endpoint. Active indicates the endpoint is live and available for production use. Testing indicates the endpoint is in a test or sandbox environment. Maintenance indicates temporary unavailability. Deprecated indicates the endpoint is scheduled for retirement. Retired indicates the endpoint is no longer available.']
  patient_access_api_flag boolean [note: 'Indicates whether this endpoint is designated as a Patient Access API under CMS Interoperability Rule requirements. True if it provides patient-facing access to health data, False otherwise.']
  payer_to_payer_api_flag boolean [note: 'Indicates whether this endpoint is designated as a Payer-to-Payer API under CMS Interoperability Rule requirements. True if it supports payer-to-payer data exchange, False otherwise.']
  provider_access_api_flag boolean [note: 'Indicates whether this endpoint is designated as a Provider Access API under CMS Interoperability Rule requirements. True if it provides provider-to-provider data exchange, False otherwise.']
  public_endpoint_flag boolean [note: 'Indicates whether this endpoint is publicly accessible without authentication (e.g., for provider directory lookups). True if public, False if authentication is required.']
  rate_limit_requests_per_day varchar [note: 'Maximum number of API requests allowed per day for this endpoint. Used for capacity planning and fair use enforcement.']
  rate_limit_requests_per_minute varchar [note: 'Maximum number of API requests allowed per minute for this endpoint. Used for throttling and capacity management.']
  registration_date date [note: 'Date when this FHIR endpoint was first registered in the organization\'s endpoint inventory. Used for tracking endpoint lifecycle and governance.']
  retirement_date date [note: 'Date when this endpoint was or will be retired and decommissioned. Used for lifecycle management and historical tracking.']
  security_certificate_expiry_date date [note: 'Expiration date of the SSL/TLS security certificate used by this endpoint. Critical for maintaining secure communications and avoiding service disruptions.']
  smart_app_launch_support_flag boolean [note: 'Indicates whether this endpoint supports the SMART App Launch Framework for third-party application integration. True if SMART launch is supported, False otherwise.']
  supported_resource_types varchar [note: 'Comma-separated list of FHIR resource types supported by this endpoint (e.g., Patient, Observation, Condition, MedicationRequest, Encounter, Coverage, ExplanationOfBenefit). Derived from the CapabilityStatement.']
  total_requests_last_30_days varchar [note: 'Total number of API requests received by this endpoint in the last 30 days. Used for usage analytics and capacity planning.']
  uptime_percentage decimal(5,2) [note: 'Calculated uptime percentage for this endpoint over a defined measurement period (typically 30 days). Used for Service Level Agreement (SLA) tracking and performance reporting.']
  vibe_mutation_marker varchar

  Note: 'Master record for every FHIR API endpoint registered and managed by the organization, including patient-facing SMART on FHIR apps, payer FHIR APIs (CMS Interoperability Rule), provider directory endpoints, and internal FHIR server instances. Captures endpoint URL, FHIR version (R4/STU3), capability statement URL, supported resource types, authentication method (OAuth2/SMART/API key), rate limits, CMS compliance flag (21st Century Cures Act), and operational status. SSOT for FHIR API inventory.'
}

Table interoperability.fhir_resource_log {
  fhir_resource_log_id varchar [pk, note: 'Unique identifier for each FHIR resource operation log entry. Primary key for the FHIR resource log.']
  demographics_id varchar [note: 'The Medical Record Number (MRN) or FHIR Patient resource ID representing the patient whose data is the subject of the API operation. Empty for non-patient-specific operations (e.g., Practitioner lookup). Required for Protected Health Information (PHI) access auditing per HIPAA.']
  fhir_endpoint_id varchar [note: 'Foreign key linking to interoperability.fhir_endpoint. Business justification: FHIR resource operations are executed against specific FHIR endpoints. Linking fhir_resource_log to fhir_endpoint enables tracking which endpoint served each request, monitoring endpoint-specific perf']
  parent_fhir_resource_log_id varchar [note: 'Self-referencing FK on fhir_resource_log (related_fhir_resource_log_id)']
  visit_id varchar [note: 'The FHIR Encounter resource ID representing the clinical encounter context in which the API operation occurred. Used to link API access to specific episodes of care for clinical workflow analysis.']
  access_decision varchar [note: 'The access control decision made by the authorization engine (granted, denied, conditional). Supports security audit and access policy effectiveness analysis.']
  authorization_scope varchar [note: 'The OAuth 2.0 scopes granted to the requesting client for this operation (e.g., patient/*.read, user/Observation.write). Defines the access permissions under which the operation was performed.']
  conformance_validation_result varchar [note: 'Indicates whether the FHIR resource in the request or response passed conformance validation against the applicable FHIR profile or implementation guide (passed, failed, not_validated). Supports data quality monitoring and interoperability compliance.']
  consent_policy_applied varchar [note: 'Identifier or reference to the patient consent policy that was evaluated and applied during this operation. Supports consent-based access control and HIPAA minimum necessary compliance.']
  created_timestamp timestamp [note: 'The date and time when this log record was created in the data warehouse. Used for data lineage and audit trail purposes.']
  cures_act_exception_flag boolean [note: 'Indicates whether this operation involved an exception to the information blocking prohibition under the 21st Century Cures Act (e.g., privacy exception, security exception). True if an exception was invoked, False otherwise.']
  data_segmentation_applied boolean [note: 'Indicates whether data segmentation for privacy (DS4P) was applied to filter sensitive data elements from the response based on patient consent or policy. True if segmentation occurred, False otherwise.']
  denial_reason varchar [note: 'The reason code or message explaining why access was denied or the operation failed. Used for troubleshooting and identifying access control issues.']
  exception_reason varchar [note: 'The specific exception category or reason code under the 21st Century Cures Act that justified restricting access or blocking information (e.g., privacy, security, infeasibility). Required when cures_act_exception_flag is True.']
  fhir_profile_url varchar [note: 'The canonical URL of the FHIR profile or implementation guide against which the resource was validated (e.g., US Core, IPS). Identifies the conformance standard applied.']
  fhir_resource_identifier varchar [note: 'The logical identifier of the specific FHIR resource instance being accessed (e.g., Patient/12345, Observation/67890). Empty for search or create operations that do not target a specific resource instance.']
  fhir_resource_type varchar [note: 'The type of FHIR resource being accessed or manipulated (e.g., Patient, Observation, Condition, MedicationRequest). Defines the clinical or administrative entity subject to the operation. [ENUM-REF-CANDIDATE: Patient|Observation|Condition|MedicationRequest|Procedure|Encounter|AllergyIntolerance|DiagnosticReport|Immunization|CarePlan|DocumentReference|Practitioner|Organization|Location|Device|Appointment|ServiceRequest|Coverage|Claim|ExplanationOfBenefit|CareTeam|Goal|Medication|Substance|Specimen|Task|Communication|Consent|Provenance|AuditEvent|Bundle — promote to reference product]']
  fhir_version_code varchar [note: 'The version identifier of the FHIR resource instance accessed via vread or returned in response. Supports resource versioning and history tracking per FHIR specification.']
  hie_transaction_code varchar [note: 'Correlation identifier linking this FHIR operation to a broader Health Information Exchange (HIE) transaction or query. Used to trace data flows across organizational boundaries.']
  http_status_code varchar [note: 'The HTTP response status code returned by the FHIR server (e.g., 200 for success, 404 for not found, 401 for unauthorized, 500 for server error). Indicates the outcome of the API operation.']
  modified_timestamp timestamp [note: 'The date and time when this log record was last modified or updated in the data warehouse. Supports change tracking and data quality monitoring.']
  operation_outcome varchar [note: 'High-level categorization of the operation result (success, client_error, server_error, not_found, unauthorized, forbidden, validation_error). Derived from HTTP status code for simplified reporting and alerting. [ENUM-REF-CANDIDATE: success|client_error|server_error|not_found|unauthorized|forbidden|validation_error — 7 candidates stripped; promote to reference product]']
  operation_type varchar [note: 'The RESTful interaction type performed on the FHIR resource (read, vread, update, patch, delete, create, search-type, history-instance, history-type, or custom $operation). Aligns with FHIR RESTful API interaction definitions. [ENUM-REF-CANDIDATE: read|vread|update|patch|delete|create|search-type|history-instance|history-type|operation — 10 candidates stripped; promote to reference product]']
  request_body_size_bytes varchar [note: 'The size of the HTTP request body payload in bytes. Used for bandwidth monitoring and identifying large resource submissions.']
  request_method varchar [note: 'The HTTP method used for the FHIR API request (GET, POST, PUT, PATCH, DELETE). Indicates the type of RESTful operation performed.']
  request_timestamp timestamp [note: 'The date and time when the FHIR API request was received by the server. Represents the business event time for the operation and is used for audit trail and performance analysis.']
  request_url varchar [note: 'The full URL path of the FHIR API request, including query parameters for search operations. Captures the exact API endpoint and parameters used for detailed audit and debugging.']
  requesting_application_code varchar [note: 'Identifier of the client application or system that initiated the FHIR API request (e.g., mobile app, EHR module, third-party application). Used for access tracking and application-level analytics.']
  requesting_client_code varchar [note: 'OAuth 2.0 client identifier or API key associated with the requesting application. Supports authentication audit and client-level access control.']
  response_body_size_bytes varchar [note: 'The size of the HTTP response body payload in bytes. Used for bandwidth monitoring and identifying large resource retrievals.']
  response_time_ms varchar [note: 'The elapsed time in milliseconds between request receipt and response transmission. Key performance indicator for FHIR API latency and service level agreement (SLA) monitoring.']
  response_timestamp timestamp [note: 'The date and time when the FHIR API response was sent back to the client. Used to calculate response time and monitor API performance.']
  search_parameters varchar [note: 'The query string parameters used in FHIR search operations (e.g., _id, _lastUpdated, patient, code). Captured for search pattern analysis and optimization.']
  search_result_count varchar [note: 'The number of FHIR resources returned in response to a search operation. Used to analyze search effectiveness and identify overly broad queries.']
  source_ip_address varchar [note: 'The IP address of the client that originated the FHIR API request. Used for security monitoring, access control, and geographic analysis. May be considered personally identifiable information (PII) in some jurisdictions.']
  user_agent varchar [note: 'The HTTP User-Agent header value identifying the client software, operating system, and device type. Used for client compatibility analysis and troubleshooting.']
  validation_errors varchar [note: 'Detailed error messages or codes returned by the FHIR validator when conformance validation fails. Used for troubleshooting and data quality improvement.']
  vibe_mutation_marker varchar

  Note: 'Transactional log of every FHIR resource operation (read, search, create, update, delete, $operation) processed through FHIR API endpoints. Captures FHIR resource type (Patient, Observation, Condition, MedicationRequest, etc.), operation type, request timestamp, response HTTP status, FHIR resource ID, requesting application/client ID, patient context, response time, and conformance validation result. Supports 21st Century Cures Act audit requirements and FHIR API performance monitoring.'
}

Table interoperability.mapping_rule {
  mapping_rule_id varchar [pk, note: 'Unique identifier for the individual transformation rule within a data mapping definition. Primary key for the mapping rule record.']
  fallback_mapping_rule_id varchar [note: 'Self-referencing FK on mapping_rule (fallback_mapping_rule_id)']
  mapping_definition_id varchar [note: 'Reference to the parent mapping definition container that groups related transformation rules. Links this atomic rule to its parent mapping context.']
  source_crosswalk_id varchar [note: 'Foreign key linking to reference.crosswalk. Business justification: Interface transformation rules reference crosswalk tables for code-to-code mappings. Real-world: mapping rules execute crosswalk lookups during message transformation to translate between code systems']
  source_exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Mapping rules transform data FROM a source exchange standard. Adding this FK provides authoritative linkage to the standard definition (HL7v2, FHIR, CDA, etc.) and enables validation that the source_e']
  approved_by varchar [note: 'Identifier of the user or authority who approved this transformation rule for production use. Supports governance and change control processes for interface engine configurations.']
  approved_timestamp timestamp [note: 'The date and time when this transformation rule was approved for production use. Supports governance and change control processes for interface engine configurations.']
  condition_expression varchar [note: 'Boolean expression or predicate that determines when this rule should be applied. If empty or null, the rule applies unconditionally. Supports conditional transformation logic.']
  created_timestamp timestamp [note: 'The date and time when this transformation rule record was first created in the system. Supports audit trail and change tracking for interface configurations.']
  data_type_conversion varchar [note: 'Specific instructions or function calls for converting the source data type to the target data type. May include format strings, parsing rules, or precision handling.']
  default_value decimal(18,2) [note: 'The value to assign to the target field when the source value is missing, null, or does not meet the condition expression. Supports fallback behavior in transformation logic.']
  effective_end_date date [note: 'The date when this transformation rule is no longer active and should not be applied. Nullable for rules with indefinite validity. Supports rule retirement and deprecation.']
  effective_start_date date [note: 'The date when this transformation rule becomes active and should be applied by the interface engine. Supports time-based rule activation for regulatory or business changes.']
  equivalence_type varchar [note: 'Describes the semantic relationship between the source and target concepts in terminology mapping. Follows HL7 FHIR ConceptMapEquivalence value set for interoperability standards. [ENUM-REF-CANDIDATE: equivalent|equal|wider|subsumes|narrower|specializes|inexact|unmatched|disjoint — 9 candidates stripped; promote to reference product]']
  error_handling_action varchar [note: 'Defines the action to take when this rule encounters an error during execution. Options: abort (stop processing), log (record error and continue), skip (ignore rule), retry (attempt again), default (use default_value).']
  is_mandatory boolean [note: 'Indicates whether this transformation rule must successfully execute for the overall mapping to be considered valid. If true, rule failure causes message rejection or error.']
  modified_by varchar [note: 'Identifier of the user, system, or interface analyst who last modified this transformation rule. Used for accountability and audit trail in interface engine governance.']
  modified_timestamp timestamp [note: 'The date and time when this transformation rule record was last modified. Supports audit trail and change tracking for interface configurations.']
  notes varchar [note: 'Free-text field for additional comments, implementation notes, known issues, or special considerations related to this transformation rule. Supports knowledge transfer and maintenance.']
  null_handling_strategy varchar [note: 'Defines how the transformation engine should handle null or missing source values. Options: skip (do not write target), default (use default_value), error (raise exception), empty_string (write empty string), preserve_null (write null to target).']
  rule_description varchar [note: 'Detailed explanation of the transformation logic, business rationale, and expected behavior of this mapping rule. Documents the purpose and context for future maintenance.']
  rule_name varchar [note: 'Human-readable name or label for the transformation rule. Used for identification and documentation purposes in interface engine configurations.']
  rule_priority varchar [note: 'Priority level for rule execution when multiple rules could apply to the same source-target pair. Higher values indicate higher priority. Used for conflict resolution.']
  rule_sequence varchar [note: 'Ordinal position of this transformation rule within the parent mapping definition. Determines execution order when multiple rules apply to the same source-target pair.']
  rule_status varchar [note: 'Current lifecycle status of the transformation rule. Determines whether the rule is executed by the interface engine during message processing.']
  rule_version varchar [note: 'Version identifier for this transformation rule. Supports granular versioning and change tracking of individual rules independent of the parent mapping definition.']
  source_data_type varchar [note: 'The data type of the source field as defined in the source system schema or message specification. Used for type validation and conversion planning.']
  source_expression varchar [note: 'The source field path, XPath, JSONPath, or HL7 segment/field reference that identifies the input data element to be transformed. May include extraction logic or functions.']
  target_code_system varchar [note: 'The terminology or code system used in the target field. Examples: ICD-10, SNOMED CT, LOINC, NDC, CPT. Used for terminology mapping and value set translation.']
  target_data_type varchar [note: 'The data type of the target field as defined in the target system schema or message specification. Used for type conversion and validation.']
  target_expression varchar [note: 'The target field path, XPath, JSONPath, or HL7 segment/field reference that identifies where the transformed value should be written. May include assignment logic or functions.']
  test_case_reference varchar [note: 'Reference to the test case or test suite that validates this transformation rule. Links rule to quality assurance artifacts for regression testing and validation.']
  transformation_function varchar [note: 'The function, method, or algorithm applied to convert the source value to the target format. May reference built-in interface engine functions, custom scripts, or standard conversion routines.']
  validation_rule varchar [note: 'Post-transformation validation expression or constraint that the target value must satisfy. Used to ensure data quality and conformance to target system requirements.']
  vibe_mutation_marker varchar
  created_by varchar [note: 'Identifier of the user, system, or interface analyst who created this transformation rule. Used for accountability and audit trail in interface engine governance.']

  Note: 'Individual transformation rule record within a data mapping definition, representing the atomic unit of field-level or value-level translation logic. Captures rule sequence, source expression, target expression, condition expression, default value, null handling behavior, data type conversion, and test case reference. Enables granular versioning, testing, and governance of transformation logic separate from the parent mapping container.'
}

Table interoperability.hie_participation {
  hie_participation_id varchar [pk, note: 'Unique identifier for the HIE participation record. Primary key for the HIE participation entity.']
  business_associate_agreement_id varchar [note: 'Reference to the Business Associate Agreement governing the HIE relationship, if the HIE is acting as a business associate.']
  care_site_id varchar [note: 'Reference to the specific facility participating in the HIE, if participation is facility-level rather than organization-wide.']
  employee_id varchar [note: 'Identifier of the user who last updated this HIE participation record.']
  financial_entity_id varchar [note: 'Reference to the healthcare organization participating in the HIE. Links to the organization master data.']
  hie_organization_id varchar [note: 'Unique identifier assigned by the HIE network to this participating organization. Used for routing and identification within the HIE.']
  interface_engine_id varchar [note: 'Foreign key linking to interoperability.interface_engine. Business justification: HIE participation uses specific interface engine endpoints for connectivity. Currently interface_engine_endpoint (STRING) exists. FK to interface_engine enables tracking which engine instance handles ']
  org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: HIE participation tracks which provider organizations participate in health information exchanges. Care_site_id exists but doesn\'t identify the legal NPI holder. Credentialing, regulatory reporting, a']
  renewed_hie_participation_id varchar [note: 'Self-referencing FK on hie_participation (renewed_hie_participation_id)']
  annual_participation_fee decimal(15,2) [note: 'Annual fee charged by the HIE network for participation, if applicable.']
  compliance_attestation_date date [note: 'Date when the organization attested to compliance with HIE policies, HIPAA requirements, and technical standards.']
  compliance_attestation_expiration_date date [note: 'Date when the current compliance attestation expires and must be renewed.']
  contribution_volume_monthly_avg varchar [note: 'Average number of clinical documents or messages contributed to the HIE per month by this organization.']
  created_timestamp timestamp [note: 'Timestamp when this HIE participation record was first created in the system.']
  data_sharing_scope varchar [note: 'Description of the types of clinical data shared through the HIE (e.g., ADT, lab results, radiology reports, medication history, immunizations, clinical summaries).']
  data_use_agreement_expiration_date date [note: 'Date when the current Data Use Agreement expires and must be renewed.']
  data_use_agreement_signed_date date [note: 'Date when the organization signed the Data Use Agreement or Participation Agreement with the HIE.']
  go_live_date date [note: 'Date when the organization began actively exchanging data through the HIE network in production.']
  hie_network_name varchar [note: 'Official name of the HIE network (e.g., CommonWell Health Alliance, Carequality, eHealth Exchange, state-specific HIE name).']
  hie_network_type varchar [note: 'Classification of the HIE network by geographic or organizational scope: state HIE, regional HIE, national network, private exchange, or vendor-specific network.']
  interface_engine_endpoint varchar [note: 'Technical endpoint URL or address configured in the interface engine for HIE connectivity (e.g., FHIR base URL, Direct address, HL7 MLLP endpoint).']
  last_audit_date date [note: 'Date of the most recent compliance or security audit conducted by the HIE network.']
  next_audit_date date [note: 'Scheduled date for the next compliance or security audit by the HIE network.']
  notes varchar [note: 'Additional notes or comments regarding the HIE participation, including special configurations, exceptions, or historical context.']
  npi varchar [note: 'National Provider Identifier for the organization participating in the HIE, used for provider directory and routing purposes.']
  onboarding_date date [note: 'Date when the organization formally joined the HIE network and completed technical onboarding.']
  participation_status varchar [note: 'Current status of the organizations participation in the HIE network: active (exchanging data), inactive (not exchanging), suspended (temporarily halted), pending onboarding (in setup), or terminated (ended).']
  participation_tier varchar [note: 'Level of participation in the HIE: query-only (read access), contribute-only (write access), query-and-contribute (bidirectional), or full bidirectional with advanced services.']
  patient_consent_model varchar [note: 'Consent framework governing patient data sharing: opt-in (explicit consent required), opt-out (default sharing unless patient objects), no consent required (permitted by law), or emergency-only access.']
  primary_contact_email varchar [note: 'Email address of the primary organizational contact for HIE participation.']
  primary_contact_name varchar [note: 'Name of the primary organizational contact responsible for HIE participation and coordination.']
  primary_contact_phone varchar [note: 'Phone number of the primary organizational contact for HIE participation.']
  query_volume_monthly_avg varchar [note: 'Average number of queries sent to the HIE per month by this organization.']
  supported_standards varchar [note: 'List of interoperability standards supported for this HIE participation (e.g., HL7 v2.5.1, FHIR R4, CDA R2, Direct 1.1, IHE XDS).']
  suspension_reason varchar [note: 'Reason for suspension or termination of HIE participation (e.g., compliance violation, technical issues, voluntary withdrawal, contract expiration).']
  technical_connection_type varchar [note: 'Technical method used to connect to the HIE: Direct Messaging (SMTP/S-MIME), FHIR API, HL7v2 interface, CDA document exchange, or proprietary protocol.']
  technical_contact_email varchar [note: 'Email address of the technical contact for HIE interface support.']
  technical_contact_name varchar [note: 'Name of the technical contact responsible for interface configuration and troubleshooting.']
  technical_contact_phone varchar [note: 'Phone number of the technical contact for HIE interface support.']
  termination_date date [note: 'Date when the organization formally ended participation in the HIE network.']
  transaction_fee_model varchar [note: 'Pricing model for HIE transactions: flat rate, per-transaction fee, tiered pricing based on volume, or no fee.']
  updated_timestamp timestamp [note: 'Timestamp when this HIE participation record was last updated in the system.']
  vibe_mutation_marker varchar

  Note: 'Master record documenting the healthcare organizations formal participation in Health Information Exchanges (HIEs), including state HIEs, regional HIEs (CommonWell, Carequality, eHealth Exchange), and national networks. Captures HIE name, network type, participation tier (query/contribute/both), onboarding date, data sharing scope, patient consent model (opt-in/opt-out), technical connection type, compliance attestation date, and participation status. SSOT for HIE network membership.'
}

Table interoperability.hie_query {
  hie_query_id varchar [pk, note: 'Unique identifier for each HIE query transaction. Primary key for the HIE query record.']
  clinician_id varchar [note: 'Identifier of the healthcare provider who requested the HIE query.']
  consent_policy_id varchar [note: 'Identifier of the consent policy applied to this HIE query for patient privacy enforcement.']
  demographics_id varchar [note: 'Internal identifier of the patient for whom the HIE query was performed.']
  follow_up_hie_query_id varchar [note: 'Self-referencing FK on hie_query (follow_up_hie_query_id)']
  hie_organization_id varchar [note: 'Foreign key linking to interoperability.hie_organization. Business justification: HIE queries are submitted to or received from specific HIE organizations. Currently only hie_network_name (STRING) exists. Adding FK to hie_organization enables proper referential integrity, tracking ']
  hie_participation_id varchar [note: 'Foreign key linking to interoperability.hie_participation. Business justification: HIE queries are executed within the context of a specific HIE participation agreement. Currently hie_query has hie_network_name (STRING) and care_site_id, but no direct link to the participation recor']
  interface_engine_id varchar [note: 'Identifier of the interface engine that processed and routed the HIE query.']
  primary_hie_care_site_id varchar [note: 'Identifier of the healthcare facility that initiated the HIE query request.']
  visit_id varchar [note: 'Identifier of the clinical encounter during which the HIE query was performed.']
  audit_logged boolean [note: 'Indicates whether the HIE query transaction was logged in the audit trail for compliance and security monitoring.']
  clinical_purpose_code varchar [note: 'Code indicating the clinical purpose for which the HIE query was performed, used for consent enforcement and audit logging.']
  consent_verified boolean [note: 'Indicates whether patient consent was verified before the HIE query was executed.']
  created_timestamp timestamp [note: 'Date and time when the HIE query record was created in the data warehouse.']
  data_sensitivity_level varchar [note: 'Sensitivity classification of the data requested or returned in the HIE query.']
  documents_returned_count varchar [note: 'Number of clinical documents returned by the responding facility in response to the HIE query.']
  error_code varchar [note: 'Error code returned by the HIE network if the query failed or encountered issues.']
  error_message varchar [note: 'Detailed error message describing the reason for query failure or issues encountered.']
  hie_transaction_code varchar [note: 'Unique transaction identifier assigned by the HIE network for tracking and audit purposes.']
  initiating_facility_npi varchar [note: 'National Provider Identifier of the facility that initiated the query.']
  match_algorithm varchar [note: 'Name or identifier of the patient matching algorithm used by the HIE to determine patient identity.']
  match_confidence_score decimal(5,2) [note: 'Confidence score (0-100) indicating the likelihood that the patient demographics matched the correct patient record in the responding system.']
  notes varchar [note: 'Additional notes or comments related to the HIE query transaction for operational or audit purposes.']
  patient_date_of_birth date [note: 'Date of birth of the patient used in the HIE query for demographic matching.']
  patient_first_name varchar [note: 'First name of the patient submitted in the HIE query for demographic matching.']
  patient_gender varchar [note: 'Gender of the patient submitted in the HIE query for demographic matching.']
  patient_last_name varchar [note: 'Last name of the patient submitted in the HIE query for demographic matching.']
  patient_mrn varchar [note: 'Medical Record Number of the patient used in the HIE query for patient matching.']
  patient_ssn_last_four varchar [note: 'Last four digits of the patient Social Security Number used for matching in the HIE query.']
  patient_zip_code varchar [note: 'ZIP code of the patient address used in the HIE query for demographic matching.']
  query_message_control_number varchar [note: 'Unique message identifier for the query request as defined by the messaging protocol.']
  query_priority varchar [note: 'Priority level assigned to the HIE query indicating urgency of the information request.']
  query_protocol varchar [note: 'Interoperability protocol used to submit and receive the HIE query.']
  query_response_time_seconds decimal(10,3) [note: 'Time in seconds taken for the HIE network to return a response to the query request.']
  query_source_system varchar [note: 'Name or identifier of the source system (EMR/EHR) from which the HIE query was initiated.']
  query_status varchar [note: 'Current processing status of the HIE query transaction.']
  query_timestamp timestamp [note: 'Date and time when the HIE query was submitted to the health information exchange network.']
  query_type varchar [note: 'Type of query submitted to the HIE network. [ENUM-REF-CANDIDATE: patient_discovery|document_query|document_retrieve|patient_demographics_query|clinical_data_query|medication_history_query|immunization_query|lab_results_query|radiology_query|care_summary_query — promote to reference product]']
  requesting_provider_npi varchar [note: 'National Provider Identifier of the provider who requested the HIE query.']
  responding_facility_npi varchar [note: 'National Provider Identifier of the facility that responded to the query.']
  response_timestamp timestamp [note: 'Date and time when the HIE query response was received from the responding facility.']
  retry_count varchar [note: 'Number of times the HIE query was retried due to failures or timeouts.']
  vibe_mutation_marker varchar

  Note: 'Transactional record of every patient record query submitted to or received from an HIE network. Captures query timestamp, query type (patient discovery/document query/document retrieve), initiating facility, responding facility, patient demographics used for matching, match confidence score, number of documents returned, query response time, query status, and clinical purpose code. Supports care coordination analytics, HIE utilization reporting, and patient consent enforcement.'
}

Table interoperability.cda_document {
  cda_document_id varchar [pk, note: 'Unique identifier for the CDA document record in the interoperability layer. Primary key.']
  author_clinician_id varchar [note: 'Foreign key linking to provider.clinician. Business justification: CDA documents require linking to authoring clinician for credentialing privileging reviews, peer review case attribution, and Promoting Interoperability attestation. Author_provider_npi exists but lac']
  care_plan_id varchar [note: 'Foreign key linking to clinical.care_plan. Business justification: Care plans are transmitted in C-CDA Care Plan documents for care coordination. Linking cda_document to care_plan enables tracking which care plans were shared with external providers, supports care co']
  consent_reference_id varchar [note: 'Identifier of the patient consent record authorizing the exchange of this CDA document.']
  custodian_org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: CDA documents have custodian organization (legal entity responsible for the document). Custodian_organization_name exists but lacks FK. Healthcare compliance, legal health record management, and breac']
  demographics_id varchar [note: 'Internal system identifier for the patient who is the subject of this CDA document.']
  diagnosis_id varchar [note: 'Foreign key linking to clinical.clinical_diagnosis. Business justification: C-CDA documents contain diagnosis sections (Problem List, Encounter Diagnoses). Linking cda_document to clinical_diagnosis enables reconciliation of which specific diagnoses were transmitted in care t']
  interface_channel_id varchar [note: 'Identifier of the interface engine channel or route through which this CDA document was transmitted or received.']
  primary_cda_care_site_id varchar [note: 'Identifier of the healthcare facility or organization that authored or generated this CDA document.']
  problem_id varchar [note: 'Foreign key linking to clinical.problem. Business justification: Problem lists are core C-CDA content (Problem List section required in many document types). Linking cda_document to problem enables tracking which problems were transmitted in care transitions, suppo']
  superseded_cda_document_id varchar [note: 'Self-referencing FK on cda_document (superseded_cda_document_id)']
  trading_partner_id varchar [note: 'Foreign key linking to interoperability.trading_partner. Business justification: CDA documents are exchanged with trading partners (sent to or received from). Currently only destination_system_code and destination_system_name exist as strings. FK to trading_partner enables proper ']
  visit_id varchar [note: 'Identifier of the clinical encounter or visit associated with this CDA document, if applicable.']
  acknowledgment_status varchar [note: 'Status of the acknowledgment received from the destination system for outbound CDA document transmissions.']
  acknowledgment_timestamp timestamp [note: 'Date and time when acknowledgment was received from the destination system.']
  cda_version varchar [note: 'Version of the CDA standard used for this document (e.g., CDA R2, C-CDA R1.1, C-CDA R2.1, C-CDA R3.0).']
  confidentiality_code varchar [note: 'HL7 confidentiality code indicating the privacy level of the document (e.g., N=Normal, R=Restricted, V=Very Restricted).']
  created_timestamp timestamp [note: 'Date and time when this CDA document record was first created in the interoperability system.']
  document_creation_timestamp timestamp [note: 'Date and time when the CDA document was originally created or authored, as recorded in the CDA effectiveTime element.']
  document_hash varchar [note: 'Cryptographic hash (e.g., SHA-256) of the CDA document content for integrity verification and tamper detection.']
  document_size_bytes varchar [note: 'Size of the CDA document file in bytes.']
  document_status varchar [note: 'Current lifecycle status of the CDA document indicating its completeness and validity for clinical use.']
  document_title varchar [note: 'Human-readable title of the CDA document as specified in the title element.']
  document_type_code varchar [note: 'LOINC code representing the type of clinical document (e.g., 34133-9 for Summarization of Episode Note, 11488-4 for Consultation Note, 18842-5 for Discharge Summary).']
  document_type_name varchar [note: 'Human-readable name of the CDA document type (e.g., Continuity of Care Document (CCD), Consolidated CDA (C-CDA), Quality Reporting Document Architecture (QRDA) Category I, QRDA Category III, Referral Note, Discharge Summary, Progress Note, Operative Note).']
  document_unique_identifier varchar [note: 'Globally unique identifier for the CDA document, typically an Object Identifier (OID) conforming to ISO/IEC 8824 standard. This is the CDA document\'s id element value.']
  document_version_number varchar [note: 'Sequential version number of this CDA document within its document set. Increments with each amendment or update.']
  exchange_direction varchar [note: 'Direction of document exchange relative to the organization: inbound (received from external source) or outbound (sent to external recipient).']
  hipaa_compliant_flag boolean [note: 'Indicates whether the CDA document exchange complies with HIPAA Privacy and Security Rules.']
  language_code varchar [note: 'ISO 639-1 two-letter language code indicating the primary language of the CDA document content (e.g., en, es, fr).']
  modified_timestamp timestamp [note: 'Date and time when this CDA document record was last modified in the interoperability system.']
  notes varchar [note: 'Free-text notes or comments about the CDA document exchange, validation issues, or special handling instructions.']
  patient_mrn varchar [note: 'Medical Record Number of the patient who is the subject of this CDA document. Links to the patient master index.']
  purpose_of_use_code varchar [note: 'HL7 PurposeOfUse code indicating the reason for document exchange (e.g., TREATMENT, PAYMENT, OPERATIONS, RESEARCH).']
  receipt_timestamp timestamp [note: 'Date and time when the CDA document was received by the destination system for inbound exchanges.']
  service_end_date date [note: 'End date of the clinical service period documented in this CDA document.']
  service_start_date date [note: 'Start date of the clinical service period documented in this CDA document.']
  source_system_code varchar [note: 'Code identifying the source system or Electronic Health Record (EHR) that generated or transmitted this CDA document (e.g., EPIC, CERNER, MEDITECH).']
  source_system_name varchar [note: 'Name of the source system or EHR that generated this CDA document.']
  storage_location_uri varchar [note: 'Uniform Resource Identifier or file path indicating where the CDA document XML file is stored in the document repository or object storage system.']
  transmission_timestamp timestamp [note: 'Date and time when the CDA document was transmitted through the interface engine or HIE.']
  validation_error_count varchar [note: 'Number of validation errors identified during CDA schema and implementation guide validation.']
  validation_status varchar [note: 'Result of CDA schema and implementation guide validation performed on the document.']
  validation_timestamp timestamp [note: 'Date and time when CDA document validation was performed.']
  validation_warning_count varchar [note: 'Number of validation warnings identified during CDA document validation.']
  vibe_mutation_marker varchar

  Note: 'Master record for every CDA (Clinical Document Architecture) document generated, received, or exchanged through the interoperability layer. Captures document type (CCD, C-CDA, QRDA I/III, Referral Note, Discharge Summary), document unique ID (OID), document creation timestamp, author facility, patient reference, CDA version, document status (draft/final/amended/deprecated), exchange direction (inbound/outbound), source system, and storage reference. SSOT for CDA document inventory.'
}

Table interoperability.cda_validation_result {
  cda_validation_result_id varchar [pk, note: 'Unique identifier for the CDA validation result record. Primary key.']
  cda_document_id varchar [note: 'Unique identifier of the CDA document that was validated. References the source document in the document repository.']
  revalidated_cda_validation_result_id varchar [note: 'Self-referencing FK on cda_validation_result (revalidated_cda_validation_result_id)']
  trading_partner_id varchar [note: 'Identifier of the trading partner or external organization that submitted or will receive the validated document.']
  visit_id varchar [note: 'Identifier of the clinical encounter associated with the CDA document being validated.']
  certification_requirement_met boolean [note: 'Indicates whether the validation results demonstrate that certification requirements (e.g., ONC Health IT Certification) are met.']
  conformance_profile varchar [note: 'The CDA conformance profile or implementation guide tested during validation (e.g., C-CDA 2.1, QRDA Category I, QRDA Category III).']
  created_timestamp timestamp [note: 'Date and time when this validation result record was first created in the system.']
  critical_error_list varchar [note: 'Comma-separated or structured list of critical error codes that must be resolved before document can be accepted.']
  destination_system varchar [note: 'Name of the destination system or Health Information Exchange (HIE) that will receive the validated document.']
  document_author_npi varchar [note: 'National Provider Identifier of the clinician or provider who authored the CDA document.']
  document_size_kb decimal(10,2) [note: 'Size of the CDA document in kilobytes. Used for performance analysis and capacity planning.']
  document_type varchar [note: 'Type of CDA document validated (e.g., Continuity of Care Document, Discharge Summary, Progress Note). [ENUM-REF-CANDIDATE: continuity_of_care|discharge_summary|progress_note|consultation_note|operative_note|history_and_physical|referral_note — 7 candidates stripped; promote to reference product]']
  finding_details varchar [note: 'Structured or semi-structured text containing detailed validation findings including error codes, line numbers, XPath locations, and remediation guidance.']
  hie_network_name varchar [note: 'Name of the Health Information Exchange network through which the document will be exchanged.']
  last_updated_timestamp timestamp [note: 'Date and time when this validation result record was last modified.']
  notes varchar [note: 'Free-text notes or comments about the validation results, remediation actions, or special circumstances.']
  patient_mrn varchar [note: 'Medical Record Number of the patient whose clinical information is contained in the validated CDA document.']
  regulatory_submission_type varchar [note: 'Type of regulatory submission this validation supports (e.g., Meaningful Use, MIPS, HEDIS, CMS Quality Reporting).']
  remediation_assigned_to varchar [note: 'Username or identifier of the user or team assigned to remediate validation errors.']
  remediation_completed_timestamp timestamp [note: 'Date and time when document remediation was completed and the document was re-validated successfully.']
  remediation_required_flag boolean [note: 'Indicates whether document remediation is required before the document can be accepted or submitted.']
  retry_count varchar [note: 'Number of times the document has been re-validated after remediation attempts.']
  schema_validation_passed boolean [note: 'Indicates whether the document passed XML schema validation against the CDA schema definition.']
  schematron_validation_passed boolean [note: 'Indicates whether the document passed Schematron rule-based validation for conformance profile requirements.']
  structural_validation_passed boolean [note: 'Indicates whether the document passed structural validation for required sections, entries, and document hierarchy.']
  submission_readiness_flag boolean [note: 'Indicates whether the document is ready for regulatory submission or external exchange based on validation results.']
  total_error_count varchar [note: 'Total number of errors identified during validation. Errors represent critical conformance failures that prevent document acceptance.']
  total_informational_count varchar [note: 'Total number of informational findings identified during validation. Informational findings provide guidance for document quality improvement.']
  total_warning_count varchar [note: 'Total number of warnings identified during validation. Warnings represent non-critical issues that should be reviewed but do not prevent document acceptance.']
  validation_execution_time_ms varchar [note: 'Time taken to complete the validation process measured in milliseconds. Used for performance monitoring.']
  validation_initiated_by varchar [note: 'Username or identifier of the user or system process that initiated the validation.']
  validation_purpose varchar [note: 'Business purpose for performing the validation (e.g., trading partner onboarding, regulatory submission readiness, quality assurance).']
  validation_status varchar [note: 'Overall pass/fail status of the validation. Indicates whether the document meets conformance requirements.']
  validation_timestamp timestamp [note: 'Date and time when the CDA document validation was performed. Primary business event timestamp for this transaction.']
  validator_tool_name varchar [note: 'Name of the validation tool or engine used to perform the conformance check (e.g., NIST CDA Validator, Schematron Validator, C-CDA Validator).']
  validator_tool_version varchar [note: 'Version number of the validation tool used to ensure traceability of validation logic.']
  vibe_mutation_marker varchar
  vocabulary_validation_passed boolean [note: 'Indicates whether the document passed vocabulary validation for coded elements (SNOMED CT, LOINC, RxNorm, ICD-10).']

  Note: 'Transactional record of CDA document conformance validation results produced by schematron validators and C-CDA validators. Captures validation timestamp, document reference, validator tool used, conformance profile tested (C-CDA 2.1, QRDA I, etc.), total errors, total warnings, total informational findings, overall pass/fail status, and structured finding details. Supports document quality assurance, trading partner onboarding, and regulatory submission readiness.'
}

Table interoperability.patient_identity_match {
  patient_identity_match_id varchar [pk, note: 'Unique identifier for the patient identity matching event. Primary key for this transactional record.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or organization from which the match request originated.']
  employee_id varchar [note: 'User ID of the clinician or staff member who initiated the match request from the source system.']
  hie_organization_id varchar [note: 'Foreign key linking to interoperability.hie_organization. Business justification: Patient identity matching events occur when querying HIE networks. Link to hie_organization provides organizational context for match requests, enables tracking match accuracy by HIE network, and supp']
  patient_matched_empi_mpi_record_id varchar [note: 'The Enterprise Master Patient Index identifier from the EMPI system that was matched. May differ from local MPI ID in multi-system environments.']
  patient_mpi_record_id varchar [note: 'The enterprise Master Patient Index identifier that was matched to the submitted patient identifiers. Represents the golden record in the MPI.']
  superseded_patient_identity_match_id varchar [note: 'Self-referencing FK on patient_identity_match (superseded_patient_identity_match_id)']
  candidate_count varchar [note: 'Number of candidate patient records identified during the matching process before final match determination.']
  consent_override_flag boolean [note: 'Indicates whether patient consent restrictions were overridden for this match request due to emergency or break-the-glass access (True=override applied, False=normal consent rules applied).']
  consent_override_reason varchar [note: 'Reason documented for overriding patient consent restrictions during the match request (e.g., emergency treatment, break-the-glass).']
  created_timestamp timestamp [note: 'Date and time when this patient identity match record was first created in the system. Used for audit trail and data lineage.']
  duplicate_record_flag boolean [note: 'Indicates whether the match process identified a potential duplicate patient record that should be investigated for merging (True=duplicate detected, False=no duplicate).']
  error_code varchar [note: 'Error code returned if the match process encountered an error or exception. Empty if match completed successfully.']
  error_message varchar [note: 'Detailed error message describing any errors encountered during the match process.']
  hie_transaction_code varchar [note: 'Unique transaction identifier from the Health Information Exchange network, used to correlate this match event with HIE query logs.']
  last_updated_timestamp timestamp [note: 'Date and time when this patient identity match record was last modified. Used for audit trail and change tracking.']
  manual_review_assigned_to varchar [note: 'User ID or name of the HIM staff member assigned to manually review this match result.']
  manual_review_completed_timestamp timestamp [note: 'Date and time when manual review of the match result was completed.']
  manual_review_notes varchar [note: 'Free-text notes entered by the reviewer documenting the rationale for the manual review decision.']
  manual_review_outcome varchar [note: 'Outcome of the manual review process (CONFIRMED=match confirmed, REJECTED=match rejected, MERGED=records merged, NEW_RECORD_CREATED=new MPI record created).']
  manual_review_required_flag boolean [note: 'Indicates whether the match result requires manual review by HIM staff due to ambiguous or low-confidence matching (True=manual review required, False=automated match accepted).']
  match_algorithm_code varchar [note: 'Code identifying the specific matching algorithm or rule set used to perform the patient identity match (e.g., deterministic, probabilistic, hybrid).']
  match_algorithm_version varchar [note: 'Version number of the matching algorithm used, enabling traceability and audit of algorithm changes over time.']
  match_confidence_level varchar [note: 'Categorical confidence level of the match result based on match score thresholds (HIGH=score above high threshold, MEDIUM=score in middle range, LOW=score below medium threshold).']
  match_method varchar [note: 'Method used to perform the patient identity match (DETERMINISTIC=exact match on key identifiers, PROBABILISTIC=statistical matching, HYBRID=combination, MANUAL=human review).']
  match_processing_time_ms varchar [note: 'Time taken to process the identity match request, measured in milliseconds. Used for performance monitoring and SLA tracking.']
  match_request_timestamp timestamp [note: 'The date and time when the patient identity match request was initiated during cross-organizational data exchange. Represents the principal business event time for this transaction.']
  match_result_status varchar [note: 'Outcome of the patient identity matching process (MATCH=definitive match found, POSSIBLE_MATCH=potential match requiring review, NO_MATCH=no match found, MULTIPLE_MATCH=multiple candidates found, ERROR=matching process failed).']
  match_score decimal(5,2) [note: 'Numerical score representing the confidence level of the patient identity match, typically expressed as a percentage or weighted score. Higher scores indicate stronger matches.']
  matched_date_of_birth date [note: 'Date of birth from the matched MPI record, used to validate the match quality.']
  matched_patient_first_name varchar [note: 'First name of the patient from the matched MPI record, returned as part of the match result.']
  matched_patient_last_name varchar [note: 'Last name of the patient from the matched MPI record, returned as part of the match result.']
  requesting_user_npi varchar [note: 'National Provider Identifier of the healthcare provider who initiated the match request, if applicable.']
  source_system_code varchar [note: 'Identifier of the source system or application that initiated the patient identity match request.']
  source_system_name varchar [note: 'Name of the source system or application that initiated the match request (e.g., Epic EHR, Cerner Millennium, HIE portal).']
  submitted_address_line_1 varchar [note: 'First line of the patient address submitted in the match request.']
  submitted_city varchar [note: 'City of the patient address submitted in the match request.']
  submitted_date_of_birth date [note: 'Date of birth of the patient submitted in the match request, used as a key demographic matching attribute.']
  submitted_gender varchar [note: 'Gender of the patient submitted in the match request (M=Male, F=Female, U=Unknown, O=Other).']
  submitted_mrn varchar [note: 'The Medical Record Number submitted as part of the match request from the source system. May be facility-specific.']
  submitted_patient_first_name varchar [note: 'First name of the patient submitted in the match request for identity matching purposes.']
  submitted_patient_last_name varchar [note: 'Last name of the patient submitted in the match request for identity matching purposes.']
  submitted_phone_number varchar [note: 'Phone number of the patient submitted in the match request.']
  submitted_postal_code varchar [note: 'Postal code of the patient address submitted in the match request.']
  submitted_ssn varchar [note: 'Social Security Number submitted in the match request, if available. Used as a strong identifier for matching.']
  submitted_state varchar [note: 'State or province of the patient address submitted in the match request.']
  transaction_type varchar [note: 'Type of interoperability transaction that triggered the identity match (PIX Query, PDQ Query, MPI Lookup, EMPI Match, FHIR Patient Match, HL7 ADT).']
  vibe_mutation_marker varchar

  Note: 'Transactional record of patient identity matching events performed during cross-organizational data exchange, including MPI (Master Patient Index) lookups, EMPI matching, and IHE PIX/PDQ transactions. Captures match request timestamp, source system, match algorithm used, candidate patient identifiers submitted, match score, match result (match/possible match/no match), matched MPI record reference, and manual review flag. Critical for preventing patient data mismatches during HIE queries and care transitions.'
}

Table interoperability.direct_message {
  direct_message_id varchar [pk, note: 'Unique identifier for the Direct Secure Messaging transaction. Primary key for the direct_message product.']
  interface_engine_id varchar [note: 'Identifier of the interface engine or Direct messaging gateway that processed and transmitted the message. Links to the interface_engine product for system tracking.']
  mpi_record_id varchar [note: 'Foreign key linking to patient.mpi_record. Business justification: Direct Secure Messaging transmits patient PHI (referrals, care summaries, lab results). Audit trails and breach investigations require authoritative patient linkage. Meaningful Use attestation require']
  replied_to_direct_message_id varchar [note: 'Self-referencing FK on direct_message (replied_to_direct_message_id)']
  sender_direct_address_id varchar [note: 'Foreign key linking to interoperability.direct_address. Business justification: Direct messages are sent FROM managed Direct addresses. Currently sender_direct_address is a STRING column. Adding sender_direct_address_id FK links the message to the managed address record in direct']
  trading_partner_id varchar [note: 'Identifier of the trading partner (external organization) involved in the Direct message exchange. Links to the trading_partner product for relationship management.']
  visit_id varchar [note: 'Identifier of the clinical encounter associated with the Direct message content, linking the message to a specific episode of care.']
  acknowledgment_code varchar [note: 'SMTP or application-level acknowledgment code returned by the recipient system confirming message receipt and processing status.']
  attachment_count varchar [note: 'Number of file attachments included with the Direct message (e.g., CDA documents, PDF reports, DICOM images). Zero indicates message body only.']
  attachment_types varchar [note: 'Comma-separated list of MIME types for all attachments included in the Direct message (e.g., application/xml, application/pdf, image/jpeg).']
  certificate_validation_result varchar [note: 'Result of the digital certificate validation process for both sender and recipient certificates, ensuring trust and authenticity of the Direct message exchange.']
  clinical_document_reference varchar [note: 'Reference identifier or pointer to the associated clinical document (CDA, FHIR document, or other format) that was transmitted within or attached to the Direct message.']
  created_timestamp timestamp [note: 'The date and time when this Direct message record was first created in the system. Represents the audit trail creation time, distinct from the send_timestamp.']
  delivery_status varchar [note: 'Current delivery status of the Direct message indicating whether it was successfully delivered, failed, bounced, or is pending delivery confirmation.']
  delivery_timestamp timestamp [note: 'The date and time when the Direct message was successfully delivered to the recipient system, or when a delivery failure was confirmed. Null if delivery is still pending.']
  encryption_algorithm varchar [note: 'The cryptographic algorithm used to encrypt the Direct message (e.g., AES-256, 3DES). Supports security audit and compliance verification.']
  encryption_status varchar [note: 'Indicates whether the Direct message was successfully encrypted using S/MIME encryption standards as required by the Direct Protocol for Protected Health Information (PHI) transmission.']
  failure_reason varchar [note: 'Detailed description of the reason for message delivery failure, including SMTP error codes, certificate validation errors, or recipient system unavailability. Null for successful deliveries.']
  hie_network_name varchar [note: 'Name of the Health Information Exchange network or DirectTrust community through which the message was routed, if applicable. Null for direct point-to-point exchanges.']
  hipaa_compliant boolean [note: 'Boolean flag indicating whether the Direct message transmission met all HIPAA Security Rule requirements for Protected Health Information (PHI) exchange, including encryption and authentication.']
  meaningful_use_eligible boolean [note: 'Boolean flag indicating whether this Direct message transaction qualifies for Meaningful Use or Promoting Interoperability attestation requirements under CMS programs.']
  message_control_number varchar [note: 'Unique control identifier assigned to the Direct message by the sending system, used for tracking and correlation across systems.']
  message_priority varchar [note: 'Priority level assigned to the Direct message indicating the urgency of the clinical information being exchanged. Influences routing and notification workflows.']
  message_size_bytes varchar [note: 'Total size of the Direct message including all attachments and headers, measured in bytes. Used for capacity planning and transmission monitoring.']
  message_type varchar [note: 'Classification of the Direct message content indicating the clinical purpose or document type being exchanged (e.g., referral, care summary, lab result, discharge notification).']
  modified_timestamp timestamp [note: 'The date and time when this Direct message record was last modified or updated in the system. Supports audit trail and change tracking requirements.']
  notes varchar [note: 'Free-text notes or comments about the Direct message transaction, including manual interventions, escalations, or special handling instructions.']
  patient_mrn varchar [note: 'The Medical Record Number of the patient whose clinical information is being exchanged in the Direct message. Used for patient matching and care coordination.']
  read_receipt_received boolean [note: 'Boolean flag indicating whether a read receipt (Message Disposition Notification) was received from the recipient, confirming the message was opened.']
  read_receipt_requested boolean [note: 'Boolean flag indicating whether the sender requested a read receipt (Message Disposition Notification) to confirm the recipient opened and read the message.']
  read_timestamp timestamp [note: 'The date and time when the recipient opened and read the Direct message, as reported by the Message Disposition Notification. Null if no read receipt was received.']
  recipient_certificate_serial_number varchar [note: 'Serial number of the digital certificate used by the recipient to decrypt the Direct message. Used for certificate tracking and audit trails.']
  recipient_direct_address varchar [note: 'The Direct Protocol email address of the intended recipient (provider, organization, or system) receiving the secure message. Format follows standard email address structure with DirectTrust-accredited domain.']
  recipient_npi varchar [note: 'National Provider Identifier of the receiving provider or organization. Ten-digit unique identifier assigned by CMS for HIPAA-covered entities.']
  recipient_organization_name varchar [note: 'Name of the healthcare organization or facility that received the Direct message. Supports care coordination tracking and organizational analytics.']
  retry_count varchar [note: 'Number of times the system attempted to resend the Direct message after initial delivery failure. Zero indicates successful first-attempt delivery.']
  send_timestamp timestamp [note: 'The date and time when the Direct message was sent from the originating system. Represents the business event time of message transmission.']
  sender_certificate_serial_number varchar [note: 'Serial number of the digital certificate used by the sender to sign and encrypt the Direct message. Used for certificate tracking and audit trails.']
  subject_line varchar [note: 'Subject line of the Direct message providing a brief description of the message content or purpose. May contain patient identifiers or clinical context.']
  vibe_mutation_marker varchar
  workflow_status varchar [note: 'Current status of the Direct message within the internal care coordination workflow, tracking the message from initiation through final processing and archival. [ENUM-REF-CANDIDATE: initiated|in_transit|delivered|acknowledged|processed|archived|failed — 7 candidates stripped; promote to reference product]']

  Note: 'Transactional record of every Direct Secure Messaging transaction exchanged via the Direct Protocol (DirectTrust). Captures message ID, sender Direct address, recipient Direct address, message type (referral, care summary, lab result, discharge notification), send timestamp, delivery status (sent/delivered/failed/bounced), message size, encryption status, certificate validation result, and associated clinical document reference. Supports care coordination, referral workflows, and Meaningful Use/Promoting Interoperability attestation.'
}

Table interoperability.direct_address {
  direct_address_id varchar [pk, note: 'Unique identifier for the Direct Secure Messaging address record. Primary key.']
  care_site_id varchar [note: 'Foreign key reference to the facility associated with this Direct address when the address type is facility or organization.']
  clinician_id varchar [note: 'Foreign key reference to the provider associated with this Direct address when the address type is provider.']
  demographics_id varchar [note: 'Foreign key reference to the patient associated with this Direct address when the address type is patient.']
  replaced_direct_address_id varchar [note: 'Self-referencing FK on direct_address (replaced_direct_address_id)']
  activation_date date [note: 'The date on which this Direct address was activated and became operational for sending and receiving secure messages.']
  address_status varchar [note: 'Current operational status of the Direct address. Active addresses can send and receive messages; inactive, suspended, or revoked addresses cannot.']
  address_type varchar [note: 'Classification of the Direct address by entity type. Indicates whether the address belongs to an individual provider, a facility, a patient, an organizational unit, a department, or an application endpoint.']
  administrative_contact_email varchar [note: 'The email address of the administrative contact responsible for this Direct address. Used for notifications and operational communications.']
  administrative_contact_name varchar [note: 'The name of the administrative contact responsible for managing this Direct address. Used for operational coordination and issue resolution.']
  administrative_contact_phone varchar [note: 'The phone number of the administrative contact responsible for this Direct address. Used for urgent operational communications.']
  auto_renewal_enabled_flag boolean [note: 'Indicates whether automatic certificate renewal is enabled for this Direct address. True if auto-renewal is configured, False if manual renewal is required.']
  certificate_expiration_date date [note: 'The date on which the digital certificate for this Direct address will expire. Certificates must be renewed before this date to maintain secure messaging capability.']
  certificate_issue_date date [note: 'The date on which the digital certificate for this Direct address was issued by the Certificate Authority.']
  certificate_issuer_dn varchar [note: 'The Distinguished Name of the Certificate Authority that issued the certificate for this Direct address. Identifies the trusted CA in the PKI hierarchy.']
  certificate_serial_number varchar [note: 'The unique serial number of the X.509 digital certificate issued for this Direct address. Used for certificate identification and revocation checking.']
  certificate_status varchar [note: 'Current status of the X.509 digital certificate associated with this Direct address. Valid certificates are required for secure message encryption and signing.']
  created_timestamp timestamp [note: 'The timestamp when this Direct address record was first created in the system. Used for audit trail and data lineage tracking.']
  deactivation_date date [note: 'The date on which this Direct address was deactivated and ceased to be operational. Null if the address is currently active.']
  department_name varchar [note: 'The name of the clinical or administrative department associated with this Direct address when the address type is department or organization.']
  direct_address varchar [note: 'The fully qualified Direct address in email format (e.g., provider@direct.hospital.org). Used for secure HIPAA-compliant messaging between healthcare entities.']
  display_name varchar [note: 'The human-readable display name associated with this Direct address, typically shown in message headers and address books (e.g., Dr. John Smith, Cardiology Department).']
  encryption_algorithm varchar [note: 'The cryptographic algorithm used for encrypting messages sent to this Direct address (e.g., AES-256, 3DES). Ensures HIPAA-compliant secure transmission.']
  hipaa_compliant_flag boolean [note: 'Indicates whether this Direct address has been verified as HIPAA-compliant for secure transmission of Protected Health Information (PHI). True if compliant, False otherwise.']
  hisp_domain varchar [note: 'The domain name of the HISP that manages this Direct address (e.g., direct.hospital.org). Used for routing and trust validation.']
  hisp_name varchar [note: 'The name of the Health Information Service Provider that hosts and manages the Direct messaging infrastructure for this address.']
  hitrust_certified_flag boolean [note: 'Indicates whether the HISP managing this Direct address holds HITRUST CSF certification. True if certified, False otherwise.']
  last_message_received_timestamp timestamp [note: 'The timestamp of the most recent message received by this Direct address. Used for activity tracking and dormant address identification.']
  last_message_sent_timestamp timestamp [note: 'The timestamp of the most recent message sent from this Direct address. Used for activity tracking and dormant address identification.']
  last_updated_timestamp timestamp [note: 'The timestamp when this Direct address record was last modified. Used for audit trail and change tracking.']
  message_volume_last_30_days varchar [note: 'The total number of messages sent or received by this Direct address in the last 30 days. Used for activity monitoring and capacity planning.']
  notes varchar [note: 'Free-text field for additional notes, comments, or special instructions related to this Direct address. Used for operational context and troubleshooting.']
  notification_email varchar [note: 'The email address to which operational notifications about this Direct address are sent (e.g., certificate expiration warnings, delivery failures).']
  npi varchar [note: 'The 10-digit National Provider Identifier associated with this Direct address when the address type is provider. Used to link the Direct address to a specific healthcare provider.']
  primary_use_case varchar [note: 'The primary clinical or operational use case for which this Direct address is utilized. Helps categorize messaging patterns and workflows. [ENUM-REF-CANDIDATE: care_coordination|referral|lab_results|radiology_results|discharge_summary|continuity_of_care|patient_portal|public_health_reporting — 8 candidates stripped; promote to reference product]']
  signature_algorithm varchar [note: 'The cryptographic algorithm used for digitally signing messages from this Direct address (e.g., RSA-SHA256). Ensures message integrity and non-repudiation.']
  specialty varchar [note: 'The clinical specialty of the provider associated with this Direct address when the address type is provider (e.g., Cardiology, Family Medicine, Radiology).']
  trust_bundle_membership_status varchar [note: 'Current status of this Direct address membership in the trust bundle. Active membership is required for trusted message exchange.']
  trust_bundle_name varchar [note: 'The name of the trust bundle or trust anchor bundle that this Direct address belongs to. Trust bundles define the set of trusted Certificate Authorities for secure message exchange.']
  vibe_mutation_marker varchar

  Note: 'Master record for all Direct Secure Messaging addresses managed by or registered with the organization, including provider Direct addresses, facility Direct addresses, and patient Direct addresses. Captures Direct address (FQDN format), address type (provider/facility/patient), associated NPI or facility ID, certificate status, certificate expiration date, HISP (Health Information Service Provider) name, trust bundle membership, and activation status. SSOT for Direct address inventory.'
}

Table interoperability.interface_sla {
  interface_sla_id varchar [pk, note: 'Unique identifier for the interface SLA record. Primary key.']
  interface_channel_id varchar [note: 'Reference to the interface channel or connection to which this SLA applies. Links to the specific HL7v2, FHIR, or CDA interface channel being monitored.']
  superseded_interface_sla_id varchar [note: 'Self-referencing FK on interface_sla (superseded_interface_sla_id)']
  trading_partner_id varchar [note: 'Reference to the trading partner or Health Information Exchange (HIE) participant associated with this SLA. Identifies the external organization with whom the SLA is established.']
  alert_threshold_percent decimal(5,2) [note: 'Percentage threshold at which proactive alerts are triggered before an SLA breach occurs. Enables early warning and intervention.']
  auto_escalation_enabled_flag boolean [note: 'Indicates whether automatic escalation is enabled when SLA thresholds are breached. True if auto-escalation is active, False if manual escalation is required.']
  business_criticality varchar [note: 'Business criticality classification of the interface and its associated SLA. Determines priority for monitoring, response, and resource allocation.']
  compliance_framework varchar [note: 'Regulatory or industry compliance framework that this SLA supports. May reference HIPAA, HITRUST, HL7 standards, or other healthcare interoperability requirements.']
  contract_reference varchar [note: 'Reference to the master service contract or data sharing agreement that governs this SLA. Links SLA to legal or business agreements.']
  created_timestamp timestamp [note: 'Timestamp when this SLA record was first created in the system. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  effective_end_date date [note: 'Date when this SLA expires or is no longer enforced. Null if the SLA is open-ended or perpetual.']
  effective_start_date date [note: 'Date when this SLA becomes effective and monitoring begins. SLA targets are enforced starting from this date.']
  escalation_contact_email varchar [note: 'Email address of the escalation contact person for SLA breaches.']
  escalation_contact_name varchar [note: 'Name of the escalation contact person for SLA breaches. Secondary contact when primary contact is unavailable or issue requires escalation.']
  escalation_contact_phone varchar [note: 'Phone number of the escalation contact person for SLA breaches.']
  escalation_path varchar [note: 'Defined escalation path or procedure to follow when SLA thresholds are breached. May reference teams, roles, or contact procedures.']
  last_review_date date [note: 'Date when this SLA was last reviewed and validated by stakeholders. Used for tracking periodic SLA review cycles.']
  max_error_rate_percent decimal(5,2) [note: 'Maximum acceptable error rate as a percentage of total messages processed. Error rates exceeding this threshold trigger SLA breach alerts.']
  max_latency_ms varchar [note: 'Maximum acceptable message processing latency in milliseconds. Messages exceeding this threshold are considered SLA violations.']
  measurement_window_hours varchar [note: 'Time window in hours over which SLA metrics are measured and evaluated. Defines the rolling period for performance assessment.']
  message_throughput_target decimal(12,2) [note: 'Target number of messages per hour that the interface channel must process to meet SLA requirements. Measured in messages per hour.']
  modified_by varchar [note: 'Username or identifier of the person who last modified this SLA record. Used for audit and change tracking.']
  modified_timestamp timestamp [note: 'Timestamp when this SLA record was last modified. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for tracking changes and audit trails.']
  monitoring_enabled_flag boolean [note: 'Indicates whether active monitoring and alerting is enabled for this SLA. True if monitoring is active, False if disabled.']
  next_review_date date [note: 'Date when this SLA is scheduled for next review. Ensures periodic validation and updates to SLA terms.']
  notes varchar [note: 'Additional notes, comments, or context about this SLA. Free-text field for operational or business information.']
  notification_email_list varchar [note: 'Comma-separated list of email addresses to notify when SLA thresholds are breached or alerts are triggered.']
  penalty_clause varchar [note: 'Description of financial or operational penalties that apply when SLA targets are not met. May reference contract terms or service credits.']
  primary_contact_email varchar [note: 'Email address of the primary contact person responsible for this SLA.']
  primary_contact_name varchar [note: 'Name of the primary contact person responsible for this SLA. First point of contact for SLA-related issues.']
  primary_contact_phone varchar [note: 'Phone number of the primary contact person responsible for this SLA.']
  reporting_frequency varchar [note: 'Frequency at which SLA performance reports are generated and distributed to stakeholders.']
  sla_code varchar [note: 'Unique business code or identifier for the SLA. Used for operational tracking and cross-system reference.']
  sla_name varchar [note: 'Business-friendly name or title of the SLA. Used for identification and reporting purposes.']
  sla_status varchar [note: 'Current operational status of the SLA. Indicates whether the SLA is actively enforced, temporarily suspended, or in draft state.']
  sla_type varchar [note: 'Classification of the SLA based on the primary performance metric being measured. Determines the focus area for monitoring and alerting.']
  throughput_unit varchar [note: 'Unit of measure for the message throughput target. Defines the time granularity for throughput measurement.']
  uptime_target_percent decimal(5,2) [note: 'Target uptime percentage for the interface channel or connection. Represents the minimum percentage of time the interface must be operational.']
  version varchar [note: 'Version number or identifier for this SLA definition. Tracks changes and revisions to SLA terms over time.']
  vibe_mutation_marker varchar
  created_by varchar [note: 'Username or identifier of the person who created this SLA record. Used for audit and accountability purposes.']

  Note: 'Master record defining Service Level Agreement (SLA) targets for each interface channel or trading partner connection. Captures SLA name, associated channel or partner, message throughput target (messages/hour), maximum acceptable latency (ms), maximum error rate threshold (%), uptime target (%), alerting thresholds, escalation path, measurement window, and effective date. Enables proactive interface performance management and SLA breach alerting.'
}

Table interoperability.interface_downtime {
  interface_downtime_id varchar [pk, note: 'Unique identifier for the interface downtime event record.']
  fhir_endpoint_id varchar [note: 'Foreign key linking to interoperability.fhir_endpoint. Business justification: FHIR endpoints can experience downtime separately from HL7 interface channels. Adding fhir_endpoint_id FK enables tracking API-specific outages, monitoring FHIR endpoint SLAs, and analyzing downtime p']
  interface_channel_id varchar [note: 'Reference to the interface channel affected by this downtime event.']
  interface_engine_id varchar [note: 'Reference to the interface engine hosting the affected channel.']
  parent_interface_downtime_id varchar [note: 'Self-referencing FK on interface_downtime (related_interface_downtime_id)']
  primary_interface_employee_id varchar [note: 'Reference to the user or system account that first detected and reported the downtime event.']
  trading_partner_id varchar [note: 'Reference to the trading partner connection affected by this downtime event, if applicable.']
  actual_uptime_percentage decimal(5,2) [note: 'The actual uptime percentage achieved during the measurement period, accounting for this downtime event.']
  affected_channels_count varchar [note: 'Number of interface channels affected by this downtime event.']
  affected_departments varchar [note: 'Comma-separated list of clinical or operational departments impacted by this interface downtime event.']
  affected_facilities varchar [note: 'Comma-separated list of facility names or identifiers impacted by this interface downtime event.']
  affected_message_types varchar [note: 'Comma-separated list of HL7 message types (e.g., ADT, ORM, ORU) or FHIR resource types affected during the downtime period.']
  business_impact_description varchar [note: 'Narrative description of the business and clinical impact caused by this downtime event, including affected workflows and patient care implications.']
  change_request_reference varchar [note: 'Reference number or identifier of the change request that triggered this downtime, if applicable for planned maintenance.']
  created_timestamp timestamp [note: 'Date and time when this downtime event record was first created in the system.']
  detection_method varchar [note: 'Method by which the downtime event was initially detected.']
  downtime_duration_minutes decimal(10,2) [note: 'Total duration of the downtime event measured in minutes, calculated from start to end timestamp.']
  downtime_end_timestamp timestamp [note: 'The precise date and time when the interface downtime event ended and service was restored. Null if downtime is still active.']
  downtime_event_number varchar [note: 'Business identifier for the downtime event, used for tracking and reporting purposes.']
  downtime_start_timestamp timestamp [note: 'The precise date and time when the interface downtime event began, marking the start of service interruption.']
  downtime_status varchar [note: 'Current lifecycle status of the downtime event indicating whether it is active, resolved, under investigation, recovering, or closed.']
  downtime_type varchar [note: 'Classification of the downtime event indicating whether it was planned maintenance, unplanned outage, trading partner outage, emergency maintenance, scheduled upgrade, or network failure.']
  escalation_flag boolean [note: 'Indicates whether this downtime event was escalated to higher-level support or management.']
  escalation_level varchar [note: 'The support tier or level to which the downtime event was escalated.']
  escalation_timestamp timestamp [note: 'Date and time when the downtime event was escalated to higher-level support or management.']
  impact_severity varchar [note: 'Business impact severity level of the downtime event, indicating the criticality of the service interruption on clinical and operational workflows.']
  incident_ticket_reference varchar [note: 'Reference number or identifier of the IT service management incident ticket associated with this downtime event.']
  messages_lost_count varchar [note: 'Total number of interface messages permanently lost or unrecoverable due to the downtime event.']
  messages_queued_count varchar [note: 'Total number of interface messages queued or held during the downtime period awaiting transmission or processing.']
  messages_replayed_count varchar [note: 'Total number of interface messages successfully replayed or reprocessed after service recovery.']
  notes varchar [note: 'Additional free-text notes and observations related to the downtime event.']
  notification_sent_flag boolean [note: 'Indicates whether stakeholder notifications were sent regarding this downtime event.']
  notification_timestamp timestamp [note: 'Date and time when stakeholder notifications were sent for this downtime event.']
  post_incident_review_completed_flag boolean [note: 'Indicates whether a post-incident review was conducted to analyze lessons learned and prevent recurrence.']
  post_incident_review_date date [note: 'Date when the post-incident review meeting was conducted.']
  preventive_actions varchar [note: 'Description of preventive actions identified and planned to prevent recurrence of similar downtime events.']
  problem_ticket_reference varchar [note: 'Reference number or identifier of the IT service management problem ticket if root cause analysis was escalated.']
  resolution_notes varchar [note: 'Detailed notes documenting the resolution steps taken to restore service and recover from the downtime event.']
  resolution_timestamp timestamp [note: 'Date and time when the downtime event was resolved and service restoration was confirmed.']
  root_cause_category varchar [note: 'High-level classification of the root cause that triggered the downtime event.']
  root_cause_description varchar [note: 'Detailed narrative description of the root cause analysis findings explaining why the downtime occurred.']
  sla_breach_flag boolean [note: 'Indicates whether this downtime event resulted in a breach of the interface availability Service Level Agreement.']
  sla_target_uptime_percentage decimal(5,2) [note: 'The contractual target uptime percentage defined in the SLA for the affected interface channel.']
  updated_timestamp timestamp [note: 'Date and time when this downtime event record was last modified.']
  vibe_mutation_marker varchar
  workaround_description varchar [note: 'Description of the temporary workaround implemented to maintain business continuity during the downtime event.']
  workaround_implemented_flag boolean [note: 'Indicates whether a temporary workaround was implemented to mitigate the impact while permanent resolution was in progress.']

  Note: 'Transactional record of every planned and unplanned interface downtime event affecting interface channels or trading partner connections. Captures downtime start timestamp, downtime end timestamp, downtime type (planned maintenance/unplanned outage/trading partner outage), affected channels, root cause, impact severity, messages queued during downtime, messages replayed after recovery, and incident ticket reference. Supports SLA reporting, root cause analysis, and operational resilience tracking.'
}

Table interoperability.terminology_mapping {
  terminology_mapping_id varchar [pk, note: 'Unique identifier for the terminology mapping record. Primary key.']
  primary_superseded_by_terminology_mapping_id varchar [note: 'Reference to the newer mapping that replaces this one when a mapping is deprecated or retired.']
  source_code_cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Interface engines map CPT procedure codes between EHR and billing systems or trading partners. Real-world scenario: translating local procedure codes to standard CPT for claims transmission via 837 tr']
  source_code_hcpcs_code_id varchar [note: 'Foreign key linking to reference.hcpcs_code. Business justification: DME and supply interfaces map local codes to HCPCS for claims submission. Real-world: translating internal supply codes to HCPCS Level II for Medicare/Medicaid billing via 837 transactions.']
  source_code_icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Interface engines map ICD diagnosis codes between internal and trading partner systems. Real-world interoperability requires translating ICD-9 to ICD-10, or local codes to standard ICD for HIE queries']
  source_code_loinc_code_id varchar [note: 'Foreign key linking to reference.loinc_code. Business justification: Lab interfaces map local test codes to LOINC for interoperability. Real-world: ORU result messages translate internal lab codes to standard LOINC for HIE sharing and public health reporting.']
  source_code_ndc_drug_id varchar [note: 'Foreign key linking to reference.ndc_drug. Business justification: Pharmacy interfaces map medication codes to NDC for e-prescribing and medication reconciliation. Real-world: NCPDP SCRIPT messages and FHIR MedicationRequest resources require NDC code mapping.']
  source_code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: Terminology mappings must reference specific versions of code sets (ICD-10, SNOMED, LOINC) to ensure mapping accuracy. Links interoperability domain to reference data domain, enabling version-controll']
  source_code_snomed_concept_id varchar [note: 'Foreign key linking to reference.snomed_concept. Business justification: FHIR interfaces map SNOMED CT concepts for clinical terminology interoperability. Real-world: translating local problem list terms to SNOMED for USCDI-compliant FHIR API exchanges and care quality rep']
  target_exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Terminology mappings target specific exchange standards (e.g., mapping local codes to FHIR ValueSets, HL7v2 tables, or CDA code systems). Currently only target_code_system (STRING) exists. FK to excha']
  tertiary_terminology_modified_by_user_employee_id varchar [note: 'Identifier of the user who most recently modified this mapping record.']
  alternate_target_code_value decimal(18,2) [note: 'An alternative target code value that may also be valid for this mapping, used when multiple valid mappings exist.']
  alternate_target_display_name varchar [note: 'Display name for the alternate target code, providing additional context for secondary mapping options.']
  approval_timestamp timestamp [note: 'Date and time when this mapping was officially approved by the governance process.']
  created_timestamp timestamp [note: 'Date and time when this mapping record was first created in the system.']
  effective_end_date date [note: 'The date after which this terminology mapping is no longer valid and should not be used. Null indicates an open-ended mapping.']
  effective_start_date date [note: 'The date from which this terminology mapping becomes valid and should be used in data transformation and exchange processes.']
  error_count varchar [note: 'Number of errors or exceptions encountered when applying this mapping, used to identify problematic mappings requiring review.']
  governance_approval_status varchar [note: 'Status of governance review and approval for this mapping: pending (awaiting review), approved (validated and authorized for use), rejected (not approved), conditional (approved with restrictions or conditions).']
  last_review_date date [note: 'Date when this mapping was last reviewed by a subject matter expert or governance committee.']
  mapping_code varchar [note: 'Unique business code or identifier for this mapping, used for external reference and integration.']
  mapping_confidence_score decimal(5,2) [note: 'Numeric confidence score (0.00 to 100.00) representing the certainty or quality of the mapping, often derived from automated mapping tools or expert review.']
  mapping_method varchar [note: 'The method by which this mapping was created: manual (human expert), automated (algorithm or tool), hybrid (combination of automated and manual review), vendor_supplied (provided by EHR or terminology vendor).']
  mapping_name varchar [note: 'Human-readable name or title for this terminology mapping, used for identification and reference in governance workflows.']
  mapping_priority varchar [note: 'Business priority level for this mapping, indicating urgency or importance for clinical, billing, or regulatory use cases.']
  mapping_rationale varchar [note: 'Detailed explanation or justification for why this particular mapping was chosen, especially for inexact or complex mappings.']
  mapping_relationship_type varchar [note: 'The semantic relationship between the source and target codes: equivalent (exact match), wider/subsumes (target is broader), narrower/specializes (target is more specific), inexact (approximate match), unmatched (no suitable target), disjoint (concepts do not overlap), relatedto (related but not hierarchical). [ENUM-REF-CANDIDATE: equivalent|equal|wider|subsumes|narrower|specializes|inexact|unmatched|disjoint|relatedto — 10 candidates stripped; promote to reference product]']
  mapping_status varchar [note: 'Current lifecycle status of the mapping: draft (in development), active (approved and in use), retired (no longer valid), deprecated (superseded by newer mapping), under_review (pending governance approval).']
  mapping_tool_name varchar [note: 'Name of the software tool or platform used to create or validate this mapping (e.g., UMLS Metathesaurus, Apelon DTS, proprietary mapping engine).']
  modified_timestamp timestamp [note: 'Date and time when this mapping record was last modified or updated.']
  next_review_date date [note: 'Scheduled date for the next periodic review of this mapping to ensure continued accuracy and relevance.']
  notes varchar [note: 'Free-text notes or comments about this mapping, including special handling instructions, known limitations, or historical context.']
  source_code_system varchar [note: 'The code system or terminology from which the source code originates (e.g., local facility codes, proprietary system codes, legacy identifiers).']
  source_code_system_version varchar [note: 'Version of the source code system, ensuring mapping accuracy when source terminologies evolve over time.']
  source_context varchar [note: 'Additional contextual information about where or how the source code is used in the source system (e.g., specific module, workflow, or clinical domain).']
  target_code_system varchar [note: 'The standard terminology or code system to which the source code is being mapped (e.g., SNOMED CT, LOINC, RxNorm, ICD-10, CPT, CVX).']
  target_code_system_version varchar [note: 'Version of the target standard terminology, critical for maintaining mapping accuracy as standards evolve.']
  target_code_value decimal(18,2) [note: 'The actual code value in the target standard terminology that the source code maps to.']
  target_context varchar [note: 'Additional contextual information about the appropriate use of the target code in the target terminology or receiving system.']
  target_display_name varchar [note: 'Human-readable display name or description of the target code as defined in the standard terminology.']
  usage_count varchar [note: 'Number of times this mapping has been applied in data transformation or exchange processes, indicating mapping utilization and importance.']
  use_case_category varchar [note: 'The primary business or clinical use case for which this mapping is intended (e.g., clinical documentation, laboratory results, radiology reports, pharmacy orders, billing and coding, quality reporting, research data, HIE exchange, public health reporting). [ENUM-REF-CANDIDATE: clinical_documentation|laboratory|radiology|pharmacy|billing|quality_reporting|research|hie_exchange|public_health — 9 candidates stripped; promote to reference product]']
  validation_status varchar [note: 'Status of technical and semantic validation for this mapping: validated (passed all checks), unvalidated (not yet tested), failed_validation (errors detected), pending_validation (queued for review).']
  validation_timestamp timestamp [note: 'Date and time when this mapping was last validated or tested for accuracy and completeness.']
  vibe_mutation_marker varchar

  Note: 'Master record for enterprise terminology translation mappings between local codes and standard terminologies (SNOMED CT, LOINC, RxNorm, ICD-10, CPT, CVX). Captures source code system, source code value, source display name, target code system, target code value, target display name, mapping relationship type (equivalent/broader/narrower/related), mapping confidence, effective date, expiration date, and governance approval status. Distinct from data_mapping (field-level) — this is value-level code translation.'
}

Table interoperability.subscription_topic {
  subscription_topic_id varchar [pk, note: 'Unique identifier for the subscription topic record. Primary key.']
  exchange_standard_id varchar [note: 'Reference to the data exchange standard governing the format and structure of notifications for this subscription.']
  interface_engine_id varchar [note: 'Reference to the interface engine responsible for processing and delivering notifications for this subscription topic.']
  superseded_subscription_topic_id varchar [note: 'Self-referencing FK on subscription_topic (superseded_subscription_topic_id)']
  trading_partner_id varchar [note: 'Reference to the trading partner organization subscribing to this topic.']
  audit_logging_enabled_flag boolean [note: 'Indicates whether all notification events for this subscription are logged for compliance and audit purposes.']
  authentication_credential varchar [note: 'Encrypted or tokenized authentication credential (API key, token reference, certificate thumbprint) used to authenticate with the subscriber endpoint. Stored securely.']
  authentication_method varchar [note: 'The authentication mechanism required for the subscriber endpoint to accept notifications.']
  created_timestamp timestamp [note: 'Timestamp when this subscription topic record was first created in the system.']
  data_sharing_agreement_reference varchar [note: 'Reference identifier to the legal data sharing agreement or business associate agreement governing this subscription.']
  effective_end_date date [note: 'Date when this subscription topic expires or is scheduled for deactivation. Null indicates no planned end date.']
  effective_start_date date [note: 'Date when this subscription topic becomes active and begins processing events.']
  encryption_required_flag boolean [note: 'Indicates whether notification payloads must be encrypted in transit and at rest.']
  event_batch_size varchar [note: 'Number of events to batch together in a single notification delivery. 1 indicates individual event notifications.']
  event_batch_window_seconds varchar [note: 'Time window in seconds to collect events before sending a batched notification.']
  fhir_filter_criteria varchar [note: 'FHIR search parameters or filter expressions used to narrow the scope of events that trigger notifications (e.g., \'Observation?code=http://loinc.org|2339-0&status=final\').']
  fhir_resource_type varchar [note: 'The FHIR resource type being monitored for this subscription (e.g., \'Patient\', \'Observation\', \'Encounter\', \'DiagnosticReport\'). Null for non-FHIR subscriptions.']
  hl7v2_message_type varchar [note: 'The HL7 v2.x message type and trigger event for this subscription (e.g., \'ADT^A01\', \'ORU^R01\', \'SIU^S12\'). Null for non-HL7v2 subscriptions.']
  last_error_message varchar [note: 'Most recent error message or exception details from a failed notification delivery attempt.']
  last_error_timestamp timestamp [note: 'Timestamp of the most recent notification delivery failure for this subscription topic.']
  last_notification_timestamp timestamp [note: 'Timestamp of the most recent successful notification delivery for this subscription topic.']
  max_retry_attempts varchar [note: 'Maximum number of retry attempts for failed notification deliveries before marking as permanently failed.']
  notes varchar [note: 'Free-text notes for additional context, configuration details, or operational instructions related to this subscription topic.']
  notification_channel_type varchar [note: 'The communication channel or protocol used to deliver subscription notifications to the subscriber.']
  notification_count_total varchar [note: 'Cumulative count of all notifications sent for this subscription topic since activation.']
  notification_failure_count varchar [note: 'Cumulative count of failed notification delivery attempts for this subscription topic.']
  patient_consent_required_flag boolean [note: 'Indicates whether individual patient consent is required before sending notifications for this subscription topic.']
  payload_content_type varchar [note: 'Specifies what data is included in the notification payload: full FHIR resource, resource ID only, empty notification, or custom format.']
  payload_mime_type varchar [note: 'The MIME type of the notification payload (e.g., \'application/fhir+json\', \'application/hl7-v2\', \'application/xml\').']
  phi_included_flag boolean [note: 'Indicates whether the notification payload contains Protected Health Information subject to HIPAA regulations.']
  priority_level varchar [note: 'Business priority of this subscription topic, used for resource allocation and queue management during high-volume periods.']
  retry_interval_seconds varchar [note: 'Time interval in seconds between retry attempts for failed notifications.']
  retry_policy varchar [note: 'The retry strategy applied when notification delivery fails.']
  subscriber_contact_email varchar [note: 'Email address of the primary contact for subscription-related communications and issue resolution.']
  subscriber_contact_name varchar [note: 'Name of the primary technical or operational contact for the subscribing organization.']
  subscriber_contact_phone varchar [note: 'Phone number of the primary contact for urgent subscription issues or outage notifications.']
  subscriber_endpoint_url varchar [note: 'The target URL or endpoint address where notifications are sent (e.g., REST endpoint, websocket URL, MLLP host:port).']
  subscriber_organization_name varchar [note: 'Name of the external organization or system subscribing to this topic.']
  subscription_status varchar [note: 'Current operational status of the subscription topic indicating whether it is actively processing events.']
  timeout_seconds varchar [note: 'Maximum time in seconds to wait for a response from the subscriber endpoint before considering the notification delivery failed.']
  topic_code varchar [note: 'Unique business code identifying the subscription topic, used for external system references and configuration management.']
  topic_name varchar [note: 'Human-readable name of the subscription topic (e.g., \'ADT Notifications\', \'Lab Result Availability\', \'Care Gap Alerts\').']
  topic_type varchar [note: 'Classification of the subscription topic based on the underlying standard or use case.']
  trigger_event_type varchar [note: 'The specific clinical or administrative event type that triggers this subscription (e.g., \'ADT^A01\', \'Observation.create\', \'Encounter.discharge\').']
  updated_timestamp timestamp [note: 'Timestamp when this subscription topic record was last modified.']
  vibe_mutation_marker varchar

  Note: 'Master record for FHIR Subscription topics and HL7v2 event subscriptions configured to push notifications to external systems when specific clinical events occur (e.g., ADT notifications, lab result availability, care gap alerts). Captures topic name, trigger event type, FHIR resource filter criteria, notification channel type (REST-hook/websocket/email/FHIR messaging), subscriber endpoint, payload type (full-resource/id-only/empty), and subscription status. Supports event-driven interoperability and care coordination notifications.'
}

Table interoperability.subscription_notification {
  subscription_notification_id varchar [pk, note: 'Unique identifier for the subscription notification event record. Primary key.']
  care_site_id varchar [note: 'Reference to the healthcare facility or organization where the triggering event originated. Identifies the source system or location that generated the event data.']
  financial_entity_id varchar [note: 'Reference to the organization or trading partner that is the recipient of this notification. Links to the external entity consuming the event data.']
  interface_channel_id varchar [note: 'Reference to the specific interface channel or connection configuration used to deliver this notification. Links to the technical routing and transport configuration.']
  interface_engine_id varchar [note: 'Reference to the interface engine or integration platform that processed and dispatched this notification. Links to the technical infrastructure component responsible for delivery.']
  mpi_record_id varchar [note: 'Foreign key linking to patient.mpi_record. Business justification: Event-driven notifications (ADT, lab results, imaging) are patient-specific and require authoritative identity for routing to subscribers. Delivery confirmation and audit trails depend on patient link']
  retried_subscription_notification_id varchar [note: 'Self-referencing FK on subscription_notification (retried_subscription_notification_id)']
  scheduling_appointment_id varchar [note: 'Foreign key linking to scheduling.scheduling_appointment. Business justification: Real-time appointment notifications via FHIR subscriptions (Appointment resource updates). Modern interoperability pattern: external systems subscribe to appointment events (booked, cancelled, resched']
  subscription_topic_id varchar [note: 'Reference to the FHIR Subscription or HL7 event subscription definition that triggered this notification. Links to the subscription configuration that defines the topic, criteria, and endpoint.']
  visit_id varchar [note: 'Reference to the clinical encounter associated with the triggering event, if applicable. Null for non-encounter events. Links the notification to the specific episode of care.']
  acknowledgment_received_flag boolean [note: 'Indicates whether a positive acknowledgment (ACK) was received from the subscriber endpoint. True if ACK received; false if NACK or no response. Used to distinguish between delivery success and failure.']
  acknowledgment_timestamp timestamp [note: 'The date and time when the acknowledgment was received from the subscriber endpoint. Null if no acknowledgment received. Used to calculate delivery latency and SLA compliance.']
  business_impact_description varchar [note: 'Free-text description of the business impact if this notification failed to deliver (e.g., delayed care coordination, missed clinical alert, billing delay). Used for prioritizing remediation efforts.']
  created_timestamp timestamp [note: 'The date and time when this notification record was first created in the system. Used for audit trail and data lineage tracking.']
  delivery_latency_milliseconds varchar [note: 'The elapsed time in milliseconds between notification dispatch and acknowledgment receipt. Null if acknowledgment not received. Used for performance monitoring and SLA tracking.']
  delivery_status varchar [note: 'Current lifecycle status of the notification delivery. Sent indicates dispatched; delivered indicates acknowledgment received; failed indicates delivery error; retrying indicates automatic retry in progress; abandoned indicates retry limit exceeded.']
  encryption_enabled_flag boolean [note: 'Indicates whether the notification was transmitted using encryption (e.g., TLS, HTTPS). True if encrypted; false if transmitted in clear text. Used for security compliance auditing.']
  error_code varchar [note: 'The error code returned by the subscriber endpoint or notification engine if delivery failed. Null if delivery succeeded. Used for troubleshooting and categorizing failure types.']
  error_message varchar [note: 'The detailed error message or description returned if delivery failed. Null if delivery succeeded. Provides human-readable context for troubleshooting failed notifications.']
  failure_reason_category varchar [note: 'High-level categorization of the failure reason if delivery failed. Null if delivery succeeded. Used for root cause analysis and identifying systemic issues. [ENUM-REF-CANDIDATE: network_error|authentication_failure|authorization_failure|endpoint_unavailable|timeout|invalid_payload|subscriber_error|configuration_error — 8 candidates stripped; promote to reference product]']
  http_response_code varchar [note: 'The HTTP status code returned by the subscriber endpoint (e.g., 200 for success, 404 for not found, 500 for server error). Null if transport protocol is not HTTP-based.']
  max_retry_count varchar [note: 'The maximum number of retry attempts configured for this subscription before the notification is abandoned. Defines the retry policy threshold.']
  modified_timestamp timestamp [note: 'The date and time when this notification record was last updated (e.g., status change, retry attempt). Used for audit trail and tracking notification lifecycle changes.']
  next_retry_timestamp timestamp [note: 'The scheduled date and time for the next delivery retry attempt. Null if delivery succeeded or retry limit reached. Used by the notification engine to schedule retry jobs.']
  notes varchar [note: 'Free-text field for additional context, troubleshooting notes, or operational comments related to this notification. Used for documenting manual interventions or special circumstances.']
  notification_sent_flag boolean [note: 'Indicates whether an alert or notification was sent to support staff regarding this delivery event (e.g., for failures or SLA breaches). True if alert sent; false otherwise. Used for operational monitoring.']
  notification_timestamp timestamp [note: 'The exact date and time when the notification was dispatched to the subscriber endpoint. Represents the principal business event time for this transaction.']
  patient_mrn varchar [note: 'The Medical Record Number of the patient associated with the triggering event, if applicable. Null for non-patient events. Used for patient-centric notification tracking and audit trails. Protected Health Information (PHI) under HIPAA.']
  payload_content_type varchar [note: 'The MIME type or format of the notification payload (e.g., application/fhir+json, application/hl7-v2, empty for id-only notifications). Defines how the subscriber should parse the notification body.']
  payload_reference varchar [note: 'Reference to the stored notification payload (e.g., object storage key, message queue ID, archive location). Enables retrieval of the full notification body for audit or replay purposes. Null if payload is not persisted.']
  payload_size_bytes varchar [note: 'The size of the notification payload in bytes. Used for capacity planning, bandwidth monitoring, and identifying oversized notifications that may cause delivery issues.']
  phi_transmitted_flag boolean [note: 'Indicates whether the notification payload contained Protected Health Information (PHI) as defined by HIPAA. True if PHI was included; false if only identifiers or metadata were sent. Used for compliance auditing and security monitoring.']
  priority varchar [note: 'The priority level assigned to this notification, determining delivery urgency and retry behavior. STAT indicates immediate delivery required; urgent indicates expedited delivery; routine indicates standard delivery.']
  retry_count varchar [note: 'The number of delivery retry attempts made for this notification. Zero indicates first attempt; increments with each retry. Used to track delivery reliability and identify problematic endpoints.']
  sla_breach_flag boolean [note: 'Indicates whether the notification delivery exceeded the SLA target delivery time. True if SLA was breached; false if delivered within SLA. Used for performance reporting and partner accountability.']
  sla_target_delivery_seconds varchar [note: 'The target delivery time in seconds defined by the Service Level Agreement (SLA) for this subscription. Used to measure whether the notification met the agreed-upon delivery performance standard.']
  subscriber_endpoint_url varchar [note: 'The target URL or endpoint address where the notification was sent. May be a REST endpoint, message queue, webhook, or Direct address. Business-confidential as it reveals system integration architecture.']
  subscription_topic varchar [note: 'The canonical URL or topic identifier that defines the event type being monitored (e.g., Patient admission, Lab result available, Medication order). Represents the business event category that triggered the notification.']
  triggering_event_type varchar [note: 'The specific event action that triggered the notification (e.g., create, update, delete, admit, discharge, transfer). Represents the CRUD or clinical workflow event that caused the subscription to fire. [ENUM-REF-CANDIDATE: create|update|delete|admit|discharge|transfer|result_available|order_placed|status_change — 9 candidates stripped; promote to reference product]']
  triggering_resource_identifier varchar [note: 'The unique identifier of the specific resource instance that triggered the notification (e.g., Patient/12345, Observation/67890). Enables tracing back to the exact clinical or administrative record that caused the event.']
  triggering_resource_type varchar [note: 'The FHIR resource type or HL7 message type that triggered the notification (e.g., Patient, Observation, MedicationRequest, ADT^A01). Identifies the clinical or administrative data entity involved in the event.']
  vibe_mutation_marker varchar

  Note: 'Transactional record of every event-driven notification dispatched to a subscriber endpoint via FHIR Subscription or HL7 event notification. Captures notification timestamp, subscription topic reference, triggering event type, triggering resource ID, subscriber endpoint, delivery status (sent/delivered/failed/retrying), HTTP response code, retry count, and payload reference. Enables monitoring of event-driven interoperability workflows and subscriber delivery reliability.'
}

Table interoperability.onboarding_project {
  onboarding_project_id varchar [pk, note: 'Unique identifier for the interface or trading partner onboarding project. Primary key for the onboarding project record.']
  exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Each onboarding project implements a specific exchange standard (HL7v2, FHIR, CDA). Link to exchange_standard enables tracking project scope, managing standard-specific requirements, and analyzing onb']
  interface_engine_id varchar [note: 'Reference to the interface engine or integration platform where this interface will be deployed and managed.']
  org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: Onboarding projects establish interfaces with provider organizations. Linking to org_provider enables tracking which healthcare entities have active data exchange, supports payer credentialing validat']
  predecessor_onboarding_project_id varchar [note: 'Self-referencing FK on onboarding_project (predecessor_onboarding_project_id)']
  trading_partner_id varchar [note: 'Reference to the trading partner or external organization being onboarded for data exchange. Links to the trading partner master record.']
  actual_cost decimal(15,2) [note: 'Actual total cost incurred for this onboarding project to date or upon completion.']
  actual_go_live_date date [note: 'Actual date when the interface was successfully deployed to production and began live data exchange.']
  budget_amount decimal(15,2) [note: 'Total budget allocated for this onboarding project, including labor, software, and external vendor costs.']
  build_completion_date date [note: 'Date when the interface development and configuration was completed and ready for testing.']
  business_owner_name varchar [note: 'Full name of the business stakeholder or department owner sponsoring this onboarding project.']
  certification_date date [note: 'Date when certification or accreditation was successfully obtained for this interface.']
  certification_required_flag boolean [note: 'Indicates whether formal certification (ONC, DirectTrust, Carequality, CommonWell, etc.) is required for this interface onboarding.']
  certification_status varchar [note: 'Current status of the certification or accreditation process for this interface onboarding project.']
  certification_type varchar [note: 'Type of certification or accreditation required for this interface, such as ONC Health IT Certification, DirectTrust accreditation, or Carequality connection.']
  created_timestamp timestamp [note: 'Timestamp when this onboarding project record was first created in the system.']
  data_sharing_agreement_date date [note: 'Date when the data sharing agreement or business associate agreement was signed and became effective.']
  data_sharing_agreement_signed_flag boolean [note: 'Indicates whether a data sharing agreement or business associate agreement has been executed with the trading partner.']
  design_completion_date date [note: 'Date when the interface design, including mapping specifications and technical architecture, was completed and approved.']
  discovery_completion_date date [note: 'Date when the discovery phase was completed and requirements were finalized.']
  discovery_start_date date [note: 'Date when the discovery phase began, including requirements gathering and technical assessment activities.']
  estimated_message_volume_monthly varchar [note: 'Estimated number of messages or transactions expected to be exchanged per month once the interface is live.']
  integration_testing_completion_date date [note: 'Date when integration testing was successfully completed and the interface was validated for production readiness.']
  integration_testing_start_date date [note: 'Date when end-to-end integration testing with the trading partner began.']
  interface_type varchar [note: 'The type or standard of interface being onboarded, such as HL7v2, FHIR, CDA, Direct messaging, X12 EDI, NCPDP, or custom integration. [ENUM-REF-CANDIDATE: HL7v2|FHIR|CDA|Direct|X12|NCPDP|Custom — 7 candidates stripped; promote to reference product]']
  lessons_learned varchar [note: 'Documentation of key lessons learned, best practices, and improvement opportunities identified during the onboarding project.']
  message_type varchar [note: 'Specific message types or transaction sets being implemented in this onboarding project (e.g., ADT, ORU, SIU for HL7v2; Patient, Observation for FHIR).']
  mitigation_plan varchar [note: 'Description of risk mitigation strategies and contingency plans for addressing identified project risks.']
  notes varchar [note: 'Additional notes, comments, or context relevant to this onboarding project for reference and documentation purposes.']
  priority varchar [note: 'Business priority level assigned to this onboarding project, determining resource allocation and scheduling precedence.']
  project_closure_date date [note: 'Date when the onboarding project was formally closed after successful go-live and post-live stabilization.']
  project_code varchar [note: 'Short alphanumeric code or identifier used to reference this onboarding project in communications and documentation.']
  project_initiation_date date [note: 'Date when the onboarding project was formally initiated and approved to proceed.']
  project_name varchar [note: 'Business name or title assigned to this onboarding project for identification and tracking purposes.']
  project_phase varchar [note: 'Current phase or stage of the onboarding project lifecycle, tracking progress from initial discovery through post-live support. [ENUM-REF-CANDIDATE: discovery|design|build|testing|go_live|post_live|on_hold|cancelled — 8 candidates stripped; promote to reference product]']
  project_status varchar [note: 'Overall status of the onboarding project indicating whether it is actively progressing, completed, paused, or terminated.']
  risk_description varchar [note: 'Description of key risks, challenges, or concerns identified for this onboarding project.']
  risk_level varchar [note: 'Overall risk assessment for this onboarding project based on complexity, dependencies, and potential impact.']
  target_go_live_date date [note: 'Planned or target date for the interface to go live and begin production data exchange.']
  technical_lead_email varchar [note: 'Email address of the technical lead for technical coordination and issue resolution.']
  technical_lead_name varchar [note: 'Full name of the technical lead or integration engineer responsible for the technical implementation of the interface.']
  uat_completion_date date [note: 'Date when user acceptance testing was completed and business sign-off was obtained.']
  uat_start_date date [note: 'Date when user acceptance testing by business stakeholders and end users began.']
  unit_testing_completion_date date [note: 'Date when unit testing was successfully completed with all test cases passed.']
  unit_testing_start_date date [note: 'Date when unit testing of individual interface components began.']
  updated_timestamp timestamp [note: 'Timestamp when this onboarding project record was last modified or updated.']
  vibe_mutation_marker varchar

  Note: 'Master record for every trading partner or interface onboarding project managed by the interoperability team. Captures project name, trading partner reference, interface type being onboarded, project phase (discovery/design/build/testing/go-live/post-live), project manager, target go-live date, actual go-live date, testing milestone dates, certification requirements (ONC, DirectTrust, Carequality), and project status. Enables portfolio management of the organizations interface onboarding pipeline.'
}

Table interoperability.conformance_test {
  conformance_test_id varchar [pk, note: 'Unique identifier for the conformance test record. Primary key.']
  exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Each conformance test validates compliance with a specific exchange standard and version (HL7v2.5.1, FHIR R4, CDA R2). Link to exchange_standard enables tracking certification status by standard, mana']
  fhir_endpoint_id varchar [note: 'Reference to the FHIR endpoint being tested for conformance. Nullable if test is not FHIR-specific.']
  interface_channel_id varchar [note: 'Reference to the interface channel being tested for conformance and interoperability.']
  onboarding_project_id varchar [note: 'Foreign key linking to interoperability.onboarding_project. Business justification: Conformance tests are conducted as part of trading partner onboarding projects. Currently conformance_test has interface_channel_id, fhir_endpoint_id, and trading_partner_id, but no link to the onboar']
  retest_conformance_test_id varchar [note: 'Self-referencing FK on conformance_test (retest_conformance_test_id)']
  trading_partner_id varchar [note: 'Reference to the trading partner for whom this conformance test was conducted. Nullable if internal testing.']
  approval_timestamp timestamp [note: 'Timestamp when the conformance test results were approved for certification submission or go-live.']
  approved_by varchar [note: 'Name of the individual who approved the conformance test results for certification submission or go-live.']
  certification_submission_reference varchar [note: 'Reference number or identifier for the ONC Health IT Certification submission associated with this conformance test. Nullable if not part of a certification submission.']
  conformance_status varchar [note: 'Overall conformance status determination based on test results. Indicates whether the interface/endpoint meets the required conformance profile.']
  created_timestamp timestamp [note: 'Timestamp when this conformance test record was first created in the system. Audit trail field.']
  critical_failures_count varchar [note: 'Number of critical or blocking failures identified during the conformance test that prevent certification or go-live.']
  failure_summary varchar [note: 'Summary description of the failures encountered during the conformance test, including error codes and affected test cases.']
  fhir_resource_type varchar [note: 'The FHIR resource type being tested for conformance (e.g., Patient, Observation, MedicationRequest, Encounter). Nullable if test is not FHIR-specific.']
  go_live_readiness_status varchar [note: 'Status indicating whether the interface or endpoint is ready for production go-live based on conformance test results.']
  message_event varchar [note: 'The HL7 v2 message event trigger being tested (e.g., A01, A04, O01, R01). Nullable if test is not HL7 v2-specific.']
  message_type varchar [note: 'The HL7 v2 message type being tested (e.g., ADT, ORM, ORU, DFT). Nullable if test is not HL7 v2-specific.']
  notes varchar [note: 'Additional free-text notes or comments about the conformance test execution, results, or context.']
  onc_certification_criteria varchar [note: 'The specific ONC Health IT Certification criteria being tested (e.g., 170.315(g)(10) for Standardized API for Patient and Population Services). Nullable if not ONC certification-related.']
  pass_percentage decimal(5,2) [note: 'Percentage of test cases that passed, calculated as (test_cases_passed / total_test_cases) * 100. Used for conformance scoring.']
  remediation_notes varchar [note: 'Detailed notes on the remediation actions required or taken to address conformance test failures.']
  remediation_required_flag boolean [note: 'Boolean flag indicating whether remediation work is required to address conformance test failures before go-live or certification.']
  retest_required_flag boolean [note: 'Boolean flag indicating whether a retest is required after remediation or configuration changes.']
  retest_scheduled_date date [note: 'The scheduled date for retesting after remediation. Nullable if no retest is scheduled.']
  test_cases_failed varchar [note: 'Number of test cases that failed during this conformance test execution.']
  test_cases_passed varchar [note: 'Number of test cases that passed successfully during this conformance test execution.']
  test_cases_skipped varchar [note: 'Number of test cases that were skipped or not executed during this conformance test run.']
  test_duration_minutes varchar [note: 'Total duration of the conformance test execution in minutes, from start to completion.']
  test_environment varchar [note: 'The environment in which the conformance test was executed (e.g., Development, Test, Staging, Production).']
  test_execution_date date [note: 'The date on which the conformance test was executed. Principal business event timestamp for this transaction.']
  test_execution_timestamp timestamp [note: 'The precise timestamp when the conformance test execution began, including time zone information.']
  test_log_url varchar [note: 'URL or file path to the detailed test execution logs for troubleshooting and audit purposes.']
  test_report_url varchar [note: 'URL or file path to the detailed conformance test report generated by the testing tool.']
  test_result varchar [note: 'Overall pass/fail result of the conformance test execution. Indicates whether the interface or endpoint met conformance requirements.']
  test_scope varchar [note: 'Description of the scope of the conformance test, including message types, FHIR resources, or transaction sets being validated (e.g., ADT^A01, Patient Resource, CDA Document).']
  test_suite_name varchar [note: 'Name of the conformance testing tool or suite used to execute the test (e.g., ONC Certification, Touchstone, Inferno, HL7 Conformance Tester). [ENUM-REF-CANDIDATE: ONC Certification|Touchstone|Inferno|HL7 Conformance Tester|IHE Gazelle|NIST Test Tool|Custom Internal Suite — 7 candidates stripped; promote to reference product]']
  test_suite_version varchar [note: 'Version number of the test suite or testing tool used for this conformance test execution.']
  tester_email varchar [note: 'Email address of the individual or team who executed the conformance test.']
  tester_name varchar [note: 'Name of the individual or team who executed the conformance test.']
  total_test_cases varchar [note: 'Total number of individual test cases executed as part of this conformance test run.']
  transaction_set varchar [note: 'The transaction set or interaction pattern being tested (e.g., IHE PIX Query, IHE PDQ Query, FHIR RESTful API operations). Nullable if not applicable.']
  updated_timestamp timestamp [note: 'Timestamp when this conformance test record was last updated. Audit trail field.']
  vibe_mutation_marker varchar

  Note: 'Transactional record of conformance and interoperability testing activities conducted for interface channels, FHIR endpoints, and trading partner connections. Captures test execution date, test suite used (ONC Certification, Touchstone, Inferno, HL7 Conformance Tester), test scope (message type/FHIR resource/transaction set), pass/fail result, number of test cases executed, number passed, number failed, critical failures, and certification submission reference. Supports ONC Health IT Certification and trading partner go-live readiness.'
}

Table interoperability.promoting_interoperability {
  promoting_interoperability_id varchar [pk, note: 'Unique identifier for the promoting interoperability performance record.']
  care_site_id varchar [note: 'Reference to the specific facility or hospital reporting this PI measure performance.']
  clinician_id varchar [note: 'Reference to the eligible clinician or provider reporting this PI measure performance.']
  employee_id varchar [note: 'Reference to the user who last updated this PI measure performance record.']
  org_provider_id varchar [note: 'Reference to the healthcare organization reporting this PI measure performance.']
  prior_promoting_interoperability_id varchar [note: 'Self-referencing FK on promoting_interoperability (prior_promoting_interoperability_id)']
  apm_participation_flag boolean [note: 'Indicates whether this PI measure is being reported as part of an Alternative Payment Model.']
  attestation_contact_email varchar [note: 'The email address of the individual responsible for submitting this PI measure attestation.']
  attestation_contact_name varchar [note: 'The name of the individual responsible for submitting this PI measure attestation.']
  attestation_contact_phone varchar [note: 'The phone number of the individual responsible for submitting this PI measure attestation.']
  attestation_date date [note: 'The date on which the PI measure performance was attested and submitted to CMS.']
  attestation_method varchar [note: 'The method or channel used to submit the PI measure attestation to CMS.']
  attestation_status varchar [note: 'The current status of the PI measure attestation submission to CMS.']
  bonus_points_earned varchar [note: 'The number of bonus points earned for exceptional performance on this PI measure.']
  cms_program_year varchar [note: 'The CMS program year for which this PI measure is being reported (may differ from calendar year).']
  created_timestamp timestamp [note: 'The timestamp when this PI measure performance record was first created in the system.']
  data_completeness_percentage decimal(5,2) [note: 'The percentage of required data elements that were complete and available for this PI measure calculation.']
  denominator_count varchar [note: 'The total number of eligible instances for the measure (total opportunities).']
  ehr_certification_number varchar [note: 'The ONC certification identifier for the EHR technology used to support this PI measure.']
  ehr_product_version varchar [note: 'The version of the EHR product used to support this PI measure.']
  ehr_vendor_name varchar [note: 'The name of the EHR vendor whose system was used to support this PI measure.']
  exclusion_count varchar [note: 'The number of instances excluded from the measure calculation due to valid exclusion criteria.']
  hardship_exception_flag boolean [note: 'Indicates whether a hardship exception was granted for this PI measure.']
  hardship_exception_reason varchar [note: 'The reason or justification for the hardship exception if one was granted.']
  last_updated_timestamp timestamp [note: 'The timestamp when this PI measure performance record was last modified.']
  measure_category varchar [note: 'The category of the PI measure within the CMS program structure. [ENUM-REF-CANDIDATE: electronic_prescribing|health_information_exchange|provider_to_patient_exchange|public_health_reporting|clinical_data_registry_reporting|base_score|performance_score|bonus — 8 candidates stripped; promote to reference product]']
  measure_identifier varchar [note: 'The unique CMS identifier for the specific PI measure being reported (e.g., PI_EP_1, PI_HIE_1).']
  measure_name varchar [note: 'The descriptive name of the PI measure (e.g., e-Prescribing, Health Information Exchange, Support Electronic Referral Loops).']
  measure_weight decimal(5,2) [note: 'The weight or contribution of this measure to the overall PI score, expressed as a percentage.']
  mips_participation_flag boolean [note: 'Indicates whether this PI measure is being reported as part of MIPS participation.']
  notes varchar [note: 'Additional notes, comments, or context regarding this PI measure performance or attestation.']
  npi varchar [note: 'The National Provider Identifier of the reporting clinician or organization.']
  numerator_count varchar [note: 'The number of instances that meet the measure criteria (successful actions or compliant cases).']
  payment_adjustment_percentage decimal(5,2) [note: 'The percentage payment adjustment (positive or negative) resulting from this PI measure performance.']
  performance_met_flag boolean [note: 'Indicates whether the performance rate met the CMS threshold for this measure.']
  performance_rate decimal(5,2) [note: 'The calculated performance rate for the measure, expressed as a percentage (numerator divided by denominator minus exclusions).']
  reporting_entity_type varchar [note: 'The type of entity reporting this PI measure (eligible clinician, hospital, group, or APM entity).']
  reporting_period_end_date date [note: 'The end date of the reporting period for this PI measure performance.']
  reporting_period_start_date date [note: 'The start date of the reporting period for this PI measure performance.']
  reporting_year varchar [note: 'The calendar year for which this PI measure performance is being reported.']
  submission_confirmation_number varchar [note: 'The confirmation number provided by CMS upon successful submission of the PI measure attestation.']
  threshold_percentage decimal(5,2) [note: 'The CMS-defined threshold percentage that must be met for this measure to be considered compliant.']
  tin varchar [note: 'The Tax Identification Number of the reporting organization or practice.']
  validation_errors varchar [note: 'Description of any validation errors encountered during PI measure submission or processing.']
  validation_status varchar [note: 'The status of data validation checks performed on this PI measure submission.']
  vibe_mutation_marker varchar

  Note: 'Transactional record tracking the organizations performance on CMS Promoting Interoperability (PI) program measures (formerly Meaningful Use), including electronic prescribing rates, health information exchange rates, provider-to-patient exchange rates, public health reporting rates, and clinical data registry reporting rates. Captures reporting period, eligible clinician or hospital reference, measure identifier, numerator count, denominator count, exclusion count, performance rate, and attestation status. Supports CMS PI attestation and value-based program compliance.'
}

Table interoperability.public_health_report {
  public_health_report_id varchar [pk, note: 'Unique identifier for each public health reporting submission record. Primary key for the public health report entity.']
  care_site_id varchar [note: 'Unique identifier of the healthcare facility or organization submitting this public health report. Links to the facility master data.']
  condition_code_icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Public health reporting submits notifiable conditions using ICD codes. Real-world: electronic lab reporting (ELR) and case reporting to state health departments require standard ICD-10 diagnosis codes']
  corrected_public_health_report_id varchar [note: 'Self-referencing FK on public_health_report (corrected_public_health_report_id)']
  data_use_agreement_id varchar [note: 'Unique identifier of the data use agreement or data sharing agreement governing the exchange of this public health report with the receiving agency. Links to the legal agreement authorizing the data sharing.']
  exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Public health reports conform to specific exchange standards (HL7v2, CDA, FHIR, etc.) mandated by reporting agencies. Currently this is captured as STRING columns message_standard and message_version.']
  immunization_id varchar [note: 'Foreign key linking to clinical.immunization. Business justification: Immunization registries (IIS) are mandatory public health reporting under meaningful use. Linking public_health_report to immunization enables tracking which immunization records were successfully sub']
  interface_channel_id varchar [note: 'Unique identifier of the interface engine channel used to transmit this public health report. Links to the interface channel configuration that defines transport, protocol, and endpoint details.']
  trading_partner_id varchar [note: 'Unique identifier of the trading partner record representing the receiving public health agency. Links to trading partner master data containing contact information, technical endpoints, and data sharing agreements.']
  visit_id varchar [note: 'Unique identifier of the clinical encounter associated with this public health report, if applicable. Links the report to the originating patient visit or episode of care.']
  acknowledgment_code varchar [note: 'Code returned by the receiving public health agency in the acknowledgment message indicating acceptance, rejection, or error condition. Typically an HL7 acknowledgment code (AA, AE, AR, CA, CE, CR) or FHIR OperationOutcome code.']
  acknowledgment_payload varchar [note: 'Full text of the acknowledgment message received from the public health agency, including any error details, validation messages, or processing notes.']
  acknowledgment_timestamp timestamp [note: 'Date and time when the acknowledgment message was received from the public health agency confirming receipt and processing status of the submission.']
  attestation_eligible_flag boolean [note: 'Boolean indicator of whether this public health report submission counts toward CMS Promoting Interoperability attestation requirements. True if the submission meets all criteria for attestation credit.']
  case_count varchar [note: 'Number of individual cases, records, or events included in this public health report submission. For ELR this is lab result count, for IIS this is immunization count, for syndromic surveillance this is encounter count.']
  created_timestamp timestamp [note: 'Date and time when this public health report record was first created in the data warehouse. Audit timestamp for data lineage and record creation tracking.']
  encryption_enabled_flag boolean [note: 'Boolean indicator of whether the public health report transmission was encrypted in transit. True if encryption was applied, false if transmitted in clear text. Critical for HIPAA compliance and PHI protection.']
  error_description varchar [note: 'Detailed description of any errors, validation failures, or rejection reasons returned by the receiving public health agency. Populated when submission_status is rejected or error.']
  jurisdiction_code varchar [note: 'Code identifying the state, county, or local public health jurisdiction to which this report is being submitted. Typically a FIPS code or state abbreviation.']
  message_payload varchar [note: 'Full text of the transmitted public health message in its native format (HL7 v2 pipe-delimited message, FHIR JSON bundle, CDA XML document). Stored for audit, troubleshooting, and resubmission purposes.']
  modified_timestamp timestamp [note: 'Date and time when this public health report record was last updated in the data warehouse. Audit timestamp for tracking changes to submission status, acknowledgments, or retry attempts.']
  patient_mrn varchar [note: 'Medical record number of the patient associated with this public health report, if the report pertains to a single patient. For batch submissions covering multiple patients, this field may be null.']
  phi_included_flag boolean [note: 'Boolean indicator of whether this public health report contains Protected Health Information as defined by HIPAA. True if PHI is present, requiring additional security and privacy controls.']
  promoting_interoperability_measure varchar [note: 'CMS Promoting Interoperability (formerly Meaningful Use) measure that this public health report submission satisfies. Examples include Public Health Registry Reporting, Immunization Registry Reporting, Electronic Case Reporting, Syndromic Surveillance Reporting.']
  report_identifier varchar [note: 'External business identifier or control number assigned to this public health report submission for tracking and reconciliation with the receiving agency.']
  report_type varchar [note: 'Category of public health report being submitted. ELR = Electronic Lab Reporting, IIS = Immunization Information System, syndromic_surveillance = BioSense Platform submissions, cancer_registry = state cancer registry reporting, vital_records = birth/death certificate reporting, reportable_condition = notifiable disease reporting.']
  reporting_agency_code varchar [note: 'Standardized code or identifier for the receiving public health agency, typically a state health department code or federal agency identifier.']
  reporting_agency_name varchar [note: 'Name of the state or federal public health agency receiving this report submission (e.g., State Department of Health, CDC BioSense Platform, State Immunization Registry).']
  reporting_period_end_date date [note: 'End date of the time period covered by this public health report submission. Defines the upper bound of the reporting window.']
  reporting_period_start_date date [note: 'Start date of the time period covered by this public health report submission. For lab results, this may be the specimen collection date range start; for immunizations, the administration date range start.']
  retry_count varchar [note: 'Number of times this public health report submission has been retried after initial failure. Used to track resubmission attempts and prevent infinite retry loops.']
  submission_source_system varchar [note: 'Name or identifier of the source clinical system that generated the data for this public health report (e.g., Epic EHR, Cerner Millennium, Laboratory Information System). Used for troubleshooting and data lineage tracking.']
  submission_status varchar [note: 'Current lifecycle status of the public health report submission. Accepted = successfully received and validated by agency, rejected = failed validation or business rules, pending = awaiting acknowledgment, acknowledged = receipt confirmed but not yet processed, error = transmission or technical failure.']
  submission_timestamp timestamp [note: 'Date and time when the public health report was transmitted to the receiving agency. This is the principal business event timestamp representing when the reporting obligation was fulfilled.']
  transmission_method varchar [note: 'Technical transport protocol used to transmit the public health report. HTTPS = secure web service, SFTP = secure file transfer, Direct = Direct secure messaging, SOAP = SOAP web service, REST = RESTful API, MLLP = Minimal Lower Layer Protocol for HL7 v2.']
  vibe_mutation_marker varchar

  Note: 'Transactional record of every public health reporting submission made to state and federal public health agencies, including electronic lab reporting (ELR), immunization registry submissions (IIS), syndromic surveillance (BioSense), cancer registry reporting, and vital records reporting. Captures report type, reporting agency, submission timestamp, reporting period, message standard used (HL7v2 2.5.1, FHIR), submission status (accepted/rejected/pending), acknowledgment code, and case count. Supports Promoting Interoperability public health measures.'
}

Table interoperability.care_transition_notification {
  care_transition_notification_id varchar [pk, note: 'Unique identifier for the care transition notification record. Primary key.']
  care_site_id varchar [note: 'Reference to the healthcare facility that sent the care transition notification.']
  clinician_id varchar [note: 'Reference to the attending provider responsible for the patient during the care transition event.']
  demographics_id varchar [note: 'Reference to the patient who experienced the care transition event.']
  hie_transaction_id varchar [note: 'Transaction identifier assigned by the Health Information Exchange network if the notification was routed through an HIE.']
  interface_channel_id varchar [note: 'Reference to the interface engine channel configuration used to send the notification.']
  recipient_direct_address_id varchar [note: 'Foreign key linking to interoperability.direct_address. Business justification: Care transition notifications (ADT notifications) are often sent via Direct Secure Messaging to care team members. The receiving_party_identifier could be a Direct address. Adding recipient_direct_add']
  scheduling_appointment_id varchar [note: 'Foreign key linking to scheduling.scheduling_appointment. Business justification: ADT notifications (discharge, transfer) trigger follow-up appointment scheduling per care coordination protocols. CMS care transitions programs and ACO contracts require tracking whether transition no']
  superseded_care_transition_notification_id varchar [note: 'Self-referencing FK on care_transition_notification (superseded_care_transition_notification_id)']
  visit_id varchar [note: 'Reference to the encounter associated with the care transition event (admission, discharge, transfer, or ED visit).']
  acknowledgment_code varchar [note: 'HL7 acknowledgment code received from the recipient system (AA=Application Accept, AE=Application Error, AR=Application Reject, CA=Commit Accept, CE=Commit Error, CR=Commit Reject).']
  acknowledgment_received_flag boolean [note: 'Indicates whether an acknowledgment was received from the recipient system confirming receipt of the notification.']
  acknowledgment_timestamp timestamp [note: 'Date and time when the acknowledgment was received from the recipient system.']
  actual_delivery_minutes varchar [note: 'Actual time in minutes from event occurrence to successful notification delivery for SLA compliance monitoring.']
  attending_provider_npi varchar [note: 'National Provider Identifier of the attending provider for regulatory reporting.']
  care_coordination_purpose varchar [note: 'Specific care coordination purpose for the notification (e.g., post-discharge follow-up, medication reconciliation, care plan update, transition of care summary).']
  cms_interoperability_compliant_flag boolean [note: 'Indicates whether this notification meets CMS Interoperability and Patient Access Final Rule requirements for ADT notifications.']
  created_timestamp timestamp [note: 'Date and time when this notification record was created in the system for audit trail purposes.']
  delivery_attempt_count varchar [note: 'Number of delivery attempts made for this notification.']
  delivery_channel varchar [note: 'Communication channel used to deliver the notification: Direct secure messaging, FHIR API, HL7 v2 interface, Clinical Document Architecture (CDA), REST API, secure email, or fax. [ENUM-REF-CANDIDATE: direct|fhir|hl7v2|cda|api|secure_email|fax — 7 candidates stripped; promote to reference product]']
  delivery_status varchar [note: 'Current status of the notification delivery: sent, delivered to recipient system, failed, pending transmission, acknowledged by recipient, or rejected.']
  discharge_disposition varchar [note: 'Disposition of the patient at discharge (e.g., home, skilled nursing facility, hospice, left against medical advice) when event type is discharge.']
  encryption_applied_flag boolean [note: 'Indicates whether the notification message was encrypted during transmission to protect Protected Health Information (PHI).']
  event_timestamp timestamp [note: 'Date and time when the care transition event occurred (when the patient was admitted, discharged, or transferred).']
  event_type varchar [note: 'Type of care transition event that triggered the notification: admission, discharge, transfer between units, emergency department visit, observation admission, or inpatient admission.']
  failure_reason varchar [note: 'Description of the reason for delivery failure if the notification was not successfully delivered.']
  message_standard varchar [note: 'Interoperability standard used for the notification message: HL7 v2.x, FHIR R4, FHIR R5, CDA R2, Consolidated CDA (C-CDA), or proprietary format.']
  message_type_code varchar [note: 'Specific message type code from the standard (e.g., ADT^A01 for admission, ADT^A03 for discharge in HL7 v2).']
  message_version varchar [note: 'Version of the message standard used (e.g., 2.5.1 for HL7 v2, 4.0.1 for FHIR R4).']
  modified_timestamp timestamp [note: 'Date and time when this notification record was last modified for audit trail and change tracking.']
  notification_content_summary varchar [note: 'Brief summary of the notification content for audit and tracking purposes without including full PHI details.']
  notification_control_number varchar [note: 'Business identifier for the notification message, typically the HL7 message control ID or FHIR message identifier used for tracking and acknowledgment.']
  notification_priority varchar [note: 'Priority level assigned to the notification for delivery processing: routine, urgent, stat (immediate), or emergency.']
  notification_sent_timestamp timestamp [note: 'Date and time when the notification was sent to the receiving party.']
  notification_source_system varchar [note: 'Name of the source system that generated the care transition notification (e.g., Epic, Cerner, MEDITECH).']
  patient_consent_status varchar [note: 'Status of patient consent for sharing care transition information with the receiving party.']
  payload_size_bytes varchar [note: 'Size of the notification message payload in bytes for performance monitoring and capacity planning.']
  phi_included_flag boolean [note: 'Indicates whether the notification contains Protected Health Information subject to HIPAA Privacy Rule requirements.']
  primary_diagnosis_code varchar [note: 'Primary diagnosis code (ICD-10-CM) associated with the care transition event for clinical context.']
  primary_diagnosis_description varchar [note: 'Human-readable description of the primary diagnosis for the care transition event.']
  receiving_party_identifier varchar [note: 'Identifier of the receiving party (NPI for providers, organization ID for payers/ACOs, Direct address, or FHIR endpoint identifier).']
  receiving_party_name varchar [note: 'Name of the receiving party or organization for human-readable identification.']
  receiving_party_type varchar [note: 'Type of recipient receiving the care transition notification: Primary Care Physician (PCP), specialist, payer, Accountable Care Organization (ACO), care manager, Health Information Exchange (HIE), patient, or family member. [ENUM-REF-CANDIDATE: pcp|specialist|payer|aco|care_manager|hie|patient|family_member — 8 candidates stripped; promote to reference product]']
  sending_facility_npi varchar [note: 'National Provider Identifier of the sending facility for regulatory reporting and identification.']
  sla_breach_flag boolean [note: 'Indicates whether the notification delivery exceeded the SLA target time, requiring escalation or remediation.']
  sla_target_delivery_minutes varchar [note: 'Target time in minutes for notification delivery per service level agreement with receiving party or regulatory requirement.']
  transfer_from_location varchar [note: 'Location or unit from which the patient was transferred when event type is transfer.']
  transfer_to_location varchar [note: 'Location or unit to which the patient was transferred when event type is transfer.']
  vibe_mutation_marker varchar

  Note: 'Transactional record of every care transition notification (ADT notification) sent to care team members, PCPs, payers, and ACO partners when a patient is admitted, discharged, or transferred. Captures notification timestamp, event type (admission/discharge/transfer/ED visit), sending facility, receiving party type (PCP/specialist/payer/ACO), delivery channel (Direct/FHIR/HL7v2/API), delivery status, patient reference, encounter reference, and acknowledgment receipt. Supports CMS Interoperability Rule ADT notification requirements and care coordination.'
}

Table interoperability.hie_transaction {
  hie_transaction_id varchar [pk, note: 'Primary key for hie_transaction']
  demographics_id varchar [note: 'The unique identifier for the patient whose data is being exchanged in this transaction. May be a medical record number (MRN) or other patient identifier.']
  hie_organization_id varchar [note: 'Foreign key linking to interoperability.hie_organization. Business justification: HIE transactions involve specific HIE organizations (source or destination). Currently only hie_network_id (STRING) exists. FK to hie_organization enables proper organizational tracking, retrieving or']
  interface_channel_id varchar [note: 'Foreign key linking to interoperability.interface_channel. Business justification: HIE transactions flow through specific interface channels. Currently only interface_id (STRING) exists. Adding proper FK to interface_channel enables tracking which channel processed each transaction,']
  mapping_rule_id varchar [note: 'Identifier of the transformation rule or mapping configuration applied to this transaction, if any.']
  parent_hie_transaction_id varchar [note: 'Self-referencing FK on hie_transaction (related_hie_transaction_id)']
  parent_transaction_id varchar [note: 'Reference to a parent HIE transaction if this transaction is a retry, follow-up, or child transaction of another exchange.']
  visit_id varchar [note: 'The unique identifier for the clinical encounter or visit associated with this transaction, if applicable.']
  acknowledgment_code varchar [note: 'The acknowledgment status code received from the destination system (AA=Application Accept, AE=Application Error, AR=Application Reject, CA=Commit Accept, CE=Commit Error, CR=Commit Reject).']
  acknowledgment_timestamp timestamp [note: 'The date and time when the acknowledgment was received from the destination system.']
  archived_timestamp timestamp [note: 'The date and time when this transaction record was archived, if applicable.']
  business_purpose varchar [note: 'The business or clinical purpose for which this data exchange was performed, as defined by HIPAA permitted uses.']
  consent_status varchar [note: 'The status of patient consent for data sharing at the time of this transaction.']
  correlation_identifier varchar [note: 'Identifier used to correlate this transaction with related transactions or to link request and response messages.']
  created_timestamp timestamp [note: 'The date and time when this HIE transaction record was first created in the system.']
  destination_system_code varchar [note: 'Identifier of the target system or organization that is the intended recipient of the message in this HIE transaction.']
  destination_system_name varchar [note: 'Human-readable name of the destination system or facility that is receiving this transaction.']
  direction varchar [note: 'Indicates whether this transaction represents data received from an external system (inbound) or sent to an external system (outbound).']
  endpoint_url varchar [note: 'The network endpoint URL or address where the message was sent or received.']
  error_code varchar [note: 'The error code returned if the transaction failed or was rejected, indicating the specific issue encountered.']
  error_description varchar [note: 'Human-readable description of the error or rejection reason if the transaction was not successfully processed.']
  hie_transaction_status varchar [note: 'Current lifecycle status of the HIE transaction indicating whether the data exchange has been successfully completed, is in progress, or encountered errors.']
  is_archived boolean [note: 'Indicates whether this transaction record has been archived for long-term retention and is no longer actively processed.']
  message_control_number varchar [note: 'Unique control identifier assigned by the sending system to track this specific message instance.']
  message_event_code varchar [note: 'The specific event or trigger code within the message standard (e.g., ADT^A01 for patient admission in HL7 v2).']
  message_size_bytes varchar [note: 'The size of the message payload in bytes for this transaction.']
  message_standard varchar [note: 'The healthcare interoperability standard used for this transaction (e.g., HL7 v2, FHIR, CDA, X12 EDI).']
  message_version varchar [note: 'The specific version of the message standard used (e.g., 2.5.1 for HL7 v2, R4 for FHIR).']
  modified_timestamp timestamp [note: 'The date and time when this HIE transaction record was last updated or modified.']
  priority varchar [note: 'The priority level assigned to this transaction indicating urgency of processing (routine, urgent, stat, emergency).']
  processing_duration_ms varchar [note: 'The time in milliseconds taken to process this transaction from receipt to acknowledgment.']
  retry_count varchar [note: 'The number of times this transaction has been retried after initial failure.']
  security_classification varchar [note: 'The confidentiality or security classification level of the data being exchanged in this transaction.']
  source_system_code varchar [note: 'Identifier of the originating system or organization that sent the message in this HIE transaction.']
  source_system_name varchar [note: 'Human-readable name of the source system or facility that originated this transaction.']
  transaction_number varchar [note: 'Business-facing unique transaction number or reference code assigned to this HIE data exchange event.']
  transaction_timestamp timestamp [note: 'The date and time when the HIE transaction was initiated or the message was sent/received. Represents the principal business event time for this exchange.']
  transaction_type varchar [note: 'Classification of the HIE transaction based on the clinical or administrative event being exchanged (e.g., admission notification, lab result delivery, patient query).']
  transformation_applied boolean [note: 'Indicates whether data transformation or mapping was applied to convert the message between different standards or formats.']
  transmission_protocol varchar [note: 'The network protocol used to transmit this message (e.g., MLLP for HL7 v2, HTTPS for FHIR, Direct for secure messaging).']
  vibe_mutation_marker varchar

  Note: 'Master reference table for hie_transaction. Referenced by hie_transaction_id.'
}

Table interoperability.data_sharing_agreement {
  data_sharing_agreement_id varchar [pk, note: 'Primary key for data_sharing_agreement']
  hie_organization_id varchar
  interface_engine_id varchar [note: 'Foreign key linking to interoperability.interface_engine. Business justification: Data sharing agreements specify which interface engine configuration to use for data exchange. Currently interface_engine_configuration_id (BIGINT) exists but doesn\'t reference the interface_engine ta']
  superseded_data_sharing_agreement_id varchar [note: 'Self-referencing FK on data_sharing_agreement (superseded_data_sharing_agreement_id)']
  trading_partner_id varchar [note: 'Foreign key linking to interoperability.trading_partner. Business justification: Each data sharing agreement is established with a specific trading partner. Currently partner_organization_id (BIGINT) exists but doesn\'t reference the trading_partner table. Adding proper FK enables ']
  agreement_code varchar
  agreement_name varchar [note: 'Human-readable name or title of the data sharing agreement, describing the partnership or data exchange purpose.']
  agreement_number varchar [note: 'Business identifier for the data sharing agreement, used for external reference and communication with partner organizations.']
  agreement_status varchar [note: 'Current lifecycle status of the data sharing agreement, indicating whether it is operational or in a transitional state.']
  agreement_type varchar [note: 'Classification of the data sharing agreement based on the nature of the partnership and data exchange model.']
  audit_logging_required_flag boolean [note: 'Indicates whether comprehensive audit logging of data access and transmission is required under this agreement.']
  auto_renewal_flag boolean [note: 'Indicates whether the agreement automatically renews unless either party provides termination notice.']
  breach_notification_required_flag boolean [note: 'Indicates whether the partner organization must notify the healthcare organization of any data breaches involving shared data.']
  breach_notification_timeframe_hours varchar [note: 'Maximum number of hours within which the partner organization must notify of a data breach.']
  compliance_review_frequency_days varchar [note: 'Number of days between scheduled compliance reviews of this data sharing agreement.']
  consent_required_flag boolean [note: 'Indicates whether explicit patient consent is required before data can be shared under this agreement.']
  created_timestamp timestamp [note: 'Timestamp when this data sharing agreement record was first created in the system.']
  data_categories_shared varchar [note: 'Comma-separated list or description of the types of healthcare data covered by this agreement (e.g., clinical, administrative, financial, laboratory, imaging).']
  data_exchange_direction varchar [note: 'Direction of data flow under this agreement, indicating whether data is received, sent, or exchanged in both directions.']
  data_exchange_standard varchar [note: 'Primary healthcare data standard or protocol used for data exchange under this agreement.']
  data_quality_standards varchar [note: 'Documented data quality requirements and standards that shared data must meet (e.g., completeness, accuracy, timeliness).']
  data_retention_period_days varchar [note: 'Number of days the receiving organization is permitted to retain the shared data before it must be destroyed or returned.']
  data_use_restrictions varchar [note: 'Documented restrictions or limitations on how the receiving organization may use the shared data.']
  effective_date date [note: 'Date when the data sharing agreement becomes legally binding and operational for data exchange activities.']
  effective_end_date date
  effective_start_date date
  encryption_required_flag boolean [note: 'Indicates whether data must be encrypted during transmission and at rest as a condition of this agreement.']
  execution_date date
  expiration_date date [note: 'Date when the data sharing agreement terminates or requires renewal. Nullable for agreements with no defined end date.']
  hipaa_business_associate_flag boolean [note: 'Indicates whether the partner organization is classified as a HIPAA Business Associate, requiring a Business Associate Agreement.']
  last_compliance_review_date date [note: 'Date of the most recent compliance review conducted for this data sharing agreement.']
  last_updated_timestamp timestamp [note: 'Timestamp when this data sharing agreement record was last modified in the system.']
  legal_basis varchar [note: 'Legal or regulatory framework authorizing the data sharing (e.g., HIPAA, 42 CFR Part 2, state law, patient consent).']
  next_compliance_review_date date [note: 'Scheduled date for the next compliance review of this data sharing agreement.']
  notes varchar [note: 'Additional notes, comments, or special considerations related to this data sharing agreement.']
  partner_contact_email varchar [note: 'Email address of the primary contact person at the partner organization for this data sharing agreement.']
  partner_contact_name varchar [note: 'Name of the primary contact person at the partner organization for this data sharing agreement.']
  partner_contact_phone varchar [note: 'Phone number of the primary contact person at the partner organization for this data sharing agreement.']
  permitted_purpose varchar
  phi_included_flag boolean [note: 'Indicates whether Protected Health Information is included in the data shared under this agreement, requiring HIPAA compliance.']
  primary_contact_email varchar [note: 'Email address of the primary internal contact person for this data sharing agreement.']
  primary_contact_name varchar [note: 'Name of the primary internal contact person responsible for this data sharing agreement.']
  primary_contact_phone varchar [note: 'Phone number of the primary internal contact person for this data sharing agreement.']
  purpose_of_use varchar [note: 'Documented business purpose for which data is shared under this agreement (e.g., treatment, care coordination, quality reporting, research).']
  renewal_date date
  renewal_notification_days varchar [note: 'Number of days before expiration that stakeholders should be notified for agreement renewal consideration.']
  responsible_department varchar [note: 'Internal department or business unit responsible for managing and maintaining this data sharing agreement.']
  security_requirements varchar [note: 'Documented security controls and safeguards required for data transmission and storage under this agreement.']
  signatory_name varchar
  termination_date date [note: 'Actual date when the data sharing agreement was terminated, if applicable.']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the data sharing agreement.']
  termination_reason varchar [note: 'Documented reason for termination of the data sharing agreement, if applicable.']
  transmission_frequency varchar [note: 'Expected frequency or schedule for data transmission under this agreement.']
  transmission_method varchar [note: 'Technical method or protocol used to transmit data between organizations under this agreement.']
  updated_timestamp timestamp
  vibe_mutation_marker varchar

  Note: 'Master reference table for data_sharing_agreement. Referenced by data_sharing_agreement_id.'
}

Table interoperability.hie_organization {
  hie_organization_id varchar [pk, note: 'Primary key for hie_organization']
  parent_hie_organization_id varchar [note: 'Self-referencing FK on hie_organization (parent_hie_organization_id)']
  trading_partner_id varchar
  address_line_1 varchar [note: 'The first line of the organization\'s physical address, typically containing street number and name.']
  address_line_2 varchar [note: 'The second line of the organization\'s physical address, typically containing suite, floor, or building information.']
  authentication_method varchar [note: 'The authentication mechanism required to connect to the organization\'s HIE endpoint.']
  carequality_participant boolean [note: 'Indicates whether the organization is a participant in the Carequality interoperability framework.']
  certification_date date [note: 'The date when the organization received its current health information exchange certification.']
  certification_expiry_date date [note: 'The date when the organization\'s health information exchange certification expires.']
  certification_status varchar [note: 'The current certification status of the organization for health information exchange capabilities.']
  city varchar [note: 'The city where the HIE organization is located.']
  commonwell_participant boolean [note: 'Indicates whether the organization is a member of the CommonWell Health Alliance network.']
  country_code varchar [note: 'The three-letter ISO country code where the HIE organization is located.']
  created_timestamp timestamp [note: 'The timestamp when this HIE organization record was first created in the system.']
  data_sharing_agreement_date date [note: 'The date when the data sharing agreement was signed with this HIE organization.']
  data_sharing_agreement_expiry_date date [note: 'The date when the data sharing agreement with this HIE organization expires and requires renewal.']
  data_sharing_agreement_signed boolean [note: 'Indicates whether a formal data sharing agreement has been executed with this HIE organization.']
  direct_trust_bundle_enabled boolean [note: 'Indicates whether the organization participates in the Direct Trust network for secure health information exchange.']
  endpoint_protocol varchar [note: 'The communication protocol used by the organization\'s HIE endpoint for data exchange.']
  endpoint_url varchar [note: 'The primary technical endpoint URL for connecting to the organization\'s HIE services and data exchange interfaces.']
  hie_network_name varchar
  hipaa_compliant boolean [note: 'Indicates whether the HIE organization has been verified as HIPAA compliant for protected health information exchange.']
  interface_engine_type varchar [note: 'The type or vendor of the interface engine used by the organization for health data exchange (e.g., Rhapsody, Mirth Connect, Cloverleaf, Ensemble).']
  is_active boolean [note: 'Indicates whether this HIE organization record is currently active and available for data exchange operations.']
  last_successful_exchange_timestamp timestamp [note: 'The timestamp of the most recent successful data exchange with this HIE organization.']
  message_volume_monthly_avg varchar [note: 'The average number of interoperability messages exchanged with this organization per month.']
  modified_timestamp timestamp [note: 'The timestamp when this HIE organization record was last modified.']
  notes varchar [note: 'Additional free-text notes or comments about the HIE organization, including special configuration requirements or operational considerations.']
  organization_identifier varchar [note: 'The externally-known unique identifier for the HIE organization, such as National Provider Identifier (NPI), Tax ID (TIN), or other registry identifier.']
  organization_name varchar [note: 'The official legal name of the HIE organization or health information exchange entity.']
  organization_npi varchar
  organization_status varchar
  organization_type varchar [note: 'Classification of the HIE organization indicating the type of healthcare entity participating in health information exchange.']
  participation_end_date date [note: 'The date when the organization\'s participation in the health information exchange ended or is scheduled to end. Null for ongoing participation.']
  participation_start_date date [note: 'The date when the organization began participating in the health information exchange.']
  participation_status varchar [note: 'Current lifecycle status of the organization\'s participation in the health information exchange network.']
  postal_code varchar [note: 'The postal or ZIP code of the organization\'s address.']
  primary_contact_email varchar [note: 'The email address of the primary contact person for HIE coordination and technical communication.']
  primary_contact_name varchar [note: 'The name of the primary contact person at the HIE organization responsible for interoperability coordination.']
  primary_contact_phone varchar [note: 'The phone number of the primary contact person for HIE coordination and support.']
  state_province varchar [note: 'The state or province where the HIE organization is located.']
  supported_cda_versions varchar [note: 'Comma-separated list of CDA document standard versions supported by this organization for clinical document exchange (e.g., CDA R2, C-CDA R1.1, C-CDA R2.1).']
  supported_fhir_versions varchar [note: 'Comma-separated list of FHIR standard versions supported by this organization for interoperability (e.g., DSTU2, STU3, R4, R5).']
  supported_hl7v2_versions varchar [note: 'Comma-separated list of HL7v2 message standard versions supported by this organization for interoperability (e.g., 2.3, 2.5.1, 2.7).']
  tefca_qhin_participant boolean [note: 'Indicates whether the organization participates in TEFCA as a Qualified Health Information Network or through a QHIN.']
  updated_timestamp timestamp
  vibe_mutation_marker varchar

  Note: 'Master reference table for hie_organization. Referenced by hie_organization_id.'
}

Table interoperability.mapping_definition {
  mapping_definition_id varchar [pk, note: 'Primary key for mapping_definition']
  interface_engine_id varchar
  mapping_exchange_standard_id varchar
  primary_superseded_mapping_definition_id varchar [note: 'Self-referencing FK on mapping_definition (superseded_mapping_definition_id)']
  source_exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Mapping definitions transform data from a source exchange standard. Currently only source_standard (STRING) exists. FK to exchange_standard enables proper standard version tracking, managing standard-']
  approval_date date [note: 'The date when this mapping definition received formal approval for production use.']
  approval_status varchar [note: 'Current approval state in the governance workflow: pending (awaiting review), approved (authorized for use), rejected (not approved), under_review (in evaluation).']
  approved_by varchar [note: 'Name or identifier of the person or committee who approved this mapping definition for production use.']
  bidirectional_flag boolean [note: 'Indicates whether this mapping definition can be applied in both directions (source to target and target to source). True if bidirectional, false if unidirectional.']
  cardinality_source varchar [note: 'The cardinality constraint of the source element (e.g., 0..1, 1..1, 0..*, 1..*) indicating minimum and maximum occurrences.']
  cardinality_target varchar [note: 'The cardinality constraint of the target element (e.g., 0..1, 1..1, 0..*, 1..*) indicating minimum and maximum occurrences.']
  change_reason varchar [note: 'Explanation of why this mapping definition was created or modified, including references to change requests or regulatory requirements.']
  complexity_score varchar [note: 'Numeric score (1-10) indicating the complexity of the transformation logic, used for resource planning and maintenance prioritization.']
  conditional_logic varchar [note: 'Boolean or conditional expression that determines when this mapping rule should be applied. May reference other field values or business rules.']
  contact_information varchar [note: 'Contact details (email, phone, or team name) for the subject matter expert or team responsible for this mapping definition.']
  copyright_notice varchar [note: 'Legal copyright statement or intellectual property notice associated with this mapping definition.']
  created_timestamp timestamp [note: 'The date and time when this mapping definition record was first created in the system.']
  default_value decimal(18,2) [note: 'The default value to be used when the source element is null, missing, or does not meet transformation conditions.']
  documentation_url varchar [note: 'Web address or file path to detailed technical documentation, implementation guides, or specification documents for this mapping.']
  effective_end_date date [note: 'The date when this mapping definition is no longer valid or has been superseded by a newer version. Null indicates no planned end date.']
  effective_start_date date [note: 'The date when this mapping definition becomes active and available for use in data transformation processes.']
  equivalence_type varchar [note: 'Describes the semantic relationship between source and target concepts: equivalent (same meaning), equal (identical), wider (target is broader), subsumes (target includes source), narrower (target is more specific), specializes (target refines source), inexact (approximate match), unmatched (no correspondence), disjoint (mutually exclusive).']
  error_handling_strategy varchar [note: 'Defines the action to take when mapping transformation fails: fail (halt processing), warn (log warning and continue), skip (omit element), default (use default value), retry (attempt again), log (record error and continue).']
  experimental_flag boolean [note: 'Indicates whether this mapping definition is experimental and not yet approved for production use. True if experimental, false if production-ready.']
  jurisdiction varchar [note: 'Geographic or regulatory jurisdiction where this mapping definition applies (e.g., USA, CAN, EUR). Uses ISO 3166-1 alpha-3 country codes.']
  last_review_date date [note: 'The date when this mapping definition was last reviewed for accuracy, relevance, and compliance with current standards.']
  mapping_code varchar [note: 'Unique business code or identifier for the mapping definition, used for external reference and system integration.']
  mapping_name varchar [note: 'Human-readable name of the data mapping definition used for identification and reference purposes.']
  mapping_status varchar [note: 'Current lifecycle status of the mapping definition: draft (under development), active (in production use), deprecated (scheduled for retirement), retired (no longer used), testing (under validation).']
  mapping_superseded_by_map varchar [note: 'Reference to the newer mapping definition that replaces this one when this mapping is deprecated or retired.']
  mapping_type varchar [note: 'Classification of the mapping definition by its transformation approach: conceptual (high-level business concept alignment), structural (data structure transformation), semantic (meaning preservation), syntactic (format conversion), value_set (enumeration mapping), or code_system (terminology mapping).']
  modified_timestamp timestamp [note: 'The date and time when this mapping definition record was last modified or updated.']
  next_review_date date [note: 'The scheduled date for the next periodic review of this mapping definition.']
  notes varchar
  priority_order varchar [note: 'Numeric value indicating the execution order or priority when multiple mapping rules apply to the same element. Lower numbers execute first.']
  publisher_organization varchar [note: 'The organization or department responsible for authoring, maintaining, and publishing this mapping definition.']
  purpose_description varchar [note: 'Detailed explanation of why this mapping definition exists and what business or clinical need it addresses.']
  source_data_type varchar [note: 'The data type of the source element as defined in the source standard (e.g., XPN, CodeableConcept, string, dateTime).']
  source_element_path varchar [note: 'The hierarchical path or location of the source data element within the source standard structure (e.g., PID-5 for HL7v2, Patient.name for FHIR).']
  source_format varchar
  source_standard varchar [note: 'The healthcare data standard or format of the source system from which data is being mapped. Examples include HL7v2, FHIR, CDA, X12, DICOM, or custom proprietary formats.']
  source_version varchar [note: 'Version number or release identifier of the source data standard (e.g., HL7v2.5.1, FHIR R4, CDA R2).']
  target_data_type varchar [note: 'The data type of the target element as defined in the target standard (e.g., XPN, CodeableConcept, string, dateTime).']
  target_element_path varchar [note: 'The hierarchical path or location of the target data element within the target standard structure (e.g., PID-5 for HL7v2, Patient.name for FHIR).']
  target_format varchar
  target_standard varchar [note: 'The healthcare data standard or format of the target system to which data is being mapped. Examples include HL7v2, FHIR, CDA, X12, DICOM, or custom proprietary formats.']
  target_version varchar [note: 'Version number or release identifier of the target data standard (e.g., HL7v2.5.1, FHIR R4, CDA R2).']
  test_case_reference varchar [note: 'Reference identifier or URL to the test cases and validation scenarios used to verify this mapping definition.']
  transformation_rule varchar [note: 'The technical expression, formula, or logic that defines how source data is transformed into target data. May include concatenation, splitting, date format conversion, unit conversion, or conditional logic.']
  updated_timestamp timestamp
  use_context varchar [note: 'Description of the clinical, operational, or business context in which this mapping is intended to be used (e.g., inpatient admissions, lab results, claims processing).']
  validation_rule varchar [note: 'Expression or constraint that validates the transformed data meets target system requirements before transmission. May include format checks, range validation, or business rule validation.']
  version varchar
  version_number varchar [note: 'Version identifier for this mapping definition, following semantic versioning or organizational versioning standards.']
  vibe_mutation_marker varchar

  Note: 'Master reference table for mapping_definition. Referenced by mapping_definition_id.'
}

Table interoperability.data_use_agreement {
  data_use_agreement_id varchar [pk, note: 'Primary key for data_use_agreement']
  hie_organization_id varchar
  superseded_data_use_agreement_id varchar [note: 'Self-referencing FK on data_use_agreement (superseded_data_use_agreement_id)']
  trading_partner_id varchar [note: 'Foreign key linking to interoperability.trading_partner. Business justification: Data use agreements govern data exchange with specific trading partners (research institutions, public health agencies). FK to trading_partner enables tracking agreements by partner, managing partner-']
  agreement_code varchar
  agreement_name varchar [note: 'Human-readable name or title of the data use agreement.']
  agreement_number varchar [note: 'Externally-known business identifier for the data use agreement, typically formatted as DUA-NNNNNN.']
  agreement_status varchar
  agreement_type varchar [note: 'Classification of the data use agreement based on the type of data sharing and purpose.']
  amendment_count varchar [note: 'Number of amendments made to this data use agreement since its original execution.']
  audit_rights varchar [note: 'Description of the healthcare organization\'s rights to audit the recipient\'s use and protection of the shared data.']
  auto_renewal boolean [note: 'Indicates whether this agreement automatically renews unless terminated by either party.']
  breach_notification_required boolean [note: 'Indicates whether the recipient must notify the healthcare organization of any data breach or unauthorized disclosure.']
  created_timestamp timestamp [note: 'Timestamp when this data use agreement record was first created in the system.']
  data_categories varchar
  data_classification varchar [note: 'Classification of the data being shared under this agreement based on identifiability.']
  data_destruction_required boolean [note: 'Indicates whether the recipient is required to destroy or return the data at the end of the agreement.']
  data_format varchar [note: 'Standard format in which data will be provided to the recipient.']
  data_purpose varchar [note: 'Detailed description of the permitted purpose for which the recipient may use the shared data.']
  data_retention_period_days varchar [note: 'Maximum number of days the recipient is permitted to retain the shared data.']
  data_scope varchar [note: 'Description of the specific data elements, datasets, or data categories covered by this agreement.']
  data_transfer_method varchar [note: 'Technical method by which data will be transferred to the recipient organization.']
  data_use_agreement_status varchar [note: 'Current lifecycle status of the data use agreement.']
  effective_date date [note: 'Date when the data use agreement becomes legally binding and data sharing may commence.']
  effective_end_date date
  effective_start_date date
  execution_date date
  expiration_date date [note: 'Date when the data use agreement terminates. Nullable for agreements without a fixed end date.']
  governing_law varchar [note: 'Legal jurisdiction and governing law that applies to this data use agreement.']
  irb_approval_date date [note: 'Date when IRB approval was granted for this data use. Nullable if not applicable.']
  irb_approval_number varchar [note: 'IRB approval number if the data use is for research purposes requiring IRB oversight. Nullable if not applicable.']
  last_amendment_date date [note: 'Date of the most recent amendment to this agreement. Nullable if never amended.']
  last_modified_timestamp timestamp [note: 'Timestamp when this data use agreement record was last modified in the system.']
  legal_review_completed boolean [note: 'Indicates whether legal review of this agreement has been completed by the healthcare organization\'s legal department.']
  legal_review_date date [note: 'Date when legal review of this agreement was completed. Nullable if not yet reviewed.']
  notes varchar [note: 'Additional notes, comments, or special conditions related to this data use agreement.']
  permitted_disclosures varchar [note: 'Description of any permitted further disclosures or sub-sharing allowed under this agreement.']
  permitted_use varchar
  prohibited_uses varchar [note: 'Explicit description of uses or disclosures that are prohibited under this agreement.']
  recipient_contact_email varchar [note: 'Email address of the primary contact person at the recipient organization.']
  recipient_contact_name varchar [note: 'Full name of the primary contact person at the recipient organization responsible for this agreement.']
  recipient_contact_phone varchar [note: 'Phone number of the primary contact person at the recipient organization.']
  renewal_eligible boolean [note: 'Indicates whether this agreement is eligible for renewal upon expiration.']
  security_requirements varchar [note: 'Description of security safeguards and controls the recipient must implement to protect the shared data.']
  signature_date_healthcare date [note: 'Date when the healthcare organization\'s authorized representative signed the agreement.']
  signature_date_recipient date [note: 'Date when the recipient organization\'s authorized representative signed the agreement.']
  signed_by_healthcare varchar [note: 'Full name of the authorized representative who signed this agreement on behalf of the healthcare organization.']
  signed_by_recipient varchar [note: 'Full name of the authorized representative who signed this agreement on behalf of the recipient organization.']
  termination_date date [note: 'Actual date when the agreement was terminated, if terminated before expiration date. Nullable if not terminated.']
  termination_notice_days varchar [note: 'Number of days advance notice required for either party to terminate the agreement.']
  transfer_frequency varchar [note: 'Frequency at which data will be transferred to the recipient under this agreement.']
  updated_timestamp timestamp
  vibe_mutation_marker varchar

  Note: 'Master reference table for data_use_agreement. Referenced by data_use_agreement_id.'
}

Table digital_health.digital_health_rpm_device_reading {
  digital_health_rpm_device_reading_id varchar [pk, note: 'Surrogate primary key for each RPM device reading event.']
  care_site_id varchar [note: 'FK to the care site responsible for the RPM program.']
  demographics_id varchar
  fhir_observation_id varchar [note: 'FHIR Observation resource ID if this reading was mapped to a FHIR resource.']
  mpi_record_id varchar [note: 'FK to patient MPI record; links the reading to the enterprise patient identity.']
  primary_rpm_alert_threshold_id varchar [note: 'Threshold rule evaluated against this reading.']
  rpm_alert_threshold_id varchar [note: 'FK to the alert threshold rule that was evaluated for this reading.']
  rpm_clinician_id varchar [note: 'FK to the ordering or supervising clinician for the RPM program.']
  rpm_program_enrollment_id varchar [note: 'FK to the RPM program enrollment that authorized this monitoring.']
  rpm_reviewed_by_clinician_id varchar
  alert_acknowledged_by varchar [note: 'Name or user ID of the clinician who acknowledged the alert.']
  alert_acknowledged_flag boolean [note: 'Whether the alert generated by this reading has been acknowledged by a clinician.']
  alert_acknowledged_timestamp timestamp [note: 'Timestamp when the alert was acknowledged.']
  alert_severity varchar [note: 'Severity of the triggered alert: low, medium, high, critical.']
  alert_triggered_flag boolean [note: 'Indicates whether this reading triggered an alert based on configured thresholds.']
  context_code varchar [note: 'Clinical context of the reading: fasting, post_meal, post_exercise, resting, sleeping.']
  created_timestamp timestamp [note: 'Record creation timestamp in the data lakehouse.']
  data_quality_flag boolean [note: 'Whether the reading passed data quality validation.']
  data_source varchar
  device_identifier varchar [note: 'Unique device identifier (UDI or serial number) of the RPM device that generated the reading.']
  device_manufacturer varchar [note: 'Manufacturer name of the RPM device.']
  device_model varchar [note: 'Model name/number of the RPM device.']
  device_serial_number varchar
  device_type varchar [note: 'Type of device (e.g., pulse_oximeter, glucometer, blood_pressure_cuff, weight_scale, ecg_patch).']
  diastolic_bp varchar
  diastolic_mmhg decimal(6,2) [note: 'Diastolic blood pressure in mmHg.']
  ehr_sync_timestamp timestamp [note: 'Timestamp when the reading was synced to the EHR.']
  ehr_synced_flag boolean [note: 'Whether this reading has been synced to the EHR as a clinical observation.']
  glucose_mg_dl decimal(8,2) [note: 'Blood glucose level in mg/dL; populated when measurement_type=glucose.']
  heart_rate_bpm decimal(6,2) [note: 'Heart rate in beats per minute; populated when measurement_type=heart_rate.']
  is_out_of_range_flag boolean
  loinc_code varchar [note: 'LOINC code corresponding to the measurement type for semantic interoperability.']
  measurement_type varchar [note: 'Type of measurement: heart_rate, glucose, spo2, weight, blood_pressure_systolic, blood_pressure_diastolic, temperature, respiratory_rate.']
  measurement_unit varchar [note: 'Unit of measure (e.g., bpm, mg/dL, %, kg, lbs, mmHg, degC, degF, breaths/min).']
  measurement_value decimal(12,4) [note: 'Numeric value of the measurement in the specified unit.']
  notes varchar [note: 'Free-text notes from the patient or clinician about this reading.']
  out_of_range_flag boolean [note: 'Whether the reading breached an alert threshold.']
  patient_reported_flag boolean [note: 'True if the reading was manually entered by the patient rather than auto-transmitted by device.']
  quality_flag boolean
  reading_date date [note: 'Calendar date of the reading, derived from reading_timestamp for partitioning.']
  reading_quality_flag varchar [note: 'Quality indicator for the reading: valid, artifact, out_of_range, device_error.']
  reading_timestamp timestamp [note: 'Timestamp when the measurement was taken by the device.']
  reading_type varchar [note: 'Vital type measured (heart_rate, glucose, spo2, weight, blood_pressure).']
  reading_unit varchar
  reading_value decimal(12,4)
  received_timestamp timestamp [note: 'Timestamp when the reading was received by the RPM platform.']
  respiratory_rate_bpm decimal(6,2) [note: 'Respiratory rate in breaths per minute.']
  reviewed_flag boolean
  reviewed_timestamp timestamp
  spo2_percent decimal(5,2) [note: 'Peripheral oxygen saturation percentage; populated when measurement_type=spo2.']
  systolic_bp varchar
  systolic_mmhg decimal(6,2) [note: 'Systolic blood pressure in mmHg.']
  temperature_celsius decimal(5,2) [note: 'Body temperature in degrees Celsius.']
  transmission_method varchar [note: 'How the reading was transmitted: bluetooth, cellular, wifi, manual_entry.']
  updated_timestamp timestamp [note: 'Record last-updated timestamp.']
  weight_kg decimal(8,3) [note: 'Body weight in kilograms; populated when measurement_type=weight.']

  Note: 'Stores individual sensor/device readings from Remote Patient Monitoring (RPM) devices including heart rate, glucose, SpO2, and weight. Each row represents a single measurement event transmitted from a patient-connected device.'
}

Table digital_health.digital_health_rpm_program_enrollment {
  digital_health_rpm_program_enrollment_id varchar [pk, note: 'Surrogate primary key for the RPM program enrollment record.']
  care_manager_employee_id varchar [note: 'FK to the care manager or nurse assigned to monitor this enrollment.']
  care_program_enrollment_id varchar [note: 'FK to the broader care program enrollment if RPM is part of a care management program.']
  care_site_id varchar [note: 'FK to the care site managing the RPM program.']
  demographics_id varchar
  insurance_coverage_id varchar [note: 'FK to the insurance coverage used for RPM billing.']
  mpi_record_id varchar [note: 'FK to patient MPI record.']
  rpm_clinician_id varchar [note: 'FK to the ordering/supervising clinician.']
  rpm_enrolling_clinician_id varchar
  adherence_rate decimal(5,4)
  billing_code varchar [note: 'CPT/HCPCS code used for RPM billing.']
  billing_eligible_flag boolean
  billing_month varchar [note: 'Billing month in YYYY-MM format for monthly RPM billing cycle tracking.']
  billing_threshold_met_flag boolean [note: 'Whether the minimum reading threshold for billing has been met this month.']
  condition_managed varchar
  consent_date date [note: 'Date RPM consent was obtained.']
  consent_document_reference varchar [note: 'Reference to the consent document in the document management system.']
  consent_obtained_flag boolean [note: 'Whether informed consent for RPM monitoring was obtained.']
  cpt_code_primary varchar [note: 'Primary CPT billing code for the RPM program (e.g., 99453, 99454, 99457, 99458).']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  device_identifier varchar [note: 'Primary device UDI or serial number assigned at enrollment.']
  device_issued_date date [note: 'Date devices were issued to patient.']
  device_issued_flag boolean [note: 'Whether monitoring devices were issued.']
  device_type_list varchar [note: 'Comma-separated list of device types assigned to this enrollment.']
  disenrollment_date date [note: 'Date the patient was disenrolled or completed the program.']
  disenrollment_reason varchar [note: 'Reason for disenrollment: completed, patient_withdrew, non_compliant, deceased, insurance_denied.']
  enrollment_date date [note: 'Date the patient was enrolled in the RPM program.']
  enrollment_status varchar [note: 'Current enrollment status: active, paused, completed, withdrawn, pending.']
  escalation_count varchar [note: 'Number of times readings triggered escalation to clinical staff.']
  expected_reading_frequency varchar
  last_clinician_review_date date [note: 'Date the supervising clinician last reviewed the RPM data.']
  last_reading_date date [note: 'Date of the most recent device reading received.']
  minimum_readings_per_month varchar [note: 'Minimum number of readings required per month for billing compliance (CMS requires 16 days/month for CPT 99454).']
  monitoring_duration_days decimal(9,4) [note: 'Total planned duration of the RPM program in days.']
  monitoring_frequency varchar [note: 'Expected reading cadence (daily, twice daily).']
  monitoring_frequency_days varchar [note: 'Expected frequency of readings in days (e.g., 1 = daily).']
  monthly_reimbursement_amount decimal(18,2)
  next_review_date date [note: 'Scheduled date for the next clinician review of RPM data.']
  patient_compliance_rate decimal(5,2) [note: 'Percentage of expected readings actually received, indicating patient compliance.']
  primary_diagnosis_icd10 varchar [note: 'Primary ICD-10 diagnosis code justifying RPM enrollment.']
  program_name varchar [note: 'Name of the RPM program (e.g., Cardiac RPM, Diabetes RPM, Hypertension Management).']
  program_type varchar [note: 'Type of RPM program: chronic_disease_management, post_discharge, preventive, oncology.']
  readings_this_month varchar [note: 'Count of qualifying readings received in the current billing month.']
  rpm_alert_threshold_id varchar [note: 'Default alert threshold set applied to this enrollment.']
  updated_timestamp timestamp [note: 'Record last-updated timestamp.']

  Note: 'Tracks patient enrollment in Remote Patient Monitoring (RPM) programs, including the devices assigned, monitoring parameters, billing codes, and program lifecycle dates.'
}

Table digital_health.digital_health_rpm_alert_threshold {
  digital_health_rpm_alert_threshold_id varchar [pk, note: 'Surrogate primary key for the alert threshold rule.']
  care_site_id varchar [note: 'FK to the care site that owns this threshold configuration.']
  mpi_record_id varchar [note: 'FK to patient MPI record; NULL for program-level defaults.']
  rpm_approved_by_clinician_id varchar [note: 'FK to the clinician who approved this threshold configuration.']
  rpm_clinician_id varchar [note: 'FK to the clinician who configured or approved this threshold.']
  rpm_created_by_clinician_id varchar [note: 'FK to the clinician who created this threshold.']
  rpm_notify_clinician_id varchar
  rpm_program_enrollment_id varchar [note: 'FK to the specific patient enrollment this threshold applies to; NULL if it is a program-level default.']
  rpm_set_by_clinician_id varchar [note: 'Clinician who configured the threshold.']
  alert_notification_method varchar [note: 'How alerts are delivered: in_app, sms, email, phone_call, ehr_inbox.']
  alert_recipient_role varchar [note: 'Role of the alert recipient: care_manager, attending_physician, on_call_nurse.']
  alert_severity varchar [note: 'Severity assigned when threshold is breached.']
  alert_severity_lower_critical varchar [note: 'Alert severity label for lower critical breach: critical, high, medium, low.']
  alert_severity_upper_critical varchar [note: 'Alert severity label for upper critical breach.']
  clinical_rationale decimal(9,4) [note: 'Free-text clinical rationale for the threshold values.']
  consecutive_readings_required varchar [note: 'Number of consecutive out-of-range readings required before triggering an alert (reduces false positives).']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  effective_end_date date [note: 'Date this threshold rule expires or was superseded.']
  effective_start_date date [note: 'Date this threshold rule became effective.']
  escalation_rule varchar
  high_critical_value decimal(12,4)
  high_warning_value decimal(12,4)
  is_active boolean [note: 'Whether this threshold rule is currently active.']
  is_active_flag boolean
  loinc_code varchar
  low_critical_value decimal(12,4)
  low_warning_value decimal(12,4)
  lower_critical_value decimal(12,4) [note: 'Lower critical threshold; readings below this value trigger a critical alert.']
  lower_warning_value decimal(12,4) [note: 'Lower warning threshold; readings below this value trigger a warning alert.']
  measurement_type varchar [note: 'Measurement type this threshold applies to: heart_rate, glucose, spo2, weight, blood_pressure_systolic, blood_pressure_diastolic, temperature, respiratory_rate.']
  measurement_unit varchar [note: 'Unit of measure for the threshold values (e.g., bpm, mg/dL, %, kg, mmHg).']
  reading_type varchar [note: 'Vital type the threshold governs.']
  suppression_window_minutes varchar [note: 'Minimum minutes between repeated alerts for the same threshold breach to prevent alert fatigue.']
  threshold_scope varchar [note: 'Scope of the threshold: patient_specific or program_default.']
  threshold_unit varchar [note: 'Unit of measure for threshold bounds.']
  unit varchar
  updated_timestamp timestamp [note: 'Record last-updated timestamp.']
  upper_critical_value decimal(12,4) [note: 'Upper critical threshold; readings above this value trigger a critical alert.']
  upper_warning_value decimal(12,4) [note: 'Upper warning threshold; readings above this value trigger a warning alert.']

  Note: 'Defines alert threshold rules for RPM device readings. Each row specifies the upper/lower bounds for a measurement type that, when exceeded, trigger clinical alerts for a patient or program.'
}

Table digital_health.digital_health_prom_response {
  digital_health_prom_response_id varchar [pk, note: 'Surrogate primary key for the PROM response record.']
  baseline_response_id varchar [note: 'Self-referential FK to the baseline PROM response for longitudinal comparison.']
  care_site_id varchar [note: 'FK to the care site associated with this PROM collection.']
  clinician_id varchar [note: 'FK to the clinician who ordered or is associated with this PROM.']
  demographics_id varchar
  fhir_resource_log_id varchar [note: 'FHIR QuestionnaireResponse resource ID for interoperability.']
  mpi_record_id varchar [note: 'FK to patient MPI record.']
  rpm_program_enrollment_id varchar [note: 'FK to RPM enrollment if PROM is part of an RPM program.']
  scheduling_appointment_id varchar [note: 'FK to the appointment associated with this PROM collection.']
  visit_id varchar [note: 'FK to the encounter during which the PROM was collected, if applicable.']
  administered_timestamp timestamp [note: 'When the PROM was administered.']
  administration_method varchar
  administration_mode varchar [note: 'How the PROM was administered (portal, tablet, phone).']
  alert_triggered_flag boolean [note: 'Whether the PROM score triggered a clinical alert (e.g., PHQ-9 >= 10 triggers depression follow-up).']
  alert_type varchar [note: 'Type of alert triggered: depression_screen_positive, suicide_risk, functional_decline, pain_escalation.']
  assessment_date date
  collection_date date [note: 'Date the PROM was completed.']
  collection_method varchar [note: 'How the PROM was collected: patient_portal, tablet_kiosk, phone_ivr, paper_scan, rpm_app, email_link.']
  collection_setting varchar [note: 'Setting of collection: pre_visit, post_visit, remote, inpatient, post_discharge.']
  collection_timestamp timestamp [note: 'Timestamp when the patient completed the PROM.']
  completed_timestamp timestamp [note: 'When the patient completed the PROM.']
  completion_rate_pct decimal(5,2) [note: 'Percentage of questions answered (for partial responses).']
  completion_status varchar
  created_timestamp timestamp [note: 'Record creation timestamp.']
  domain_fatigue_score decimal(8,2) [note: 'Domain-specific score for fatigue subscale.']
  domain_mental_health_score decimal(8,2) [note: 'Domain-specific score for mental health subscale.']
  domain_pain_score decimal(8,2) [note: 'Domain-specific score for pain subscale.']
  domain_physical_function_score decimal(8,2) [note: 'Domain-specific score for physical function subscale.']
  domain_social_participation_score decimal(8,2) [note: 'Domain-specific score for social participation subscale.']
  follow_up_completed_flag boolean [note: 'Whether the required follow-up was completed.']
  follow_up_required_flag boolean [note: 'Whether clinical follow-up is required based on the PROM score.']
  gad7_total_score varchar [note: 'GAD-7 total score (0-21); populated when instrument_name=GAD-7.']
  instrument_category varchar [note: 'Category of PROM: generic_hrqol, disease_specific, functional_status, mental_health, pain, satisfaction.']
  instrument_code varchar [note: 'PROM instrument code (e.g. PROMIS-29).']
  instrument_loinc_code varchar [note: 'LOINC panel code for the PROM instrument.']
  instrument_name varchar [note: 'Name of the PROM instrument (e.g., PROMIS-29, KOOS, HOOS, VR-12, PHQ-9, GAD-7, DASH, ODI).']
  instrument_version varchar [note: 'Version of the PROM instrument used.']
  language_code varchar [note: 'Language in which the PROM was administered.']
  loinc_code varchar
  mcid_threshold_met_flag boolean [note: 'Whether the score change meets the Minimal Clinically Important Difference (MCID) threshold.']
  phq9_total_score varchar [note: 'PHQ-9 total score (0-27); populated when instrument_name=PHQ-9.']
  proxy_completed_flag boolean [note: 'Whether the PROM was completed by a proxy (caregiver) rather than the patient.']
  question_code varchar
  question_text varchar
  raw_score decimal(10,4) [note: 'Computed raw score for the response/instrument.']
  response_numeric_score decimal(10,4)
  response_status varchar [note: 'Status of the PROM response: completed, partial, not_started, expired, declined.']
  response_timestamp timestamp
  response_value decimal(18,2)
  score_change_from_baseline decimal(10,4) [note: 'Change in score from the patient\'s baseline PROM for this instrument.']
  score_interpretation varchar [note: 'Clinical interpretation of the score: normal, mild, moderate, severe, minimal.']
  t_score decimal(8,2) [note: 'T-score (standardized score with mean=50, SD=10) for PROMIS instruments.']
  total_score decimal(10,4) [note: 'Total or summary score for the PROM instrument.']
  updated_timestamp timestamp [note: 'Record last-updated timestamp.']

  Note: 'Stores Patient-Reported Outcome Measure (PROM) responses. Each row represents a patient\'s response to a validated PROM instrument (e.g., PROMIS, KOOS, HOOS, VR-12, PHQ-9, GAD-7) at a specific point in time.'
}

Table digital_health.digital_health_portal_engagement_event {
  digital_health_portal_engagement_event_id varchar [pk, note: 'Surrogate primary key for the portal engagement event.']
  care_site_id varchar [note: 'FK to the care site context of the engagement event.']
  communication_campaign_id varchar [note: 'FK to the communication campaign that drove this portal engagement.']
  demographics_id varchar
  message_recipient_clinician_id varchar [note: 'FK to the clinician who received or sent the portal message.']
  message_thread_id varchar [note: 'Identifier of the secure message thread, if event_type is message-related.']
  mpi_record_id varchar [note: 'FK to patient MPI record.']
  portal_account_id varchar [note: 'FK to the patient portal account that generated this event.']
  prom_response_id varchar [note: 'FK to the PROM response if event_type=prom_completed.']
  proxy_access_id varchar [note: 'FK to the proxy access record if this was a proxy session.']
  rpm_device_reading_id varchar [note: 'FK to the RPM reading if event_type=rpm_data_viewed.']
  scheduling_appointment_id varchar [note: 'FK to the appointment if the event is appointment-related.']
  session_id varchar [note: 'Portal session identifier grouping multiple events in a single user session.']
  test_result_lab_order_id varchar [note: 'FK to the lab order whose result was viewed.']
  visit_id varchar [note: 'FK to the encounter associated with this event, if applicable.']
  appointment_action_flag boolean
  bill_pay_action_flag boolean
  browser_type varchar [note: 'Browser or app version used to access the portal.']
  channel varchar
  created_timestamp timestamp [note: 'Record creation timestamp in the data lakehouse.']
  device_type varchar [note: 'Device type used to access the portal: desktop, mobile_web, ios_app, android_app, tablet.']
  document_type varchar [note: 'Type of document uploaded or downloaded: after_visit_summary, lab_result, imaging_report, care_plan, insurance_card.']
  duration_seconds varchar
  error_code varchar [note: 'Error code if event_status=failed.']
  error_description varchar [note: 'Description of the error if event_status=failed.']
  event_category varchar [note: 'High-level category: authentication, messaging, scheduling, clinical_data, billing, documents, prom, rpm, account_management.']
  event_date date [note: 'Calendar date of the event for partitioning and daily aggregation.']
  event_status varchar [note: 'Outcome of the event: success, failed, abandoned, timeout.']
  event_timestamp timestamp [note: 'Timestamp when the portal engagement event occurred.']
  event_type varchar [note: 'Type of portal engagement event: login, logout, message_sent, message_read, appointment_scheduled, appointment_cancelled, appointment_rescheduled, test_result_viewed, medication_list_viewed, care_plan_viewed, rx_renewal_requested, bill_paid, bill_viewed, document_uploaded, document_downloaded, prom_completed, rpm_data_viewed, proxy_access_used, account_settings_updated, notification_preference_updated.']
  feature_name varchar [note: 'Specific feature or module used (e.g., MyChart Messaging, Test Results, Appointments).']
  ip_address varchar
  ip_address_hash varchar [note: 'Hashed IP address for security auditing without storing raw PII.']
  is_proxy_session boolean [note: 'Whether the session was conducted by a proxy/delegate rather than the patient.']
  message_sent_flag boolean
  notification_channel varchar [note: 'Channel through which the patient was notified to take this portal action: email, sms, push_notification, none.']
  page_name varchar [note: 'Name of the portal page or feature where the event occurred.']
  page_or_feature varchar
  result_viewed_flag boolean
  session_duration_seconds decimal(9,4) [note: 'Duration of the portal session in seconds.']
  session_end_timestamp timestamp [note: 'Timestamp when the portal session ended.']
  session_start_timestamp timestamp [note: 'Timestamp when the portal session started.']
  success_flag boolean [note: 'Whether the interaction succeeded.']
  updated_timestamp timestamp [note: 'Record last-updated timestamp.']

  Note: 'Captures patient portal engagement events and metrics. Each row represents a discrete patient interaction with the patient portal (e.g., login, message sent, appointment scheduled, test result viewed, prescription renewal requested), enabling engagement analytics and outreach optimization.'
}

Table digital_health.rpm_enrollment {
  rpm_enrollment_id varchar [pk, note: 'Primary key for rpm_enrollment']
  rpm_program_enrollment_id varchar [note: 'Foreign key linking to digital_health.digital_health_rpm_program_enrollment. Business justification: rpm_enrollment is a completely siloed table containing only its PK with no inbound or outbound FK. It is described as \'RPM program enrollment and alert thresholds\', which is the same business concept ']

  Note: 'RPM program enrollment and alert thresholds'
}

Table digital_health.portal_session {
  portal_session_id varchar [pk, note: 'Primary key for portal_session']
  care_site_id varchar [note: 'Reference to the health system facility or organization context associated with the portal session.']
  mpi_record_id varchar [note: 'Reference to the patient master record (MPI) for whom this portal session was established.']
  previous_portal_session_id varchar [note: 'Self-referencing FK on portal_session (previous_portal_session_id)']
  user_account_id varchar [note: 'Reference to the portal user account that authenticated for this session (may be patient, proxy, or caregiver).']
  access_channel varchar [note: 'The interface channel through which the portal was accessed (distinct from device type).']
  authentication_method varchar [note: 'The mechanism used to authenticate the user at session start.']
  browser_name varchar [note: 'Web browser name and version used for the portal session, where applicable.']
  consent_acknowledged_flag boolean [note: 'Indicates whether required terms-of-use or privacy consent was acknowledged during the session.']
  device_identifier varchar [note: 'Unique identifier of the device used for the session, supporting trusted-device and fraud-detection workflows.']
  device_type varchar [note: 'Category of physical device used to access the patient portal.']
  failed_login_attempts varchar [note: 'Number of failed authentication attempts preceding this successful session, supporting security monitoring.']
  geo_country varchar [note: 'ISO 3166-1 alpha-3 country code derived from the session source IP for access-pattern monitoring.']
  geo_region varchar [note: 'State, province, or region inferred from the session source IP location.']
  ip_address varchar [note: 'Source IP address from which the portal session originated, used for access auditing and geolocation.']
  last_activity_timestamp timestamp [note: 'Timestamp of the most recent user interaction within the session, used to enforce inactivity timeout policies.']
  locale_preference varchar [note: 'Language and locale setting (e.g., en-US, es-US) used during the portal session for accessibility and personalization.']
  login_timestamp timestamp [note: 'The principal real-world event time when the portal session was initiated via successful authentication.']
  logout_timestamp timestamp [note: 'Timestamp when the session was explicitly ended by the user via logout. Nullable for sessions ended by timeout or system.']
  mfa_completed boolean [note: 'Indicates whether multi-factor authentication was successfully completed during this session.']
  operating_system varchar [note: 'Operating system and version reported by the accessing device.']
  page_view_count varchar [note: 'Number of distinct portal pages or screens viewed during the session, supporting engagement analytics.']
  phi_accessed_flag boolean [note: 'Indicates whether Protected Health Information was viewed or accessed during this session, driving HIPAA audit logging.']
  primary_activity_type varchar [note: 'The dominant functional activity the user performed during the session.']
  proxy_access_flag boolean [note: 'Indicates whether the session was conducted by an authorized proxy (e.g., parent, guardian, caregiver) rather than the patient directly.']
  proxy_relationship varchar [note: 'The relationship of the acting user to the patient when proxy access is used.']
  session_created_timestamp timestamp [note: 'Timestamp when the session record was first captured in the system.']
  session_duration_seconds varchar [note: 'Total elapsed time in seconds between login and session termination, supporting engagement and access analytics.']
  session_expiry_timestamp timestamp [note: 'Timestamp at which the session token expires and re-authentication is required.']
  session_status varchar [note: 'Current lifecycle state of the portal session.']
  session_token varchar [note: 'Opaque externally-issued session token / business key used to reference this portal session across systems.']
  session_updated_timestamp timestamp [note: 'Timestamp when the session record was last modified.']
  termination_reason varchar [note: 'The business reason the session ended, supporting security and user-experience analysis.']
  user_agent varchar [note: 'Full user-agent header captured from the client, supporting compatibility and security analytics.']

  Note: 'Master reference table for portal_session. Referenced by session_id.'
}

Table digital_health.secure_message_thread {
  secure_message_thread_id varchar [pk, note: 'Primary key for secure_message_thread']
  care_site_id varchar [note: 'Identifier of the facility or practice location that owns or routes the messaging thread within a multi-facility health system.']
  care_team_id varchar [note: 'Identifier of the care team the thread is routed to, enabling shared-inbox group messaging and coverage.']
  clinician_id varchar [note: 'Identifier of the clinician or care team member currently responsible for responding to the thread.']
  employee_id varchar [note: 'Identifier of the party (patient, provider, or care team member) who originated the conversation thread.']
  mpi_record_id varchar [note: 'Identifier of the patient who is the subject of and a participant in the secure messaging thread.']
  parent_secure_message_thread_id varchar [note: 'Self-referencing FK on secure_message_thread (parent_secure_message_thread_id)']
  visit_id varchar [note: 'Identifier of the clinical encounter that this messaging thread is associated with or arose from, if any.']
  channel varchar [note: 'The interface/channel through which the secure conversation is conducted.']
  closed_reason varchar [note: 'Categorical reason describing why the thread was closed, supporting quality and operations reporting.']
  consent_on_file boolean [note: 'Indicates whether documented patient consent for secure electronic messaging is on file, required for compliant communication.']
  created_at timestamp [note: 'Timestamp when this thread record was first captured in the source system.']
  escalation_status varchar [note: 'Current escalation state of the thread when response SLAs are at risk or breached, supporting triage workflows.']
  first_response_at timestamp [note: 'Timestamp of the first provider response, used to measure response time against patient-engagement SLAs.']
  has_attachment boolean [note: 'Indicates whether any message in the thread includes a file attachment such as a document or image.']
  is_archived boolean [note: 'Indicates whether the thread has been archived out of active inboxes while retained for compliance.']
  is_clinical boolean [note: 'Indicates whether the thread contains clinical content requiring licensed clinician review versus purely administrative content.']
  language_code varchar [note: 'ISO 639-1 language code of the conversation, supporting patient communication preferences and interpreter needs.']
  last_message_at timestamp [note: 'Timestamp of the most recent message in the thread, used for inbox sorting and stale-thread detection.']
  message_count varchar [note: 'Total number of individual messages exchanged within the thread, used for engagement and workload analytics.']
  opened_at timestamp [note: 'Timestamp when the secure conversation thread was first opened/initiated.']
  priority varchar [note: 'Clinical priority assigned to the thread, influencing response SLA and provider triage queues.']
  requires_response boolean [note: 'Flags whether an outstanding response is awaited from a provider, used for SLA monitoring and escalation.']
  resolved_at timestamp [note: 'Timestamp when the thread was marked resolved or closed by the responsible clinician.']
  response_due_at timestamp [note: 'Timestamp by which a response is required to meet the service-level commitment for the assigned priority.']
  retention_expiry_date date [note: 'Date when the thread becomes eligible for purge under the applicable HIPAA medical-record retention policy.']
  sensitivity_level varchar [note: 'Confidentiality sensitivity classification controlling who may view the thread (e.g., behavioral health, HIV, substance use special protections).']
  subject_category varchar [note: 'Standardized clinical or administrative topic of the thread used for routing and reporting. [ENUM-REF-CANDIDATE: medication|symptom|lab_result|referral|insurance|scheduling|general_question|test_results|care_plan — promote to reference product]']
  thread_reference_number varchar [note: 'Externally-known human-facing reference number for the conversation, surfaced in the patient portal and clinician inbox for cross-system traceability.']
  thread_status varchar [note: 'Current state of the conversation within its lifecycle, used for inbox triage and SLA tracking.']
  thread_subject varchar [note: 'Human-readable subject or title of the secure message conversation; may reference clinical context and is therefore treated as PHI under HIPAA.']
  thread_type varchar [note: 'Categorical classification segmenting threads by their primary business purpose to drive routing and analytics.']
  unread_count varchar [note: 'Number of unread messages in the thread for the currently responsible recipient, driving inbox notification badges.']
  updated_at timestamp [note: 'Timestamp when this thread record was last modified in the source system.']

  Note: 'Master reference table for secure_message_thread. Referenced by message_thread_id.'
}

// --- Foreign Key References ---
Ref: patient.mpi_record.care_site_id > facility.care_site.care_site_id
Ref: patient.mpi_record.surviving_mpi_record_id > patient.mpi_record.mpi_record_id
Ref: patient.demographics.mpi_record_id > patient.mpi_record.mpi_record_id
Ref: patient.address.demographics_id > patient.demographics.demographics_id
Ref: patient.address.geographic_region_id > reference.geographic_region.geographic_region_id
Ref: patient.address.mpi_record_id > patient.mpi_record.mpi_record_id
Ref: patient.address.sdoh_referral_id > patient.sdoh_referral.sdoh_referral_id
