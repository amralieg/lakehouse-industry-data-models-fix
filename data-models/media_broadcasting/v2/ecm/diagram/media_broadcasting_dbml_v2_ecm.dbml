Table audience.dsp_usage_report {
  dsp_usage_report_id varchar [pk, note: 'Primary key for DSP usage report']
  master_recording_id varchar [note: 'FK to content.master_recording']
  release_id varchar [note: 'FK to content.release']
  album_upc varchar [note: 'UPC of the parent album/release']
  artist_name varchar [note: 'Artist name as reported by DSP']
  created_at timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'ISO currency code']
  dsp_name varchar [note: 'Name of the DSP: SPOTIFY, APPLE_MUSIC, YOUTUBE_MUSIC, AMAZON_MUSIC, TIDAL, DEEZER']
  isrc varchar [note: 'International Standard Recording Code for the track']
  per_stream_rate decimal(18,2) [note: 'Calculated per-stream rate']
  playlist_add_count varchar [note: 'Number of playlist additions']
  report_period_end date [note: 'End date of the reporting period']
  report_period_start date [note: 'Start date of the reporting period']
  report_received_at timestamp [note: 'When the report was received from DSP']
  reporting_period_end date [note: 'End date of the reporting period']
  reporting_period_start date [note: 'Start date of the reporting period']
  revenue_amount decimal(18,2) [note: 'Revenue amount for the streams']
  revenue_currency varchar [note: 'ISO 4217 currency code']
  revenue_share_amount decimal(18,2) [note: 'Revenue share amount for the period']
  save_count varchar [note: 'Number of saves/likes']
  skip_count varchar [note: 'Number of skips before 30 seconds']
  stream_count varchar [note: 'Number of streams in the period']
  stream_type varchar [note: 'Type: ON_DEMAND, RADIO, PLAYLIST, ALGORITHMIC']
  subscription_tier varchar [note: 'User tier: PREMIUM, FREE_AD_SUPPORTED, FAMILY, STUDENT']
  territory_code varchar [note: 'ISO 3166-1 alpha-2 country code']
  track_title varchar [note: 'Title of the track']
  unique_listeners varchar [note: 'Unique listener count if provided']
  updated_at timestamp [note: 'Record last update timestamp']

  Note: 'Digital streaming platform usage report capturing ISRC-keyed streaming counts from services like Spotify, Apple Music, and YouTube Music for royalty calculation and audience measurement'
}

