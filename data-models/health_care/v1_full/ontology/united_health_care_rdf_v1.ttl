    rdfs:comment 'Amount paid by Medicaid for dual-eligible members where Medicaid provides supplemental coverage.' ;
    rdfs:domain ind:ProgramClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentReasonCodes rdf:type rdf:Property ;
