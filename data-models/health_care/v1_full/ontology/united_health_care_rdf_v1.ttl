ind:daysToResolution rdf:type rdf:Property ;
    rdfs:label 'Days To Resolution' ;
    rdfs:comment 'Number of calendar days from dispute filing to resolution.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:businessDaysToResolution rdf:type rdf:Property ;
    rdfs:label 'Business Days To Resolution' ;
    rdfs:comment 'Number of business days from dispute filing to resolution.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reopenedFlag rdf:type rdf:Property ;
    rdfs:label 'Reopened Flag' ;
    rdfs:comment 'Indicates whether the dispute was reopened after initial closure.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incentiveId rdf:type rdf:Property ;
    rdfs:label 'Incentive Id' ;
    rdfs:comment 'Unique identifier for the contract incentive or bonus structure record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Incentive .

ind:thresholdType rdf:type rdf:Property ;
    rdfs:label 'Threshold Type' ;
    rdfs:comment 'Type of performance threshold structure used to determine incentive eligibility and payment amount.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumIncentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Incentive Amount' ;
    rdfs:comment 'Minimum dollar amount that will be paid if the threshold is met, regardless of calculation method.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceMetricCode rdf:type rdf:Property ;
    rdfs:label 'Performance Metric Code' ;
    rdfs:comment 'Standardized code identifying the specific performance metric being measured (e.g., HEDIS measure code, CMS quality measure ID).' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceMetricDescription rdf:type rdf:Property ;
    rdfs:label 'Performance Metric Description' ;
    rdfs:comment 'Detailed description of what the performance metric measures and how it is calculated.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementSteward rdf:type rdf:Property ;
    rdfs:label 'Measurement Steward' ;
    rdfs:comment 'Organization responsible for developing and maintaining the performance measure (e.g., NCQA, CMS, NQF).' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselinePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Period Start Date' ;
    rdfs:comment 'Start date of the period used to establish the baseline performance value.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baselinePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Period End Date' ;
    rdfs:comment 'End date of the period used to establish the baseline performance value.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stretchTargetValue rdf:type rdf:Property ;
    rdfs:label 'Stretch Target Value' ;
    rdfs:comment 'Aspirational performance value beyond the standard target that may earn additional incentive payment.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligiblePopulationCriteria rdf:type rdf:Property ;
    rdfs:label 'Eligible Population Criteria' ;
    rdfs:comment 'Criteria defining the member population included in the performance measurement (e.g., age range, diagnosis codes, LOB).' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicApplicability rdf:type rdf:Property ;
    rdfs:label 'Geographic Applicability' ;
    rdfs:comment 'Geographic regions or service areas where this incentive applies (e.g., state codes, county codes, market regions).' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyApplicability rdf:type rdf:Property ;
    rdfs:label 'Specialty Applicability' ;
    rdfs:comment 'Provider specialties to which this incentive applies (e.g., cardiology, endocrinology, primary care).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingLagDays rdf:type rdf:Property ;
    rdfs:label 'Reporting Lag Days' ;
    rdfs:comment 'Number of days after the reporting period end date before performance results are made available to the provider.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualityGateRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Gate Required Flag' ;
    rdfs:comment 'Indicates whether the provider must meet minimum quality performance thresholds to be eligible for cost-based incentives.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityGateThreshold rdf:type rdf:Property ;
    rdfs:label 'Quality Gate Threshold' ;
    rdfs:comment 'Minimum quality performance score or percentile that must be achieved to pass the quality gate and be eligible for incentive payment.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeScoreWeight rdf:type rdf:Property ;
    rdfs:label 'Composite Score Weight' ;
    rdfs:comment 'Weight or percentage contribution of this incentive metric to an overall composite performance score.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierThresholdLower rdf:type rdf:Property ;
    rdfs:label 'Tier Threshold Lower' ;
    rdfs:comment 'Lower boundary of the performance range for this tier level in a tiered incentive structure.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierThresholdUpper rdf:type rdf:Property ;
    rdfs:label 'Tier Threshold Upper' ;
    rdfs:comment 'Upper boundary of the performance range for this tier level in a tiered incentive structure.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Tier Payment Amount' ;
    rdfs:comment 'Incentive payment amount associated with achieving performance within this tier level.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdPoolAmount rdf:type rdf:Property ;
    rdfs:label 'Withhold Pool Amount' ;
    rdfs:comment 'Total dollar amount withheld in the pool that is available for distribution based on incentive achievement.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryoverAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Carryover Allowed Flag' ;
    rdfs:comment 'Indicates whether unearned or undistributed incentive amounts can be carried over to subsequent measurement periods.' ;
    rdfs:domain ind:Incentive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractPaymentScheduleId rdf:type rdf:Property ;
    rdfs:label 'Contract Payment Schedule Id' ;
    rdfs:comment 'Unique identifier for the contract payment schedule record. Primary key for the payment schedule entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContractPaymentSchedule .

ind:scheduleSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Sequence Number' ;
    rdfs:comment 'Sequential number indicating the order of this payment within the overall contract payment schedule. Used to track payment milestones chronologically.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentStatusDate rdf:type rdf:Property ;
    rdfs:label 'Payment Status Date' ;
    rdfs:comment 'The date when the payment reached its current status. Used for tracking payment lifecycle progression and audit purposes.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualityIncentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Quality Incentive Amount' ;
    rdfs:comment 'The monetary amount of incentive payment earned based on quality performance metrics. Component of value-based payment arrangements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sharedSavingsAmount rdf:type rdf:Property ;
    rdfs:label 'Shared Savings Amount' ;
    rdfs:comment 'The calculated monetary amount of shared savings payment to be made to the provider based on achieved cost reductions and quality performance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdReleaseDate rdf:type rdf:Property ;
    rdfs:label 'Withhold Release Date' ;
    rdfs:comment 'The date on which withheld funds are scheduled to be released to the provider, subject to performance criteria being met.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyReasonCode rdf:type rdf:Property ;
    rdfs:label 'Penalty Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for penalty assessment. Used for tracking and reporting contract compliance issues.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Penalty Reason Description' ;
    rdfs:comment 'Detailed textual explanation of why a penalty was assessed against the payment.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationFlag rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Flag' ;
    rdfs:comment 'Indicator of whether this payment requires or has undergone reconciliation. Used to track payments that need adjustment based on actual utilization or performance.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Approval Required Flag' ;
    rdfs:comment 'Indicator of whether this payment requires explicit approval before processing. Used for high-value or exceptional payments requiring additional oversight.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Payment Approved By' ;
    rdfs:comment 'Identifier or name of the individual who approved the payment for processing. Used for audit trail and accountability.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentProcessedBy rdf:type rdf:Property ;
    rdfs:label 'Payment Processed By' ;
    rdfs:comment 'Identifier or name of the individual or system that processed the payment. Used for audit trail and operational tracking.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentProcessingDate rdf:type rdf:Property ;
    rdfs:label 'Payment Processing Date' ;
    rdfs:comment 'The date on which the payment was submitted for processing through the payment system. Distinct from actual payment date.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentBatchId rdf:type rdf:Property ;
    rdfs:label 'Payment Batch Id' ;
    rdfs:comment 'Identifier of the payment batch in which this payment was processed. Used for grouping payments processed together.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Batch .

ind:autoPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Payment Flag' ;
    rdfs:comment 'Indicator of whether this payment is processed automatically without manual intervention. Used for routine scheduled payments.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentHoldFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Hold Flag' ;
    rdfs:comment 'Indicator of whether this payment is currently on hold and should not be processed. Used to temporarily suspend payments pending investigation or resolution.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentHoldDate rdf:type rdf:Property ;
    rdfs:label 'Payment Hold Date' ;
    rdfs:comment 'The date on which the payment was placed on hold. Used for tracking hold duration.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentReleaseDate rdf:type rdf:Property ;
    rdfs:label 'Payment Release Date' ;
    rdfs:comment 'The date on which a held payment was released for processing. Used for tracking hold resolution.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:latePaymentPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty Amount' ;
    rdfs:comment 'The monetary penalty assessed for late payment beyond the due date. Separate from interest charges.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earlyPaymentDiscountPercentage rdf:type rdf:Property ;
    rdfs:label 'Early Payment Discount Percentage' ;
    rdfs:comment 'The percentage discount offered for early payment before the scheduled date. Incentive for accelerated payment.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earlyPaymentDiscountAmount rdf:type rdf:Property ;
    rdfs:label 'Early Payment Discount Amount' ;
    rdfs:comment 'The calculated monetary discount applied for early payment.' ;
    rdfs:domain ind:ContractPaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceRequirementId rdf:type rdf:Property ;
    rdfs:label 'Compliance Requirement Id' ;
    rdfs:comment 'Unique identifier for the compliance requirement record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceRequirement .

ind:requirementCode rdf:type rdf:Property ;
    rdfs:label 'Requirement Code' ;
    rdfs:comment 'Unique business code or reference number assigned to the compliance requirement for tracking and reporting purposes.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementName rdf:type rdf:Property ;
    rdfs:label 'Requirement Name' ;
    rdfs:comment 'Short descriptive name of the compliance requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementDescription rdf:type rdf:Property ;
    rdfs:label 'Requirement Description' ;
    rdfs:comment 'Detailed description of the compliance requirement including scope, applicability, and specific obligations.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementType rdf:type rdf:Property ;
    rdfs:label 'Requirement Type' ;
    rdfs:comment 'Classification of the compliance requirement based on its origin and nature (e.g., regulatory mandate, contractual obligation, internal policy).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementCategory rdf:type rdf:Property ;
    rdfs:label 'Requirement Category' ;
    rdfs:comment 'Functional category or domain area to which the compliance requirement applies.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableProductType rdf:type rdf:Property ;
    rdfs:label 'Applicable Product Type' ;
    rdfs:comment 'Specific insurance product types subject to this requirement (e.g., HMO, PPO, EPO, POS, HDHP, MA-PD, D-SNP). Multiple product types may be pipe-separated.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDueDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Due Date' ;
    rdfs:comment 'Target date by which the organization must achieve compliance with this requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Assessment Date' ;
    rdfs:comment 'Date when the compliance requirement was last assessed or audited for adherence.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Next Assessment Date' ;
    rdfs:comment 'Scheduled date for the next compliance assessment or audit of this requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingDeadline rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline' ;
    rdfs:comment 'Specific deadline or timeframe for submitting compliance reports (e.g., \'60 days after quarter end\', \'March 31 annually\').' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyForNonCompliance rdf:type rdf:Property ;
    rdfs:label 'Penalty For Non Compliance' ;
    rdfs:comment 'Description of penalties, fines, sanctions, or consequences for failing to meet this compliance requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Risk Impact Description' ;
    rdfs:comment 'Detailed description of the potential business, financial, operational, or reputational impact if this requirement is not met.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleRole rdf:type rdf:Property ;
    rdfs:label 'Responsible Role' ;
    rdfs:comment 'Job title or role of the individual accountable for this compliance requirement (e.g., Chief Compliance Officer, Privacy Officer, Quality Director).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationContact rdf:type rdf:Property ;
    rdfs:label 'Escalation Contact' ;
    rdfs:comment 'Name or role of the person to escalate compliance issues or questions to.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditRequired rdf:type rdf:Property ;
    rdfs:label 'External Audit Required' ;
    rdfs:comment 'Indicates whether an external audit or third-party assessment is required for this compliance requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverGranted rdf:type rdf:Property ;
    rdfs:label 'Waiver Granted' ;
    rdfs:comment 'Indicates whether a waiver or exemption from this compliance requirement has been granted by the regulatory authority.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Expiration Date' ;
    rdfs:comment 'Date when the granted waiver or exemption expires.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverJustification rdf:type rdf:Property ;
    rdfs:label 'Waiver Justification' ;
    rdfs:comment 'Business or operational justification for requesting or receiving a waiver from this requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedPolicyDocument rdf:type rdf:Property ;
    rdfs:label 'Related Policy Document' ;
    rdfs:comment 'Reference to internal policy, procedure, or standard operating procedure document that addresses this compliance requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedSystem rdf:type rdf:Property ;
    rdfs:label 'Related System' ;
    rdfs:comment 'Name of the IT system, application, or platform that supports compliance with this requirement (e.g., Facets, QNXT, Salesforce).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyPerformanceIndicator rdf:type rdf:Property ;
    rdfs:label 'Key Performance Indicator' ;
    rdfs:comment 'Specific metric or KPI used to measure compliance performance for this requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetThreshold rdf:type rdf:Property ;
    rdfs:label 'Target Threshold' ;
    rdfs:comment 'Target value or threshold that must be met to demonstrate compliance (e.g., \'95% accuracy\', \'within 30 days\').' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentPerformanceValue rdf:type rdf:Property ;
    rdfs:label 'Current Performance Value' ;
    rdfs:comment 'Most recent measured performance value against the compliance KPI or threshold.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceMeasurementDate rdf:type rdf:Property ;
    rdfs:label 'Performance Measurement Date' ;
    rdfs:comment 'Date when the current performance value was measured or calculated.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varianceFromTarget rdf:type rdf:Property ;
    rdfs:label 'Variance From Target' ;
    rdfs:comment 'Calculated difference between current performance and target threshold, indicating compliance gap or surplus.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Implementation Cost Estimate' ;
    rdfs:comment 'Estimated cost to implement controls, processes, or systems to achieve compliance with this requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ongoingComplianceCost rdf:type rdf:Property ;
    rdfs:label 'Ongoing Compliance Cost' ;
    rdfs:comment 'Estimated annual or recurring cost to maintain compliance with this requirement (e.g., monitoring, reporting, audits).' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Cost Currency Code' ;
    rdfs:comment 'ISO 4217 currency code for cost estimates.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByRequirementCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Requirement Code' ;
    rdfs:comment 'Code of the compliance requirement that supersedes or replaces this requirement, if applicable.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedRequirementCodes rdf:type rdf:Property ;
    rdfs:label 'Related Requirement Codes' ;
    rdfs:comment 'Pipe-separated list of related or dependent compliance requirement codes that are connected to this requirement.' ;
    rdfs:domain ind:ComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:negotiationId rdf:type rdf:Property ;
    rdfs:label 'Negotiation Id' ;
    rdfs:comment 'Unique identifier for the contract negotiation record. Primary key for tracking negotiation events, proposals, and outcomes.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:round rdf:type rdf:Property ;
    rdfs:label 'Round' ;
    rdfs:comment 'Sequential number indicating which round of negotiation this event represents (1 for initial proposal, 2 for first counter-offer, etc.).' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responseReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Response Received Date' ;
    rdfs:comment 'Date when a response to this negotiation event was received from the counterparty.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectedDate rdf:type rdf:Property ;
    rdfs:label 'Rejected Date' ;
    rdfs:comment 'Date when this negotiation event was rejected by either party.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:respondingParty rdf:type rdf:Property ;
    rdfs:label 'Responding Party' ;
    rdfs:comment 'Identifies which party is expected to respond to this negotiation event.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedRateType rdf:type rdf:Property ;
    rdfs:label 'Proposed Rate Type' ;
    rdfs:comment 'Type of rate structure proposed in this negotiation event, such as flat rate, percentage of Medicare, percentage of charges, custom fee schedule, Per Member Per Month (PMPM), case rate, per diem, or bundled rate.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedRateValue rdf:type rdf:Property ;
    rdfs:label 'Proposed Rate Value' ;
    rdfs:comment 'Numeric value of the proposed rate in this negotiation event. Interpretation depends on proposed_rate_type (e.g., dollar amount, percentage, PMPM amount).' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentRateValue rdf:type rdf:Property ;
    rdfs:label 'Current Rate Value' ;
    rdfs:comment 'Current rate value in effect before this negotiation, used for comparison and variance analysis.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateVariancePercent rdf:type rdf:Property ;
    rdfs:label 'Rate Variance Percent' ;
    rdfs:comment 'Percentage difference between the proposed rate and the current rate, calculated as ((proposed - current) / current) * 100.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:termLengthMonths rdf:type rdf:Property ;
    rdfs:label 'Term Length Months' ;
    rdfs:comment 'Proposed length of the contract term in months.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualityIncentiveFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Incentive Flag' ;
    rdfs:comment 'Indicates whether the proposed contract includes quality-based incentive payments or performance bonuses.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMetricType rdf:type rdf:Property ;
    rdfs:label 'Quality Metric Type' ;
    rdfs:comment 'Type of quality metrics included in the proposed contract, such as Healthcare Effectiveness Data and Information Set (HEDIS), Consumer Assessment of Healthcare Providers and Systems (CAHPS), Stars ratings, clinical outcomes, patient safety, cost efficiency, or composite measures.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskCorridorPercent rdf:type rdf:Property ;
    rdfs:label 'Risk Corridor Percent' ;
    rdfs:comment 'Percentage threshold defining the risk corridor for shared savings or losses in value-based arrangements.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumVolumeRequirement rdf:type rdf:Property ;
    rdfs:label 'Minimum Volume Requirement' ;
    rdfs:comment 'Minimum number of members, procedures, or encounters required under the proposed contract terms.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedMemberCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Member Count' ;
    rdfs:comment 'Estimated number of health plan members who would be covered under the proposed contract.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedAnnualClaims rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Claims' ;
    rdfs:comment 'Projected total annual claims amount expected under the proposed contract terms.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pmpmTarget rdf:type rdf:Property ;
    rdfs:label 'Pmpm Target' ;
    rdfs:comment 'Target Per Member Per Month cost or payment amount proposed in the negotiation.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mlrTargetPercent rdf:type rdf:Property ;
    rdfs:label 'Mlr Target Percent' ;
    rdfs:comment 'Target Medical Loss Ratio percentage proposed in the negotiation, representing the proportion of premium revenue spent on medical claims and quality improvement.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:administrativeFeePercent rdf:type rdf:Property ;
    rdfs:label 'Administrative Fee Percent' ;
    rdfs:comment 'Percentage of premium or claims allocated for administrative fees in Administrative Services Only (ASO) or Third Party Administrator (TPA) arrangements.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:careManagementFee rdf:type rdf:Property ;
    rdfs:label 'Care Management Fee' ;
    rdfs:comment 'Fixed or per-member fee for care management services included in the proposed contract.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exclusivityClause rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Clause' ;
    rdfs:comment 'Indicates whether the proposed contract includes exclusivity provisions restricting the provider from contracting with competing payers.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:negotiatorTitle rdf:type rdf:Property ;
    rdfs:label 'Negotiator Title' ;
    rdfs:comment 'Job title or role of the payer representative conducting the negotiation.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:negotiatorEmail rdf:type rdf:Property ;
    rdfs:label 'Negotiator Email' ;
    rdfs:comment 'Email address of the payer representative conducting the negotiation.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:negotiatorPhone rdf:type rdf:Property ;
    rdfs:label 'Negotiator Phone' ;
    rdfs:comment 'Phone number of the payer representative conducting the negotiation.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterOfferSummary rdf:type rdf:Property ;
    rdfs:label 'Counter Offer Summary' ;
    rdfs:comment 'Summary of the counter-offer terms proposed in response to this negotiation event.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReviewCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Completed Date' ;
    rdfs:comment 'Date when compliance review of this negotiation event was completed.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:roiPercent rdf:type rdf:Property ;
    rdfs:label 'Roi Percent' ;
    rdfs:comment 'Estimated return on investment percentage for this negotiation proposal, calculated based on projected financial benefits versus costs.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:competitiveBenchmarkRate rdf:type rdf:Property ;
    rdfs:label 'Competitive Benchmark Rate' ;
    rdfs:comment 'Market benchmark rate used for comparison when evaluating this negotiation proposal.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceFromBenchmarkPercent rdf:type rdf:Property ;
    rdfs:label 'Variance From Benchmark Percent' ;
    rdfs:comment 'Percentage variance between the proposed rate and the competitive benchmark rate.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strategicPriorityFlag rdf:type rdf:Property ;
    rdfs:label 'Strategic Priority Flag' ;
    rdfs:comment 'Indicates whether this negotiation is designated as a strategic priority for the organization.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberImpactAssessment rdf:type rdf:Property ;
    rdfs:label 'Member Impact Assessment' ;
    rdfs:comment 'Qualitative assessment of how this negotiation outcome would impact health plan members in terms of access, cost, and quality.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByNegotiationId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Negotiation Id' ;
    rdfs:comment 'Identifier of the negotiation record that supersedes this one, if applicable.' ;
    rdfs:domain ind:Negotiation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Negotiation .

ind:programPaymentId rdf:type rdf:Property ;
    rdfs:label 'Program Payment Id' ;
    rdfs:comment 'Unique identifier for the government program payment record. Primary key for the payment transaction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProgramPayment .

ind:payeeNpi rdf:type rdf:Property ;
    rdfs:label 'Payee Npi' ;
    rdfs:comment 'National Provider Identifier of the provider or facility receiving the payment. Ten-digit unique identifier assigned by CMS.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeTin rdf:type rdf:Property ;
    rdfs:label 'Payee Tin' ;
    rdfs:comment 'Tax Identification Number of the payee receiving the payment. Used for IRS reporting and payment reconciliation.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeName rdf:type rdf:Property ;
    rdfs:label 'Payee Name' ;
    rdfs:comment 'Legal name of the provider, beneficiary, or entity receiving the payment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Payee Address Line 1' ;
    rdfs:comment 'First line of the payee mailing address to which payment is sent.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Payee Address Line 2' ;
    rdfs:comment 'Second line of the payee mailing address (suite, apartment, building number, etc.).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeCity rdf:type rdf:Property ;
    rdfs:label 'Payee City' ;
    rdfs:comment 'City name of the payee mailing address.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeState rdf:type rdf:Property ;
    rdfs:label 'Payee State' ;
    rdfs:comment 'Two-letter state code of the payee mailing address.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeZipCode rdf:type rdf:Property ;
    rdfs:label 'Payee Zip Code' ;
    rdfs:comment 'ZIP code of the payee mailing address. May include 5-digit or 9-digit ZIP+4 format.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareBeneficiaryMemberProfileId rdf:type rdf:Property ;
    rdfs:label 'Medicare Beneficiary Member Profile Id' ;
    rdfs:comment 'Medicare Beneficiary Identifier assigned by CMS to the beneficiary. Replaces the Health Insurance Claim Number (HICN) for Medicare beneficiaries.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberProfile .

ind:claimAdjudicationDate rdf:type rdf:Property ;
    rdfs:label 'Claim Adjudication Date' ;
    rdfs:comment 'Date on which the claim was adjudicated and approved for payment.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Member Liability Amount' ;
    rdfs:comment 'Total amount for which the member is financially responsible, including deductible, coinsurance, and copayment.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoupmentAmount rdf:type rdf:Property ;
    rdfs:label 'Recoupment Amount' ;
    rdfs:comment 'Amount recouped from the provider to recover prior overpayments or erroneous payments.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentUnits rdf:type rdf:Property ;
    rdfs:label 'Payment Units' ;
    rdfs:comment 'Number of units of service for which payment is calculated (e.g., days, visits, procedures).' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimFrequencyCode rdf:type rdf:Property ;
    rdfs:label 'Claim Frequency Code' ;
    rdfs:comment 'Single-character code indicating whether the claim is an original submission, replacement, or void (e.g., 1=original, 7=replacement, 8=void).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Billing Provider Npi' ;
    rdfs:comment 'National Provider Identifier of the provider or organization that submitted the claim and is receiving payment.' ;
    rdfs:domain ind:Government ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Void Reason Description' ;
    rdfs:comment 'Textual description of the reason the payment was voided.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSupplementalPayment rdf:type rdf:Property ;
    rdfs:label 'Is Supplemental Payment' ;
    rdfs:comment 'Indicates whether this payment is a supplemental payment issued after the initial claim payment to correct underpayment or apply additional adjustments.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentFiscalYear rdf:type rdf:Property ;
    rdfs:label 'Payment Fiscal Year' ;
    rdfs:comment 'Fiscal year in which the payment was issued, used for financial reporting and reconciliation.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentFiscalPeriod rdf:type rdf:Property ;
    rdfs:label 'Payment Fiscal Period' ;
    rdfs:comment 'Fiscal period (month or quarter) in which the payment was issued, used for financial reporting and reconciliation.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTurnaroundTimeDays rdf:type rdf:Property ;
    rdfs:label 'Payment Turnaround Time Days' ;
    rdfs:comment 'Number of days between claim adjudication date and payment date, used to measure payment timeliness and compliance with prompt payment laws.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isPromptPaymentCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Prompt Payment Compliant' ;
    rdfs:comment 'Indicates whether the payment was issued within the timeframe required by state prompt payment laws or CMS regulations.' ;
    rdfs:domain ind:ProgramPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityId rdf:type rdf:Property ;
    rdfs:label 'Priority Id' ;
    rdfs:comment 'Unique identifier for the priority level record. Primary key for the priority entity.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Priority .

ind:responseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Time Minutes' ;
    rdfs:comment 'Target time in minutes for initial response to member or provider inquiry based on priority level. Used for Service Level Agreement (SLA) tracking and First Call Resolution (FCR) metrics.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationTimeHours rdf:type rdf:Property ;
    rdfs:label 'Escalation Time Hours' ;
    rdfs:comment 'Maximum time in hours before automatic escalation to higher support tier or management if case remains unresolved.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:businessImpact rdf:type rdf:Property ;
    rdfs:label 'Business Impact' ;
    rdfs:comment 'Assessment of business impact associated with this priority level, considering member satisfaction, regulatory risk, financial exposure, and operational disruption.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberImpact rdf:type rdf:Property ;
    rdfs:label 'Member Impact' ;
    rdfs:comment 'Assessment of impact on member experience and satisfaction, used for Net Promoter Score (NPS) correlation and member advocacy prioritization.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRisk rdf:type rdf:Property ;
    rdfs:label 'Regulatory Risk' ;
    rdfs:comment 'Assessment of regulatory compliance risk associated with this priority level, considering Centers for Medicare and Medicaid Services (CMS), Health Insurance Portability and Accountability Act (HIPAA), and state insurance department requirements.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialImpactThreshold rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Threshold' ;
    rdfs:comment 'Minimum dollar amount threshold that qualifies a case for this priority level based on potential financial exposure or claim value.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliesToGrievances rdf:type rdf:Property ;
    rdfs:label 'Applies To Grievances' ;
    rdfs:comment 'Indicates whether this priority level is applicable to member grievance cases, which have specific regulatory timeframes under Centers for Medicare and Medicaid Services (CMS) and state regulations.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToAppeals rdf:type rdf:Property ;
    rdfs:label 'Applies To Appeals' ;
    rdfs:comment 'Indicates whether this priority level is applicable to member appeal cases, which have mandated resolution timeframes under Centers for Medicare and Medicaid Services (CMS) and Affordable Care Act (ACA) regulations.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToInquiries rdf:type rdf:Property ;
    rdfs:label 'Applies To Inquiries' ;
    rdfs:comment 'Indicates whether this priority level is applicable to general member or provider inquiries handled through contact center operations.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToComplaints rdf:type rdf:Property ;
    rdfs:label 'Applies To Complaints' ;
    rdfs:comment 'Indicates whether this priority level is applicable to member complaints that do not rise to the level of formal grievances but require tracking and resolution.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresManagementNotification rdf:type rdf:Property ;
    rdfs:label 'Requires Management Notification' ;
    rdfs:comment 'Indicates whether cases assigned this priority level require immediate notification to management or executive leadership.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresMemberOutreach rdf:type rdf:Property ;
    rdfs:label 'Requires Member Outreach' ;
    rdfs:comment 'Indicates whether this priority level requires proactive outreach to the member to acknowledge receipt and provide status updates.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactChannelPreference rdf:type rdf:Property ;
    rdfs:label 'Contact Channel Preference' ;
    rdfs:comment 'Preferred communication channel for member contact based on priority level, supporting omnichannel support strategy.' ;
    rdfs:domain ind:Priority ;
