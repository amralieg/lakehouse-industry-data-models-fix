  created_timestamp timestamp [note: 'Date and time when this taxonomy entry was first created in the system. | Column created_timestamp (TIMESTAMP) in content.taxonomy']
  display_order varchar [note: 'Numeric sort order for displaying taxonomy entries within the same parent or type grouping. | Column display_order (INT) in content.taxonomy']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
