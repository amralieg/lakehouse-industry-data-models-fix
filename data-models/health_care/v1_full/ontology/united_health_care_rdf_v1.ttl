    rdfs:range ind:Agent .

ind:complianceReviewerAgentId rdf:type rdf:Property ;
    rdfs:label 'Compliance Reviewer Agent Id' ;
    rdfs:comment 'Unique identifier for the compliance officer who reviewed the decision.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:leadSourceId rdf:type rdf:Property ;
    rdfs:label 'Lead Source Id' ;
    rdfs:comment 'Unique identifier for the lead source record. Primary key for the lead source reference table.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LeadSource .

ind:costPerLead rdf:type rdf:Property ;
    rdfs:label 'Cost Per Lead' ;
    rdfs:comment 'Average cost incurred to acquire a single lead from this source. Used for Return on Investment (ROI) analysis and budget planning.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conversionRatePercent rdf:type rdf:Property ;
    rdfs:label 'Conversion Rate Percent' ;
    rdfs:comment 'Historical conversion rate from lead to enrolled member for this source, expressed as a percentage. Used for lead quality assessment and forecasting.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Compliance Approval Required' ;
    rdfs:comment 'Indicates whether leads from this source require additional compliance review or approval before sales engagement. True for high-risk or regulated sources.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSharingAgreementRequired rdf:type rdf:Property ;
