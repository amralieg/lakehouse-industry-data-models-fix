  payment_method varchar [note: 'The method used to remit the contribution payment to the guild benefit fund. | Column payment_method (STRING) in talent.pension_health_contribution']
  payment_reference_number varchar [note: 'The transaction reference number or check number associated with the remittance payment. | Column payment_reference_number (STRING) in talent.pension_health_contribution']
  reconciliation_date date [note: 'The date on which this contribution record was successfully reconciled with the guild benefit fund\'s records. | Column reconciliation_date (DATE) in talent.pension_health_contribution']
  reconciliation_status varchar [note: 'Current status of the contribution record in the reconciliation process with the guild benefit fund. | Column reconciliation_status (STRING) in talent.pension_health_contribution']
  remittance_date date [note: 'The date on which the contribution payment was remitted to the guild benefit fund. | Column remittance_date (DATE) in talent.pension_health_contribution']
  remittance_due_date date [note: 'The contractual due date by which the contribution must be remitted to the guild benefit fund to avoid penalties. | Column remittance_due_date (DATE) in talent.pension_health_contribution']
  reporting_period varchar [note: 'The fiscal or calendar reporting period (e.g., 2024-Q1, 2024-03) to which this contribution is assigned for financial and compliance reporting. | Column reporting_period (STRING) in talent.pension_health_contribution']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in talent.pension_health_contribution']
  total_contribution_amount decimal(18,2) [note: 'The combined total of employer and employee contributions remitted to the guild benefit fund for this contribution record. | Column total_contribution_amount (DECIMAL(18,2)) in talent.pension_health_contribution']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in talent.pension_health_contribution']
  updated_timestamp timestamp [note: 'The date and time when this pension and health contribution record was last modified. | Column updated_timestamp (TIMESTAMP) in talent.pension_health_contribution']
