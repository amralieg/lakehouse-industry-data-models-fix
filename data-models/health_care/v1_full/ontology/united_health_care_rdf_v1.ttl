    rdfs:comment 'Indicates whether the lead has provided HIPAA authorization for use and disclosure of protected health information.' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignedToRole rdf:type rdf:Property ;
