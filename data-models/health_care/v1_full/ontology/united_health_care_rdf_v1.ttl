ind:Pharmacy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Pharmacy ;
    rdfs:label 'Pharmacy' ;
    rdfs:comment 'Master reference table for pharmacy. Referenced by pharmacy_id.' .

ind:Workgroup rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Workgroup' ;
    rdfs:comment 'Master reference table for workgroup. Referenced by assigned_to_workgroup_id.' .

ind:AllocationRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Allocation Run' ;
    rdfs:comment 'Master reference table for allocation_run. Referenced by allocation_run_id.' .

ind:SubmissionFile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Submission File' ;
    rdfs:comment 'Master reference table for submission_file. Referenced by submission_file_id.' .

ind:AuditSample rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Audit Sample' ;
    rdfs:comment 'Master reference table for audit_sample. Referenced by audit_sample_id.' .

# --- Attribute Properties ---
ind:terminationEventId rdf:type rdf:Property ;
    rdfs:label 'Termination Event Id' ;
    rdfs:comment 'Unique identifier for the coverage termination event record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TerminationEvent .

ind:memberProfileId rdf:type rdf:Property ;
    rdfs:label 'Member Profile Id' ;
    rdfs:comment 'Unique identifier for the member whose coverage is being terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberProfile .

ind:subscriberMemberProfileId rdf:type rdf:Property ;
    rdfs:label 'Subscriber Member Profile Id' ;
    rdfs:comment 'External subscriber identifier assigned by the health plan for the primary policyholder.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberProfile .

ind:groupNumber rdf:type rdf:Property ;
    rdfs:label 'Group Number' ;
    rdfs:comment 'Employer or group identifier associated with the coverage being terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Number' ;
    rdfs:comment 'Unique policy or contract number for the coverage being terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageType rdf:type rdf:Property ;
    rdfs:label 'Coverage Type' ;
    rdfs:comment 'Type of health coverage being terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineOfBusiness rdf:type rdf:Property ;
    rdfs:label 'Line Of Business' ;
    rdfs:comment 'Business segment under which the terminated coverage was provided.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productCode rdf:type rdf:Property ;
    rdfs:label 'Product Code' ;
    rdfs:comment 'Internal code identifying the specific health plan product being terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productName rdf:type rdf:Property ;
    rdfs:label 'Product Name' ;
    rdfs:comment 'Human-readable name of the health plan product being terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planType rdf:type rdf:Property ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'Classification of the health plan structure being terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'Date on which the coverage termination becomes effective.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:terminationReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Description' ;
    rdfs:comment 'Detailed explanation of the reason for coverage termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationCategory rdf:type rdf:Property ;
    rdfs:label 'Termination Category' ;
    rdfs:comment 'High-level classification of the termination reason.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedBy rdf:type rdf:Property ;
    rdfs:label 'Initiated By' ;
    rdfs:comment 'Party that initiated the coverage termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedDate rdf:type rdf:Property ;
    rdfs:label 'Requested Date' ;
    rdfs:comment 'Date on which the termination was requested or initiated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:processedDate rdf:type rdf:Property ;
    rdfs:label 'Processed Date' ;
    rdfs:comment 'Date on which the termination was processed in the system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationSentDate rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Date' ;
    rdfs:comment 'Date on which termination notification was sent to the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastCoverageDate rdf:type rdf:Property ;
    rdfs:label 'Last Coverage Date' ;
    rdfs:comment 'Final date on which the member had active coverage before termination.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gracePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Grace Period End Date' ;
    rdfs:comment 'Date on which the premium payment grace period expires, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobraEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Cobra Eligible Flag' ;
    rdfs:comment 'Indicates whether the member is eligible for COBRA continuation coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraElectionDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Election Deadline Date' ;
    rdfs:comment 'Date by which the member must elect COBRA continuation coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobraNotificationSentDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Notification Sent Date' ;
    rdfs:comment 'Date on which COBRA election notice was sent to the member.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hipaaSpecialEnrollmentEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Special Enrollment Eligible Flag' ;
    rdfs:comment 'Indicates whether the termination qualifies the member for HIPAA special enrollment rights.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateOfCoverageIssuedFlag rdf:type rdf:Property ;
    rdfs:label 'Certificate Of Coverage Issued Flag' ;
    rdfs:comment 'Indicates whether a certificate of creditable coverage was issued to the member.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateOfCoverageIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Of Coverage Issued Date' ;
    rdfs:comment 'Date on which the certificate of creditable coverage was issued.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retroactiveTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Retroactive Termination Flag' ;
    rdfs:comment 'Indicates whether the termination is retroactive to a date prior to processing.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumRefundAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Refund Amount' ;
    rdfs:comment 'Amount of premium to be refunded to the member or employer due to termination.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumRefundProcessedFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Refund Processed Flag' ;
    rdfs:comment 'Indicates whether the premium refund has been processed.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outstandingPremiumBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Premium Balance' ;
    rdfs:comment 'Amount of unpaid premium owed at the time of termination.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimsRunoutPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Claims Runout Period Days' ;
    rdfs:comment 'Number of days after termination during which claims for services rendered before termination will be accepted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimsRunoutEndDate rdf:type rdf:Property ;
    rdfs:label 'Claims Runout End Date' ;
    rdfs:comment 'Date after which claims for services rendered before termination will no longer be accepted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Eligible Flag' ;
    rdfs:comment 'Indicates whether the member is eligible for coverage reinstatement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Deadline Date' ;
    rdfs:comment 'Date by which the member must request reinstatement of coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketplaceTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Marketplace Termination Flag' ;
    rdfs:comment 'Indicates whether this termination applies to a Qualified Health Plan (QHP) purchased through a health insurance marketplace.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketplaceTransactionId rdf:type rdf:Property ;
    rdfs:label 'Marketplace Transaction Id' ;
    rdfs:comment 'Unique identifier for the marketplace enrollment transaction associated with this termination.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transaction .

ind:aptcReconciliationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Aptc Reconciliation Required Flag' ;
    rdfs:comment 'Indicates whether Advanced Premium Tax Credit reconciliation is required for this termination.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareTerminationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Medicare Termination Reason Code' ;
    rdfs:comment 'CMS-specific termination reason code for Medicare Advantage or Part D plans.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsTransactionControlNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Transaction Control Number' ;
    rdfs:comment 'CMS-assigned control number for Medicare enrollment transactions.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidTerminationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Medicaid Termination Reason Code' ;
    rdfs:comment 'State Medicaid agency termination reason code.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateReportedFlag rdf:type rdf:Property ;
    rdfs:label 'State Reported Flag' ;
    rdfs:comment 'Indicates whether the termination has been reported to the state insurance department or Medicaid agency.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateReportingDate rdf:type rdf:Property ;
    rdfs:label 'State Reporting Date' ;
    rdfs:comment 'Date on which the termination was reported to the state agency.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irs1095ImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Irs 1095 Impact Flag' ;
    rdfs:comment 'Indicates whether this termination impacts IRS Form 1095-B or 1095-C reporting.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Employer Notification Required Flag' ;
    rdfs:comment 'Indicates whether the employer must be notified of this termination.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerNotificationSentDate rdf:type rdf:Property ;
    rdfs:label 'Employer Notification Sent Date' ;
    rdfs:comment 'Date on which termination notification was sent to the employer.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dependentTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Dependent Termination Flag' ;
    rdfs:comment 'Indicates whether this termination applies to a dependent rather than a subscriber.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dependentRelationshipCode rdf:type rdf:Property ;
    rdfs:label 'Dependent Relationship Code' ;
    rdfs:comment 'Relationship of the dependent to the subscriber, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageOutTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Age Out Termination Flag' ;
    rdfs:comment 'Indicates whether the termination is due to a dependent reaching the maximum age for coverage.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deathTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Death Termination Flag' ;
    rdfs:comment 'Indicates whether the termination is due to the death of the member.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dateOfDeath rdf:type rdf:Property ;
    rdfs:label 'Date Of Death' ;
    rdfs:comment 'Date of death of the member, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nonPaymentTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Non Payment Termination Flag' ;
    rdfs:comment 'Indicates whether the termination is due to non-payment of premiums.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gracePeriodAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Grace Period Applied Flag' ;
    rdfs:comment 'Indicates whether a premium payment grace period was applied before termination.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Termination Flag' ;
    rdfs:comment 'Indicates whether the termination is due to fraud, waste, or abuse.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siuCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Siu Case Number' ;
    rdfs:comment 'Case number from the Special Investigations Unit if termination is fraud-related.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Eligible Flag' ;
    rdfs:comment 'Indicates whether the member is eligible to appeal the termination decision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Deadline Date' ;
    rdfs:comment 'Date by which the member must file an appeal of the termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Flag' ;
    rdfs:comment 'Indicates whether an appeal has been filed for this termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Appeal Case Number' ;
    rdfs:comment 'Case number assigned to the termination appeal, if filed.' ;
    rdfs:domain ind:TerminationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Code identifying the system of record that originated the termination event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTransactionId rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Id' ;
    rdfs:comment 'Unique transaction identifier from the source system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transaction .

ind:ediTransactionSetId rdf:type rdf:Property ;
    rdfs:label 'Edi Transaction Set Id' ;
    rdfs:comment 'Identifier for the EDI 834 transaction set that communicated this termination.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediInterchangeControlNumber rdf:type rdf:Property ;
    rdfs:label 'Edi Interchange Control Number' ;
    rdfs:comment 'Control number for the EDI interchange containing the termination transaction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingStatus rdf:type rdf:Property ;
    rdfs:label 'Processing Status' ;
    rdfs:comment 'Current processing status of the termination event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorCode rdf:type rdf:Property ;
    rdfs:label 'Error Code' ;
    rdfs:comment 'Error code if the termination processing failed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorDescription rdf:type rdf:Property ;
    rdfs:label 'Error Description' ;
    rdfs:comment 'Detailed description of the processing error, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Indicates whether this termination has been reversed or cancelled.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'Date on which the termination was reversed, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Reason for reversing the termination, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentId rdf:type rdf:Property ;
    rdfs:label 'Agent Id' ;
    rdfs:comment 'Identifier of the user or system process that processed the termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:comments rdf:type rdf:Property ;
    rdfs:label 'Comments' ;
    rdfs:comment 'Free-text comments or notes regarding the termination event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobroEventId rdf:type rdf:Property ;
    rdfs:label 'Cobro Event Id' ;
    rdfs:comment 'Unique identifier for the COBRA continuation event record.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualifyingEventType rdf:type rdf:Property ;
    rdfs:label 'Qualifying Event Type' ;
    rdfs:comment 'The type of qualifying event that triggered COBRA eligibility, such as termination of employment, reduction in hours, divorce, or loss of dependent status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualifyingEventDate rdf:type rdf:Property ;
    rdfs:label 'Qualifying Event Date' ;
    rdfs:comment 'The date on which the qualifying event occurred that made the member eligible for COBRA continuation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationDate rdf:type rdf:Property ;
    rdfs:label 'Notification Date' ;
    rdfs:comment 'The date on which the COBRA election notice was sent to the qualified beneficiary.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionDate rdf:type rdf:Property ;
    rdfs:label 'Election Date' ;
    rdfs:comment 'The date on which the qualified beneficiary elected to continue coverage under COBRA.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Election Deadline Date' ;
    rdfs:comment 'The deadline date by which the qualified beneficiary must elect COBRA continuation coverage, typically 60 days from the later of the qualifying event or notification date.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionStatus rdf:type rdf:Property ;
    rdfs:label 'Election Status' ;
    rdfs:comment 'The current status of the COBRA election indicating whether the beneficiary has elected, declined, or is pending decision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Effective Date' ;
    rdfs:comment 'The date on which COBRA continuation coverage becomes effective, typically the day after the original coverage would have ended.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Termination Date' ;
    rdfs:comment 'The date on which COBRA continuation coverage is scheduled to terminate or has terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximumCoveragePeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Maximum Coverage Period Months' ;
    rdfs:comment 'The maximum number of months for which COBRA continuation coverage is available, typically 18, 29, or 36 months depending on the qualifying event.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:extendedCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Extended Coverage Indicator' ;
    rdfs:comment 'Indicates whether the COBRA coverage period has been extended beyond the standard period due to disability or second qualifying event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extensionReason rdf:type rdf:Property ;
    rdfs:label 'Extension Reason' ;
    rdfs:comment 'The reason for extending COBRA coverage beyond the initial maximum period, such as disability determination or occurrence of a second qualifying event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disabilityDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Disability Determination Date' ;
    rdfs:comment 'The date on which a qualified beneficiary was determined to be disabled by the Social Security Administration, allowing for extended COBRA coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Amount' ;
    rdfs:comment 'The monthly premium amount charged for COBRA continuation coverage, typically 102% of the applicable premium cost.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumPercentage rdf:type rdf:Property ;
    rdfs:label 'Premium Percentage' ;
    rdfs:comment 'The percentage of the applicable premium that the qualified beneficiary must pay, typically 102% for standard COBRA or 150% for disability extensions.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Payment Frequency' ;
    rdfs:comment 'The frequency at which COBRA premium payments are due, such as monthly, quarterly, or annually.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstPremiumDueDate rdf:type rdf:Property ;
    rdfs:label 'First Premium Due Date' ;
    rdfs:comment 'The date by which the first COBRA premium payment is due, typically 45 days from the election date.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'The number of days after the premium due date during which payment can be made without termination of coverage, typically 30 days.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'The method by which the qualified beneficiary pays COBRA premiums, such as check, electronic funds transfer, or credit card.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planYearStartDate rdf:type rdf:Property ;
    rdfs:label 'Plan Year Start Date' ;
    rdfs:comment 'The start date of the plan year for the health plan being continued under COBRA.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planYearEndDate rdf:type rdf:Property ;
    rdfs:label 'Plan Year End Date' ;
    rdfs:comment 'The end date of the plan year for the health plan being continued under COBRA.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employerName rdf:type rdf:Property ;
    rdfs:label 'Employer Name' ;
    rdfs:comment 'The name of the employer or group sponsor that provided the original health coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerTin rdf:type rdf:Property ;
    rdfs:label 'Employer Tin' ;
    rdfs:comment 'The Tax Identification Number of the employer or group sponsor.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryType rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Type' ;
    rdfs:comment 'The type of qualified beneficiary electing COBRA coverage, such as employee, spouse, dependent child, or domestic partner.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentCount rdf:type rdf:Property ;
    rdfs:label 'Dependent Count' ;
    rdfs:comment 'The number of dependents included in the COBRA continuation coverage election.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:terminationReason rdf:type rdf:Property ;
    rdfs:label 'Termination Reason' ;
    rdfs:comment 'The reason for termination of COBRA continuation coverage, such as non-payment, reaching maximum coverage period, obtaining other coverage, or Medicare entitlement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsidyEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Subsidy Eligible Indicator' ;
    rdfs:comment 'Indicates whether the qualified beneficiary is eligible for premium subsidy assistance under federal programs such as the American Rescue Plan Act (ARPA).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subsidyPercentage rdf:type rdf:Property ;
    rdfs:label 'Subsidy Percentage' ;
    rdfs:comment 'The percentage of the COBRA premium covered by federal subsidy assistance, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subsidyStartDate rdf:type rdf:Property ;
    rdfs:label 'Subsidy Start Date' ;
    rdfs:comment 'The date on which premium subsidy assistance begins for the qualified beneficiary.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subsidyEndDate rdf:type rdf:Property ;
    rdfs:label 'Subsidy End Date' ;
    rdfs:comment 'The date on which premium subsidy assistance ends for the qualified beneficiary.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticeMethod rdf:type rdf:Property ;
    rdfs:label 'Notice Method' ;
    rdfs:comment 'The method by which the COBRA election notice was delivered to the qualified beneficiary, such as mail, email, or electronic portal.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeLanguage rdf:type rdf:Property ;
    rdfs:label 'Notice Language' ;
    rdfs:comment 'The language in which the COBRA election notice was provided to the qualified beneficiary.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administratorName rdf:type rdf:Property ;
    rdfs:label 'Administrator Name' ;
    rdfs:comment 'The name of the COBRA administrator or Third Party Administrator (TPA) responsible for managing the continuation coverage.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administratorContactPhone rdf:type rdf:Property ;
    rdfs:label 'Administrator Contact Phone' ;
    rdfs:comment 'The contact phone number for the COBRA administrator or Third Party Administrator (TPA).' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administratorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Administrator Contact Email' ;
    rdfs:comment 'The contact email address for the COBRA administrator or Third Party Administrator (TPA).' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateContinuationIndicator rdf:type rdf:Property ;
    rdfs:label 'State Continuation Indicator' ;
    rdfs:comment 'Indicates whether the continuation coverage is provided under state continuation laws (mini-COBRA) rather than federal COBRA.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'The two-letter state code where the COBRA or state continuation coverage is governed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conversionOptionAvailableIndicator rdf:type rdf:Property ;
    rdfs:label 'Conversion Option Available Indicator' ;
    rdfs:comment 'Indicates whether the qualified beneficiary has the option to convert COBRA coverage to an individual policy at the end of the continuation period.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conversionDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Conversion Deadline Date' ;
    rdfs:comment 'The deadline date by which the qualified beneficiary must exercise the option to convert COBRA coverage to an individual policy.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retroactiveCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Retroactive Coverage Indicator' ;
    rdfs:comment 'Indicates whether COBRA coverage was elected retroactively to cover the period between the qualifying event and the election date.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retroactivePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Retroactive Premium Amount' ;
    rdfs:comment 'The total premium amount due for retroactive coverage from the qualifying event date to the election date.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:electionFormReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Election Form Received Date' ;
    rdfs:comment 'The date on which the completed COBRA election form was received by the plan administrator.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionConfirmationSentDate rdf:type rdf:Property ;
    rdfs:label 'Election Confirmation Sent Date' ;
    rdfs:comment 'The date on which confirmation of COBRA election was sent to the qualified beneficiary.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPremiumPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Premium Payment Date' ;
    rdfs:comment 'The date on which the most recent COBRA premium payment was received.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPremiumPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Premium Payment Amount' ;
    rdfs:comment 'The amount of the most recent COBRA premium payment received.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'The current payment status of COBRA premiums, indicating whether payments are current, past due, or delinquent.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationNoticeSentDate rdf:type rdf:Property ;
    rdfs:label 'Termination Notice Sent Date' ;
    rdfs:comment 'The date on which notice of COBRA coverage termination was sent to the qualified beneficiary.' ;
    rdfs:domain ind:CobroEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFiledIndicator rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Indicator' ;
    rdfs:comment 'Indicates whether the qualified beneficiary has filed an appeal regarding COBRA eligibility, coverage, or termination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealFiledDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Date' ;
    rdfs:comment 'The date on which an appeal was filed by the qualified beneficiary regarding COBRA coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Resolution Date' ;
    rdfs:comment 'The date on which the appeal regarding COBRA coverage was resolved.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealOutcome rdf:type rdf:Property ;
    rdfs:label 'Appeal Outcome' ;
    rdfs:comment 'The outcome of the appeal filed by the qualified beneficiary regarding COBRA coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystem rdf:type rdf:Property ;
    rdfs:label 'Source System' ;
    rdfs:comment 'The name of the source system from which the COBRA event record originated, such as Facets, QNXT, or HealthRules.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemId rdf:type rdf:Property ;
    rdfs:label 'Source System Id' ;
    rdfs:comment 'The unique identifier for this COBRA event record in the source system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transaction Timestamp' ;
    rdfs:comment 'The timestamp when the COBRA event transaction was recorded in the source system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Record Effective Date' ;
    rdfs:comment 'The date from which this COBRA event record is effective for business purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordEndDate rdf:type rdf:Property ;
    rdfs:label 'Record End Date' ;
    rdfs:comment 'The date on which this COBRA event record is no longer effective for business purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:currentRecordIndicator rdf:type rdf:Property ;
    rdfs:label 'Current Record Indicator' ;
    rdfs:comment 'Indicates whether this is the current active record for the COBRA event or a historical version.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statusCodeId rdf:type rdf:Property ;
    rdfs:label 'Status Code Id' ;
    rdfs:comment 'Unique identifier for the eligibility status code record. Primary key for the eligibility status code reference table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StatusCode .

ind:code rdf:type rdf:Property ;
    rdfs:label 'Code' ;
    rdfs:comment 'Standardized alphanumeric code representing the eligibility status. Used in eligibility verification transactions and member enrollment systems.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:name rdf:type rdf:Property ;
    rdfs:label 'Name' ;
    rdfs:comment 'Human-readable name of the eligibility status code. Provides clear business terminology for the status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:description rdf:type rdf:Property ;
    rdfs:label 'Description' ;
    rdfs:comment 'Detailed description of the eligibility status code, including business rules, conditions, and usage context.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:category rdf:type rdf:Property ;
    rdfs:label 'Category' ;
    rdfs:comment 'High-level category grouping for the eligibility status. Used for reporting and business logic segmentation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActiveCoverage rdf:type rdf:Property ;
    rdfs:label 'Is Active Coverage' ;
    rdfs:comment 'Boolean flag indicating whether this status represents active insurance coverage. True means member has active benefits; false means coverage is not in effect.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsClaimsProcessing rdf:type rdf:Property ;
    rdfs:label 'Allows Claims Processing' ;
    rdfs:comment 'Boolean flag indicating whether claims can be processed and adjudicated for members with this eligibility status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresPriorAuthorization rdf:type rdf:Property ;
    rdfs:label 'Requires Prior Authorization' ;
    rdfs:comment 'Boolean flag indicating whether prior authorization is required for services when member has this eligibility status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ediTransactionCode rdf:type rdf:Property ;
    rdfs:label 'Edi Transaction Code' ;
    rdfs:comment 'EDI transaction code used in ANSI X12 270/271 eligibility inquiry and response transactions. Maps internal status to standard EDI format.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraEligible rdf:type rdf:Property ;
    rdfs:label 'Cobra Eligible' ;
    rdfs:comment 'Boolean flag indicating whether members with this status are eligible for COBRA continuation coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaContinuationEligible rdf:type rdf:Property ;
    rdfs:label 'Hipaa Continuation Eligible' ;
    rdfs:comment 'Boolean flag indicating whether members with this status are eligible for HIPAA special enrollment or continuation rights.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumPaymentRequired rdf:type rdf:Property ;
    rdfs:label 'Premium Payment Required' ;
    rdfs:comment 'Boolean flag indicating whether premium payment is required to maintain this eligibility status.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gracePeriodApplicable rdf:type rdf:Property ;
    rdfs:label 'Grace Period Applicable' ;
    rdfs:comment 'Boolean flag indicating whether a premium payment grace period applies to this eligibility status.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retroactiveCoverageAllowed rdf:type rdf:Property ;
    rdfs:label 'Retroactive Coverage Allowed' ;
    rdfs:comment 'Boolean flag indicating whether retroactive coverage adjustments are permitted for this eligibility status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planTypeApplicability rdf:type rdf:Property ;
    rdfs:label 'Plan Type Applicability' ;
    rdfs:comment 'Health plan types to which this eligibility status applies. Indicates whether status is specific to certain plan designs or universal.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationOfBenefitsPriority rdf:type rdf:Property ;
    rdfs:label 'Coordination Of Benefits Priority' ;
    rdfs:comment 'Priority order for coordination of benefits processing when member has this eligibility status. Lower numbers indicate higher priority.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providerEligibilityVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Provider Eligibility Verification Required' ;
    rdfs:comment 'Boolean flag indicating whether providers must verify eligibility before rendering services for members with this status.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'Date when this eligibility status code was terminated and is no longer available for new assignments. Null if currently active.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:displayOrder rdf:type rdf:Property ;
    rdfs:label 'Display Order' ;
    rdfs:comment 'Numeric sequence for ordering eligibility status codes in user interfaces and reports. Lower numbers appear first.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:systemGenerated rdf:type rdf:Property ;
    rdfs:label 'System Generated' ;
    rdfs:comment 'Boolean flag indicating whether this status is automatically assigned by system processes versus manually assigned by users.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresManualReview rdf:type rdf:Property ;
    rdfs:label 'Requires Manual Review' ;
    rdfs:comment 'Boolean flag indicating whether eligibility records with this status require manual review by enrollment specialists.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationTrigger rdf:type rdf:Property ;
    rdfs:label 'Notification Trigger' ;
    rdfs:comment 'Boolean flag indicating whether assignment of this status should trigger automated member notification communications.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingCategory rdf:type rdf:Property ;
    rdfs:label 'Reporting Category' ;
    rdfs:comment 'Category used for regulatory reporting and compliance submissions. Maps internal status to required reporting classifications.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisReportable rdf:type rdf:Property ;
    rdfs:label 'Hedis Reportable' ;
    rdfs:comment 'Boolean flag indicating whether members with this eligibility status should be included in HEDIS quality measure reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskAdjustmentEligible rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Eligible' ;
    rdfs:comment 'Boolean flag indicating whether members with this status are eligible for risk adjustment factor (RAF) scoring and Hierarchical Condition Category (HCC) coding.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalLossRatioInclusion rdf:type rdf:Property ;
    rdfs:label 'Medical Loss Ratio Inclusion' ;
    rdfs:comment 'Boolean flag indicating whether members with this status should be included in Medical Loss Ratio calculations for ACA compliance.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialEnrollmentPeriodTrigger rdf:type rdf:Property ;
    rdfs:label 'Special Enrollment Period Trigger' ;
    rdfs:comment 'Boolean flag indicating whether this status change triggers a special enrollment period for the member or dependents.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualifyingLifeEventRelated rdf:type rdf:Property ;
    rdfs:label 'Qualifying Life Event Related' ;
    rdfs:comment 'Boolean flag indicating whether this eligibility status is associated with a qualifying life event that permits enrollment changes.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subsidyEligible rdf:type rdf:Property ;
    rdfs:label 'Subsidy Eligible' ;
    rdfs:comment 'Boolean flag indicating whether members with this status are eligible for premium tax credits or cost-sharing reductions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dualEligibleApplicable rdf:type rdf:Property ;
    rdfs:label 'Dual Eligible Applicable' ;
    rdfs:comment 'Boolean flag indicating whether this status applies to dual eligible members (Medicare and Medicaid).' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyBenefitsActive rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Benefits Active' ;
    rdfs:comment 'Boolean flag indicating whether pharmacy benefits are active for members with this eligibility status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthCoverageActive rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Coverage Active' ;
    rdfs:comment 'Boolean flag indicating whether behavioral health and mental health services are covered under this eligibility status.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dentalVisionCoverageActive rdf:type rdf:Property ;
    rdfs:label 'Dental Vision Coverage Active' ;
    rdfs:comment 'Boolean flag indicating whether supplemental dental and vision benefits are active for members with this eligibility status.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfNetworkBenefitsAllowed rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Benefits Allowed' ;
    rdfs:comment 'Boolean flag indicating whether out-of-network provider services are covered for members with this eligibility status.' ;
    rdfs:domain ind:StatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyServicesCoverage rdf:type rdf:Property ;
