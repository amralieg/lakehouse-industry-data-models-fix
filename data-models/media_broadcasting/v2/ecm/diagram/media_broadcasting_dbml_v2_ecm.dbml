  revenue_recognition_date date [note: 'Date on which revenue from this carriage fee invoice is recognized per ASC 606 revenue recognition standards. | Column revenue_recognition_date (DATE) in billing.billing_carriage_fee_invoice']
  sap_posting_reference varchar [note: 'SAP S/4HANA financial posting document reference for revenue recognition and accounts receivable. | Column sap_posting_reference (STRING) in billing.billing_carriage_fee_invoice']
