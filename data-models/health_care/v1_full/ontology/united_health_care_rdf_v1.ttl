ind:npsImpactWeight rdf:type rdf:Property ;
    rdfs:label 'Nps Impact Weight' ;
    rdfs:comment 'Weighting factor for Net Promoter Score (NPS) impact calculation, reflecting how cases at this priority level influence overall member satisfaction scores.' ;
    rdfs:domain ind:Priority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityReviewRequired rdf:type rdf:Property ;
