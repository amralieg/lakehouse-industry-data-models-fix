ind:waiverCriteria rdf:type rdf:Property ;
    rdfs:label 'Waiver Criteria' ;
    rdfs:comment 'Business rules defining the conditions under which this surcharge can be waived (e.g., completion of smoking cessation program).' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCycle rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle' ;
    rdfs:comment 'Timing of surcharge billing relative to coverage period (current month, advance, arrears).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Number' ;
    rdfs:comment 'Regulatory rate filing number associated with this surcharge, submitted to state insurance departments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Filing Approval Date' ;
    rdfs:comment 'Date when the regulatory authority approved the rate filing containing this surcharge.' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryNotes rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notes' ;
    rdfs:comment 'Additional notes or comments related to regulatory compliance, filing requirements, or special conditions for this surcharge.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededBySurchargeId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Surcharge Id' ;
    rdfs:comment 'Identifier of the surcharge definition that replaces this one. Null if this is the current version.' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Surcharge .

ind:billingNoteId rdf:type rdf:Property ;
    rdfs:label 'Billing Note Id' ;
    rdfs:comment 'Unique identifier for the billing note record. Primary key for the billing note entity.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:text rdf:type rdf:Property ;
    rdfs:label 'Text' ;
    rdfs:comment 'Free-text content of the billing note containing detailed information, instructions, or comments related to the invoice or account.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subject rdf:type rdf:Property ;
    rdfs:label 'Subject' ;
    rdfs:comment 'Brief subject line or title summarizing the purpose of the billing note for quick reference.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visibility rdf:type rdf:Property ;
    rdfs:label 'Visibility' ;
    rdfs:comment 'Indicates whether the note is visible to internal users only, members only, or both. Controls access and display of the note.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUserName rdf:type rdf:Property ;
    rdfs:label 'Created By User Name' ;
    rdfs:comment 'Name of the user who created the billing note for human-readable audit trail.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedByUserName rdf:type rdf:Property ;
    rdfs:label 'Modified By User Name' ;
    rdfs:comment 'Name of the user who last modified the billing note for human-readable audit trail.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolvedDate rdf:type rdf:Property ;
    rdfs:label 'Resolved Date' ;
    rdfs:comment 'The date when the billing note was marked as resolved or closed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolvedByUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Resolved By User Agent Id' ;
    rdfs:comment 'Identifier of the user who resolved or closed the billing note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:resolvedByUserName rdf:type rdf:Property ;
    rdfs:label 'Resolved By User Name' ;
    rdfs:comment 'Name of the user who resolved the billing note for human-readable reference.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDisputeRelated rdf:type rdf:Property ;
    rdfs:label 'Is Dispute Related' ;
    rdfs:comment 'Indicates whether the billing note is related to a billing dispute or contested charge.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRetroactive rdf:type rdf:Property ;
    rdfs:label 'Is Retroactive' ;
    rdfs:comment 'Indicates whether the note documents a retroactive billing adjustment or change.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pmpmAmount rdf:type rdf:Property ;
    rdfs:label 'Pmpm Amount' ;
    rdfs:comment 'The per member per month rate referenced in the billing note, commonly used in premium calculations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pepmAmount rdf:type rdf:Property ;
    rdfs:label 'Pepm Amount' ;
    rdfs:comment 'The per employee per month rate referenced in the billing note, used in group billing calculations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:departmentName rdf:type rdf:Property ;
    rdfs:label 'Department Name' ;
    rdfs:comment 'Name of the internal department or business unit associated with the billing note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Assigned To User Agent Id' ;
    rdfs:comment 'Identifier of the user to whom the billing note is assigned for action or resolution.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:sourceSystemNoteId rdf:type rdf:Property ;
    rdfs:label 'Source System Note Id' ;
    rdfs:comment 'The unique identifier for the billing note in the source system, used for traceability and reconciliation.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Note .

ind:isConfidential rdf:type rdf:Property ;
    rdfs:label 'Is Confidential' ;
    rdfs:comment 'Indicates whether the billing note contains confidential information requiring restricted access.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retentionEndDate rdf:type rdf:Property ;
    rdfs:label 'Retention End Date' ;
    rdfs:comment 'The date after which the billing note may be purged or deleted according to records retention policies.' ;
    rdfs:domain ind:BillingNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationId rdf:type rdf:Property ;
    rdfs:label 'Investigation Id' ;
    rdfs:comment 'Unique identifier for the fraud, waste, and abuse investigation case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investigation .

ind:openedDate rdf:type rdf:Property ;
    rdfs:label 'Opened Date' ;
    rdfs:comment 'Date when the investigation case was officially opened and initiated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetDate rdf:type rdf:Property ;
    rdfs:label 'Target Date' ;
    rdfs:comment 'Target date by which the investigation is expected to be completed based on priority and complexity.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadInvestigatorName rdf:type rdf:Property ;
    rdfs:label 'Lead Investigator Name' ;
    rdfs:comment 'Full name of the primary investigator responsible for leading the investigation case.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadInvestigatorId rdf:type rdf:Property ;
    rdfs:label 'Lead Investigator Id' ;
    rdfs:comment 'Employee identifier of the lead investigator assigned to the case.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investigator .

ind:assignedTeam rdf:type rdf:Property ;
    rdfs:label 'Assigned Team' ;
    rdfs:comment 'Name or identifier of the Special Investigations Unit team assigned to handle the case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceType rdf:type rdf:Property ;
    rdfs:label 'Source Type' ;
    rdfs:comment 'Source or method through which the potential fraud, waste, or abuse was initially identified or reported.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Source Reference Number' ;
    rdfs:comment 'Reference number or identifier from the originating source system or report that triggered the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allegationSummary rdf:type rdf:Property ;
    rdfs:label 'Allegation Summary' ;
    rdfs:comment 'Brief summary of the fraud, waste, or abuse allegations that are the subject of the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allegationDetails rdf:type rdf:Property ;
    rdfs:label 'Allegation Details' ;
    rdfs:comment 'Detailed description of the allegations including specific claims, dates, providers, members, and suspected fraudulent activities.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectType rdf:type rdf:Property ;
    rdfs:label 'Subject Type' ;
    rdfs:comment 'Type of entity that is the subject or target of the fraud investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectName rdf:type rdf:Property ;
    rdfs:label 'Subject Name' ;
    rdfs:comment 'Name of the individual, provider, or organization that is the subject of the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectIdentifier rdf:type rdf:Property ;
    rdfs:label 'Subject Identifier' ;
    rdfs:comment 'Unique identifier for the subject of the investigation such as National Provider Identifier (NPI), Tax Identification Number (TIN), or member ID.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Loss Amount' ;
    rdfs:comment 'Estimated total financial loss or overpayment amount associated with the fraudulent activity under investigation.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confirmedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Loss Amount' ;
    rdfs:comment 'Confirmed total financial loss or overpayment amount substantiated through investigation findings and evidence.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveredAmount rdf:type rdf:Property ;
    rdfs:label 'Recovered Amount' ;
    rdfs:comment 'Total amount recovered or recouped from the subject as a result of the investigation and recovery actions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimsCount rdf:type rdf:Property ;
    rdfs:label 'Claims Count' ;
    rdfs:comment 'Total number of claims identified as potentially fraudulent or improper in the investigation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:membersAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Members Affected Count' ;
    rdfs:comment 'Total number of members whose claims or benefits were affected by the fraudulent activity.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dateRangeStart rdf:type rdf:Property ;
    rdfs:label 'Date Range Start' ;
    rdfs:comment 'Start date of the time period during which the suspected fraudulent activity occurred.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Date Range End' ;
    rdfs:comment 'End date of the time period during which the suspected fraudulent activity occurred.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evidenceCollected rdf:type rdf:Property ;
    rdfs:label 'Evidence Collected' ;
    rdfs:comment 'Description of evidence collected during the investigation including documents, records, statements, and physical evidence.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessCount rdf:type rdf:Property ;
    rdfs:label 'Witness Count' ;
    rdfs:comment 'Total number of witnesses interviewed or providing statements during the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interviewCount rdf:type rdf:Property ;
    rdfs:label 'Interview Count' ;
    rdfs:comment 'Total number of formal interviews conducted as part of the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:subpoenaIssued rdf:type rdf:Property ;
    rdfs:label 'Subpoena Issued' ;
    rdfs:comment 'Indicates whether a subpoena was issued to obtain records or testimony during the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subpoenaCount rdf:type rdf:Property ;
    rdfs:label 'Subpoena Count' ;
    rdfs:comment 'Total number of subpoenas issued during the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingSummary rdf:type rdf:Property ;
    rdfs:label 'Finding Summary' ;
    rdfs:comment 'Summary of the investigation findings including conclusions about whether fraud, waste, or abuse occurred.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingDetails rdf:type rdf:Property ;
    rdfs:label 'Finding Details' ;
    rdfs:comment 'Detailed description of investigation findings including specific evidence, patterns identified, and substantiated allegations.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substantiated rdf:type rdf:Property ;
    rdfs:label 'Substantiated' ;
    rdfs:comment 'Indicates whether the fraud, waste, or abuse allegations were substantiated by the investigation findings.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disposition rdf:type rdf:Property ;
    rdfs:label 'Disposition' ;
    rdfs:comment 'Final disposition or outcome of the investigation indicating the resolution and actions taken.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureReason rdf:type rdf:Property ;
    rdfs:label 'Closure Reason' ;
    rdfs:comment 'Reason for closing the investigation case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionTaken rdf:type rdf:Property ;
    rdfs:label 'Action Taken' ;
    rdfs:comment 'Primary action taken as a result of the investigation findings.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryInitiated rdf:type rdf:Property ;
    rdfs:label 'Recovery Initiated' ;
    rdfs:comment 'Indicates whether overpayment recovery actions were initiated as a result of the investigation.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryMethod rdf:type rdf:Property ;
    rdfs:label 'Recovery Method' ;
    rdfs:comment 'Method used to recover overpayments identified through the investigation.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerTerminated rdf:type rdf:Property ;
    rdfs:label 'Provider Terminated' ;
    rdfs:comment 'Indicates whether the provider contract was terminated as a result of the investigation findings.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerSuspended rdf:type rdf:Property ;
    rdfs:label 'Provider Suspended' ;
    rdfs:comment 'Indicates whether the provider was suspended from the network as a result of the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referredToLawEnforcement rdf:type rdf:Property ;
    rdfs:label 'Referred To Law Enforcement' ;
    rdfs:comment 'Indicates whether the investigation case was referred to law enforcement agencies for criminal prosecution.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawEnforcementAgency rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Agency' ;
    rdfs:comment 'Name of the law enforcement agency to which the case was referred, if applicable.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Case Number' ;
    rdfs:comment 'Case number assigned by the law enforcement agency for the referred investigation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referredToLegal rdf:type rdf:Property ;
    rdfs:label 'Referred To Legal' ;
    rdfs:comment 'Indicates whether the investigation case was referred to the internal legal department for civil action or litigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Legal Case Number' ;
    rdfs:comment 'Case number assigned by the legal department for civil litigation or legal action related to the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedToCms rdf:type rdf:Property ;
    rdfs:label 'Reported To Cms' ;
    rdfs:comment 'Indicates whether the investigation findings were reported to the Centers for Medicare and Medicaid Services as required for Medicare and Medicaid programs.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportedToState rdf:type rdf:Property ;
    rdfs:label 'Reported To State' ;
    rdfs:comment 'Indicates whether the investigation findings were reported to state insurance or Medicaid agencies as required.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateReportDate rdf:type rdf:Property ;
    rdfs:label 'State Report Date' ;
    rdfs:comment 'Date when the investigation findings were reported to state regulatory agencies.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedToOig rdf:type rdf:Property ;
    rdfs:label 'Reported To Oig' ;
    rdfs:comment 'Indicates whether the investigation findings were reported to the Office of Inspector General for potential exclusion or sanctions.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oigReportDate rdf:type rdf:Property ;
    rdfs:label 'Oig Report Date' ;
    rdfs:comment 'Date when the investigation findings were reported to the Office of Inspector General.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relatedInvestigations rdf:type rdf:Property ;
    rdfs:label 'Related Investigations' ;
    rdfs:comment 'Comma-separated list of related investigation case numbers that are connected to this investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentInvestigationId rdf:type rdf:Property ;
    rdfs:label 'Parent Investigation Id' ;
    rdfs:comment 'Identifier of the parent investigation if this case is a sub-investigation or part of a larger investigation effort.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investigation .

ind:statuteOfLimitationsDate rdf:type rdf:Property ;
    rdfs:label 'Statute Of Limitations Date' ;
    rdfs:comment 'Date by which legal action must be initiated based on applicable statute of limitations for fraud prosecution or recovery.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastActivityDate rdf:type rdf:Property ;
    rdfs:label 'Last Activity Date' ;
    rdfs:comment 'Date of the most recent activity or update recorded for the investigation case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigatorHours rdf:type rdf:Property ;
    rdfs:label 'Investigator Hours' ;
    rdfs:comment 'Total number of investigator hours spent on the investigation case.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cost rdf:type rdf:Property ;
    rdfs:label 'Cost' ;
    rdfs:comment 'Total cost incurred to conduct the investigation including labor, travel, and external services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnOnInvestment rdf:type rdf:Property ;
    rdfs:label 'Return On Investment' ;
    rdfs:comment 'Return on investment ratio calculated as recovered amount divided by investigation cost.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:providerAuditId rdf:type rdf:Property ;
    rdfs:label 'Provider Audit Id' ;
    rdfs:comment 'Unique identifier for the provider audit record. Primary key for the provider audit entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderAudit .

ind:auditNumber rdf:type rdf:Property ;
    rdfs:label 'Audit Number' ;
    rdfs:comment 'Human-readable unique audit reference number assigned to the provider audit for tracking and reporting purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditScope rdf:type rdf:Property ;
    rdfs:label 'Audit Scope' ;
    rdfs:comment 'The scope or focus area of the audit (e.g., claims review, billing patterns, medical records, coding accuracy, documentation compliance).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedDate rdf:type rdf:Property ;
    rdfs:label 'Initiated Date' ;
    rdfs:comment 'The date when the provider audit was formally initiated or opened.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledStartDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Date' ;
    rdfs:comment 'The planned or scheduled date for the audit fieldwork or review to begin.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Completion Date' ;
    rdfs:comment 'The planned or target date for completing the audit review and issuing findings.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Audit Period Start Date' ;
    rdfs:comment 'The beginning date of the time period under audit review (i.e., the earliest date of claims or activities being examined).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Audit Period End Date' ;
    rdfs:comment 'The ending date of the time period under audit review (i.e., the latest date of claims or activities being examined).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sampleMethod rdf:type rdf:Property ;
    rdfs:label 'Sample Method' ;
    rdfs:comment 'The statistical or judgmental method used to select the audit sample (e.g., random sampling, stratified sampling, targeted selection).' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalClaimsReviewed rdf:type rdf:Property ;
    rdfs:label 'Total Claims Reviewed' ;
    rdfs:comment 'The total number of claims reviewed during the audit, including both sampled and additional claims examined.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimsWithErrors rdf:type rdf:Property ;
    rdfs:label 'Claims With Errors' ;
    rdfs:comment 'The number of claims reviewed that were found to contain errors, discrepancies, or compliance issues.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:errorRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Error Rate Percentage' ;
    rdfs:comment 'The calculated percentage of claims with errors relative to the total claims reviewed, expressed as a percentage.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overpaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Overpayment Amount' ;
    rdfs:comment 'The total dollar amount of overpayments identified during the audit that must be recovered from the provider.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underpaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Underpayment Amount' ;
    rdfs:comment 'The total dollar amount of underpayments identified during the audit that are owed to the provider.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedOverpaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Projected Overpayment Amount' ;
    rdfs:comment 'The statistically projected overpayment amount extrapolated from the audit sample to the entire population of claims, when statistical sampling is used.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Recovery Amount' ;
    rdfs:comment 'The dollar amount of identified overpayments that remain outstanding and have not yet been recovered from the provider.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correctiveActionPlanReceived rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Received' ;
    rdfs:comment 'Indicates whether a corrective action plan has been received from the provider in response to the audit findings.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referredToSiu rdf:type rdf:Property ;
    rdfs:label 'Referred To Siu' ;
    rdfs:comment 'Indicates whether the audit findings were referred to the Special Investigations Unit for potential fraud, waste, or abuse investigation.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siuReferralDate rdf:type rdf:Property ;
    rdfs:label 'Siu Referral Date' ;
    rdfs:comment 'The date when the audit case was referred to the Special Investigations Unit for further investigation.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementReferralDate rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Referral Date' ;
    rdfs:comment 'The date when the audit case was referred to law enforcement agencies for investigation or prosecution.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractActionTaken rdf:type rdf:Property ;
    rdfs:label 'Contract Action Taken' ;
    rdfs:comment 'The contractual or administrative action taken against the provider as a result of the audit findings (e.g., warning, termination, payment suspension, exclusion).' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractActionDate rdf:type rdf:Property ;
    rdfs:label 'Contract Action Date' ;
    rdfs:comment 'The date when contractual or administrative action was taken against the provider based on the audit findings.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditMethodology rdf:type rdf:Property ;
    rdfs:label 'Audit Methodology' ;
    rdfs:comment 'A description of the audit methodology, approach, and procedures used to conduct the provider audit.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationRequested rdf:type rdf:Property ;
    rdfs:label 'Documentation Requested' ;
    rdfs:comment 'Indicates whether medical records or other supporting documentation was requested from the provider during the audit.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationRequestDate rdf:type rdf:Property ;
    rdfs:label 'Documentation Request Date' ;
    rdfs:comment 'The date when documentation or medical records were formally requested from the provider.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentationReceived rdf:type rdf:Property ;
    rdfs:label 'Documentation Received' ;
    rdfs:comment 'Indicates whether the requested documentation or medical records were received from the provider.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerResponseReceived rdf:type rdf:Property ;
    rdfs:label 'Provider Response Received' ;
    rdfs:comment 'Indicates whether a formal response or rebuttal was received from the provider regarding the preliminary audit findings.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerResponseDate rdf:type rdf:Property ;
    rdfs:label 'Provider Response Date' ;
    rdfs:comment 'The date when the provider submitted their formal response or rebuttal to the preliminary audit findings.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:finalReportIssued rdf:type rdf:Property ;
    rdfs:label 'Final Report Issued' ;
    rdfs:comment 'Indicates whether the final audit report has been issued to the provider and relevant stakeholders.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:finalReportDate rdf:type rdf:Property ;
    rdfs:label 'Final Report Date' ;
    rdfs:comment 'The date when the final audit report was issued to the provider and relevant stakeholders.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cptCodesReviewed rdf:type rdf:Property ;
    rdfs:label 'Cpt Codes Reviewed' ;
    rdfs:comment 'A list or summary of the CPT procedure codes that were reviewed during the audit, if applicable.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icdCodesReviewed rdf:type rdf:Property ;
    rdfs:label 'Icd Codes Reviewed' ;
    rdfs:comment 'A list or summary of the ICD diagnosis codes that were reviewed during the audit, if applicable.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgCodesReviewed rdf:type rdf:Property ;
    rdfs:label 'Drg Codes Reviewed' ;
    rdfs:comment 'A list or summary of the DRG codes that were reviewed during the audit for inpatient claims, if applicable.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repeatOffender rdf:type rdf:Property ;
    rdfs:label 'Repeat Offender' ;
    rdfs:comment 'Indicates whether the provider has been previously audited and found to have similar compliance issues or violations.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:previousAuditCount rdf:type rdf:Property ;
    rdfs:label 'Previous Audit Count' ;
    rdfs:comment 'The number of previous audits conducted on this provider within a specified time period.' ;
    rdfs:domain ind:ProviderAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Payment Reconciliation Id' ;
    rdfs:comment 'Unique identifier for the payment reconciliation record. Primary key for tracking the matching of payments to invoices and posting of reconciliation results.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentReconciliation .

ind:reconciliationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Timestamp' ;
    rdfs:comment 'The precise date and time when the payment reconciliation process was completed, including timezone information.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:invoiceAmount rdf:type rdf:Property ;
    rdfs:label 'Invoice Amount' ;
    rdfs:comment 'The total amount due on the invoice being reconciled, including all charges, fees, and applicable taxes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliedAmount rdf:type rdf:Property ;
    rdfs:label 'Applied Amount' ;
    rdfs:comment 'The portion of the payment amount that was successfully matched and applied to the specific invoice during reconciliation.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unappliedAmount rdf:type rdf:Property ;
    rdfs:label 'Unapplied Amount' ;
    rdfs:comment 'The portion of the payment that could not be matched to an invoice and remains unapplied, requiring further investigation or manual intervention.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationType rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Type' ;
    rdfs:comment 'The method by which the reconciliation was performed, such as automatic system matching, manual review, or system-assisted processing.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Match Confidence Score' ;
    rdfs:comment 'Numerical score representing the system\'s confidence level in the payment-to-invoice match, typically expressed as a percentage from 0 to 100.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchCriteria rdf:type rdf:Property ;
    rdfs:label 'Match Criteria' ;
    rdfs:comment 'Description of the criteria or rules used to match the payment to the invoice, such as invoice number, member ID, or payment reference.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTimelinessIndicator rdf:type rdf:Property ;
    rdfs:label 'Payment Timeliness Indicator' ;
    rdfs:comment 'Indicator of whether the payment was received on time, late, within the grace period, or past the grace period.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationCode rdf:type rdf:Property ;
    rdfs:label 'Authorization Code' ;
    rdfs:comment 'Authorization code provided by the payment processor confirming approval of the payment transaction.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingStatus rdf:type rdf:Property ;
    rdfs:label 'Posting Status' ;
    rdfs:comment 'Status indicating whether the reconciliation results have been successfully posted to the financial systems.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountsReceivableAccount rdf:type rdf:Property ;
    rdfs:label 'Accounts Receivable Account' ;
    rdfs:comment 'The accounts receivable account code from which the invoice balance was cleared upon successful reconciliation.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationBatchId rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Batch Id' ;
    rdfs:comment 'Identifier of the batch processing run during which this payment reconciliation was performed, used for audit and tracking purposes.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Batch .

ind:exceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Exception Flag' ;
    rdfs:comment 'Boolean indicator of whether the reconciliation resulted in an exception requiring manual review or intervention.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionType rdf:type rdf:Property ;
    rdfs:label 'Exception Type' ;
    rdfs:comment 'Classification of the type of exception encountered during reconciliation, such as no match found, amount mismatch, or duplicate payment.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionDescription rdf:type rdf:Property ;
    rdfs:label 'Exception Description' ;
    rdfs:comment 'Detailed textual description of the exception encountered during the reconciliation process.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Resolution Status' ;
    rdfs:comment 'Status indicating whether any exceptions or issues identified during reconciliation have been resolved.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Description' ;
    rdfs:comment 'Detailed textual description explaining why the reconciliation was reversed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processorName rdf:type rdf:Property ;
    rdfs:label 'Processor Name' ;
    rdfs:comment 'Name of the third-party payment processor or financial institution that handled the payment transaction.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processorId rdf:type rdf:Property ;
    rdfs:label 'Processor Id' ;
    rdfs:comment 'Unique identifier of the payment processor or financial institution in the organization\'s systems.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lockboxNumber rdf:type rdf:Property ;
    rdfs:label 'Lockbox Number' ;
    rdfs:comment 'The lockbox number if the payment was received through a bank lockbox service for automated payment processing.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'The date when the payment cleared through the banking system and funds became available.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nsfFlag rdf:type rdf:Property ;
    rdfs:label 'Nsf Flag' ;
    rdfs:comment 'Boolean indicator of whether the payment was returned due to non-sufficient funds in the payer\'s account.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnReasonCode rdf:type rdf:Property ;
    rdfs:label 'Return Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for payment return, such as Non-Sufficient Funds (NSF), account closed, or stop payment.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnDate rdf:type rdf:Property ;
    rdfs:label 'Return Date' ;
    rdfs:comment 'The date when the payment was returned by the financial institution.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chargebackFlag rdf:type rdf:Property ;
    rdfs:label 'Chargeback Flag' ;
    rdfs:comment 'Boolean indicator of whether the payment was subject to a chargeback dispute initiated by the payer.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chargebackDate rdf:type rdf:Property ;
    rdfs:label 'Chargeback Date' ;
    rdfs:comment 'The date when the chargeback was initiated against the payment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chargebackReasonCode rdf:type rdf:Property ;
    rdfs:label 'Chargeback Reason Code' ;
    rdfs:comment 'Standardized code provided by the card network indicating the reason for the chargeback dispute.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditBalanceFlag rdf:type rdf:Property ;
    rdfs:label 'Credit Balance Flag' ;
    rdfs:comment 'Boolean indicator of whether the reconciliation resulted in a credit balance on the account due to overpayment.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Balance Amount' ;
    rdfs:comment 'The amount of credit balance remaining on the account after reconciliation, available for application to future invoices.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autopayFlag rdf:type rdf:Property ;
    rdfs:label 'Autopay Flag' ;
    rdfs:comment 'Boolean indicator of whether the payment was processed automatically through an autopay enrollment.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurringPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Recurring Payment Flag' ;
    rdfs:comment 'Boolean indicator of whether this payment is part of a recurring payment schedule.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationSystem rdf:type rdf:Property ;
    rdfs:label 'Reconciliation System' ;
    rdfs:comment 'Name of the system or application that performed the payment reconciliation process.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciledByUserId rdf:type rdf:Property ;
    rdfs:label 'Reconciled By User Id' ;
    rdfs:comment 'Identifier of the user or system operator who performed or approved the reconciliation, applicable for manual or system-assisted reconciliations.' ;
    rdfs:domain ind:PaymentReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:discountId rdf:type rdf:Property ;
    rdfs:label 'Discount Id' ;
    rdfs:comment 'Unique surrogate key for each discount definition.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Discount .

ind:applicableMemberGroup rdf:type rdf:Property ;
    rdfs:label 'Applicable Member Group' ;
    rdfs:comment 'Identifier for member segment (e.g., group size, employer, Medicare) eligible for discount.' ;
