ind:claimLineId rdf:type rdf:Property ;
    rdfs:label 'Claim Line Id' ;
    rdfs:comment 'Unique identifier for each pharmacy claim line item, representing a single drug dispensed within a pharmacy claim.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimLine .

ind:dateWritten rdf:type rdf:Property ;
    rdfs:label 'Date Written' ;
    rdfs:comment 'Date the prescription was written by the prescriber.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateFilled rdf:type rdf:Property ;
    rdfs:label 'Date Filled' ;
    rdfs:comment 'Date the prescription was dispensed by the pharmacy.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateSubmitted rdf:type rdf:Property ;
    rdfs:label 'Date Submitted' ;
    rdfs:comment 'Date the pharmacy claim was submitted to the payer for adjudication.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateProcessed rdf:type rdf:Property ;
    rdfs:label 'Date Processed' ;
    rdfs:comment 'Date the claim was adjudicated and processed by the payer.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:datePaid rdf:type rdf:Property ;
    rdfs:label 'Date Paid' ;
    rdfs:comment 'Date payment was issued to the pharmacy for this claim line.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:denialReasonCode rdf:type rdf:Property ;
    rdfs:label 'Denial Reason Code' ;
    rdfs:comment 'Code indicating the reason for claim denial if status is denied.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Denial Reason Description' ;
    rdfs:comment 'Human-readable description of the denial reason.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesTaxSubmitted rdf:type rdf:Property ;
    rdfs:label 'Sales Tax Submitted' ;
    rdfs:comment 'Sales tax amount submitted by the pharmacy.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Member Copay Amount' ;
    rdfs:comment 'Fixed copayment amount paid by the member.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCoinsuranceAmount rdf:type rdf:Property ;
    rdfs:label 'Member Coinsurance Amount' ;
    rdfs:comment 'Percentage-based coinsurance amount paid by the member.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Member Deductible Amount' ;
    rdfs:comment 'Amount applied to the member\'s deductible for this claim line.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberTotalOutOfPocket rdf:type rdf:Property ;
    rdfs:label 'Member Total Out Of Pocket' ;
    rdfs:comment 'Total out-of-pocket amount paid by the member (copay + coinsurance + deductible).' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:therapeuticClassDescription rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Class Description' ;
    rdfs:comment 'Description of the therapeutic class or category of the drug.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugCategory rdf:type rdf:Property ;
    rdfs:label 'Drug Category' ;
    rdfs:comment 'High-level category of the drug based on usage pattern and clinical purpose.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityLimitExceeded rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit Exceeded' ;
    rdfs:comment 'Indicates whether the dispensed quantity exceeded plan-defined quantity limits.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:durConflictDescription rdf:type rdf:Property ;
    rdfs:label 'Dur Conflict Description' ;
    rdfs:comment 'Description of the drug utilization review conflict detected.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durOverrideCode rdf:type rdf:Property ;
    rdfs:label 'Dur Override Code' ;
    rdfs:comment 'Code indicating the professional service override reason if DUR conflict was overridden.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceProviderIdQualifier rdf:type rdf:Property ;
    rdfs:label 'Service Provider Id Qualifier' ;
    rdfs:comment 'Qualifier indicating the type of pharmacy identifier (01=NPI, 07=NCPDP, 08=State License).' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalClaimLineId rdf:type rdf:Property ;
    rdfs:label 'Original Claim Line Id' ;
    rdfs:comment 'Reference to the original claim line ID if this is a reversal or adjustment.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Line .

ind:patientResidenceCode rdf:type rdf:Property ;
    rdfs:label 'Patient Residence Code' ;
    rdfs:comment 'Code indicating the patient\'s residence type (00=home, 01=skilled nursing facility, 02=nursing facility, etc.).' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:levelOfService rdf:type rdf:Property ;
    rdfs:label 'Level Of Service' ;
    rdfs:comment 'Code indicating the level of professional service provided by the pharmacist.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prescriptionOriginCode rdf:type rdf:Property ;
    rdfs:label 'Prescription Origin Code' ;
    rdfs:comment 'Code indicating how the prescription was received (0=not specified, 1=written, 2=telephone, 3=electronic, 4=fax, 5=pharmacy).' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobOtherPayerAmount rdf:type rdf:Property ;
    rdfs:label 'Cob Other Payer Amount' ;
    rdfs:comment 'Amount paid by other insurance in coordination of benefits scenarios.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accumulatedDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Accumulated Deductible Amount' ;
    rdfs:comment 'Total deductible amount accumulated by the member year-to-date after this claim.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Deductible Amount' ;
    rdfs:comment 'Remaining deductible amount the member must satisfy after this claim.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accumulatedOutOfPocketAmount rdf:type rdf:Property ;
    rdfs:label 'Accumulated Out Of Pocket Amount' ;
    rdfs:comment 'Total out-of-pocket amount accumulated by the member year-to-date after this claim.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingOutOfPocketAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Out Of Pocket Amount' ;
    rdfs:comment 'Remaining out-of-pocket maximum the member must satisfy after this claim.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageGapIndicator rdf:type rdf:Property ;
    rdfs:label 'Coverage Gap Indicator' ;
    rdfs:comment 'Indicates whether the member is in the Medicare Part D coverage gap (donut hole) for this claim.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:catastrophicCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Catastrophic Coverage Indicator' ;
    rdfs:comment 'Indicates whether the member has reached catastrophic coverage phase for this claim.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lowIncomeSubsidyIndicator rdf:type rdf:Property ;
    rdfs:label 'Low Income Subsidy Indicator' ;
    rdfs:comment 'Indicates whether the member qualifies for Medicare Part D Low Income Subsidy.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brandGenericSavingsAmount rdf:type rdf:Property ;
    rdfs:label 'Brand Generic Savings Amount' ;
    rdfs:comment 'Estimated savings if a generic alternative had been dispensed instead of brand.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacyClaimLineSequence rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Claim Line Sequence' ;
    rdfs:comment 'Sequential line number within the parent pharmacy claim for ordering multiple line items.' ;
    rdfs:domain ind:ClaimLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorAuthReqId rdf:type rdf:Property ;
    rdfs:label 'Prior Auth Req Id' ;
    rdfs:comment 'Unique identifier for the prior authorization request record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PriorAuthReq .

ind:requestNumber rdf:type rdf:Property ;
    rdfs:label 'Request Number' ;
    rdfs:comment 'Human-readable unique request number assigned to the prior authorization request for tracking and reference purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestUrgency rdf:type rdf:Property ;
    rdfs:label 'Request Urgency' ;
    rdfs:comment 'Urgency level of the prior authorization request indicating the clinical priority and required turnaround time.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugForm rdf:type rdf:Property ;
    rdfs:label 'Drug Form' ;
    rdfs:comment 'Dosage form of the medication (e.g., tablet, capsule, injection).' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityRequested rdf:type rdf:Property ;
    rdfs:label 'Quantity Requested' ;
    rdfs:comment 'Quantity of the medication requested in the prior authorization, measured in the appropriate unit (tablets, ml, etc.).' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:refillsRequested rdf:type rdf:Property ;
    rdfs:label 'Refills Requested' ;
    rdfs:comment 'Number of refills requested for the medication as part of the prior authorization.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prescriberFax rdf:type rdf:Property ;
    rdfs:label 'Prescriber Fax' ;
    rdfs:comment 'Fax number for the prescribing physician or provider office for communication regarding the prior authorization.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousTreatments rdf:type rdf:Property ;
    rdfs:label 'Previous Treatments' ;
    rdfs:comment 'Description of previous medications or treatments attempted before requesting this medication, often required for step therapy protocols.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentFailureReason rdf:type rdf:Property ;
    rdfs:label 'Treatment Failure Reason' ;
    rdfs:comment 'Explanation of why previous treatments were ineffective or inappropriate, supporting the need for the requested medication.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contraindicationNotes rdf:type rdf:Property ;
    rdfs:label 'Contraindication Notes' ;
    rdfs:comment 'Documentation of any contraindications or adverse reactions to alternative medications that justify the requested drug.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyPhone rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Phone' ;
    rdfs:comment 'Contact phone number for the dispensing pharmacy.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepTherapyCompleted rdf:type rdf:Property ;
    rdfs:label 'Step Therapy Completed' ;
    rdfs:comment 'Indicator of whether required step therapy protocols have been completed by the member.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantityLimitApplicable rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit Applicable' ;
    rdfs:comment 'Indicator of whether quantity limits apply to the requested medication under the health plan\'s pharmacy benefit.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantityLimitValue rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit Value' ;
    rdfs:comment 'Maximum quantity allowed per fill or time period under the health plan\'s quantity limit policy.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:decisionCode rdf:type rdf:Property ;
    rdfs:label 'Decision Code' ;
    rdfs:comment 'Standardized code indicating the decision outcome (e.g., A1=Approved, D1=Denied, P1=Pended for additional information).' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalNumber rdf:type rdf:Property ;
    rdfs:label 'Approval Number' ;
    rdfs:comment 'Unique authorization number assigned when the prior authorization is approved, used for claims processing.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerToPeerRequested rdf:type rdf:Property ;
    rdfs:label 'Peer To Peer Requested' ;
    rdfs:comment 'Indicator of whether the prescribing physician requested a peer-to-peer consultation with the plan\'s medical director.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionSource rdf:type rdf:Property ;
    rdfs:label 'Submission Source' ;
    rdfs:comment 'Entity that submitted the prior authorization request (e.g., provider, member, pharmacy).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expeditedReviewReason rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Reason' ;
    rdfs:comment 'Clinical justification for requesting expedited review of the prior authorization due to urgent medical need.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pbmProcessorControlNumber rdf:type rdf:Property ;
    rdfs:label 'Pbm Processor Control Number' ;
    rdfs:comment 'Unique control number assigned by the PBM for tracking the prior authorization request.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberCoinsurancePercent rdf:type rdf:Property ;
    rdfs:label 'Member Coinsurance Percent' ;
    rdfs:comment 'Percentage of medication cost the member is responsible for under coinsurance cost-sharing.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:therapeuticClass rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Class' ;
    rdfs:comment 'Therapeutic classification of the medication indicating its primary clinical use (e.g., antihypertensive, antibiotic, antidiabetic).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offLabelUse rdf:type rdf:Property ;
    rdfs:label 'Off Label Use' ;
    rdfs:comment 'Indicator of whether the medication is being prescribed for an off-label use not approved by the FDA.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offLabelJustification rdf:type rdf:Property ;
    rdfs:label 'Off Label Justification' ;
    rdfs:comment 'Clinical justification and supporting evidence for off-label use of the medication.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Clinical Criteria Met' ;
    rdfs:comment 'Indicator of whether the request meets the health plan\'s clinical criteria for approval.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportingDocumentationReceived rdf:type rdf:Property ;
    rdfs:label 'Supporting Documentation Received' ;
    rdfs:comment 'Indicator of whether all required supporting clinical documentation has been received for review.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pendedReason rdf:type rdf:Property ;
    rdfs:label 'Pended Reason' ;
    rdfs:comment 'Reason why the prior authorization request was pended and additional information is required.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachAttempts rdf:type rdf:Property ;
    rdfs:label 'Outreach Attempts' ;
    rdfs:comment 'Number of attempts made to contact the prescriber or provider for additional information.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retroactiveReview rdf:type rdf:Property ;
    rdfs:label 'Retroactive Review' ;
    rdfs:comment 'Indicator of whether this is a retroactive prior authorization review conducted after medication dispensing.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyOverride rdf:type rdf:Property ;
    rdfs:label 'Emergency Override' ;
    rdfs:comment 'Indicator of whether an emergency override was applied to allow immediate medication dispensing pending formal review.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:continuationOfTherapy rdf:type rdf:Property ;
    rdfs:label 'Continuation Of Therapy' ;
    rdfs:comment 'Indicator of whether this request is for continuation of an existing therapy the member was previously receiving.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transitionFillProvided rdf:type rdf:Property ;
    rdfs:label 'Transition Fill Provided' ;
    rdfs:comment 'Indicator of whether a temporary transition fill was provided while the prior authorization is being processed.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseManagerAssigned rdf:type rdf:Property ;
    rdfs:label 'Case Manager Assigned' ;
    rdfs:comment 'Name of the case manager assigned to coordinate care and support the prior authorization process.' ;
    rdfs:domain ind:PriorAuthReq ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugId rdf:type rdf:Property ;
    rdfs:label 'Drug Id' ;
    rdfs:comment 'Unique system identifier for the drug record in the enterprise data warehouse.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Drug .

ind:ndcFormat rdf:type rdf:Property ;
    rdfs:label 'Ndc Format' ;
    rdfs:comment 'The segment format of the NDC indicating the labeler-product-package configuration (e.g., 5-4-2, 5-3-2, 4-4-2).' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:labelerCode rdf:type rdf:Property ;
    rdfs:label 'Labeler Code' ;
    rdfs:comment 'The first segment of the NDC identifying the manufacturer or labeler of the drug product.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proprietaryName rdf:type rdf:Property ;
    rdfs:label 'Proprietary Name' ;
    rdfs:comment 'The brand or trade name of the drug as marketed by the manufacturer (e.g., Lipitor, Advil).' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonProprietaryName rdf:type rdf:Property ;
    rdfs:label 'Non Proprietary Name' ;
    rdfs:comment 'The generic or non-proprietary name of the drug, typically the active ingredient name (e.g., atorvastatin, ibuprofen).' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activeIngredient rdf:type rdf:Property ;
    rdfs:label 'Active Ingredient' ;
    rdfs:comment 'The chemical substance in the drug responsible for its therapeutic effect.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inactiveIngredients rdf:type rdf:Property ;
    rdfs:label 'Inactive Ingredients' ;
    rdfs:comment 'The non-therapeutic components of the drug formulation (e.g., binders, fillers, preservatives, colorants).' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:class rdf:type rdf:Property ;
    rdfs:label 'Class' ;
    rdfs:comment 'The therapeutic or pharmacological classification of the drug (e.g., antihypertensive, antibiotic, analgesic).' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticCategory rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Category' ;
    rdfs:comment 'The broad therapeutic category indicating the primary medical use of the drug (e.g., cardiovascular, anti-infective, central nervous system).' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxOtcIndicator rdf:type rdf:Property ;
    rdfs:label 'Rx Otc Indicator' ;
    rdfs:comment 'Indicates whether the drug requires a prescription (Rx) or is available over-the-counter (OTC).' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageQuantity rdf:type rdf:Property ;
    rdfs:label 'Package Quantity' ;
    rdfs:comment 'The numeric quantity of dosage units in the package.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:packageUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Package Unit Of Measure' ;
    rdfs:comment 'The unit of measure for the package quantity (e.g., tablet, capsule, mL, gram, vial).' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpiDescription rdf:type rdf:Property ;
    rdfs:label 'Gpi Description' ;
    rdfs:comment 'The human-readable description of the GPI classification.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ahfsCode rdf:type rdf:Property ;
    rdfs:label 'Ahfs Code' ;
    rdfs:comment 'The AHFS therapeutic classification code used to categorize drugs by pharmacological and therapeutic properties.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atcCode rdf:type rdf:Property ;
    rdfs:label 'Atc Code' ;
    rdfs:comment 'The WHO Anatomical Therapeutic Chemical classification code used internationally to classify drugs by organ system and therapeutic properties.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysSupplyLimit rdf:type rdf:Property ;
    rdfs:label 'Days Supply Limit' ;
    rdfs:comment 'The maximum number of days supply that can be dispensed per prescription fill.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:repackagedIndicator rdf:type rdf:Property ;
    rdfs:label 'Repackaged Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug has been repackaged from bulk containers into smaller units by a repackager.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interchangeableIndicator rdf:type rdf:Property ;
    rdfs:label 'Interchangeable Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the biosimilar is designated as interchangeable with its reference biologic, allowing pharmacy-level substitution.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bloodProductIndicator rdf:type rdf:Property ;
    rdfs:label 'Blood Product Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug is derived from human blood or plasma.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refrigerationRequired rdf:type rdf:Property ;
    rdfs:label 'Refrigeration Required' ;
    rdfs:comment 'Boolean flag indicating whether the drug requires refrigerated storage conditions.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazardousDrugIndicator rdf:type rdf:Property ;
    rdfs:label 'Hazardous Drug Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug is classified as hazardous requiring special handling and disposal procedures.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blackBoxWarningIndicator rdf:type rdf:Property ;
    rdfs:label 'Black Box Warning Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug has an FDA-mandated black box warning for serious or life-threatening risks.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remsRequired rdf:type rdf:Property ;
    rdfs:label 'Rems Required' ;
    rdfs:comment 'Boolean flag indicating whether the drug requires participation in an FDA Risk Evaluation and Mitigation Strategy program.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pregnancyCategory rdf:type rdf:Property ;
    rdfs:label 'Pregnancy Category' ;
    rdfs:comment 'The FDA pregnancy category indicating potential risks to fetus (A=safest, X=contraindicated, N=not classified). Note: FDA replaced this with pregnancy and lactation labeling in 2015.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lactationRiskCategory rdf:type rdf:Property ;
    rdfs:label 'Lactation Risk Category' ;
    rdfs:comment 'The classification of risk for use during breastfeeding.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pediatricUseIndicator rdf:type rdf:Property ;
    rdfs:label 'Pediatric Use Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug is approved for use in pediatric populations.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geriatricUseIndicator rdf:type rdf:Property ;
    rdfs:label 'Geriatric Use Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug has specific considerations or warnings for geriatric use.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:beersCriteriaIndicator rdf:type rdf:Property ;
    rdfs:label 'Beers Criteria Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug is listed in the American Geriatrics Society Beers Criteria as potentially inappropriate for older adults.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:narrowTherapeuticIndex rdf:type rdf:Property ;
    rdfs:label 'Narrow Therapeutic Index' ;
    rdfs:comment 'Boolean flag indicating whether the drug has a narrow therapeutic index requiring careful dosing and monitoring.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:highAlertMedication rdf:type rdf:Property ;
    rdfs:label 'High Alert Medication' ;
    rdfs:comment 'Boolean flag indicating whether the drug is classified as a high-alert medication with heightened risk of causing significant patient harm when used in error.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lookAlikeSoundAlike rdf:type rdf:Property ;
    rdfs:label 'Look Alike Sound Alike' ;
    rdfs:comment 'Boolean flag indicating whether the drug has been identified as having look-alike or sound-alike name confusion risks.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fdaApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Fda Approval Date' ;
    rdfs:comment 'The date the drug received FDA approval for marketing in the United States.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusivityExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Expiration Date' ;
    rdfs:comment 'The date when the drug\'s FDA-granted market exclusivity period expires.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketStatus rdf:type rdf:Property ;
    rdfs:label 'Market Status' ;
    rdfs:comment 'The current market availability status of the drug product.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallStatus rdf:type rdf:Property ;
    rdfs:label 'Recall Status' ;
    rdfs:comment 'The FDA recall classification if the drug is subject to a recall (Class I=most serious, Class III=least serious).' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticEquivalentGroup rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Equivalent Group' ;
    rdfs:comment 'A grouping identifier for drugs that are therapeutically equivalent and may be substituted for one another.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionSeverity rdf:type rdf:Property ;
    rdfs:label 'Interaction Severity' ;
    rdfs:comment 'The highest severity level of known drug-drug interactions for this medication.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:foodInteractionIndicator rdf:type rdf:Property ;
    rdfs:label 'Food Interaction Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug has clinically significant interactions with food or beverages.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alcoholInteractionIndicator rdf:type rdf:Property ;
    rdfs:label 'Alcohol Interaction Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug has contraindications or warnings for concurrent alcohol use.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renalDosingAdjustmentRequired rdf:type rdf:Property ;
    rdfs:label 'Renal Dosing Adjustment Required' ;
    rdfs:comment 'Boolean flag indicating whether the drug requires dose adjustment for patients with renal impairment.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hepaticDosingAdjustmentRequired rdf:type rdf:Property ;
    rdfs:label 'Hepatic Dosing Adjustment Required' ;
    rdfs:comment 'Boolean flag indicating whether the drug requires dose adjustment for patients with hepatic impairment.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:therapeuticDuplicationClass rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Duplication Class' ;
    rdfs:comment 'A classification code used to identify drugs with similar therapeutic effects for detecting therapeutic duplication in drug regimens.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitDoseIndicator rdf:type rdf:Property ;
    rdfs:label 'Unit Dose Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug is packaged in unit-dose format for institutional use.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preservativeFreeIndicator rdf:type rdf:Property ;
    rdfs:label 'Preservative Free Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug formulation is preservative-free.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latexFreeIndicator rdf:type rdf:Property ;
    rdfs:label 'Latex Free Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug packaging and delivery devices are latex-free.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:glutenFreeIndicator rdf:type rdf:Property ;
    rdfs:label 'Gluten Free Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug formulation is certified gluten-free.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dyeFreeIndicator rdf:type rdf:Property ;
    rdfs:label 'Dye Free Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug formulation is free of artificial dyes and colorants.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sugarFreeIndicator rdf:type rdf:Property ;
    rdfs:label 'Sugar Free Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug formulation is sugar-free, relevant for diabetic patients.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kosherCertifiedIndicator rdf:type rdf:Property ;
    rdfs:label 'Kosher Certified Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug has kosher certification.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:halalCertifiedIndicator rdf:type rdf:Property ;
    rdfs:label 'Halal Certified Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug has halal certification.' ;
    rdfs:domain ind:Drug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rebateId rdf:type rdf:Property ;
    rdfs:label 'Rebate Id' ;
    rdfs:comment 'Unique identifier for the pharmaceutical rebate contract record.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rebate .

ind:minimumVolume rdf:type rdf:Property ;
    rdfs:label 'Minimum Volume' ;
    rdfs:comment 'The minimum number of prescriptions or units required to qualify for this rebate tier.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumVolume rdf:type rdf:Property ;
    rdfs:label 'Maximum Volume' ;
    rdfs:comment 'The maximum number of prescriptions or units eligible for this rebate tier before a different tier applies.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:volumeUnit rdf:type rdf:Property ;
    rdfs:label 'Volume Unit' ;
    rdfs:comment 'The unit of measure for volume thresholds (e.g., prescription, claim, unit, package).' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketShareTarget rdf:type rdf:Property ;
    rdfs:label 'Market Share Target' ;
    rdfs:comment 'The target market share percentage required to earn this rebate, if applicable to market share agreements.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentLagDays rdf:type rdf:Property ;
    rdfs:label 'Payment Lag Days' ;
    rdfs:comment 'The number of days after the period end before rebate payment is due or expected.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genericFlag rdf:type rdf:Property ;
    rdfs:label 'Generic Flag' ;
    rdfs:comment 'Indicates whether this rebate applies to a generic pharmaceutical product.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brandFlag rdf:type rdf:Property ;
    rdfs:label 'Brand Flag' ;
    rdfs:comment 'Indicates whether this rebate applies to a brand-name pharmaceutical product.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retailEligible rdf:type rdf:Property ;
    rdfs:label 'Retail Eligible' ;
    rdfs:comment 'Indicates whether prescriptions filled at retail pharmacies are eligible for this rebate.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialtyPharmacyEligible rdf:type rdf:Property ;
    rdfs:label 'Specialty Pharmacy Eligible' ;
    rdfs:comment 'Indicates whether prescriptions filled through specialty pharmacies are eligible for this rebate.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:passThroughPercentage rdf:type rdf:Property ;
    rdfs:label 'Pass Through Percentage' ;
    rdfs:comment 'The percentage of the rebate that is passed through to the plan sponsor or employer.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retainedPercentage rdf:type rdf:Property ;
    rdfs:label 'Retained Percentage' ;
    rdfs:comment 'The percentage of the rebate retained by the Pharmacy Benefit Manager (PBM) as administrative fees or margin.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceTarget rdf:type rdf:Property ;
    rdfs:label 'Performance Target' ;
    rdfs:comment 'The numeric target value for the performance metric that must be achieved to earn the rebate.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:guaranteeAmount rdf:type rdf:Property ;
    rdfs:label 'Guarantee Amount' ;
    rdfs:comment 'The guaranteed minimum rebate amount per member per month (PMPM) or per employee per month (PEPM) as specified in the contract.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:guaranteeBasis rdf:type rdf:Property ;
    rdfs:label 'Guarantee Basis' ;
    rdfs:comment 'The basis on which the rebate guarantee is calculated (e.g., PMPM, PEPM, annual total).' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trueUpProvision rdf:type rdf:Property ;
    rdfs:label 'True Up Provision' ;
    rdfs:comment 'Indicates whether the contract includes a true-up provision to reconcile actual rebates against guaranteed amounts.' ;
    rdfs:domain ind:Rebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditRights rdf:type rdf:Property ;
    rdfs:label 'Audit Rights' ;
    rdfs:comment 'Description of the audit rights granted to the plan sponsor or payer regarding rebate calculations and payments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebateTxnId rdf:type rdf:Property ;
    rdfs:label 'Rebate Txn Id' ;
    rdfs:comment 'Unique identifier for the rebate transaction record. Primary key for the rebate transaction entity.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rebateAgreementId rdf:type rdf:Property ;
    rdfs:label 'Rebate Agreement Id' ;
    rdfs:comment 'Identifier linking this transaction to the master rebate agreement or contract with the manufacturer or Pharmacy Benefit Manager (PBM) partner.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agreement .

ind:partyId rdf:type rdf:Property ;
    rdfs:label 'Party Id' ;
    rdfs:comment 'Identifier for the PBM partner involved in the rebate transaction, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:pbmPartnerName rdf:type rdf:Property ;
    rdfs:label 'Pbm Partner Name' ;
    rdfs:comment 'Business name of the PBM partner involved in the rebate transaction.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebateType rdf:type rdf:Property ;
    rdfs:label 'Rebate Type' ;
    rdfs:comment 'Classification of the rebate type (e.g., manufacturer rebate, PBM rebate, formulary rebate, utilization rebate, market share rebate).' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebateProgramCode rdf:type rdf:Property ;
    rdfs:label 'Rebate Program Code' ;
    rdfs:comment 'Internal code identifying the specific rebate program or initiative under which this transaction is processed.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebateProgramName rdf:type rdf:Property ;
    rdfs:label 'Rebate Program Name' ;
    rdfs:comment 'Descriptive name of the rebate program or initiative.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Service Period Start Date' ;
    rdfs:comment 'Start date of the service period for which the rebate is calculated (e.g., quarter start date). Format: yyyy-MM-dd.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:servicePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Service Period End Date' ;
    rdfs:comment 'End date of the service period for which the rebate is calculated (e.g., quarter end date). Format: yyyy-MM-dd.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prescriptionCount rdf:type rdf:Property ;
    rdfs:label 'Prescription Count' ;
    rdfs:comment 'Total number of prescriptions filled for the drug during the service period that qualify for this rebate.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalIngredientCost rdf:type rdf:Property ;
    rdfs:label 'Total Ingredient Cost' ;
    rdfs:comment 'Total ingredient cost for all prescriptions of this drug during the service period, typically based on Average Wholesale Price (AWP) or Maximum Allowable Cost (MAC).' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awpAmount rdf:type rdf:Property ;
    rdfs:label 'Awp Amount' ;
    rdfs:comment 'Total Average Wholesale Price amount for the drug quantity associated with this rebate transaction.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:macAmount rdf:type rdf:Property ;
    rdfs:label 'Mac Amount' ;
    rdfs:comment 'Total Maximum Allowable Cost amount for the drug quantity associated with this rebate transaction.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebatePerUnit rdf:type rdf:Property ;
    rdfs:label 'Rebate Per Unit' ;
    rdfs:comment 'Rebate amount per unit of the drug (e.g., per tablet, per milliliter).' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseRebateAmount rdf:type rdf:Property ;
    rdfs:label 'Base Rebate Amount' ;
    rdfs:comment 'Base rebate amount before any adjustments, bonuses, or penalties.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceBonusAmount rdf:type rdf:Property ;
    rdfs:label 'Performance Bonus Amount' ;
    rdfs:comment 'Additional rebate amount earned based on performance metrics (e.g., market share, utilization targets).' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netRebateAmount rdf:type rdf:Property ;
    rdfs:label 'Net Rebate Amount' ;
    rdfs:comment 'Final net rebate amount after all adjustments, bonuses, and penalties. This is the actual amount paid or received.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeReasonCode rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason Code' ;
    rdfs:comment 'Code indicating the reason for dispute if the rebate transaction is disputed.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason Description' ;
    rdfs:comment 'Detailed description of the reason for dispute if the rebate transaction is disputed.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Contract Expiration Date' ;
    rdfs:comment 'Expiration date of the rebate contract or agreement. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brandIndicator rdf:type rdf:Property ;
    rdfs:label 'Brand Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the drug is a brand-name formulation.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retailIndicator rdf:type rdf:Property ;
    rdfs:label 'Retail Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the prescriptions were filled at retail pharmacies.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationPeriod rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Period' ;
    rdfs:comment 'The reconciliation period identifier (e.g., Q1 2023, January 2023) for which the rebate is calculated.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refillRequestId rdf:type rdf:Property ;
    rdfs:label 'Refill Request Id' ;
    rdfs:comment 'Unique identifier for the medication refill request submitted by the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RefillRequest .

ind:prescriptionId rdf:type rdf:Property ;
    rdfs:label 'Prescription Id' ;
    rdfs:comment 'Unique identifier for the original prescription being refilled.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Prescription .

ind:requestMethod rdf:type rdf:Property ;
    rdfs:label 'Request Method' ;
    rdfs:comment 'Method or channel through which the member submitted the refill request.' ;
    rdfs:domain ind:RefillRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysSupplyRequested rdf:type rdf:Property ;
    rdfs:label 'Days Supply Requested' ;
    rdfs:comment 'Number of days the requested medication quantity is intended to last.' ;
    rdfs:domain ind:RefillRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:refillsRemaining rdf:type rdf:Property ;
    rdfs:label 'Refills Remaining' ;
    rdfs:comment 'Number of authorized refills remaining on the original prescription at the time of request.' ;
    rdfs:domain ind:RefillRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalFillDate rdf:type rdf:Property ;
    rdfs:label 'Original Fill Date' ;
    rdfs:comment 'Date when the prescription was originally filled.' ;
    rdfs:domain ind:RefillRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastFillDate rdf:type rdf:Property ;
    rdfs:label 'Last Fill Date' ;
    rdfs:comment 'Date when the prescription was last filled or refilled prior to this request.' ;
    rdfs:domain ind:RefillRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prescriptionExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Prescription Expiration Date' ;
    rdfs:comment 'Date when the original prescription expires and can no longer be refilled.' ;
    rdfs:domain ind:RefillRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isSpecialtyDrug rdf:type rdf:Property ;
    rdfs:label 'Is Specialty Drug' ;
    rdfs:comment 'Indicates whether the medication is classified as a specialty drug requiring special handling.' ;
    rdfs:domain ind:RefillRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isControlledSubstance rdf:type rdf:Property ;
    rdfs:label 'Is Controlled Substance' ;
    rdfs:comment 'Indicates whether the medication is a controlled substance under DEA regulations.' ;
    rdfs:domain ind:RefillRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Copay Amount' ;
    rdfs:comment 'Estimated member copayment amount for the refill based on benefit design.' ;
    rdfs:domain ind:RefillRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedTotalCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Total Cost' ;
    rdfs:comment 'Estimated total cost of the refill including ingredient cost, dispensing fee, and other charges.' ;
