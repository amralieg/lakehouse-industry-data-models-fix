    rdfs:label 'Feature Store Entity' ;
    rdfs:comment 'Table storing feature store entities' .

ind:GenomicSequencing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Genomics ;
    rdfs:label 'Genomic Sequencing' ;
    rdfs:comment 'Table for genomic sequencing results' .

ind:SnfStay rdf:type rdfs:Class ;
