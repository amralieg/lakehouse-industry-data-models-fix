ind:overpaymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Overpayment Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment corrects an overpayment on the original claim.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
