    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hccCode rdf:type rdf:Property ;
    rdfs:label 'Hcc Code' ;
    rdfs:comment 'The HCC code derived from the diagnosis codes for this service line, used for risk adjustment in Medicare Advantage and ACA plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
