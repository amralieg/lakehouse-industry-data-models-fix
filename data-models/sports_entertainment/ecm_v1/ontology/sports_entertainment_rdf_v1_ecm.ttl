ind:priorityAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Access Level' ;
    rdfs:comment 'Numeric ranking of priority access for ticket purchases, event reservations, and exclusive content. Higher values indicate greater priority.' ;
    rdfs:domain ind:BenefitPackage ;
