ind:surveyName rdf:type rdf:Property ;
    rdfs:label 'Survey Name' ;
    rdfs:comment 'Descriptive name of the CAHPS survey version.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mortalityReviewId rdf:type rdf:Property ;
