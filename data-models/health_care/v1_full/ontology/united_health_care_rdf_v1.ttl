    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkAdequacyRequired rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Required' ;
    rdfs:comment 'Indicates whether this specialty is subject to network adequacy requirements for regulatory compliance.' ;
    rdfs:domain ind:SpecialtyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:essentialHealthBenefit rdf:type rdf:Property ;
