    rdfs:comment 'Indicates whether the notification delivery met internal service level agreement targets.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expeditedRequest rdf:type rdf:Property ;
    rdfs:label 'Expedited Request' ;
    rdfs:comment 'Indicates whether the authorization was processed as an expedited request requiring faster notification.' ;
