ind:isHierarchical rdf:type rdf:Property ;
    rdfs:label 'Is Hierarchical' ;
    rdfs:comment 'Indicates whether this HCC category participates in hierarchical relationships where more severe conditions supersede less severe ones.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededByHccCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Hcc Code' ;
    rdfs:comment 'The HCC code that supersedes this category in the hierarchy when both conditions are present.' ;
