    rdfs:comment 'Numeric score from initial resume screening or automated assessment (0-100 scale).' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:skillsSummary rdf:type rdf:Property ;
    rdfs:label 'Skills Summary' ;
    rdfs:comment 'Comma-separated or structured summary of the candidate\'s key skills and competencies.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:veteranStatus rdf:type rdf:Property ;
    rdfs:label 'Veteran Status' ;
    rdfs:comment 'Indicates whether the candidate is a veteran for Equal Employment Opportunity (EEO) and affirmative action reporting.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:willingToRelocate rdf:type rdf:Property ;
    rdfs:label 'Willing To Relocate' ;
    rdfs:comment 'Indicates whether the candidate is willing to relocate for the position.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affiliation rdf:type rdf:Property ;
    rdfs:label 'Affiliation' ;
    rdfs:comment 'Parent federation or umbrella organization the union is affiliated with (e.g., AFL-CIO, Change to Win, independent).' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bargainingUnitDescription rdf:type rdf:Property ;
    rdfs:label 'Bargaining Unit Description' ;
    rdfs:comment 'Description of the employee group or job classifications covered by this union (e.g., broadcast technicians, stagehands, performers, officials).' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Cba Effective Date' ;
    rdfs:comment 'Start date of the current collective bargaining agreement between the organization and the union.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cbaExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Cba Expiration Date' ;
    rdfs:comment 'End date of the current collective bargaining agreement. Critical for labor relations planning and negotiation scheduling.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contactName rdf:type rdf:Property ;
    rdfs:label 'Contact Name' ;
    rdfs:comment 'Name of the primary union representative or business agent for labor relations communication.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactTitle rdf:type rdf:Property ;
    rdfs:label 'Contact Title' ;
    rdfs:comment 'Job title or role of the primary union contact (e.g., Business Agent, Shop Steward, Union President).' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decertificationDate rdf:type rdf:Property ;
    rdfs:label 'Decertification Date' ;
    rdfs:comment 'Date when the union was decertified or lost its representation status, if applicable.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:duesDeductionCode rdf:type rdf:Property ;
    rdfs:label 'Dues Deduction Code' ;
    rdfs:comment 'Payroll system code used to process union dues deductions from member paychecks.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duesFlatAmount rdf:type rdf:Property ;
    rdfs:label 'Dues Flat Amount' ;
    rdfs:comment 'Fixed dollar amount deducted for union dues per pay period, if applicable.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:duesPercentage rdf:type rdf:Property ;
    rdfs:label 'Dues Percentage' ;
    rdfs:comment 'Standard percentage of gross wages deducted for union dues, if applicable.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastNegotiationDate rdf:type rdf:Property ;
    rdfs:label 'Last Negotiation Date' ;
    rdfs:comment 'Date of the most recent collective bargaining negotiation session or contract ratification.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:localNumber rdf:type rdf:Property ;
    rdfs:label 'Local Number' ;
    rdfs:comment 'Local chapter or branch number if the union is part of a larger national or international organization.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextNegotiationDate rdf:type rdf:Property ;
    rdfs:label 'Next Negotiation Date' ;
    rdfs:comment 'Scheduled date for the next collective bargaining negotiation or contract renewal discussion.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:strikeHistoryFlag rdf:type rdf:Property ;
    rdfs:label 'Strike History Flag' ;
    rdfs:comment 'Indicates whether this union has a history of work stoppages or strikes involving the organization.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unionAbbreviation rdf:type rdf:Property ;
    rdfs:label 'Union Abbreviation' ;
    rdfs:comment 'Commonly used abbreviation or acronym for the union name (e.g., SAG-AFTRA, IATSE, IBEW).' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionName rdf:type rdf:Property ;
    rdfs:label 'Union Name' ;
    rdfs:comment 'Full legal name of the labor union or collective bargaining unit.' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionType rdf:type rdf:Property ;
    rdfs:label 'Union Type' ;
    rdfs:comment 'Classification of the union based on the type of workers represented (craft, industrial, professional, public sector, entertainment).' ;
    rdfs:domain ind:Union ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationNumber rdf:type rdf:Property ;
    rdfs:label 'Accreditation Number' ;
    rdfs:comment 'Unique accreditation or approval number issued by the accreditation body. Used for audit and compliance verification.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentOwner rdf:type rdf:Property ;
    rdfs:label 'Content Owner' ;
    rdfs:comment 'Name of the internal department, team, or individual responsible for course content development, maintenance, and quality assurance.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costPerParticipant rdf:type rdf:Property ;
    rdfs:label 'Cost Per Participant' ;
    rdfs:comment 'Standard cost per participant for delivering the course, including instructor fees, materials, and facility costs. Used for training budget planning and cost allocation. Currency is USD.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:courseCode rdf:type rdf:Property ;
    rdfs:label 'Course Code' ;
    rdfs:comment 'Externally-known unique alphanumeric code identifying the course in the learning management system and HR systems. Used for course registration and transcript references.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courseType rdf:type rdf:Property ;
    rdfs:label 'Course Type' ;
    rdfs:comment 'Classification of the course delivery method and format. Determines scheduling, resource allocation, and completion tracking requirements.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditHours rdf:type rdf:Property ;
    rdfs:label 'Credit Hours' ;
    rdfs:comment 'Number of continuing education or professional development credit hours awarded upon successful completion. Used for certification and license maintenance.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:difficultyLevel rdf:type rdf:Property ;
    rdfs:label 'Difficulty Level' ;
    rdfs:comment 'Skill level required or targeted by the course. Used for prerequisite validation and career path planning.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationHours rdf:type rdf:Property ;
    rdfs:label 'Duration Hours' ;
    rdfs:comment 'Standard duration of the course measured in hours. Used for scheduling, capacity planning, and training time tracking.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Is Compliance Required' ;
    rdfs:comment 'Indicates whether the course fulfills regulatory or industry compliance requirements such as OSHA safety training or collective bargaining agreement obligations. True if compliance-related.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:learningObjectives rdf:type rdf:Property ;
    rdfs:label 'Learning Objectives' ;
    rdfs:comment 'Structured list of specific learning outcomes and competencies participants will achieve upon successful completion of the course.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialsIncluded rdf:type rdf:Property ;
    rdfs:label 'Materials Included' ;
    rdfs:comment 'Description of materials provided to participants, such as workbooks, digital resources, reference guides, or certification kits.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxEnrollment rdf:type rdf:Property ;
    rdfs:label 'Max Enrollment' ;
    rdfs:comment 'Maximum number of participants that can be enrolled in a single course offering. Used for capacity planning and waitlist management.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minEnrollment rdf:type rdf:Property ;
    rdfs:label 'Min Enrollment' ;
    rdfs:comment 'Minimum number of participants required for a course offering to proceed. Used for cost-effectiveness and scheduling decisions.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:passingScorePercentage rdf:type rdf:Property ;
    rdfs:label 'Passing Score Percentage' ;
    rdfs:comment 'Minimum score percentage required to successfully complete the course. Used for assessment and certification validation.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prerequisites rdf:type rdf:Property ;
    rdfs:label 'Prerequisites' ;
    rdfs:comment 'Description of prerequisite courses, certifications, or experience required before enrolling in this course. Used for enrollment validation.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recertificationIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Recertification Interval Months' ;
    rdfs:comment 'Number of months after course completion before recertification is required. Null if recertification is not required.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Recertification Required' ;
    rdfs:comment 'Indicates whether the course requires periodic recertification or renewal. True if recertification is required to maintain compliance or competency.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shortTitle rdf:type rdf:Property ;
    rdfs:label 'Short Title' ;
    rdfs:comment 'Abbreviated title of the course for use in reports, dashboards, and mobile interfaces where space is limited.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectArea rdf:type rdf:Property ;
    rdfs:label 'Subject Area' ;
    rdfs:comment 'Specific subject domain or discipline the course covers (e.g., broadcast operations, event management, talent relations, venue safety, production technology).' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorName rdf:type rdf:Property ;
    rdfs:label 'Vendor Name' ;
    rdfs:comment 'Name of the external training vendor or provider if the course is delivered by a third party. Null for internally-developed courses.' ;
    rdfs:domain ind:Course ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversedPayrollRunId rdf:type rdf:Property ;
    rdfs:label 'Reversed Payroll Run Id' ;
    rdfs:comment 'Reference to the original payroll run that this run reverses (populated only if reversal_flag is true).' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PayrollRun .

ind:calculationEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation End Timestamp' ;
    rdfs:comment 'Date and time when payroll calculation processing completed for this run.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:calculationStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Start Timestamp' ;
    rdfs:comment 'Date and time when payroll calculation processing began for this run.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:checkDate rdf:type rdf:Property ;
    rdfs:label 'Check Date' ;
    rdfs:comment 'The date printed on physical checks or used as the effective date for electronic payments.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectiveBargainingAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Collective Bargaining Agreement Flag' ;
    rdfs:comment 'Indicates whether this payroll run includes employees covered by a collective bargaining agreement.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:generalLedgerBatchReference rdf:type rdf:Property ;
    rdfs:label 'General Ledger Batch Reference' ;
    rdfs:comment 'Identifier of the general ledger batch to which this payroll run was posted for financial accounting.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offCycleReason rdf:type rdf:Property ;
    rdfs:label 'Off Cycle Reason' ;
    rdfs:comment 'Explanation for why this payroll run was processed outside the regular payroll schedule (applicable only for off-cycle runs).' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paidTimestamp rdf:type rdf:Property ;
    rdfs:label 'Paid Timestamp' ;
    rdfs:comment 'Date and time when payments were successfully disbursed to employees for this payroll run.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:payrollArea rdf:type rdf:Property ;
    rdfs:label 'Payroll Area' ;
    rdfs:comment 'Organizational subdivision within the company that groups employees by payroll processing characteristics (e.g., hourly staff, salaried staff, union workers).' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Payroll Company Code' ;
    rdfs:comment 'The legal entity or company code under which this payroll run is processed, used for financial and tax reporting segregation.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollFrequency rdf:type rdf:Property ;
    rdfs:label 'Payroll Frequency' ;
    rdfs:comment 'The recurring schedule on which this payroll run is processed (e.g., weekly, biweekly, semimonthly, monthly).' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Posted Timestamp' ;
    rdfs:comment 'Date and time when this payroll run was posted to the general ledger.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:totalDeductions rdf:type rdf:Property ;
    rdfs:label 'Total Deductions' ;
    rdfs:comment 'Aggregate amount of all deductions (taxes, benefits, garnishments) withheld from employee pay in this payroll run.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEmployerBenefits rdf:type rdf:Property ;
    rdfs:label 'Total Employer Benefits' ;
    rdfs:comment 'Aggregate employer-paid benefits contributions (e.g., health insurance, retirement matching) for this payroll run.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEmployerTaxes rdf:type rdf:Property ;
    rdfs:label 'Total Employer Taxes' ;
    rdfs:comment 'Aggregate employer-paid payroll taxes (e.g., FICA, FUTA, SUTA) for this payroll run.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalGrossPay rdf:type rdf:Property ;
    rdfs:label 'Total Gross Pay' ;
    rdfs:comment 'Aggregate gross earnings for all employees included in this payroll run before any deductions.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalNetPay rdf:type rdf:Property ;
    rdfs:label 'Total Net Pay' ;
    rdfs:comment 'Aggregate net pay disbursed to all employees in this payroll run after all deductions.' ;
    rdfs:domain ind:PayrollRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:competencyFrameworkId rdf:type rdf:Property ;
    rdfs:label 'Competency Framework Id' ;
    rdfs:comment 'Reference to the competency framework used for evaluating skills and behaviors in this review form.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompetencyFramework .

ind:approvalWorkflowRequired rdf:type rdf:Property ;
    rdfs:label 'Approval Workflow Required' ;
    rdfs:comment 'Indicates whether completed reviews using this form require formal approval workflow through HR or senior management.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calibrationRequired rdf:type rdf:Property ;
    rdfs:label 'Calibration Required' ;
    rdfs:comment 'Indicates whether reviews using this form must go through a calibration session to ensure rating consistency across the organization.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compensationImpact rdf:type rdf:Property ;
    rdfs:label 'Compensation Impact' ;
    rdfs:comment 'Indicates whether results from this review form directly influence compensation decisions such as merit increases or bonuses.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employeeCategory rdf:type rdf:Property ;
    rdfs:label 'Employee Category' ;
    rdfs:comment 'Employee classification for which this review form is designed, aligning with workforce segments in sports entertainment operations.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCompletionMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Completion Minutes' ;
    rdfs:comment 'Estimated time in minutes required to complete this review form, used for planning and communication to participants.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formCode rdf:type rdf:Property ;
    rdfs:label 'Form Code' ;
    rdfs:comment 'Business identifier code for the review form template used in HR systems and reporting.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formName rdf:type rdf:Property ;
    rdfs:label 'Form Name' ;
    rdfs:comment 'Human-readable name of the review form template (e.g., Annual Performance Review, 90-Day Probation Review, Talent Assessment).' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formStatus rdf:type rdf:Property ;
    rdfs:label 'Form Status' ;
    rdfs:comment 'Current lifecycle status of the review form template indicating availability for use in performance cycles.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formType rdf:type rdf:Property ;
    rdfs:label 'Form Type' ;
    rdfs:comment 'Classification of the review form by purpose and usage context within the performance management lifecycle.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:includesManagerAssessment rdf:type rdf:Property ;
    rdfs:label 'Includes Manager Assessment' ;
    rdfs:comment 'Indicates whether this review form includes an assessment component completed by the direct manager.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesPeerFeedback rdf:type rdf:Property ;
    rdfs:label 'Includes Peer Feedback' ;
    rdfs:comment 'Indicates whether this review form includes feedback from peer colleagues as part of a 360-degree review process.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesSelfAssessment rdf:type rdf:Property ;
    rdfs:label 'Includes Self Assessment' ;
    rdfs:comment 'Indicates whether this review form includes a self-assessment component completed by the employee being reviewed.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesUpwardFeedback rdf:type rdf:Property ;
    rdfs:label 'Includes Upward Feedback' ;
    rdfs:comment 'Indicates whether this review form includes feedback from direct reports evaluating their manager.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUsedDate rdf:type rdf:Property ;
    rdfs:label 'Last Used Date' ;
    rdfs:comment 'Most recent date when this review form template was used to initiate a performance review.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalEntity rdf:type rdf:Property ;
    rdfs:label 'Legal Entity' ;
    rdfs:comment 'Legal entity or subsidiary for which this review form is applicable, supporting multi-entity sports entertainment operations.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:localizationAvailable rdf:type rdf:Property ;
    rdfs:label 'Localization Available' ;
    rdfs:comment 'Indicates whether this review form has been localized and is available in multiple languages for global workforce use.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:questionCount rdf:type rdf:Property ;
    rdfs:label 'Question Count' ;
    rdfs:comment 'Total number of questions, rating items, or assessment criteria included in this review form template.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingScaleType rdf:type rdf:Property ;
    rdfs:label 'Rating Scale Type' ;
    rdfs:comment 'Type of rating or scoring methodology used in this review form for evaluating employee performance.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresDevelopmentPlan rdf:type rdf:Property ;
    rdfs:label 'Requires Development Plan' ;
    rdfs:comment 'Indicates whether this review form requires creation of an individual development plan for talent growth and skill enhancement.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresGoalSetting rdf:type rdf:Property ;
    rdfs:label 'Requires Goal Setting' ;
    rdfs:comment 'Indicates whether completion of this review form requires the establishment of performance goals for the next review period.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewCycleType rdf:type rdf:Property ;
    rdfs:label 'Review Cycle Type' ;
    rdfs:comment 'Frequency or timing pattern for which this review form is designed within the performance management calendar.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionCount rdf:type rdf:Property ;
    rdfs:label 'Section Count' ;
    rdfs:comment 'Number of major sections or categories within this review form template structure.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:successionPlanningImpact rdf:type rdf:Property ;
    rdfs:label 'Succession Planning Impact' ;
    rdfs:comment 'Indicates whether results from this review form are used in succession planning and talent pipeline identification.' ;
    rdfs:domain ind:ReviewForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mentorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Mentor Employee Id' ;
    rdfs:comment 'Reference to the assigned mentor or coach supporting the employee through this development plan. Links to the employee master record. Nullable if no formal mentor is assigned.' ;
    rdfs:domain ind:DevelopmentPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:targetPositionId rdf:type rdf:Property ;
    rdfs:label 'Target Position Id' ;
    rdfs:comment 'Reference to the target job position or role that this development plan is preparing the employee for. Links to the position master record. Nullable for skill-focused plans without a specific target role.' ;
    rdfs:domain ind:DevelopmentPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:careerTrack rdf:type rdf:Property ;
    rdfs:label 'Career Track' ;
    rdfs:comment 'The specific career path or track this development plan supports (e.g., \'Technical Specialist\', \'People Management\', \'Broadcast Operations\', \'League Official\', \'Venue Management\').' ;
    rdfs:domain ind:DevelopmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenter rdf:type rdf:Property ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'The financial cost center responsible for funding and tracking expenses related to this development plan (training costs, certification fees, etc.).' ;
    rdfs:domain ind:DevelopmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentCompetencyLevel rdf:type rdf:Property ;
    rdfs:label 'Current Competency Level' ;
    rdfs:comment 'The employee\'s assessed competency level at the start of the development plan, establishing the baseline for measuring growth.' ;
    rdfs:domain ind:DevelopmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Budget Amount' ;
    rdfs:comment 'The estimated total budget allocated for this development plan, covering training, certifications, travel, and other development-related expenses. Expressed in USD.' ;
    rdfs:domain ind:DevelopmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:progressPercentage rdf:type rdf:Property ;
    rdfs:label 'Progress Percentage' ;
    rdfs:comment 'The overall completion percentage of the development plan, calculated based on completed activities, milestones, and objectives. Range: 0.00 to 100.00.' ;
    rdfs:domain ind:DevelopmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:successionPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Succession Plan Flag' ;
    rdfs:comment 'Indicates whether this development plan is part of a formal succession planning initiative to prepare the employee for a critical or leadership role.' ;
    rdfs:domain ind:DevelopmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetCompetencyLevel rdf:type rdf:Property ;
    rdfs:label 'Target Competency Level' ;
    rdfs:comment 'The desired competency level the employee should achieve upon successful completion of the development plan.' ;
    rdfs:domain ind:DevelopmentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandCategory rdf:type rdf:Property ;
    rdfs:label 'Brand Category' ;
    rdfs:comment 'High-level category classifying the brand by its entertainment genre or sports discipline.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandHealthIndex rdf:type rdf:Property ;
    rdfs:label 'Brand Health Index' ;
    rdfs:comment 'Composite metric measuring overall brand strength including awareness, perception, loyalty, and market performance, scaled 0-100.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brandManagerEmail rdf:type rdf:Property ;
    rdfs:label 'Brand Manager Email' ;
    rdfs:comment 'Business email address of the brand manager for internal communication and coordination.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandManagerName rdf:type rdf:Property ;
    rdfs:label 'Brand Manager Name' ;
    rdfs:comment 'Full name of the individual responsible for managing the brand strategy and operations.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandValueUsd rdf:type rdf:Property ;
    rdfs:label 'Brand Value Usd' ;
    rdfs:comment 'Estimated monetary value of the brand in US dollars based on market analysis and revenue generation potential.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastRightsHolder rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Holder' ;
    rdfs:comment 'Name of the media company or network that holds exclusive broadcasting rights for brand content.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanClubEnabledFlag rdf:type rdf:Property ;
