ind:parentRuleId rdf:type rdf:Property ;
    rdfs:label 'Parent Rule Id' ;
    rdfs:comment 'Reference to a parent segment rule if this rule is a variant, refinement, or sub-rule of another segment rule. Null if this is a top-level rule.' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SegmentRule .

ind:appliesToMemberTypes rdf:type rdf:Property ;
    rdfs:label 'Applies To Member Types' ;
    rdfs:comment 'Comma-separated list or description of fan membership types to which this rule applies (e.g., individual, family, season_ticket_holder, VIP, fan_club_member).' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessOwner rdf:type rdf:Property ;
    rdfs:label 'Business Owner' ;
    rdfs:comment 'Name or identifier of the business unit, team, or individual responsible for defining and maintaining this segment rule.' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelScope rdf:type rdf:Property ;
    rdfs:label 'Channel Scope' ;
    rdfs:comment 'Engagement channels to which this segment rule applies (e.g., all_channels, digital_only, in_venue_only, broadcast, mobile_app).' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedFanCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Fan Count' ;
    rdfs:comment 'Estimated or last calculated number of fans who qualify for this segment rule based on the most recent evaluation.' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCcpaCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Ccpa Compliant' ;
    rdfs:comment 'Indicates whether this segment rule has been reviewed and approved for compliance with CCPA privacy requirements for California fan data processing.' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isGdprCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Gdpr Compliant' ;
    rdfs:comment 'Indicates whether this segment rule has been reviewed and approved for compliance with GDPR privacy requirements for fan data processing.' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastEvaluationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Evaluation Timestamp' ;
    rdfs:comment 'The timestamp when this segment rule was last evaluated and applied to the fan base.' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lookbackPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Days' ;
    rdfs:comment 'The number of days in the past that the rule evaluates when assessing fan behavior or transactions (e.g., 90 days for recent purchase activity, 365 days for annual spend).' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marketingUseAllowed rdf:type rdf:Property ;
    rdfs:label 'Marketing Use Allowed' ;
    rdfs:comment 'Indicates whether fans identified by this segment rule can be targeted for marketing campaigns and promotional communications.' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Maximum Threshold Value' ;
    rdfs:comment 'The maximum numeric threshold value that must not be exceeded for a fan to qualify for this segment (e.g., maximum days since last purchase, maximum churn risk score).' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextEvaluationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Next Evaluation Timestamp' ;
    rdfs:comment 'The timestamp when this segment rule is scheduled to be evaluated next based on the evaluation frequency.' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ruleCategory rdf:type rdf:Property ;
    rdfs:label 'Rule Category' ;
    rdfs:comment 'Business category or grouping for the segment rule used for organizational and reporting purposes (e.g., VIP Identification, Churn Risk, High Value, Season Ticket Holder).' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Threshold Unit' ;
    rdfs:comment 'The unit of measure for the threshold values (e.g., USD, events, days, points, percentage, count).' ;
    rdfs:domain ind:SegmentRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingFacilityId rdf:type rdf:Property ;
    rdfs:label 'Training Facility Id' ;
    rdfs:comment 'Identifier of the primary training facility or practice venue used by the team.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:championshipCount rdf:type rdf:Property ;
