  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Carriage fees are paid BY distribution partners (MVPDs, cable operators). Linking to partner domain enables consolidated partner financial management, credit risk assessment, and cross-agreement analy | Column partner_id (BIGINT) in partner.billing_carriage_fee_invoice']
  prepared_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Carriage fee invoices are high-value, complex documents prepared by specialized distribution billing analysts. Tracking preparer employee supports quality control, dispute resolution, and operational  | Column prepared_by_employee_id (BIGINT) in workforce.billing_carriage_fee_invoice']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Carriage invoices attributed to profit centers (channels, networks) for distribution revenue segment reporting and business unit P&L. Essential for broadcasters tracking carriage performance by channe | Column profit_center_id (BIGINT) in finance.billing_carriage_fee_invoice']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Carriage fee invoices need revenue stream classification for distribution revenue reporting, distinct from advertising and subscription streams. Critical for broadcasters with MVPD relationships where | Column revenue_stream_id (BIGINT) in finance.billing_carriage_fee_invoice']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in billing.billing_carriage_fee_invoice']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in billing.billing_carriage_fee_invoice']
  base_carriage_fee_amount decimal(18,2) [note: 'Base carriage fee amount calculated as subscriber count multiplied by per-subscriber rate before adjustments. | Column base_carriage_fee_amount (DECIMAL(18,2)) in billing.billing_carriage_fee_invoice']
  billing_contact_email varchar [note: 'Email address of the billing contact at the MVPD operator for invoice delivery and correspondence. | Column billing_contact_email (STRING) in billing.billing_carriage_fee_invoice']
  billing_contact_name varchar [note: 'Name of the billing contact at the MVPD operator for invoice correspondence. | Column billing_contact_name (STRING) in billing.billing_carriage_fee_invoice']
