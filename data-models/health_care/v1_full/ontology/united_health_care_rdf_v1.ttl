    rdfs:comment 'Number of days that communication records sent through this channel must be retained for regulatory compliance and audit purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaResponseTimeHours rdf:type rdf:Property ;
