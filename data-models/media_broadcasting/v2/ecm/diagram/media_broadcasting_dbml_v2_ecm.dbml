  credit_attribution_text varchar [note: 'Specific credit text that must be displayed when this usage right is exercised (e.g., \'Starring John Doe\'). Null if not required. | Column credit_attribution_text (STRING) in talent.usage_right']
  exclusivity_flag boolean [note: 'Indicates whether this usage right is exclusive to Media Broadcasting (True) or non-exclusive (False). | Column exclusivity_flag (BOOLEAN) in talent.usage_right']
  holdback_period_days varchar [note: 'Number of days after initial use during which certain usage types are restricted (exclusivity period). Null if no holdback applies. | Column holdback_period_days (INT) in talent.usage_right']
