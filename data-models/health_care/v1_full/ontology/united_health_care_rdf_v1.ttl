    rdfs:range xsd:integer .

ind:pharmacyQuantity rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Quantity' ;
    rdfs:comment 'Quantity of medication dispensed that may have triggered the rule violation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseNoteId rdf:type rdf:Property ;
    rdfs:label 'Case Note Id' ;
    rdfs:comment 'Unique identifier for the case note record within the fraud investigation system.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:noteSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Note Sequence Number' ;
    rdfs:comment 'Sequential number indicating the chronological order of notes within a specific fraud case.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:noteType rdf:type rdf:Property ;
    rdfs:label 'Note Type' ;
    rdfs:comment 'Classification of the case note indicating its purpose and content category within the investigation workflow.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteCategory rdf:type rdf:Property ;
    rdfs:label 'Note Category' ;
    rdfs:comment 'High-level categorization of the note content based on the functional area of investigation.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteSubject rdf:type rdf:Property ;
    rdfs:label 'Note Subject' ;
    rdfs:comment 'Brief subject line or title summarizing the main topic or focus of the case note.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteText rdf:type rdf:Property ;
    rdfs:label 'Note Text' ;
    rdfs:comment 'Free-text narrative content of the case note documenting investigator observations, findings, actions taken, or communications.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteStatus rdf:type rdf:Property ;
    rdfs:label 'Note Status' ;
    rdfs:comment 'Current workflow status of the case note indicating its review and approval state.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorUserId rdf:type rdf:Property ;
    rdfs:label 'Author User Id' ;
    rdfs:comment 'System identifier of the investigator or user who created the case note.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:modifiedByName rdf:type rdf:Property ;
    rdfs:label 'Modified By Name' ;
    rdfs:comment 'Full name of the user who last modified the case note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submitted Timestamp' ;
    rdfs:comment 'Date and time when the case note was submitted for review or approval.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:attachmentTypes rdf:type rdf:Property ;
    rdfs:label 'Attachment Types' ;
    rdfs:comment 'Comma-separated list of file types or document categories attached to the case note (e.g., PDF, image, spreadsheet, medical record, claim document).' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wordCount rdf:type rdf:Property ;
    rdfs:label 'Word Count' ;
    rdfs:comment 'Total number of words in the note text content, used for documentation completeness metrics.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:characterCount rdf:type rdf:Property ;
    rdfs:label 'Character Count' ;
    rdfs:comment 'Total number of characters in the note text content, used for system storage and display purposes.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:investigationPhase rdf:type rdf:Property ;
    rdfs:label 'Investigation Phase' ;
    rdfs:comment 'Current phase or stage of the fraud investigation at the time the note was created.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
