    rdfs:range xsd:string .

ind:controlActivityCode rdf:type rdf:Property ;
    rdfs:label 'Control Activity Code' ;
    rdfs:comment 'Standardized code representing the type of control activity performed, used for reporting and analysis.' ;
    rdfs:domain ind:AuditControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditQuarter rdf:type rdf:Property ;
    rdfs:label 'Audit Quarter' ;
    rdfs:comment 'The fiscal quarter within the audit year when this control test is scheduled or performed.' ;
