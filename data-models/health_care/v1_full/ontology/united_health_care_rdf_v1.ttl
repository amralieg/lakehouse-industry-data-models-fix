    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudIndicator rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator' ;
    rdfs:comment 'Flag indicating whether this service line has been flagged for potential fraud, waste, or abuse investigation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billTypeCode rdf:type rdf:Property ;
    rdfs:label 'Bill Type Code' ;
    rdfs:comment 'Three-digit code used on institutional claims (UB-04) to identify the type of facility, care type, and billing sequence.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'The amount of sales tax or other applicable taxes charged for this service line, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdAmount rdf:type rdf:Property ;
    rdfs:label 'Withhold Amount' ;
    rdfs:comment 'The amount withheld from payment for this service line as part of a risk-sharing or quality incentive arrangement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitationIndicator rdf:type rdf:Property ;
    rdfs:label 'Capitation Indicator' ;
    rdfs:comment 'Flag indicating whether this service line is covered under a capitated payment arrangement and not separately reimbursable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalLinePaidAmount rdf:type rdf:Property ;
    rdfs:label 'Original Line Paid Amount' ;
    rdfs:comment 'The original paid amount for this service line before any adjustments, voids, or reprocessing. Used for tracking payment history.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason' ;
    rdfs:comment 'Description of the reason for any adjustment made to the original payment for this service line.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidIndicator rdf:type rdf:Property ;
    rdfs:label 'Void Indicator' ;
    rdfs:comment 'Flag indicating whether this service line payment has been voided and reversed.' ;
