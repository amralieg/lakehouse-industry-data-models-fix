  ean varchar [note: 'European Article Number for the release']
  ean_code varchar [note: 'European Article Number for the release']
  explicit_content_flag boolean [note: 'Indicates if release contains explicit content']
  explicit_flag boolean [note: 'Flag indicating explicit content']
  genre varchar [note: 'Primary genre classification']
