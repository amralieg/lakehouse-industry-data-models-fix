    rdfs:comment 'Indicates whether services within this specialty are classified as preventive services with no cost-sharing under ACA.' ;
    rdfs:domain ind:SpecialtyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Board Certification Required' ;
    rdfs:comment 'Indicates whether board certification in the specialty is required for providers under the contract.' ;
