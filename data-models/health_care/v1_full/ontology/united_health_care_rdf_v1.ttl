ind:handlingRequirements rdf:type rdf:Property ;
    rdfs:label 'Handling Requirements' ;
    rdfs:comment 'Special handling instructions for the specialty drug, including preparation, administration, and disposal requirements (e.g., cytotoxic handling, aseptic technique).' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthorizationCriteria rdf:type rdf:Property ;
