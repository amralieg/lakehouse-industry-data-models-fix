    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialMediaFollowersCount rdf:type rdf:Property ;
    rdfs:label 'Social Media Followers Count' ;
    rdfs:comment 'Total number of followers across the brand\'s primary social media platforms. Used to assess digital reach and activation amplification potential.' ;
