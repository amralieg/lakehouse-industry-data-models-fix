    rdfs:range xsd:boolean .

ind:memberPortalUsername rdf:type rdf:Property ;
    rdfs:label 'Member Portal Username' ;
    rdfs:comment 'Username for the member\'s online portal account.' ;
    rdfs:domain ind:MemberProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobileAppUser rdf:type rdf:Property ;
    rdfs:label 'Mobile App User' ;
    rdfs:comment 'Boolean flag indicating whether the member has downloaded and registered for the mobile app.' ;
