    rdfs:comment 'User identifier or name of the individual who most recently updated or modified this measure category record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureId rdf:type rdf:Property ;
    rdfs:label 'Measure Id' ;
    rdfs:comment 'Unique identifier for the quality measure record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Measure .

ind:subcategory rdf:type rdf:Property ;
    rdfs:label 'Subcategory' ;
    rdfs:comment 'More granular classification within the measure category (e.g., Diabetes Care, Cardiovascular Care, Preventive Screening).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:steward rdf:type rdf:Property ;
    rdfs:label 'Steward' ;
    rdfs:comment 'Organization responsible for developing and maintaining the measure (e.g., NCQA, CMS, NQF).' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalRationale rdf:type rdf:Property ;
    rdfs:label 'Clinical Rationale' ;
    rdfs:comment 'Evidence-based justification explaining why the measure is clinically important and how it impacts patient outcomes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denominatorExclusions rdf:type rdf:Property ;
    rdfs:label 'Denominator Exclusions' ;
    rdfs:comment 'Criteria for removing members from the denominator due to valid clinical or administrative reasons.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denominatorExceptions rdf:type rdf:Property ;
    rdfs:label 'Denominator Exceptions' ;
    rdfs:comment 'Circumstances under which members are removed from the denominator due to medical, patient, or system reasons.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numeratorExclusions rdf:type rdf:Property ;
    rdfs:label 'Numerator Exclusions' ;
    rdfs:comment 'Criteria for removing members from the numerator even if they initially met numerator criteria.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End Date' ;
    rdfs:comment 'Ending date of the period during which measure performance is evaluated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lookbackPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Months' ;
    rdfs:comment 'Number of months prior to the measurement period during which historical data is evaluated for measure compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageRangeMinimum rdf:type rdf:Property ;
    rdfs:label 'Age Range Minimum' ;
    rdfs:comment 'Minimum age in years for members to be included in the measure denominator.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageRangeMaximum rdf:type rdf:Property ;
    rdfs:label 'Age Range Maximum' ;
    rdfs:comment 'Maximum age in years for members to be included in the measure denominator.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Age Determination Date' ;
    rdfs:comment 'Specific date used to calculate member age for measure eligibility (e.g., end of measurement period, start of measurement period).' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuousEnrollmentRequired rdf:type rdf:Property ;
    rdfs:label 'Continuous Enrollment Required' ;
    rdfs:comment 'Indicates whether members must be continuously enrolled during the measurement period to be included in the measure.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
