    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactAssessmentCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Completed Flag' ;
    rdfs:comment 'Indicator of whether a business impact assessment was completed for this policy version to evaluate operational and financial implications.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impactAssessmentSummary rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Summary' ;
    rdfs:comment 'Summary of the business impact assessment findings for this policy version, including affected processes and estimated costs.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stakeholderFeedback rdf:type rdf:Property ;
    rdfs:label 'Stakeholder Feedback' ;
    rdfs:comment 'Summary of feedback received from stakeholders during the review and approval process for this policy version.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionProcessDefinedFlag rdf:type rdf:Property ;
    rdfs:label 'Exception Process Defined Flag' ;
    rdfs:comment 'Indicator of whether a formal exception or waiver process is defined for this policy version.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monitoringMetrics rdf:type rdf:Property ;
    rdfs:label 'Monitoring Metrics' ;
    rdfs:comment 'Key performance indicators or metrics used to monitor compliance with this policy version.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryActionId rdf:type rdf:Property ;
    rdfs:label 'Recovery Action Id' ;
    rdfs:comment 'Unique identifier for the recovery action record. Primary key for the recovery action entity.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current status of the recovery action in its lifecycle from initiation to closure.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Action Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for the recovery action such as overpayment, duplicate payment, fraud, or billing error.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Action Reason Description' ;
    rdfs:comment 'Detailed explanation of why the recovery action was initiated including specific findings from the investigation or audit.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryAmountRequested rdf:type rdf:Property ;
    rdfs:label 'Recovery Amount Requested' ;
    rdfs:comment 'Total dollar amount being sought for recovery through this action including principal and any applicable penalties or interest.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryAmountCollected rdf:type rdf:Property ;
    rdfs:label 'Recovery Amount Collected' ;
    rdfs:comment 'Actual dollar amount successfully recovered to date through this recovery action.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:administrativeFee rdf:type rdf:Property ;
    rdfs:label 'Administrative Fee' ;
    rdfs:comment 'Administrative processing fee charged to cover the cost of recovery operations and investigation.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedDate rdf:type rdf:Property ;
    rdfs:label 'Approved Date' ;
    rdfs:comment 'Date when the recovery action was approved by authorized personnel or management.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDueDate rdf:type rdf:Property ;
    rdfs:label 'Response Due Date' ;
    rdfs:comment 'Date by which the provider must respond to the recovery action notification or submit an appeal.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstCollectionDate rdf:type rdf:Property ;
    rdfs:label 'First Collection Date' ;
    rdfs:comment 'Date when the first payment or recovery amount was collected from the provider.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:offsetAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Offset Applied Flag' ;
    rdfs:comment 'Indicator of whether the recovery amount has been or will be offset against future claim payments to the provider.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:installmentPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Installment Plan Flag' ;
    rdfs:comment 'Indicator of whether the provider has been granted an installment payment plan to repay the recovery amount over time.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:installmentCount rdf:type rdf:Property ;
    rdfs:label 'Installment Count' ;
    rdfs:comment 'Total number of installment payments agreed upon if the provider is on an installment plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentAmount rdf:type rdf:Property ;
    rdfs:label 'Installment Amount' ;
    rdfs:comment 'Dollar amount of each installment payment if the provider is on an installment plan.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentFrequency rdf:type rdf:Property ;
    rdfs:label 'Installment Frequency' ;
    rdfs:comment 'Frequency at which installment payments are due if the provider is on an installment plan.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementFlag rdf:type rdf:Property ;
    rdfs:label 'Settlement Flag' ;
    rdfs:comment 'Indicator of whether the recovery action was resolved through a negotiated settlement agreement with the provider.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Amount' ;
    rdfs:comment 'Agreed-upon dollar amount in a settlement agreement which may differ from the original recovery amount requested.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalActionFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Action Flag' ;
    rdfs:comment 'Indicator of whether the recovery action has been escalated to legal proceedings or litigation.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalReferralDate rdf:type rdf:Property ;
    rdfs:label 'Legal Referral Date' ;
    rdfs:comment 'Date when the recovery action was referred to legal counsel or external legal representation.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:courtCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Court Case Number' ;
    rdfs:comment 'Official case number assigned by the court if the recovery action has resulted in litigation.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:judgmentAmount rdf:type rdf:Property ;
    rdfs:label 'Judgment Amount' ;
    rdfs:comment 'Dollar amount awarded by the court in a legal judgment related to this recovery action.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:judgmentDate rdf:type rdf:Property ;
    rdfs:label 'Judgment Date' ;
    rdfs:comment 'Date when the court issued a legal judgment related to this recovery action.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:externalCollectionFlag rdf:type rdf:Property ;
    rdfs:label 'External Collection Flag' ;
    rdfs:comment 'Indicator of whether the recovery action has been referred to an external third-party collection agency.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:writeOffReason rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason' ;
    rdfs:comment 'Reason why the outstanding recovery amount was written off such as provider bankruptcy or cost-benefit determination.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedDepartment rdf:type rdf:Property ;
    rdfs:label 'Assigned Department' ;
    rdfs:comment 'Department or unit responsible for managing this recovery action such as Special Investigations Unit or Payment Integrity.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryLikelihoodScore rdf:type rdf:Property ;
    rdfs:label 'Recovery Likelihood Score' ;
    rdfs:comment 'Predictive score indicating the probability of successfully recovering the outstanding amount based on historical patterns and provider characteristics.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:providerCooperationLevel rdf:type rdf:Property ;
    rdfs:label 'Provider Cooperation Level' ;
    rdfs:comment 'Assessment of the provider level of cooperation during the recovery process.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsReviewedCount rdf:type rdf:Property ;
    rdfs:label 'Claims Reviewed Count' ;
    rdfs:comment 'Total number of claims reviewed during the audit or investigation that led to this recovery action.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimsWithErrorsCount rdf:type rdf:Property ;
    rdfs:label 'Claims With Errors Count' ;
    rdfs:comment 'Number of claims identified with billing errors, overpayments, or fraudulent activity during the audit or investigation.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Contract Termination Flag' ;
    rdfs:comment 'Indicator of whether the provider contract has been terminated as a result of the fraud, waste, or abuse findings.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion Flag' ;
    rdfs:comment 'Indicator of whether the provider has been excluded from participation in federal healthcare programs as a result of the fraud findings.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion Date' ;
    rdfs:comment 'Date when the provider was excluded from participation in federal healthcare programs.' ;
    rdfs:domain ind:RecoveryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryNotes rdf:type rdf:Property ;
    rdfs:label 'Recovery Notes' ;
    rdfs:comment 'Free-text notes documenting key events, communications, and decisions related to the recovery action.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionId rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Id' ;
    rdfs:comment 'Unique identifier for the corrective action plan created to remediate audit findings or compliance violations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrectiveAction .

ind:capNumber rdf:type rdf:Property ;
    rdfs:label 'Cap Number' ;
    rdfs:comment 'Human-readable business identifier for the corrective action plan, typically formatted as CAP-YYYY-NNNNNN.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDomain rdf:type rdf:Property ;
    rdfs:label 'Compliance Domain' ;
    rdfs:comment 'Primary compliance domain or regulatory area to which the corrective action plan applies.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerTitle rdf:type rdf:Property ;
    rdfs:label 'Owner Title' ;
    rdfs:comment 'Job title or role of the corrective action plan owner.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToName rdf:type rdf:Property ;
    rdfs:label 'Assigned To Name' ;
    rdfs:comment 'Full name of the individual or team currently assigned to work on the corrective action plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToEmail rdf:type rdf:Property ;
    rdfs:label 'Assigned To Email' ;
    rdfs:comment 'Email address of the individual or team assigned to the corrective action plan.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedSystems rdf:type rdf:Property ;
    rdfs:label 'Affected Systems' ;
    rdfs:comment 'Comma-separated list of systems, applications, or platforms affected by the finding and corrective action.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedProcesses rdf:type rdf:Property ;
    rdfs:label 'Affected Processes' ;
    rdfs:comment 'Business processes or workflows impacted by the finding and requiring remediation.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationApproach rdf:type rdf:Property ;
    rdfs:label 'Remediation Approach' ;
    rdfs:comment 'Primary approach or method used to remediate the finding, such as process change, policy update, or system enhancement.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationPlan rdf:type rdf:Property ;
    rdfs:label 'Implementation Plan' ;
    rdfs:comment 'Detailed plan outlining the steps, milestones, and activities required to implement the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationMethod rdf:type rdf:Property ;
    rdfs:label 'Validation Method' ;
    rdfs:comment 'Method used to validate that the corrective action has been effectively implemented and the finding resolved.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedEffortHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Effort Hours' ;
    rdfs:comment 'Estimated number of person-hours required to complete the corrective action plan.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualEffortHours rdf:type rdf:Property ;
    rdfs:label 'Actual Effort Hours' ;
    rdfs:comment 'Actual number of person-hours expended to complete the corrective action plan.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalDueDate rdf:type rdf:Property ;
    rdfs:label 'Original Due Date' ;
    rdfs:comment 'Original due date established when the corrective action plan was first created.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revisedDueDate rdf:type rdf:Property ;
    rdfs:label 'Revised Due Date' ;
    rdfs:comment 'Revised due date if the corrective action plan timeline was extended or modified.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submittedDate rdf:type rdf:Property ;
    rdfs:label 'Submitted Date' ;
    rdfs:comment 'Date when the corrective action plan was submitted for approval.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:startedDate rdf:type rdf:Property ;
    rdfs:label 'Started Date' ;
    rdfs:comment 'Date when implementation of the corrective action plan began.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validatedDate rdf:type rdf:Property ;
    rdfs:label 'Validated Date' ;
    rdfs:comment 'Date when the effectiveness of the corrective action was validated and confirmed.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isOverdue rdf:type rdf:Property ;
    rdfs:label 'Is Overdue' ;
    rdfs:comment 'Boolean flag indicating whether the corrective action plan is past its due date without completion.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extensionCount rdf:type rdf:Property ;
    rdfs:label 'Extension Count' ;
    rdfs:comment 'Number of times the corrective action plan due date has been extended.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresRegulatoryNotification rdf:type rdf:Property ;
    rdfs:label 'Requires Regulatory Notification' ;
    rdfs:comment 'Boolean flag indicating whether the corrective action plan must be reported to regulatory authorities.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Date' ;
    rdfs:comment 'Date when the corrective action plan was reported to regulatory authorities.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryResponse rdf:type rdf:Property ;
    rdfs:label 'Regulatory Response' ;
    rdfs:comment 'Response or feedback received from the regulatory agency regarding the corrective action plan.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceRisk rdf:type rdf:Property ;
    rdfs:label 'Recurrence Risk' ;
    rdfs:comment 'Assessment of the risk that the compliance violation or audit finding could recur after remediation.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveMeasures rdf:type rdf:Property ;
    rdfs:label 'Preventive Measures' ;
    rdfs:comment 'Description of preventive measures implemented to reduce the risk of recurrence.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringPlan rdf:type rdf:Property ;
    rdfs:label 'Monitoring Plan' ;
    rdfs:comment 'Plan for ongoing monitoring to ensure sustained compliance after corrective action completion.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestonesCompleted rdf:type rdf:Property ;
    rdfs:label 'Milestones Completed' ;
    rdfs:comment 'Number of milestones that have been completed in the corrective action plan.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evidenceDocumentation rdf:type rdf:Property ;
    rdfs:label 'Evidence Documentation' ;
    rdfs:comment 'Description or reference to documentation and evidence supporting corrective action completion.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceLocation rdf:type rdf:Property ;
    rdfs:label 'Evidence Location' ;
    rdfs:comment 'File path, URL, or repository location where supporting evidence and documentation are stored.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureNotes rdf:type rdf:Property ;
    rdfs:label 'Closure Notes' ;
    rdfs:comment 'Final notes and comments recorded when the corrective action plan was closed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedCapIds rdf:type rdf:Property ;
    rdfs:label 'Related Cap Ids' ;
    rdfs:comment 'Comma-separated list of related corrective action plan IDs that address similar or connected findings.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactAssessment rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment' ;
    rdfs:comment 'Assessment of the business, operational, and regulatory impact of the finding and corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:potentialPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Potential Penalty Amount' ;
    rdfs:comment 'Potential regulatory penalty or fine amount in USD if the corrective action is not completed.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stakeholderNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Stakeholder Notification Date' ;
    rdfs:comment 'Date when key stakeholders were notified about the corrective action plan and its status.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trainingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Training Completion Date' ;
    rdfs:comment 'Date when required training associated with the corrective action plan was completed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyUpdateRequired rdf:type rdf:Property ;
    rdfs:label 'Policy Update Required' ;
    rdfs:comment 'Boolean flag indicating whether organizational policies or procedures require updates as part of the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Policy Update Date' ;
    rdfs:comment 'Date when organizational policies or procedures were updated as part of the corrective action plan.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:systemChangeRequired rdf:type rdf:Property ;
    rdfs:label 'System Change Required' ;
    rdfs:comment 'Boolean flag indicating whether IT system changes or enhancements are required as part of the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemChangeTicketId rdf:type rdf:Property ;
    rdfs:label 'System Change Ticket Id' ;
    rdfs:comment 'Identifier of the IT change request or ticket associated with system modifications for the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalConsultantEngaged rdf:type rdf:Property ;
    rdfs:label 'External Consultant Engaged' ;
    rdfs:comment 'Boolean flag indicating whether external consultants or third-party experts were engaged to support the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consultantName rdf:type rdf:Property ;
    rdfs:label 'Consultant Name' ;
    rdfs:comment 'Name of the external consulting firm or expert engaged to support the corrective action plan.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRepeatFinding rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Finding' ;
    rdfs:comment 'Boolean flag indicating whether this finding is a repeat or recurrence of a previously identified issue.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:previousCapId rdf:type rdf:Property ;
    rdfs:label 'Previous Cap Id' ;
    rdfs:comment 'Identifier of the previous corrective action plan if this is a repeat finding.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrectiveAction .

ind:effectivenessRating rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Rating' ;
    rdfs:comment 'Rating of the corrective action effectiveness based on post-implementation validation and monitoring.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectivenessAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Assessment Date' ;
    rdfs:comment 'Date when the effectiveness of the corrective action was formally assessed.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overpaymentRecoveryId rdf:type rdf:Property ;
    rdfs:label 'Overpayment Recovery Id' ;
    rdfs:comment 'Unique identifier for the overpayment recovery record. Primary key for tracking recovery actions across the fraud detection and payment integrity lifecycle.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OverpaymentRecovery .

ind:demandLetterDate rdf:type rdf:Property ;
    rdfs:label 'Demand Letter Date' ;
    rdfs:comment 'Date when formal demand letter was sent to provider requesting repayment of overpayment.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstRecoveryDate rdf:type rdf:Property ;
    rdfs:label 'First Recovery Date' ;
    rdfs:comment 'Date when the first payment or recovery action was received toward the overpayment balance.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastRecoveryDate rdf:type rdf:Property ;
    rdfs:label 'Last Recovery Date' ;
    rdfs:comment 'Date of the most recent payment or recovery action received toward the overpayment balance.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalClaimPaidDate rdf:type rdf:Property ;
    rdfs:label 'Original Claim Paid Date' ;
    rdfs:comment 'Date when the original claim that resulted in overpayment was paid by the health plan.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Original Paid Amount' ;
    rdfs:comment 'Original dollar amount paid on the claim before overpayment was identified and recovery initiated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correctPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Correct Paid Amount' ;
    rdfs:comment 'Correct dollar amount that should have been paid on the claim based on proper adjudication rules.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryPriority rdf:type rdf:Property ;
    rdfs:label 'Recovery Priority' ;
    rdfs:comment 'Priority level assigned to the recovery action based on amount, fraud risk, or other business factors.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedTo rdf:type rdf:Property ;
    rdfs:label 'Assigned To' ;
    rdfs:comment 'Name or identifier of the recovery specialist or team assigned to manage the overpayment recovery case.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPlanTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Terms' ;
    rdfs:comment 'Description of the payment plan terms agreed upon with the provider for overpayment recovery.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsAgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Collections Agency Flag' ;
    rdfs:comment 'Indicator of whether the overpayment recovery has been referred to an external collections agency.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionsReferralDate rdf:type rdf:Property ;
    rdfs:label 'Collections Referral Date' ;
    rdfs:comment 'Date when the overpayment recovery case was referred to an external collections agency.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Date' ;
    rdfs:comment 'Date when a settlement agreement was finalized with the provider for overpayment recovery.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:offsetClaimCount rdf:type rdf:Property ;
    rdfs:label 'Offset Claim Count' ;
    rdfs:comment 'Number of subsequent claims from which payments were offset to recover the overpayment.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:siuInvestigator rdf:type rdf:Property ;
    rdfs:label 'Siu Investigator' ;
    rdfs:comment 'Name or identifier of the SIU investigator assigned to the fraud case associated with the overpayment.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryYear rdf:type rdf:Property ;
    rdfs:label 'Recovery Year' ;
    rdfs:comment 'Calendar year in which the overpayment recovery action was initiated or completed.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recoveryQuarter rdf:type rdf:Property ;
    rdfs:label 'Recovery Quarter' ;
    rdfs:comment 'Calendar quarter in which the overpayment recovery action was initiated or completed.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachIncidentId rdf:type rdf:Property ;
    rdfs:label 'Breach Incident Id' ;
    rdfs:comment 'Unique identifier for the data breach incident record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BreachIncident .

ind:incidentNumber rdf:type rdf:Property ;
    rdfs:label 'Incident Number' ;
    rdfs:comment 'Human-readable unique incident number assigned to the breach for tracking and reference purposes.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachType rdf:type rdf:Property ;
    rdfs:label 'Breach Type' ;
    rdfs:comment 'Classification of the type of breach incident that occurred.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachCategory rdf:type rdf:Property ;
    rdfs:label 'Breach Category' ;
    rdfs:comment 'Category indicating the medium of the breached information.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachLocationType rdf:type rdf:Property ;
    rdfs:label 'Breach Location Type' ;
    rdfs:comment 'Type of location or medium where the breach occurred.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryDate rdf:type rdf:Property ;
    rdfs:label 'Discovery Date' ;
    rdfs:comment 'Date when the breach incident was first discovered or became known to the organization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:discoveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Discovery Timestamp' ;
    rdfs:comment 'Precise timestamp when the breach incident was first discovered or became known to the organization.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:occurrenceDate rdf:type rdf:Property ;
    rdfs:label 'Occurrence Date' ;
    rdfs:comment 'Estimated or actual date when the breach incident occurred.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:occurrenceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Occurrence Timestamp' ;
    rdfs:comment 'Estimated or actual timestamp when the breach incident occurred.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:hhsNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Hhs Notification Date' ;
    rdfs:comment 'Date when the breach was reported to the Department of Health and Human Services.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mediaNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Media Notification Date' ;
    rdfs:comment 'Date when media outlets were notified of the breach incident, required for breaches affecting 500 or more individuals.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:containmentDate rdf:type rdf:Property ;
    rdfs:label 'Containment Date' ;
    rdfs:comment 'Date when the breach was contained and further unauthorized access was prevented.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:affectedRecordsCount rdf:type rdf:Property ;
    rdfs:label 'Affected Records Count' ;
    rdfs:comment 'Total number of records or individuals affected by the breach incident.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedMembersCount rdf:type rdf:Property ;
    rdfs:label 'Affected Members Count' ;
    rdfs:comment 'Total number of health plan members whose Protected Health Information (PHI) was compromised in the breach.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedStates rdf:type rdf:Property ;
    rdfs:label 'Affected States' ;
    rdfs:comment 'Comma-separated list of US state codes where affected individuals reside.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiCompromisedFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Compromised Flag' ;
    rdfs:comment 'Indicator whether Protected Health Information was compromised in the breach.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ephiCompromisedFlag rdf:type rdf:Property ;
    rdfs:label 'Ephi Compromised Flag' ;
    rdfs:comment 'Indicator whether Electronic Protected Health Information was compromised in the breach.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:piiCompromisedFlag rdf:type rdf:Property ;
    rdfs:label 'Pii Compromised Flag' ;
    rdfs:comment 'Indicator whether Personally Identifiable Information beyond PHI was compromised in the breach.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialDataCompromisedFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Data Compromised Flag' ;
    rdfs:comment 'Indicator whether financial information such as credit card or bank account data was compromised.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataElementsCompromised rdf:type rdf:Property ;
    rdfs:label 'Data Elements Compromised' ;
    rdfs:comment 'Detailed description of the specific data elements that were compromised in the breach.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachSeverity rdf:type rdf:Property ;
    rdfs:label 'Breach Severity' ;
    rdfs:comment 'Assessed severity level of the breach incident based on impact and scope.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAssessmentCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Completed Flag' ;
    rdfs:comment 'Indicator whether a formal risk assessment was completed to determine if the incident constitutes a breach requiring notification.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lowProbabilityDeterminationFlag rdf:type rdf:Property ;
    rdfs:label 'Low Probability Determination Flag' ;
    rdfs:comment 'Indicator whether the risk assessment determined there was a low probability that PHI was compromised, exempting notification requirements.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Required Flag' ;
    rdfs:comment 'Indicator whether breach notification to affected individuals is required based on risk assessment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hhsReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Hhs Reporting Required Flag' ;
    rdfs:comment 'Indicator whether the breach must be reported to HHS based on the number of affected individuals.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mediaNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Media Notification Required Flag' ;
    rdfs:comment 'Indicator whether media notification is required for breaches affecting 500 or more individuals in a jurisdiction.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'State Notification Required Flag' ;
    rdfs:comment 'Indicator whether notification to state authorities is required under state breach notification laws.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessAssociateInvolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Business Associate Involved Flag' ;
    rdfs:comment 'Indicator whether a Business Associate was involved in or responsible for the breach incident.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessAssociateName rdf:type rdf:Property ;
    rdfs:label 'Business Associate Name' ;
    rdfs:comment 'Name of the Business Associate involved in the breach incident, if applicable.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleLocation rdf:type rdf:Property ;
    rdfs:label 'Responsible Location' ;
    rdfs:comment 'Physical location or facility where the breach incident occurred.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveredBy rdf:type rdf:Property ;
    rdfs:label 'Discovered By' ;
    rdfs:comment 'Name or identifier of the individual or system that discovered the breach incident.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentOwner rdf:type rdf:Property ;
    rdfs:label 'Incident Owner' ;
    rdfs:comment 'Name or identifier of the individual assigned as the primary owner responsible for managing the breach incident response.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containmentActions rdf:type rdf:Property ;
    rdfs:label 'Containment Actions' ;
    rdfs:comment 'Detailed description of the actions taken to contain the breach and prevent further unauthorized access.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationActions rdf:type rdf:Property ;
    rdfs:label 'Remediation Actions' ;
    rdfs:comment 'Detailed description of the remediation actions taken to address vulnerabilities and prevent future breaches.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationStatus rdf:type rdf:Property ;
    rdfs:label 'Investigation Status' ;
    rdfs:comment 'Current status of the breach investigation.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationSummary rdf:type rdf:Property ;
    rdfs:label 'Investigation Summary' ;
    rdfs:comment 'Summary of the investigation findings and conclusions.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementNotifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Notified Flag' ;
    rdfs:comment 'Indicator whether law enforcement authorities were notified of the breach incident.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawEnforcementNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Notification Date' ;
    rdfs:comment 'Date when law enforcement authorities were notified of the breach incident.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryActionTakenFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Taken Flag' ;
    rdfs:comment 'Indicator whether regulatory enforcement action was taken as a result of the breach.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedFinancialImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Financial Impact' ;
    rdfs:comment 'Estimated total financial impact of the breach including penalties, remediation costs, and potential litigation.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:substituteNoticeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Substitute Notice Required Flag' ;
    rdfs:comment 'Indicator whether substitute notice methods were required due to insufficient or out-of-date contact information.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditMonitoringOfferedFlag rdf:type rdf:Property ;
    rdfs:label 'Credit Monitoring Offered Flag' ;
    rdfs:comment 'Indicator whether credit monitoring services were offered to affected individuals.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditMonitoringDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Credit Monitoring Duration Months' ;
    rdfs:comment 'Duration in months for which credit monitoring services are provided to affected individuals.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:externalCounselEngagedFlag rdf:type rdf:Property ;
    rdfs:label 'External Counsel Engaged Flag' ;
    rdfs:comment 'Indicator whether external legal counsel was engaged to assist with the breach response.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceClaimFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Filed Flag' ;
    rdfs:comment 'Indicator whether a cyber insurance claim was filed for the breach incident.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Number' ;
    rdfs:comment 'Claim number assigned by the cyber insurance carrier for the breach incident.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hhsBreachPortalPostedFlag rdf:type rdf:Property ;
    rdfs:label 'Hhs Breach Portal Posted Flag' ;
    rdfs:comment 'Indicator whether the breach was posted to the HHS Office for Civil Rights breach portal (Wall of Shame).' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hhsBreachPortalPostDate rdf:type rdf:Property ;
    rdfs:label 'Hhs Breach Portal Post Date' ;
    rdfs:comment 'Date when the breach was posted to the HHS breach portal.' ;
    rdfs:domain ind:BreachIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingResponseId rdf:type rdf:Property ;
    rdfs:label 'Filing Response Id' ;
    rdfs:comment 'Unique identifier for the regulatory filing response record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FilingResponse .

ind:responseReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Response Reference Number' ;
    rdfs:comment 'Official reference number assigned by the regulatory body to this response communication.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorCode rdf:type rdf:Property ;
    rdfs:label 'Regulator Code' ;
    rdfs:comment 'Code identifying the regulatory body or agency that issued the response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorName rdf:type rdf:Property ;
    rdfs:label 'Regulator Name' ;
    rdfs:comment 'Full name of the regulatory body or agency that issued the response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateJurisdiction rdf:type rdf:Property ;
    rdfs:label 'State Jurisdiction' ;
    rdfs:comment 'State jurisdiction under which the regulatory response was issued, applicable for state Department of Insurance responses.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDate rdf:type rdf:Property ;
    rdfs:label 'Response Date' ;
    rdfs:comment 'Date on which the regulatory body issued the response to the filing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseType rdf:type rdf:Property ;
    rdfs:label 'Response Type' ;
    rdfs:comment 'Classification of the regulatory response indicating the nature of the regulator\'s communication.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Approval Effective Date' ;
    rdfs:comment 'Date on which an approved filing becomes effective, as specified by the regulator.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseSummary rdf:type rdf:Property ;
    rdfs:label 'Response Summary' ;
    rdfs:comment 'Brief summary of the key points and decisions communicated in the regulatory response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDetails rdf:type rdf:Property ;
    rdfs:label 'Response Details' ;
    rdfs:comment 'Detailed text of the regulatory response including all findings, conditions, and instructions provided by the regulator.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Deficiency Count' ;
    rdfs:comment 'Number of deficiencies or issues identified by the regulator in the response.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deficiencyDescription rdf:type rdf:Property ;
    rdfs:label 'Deficiency Description' ;
    rdfs:comment 'Detailed description of deficiencies, issues, or concerns raised by the regulator that require remediation.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsImposed rdf:type rdf:Property ;
    rdfs:label 'Conditions Imposed' ;
    rdfs:comment 'Specific conditions, requirements, or restrictions imposed by the regulator as part of a conditional approval or response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informationRequested rdf:type rdf:Property ;
    rdfs:label 'Information Requested' ;
    rdfs:comment 'Details of additional information, documentation, or clarification requested by the regulator.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Penalty Currency Code' ;
    rdfs:comment 'Currency code for the penalty amount assessed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hearingScheduledFlag rdf:type rdf:Property ;
    rdfs:label 'Hearing Scheduled Flag' ;
    rdfs:comment 'Indicator of whether a regulatory hearing has been scheduled as part of the response process.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hearingDate rdf:type rdf:Property ;
    rdfs:label 'Hearing Date' ;
    rdfs:comment 'Date scheduled for a regulatory hearing related to the filing response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hearingLocation rdf:type rdf:Property ;
    rdfs:label 'Hearing Location' ;
    rdfs:comment 'Physical or virtual location where the regulatory hearing will be conducted.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerTitle rdf:type rdf:Property ;
    rdfs:label 'Reviewer Title' ;
    rdfs:comment 'Professional title or position of the regulatory official who reviewed the filing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerContactEmail rdf:type rdf:Property ;
    rdfs:label 'Reviewer Contact Email' ;
    rdfs:comment 'Email address of the regulatory official for follow-up communication regarding the response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Reviewer Contact Phone' ;
    rdfs:comment 'Phone number of the regulatory official for follow-up communication regarding the response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceProgramType rdf:type rdf:Property ;
    rdfs:label 'Compliance Program Type' ;
    rdfs:comment 'Type of regulatory compliance program or requirement that the filing and response pertain to.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingCategory rdf:type rdf:Property ;
    rdfs:label 'Filing Category' ;
    rdfs:comment 'Category or type of the original filing that this response addresses.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serffTrackingNumber rdf:type rdf:Property ;
    rdfs:label 'Serff Tracking Number' ;
    rdfs:comment 'SERFF system tracking number for the filing, used by NAIC for electronic rate and form filing management.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentCount rdf:type rdf:Property ;
    rdfs:label 'Document Count' ;
    rdfs:comment 'Number of documents or attachments included with the regulatory response.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentReferenceList rdf:type rdf:Property ;
    rdfs:label 'Document Reference List' ;
    rdfs:comment 'List of document identifiers or file names for attachments included with the regulatory response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToDepartment rdf:type rdf:Property ;
    rdfs:label 'Assigned To Department' ;
    rdfs:comment 'Department responsible for managing and responding to the regulatory response.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Action Required Flag' ;
    rdfs:comment 'Indicator of whether the regulatory response requires follow-up action from the organization.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actionPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Action Plan Description' ;
    rdfs:comment 'Description of the action plan developed to address the regulatory response requirements.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Completion Date' ;
    rdfs:comment 'Date on which all remediation actions required by the regulatory response were completed.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpSubmissionRegulatoryFilingId rdf:type rdf:Property ;
    rdfs:label 'Follow Up Submission Regulatory Filing Id' ;
    rdfs:comment 'Identifier of the follow-up filing or submission made in response to the regulator\'s requirements.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryFiling .

ind:followUpSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Submission Date' ;
    rdfs:comment 'Date on which the follow-up filing or response was submitted to the regulator.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialImpactCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Currency Code' ;
    rdfs:comment 'Currency code for the financial impact amount.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Review Required Flag' ;
    rdfs:comment 'Indicator of whether the regulatory response requires legal department review and counsel.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalReviewCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Legal Review Completed Date' ;
    rdfs:comment 'Date on which legal department review of the regulatory response was completed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:executiveNotificationFlag rdf:type rdf:Property ;
    rdfs:label 'Executive Notification Flag' ;
    rdfs:comment 'Indicator of whether executive leadership was notified of the regulatory response due to materiality or risk level.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:executiveNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Executive Notification Date' ;
    rdfs:comment 'Date on which executive leadership was notified of the regulatory response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:boardNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Board Notification Required Flag' ;
    rdfs:comment 'Indicator of whether the Board of Directors must be notified of the regulatory response due to materiality or governance requirements.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Board Notification Date' ;
    rdfs:comment 'Date on which the Board of Directors was notified of the regulatory response.' ;
    rdfs:domain ind:FilingResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calendarId rdf:type rdf:Property ;
    rdfs:label 'Calendar Id' ;
    rdfs:comment 'Unique identifier for each compliance calendar event entry.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:eventName rdf:type rdf:Property ;
    rdfs:label 'Event Name' ;
    rdfs:comment 'The name or title of the compliance event, such as \'HIPAA Security Risk Assessment\' or \'Medicare Advantage Bid Submission\'.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDescription rdf:type rdf:Property ;
    rdfs:label 'Event Description' ;
    rdfs:comment 'Detailed description of the compliance event, including scope, requirements, and deliverables.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventCategory rdf:type rdf:Property ;
    rdfs:label 'Event Category' ;
    rdfs:comment 'Broad category of the compliance event, such as regulatory, internal policy, external audit, certification, training, or reporting.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableLineOfBusiness rdf:type rdf:Property ;
    rdfs:label 'Applicable Line Of Business' ;
    rdfs:comment 'The line of business to which this compliance event applies, such as Medicare Advantage, Medicaid, Commercial, or all lines.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableState rdf:type rdf:Property ;
    rdfs:label 'Applicable State' ;
    rdfs:comment 'The state jurisdiction(s) to which this compliance event applies, using two-letter state codes (e.g., \'CA\', \'NY\', \'ALL\').' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrencePattern rdf:type rdf:Property ;
    rdfs:label 'Recurrence Pattern' ;
    rdfs:comment 'The frequency pattern of the compliance event, such as annual, quarterly, monthly, or one-time.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledEndDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Date' ;
    rdfs:comment 'The scheduled end date or deadline for the compliance event in yyyy-MM-dd format.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Filing Deadline Date' ;
    rdfs:comment 'The final date by which a filing, submission, or report must be completed in yyyy-MM-dd format.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:advanceNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Advance Notice Days' ;
    rdfs:comment 'The number of days in advance that stakeholders should be notified before the compliance event.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responsibleOwnerName rdf:type rdf:Property ;
    rdfs:label 'Responsible Owner Name' ;
    rdfs:comment 'The name of the individual or role responsible for overseeing the compliance event.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOwnerEmail rdf:type rdf:Property ;
    rdfs:label 'Responsible Owner Email' ;
    rdfs:comment 'The email address of the individual responsible for the compliance event.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backupOwnerName rdf:type rdf:Property ;
    rdfs:label 'Backup Owner Name' ;
    rdfs:comment 'The name of the backup individual or role who can manage the compliance event if the primary owner is unavailable.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backupOwnerEmail rdf:type rdf:Property ;
