    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waivableIndicator rdf:type rdf:Property ;
    rdfs:label 'Waivable Indicator' ;
    rdfs:comment 'Flag indicating whether this surcharge can be waived under certain conditions (e.g., wellness program participation).' ;
    rdfs:domain ind:Surcharge ;
    rdf:type owl:DatatypeProperty ;
