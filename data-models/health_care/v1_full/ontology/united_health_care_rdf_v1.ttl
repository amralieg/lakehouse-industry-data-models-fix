ind:allegationSource rdf:type rdf:Property ;
    rdfs:label 'Allegation Source' ;
    rdfs:comment 'Origin or source of the fraud allegation that prompted the investigation and case note.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedEntityType rdf:type rdf:Property ;
    rdfs:label 'Related Entity Type' ;
    rdfs:comment 'Type of entity (provider, member, facility, etc.) that is the subject of or referenced in the case note.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
