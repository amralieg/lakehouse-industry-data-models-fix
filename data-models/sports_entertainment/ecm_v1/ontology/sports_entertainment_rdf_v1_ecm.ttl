ind:assetClass rdf:type rdf:Property ;
    rdfs:label 'Asset Class' ;
    rdfs:comment 'Commercial tier classification indicating the relative value and exclusivity of the inventory category. Premium assets command highest rates and offer maximum visibility; exclusive assets are limited to single sponsors.' ;
    rdfs:domain ind:InventoryCategory ;
    rdf:type owl:DatatypeProperty ;
