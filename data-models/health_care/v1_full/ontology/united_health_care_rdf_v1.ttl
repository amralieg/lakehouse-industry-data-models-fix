ind:maxPatientsPerSlot rdf:type rdf:Property ;
    rdfs:label 'Max Patients Per Slot' ;
    rdfs:comment 'Maximum number of patients that can be scheduled in a single slot (e.g., group visits).' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceType rdf:type rdf:Property ;
    rdfs:label 'Service Type' ;
    rdfs:comment 'Type of service the provider is offering during this schedule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentType rdf:type rdf:Property ;
    rdfs:label 'Appointment Type' ;
    rdfs:comment 'Category of appointments that can be booked in this schedule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityName rdf:type rdf:Property ;
    rdfs:label 'Facility Name' ;
    rdfs:comment 'Name of the facility or clinic associated with the schedule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line1' ;
    rdfs:comment 'First line of the facility address.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timezone rdf:type rdf:Property ;
    rdfs:label 'Timezone' ;
    rdfs:comment 'Time zone of the facility (e.g., America/Chicago).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inPersonFlag rdf:type rdf:Property ;
    rdfs:label 'In Person Flag' ;
    rdfs:comment 'Indicates if the schedule supports in-person appointments.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minNoticeMinutes rdf:type rdf:Property ;
    rdfs:label 'Min Notice Minutes' ;
    rdfs:comment 'Minimum notice required for booking an appointment in minutes.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cancellationPolicy rdf:type rdf:Property ;
    rdfs:label 'Cancellation Policy' ;
    rdfs:comment 'Textual description of the cancellation policy for this schedule.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overbookAllowed rdf:type rdf:Property ;
    rdfs:label 'Overbook Allowed' ;
    rdfs:comment 'Indicates whether overbooking is permitted for this schedule.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overbookLimit rdf:type rdf:Property ;
    rdfs:label 'Overbook Limit' ;
    rdfs:comment 'Maximum number of overbooked slots allowed.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modifiedByUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Modified By User Agent Id' ;
    rdfs:comment 'Identifier of the user who last modified the schedule record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:contractAffiliationId rdf:type rdf:Property ;
    rdfs:label 'Contract Affiliation Id' ;
    rdfs:comment 'Identifier linking to the provider\'s contract or affiliation governing this schedule.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:networkAffiliationId rdf:type rdf:Property ;
    rdfs:label 'Network Affiliation Id' ;
    rdfs:comment 'Unique identifier for the network affiliation record representing a provider\'s participation in a specific network.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetworkAffiliation .

ind:pcpFlag rdf:type rdf:Property ;
    rdfs:label 'Pcp Flag' ;
    rdfs:comment 'Indicates whether the provider is designated as a Primary Care Physician eligible for member assignment in HMO and POS plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialistFlag rdf:type rdf:Property ;
    rdfs:label 'Specialist Flag' ;
    rdfs:comment 'Indicates whether the provider is classified as a specialist requiring referral or prior authorization for certain plan types.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalAffiliationFlag rdf:type rdf:Property ;
    rdfs:label 'Hospital Affiliation Flag' ;
    rdfs:comment 'Indicates whether the provider has admitting privileges or is affiliated with a hospital in the network.' ;
    rdfs:domain ind:NetworkAffiliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recredentialingDate rdf:type rdf:Property ;
    rdfs:label 'Recredentialing Date' ;
    rdfs:comment 'The date by which the provider must complete recredentialing to maintain network participation status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geographicServiceArea rdf:type rdf:Property ;
    rdfs:label 'Geographic Service Area' ;
    rdfs:comment 'The geographic region or service area where the provider is authorized to serve network members.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceLocationId rdf:type rdf:Property ;
    rdfs:label 'Service Location Id' ;
    rdfs:comment 'Identifier for the specific practice location or facility where the provider delivers services under this network affiliation.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:parStatus rdf:type rdf:Property ;
    rdfs:label 'Par Status' ;
    rdfs:comment 'Indicates whether the provider is a participating provider who has agreed to accept network reimbursement rates.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Code' ;
    rdfs:comment 'The coded reason for termination of the provider\'s network affiliation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationInitiatedBy rdf:type rdf:Property ;
    rdfs:label 'Termination Initiated By' ;
    rdfs:comment 'Indicates which party initiated the termination of the network affiliation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoAssignmentEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Assignment Eligible Flag' ;
    rdfs:comment 'Indicates whether the provider is eligible to receive auto-assigned members in HMO or managed care plans.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:panelStatus rdf:type rdf:Property ;
    rdfs:label 'Panel Status' ;
    rdfs:comment 'Indicates the current capacity status of the provider\'s patient panel for accepting new member assignments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:panelSizeLimit rdf:type rdf:Property ;
    rdfs:label 'Panel Size Limit' ;
    rdfs:comment 'The maximum number of members that can be assigned to the provider\'s panel.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currentPanelCount rdf:type rdf:Property ;
    rdfs:label 'Current Panel Count' ;
    rdfs:comment 'The current number of members assigned to the provider\'s panel.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimsSubmissionMethod rdf:type rdf:Property ;
    rdfs:label 'Claims Submission Method' ;
    rdfs:comment 'The method by which the provider submits claims for services rendered to network members.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediPayerId rdf:type rdf:Property ;
    rdfs:label 'Edi Payer Id' ;
    rdfs:comment 'The unique payer identifier used in EDI transactions for claims submission and remittance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
