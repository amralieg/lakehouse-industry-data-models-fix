    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tpaId rdf:type rdf:Property ;
    rdfs:label 'Tpa Id' ;
    rdfs:comment 'Unique identifier for the third party administrator handling billing for this event, if applicable.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mlrApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Mlr Applicable Indicator' ;
    rdfs:comment 'Flag indicating whether this billing event premium is subject to MLR calculation and rebate requirements.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaReportableIndicator rdf:type rdf:Property ;
    rdfs:label 'Aca Reportable Indicator' ;
    rdfs:comment 'Flag indicating whether this billing event must be included in ACA reporting requirements (e.g., 1095-B, 1095-C forms).' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraQualifyingEventDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Qualifying Event Date' ;
    rdfs:comment 'The date of the qualifying event that triggered COBRA eligibility for this billing event.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicarePartAPremium rdf:type rdf:Property ;
    rdfs:label 'Medicare Part A Premium' ;
    rdfs:comment 'The Medicare Part A premium amount included in this billing event for Medicare Advantage plans.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicarePartBPremium rdf:type rdf:Property ;
    rdfs:label 'Medicare Part B Premium' ;
    rdfs:comment 'The Medicare Part B premium amount included in this billing event for Medicare Advantage plans.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicarePartDPremium rdf:type rdf:Property ;
    rdfs:label 'Medicare Part D Premium' ;
    rdfs:comment 'The Medicare Part D prescription drug premium amount included in this billing event.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lisSubsidyAmount rdf:type rdf:Property ;
    rdfs:label 'Lis Subsidy Amount' ;
    rdfs:comment 'The amount of low income subsidy applied to Medicare Part D premiums in this billing event.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lateEnrollmentPenalty rdf:type rdf:Property ;
    rdfs:label 'Late Enrollment Penalty' ;
    rdfs:comment 'The amount of late enrollment penalty applied to this billing event for Medicare plans.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:refundReasonCode rdf:type rdf:Property ;
    rdfs:label 'Refund Reason Code' ;
    rdfs:comment 'Code indicating the reason for issuing a refund in this billing event.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Posted Timestamp' ;
    rdfs:comment 'The date and time when this billing event was posted to the accounts receivable system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ediTransactionSet rdf:type rdf:Property ;
    rdfs:label 'Edi Transaction Set' ;
    rdfs:comment 'The ANSI X12 EDI transaction set code associated with this billing event (e.g., 834 for enrollment, 820 for premium payment).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityLevelId rdf:type rdf:Property ;
    rdfs:label 'Severity Level Id' ;
    rdfs:comment 'Unique identifier for the fraud severity level classification.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SeverityLevel .

ind:responseTimeHours rdf:type rdf:Property ;
    rdfs:label 'Response Time Hours' ;
    rdfs:comment 'Maximum number of hours within which an incident of this severity level must receive initial response or acknowledgment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimeHours rdf:type rdf:Property ;
    rdfs:label 'Resolution Time Hours' ;
    rdfs:comment 'Target number of hours within which an incident of this severity level should be resolved or escalated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Required Flag' ;
    rdfs:comment 'Indicates whether incidents at this severity level require automatic escalation to senior management or specialized investigation teams.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialThresholdMinimum rdf:type rdf:Property ;
    rdfs:label 'Financial Threshold Minimum' ;
    rdfs:comment 'Minimum dollar amount of suspected fraud or overpayment that qualifies an incident for this severity level.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialThresholdMaximum rdf:type rdf:Property ;
    rdfs:label 'Financial Threshold Maximum' ;
    rdfs:comment 'Maximum dollar amount of suspected fraud or overpayment that qualifies an incident for this severity level before escalating to a higher severity.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investigationTeamAssignment rdf:type rdf:Property ;
    rdfs:label 'Investigation Team Assignment' ;
    rdfs:comment 'Default investigation team or unit assigned to handle incidents of this severity level (e.g., SIU Tier 1, SIU Tier 2, Specialized Fraud Unit).' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required Flag' ;
    rdfs:comment 'Indicates whether incidents at this severity level require mandatory reporting to regulatory bodies such as Centers for Medicare and Medicaid Services (CMS) or state insurance departments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditTrailRetentionYears rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Retention Years' ;
    rdfs:comment 'Number of years that audit trails and investigation records for incidents at this severity level must be retained.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:iconReference rdf:type rdf:Property ;
    rdfs:label 'Icon Reference' ;
    rdfs:comment 'Reference to the icon or visual symbol used to represent this severity level in user interfaces and dashboards.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:automatedDetectionFlag rdf:type rdf:Property ;
    rdfs:label 'Automated Detection Flag' ;
    rdfs:comment 'Indicates whether incidents at this severity level can be automatically detected and classified by fraud detection algorithms and machine learning models.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manualReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Manual Review Required Flag' ;
    rdfs:comment 'Indicates whether all incidents at this severity level require mandatory manual review by a fraud investigator before any automated actions are taken.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerSuspensionEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Suspension Eligible Flag' ;
    rdfs:comment 'Indicates whether incidents at this severity level may warrant immediate suspension of provider payment or network participation pending investigation.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overpaymentRecoveryPriority rdf:type rdf:Property ;
    rdfs:label 'Overpayment Recovery Priority' ;
    rdfs:comment 'Priority level for initiating overpayment recovery actions for incidents at this severity level.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationProtocol rdf:type rdf:Property ;
    rdfs:label 'Communication Protocol' ;
    rdfs:comment 'Defined communication protocol and stakeholder notification requirements for incidents at this severity level.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScoreMinimum rdf:type rdf:Property ;
    rdfs:label 'Risk Score Minimum' ;
    rdfs:comment 'Minimum risk score threshold that qualifies an incident for this severity level classification.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskScoreMaximum rdf:type rdf:Property ;
    rdfs:label 'Risk Score Maximum' ;
    rdfs:comment 'Maximum risk score threshold that qualifies an incident for this severity level before escalating to a higher severity classification.' ;
    rdfs:domain ind:SeverityLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typeId rdf:type rdf:Property ;
    rdfs:label 'Type Id' ;
    rdfs:comment 'Unique identifier for the fraud type classification. Primary key for the fraud type reference table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnitedHealthCare .

ind:fwaClassification rdf:type rdf:Property ;
    rdfs:label 'Fwa Classification' ;
    rdfs:comment 'Classification indicating whether this type represents fraud (intentional deception), waste (overutilization without intent), or abuse (practices inconsistent with standards).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typicalIndicators rdf:type rdf:Property ;
    rdfs:label 'Typical Indicators' ;
    rdfs:comment 'Common red flags and patterns that indicate potential occurrence of this fraud type, used by investigators and automated detection systems.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimTypeApplicability rdf:type rdf:Property ;
    rdfs:label 'Claim Type Applicability' ;
    rdfs:comment 'Types of claims where this fraud type is typically observed (e.g., professional claims, institutional claims, pharmacy claims, dental claims).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerSpecialtyRisk rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Risk' ;
    rdfs:comment 'Provider specialties or types that are at higher risk for this fraud type (e.g., DME suppliers, home health agencies, pain management clinics).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageFinancialImpact rdf:type rdf:Property ;
    rdfs:label 'Average Financial Impact' ;
    rdfs:comment 'Average dollar amount of financial loss per occurrence of this fraud type, used for risk prioritization and resource allocation.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investigationPriority rdf:type rdf:Property ;
    rdfs:label 'Investigation Priority' ;
    rdfs:comment 'Standard priority level assigned to investigations of this fraud type by the Special Investigations Unit (SIU).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresLawEnforcementReferral rdf:type rdf:Property ;
    rdfs:label 'Requires Law Enforcement Referral' ;
    rdfs:comment 'Indicates whether confirmed cases of this fraud type typically require referral to law enforcement agencies or regulatory bodies.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mandatoryReportingThreshold rdf:type rdf:Property ;
    rdfs:label 'Mandatory Reporting Threshold' ;
    rdfs:comment 'Dollar threshold above which cases of this fraud type must be reported to external authorities per regulatory requirements.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statuteOfLimitationsYears rdf:type rdf:Property ;
    rdfs:label 'Statute Of Limitations Years' ;
    rdfs:comment 'Number of years within which legal action can be taken for this fraud type, based on applicable federal and state laws.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preventionStrategy rdf:type rdf:Property ;
    rdfs:label 'Prevention Strategy' ;
    rdfs:comment 'Recommended prevention strategies and controls to reduce occurrence of this fraud type (e.g., prepayment edits, provider education, enhanced credentialing).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsProgramIntegrityCategory rdf:type rdf:Property ;
    rdfs:label 'Cms Program Integrity Category' ;
    rdfs:comment 'CMS program integrity category classification for Medicare and Medicaid fraud types, used for federal reporting and coordination.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicFraudCode rdf:type rdf:Property ;
    rdfs:label 'Naic Fraud Code' ;
    rdfs:comment 'NAIC standardized fraud classification code for industry-wide reporting and benchmarking.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:involvesOrganizedCrime rdf:type rdf:Property ;
    rdfs:label 'Involves Organized Crime' ;
    rdfs:comment 'Indicates whether this fraud type is commonly associated with organized crime rings or sophisticated fraud schemes requiring specialized investigation.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSources rdf:type rdf:Property ;
    rdfs:label 'Data Sources' ;
    rdfs:comment 'Key data sources and systems used to detect and investigate this fraud type (e.g., claims data, provider enrollment, pharmacy data, external databases).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:historicalPrevalenceRate rdf:type rdf:Property ;
    rdfs:label 'Historical Prevalence Rate' ;
    rdfs:comment 'Historical rate of occurrence for this fraud type as a percentage of total claims or providers, used for risk modeling and resource planning.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:convictionRate rdf:type rdf:Property ;
    rdfs:label 'Conviction Rate' ;
    rdfs:comment 'Historical percentage of investigated cases of this fraud type that resulted in criminal conviction or civil settlement, indicating prosecutability.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageInvestigationDays rdf:type rdf:Property ;
    rdfs:label 'Average Investigation Days' ;
    rdfs:comment 'Typical number of days required to complete investigation of this fraud type, used for case planning and resource allocation.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresExternalData rdf:type rdf:Property ;
    rdfs:label 'Requires External Data' ;
    rdfs:comment 'Indicates whether investigation of this fraud type typically requires data from external sources (e.g., law enforcement databases, other payers, public records).' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:educationMaterialsAvailable rdf:type rdf:Property ;
    rdfs:label 'Education Materials Available' ;
    rdfs:comment 'Indicates whether provider or member education materials are available to prevent this fraud type through awareness and compliance training.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prepaymentEditApplicable rdf:type rdf:Property ;
    rdfs:label 'Prepayment Edit Applicable' ;
    rdfs:comment 'Indicates whether prepayment claim edits can effectively prevent or detect this fraud type before payment is issued.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postpaymentAuditApplicable rdf:type rdf:Property ;
    rdfs:label 'Postpayment Audit Applicable' ;
    rdfs:comment 'Indicates whether postpayment provider audits are an effective method for detecting this fraud type after claims have been paid.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerComparisonApplicable rdf:type rdf:Property ;
    rdfs:label 'Peer Comparison Applicable' ;
    rdfs:comment 'Indicates whether peer comparison analytics (comparing provider patterns to specialty peers) is effective for detecting this fraud type.' ;
    rdfs:domain ind:Type ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentHoldId rdf:type rdf:Property ;
    rdfs:label 'Payment Hold Id' ;
    rdfs:comment 'Unique identifier for the payment hold record. Primary key for the payment hold entity.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holdType rdf:type rdf:Property ;
    rdfs:label 'Hold Type' ;
    rdfs:comment 'Classification of the payment hold indicating the reason category for placing the payment on hold.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdStatus rdf:type rdf:Property ;
    rdfs:label 'Hold Status' ;
    rdfs:comment 'Current status of the payment hold indicating its lifecycle stage.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdAmount rdf:type rdf:Property ;
    rdfs:label 'Hold Amount' ;
    rdfs:comment 'Total monetary amount of the payment that has been placed on hold, in US dollars.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:releasedAmount rdf:type rdf:Property ;
    rdfs:label 'Released Amount' ;
    rdfs:comment 'Monetary amount that has been released from the hold, in US dollars. Applicable for partial releases.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingHoldAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Hold Amount' ;
    rdfs:comment 'Monetary amount still on hold after any partial releases, in US dollars.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdPlacedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Hold Placed Timestamp' ;
    rdfs:comment 'Precise date and time when the payment hold was placed, including timezone information.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:holdReleasedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Hold Released Timestamp' ;
    rdfs:comment 'Precise date and time when the payment hold was released, including timezone information.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:holdDurationDays rdf:type rdf:Property ;
    rdfs:label 'Hold Duration Days' ;
    rdfs:comment 'Number of calendar days the payment has been on hold, calculated from placement to current date or release date.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:investigatorName rdf:type rdf:Property ;
    rdfs:label 'Investigator Name' ;
    rdfs:comment 'Full name of the fraud investigator or SIU analyst assigned to this case.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudIndicatorFlags rdf:type rdf:Property ;
    rdfs:label 'Fraud Indicator Flags' ;
    rdfs:comment 'Comma-separated list of fraud indicator codes or flags that triggered the payment hold.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseCriteria rdf:type rdf:Property ;
    rdfs:label 'Release Criteria' ;
    rdfs:comment 'Detailed description of the conditions and documentation required to release the payment hold.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Release Approval Required' ;
    rdfs:comment 'Indicates whether managerial or supervisory approval is required to release the payment hold.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:releaseApproverAgentId rdf:type rdf:Property ;
    rdfs:label 'Release Approver Agent Id' ;
    rdfs:comment 'Unique identifier of the manager or supervisor who approved the release of the payment hold.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:releaseApproverName rdf:type rdf:Property ;
    rdfs:label 'Release Approver Name' ;
    rdfs:comment 'Full name of the manager or supervisor who approved the release.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Release Approval Date' ;
    rdfs:comment 'Date when the release of the payment hold was approved by the authorized approver.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentationComplete rdf:type rdf:Property ;
    rdfs:label 'Documentation Complete' ;
    rdfs:comment 'Indicates whether all required documentation has been received and is complete for hold resolution.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overpaymentIdentified rdf:type rdf:Property ;
    rdfs:label 'Overpayment Identified' ;
    rdfs:comment 'Indicates whether an overpayment was identified during the investigation of this payment hold.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawEnforcementReferral rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Referral' ;
    rdfs:comment 'Indicates whether the case has been referred to law enforcement agencies for potential criminal investigation.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditFindingCode rdf:type rdf:Property ;
    rdfs:label 'Audit Finding Code' ;
    rdfs:comment 'Standardized code representing the specific audit finding that triggered the payment hold.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentSystemSource rdf:type rdf:Property ;
    rdfs:label 'Payment System Source' ;
    rdfs:comment 'Name of the source payment system or claims adjudication platform that generated the payment hold.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdInitiatedBy rdf:type rdf:Property ;
    rdfs:label 'Hold Initiated By' ;
    rdfs:comment 'Indicates the source or party that initiated the payment hold.' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerSanctionId rdf:type rdf:Property ;
    rdfs:label 'Provider Sanction Id' ;
    rdfs:comment 'Unique identifier for the provider sanction record. Primary key for the provider sanction entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderSanction .

ind:sanctionSubtype rdf:type rdf:Property ;
    rdfs:label 'Sanction Subtype' ;
    rdfs:comment 'A more granular classification of the sanction type, providing additional detail on the specific action taken.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionStatus rdf:type rdf:Property ;
    rdfs:label 'Sanction Status' ;
    rdfs:comment 'The current lifecycle status of the provider sanction.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationCaseId rdf:type rdf:Property ;
    rdfs:label 'Investigation Case Id' ;
    rdfs:comment 'The unique identifier of the SIU investigation case that resulted in this sanction.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Case .

ind:sanctionEndDate rdf:type rdf:Property ;
    rdfs:label 'Sanction End Date' ;
    rdfs:comment 'The date when the sanction is scheduled to expire or was actually lifted, if applicable.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sanctionDurationDays rdf:type rdf:Property ;
    rdfs:label 'Sanction Duration Days' ;
    rdfs:comment 'The total number of days the sanction is or was in effect, calculated from effective date to end date.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monetaryPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Monetary Penalty Amount' ;
    rdfs:comment 'The total dollar amount of financial penalties assessed against the provider as part of the sanction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementCriteria rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Criteria' ;
    rdfs:comment 'Detailed description of the conditions and requirements the provider must meet to be eligible for reinstatement.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oigExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Oig Exclusion Flag' ;
    rdfs:comment 'Indicates whether the provider has been excluded from participation in federal healthcare programs by the OIG.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oigExclusionDate rdf:type rdf:Property ;
    rdfs:label 'Oig Exclusion Date' ;
    rdfs:comment 'The date when the provider was added to the OIG exclusion list.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'State Exclusion Flag' ;
    rdfs:comment 'Indicates whether the provider has been excluded from participation in state Medicaid programs.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateExclusionJurisdiction rdf:type rdf:Property ;
    rdfs:label 'State Exclusion Jurisdiction' ;
    rdfs:comment 'The state or states where the provider has been excluded from Medicaid participation.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Network Termination Flag' ;
    rdfs:comment 'Indicates whether the provider\'s participation in the UnitedHealthcare network was terminated as a result of the sanction.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Network Termination Date' ;
    rdfs:comment 'The date when the provider\'s network participation was officially terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:claimsPaymentSuspendedFlag rdf:type rdf:Property ;
    rdfs:label 'Claims Payment Suspended Flag' ;
    rdfs:comment 'Indicates whether payment of claims submitted by the provider has been suspended pending investigation or as part of the sanction.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentSuspensionDate rdf:type rdf:Property ;
    rdfs:label 'Payment Suspension Date' ;
    rdfs:comment 'The date when claims payment suspension was initiated for the provider.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionPlanRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Required Flag' ;
    rdfs:comment 'Indicates whether the provider is required to submit and complete a corrective action plan as part of the sanction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Status' ;
    rdfs:comment 'The current status of the provider\'s corrective action plan submission and implementation.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionPlanDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Due Date' ;
    rdfs:comment 'The deadline by which the provider must submit their corrective action plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionPlanCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Completion Date' ;
    rdfs:comment 'The date when the provider successfully completed all requirements of the corrective action plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditFindingsReference rdf:type rdf:Property ;
    rdfs:label 'Audit Findings Reference' ;
    rdfs:comment 'Reference identifier or summary of the provider audit findings that led to or support the sanction.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedClaimsCount rdf:type rdf:Property ;
    rdfs:label 'Affected Claims Count' ;
    rdfs:comment 'The total number of claims identified as fraudulent, wasteful, or abusive in the investigation.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sanctionImposedBy rdf:type rdf:Property ;
    rdfs:label 'Sanction Imposed By' ;
    rdfs:comment 'The name or role of the individual or committee that authorized the imposition of the sanction.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Sanction Approval Date' ;
    rdfs:comment 'The date when the sanction decision was formally approved by the authorized authority.' ;
    rdfs:domain ind:ProviderSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trainingRecordId rdf:type rdf:Property ;
    rdfs:label 'Training Record Id' ;
    rdfs:comment 'Unique identifier for each compliance training record event in the system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrainingRecord .

ind:employeeId rdf:type rdf:Property ;
    rdfs:label 'Employee Id' ;
    rdfs:comment 'Unique identifier for the employee who completed or is assigned the training. Links to the employee master record in HR systems.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:employeeName rdf:type rdf:Property ;
    rdfs:label 'Employee Name' ;
    rdfs:comment 'Full legal name of the employee who completed the training, used for reporting and audit trail purposes.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeEmail rdf:type rdf:Property ;
    rdfs:label 'Employee Email' ;
    rdfs:comment 'Corporate email address of the employee used for training notifications and certificate delivery.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:department rdf:type rdf:Property ;
    rdfs:label 'Department' ;
    rdfs:comment 'The organizational department or business unit to which the employee belongs at the time of training completion.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobTitle rdf:type rdf:Property ;
    rdfs:label 'Job Title' ;
    rdfs:comment 'The employee\'s job title or role at the time of training completion, used to determine training requirements and compliance obligations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingModuleId rdf:type rdf:Property ;
    rdfs:label 'Training Module Id' ;
    rdfs:comment 'Unique identifier for the specific compliance training module or course completed by the employee.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrainingModule .

ind:trainingModuleName rdf:type rdf:Property ;
    rdfs:label 'Training Module Name' ;
    rdfs:comment 'Descriptive name of the compliance training module, such as HIPAA Privacy Training, Anti-Kickback Statute Training, or ACA Compliance Training.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingCategory rdf:type rdf:Property ;
    rdfs:label 'Training Category' ;
    rdfs:comment 'High-level category or domain of the compliance training module, used for grouping and reporting training completion by regulatory area.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingType rdf:type rdf:Property ;
    rdfs:label 'Training Type' ;
    rdfs:comment 'Classification of the training event indicating whether it is initial training, annual refresher, ad-hoc update, or remedial training.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Training Delivery Method' ;
    rdfs:comment 'The method or format through which the training was delivered to the employee.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingProvider rdf:type rdf:Property ;
    rdfs:label 'Training Provider' ;
    rdfs:comment 'Name of the organization or vendor that provided the training content or platform, such as internal compliance team or external training vendor.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionStatus rdf:type rdf:Property ;
    rdfs:label 'Completion Status' ;
    rdfs:comment 'Outcome status indicating whether the employee passed, failed, or did not complete the training assessment requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationIssueDate rdf:type rdf:Property ;
    rdfs:label 'Certification Issue Date' ;
    rdfs:comment 'The date on which the compliance training certificate was issued to the employee upon successful completion.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:passingScore rdf:type rdf:Property ;
    rdfs:label 'Passing Score' ;
    rdfs:comment 'The minimum score or percentage required to pass the training assessment and achieve certification.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attemptNumber rdf:type rdf:Property ;
    rdfs:label 'Attempt Number' ;
    rdfs:comment 'The sequential number of the attempt for this training module, tracking how many times the employee has taken the training or assessment.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isRoleBased rdf:type rdf:Property ;
    rdfs:label 'Is Role Based' ;
    rdfs:comment 'Flag indicating whether the training requirement is specific to the employee\'s job role or function within the organization.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceYear rdf:type rdf:Property ;
    rdfs:label 'Compliance Year' ;
    rdfs:comment 'The calendar year for which this training record satisfies compliance requirements, used for annual compliance reporting.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingVersion rdf:type rdf:Property ;
    rdfs:label 'Training Version' ;
    rdfs:comment 'Version number or identifier of the training module content, tracking updates and revisions to training materials over time.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:language rdf:type rdf:Property ;
    rdfs:label 'Language' ;
    rdfs:comment 'The language in which the training content was delivered to the employee.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Waiver Approved By' ;
    rdfs:comment 'Name of the manager or compliance officer who approved the training waiver, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Approval Date' ;
    rdfs:comment 'The date on which the training waiver was approved by authorized personnel.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationRequired rdf:type rdf:Property ;
    rdfs:label 'Remediation Required' ;
    rdfs:comment 'Flag indicating whether the employee requires additional remedial training or coaching due to failure or non-compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Completed Date' ;
    rdfs:comment 'The date on which required remedial training or corrective action was completed by the employee.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supervisorName rdf:type rdf:Property ;
    rdfs:label 'Supervisor Name' ;
    rdfs:comment 'Name of the employee\'s direct supervisor or manager at the time of training assignment, used for escalation and compliance tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisorEmail rdf:type rdf:Property ;
    rdfs:label 'Supervisor Email' ;
    rdfs:comment 'Corporate email address of the employee\'s supervisor, used for compliance notifications and escalations.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Code representing the physical work location or office of the employee at the time of training completion.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationName rdf:type rdf:Property ;
    rdfs:label 'Location Name' ;
    rdfs:comment 'Descriptive name of the employee\'s work location, such as office name or site name.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Training Source System' ;
    rdfs:comment 'Name of the learning management system or training platform from which this training record was captured, such as Workday Learning or external LMS.' ;
    rdfs:domain ind:TrainingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Timestamp' ;
    rdfs:comment 'The date and time when the employee provided acknowledgment or attestation of the training content.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ipAddress rdf:type rdf:Property ;
    rdfs:label 'Ip Address' ;
    rdfs:comment 'The IP address from which the employee accessed and completed the training, captured for audit and security purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceType rdf:type rdf:Property ;
    rdfs:label 'Device Type' ;
    rdfs:comment 'The type of device used by the employee to complete the training, captured for user experience and accessibility tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:browserType rdf:type rdf:Property ;
    rdfs:label 'Browser Type' ;
    rdfs:comment 'The web browser used by the employee to access the training content, captured for technical support and compatibility tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberSanctionId rdf:type rdf:Property ;
    rdfs:label 'Member Sanction Id' ;
    rdfs:comment 'Unique identifier for the member sanction record. Primary key for tracking sanctions applied to members for confirmed fraudulent activity.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sanctionTypeCode rdf:type rdf:Property ;
    rdfs:label 'Sanction Type Code' ;
    rdfs:comment 'Code representing the type of sanction applied to the member, such as benefit suspension, termination, or enrollment denial.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationFindingCode rdf:type rdf:Property ;
    rdfs:label 'Investigation Finding Code' ;
    rdfs:comment 'Code representing the outcome of the fraud investigation that led to the sanction, such as confirmed fraud, abuse, or misrepresentation.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPermanent rdf:type rdf:Property ;
    rdfs:label 'Is Permanent' ;
    rdfs:comment 'Boolean flag indicating whether the sanction is permanent with no scheduled end date.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:imposedByDepartment rdf:type rdf:Property ;
    rdfs:label 'Imposed By Department' ;
    rdfs:comment 'Department or organizational unit that imposed the sanction, such as Special Investigations Unit or Compliance.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:imposedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Imposed Timestamp' ;
    rdfs:comment 'Date and time when the sanction was officially imposed in the system.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:restitutionPlanId rdf:type rdf:Property ;
    rdfs:label 'Restitution Plan Id' ;
    rdfs:comment 'Unique identifier of the repayment or restitution plan established for the member to recover overpayments.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:criminalCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Criminal Case Number' ;
    rdfs:comment 'Case number assigned by law enforcement or the court system for criminal prosecution related to the fraud.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigatorAgentId rdf:type rdf:Property ;
    rdfs:label 'Investigator Agent Id' ;
    rdfs:comment 'Unique identifier of the investigator or case manager from the Special Investigations Unit who handled the fraud case.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:evidenceSummary rdf:type rdf:Property ;
    rdfs:label 'Evidence Summary' ;
    rdfs:comment 'Summary of key evidence collected during the investigation that supports the sanction decision.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsInvolvedCount rdf:type rdf:Property ;
    rdfs:label 'Claims Involved Count' ;
    rdfs:comment 'Total number of claims identified as fraudulent or involved in the member\'s fraudulent activity.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providersInvolvedCount rdf:type rdf:Property ;
    rdfs:label 'Providers Involved Count' ;
    rdfs:comment 'Number of healthcare providers implicated or involved in the member\'s fraudulent activity, if applicable.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingSource rdf:type rdf:Property ;
    rdfs:label 'Reporting Source' ;
    rdfs:comment 'Source that initially reported or flagged the suspicious activity, such as internal audit, provider, member, or fraud hotline.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Reported Flag' ;
    rdfs:comment 'Boolean flag indicating whether the fraud case was reported to CMS as required for Medicare or Medicaid programs.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Sanction Reason Code' ;
    rdfs:comment 'Standardized code representing the specific reason or legal basis for imposing the sanction.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalBasis rdf:type rdf:Property ;
    rdfs:label 'Legal Basis' ;
    rdfs:comment 'Legal statute, regulation, or contract provision that provides the authority for imposing the sanction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementConditions rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Conditions' ;
    rdfs:comment 'Description of conditions the member must meet for reinstatement of benefits, such as full restitution or completion of probation period.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedByUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User Agent Id' ;
    rdfs:comment 'Identifier of the user who last modified the sanction record.' ;
    rdfs:domain ind:MemberSanction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:auditFindingId rdf:type rdf:Property ;
    rdfs:label 'Audit Finding Id' ;
    rdfs:comment 'Unique identifier for the audit finding record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditFinding .

ind:findingNumber rdf:type rdf:Property ;
    rdfs:label 'Finding Number' ;
    rdfs:comment 'Human-readable reference number assigned to the finding within the audit (e.g., 2024-HIPAA-001).' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingTitle rdf:type rdf:Property ;
    rdfs:label 'Finding Title' ;
    rdfs:comment 'Brief descriptive title summarizing the nature of the audit finding.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingDescription rdf:type rdf:Property ;
    rdfs:label 'Finding Description' ;
    rdfs:comment 'Detailed narrative description of the audit finding, including what was observed and why it represents a deficiency or non-compliance.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingType rdf:type rdf:Property ;
    rdfs:label 'Finding Type' ;
    rdfs:comment 'Classification of the finding based on its nature (e.g., deficiency, non-compliance, observation, material weakness).' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskRating rdf:type rdf:Property ;
    rdfs:label 'Risk Rating' ;
    rdfs:comment 'Overall risk rating assigned to the finding based on likelihood and impact assessment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:likelihood rdf:type rdf:Property ;
    rdfs:label 'Likelihood' ;
    rdfs:comment 'Assessment of the probability that the identified issue will result in an adverse event or loss.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impact rdf:type rdf:Property ;
    rdfs:label 'Impact' ;
    rdfs:comment 'Assessment of the potential business, financial, or regulatory impact if the finding is not remediated.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlId rdf:type rdf:Property ;
    rdfs:label 'Control Id' ;
    rdfs:comment 'Identifier of the internal control or policy that failed or was found deficient.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Control .

ind:rootCause rdf:type rdf:Property ;
    rdfs:label 'Root Cause' ;
    rdfs:comment 'Identified underlying cause or reason for the finding, based on root cause analysis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedBusinessUnit rdf:type rdf:Property ;
    rdfs:label 'Affected Business Unit' ;
    rdfs:comment 'Name of the business unit, department, or division where the finding was identified.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedProcess rdf:type rdf:Property ;
    rdfs:label 'Affected Process' ;
    rdfs:comment 'Specific business process or workflow that is impacted by the finding.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedSystem rdf:type rdf:Property ;
    rdfs:label 'Affected System' ;
    rdfs:comment 'Name of the IT system or application where the finding was identified (e.g., Facets, QNXT, Salesforce Health Cloud).' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementResponse rdf:type rdf:Property ;
    rdfs:label 'Management Response' ;
    rdfs:comment 'Formal response from management acknowledging the finding and outlining planned corrective actions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationNotes rdf:type rdf:Property ;
    rdfs:label 'Validation Notes' ;
    rdfs:comment 'Notes or comments from the auditor regarding the validation or testing of the corrective action.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repeatFindingFlag rdf:type rdf:Property ;
    rdfs:label 'Repeat Finding Flag' ;
    rdfs:comment 'Indicator of whether this finding was previously identified in a prior audit and has recurred.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorFindingId rdf:type rdf:Property ;
    rdfs:label 'Prior Finding Id' ;
    rdfs:comment 'Identifier of the previous audit finding if this is a repeat finding.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditFinding .

ind:memberImpactCount rdf:type rdf:Property ;
    rdfs:label 'Member Impact Count' ;
    rdfs:comment 'Number of members or beneficiaries affected by the finding.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providerImpactCount rdf:type rdf:Property ;
    rdfs:label 'Provider Impact Count' ;
    rdfs:comment 'Number of healthcare providers affected by the finding.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimImpactCount rdf:type rdf:Property ;
    rdfs:label 'Claim Impact Count' ;
    rdfs:comment 'Number of claims affected by the finding.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phiBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Breach Flag' ;
    rdfs:comment 'Indicator of whether the finding involves a breach or unauthorized disclosure of protected health information.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breachNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Breach Notification Required Flag' ;
    rdfs:comment 'Indicator of whether the finding requires formal breach notification to affected individuals, HHS, or media under HIPAA Breach Notification Rule.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breachNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Breach Notification Date' ;
    rdfs:comment 'Date on which breach notification was sent to affected parties or regulatory authorities.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:externalAuditorName rdf:type rdf:Property ;
    rdfs:label 'External Auditor Name' ;
    rdfs:comment 'Name of the external audit firm or regulatory examiner who identified the finding (if applicable).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedDate rdf:type rdf:Property ;
    rdfs:label 'Identified Date' ;
    rdfs:comment 'Date on which the finding was first identified or discovered during the audit.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedDate rdf:type rdf:Property ;
    rdfs:label 'Reported Date' ;
    rdfs:comment 'Date on which the finding was formally reported to management or included in the audit report.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:acknowledgedDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledged Date' ;
    rdfs:comment 'Date on which management formally acknowledged the finding and accepted responsibility for remediation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Remediation Cost Estimate' ;
    rdfs:comment 'Estimated cost in US dollars to implement the corrective action and remediate the finding.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remediationEffortHours rdf:type rdf:Property ;
    rdfs:label 'Remediation Effort Hours' ;
    rdfs:comment 'Estimated number of labor hours required to implement the corrective action.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agingDays rdf:type rdf:Property ;
    rdfs:label 'Aging Days' ;
    rdfs:comment 'Number of days the finding has been open since identification.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overdueFlag rdf:type rdf:Property ;
    rdfs:label 'Overdue Flag' ;
    rdfs:comment 'Indicator of whether the finding remediation is past the target completion date.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:daysOverdue rdf:type rdf:Property ;
    rdfs:label 'Days Overdue' ;
    rdfs:comment 'Number of days the finding remediation is past the target completion date.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evidenceReference rdf:type rdf:Property ;
    rdfs:label 'Evidence Reference' ;
    rdfs:comment 'Reference to supporting documentation, evidence, or work papers that substantiate the finding.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyId rdf:type rdf:Property ;
    rdfs:label 'Policy Id' ;
    rdfs:comment 'Unique identifier for the compliance policy record. Primary key for the compliance policy entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:governingRegulation rdf:type rdf:Property ;
    rdfs:label 'Governing Regulation' ;
    rdfs:comment 'Primary federal or state regulation, statute, or standard that mandates or governs this compliance policy.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scope rdf:type rdf:Property ;
    rdfs:label 'Scope' ;
    rdfs:comment 'Organizational scope defining which parts of the organization are subject to this compliance policy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerName rdf:type rdf:Property ;
    rdfs:label 'Owner Name' ;
    rdfs:comment 'Name of the individual or role responsible for maintaining and enforcing the compliance policy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerEmail rdf:type rdf:Property ;
    rdfs:label 'Owner Email' ;
    rdfs:comment 'Email address of the policy owner for inquiries and escalations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementLevel rdf:type rdf:Property ;
    rdfs:label 'Enforcement Level' ;
    rdfs:comment 'Level of enforcement required for the compliance policy indicating whether adherence is mandatory or advisory.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationSeverity rdf:type rdf:Property ;
    rdfs:label 'Violation Severity' ;
    rdfs:comment 'Severity classification for violations of this compliance policy, used to determine escalation and remediation actions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyDescription rdf:type rdf:Property ;
    rdfs:label 'Penalty Description' ;
    rdfs:comment 'Description of penalties or consequences for non-compliance with the policy, including disciplinary actions or regulatory fines.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Training Required Flag' ;
    rdfs:comment 'Indicator of whether employee training is required for this compliance policy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trainingFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Training Frequency Months' ;
    rdfs:comment 'Number of months between required training sessions for this compliance policy (e.g., 12 for annual training).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attestationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Attestation Required Flag' ;
    rdfs:comment 'Indicator of whether employees must formally attest to their understanding and compliance with this policy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Attestation Frequency Months' ;
    rdfs:comment 'Number of months between required attestations for this compliance policy (e.g., 12 for annual attestation).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Required Flag' ;
    rdfs:comment 'Indicator of whether periodic audits are required to verify compliance with this policy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditFrequencyMonths rdf:type rdf:Property ;
