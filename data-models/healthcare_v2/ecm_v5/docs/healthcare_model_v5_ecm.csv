order,entry_management,reconciliation,discrepancy_identified_indicator,discrepancy_identified_indicator,Discrepancy Identified Indicator,BOOLEAN,,,,,transactional_data,"Boolean flag indicating whether any discrepancies were identified during reconciliation. True if discrepancies found, false otherwise.",
order,entry_management,reconciliation,discrepancy_severity,discrepancy_severity,Discrepancy Severity,STRING,,,,high|medium|low|none,transactional_data,"Clinical severity level of identified discrepancies. High for potentially life-threatening, medium for clinically significant, low for minor, none if no discrepancies.",
order,entry_management,reconciliation,documentation_location,documentation_location,Documentation Location,STRING,,,,,transactional_data,"Location or section within the EMR where the reconciliation documentation is stored (e.g., admission note, discharge summary, medication administration record).",
order,entry_management,reconciliation,drug_interaction_check_indicator,drug_interaction_check_indicator,Drug Interaction Check Indicator,BOOLEAN,,,,,transactional_data,"Boolean flag indicating whether drug-drug interaction screening was performed during reconciliation. True if performed, false otherwise.",
order,entry_management,reconciliation,duration_minutes,duration_minutes,Reconciliation Duration in Minutes,INT,,,,,transactional_data,Total time in minutes spent performing the reconciliation process.,
order,entry_management,reconciliation,formulary_check_indicator,formulary_check_indicator,Formulary Check Indicator,BOOLEAN,,,,,transactional_data,"Boolean flag indicating whether formulary status was checked for medications during reconciliation. True if checked, false otherwise.",
order,entry_management,reconciliation,home_medication_list_reviewed_indicator,home_medication_list_reviewed_indicator,Home Medication List Reviewed Indicator,BOOLEAN,,,,,transactional_data,"Boolean flag indicating whether the patients home medication list was reviewed during reconciliation. True if reviewed, false otherwise.",
order,entry_management,reconciliation,last_updated_datetime,last_updated_datetime,Last Updated Date and Time,TIMESTAMP,,,,,transactional_data,Date and time when this reconciliation record was last modified. Audit trail timestamp for record updates.,
