    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Response Submitted Date' ;
    rdfs:comment 'Date when the organization submitted its response to regulatory objections or information requests.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supersedesFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Supersedes Filing Number' ;
    rdfs:comment 'Filing number of the previous filing that this filing supersedes or replaces.' ;
