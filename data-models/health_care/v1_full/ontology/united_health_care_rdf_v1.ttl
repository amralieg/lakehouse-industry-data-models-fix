ind:evidenceType rdf:type rdf:Property ;
    rdfs:label 'Evidence Type' ;
    rdfs:comment 'Type of evidence documented or referenced in the case note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chainOfCustodyIndicator rdf:type rdf:Property ;
    rdfs:label 'Chain Of Custody Indicator' ;
    rdfs:comment 'Flag indicating whether the case note documents chain of custody information for evidence handling.' ;
