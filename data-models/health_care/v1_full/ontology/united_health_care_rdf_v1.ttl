ind:productApproved rdf:type rdf:Property ;
    rdfs:label 'Product Approved' ;
    rdfs:comment 'Comma-separated list of specific health plan products for which the provider is approved (HMO, PPO, EPO, POS, etc.).' ;
    rdfs:domain ind:CredentialingDecision ;
