}

Table finance.chart_of_accounts {
  chart_of_accounts_id varchar [pk, note: 'Unique identifier for the chart of accounts entry. Primary key for the chart of accounts master data. | Column chart_of_accounts_id (BIGINT) in finance.chart_of_accounts']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: GL accounts are defined per legal entity in SAP S/4HANA. The company_code is a business key reference to legal_entity. FK enables proper chart of accounts management per legal entity. | Column company_legal_entity_id (BIGINT) in finance.chart_of_accounts']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.chart_of_accounts']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.chart_of_accounts']
  account_currency varchar [note: 'The primary currency in which this account is maintained, using ISO 4217 three-letter currency codes (e.g., \'USD\', \'EUR\', \'GBP\'). Determines the currency for postings and balance reporting. | Column account_currency (STRING) in finance.chart_of_accounts']
  account_group varchar [note: 'SAP account group classification that controls field status, number range assignment, and screen layout for the account. Groups accounts with similar characteristics and processing rules (e.g., \'REVENUE\', \'COGS\', \'OPEX\', \'CAPEX\'). | Column account_group (STRING) in finance.chart_of_accounts']
  account_name varchar [note: 'The full descriptive name of the general ledger account, providing clear business context for the account\'s purpose (e.g., \'Advertising Revenue - Linear TV\', \'Content Production Costs\', \'Subscription Revenue - SVOD\'). | Column account_name (STRING) in finance.chart_of_accounts']
  account_notes varchar [note: 'Free-text field for additional notes, usage guidelines, or special instructions related to this account. Used to document account-specific policies, restrictions, or business context. | Column account_notes (STRING) in finance.chart_of_accounts']
  account_short_text varchar [note: 'Abbreviated name or short description of the account used in reports and transaction displays where space is limited. | Column account_short_text (STRING) in finance.chart_of_accounts']
  account_status varchar [note: 'Current lifecycle status of the account: active (available for posting), inactive (not available for new postings but retains history), blocked (temporarily suspended), or pending_approval (awaiting activation approval). | Column account_status (STRING) in finance.chart_of_accounts']
  account_type varchar [note: 'High-level classification of the account into fundamental accounting categories: asset (balance sheet), liability (balance sheet), equity (balance sheet), revenue (P&L), or expense (P&L). Determines which financial statement the account appears on. | Column account_type (STRING) in finance.chart_of_accounts']
  alternative_account_number varchar [note: 'An alternative or legacy account number used for mapping to previous chart of accounts structures, external reporting systems, or consolidation systems. Supports migration and integration scenarios. | Column alternative_account_number (STRING) in finance.chart_of_accounts']
  balance_sheet_classification varchar [note: 'For balance sheet accounts, specifies whether the account is classified as current asset, non-current asset, current liability, non-current liability, or equity. Not applicable for P&L accounts. | Column balance_sheet_classification (STRING) in finance.chart_of_accounts']
  chart_of_accounts_code varchar [note: 'The chart of accounts identifier to which this account belongs. Media Broadcasting may maintain multiple charts of accounts for different regions or business units (e.g., \'USGA\' for US GAAP, \'IFRS\' for international operations). | Column chart_of_accounts_code (STRING) in finance.chart_of_accounts']
  company_code varchar [note: 'The SAP company code (legal entity) to which this chart of accounts entry applies. Supports multi-entity environments where different legal entities may have entity-specific account configurations. | Column company_code (STRING) in finance.chart_of_accounts']
  consolidation_account varchar [note: 'The consolidation account code used for corporate consolidation and intercompany eliminations. Maps local entity accounts to group-level chart of accounts for consolidated financial reporting. | Column consolidation_account (STRING) in finance.chart_of_accounts']
  cost_center_required boolean [note: 'Indicates whether a cost center must be specified when posting to this account. True for expense accounts requiring cost center assignment; false for balance sheet and revenue accounts. | Column cost_center_required (BOOLEAN) in finance.chart_of_accounts']
  cost_element_category varchar [note: 'Classification of the account as a cost element for controlling purposes: primary (direct posting from FI), secondary (internal allocations/assessments), revenue (revenue postings), or none (not a cost element). Links financial accounting to management accounting. | Column cost_element_category (STRING) in finance.chart_of_accounts']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.chart_of_accounts']
  created_by_user varchar [note: 'The user ID of the person who created this chart of accounts entry in SAP S/4HANA. Used for audit trail and accountability. | Column created_by_user (STRING) in finance.chart_of_accounts']
  created_timestamp timestamp [note: 'The date and time when this chart of accounts entry was first created in the system. Part of the audit trail for master data governance. | Column created_timestamp (TIMESTAMP) in finance.chart_of_accounts']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  financial_statement_item varchar [note: 'The line item code on the financial statement (balance sheet or income statement) where this account\'s balance is reported. Used for financial statement generation and external reporting. | Column financial_statement_item (STRING) in finance.chart_of_accounts']
  functional_area varchar [note: 'SAP functional area classification used for segment reporting and cost-of-sales accounting. Represents business functions such as \'Content Production\', \'Distribution\', \'Sales & Marketing\', \'Technology\', \'Corporate\'. Enables P&L reporting by business function per IFRS requirements. | Column functional_area (STRING) in finance.chart_of_accounts']
  gl_account_number varchar [note: 'The unique account code used to identify this general ledger account across all financial postings. This is the authoritative account identifier used in SAP S/4HANA FI module for all financial transactions. | Column gl_account_number (STRING) in finance.chart_of_accounts']
  last_modified_by_user varchar [note: 'The user ID of the person who last modified this chart of accounts entry. Used for change tracking and audit trail. | Column last_modified_by_user (STRING) in finance.chart_of_accounts']
  last_modified_timestamp timestamp [note: 'The date and time when this chart of accounts entry was last modified. Part of the audit trail for master data change management. | Column last_modified_timestamp (TIMESTAMP) in finance.chart_of_accounts']
  line_item_display_allowed boolean [note: 'Indicates whether individual line items (transaction details) can be displayed for this account. True enables drill-down to transaction level; false shows only account balance. Typically true for balance sheet accounts, false for P&L accounts. | Column line_item_display_allowed (BOOLEAN) in finance.chart_of_accounts']
  materiality_threshold_amount decimal(18,2) [note: 'The monetary threshold above which transactions or balances in this account are considered material for audit and control purposes. Used to determine testing scope and control frequency for SOX compliance. | Column materiality_threshold_amount (DECIMAL(18,2)) in finance.chart_of_accounts']
  open_item_management boolean [note: 'Indicates whether this account uses open item management, tracking individual postings until they are cleared (e.g., for receivables, payables, clearing accounts). True enables clearing transactions; false for standard balance accounts. | Column open_item_management (BOOLEAN) in finance.chart_of_accounts']
  pl_statement_classification varchar [note: 'For P&L accounts, specifies the detailed classification within the income statement (e.g., \'Operating Revenue\', \'Cost of Sales\', \'Operating Expenses\', \'Depreciation\', \'Interest Expense\', \'Tax Expense\'). Not applicable for balance sheet accounts. | Column pl_statement_classification (STRING) in finance.chart_of_accounts']
  planning_level varchar [note: 'The planning level or budget category assigned to this account for financial planning and budgeting purposes. Links the account to budget planning hierarchies and enables budget vs. actual reporting. | Column planning_level (STRING) in finance.chart_of_accounts']
  posting_blocked boolean [note: 'Indicates whether direct postings to this account are currently blocked. True prevents new transactions; false allows normal posting. Used to freeze accounts during period-end close or for inactive accounts. | Column posting_blocked (BOOLEAN) in finance.chart_of_accounts']
  profit_center_required boolean [note: 'Indicates whether a profit center must be specified when posting to this account. True for accounts requiring segment profitability tracking; false otherwise. | Column profit_center_required (BOOLEAN) in finance.chart_of_accounts']
  reconciliation_account_type varchar [note: 'Identifies if this is a reconciliation account (subledger control account) and its type: customer (accounts receivable), vendor (accounts payable), asset (fixed assets), or none (standard GL account). Reconciliation accounts are automatically posted from subledgers. | Column reconciliation_account_type (STRING) in finance.chart_of_accounts']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.chart_of_accounts']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.chart_of_accounts']
  sox_control_classification varchar [note: 'Classification of the account for SOX compliance purposes: key_control (critical accounts requiring enhanced controls and testing), supporting_control (accounts with standard controls), or not_in_scope (accounts outside SOX scope). Drives audit testing requirements. | Column sox_control_classification (STRING) in finance.chart_of_accounts']
  tax_category varchar [note: 'The tax category classification for this account, determining how tax is calculated and posted (e.g., \'Input Tax\', \'Output Tax\', \'Non-Taxable\', \'Tax Exempt\'). Used for VAT/GST/sales tax processing. | Column tax_category (STRING) in finance.chart_of_accounts']
  trading_partner_required boolean [note: 'Indicates whether a trading partner (intercompany entity) must be specified when posting to this account. True for intercompany accounts requiring elimination tracking; false for standard accounts. | Column trading_partner_required (BOOLEAN) in finance.chart_of_accounts']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.chart_of_accounts']
  valid_from_date date [note: 'The date from which this account becomes active and available for posting. Supports time-dependent chart of accounts changes and new account activation. | Column valid_from_date (DATE) in finance.chart_of_accounts']
  valid_to_date date [note: 'The date until which this account remains active. After this date, the account is no longer available for posting. Null indicates the account is currently active with no planned end date. | Column valid_to_date (DATE) in finance.chart_of_accounts']

  Note: 'SAP S/4HANA FI-authoritative chart of accounts defining the complete hierarchy of general ledger account codes used across all Media Broadcasting entities. Captures account number, account type (P&L, balance sheet), account group, functional area, cost element category, currency, consolidation account mapping, and SOX control classification. Serves as the foundational reference for all financial postings, period-end close, and intercompany eliminations. | Unity Catalog table: media_broadcasting_ecm.finance.chart_of_accounts Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.cost_center {
  cost_center_id varchar [pk, note: 'Unique identifier for the cost center. Primary key. | Column cost_center_id (BIGINT) in finance.cost_center']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Station cost centers map to licensed facilities for regulatory cost reporting (ownership reports, financial qualifications). Cost center structure typically mirrors license structure in broadcast oper | Column broadcast_license_id (BIGINT) in compliance.cost_center']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Cost centers belong to legal entities in SAP CO organizational structure. The company_code is a business key reference to legal_entity. | Column company_legal_entity_id (BIGINT) in finance.cost_center']
  parent_cost_center_id varchar [note: 'Reference to the parent cost center in the organizational hierarchy, enabling hierarchical cost roll-ups and departmental P&L aggregation. | Column parent_cost_center_id (BIGINT) in finance.cost_center']
  profit_center_id varchar [note: 'Reference to the profit center to which this cost center is assigned for internal management reporting and EBITDA tracking. | Column profit_center_id (BIGINT) in finance.cost_center']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.cost_center']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.cost_center']
  activity_type varchar [note: 'The primary activity type or service provided by this cost center for internal cost allocation purposes (e.g., Studio Hours, Editing Hours, Transmission Hours). | Column activity_type (STRING) in finance.cost_center']
  annual_budget_amount decimal(18,2) [note: 'The total annual budget allocated to this cost center for the current fiscal year, in the cost center\'s currency. | Column annual_budget_amount (DECIMAL(18,2)) in finance.cost_center']
  budget_allocation_reference varchar [note: 'Reference identifier to the annual or periodic budget allocation document for this cost center, used for budget vs. actual variance analysis. | Column budget_allocation_reference (STRING) in finance.cost_center']
  business_area varchar [note: 'The business area or division within Media Broadcasting to which this cost center belongs (e.g., Linear Broadcasting, Streaming Platforms, News Division, Sports Division). | Column business_area (STRING) in finance.cost_center']
  company_code varchar [note: 'The SAP company code representing the legal entity to which this cost center is assigned for financial reporting purposes. | Column company_code (STRING) in finance.cost_center']
  controlling_area varchar [note: 'The SAP Controlling Area code to which this cost center belongs. Controlling area represents the organizational unit for cost accounting. | Column controlling_area (STRING) in finance.cost_center']
  cost_allocation_method varchar [note: 'The method used to allocate costs from this cost center to other cost objects (e.g., direct assignment, activity-based costing, percentage allocation, driver-based). | Column cost_allocation_method (STRING) in finance.cost_center']
  cost_center_category varchar [note: 'Classification of the cost center by cost behavior: direct costs attributable to specific content/programs, indirect costs supporting operations, overhead, or capital expenditure. | Column cost_center_category (STRING) in finance.cost_center']
  cost_center_code varchar [note: 'The business identifier code for the cost center as defined in SAP Controlling (CO) module. Used for financial reporting and budget tracking. | Column cost_center_code (STRING) in finance.cost_center']
  cost_center_description varchar [note: 'Detailed description of the cost center\'s purpose, scope, and responsibilities within the organization. | Column cost_center_description (STRING) in finance.cost_center']
  cost_center_name varchar [note: 'The full descriptive name of the cost center (e.g., \'Digital Platform Operations\', \'News Production Studio A\', \'Ad Sales Northeast Region\'). | Column cost_center_name (STRING) in finance.cost_center']
  cost_center_status varchar [note: 'Current lifecycle status of the cost center indicating whether it is operational and available for cost posting. | Column cost_center_status (STRING) in finance.cost_center']
  cost_center_type varchar [note: 'Classification of the cost center by functional area within the media broadcasting business. [ENUM-REF-CANDIDATE: production|operations|sales|distribution|corporate|technology|content_acquisition — 7 candidates stripped; promote to reference product] | Column cost_center_type (STRING) in finance.cost_center']
  cost_element_group varchar [note: 'The primary cost element group or category that this cost center typically incurs (e.g., Personnel Costs, Production Costs, Technology Costs, Rights & Licensing). | Column cost_element_group (STRING) in finance.cost_center']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.cost_center']
  created_by_user varchar [note: 'The user ID of the person who created this cost center record in the system. | Column created_by_user (STRING) in finance.cost_center']
  created_timestamp timestamp [note: 'The date and time when this cost center record was first created in the system. | Column created_timestamp (TIMESTAMP) in finance.cost_center']
  currency_code varchar [note: 'The three-letter ISO 4217 currency code in which this cost center\'s budget and actual costs are tracked (e.g., USD, GBP, EUR). | Column currency_code (STRING) in finance.cost_center']
  department_code varchar [note: 'The department code within the organizational structure to which this cost center is assigned. | Column department_code (STRING) in finance.cost_center']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  ebitda_reporting_segment varchar [note: 'The EBITDA reporting segment to which this cost center\'s costs are allocated for executive and investor reporting. | Column ebitda_reporting_segment (STRING) in finance.cost_center']
  functional_area varchar [note: 'The functional classification of the cost center for financial statement reporting (e.g., Production, Distribution, Sales & Marketing, General & Administrative). | Column functional_area (STRING) in finance.cost_center']
  hierarchy_node varchar [note: 'The position of this cost center within the organizational cost center hierarchy, used for roll-up reporting and consolidation. | Column hierarchy_node (STRING) in finance.cost_center']
  intercompany_flag boolean [note: 'Indicates whether this cost center participates in intercompany transactions requiring elimination entries during consolidation. | Column intercompany_flag (BOOLEAN) in finance.cost_center']
  is_revenue_generating boolean [note: 'Flag indicating whether this cost center directly generates revenue (e.g., Ad Sales regions) or is purely a cost-incurring unit. | Column is_revenue_generating (BOOLEAN) in finance.cost_center']
  last_modified_by_user varchar [note: 'The user ID of the person who last modified this cost center record in the system. | Column last_modified_by_user (STRING) in finance.cost_center']
  last_modified_timestamp timestamp [note: 'The date and time when this cost center record was last updated in the system. | Column last_modified_timestamp (TIMESTAMP) in finance.cost_center']
  location_code varchar [note: 'The physical location or facility code where this cost center operates (e.g., studio location, broadcast center, regional office). | Column location_code (STRING) in finance.cost_center']
  notes varchar [note: 'Free-text field for additional notes, special instructions, or context about this cost center\'s purpose or operational considerations. | Column notes (STRING) in finance.cost_center']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.cost_center']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.cost_center']
  sox_control_flag boolean [note: 'Indicates whether this cost center is subject to SOX financial controls and requires enhanced audit trail and approval workflows. | Column sox_control_flag (BOOLEAN) in finance.cost_center']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.cost_center']
  valid_from_date date [note: 'The date from which this cost center becomes active and available for cost posting in the financial system. | Column valid_from_date (DATE) in finance.cost_center']
  valid_to_date date [note: 'The date until which this cost center remains active. Null indicates an open-ended validity period. | Column valid_to_date (DATE) in finance.cost_center']

  Note: 'SAP CO-authoritative cost center master data representing organizational units responsible for incurring costs across Media Broadcasting — including production studios, broadcast operations, digital platforms, sales regions, and corporate functions. Tracks cost center code, hierarchy node, responsible manager, controlling area, profit center assignment, currency, validity period, and budget allocation reference. Enables granular cost tracking for EBITDA reporting and departmental P&L. | Unity Catalog table: media_broadcasting_ecm.finance.cost_center SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.profit_center {
  profit_center_id varchar [pk, note: 'Unique system identifier for the profit center record. Primary key. | Column profit_center_id (BIGINT) in finance.profit_center']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Profit centers align with licensed stations for financial and regulatory reporting. License-level EBITDA is required for debt covenants, ownership attribution rules, and FCC financial qualification re | Column broadcast_license_id (BIGINT) in compliance.profit_center']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Profit centers belong to legal entities in SAP CO organizational structure. The company_code is a business key reference to legal_entity. This is essential for P&L consolidation. | Column company_legal_entity_id (BIGINT) in finance.profit_center']
  responsible_manager_employee_id varchar [note: 'The unique employee identifier of the manager responsible for this profit center. Links to HR master data for organizational reporting. | Column responsible_manager_employee_id (BIGINT) in workforce.profit_center']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.profit_center']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.profit_center']
  activation_date date [note: 'The date on which this profit center was activated and began accepting financial postings. Used for historical analysis and lifecycle tracking. | Column activation_date (DATE) in finance.profit_center']
  budget_allocation_method varchar [note: 'The methodology used for allocating budgets to this profit center. Top-down allocates from corporate targets; bottom-up aggregates from operational plans; zero-based requires justification of all expenses; incremental adjusts prior year budgets. | Column budget_allocation_method (STRING) in finance.profit_center']
  business_unit varchar [note: 'The higher-level business unit or division to which this profit center belongs. Used for hierarchical rollup in management reporting. Examples: Digital Media, Broadcast Networks, Content Production. | Column business_unit (STRING) in finance.profit_center']
  closure_date date [note: 'The date on which this profit center was closed and ceased operations. Null for active profit centers. Used for historical reporting and archival. | Column closure_date (DATE) in finance.profit_center']
  company_code varchar [note: 'The company code representing the legal entity to which this profit center belongs. Used for financial statement preparation and legal reporting. | Column company_code (STRING) in finance.profit_center']
  controlling_area_code varchar [note: 'The controlling area to which this profit center is assigned. Controlling area is the organizational unit in SAP CO that represents a closed system for cost accounting purposes. | Column controlling_area_code (STRING) in finance.profit_center']
  cost_center_assignment_flag boolean [note: 'Indicates whether cost centers can be directly assigned to this profit center for cost allocation and internal charging purposes. | Column cost_center_assignment_flag (BOOLEAN) in finance.profit_center']
  country_code varchar [note: 'The primary country of operation for this profit center. Three-letter ISO 3166-1 alpha-3 country code. | Column country_code (STRING) in finance.profit_center']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.profit_center']
  created_timestamp timestamp [note: 'The date and time when this profit center record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in finance.profit_center']
  currency_code varchar [note: 'The functional currency in which this profit center conducts its operations and reports financial results. Three-letter ISO 4217 code. | Column currency_code (STRING) in finance.profit_center']
  ebitda_reporting_flag boolean [note: 'Indicates whether this profit center is included in EBITDA segment reporting for management and investor communications. EBITDA is a key profitability metric in media broadcasting. | Column ebitda_reporting_flag (BOOLEAN) in finance.profit_center']
  geographic_region varchar [note: 'The primary geographic region or market in which this profit center operates. Used for regional performance analysis and geographic segment reporting. Examples: North America, EMEA, APAC, Latin America. | Column geographic_region (STRING) in finance.profit_center']
  hierarchy_node varchar [note: 'The node identifier within the profit center standard hierarchy. Used for multi-level aggregation and drill-down reporting in management accounting. | Column hierarchy_node (STRING) in finance.profit_center']
  intercompany_elimination_flag boolean [note: 'Indicates whether transactions involving this profit center require intercompany elimination adjustments during financial consolidation. Used in multi-entity corporate structures. | Column intercompany_elimination_flag (BOOLEAN) in finance.profit_center']
  last_modified_by_user varchar [note: 'The username or identifier of the user who last modified this profit center record. Used for accountability and audit trail purposes. | Column last_modified_by_user (STRING) in finance.profit_center']
  last_modified_timestamp timestamp [note: 'The date and time when this profit center record was last updated. Used for change tracking and audit compliance. | Column last_modified_timestamp (TIMESTAMP) in finance.profit_center']
  notes varchar [note: 'Free-form notes capturing additional context, special instructions, or historical information about the profit center. Used by finance teams for operational reference. | Column notes (STRING) in finance.profit_center']
  parent_profit_center_code varchar [note: 'The code of the parent profit center in the organizational hierarchy, if this profit center rolls up to another. Enables hierarchical consolidation for segment EBITDA and management reporting. | Column parent_profit_center_code (STRING) in finance.profit_center']
  profit_center_code varchar [note: 'The externally-known unique alphanumeric code identifying the profit center within the controlling area. Used in SAP CO for segment reporting and management accounting. Examples: SVOD-US, LINEAR-UK, ADSALES-NA. | Column profit_center_code (STRING) in finance.profit_center']
  profit_center_description varchar [note: 'Detailed textual description of the profit centers business purpose, scope of operations, and strategic role within the enterprise. Used for documentation and onboarding. | Column profit_center_description (STRING) in finance.profit_center']
  profit_center_name varchar [note: 'The full business name of the profit center. Human-readable label used in financial reports and management dashboards. | Column profit_center_name (STRING) in finance.profit_center']
  profit_center_status varchar [note: 'Current lifecycle status of the profit center. Active profit centers are operational and accept postings; inactive are temporarily suspended; planned are future entities; closed are historical and no longer accept transactions. | Column profit_center_status (STRING) in finance.profit_center']
  profit_center_type varchar [note: 'Classification of the profit center based on its accountability model. Revenue centers are responsible for revenue generation; cost centers for cost control; investment centers for return on invested capital; service centers provide internal services. | Column profit_center_type (STRING) in finance.profit_center']
  revenue_posting_flag boolean [note: 'Indicates whether revenue transactions can be posted directly to this profit center. Used to control which profit centers participate in revenue recognition workflows. | Column revenue_posting_flag (BOOLEAN) in finance.profit_center']
  segment_code varchar [note: 'The segment classification for external segment reporting under IFRS 8 and US GAAP. Segments represent distinguishable components of the business for which discrete financial information is available and regularly reviewed by the chief operating decision maker. Examples: Streaming, Linear Broadcasting, Advertising, Syndication. | Column segment_code (STRING) in finance.profit_center']
  short_name varchar [note: 'Abbreviated name or acronym for the profit center, used in condensed reports and system displays where space is limited. | Column short_name (STRING) in finance.profit_center']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.profit_center']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.profit_center']
  sox_control_scope_flag boolean [note: 'Indicates whether this profit center is within the scope of SOX financial controls and requires enhanced audit trails and segregation of duties for financial postings. | Column sox_control_scope_flag (BOOLEAN) in finance.profit_center']
  transfer_pricing_method varchar [note: 'The method used for pricing internal transactions between this profit center and other organizational units. Examples: cost-plus, market-based, negotiated. Critical for accurate profit center performance measurement. | Column transfer_pricing_method (STRING) in finance.profit_center']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.profit_center']
  valid_from_date date [note: 'The date from which this profit center configuration is effective. Used for time-dependent master data versioning in SAP CO. | Column valid_from_date (DATE) in finance.profit_center']
  valid_to_date date [note: 'The date until which this profit center configuration is effective. Null indicates open-ended validity. Used for time-dependent master data versioning. | Column valid_to_date (DATE) in finance.profit_center']

  Note: 'SAP CO-authoritative profit center master representing autonomous business units within Media Broadcasting that are evaluated on profitability — such as SVOD platform, linear broadcast network, advertising sales division, and syndication unit. Captures profit center code, hierarchy, controlling area, responsible manager, currency, and segment classification. Underpins segment reporting, EBITDA tracking, and management accounting. | Unity Catalog table: media_broadcasting_ecm.finance.profit_center SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.general_ledger {
  general_ledger_id varchar [pk, note: 'Unique identifier for the general ledger record. Primary key for the general ledger data product. | Column general_ledger_id (BIGINT) in finance.general_ledger']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: GL entries reference chart of accounts for account metadata. The gl_account STRING is a business key that should be supplemented with FK to chart_of_accounts.chart_of_accounts_id. The gl_account_descr | Column chart_of_accounts_id (BIGINT) in finance.general_ledger']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: General ledger entries belong to legal entities in SAP S/4HANA FI. The company_code is a business key reference to legal_entity. This is the foundational relationship for financial consolidation. | Column company_legal_entity_id (BIGINT) in finance.general_ledger']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: GL entries can be allocated to cost centers for cost tracking. The cost_center STRING column will be replaced by FK to cost_center.cost_center_id. | Column cost_center_id (BIGINT) in finance.general_ledger']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: GL entries can be allocated to profit centers for P&L tracking. The profit_center STRING column will be replaced by FK to profit_center.profit_center_id. | Column profit_center_id (BIGINT) in finance.general_ledger']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.general_ledger']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.general_ledger']
  account_type varchar [note: 'High-level classification of the general ledger account into one of the five fundamental accounting categories: asset, liability, equity, revenue, or expense. Used for financial statement preparation and trial balance categorization. | Column account_type (STRING) in finance.general_ledger']
  budget_amount_functional_currency decimal(18,2) [note: 'Budgeted amount allocated to the general ledger account for the fiscal period, expressed in functional currency. Used for budget vs. actual variance analysis and financial planning. Particularly relevant for production budgets, content acquisition costs, and operational expense management. | Column budget_amount_functional_currency (DECIMAL(18,2)) in finance.general_ledger']
  business_area varchar [note: 'Four-character code representing the business area or division for cross-company code reporting. Enables consolidated financial statements across multiple legal entities within the same business segment (e.g., linear broadcasting, streaming platforms, syndication). | Column business_area (STRING) in finance.general_ledger']
  closing_balance_functional_currency decimal(18,2) [note: 'Closing balance of the general ledger account at the end of the fiscal period, expressed in functional currency. Calculated as opening balance plus net period activity. Represents the ending position for trial balance and financial statement generation. | Column closing_balance_functional_currency (DECIMAL(18,2)) in finance.general_ledger']
  company_code varchar [note: 'Four-character alphanumeric identifier for the legal entity within the Media Broadcasting enterprise. Represents the organizational unit for which separate financial statements are prepared. Maps to SAP S/4HANA company code structure. | Column company_code (STRING) in finance.general_ledger']
  consolidation_unit varchar [note: 'Consolidation unit code representing the entity for group consolidation and statutory reporting. Used for multi-entity financial consolidation, intercompany eliminations, and corporate-level financial statement preparation. | Column consolidation_unit (STRING) in finance.general_ledger']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.general_ledger']
  credit_amount_functional_currency decimal(18,2) [note: 'Total credit amount posted to the general ledger account for the period, expressed in the functional currency of the company code. Represents increases to liability, equity, and revenue accounts or decreases to asset and expense accounts. | Column credit_amount_functional_currency (DECIMAL(18,2)) in finance.general_ledger']
  credit_amount_transaction_currency decimal(18,2) [note: 'Total credit amount posted to the general ledger account for the period, expressed in the original transaction currency. Maintained for audit trail and foreign exchange reconciliation purposes. | Column credit_amount_transaction_currency (DECIMAL(18,2)) in finance.general_ledger']
  debit_amount_functional_currency decimal(18,2) [note: 'Total debit amount posted to the general ledger account for the period, expressed in the functional currency of the company code. Represents increases to asset and expense accounts or decreases to liability, equity, and revenue accounts. | Column debit_amount_functional_currency (DECIMAL(18,2)) in finance.general_ledger']
  debit_amount_transaction_currency decimal(18,2) [note: 'Total debit amount posted to the general ledger account for the period, expressed in the original transaction currency. Maintained for audit trail and foreign exchange reconciliation purposes. | Column debit_amount_transaction_currency (DECIMAL(18,2)) in finance.general_ledger']
  document_type varchar [note: 'Two-character code representing the type of accounting document that generated the general ledger entry (e.g., SA for G/L account document, DR for customer invoice, KR for vendor invoice, DZ for payment). Used for document classification and posting control. | Column document_type (STRING) in finance.general_ledger']
  ebitda_indicator boolean [note: 'Boolean flag indicating whether the general ledger account is included in EBITDA calculation for management reporting and investor disclosures. True if the account contributes to EBITDA (operating revenues and expenses), false if excluded (interest, taxes, depreciation, amortization). | Column ebitda_indicator (BOOLEAN) in finance.general_ledger']
  fiscal_year varchar [note: 'Four-digit fiscal year for which the general ledger balance is recorded. Represents the accounting period year aligned with the company\'s financial reporting calendar. | Column fiscal_year (INT) in finance.general_ledger']
  functional_area varchar [note: 'Functional area code representing the business function or operational domain (e.g., content production, advertising sales, distribution, subscriber management). Used for cross-organizational reporting and functional cost analysis. | Column functional_area (STRING) in finance.general_ledger']
  functional_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the functional currency of the company code (e.g., USD, GBP, EUR). The functional currency is the primary currency in which the legal entity conducts business and prepares financial statements. | Column functional_currency_code (STRING) in finance.general_ledger']
  gl_account varchar [note: 'General ledger account number from the chart of accounts. Represents the specific account classification (asset, liability, equity, revenue, expense) for financial transactions. Structured according to the enterprise chart of accounts hierarchy. | Column gl_account (STRING) in finance.general_ledger']
  last_posting_date date [note: 'Date of the most recent transaction posted to this general ledger account within the fiscal period. Used for audit trail and period-end reconciliation validation. | Column last_posting_date (DATE) in finance.general_ledger']
  ledger_group varchar [note: 'Ledger group code representing the accounting principle or reporting standard (e.g., 0L for leading ledger, 2L for IFRS, 3L for US GAAP). Enables parallel accounting for multiple reporting frameworks within a single system. | Column ledger_group (STRING) in finance.general_ledger']
  net_balance_functional_currency decimal(18,2) [note: 'Net balance of the general ledger account for the period, calculated as debit amount minus credit amount (or vice versa depending on account type), expressed in the functional currency. Represents the aggregated account state for trial balance and financial statement generation. | Column net_balance_functional_currency (DECIMAL(18,2)) in finance.general_ledger']
  opening_balance_functional_currency decimal(18,2) [note: 'Opening balance of the general ledger account at the beginning of the fiscal period, expressed in functional currency. Represents the carried-forward balance from the previous period for balance sheet accounts. | Column opening_balance_functional_currency (DECIMAL(18,2)) in finance.general_ledger']
  period_lock_status varchar [note: 'Status of the posting period indicating whether the period is open for new postings, closed for regular postings but open for adjustments, or locked for all postings. Used for period-end close control and financial statement finalization. | Column period_lock_status (STRING) in finance.general_ledger']
  posting_key varchar [note: 'Two-digit numeric code that controls the posting behavior and determines whether the entry is a debit or credit (e.g., 40 for debit, 50 for credit). Used for transaction validation and account determination logic. | Column posting_key (STRING) in finance.general_ledger']
  posting_period varchar [note: 'Numeric posting period within the fiscal year (typically 1-12 for monthly periods, with additional special periods 13-16 for year-end adjustments). Represents the accounting period for transaction posting and period-end close. | Column posting_period (INT) in finance.general_ledger']
  reconciliation_account_indicator boolean [note: 'Boolean flag indicating whether the general ledger account is a reconciliation account (subledger control account) that must reconcile with subsidiary ledgers such as accounts receivable, accounts payable, or fixed assets. True if reconciliation account, false otherwise. | Column reconciliation_account_indicator (BOOLEAN) in finance.general_ledger']
  record_created_timestamp timestamp [note: 'Timestamp when the general ledger record was first created in the system. Represents the initial capture time for audit trail and data lineage tracking. | Column record_created_timestamp (TIMESTAMP) in finance.general_ledger']
  record_updated_timestamp timestamp [note: 'Timestamp when the general ledger record was last modified. Represents the most recent change time for audit trail and change tracking. Updated whenever period balances are adjusted or corrected. | Column record_updated_timestamp (TIMESTAMP) in finance.general_ledger']
  revenue_stream_category varchar [note: 'Classification of revenue accounts by primary revenue stream type for Media Broadcasting business. Categories include advertising (linear and digital ad sales), subscription (SVOD/AVOD), carriage fees (MVPD/vMVPD distribution), syndication (content resale), licensing (rights monetization), transactional (TVOD), and other. Used for revenue assurance and segment reporting. [ENUM-REF-CANDIDATE: advertising|subscription|carriage_fees|syndication|licensing|transactional|other — 7 candidates stripped; promote to reference product] | Column revenue_stream_category (STRING) in finance.general_ledger']
  segment varchar [note: 'Segment code for external segment reporting as required by IFRS 8 and US GAAP. Represents reportable business segments for statutory financial reporting and investor disclosures (e.g., content production, advertising, subscription services). | Column segment (STRING) in finance.general_ledger']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.general_ledger']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.general_ledger']
  sox_control_indicator boolean [note: 'Boolean flag indicating whether the general ledger account is subject to Sarbanes-Oxley Act internal control requirements and audit procedures. True if SOX-controlled account requiring enhanced documentation and approval workflows, false otherwise. | Column sox_control_indicator (BOOLEAN) in finance.general_ledger']
  trading_partner varchar [note: 'Trading partner code identifying the intercompany counterparty for intercompany transactions. Used for intercompany eliminations and consolidated financial statement preparation. | Column trading_partner (STRING) in finance.general_ledger']
  transaction_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the original transaction currency if different from functional currency. Used for multi-currency transactions requiring foreign exchange conversion and revaluation. | Column transaction_currency_code (STRING) in finance.general_ledger']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.general_ledger']
  variance_amount_functional_currency decimal(18,2) [note: 'Variance between actual net balance and budgeted amount for the fiscal period, expressed in functional currency. Calculated as actual minus budget. Positive variance indicates over-budget for expense accounts or under-budget for revenue accounts. | Column variance_amount_functional_currency (DECIMAL(18,2)) in finance.general_ledger']

  Note: 'SAP FI general ledger representing period-level account balances and individual line items for all Media Broadcasting legal entities. Each record captures a GL account balance within a company code, fiscal year, and posting period — storing debit/credit totals, functional and transaction currency amounts, document type references, and SOX control indicators. Serves as the authoritative source for trial balance generation, statutory financial statements, and period-end close validation. Distinguished from journal_entry (which holds individual postings) by representing the aggregated account state. | Unity Catalog table: media_broadcasting_ecm.finance.general_ledger Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.journal_entry {
  journal_entry_id varchar [pk, note: 'Unique identifier for the journal entry record. Primary key for the journal entry entity. | Column journal_entry_id (BIGINT) in finance.journal_entry']
  approver_user_employee_id varchar [note: 'The SAP user ID of the individual who approved this journal entry for posting, as required by SOX internal control procedures. Null if no approval was required or entry is still pending approval. | Column approver_user_employee_id (BIGINT) in workforce.journal_entry']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Journal entries belong to legal entities in SAP S/4HANA FI. The company_code is a business key reference to legal_entity. This is essential for financial consolidation and SOX controls. | Column company_legal_entity_id (BIGINT) in finance.journal_entry']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Journal entries in media broadcasting post to cost centers for production cost allocation, departmental expense tracking, and budget monitoring. Enables drill-down from GL to cost center detail for va | Column cost_center_id (BIGINT) in finance.journal_entry']
  maintenance_work_order_id varchar [note: 'Foreign key linking to technology.maintenance_work_order. Business justification: Maintenance costs (labor, parts, vendor services) are journalized from completed work orders. Finance posts work order costs to GL accounts for facility/equipment maintenance expense tracking, cost ce | Column maintenance_work_order_id (BIGINT) in technology.journal_entry']
  primary_journal_employee_id varchar [note: 'The SAP user ID of the individual who posted this journal entry into the system. Used for audit trail and accountability purposes. | Column primary_journal_employee_id (BIGINT) in workforce.journal_entry']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Journal entries for revenue recognition, intercompany eliminations, and P&L postings require profit center assignment for segment reporting and EBITDA calculation. Critical for media broadcasting busi | Column profit_center_id (BIGINT) in finance.journal_entry']
  recurring_entry_template_id varchar [note: 'The identifier of the recurring entry template from which this journal entry was generated. Populated only when recurring_entry_indicator is True. | Column recurring_entry_template_id (BIGINT) in finance.journal_entry']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Journal entries support regulatory filings (ownership change accounting, financial certifications in license applications, spectrum auction payments). Audit trail from filing to supporting GL entries  | Column regulatory_filing_id (BIGINT) in compliance.journal_entry']
  source_document_id varchar [note: 'The unique identifier of the source document in the originating system that generated this journal entry. Used for traceability and reconciliation back to operational systems. | Column source_document_id (BIGINT) in finance.journal_entry']
  sox_control_id varchar [note: 'The identifier of the SOX internal control that governs the posting and approval of this journal entry type. Links the entry to the company\'s SOX compliance framework. | Column sox_control_id (BIGINT) in compliance.journal_entry']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.journal_entry']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.journal_entry']
  accrual_reversal_date date [note: 'The future posting date on which this accrual entry will automatically reverse. Populated only when accrual_reversal_indicator is True. | Column accrual_reversal_date (DATE) in finance.journal_entry']
  accrual_reversal_indicator boolean [note: 'Boolean flag indicating whether this journal entry is an automatic accrual reversal. True if this entry will automatically reverse in the subsequent period. | Column accrual_reversal_indicator (BOOLEAN) in finance.journal_entry']
  adjustment_type varchar [note: 'Classification of the journal entry by its accounting purpose: standard operational posting, period-end accrual, prepayment amortization, account reclassification, intercompany elimination, or error correction. | Column adjustment_type (STRING) in finance.journal_entry']
  approval_timestamp timestamp [note: 'The date and time when the journal entry was approved by the designated approver. Null if no approval was required or entry is still pending approval. | Column approval_timestamp (TIMESTAMP) in finance.journal_entry']
  batch_input_session varchar [note: 'The name of the batch input session if this journal entry was posted via batch processing rather than manual entry. Empty for manually posted entries. | Column batch_input_session (STRING) in finance.journal_entry']
  company_code varchar [note: 'Four-character code identifying the legal entity within the Media Broadcasting enterprise for which this journal entry is posted. Represents the smallest organizational unit for which a complete self-contained set of accounts can be drawn up for purposes of external reporting. | Column company_code (STRING) in finance.journal_entry']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.journal_entry']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the journal entry amounts are denominated (e.g., USD, GBP, EUR). All line items within this document share this currency. | Column currency_code (STRING) in finance.journal_entry']
  document_date date [note: 'The date of the original source document (invoice, receipt, contract) that gave rise to this journal entry. May differ from posting date when entries are posted retrospectively. | Column document_date (DATE) in finance.journal_entry']
  document_header_text varchar [note: 'Descriptive text at the document header level providing context or explanation for the journal entry, such as the business purpose, transaction description, or special instructions. | Column document_header_text (STRING) in finance.journal_entry']
  document_number varchar [note: 'The externally-known SAP document number assigned to this journal entry at posting time. This is the business identifier used across financial reporting and audit trails. | Column document_number (STRING) in finance.journal_entry']
  document_type varchar [note: 'Two-character code classifying the nature of the accounting document (e.g., SA=General Ledger Document, DR=Customer Invoice, KR=Vendor Invoice, DZ=Customer Payment, KZ=Vendor Payment, AB=Accounting Document). Controls the number range and field status for the entry. | Column document_type (STRING) in finance.journal_entry']
  entry_date date [note: 'The calendar date when the journal entry was physically entered into the SAP system by the user, which may differ from both document date and posting date. | Column entry_date (DATE) in finance.journal_entry']
  entry_time timestamp [note: 'The precise date and time when the journal entry was created in the SAP system. Provides audit trail for record creation. | Column entry_time (TIMESTAMP) in finance.journal_entry']
  exchange_rate decimal(15,5) [note: 'The exchange rate applied to convert document currency amounts to local currency amounts at the time of posting. Expressed as local currency per one unit of document currency. | Column exchange_rate (DECIMAL(15,5)) in finance.journal_entry']
  exchange_rate_type varchar [note: 'Single-character code indicating the type of exchange rate used (e.g., M=Average Rate, B=Bank Buying Rate, G=Bank Selling Rate). Determines which rate table is consulted for currency conversion. | Column exchange_rate_type (STRING) in finance.journal_entry']
  fiscal_year varchar [note: 'The fiscal year in which this journal entry is posted, following the company\'s financial calendar. Used for period-end close and annual financial reporting. | Column fiscal_year (INT) in finance.journal_entry']
  intercompany_indicator boolean [note: 'Boolean flag indicating whether this journal entry represents an intercompany transaction between different legal entities within Media Broadcasting. True for intercompany entries requiring elimination in consolidated reporting. | Column intercompany_indicator (BOOLEAN) in finance.journal_entry']
  last_modified_timestamp timestamp [note: 'The date and time when the journal entry record was last modified in the system. Used for change tracking and audit compliance. | Column last_modified_timestamp (TIMESTAMP) in finance.journal_entry']
  ledger_group varchar [note: 'Two-character code identifying the ledger group to which this journal entry belongs. Supports parallel accounting for different accounting principles (e.g., 0L=Leading Ledger, 2L=IFRS Ledger, 3L=Tax Ledger). | Column ledger_group (STRING) in finance.journal_entry']
  local_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the local currency of the company code. Used for parallel accounting and statutory reporting. | Column local_currency_code (STRING) in finance.journal_entry']
  parked_indicator boolean [note: 'Boolean flag indicating whether this journal entry is in parked status (saved but not yet posted). True if parked, False if fully posted. | Column parked_indicator (BOOLEAN) in finance.journal_entry']
  posting_date date [note: 'The date on which the journal entry was posted to the general ledger. This is the accounting date that determines the fiscal period and is used for financial statement reporting. Represents the principal business event timestamp for this transaction. | Column posting_date (DATE) in finance.journal_entry']
  posting_period varchar [note: 'The accounting period (typically 1-12 for monthly periods, with additional special periods 13-16 for year-end adjustments) within the fiscal year when this entry was posted. | Column posting_period (INT) in finance.journal_entry']
  recurring_entry_indicator boolean [note: 'Boolean flag indicating whether this journal entry is part of a recurring entry template (e.g., monthly depreciation, rent accruals). True if generated from a recurring template. | Column recurring_entry_indicator (BOOLEAN) in finance.journal_entry']
  reference_number varchar [note: 'Free-text reference field used to store external document identifiers such as invoice numbers, purchase order numbers, contract references, or other source system identifiers that link this journal entry to originating business transactions. | Column reference_number (STRING) in finance.journal_entry']
  reversal_indicator boolean [note: 'Boolean flag indicating whether this journal entry is a reversal of a previously posted document. True if this entry reverses another entry, False otherwise. | Column reversal_indicator (BOOLEAN) in finance.journal_entry']
  reversal_reason_code varchar [note: 'Two-digit code indicating the business reason for reversing the original document (e.g., 01=Error Correction, 02=Accrual Reversal, 03=Period-End Adjustment). Populated only when reversal_indicator is True. | Column reversal_reason_code (STRING) in finance.journal_entry']
  reversed_document_number varchar [note: 'The document number of the original journal entry that this entry reverses. Populated only when reversal_indicator is True. | Column reversed_document_number (STRING) in finance.journal_entry']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.journal_entry']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.journal_entry']
  source_system_code varchar [note: 'Code identifying the originating system from which this journal entry was interfaced into SAP S/4HANA (e.g., WideOrbit for advertising revenue, Zuora for subscription billing, Rightsline for royalty accruals). Empty for entries created directly in SAP. | Column source_system_code (STRING) in finance.journal_entry']
  trading_partner_company_code varchar [note: 'The company code of the intercompany trading partner for intercompany transactions. Populated only when intercompany_indicator is True. Used for intercompany reconciliation and consolidation eliminations. | Column trading_partner_company_code (STRING) in finance.journal_entry']
  transaction_code varchar [note: 'The SAP transaction code (T-Code) used to post this journal entry (e.g., FB01, FB50, F-02). Indicates the posting interface and provides context for the entry method. | Column transaction_code (STRING) in finance.journal_entry']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.journal_entry']
  workflow_status varchar [note: 'Current status of the journal entry within the SOX-compliant approval workflow. Tracks the document through draft, approval, posting, and potential reversal stages. | Column workflow_status (STRING) in finance.journal_entry']

  Note: 'Individual accounting document posted to the SAP S/4HANA general ledger capturing all financial transactions across Media Broadcasting — including revenue recognition postings, accruals, prepayments, intercompany charges, and period-end adjustments. Records document number, company code, posting date, document date, document type, reference, reversal indicator, posting user, and SOX approval workflow status. The atomic unit of financial record-keeping. | Unity Catalog table: media_broadcasting_ecm.finance.journal_entry Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.production_budget {
  production_budget_id varchar [pk, note: 'Primary key for production_budget | Column production_budget_id (BIGINT) in finance.production_budget']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Production budgets track facility usage costs for content creation. Productions book broadcast facilities (studios, control rooms) and production accounting allocates facility rental/usage charges to  | Column broadcast_facility_id (BIGINT) in technology.production_budget']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Production budgets are allocated to cost centers for expense tracking. The cost_center_code STRING column will be replaced by FK to cost_center.cost_center_id. | Column cost_center_id (BIGINT) in finance.production_budget']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Production budgets include line items for music licensing, archive footage licensing, and rights acquisitions governed by license agreements. Required for production cost tracking, budget variance ana | Column license_agreement_id (BIGINT) in rights.production_budget']
  production_project_id varchar [note: 'Reference to the production project (scripted series, film, live event, news programming, digital original) for which this budget is allocated. | Column production_project_id (BIGINT) in production.production_budget']
  studio_facility_id varchar [note: 'Foreign key linking to technology.studio_facility. Business justification: Production budgets specifically track studio bookings and usage costs. Studios are booked per production project with hourly/daily rates charged to project budgets. Finance requires studio identificat | Column studio_facility_id (BIGINT) in technology.production_budget']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.production_budget']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.production_budget']
  above_the_line_amount decimal(18,2) [note: 'Budget allocated to above-the-line costs including key creative talent (writers, directors, producers, lead actors). These are typically negotiated individually and represent significant budget items. | Column above_the_line_amount (DECIMAL(18,2)) in finance.production_budget']
  actual_spend_to_date decimal(18,2) [note: 'Cumulative actual expenditure against this budget as of the last financial update. Used for variance tracking and budget performance monitoring. | Column actual_spend_to_date (DECIMAL(18,2)) in finance.production_budget']
  approval_date date [note: 'The date on which this production budget was formally approved for spending. | Column approval_date (DATE) in finance.production_budget']
  approved_by varchar [note: 'Name or identifier of the executive or financial authority who approved this production budget. | Column approved_by (STRING) in finance.production_budget']
  below_the_line_amount decimal(18,2) [note: 'Budget allocated to below-the-line costs including crew, equipment, facilities, and production support. These are standard production costs not tied to key creative talent. | Column below_the_line_amount (DECIMAL(18,2)) in finance.production_budget']
  budget_effective_date date [note: 'The date from which this budget version becomes effective and spending authorization begins. | Column budget_effective_date (DATE) in finance.production_budget']
  budget_expiry_date date [note: 'The date on which this budget version expires or is superseded by a new version. Null for open-ended budgets. | Column budget_expiry_date (DATE) in finance.production_budget']
  budget_notes varchar [note: 'Free-text notes and comments regarding this budget version, including justification for revisions, special conditions, or approval stipulations. | Column budget_notes (STRING) in finance.production_budget']
  budget_number varchar [note: 'Externally-known unique identifier for the production budget, used for tracking and reference in financial systems and production workflows. | Column budget_number (STRING) in finance.production_budget']
  budget_status varchar [note: 'Current lifecycle status of the production budget. Tracks progression from draft through approval to active spending and final closure. [ENUM-REF-CANDIDATE: draft|submitted|approved|active|revised|closed|cancelled — 7 candidates stripped; promote to reference product] | Column budget_status (STRING) in finance.production_budget']
  budget_type varchar [note: 'Classification of the production budget by content type. Different content types have different cost structures and budget approval workflows. [ENUM-REF-CANDIDATE: scripted_series|film|live_event|news_programming|digital_original|documentary|sports|reality|animation — 9 candidates stripped; promote to reference product] | Column budget_type (STRING) in finance.production_budget']
  budget_version varchar [note: 'Version number of the budget. Budgets are revised throughout the production lifecycle; this field tracks the iteration (e.g., 1 for initial, 2 for first revision). | Column budget_version (STRING) in finance.production_budget']
  committed_amount decimal(18,2) [note: 'Amount committed through purchase orders and contracts but not yet invoiced or paid. Used for funds reservation and budget availability calculation. | Column committed_amount (DECIMAL(18,2)) in finance.production_budget']
  contingency_amount decimal(18,2) [note: 'Contingency reserve allocated for unforeseen production costs and budget overruns. Typically 5-10% of total budget. | Column contingency_amount (DECIMAL(18,2)) in finance.production_budget']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.production_budget']
  created_timestamp timestamp [note: 'Timestamp when this production budget record was first created in the system. | Column created_timestamp (TIMESTAMP) in finance.production_budget']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this budget record (e.g., USD, GBP, EUR). | Column currency_code (STRING) in finance.production_budget']
  facilities_amount decimal(18,2) [note: 'Budget allocated to production facilities including studio rental, location fees, set construction, and production office space. | Column facilities_amount (DECIMAL(18,2)) in finance.production_budget']
  fiscal_year varchar [note: 'The fiscal year to which this production budget is allocated. Used for annual financial planning and reporting. | Column fiscal_year (STRING) in finance.production_budget']
  internal_order_number varchar [note: 'SAP CO internal order number used for production cost control and tracking actual expenditures against this budget. | Column internal_order_number (STRING) in finance.production_budget']
  last_modified_timestamp timestamp [note: 'Timestamp when this production budget record was last updated. Used for change tracking and audit trail. | Column last_modified_timestamp (TIMESTAMP) in finance.production_budget']
  music_licensing_amount decimal(18,2) [note: 'Budget allocated to music licensing, original score composition, and music rights clearance for the production. | Column music_licensing_amount (DECIMAL(18,2)) in finance.production_budget']
  post_production_amount decimal(18,2) [note: 'Budget allocated to post-production activities including editing, color correction, sound design, mixing, and final mastering. | Column post_production_amount (DECIMAL(18,2)) in finance.production_budget']
  production_end_date date [note: 'Planned or actual end date of production for this project. Used for budget closure and final cost reconciliation. | Column production_end_date (DATE) in finance.production_budget']
  production_start_date date [note: 'Planned or actual start date of production for this project. Used for budget phasing and cash flow planning. | Column production_start_date (DATE) in finance.production_budget']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.production_budget']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.production_budget']
  sox_control_flag boolean [note: 'Indicates whether this budget is subject to SOX financial controls and audit requirements. True for budgets above materiality thresholds. | Column sox_control_flag (BOOLEAN) in finance.production_budget']
  total_approved_amount decimal(18,2) [note: 'Total approved budget amount for the production project across all cost categories. This is the authorized spending limit. | Column total_approved_amount (DECIMAL(18,2)) in finance.production_budget']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.production_budget']
  variance_amount decimal(18,2) [note: 'Calculated variance between approved budget and actual spend (approved amount minus actual spend). Positive values indicate under-budget, negative values indicate over-budget. | Column variance_amount (DECIMAL(18,2)) in finance.production_budget']
  variance_percentage decimal(5,2) [note: 'Variance expressed as a percentage of the approved budget. Used for budget performance dashboards and exception reporting. | Column variance_percentage (DECIMAL(5,2)) in finance.production_budget']
  vfx_amount decimal(18,2) [note: 'Budget allocated to visual effects production. VFX is often a significant cost category for scripted series, films, and high-production-value content. | Column vfx_amount (DECIMAL(18,2)) in finance.production_budget']

  Note: 'Financial budget allocated to individual content production projects — covering scripted series, films, live events, news programming, and digital originals. Tracks approved budget amount by cost category (above-the-line talent, below-the-line crew, facilities, post-production, VFX, music licensing), budget version, fiscal year, production project reference, cost center, currency, approval status, and variance-to-actual tracking. Integrates with SAP CO internal orders for production cost control. | Unity Catalog table: media_broadcasting_ecm.finance.production_budget SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.budget_version {
  budget_version_id varchar [pk, note: 'Unique identifier for the budget version record. Primary key. | Column budget_version_id (BIGINT) in finance.budget_version']
  approver_employee_id varchar [note: 'The employee identifier of the approver in the HR system. Links to the employee master data for audit and authorization verification. | Column approver_employee_id (BIGINT) in workforce.budget_version']
  budget_employee_id varchar [note: 'The user identifier of the person who last modified this budget version record. Links to the user management system for accountability and audit purposes. | Column employee_id (BIGINT) in workforce.budget_version']
  budget_id varchar [note: 'Reference to the parent budget entity that this version belongs to. Links to the master budget record. | Column budget_id (BIGINT) in production.budget_version']
  cost_center_id varchar [note: 'Reference to the cost center for which this budget version applies. Used for departmental and operational expense tracking. | Column cost_center_id (BIGINT) in finance.budget_version']
  production_project_id varchar [note: 'Reference to the production project for which this budget version applies. Used for content production budget tracking and cost management. | Column production_project_id (BIGINT) in production.budget_version']
  profit_center_id varchar [note: 'Reference to the profit center for which this budget version applies. Used for revenue and profitability analysis by business unit or channel. | Column profit_center_id (BIGINT) in finance.budget_version']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.budget_version']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.budget_version']
  approval_date date [note: 'The date on which this budget version was formally approved by the authorized approver. Used for audit trail and compliance tracking. | Column approval_date (DATE) in finance.budget_version']
  approver_name varchar [note: 'The full name of the individual who approved this budget version. Typically a finance director, CFO, or department head with budget authority. | Column approver_name (STRING) in finance.budget_version']
  baseline_amount decimal(18,2) [note: 'The original baseline budget amount before any revisions or adjustments. Used as a reference point for variance analysis and tracking budget changes over time. | Column baseline_amount (DECIMAL(18,2)) in finance.budget_version']
  budget_category varchar [note: 'High-level classification of the budget type. Operating expense (OPEX) covers day-to-day costs; capital expenditure (CAPEX) covers long-term investments; production cost tracks content creation spend; revenue target sets income goals; headcount manages personnel costs; marketing covers promotional spend; content acquisition tracks licensing and rights purchases. [ENUM-REF-CANDIDATE: operating_expense|capital_expenditure|production_cost|revenue_target|headcount|marketing|content_acquisition — 7 candidates stripped; promote to reference product] | Column budget_category (STRING) in finance.budget_version']
  budget_version_status varchar [note: 'Current lifecycle status of the budget version. Draft indicates work in progress; pending approval is awaiting authorization; approved is authorized but not yet active; active is currently in effect; superseded has been replaced by a newer version; closed is finalized and archived. | Column budget_version_status (STRING) in finance.budget_version']
  change_rationale varchar [note: 'Detailed explanation of why this budget version was created. Captures the business justification for revisions, reforecasts, or supplemental allocations. Critical for variance analysis and audit compliance. | Column change_rationale (STRING) in finance.budget_version']
  consolidation_level varchar [note: 'Indicates the organizational level at which this budget version is consolidated. Entity is the highest corporate level; division represents major business units; department is operational units; project is specific initiatives; consolidated represents fully aggregated enterprise-wide budgets. | Column consolidation_level (STRING) in finance.budget_version']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.budget_version']
  created_timestamp timestamp [note: 'The date and time when this budget version record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in finance.budget_version']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the budget amount (e.g., USD, EUR, GBP). Ensures accurate multi-currency budget tracking and consolidation. | Column currency_code (STRING) in finance.budget_version']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_end_date date [note: 'The date on which this budget version ceases to be effective. Nullable for open-ended budgets. Used to manage budget version lifecycles and historical tracking. | Column effective_end_date (DATE) in finance.budget_version']
  effective_start_date date [note: 'The date from which this budget version becomes effective and active for budget control and variance reporting. | Column effective_start_date (DATE) in finance.budget_version']
  external_reference_code varchar [note: 'An external identifier or reference number from the source system or external budgeting tool. Used for cross-system reconciliation and traceability. | Column external_reference_code (STRING) in finance.budget_version']
  fiscal_year varchar [note: 'The fiscal year to which this budget version applies. Typically a four-digit year (e.g., 2024). | Column fiscal_year (INT) in finance.budget_version']
  is_locked boolean [note: 'Indicates whether this budget version is locked from further edits. True means the version is frozen and cannot be modified; false means it is still editable. Used to enforce budget control and prevent unauthorized changes after approval. | Column is_locked (BOOLEAN) in finance.budget_version']
  last_modified_timestamp timestamp [note: 'The date and time when this budget version record was last updated. Tracks the most recent change for audit and version control purposes. | Column last_modified_timestamp (TIMESTAMP) in finance.budget_version']
  notes varchar [note: 'Free-text field for additional comments, assumptions, or context related to this budget version. Used by finance teams to document planning assumptions, constraints, or special considerations. | Column notes (STRING) in finance.budget_version']
  planning_period varchar [note: 'The planning period granularity for this budget version. Supports quarterly (Q1-Q4), monthly (M01-M12), half-yearly (H1-H2), or full fiscal year (FY) planning cycles. | Column planning_period (STRING) in finance.budget_version']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.budget_version']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.budget_version']
  total_approved_amount decimal(18,2) [note: 'The total monetary amount approved for this budget version. Represents the authorized spending limit or revenue target for the specified cost center, profit center, or production project. | Column total_approved_amount (DECIMAL(18,2)) in finance.budget_version']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.budget_version']
  variance_threshold_percentage decimal(5,2) [note: 'The acceptable variance percentage threshold for this budget version. Triggers alerts or approval workflows when actual spend deviates from budget by more than this percentage. Typically set between 5% and 15%. | Column variance_threshold_percentage (DECIMAL(5,2)) in finance.budget_version']
  version_number varchar [note: 'Sequential version number for this budget iteration. Increments with each revision or reforecast. Version 1 is typically the original approved budget. | Column version_number (INT) in finance.budget_version']
  version_type varchar [note: 'Classification of the budget version indicating its purpose and lifecycle stage. Original is the initial approved budget; revised reflects approved changes; forecast is a projection; actuals represent actual spend; rolling forecast is a continuous forward-looking estimate; supplemental is an additional allocation. | Column version_type (STRING) in finance.budget_version']

  Note: 'Versioned snapshot of an approved financial budget for a cost center, profit center, or production project within Media Broadcasting. Captures version number, version type (original, revised, forecast, actuals), fiscal year, planning period, total approved amount, currency, approval date, approver, and change rationale. Enables budget vs. actuals variance analysis and rolling forecast management across the enterprise. | Unity Catalog table: media_broadcasting_ecm.finance.budget_version SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.revenue_stream {
  revenue_stream_id varchar [pk, note: 'Unique identifier for the revenue stream. Primary key for this entity. | Column revenue_stream_id (BIGINT) in finance.revenue_stream']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Revenue streams map to GL accounts for revenue posting. The gl_account_code STRING is a business key that should be supplemented with FK to chart_of_accounts.chart_of_accounts_id. | Column chart_of_accounts_id (BIGINT) in finance.revenue_stream']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Revenue streams can be associated with cost centers for revenue tracking. The cost_center_code STRING is a business key that should be supplemented with FK to cost_center.cost_center_id. | Column cost_center_id (BIGINT) in finance.revenue_stream']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Revenue streams are associated with profit centers for P&L attribution. The profit_center_code STRING is a business key that should be supplemented with FK to profit_center.profit_center_id. | Column profit_center_id (BIGINT) in finance.revenue_stream']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.revenue_stream']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.revenue_stream']
  accounting_standard varchar [note: 'The accounting standard governing revenue recognition for this stream (ASC 606 for US GAAP, IFRS 15 for international, or local GAAP variants). | Column accounting_standard (STRING) in finance.revenue_stream']
  audience_measurement_source varchar [note: 'Primary audience measurement provider used for revenue validation and guarantees (e.g., Nielsen, Comscore, Adobe Analytics). Critical for advertising revenue streams with audience guarantees. | Column audience_measurement_source (STRING) in finance.revenue_stream']
  audit_trail_required boolean [note: 'Indicates whether detailed audit trail and supporting documentation must be maintained for all transactions in this revenue stream (True for high-risk or regulated streams). | Column audit_trail_required (BOOLEAN) in finance.revenue_stream']
  business_unit varchar [note: 'Business unit or division responsible for generating this revenue stream (e.g., Broadcast Networks, Digital Platforms, Studios). | Column business_unit (STRING) in finance.revenue_stream']
  commission_rate_percent decimal(5,2) [note: 'Standard commission rate percentage paid to sales representatives or agencies for revenue generated through this stream. | Column commission_rate_percent (DECIMAL(5,2)) in finance.revenue_stream']
  content_type varchar [note: 'Type of content delivery associated with this revenue stream: live, on-demand, linear (scheduled), non-linear, simulcast, catch-up, or archive. [ENUM-REF-CANDIDATE: live|on_demand|linear|non_linear|simulcast|catch_up|archive — 7 candidates stripped; promote to reference product] | Column content_type (STRING) in finance.revenue_stream']
  contract_type varchar [note: 'Type of contractual arrangement governing this revenue stream: upfront (advance commitment), scatter (spot market), guaranteed delivery, non-guaranteed, fixed fee, variable fee, or hybrid. [ENUM-REF-CANDIDATE: upfront|scatter|guaranteed|non_guaranteed|fixed_fee|variable_fee|hybrid — 7 candidates stripped; promote to reference product] | Column contract_type (STRING) in finance.revenue_stream']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.revenue_stream']
  created_timestamp timestamp [note: 'Timestamp when this revenue stream record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in finance.revenue_stream']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for revenue transactions in this stream (e.g., USD, GBP, EUR). | Column currency_code (STRING) in finance.revenue_stream']
  effective_end_date date [note: 'Date when this revenue stream classification ceased to be effective. Null for currently active streams. Used for historical analysis and sunset planning. | Column effective_end_date (DATE) in finance.revenue_stream']
  effective_start_date date [note: 'Date when this revenue stream classification became effective and began generating revenue. Used for historical revenue analysis and period-over-period comparisons. | Column effective_start_date (DATE) in finance.revenue_stream']
  gl_account_code varchar [note: 'General ledger account code in the chart of accounts where revenue from this stream is posted. | Column gl_account_code (STRING) in finance.revenue_stream']
  is_deferred boolean [note: 'Indicates whether revenue from this stream is initially recorded as deferred revenue and recognized over time (True for advance payments, subscriptions; False for immediate recognition). | Column is_deferred (BOOLEAN) in finance.revenue_stream']
  is_recurring boolean [note: 'Indicates whether this revenue stream generates recurring revenue (True for subscriptions, carriage fees; False for one-time transactions, spot advertising). | Column is_recurring (BOOLEAN) in finance.revenue_stream']
  makegoods_policy varchar [note: 'Policy for providing makegoods (compensatory ad spots) when delivery guarantees are not met: automatic, negotiated, none, audience-based, or technical failure only. | Column makegoods_policy (STRING) in finance.revenue_stream']
  modified_by varchar [note: 'User ID or name of the person who last modified this revenue stream record. Used for audit trail and accountability. | Column modified_by (STRING) in finance.revenue_stream']
  modified_timestamp timestamp [note: 'Timestamp when this revenue stream record was last modified. Used for audit trail and change tracking. | Column modified_timestamp (TIMESTAMP) in finance.revenue_stream']
  notes varchar [note: 'Free-text field for additional business context, special handling instructions, or historical notes about this revenue stream classification. | Column notes (STRING) in finance.revenue_stream']
  payment_terms_days varchar [note: 'Standard payment terms in days for this revenue stream (e.g., Net 30, Net 60). Used for accounts receivable aging and cash flow forecasting. | Column payment_terms_days (INT) in finance.revenue_stream']
  performance_obligation varchar [note: 'Description of the performance obligation that must be satisfied for revenue recognition per ASC 606 / IFRS 15 (e.g., delivery of ad impressions, provision of streaming access, content licensing rights transfer). | Column performance_obligation (STRING) in finance.revenue_stream']
  platform_type varchar [note: 'Distribution platform type for this revenue stream: linear broadcast, OTT (Over-The-Top), MVPD (Multichannel Video Programming Distributor), vMVPD (Virtual MVPD), FAST (Free Ad-Supported Streaming TV), VOD, theatrical, syndication, or digital. [ENUM-REF-CANDIDATE: linear|OTT|MVPD|vMVPD|FAST|VOD|theatrical|syndication|digital — 9 candidates stripped; promote to reference product] | Column platform_type (STRING) in finance.revenue_stream']
  pricing_model varchar [note: 'Pricing structure for this revenue stream: CPM (Cost Per Mille for advertising), flat rate, tiered pricing, usage-based, revenue share, or hybrid model. | Column pricing_model (STRING) in finance.revenue_stream']
  recognition_method varchar [note: 'Method by which revenue is recognized per accounting standards: point in time (transactional), over time (subscription), usage-based (consumption), or milestone-based (licensing). | Column recognition_method (STRING) in finance.revenue_stream']
  reporting_segment varchar [note: 'Corporate reporting segment for external financial reporting (e.g., Linear Broadcasting, Streaming Services, Content Licensing). Used for segment disclosure per ASC 280 / IFRS 8. | Column reporting_segment (STRING) in finance.revenue_stream']
  revenue_category varchar [note: 'High-level classification of revenue type: advertising (upfront, scatter, DAI), subscription (SVOD, AVOD, TVOD), carriage fees, syndication, content licensing, ancillary, or transactional. [ENUM-REF-CANDIDATE: advertising|subscription|carriage|syndication|licensing|ancillary|transactional — 7 candidates stripped; promote to reference product] | Column revenue_category (STRING) in finance.revenue_stream']
  revenue_stream_status varchar [note: 'Current lifecycle status of the revenue stream: active (currently generating revenue), inactive (not in use), suspended (temporarily halted), pending approval (awaiting finance approval), or deprecated (phased out). | Column revenue_stream_status (STRING) in finance.revenue_stream']
  revenue_subcategory varchar [note: 'Detailed sub-classification within the revenue category (e.g., Upfront, Scatter, Programmatic for advertising; SVOD, AVOD, TVOD for subscription; Linear Carriage, OTT Carriage for carriage fees). | Column revenue_subcategory (STRING) in finance.revenue_stream']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.revenue_stream']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.revenue_stream']
  sox_control_flag boolean [note: 'Indicates whether this revenue stream is subject to SOX internal controls and requires additional audit documentation (True for material revenue streams, False for immaterial). | Column sox_control_flag (BOOLEAN) in finance.revenue_stream']
  stream_code varchar [note: 'Business identifier code for the revenue stream (e.g., ADV-UPFRONT, SVOD-PREM, CARRIAGE-FEE). Used across financial systems and reporting. | Column stream_code (STRING) in finance.revenue_stream']
  stream_name varchar [note: 'Full descriptive name of the revenue stream (e.g., Upfront Advertising Sales, Premium SVOD Subscription, Syndication License Fees). | Column stream_name (STRING) in finance.revenue_stream']
  tax_jurisdiction varchar [note: 'Primary tax jurisdiction for this revenue stream using ISO 3166-1 alpha-2 or alpha-3 country codes (e.g., USA, GBR, DEU). | Column tax_jurisdiction (STRING) in finance.revenue_stream']
  tax_treatment varchar [note: 'Tax treatment classification for this revenue stream: taxable (subject to VAT/GST/sales tax), exempt, zero-rated, or out of scope. | Column tax_treatment (STRING) in finance.revenue_stream']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.revenue_stream']
  created_by varchar [note: 'User ID or name of the person who created this revenue stream record. Used for audit trail and accountability. | Column created_by (STRING) in finance.revenue_stream']

  Note: 'Master classification of all revenue-generating streams across Media Broadcasting — advertising (upfront, scatter, DAI), subscription (SVOD, AVOD, TVOD), carriage fees, syndication license fees, content licensing, and ancillary revenues. Defines stream code, stream name, revenue category, recognition method (ASC 606 / IFRS 15), associated profit center, tax treatment, and reporting segment. Serves as the authoritative revenue taxonomy for financial reconciliation and EBITDA reporting. | Unity Catalog table: media_broadcasting_ecm.finance.revenue_stream SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
}

Table finance.revenue_recognition_event {
  revenue_recognition_event_id varchar [pk, note: 'Unique identifier for the revenue recognition event. Primary key for this transactional record of revenue posting in SAP S/4HANA. | Column revenue_recognition_event_id (BIGINT) in finance.revenue_recognition_event']
  ad_sales_order_id varchar [note: 'Reference to the originating sales order (from Wide Orbit for ad sales, or Salesforce Media Cloud for direct sales) that triggered this revenue recognition event. | Column sales_order_id (BIGINT) in sales.revenue_recognition_event']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Revenue recognition events post to GL accounts. The gl_account_code STRING is a business key that should be supplemented with FK to chart_of_accounts.chart_of_accounts_id. | Column chart_of_accounts_id (BIGINT) in finance.revenue_recognition_event']
  company_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Revenue recognition events belong to legal entities for financial reporting. The company_code is a business key reference to legal_entity. | Column company_legal_entity_id (BIGINT) in finance.revenue_recognition_event']
  content_title_id varchar [note: 'Reference to the content title (series, episode, film, program) associated with this revenue recognition event. Enables revenue attribution by content asset for rights and royalties management. | Column content_title_id (BIGINT) in content.revenue_recognition_event']
  contract_id varchar [note: 'Reference to the underlying contract or agreement that governs this revenue recognition event. Links to the master contract entity. | Column contract_id (BIGINT) in talent.revenue_recognition_event']
  coppa_declaration_id varchar [note: 'Foreign key linking to compliance.coppa_declaration. Business justification: COPPA-directed content has restricted advertising revenue (no behavioral targeting, limited data collection). Revenue recognition must account for lower CPMs and consent-gated monetization. Finance ne | Column coppa_declaration_id (BIGINT) in compliance.revenue_recognition_event']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Revenue can be allocated to cost centers for revenue tracking. The cost_center_code STRING column will be replaced by FK to cost_center.cost_center_id. | Column cost_center_id (BIGINT) in finance.revenue_recognition_event']
  employee_id varchar [note: 'SAP S/4HANA user ID of the person or system account that posted this revenue recognition event. Required for SOX segregation of duties controls and audit trails. | Column employee_id (BIGINT) in workforce.revenue_recognition_event']
  invoice_id varchar [note: 'Reference to the invoice issued to the customer for this revenue. Links revenue recognition to accounts receivable and cash collection for revenue assurance. | Column invoice_id (BIGINT) in billing.revenue_recognition_event']
  original_recognition_event_revenue_recognition_event_id varchar [note: 'Reference to the original revenue recognition event ID if this record represents a reversal or adjustment. Enables full audit trail of revenue corrections. | Column original_recognition_event_revenue_recognition_event_id (BIGINT) in finance.revenue_recognition_event']
  performance_obligation_id varchar [note: 'Reference to the specific performance obligation within the contract that this revenue recognition event satisfies. Critical for ASC 606 / IFRS 15 compliance. | Column performance_obligation_id (BIGINT) in partner.revenue_recognition_event']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Revenue is allocated to profit centers for P&L tracking and EBITDA reporting. The profit_center_code STRING column will be replaced by FK to profit_center.profit_center_id. | Column profit_center_id (BIGINT) in finance.revenue_recognition_event']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Revenue recognition events are classified by revenue stream (advertising, subscription, carriage fees, syndication). The revenue_stream_type STRING column will be replaced by FK to revenue_stream.reve | Column revenue_stream_id (BIGINT) in finance.revenue_recognition_event']
  subscriber_id varchar [note: 'Reference to the customer (advertiser, subscriber, distributor, licensee) who is the counterparty to the revenue-generating contract. Links to the master customer entity. | Column subscriber_id (BIGINT) in subscriber.revenue_recognition_event']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in finance.revenue_recognition_event']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in finance.revenue_recognition_event']
  accounting_document_number varchar [note: 'The SAP S/4HANA accounting document number (FI document) that records this revenue recognition event. Provides full audit trail and drill-back capability to source transactions. | Column accounting_document_number (STRING) in finance.revenue_recognition_event']
  asc_606_compliant_flag boolean [note: 'Boolean indicator (True/False) confirming that this revenue recognition event was processed in accordance with ASC 606 (US GAAP) revenue recognition standards. | Column asc_606_compliant_flag (BOOLEAN) in finance.revenue_recognition_event']
  company_code varchar [note: 'SAP S/4HANA company code representing the legal entity or business unit that recognized this revenue. Used for intercompany eliminations and consolidated financial reporting. | Column company_code (STRING) in finance.revenue_recognition_event']
  contract_modification_flag boolean [note: 'Boolean indicator (True/False) denoting whether this revenue recognition event resulted from a contract modification. ASC 606 requires specific accounting treatment for modified contracts. | Column contract_modification_flag (BOOLEAN) in finance.revenue_recognition_event']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.revenue_recognition_event']
  created_timestamp timestamp [note: 'Timestamp when this revenue recognition event record was first created in the system. Critical for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in finance.revenue_recognition_event']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the recognized and deferred amounts (e.g., USD, GBP, EUR). Critical for multi-currency financial consolidation. | Column currency_code (STRING) in finance.revenue_recognition_event']
  deferred_amount decimal(18,2) [note: 'The monetary amount of revenue deferred (not yet recognized) as of this event. Represents unearned revenue that will be recognized in future periods as performance obligations are satisfied. | Column deferred_amount (DECIMAL(18,2)) in finance.revenue_recognition_event']
  fiscal_period varchar [note: 'The fiscal period (month or quarter) within the fiscal year in which this revenue recognition event was posted. Critical for monthly financial reporting and revenue trending. | Column fiscal_period (INT) in finance.revenue_recognition_event']
  fiscal_year varchar [note: 'The fiscal year in which this revenue recognition event was posted. Used for period-end close, annual financial statements, and year-over-year revenue analysis. | Column fiscal_year (INT) in finance.revenue_recognition_event']
  gl_account_code varchar [note: 'The general ledger account code in SAP S/4HANA chart of accounts to which this revenue recognition event was posted. Enables financial statement mapping and SOX-compliant audit trails. | Column gl_account_code (STRING) in finance.revenue_recognition_event']
  ifrs_15_compliant_flag boolean [note: 'Boolean indicator (True/False) confirming that this revenue recognition event was processed in accordance with IFRS 15 (International Financial Reporting Standards) revenue recognition standards. | Column ifrs_15_compliant_flag (BOOLEAN) in finance.revenue_recognition_event']
  last_modified_timestamp timestamp [note: 'Timestamp when this revenue recognition event record was last modified. Tracks changes for SOX compliance and financial audit requirements. | Column last_modified_timestamp (TIMESTAMP) in finance.revenue_recognition_event']
  notes varchar [note: 'Free-text notes providing additional context or explanation for this revenue recognition event. Used for audit documentation, special accounting treatments, or manual adjustments. | Column notes (STRING) in finance.revenue_recognition_event']
  platform_type varchar [note: 'The distribution platform or channel through which the revenue was generated: linear (traditional broadcast), OTT (over-the-top streaming), VOD (video on demand), SVOD (subscription VOD), AVOD (ad-supported VOD), TVOD (transactional VOD), FAST (free ad-supported streaming TV), MVPD (multichannel video programming distributor), vMVPD (virtual MVPD), or syndication (content resale). [ENUM-REF-CANDIDATE: linear|ott|vod|svod|avod|tvod|fast|mvpd|vmvpd|syndication — 10 candidates stripped; promote to reference product] | Column platform_type (STRING) in finance.revenue_recognition_event']
  recognition_date date [note: 'The accounting date on which this revenue was recognized in the general ledger. This is the principal business event timestamp for financial reporting and period-end close. | Column recognition_date (DATE) in finance.revenue_recognition_event']
  recognition_method varchar [note: 'The revenue recognition method applied: point_in_time (recognized at a single moment, e.g., ad spot delivery), over_time (recognized ratably over contract term, e.g., subscription), milestone (recognized upon achievement of contractual milestones), or percentage_of_completion (recognized based on progress toward completion). | Column recognition_method (STRING) in finance.revenue_recognition_event']
  recognition_status varchar [note: 'Current lifecycle status of this revenue recognition event: recognized (fully posted to GL), deferred (not yet earned), partially_recognized (over-time recognition in progress), reversed (corrected or cancelled), or adjusted (modified post-recognition). | Column recognition_status (STRING) in finance.revenue_recognition_event']
  recognized_amount decimal(18,2) [note: 'The monetary amount of revenue recognized in this event and posted to the general ledger. Represents the earned portion of the transaction price allocated to the performance obligation. | Column recognized_amount (DECIMAL(18,2)) in finance.revenue_recognition_event']
  revenue_assurance_status varchar [note: 'Status of revenue assurance validation for this recognition event: verified (passed all controls), pending_verification (awaiting reconciliation), discrepancy_identified (variance detected), or reconciled (discrepancy resolved). | Column revenue_assurance_status (STRING) in finance.revenue_recognition_event']
  reversal_reason_code varchar [note: 'Code indicating the reason for revenue reversal or adjustment if recognition_status is \'reversed\' or \'adjusted\'. Examples: contract cancellation, pricing correction, performance obligation not met, billing error. | Column reversal_reason_code (STRING) in finance.revenue_recognition_event']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in finance.revenue_recognition_event']
  source_reference_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in finance.revenue_recognition_event']
  sox_control_flag boolean [note: 'Boolean indicator (True/False) denoting whether this revenue recognition event is subject to Sarbanes-Oxley (SOX) internal control testing and audit requirements. | Column sox_control_flag (BOOLEAN) in finance.revenue_recognition_event']
  transaction_date date [note: 'The original business transaction date (e.g., ad spot air date, subscription activation date, content delivery date) that triggered the revenue recognition event. May differ from recognition_date for deferred or over-time recognition scenarios. | Column transaction_date (DATE) in finance.revenue_recognition_event']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in finance.revenue_recognition_event']

  Note: 'Transactional record of each revenue recognition event posted in SAP S/4HANA for Media Broadcasting revenue streams — capturing the point-in-time or over-time recognition of advertising revenue, subscription fees, carriage fees, and content licensing income. Stores recognition date, recognized amount, deferred amount, performance obligation reference, contract modification flag, revenue stream, GL account, company code, and ASC 606 / IFRS 15 compliance indicators. | Unity Catalog table: media_broadcasting_ecm.finance.revenue_recognition_event SOX compliance controls applicable. Integrates with SAP S/4HANA CO (finance/controlling).'
