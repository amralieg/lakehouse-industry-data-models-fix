    rdfs:label 'Population Health Cohort Mgmt Cohort Definition' ;
    rdfs:comment 'Table defining dynamic cohorts' .

ind:PopulationHealthCohortMgmtCohortMembership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PopulationHealthCohortMgmt ;
    rdfs:label 'Population Health Cohort Mgmt Cohort Membership' ;
    rdfs:comment 'Table tracking cohort membership' .

ind:EligibilityCriteria rdf:type rdfs:Class ;
