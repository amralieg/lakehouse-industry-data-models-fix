  expiration_date date [note: 'Date when the co-production agreement terminates or expires. Nullable for open-ended agreements. | Column expiration_date (DATE) in partner.coproduction_agreement']
  force_majeure_provision varchar [note: 'Contractual terms addressing obligations and liabilities in the event of unforeseeable circumstances preventing performance. | Column force_majeure_provision (STRING) in partner.coproduction_agreement']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of the co-production agreement. | Column governing_law_jurisdiction (STRING) in partner.coproduction_agreement']
  insurance_requirements varchar [note: 'Mandatory insurance coverage types and amounts required for the co-production. | Column insurance_requirements (STRING) in partner.coproduction_agreement']
  last_amendment_date date [note: 'Date of the most recent amendment to the co-production agreement. | Column last_amendment_date (DATE) in partner.coproduction_agreement']
  notes varchar [note: 'Additional comments, special provisions, or contextual information about the co-production agreement. | Column notes (STRING) in partner.coproduction_agreement']
  our_investment_amount decimal(18,2) [note: 'Financial contribution amount committed by our organization to the co-production. | Column our_investment_amount (DECIMAL(18,2)) in partner.coproduction_agreement']
  our_investment_percentage decimal(5,2) [note: 'Percentage of total production budget contributed by our organization. | Column our_investment_percentage (DECIMAL(5,2)) in partner.coproduction_agreement']
  our_ip_ownership_percentage decimal(5,2) [note: 'Percentage of intellectual property rights owned by our organization in the co-produced content. | Column our_ip_ownership_percentage (DECIMAL(5,2)) in partner.coproduction_agreement']
  our_primary_territory varchar [note: 'Geographic territory or territories where our organization holds primary distribution rights. | Column our_primary_territory (STRING) in partner.coproduction_agreement']
  production_end_date date [note: 'Scheduled or actual date when principal photography or production activities are completed. | Column production_end_date (DATE) in partner.coproduction_agreement']
  production_start_date date [note: 'Scheduled or actual date when principal photography or production activities commence. | Column production_start_date (DATE) in partner.coproduction_agreement']
  production_type varchar [note: 'Category of content being co-produced (film, television series, documentary, etc.). | Column production_type (STRING) in partner.coproduction_agreement']
  residuals_sharing_formula varchar [note: 'Formula or methodology for distributing residual payments to talent among co-production partners. | Column residuals_sharing_formula (STRING) in partner.coproduction_agreement']
  revenue_sharing_model varchar [note: 'Methodology for distributing revenues generated from the co-produced content among partners. | Column revenue_sharing_model (STRING) in partner.coproduction_agreement']
  signed_date date [note: 'Date when all parties executed the co-production agreement. | Column signed_date (DATE) in partner.coproduction_agreement']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.coproduction_agreement']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.coproduction_agreement']
  termination_clause varchar [note: 'Conditions and procedures under which the co-production agreement may be terminated by any party. | Column termination_clause (STRING) in partner.coproduction_agreement']
  total_budget_amount decimal(18,2) [note: 'Total production budget for the co-produced content across all partners. | Column total_budget_amount (DECIMAL(18,2)) in partner.coproduction_agreement']
