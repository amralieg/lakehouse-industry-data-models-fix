ind:costPoolName rdf:type rdf:Property ;
    rdfs:label 'Cost Pool Name' ;
    rdfs:comment 'The name of the cost pool from which this allocation is distributed.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationTier rdf:type rdf:Property ;
    rdfs:label 'Allocation Tier' ;
    rdfs:comment 'The tier or level in a multi-tier allocation hierarchy (e.g., tier 1 for direct allocations, tier 2 for step-down).' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorPeriodAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Period Amount' ;
    rdfs:comment 'The allocated amount from the prior comparable period for trend analysis.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yearToDateAmount rdf:type rdf:Property ;
    rdfs:label 'Year To Date Amount' ;
    rdfs:comment 'The cumulative allocated amount for the fiscal year to date.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationFrequency rdf:type rdf:Property ;
    rdfs:label 'Allocation Frequency' ;
    rdfs:comment 'The frequency at which the allocation rule is executed and applied to financial transactions.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCostCenter rdf:type rdf:Property ;
    rdfs:label 'Source Cost Center' ;
    rdfs:comment 'The originating cost center from which costs or revenues are being allocated.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceGlAccount rdf:type rdf:Property ;
    rdfs:label 'Source Gl Account' ;
    rdfs:comment 'The general ledger account number from which the allocation originates.' ;
    rdfs:domain ind:AllocationRule ;
    rdf:type owl:DatatypeProperty ;
