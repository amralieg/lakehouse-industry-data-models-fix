    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otcAllowanceAmount rdf:type rdf:Property ;
    rdfs:label 'Otc Allowance Amount' ;
    rdfs:comment 'Quarterly or annual allowance for over-the-counter health products and medications.' ;
    rdfs:domain ind:BenefitDesign ;
