  effective_start_date date [note: 'Date when this taxonomy entry becomes effective and available for content classification. | Column effective_start_date (DATE) in content.taxonomy']
  external_code varchar [note: 'External or industry-standard taxonomy code for interoperability with third-party systems and content metadata standards. | Column external_code (STRING) in content.taxonomy']
  hierarchy_level varchar [note: 'Numeric level in the taxonomy hierarchy where 1 is the top level and higher numbers represent deeper nesting. | Column hierarchy_level (INT) in content.taxonomy']
  hierarchy_path varchar [note: 'Full hierarchical path from root to current taxonomy entry, typically represented as a delimited string (e.g., /Drama/Crime/Detective). | Column hierarchy_path (STRING) in content.taxonomy']
  is_active boolean [note: 'Indicates whether the taxonomy entry is currently active and available for content classification. Inactive entries are retained for historical reference. | Column is_active (BOOLEAN) in content.taxonomy']
  is_leaf_node boolean [note: 'Indicates whether this taxonomy entry is a leaf node (has no children) in the hierarchy. True for leaf nodes, false for parent nodes. | Column is_leaf_node (BOOLEAN) in content.taxonomy']
  language_code varchar [note: 'ISO 639 language code indicating the language of the taxonomy entry name and description. | Column language_code (STRING) in content.taxonomy']
  last_modified_timestamp timestamp [note: 'Date and time when this taxonomy entry was last updated. | Column last_modified_timestamp (TIMESTAMP) in content.taxonomy']
