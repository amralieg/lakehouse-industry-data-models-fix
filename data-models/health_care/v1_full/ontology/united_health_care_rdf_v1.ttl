    rdfs:comment 'The name of the department to which the amount is being allocated.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceGlAccountCode rdf:type rdf:Property ;
