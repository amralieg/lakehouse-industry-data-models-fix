ind:eligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Status' ;
    rdfs:comment 'The current eligibility status of the member indicating whether they have active coverage and can access benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
