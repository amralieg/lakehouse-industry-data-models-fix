    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandStatus rdf:type rdf:Property ;
    rdfs:label 'Brand Status' ;
    rdfs:comment 'Current lifecycle status of the brand within the sponsorship ecosystem. Active brands have current or recent partnerships; prospective brands are in the sales pipeline.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandTier rdf:type rdf:Property ;
    rdfs:label 'Brand Tier' ;
    rdfs:comment 'Sponsorship tier classification indicating the level of partnership prominence and benefits (e.g., title sponsor, presenting sponsor, official partner).' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandValueProposition rdf:type rdf:Property ;
    rdfs:label 'Brand Value Proposition' ;
    rdfs:comment 'Core value proposition or brand positioning statement. Used to align sponsorship activations with brand messaging and ensure partnership authenticity.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandWebsiteUrl rdf:type rdf:Property ;
    rdfs:label 'Brand Website Url' ;
    rdfs:comment 'Official website URL for the brand. Used for sponsor profile pages, activation tracking, and digital partnership integrations.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitorBrands rdf:type rdf:Property ;
