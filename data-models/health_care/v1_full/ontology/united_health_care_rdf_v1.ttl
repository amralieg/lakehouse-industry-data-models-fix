    rdfs:range ind:UnitedHealthCare .

ind:routingStrategy rdf:type rdf:Property ;
    rdfs:label 'Routing Strategy' ;
    rdfs:comment 'Algorithm used to distribute interactions from this queue to available agents (longest idle, skills-based, round-robin, etc.).' ;
