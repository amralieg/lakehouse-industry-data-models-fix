ind:drugQuantity rdf:type rdf:Property ;
    rdfs:label 'Drug Quantity' ;
    rdfs:comment 'The quantity of medication dispensed for pharmacy claims, measured in the appropriate unit (e.g., tablets, milliliters).' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dawCode rdf:type rdf:Property ;
    rdfs:label 'Daw Code' ;
    rdfs:comment 'Code indicating whether the brand name drug was dispensed as written by the prescriber or if a generic substitution was made.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofBusiness rdf:type rdf:Property ;
    rdfs:label 'Of Business' ;
    rdfs:comment 'The insurance product line or market segment under which this service line is covered.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingMethod rdf:type rdf:Property ;
    rdfs:label 'Pricing Method' ;
    rdfs:comment 'The methodology used to determine the allowed amount for this service line.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalNecessityIndicator rdf:type rdf:Property ;
    rdfs:label 'Medical Necessity Indicator' ;
    rdfs:comment 'Flag indicating whether the service was determined to be medically necessary based on clinical guidelines and policy criteria.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveServiceIndicator rdf:type rdf:Property ;
    rdfs:label 'Preventive Service Indicator' ;
    rdfs:comment 'Flag indicating whether the service is classified as preventive care, which may be covered at 100% under ACA requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bundledIndicator rdf:type rdf:Property ;
    rdfs:label 'Bundled Indicator' ;
    rdfs:comment 'Flag indicating whether this service line is bundled with another service and not separately reimbursable.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:duplicateIndicator rdf:type rdf:Property ;
    rdfs:label 'Duplicate Indicator' ;
    rdfs:comment 'Flag indicating whether this line was identified as a duplicate of a previously processed claim line.' ;
