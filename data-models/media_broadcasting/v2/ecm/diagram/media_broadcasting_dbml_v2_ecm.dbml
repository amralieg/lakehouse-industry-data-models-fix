  blocking_reason varchar [note: 'Reason why the usage right is blocked or conditionally cleared. Null if status is cleared or pending. | Column blocking_reason (STRING) in talent.usage_right']
  clearance_granted_by varchar [note: 'Name or identifier of the person or system that granted clearance for this usage right. | Column clearance_granted_by (STRING) in talent.usage_right']
  clearance_granted_date date [note: 'Date when clearance was granted for this usage right. Null if not yet cleared. | Column clearance_granted_date (DATE) in talent.usage_right']
  clearance_requested_date date [note: 'Date when clearance verification was requested for this usage right. | Column clearance_requested_date (DATE) in talent.usage_right']
  clearance_status varchar [note: 'Current clearance verification status of the usage right. Tracks operational approval workflow. | Column clearance_status (STRING) in talent.usage_right']
  consent_obtained_date date [note: 'Date when talent consent was obtained for this usage right. Null if consent not obtained or not required. | Column consent_obtained_date (DATE) in talent.usage_right']
  consent_obtained_flag boolean [note: 'Indicates whether required consent has been obtained from the talent (True) or not (False). Null if consent not required. | Column consent_obtained_flag (BOOLEAN) in talent.usage_right']
  consent_required_flag boolean [note: 'Indicates whether explicit talent consent is required for each use under this right (True) or if blanket consent was granted (False). | Column consent_required_flag (BOOLEAN) in talent.usage_right']
