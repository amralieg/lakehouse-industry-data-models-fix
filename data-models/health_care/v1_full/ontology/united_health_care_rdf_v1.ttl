    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Order .

ind:subscriberAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Subscriber Address Line1' ;
    rdfs:comment 'First line of the subscriber\'s residential address.' ;
