  conditional_terms varchar [note: 'Specific conditions, restrictions, or requirements that must be met for the clearance to remain valid. | Column conditional_terms (STRING) in talent.talent_clearance']
  contract_reference_number varchar [note: 'Reference to the underlying talent contract that governs the usage rights being cleared. | Column contract_reference_number (STRING) in talent.talent_clearance']
