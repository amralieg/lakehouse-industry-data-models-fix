    rdfs:range xsd:integer .

ind:complianceNotes rdf:type rdf:Property ;
    rdfs:label 'Compliance Notes' ;
    rdfs:comment 'Additional notes related to regulatory compliance requirements for this lineup in gaming operations.' ;
    rdfs:domain ind:Lineup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fantasyEligibleFlag rdf:type rdf:Property ;
