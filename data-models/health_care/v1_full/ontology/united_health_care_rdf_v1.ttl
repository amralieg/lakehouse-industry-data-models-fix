ind:relationshipType rdf:type rdf:Property ;
    rdfs:label 'Relationship Type' ;
    rdfs:comment 'Type of hierarchical relationship between parent and child products (e.g., family plan structure, supplemental rider attachment, dependent coverage linkage).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:level rdf:type rdf:Property ;
