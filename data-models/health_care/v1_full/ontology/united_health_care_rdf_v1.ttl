    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterventionType .

ind:complexityLevel rdf:type rdf:Property ;
    rdfs:label 'Complexity Level' ;
    rdfs:comment 'Indicates the level of clinical complexity and resource intensity required to deliver the intervention. Used for care manager workload planning and resource allocation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
