    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planCategory rdf:type rdf:Property ;
    rdfs:label 'Plan Category' ;
    rdfs:comment 'Broader classification grouping related benefit types for reporting and administration.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planYearEndDate rdf:type rdf:Property ;
    rdfs:label 'Plan Year End Date' ;
    rdfs:comment 'End date of the benefit plan year for tracking deductibles, out-of-pocket maximums, and annual limits.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planYearStartDate rdf:type rdf:Property ;
    rdfs:label 'Plan Year Start Date' ;
    rdfs:comment 'Start date of the benefit plan year for tracking deductibles, out-of-pocket maximums, and annual limits.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:summaryPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Summary Plan Description' ;
    rdfs:comment 'Detailed textual description of the benefit plan features, coverage, exclusions, and employee rights as required by ERISA.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Waiting Period Days' ;
    rdfs:comment 'Number of days a new employee must wait before becoming eligible to enroll in this benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectiveBargainingAgreementId rdf:type rdf:Property ;
    rdfs:label 'Collective Bargaining Agreement Id' ;
    rdfs:comment 'Identifier of the collective bargaining agreement that governs benefit terms for this enrollment period, if applicable to union employees.' ;
    rdfs:domain ind:OpenEnrollmentPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CbaAgreement .

ind:autoEnrollmentEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Enrollment Enabled' ;
    rdfs:comment 'Indicates whether employees who do not make active elections will be automatically enrolled in default benefit plans.' ;
    rdfs:domain ind:OpenEnrollmentPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationStartDate rdf:type rdf:Property ;
    rdfs:label 'Communication Start Date' ;
    rdfs:comment 'Date when enrollment communications and educational materials are released to employees.' ;
    rdfs:domain ind:OpenEnrollmentPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Effective Date' ;
    rdfs:comment 'Date when benefit elections made during this enrollment period become effective and coverage begins.' ;
    rdfs:domain ind:OpenEnrollmentPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dependentVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Dependent Verification Required' ;
    rdfs:comment 'Indicates whether employees must provide documentation to verify dependent eligibility during this enrollment period.' ;
    rdfs:domain ind:OpenEnrollmentPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibleEmployeeCount rdf:type rdf:Property ;
    rdfs:label 'Eligible Employee Count' ;
    rdfs:comment 'Total number of employees eligible to participate in this open enrollment period.' ;
    rdfs:domain ind:OpenEnrollmentPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enrollmentDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Deadline Date' ;
    rdfs:comment 'Final date by which employees must complete their benefit elections. May differ from end_date if there is a grace period for processing.' ;
    rdfs:domain ind:OpenEnrollmentPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:passiveEnrollmentEnabled rdf:type rdf:Property ;
    rdfs:label 'Passive Enrollment Enabled' ;
    rdfs:comment 'Indicates whether employees who do not make changes will have their current benefit elections automatically carried forward to the new plan year.' ;
    rdfs:domain ind:OpenEnrollmentPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualifyingEventWindowDays rdf:type rdf:Property ;
    rdfs:label 'Qualifying Event Window Days' ;
    rdfs:comment 'Number of days employees have to make benefit changes following a qualifying life event during this period.' ;
    rdfs:domain ind:OpenEnrollmentPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modifiedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Modified By Employee Id' ;
    rdfs:comment 'Reference to the employee or system user who last modified the requisition record.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:recruiterEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Recruiter Employee Id' ;
    rdfs:comment 'Reference to the HR recruiter or talent acquisition specialist assigned to manage the recruiting process for this requisition.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:approvalWorkflowCode rdf:type rdf:Property ;
    rdfs:label 'Approval Workflow Code' ;
    rdfs:comment 'Reference to the approval workflow instance governing the requisition approval process.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jobDescription rdf:type rdf:Property ;
    rdfs:label 'Job Description' ;
    rdfs:comment 'Detailed narrative description of the role, responsibilities, qualifications, and expectations for the position.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumEducationLevel rdf:type rdf:Property ;
    rdfs:label 'Minimum Education Level' ;
    rdfs:comment 'The minimum educational qualification required for candidates applying to this position.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumYearsExperience rdf:type rdf:Property ;
    rdfs:label 'Minimum Years Experience' ;
    rdfs:comment 'The minimum number of years of relevant work experience required for the position.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfOpenings rdf:type rdf:Property ;
    rdfs:label 'Number Of Openings' ;
    rdfs:comment 'The quantity of positions to be filled under this requisition, typically 1 but may be higher for bulk seasonal or event crew hiring.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:physicalRequirementsDescription rdf:type rdf:Property ;
    rdfs:label 'Physical Requirements Description' ;
    rdfs:comment 'Description of physical demands and working conditions for the position, relevant for OSHA safety compliance and ADA accommodation planning.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionsFilled rdf:type rdf:Property ;
    rdfs:label 'Positions Filled' ;
    rdfs:comment 'The count of positions that have been successfully filled and closed under this requisition.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postedDate rdf:type rdf:Property ;
    rdfs:label 'Posted Date' ;
    rdfs:comment 'The date the requisition was published to internal or external job boards and made visible to candidates.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:postingVisibility rdf:type rdf:Property ;
    rdfs:label 'Posting Visibility' ;
    rdfs:comment 'Indicates whether the requisition is posted internally to current employees only, externally to the public, both, or kept confidential.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remoteWorkEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Remote Work Eligible Flag' ;
    rdfs:comment 'Indicates whether the position is eligible for remote or hybrid work arrangements.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requisitionType rdf:type rdf:Property ;
    rdfs:label 'Requisition Type' ;
    rdfs:comment 'Classification of the requisition indicating whether it is for a new headcount, replacement of a departing employee, seasonal hiring, or other workforce planning scenario.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryRangeMaximum rdf:type rdf:Property ;
    rdfs:label 'Salary Range Maximum' ;
    rdfs:comment 'The maximum annual salary or hourly rate budgeted for this position, in USD.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryRangeMinimum rdf:type rdf:Property ;
    rdfs:label 'Salary Range Minimum' ;
    rdfs:comment 'The minimum annual salary or hourly rate budgeted for this position, in USD.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:securityClearanceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Security Clearance Required Flag' ;
    rdfs:comment 'Indicates whether the position requires background checks, security clearance, or credential verification due to venue access or sensitive operations.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:travelRequirementPercentage rdf:type rdf:Property ;
    rdfs:label 'Travel Requirement Percentage' ;
    rdfs:comment 'The estimated percentage of time the position requires business travel, relevant for broadcast crews, league officials, and touring event staff.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unionCode rdf:type rdf:Property ;
    rdfs:label 'Union Code' ;
    rdfs:comment 'Code identifying the specific labor union or bargaining unit that covers this position, if applicable.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionCoveredFlag rdf:type rdf:Property ;
    rdfs:label 'Union Covered Flag' ;
    rdfs:comment 'Indicates whether this position is covered by a collective bargaining agreement (CBA) or labor union contract.' ;
    rdfs:domain ind:Requisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:candidateType rdf:type rdf:Property ;
    rdfs:label 'Candidate Type' ;
    rdfs:comment 'Classification of the candidate source or type (internal transfer, external applicant, employee referral, agency submission, rehire, contractor conversion).' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverLetterText rdf:type rdf:Property ;
    rdfs:label 'Cover Letter Text' ;
    rdfs:comment 'Full text content of the candidate\'s cover letter or application statement.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentEmployer rdf:type rdf:Property ;
    rdfs:label 'Current Employer' ;
    rdfs:comment 'Name of the candidate\'s current or most recent employer organization.' ;
