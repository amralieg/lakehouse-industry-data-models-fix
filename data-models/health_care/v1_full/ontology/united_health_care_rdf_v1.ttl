    rdfs:comment 'The qualifying life event that makes the prospective member eligible for a Special Enrollment Period outside of open enrollment.' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedSubsidyAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Subsidy Amount' ;
    rdfs:comment 'The estimated monthly premium tax credit amount the prospective member may qualify for.' ;
