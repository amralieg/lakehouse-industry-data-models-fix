    rdfs:domain ind:PostAcuteCarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledServices rdf:type rdf:Property ;
    rdfs:label 'Scheduled Services' ;
    rdfs:comment 'List of services (e.g., physical therapy, occupational therapy) scheduled as part of the plan.' ;
    rdfs:domain ind:PostAcuteCarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapyPlan rdf:type rdf:Property ;
    rdfs:label 'Therapy Plan' ;
    rdfs:comment 'Details of physical, occupational, speech, or other therapy services included in the plan.' ;
    rdfs:domain ind:PostAcuteCarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:respondingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Responding Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Clinical alerts require provider review/acknowledgment per RPM care protocols. Tracking the responding clinician supports CMS interactive communication requirements and malpractice documentation.' ;
    rdfs:domain ind:HealthAlert ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:alertCategory rdf:type rdf:Property ;
    rdfs:label 'Alert Category' ;
    rdfs:comment 'Category classifying the type of alert.' ;
    rdfs:domain ind:HealthAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertDescription rdf:type rdf:Property ;
    rdfs:label 'Alert Description' ;
    rdfs:comment 'Free-text description providing context for the alert.' ;
    rdfs:domain ind:HealthAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertTimestamp rdf:type rdf:Property ;
    rdfs:label 'Alert Timestamp' ;
    rdfs:comment 'Timestamp when the alert condition was detected.' ;
    rdfs:domain ind:HealthAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:measuredValue rdf:type rdf:Property ;
    rdfs:label 'Measured Value' ;
    rdfs:comment 'Measured value of the metric at the time of alert.' ;
    rdfs:domain ind:HealthAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Threshold Unit' ;
    rdfs:comment 'Unit of measure for the threshold value.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Flag' ;
    rdfs:comment 'Indicates whether the service is billable to the payer (true) or not (false).' ;
    rdfs:domain ind:ServiceDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followupDate rdf:type rdf:Property ;
    rdfs:label 'Followup Date' ;
    rdfs:comment 'Scheduled date for the required follow-up, if any.' ;
    rdfs:domain ind:ServiceDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followupRequired rdf:type rdf:Property ;
    rdfs:label 'Followup Required' ;
    rdfs:comment 'Indicates whether a follow-up appointment is required after the service.' ;
    rdfs:domain ind:ServiceDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcomeNotes rdf:type rdf:Property ;
    rdfs:label 'Outcome Notes' ;
    rdfs:comment 'Clinician-documented narrative describing the clinical outcome of the service.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:satisfactionRating rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Rating' ;
    rdfs:comment 'Patient-reported satisfaction rating (e.g., 1-5).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceCode rdf:type rdf:Property ;
    rdfs:label 'Service Code' ;
    rdfs:comment 'Standardized code representing the type of post-acute service delivered (e.g., CPT, HCPCS).' ;
    rdfs:domain ind:PostAcuteCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceDeliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Service Delivery Status' ;
    rdfs:comment 'Current lifecycle status of the service delivery.' ;
    rdfs:domain ind:ServiceDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceName rdf:type rdf:Property ;
    rdfs:label 'Service Name' ;
    rdfs:comment 'Human-readable name of the service delivered.' ;
    rdfs:domain ind:ServiceDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceType rdf:type rdf:Property ;
    rdfs:label 'Service Type' ;
    rdfs:comment 'Broad category of the service delivered.' ;
    rdfs:domain ind:PostAcuteCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityBeds rdf:type rdf:Property ;
    rdfs:label 'Capacity Beds' ;
    rdfs:comment 'Maximum number of inpatient beds available at the location.' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capacityRooms rdf:type rdf:Property ;
    rdfs:label 'Capacity Rooms' ;
    rdfs:comment 'Maximum number of therapy or treatment rooms.' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closingDate rdf:type rdf:Property ;
    rdfs:label 'Closing Date' ;
    rdfs:comment 'Date the location ceased operations (null if still open).' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hasEmergencyServices rdf:type rdf:Property ;
    rdfs:label 'Has Emergency Services' ;
    rdfs:comment 'True if the location provides 24-hour emergency care.' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionScore rdf:type rdf:Property ;
    rdfs:label 'Inspection Score' ;
    rdfs:comment 'Numeric score (0-100) resulting from the latest inspection.' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openingDate rdf:type rdf:Property ;
    rdfs:label 'Opening Date' ;
    rdfs:comment 'Date the location began providing services.' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:postAcuteLocationName rdf:type rdf:Property ;
    rdfs:label 'Post Acute Location Name' ;
    rdfs:comment 'Human-readable name of the post-acute care location (e.g., "Sunrise Rehab Center").' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postAcuteLocationStatus rdf:type rdf:Property ;
    rdfs:label 'Post Acute Location Status' ;
    rdfs:comment 'Current operational status of the location.' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicesOffered rdf:type rdf:Property ;
    rdfs:label 'Services Offered' ;
    rdfs:comment 'Free-form list or coded string describing clinical services (e.g., "Physical Therapy, Occupational Therapy").' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wheelchairAccessible rdf:type rdf:Property ;
    rdfs:label 'Wheelchair Accessible' ;
    rdfs:comment 'Indicates whether the facility complies with ADA wheelchair-accessibility standards.' ;
    rdfs:domain ind:PostAcuteLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceBundleId rdf:type rdf:Property ;
    rdfs:label 'Service Bundle Id' ;
    rdfs:comment 'Identifier of the service bundle to which this service belongs (if applicable).' ;
    rdfs:domain ind:PostAcuteCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceBundle .

ind:billingCodeType rdf:type rdf:Property ;
    rdfs:label 'Billing Code Type' ;
    rdfs:comment 'Indicates whether the billing code follows CPT or HCPCS standards.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBundleService rdf:type rdf:Property ;
    rdfs:label 'Is Bundle Service' ;
    rdfs:comment 'True if the service is offered only as part of a bundled care package.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCoveredByMedicaid rdf:type rdf:Property ;
    rdfs:label 'Is Covered By Medicaid' ;
    rdfs:comment 'True if the service is reimbursable under Medicaid.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCoveredByMedicare rdf:type rdf:Property ;
    rdfs:label 'Is Covered By Medicare' ;
    rdfs:comment 'True if the service is reimbursable under Medicare.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCoveredByPrivateInsurance rdf:type rdf:Property ;
    rdfs:label 'Is Covered By Private Insurance' ;
    rdfs:comment 'True if the service is covered by private payer contracts.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHomeBased rdf:type rdf:Property ;
    rdfs:label 'Is Home Based' ;
    rdfs:comment 'True if the service is provided in the patient’s home.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxSessionsAllowed rdf:type rdf:Property ;
    rdfs:label 'Max Sessions Allowed' ;
    rdfs:comment 'Upper limit on the number of reimbursable sessions per episode of care.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postAcuteServiceDescription rdf:type rdf:Property ;
    rdfs:label 'Post Acute Service Description' ;
    rdfs:comment 'Detailed narrative describing the scope, goals, and methodology of the service.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postAcuteServiceName rdf:type rdf:Property ;
    rdfs:label 'Post Acute Service Name' ;
    rdfs:comment 'Human-readable name of the post-acute care service (e.g., Physical Therapy – Lower Extremity).' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postAcuteServiceStatus rdf:type rdf:Property ;
    rdfs:label 'Post Acute Service Status' ;
    rdfs:comment 'Current lifecycle state of the service definition.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:price rdf:type rdf:Property ;
    rdfs:label 'Price' ;
    rdfs:comment 'Standard price charged for a single session of the service.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceCurrency rdf:type rdf:Property ;
    rdfs:label 'Price Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the price (e.g., USD).' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerSpecialtyRequired rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Required' ;
    rdfs:comment 'Clinical specialty required to deliver the service (e.g., Physical Therapist).' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresPrescription rdf:type rdf:Property ;
    rdfs:label 'Requires Prescription' ;
    rdfs:comment 'True if a physician prescription is required to order the service.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sessionIntervalDays rdf:type rdf:Property ;
    rdfs:label 'Session Interval Days' ;
    rdfs:comment 'Minimum number of days required between consecutive sessions.' ;
    rdfs:domain ind:PostAcuteService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalTrialId rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Id' ;
    rdfs:comment 'Identifier of the clinical trial associated with the genomic test, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Trial .

ind:genomicOrderId rdf:type rdf:Property ;
    rdfs:label 'Genomic Order Id' ;
    rdfs:comment 'System-generated unique identifier for the genomic order record.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicOrder .

ind:indicationDiagnosisId rdf:type rdf:Property ;
    rdfs:label 'Indication Diagnosis Id' ;
    rdfs:comment 'Foreign key linking to clinical.diagnosis. Business justification: Genomic test orders require a clinical indication/diagnosis for medical necessity, insurance authorization, and compliance. Standard ordering workflow in oncology and rare disease programs.' ;
    rdfs:domain ind:GenomicsGenomicOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Diagnosis .

ind:clinicalInterpretation rdf:type rdf:Property ;
    rdfs:label 'Clinical Interpretation' ;
    rdfs:comment 'Narrative interpretation of the genomic findings.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isClinicalTrial rdf:type rdf:Property ;
    rdfs:label 'Is Clinical Trial' ;
    rdfs:comment 'Flag indicating whether the order is part of a clinical trial.' ;
    rdfs:domain ind:GenomicsGenomicOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isResearch rdf:type rdf:Property ;
    rdfs:label 'Is Research' ;
    rdfs:comment 'Flag indicating whether the order is for research purposes rather than clinical care.' ;
    rdfs:domain ind:GenomicsGenomicOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderAmount rdf:type rdf:Property ;
    rdfs:label 'Order Amount' ;
    rdfs:comment 'Charged amount for the genomic test before adjustments.' ;
    rdfs:domain ind:GenomicsGenomicOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportUrl rdf:type rdf:Property ;
    rdfs:label 'Report Url' ;
    rdfs:comment 'Link to the electronic genomic report stored in the EHR.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultReleaseDate rdf:type rdf:Property ;
    rdfs:label 'Result Release Date' ;
    rdfs:comment 'Date the final genomic report was made available to the ordering clinician.' ;
    rdfs:domain ind:GenomicsGenomicOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:readmissionEventId rdf:type rdf:Property ;
    rdfs:label 'Readmission Event Id' ;
    rdfs:comment 'Unique surrogate key for each readmission event record.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readmissionPostAcuteLocationId rdf:type rdf:Property ;
    rdfs:label 'Readmission Post Acute Location Id' ;
    rdfs:comment 'Foreign key linking to post_acute_care.post_acute_location. Business justification: A readmission event may occur at a specific post-acute care location. This enables tracking which PAC facility the patient was readmitted to, supporting quality metrics and facility-level readmission ' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PostAcuteLocation .

ind:dischargeDispositionDescription rdf:type rdf:Property ;
    rdfs:label 'Discharge Disposition Description' ;
    rdfs:comment 'Human-readable description of the discharge disposition.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDuplicateEvent rdf:type rdf:Property ;
    rdfs:label 'Is Duplicate Event' ;
    rdfs:comment 'Indicates whether this record is a duplicate of another readmission event.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReadmissionWithin30Days rdf:type rdf:Property ;
    rdfs:label 'Is Readmission Within 30 Days' ;
    rdfs:comment 'True if the readmission occurred within 30 days of discharge.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReadmissionWithin90Days rdf:type rdf:Property ;
    rdfs:label 'Is Readmission Within 90 Days' ;
    rdfs:comment 'True if the readmission occurred within 90 days of discharge.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lengthOfStayOriginal rdf:type rdf:Property ;
    rdfs:label 'Length Of Stay Original' ;
    rdfs:comment 'Number of days the patient stayed during the index encounter.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lengthOfStayReadmission rdf:type rdf:Property ;
    rdfs:label 'Length Of Stay Readmission' ;
    rdfs:comment 'Number of days the patient stayed during the readmission encounter.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readmissionCost rdf:type rdf:Property ;
    rdfs:label 'Readmission Cost' ;
    rdfs:comment 'Total billed amount for the readmission encounter.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readmissionOutcome rdf:type rdf:Property ;
    rdfs:label 'Readmission Outcome' ;
    rdfs:comment 'Final disposition of the patient after the readmission.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionPaymentStatus rdf:type rdf:Property ;
    rdfs:label 'Readmission Payment Status' ;
    rdfs:comment 'Current payment status of the readmission claim.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Readmission Reason Code' ;
    rdfs:comment 'Standardized code describing why the patient was readmitted.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Readmission Reason Description' ;
    rdfs:comment 'Free-text description of the readmission reason.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Readmission Timestamp' ;
    rdfs:comment 'Date-time when the readmission occurred.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:readmissionWindowDays rdf:type rdf:Property ;
    rdfs:label 'Readmission Window Days' ;
    rdfs:comment 'Number of days between the original discharge and the readmission.' ;
    rdfs:domain ind:ReadmissionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originatingCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Originating Care Site Id' ;
    rdfs:comment 'Foreign key linking to facility.care_site. Business justification: Discharge planning and readmission analytics require tracking which acute facility originated the PAC referral. CMS Bundled Payment models hold originating hospitals accountable for PAC outcomes and c' ;
    rdfs:domain ind:Referral ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:referralEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Referral Employee Id' ;
    rdfs:comment 'Identifier of the system user who created the referral record.' ;
    rdfs:domain ind:Referral ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:closureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closure Timestamp' ;
    rdfs:comment 'Timestamp when the referral record was closed in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dischargeDestination rdf:type rdf:Property ;
    rdfs:label 'Discharge Destination' ;
    rdfs:comment 'Facility or setting to which the patient will be discharged after the referral service.' ;
    rdfs:domain ind:Referral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCostCurrency rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the estimated cost.' ;
    rdfs:domain ind:Referral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedStartDate rdf:type rdf:Property ;
    rdfs:label 'Expected Start Date' ;
    rdfs:comment 'Planned date when the patient is expected to begin the referred service.' ;
    rdfs:domain ind:Referral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outcomeDate rdf:type rdf:Property ;
    rdfs:label 'Outcome Date' ;
    rdfs:comment 'Date when the referral outcome was recorded.' ;
    rdfs:domain ind:Referral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reasonForReferral rdf:type rdf:Property ;
    rdfs:label 'Reason For Referral' ;
    rdfs:comment 'Narrative description of the clinical or administrative reason prompting the referral.' ;
    rdfs:domain ind:Referral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicsSampleSpecimenId rdf:type rdf:Property ;
    rdfs:label 'Genomics Sample Specimen Id' ;
    rdfs:comment 'Identifier of the biological sample processed in this run.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specimen .

ind:genomicsSpecimenId rdf:type rdf:Property ;
    rdfs:label 'Genomics Specimen Id' ;
    rdfs:comment 'Foreign key linking to laboratory.specimen. Business justification: Sequencing runs process specific laboratory specimens. Direct specimen traceability on runs is required for quality control, contamination investigations, and regulatory compliance (CAP checklist). Th' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specimen .

ind:reagentKitMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Reagent Kit Material Master Id' ;
    rdfs:comment 'Foreign key linking to supply.material_master. Business justification: Labs must track which reagent kit lot was used per sequencing run for FDA recall response, QC failure investigation, and cost allocation. Domain experts expect reagent traceability to material master ' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:sequencingRunId rdf:type rdf:Property ;
    rdfs:label 'Sequencing Run Id' ;
    rdfs:comment 'Unique system-generated identifier for the sequencing run.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SequencingRun .

ind:supervisingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Supervising Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: CLIA regulations require a medical director (credentialed clinician) to authorize/supervise clinical sequencing runs. Distinct from operator_id (technician). Required for lab accreditation compliance ' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:chemistryVersion rdf:type rdf:Property ;
    rdfs:label 'Chemistry Version' ;
    rdfs:comment 'Version of the sequencing chemistry kit used.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRetentionDays rdf:type rdf:Property ;
    rdfs:label 'Compliance Retention Days' ;
    rdfs:comment 'Number of days required to retain the run data for regulatory compliance.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:controlType rdf:type rdf:Property ;
    rdfs:label 'Control Type' ;
    rdfs:comment 'Type of control sample used, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPath rdf:type rdf:Property ;
    rdfs:label 'Data Path' ;
    rdfs:comment 'File system or object storage path where raw and processed data are stored.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowcellCode rdf:type rdf:Property ;
    rdfs:label 'Flowcell Code' ;
    rdfs:comment 'Identifier of the flowcell hardware used.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowcellType rdf:type rdf:Property ;
    rdfs:label 'Flowcell Type' ;
    rdfs:comment 'Model or type of the flowcell (e.g., NovaSeq S4).' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isControlRun rdf:type rdf:Property ;
    rdfs:label 'Is Control Run' ;
    rdfs:comment 'Indicates whether the run is a control (quality assurance) run.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laneCount rdf:type rdf:Property ;
    rdfs:label 'Lane Count' ;
    rdfs:comment 'Number of flowcell lanes used in the run.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:libraryPrepKit rdf:type rdf:Property ;
    rdfs:label 'Library Prep Kit' ;
    rdfs:comment 'Name of the library preparation kit.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:libraryPrepKitVersion rdf:type rdf:Property ;
    rdfs:label 'Library Prep Kit Version' ;
    rdfs:comment 'Version of the library preparation kit.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meanQualityScore rdf:type rdf:Property ;
    rdfs:label 'Mean Quality Score' ;
    rdfs:comment 'Average base quality score across all reads.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentQ30 rdf:type rdf:Property ;
    rdfs:label 'Percent Q30' ;
    rdfs:comment 'Percentage of bases with quality score ≥30.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qcPass rdf:type rdf:Property ;
    rdfs:label 'Qc Pass' ;
    rdfs:comment 'Indicates whether the run met predefined quality thresholds.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readLength rdf:type rdf:Property ;
    rdfs:label 'Read Length' ;
    rdfs:comment 'Target read length in base pairs.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Run Duration Seconds' ;
    rdfs:comment 'Total elapsed time of the run in seconds.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runIdentifier rdf:type rdf:Property ;
    rdfs:label 'Run Identifier' ;
    rdfs:comment 'External business identifier or accession number assigned to the run by the laboratory.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runLocation rdf:type rdf:Property ;
    rdfs:label 'Run Location' ;
    rdfs:comment 'Physical location or lab where the run was performed.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runProjectCode rdf:type rdf:Property ;
    rdfs:label 'Run Project Code' ;
    rdfs:comment 'Code linking the run to a research or clinical project.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalBases rdf:type rdf:Property ;
    rdfs:label 'Total Bases' ;
    rdfs:comment 'Aggregate number of bases sequenced (reads × read length).' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalReads rdf:type rdf:Property ;
    rdfs:label 'Total Reads' ;
    rdfs:comment 'Total number of sequencing reads generated.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:yieldGb rdf:type rdf:Property ;
    rdfs:label 'Yield Gb' ;
    rdfs:comment 'Total data output of the run in gigabytes.' ;
    rdfs:domain ind:GenomicsSequencingRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:genomicInterpretationId rdf:type rdf:Property ;
    rdfs:label 'Genomic Interpretation Id' ;
    rdfs:comment 'System-generated unique identifier for each genomic interpretation record.' ;
    rdfs:domain ind:GenomicInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicReportId rdf:type rdf:Property ;
    rdfs:label 'Genomic Report Id' ;
    rdfs:comment 'Foreign key linking to genomics.genomic_report. Business justification: A genomic interpretation is a structured finding that is documented within a genomic report. Multiple interpretations feed into one report (e.g., multiple variants interpreted). This links the detaile' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicReport .

ind:clinicalActionability rdf:type rdf:Property ;
    rdfs:label 'Clinical Actionability' ;
    rdfs:comment 'Recommended clinical actions (e.g., treatment, surveillance) based on the interpretation.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceScore rdf:type rdf:Property ;
    rdfs:label 'Evidence Score' ;
    rdfs:comment 'Quantitative score (0-100) summarizing overall evidence strength.' ;
    rdfs:domain ind:GenomicInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geneSymbol rdf:type rdf:Property ;
    rdfs:label 'Gene Symbol' ;
    rdfs:comment 'HGNC-approved gene symbol(s) referenced in the interpretation.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaRetentionYears rdf:type rdf:Property ;
    rdfs:label 'Hipaa Retention Years' ;
    rdfs:comment 'Number of years the interpretation must be retained to satisfy HIPAA regulations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interpretationDate rdf:type rdf:Property ;
    rdfs:label 'Interpretation Date' ;
    rdfs:comment 'Date the interpretation was authored.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interpretationStatus rdf:type rdf:Property ;
    rdfs:label 'Interpretation Status' ;
    rdfs:comment 'Current lifecycle status of the interpretation.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpretationSummary rdf:type rdf:Property ;
    rdfs:label 'Interpretation Summary' ;
    rdfs:comment 'Brief, human-readable summary of the genomic findings and their clinical relevance.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpretationText rdf:type rdf:Property ;
    rdfs:label 'Interpretation Text' ;
    rdfs:comment 'Full free-text narrative of the genomic interpretation.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpretationType rdf:type rdf:Property ;
    rdfs:label 'Interpretation Type' ;
    rdfs:comment 'Category describing the purpose of the interpretation.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpretationVersion rdf:type rdf:Property ;
    rdfs:label 'Interpretation Version' ;
    rdfs:comment 'Version of the interpretation document to support SCD Type 2 change tracking.' ;
    rdfs:domain ind:GenomicInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phenotypeRelevance rdf:type rdf:Property ;
    rdfs:label 'Phenotype Relevance' ;
    rdfs:comment 'Narrative linking the genomic result to observed patient phenotype(s).' ;
    rdfs:domain ind:GenomicInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedPathway rdf:type rdf:Property ;
    rdfs:label 'Recommended Pathway' ;
    rdfs:comment 'Suggested care pathway or guideline reference (e.g., NCCN, CPIC).' ;
    rdfs:domain ind:GenomicInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingEvidenceCodes rdf:type rdf:Property ;
    rdfs:label 'Supporting Evidence Codes' ;
    rdfs:comment 'Comma-separated list of standard codes (e.g., PMID, ClinVar IDs) that substantiate the interpretation.' ;
    rdfs:domain ind:GenomicInterpretation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:variantCount rdf:type rdf:Property ;
    rdfs:label 'Variant Count' ;
    rdfs:comment 'Number of distinct genomic variants considered in this interpretation.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Consenting Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Genetic testing informed consent requires documentation of which qualified clinician (genetic counselor/physician) explained risks and obtained consent. Regulatory requirement per state genetic testin' ;
    rdfs:domain ind:GenomicsGenomicConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:genomicConsentId rdf:type rdf:Property ;
    rdfs:label 'Genomic Consent Id' ;
    rdfs:comment 'Unique surrogate key for each genomic consent record.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicConsent .

ind:genomicsEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Genomics Employee Id' ;
    rdfs:comment 'Identifier of the system user who created the consent record.' ;
    rdfs:domain ind:GenomicsGenomicConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:givenBy rdf:type rdf:Property ;
    rdfs:label 'Given By' ;
    rdfs:comment 'Name of the individual (patient or legal guardian) who provided the consent.' ;
    rdfs:domain ind:GenomicsGenomicConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originatingDiagnosisId rdf:type rdf:Property ;
    rdfs:label 'Originating Diagnosis Id' ;
    rdfs:comment 'Foreign key linking to clinical.diagnosis. Business justification: CMS bundled payment models (BPCI-A) and readmission penalty programs require linking PAC episodes to the acute-care discharge diagnosis that triggered post-acute placement. Essential for episode-based' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Diagnosis .

ind:originatingDrgId rdf:type rdf:Property ;
    rdfs:label 'Originating Drg Id' ;
    rdfs:comment 'Foreign key linking to reference.drg. Business justification: CMS Bundled Payments for Care Improvement (BPCI) requires linking post-acute episodes to the originating acute-care DRG for episode-based payment reconciliation and cost benchmarking.' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Drg .

ind:comorbidities rdf:type rdf:Property ;
    rdfs:label 'Comorbidities' ;
    rdfs:comment 'Comma-separated list of additional diagnoses relevant to the episode.' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:episodeGoal rdf:type rdf:Property ;
    rdfs:label 'Episode Goal' ;
    rdfs:comment 'Narrative description of the clinical goal for the episode.' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:episodeStatus rdf:type rdf:Property ;
    rdfs:label 'Episode Status' ;
    rdfs:comment 'Current lifecycle state of the episode.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalStatusScore rdf:type rdf:Property ;
    rdfs:label 'Functional Status Score' ;
    rdfs:comment 'Add pii_phi, pii_pii, pii_sensitive tags for PHI compliance' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isEligibleForQualityMeasure rdf:type rdf:Property ;
    rdfs:label 'Is Eligible For Quality Measure' ;
    rdfs:comment 'Flag indicating if the episode qualifies for quality reporting.' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEligibleForReimbursement rdf:type rdf:Property ;
    rdfs:label 'Is Eligible For Reimbursement' ;
    rdfs:comment 'Flag indicating if the episode meets payer reimbursement criteria.' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netResponsibility rdf:type rdf:Property ;
    rdfs:label 'Net Responsibility' ;
    rdfs:comment 'Remaining amount owed after payments (patient responsibility).' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryProcedureCode rdf:type rdf:Property ;
    rdfs:label 'Primary Procedure Code' ;
    rdfs:comment 'Main procedure performed during the episode, coded per CPT.' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMeasureScore rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Score' ;
    rdfs:comment 'Score derived from quality metrics applicable to the episode.' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readmissionWithin30Days rdf:type rdf:Property ;
    rdfs:label 'Readmission Within 30 Days' ;
    rdfs:comment 'True if readmission occurred within 30 days of discharge.' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementAmount rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Amount' ;
    rdfs:comment 'Amount approved for reimbursement by the payer.' ;
    rdfs:domain ind:PostAcuteEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:genomicSampleSpecimenId rdf:type rdf:Property ;
    rdfs:label 'Genomic Sample Specimen Id' ;
    rdfs:comment 'Laboratory accession number for the specimen.' ;
    rdfs:domain ind:GenomicTestResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specimen .

ind:genomicSpecimenId rdf:type rdf:Property ;
    rdfs:label 'Genomic Specimen Id' ;
    rdfs:comment 'Foreign key linking to laboratory.specimen. Business justification: Genomic test results must be directly traceable to the specimen for chain-of-custody compliance, quality investigations, and CAP/CLIA accreditation audits. Direct specimen linkage on results is standa' ;
    rdfs:domain ind:GenomicTestResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specimen .

ind:genomicsReportId rdf:type rdf:Property ;
    rdfs:label 'Genomics Report Id' ;
    rdfs:comment 'Identifier assigned by an external genomics vendor.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicsReport .

ind:performingCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Performing Care Site Id' ;
    rdfs:comment 'Foreign key linking to facility.care_site. Business justification: Genomic tests are performed at CLIA-certified lab sites distinct from ordering facilities. Regulatory compliance (CLIA, CAP) requires tracking which certified site performed each test for accreditatio' ;
    rdfs:domain ind:GenomicTestResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:coverageDepth rdf:type rdf:Property ;
    rdfs:label 'Coverage Depth' ;
    rdfs:comment 'Average read depth across the sequenced regions.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConfirmed rdf:type rdf:Property ;
    rdfs:label 'Is Confirmed' ;
    rdfs:comment 'Indicates whether the result has been clinically validated and signed off.' ;
    rdfs:domain ind:GenomicTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRetestNeeded rdf:type rdf:Property ;
    rdfs:label 'Is Retest Needed' ;
    rdfs:comment 'True if additional testing is recommended based on the result.' ;
    rdfs:domain ind:GenomicTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultCode rdf:type rdf:Property ;
    rdfs:label 'Result Code' ;
    rdfs:comment 'System-generated alphanumeric code identifying the specific test result.' ;
    rdfs:domain ind:GenomicTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultDate rdf:type rdf:Property ;
    rdfs:label 'Result Date' ;
    rdfs:comment 'Timestamp when the final result was released to the ordering clinician.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultDescription rdf:type rdf:Property ;
    rdfs:label 'Result Description' ;
    rdfs:comment 'Free-text narrative describing the overall outcome of the genomic test.' ;
    rdfs:domain ind:GenomicTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultVersion rdf:type rdf:Property ;
    rdfs:label 'Result Version' ;
    rdfs:comment 'Version number of the result record to support SCD Type 2 changes.' ;
    rdfs:domain ind:GenomicTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:turnaroundTimeDays rdf:type rdf:Property ;
    rdfs:label 'Turnaround Time Days' ;
    rdfs:comment 'Number of calendar days from specimen receipt to result release.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicQualityControlId rdf:type rdf:Property ;
    rdfs:label 'Genomic Quality Control Id' ;
    rdfs:comment 'Unique identifier for the genomic quality control metric. _canonical_skip_reason: Inferred role REFERENCE_LOOKUP; no minimum categories required.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acceptableRangeLower rdf:type rdf:Property ;
    rdfs:label 'Acceptable Range Lower' ;
    rdfs:comment 'Lower bound of the acceptable range for the metric.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acceptableRangeUpper rdf:type rdf:Property ;
    rdfs:label 'Acceptable Range Upper' ;
    rdfs:comment 'Upper bound of the acceptable range for the metric.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicablePlatform rdf:type rdf:Property ;
    rdfs:label 'Applicable Platform' ;
    rdfs:comment 'Sequencing platform(s) to which the metric applies.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableSampleType rdf:type rdf:Property ;
    rdfs:label 'Applicable Sample Type' ;
    rdfs:comment 'Sample material types for which the metric is valid.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableSequencingType rdf:type rdf:Property ;
    rdfs:label 'Applicable Sequencing Type' ;
    rdfs:comment 'Sequencing assay types for which the metric is relevant.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicQualityControlStatus rdf:type rdf:Property ;
    rdfs:label 'Genomic Quality Control Status' ;
    rdfs:comment 'Current lifecycle status of the metric definition.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricCategory rdf:type rdf:Property ;
    rdfs:label 'Metric Category' ;
    rdfs:comment 'High-level classification of the metric type.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricDescription rdf:type rdf:Property ;
    rdfs:label 'Metric Description' ;
    rdfs:comment 'Detailed description of what the metric measures and its clinical relevance.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricType rdf:type rdf:Property ;
    rdfs:label 'Metric Type' ;
    rdfs:comment 'Data type of the metric value.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationMethod rdf:type rdf:Property ;
    rdfs:label 'Validation Method' ;
    rdfs:comment 'Method used to validate the metric definition.' ;
    rdfs:domain ind:GenomicQualityControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicSequenceId rdf:type rdf:Property ;
    rdfs:label 'Genomic Sequence Id' ;
    rdfs:comment 'Unique surrogate key for the genomic sequence record.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicSequence .

ind:alignmentParameters rdf:type rdf:Property ;
    rdfs:label 'Alignment Parameters' ;
    rdfs:comment 'Command-line parameters used for alignment.' ;
    rdfs:domain ind:GenomicsGenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alignmentTool rdf:type rdf:Property ;
    rdfs:label 'Alignment Tool' ;
    rdfs:comment 'Software tool used for aligning reads to reference.' ;
    rdfs:domain ind:GenomicsGenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assayType rdf:type rdf:Property ;
    rdfs:label 'Assay Type' ;
    rdfs:comment 'Laboratory assay performed for sequencing.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveTo rdf:type rdf:Property ;
    rdfs:label 'Effective To' ;
    rdfs:comment 'Timestamp when this version was superseded (null if current).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileFormat rdf:type rdf:Property ;
    rdfs:label 'File Format' ;
    rdfs:comment 'Standard file format of the genomic data.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicBuildVersion rdf:type rdf:Property ;
    rdfs:label 'Genomic Build Version' ;
    rdfs:comment 'Version of the genomic build used for alignment.' ;
    rdfs:domain ind:GenomicsGenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicsGenomicSequenceStatus rdf:type rdf:Property ;
    rdfs:label 'Genomics Genomic Sequence Status' ;
    rdfs:comment 'Current lifecycle status of the sequence record.' ;
    rdfs:domain ind:GenomicsGenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimarySequence rdf:type rdf:Property ;
    rdfs:label 'Is Primary Sequence' ;
    rdfs:comment 'Indicates if this sequence is the primary reference for the patient.' ;
    rdfs:domain ind:GenomicsGenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privacyClassification rdf:type rdf:Property ;
    rdfs:label 'Privacy Classification' ;
    rdfs:comment 'Classification level for privacy compliance.' ;
    rdfs:domain ind:GenomicsGenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityScoreMean rdf:type rdf:Property ;
    rdfs:label 'Quality Score Mean' ;
    rdfs:comment 'Average base quality score (Phred) across reads.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readLengthMean rdf:type rdf:Property ;
    rdfs:label 'Read Length Mean' ;
    rdfs:comment 'Average length of reads in base pairs.' ;
    rdfs:domain ind:GenomicsGenomicSequence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sequenceType rdf:type rdf:Property ;
    rdfs:label 'Sequence Type' ;
    rdfs:comment 'Category of the sequence data indicating processing stage.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequencingDate rdf:type rdf:Property ;
    rdfs:label 'Sequencing Date' ;
    rdfs:comment 'Date when the sequencing run was performed.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sequencingPlatform rdf:type rdf:Property ;
    rdfs:label 'Sequencing Platform' ;
    rdfs:comment 'Technology platform used to generate the sequence.' ;
    rdfs:domain ind:Genomics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precisionTrialEnrollId rdf:type rdf:Property ;
    rdfs:label 'Precision Trial Enroll Id' ;
    rdfs:comment 'Unique surrogate key for each precision trial enrollment record.' ;
    rdfs:domain ind:PrecisionTrialEnroll ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:researchClinicalTrialMatchingEligibilityEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Research Clinical Trial Matching Eligibility Evaluation Id' ;
    rdfs:comment 'Foreign key linking to research_clinical_trial_matching.eligibility_evaluation. Business justification: Precision trial enrollment must reference the eligibility evaluation that qualified the patient. Required for audit trails, regulatory compliance (21 CFR Part 11), and ensuring enrollment decisions ar' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchClinicalTrialMatchingEligibilityEvaluation .

ind:randomizationGroup rdf:type rdf:Property ;
    rdfs:label 'Randomization Group' ;
    rdfs:comment 'Assigned randomization arm for the patient.' ;
    rdfs:domain ind:PrecisionTrialEnroll ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicOrderingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Genomic Ordering Clinician Id' ;
    rdfs:comment 'FK to provider.clinician' ;
    rdfs:domain ind:GenomicReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryGenomicClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Genomic Clinician Id' ;
