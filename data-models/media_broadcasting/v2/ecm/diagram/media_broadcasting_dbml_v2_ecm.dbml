  record_label_name varchar [note: 'Record label name']
  recording_date date [note: 'Date of recording']
  recording_title varchar [note: 'Recording title (may differ from composition)']
  release_date date [note: 'Original release date']
  sample_rate_hz varchar [note: 'Sample rate in Hz']
  sample_rate_khz decimal [note: 'Sample rate in kHz']
  source_code varchar [note: 'Original record ID in source system']
  territory_of_origin varchar [note: 'ISO country code of recording origin']
  territory_of_recording varchar [note: 'Country/territory where recorded']
  title varchar [note: 'Recording title (may differ from composition)']
  updated_at timestamp [note: 'Record last update timestamp']
  version_type varchar [note: 'Version type: ORIGINAL, REMIX, LIVE, ACOUSTIC, etc.']

  Note: 'Master recording representing a specific recorded performance with ISRC identifier, distinct from composition for rights management'
}

Table content.release {
