insurance,plan_management,health_plan,formulary_id,formulary_id,Formulary ID,BIGINT,,pharmacy.formulary.formulary_id,,,master_data,"Reference to the drug formulary tier structure that defines covered medications, tier placement, and cost-sharing for this plan.",
insurance,plan_management,health_plan,payer_id,payer_id,Payer ID,BIGINT,,insurance.payer.payer_id,,,master_data,Reference to the insurance payer organization that underwrites or administers this health plan.,
insurance,plan_management,health_plan,predecessor_health_plan_id,predecessor_health_plan_id,Predecessor Health Plan Id,BIGINT,,insurance.health_plan.health_plan_id,"dbx_self_ref_fk,restricted,pii",,master_data,Self-referencing FK on health_plan (predecessor_health_plan_id),
insurance,plan_management,health_plan,provider_network_id,provider_network_id,Provider Network ID,BIGINT,,insurance.provider_network.provider_network_id,,,master_data,"Reference to the provider network that defines in-network and out-of-network providers, facilities, and pharmacies for this plan.",
insurance,plan_management,health_plan,benefit_year,benefit_year,Benefit Year,INT,,,,,master_data,The calendar year for which this plan configuration and benefit structure are effective. Used to track annual plan changes and benefit resets.,
insurance,plan_management,health_plan,cms_contract_number,cms_contract_number,Centers for Medicare and Medicaid Services (CMS) Contract Number,STRING,,,,,master_data,"The unique contract identifier assigned by CMS for Medicare Advantage, Medicare Part D, or Medicaid managed care plans. Used for regulatory reporting and plan identification.",
insurance,plan_management,health_plan,cob_order,cob_order,Coordination of Benefits (COB) Order,STRING,,,,Primary|Secondary|Tertiary,master_data,"The order in which this plan pays when a member has multiple insurance coverages. Primary pays first, Secondary pays after primary, Tertiary pays after secondary. Used for COB adjudication logic.",
insurance,plan_management,health_plan,coinsurance_percentage,coinsurance_percentage,Coinsurance Percentage,"DECIMAL(5,2)",,,,,master_data,"The percentage of allowed charges that the member is responsible for paying after the deductible is met. Expressed as a percentage (e.g., 20.00 for 20% member responsibility).",
insurance,plan_management,health_plan,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,master_data,The timestamp when this health plan record was first created in the system. Used for audit trail and data lineage tracking.,
insurance,plan_management,health_plan,effective_date,effective_date,Plan Effective Date,DATE,,,,,master_data,The date on which this health plan configuration becomes active and available for member enrollment and coverage. Typically aligns with benefit year start or employer plan year start.,
insurance,plan_management,health_plan,emergency_room_copay_amount,emergency_room_copay_amount,Emergency Room (ER) Copay Amount,"DECIMAL(10,2)",,,,,master_data,The fixed dollar amount in USD that a member pays for an emergency department visit. May be waived if admitted. Null if the plan uses coinsurance instead of copay.,
insurance,plan_management,health_plan,facility_service_area_description,facility_service_area_description,Service Area Description,STRING,,,,,master_data,"A textual description of the geographic service area where this plan is available, typically defined by counties, ZIP codes, or metropolitan areas.",
insurance,plan_management,health_plan,family_deductible_amount,family_deductible_amount,Family Deductible Amount,"DECIMAL(12,2)",,,,,master_data,The annual deductible amount in USD that a family unit must collectively pay out-of-pocket before the plan begins cost-sharing for covered services.,
insurance,plan_management,health_plan,family_oop_max_amount,family_oop_max_amount,Family Out-of-Pocket (OOP) Maximum Amount,"DECIMAL(12,2)",,,,,master_data,"The annual maximum amount in USD that a family unit will collectively pay out-of-pocket for covered services. After reaching this limit, the plan pays 100% of covered costs for the remainder of the benefit year.",
insurance,plan_management,health_plan,fsa_eligible,fsa_eligible,Flexible Spending Account (FSA) Eligible,BOOLEAN,,,,,master_data,Indicates whether this plan allows members to participate in a Flexible Spending Account for pre-tax healthcare or dependent care expenses.,
insurance,plan_management,health_plan,funding_type,funding_type,Funding Type,STRING,,,,Fully Insured|Self-Funded|Level Funded|Partially Self-Funded,master_data,The financial arrangement model for the plan. Fully Insured means the payer assumes all risk; Self-Funded means the employer assumes risk and payer provides administrative services only (ASO); Level Funded is a hybrid with predictable monthly costs; Partially Self-Funded shares risk between employer and payer.,
insurance,plan_management,health_plan,group_number,group_number,Group Number,STRING,,,,,master_data,"The group identifier assigned to employer-sponsored or association-based plans, used for member eligibility verification and claims adjudication.",
insurance,plan_management,health_plan,hra_eligible,hra_eligible,Health Reimbursement Arrangement (HRA) Eligible,BOOLEAN,,,,,master_data,Indicates whether this plan is paired with an employer-funded Health Reimbursement Arrangement that reimburses employees for qualified medical expenses.,
insurance,plan_management,health_plan,hsa_eligible,hsa_eligible,Health Savings Account (HSA) Eligible,BOOLEAN,,,,,master_data,"Indicates whether this plan is HSA-qualified, meaning it meets IRS requirements for high-deductible health plans that allow members to contribute to a tax-advantaged Health Savings Account.",
insurance,plan_management,health_plan,individual_deductible_amount,individual_deductible_amount,Individual Deductible Amount,"DECIMAL(12,2)",,,,,master_data,The annual deductible amount in USD that an individual member must pay out-of-pocket before the plan begins cost-sharing for covered services.,
insurance,plan_management,health_plan,individual_oop_max_amount,individual_oop_max_amount,Individual Out-of-Pocket (OOP) Maximum Amount,"DECIMAL(12,2)",,,,,master_data,"The annual maximum amount in USD that an individual member will pay out-of-pocket for covered services. After reaching this limit, the plan pays 100% of covered costs for the remainder of the benefit year.",
insurance,plan_management,health_plan,inpatient_hospital_copay_amount,inpatient_hospital_copay_amount,Inpatient Hospital Copay Amount,"DECIMAL(10,2)",,,,,master_data,The fixed dollar amount in USD that a member pays per inpatient hospital admission or per day. Null if the plan uses coinsurance instead of copay.,
insurance,plan_management,health_plan,issuer_state,issuer_state,Issuer State,STRING,,,,,master_data,The two-letter state code where this health plan is issued and regulated. Used for multi-state payers to track jurisdiction-specific plan configurations.,
insurance,plan_management,health_plan,metal_tier,metal_tier,Metal Tier,STRING,,,,Bronze|Silver|Gold|Platinum|Catastrophic|Not Applicable,master_data,"The actuarial value tier for ACA (Affordable Care Act) marketplace plans indicating the percentage of covered healthcare costs the plan pays on average. Bronze (60%), Silver (70%), Gold (80%), Platinum (90%), Catastrophic (minimal coverage for under-30 or hardship exemption). Not Applicable for non-ACA plans.",
insurance,plan_management,health_plan,open_enrollment_end_date,open_enrollment_end_date,Open Enrollment End Date,DATE,,,,,master_data,The last date of the annual open enrollment period during which eligible individuals can enroll in or change their health plan selection without a qualifying life event.,
insurance,plan_management,health_plan,open_enrollment_start_date,open_enrollment_start_date,Open Enrollment Start Date,DATE,,,,,master_data,The first date of the annual open enrollment period during which eligible individuals can enroll in or change their health plan selection without a qualifying life event.,
insurance,plan_management,health_plan,out_of_network_coverage,out_of_network_coverage,Out-of-Network Coverage Available,BOOLEAN,,,,,master_data,"Indicates whether this plan provides any coverage for out-of-network providers and facilities. True for PPO and POS plans, false for HMO and EPO plans (except emergency services).",
insurance,plan_management,health_plan,out_of_network_deductible_amount,out_of_network_deductible_amount,Out-of-Network Individual Deductible Amount,"DECIMAL(12,2)",,,,,master_data,The annual deductible amount in USD for out-of-network services. Typically higher than in-network deductible. Null if plan does not cover out-of-network services.,
insurance,plan_management,health_plan,out_of_network_oop_max_amount,out_of_network_oop_max_amount,Out-of-Network Individual Out-of-Pocket (OOP) Maximum Amount,"DECIMAL(12,2)",,,,,master_data,The annual maximum out-of-pocket amount in USD for out-of-network services. Typically higher than in-network OOP max. Null if plan does not cover out-of-network services.,
insurance,plan_management,health_plan,plan_document_url,plan_document_url,Plan Document Uniform Resource Locator (URL),STRING,,,,,master_data,"The web URL where the official plan document, Summary of Benefits and Coverage (SBC), or Evidence of Coverage (EOC) can be accessed by members and providers.",
insurance,plan_management,health_plan,plan_identifier,plan_identifier,Health Plan Identifier,STRING,,,,,master_data,"The externally-recognized unique identifier for this plan. May be HIOS (Health Insurance Oversight System) Plan ID for ACA marketplace plans, CMS contract number for Medicare Advantage or Part D plans, or state-assigned Medicaid plan ID.",
insurance,plan_management,health_plan,plan_name,plan_name,Health Plan Name,STRING,,,,,master_data,"pii_phi,pii_pii,pii_sensitive",
insurance,plan_management,health_plan,plan_status,plan_status,Health Plan Status,STRING,,,,Active|Suspended|Terminated|Pending Approval|Grandfathered|Closed to New Enrollment,master_data,The current lifecycle status of the health plan. Active means the plan is currently offered and accepting enrollments; Suspended means temporarily unavailable; Terminated means no longer offered; Pending Approval means awaiting regulatory approval; Grandfathered means exempt from certain ACA requirements; Closed to New Enrollment means existing members can renew but new members cannot enroll.,
insurance,plan_management,health_plan,plan_type,plan_type,Health Plan Type,STRING,,,,,master_data,The structural type of the health plan indicating network and coverage model. HMO (Health Maintenance Organization) requires PCP and referrals; PPO (Preferred Provider Organization) allows out-of-network care; EPO (Exclusive Provider Organization) requires in-network only; POS (Point of Service) hybrid model; HDHP (High Deductible Health Plan) paired with HSA; Medicare Advantage (MA) for Medicare beneficiaries; Medicare Part D for prescription drug coverage; Medicaid Managed Care for state Medicaid programs; CHIP (Childrens Health Insurance Program); Self-Funded for employer-administered plans. [ENUM-REF-CANDIDATE: HMO|PPO|EPO|POS|HDHP|Medicare Advantage|Medicare Part D|Medicaid Managed Care|CHIP|Self-Funded — 10 candidates stripped; promote to reference product],
insurance,plan_management,health_plan,prescription_tier1_copay_amount,prescription_tier1_copay_amount,Prescription Drug Tier 1 Copay Amount,"DECIMAL(10,2)",,,"dbx_restricted, dbx_pii_health",,master_data,The fixed dollar amount in USD that a member pays for a Tier 1 (typically generic) prescription drug. Null if the plan uses coinsurance for pharmacy benefits.,
insurance,plan_management,health_plan,prescription_tier2_copay_amount,prescription_tier2_copay_amount,Prescription Drug Tier 2 Copay Amount,"DECIMAL(10,2)",,,"dbx_restricted, dbx_pii_health",,master_data,The fixed dollar amount in USD that a member pays for a Tier 2 (typically preferred brand) prescription drug. Null if the plan uses coinsurance for pharmacy benefits.,
insurance,plan_management,health_plan,prescription_tier3_copay_amount,prescription_tier3_copay_amount,Prescription Drug Tier 3 Copay Amount,"DECIMAL(10,2)",,,"dbx_restricted, dbx_pii_health",,master_data,The fixed dollar amount in USD that a member pays for a Tier 3 (typically non-preferred brand) prescription drug. Null if the plan uses coinsurance for pharmacy benefits.,
insurance,plan_management,health_plan,prescription_tier4_copay_amount,prescription_tier4_copay_amount,Prescription Drug Tier 4 Copay Amount,"DECIMAL(10,2)",,,"dbx_restricted, dbx_pii_health",,master_data,The fixed dollar amount in USD that a member pays for a Tier 4 (typically specialty) prescription drug. Null if the plan uses coinsurance for pharmacy benefits.,
insurance,plan_management,health_plan,preventive_care_covered,preventive_care_covered,Preventive Care Covered at 100%,BOOLEAN,,,,,master_data,"Indicates whether preventive care services (annual physicals, immunizations, screenings) are covered at 100% with no member cost-sharing, as required by ACA for non-grandfathered plans.",
insurance,plan_management,health_plan,primary_care_copay_amount,primary_care_copay_amount,Primary Care Physician (PCP) Copay Amount,"DECIMAL(10,2)",,,,,master_data,The fixed dollar amount in USD that a member pays for a primary care physician office visit. Null if the plan uses coinsurance instead of copay.,
insurance,plan_management,health_plan,prior_authorization_required,prior_authorization_required,Prior Authorization Required,BOOLEAN,,,,,master_data,"Indicates whether this plan requires prior authorization for certain services, procedures, or medications. When true, members or providers must obtain approval before services are rendered to ensure coverage.",
insurance,plan_management,health_plan,requires_pcp_selection,requires_pcp_selection,Requires Primary Care Physician (PCP) Selection,BOOLEAN,,,,,master_data,"Indicates whether members are required to select and maintain a designated primary care physician. Typically true for HMO and POS plans, false for PPO and EPO plans.",
insurance,plan_management,health_plan,requires_referral_for_specialist,requires_referral_for_specialist,Requires Referral for Specialist,BOOLEAN,,,,,master_data,"Indicates whether members must obtain a referral from their PCP before seeing a specialist. Typically true for HMO plans, false for PPO, EPO, and POS plans.",
insurance,plan_management,health_plan,specialist_copay_amount,specialist_copay_amount,Specialist Copay Amount,"DECIMAL(10,2)",,,,,master_data,The fixed dollar amount in USD that a member pays for a specialist physician office visit. Null if the plan uses coinsurance instead of copay.,
insurance,plan_management,health_plan,state_filing_number,state_filing_number,State Insurance Department Filing Number,STRING,,,,,master_data,The unique filing or approval number assigned by the state insurance department for this health plan product. Required for regulatory compliance and rate filings.,
insurance,plan_management,health_plan,termination_date,termination_date,Plan Termination Date,DATE,,,,,master_data,The date on which this health plan configuration is terminated and no longer available for coverage. Null for active plans with no planned termination.,
insurance,plan_management,health_plan,updated_timestamp,updated_timestamp,Record Updated Timestamp,TIMESTAMP,,,,,master_data,The timestamp when this health plan record was last modified in the system. Used for audit trail and change tracking.,
insurance,plan_management,health_plan,urgent_care_copay_amount,urgent_care_copay_amount,Urgent Care Copay Amount,"DECIMAL(10,2)",,,,,master_data,The fixed dollar amount in USD that a member pays for an urgent care facility visit. Null if the plan uses coinsurance instead of copay.,
insurance,plan_management,insurance_coverage_policy,insurance_coverage_policy_id,insurance_coverage_policy_id,Coverage Policy ID,BIGINT,Y,,,,master_data,"Add pii_phi, pii_pii, pii_sensitive tags for PHI compliance",
insurance,plan_management,insurance_coverage_policy,compliance_policy_id,compliance_policy_id,Compliance Policy Id (Foreign Key),BIGINT,,compliance.compliance_policy.compliance_policy_id,,,master_data,"Foreign key linking to compliance.policy. Business justification: Payer coverage policies must align with organizational compliance policies governing experimental treatment, off-label use, investigational devices, and regulatory coverage requirements. This linkage ",
insurance,plan_management,insurance_coverage_policy,cpt_code_id,cpt_code_id,Cpt Code Id (Foreign Key),BIGINT,,reference.cpt_code.cpt_code_id,,,master_data,"Foreign key linking to reference.cpt_code. Business justification: Coverage policies define medical necessity criteria for specific CPT procedures. Current text field applicable_cpt_codes should be normalized to proper FK for policy enforcement, prior authorization",
insurance,plan_management,insurance_coverage_policy,drg_id,drg_id,Drg Id (Foreign Key),BIGINT,,reference.drg.drg_id,,,master_data,"Foreign key linking to reference.drg. Business justification: Coverage policies define payment rules and authorization requirements for specific DRGs in inpatient settings. Critical for bundled payment administration, outlier payment calculation, and hospital co",
insurance,plan_management,insurance_coverage_policy,hcpcs_code_id,hcpcs_code_id,Hcpcs Code Id (Foreign Key),BIGINT,,reference.hcpcs_code.hcpcs_code_id,,,master_data,"Foreign key linking to reference.hcpcs_code. Business justification: Coverage policies govern HCPCS code reimbursement and authorization requirements. Denormalized text field applicable_hcpcs_codes should be proper FK for policy administration, utilization management",
insurance,plan_management,insurance_coverage_policy,health_plan_id,health_plan_id,Health Plan ID,BIGINT,,insurance.health_plan.health_plan_id,"dbx_restricted, dbx_pii",,master_data,Reference to the specific health plan under which this coverage policy applies.,
insurance,plan_management,insurance_coverage_policy,icd_code_id,icd_code_id,Icd Code Id (Foreign Key),BIGINT,,reference.icd_code.icd_code_id,,,master_data,"Foreign key linking to reference.icd_code. Business justification: Coverage policies specify diagnosis criteria for medical necessity. Text field applicable_icd10_codes should be normalized FK for automated policy evaluation, clinical documentation requirements, an",
insurance,plan_management,insurance_coverage_policy,payer_id,payer_id,Payer ID,BIGINT,,insurance.payer.payer_id,,,master_data,Reference to the insurance payer or health plan that owns this coverage policy.,
insurance,plan_management,insurance_coverage_policy,required_consent_form_template_id,required_consent_form_template_id,Required Consent Form Template Id (Foreign Key),BIGINT,,consent.consent_form_template.consent_form_template_id,,,master_data,"Foreign key linking to consent.consent_form_template. Business justification: Coverage policies define consent documentation requirements for specific procedures/services (e.g., sterilization consent, experimental treatment consent). Medical policy enforcement requires linking ",
insurance,plan_management,insurance_coverage_policy,specialty_id,specialty_id,Specialty Id (Foreign Key),BIGINT,,provider.specialty.specialty_id,,,master_data,"Foreign key linking to provider.specialty. Business justification: Medical policies define coverage criteria by specialty (e.g., orthopedic surgery criteria, cardiology device policies). Essential for claims adjudication, medical necessity determination, and specialt",
insurance,plan_management,insurance_coverage_policy,superseded_by_coverage_policy_insurance_coverage_policy_id,superseded_by_coverage_policy_insurance_coverage_policy_id,Superseded By Policy ID,BIGINT,,insurance.insurance_coverage_policy.insurance_coverage_policy_id,,,master_data,Reference to the coverage policy that replaces this policy when it is retired or superseded. Nullable if the policy is still active or has not been replaced.,
insurance,plan_management,insurance_coverage_policy,taxonomy_id,taxonomy_id,Provider Taxonomy Id (Foreign Key),BIGINT,,provider.taxonomy.taxonomy_id,,,master_data,"Foreign key linking to provider.provider_taxonomy. Business justification: Coverage policies reference taxonomy codes for provider type restrictions (e.g., only board-certified surgeons, only licensed clinical psychologists). Critical for claims auto-adjudication and provide",
insurance,plan_management,insurance_coverage_policy,age_restrictions,age_restrictions,Age Restrictions,STRING,,,,,master_data,"Age-based limitations or requirements for coverage under this policy (e.g., covered for patients 18 years and older, pediatric use only).",
insurance,plan_management,insurance_coverage_policy,appeals_allowed,appeals_allowed,Appeals Allowed,BOOLEAN,,,,,master_data,Indicates whether coverage denials based on this policy can be appealed by the provider or patient. True = appeals allowed; False = no appeals allowed.,
insurance,plan_management,insurance_coverage_policy,appeals_process_description,appeals_process_description,Appeals Process Description,STRING,,,,,master_data,"Detailed description of the appeals process for coverage denials based on this policy, including timelines, required documentation, and contact information.",
insurance,plan_management,insurance_coverage_policy,approval_date,approval_date,Policy Approval Date,DATE,,,,,master_data,Date on which the coverage policy was formally approved by the payers medical policy committee or equivalent governance body.,
insurance,plan_management,insurance_coverage_policy,approved_by,approved_by,Policy Approved By,STRING,,,,,master_data,Name or identifier of the individual or committee that approved the coverage policy.,
insurance,plan_management,insurance_coverage_policy,clinical_evidence_source,clinical_evidence_source,Clinical Evidence Source,STRING,,,,,master_data,"Reference to the clinical evidence, guidelines, or literature that supports the coverage determination (e.g., NCCN Guidelines, FDA approval, peer-reviewed clinical trial).",
insurance,plan_management,insurance_coverage_policy,coverage_determination,coverage_determination,Coverage Determination,STRING,,,,covered|non_covered|conditional|investigational|experimental|not_medically_necessary,master_data,"Final determination of whether the service, procedure, or technology is covered under this policy. Covered = reimbursable; Non-Covered = not reimbursable; Conditional = covered only if specific criteria met; Investigational/Experimental = not covered due to lack of evidence; Not Medically Necessary = does not meet medical necessity criteria.",
insurance,plan_management,insurance_coverage_policy,created_timestamp,created_timestamp,Created Timestamp,TIMESTAMP,,,,,master_data,Timestamp when the coverage policy record was first created in the system.,
insurance,plan_management,insurance_coverage_policy,effective_date,effective_date,Effective Date,DATE,,,,,master_data,Date on which the coverage policy becomes active and enforceable for claims adjudication and prior authorization decisions.,
insurance,plan_management,insurance_coverage_policy,exclusions,exclusions,Exclusions,STRING,,,,,master_data,"Specific services, procedures, diagnoses, or circumstances that are explicitly excluded from coverage under this policy.",
insurance,plan_management,insurance_coverage_policy,expiration_date,expiration_date,Expiration Date,DATE,,,,,master_data,Date on which the coverage policy ceases to be active. Nullable for policies with no defined end date.,
insurance,plan_management,insurance_coverage_policy,frequency_limitations,frequency_limitations,Frequency Limitations,STRING,,,,,master_data,"Limitations on how often the service or procedure can be performed and reimbursed within a specified time period (e.g., once per calendar year, maximum 12 visits per year).",
insurance,plan_management,insurance_coverage_policy,gender_restrictions,gender_restrictions,Gender Restrictions,STRING,,,"dbx_confidential, dbx_pii",,master_data,"Gender-based limitations or requirements for coverage under this policy (e.g., female patients only, male patients only, no gender restrictions).",
insurance,plan_management,insurance_coverage_policy,insurance_coverage_policy_category,insurance_coverage_policy_category,Policy Category,STRING,,,,,master_data,"High-level categorization of the coverage policy by clinical domain or service type (e.g., Radiology, Pharmacy, Surgical Procedures, Durable Medical Equipment).",
insurance,plan_management,insurance_coverage_policy,insurance_coverage_policy_description,insurance_coverage_policy_description,Policy Description,STRING,,,,,master_data,Cleaned boilerplate phrase from insurance.coverage_policy.policy_description,
insurance,plan_management,insurance_coverage_policy,insurance_coverage_policy_status,insurance_coverage_policy_status,Policy Status,STRING,,,,active|inactive|draft|under_review|retired|superseded,master_data,Current lifecycle status of the coverage policy. Active = in effect and enforceable; Inactive = temporarily suspended; Draft = not yet finalized; Under Review = being evaluated or updated; Retired = no longer in use; Superseded = replaced by a newer policy version.,
insurance,plan_management,insurance_coverage_policy,last_updated_date,last_updated_date,Last Updated Date,DATE,,,,,master_data,Date when the coverage policy was last modified or revised.,
insurance,plan_management,insurance_coverage_policy,medical_necessity_criteria,medical_necessity_criteria,Medical Necessity Criteria,STRING,,,"dbx_restricted, dbx_pii",,master_data,Clinical criteria defining when the service or procedure is considered medically necessary and therefore eligible for coverage under this policy.,
insurance,plan_management,insurance_coverage_policy,network_restrictions,network_restrictions,Network Restrictions,STRING,,,,in_network_only|out_of_network_allowed|no_restriction,master_data,Indicates whether the service or procedure must be performed by an in-network provider to be covered. In-Network Only = only in-network providers eligible; Out-of-Network Allowed = both in-network and out-of-network providers eligible (may have different reimbursement); No Restriction = network status does not affect coverage.,
insurance,plan_management,insurance_coverage_policy,place_of_service_restrictions,place_of_service_restrictions,Place of Service Restrictions,STRING,,,,,master_data,"Restrictions on where the service or procedure can be performed to be eligible for coverage (e.g., inpatient hospital only, outpatient facility or office, home health setting).",
insurance,plan_management,insurance_coverage_policy,policy_number,policy_number,Policy Number,STRING,,,,"^[A-Z0-9]{6,20}$",master_data,"pii_phi,pii_pii,pii_sensitive",
insurance,plan_management,insurance_coverage_policy,policy_owner,policy_owner,Policy Owner,STRING,,,,,master_data,Name or identifier of the individual or department responsible for maintaining and updating this coverage policy.,
insurance,plan_management,insurance_coverage_policy,policy_type,policy_type,Policy Type,STRING,,,,medical_policy|coverage_determination|lcd|ncd|administrative_policy|clinical_guideline,master_data,Classification of the coverage policy. Medical Policy = internal payer medical necessity policy; Coverage Determination = specific coverage decision; LCD = Local Coverage Determination (Medicare contractor-specific); NCD = National Coverage Determination (CMS national policy); Administrative Policy = non-clinical coverage rule; Clinical Guideline = evidence-based clinical criteria.,
insurance,plan_management,insurance_coverage_policy,prior_authorization_criteria,prior_authorization_criteria,Prior Authorization Criteria,STRING,,,,,master_data,Detailed clinical and administrative criteria that must be met to obtain prior authorization for the service or procedure covered by this policy.,
insurance,plan_management,insurance_coverage_policy,prior_authorization_required,prior_authorization_required,Prior Authorization Required,BOOLEAN,,,,,master_data,Indicates whether prior authorization is required before the service or procedure can be performed and reimbursed under this policy. True = prior authorization required; False = no prior authorization required.,
insurance,plan_management,insurance_coverage_policy,provider_specialty_restrictions,provider_specialty_restrictions,Provider Specialty Restrictions,STRING,,,,,master_data,"Restrictions on which provider specialties are authorized to perform the service or procedure under this policy (e.g., board-certified cardiologist only, licensed physical therapist).",
insurance,plan_management,insurance_coverage_policy,quantity_limitations,quantity_limitations,Quantity Limitations,STRING,,,,,master_data,"Limitations on the quantity or dosage of the service, supply, or medication that can be provided and reimbursed under this policy (e.g., maximum 30-day supply, up to 10 units per month).",
insurance,plan_management,insurance_coverage_policy,regulatory_basis,regulatory_basis,Regulatory Basis,STRING,,,,,master_data,"Reference to the regulatory or statutory basis for the coverage policy (e.g., CMS NCD 210.1, State Medicaid Manual Section 4.5, ACA Essential Health Benefits).",
insurance,plan_management,insurance_coverage_policy,review_date,review_date,Review Date,DATE,,,,,master_data,"Scheduled date for the next policy review or update cycle, ensuring the policy remains aligned with current clinical evidence and regulatory requirements.",
insurance,plan_management,insurance_coverage_policy,step_therapy_criteria,step_therapy_criteria,Step Therapy Criteria,STRING,,,,,master_data,"Detailed criteria defining the step therapy requirements, including which treatments must be tried first and the conditions under which step therapy can be bypassed.",
insurance,plan_management,insurance_coverage_policy,step_therapy_required,step_therapy_required,Step Therapy Required,BOOLEAN,,,,,master_data,Indicates whether step therapy (trial of less expensive or less invasive treatments first) is required before the service or procedure is covered. True = step therapy required; False = no step therapy required.,
insurance,plan_management,insurance_coverage_policy,title,title,Policy Title,STRING,,,,,master_data,"Human-readable title or name of the coverage policy, describing the service or condition covered.",
insurance,plan_management,insurance_coverage_policy,updated_timestamp,updated_timestamp,Updated Timestamp,TIMESTAMP,,,,,master_data,Timestamp when the coverage policy record was last updated in the system.,
insurance,plan_management,insurance_coverage_policy,version,version,Policy Version,STRING,,,,^[0-9]+.[0-9]+$,master_data,"Version number of the coverage policy, used to track revisions and updates over time (e.g., 1.0, 2.3).",
insurance,plan_management,insurance_formulary_tier,insurance_formulary_tier_id,insurance_formulary_tier_id,Formulary Tier Identifier (ID),BIGINT,Y,,,,master_data,Unique identifier for the formulary tier record. Primary key for the formulary tier entity.,
insurance,plan_management,insurance_formulary_tier,formulary_id,formulary_id,Formulary Identifier (ID),BIGINT,,pharmacy.formulary.formulary_id,,,master_data,Reference to the parent formulary that contains this tier structure. Links to the pharmacy formulary master data.,
insurance,plan_management,insurance_formulary_tier,health_plan_id,health_plan_id,Health Plan Identifier (ID),BIGINT,,insurance.health_plan.health_plan_id,"dbx_restricted, dbx_pii",,master_data,Reference to the health plan to which this formulary tier structure applies. Links to the health plan master data.,
insurance,plan_management,insurance_formulary_tier,ndc_drug_id,ndc_drug_id,Ndc Drug Id (Foreign Key),BIGINT,,reference.ndc_drug.ndc_drug_id,,,master_data,"Foreign key linking to reference.ndc_drug. Business justification: Formulary tiers assign specific NDC drugs to cost-sharing levels (tier 1-4). Essential for pharmacy benefit administration, member cost calculation, and formulary management in payer pharmacy operatio",
insurance,plan_management,insurance_formulary_tier,superseded_by_formulary_tier_insurance_formulary_tier_id,superseded_by_formulary_tier_insurance_formulary_tier_id,Superseded By Tier Identifier (ID),BIGINT,,insurance.insurance_formulary_tier.insurance_formulary_tier_id,,,master_data,Reference to the formulary tier record that replaces this tier structure. Used for tracking tier evolution and managing transitions during formulary updates. Null if this is the current active tier.,
insurance,plan_management,insurance_formulary_tier,cms_tier_category,cms_tier_category,Centers for Medicare and Medicaid Services (CMS) Tier Category,STRING,,,,,master_data,CMS-defined tier category classification for Medicare Part D reporting and compliance. Maps internal tier structure to CMS standard tier definitions for regulatory submissions.,
insurance,plan_management,insurance_formulary_tier,created_timestamp,created_timestamp,Created Timestamp,TIMESTAMP,,,,,master_data,Date and time when this formulary tier record was first created in the system. Used for audit trail and data lineage tracking.,
insurance,plan_management,insurance_formulary_tier,days_supply_mail_order,days_supply_mail_order,Days Supply Mail Order,INT,,,,,master_data,Standard number of days supply allowed per prescription fill for medications in this tier through mail order pharmacies. Typically 90 days to encourage mail order utilization.,
insurance,plan_management,insurance_formulary_tier,days_supply_standard,days_supply_standard,Days Supply Standard,INT,,,,,master_data,"Standard number of days supply allowed per prescription fill for medications in this tier at retail pharmacies. Common values are 30, 60, or 90 days.",
insurance,plan_management,insurance_formulary_tier,deductible_applies,deductible_applies,Deductible Applies,BOOLEAN,,,,,master_data,Indicates whether the plan deductible must be met before cost-sharing for this tier takes effect. True if deductible applies; False if tier cost-sharing is immediate.,
insurance,plan_management,insurance_formulary_tier,effective_date,effective_date,Effective Date,DATE,,,,,master_data,Date when this formulary tier structure becomes active and applicable for member cost-sharing calculations. Aligns with benefit year or mid-year formulary updates.,
insurance,plan_management,insurance_formulary_tier,mail_order_eligible,mail_order_eligible,Mail Order Eligible,BOOLEAN,,,,,master_data,"Indicates whether medications in this tier are eligible for mail order pharmacy fulfillment, typically with extended days supply and potentially different cost-sharing. True if mail order is available; False otherwise.",
insurance,plan_management,insurance_formulary_tier,member_coinsurance_percentage,member_coinsurance_percentage,Member Coinsurance Percentage,"DECIMAL(5,2)",,,,,master_data,Percentage of the drug cost the member pays for medications in this tier. Represents percentage-based cost-sharing structure. Null if flat copay applies instead.,
insurance,plan_management,insurance_formulary_tier,member_communication_text,member_communication_text,Member Communication Text,STRING,,,,,master_data,"Standardized text used in member-facing communications to explain this tier, including Summary of Benefits and Coverage (SBC) documents, formulary guides, and member portals.",
insurance,plan_management,insurance_formulary_tier,member_copay_amount,member_copay_amount,Member Copay Amount,"DECIMAL(10,2)",,,,,master_data,Fixed dollar amount the member pays per prescription fill for medications in this tier. Represents flat copayment cost-sharing structure. Null if coinsurance applies instead.,
insurance,plan_management,insurance_formulary_tier,notes,notes,Notes,STRING,,,,,master_data,"Free-text field for additional comments, special instructions, or contextual information about this formulary tier that does not fit into structured fields. Used for operational notes and exception documentation.",
insurance,plan_management,insurance_formulary_tier,out_of_pocket_applies,out_of_pocket_applies,Out-of-Pocket (OOP) Maximum Applies,BOOLEAN,,,,,master_data,Indicates whether member cost-sharing for this tier counts toward the annual out-of-pocket maximum. True if costs accumulate toward OOP max; False otherwise.,
insurance,plan_management,insurance_formulary_tier,preferred_tier_flag,preferred_tier_flag,Preferred Tier Flag,BOOLEAN,,,,,master_data,"Indicates whether this tier represents a preferred cost-sharing level, typically associated with lower member costs and plan-preferred medications. True for preferred tiers; False otherwise.",
insurance,plan_management,insurance_formulary_tier,preventive_tier_flag,preventive_tier_flag,Preventive Tier Flag,BOOLEAN,,,,,master_data,Indicates whether this tier is designated for preventive medications covered at zero or minimal cost-sharing under Affordable Care Act (ACA) preventive care requirements. True for preventive tiers; False otherwise.,
insurance,plan_management,insurance_formulary_tier,prior_authorization_required,prior_authorization_required,Prior Authorization (PA) Required,BOOLEAN,,,,,master_data,Indicates whether medications in this tier require prior authorization approval from the health plan before coverage is provided. True if PA is required; False otherwise.,
insurance,plan_management,insurance_formulary_tier,provider_communication_text,provider_communication_text,Provider Communication Text,STRING,,,,,master_data,"Standardized text used in provider-facing communications to explain this tier structure, cost-sharing rules, and utilization management requirements for prescribing decisions.",
insurance,plan_management,insurance_formulary_tier,quantity_limit_applies,quantity_limit_applies,Quantity Limit Applies,BOOLEAN,,,,,master_data,Indicates whether medications in this tier are subject to quantity limits per fill or per time period. True if quantity limits apply; False otherwise. Specific limits are defined at the drug level.,
insurance,plan_management,insurance_formulary_tier,regulatory_approval_date,regulatory_approval_date,Regulatory Approval Date,DATE,,,,,master_data,Date when the formulary tier structure received regulatory approval from CMS or other governing bodies. Null if no regulatory approval is required or if approval is pending.,
