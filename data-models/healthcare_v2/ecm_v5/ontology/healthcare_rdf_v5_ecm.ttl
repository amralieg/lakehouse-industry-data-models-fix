ind:batteryLevel rdf:type rdf:Property ;
    rdfs:label 'Battery Level' ;
    rdfs:comment 'Remaining battery percentage of the device when the reading was taken.' ;
    rdfs:domain ind:RpmReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:firmwareVersion rdf:type rdf:Property ;
    rdfs:label 'Firmware Version' ;
    rdfs:comment 'Software version running on the monitoring device.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementType rdf:type rdf:Property ;
    rdfs:label 'Measurement Type' ;
    rdfs:comment 'Clinical category of the measurement captured (e.g., heart rate, blood pressure).' ;
    rdfs:domain ind:RpmReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingStatus rdf:type rdf:Property ;
    rdfs:label 'Reading Status' ;
    rdfs:comment 'Lifecycle status of the reading after validation.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reading Timestamp' ;
    rdfs:comment 'Date and time when the measurement was taken by the device.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:signalQuality rdf:type rdf:Property ;
    rdfs:label 'Signal Quality' ;
    rdfs:comment 'Assessment of the raw signal integrity at the time of capture.' ;
    rdfs:domain ind:RpmReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentSchedulingAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Enrollment Scheduling Appointment Id' ;
    rdfs:comment 'Foreign key linking to scheduling.scheduling_appointment. Business justification: RPM device setup/training visits are billed under CPT 99453. Programs must track which appointment initiated enrollment for billing compliance and device provisioning workflows.' ;
    rdfs:domain ind:RpmEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SchedulingAppointment .

ind:populationHealthCohortCohortDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Population Health Cohort Cohort Definition Id' ;
    rdfs:comment 'Foreign key linking to population_health_cohort.cohort_definition. Business justification: Value-based care workflow: population health teams identify at-risk cohorts (e.g., uncontrolled HbA1c) then enroll members into RPM programs. Tracking which cohort triggered enrollment supports progra' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PopulationHealthCohortCohortDefinition .

ind:populationHealthCohortMgmtCohortDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Population Health Cohort Mgmt Cohort Definition Id' ;
    rdfs:comment 'Foreign key linking to population_health_cohort_mgmt.cohort_definition. Business justification: Care managers enroll patients into RPM based on cohort qualification. Tracking which cohort qualified a patient for enrollment supports program effectiveness analysis, regulatory reporting, and ensure' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PopulationHealthCohortMgmtCohortDefinition .

ind:alertFrequency rdf:type rdf:Property ;
    rdfs:label 'Alert Frequency' ;
    rdfs:comment 'How often the system evaluates the threshold and generates alerts.' ;
    rdfs:domain ind:RpmEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertThresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Alert Threshold Unit' ;
    rdfs:comment 'Unit of measure for the alert threshold value.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Alert Threshold Value' ;
    rdfs:comment 'Numeric value that triggers an alert when the monitored measurement exceeds it.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deviceSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Device Serial Number' ;
    rdfs:comment 'Manufacturer serial number of the assigned monitoring device; used for warranty and support.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portalEngagementScore rdf:type rdf:Property ;
    rdfs:label 'Portal Engagement Score' ;
    rdfs:comment 'Composite score reflecting patient interaction frequency and depth within the portal.' ;
    rdfs:domain ind:RpmEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portalLastLogin rdf:type rdf:Property ;
    rdfs:label 'Portal Last Login' ;
    rdfs:comment 'Timestamp of the most recent patient login to the health portal.' ;
    rdfs:domain ind:RpmEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:promMeasureName rdf:type rdf:Property ;
    rdfs:label 'Prom Measure Name' ;
    rdfs:comment 'Name of the patient-reported outcome measure collected (e.g., pain_score, fatigue_level).' ;
    rdfs:domain ind:RpmEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promMeasureUnit rdf:type rdf:Property ;
    rdfs:label 'Prom Measure Unit' ;
    rdfs:comment 'Unit of the PROM value (e.g., score, mmHg).' ;
    rdfs:domain ind:RpmEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promMeasureValue rdf:type rdf:Property ;
    rdfs:label 'Prom Measure Value' ;
    rdfs:comment 'Numeric result reported by the patient for the selected PROM.' ;
    rdfs:domain ind:RpmEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Terminated Timestamp' ;
    rdfs:comment 'Timestamp when the enrollment was terminated, if applicable.' ;
    rdfs:domain ind:RpmEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignedDrugMasterId rdf:type rdf:Property ;
    rdfs:label 'Assigned Drug Master Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.drug_master. Business justification: OTP programs assign specific formulary medications (methadone, buprenorphine) per SAMHSA 42 CFR Part 8. Normalizing medication_assigned text to a drug_master FK enables formulary validation and dosing' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:otpEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Otp Enrollment Id' ;
    rdfs:comment 'System-generated unique identifier for each OTP enrollment record.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OtpEnrollment .

ind:otpOrgProviderId rdf:type rdf:Property ;
    rdfs:label 'Otp Org Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.org_provider. Business justification: OTPs are DEA/SAMHSA-certified organizational providers. Enrollment must link to the certified org for DEA compliance, SAMHSA certification tracking, CMS billing, and state licensing requirements.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgProvider .

ind:standingPrescriptionId rdf:type rdf:Property ;
    rdfs:label 'Standing Prescription Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.prescription. Business justification: OTP daily dosing requires a standing prescription for DEA Schedule II compliance. Linking enrollment to the active prescription enables take-home dose authorization and dispensing verification workflo' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Prescription .

ind:actualEndDate rdf:type rdf:Property ;
    rdfs:label 'Actual End Date' ;
    rdfs:comment 'Date the enrollment was actually closed or terminated.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseManagerNotes rdf:type rdf:Property ;
    rdfs:label 'Case Manager Notes' ;
    rdfs:comment 'Free-text notes entered by the case manager.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedEndDate rdf:type rdf:Property ;
    rdfs:label 'Expected End Date' ;
    rdfs:comment 'Planned termination date of the enrollment agreement, if known.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialResponsibility rdf:type rdf:Property ;
    rdfs:label 'Financial Responsibility' ;
    rdfs:comment 'Entity responsible for payment of OTP services.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaRetentionDate rdf:type rdf:Property ;
    rdfs:label 'Hipaa Retention Date' ;
    rdfs:comment 'Date after which the enrollment record may be archived or destroyed per HIPAA policy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUrineTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Urine Test Date' ;
    rdfs:comment 'Date of the most recent urine drug test.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicationAssigned rdf:type rdf:Property ;
    rdfs:label 'Medication Assigned' ;
    rdfs:comment 'Medication selected for opioid use disorder treatment.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationDosageMg rdf:type rdf:Property ;
    rdfs:label 'Medication Dosage Mg' ;
    rdfs:comment 'Prescribed daily dosage in milligrams.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicationEndDate rdf:type rdf:Property ;
    rdfs:label 'Medication End Date' ;
    rdfs:comment 'Date the medication regimen is scheduled to end or was discontinued.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicationStartDate rdf:type rdf:Property ;
    rdfs:label 'Medication Start Date' ;
    rdfs:comment 'Date the medication regimen began.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programTier rdf:type rdf:Property ;
    rdfs:label 'Program Tier' ;
    rdfs:comment 'Tier level indicating intensity of services provided to the patient.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urineTestRequired rdf:type rdf:Property ;
    rdfs:label 'Urine Test Required' ;
    rdfs:comment 'Indicates whether routine urine drug testing is required for the patient.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:urineTestSchedule rdf:type rdf:Property ;
    rdfs:label 'Urine Test Schedule' ;
    rdfs:comment 'Frequency of required urine drug tests.' ;
    rdfs:domain ind:BehavioralHealthOtpEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentId rdf:type rdf:Property ;
    rdfs:label 'Consent Id' ;
    rdfs:comment 'Reference to the patient consent record required for substance use treatment data sharing.' ;
    rdfs:domain ind:BehavioralHealthMatTreatment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cfr42Consent .

ind:matTreatmentId rdf:type rdf:Property ;
    rdfs:label 'Mat Treatment Id' ;
    rdfs:comment 'Unique surrogate key for each medication assisted treatment record.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MatTreatment .

ind:prescriberDeaRegistrationId rdf:type rdf:Property ;
    rdfs:label 'Prescriber Dea Registration Id' ;
    rdfs:comment 'Foreign key linking to provider.dea_registration. Business justification: MAT prescribing requires specific DEA X-waiver/OTP authorization. Direct link enables real-time compliance verification that prescriber holds appropriate controlled substance authority for buprenorphi' ;
    rdfs:domain ind:BehavioralHealthMatTreatment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DeaRegistration .

ind:administrationFrequency rdf:type rdf:Property ;
    rdfs:label 'Administration Frequency' ;
    rdfs:comment 'Scheduled frequency of medication administration.' ;
    rdfs:domain ind:BehavioralHealthMatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAmount rdf:type rdf:Property ;
    rdfs:label 'Billing Amount' ;
    rdfs:comment 'Charged amount for the treatment episode before adjustments.' ;
    rdfs:domain ind:BehavioralHealthMatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargeStatus rdf:type rdf:Property ;
    rdfs:label 'Discharge Status' ;
    rdfs:comment 'Final disposition of the patient after the treatment episode.' ;
