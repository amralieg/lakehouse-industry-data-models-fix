    rdfs:comment 'Standard turnaround time in hours for processing authorization requests for this service type, per regulatory and contractual requirements.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expeditedReviewAvailable rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Available' ;
    rdfs:comment 'Indicates whether expedited review is available for urgent/emergent requests for this service type.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresClinicalDocumentation rdf:type rdf:Property ;
    rdfs:label 'Requires Clinical Documentation' ;
    rdfs:comment 'Indicates whether clinical documentation (medical records, test results, physician notes) must be submitted with the authorization request.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
