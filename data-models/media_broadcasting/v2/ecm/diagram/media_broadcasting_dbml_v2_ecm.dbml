  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Deal memos reference the commissioning partner entity (studio, network, streamer) for deal tracking and relationship management. Critical for converting deal memos to long-form contracts and tracking  | Column partner_id (BIGINT) in partner.deal_memo']
