  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.regulatory_obligation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.regulatory_obligation']
  applicability_scope varchar [note: 'Business units, platforms, or services to which this obligation applies (e.g., linear TV, OTT platforms, radio, digital publishers, SVOD services, AVOD platforms, FAST channels). | Column applicability_scope (STRING) in compliance.regulatory_obligation']
  audit_trail_required boolean [note: 'Indicates whether an audit trail of compliance activities and decisions must be maintained for this obligation. | Column audit_trail_required (BOOLEAN) in compliance.regulatory_obligation']
  automation_status varchar [note: 'Degree to which compliance monitoring and reporting for this obligation is automated: manual, partially automated, fully automated, or not applicable. | Column automation_status (STRING) in compliance.regulatory_obligation']
  compliance_frequency varchar [note: 'How often compliance with this obligation must be demonstrated or reported: ongoing (continuous), annual, quarterly, monthly, event-driven (triggered by specific events), or biennial. | Column compliance_frequency (STRING) in compliance.regulatory_obligation']
  compliance_status varchar [note: 'Current compliance status of the organization with respect to this obligation: compliant, non-compliant, in progress, not applicable, under review, or remediation required. | Column compliance_status (STRING) in compliance.regulatory_obligation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.regulatory_obligation']
  created_timestamp timestamp [note: 'Timestamp when this regulatory obligation record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.regulatory_obligation']
  documentation_required boolean [note: 'Indicates whether formal documentation, records, or evidence must be maintained to demonstrate compliance with this obligation. | Column documentation_required (BOOLEAN) in compliance.regulatory_obligation']
  documentation_retention_years varchar [note: 'Number of years that compliance documentation must be retained, as mandated by the regulation or internal policy. | Column documentation_retention_years (INT) in compliance.regulatory_obligation']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_date date [note: 'Date when this regulatory obligation became or becomes effective and enforceable. | Column effective_date (DATE) in compliance.regulatory_obligation']
  expiration_date date [note: 'Date when this obligation expires or is superseded, if applicable. Null for ongoing obligations. | Column expiration_date (DATE) in compliance.regulatory_obligation']
  external_reporting_required boolean [note: 'Indicates whether compliance with this obligation requires formal reporting or filing to an external regulatory body. | Column external_reporting_required (BOOLEAN) in compliance.regulatory_obligation']
  filing_deadline_description varchar [note: 'Human-readable description of the filing deadline (e.g., \'April 1 annually\', \'10 days after broadcast\', \'within 30 days of license expiration\'). | Column filing_deadline_description (STRING) in compliance.regulatory_obligation']
  filing_deadline_type varchar [note: 'Type of deadline for compliance filing or reporting: fixed date (specific calendar date), rolling (X days from event), event-based (triggered by business event), or not applicable. | Column filing_deadline_type (STRING) in compliance.regulatory_obligation']
  is_active boolean [note: 'Indicates whether this regulatory obligation is currently active and enforceable. False if the obligation has been superseded, repealed, or is no longer applicable. | Column is_active (BOOLEAN) in compliance.regulatory_obligation']
  jurisdiction varchar [note: 'Geographic jurisdiction where this obligation applies, using 3-letter ISO country code (e.g., USA, GBR, DEU) or regional code (e.g., EUR for EU-wide regulations). | Column jurisdiction (STRING) in compliance.regulatory_obligation']
  last_compliance_review_date date [note: 'Date when compliance with this obligation was last reviewed or assessed. | Column last_compliance_review_date (DATE) in compliance.regulatory_obligation']
  last_modified_timestamp timestamp [note: 'Timestamp when this regulatory obligation record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in compliance.regulatory_obligation']
  maximum_penalty_amount decimal(18,2) [note: 'Maximum monetary penalty or fine amount that can be imposed for non-compliance, in the currency specified. | Column maximum_penalty_amount (DECIMAL(18,2)) in compliance.regulatory_obligation']
  monitoring_system varchar [note: 'Name of the system or tool used to monitor compliance with this obligation (e.g., GRC platform, compliance management system, manual tracking). | Column monitoring_system (STRING) in compliance.regulatory_obligation']
  next_compliance_review_date date [note: 'Scheduled date for the next compliance review or assessment of this obligation. | Column next_compliance_review_date (DATE) in compliance.regulatory_obligation']
  notes varchar [note: 'Additional notes, comments, or context about this regulatory obligation, including implementation guidance or special considerations. | Column notes (STRING) in compliance.regulatory_obligation']
  obligation_code varchar [note: 'Unique business identifier code for the regulatory obligation, used for external reference and reporting. | Column obligation_code (STRING) in compliance.regulatory_obligation']
  obligation_description varchar [note: 'Detailed description of the regulatory obligation, including what must be done, reported, or maintained to achieve compliance. | Column obligation_description (STRING) in compliance.regulatory_obligation']
  obligation_name varchar [note: 'Short descriptive name of the regulatory obligation. | Column obligation_name (STRING) in compliance.regulatory_obligation']
  obligation_type varchar [note: 'Category of regulatory obligation: licensing (broadcast licenses, spectrum), content standards (ratings, COPPA), data privacy (GDPR, CCPA), financial reporting (SOX), accessibility (closed captioning), or technical standards (ATSC, DVB). | Column obligation_type (STRING) in compliance.regulatory_obligation']
  penalty_currency varchar [note: 'Currency code for the penalty amount, using ISO 4217 3-letter code (e.g., USD, GBP, EUR). | Column penalty_currency (STRING) in compliance.regulatory_obligation']
  penalty_description varchar [note: 'Description of penalties, fines, or sanctions that may be imposed for non-compliance with this obligation. | Column penalty_description (STRING) in compliance.regulatory_obligation']
  public_disclosure_required boolean [note: 'Indicates whether compliance information or related documents must be made publicly available (e.g., in FCC Online Public Inspection File). | Column public_disclosure_required (BOOLEAN) in compliance.regulatory_obligation']
  regulation_name varchar [note: 'Full name of the regulation, law, or standard that mandates this obligation (e.g., Communications Act Section 73, GDPR Article 30, SOX Section 404). | Column regulation_name (STRING) in compliance.regulatory_obligation']
  regulation_reference_number varchar [note: 'Official citation or reference number of the regulation (e.g., 47 CFR 73.3526, GDPR Art. 30, SOX §404). | Column regulation_reference_number (STRING) in compliance.regulatory_obligation']
  regulatory_body varchar [note: 'Name of the governing body or agency that enforces this obligation (e.g., FCC, Ofcom, European Audiovisual Observatory, MPA, Nielsen, IAB, SCTE, ISO). | Column regulatory_body (STRING) in compliance.regulatory_obligation']
  related_policy_document varchar [note: 'Reference to internal policy, procedure, or guideline document that governs how this obligation is implemented and monitored. | Column related_policy_document (STRING) in compliance.regulatory_obligation']
  responsible_department varchar [note: 'Department or business unit accountable for this obligation (e.g., Legal, Compliance, Broadcast Operations, Finance, IT Security). | Column responsible_department (STRING) in compliance.regulatory_obligation']
  risk_level varchar [note: 'Assessed risk level of non-compliance with this obligation, based on potential business impact, regulatory scrutiny, and penalty severity. | Column risk_level (STRING) in compliance.regulatory_obligation']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.regulatory_obligation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.regulatory_obligation']

  Note: 'Master catalog of all regulatory obligations applicable to the organization, mapped to specific regulations, governing bodies, and business units. Captures obligation type, regulation name, regulatory body, jurisdiction, obligation description, applicability scope (linear TV, OTT, radio, digital), compliance frequency (ongoing, annual, quarterly, event-driven), responsible owner, and current compliance status. Serves as the compliance obligation register. | Unity Catalog table: media_broadcasting_ecm.compliance.regulatory_obligation'
}

Table compliance.incident {
  incident_id varchar [pk, note: 'Primary key for incident | Column incident_id (BIGINT) in compliance.incident']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Accessibility violations (missing captions, non-compliant video player) may be recorded as compliance incidents. This FK links the incident to the specific accessibility obligation that was violated. | Column accessibility_obligation_id (BIGINT) in compliance.incident']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Compliance incidents may be discovered through audit findings. This FK links incidents to the audit finding that identified them, supporting root cause analysis and audit trail requirements. | Column audit_finding_id (BIGINT) in compliance.incident']
  broadcast_facility_id varchar [note: 'Identifier of the broadcast station or facility involved in the compliance incident, if applicable. | Column broadcast_facility_id (BIGINT) in technology.incident']
  broadcast_license_id varchar [note: 'Identifier of the broadcast license associated with the compliance incident, if applicable. | Column broadcast_license_id (BIGINT) in compliance.incident']
  coppa_declaration_id varchar [note: 'Foreign key linking to compliance.coppa_declaration. Business justification: COPPA compliance incidents (e.g., collecting children\'s data without parental consent) relate to specific COPPA declarations. This FK links the incident to the COPPA declaration that was violated, sup | Column coppa_declaration_id (BIGINT) in compliance.incident']
  encoder_config_id varchar [note: 'Foreign key linking to technology.encoder_config. Business justification: Encoding failures causing compliance violations (caption loss, rating display failure, audio description dropout) require encoder tracking for FCC incident reporting and remediation. | Column encoder_config_id (BIGINT) in technology.incident']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Compliance incidents (indecency complaints, technical violations, content violations, rights disputes) must reference the specific media asset involved for investigation, root cause analysis, regulato | Column media_asset_id (BIGINT) in mediaasset.incident']
  regulatory_change_id varchar [note: 'Foreign key linking to compliance.regulatory_change. Business justification: Compliance incidents may be triggered by new regulatory requirements that the organization has not yet implemented. This FK links incidents to the regulatory change that introduced the requirement, su | Column regulatory_change_id (BIGINT) in compliance.incident']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Compliance incidents may trigger or be documented in regulatory filings (e.g., incident reports to FCC). This FK links the incident to any resulting regulatory filing, enabling tracking of incident re | Column regulatory_filing_id (BIGINT) in compliance.incident']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Compliance incidents represent violations of specific regulatory obligations. This FK links the incident to the primary obligation that was violated, enabling compliance reporting and risk analysis by | Column regulatory_obligation_id (BIGINT) in compliance.incident']
  responsible_party_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Compliance incidents require assigned employee for resolution tracking and accountability. Responsible party contact data should reference employee record rather than duplicate information. | Column responsible_party_employee_id (BIGINT) in workforce.incident']
  sox_control_id varchar [note: 'Foreign key linking to compliance.sox_control. Business justification: SOX control failures may be recorded as compliance incidents (e.g., control breakdown leading to financial misstatement risk). This FK links the incident to the SOX control that failed, supporting roo | Column sox_control_id (BIGINT) in compliance.incident']
  title_id varchar [note: 'Identifier of the content asset (title, episode, program) affected by the compliance incident, if applicable. | Column title_id (BIGINT) in content.incident']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Compliance incidents often involve specific equipment failures (transmitter power drop, frequency drift). Equipment-level tracking required for root cause analysis and regulatory reporting beyond faci | Column transmission_equipment_id (BIGINT) in technology.incident']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in compliance.incident']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in compliance.incident']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in compliance.incident']
  affected_regulation varchar [note: 'The specific regulation, statute, or standard that was violated or at risk (e.g., FCC Part 73, GDPR Article 5, SOX Section 404, ATSC A/53). | Column affected_regulation (STRING) in compliance.incident']
  closure_date date [note: 'The date on which the compliance incident was formally closed after all remediation actions were completed and verified. | Column closure_date (DATE) in compliance.incident']
  closure_notes varchar [note: 'Final notes and summary documenting the resolution of the compliance incident, lessons learned, and any outstanding follow-up items. | Column closure_notes (STRING) in compliance.incident']
  corrective_action_completion_date date [note: 'Actual date on which the corrective action plan was completed and verified. | Column corrective_action_completion_date (DATE) in compliance.incident']
  corrective_action_due_date date [note: 'Target completion date for the corrective action plan. | Column corrective_action_due_date (DATE) in compliance.incident']
  corrective_action_plan varchar [note: 'Documented plan outlining the corrective actions to be taken to remediate the incident and prevent recurrence. | Column corrective_action_plan (STRING) in compliance.incident']
  corrective_action_status varchar [note: 'Current status of the corrective action plan implementation. | Column corrective_action_status (STRING) in compliance.incident']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in compliance.incident']
  created_timestamp timestamp [note: 'Timestamp when the compliance incident record was first created in the system. | Column created_timestamp (TIMESTAMP) in compliance.incident']
  discovery_date date [note: 'The date on which the compliance incident was discovered or identified by the organization or external party. | Column discovery_date (DATE) in compliance.incident']
  discovery_source varchar [note: 'The source or method by which the compliance incident was discovered (e.g., internal audit, regulator inspection, viewer complaint, self-disclosure, automated monitoring). [ENUM-REF-CANDIDATE: internal_audit|external_audit|regulator_inspection|viewer_complaint|self_disclosure|automated_monitoring|third_party_report — 7 candidates stripped; promote to reference product] | Column discovery_source (STRING) in compliance.incident']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  escalation_date date [note: 'The date on which the compliance incident was escalated to a higher authority or external party. | Column escalation_date (DATE) in compliance.incident']
  escalation_status varchar [note: 'Indicates whether and to whom the compliance incident has been escalated within the organization or externally. | Column escalation_status (STRING) in compliance.incident']
  financial_impact_amount decimal(18,2) [note: 'Estimated or actual financial impact of the compliance incident, including fines, penalties, remediation costs, and lost revenue. | Column financial_impact_amount (DECIMAL(18,2)) in compliance.incident']
  financial_impact_currency varchar [note: 'Three-letter ISO 4217 currency code for the financial impact amount. | Column financial_impact_currency (STRING) in compliance.incident']
  impacted_service varchar [note: 'The broadcast service, streaming platform, or distribution channel affected by the compliance incident (e.g., linear broadcast, OTT platform, MVPD service). | Column impacted_service (STRING) in compliance.incident']
  incident_date date [note: 'The date on which the compliance incident occurred or was first observed. | Column incident_date (DATE) in compliance.incident']
  incident_description varchar [note: 'Detailed narrative description of the compliance incident, including what occurred, how it was identified, and the immediate circumstances. | Column incident_description (STRING) in compliance.incident']
  incident_number varchar [note: 'Business-facing unique identifier or case number assigned to the compliance incident for tracking and reference purposes. | Column incident_number (STRING) in compliance.incident']
  incident_status varchar [note: 'Current lifecycle status of the compliance incident in the response and remediation workflow. | Column incident_status (STRING) in compliance.incident']
  incident_type varchar [note: 'Classification of the compliance incident by regulatory domain (e.g., broadcast licensing, content standards, data privacy, financial reporting, accessibility, technical standards). [ENUM-REF-CANDIDATE: broadcast_licensing|content_standards|data_privacy|financial_reporting|accessibility|technical_standards|advertising_compliance|rights_clearance|closed_captioning|other — 10 candidates stripped; promote to reference product] | Column incident_type (STRING) in compliance.incident']
  last_modified_timestamp timestamp [note: 'Timestamp when the compliance incident record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in compliance.incident']
  notes varchar [note: 'Additional notes, comments, or context related to the compliance incident that do not fit into other structured fields. | Column notes (STRING) in compliance.incident']
  recurrence_risk_level varchar [note: 'Assessed risk level of the compliance incident recurring after corrective actions have been implemented. | Column recurrence_risk_level (STRING) in compliance.incident']
  regulatory_body varchar [note: 'The governing body or regulatory authority with jurisdiction over the affected regulation (e.g., FCC, Ofcom, MPA, ISO). | Column regulatory_body (STRING) in compliance.incident']
  regulatory_notification_date date [note: 'The date on which the regulatory body was formally notified of the compliance incident. | Column regulatory_notification_date (DATE) in compliance.incident']
  regulatory_notification_method varchar [note: 'The method used to notify the regulatory body of the compliance incident. | Column regulatory_notification_method (STRING) in compliance.incident']
  regulatory_notification_required boolean [note: 'Indicates whether the compliance incident requires formal notification to the regulatory body under applicable reporting obligations. | Column regulatory_notification_required (BOOLEAN) in compliance.incident']
  regulatory_reference_number varchar [note: 'Reference or case number assigned by the regulatory body for tracking the incident and any subsequent investigation or enforcement action. | Column regulatory_reference_number (STRING) in compliance.incident']
  root_cause_analysis varchar [note: 'Analysis of the underlying root cause(s) of the compliance incident, including process failures, system defects, human error, or policy gaps. | Column root_cause_analysis (STRING) in compliance.incident']
  severity_level varchar [note: 'Assessed severity of the compliance incident based on potential regulatory impact, financial exposure, and reputational risk. | Column severity_level (STRING) in compliance.incident']
  source_record_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in compliance.incident']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.incident']

  Note: 'Operational record of compliance incidents, violations, and near-misses identified across all regulatory domains. Captures incident type, affected regulation, discovery source (internal audit, regulator, viewer complaint, self-disclosure), incident date, severity, impacted content or service, root cause analysis, corrective action plan, escalation status, and regulatory notification requirement. Drives the compliance incident response and remediation lifecycle. | Unity Catalog table: media_broadcasting_ecm.compliance.incident'
}

