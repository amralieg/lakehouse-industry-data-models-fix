ind:requiresClinicalLicense rdf:type rdf:Property ;
    rdfs:label 'Requires Clinical License' ;
    rdfs:comment 'Indicates whether delivery of this intervention type requires a clinically licensed professional such as RN, LCSW, or physician. Used for care team assignment and compliance.' ;
