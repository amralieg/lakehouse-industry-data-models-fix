ind:continuousEnrollmentMonths rdf:type rdf:Property ;
    rdfs:label 'Continuous Enrollment Months' ;
    rdfs:comment 'Number of months of continuous enrollment required for measure eligibility.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allowableGapDays rdf:type rdf:Property ;
    rdfs:label 'Allowable Gap Days' ;
    rdfs:comment 'Maximum number of days a member can have a gap in enrollment and still be considered continuously enrolled.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benefitTypeRequired rdf:type rdf:Property ;
    rdfs:label 'Benefit Type Required' ;
    rdfs:comment 'Specific benefit coverage required for measure eligibility (e.g., medical, pharmacy, behavioral health).' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stratificationRequired rdf:type rdf:Property ;
    rdfs:label 'Stratification Required' ;
    rdfs:comment 'Indicates whether the measure must be reported with stratified results by demographic or clinical subgroups.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stratificationCriteria rdf:type rdf:Property ;
    rdfs:label 'Stratification Criteria' ;
    rdfs:comment 'Specific dimensions by which measure results must be stratified (e.g., age groups, gender, race/ethnicity, disease severity).' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAdjustmentMethod rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Method' ;
    rdfs:comment 'Statistical methodology used to adjust measure results for differences in patient case mix or severity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueSetVersion rdf:type rdf:Property ;
    rdfs:label 'Value Set Version' ;
    rdfs:comment 'Version identifier for the clinical code value sets (ICD-10, CPT, HCPCS, LOINC, RxNorm) used in measure specifications.' ;
    rdfs:domain ind:Measure ;
