    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyCoordination rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Coordination' ;
    rdfs:comment 'Method for coordinating pharmacy benefits between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visionCoordination rdf:type rdf:Property ;
    rdfs:label 'Vision Coordination' ;
    rdfs:comment 'Rule defining how vision benefits are coordinated between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
