Table subscriber.subscriber {
  subscriber_id varchar [pk, note: 'Unique identifier for the subscriber. Primary key for the subscriber master record across all service tiers (SVOD, AVOD, TVOD, bundled). System-generated surrogate key independent of household or device. | Column subscriber_id (BIGINT) in subscriber.subscriber']
  audience_profile_id varchar [note: 'Foreign key linking to audience.audience_profile. Business justification: Links subscribers to Nielsen panel profiles and ACR measurement identities. Required for cross-platform audience measurement, ratings attribution, and MRC-accredited viewership reporting. Standard pra | Column audience_profile_id (BIGINT) in audience.subscriber']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.subscriber']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.subscriber']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.subscriber']
  account_status varchar [note: 'Current lifecycle status of the subscriber account. Determines access entitlements and billing state. Active subscribers have full access; suspended accounts are temporarily blocked; cancelled accounts are terminated; trial accounts are in promotional period; churned accounts have completed cancellation. | Column account_status (STRING) in subscriber.subscriber']
  adobe_profile_reference varchar [note: 'External identifier linking this subscriber to their unified profile in Adobe Experience Platform. Used for personalization, segmentation, and journey orchestration. | Column adobe_profile_reference (STRING) in subscriber.subscriber']
  arpu decimal(10,2) [note: 'Average monthly revenue generated by this subscriber across all revenue streams (subscription, transactional, advertising). Key metric for subscriber value assessment and segmentation. | Column arpu (DECIMAL(10,2)) in subscriber.subscriber']
  billing_cycle varchar [note: 'Frequency of subscription billing. Monthly, quarterly, and annual are recurring; lifetime is one-time payment; pay-per-view is transactional. | Column billing_cycle (STRING) in subscriber.subscriber']
  ccpa_opt_out_flag boolean [note: 'Indicates whether California subscriber has opted out of personal data sale. Required for CCPA compliance. | Column ccpa_opt_out_flag (BOOLEAN) in subscriber.subscriber']
  ccpa_opt_out_timestamp timestamp [note: 'Date and time when CCPA opt-out was recorded. Required for audit trail and compliance reporting. | Column ccpa_opt_out_timestamp (TIMESTAMP) in subscriber.subscriber']
  churn_risk_score decimal(5,4) [note: 'Predictive score (0.0000 to 1.0000) indicating likelihood of subscriber cancellation within next billing cycle. Generated by machine learning model based on engagement, payment history, and behavioral signals. | Column churn_risk_score (DECIMAL(5,4)) in subscriber.subscriber']
  coppa_compliant_flag boolean [note: 'Indicates whether this subscriber account is subject to COPPA restrictions (under 13 years old). When true, data collection and advertising are restricted. | Column coppa_compliant_flag (BOOLEAN) in subscriber.subscriber']
  country_code varchar [note: 'Three-letter ISO country code representing subscriber\'s primary geographic location. Used for content rights windowing, regional pricing, and regulatory compliance. | Column country_code (STRING) in subscriber.subscriber']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.subscriber']
  created_timestamp timestamp [note: 'System timestamp when this subscriber record was first created in the data platform. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in subscriber.subscriber']
  date_of_birth date [note: 'Subscriber\'s date of birth. Used for age verification, parental controls, COPPA compliance, and demographic segmentation. | Column date_of_birth (DATE) in subscriber.subscriber']
  email_address varchar [note: 'Primary email address for subscriber communication, authentication, and personalization. Used as primary contact channel and login credential. | Column email_address (STRING) in subscriber.subscriber']
  external_reference_code varchar [note: 'External business identifier for the subscriber, typically used for integration with Zuora billing and Adobe Experience Platform. May be customer-facing account number or external system key. | Column external_reference_code (STRING) in subscriber.subscriber']
  first_name varchar [note: 'Subscriber\'s given name as provided during registration. Used for personalization and customer service interactions. | Column first_name (STRING) in subscriber.subscriber']
  gdpr_consent_flag boolean [note: 'Indicates whether subscriber has provided explicit consent for data processing under GDPR. Required for EU subscribers. | Column gdpr_consent_flag (BOOLEAN) in subscriber.subscriber']
  gdpr_consent_timestamp timestamp [note: 'Date and time when GDPR consent was obtained. Required for audit trail and consent management. | Column gdpr_consent_timestamp (TIMESTAMP) in subscriber.subscriber']
  gender varchar [note: 'Subscriber\'s self-identified gender. Used for demographic analytics and content personalization. Optional field respecting subscriber privacy preferences. | Column gender (STRING) in subscriber.subscriber']
  household_id varchar [note: 'Foreign key linking subscriber to their household group. Multiple subscribers may share a household for family plans and concurrent stream management. | Column household_id (BIGINT) in subscriber.subscriber']
  last_login_timestamp timestamp [note: 'Date and time of subscriber\'s most recent authentication. Used for engagement tracking and churn prediction. | Column last_login_timestamp (TIMESTAMP) in subscriber.subscriber']
  last_name varchar [note: 'Subscriber\'s family name as provided during registration. Used for personalization and customer service interactions. | Column last_name (STRING) in subscriber.subscriber']
  last_viewing_timestamp timestamp [note: 'Date and time of subscriber\'s most recent content viewing session. Used for engagement analysis and retention modeling. | Column last_viewing_timestamp (TIMESTAMP) in subscriber.subscriber']
  ltv decimal(12,2) [note: 'Predicted total revenue this subscriber will generate over their entire relationship with the service. Used for acquisition cost justification and retention prioritization. | Column ltv (DECIMAL(12,2)) in subscriber.subscriber']
  marketing_opt_in boolean [note: 'Indicates whether subscriber has consented to receive marketing communications. Required for GDPR and CCPA compliance. | Column marketing_opt_in (BOOLEAN) in subscriber.subscriber']
  max_concurrent_streams varchar [note: 'Maximum number of simultaneous video streams allowed for this subscriber based on their service tier. Enforced by playout and CDN systems. | Column max_concurrent_streams (INT) in subscriber.subscriber']
  max_registered_devices varchar [note: 'Maximum number of devices that can be registered to this subscriber account. Used for device management and anti-piracy enforcement. | Column max_registered_devices (INT) in subscriber.subscriber']
  parental_control_enabled boolean [note: 'Indicates whether parental controls are active on this subscriber account. When true, content access is restricted based on rating thresholds and PIN protection. | Column parental_control_enabled (BOOLEAN) in subscriber.subscriber']
  parental_control_pin varchar [note: 'Encrypted PIN code required to access age-restricted content when parental controls are enabled. Stored in hashed format for security. | Column parental_control_pin (STRING) in subscriber.subscriber']
  phone_number varchar [note: 'Primary contact phone number for subscriber support and account recovery. May be used for two-factor authentication. | Column phone_number (STRING) in subscriber.subscriber']
  postal_code varchar [note: 'Subscriber\'s postal or ZIP code. Used for geographic segmentation, local content recommendations, and blackout enforcement. | Column postal_code (STRING) in subscriber.subscriber']
  preferred_language varchar [note: 'Two-letter ISO language code representing subscriber\'s preferred interface and content language. Used for UI localization and content recommendations. | Column preferred_language (STRING) in subscriber.subscriber']
  registration_source varchar [note: 'Channel through which the subscriber originally registered. Used for acquisition analytics and channel effectiveness measurement. | Column registration_source (STRING) in subscriber.subscriber']
  registration_timestamp timestamp [note: 'Date and time when the subscriber account was first created. Used for cohort analysis, LTV calculation, and subscriber lifecycle tracking. | Column registration_timestamp (TIMESTAMP) in subscriber.subscriber']
  service_tier varchar [note: 'Current subscription service tier. SVOD (Subscription Video On Demand) includes basic and premium tiers; AVOD (Advertising-Supported Video On Demand) is free with ads; TVOD (Transactional Video On Demand) is pay-per-view; bundle includes multiple services. | Column service_tier (STRING) in subscriber.subscriber']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.subscriber']
  subscription_end_date date [note: 'Date when the current subscription is scheduled to end or renew. Null for active recurring subscriptions. Used for churn prediction and retention campaigns. | Column subscription_end_date (DATE) in subscriber.subscriber']
  subscription_start_date date [note: 'Date when the current subscription tier became effective. Used for billing cycle calculation and tenure analysis. | Column subscription_start_date (DATE) in subscriber.subscriber']
  total_viewing_hours decimal(12,2) [note: 'Cumulative hours of content viewed by this subscriber since registration. Key engagement metric for LTV calculation and content recommendation. | Column total_viewing_hours (DECIMAL(12,2)) in subscriber.subscriber']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.subscriber']
  updated_timestamp timestamp [note: 'System timestamp when this subscriber record was last modified. Used for change tracking and incremental processing. | Column updated_timestamp (TIMESTAMP) in subscriber.subscriber']
  zuora_account_reference varchar [note: 'External identifier linking this subscriber to their billing account in Zuora subscription management system. Used for payment processing and revenue recognition integration. | Column zuora_account_reference (STRING) in subscriber.subscriber']

  Note: 'Master identity record for every subscriber across SVOD, AVOD, TVOD, and bundled service tiers. Serves as the SSOT for subscriber identity, capturing registration source, registration timestamp, account status, service tier, demographic attributes, ARPU, LTV, churn risk score, GDPR/CCPA/COPPA consent flags, and integration keys to Zuora (billing) and Adobe Experience Platform (personalization). Each subscriber has a unique identity independent of household or device. | Unity Catalog table: media_broadcasting_ecm.subscriber.subscriber'
}

Table subscriber.household {
  household_id varchar [pk, note: 'Unique identifier for the household grouping. Primary key for the household entity. | Column household_id (BIGINT) in subscriber.household']
  primary_subscriber_id varchar [note: 'Reference to the primary account holder or subscriber who owns this household account. This subscriber has administrative privileges for the household. | Column primary_subscriber_id (BIGINT) in subscriber.household']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.household']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.household']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.household']
  account_created_date date [note: 'Date when the household account was first created in the system. Used for tenure analysis and customer lifetime value (LTV) calculations. | Column account_created_date (DATE) in subscriber.household']
  address_line_1 varchar [note: 'Primary street address line for the household\'s service location. Used for geographic market assignment and service delivery. | Column address_line_1 (STRING) in subscriber.household']
  address_line_2 varchar [note: 'Secondary address line for apartment, suite, or unit number. Optional field for additional address detail. | Column address_line_2 (STRING) in subscriber.household']
  auto_renew_enabled boolean [note: 'Indicates whether the household subscription automatically renews at the end of each billing period. When false, subscription expires unless manually renewed. | Column auto_renew_enabled (BOOLEAN) in subscriber.household']
  average_revenue_per_user decimal(10,2) [note: 'Average monthly revenue generated by this household, calculated as total revenue divided by number of active months. Key metric for household value assessment. | Column average_revenue_per_user (DECIMAL(10,2)) in subscriber.household']
  billing_cycle_day varchar [note: 'Day of the month when the household\'s recurring subscription charge is processed. Typically set at initial subscription and remains consistent. | Column billing_cycle_day (INT) in subscriber.household']
  churn_risk_score decimal(5,2) [note: 'Predictive score (0.00 to 100.00) indicating the likelihood of this household cancelling their subscription in the next billing period. Generated by machine learning models based on engagement and payment patterns. | Column churn_risk_score (DECIMAL(5,2)) in subscriber.household']
  city varchar [note: 'City or municipality where the household is located. Used for geographic segmentation and local content availability. | Column city (STRING) in subscriber.household']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the household location. Determines applicable content rights, pricing, and regulatory requirements. | Column country_code (STRING) in subscriber.household']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.household']
  created_timestamp timestamp [note: 'Timestamp when this household record was first created in the data platform. Used for data lineage and audit purposes. | Column created_timestamp (TIMESTAMP) in subscriber.household']
  data_sharing_consent boolean [note: 'Indicates whether the household has consented to sharing their viewing data with third parties for analytics and advertising purposes. Required for privacy compliance. | Column data_sharing_consent (BOOLEAN) in subscriber.household']
  dma_code varchar [note: 'Nielsen Designated Market Area code identifying the geographic television market for this household. Used for local content availability, blackout enforcement, and advertising targeting. | Column dma_code (STRING) in subscriber.household']
  household_name varchar [note: 'Human-readable name or label for the household, typically derived from the primary account holder\'s name or a custom household designation. | Column household_name (STRING) in subscriber.household']
  household_status varchar [note: 'Current lifecycle status of the household account. Determines access rights and billing state. | Column household_status (STRING) in subscriber.household']
  household_type varchar [note: 'Classification of the household based on its composition and purpose. Determines applicable service tier rules and entitlement models. | Column household_type (STRING) in subscriber.household']
  language_preference varchar [note: 'Two-letter ISO 639-1 language code representing the household\'s preferred content and interface language. Used for content recommendations and UI localization. | Column language_preference (STRING) in subscriber.household']
  last_login_timestamp timestamp [note: 'Timestamp of the most recent authentication event for any member of this household. Used for engagement tracking and inactive account identification. | Column last_login_timestamp (TIMESTAMP) in subscriber.household']
  last_payment_date date [note: 'Date of the most recent successful payment received from this household. Used for delinquency tracking and churn prediction. | Column last_payment_date (DATE) in subscriber.household']
  lifetime_value decimal(12,2) [note: 'Total revenue generated by this household since account creation, including subscription fees, transactional purchases (TVOD), and advertising revenue attribution. Used for customer segmentation and retention investment decisions. | Column lifetime_value (DECIMAL(12,2)) in subscriber.household']
  marketing_opt_in boolean [note: 'Indicates whether the household has consented to receive marketing communications and promotional offers. Required for GDPR and CCPA compliance. | Column marketing_opt_in (BOOLEAN) in subscriber.household']
  max_concurrent_streams varchar [note: 'Maximum number of simultaneous video streams allowed for this household based on their service plan. Enforced by the streaming platform to prevent account sharing abuse. | Column max_concurrent_streams (INT) in subscriber.household']
  max_content_rating varchar [note: 'Highest content rating level allowed for viewing in this household when parental controls are active. Based on Motion Picture Association (MPA) and TV Parental Guidelines ratings. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA — 11 candidates stripped; promote to reference product] | Column max_content_rating (STRING) in subscriber.household']
  max_registered_devices varchar [note: 'Maximum number of devices that can be registered to this household account. Used to enforce device limits per service tier. | Column max_registered_devices (INT) in subscriber.household']
  mvpd_affiliation varchar [note: 'Name of the MVPD or vMVPD provider if this household accesses content through a cable/satellite/virtual provider authentication. Used for TV Everywhere entitlement validation. | Column mvpd_affiliation (STRING) in subscriber.household']
  parental_control_enabled boolean [note: 'Indicates whether parental control restrictions are active for this household. When enabled, content access is filtered based on rating thresholds and PIN protection. | Column parental_control_enabled (BOOLEAN) in subscriber.household']
  parental_control_pin varchar [note: 'Encrypted PIN code required to access age-restricted content when parental controls are enabled. Stored in hashed format for security. | Column parental_control_pin (STRING) in subscriber.household']
  payment_method_type varchar [note: 'Type of payment instrument on file for this household\'s subscription billing. Determines payment processing flow and retry logic. [ENUM-REF-CANDIDATE: credit_card|debit_card|paypal|bank_transfer|gift_card|carrier_billing|app_store — 7 candidates stripped; promote to reference product] | Column payment_method_type (STRING) in subscriber.household']
  postal_code varchar [note: 'Postal or ZIP code for the household address. Used for geographic market (DMA) assignment and service availability determination. | Column postal_code (STRING) in subscriber.household']
  service_tier varchar [note: 'Current subscription service tier for the household. Determines content library access, stream quality (SD/HD/4K), and feature availability. | Column service_tier (STRING) in subscriber.household']
  size varchar [note: 'Number of registered members or subscribers within this household. Used for family plan eligibility and simultaneous stream limit enforcement. | Column size (INT) in subscriber.household']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.household']
  state_province varchar [note: 'State, province, or region code for the household address. Used for regulatory compliance and regional content licensing. | Column state_province (STRING) in subscriber.household']
  subscription_end_date date [note: 'Date when the household\'s current subscription is scheduled to end or renew. Null for active auto-renewing subscriptions. | Column subscription_end_date (DATE) in subscriber.household']
  subscription_start_date date [note: 'Date when the household\'s current paid subscription began. May differ from account creation date if there was a trial period or reactivation. | Column subscription_start_date (DATE) in subscriber.household']
  time_zone varchar [note: 'IANA time zone identifier for the household location. Used for scheduling, program guide display, and live event timing. | Column time_zone (STRING) in subscriber.household']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.household']
  updated_timestamp timestamp [note: 'Timestamp when this household record was last modified in the data platform. Used for change tracking and incremental processing. | Column updated_timestamp (TIMESTAMP) in subscriber.household']
  verification_method varchar [note: 'Method used to verify the household\'s identity and location. Multiple methods may be used in combination for higher confidence. | Column verification_method (STRING) in subscriber.household']
  verification_status varchar [note: 'Status of household identity and address verification process. Used to enforce geographic entitlements and prevent fraudulent account creation. | Column verification_status (STRING) in subscriber.household']

  Note: 'Represents a logical household grouping of one or more subscribers sharing a service plan. Tracks household-level attributes including address, geographic market (DMA), household size, primary account holder reference, parental control settings, simultaneous stream limits, and household verification status. Supports MVPD household-based entitlement models, family plan billing, and account sharing enforcement. | Unity Catalog table: media_broadcasting_ecm.subscriber.household'
}

Table subscriber.subscription_plan {
  subscription_plan_id varchar [pk, note: 'Unique identifier for the subscription plan. Primary key for the subscription plan catalog. | Column subscription_plan_id (BIGINT) in subscriber.subscription_plan']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Subscription plans are platform-specific products (Disney+ Basic vs Hulu Live TV). Billing, entitlement provisioning, and subscriber reporting all require knowing which OTT platform a plan belongs to. | Column ott_platform_id (BIGINT) in distribution.subscription_plan']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Each subscription plan maps to specific revenue streams for financial reporting, revenue recognition policies, and segment analysis. Finance requires this mapping for ASC 606 compliance and management | Column revenue_stream_id (BIGINT) in finance.subscription_plan']
  target_demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Subscription tiers are designed targeting specific Nielsen demographics (A18-49, A25-54 key demos). Required for pricing strategy, tier optimization, and validating that plan design attracts target au | Column target_demographic_segment_id (BIGINT) in audience.subscription_plan']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.subscription_plan']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.subscription_plan']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.subscription_plan']
  ad_supported boolean [note: 'Indicates whether this subscription plan includes advertising (AVOD/FAST model) or is ad-free (SVOD model). | Column ad_supported (BOOLEAN) in subscriber.subscription_plan']
  addon_eligible boolean [note: 'Indicates whether this plan can be purchased as an add-on to another base subscription plan (e.g., premium sports channel add-on). | Column addon_eligible (BOOLEAN) in subscriber.subscription_plan']
  audio_quality_max varchar [note: 'Maximum audio quality format available under this subscription plan (e.g., stereo, surround 5.1, Dolby Atmos, DTS:X). | Column audio_quality_max (STRING) in subscriber.subscription_plan']
  auto_renewal_enabled boolean [note: 'Indicates whether subscriptions under this plan automatically renew at the end of each billing period by default. | Column auto_renewal_enabled (BOOLEAN) in subscriber.subscription_plan']
  base_price decimal(12,2) [note: 'Standard recurring price for the subscription plan before any discounts, promotions, or taxes. Expressed in the default currency. | Column base_price (DECIMAL(12,2)) in subscriber.subscription_plan']
  billing_frequency varchar [note: 'Frequency at which subscribers are billed for this plan (e.g., monthly, quarterly, annual, biannual, one-time, usage-based). | Column billing_frequency (STRING) in subscriber.subscription_plan']
  blackout_restrictions boolean [note: 'Indicates whether this subscription plan is subject to geographic blackout restrictions for certain live sports or regional content. | Column blackout_restrictions (BOOLEAN) in subscriber.subscription_plan']
  bundled_plan boolean [note: 'Indicates whether this is a bundled subscription plan that combines multiple services or content packages (e.g., streaming + live TV + music). | Column bundled_plan (BOOLEAN) in subscriber.subscription_plan']
  cancellation_policy varchar [note: 'Policy governing subscriber cancellation: anytime (immediate), end of billing period, no refund, or prorated refund. | Column cancellation_policy (STRING) in subscriber.subscription_plan']
  churn_risk_category varchar [note: 'Assessed churn risk category for subscribers on this plan based on historical churn rate analysis (low, medium, high). | Column churn_risk_category (STRING) in subscriber.subscription_plan']
  concurrent_stream_limit varchar [note: 'Maximum number of simultaneous video streams allowed under this subscription plan. Null indicates unlimited concurrent streams. | Column concurrent_stream_limit (INT) in subscriber.subscription_plan']
  content_library_scope varchar [note: 'Defines the scope of content library access granted by this plan (e.g., full catalog, limited selection, premium content only, sports only, news only, kids only). | Column content_library_scope (STRING) in subscriber.subscription_plan']
  contract_term_months varchar [note: 'Minimum contract commitment period in months for this subscription plan. Null indicates month-to-month with no minimum commitment. | Column contract_term_months (INT) in subscriber.subscription_plan']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.subscription_plan']
  created_timestamp timestamp [note: 'Timestamp when this subscription plan record was first created in the system. | Column created_timestamp (TIMESTAMP) in subscriber.subscription_plan']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the base price (e.g., USD, EUR, GBP, CAD). | Column currency_code (STRING) in subscriber.subscription_plan']
  device_registration_limit varchar [note: 'Maximum number of devices that can be registered to a subscriber account under this plan. Null indicates unlimited device registrations. | Column device_registration_limit (INT) in subscriber.subscription_plan']
  download_enabled boolean [note: 'Indicates whether offline download of content is permitted under this subscription plan. | Column download_enabled (BOOLEAN) in subscriber.subscription_plan']
  download_limit varchar [note: 'Maximum number of titles that can be downloaded for offline viewing at any given time. Null if download_enabled is false or unlimited. | Column download_limit (INT) in subscriber.subscription_plan']
  early_termination_fee decimal(12,2) [note: 'Fee charged to subscribers who cancel before the end of the contract term. Null if no early termination fee applies. | Column early_termination_fee (DECIMAL(12,2)) in subscriber.subscription_plan']
  geographic_availability varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes where this subscription plan is available for purchase (e.g., USA,CAN,GBR,AUS). Empty indicates global availability. | Column geographic_availability (STRING) in subscriber.subscription_plan']
  launch_date date [note: 'Date when this subscription plan was first made available to subscribers. | Column launch_date (DATE) in subscriber.subscription_plan']
  modified_by varchar [note: 'Identifier of the user or system process that last modified this subscription plan record. | Column modified_by (STRING) in subscriber.subscription_plan']
  modified_timestamp timestamp [note: 'Timestamp when this subscription plan record was last modified in the system. | Column modified_timestamp (TIMESTAMP) in subscriber.subscription_plan']
  parental_control_enabled boolean [note: 'Indicates whether parental control features are available under this subscription plan to restrict content based on ratings. | Column parental_control_enabled (BOOLEAN) in subscriber.subscription_plan']
  plan_code varchar [note: 'Externally-known unique business identifier for the subscription plan used in billing systems and customer communications. Managed in Zuora product catalog. | Column plan_code (STRING) in subscriber.subscription_plan']
  plan_description varchar [note: 'Detailed description of the subscription plan features, benefits, and included content for subscriber-facing materials and internal reference. | Column plan_description (STRING) in subscriber.subscription_plan']
  plan_name varchar [note: 'Human-readable marketing name of the subscription plan displayed to subscribers (e.g., Premium Plus, Family Bundle, Sports Add-On). | Column plan_name (STRING) in subscriber.subscription_plan']
  plan_status varchar [note: 'Current lifecycle status of the subscription plan: active (available for new subscriptions), inactive (temporarily unavailable), deprecated (no longer offered but existing subscriptions continue), sunset (being phased out), coming soon (announced but not yet available). | Column plan_status (STRING) in subscriber.subscription_plan']
  plan_type varchar [note: 'Business model classification: SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), FAST (Free Ad-Supported Streaming Television), hybrid, or add-on plan. | Column plan_type (STRING) in subscriber.subscription_plan']
  promotional_plan boolean [note: 'Indicates whether this is a limited-time promotional subscription plan offered at a special price or with enhanced features. | Column promotional_plan (BOOLEAN) in subscriber.subscription_plan']
  service_tier varchar [note: 'Classification of the subscription plan tier indicating the level of service and content access (e.g., basic, standard, premium, ultimate, enterprise, family). | Column service_tier (STRING) in subscriber.subscription_plan']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.subscription_plan']
  sunset_date date [note: 'Date when this subscription plan will no longer be available for new subscriptions. Null if the plan is not scheduled for sunset. | Column sunset_date (DATE) in subscriber.subscription_plan']
  target_arpu decimal(12,2) [note: 'Target average revenue per user (ARPU) metric for financial planning and performance tracking of this subscription plan. | Column target_arpu (DECIMAL(12,2)) in subscriber.subscription_plan']
  target_ltv decimal(12,2) [note: 'Target lifetime value (LTV) metric representing the projected total revenue from a subscriber over the duration of their subscription to this plan. | Column target_ltv (DECIMAL(12,2)) in subscriber.subscription_plan']
  trial_duration_days varchar [note: 'Number of days for the free trial period if trial_eligible is true. Null if no trial is offered. | Column trial_duration_days (INT) in subscriber.subscription_plan']
  trial_eligible boolean [note: 'Indicates whether this subscription plan is eligible for a free trial period for new subscribers. | Column trial_eligible (BOOLEAN) in subscriber.subscription_plan']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.subscription_plan']
  video_quality_max varchar [note: 'Maximum video resolution quality available under this subscription plan (e.g., SD, HD, Full HD, 4K, 8K). | Column video_quality_max (STRING) in subscriber.subscription_plan']

  Note: 'Catalog of all available subscription plans and service tiers offered to subscribers — SVOD, AVOD, TVOD, FAST, bundled, and add-on plans. Captures plan name, tier classification, billing frequency, base price, trial eligibility, concurrent stream limit, download allowance, ad-supported flag, and plan lifecycle status. Managed in Zuora as the product catalog. | Unity Catalog table: media_broadcasting_ecm.subscriber.subscription_plan D2C streaming lifecycle entity supporting subscriber+subscription+entitlement+playback_session+churn_event+offer flows.'
}

Table subscriber.subscription {
  subscription_id varchar [pk, note: 'Unique identifier for the subscription record. Primary key. | Column subscription_id (BIGINT) in subscriber.subscription']
  payment_method_id varchar [note: 'Reference to the payment method used for recurring billing of this subscription. | Column payment_method_id (BIGINT) in billing.subscription']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Subscriptions generate revenue tracked in specific revenue streams for ASC 606/IFRS 15 compliance, segment reporting, and P&L analysis. Finance teams need to classify subscription revenue by stream fo | Column revenue_stream_id (BIGINT) in finance.subscription']
  subscriber_id varchar [note: 'Reference to the subscriber who owns this subscription. | Column subscriber_id (BIGINT) in subscriber.subscription']
  subscription_plan_id varchar [note: 'Reference to the subscription plan that defines the service tier, features, and pricing structure. | Column subscription_plan_id (BIGINT) in subscriber.subscription']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.subscription']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.subscription']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.subscription']
  acquisition_channel varchar [note: 'Marketing channel or source through which the subscriber acquired this subscription (e.g., web, mobile app, partner referral, promotional campaign). | Column acquisition_channel (STRING) in subscriber.subscription']
  activation_date date [note: 'Date when the subscription was activated and service delivery began. May differ from enrollment date if there was a pending period. | Column activation_date (DATE) in subscriber.subscription']
  arpu decimal(15,2) [note: 'Average Revenue Per User calculated for this subscription over its lifetime, used for subscriber value analysis and forecasting. | Column arpu (DECIMAL(15,2)) in subscriber.subscription']
  auto_renew_flag boolean [note: 'Indicates whether the subscription will automatically renew at the end of the current term. True = auto-renew enabled, False = manual renewal required. | Column auto_renew_flag (BOOLEAN) in subscriber.subscription']
  base_rate_amount decimal(15,2) [note: 'The standard subscription rate amount per billing cycle, in the billing currency, before any discounts or promotions. | Column base_rate_amount (DECIMAL(15,2)) in subscriber.subscription']
  billing_cycle varchar [note: 'Frequency of billing for this subscription: monthly, quarterly, annual, semi-annual, weekly, or one-time (for TVOD transactions). | Column billing_cycle (STRING) in subscriber.subscription']
  campaign_code varchar [note: 'Marketing campaign identifier associated with the subscription acquisition, used for campaign performance tracking and attribution. | Column campaign_code (STRING) in subscriber.subscription']
  cancellation_date date [note: 'Date when the subscription was cancelled by the subscriber or system. Null for active subscriptions. | Column cancellation_date (DATE) in subscriber.subscription']
  cancellation_initiated_by varchar [note: 'Entity that initiated the cancellation: subscriber (voluntary), system (automated), admin (manual intervention), payment_failure (billing issue), fraud_detection (security). Null for active subscriptions. | Column cancellation_initiated_by (STRING) in subscriber.subscription']
  cancellation_reason varchar [note: 'Primary reason for subscription cancellation, used for churn analysis and retention strategy. Null for active subscriptions. [ENUM-REF-CANDIDATE: voluntary|payment_failure|fraud|service_quality|price|content_selection|technical_issues — 7 candidates stripped; promote to reference product] | Column cancellation_reason (STRING) in subscriber.subscription']
  contract_term_months varchar [note: 'Length of the subscription contract term in months. Null for month-to-month or open-ended subscriptions. | Column contract_term_months (INT) in subscriber.subscription']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.subscription']
  created_timestamp timestamp [note: 'Timestamp when the subscription record was first created in the system. | Column created_timestamp (TIMESTAMP) in subscriber.subscription']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for subscription billing (e.g., USD, EUR, GBP). | Column currency_code (STRING) in subscriber.subscription']
  current_term_end_date date [note: 'End date of the current billing term or subscription period. Represents the next renewal or expiration date. | Column current_term_end_date (DATE) in subscriber.subscription']
  current_term_start_date date [note: 'Start date of the current billing term or subscription period. | Column current_term_start_date (DATE) in subscriber.subscription']
  enrollment_date date [note: 'Date when the subscriber first enrolled in this subscription plan. Represents the start of the contractual relationship. | Column enrollment_date (DATE) in subscriber.subscription']
  grace_period_end_date date [note: 'Date when the grace period ends after a payment failure or cancellation, after which access is fully revoked. Null if no grace period applies. | Column grace_period_end_date (DATE) in subscriber.subscription']
  last_modified_timestamp timestamp [note: 'Timestamp when the subscription record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in subscriber.subscription']
  ltv decimal(15,2) [note: 'Lifetime Value representing the total revenue generated or projected from this subscription over its entire lifecycle. | Column ltv (DECIMAL(15,2)) in subscriber.subscription']
  max_concurrent_streams varchar [note: 'Maximum number of simultaneous video streams allowed under this subscription plan, enforced by the streaming platform. | Column max_concurrent_streams (INT) in subscriber.subscription']
  parental_control_enabled boolean [note: 'Indicates whether parental controls are enabled for this subscription to restrict access to age-inappropriate content. True = enabled, False = disabled. | Column parental_control_enabled (BOOLEAN) in subscriber.subscription']
  promotional_end_date date [note: 'Date when the promotional rate expires and standard pricing resumes. Null if no promotion is active. | Column promotional_end_date (DATE) in subscriber.subscription']
  promotional_rate_amount decimal(15,2) [note: 'The discounted subscription rate amount during the promotional period, in the billing currency. Null if no promotion is active. | Column promotional_rate_amount (DECIMAL(15,2)) in subscriber.subscription']
  promotional_rate_flag boolean [note: 'Indicates whether the subscription is currently on a promotional or discounted rate. True = promotional pricing active, False = standard pricing. | Column promotional_rate_flag (BOOLEAN) in subscriber.subscription']
  renewal_date date [note: 'Date when the subscription is scheduled to renew for the next billing cycle. | Column renewal_date (DATE) in subscriber.subscription']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.subscription']
  subscription_number varchar [note: 'Human-readable business identifier for the subscription, displayed to subscribers and customer service representatives. | Column subscription_number (STRING) in subscriber.subscription']
  subscription_status varchar [note: 'Current lifecycle state of the subscription: active (in service), suspended (temporarily paused), cancelled (terminated by subscriber or system), expired (end date reached), trialing (in trial period), pending (awaiting activation). | Column subscription_status (STRING) in subscriber.subscription']
  subscription_type varchar [note: 'Classification of subscription model: SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), bundle, premium add-on, or trial. | Column subscription_type (STRING) in subscriber.subscription']
  suspension_reason varchar [note: 'Free-text explanation for why the subscription was suspended (e.g., payment failure, subscriber request, fraud investigation). Null for non-suspended subscriptions. | Column suspension_reason (STRING) in subscriber.subscription']
  termination_date date [note: 'Date when the subscription service was fully terminated and access was revoked. May differ from cancellation date if there is a grace period. | Column termination_date (DATE) in subscriber.subscription']
  trial_end_date date [note: 'Date when the trial period ends and billing begins, if applicable. Null for non-trial subscriptions. | Column trial_end_date (DATE) in subscriber.subscription']
  trial_start_date date [note: 'Date when the trial period began, if applicable. Null for non-trial subscriptions. | Column trial_start_date (DATE) in subscriber.subscription']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.subscription']
  zuora_subscription_reference varchar [note: 'External subscription identifier from Zuora billing system for revenue recognition and invoicing integration. | Column zuora_subscription_reference (STRING) in subscriber.subscription']

  Note: 'Active or historical enrollment of a subscriber to a specific subscription plan. Represents the contractual service relationship — capturing plan enrollment date, renewal date, billing cycle, current status (active, suspended, cancelled, trialing), auto-renew flag, promotional rate, and Zuora subscription ID. One subscriber may have multiple subscriptions (e.g., base SVOD + premium add-on). | Unity Catalog table: media_broadcasting_ecm.subscriber.subscription'
}

Table subscriber.device_registration {
  device_registration_id varchar [pk, note: 'Unique identifier for the device registration record. Primary key. | Column device_registration_id (BIGINT) in subscriber.device_registration']
  app_version_id varchar [note: 'Foreign key linking to distribution.app_version. Business justification: Feature flag evaluation, force-upgrade enforcement, and A/B test cohort assignment require linking registered devices to specific app_version records. Critical for rollout management and compatibility | Column app_version_id (BIGINT) in distribution.device_registration']
  audience_profile_id varchar [note: 'Foreign key linking to audience.audience_profile. Business justification: ACR (Automatic Content Recognition) and cross-platform measurement systems link registered streaming devices to audience profiles for viewership attribution. Enables deduplicated reach/frequency repor | Column audience_profile_id (BIGINT) in audience.device_registration']
  device_type_id varchar [note: 'Foreign key linking to distribution.device_type. Business justification: Device certification and DRM enforcement require mapping subscriber devices to certified device_type records. QoS tier assignment, ABR profile selection, and DRM security level validation all depend o | Column device_type_id (BIGINT) in distribution.device_registration']
  household_id varchar [note: 'Reference to the household to which this device belongs. Enables household-level device limit enforcement and shared viewing analytics. | Column household_id (BIGINT) in subscriber.device_registration']
  subscriber_id varchar [note: 'Reference to the subscriber who registered this device. Links to the subscriber master record. | Column subscriber_id (BIGINT) in subscriber.device_registration']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.device_registration']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.device_registration']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.device_registration']
  ad_tracking_consent boolean [note: 'Indicates whether the user has consented to advertising tracking on this device. Required for GDPR and CCPA compliance. | Column ad_tracking_consent (BOOLEAN) in subscriber.device_registration']
  advertising_device_identifier varchar [note: 'Device advertising identifier (IDFA for iOS, AAID for Android). Used for targeted advertising and attribution tracking. Subject to user consent per GDPR and CCPA. | Column advertising_device_identifier (STRING) in subscriber.device_registration']
  audio_codec_support varchar [note: 'Comma-separated list of audio codecs supported by the device (e.g., AAC, Dolby Digital, Dolby Atmos, DTS). Determines audio track selection. | Column audio_codec_support (STRING) in subscriber.device_registration']
  concurrent_stream_limit varchar [note: 'Maximum number of concurrent streams allowed for this device under the subscribers plan. Enforced at playback initiation. | Column concurrent_stream_limit (INT) in subscriber.device_registration']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.device_registration']
  created_timestamp timestamp [note: 'Timestamp when this device registration record was first created in the system. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column created_timestamp (TIMESTAMP) in subscriber.device_registration']
  deregistration_reason varchar [note: 'Reason why the device was deregistered. Used for churn analysis and fraud investigation. [ENUM-REF-CANDIDATE: user_initiated|account_closure|fraud_detected|device_limit_exceeded|inactivity|admin_action|device_lost_stolen — 7 candidates stripped; promote to reference product] | Column deregistration_reason (STRING) in subscriber.device_registration']
  deregistration_timestamp timestamp [note: 'Date and time when the device was deregistered or removed from the subscriber account. Null if device is still registered. | Column deregistration_timestamp (TIMESTAMP) in subscriber.device_registration']
  device_fingerprint varchar [note: 'Unique cryptographic hash or identifier that uniquely identifies the physical device. Used for device authentication and fraud prevention. | Column device_fingerprint (STRING) in subscriber.device_registration']
  device_limit_enforcement_flag boolean [note: 'Indicates whether this device counts toward the subscribers per-account device limit. Used to exempt customer service test devices or promotional devices. | Column device_limit_enforcement_flag (BOOLEAN) in subscriber.device_registration']
  device_nickname varchar [note: 'User-assigned friendly name for the device (e.g., Living Room TV, Johns iPhone). Improves device management user experience. | Column device_nickname (STRING) in subscriber.device_registration']
  drm_certificate_reference varchar [note: 'Reference to the DRM device certificate used for secure content decryption. Required for protected content playback. | Column drm_certificate_reference (STRING) in subscriber.device_registration']
  drm_security_level varchar [note: 'Security level of the DRM implementation on the device. Determines maximum content quality and protection level (e.g., Widevine L1 for HD, L3 for SD). | Column drm_security_level (STRING) in subscriber.device_registration']
  fraud_score decimal(5,2) [note: 'Calculated fraud risk score for this device registration (0.00 to 100.00). Higher scores indicate higher likelihood of fraudulent activity. | Column fraud_score (DECIMAL(5,2)) in subscriber.device_registration']
  geographic_location varchar [note: 'Geographic location derived from IP address or device GPS (country, region, city). Used for content windowing and blackout restrictions. | Column geographic_location (STRING) in subscriber.device_registration']
  hdr_support boolean [note: 'Indicates whether the device supports HDR video playback (HDR10, Dolby Vision, HLG). Enables premium content delivery. | Column hdr_support (BOOLEAN) in subscriber.device_registration']
  ip_address varchar [note: 'IP address from which the device was registered. Used for geolocation, fraud detection, and blackout enforcement. | Column ip_address (STRING) in subscriber.device_registration']
  last_active_timestamp timestamp [note: 'Date and time of the most recent authenticated activity from this device. Used to identify inactive devices and enforce inactivity policies. | Column last_active_timestamp (TIMESTAMP) in subscriber.device_registration']
  max_download_count varchar [note: 'Maximum number of titles that can be downloaded for offline viewing on this device. Enforced per subscription plan terms. | Column max_download_count (INT) in subscriber.device_registration']
  max_resolution_supported varchar [note: 'Highest video resolution the device can decode and display. Used for adaptive bitrate streaming (ABR) profile selection. | Column max_resolution_supported (STRING) in subscriber.device_registration']
  offline_download_enabled boolean [note: 'Indicates whether this device is authorized for offline content downloads. Subject to plan entitlements and DRM restrictions. | Column offline_download_enabled (BOOLEAN) in subscriber.device_registration']
  parental_control_enabled boolean [note: 'Indicates whether parental controls are active on this device. Restricts access to age-inappropriate content per COPPA and content rating standards. | Column parental_control_enabled (BOOLEAN) in subscriber.device_registration']
  parental_control_pin_hash varchar [note: 'Cryptographic hash of the parental control PIN. Used to authenticate access to restricted content without storing the PIN in plaintext. | Column parental_control_pin_hash (STRING) in subscriber.device_registration']
  push_notification_token varchar [note: 'Device-specific token for sending push notifications (APNS for iOS, FCM for Android). Used for engagement campaigns and service alerts. | Column push_notification_token (STRING) in subscriber.device_registration']
  registration_source varchar [note: 'Channel or interface through which the device was registered. Used for registration workflow analytics and fraud detection. | Column registration_source (STRING) in subscriber.device_registration']
  registration_status varchar [note: 'Current lifecycle status of the device registration. Determines whether the device is authorized for playback. | Column registration_status (STRING) in subscriber.device_registration']
  registration_timestamp timestamp [note: 'Date and time when the device was first registered by the subscriber. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column registration_timestamp (TIMESTAMP) in subscriber.device_registration']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.device_registration']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.device_registration']
  updated_timestamp timestamp [note: 'Timestamp when this device registration record was last modified. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column updated_timestamp (TIMESTAMP) in subscriber.device_registration']
  user_agent varchar [note: 'HTTP user agent string reported by the device. Contains detailed device, OS, and browser information for analytics and troubleshooting. | Column user_agent (STRING) in subscriber.device_registration']

  Note: 'Records every device registered by a subscriber for authenticated playback. Captures device type (smart TV, mobile, tablet, set-top box, web browser, gaming console), device fingerprint, manufacturer, model, OS platform and version, registration timestamp, last active timestamp, device nickname, device status (active, deregistered, blocked), and DRM device certificate reference. Enforces per-account device limits and supports device management workflows including remote deregistration. | Unity Catalog table: media_broadcasting_ecm.subscriber.device_registration'
}

Table subscriber.entitlement {
  entitlement_id varchar [pk, note: 'Unique identifier for the entitlement record. Primary key. | Column entitlement_id (BIGINT) in subscriber.entitlement']
  channel_package_id varchar [note: 'Reference to the channel package or bundle that this entitlement provides access to. | Column channel_package_id (BIGINT) in content.entitlement']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Entitlement authorization must validate content rating against subscriber parental controls and age restrictions. Real business process: streaming platform checks entitlement.compliance_content_rating | Column compliance_content_rating_id (BIGINT) in compliance.entitlement']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Episodic entitlements for serialized content. Essential for SVOD/TVOD episode-level access control, pay-per-episode models, and early-access windows. Complements existing title_id for granular episode | Column content_episode_id (BIGINT) in content.entitlement']
  drm_policy_id varchar [note: 'Reference to the DRM policy that governs content protection and playback authorization for this entitlement. | Column drm_policy_id (BIGINT) in distribution.entitlement']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Entitlements grant subscribers access rights to specific media assets in VOD/streaming platforms. Essential for content delivery authorization, DRM policy enforcement, playback validation, and subscri | Column media_asset_id (BIGINT) in mediaasset.entitlement']
  release_window_id varchar [note: 'Reference to the content windowing strategy that defines the availability period and distribution channel for this entitlement. | Column release_window_id (BIGINT) in distribution.entitlement']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: Season-level entitlements support seasonal release windows, partial series access, and season passes. Common in TVOD and premium tier models where seasons are monetized separately. | Column season_id (BIGINT) in content.entitlement']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Series-level entitlements ("access all episodes") common in subscription models. Supports binge-watching, series passes, and franchise-based access. Enables efficient authorization without per-episode | Column series_id (BIGINT) in content.entitlement']
  subscriber_id varchar [note: 'Reference to the subscriber who holds this entitlement. | Column subscriber_id (BIGINT) in subscriber.entitlement']
  subscription_id varchar [note: 'Foreign key linking to subscriber.subscription. Business justification: Entitlements are granted based on active subscription enrollment. Currently entitlement links to subscriber and subscription_plan, but not to the actual subscription instance. Adding subscription_id F | Column subscription_id (BIGINT) in subscriber.entitlement']
  subscription_plan_id varchar [note: 'Reference to the subscription plan that grants this entitlement. | Column subscription_plan_id (BIGINT) in subscriber.entitlement']
  title_id varchar [note: 'Reference to the specific content asset or title to which access is granted. | Column title_id (BIGINT) in content.entitlement']
  vod_library_id varchar [note: 'Reference to the VOD library collection that this entitlement grants access to. | Column vod_library_id (BIGINT) in content.entitlement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.entitlement']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.entitlement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.entitlement']
  access_level varchar [note: 'Degree of access granted by this entitlement: full (complete access), preview (sample or trailer only), limited (restricted features or duration), or premium (enhanced quality or early access). | Column access_level (STRING) in subscriber.entitlement']
  activated_timestamp timestamp [note: 'Timestamp when the entitlement transitioned from pending to active status and became usable by the subscriber. | Column activated_timestamp (TIMESTAMP) in subscriber.entitlement']
  ad_free boolean [note: 'Indicates whether this entitlement provides ad-free viewing experience. False indicates AVOD (Advertising-Supported Video On Demand) model applies. | Column ad_free (BOOLEAN) in subscriber.entitlement']
  authorization_count varchar [note: 'Total number of playback authorization requests processed for this entitlement since activation. | Column authorization_count (INT) in subscriber.entitlement']
  auto_renew boolean [note: 'Indicates whether this entitlement will automatically renew upon expiration based on the underlying subscription plan. | Column auto_renew (BOOLEAN) in subscriber.entitlement']
  blackout_exempt boolean [note: 'Indicates whether this entitlement is exempt from geographic blackout restrictions typically applied to live sports or regional content. | Column blackout_exempt (BOOLEAN) in subscriber.entitlement']
  compliance_flags varchar [note: 'Comma-separated list of compliance requirements applicable to this entitlement (e.g., \'GDPR\', \'CCPA\', \'COPPA\'). Used to enforce data privacy and regulatory obligations. | Column compliance_flags (STRING) in subscriber.entitlement']
  concurrent_stream_limit varchar [note: 'Maximum number of simultaneous streams allowed under this entitlement. Null indicates no stream limit. | Column concurrent_stream_limit (INT) in subscriber.entitlement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.entitlement']
  created_timestamp timestamp [note: 'Timestamp when this entitlement record was first created in the system. | Column created_timestamp (TIMESTAMP) in subscriber.entitlement']
  device_limit varchar [note: 'Maximum number of concurrent devices that can use this entitlement. Null indicates no device limit. | Column device_limit (INT) in subscriber.entitlement']
  download_enabled boolean [note: 'Indicates whether offline download is permitted for content under this entitlement. | Column download_enabled (BOOLEAN) in subscriber.entitlement']
  early_access_enabled boolean [note: 'Indicates whether this entitlement grants early access to content before general release. | Column early_access_enabled (BOOLEAN) in subscriber.entitlement']
  effective_date date [note: 'Date when the entitlement becomes active and access rights begin. | Column effective_date (DATE) in subscriber.entitlement']
  entitlement_status varchar [note: 'Current lifecycle status of the entitlement: active (currently valid), suspended (temporarily disabled), expired (past end date), revoked (administratively cancelled), or pending (awaiting activation). | Column entitlement_status (STRING) in subscriber.entitlement']
  entitlement_type varchar [note: 'Classification of the entitlement based on how it was granted: subscription (standard plan), promotional (marketing grant), bundle (package deal), addon (premium add-on), mvpd_carriage (Multichannel Video Programming Distributor carriage agreement), or trial (free trial period). | Column entitlement_type (STRING) in subscriber.entitlement']
  expiry_date date [note: 'Date when the entitlement expires and access rights end. Null for perpetual entitlements. | Column expiry_date (DATE) in subscriber.entitlement']
  external_entitlement_reference varchar [note: 'Unique identifier for this entitlement in the originating external system (e.g., Zuora subscription ID, MVPD authorization token). | Column external_entitlement_reference (STRING) in subscriber.entitlement']
  geographic_restriction varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes where this entitlement is valid. Empty indicates no geographic restriction. | Column geographic_restriction (STRING) in subscriber.entitlement']
  grant_reason varchar [note: 'Business justification or reason code for why this entitlement was granted (e.g., \'Annual Subscription\', \'Promotional Campaign Q4-2024\', \'Customer Retention Offer\', \'MVPD Carriage Agreement\'). | Column grant_reason (STRING) in subscriber.entitlement']
  last_authorization_timestamp timestamp [note: 'Timestamp of the most recent playback authorization request that validated this entitlement at the CDN/DRM layer. | Column last_authorization_timestamp (TIMESTAMP) in subscriber.entitlement']
  modified_timestamp timestamp [note: 'Timestamp when this entitlement record was last updated. | Column modified_timestamp (TIMESTAMP) in subscriber.entitlement']
  notes varchar [note: 'Free-text field for additional administrative notes or special instructions related to this entitlement. | Column notes (STRING) in subscriber.entitlement']
  parental_control_level varchar [note: 'Maximum content rating level accessible under this entitlement based on parental control settings. Follows Motion Picture Association (MPA) and TV Parental Guidelines ratings. [ENUM-REF-CANDIDATE: none|g|pg|pg13|r|nc17|tv_y|tv_y7|tv_g|tv_pg|tv_14|tv_ma — 12 candidates stripped; promote to reference product] | Column parental_control_level (STRING) in subscriber.entitlement']
  quality_tier varchar [note: 'Maximum video quality level allowed by this entitlement: sd (standard definition), hd (high definition 1080p), 4k (ultra high definition), or 8k (8K resolution). | Column quality_tier (STRING) in subscriber.entitlement']
  revocation_reason varchar [note: 'Reason why the entitlement was revoked or suspended, if applicable (e.g., \'Payment Failure\', \'Terms of Service Violation\', \'Subscriber Request\', \'Rights Expiration\'). | Column revocation_reason (STRING) in subscriber.entitlement']
  revoked_timestamp timestamp [note: 'Timestamp when the entitlement was permanently revoked, if applicable. | Column revoked_timestamp (TIMESTAMP) in subscriber.entitlement']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.entitlement']
  suspended_timestamp timestamp [note: 'Timestamp when the entitlement was suspended, if applicable. | Column suspended_timestamp (TIMESTAMP) in subscriber.entitlement']
  trial_entitlement boolean [note: 'Indicates whether this is a trial entitlement granted as part of a free trial period. | Column trial_entitlement (BOOLEAN) in subscriber.entitlement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.entitlement']

  Note: 'Defines the specific content access rights granted to a subscriber based on their active subscription plan(s). Maps subscriber to entitled content windows, channel packages, VOD libraries, and premium add-ons. Captures entitlement source (plan, promotional grant, MVPD carriage), effective date, expiry date, and entitlement status. Drives playback authorization decisions at the CDN/DRM layer. | Unity Catalog table: media_broadcasting_ecm.subscriber.entitlement'
}

Table subscriber.parental_control {
  parental_control_id varchar [pk, note: 'Unique identifier for the parental control configuration record. Primary key. | Column parental_control_id (BIGINT) in subscriber.parental_control']
  household_id varchar [note: 'Foreign key linking to subscriber.household. Business justification: Parental controls can be configured at household level (applying to all profiles in the household) or at individual profile level. Currently parental_control has subscriber_id and profile_id FKs. Addi | Column household_id (BIGINT) in subscriber.parental_control']
  subscriber_id varchar [note: 'Reference to the subscriber account that owns this parental control configuration. Links to the subscriber master record. | Column subscriber_id (BIGINT) in subscriber.parental_control']
  viewer_profile_id varchar [note: 'Reference to the specific viewing profile within the subscriber account to which this parental control applies. Enables per-profile restrictions within a household. | Column viewer_profile_id (BIGINT) in subscriber.parental_control']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.parental_control']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.parental_control']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.parental_control']
  allowed_viewing_end_time timestamp [note: 'End time of the daily viewing window in HH:MM format (24-hour clock). Content access is blocked after this time. Null if viewing_time_restriction_enabled is False. | Column allowed_viewing_end_time (TIMESTAMP) in subscriber.parental_control']
  allowed_viewing_start_time timestamp [note: 'Start time of the daily viewing window in HH:MM format (24-hour clock). Content access is permitted starting at this time. Null if viewing_time_restriction_enabled is False. | Column allowed_viewing_start_time (TIMESTAMP) in subscriber.parental_control']
  autoplay_enabled boolean [note: 'Indicates whether automatic playback of next episode or recommended content is enabled for this profile. True if autoplay is on, False if disabled (often disabled for child profiles to limit binge-watching). | Column autoplay_enabled (BOOLEAN) in subscriber.parental_control']
  blocked_content_categories varchar [note: 'Comma-separated list of content genre or category codes that are explicitly blocked for this profile (e.g., \'horror\', \'violence\', \'adult\'). Provides granular control beyond rating thresholds. | Column blocked_content_categories (STRING) in subscriber.parental_control']
  ccpa_opt_out_flag boolean [note: 'Indicates whether the subscriber has opted out of data sharing under CCPA. True if opted out, False otherwise. Affects how parental control data may be used for analytics or personalization. | Column ccpa_opt_out_flag (BOOLEAN) in subscriber.parental_control']
  configuration_name varchar [note: 'User-defined label for this parental control configuration (e.g., \'Kids Profile\', \'Teen Settings\'). Helps account holders manage multiple configurations. | Column configuration_name (STRING) in subscriber.parental_control']
  content_language_restriction varchar [note: 'Comma-separated list of ISO 639-1 language codes (e.g., \'en\', \'es\', \'fr\') to which content access is restricted. Null if no language restrictions apply. Used to limit content to specific languages for child profiles. | Column content_language_restriction (STRING) in subscriber.parental_control']
  content_rating_threshold varchar [note: 'Maximum content rating allowed for viewing under this configuration. Based on Motion Picture Association (MPA) film ratings (G, PG, PG-13, R, NC-17) and TV Parental Guidelines (TV-Y, TV-Y7, TV-G, TV-PG, TV-14, TV-MA). Content rated above this threshold is blocked. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA — 11 candidates stripped; promote to reference product] | Column content_rating_threshold (STRING) in subscriber.parental_control']
  coppa_child_profile_flag boolean [note: 'Indicates whether this profile is designated as belonging to a child under 13 years of age, triggering COPPA compliance requirements. True if the profile is for a child under 13, False otherwise. | Column coppa_child_profile_flag (BOOLEAN) in subscriber.parental_control']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.parental_control']
  created_timestamp timestamp [note: 'Timestamp when this parental control configuration record was first created in the system. | Column created_timestamp (TIMESTAMP) in subscriber.parental_control']
  device_restriction_enabled boolean [note: 'Indicates whether this parental control configuration restricts viewing to specific registered devices. True if device restrictions are enforced, False if profile can be accessed from any device. | Column device_restriction_enabled (BOOLEAN) in subscriber.parental_control']
  effective_date date [note: 'Date when this parental control configuration became or will become active. Supports scheduled activation of restrictions. | Column effective_date (DATE) in subscriber.parental_control']
  expiration_date date [note: 'Date when this parental control configuration expires or is scheduled to be deactivated. Null if no expiration is set. | Column expiration_date (DATE) in subscriber.parental_control']
  gdpr_consent_flag boolean [note: 'Indicates whether the account holder has provided explicit consent for processing parental control data under GDPR. True if consent is granted, False otherwise. Required for EU subscribers. | Column gdpr_consent_flag (BOOLEAN) in subscriber.parental_control']
  last_modified_by varchar [note: 'Identifier of the user or system process that last modified this parental control configuration. Used for audit trail and accountability. | Column last_modified_by (STRING) in subscriber.parental_control']
  last_modified_timestamp timestamp [note: 'Timestamp when this parental control configuration was last modified. Supports audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in subscriber.parental_control']
  maturity_level_override varchar [note: 'Custom maturity level designation that overrides standard rating thresholds for specific content. Used for granular exceptions (e.g., allowing a specific R-rated film for educational purposes). Null if no override is set. | Column maturity_level_override (STRING) in subscriber.parental_control']
  max_daily_viewing_minutes varchar [note: 'Maximum number of minutes of content viewing allowed per day for this profile. Null if no daily limit is set. Used to enforce screen time limits for child profiles. | Column max_daily_viewing_minutes (INT) in subscriber.parental_control']
  notification_email varchar [note: 'Email address to which parental control alerts and notifications are sent (e.g., when a child attempts to access restricted content). Null if notifications are disabled. | Column notification_email (STRING) in subscriber.parental_control']
  parental_control_status varchar [note: 'Current lifecycle status of this parental control configuration. Active indicates the configuration is enforced; Inactive indicates it is saved but not enforced; Suspended indicates temporary deactivation by system or admin. | Column parental_control_status (STRING) in subscriber.parental_control']
  pin_code_hash varchar [note: 'Cryptographic hash of the parental control PIN. Stored as a one-way hash for security. Never stored in plaintext. Used to authenticate access to restricted content or settings changes. | Column pin_code_hash (STRING) in subscriber.parental_control']
  pin_protection_enabled boolean [note: 'Indicates whether a PIN is required to access content above the rating threshold or to modify parental control settings. True if PIN protection is active, False otherwise. | Column pin_protection_enabled (BOOLEAN) in subscriber.parental_control']
  purchase_lock_enabled boolean [note: 'Indicates whether transactional purchases (TVOD - Transactional Video On Demand) are blocked for this profile. True if purchase lock is active (preventing rentals/purchases), False if purchases are allowed. | Column purchase_lock_enabled (BOOLEAN) in subscriber.parental_control']
  search_restriction_enabled boolean [note: 'Indicates whether search functionality is restricted to only show age-appropriate content. True if search results are filtered by parental controls, False if unrestricted search is allowed. | Column search_restriction_enabled (BOOLEAN) in subscriber.parental_control']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.parental_control']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.parental_control']
  viewing_time_restriction_enabled boolean [note: 'Indicates whether time-of-day viewing restrictions are enforced for this profile. True if time restrictions are active, False otherwise. | Column viewing_time_restriction_enabled (BOOLEAN) in subscriber.parental_control']

  Note: 'Stores parental control configurations set by the account holder for a household or individual profile. Captures content rating thresholds (MPA ratings: G, PG, PG-13, R, NC-17), PIN protection settings, COPPA child profile flag, blocked content categories, purchase lock, and time-of-day viewing restrictions. Enforces COPPA compliance for profiles identified as under-13. | Unity Catalog table: media_broadcasting_ecm.subscriber.parental_control'
}

Table subscriber.viewer_profile {
  viewer_profile_id varchar [pk, note: 'Unique identifier for the viewer profile within a subscriber account or household. Primary key. | Column viewer_profile_id (BIGINT) in subscriber.viewer_profile']
  device_registration_id varchar [note: 'Identifier of the last device used to access this viewer profile. Used for device tracking, security monitoring, and cross-device analytics. May reference device registration records. | Column device_registration_id (BIGINT) in subscriber.viewer_profile']
  favorite_genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Personalization and recommendation engines require explicit genre preferences. Drives content discovery, homepage curation, and email marketing. Complements behavioral signals with declared preference | Column favorite_genre_id (BIGINT) in content.viewer_profile']
  personalization_engine_id varchar [note: 'Foreign key linking to distribution.personalization_engine. Business justification: A/B testing and personalization require tracking which recommendation engine serves each profile. Critical for measuring algorithm performance, cold-start strategy effectiveness, and experimentation i | Column personalization_engine_id (BIGINT) in distribution.viewer_profile']
  subscriber_id varchar [note: 'Reference to the parent subscriber account that owns this viewer profile. One subscriber may have multiple viewer profiles (e.g., up to 5 profiles per account). | Column subscriber_id (BIGINT) in subscriber.viewer_profile']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.viewer_profile']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.viewer_profile']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.viewer_profile']
  aep_segment_ids varchar [note: 'Comma-separated list of Adobe Experience Platform segment IDs that this viewer profile belongs to. Used for personalized content recommendations, targeted advertising, and dynamic user experience customization. | Column aep_segment_ids (STRING) in subscriber.viewer_profile']
  audio_language varchar [note: 'ISO 639-1 two-letter language code for preferred audio track language. Used for multi-language content with multiple audio tracks. | Column audio_language (STRING) in subscriber.viewer_profile']
  autoplay_enabled boolean [note: 'Boolean flag indicating whether autoplay of next episode or content is enabled for this profile. True enables automatic playback; false requires manual selection. | Column autoplay_enabled (BOOLEAN) in subscriber.viewer_profile']
  autoplay_previews_enabled boolean [note: 'Boolean flag indicating whether automatic preview playback is enabled when browsing content. True enables preview autoplay; false disables previews. | Column autoplay_previews_enabled (BOOLEAN) in subscriber.viewer_profile']
  avatar_url varchar [note: 'URL reference to the profile avatar image stored in the Media Asset Management (MAM) system or Content Delivery Network (CDN). Used for visual identification in profile selection interfaces. | Column avatar_url (STRING) in subscriber.viewer_profile']
  ccpa_opt_out_flag boolean [note: 'Boolean flag indicating whether the viewer has opted out of personal data sale under CCPA (California Consumer Privacy Act). True indicates opt-out; false indicates consent. Required for California viewer data privacy compliance. | Column ccpa_opt_out_flag (BOOLEAN) in subscriber.viewer_profile']
  coppa_compliant_flag boolean [note: 'Boolean flag indicating whether this profile is subject to COPPA (Children\'s Online Privacy Protection Act) compliance requirements. True for profiles of children under 13; false for adult profiles. Enforces enhanced privacy protections and parental consent requirements. | Column coppa_compliant_flag (BOOLEAN) in subscriber.viewer_profile']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.viewer_profile']
  created_timestamp timestamp [note: 'Timestamp when the viewer profile was first created in the system. Used for audit trail, lifecycle tracking, and compliance reporting. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column created_timestamp (TIMESTAMP) in subscriber.viewer_profile']
  data_saver_mode boolean [note: 'Boolean flag indicating whether data saver mode is enabled to reduce bandwidth consumption. True limits video quality and disables high-bandwidth features; false allows full quality streaming. | Column data_saver_mode (BOOLEAN) in subscriber.viewer_profile']
  download_enabled boolean [note: 'Boolean flag indicating whether this profile is entitled to download content for offline viewing. True enables download feature; false restricts to streaming only. Controlled by subscription tier and DRM (Digital Rights Management) policies. | Column download_enabled (BOOLEAN) in subscriber.viewer_profile']
  gdpr_consent_timestamp timestamp [note: 'Timestamp when GDPR (General Data Protection Regulation) consent was obtained for this viewer profile. Required for EU audience data privacy compliance. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column gdpr_consent_timestamp (TIMESTAMP) in subscriber.viewer_profile']
  genre_preferences varchar [note: 'Comma-separated list of preferred content genre identifiers for personalization and recommendation algorithms. Derived from viewing history and explicit user selections. Used by Adobe Experience Platform for segment targeting. | Column genre_preferences (STRING) in subscriber.viewer_profile']
  is_default_profile boolean [note: 'Boolean flag indicating whether this is the default profile that is automatically selected when the subscriber logs in. True for default profile; false for secondary profiles. Only one profile per subscriber should be marked as default. | Column is_default_profile (BOOLEAN) in subscriber.viewer_profile']
  is_kids_profile boolean [note: 'Boolean flag indicating whether this is a dedicated kids profile with enhanced parental controls, age-appropriate content filtering, and COPPA (Children\'s Online Privacy Protection Act) compliance enforcement. True for kids profiles; false for adult/general profiles. | Column is_kids_profile (BOOLEAN) in subscriber.viewer_profile']
  language_preference varchar [note: 'ISO 639-1 two-letter language code with optional ISO 3166-1 alpha-2 country code (e.g., \'en\', \'en-US\', \'es-MX\'). Determines the language for user interface, content metadata, and audio/subtitle defaults. | Column language_preference (STRING) in subscriber.viewer_profile']
  last_access_timestamp timestamp [note: 'Timestamp when the viewer profile was last accessed or used for content viewing. Used for engagement analytics, churn prediction, and inactive profile identification. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column last_access_timestamp (TIMESTAMP) in subscriber.viewer_profile']
  last_modified_timestamp timestamp [note: 'Timestamp when the viewer profile was last updated or modified. Used for audit trail, change tracking, and data synchronization. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column last_modified_timestamp (TIMESTAMP) in subscriber.viewer_profile']
  last_platform varchar [note: 'Platform type of the last device used to access this viewer profile. Used for platform-specific analytics and Over-The-Top (OTT) distribution tracking. [ENUM-REF-CANDIDATE: web|mobile_ios|mobile_android|smart_tv|roku|fire_tv|apple_tv|chromecast|gaming_console — 9 candidates stripped; promote to reference product] | Column last_platform (STRING) in subscriber.viewer_profile']
  marketing_consent boolean [note: 'Boolean flag indicating whether the viewer profile has consented to receive marketing communications and promotional content. True allows marketing; false opts out. Required for GDPR (General Data Protection Regulation) and CCPA (California Consumer Privacy Act) compliance. | Column marketing_consent (BOOLEAN) in subscriber.viewer_profile']
  maturity_rating_level varchar [note: 'Maximum content maturity rating level allowed for this viewer profile. Enforces parental controls and content filtering based on Motion Picture Association (MPA) film ratings and TV Parental Guidelines. Content exceeding this rating is blocked from playback. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA — 11 candidates stripped; promote to reference product] | Column maturity_rating_level (STRING) in subscriber.viewer_profile']
  max_concurrent_streams varchar [note: 'Maximum number of concurrent video streams allowed for this viewer profile. Enforces Digital Rights Management (DRM) and subscription tier entitlements. Typical values range from 1 to 4 streams. | Column max_concurrent_streams (INT) in subscriber.viewer_profile']
  max_downloads varchar [note: 'Maximum number of content titles that can be downloaded for offline viewing on this profile. Enforces subscription tier limits and storage management policies. | Column max_downloads (INT) in subscriber.viewer_profile']
  personalization_enabled boolean [note: 'Boolean flag indicating whether personalized content recommendations and user experience customization are enabled for this profile. True enables Adobe Experience Platform personalization; false provides generic content discovery. Impacts GDPR (General Data Protection Regulation) and CCPA (California Consumer Privacy Act) consent requirements. | Column personalization_enabled (BOOLEAN) in subscriber.viewer_profile']
  pin_code_hash varchar [note: 'Hashed PIN code for profile access control and parental lock enforcement. Used to restrict access to mature content or prevent unauthorized profile switching. Stored as cryptographic hash for security. | Column pin_code_hash (STRING) in subscriber.viewer_profile']
  pin_enabled boolean [note: 'Boolean flag indicating whether PIN protection is enabled for this profile. True requires PIN entry for profile access; false allows unrestricted access. | Column pin_enabled (BOOLEAN) in subscriber.viewer_profile']
  profile_name varchar [note: 'Human-readable display name for the viewer profile (e.g., \'Dad\', \'Kids\', \'Guest\'). Used for profile selection and personalization. | Column profile_name (STRING) in subscriber.viewer_profile']
  profile_sort_order varchar [note: 'Integer value determining the display order of this profile in the profile selection interface. Lower values appear first. Used for user experience optimization. | Column profile_sort_order (INT) in subscriber.viewer_profile']
  profile_status varchar [note: 'Current lifecycle state of the viewer profile. Active profiles can access content; inactive profiles are temporarily disabled; suspended profiles are blocked due to policy violations; deleted profiles are soft-deleted and retained for compliance. | Column profile_status (STRING) in subscriber.viewer_profile']
  profile_type varchar [note: 'Classification of the viewer profile within the household. Primary profiles have full account privileges; secondary profiles may have restricted access; kids profiles enforce parental controls; guest profiles are temporary. | Column profile_type (STRING) in subscriber.viewer_profile']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.viewer_profile']
  subtitle_language varchar [note: 'ISO 639-1 two-letter language code for preferred subtitle language. Used when subtitle_preference is enabled. | Column subtitle_language (STRING) in subscriber.viewer_profile']
  subtitle_preference varchar [note: 'Default subtitle display preference for this viewer profile. Off disables subtitles; on always displays subtitles; auto displays subtitles based on content language and user language mismatch. | Column subtitle_preference (STRING) in subscriber.viewer_profile']
  total_viewing_hours decimal(12,2) [note: 'Cumulative total viewing hours for this viewer profile across all content and sessions. Used for engagement metrics, Average Revenue Per User (ARPU) analysis, and Lifetime Value (LTV) calculations. | Column total_viewing_hours (DECIMAL(12,2)) in subscriber.viewer_profile']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.viewer_profile']
  video_quality_preference varchar [note: 'Preferred video streaming quality for this profile. Auto uses Adaptive Bitrate Streaming (ABR) based on bandwidth; low/medium/high/ultra_hd enforce specific quality tiers. Impacts Content Delivery Network (CDN) delivery and bandwidth consumption. | Column video_quality_preference (STRING) in subscriber.viewer_profile']
  viewing_history_enabled boolean [note: 'Boolean flag indicating whether viewing history is tracked and stored for this profile. True enables history tracking for recommendations and resume playback; false disables tracking for privacy. Impacts GDPR (General Data Protection Regulation) and CCPA (California Consumer Privacy Act) compliance. | Column viewing_history_enabled (BOOLEAN) in subscriber.viewer_profile']

  Note: 'Individual viewing profile within a subscriber account or household — supporting multi-profile accounts (e.g., up to 5 profiles per account). Captures profile name, avatar, language preference, content genre preferences, maturity rating level, is_kids_profile flag, and Adobe Experience Platform segment IDs for personalization. Distinct from the subscriber master record — one subscriber may have multiple viewer profiles. | Unity Catalog table: media_broadcasting_ecm.subscriber.viewer_profile D2C streaming lifecycle entity supporting subscriber+subscription+entitlement+playback_session+churn_event+offer flows.'
}

Table subscriber.churn_event {
  churn_event_id varchar [pk, note: 'Unique identifier for the subscriber churn event record. | Column churn_event_id (BIGINT) in subscriber.churn_event']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Churn events are analyzed by cost center for retention program budgeting and departmental accountability. Marketing and customer success teams track churn metrics against their cost center budgets for | Column cost_center_id (BIGINT) in finance.churn_event']
  distribution_partner_id varchar [note: 'Reference to the MVPD or vMVPD partner through which the subscription was provisioned. Null for direct-to-consumer subscriptions. Used for partner churn analysis. | Column distribution_partner_id (BIGINT) in distribution.churn_event']
  household_id varchar [note: 'Reference to the household to which the churned subscriber belonged. Used for household-level churn analysis and multi-subscriber household retention strategies. | Column household_id (BIGINT) in subscriber.churn_event']
  last_viewed_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Churn analysis tracks last content engagement to identify content gaps and inform win-back campaigns. Critical for retention analytics, content investment decisions, and personalized re-engagement off | Column last_viewed_title_id (BIGINT) in content.churn_event']
  outage_record_id varchar [note: 'Foreign key linking to technology.outage_record. Business justification: Churn analysis must correlate service cancellations with technical outages to quantify revenue impact of infrastructure failures and prioritize reliability investments. Retention analytics require lin | Column outage_record_id (BIGINT) in technology.churn_event']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Churn analysis by profit center is critical for segment profitability reporting and EBITDA calculation. Media companies track subscriber retention by business unit for strategic resource allocation an | Column profit_center_id (BIGINT) in finance.churn_event']
  retention_agent_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Retention specialists (workforce) are assigned to at-risk subscribers for win-back campaigns. Critical for churn prevention workflow tracking, agent performance metrics, and retention campaign ROI ana | Column retention_agent_employee_id (BIGINT) in workforce.churn_event']
  subscriber_id varchar [note: 'Reference to the subscriber who churned. Links to the subscriber master record. | Column subscriber_id (BIGINT) in subscriber.churn_event']
  subscription_id varchar [note: 'Reference to the specific subscription that was cancelled. Links to the subscription master record. | Column subscription_id (BIGINT) in subscriber.churn_event']
  win_back_offer_id varchar [note: 'Reference to the specific retention or win-back offer that was presented to the subscriber. Null if no offer was presented. | Column win_back_offer_id (BIGINT) in subscriber.churn_event']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.churn_event']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.churn_event']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.churn_event']
  auto_renew_disabled_date date [note: 'The date when the subscriber disabled auto-renewal for their subscription. Null if auto-renewal was never disabled. Used to identify planned churn versus reactive churn. | Column auto_renew_disabled_date (DATE) in subscriber.churn_event']
  cancellation_channel varchar [note: 'The interface or channel through which the cancellation was initiated. Supports analysis of churn patterns by customer touchpoint. [ENUM-REF-CANDIDATE: web_self_service|mobile_app|customer_care|email|chat|ivr|mvpd_drop|system_automated — 8 candidates stripped; promote to reference product] | Column cancellation_channel (STRING) in subscriber.churn_event']
  cancellation_reason_code varchar [note: 'Standardized code representing the stated reason for cancellation. Used for churn analytics and product improvement initiatives. Empty value_regex indicates reference to external reason code lookup table with more than 6 values. | Column cancellation_reason_code (STRING) in subscriber.churn_event']
  cancellation_reason_description varchar [note: 'Free-text description or additional details provided by the subscriber explaining the reason for cancellation. Supports qualitative churn analysis. | Column cancellation_reason_description (STRING) in subscriber.churn_event']
  ccpa_opt_out_flag boolean [note: 'Boolean indicator of whether the subscriber exercised CCPA opt-out rights regarding data sale or sharing. Used for privacy compliance and marketing eligibility. | Column ccpa_opt_out_flag (BOOLEAN) in subscriber.churn_event']
  churn_prediction_score decimal(5,4) [note: 'The machine learning model-generated churn risk score that was assigned to the subscriber prior to the churn event. Range 0.0000 to 1.0000, where higher values indicate higher churn risk. Used for model validation and predictive accuracy assessment. | Column churn_prediction_score (DECIMAL(5,4)) in subscriber.churn_event']
  churn_timestamp timestamp [note: 'The exact date and time when the subscriber cancellation or lapse event occurred. This is the business event timestamp representing when the subscriber relationship ended. | Column churn_timestamp (TIMESTAMP) in subscriber.churn_event']
  churn_type varchar [note: 'Classification of the churn event based on the nature of cancellation. Voluntary indicates subscriber-initiated cancellation, involuntary indicates business-initiated termination, payment failure indicates cancellation due to billing issues. | Column churn_type (STRING) in subscriber.churn_event']
  competitor_service_mentioned_flag boolean [note: 'Boolean indicator of whether the subscriber mentioned switching to a competitor service during the cancellation process. Used for competitive intelligence and market positioning analysis. | Column competitor_service_mentioned_flag (BOOLEAN) in subscriber.churn_event']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.churn_event']
  created_timestamp timestamp [note: 'The timestamp when this churn event record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in subscriber.churn_event']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the last payment amount. Supports multi-currency subscription operations. | Column currency_code (STRING) in subscriber.churn_event']
  customer_care_contact_count varchar [note: 'The number of customer care interactions the subscriber had in the 30 days prior to churn. Used to identify service quality issues and early warning signals. | Column customer_care_contact_count (INT) in subscriber.churn_event']
  days_since_last_viewing varchar [note: 'The number of days between the last viewing activity and the churn event. Used for engagement-based churn prediction models. | Column days_since_last_viewing (INT) in subscriber.churn_event']
  device_count_at_churn varchar [note: 'The number of registered devices associated with the subscriber at the time of churn. Used for multi-device engagement analysis. | Column device_count_at_churn (INT) in subscriber.churn_event']
  final_access_date date [note: 'The last date the subscriber had active access to content and services. May differ from churn_timestamp due to grace periods or paid-through dates. | Column final_access_date (DATE) in subscriber.churn_event']
  gdpr_data_deletion_requested_flag boolean [note: 'Boolean indicator of whether the subscriber requested deletion of their personal data under GDPR right to erasure at the time of churn. Used for privacy compliance tracking. | Column gdpr_data_deletion_requested_flag (BOOLEAN) in subscriber.churn_event']
  last_payment_amount decimal(15,2) [note: 'The monetary value of the last successful payment received from the subscriber before churn. Used for ARPU (Average Revenue Per User) and revenue impact analysis. | Column last_payment_amount (DECIMAL(15,2)) in subscriber.churn_event']
  last_payment_date date [note: 'The date of the last successful payment received from the subscriber before churn. Used for revenue recognition and payment failure analysis. | Column last_payment_date (DATE) in subscriber.churn_event']
  last_viewing_date date [note: 'The date of the subscribers last content viewing activity before churn. Used to identify engagement drop-off patterns and at-risk subscriber signals. | Column last_viewing_date (DATE) in subscriber.churn_event']
  notes varchar [note: 'Free-text field for additional notes, comments, or context about the churn event captured by customer care agents or system processes. | Column notes (STRING) in subscriber.churn_event']
  parental_control_enabled_flag boolean [note: 'Boolean indicator of whether parental controls were enabled on the subscription at the time of churn. Used for family-oriented subscriber segmentation and churn analysis. | Column parental_control_enabled_flag (BOOLEAN) in subscriber.churn_event']
  payment_failure_count varchar [note: 'The number of consecutive payment failures that occurred before the churn event. Used to identify involuntary churn patterns and dunning effectiveness. | Column payment_failure_count (INT) in subscriber.churn_event']
  promotional_discount_active_flag boolean [note: 'Boolean indicator of whether the subscriber had an active promotional discount at the time of churn. Used to analyze price sensitivity and promotional effectiveness. | Column promotional_discount_active_flag (BOOLEAN) in subscriber.churn_event']
  reactivation_eligibility_date date [note: 'The date when the churned subscriber becomes eligible for reactivation campaigns or promotional offers. Used for win-back campaign targeting and timing. | Column reactivation_eligibility_date (DATE) in subscriber.churn_event']
  service_tier varchar [note: 'The subscription service tier that was cancelled. SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand). | Column service_tier (STRING) in subscriber.churn_event']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.churn_event']
  subscription_tenure_months varchar [note: 'The total number of months the subscriber maintained an active subscription before churning. Used for cohort analysis and LTV (Lifetime Value) calculations. | Column subscription_tenure_months (INT) in subscriber.churn_event']
  total_lifetime_revenue decimal(15,2) [note: 'The cumulative revenue generated from this subscriber across their entire subscription tenure. Used for LTV (Lifetime Value) analysis and churn impact assessment. | Column total_lifetime_revenue (DECIMAL(15,2)) in subscriber.churn_event']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.churn_event']
  updated_timestamp timestamp [note: 'The timestamp when this churn event record was last modified. Used for audit trail and change tracking. | Column updated_timestamp (TIMESTAMP) in subscriber.churn_event']
  win_back_offer_accepted_flag boolean [note: 'Boolean indicator of whether the subscriber accepted the win-back offer. True indicates acceptance and retention, False indicates rejection and churn completion. Null if no offer was presented. | Column win_back_offer_accepted_flag (BOOLEAN) in subscriber.churn_event']
  win_back_offer_presented_flag boolean [note: 'Boolean indicator of whether a retention or win-back offer was presented to the subscriber during the cancellation process. True indicates an offer was made, False indicates no offer was presented. | Column win_back_offer_presented_flag (BOOLEAN) in subscriber.churn_event']

  Note: 'Operational record of a subscriber cancellation or lapse event. Captures cancellation timestamp, cancellation channel (self-service, customer care, payment failure, MVPD drop), stated cancellation reason, win-back offer presented flag, win-back offer accepted flag, and reactivation eligibility date. Supports churn rate reporting and retention campaign targeting. Distinct from analytics — this is the operational event record. | Unity Catalog table: media_broadcasting_ecm.subscriber.churn_event'
}

Table subscriber.subscription_change {
  subscription_change_id varchar [pk, note: 'Unique identifier for the subscription change event. Primary key. | Column subscription_change_id (BIGINT) in subscriber.subscription_change']
  add_on_id varchar [note: 'Reference to the add-on product attached or detached during this change. Populated only for add-on attach and add-on detach change types. | Column add_on_id (BIGINT) in subscriber.subscription_change']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Subscription changes originating from partner-driven campaigns (MVPD upgrade offers, bundling promotions, affiliate retention programs) require tracking the partner for revenue attribution, partner pe | Column partner_id (BIGINT) in partner.subscription_change']
  primary_subscription_employee_id varchar [note: 'Reference to the user account (subscriber self-service or internal agent) that initiated the subscription change. Used for audit trails and agent performance tracking. | Column primary_subscription_employee_id (BIGINT) in workforce.subscription_change']
  primary_subscription_plan_id varchar [note: 'Reference to the subscription plan that was active before this change. Null for new subscriptions or add-on attach events. | Column primary_subscription_plan_id (BIGINT) in subscriber.subscription_change']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Plan upgrades/downgrades affect revenue stream classification for financial reporting. Finance tracks MRR changes by revenue stream for forecasting, variance analysis, and segment performance reportin | Column revenue_stream_id (BIGINT) in finance.subscription_change']
  subscriber_id varchar [note: 'Reference to the subscriber who owns this subscription. Enables subscriber-level change analysis and churn tracking. | Column subscriber_id (BIGINT) in subscriber.subscription_change']
  subscription_id varchar [note: 'Reference to the subscription that was modified. Links to the parent subscription record in the subscriber domain. | Column subscription_id (BIGINT) in subscriber.subscription_change']
  zuora_invoice_id varchar [note: 'The unique identifier of the Zuora invoice generated for this subscription change. Links the change event to billing and revenue recognition processes. | Column zuora_invoice_id (BIGINT) in billing.subscription_change']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.subscription_change']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.subscription_change']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.subscription_change']
  applied_discount_amount decimal(15,2) [note: 'The total discount amount applied to the new plan as part of this change. Includes promotional offers, retention discounts, and loyalty rewards. | Column applied_discount_amount (DECIMAL(15,2)) in subscriber.subscription_change']
  applied_discount_percentage decimal(5,2) [note: 'The percentage discount applied to the new plan subscription fee. Used for promotion effectiveness analysis and revenue impact modeling. | Column applied_discount_percentage (DECIMAL(5,2)) in subscriber.subscription_change']
  auto_renew_enabled boolean [note: 'Indicates whether automatic renewal is enabled for the subscription after this change. Critical for churn prediction and renewal revenue forecasting. | Column auto_renew_enabled (BOOLEAN) in subscriber.subscription_change']
  change_channel varchar [note: 'The channel through which the subscription change was initiated. Enables channel effectiveness analysis and self-service adoption tracking. [ENUM-REF-CANDIDATE: web|mobile app|call center|chat|email|api|admin portal — 7 candidates stripped; promote to reference product] | Column change_channel (STRING) in subscriber.subscription_change']
  change_effective_date date [note: 'The date when the subscription change became effective and billing adjustments were applied. Critical for revenue recognition and proration calculations. | Column change_effective_date (DATE) in subscriber.subscription_change']
  change_notes varchar [note: 'Free-text notes or comments recorded by the agent or system during the change process. Captures context, customer feedback, and special handling instructions. | Column change_notes (STRING) in subscriber.subscription_change']
  change_processed_timestamp timestamp [note: 'The exact date and time when the system completed processing the change and updated the subscription state. Used for operational efficiency metrics. | Column change_processed_timestamp (TIMESTAMP) in subscriber.subscription_change']
  change_reason varchar [note: 'The primary reason provided or inferred for the subscription change. Critical for churn analysis, retention strategy, and product improvement. | Column change_reason (STRING) in subscriber.subscription_change']
  change_request_timestamp timestamp [note: 'The exact date and time when the subscriber or agent initiated the change request. Used for time-to-fulfillment analysis and customer experience tracking. | Column change_request_timestamp (TIMESTAMP) in subscriber.subscription_change']
  change_type varchar [note: 'The type of change applied to the subscription. Categorizes the nature of the modification for lifecycle analysis and revenue impact assessment. | Column change_type (STRING) in subscriber.subscription_change']
  content_entitlement_change varchar [note: 'Describes changes to content library access, premium channel entitlements, or windowing rights resulting from this subscription change. Critical for content licensing and rights management. | Column content_entitlement_change (STRING) in subscriber.subscription_change']
  contract_term_months varchar [note: 'The length of the new subscription contract term in months resulting from this change. Used for commitment analysis and churn risk modeling. | Column contract_term_months (INT) in subscriber.subscription_change']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.subscription_change']
  created_timestamp timestamp [note: 'The timestamp when this subscription change record was first created in the data platform. Used for data lineage and audit trail purposes. | Column created_timestamp (TIMESTAMP) in subscriber.subscription_change']
  device_limit_new varchar [note: 'The maximum number of concurrent devices allowed under the new subscription plan. Enables analysis of device limit impact on upgrade and downgrade decisions. | Column device_limit_new (INT) in subscriber.subscription_change']
  device_limit_previous varchar [note: 'The maximum number of concurrent devices allowed under the previous subscription plan. Used to track device entitlement changes and household sharing patterns. | Column device_limit_previous (INT) in subscriber.subscription_change']
  last_modified_timestamp timestamp [note: 'The timestamp when this subscription change record was last updated in the data platform. Supports change data capture and incremental processing workflows. | Column last_modified_timestamp (TIMESTAMP) in subscriber.subscription_change']
  mrr_impact_amount decimal(15,2) [note: 'The net change in monthly recurring revenue resulting from this subscription change. Positive for upgrades, negative for downgrades. Calculated as new_monthly_recurring_revenue minus previous_monthly_recurring_revenue. | Column mrr_impact_amount (DECIMAL(15,2)) in subscriber.subscription_change']
  new_billing_period varchar [note: 'The billing frequency of the new subscription plan. Enables analysis of billing period changes and their impact on cash flow and retention. | Column new_billing_period (STRING) in subscriber.subscription_change']
  new_monthly_recurring_revenue decimal(15,2) [note: 'The monthly recurring revenue amount from the new plan after this change. Used to calculate MRR expansion, contraction, and net revenue retention metrics. | Column new_monthly_recurring_revenue (DECIMAL(15,2)) in subscriber.subscription_change']
  offer_code varchar [note: 'The promotional code or coupon code entered by the subscriber during the change process. Used for campaign tracking and fraud detection. | Column offer_code (STRING) in subscriber.subscription_change']
  offer_redemption_status varchar [note: 'The status of promotional offer redemption at the time of subscription change. Tracks successful and failed offer applications for campaign effectiveness measurement. | Column offer_redemption_status (STRING) in subscriber.subscription_change']
  previous_billing_period varchar [note: 'The billing frequency of the previous subscription plan. Used to analyze billing period migration patterns and payment preference trends. | Column previous_billing_period (STRING) in subscriber.subscription_change']
  previous_monthly_recurring_revenue decimal(15,2) [note: 'The monthly recurring revenue amount from the previous plan before this change. Critical for MRR movement analysis and revenue waterfall reporting. | Column previous_monthly_recurring_revenue (DECIMAL(15,2)) in subscriber.subscription_change']
  promotional_offer_code varchar [note: 'Reference to the promotional offer or retention campaign that was redeemed during this subscription change. Null if no offer was applied. | Column promotional_offer_code (BIGINT) in subscriber.subscription_change']
  proration_amount decimal(15,2) [note: 'The prorated credit or charge amount applied to the subscriber account due to mid-cycle plan changes. Positive values represent charges, negative values represent credits. | Column proration_amount (DECIMAL(15,2)) in subscriber.subscription_change']
  proration_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the proration amount. Supports multi-currency subscription operations. | Column proration_currency_code (STRING) in subscriber.subscription_change']
  service_tier_change varchar [note: 'Describes the service tier transition for this subscription change. Specific to media streaming business models including AVOD (Advertising-Supported Video On Demand), SVOD (Subscription Video On Demand), and tiered SVOD offerings. | Column service_tier_change (STRING) in subscriber.subscription_change']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.subscription_change']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.subscription_change']
  zuora_amendment_reference varchar [note: 'The unique identifier of the Zuora subscription amendment record that represents this change. Enables reconciliation with the billing system of record. | Column zuora_amendment_reference (STRING) in subscriber.subscription_change']

  Note: 'Audit trail of all plan changes, upgrades, downgrades, pauses, reinstatements, and promotional offer redemptions on a subscriber\'s subscription. Captures previous plan, new plan, change type (upgrade, downgrade, pause, reactivate, add-on attach, add-on detach, offer redemption), effective date, change channel, proration amount, applied discount, offer reference, redemption status, and Zuora amendment reference. Enables subscription lifecycle analysis, promotion effectiveness tracking, and revenue reconciliation. | Unity Catalog table: media_broadcasting_ecm.subscriber.subscription_change D2C streaming lifecycle entity supporting subscriber+subscription+entitlement+playback_session+churn_event+offer flows.'
}

Table subscriber.payment_instrument {
  payment_instrument_id varchar [pk, note: 'Unique identifier for the payment instrument record. Primary key. | Column payment_instrument_id (BIGINT) in subscriber.payment_instrument']
  subscriber_id varchar [note: 'Reference to the subscriber who owns this payment instrument. Links to the subscriber master record. | Column subscriber_id (BIGINT) in subscriber.payment_instrument']
  verified_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: High-value or fraud-flagged payment methods require manual verification by billing/fraud teams. Critical for payment fraud prevention workflows, chargeback dispute resolution, and fraud analyst perfor | Column verified_by_employee_id (BIGINT) in workforce.payment_instrument']
  zuora_payment_method_id varchar [note: 'External identifier for this payment method in the Zuora subscription billing system. Used for system integration and reconciliation. | Column zuora_payment_method_id (BIGINT) in billing.payment_instrument']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.payment_instrument']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.payment_instrument']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.payment_instrument']
  bank_account_type varchar [note: 'Type of bank account for direct debit or ACH payment methods. Null for card-based payment methods. | Column bank_account_type (STRING) in subscriber.payment_instrument']
  bank_routing_number varchar [note: 'Bank routing number (ABA number in USA) for direct debit transactions. Masked or tokenized per PCI DSS requirements. | Column bank_routing_number (STRING) in subscriber.payment_instrument']
  billing_address_line1 varchar [note: 'First line of the billing address associated with the payment instrument. Used for address verification and fraud prevention. | Column billing_address_line1 (STRING) in subscriber.payment_instrument']
  billing_address_line2 varchar [note: 'Second line of the billing address (apartment, suite, unit number). Optional field for additional address details. | Column billing_address_line2 (STRING) in subscriber.payment_instrument']
  billing_city varchar [note: 'City of the billing address associated with the payment instrument. | Column billing_city (STRING) in subscriber.payment_instrument']
  billing_country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the billing address (e.g., USA, GBR, CAN). | Column billing_country_code (STRING) in subscriber.payment_instrument']
  billing_postal_code varchar [note: 'Postal or ZIP code of the billing address. Used for address verification service (AVS) fraud checks. | Column billing_postal_code (STRING) in subscriber.payment_instrument']
  billing_state_province varchar [note: 'State or province of the billing address. Format varies by country (e.g., two-letter state code for USA). | Column billing_state_province (STRING) in subscriber.payment_instrument']
  card_brand varchar [note: 'The brand of the credit or debit card (Visa, Mastercard, American Express, Discover, JCB, Diners Club). Null for non-card payment methods. | Column card_brand (STRING) in subscriber.payment_instrument']
  cardholder_name varchar [note: 'Name of the cardholder as it appears on the payment instrument. Required for card-based payment methods. | Column cardholder_name (STRING) in subscriber.payment_instrument']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.payment_instrument']
  created_timestamp timestamp [note: 'Timestamp when the payment instrument record was first created in the system. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column created_timestamp (TIMESTAMP) in subscriber.payment_instrument']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the payment instrument (e.g., USD, GBP, EUR). Determines the currency for all transactions using this instrument. | Column currency_code (STRING) in subscriber.payment_instrument']
  deactivated_timestamp timestamp [note: 'Timestamp when the payment instrument was deactivated or closed. Null for active instruments. Used for lifecycle tracking and compliance reporting. | Column deactivated_timestamp (TIMESTAMP) in subscriber.payment_instrument']
  deactivation_reason varchar [note: 'Reason why the payment instrument was deactivated. Used for churn analysis and payment method lifecycle management. | Column deactivation_reason (STRING) in subscriber.payment_instrument']
  expiry_month varchar [note: 'The month (1-12) when the payment instrument expires. Used for card expiration validation and renewal reminders. | Column expiry_month (INT) in subscriber.payment_instrument']
  expiry_year varchar [note: 'The four-digit year when the payment instrument expires. Used for card expiration validation and renewal reminders. | Column expiry_year (INT) in subscriber.payment_instrument']
  failed_transaction_count varchar [note: 'Cumulative count of failed transaction attempts using this payment instrument. Used for fraud detection and payment method health monitoring. | Column failed_transaction_count (INT) in subscriber.payment_instrument']
  gateway_reference_code varchar [note: 'External reference identifier assigned by the payment gateway for this payment instrument. Used for gateway-specific operations and reconciliation. | Column gateway_reference_code (STRING) in subscriber.payment_instrument']
  gift_card_balance decimal(10,2) [note: 'Remaining balance on the gift card or prepaid card. Updated after each transaction. Null for non-gift-card payment methods. | Column gift_card_balance (DECIMAL(10,2)) in subscriber.payment_instrument']
  gift_card_code varchar [note: 'Masked gift card or prepaid card code. Full code is tokenized per PCI DSS requirements. | Column gift_card_code (STRING) in subscriber.payment_instrument']
  is_default boolean [note: 'Flag indicating whether this is the default payment instrument for the subscriber. Used for automatic billing and subscription renewals. | Column is_default (BOOLEAN) in subscriber.payment_instrument']
  last_transaction_date date [note: 'Date of the most recent successful transaction using this payment instrument. Used for activity tracking and dormancy detection. | Column last_transaction_date (DATE) in subscriber.payment_instrument']
  mandate_acceptance_date date [note: 'Date when the subscriber accepted the direct debit mandate. Required for regulatory compliance and dispute resolution. | Column mandate_acceptance_date (DATE) in subscriber.payment_instrument']
  mandate_reference varchar [note: 'Unique identifier for the direct debit mandate or authorization. Required for SEPA and other direct debit payment methods to comply with banking regulations. | Column mandate_reference (STRING) in subscriber.payment_instrument']
  masked_account_number varchar [note: 'Masked representation of the card or account number showing only the last 4 digits (e.g., ****1234). Full number is tokenized and stored securely per PCI DSS requirements. | Column masked_account_number (STRING) in subscriber.payment_instrument']
  payment_gateway varchar [note: 'Name of the payment gateway or processor used for this payment instrument (e.g., Stripe, Braintree, Authorize.Net, Zuora Gateway). | Column payment_gateway (STRING) in subscriber.payment_instrument']
  payment_instrument_status varchar [note: 'Current lifecycle status of the payment instrument. Active instruments can be charged; expired or suspended instruments require update or replacement. | Column payment_instrument_status (STRING) in subscriber.payment_instrument']
  payment_method_type varchar [note: 'The type of payment instrument used for subscription billing. Indicates the payment mechanism (credit card, debit card, PayPal, direct debit, bank transfer, gift card, or MVPD billing). | Column payment_method_type (STRING) in subscriber.payment_instrument']
  payment_token varchar [note: 'PCI DSS compliant tokenization reference for the actual payment instrument details. Used to process transactions without exposing sensitive cardholder data. | Column payment_token (STRING) in subscriber.payment_instrument']
  paypal_email varchar [note: 'Email address associated with the PayPal account. Used for PayPal payment method identification and processing. | Column paypal_email (STRING) in subscriber.payment_instrument']
  paypal_payer_reference varchar [note: 'Unique PayPal payer identifier for the linked PayPal account. Used for PayPal billing agreement reference. | Column paypal_payer_reference (STRING) in subscriber.payment_instrument']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.payment_instrument']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.payment_instrument']
  updated_timestamp timestamp [note: 'Timestamp when the payment instrument record was last modified. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for audit trail and change tracking. | Column updated_timestamp (TIMESTAMP) in subscriber.payment_instrument']
  verification_date date [note: 'Date when the payment instrument was successfully verified. Used for compliance tracking and fraud prevention. | Column verification_date (DATE) in subscriber.payment_instrument']
  verification_status varchar [note: 'Status of payment instrument verification process. Indicates whether the payment method has been successfully validated through AVS, CVV check, or micro-deposit verification. | Column verification_status (STRING) in subscriber.payment_instrument']

  Note: 'Subscriber\'s stored payment instruments used for subscription billing. Captures payment method type (credit card, debit card, PayPal, direct debit, gift card, MVPD billing), masked card/account number, card brand, expiry date, billing address, is_default flag, and PCI DSS tokenization reference. Managed in Zuora as the payment method entity. Distinct from actual payment transactions owned by the billing domain. | Unity Catalog table: media_broadcasting_ecm.subscriber.payment_instrument'
}

Table subscriber.offer_redemption {
  offer_redemption_id varchar [pk, note: 'Unique identifier for the offer redemption transaction. Primary key for the offer redemption record. | Column offer_redemption_id (BIGINT) in subscriber.offer_redemption']
  campaign_id varchar [note: 'Reference to the marketing campaign under which this offer was promoted. Enables campaign-level performance tracking and Return on Investment (ROI) analysis. | Column campaign_id (BIGINT) in sales.offer_redemption']
  offer_id varchar [note: 'Reference to the promotional offer or discount campaign that was redeemed. Links to the offer master record. | Column offer_id (BIGINT) in subscriber.offer_redemption']
  partner_id varchar [note: 'Reference to the distribution or retail partner through which the offer was distributed, if applicable. Null for direct-to-consumer offers. | Column partner_id (BIGINT) in partner.offer_redemption']
  qualifying_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Promotional offers often require viewing or purchasing specific titles (e.g., "watch premiere to unlock discount"). Supports campaign attribution, content-driven acquisition, and partnership promotion | Column qualifying_title_id (BIGINT) in content.offer_redemption']
  resulting_subscription_plan_id varchar [note: 'Reference to the subscription plan that the subscriber enrolled in or upgraded to as a result of this offer redemption. Links to the subscription plan master record. | Column resulting_subscription_plan_id (BIGINT) in subscriber.offer_redemption']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Promotional offers affect revenue stream classification and promotional revenue tracking for financial reporting. Finance separates promotional revenue from standard pricing for margin analysis and re | Column revenue_stream_id (BIGINT) in finance.offer_redemption']
  sales_agent_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Sales and retention agents process promotional offer redemptions via phone/chat channels. Required for agent commission calculations, sales performance tracking, and offer redemption audit trails in s | Column sales_agent_employee_id (BIGINT) in workforce.offer_redemption']
  subscriber_id varchar [note: 'Reference to the subscriber who redeemed the promotional offer. Links to the subscriber master record. | Column subscriber_id (BIGINT) in subscriber.offer_redemption']
  subscription_id varchar [note: 'Reference to the specific subscription instance that was created or modified as a result of this offer redemption. Links to the subscription record. | Column subscription_id (BIGINT) in subscriber.offer_redemption']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.offer_redemption']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.offer_redemption']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.offer_redemption']
  applied_discount_amount decimal(15,2) [note: 'The monetary value of the discount applied to the subscription as a result of this redemption. Expressed in the subscription currency. | Column applied_discount_amount (DECIMAL(15,2)) in subscriber.offer_redemption']
  attribution_source varchar [note: 'The marketing source or touchpoint that led to this offer redemption. Examples include email campaign, social media ad, affiliate link, or organic search. Used for marketing attribution analysis. | Column attribution_source (STRING) in subscriber.offer_redemption']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.offer_redemption']
  created_timestamp timestamp [note: 'The date and time when this offer redemption record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in subscriber.offer_redemption']
  discount_duration_months varchar [note: 'The number of months for which the discount will be applied to the subscription. Null for one-time discounts or permanent pricing changes. | Column discount_duration_months (INT) in subscriber.offer_redemption']
  discount_percentage decimal(5,2) [note: 'The percentage discount applied when discount_type is percentage. Null for non-percentage discount types. Expressed as a decimal (e.g., 25.00 for 25% off). | Column discount_percentage (DECIMAL(5,2)) in subscriber.offer_redemption']
  discount_type varchar [note: 'The type of discount mechanism applied through this offer redemption. Determines how the discount value is calculated and applied to the subscription. | Column discount_type (STRING) in subscriber.offer_redemption']
  eligibility_failure_reason varchar [note: 'Detailed explanation of why the redemption was rejected or marked ineligible. Null if redemption was successful. Used for customer service and offer optimization. | Column eligibility_failure_reason (STRING) in subscriber.offer_redemption']
  eligibility_verified_flag boolean [note: 'Indicates whether the subscribers eligibility for the offer was verified at the time of redemption. True if eligibility checks passed, False otherwise. | Column eligibility_verified_flag (BOOLEAN) in subscriber.offer_redemption']
  first_time_subscriber_flag boolean [note: 'Indicates whether this redemption resulted in a new subscriber acquisition (True) or was redeemed by an existing subscriber (False). Critical for Customer Acquisition Cost (CAC) and Lifetime Value (LTV) analysis. | Column first_time_subscriber_flag (BOOLEAN) in subscriber.offer_redemption']
  offer_expiration_date date [note: 'The date on which the promotional offer expires and can no longer be redeemed. Used to validate redemption eligibility and track expired redemption attempts. | Column offer_expiration_date (DATE) in subscriber.offer_redemption']
  redemption_channel varchar [note: 'The platform or channel through which the subscriber redeemed the offer. Enables channel effectiveness analysis for promotional campaigns. | Column redemption_channel (STRING) in subscriber.offer_redemption']
  redemption_code varchar [note: 'The unique promotional code or voucher code entered by the subscriber at the time of redemption. Used for tracking and validation. | Column redemption_code (STRING) in subscriber.offer_redemption']
  redemption_device_type varchar [note: 'The type of device used by the subscriber to redeem the offer. Supports device-specific campaign optimization and user experience analysis. | Column redemption_device_type (STRING) in subscriber.offer_redemption']
  redemption_ip_address varchar [note: 'The IP address from which the redemption request originated. Used for fraud detection and geographic analysis. May be considered Personally Identifiable Information (PII) under General Data Protection Regulation (GDPR). | Column redemption_ip_address (STRING) in subscriber.offer_redemption']
  redemption_status varchar [note: 'Current lifecycle status of the offer redemption. Tracks whether the redemption was successfully applied, expired before use, reversed due to policy violation, or rejected due to eligibility failure. | Column redemption_status (STRING) in subscriber.offer_redemption']
  redemption_timestamp timestamp [note: 'The exact date and time when the subscriber successfully redeemed the promotional offer. Represents the business event time of redemption. | Column redemption_timestamp (TIMESTAMP) in subscriber.offer_redemption']
  revenue_impact_amount decimal(15,2) [note: 'The estimated impact on revenue resulting from this offer redemption. Negative values represent revenue reduction due to discounts; positive values may represent incremental revenue from new subscriptions or upgrades. | Column revenue_impact_amount (DECIMAL(15,2)) in subscriber.offer_redemption']
  reversal_reason varchar [note: 'Explanation of why the offer redemption was reversed. Common reasons include fraud detection, policy violation, subscriber request, or billing dispute. Null if not reversed. | Column reversal_reason (STRING) in subscriber.offer_redemption']
  reversal_timestamp timestamp [note: 'The date and time when the offer redemption was reversed or cancelled. Null if the redemption remains active. Used for chargeback and refund reconciliation. | Column reversal_timestamp (TIMESTAMP) in subscriber.offer_redemption']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.offer_redemption']
  terms_accepted_flag boolean [note: 'Indicates whether the subscriber explicitly accepted the terms and conditions associated with the promotional offer at the time of redemption. Required for compliance and dispute resolution. | Column terms_accepted_flag (BOOLEAN) in subscriber.offer_redemption']
  terms_version varchar [note: 'The version identifier of the offer terms and conditions that the subscriber agreed to at redemption. Format: v1.0, v2.1, etc. Used for legal audit trails. | Column terms_version (STRING) in subscriber.offer_redemption']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.offer_redemption']
  updated_timestamp timestamp [note: 'The date and time when this offer redemption record was last modified. Used for audit trail and change tracking. | Column updated_timestamp (TIMESTAMP) in subscriber.offer_redemption']
  zuora_subscription_number varchar [note: 'The subscription identifier in the Zuora billing system that was created or modified as a result of this offer redemption. Used for billing reconciliation and revenue recognition. | Column zuora_subscription_number (STRING) in subscriber.offer_redemption']

  Note: 'Transactional record of a subscriber redeeming a promotional offer or discount code. Captures subscriber reference, offer reference, redemption timestamp, redemption channel, applied discount amount, resulting subscription plan, and redemption status (applied, expired, reversed). Enables promotion effectiveness tracking and revenue impact reconciliation. | Unity Catalog table: media_broadcasting_ecm.subscriber.offer_redemption'
}

Table subscriber.subscriber_consent_record {
  subscriber_consent_record_id varchar [pk, note: 'Unique identifier for the subscriber consent record. Primary key for the immutable audit trail of consent events. | Column subscriber_consent_record_id (BIGINT) in subscriber.subscriber_consent_record']
  compliance_consent_record_id varchar [note: 'Foreign key to SSOT compliance.compliance_consent_record']
  device_registration_id varchar [note: 'Unique identifier of the device from which the consent was provided. Supports device-level consent tracking and audit requirements. | Column device_registration_id (BIGINT) in subscriber.subscriber_consent_record']
  processed_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: GDPR/CCPA consent changes requiring manual review are processed by compliance staff. Essential for regulatory audit trails, consent dispute resolution, and compliance team workload tracking in privacy | Column processed_by_employee_id (BIGINT) in workforce.subscriber_consent_record']
  subscriber_id varchar [note: 'Unique identifier of the subscriber to whom this consent record applies. Links to the subscriber master entity. | Column subscriber_id (BIGINT) in subscriber.subscriber_consent_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.subscriber_consent_record']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.subscriber_consent_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.subscriber_consent_record']
  collection_channel varchar [note: 'The channel or interface through which the consent was collected. Identifies the touchpoint where the subscriber provided or withdrew consent. [ENUM-REF-CANDIDATE: web|mobile_app|call_center|email|in_person|api|third_party — 7 candidates stripped; promote to reference product] | Column collection_channel (STRING) in subscriber.subscriber_consent_record']
  communication_channel_preference varchar [note: 'The subscribers preferred communication channel for receiving messages related to this consent type. Governs operational routing of communications. | Column communication_channel_preference (STRING) in subscriber.subscriber_consent_record']
  consent_audit_trail_reference varchar [note: 'External reference or identifier linking this consent record to detailed audit logs or supporting documentation. Supports regulatory audit and compliance verification. | Column consent_audit_trail_reference (STRING) in subscriber.subscriber_consent_record']
  consent_expiry_date date [note: 'The date on which this consent expires and must be re-confirmed. Nullable for consents without expiration. Supports time-bound consent management. | Column consent_expiry_date (DATE) in subscriber.subscriber_consent_record']
  consent_scope_description varchar [note: 'Detailed description of the scope and purpose of the data processing covered by this consent. Provides business context for the consent type. | Column consent_scope_description (STRING) in subscriber.subscriber_consent_record']
  consent_source_ip_address varchar [note: 'The IP address from which the consent action was initiated. Used for fraud detection and audit trail verification. | Column consent_source_ip_address (STRING) in subscriber.subscriber_consent_record']
  consent_status varchar [note: 'Current status of the consent. Indicates whether the subscriber has granted, withdrawn, or not provided consent for the specified activity. | Column consent_status (STRING) in subscriber.subscriber_consent_record']
  consent_text_presented varchar [note: 'The exact text of the consent disclosure or opt-in language presented to the subscriber at the time of consent. Immutable record for legal compliance and audit. | Column consent_text_presented (STRING) in subscriber.subscriber_consent_record']
  consent_timestamp timestamp [note: 'The exact date and time when the consent action was captured. Represents the business event time of the consent grant or withdrawal. | Column consent_timestamp (TIMESTAMP) in subscriber.subscriber_consent_record']
  consent_type varchar [note: 'The specific type of data processing or communication activity for which consent is being recorded. Defines the scope of the consent grant or withdrawal. | Column consent_type (STRING) in subscriber.subscriber_consent_record']
  consent_version varchar [note: 'Version identifier of the consent policy or terms presented to the subscriber at the time of consent. Enables tracking of consent under different policy versions. | Column consent_version (STRING) in subscriber.subscriber_consent_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.subscriber_consent_record']
  created_timestamp timestamp [note: 'The date and time when this consent record was first inserted into the system. Immutable audit field for record creation tracking. | Column created_timestamp (TIMESTAMP) in subscriber.subscriber_consent_record']
  data_retention_period_days varchar [note: 'The number of days for which subscriber data may be retained under this consent. Nullable if no specific retention period applies. Governs data lifecycle management. | Column data_retention_period_days (INT) in subscriber.subscriber_consent_record']
  double_opt_in_confirmation_timestamp timestamp [note: 'The date and time when the subscriber confirmed their consent via double opt-in. Nullable if double opt-in is not required or not yet confirmed. | Column double_opt_in_confirmation_timestamp (TIMESTAMP) in subscriber.subscriber_consent_record']
  double_opt_in_confirmed_flag boolean [note: 'Indicates whether the subscriber has confirmed their consent through a double opt-in process (e.g., email confirmation link). True if double opt-in is complete. | Column double_opt_in_confirmed_flag (BOOLEAN) in subscriber.subscriber_consent_record']
  jurisdiction varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code representing the legal jurisdiction under which this consent was collected. Determines applicable privacy regulations. | Column jurisdiction (STRING) in subscriber.subscriber_consent_record']
  last_modified_timestamp timestamp [note: 'The date and time when this consent record was last updated. For immutable audit trail design, this should remain equal to created_timestamp unless metadata corrections are applied. | Column last_modified_timestamp (TIMESTAMP) in subscriber.subscriber_consent_record']
  opt_in_method varchar [note: 'The method by which the subscriber provided consent. Distinguishes between explicit opt-in, implicit acceptance, and other consent mechanisms. | Column opt_in_method (STRING) in subscriber.subscriber_consent_record']
  parental_consent_required_flag boolean [note: 'Indicates whether parental or guardian consent is required for this subscriber under COPPA or equivalent regulations. True if the subscriber is a minor requiring parental consent. | Column parental_consent_required_flag (BOOLEAN) in subscriber.subscriber_consent_record']
  parental_consent_verified_flag boolean [note: 'Indicates whether parental consent has been verified through an acceptable verification method. True if verification is complete and valid. | Column parental_consent_verified_flag (BOOLEAN) in subscriber.subscriber_consent_record']
  preferred_language varchar [note: 'Three-letter ISO 639-2 language code representing the subscribers preferred language for consent communications and disclosures. | Column preferred_language (STRING) in subscriber.subscriber_consent_record']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.subscriber_consent_record']
  third_party_processor_name varchar [note: 'Name of the third-party data processor or partner to whom data may be shared under this consent. Nullable if consent does not involve third-party sharing. | Column third_party_processor_name (STRING) in subscriber.subscriber_consent_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.subscriber_consent_record']
  withdrawal_reason varchar [note: 'Free-text or coded reason provided by the subscriber for withdrawing consent. Nullable for granted consents. Supports churn analysis and compliance reporting. | Column withdrawal_reason (STRING) in subscriber.subscriber_consent_record']

  Note: 'Authoritative record of subscriber data privacy consents, opt-in/opt-out preferences, and communication channel preferences required under GDPR, CCPA, and COPPA. Captures consent type (marketing email, personalization, data sharing, third-party analytics, children\'s data processing), communication channel preferences (email, push, SMS, in-app, postal), preferred language, consent status, consent timestamp, consent version, collection channel, and jurisdiction. Immutable audit trail — new records are inserted for each consent or preference change rather than updating existing rows. Governs both legal compliance and operational communication routing. | Unity Catalog table: media_broadcasting_ecm.subscriber.subscriber_consent_record'
}

Table subscriber.communication_preference {
  communication_preference_id varchar [pk, note: 'Unique identifier for the communication preference record. | Column communication_preference_id (BIGINT) in subscriber.communication_preference']
  aep_segment_id varchar [note: 'External identifier linking this preference to a specific audience segment in Adobe Experience Platform for personalization and targeting. | Column aep_segment_id (BIGINT) in audience.communication_preference']
  subscriber_id varchar [note: 'Reference to the subscriber who owns this communication preference profile. | Column subscriber_id (BIGINT) in subscriber.communication_preference']
  updated_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Customer service representatives update communication preferences during support calls. Required for customer care quality assurance, preference change audit trails, and agent training on privacy comp | Column updated_by_employee_id (BIGINT) in workforce.communication_preference']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.communication_preference']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.communication_preference']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.communication_preference']
  aep_journey_suppression_flag boolean [note: 'Indicates whether this subscriber should be suppressed from Adobe Experience Platform automated journey orchestration for this preference type. | Column aep_journey_suppression_flag (BOOLEAN) in subscriber.communication_preference']
  consent_ip_address varchar [note: 'IP address from which the subscriber provided or updated this communication preference, used for audit and compliance verification. | Column consent_ip_address (STRING) in subscriber.communication_preference']
  consent_source varchar [note: 'Channel or touchpoint through which the subscriber provided or updated this communication preference (web signup, mobile app, customer service interaction, account creation, preference center, or third-party integration). | Column consent_source (STRING) in subscriber.communication_preference']
  consent_timestamp timestamp [note: 'Date and time when the subscriber provided or last updated this communication preference, in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column consent_timestamp (TIMESTAMP) in subscriber.communication_preference']
  consent_user_agent varchar [note: 'Browser or application user agent string captured when the subscriber provided or updated this communication preference, used for audit and compliance verification. | Column consent_user_agent (STRING) in subscriber.communication_preference']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.communication_preference']
  created_timestamp timestamp [note: 'Date and time when this communication preference record was first created in the system, in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column created_timestamp (TIMESTAMP) in subscriber.communication_preference']
  double_opt_in_confirmed boolean [note: 'Indicates whether the subscriber has confirmed their opt-in through a double opt-in verification process (e.g., email confirmation link). | Column double_opt_in_confirmed (BOOLEAN) in subscriber.communication_preference']
  double_opt_in_timestamp timestamp [note: 'Date and time when the subscriber confirmed their opt-in through the double opt-in verification process, in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column double_opt_in_timestamp (TIMESTAMP) in subscriber.communication_preference']
  effective_end_date date [note: 'Date when this communication preference expires or is no longer effective, in ISO 8601 format (yyyy-MM-dd). Null indicates no expiration. | Column effective_end_date (DATE) in subscriber.communication_preference']
  effective_start_date date [note: 'Date when this communication preference becomes effective and should be honored by outbound communication systems, in ISO 8601 format (yyyy-MM-dd). | Column effective_start_date (DATE) in subscriber.communication_preference']
  email_address varchar [note: 'The email address to which communications should be sent when email opt-in is enabled. | Column email_address (STRING) in subscriber.communication_preference']
  email_opt_in boolean [note: 'Indicates whether the subscriber has opted in to receive email communications for this preference type. | Column email_opt_in (BOOLEAN) in subscriber.communication_preference']
  frequency_preference varchar [note: 'Subscriber\'s preferred frequency for receiving communications of this type (daily, weekly, biweekly, monthly, quarterly, or as needed). | Column frequency_preference (STRING) in subscriber.communication_preference']
  in_app_messaging_opt_in boolean [note: 'Indicates whether the subscriber has opted in to receive in-app messages within the OTT (Over-The-Top) or SVOD (Subscription Video On Demand) application for this preference type. | Column in_app_messaging_opt_in (BOOLEAN) in subscriber.communication_preference']
  last_communication_sent_timestamp timestamp [note: 'Date and time when the last communication of this preference type was successfully sent to the subscriber, in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column last_communication_sent_timestamp (TIMESTAMP) in subscriber.communication_preference']
  last_modified_timestamp timestamp [note: 'Date and time when this communication preference record was last updated, in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column last_modified_timestamp (TIMESTAMP) in subscriber.communication_preference']
  mobile_phone_number varchar [note: 'The mobile phone number to which SMS and push notifications should be sent when those channels are opted in. | Column mobile_phone_number (STRING) in subscriber.communication_preference']
  notes varchar [note: 'Free-text field for additional notes or context about this communication preference, such as special handling instructions or subscriber-provided reasons for preference changes. | Column notes (STRING) in subscriber.communication_preference']
  postal_address_line1 varchar [note: 'First line of the postal mailing address for physical mail communications when postal mail opt-in is enabled. | Column postal_address_line1 (STRING) in subscriber.communication_preference']
  postal_address_line2 varchar [note: 'Second line of the postal mailing address (apartment, suite, unit number) for physical mail communications. | Column postal_address_line2 (STRING) in subscriber.communication_preference']
  postal_city varchar [note: 'City name for the postal mailing address. | Column postal_city (STRING) in subscriber.communication_preference']
  postal_code varchar [note: 'Postal or ZIP code for the postal mailing address. | Column postal_code (STRING) in subscriber.communication_preference']
  postal_country_code varchar [note: 'ISO 3166-1 alpha-3 three-letter country code for the postal mailing address (e.g., USA, GBR, CAN). | Column postal_country_code (STRING) in subscriber.communication_preference']
  postal_mail_opt_in boolean [note: 'Indicates whether the subscriber has opted in to receive physical postal mail communications for this preference type. | Column postal_mail_opt_in (BOOLEAN) in subscriber.communication_preference']
  postal_state_province varchar [note: 'State or province code for the postal mailing address. | Column postal_state_province (STRING) in subscriber.communication_preference']
  preference_status varchar [note: 'Current lifecycle status of this communication preference record (active and in use, inactive, pending verification through double opt-in, or suspended due to bounce or compliance issue). | Column preference_status (STRING) in subscriber.communication_preference']
  preference_type varchar [note: 'Category of communication this preference applies to (marketing campaigns, transactional notifications, service updates, editorial content, promotional offers, or administrative messages). | Column preference_type (STRING) in subscriber.communication_preference']
  preferred_contact_time timestamp [note: 'Time of day the subscriber prefers to receive communications (morning, afternoon, evening, night, or anytime). | Column preferred_contact_time (TIMESTAMP) in subscriber.communication_preference']
  preferred_language varchar [note: 'ISO 639-1 two-letter language code (optionally with ISO 3166-1 alpha-2 country code) indicating the subscriber\'s preferred language for communications (e.g., en, en-US, es, fr-CA). | Column preferred_language (STRING) in subscriber.communication_preference']
  push_notification_opt_in boolean [note: 'Indicates whether the subscriber has opted in to receive push notifications on registered devices for this preference type. | Column push_notification_opt_in (BOOLEAN) in subscriber.communication_preference']
  sms_opt_in boolean [note: 'Indicates whether the subscriber has opted in to receive SMS text messages for this preference type. | Column sms_opt_in (BOOLEAN) in subscriber.communication_preference']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.communication_preference']
  unsubscribe_flag boolean [note: 'Indicates whether the subscriber has globally unsubscribed from all communications of this preference type across all channels. | Column unsubscribe_flag (BOOLEAN) in subscriber.communication_preference']
  unsubscribe_timestamp timestamp [note: 'Date and time when the subscriber unsubscribed from this communication preference type, in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). | Column unsubscribe_timestamp (TIMESTAMP) in subscriber.communication_preference']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.communication_preference']

  Note: 'Subscriber\'s channel and frequency preferences for all outbound communications — email, push notification, SMS, in-app messaging, and postal mail. Captures opt-in status per channel, preferred language, preferred contact time, unsubscribe flags, and Adobe Experience Platform journey suppression flags. Distinct from consent_record (legal compliance) — this governs operational communication routing. | Unity Catalog table: media_broadcasting_ecm.subscriber.communication_preference'
}

Table subscriber.mvpd_affiliation {
  mvpd_affiliation_id varchar [pk, note: 'Unique identifier for the MVPD affiliation record. Primary key. | Column mvpd_affiliation_id (BIGINT) in subscriber.mvpd_affiliation']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: MVPD authentication and TV Everywhere entitlements operate within specific DMA markets. Required for blackout enforcement, local station affiliation rules, retransmission consent compliance, and marke | Column market_coverage_id (BIGINT) in audience.mvpd_affiliation']
  partner_id varchar [note: 'Reference to the MVPD or vMVPD provider organization (e.g., Comcast, DirecTV, Hulu Live). Links to provider master record. | Column partner_id (BIGINT) in partner.mvpd_affiliation']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: MVPD partnerships generate distinct revenue streams (carriage fees, affiliate revenue) that must be tracked separately for financial reporting, revenue recognition, and partner settlement reconciliati | Column revenue_stream_id (BIGINT) in finance.mvpd_affiliation']
  subscriber_id varchar [note: 'Reference to the subscriber who holds this MVPD affiliation. Links to the subscriber master record. | Column subscriber_id (BIGINT) in subscriber.mvpd_affiliation']
  verified_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: MVPD authentication verification requires manual review by operations staff for fraud prevention and authentication disputes. Critical for compliance audit trails, fraud investigation workflows, and M | Column verified_by_employee_id (BIGINT) in workforce.mvpd_affiliation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.mvpd_affiliation']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.mvpd_affiliation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.mvpd_affiliation']
  affiliation_channel varchar [note: 'The platform or device type through which the subscriber first authenticated with the MVPD provider. | Column affiliation_channel (STRING) in subscriber.mvpd_affiliation']
  affiliation_end_date date [note: 'The date when the MVPD affiliation ended or is scheduled to end. Null for active affiliations. | Column affiliation_end_date (DATE) in subscriber.mvpd_affiliation']
  affiliation_source varchar [note: 'The method by which the MVPD affiliation was established (direct subscriber login, single sign-on, API provisioning from MVPD, bulk import, or partner integration). | Column affiliation_source (STRING) in subscriber.mvpd_affiliation']
  affiliation_start_date date [note: 'The date when the MVPD affiliation became active. Represents when the subscriber first authenticated through the MVPD provider. | Column affiliation_start_date (DATE) in subscriber.mvpd_affiliation']
  affiliation_status varchar [note: 'Current lifecycle status of the MVPD affiliation. Active indicates valid authentication; expired or revoked indicates the subscriber must re-authenticate. | Column affiliation_status (STRING) in subscriber.mvpd_affiliation']
  authentication_failure_count varchar [note: 'The cumulative number of failed authentication attempts since the last successful authentication. Reset to zero on successful authentication. | Column authentication_failure_count (INT) in subscriber.mvpd_affiliation']
  authentication_failure_reason varchar [note: 'The reason code or message for the most recent authentication failure (e.g., invalid credentials, account suspended, service unavailable). | Column authentication_failure_reason (STRING) in subscriber.mvpd_affiliation']
  authentication_method varchar [note: 'The technical authentication protocol used for TV Everywhere login (SAML 2.0, OAuth 2.0, OpenID Connect, or proprietary MVPD method). | Column authentication_method (STRING) in subscriber.mvpd_affiliation']
  authentication_token varchar [note: 'The encrypted or hashed authentication token issued by the MVPD provider during TV Everywhere login. Used for session validation and entitlement checks. | Column authentication_token (STRING) in subscriber.mvpd_affiliation']
  auto_renewal_enabled_flag boolean [note: 'Indicates whether the MVPD affiliation is set to automatically renew authentication tokens. True if auto-renewal is enabled. | Column auto_renewal_enabled_flag (BOOLEAN) in subscriber.mvpd_affiliation']
  concurrent_stream_limit varchar [note: 'The maximum number of simultaneous streams allowed under this MVPD affiliation, as defined by the MVPD provider\'s policy. | Column concurrent_stream_limit (INT) in subscriber.mvpd_affiliation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.mvpd_affiliation']
  created_timestamp timestamp [note: 'The timestamp when this MVPD affiliation record was first created in the system. | Column created_timestamp (TIMESTAMP) in subscriber.mvpd_affiliation']
  data_sharing_opt_out_flag boolean [note: 'Indicates whether the subscriber has opted out of data sharing with the MVPD provider. True if the subscriber has opted out. | Column data_sharing_opt_out_flag (BOOLEAN) in subscriber.mvpd_affiliation']
  device_limit varchar [note: 'The maximum number of devices that can be registered under this MVPD affiliation, as defined by the MVPD provider\'s policy. | Column device_limit (INT) in subscriber.mvpd_affiliation']
  entitlement_package_code varchar [note: 'The code representing the subscriber\'s entitlement package from the MVPD (e.g., basic, premium, sports tier). Determines which content the subscriber can access. | Column entitlement_package_code (STRING) in subscriber.mvpd_affiliation']
  entitlement_package_name varchar [note: 'Human-readable name of the entitlement package (e.g., Premium Plus, Sports Bundle, Basic Cable). | Column entitlement_package_name (STRING) in subscriber.mvpd_affiliation']
  geographic_restriction_code varchar [note: 'Code representing geographic or blackout restrictions imposed by the MVPD provider (e.g., DMA code, zip code range). Used to enforce regional content availability. | Column geographic_restriction_code (STRING) in subscriber.mvpd_affiliation']
  home_dma_code varchar [note: 'The Nielsen DMA code representing the subscriber\'s home market as reported by the MVPD provider. Used for local content and blackout enforcement. | Column home_dma_code (STRING) in subscriber.mvpd_affiliation']
  last_authentication_failure_timestamp timestamp [note: 'The timestamp of the most recent failed authentication attempt with the MVPD provider. | Column last_authentication_failure_timestamp (TIMESTAMP) in subscriber.mvpd_affiliation']
  last_authentication_timestamp timestamp [note: 'The timestamp of the most recent successful authentication event with the MVPD provider. | Column last_authentication_timestamp (TIMESTAMP) in subscriber.mvpd_affiliation']
  last_modified_timestamp timestamp [note: 'The timestamp when this MVPD affiliation record was last updated. | Column last_modified_timestamp (TIMESTAMP) in subscriber.mvpd_affiliation']
  last_verified_timestamp timestamp [note: 'The timestamp when the MVPD affiliation was last verified with the provider. Used to determine if re-authentication is required. | Column last_verified_timestamp (TIMESTAMP) in subscriber.mvpd_affiliation']
  max_content_rating varchar [note: 'The maximum content rating allowed under this MVPD affiliation\'s parental controls. Content rated above this level is blocked. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA — 11 candidates stripped; promote to reference product] | Column max_content_rating (STRING) in subscriber.mvpd_affiliation']
  mvpd_affiliate_identifier varchar [note: 'The unique subscriber identifier assigned by the MVPD provider for TV Everywhere authentication. This is the external identifier used in SAML assertions and OAuth flows. | Column mvpd_affiliate_identifier (STRING) in subscriber.mvpd_affiliation']
  mvpd_type varchar [note: 'Classification of the MVPD provider type: traditional MVPD (cable/satellite), virtual MVPD (streaming), telco (IPTV), or other distribution model. | Column mvpd_type (STRING) in subscriber.mvpd_affiliation']
  next_verification_due_date date [note: 'The date when the next verification check with the MVPD provider is due. Calculated from last_verified_timestamp plus verification_frequency_days. | Column next_verification_due_date (DATE) in subscriber.mvpd_affiliation']
  notes varchar [note: 'Free-text notes or comments about the MVPD affiliation, such as special arrangements, support tickets, or escalation history. | Column notes (STRING) in subscriber.mvpd_affiliation']
  parental_control_enabled_flag boolean [note: 'Indicates whether parental controls are enabled for this MVPD affiliation. True if parental controls are active. | Column parental_control_enabled_flag (BOOLEAN) in subscriber.mvpd_affiliation']
  parental_control_pin varchar [note: 'Encrypted PIN used to unlock parental control restrictions. Stored in hashed format for security. | Column parental_control_pin (STRING) in subscriber.mvpd_affiliation']
  privacy_consent_flag boolean [note: 'Indicates whether the subscriber has provided consent for sharing viewing data with the MVPD provider. Required for GDPR and CCPA compliance. | Column privacy_consent_flag (BOOLEAN) in subscriber.mvpd_affiliation']
  privacy_consent_timestamp timestamp [note: 'The timestamp when the subscriber provided or updated their privacy consent for MVPD data sharing. | Column privacy_consent_timestamp (TIMESTAMP) in subscriber.mvpd_affiliation']
  source_record_id varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in subscriber.mvpd_affiliation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in subscriber.mvpd_affiliation']
  verification_frequency_days varchar [note: 'The number of days between required re-verification checks with the MVPD provider. Typically 30, 60, or 90 days depending on provider policy. | Column verification_frequency_days (INT) in subscriber.mvpd_affiliation']

  Note: 'Records the affiliation between a subscriber and their MVPD or vMVPD provider for TV Everywhere authentication and carriage-based entitlement. Captures MVPD provider name, affiliate ID, authentication token, entitlement package, affiliation status, and last verified timestamp. Supports TV Everywhere login flows and MVPD-sourced subscriber entitlement grants. | Unity Catalog table: media_broadcasting_ecm.subscriber.mvpd_affiliation'
}

Table subscriber.win_back_offer {
  win_back_offer_id varchar [pk, note: 'Primary key for win_back_offer | Column win_back_offer_id (BIGINT) in subscriber.win_back_offer']
  superseded_win_back_offer_id varchar [note: 'Self-referencing FK on win_back_offer (superseded_win_back_offer_id) | Column superseded_win_back_offer_id (BIGINT) in subscriber.win_back_offer']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in subscriber.win_back_offer']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in subscriber.win_back_offer']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in subscriber.win_back_offer']
  approved_by varchar [note: 'Username or identifier of the user who approved this win-back offer for activation. Nullable if not yet approved. | Column approved_by (STRING) in subscriber.win_back_offer']
  approved_timestamp timestamp [note: 'Timestamp when this win-back offer was approved for activation by authorized personnel. Nullable if not yet approved. | Column approved_timestamp (TIMESTAMP) in subscriber.win_back_offer']
  auto_renew_after_offer boolean [note: 'Indicates whether the subscription automatically renews at standard pricing after the win-back offer period expires. | Column auto_renew_after_offer (BOOLEAN) in subscriber.win_back_offer']
  compliance_ccpa_flag boolean [note: 'Indicates whether this win-back offer has been reviewed and approved for CCPA compliance in California market. | Column compliance_ccpa_flag (BOOLEAN) in subscriber.win_back_offer']
  compliance_coppa_flag boolean [note: 'Indicates whether this win-back offer has been reviewed and approved for COPPA compliance when targeting households with children under 13. | Column compliance_coppa_flag (BOOLEAN) in subscriber.win_back_offer']
  compliance_gdpr_flag boolean [note: 'Indicates whether this win-back offer has been reviewed and approved for GDPR compliance in European markets. | Column compliance_gdpr_flag (BOOLEAN) in subscriber.win_back_offer']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in subscriber.win_back_offer']
  created_timestamp timestamp [note: 'Timestamp when this win-back offer record was first created in the system. | Column created_timestamp (TIMESTAMP) in subscriber.win_back_offer']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the discount amount and any monetary values associated with the offer. | Column currency_code (STRING) in subscriber.win_back_offer']
  current_redemption_count varchar [note: 'Current number of times this win-back offer has been redeemed by subscribers, tracked against the total redemption cap. | Column current_redemption_count (INT) in subscriber.win_back_offer']
  discount_amount decimal(10,2) [note: 'Fixed monetary discount amount applied to the subscription price. Nullable if offer uses percentage discount or other incentive type. | Column discount_amount (DECIMAL(10,2)) in subscriber.win_back_offer']
  discount_percentage decimal(5,2) [note: 'Percentage discount applied to the subscription price for the duration of the offer. Nullable if offer type is not discount-based. | Column discount_percentage (DECIMAL(5,2)) in subscriber.win_back_offer']
  effective_end_date date [note: 'Date when the win-back offer expires and is no longer available for new redemptions. Nullable for open-ended offers. | Column effective_end_date (DATE) in subscriber.win_back_offer']
  effective_start_date date [note: 'Date when the win-back offer becomes active and available for churned subscribers to redeem. | Column effective_start_date (DATE) in subscriber.win_back_offer']
  eligibility_churn_days_max varchar [note: 'Maximum number of days since churn that a subscriber remains eligible for this win-back offer. Nullable for no upper limit. | Column eligibility_churn_days_max (INT) in subscriber.win_back_offer']
  eligibility_churn_days_min varchar [note: 'Minimum number of days a subscriber must have been churned to be eligible for this win-back offer. | Column eligibility_churn_days_min (INT) in subscriber.win_back_offer']
  free_trial_duration_days varchar [note: 'Number of days of free service provided as part of the win-back offer. Nullable if offer type is not free trial. | Column free_trial_duration_days (INT) in subscriber.win_back_offer']
  marketing_channel varchar [note: 'Primary marketing channel through which this win-back offer is promoted and delivered to churned subscribers. | Column marketing_channel (STRING) in subscriber.win_back_offer']
  max_redemptions_per_subscriber varchar [note: 'Maximum number of times a single subscriber can redeem this win-back offer across their lifetime. Nullable for unlimited redemptions. | Column max_redemptions_per_subscriber (INT) in subscriber.win_back_offer']
  modified_by varchar [note: 'Username or identifier of the user who last modified this win-back offer record. | Column modified_by (STRING) in subscriber.win_back_offer']
  modified_timestamp timestamp [note: 'Timestamp when this win-back offer record was last modified. | Column modified_timestamp (TIMESTAMP) in subscriber.win_back_offer']
  offer_code varchar [note: 'Externally-known unique code for the win-back offer used in marketing campaigns and subscriber communications. | Column offer_code (STRING) in subscriber.win_back_offer']
  offer_duration_months varchar [note: 'Number of months the win-back offer discount or benefit applies before reverting to standard pricing. | Column offer_duration_months (INT) in subscriber.win_back_offer']
  offer_name varchar [note: 'Human-readable name of the win-back offer displayed to subscribers and used in internal reporting. | Column offer_name (STRING) in subscriber.win_back_offer']
