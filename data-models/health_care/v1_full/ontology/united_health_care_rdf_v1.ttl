    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalDirectorName rdf:type rdf:Property ;
    rdfs:label 'Medical Director Name' ;
    rdfs:comment 'Name of the medical director who reviewed or approved the authorization decision.' ;
