    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetAudienceDemographic rdf:type rdf:Property ;
    rdfs:label 'Target Audience Demographic' ;
    rdfs:comment 'Description of the brand\'s primary target consumer demographic (e.g., age range, gender, income level). Used for sponsor-property fit analysis and activation planning.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLifetimeInvestmentUsd rdf:type rdf:Property ;
    rdfs:label 'Total Lifetime Investment Usd' ;
    rdfs:comment 'Cumulative total of all sponsorship investments made by the brand across all partnerships to date in USD. Used for sponsor value segmentation and relationship prioritization.' ;
    rdfs:domain ind:Brand ;
