  Note: 'Payment terms and schedules agreed with partners for acquisition fees, carriage fees, syndication fees, and co-production cost contributions. Captures payment milestones, due dates, currency, payment method, late payment penalty clauses, and withholding tax obligations by jurisdiction. Used by the billing domain to generate partner-facing invoices and payment schedules. | Unity Catalog table: media_broadcasting_ecm.partner.payment_term'
}

Table partner.territory_grant {
  territory_grant_id varchar [pk, note: 'Unique identifier for the territory grant record. Primary key. | Column territory_grant_id (BIGINT) in partner.territory_grant']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Territory grants in distribution agreements must align with licensed broadcast coverage areas. Grants reference DMA codes, coverage contours, and geographic service areas defined by FCC broadcast lice | Column broadcast_license_id (BIGINT) in compliance.territory_grant']
  content_title_id varchar [note: 'Reference to the content title for which territorial rights are granted. | Column content_title_id (BIGINT) in content.territory_grant']
  legal_reviewer_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Rights grants require legal reviewer tracking for clearance verification, compliance sign-off, and dispute resolution. Clearance_status exists but no FK to attorney who verified - critical for legal w | Column legal_reviewer_employee_id (BIGINT) in workforce.territory_grant']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Territory grants in partner domain represent distribution rights that must align with underlying license_agreement terms for territory scope, exclusivity, and windowing. Direct FK enables rights clear | Column license_agreement_id (BIGINT) in rights.territory_grant']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Territory rights are granted at asset level for international distribution. Playout systems check asset-territory combinations before transmission to prevent rights violations, enable geo-blocking, an | Column media_asset_id (BIGINT) in mediaasset.territory_grant']
  partner_agreement_id varchar [note: 'Reference to the parent partner agreement under which this territorial grant is defined. | Column partner_agreement_id (BIGINT) in partner.territory_grant']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Territory grants license content rights to specific partners (broadcasters, streaming platforms, theatrical distributors) for defined geographic regions. Links rights grants to partner master for righ | Column partner_id (BIGINT) in partner.territory_grant']
  scheduling_availability_window_id varchar [note: 'Foreign key linking to scheduling.scheduling_availability_window. Business justification: Territory grants in partner agreements define where/when content can be scheduled (e.g., exclusive US broadcast rights 2024-2026). Essential for rights-compliant scheduling, avoiding territorial viola | Column scheduling_availability_window_id (BIGINT) in scheduling.territory_grant']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.territory_grant']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.territory_grant']
  avod_rights_flag boolean [note: 'Indicates whether Advertising-Supported Video On Demand distribution rights are included in this grant. | Column avod_rights_flag (BOOLEAN) in partner.territory_grant']
  blackout_zone_indicator boolean [note: 'Flag indicating whether this grant defines a blackout zone where distribution is explicitly prohibited rather than authorized. | Column blackout_zone_indicator (BOOLEAN) in partner.territory_grant']
  carriage_fee_applicable_flag boolean [note: 'Indicates whether a carriage fee (distribution payment) is required for this territorial grant. | Column carriage_fee_applicable_flag (BOOLEAN) in partner.territory_grant']
  clearance_status varchar [note: 'Current rights clearance status for this territorial grant. Pending indicates awaiting verification; cleared indicates rights verified and distribution authorized; restricted indicates conditional clearance with limitations; expired indicates grant period has ended; revoked indicates rights withdrawn. | Column clearance_status (STRING) in partner.territory_grant']
  clearance_verification_date date [note: 'Date when rights clearance was last verified for this territorial grant. | Column clearance_verification_date (DATE) in partner.territory_grant']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code for single-country grants (e.g., USA, GBR, CAN). Null for multi-country or regional grants. | Column country_code (STRING) in partner.territory_grant']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.territory_grant']
  created_by_user varchar [note: 'Username or identifier of the user who created this territory grant record. | Column created_by_user (STRING) in partner.territory_grant']
  created_timestamp timestamp [note: 'Timestamp when this territory grant record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.territory_grant']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for financial terms associated with this grant (e.g., USD, GBP, EUR). | Column currency_code (STRING) in partner.territory_grant']
  dma_code varchar [note: 'Nielsen Designated Market Area code for US local market grants. Used for local broadcast and cable distribution rights. | Column dma_code (STRING) in partner.territory_grant']
  effective_end_date date [note: 'Date when the territorial grant expires and distribution rights terminate. Null for perpetual grants. | Column effective_end_date (DATE) in partner.territory_grant']
  effective_start_date date [note: 'Date when the territorial grant becomes effective and distribution is authorized to begin. | Column effective_start_date (DATE) in partner.territory_grant']
  grant_reference_code varchar [note: 'Business identifier for the territory grant, used in contracts and rights clearance documentation. | Column grant_reference_code (STRING) in partner.territory_grant']
  grant_type varchar [note: 'Type of territorial grant indicating exclusivity level. Exclusive grants prohibit other licensees in the territory; non-exclusive allows multiple licensees; co-exclusive allows a limited number of licensees; holdback restricts distribution during a specific window; reserved indicates rights retained by licensor. | Column grant_type (STRING) in partner.territory_grant']
  holdback_restriction varchar [note: 'Description of any holdback period or exclusivity restrictions that limit distribution during specific windows or in relation to other platforms. For example, a 90-day theatrical holdback before SVOD release. | Column holdback_restriction (STRING) in partner.territory_grant']
  language_restriction varchar [note: 'Comma-separated list of ISO 639-2 language codes specifying which language versions are covered by this grant. Null if all language versions are included. | Column language_restriction (STRING) in partner.territory_grant']
  linear_rights_flag boolean [note: 'Indicates whether traditional scheduled broadcast (linear) distribution rights are included in this grant. | Column linear_rights_flag (BOOLEAN) in partner.territory_grant']
  media_format_restriction varchar [note: 'Restrictions on media formats or technical specifications (e.g., HD only, 4K excluded, standard definition only). Null if no format restrictions apply. | Column media_format_restriction (STRING) in partner.territory_grant']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount for this territorial grant, regardless of actual distribution revenue. Null if no minimum guarantee applies. | Column minimum_guarantee_amount (DECIMAL(15,2)) in partner.territory_grant']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this territory grant record. | Column modified_by_user (STRING) in partner.territory_grant']
  modified_timestamp timestamp [note: 'Timestamp when this territory grant record was last modified. | Column modified_timestamp (TIMESTAMP) in partner.territory_grant']
  must_carry_obligation_flag boolean [note: 'Indicates whether this grant is subject to must-carry regulations requiring mandatory channel inclusion by distributors. | Column must_carry_obligation_flag (BOOLEAN) in partner.territory_grant']
  notes varchar [note: 'Free-text notes capturing additional terms, conditions, or clarifications specific to this territorial grant. | Column notes (STRING) in partner.territory_grant']
  platform_scope varchar [note: 'Comma-separated list of distribution platforms covered by this grant. May include: linear (traditional broadcast), SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), OTT (Over-The-Top), theatrical, home video, FAST (Free Ad-Supported Streaming Television), MVPD (Multichannel Video Programming Distributor), vMVPD (Virtual Multichannel Video Programming Distributor). | Column platform_scope (STRING) in partner.territory_grant']
  region_name varchar [note: 'Named region for multi-country grants (e.g., North America, European Union, Asia-Pacific, Latin America). Used when grant covers multiple countries as a group. | Column region_name (STRING) in partner.territory_grant']
  retransmission_consent_required_flag boolean [note: 'Indicates whether retransmission consent (rebroadcast authorization) is required for this territorial grant under FCC regulations. | Column retransmission_consent_required_flag (BOOLEAN) in partner.territory_grant']
  royalty_rate_percent decimal(5,2) [note: 'Percentage royalty rate applicable to revenue generated from distribution in this territory. Used for royalty calculations in the finance domain. | Column royalty_rate_percent (DECIMAL(5,2)) in partner.territory_grant']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.territory_grant']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.territory_grant']
  sublicense_permitted_flag boolean [note: 'Indicates whether the licensee is authorized to sublicense the territorial rights to third parties. | Column sublicense_permitted_flag (BOOLEAN) in partner.territory_grant']
  svod_rights_flag boolean [note: 'Indicates whether Subscription Video On Demand distribution rights are included in this grant. | Column svod_rights_flag (BOOLEAN) in partner.territory_grant']
  territory_scope varchar [note: 'Geographic scope of the grant. May be a country code (ISO 3166-1 alpha-3), region name, Designated Market Area (DMA) code, or custom territory definition. | Column territory_scope (STRING) in partner.territory_grant']
  tvod_rights_flag boolean [note: 'Indicates whether Transactional Video On Demand (pay-per-view, rental, electronic sell-through) distribution rights are included in this grant. | Column tvod_rights_flag (BOOLEAN) in partner.territory_grant']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.territory_grant']
  window_type varchar [note: 'Distribution window classification indicating the sequential release strategy phase. Windowing controls when content is available on different platforms to maximize revenue across release stages. [ENUM-REF-CANDIDATE: theatrical|home_video|pay_tv|free_tv|svod|avod|tvod|syndication|perpetual — 9 candidates stripped; promote to reference product] | Column window_type (STRING) in partner.territory_grant']

  Note: 'Specific territorial rights grants within partner agreements — defining the geographic scope (country, region, DMA, blackout zone) for which content rights are licensed or distribution is authorized. Tracks grant type (exclusive, non-exclusive), platform scope (linear, SVOD, AVOD, TVOD), holdback restrictions, and effective window. Feeds the rights domain for clearance and blackout enforcement. | Unity Catalog table: media_broadcasting_ecm.partner.territory_grant'
}

Table partner.partner_audit_event {
  partner_audit_event_id varchar [pk, note: 'Unique identifier for the partner audit event record. Primary key. | Column partner_audit_event_id (BIGINT) in partner.partner_audit_event']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Partner audits (royalty audits, revenue share audits, compliance audits) generate findings that must be tracked in the compliance system for remediation, dispute resolution, and regulatory reporting.  | Column audit_finding_id (BIGINT) in compliance.partner_audit_event']
  audited_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Partner audits (royalty audits, subscriber count verification audits, revenue share audits) examine specific invoices for accuracy. Linking audit events to invoices enables audit trail documentation,  | Column audited_invoice_id (BIGINT) in billing.partner_audit_event']
  disputed_content_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Audits often dispute specific title performance data, revenue allocation, or delivery compliance. Audit finding resolution, adjustment calculation, evidence documentation, and settlement negotiation r | Column disputed_content_title_id (BIGINT) in content.partner_audit_event']
  internal_coordinator_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Partner audits require internal coordinator tracking for liaison with external auditors, document gathering, response management, and follow-up. Essential for audit workload planning, response time tr | Column internal_coordinator_employee_id (BIGINT) in workforce.partner_audit_event']
  partner_agreement_id varchar [note: 'Identifier of the specific partner agreement under which the audit right is being exercised. Links to the contract containing audit provisions. | Column partner_agreement_id (BIGINT) in partner.partner_audit_event']
  partner_id varchar [note: 'Identifier of the partner subject to the audit. Links to the partner being audited under contractual audit rights. | Column partner_id (BIGINT) in partner.partner_audit_event']
  partner_rights_audit_event_id varchar [note: 'Foreign key to SSOT rights.rights_audit_event']
  partner_rights_rights_audit_event_id varchar [note: 'FK to SSOT rights.rights_audit_event']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.partner_audit_event']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.partner_audit_event']
  adjustment_amount decimal(18,2) [note: 'The final monetary adjustment agreed upon or imposed as a result of the audit, representing the net financial settlement. Positive values indicate amounts owed to the auditing party; negative values indicate refunds or credits. | Column adjustment_amount (DECIMAL(18,2)) in partner.partner_audit_event']
  adjustment_amount_currency varchar [note: 'Three-letter ISO 4217 currency code for the adjustment amount (e.g., USD, GBP, EUR). | Column adjustment_amount_currency (STRING) in partner.partner_audit_event']
  audit_cost decimal(18,2) [note: 'The total cost incurred for conducting the audit, including audit firm fees, internal resource costs, travel expenses, and other related costs. Used for cost recovery and budget tracking. | Column audit_cost (DECIMAL(18,2)) in partner.partner_audit_event']
  audit_cost_currency varchar [note: 'Three-letter ISO 4217 currency code for the audit cost (e.g., USD, GBP, EUR). | Column audit_cost_currency (STRING) in partner.partner_audit_event']
  audit_finding_summary varchar [note: 'High-level summary of the audit findings, including key discrepancies, compliance issues, or areas of concern identified during the audit. | Column audit_finding_summary (STRING) in partner.partner_audit_event']
  audit_firm_name varchar [note: 'Name of the external audit firm or internal audit team conducting the audit. May be a third-party accounting firm, specialized media audit firm, or internal audit department. | Column audit_firm_name (STRING) in partner.partner_audit_event']
  audit_initiated_date date [note: 'The date on which the audit was formally initiated, typically when the audit notice was sent to the partner or when the audit firm was engaged. | Column audit_initiated_date (DATE) in partner.partner_audit_event']
  audit_period_end_date date [note: 'The ending date of the period being audited. Defines the end of the time window for which records, transactions, and compliance are being examined. | Column audit_period_end_date (DATE) in partner.partner_audit_event']
  audit_period_start_date date [note: 'The beginning date of the period being audited. Defines the start of the time window for which records, transactions, and compliance are being examined. | Column audit_period_start_date (DATE) in partner.partner_audit_event']
  audit_reference_number varchar [note: 'External reference number or code assigned to this audit event by the auditing party or audit firm for tracking and correspondence purposes. | Column audit_reference_number (STRING) in partner.partner_audit_event']
  audit_scope varchar [note: 'Detailed description of the scope of the audit, including the specific content, time periods, territories, revenue streams, or cost categories being examined. | Column audit_scope (STRING) in partner.partner_audit_event']
  audit_status varchar [note: 'Current lifecycle status of the audit event. Planned audits are scheduled but not started; in-progress audits are actively being conducted; fieldwork complete indicates data collection is done; draft report indicates preliminary findings are documented; final report indicates audit is complete; disputed indicates findings are contested; resolved indicates disputes are settled; closed indicates all actions are complete. [ENUM-REF-CANDIDATE: planned|in_progress|fieldwork_complete|draft_report|final_report|disputed|resolved|closed — 8 candidates stripped; promote to reference product] | Column audit_status (STRING) in partner.partner_audit_event']
  audit_trigger varchar [note: 'The event or condition that initiated the audit. Scheduled audits are routine contractual audits; threshold breach audits are triggered by variance thresholds; dispute audits arise from disagreements; regulatory audits are mandated by authorities; random audits are part of compliance sampling; partner request audits are initiated by the partner. | Column audit_trigger (STRING) in partner.partner_audit_event']
  audit_type varchar [note: 'Category of audit being performed. Content usage audits verify content delivery and usage reporting; subscriber count audits verify subscriber numbers for carriage fee calculations; royalty statement audits verify royalty calculations and payments; carriage fee audits verify fee calculations; co-production cost audits verify shared production expenses; rights compliance audits verify adherence to licensing terms. | Column audit_type (STRING) in partner.partner_audit_event']
  corrective_action_description varchar [note: 'Detailed description of the corrective actions required or agreed upon, including process changes, system enhancements, training, or compliance measures. | Column corrective_action_description (STRING) in partner.partner_audit_event']
  corrective_action_due_date date [note: 'The deadline by which the partner must complete the required corrective actions. Used for tracking compliance with audit remediation requirements. | Column corrective_action_due_date (DATE) in partner.partner_audit_event']
  corrective_action_required boolean [note: 'Indicates whether corrective actions are required from the partner as a result of the audit findings. True if process improvements, system changes, or compliance remediation is mandated. | Column corrective_action_required (BOOLEAN) in partner.partner_audit_event']
  cost_recovery_status varchar [note: 'Status of recovering audit costs from the partner when contractually permitted. Not applicable if costs are not recoverable; pending if recovery not yet initiated; invoiced if bill sent; partially recovered if some payment received; fully recovered if all costs reimbursed; waived if costs forgiven. | Column cost_recovery_status (STRING) in partner.partner_audit_event']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.partner_audit_event']
  created_timestamp timestamp [note: 'Timestamp when this audit event record was first created in the system. Used for data lineage and audit trail purposes. | Column created_timestamp (TIMESTAMP) in partner.partner_audit_event']
  disputed_amount decimal(18,2) [note: 'The total monetary amount in dispute as a result of audit findings, representing the financial discrepancy between reported and audited figures. Null if no financial dispute exists. | Column disputed_amount (DECIMAL(18,2)) in partner.partner_audit_event']
  disputed_amount_currency varchar [note: 'Three-letter ISO 4217 currency code for the disputed amount (e.g., USD, GBP, EUR). | Column disputed_amount_currency (STRING) in partner.partner_audit_event']
  draft_report_date date [note: 'The date on which the draft audit report was issued to the partner for review and response before finalization. | Column draft_report_date (DATE) in partner.partner_audit_event']
  fieldwork_end_date date [note: 'The date on which the audit fieldwork was completed, when auditors finished their on-site or remote examination activities. | Column fieldwork_end_date (DATE) in partner.partner_audit_event']
  fieldwork_start_date date [note: 'The date on which the audit fieldwork began, when auditors started examining records, conducting interviews, and gathering evidence. | Column fieldwork_start_date (DATE) in partner.partner_audit_event']
  final_report_date date [note: 'The date on which the final audit report was issued, incorporating partner responses and auditor conclusions. | Column final_report_date (DATE) in partner.partner_audit_event']
  finding_category varchar [note: 'Classification of the severity and nature of audit findings. No findings indicates clean audit; minor discrepancy indicates immaterial variances; material discrepancy indicates significant financial impact; compliance breach indicates contractual violations; fraud suspected indicates potential intentional misrepresentation; process weakness indicates control deficiencies. | Column finding_category (STRING) in partner.partner_audit_event']
  follow_up_audit_date date [note: 'The scheduled or actual date of the follow-up audit to verify corrective action implementation and compliance. | Column follow_up_audit_date (DATE) in partner.partner_audit_event']
  follow_up_audit_required boolean [note: 'Indicates whether a follow-up audit is required to verify implementation of corrective actions or to re-examine areas of concern. True if subsequent audit is mandated. | Column follow_up_audit_required (BOOLEAN) in partner.partner_audit_event']
  lead_auditor_name varchar [note: 'Full name of the lead auditor responsible for conducting and overseeing the audit engagement. | Column lead_auditor_name (STRING) in partner.partner_audit_event']
  notes varchar [note: 'Additional notes, comments, or context about the audit event, including special circumstances, escalations, or other relevant information not captured in structured fields. | Column notes (STRING) in partner.partner_audit_event']
  partner_response_date date [note: 'The date on which the partner formally responded to the draft or final audit report, providing their position on the findings. | Column partner_response_date (DATE) in partner.partner_audit_event']
  partner_response_summary varchar [note: 'Summary of the partners formal response to the audit findings, including their agreement, disagreement, explanations, or proposed corrective actions. | Column partner_response_summary (STRING) in partner.partner_audit_event']
  resolution_date date [note: 'The date on which the audit findings and any disputes were fully resolved, either through acceptance, negotiation, arbitration, or legal settlement. | Column resolution_date (DATE) in partner.partner_audit_event']
  resolution_status varchar [note: 'Current status of the resolution process for audit findings. Pending indicates no response yet; accepted indicates partner agrees with findings; partially accepted indicates agreement on some findings; rejected indicates partner disputes findings; negotiating indicates active discussions; arbitration indicates formal dispute resolution; litigation indicates legal proceedings; settled indicates final agreement reached. [ENUM-REF-CANDIDATE: pending|accepted|partially_accepted|rejected|negotiating|arbitration|litigation|settled — 8 candidates stripped; promote to reference product] | Column resolution_status (STRING) in partner.partner_audit_event']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.partner_audit_event']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.partner_audit_event']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.partner_audit_event']
  updated_timestamp timestamp [note: 'Timestamp when this audit event record was last modified. Used for tracking changes and data currency. | Column updated_timestamp (TIMESTAMP) in partner.partner_audit_event']

  Note: 'Business audit events related to partner agreement compliance — content usage audits, subscriber count verifications for carriage fee calculations, royalty statement audits, and co-production cost audits. Tracks audit trigger, scope, findings, disputed amounts, resolution status, and audit firm. Distinct from IT audit logs — these are contractual audit rights exercised under partner agreements. | Unity Catalog table: media_broadcasting_ecm.partner.partner_audit_event'
}

Table partner.partner_dispute {
