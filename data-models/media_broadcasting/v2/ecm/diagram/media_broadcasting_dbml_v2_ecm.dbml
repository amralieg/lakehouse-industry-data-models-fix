}

Table rights.license_agreement {
  license_agreement_id varchar [pk, note: 'Unique system identifier for the license agreement record. Primary key. Role: MASTER_AGREEMENT. | Column license_agreement_id (BIGINT) in rights.license_agreement']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: License agreements for broadcast content must reference the FCC broadcast license under which content is distributed. Required for regulatory compliance and public inspection file documentation. | Column broadcast_license_id (BIGINT) in compliance.license_agreement']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: License agreements are managed by specific business units with dedicated cost centers for budget tracking and expense allocation. Required for departmental P&L reporting, budget variance analysis, and | Column cost_center_id (BIGINT) in finance.license_agreement']
  licensee_sales_account_id varchar [note: 'Foreign key linking to sales.sales_account. Business justification: License agreements are negotiated with sales accounts (distributors, broadcasters, platforms). Real-world licensing operations require tracking which sales account is the licensee for revenue recognit | Column licensee_sales_account_id (BIGINT) in sales.license_agreement']
  negotiator_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: License agreements require tracking the business affairs executive who negotiated the deal for accountability, commission calculations, workload balancing, and routing renewal negotiations to the rela | Column negotiator_employee_id (BIGINT) in workforce.license_agreement']
  primary_license_holder_id varchar [note: 'Reference to the party granting rights under this agreement (studio, distributor, music publisher, talent guild, production company). | Column primary_license_holder_id (BIGINT) in rights.license_agreement']
  primary_licensee_partner_partner_id varchar [note: 'FK to partner.partner_partner | Column primary_licensee_partner_partner_id (BIGINT) in partner.license_agreement']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: License agreements generate revenue streams and incur costs tracked to profit centers for segment reporting. Required for segment profitability analysis, EBITDA reporting by business unit, and managem | Column profit_center_id (BIGINT) in finance.license_agreement']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Material license agreements (ownership changes, political advertising contracts, significant territory expansions) trigger FCC regulatory filings. Tracks which agreements require public disclosure or  | Column regulatory_filing_id (BIGINT) in compliance.license_agreement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.license_agreement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.license_agreement']
  advance_payment_amount decimal(18,2) [note: 'Upfront payment made upon execution of the agreement, typically recoupable against future royalties or license fees. | Column advance_payment_amount (DECIMAL(18,2)) in rights.license_agreement']
  agreement_number varchar [note: 'Externally-known unique business identifier for the license agreement, used in contracts and communications with rights holders and licensees. | Column agreement_number (STRING) in rights.license_agreement']
  agreement_status varchar [note: 'Current lifecycle state of the license agreement. Controls whether rights are available for scheduling and distribution. | Column agreement_status (STRING) in rights.license_agreement']
  agreement_type varchar [note: 'Classification of the license agreement based on the nature of the rights transaction. Determines workflow, royalty calculation rules, and windowing strategies. [ENUM-REF-CANDIDATE: acquisition|co-production|syndication|first-run syndication|off-network syndication|international syndication|music sync|output deal — 8 candidates stripped; promote to reference product] | Column agreement_type (STRING) in rights.license_agreement']
  auto_renewal_flag boolean [note: 'Indicates whether the agreement automatically renews at expiry unless terminated by either party. True = auto-renews, False = expires at term end. | Column auto_renewal_flag (BOOLEAN) in rights.license_agreement']
  blackout_restrictions varchar [note: 'Geographic or temporal restrictions on content availability (e.g., no broadcast in certain markets during specific events, sports blackout rules). Free-text description. | Column blackout_restrictions (STRING) in rights.license_agreement']
  clearance_required_flag boolean [note: 'Indicates whether additional rights clearance verification is required before content can be broadcast or distributed under this agreement. True = clearance workflow required, False = no additional clearance needed. | Column clearance_required_flag (BOOLEAN) in rights.license_agreement']
  content_rating_restriction varchar [note: 'Content rating limitations imposed by this agreement (e.g., PG-13 and below only, no R-rated content). Comma-separated list of allowed ratings per MPA or TV Parental Guidelines. | Column content_rating_restriction (STRING) in rights.license_agreement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.license_agreement']
  created_timestamp timestamp [note: 'System timestamp when this license agreement record was first created in Rightsline. | Column created_timestamp (TIMESTAMP) in rights.license_agreement']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this agreement (e.g., USD, GBP, EUR). | Column currency_code (STRING) in rights.license_agreement']
  effective_date date [note: 'Date when the license agreement becomes legally binding and rights become available for exploitation. Start of the agreement term. | Column effective_date (DATE) in rights.license_agreement']
  exclusivity_flag boolean [note: 'Indicates whether the license grants exclusive rights within the territory and media windows. True = exclusive, False = non-exclusive. | Column exclusivity_flag (BOOLEAN) in rights.license_agreement']
  expiry_date date [note: 'Date when the license agreement terminates and rights revert to the licensor. End of the agreement term. Nullable for perpetual agreements. | Column expiry_date (DATE) in rights.license_agreement']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of this agreement (e.g., State of California, England and Wales, New York). | Column governing_law_jurisdiction (STRING) in rights.license_agreement']
  holdback_period_days varchar [note: 'Number of days during which content must be withheld from certain distribution windows to protect exclusivity in other windows (e.g., theatrical holdback before SVOD release). | Column holdback_period_days (INT) in rights.license_agreement']
  last_modified_timestamp timestamp [note: 'System timestamp when this license agreement record was last updated in Rightsline. | Column last_modified_timestamp (TIMESTAMP) in rights.license_agreement']
  media_rights_granted varchar [note: 'Comma-separated list of media exploitation rights included in this agreement (e.g., linear broadcast, SVOD, AVOD, TVOD, theatrical, home video, digital download, mobile streaming). | Column media_rights_granted (STRING) in rights.license_agreement']
  minimum_guarantee_amount decimal(18,2) [note: 'Minimum guaranteed payment to the licensor regardless of actual usage or revenue performance. Common in output deals and syndication agreements. | Column minimum_guarantee_amount (DECIMAL(18,2)) in rights.license_agreement']
  music_sync_license_flag boolean [note: 'Indicates whether this agreement includes music synchronization rights for use of musical compositions in audiovisual content. True = music sync rights included, False = no music sync rights. | Column music_sync_license_flag (BOOLEAN) in rights.license_agreement']
  notes varchar [note: 'Free-text field for additional contractual terms, special conditions, or internal comments about the agreement. | Column notes (STRING) in rights.license_agreement']
  payment_schedule_type varchar [note: 'Structure of the payment obligation. Determines how total_license_fee is disbursed over time. | Column payment_schedule_type (STRING) in rights.license_agreement']
  per_episode_fee decimal(18,2) [note: 'License fee charged per episode for episodic content. Applicable to syndication and first-run syndication agreements. | Column per_episode_fee (DECIMAL(18,2)) in rights.license_agreement']
  renewal_term_months varchar [note: 'Duration in months of each automatic renewal period if auto_renewal_flag is true. Null if agreement does not auto-renew. | Column renewal_term_months (INT) in rights.license_agreement']
  residuals_obligation_flag boolean [note: 'Indicates whether the agreement includes obligations to pay talent residuals for reuse of content. True = residuals required, False = no residuals. | Column residuals_obligation_flag (BOOLEAN) in rights.license_agreement']
  royalty_calculation_method varchar [note: 'Method used to calculate ongoing royalty payments to the licensor. Determines how revenue is shared or how usage is monetized. | Column royalty_calculation_method (STRING) in rights.license_agreement']
  royalty_percentage decimal(5,2) [note: 'Percentage of revenue or receipts paid to the licensor as ongoing royalties. Applicable when royalty_calculation_method is percentage-based. | Column royalty_percentage (DECIMAL(5,2)) in rights.license_agreement']
  run_count_limit varchar [note: 'Maximum number of times each episode or program may be broadcast or streamed under this agreement. Common in syndication deals. Null indicates unlimited runs. | Column run_count_limit (INT) in rights.license_agreement']
  signed_date date [note: 'Date when the agreement was executed by all parties. May differ from effective_date. | Column signed_date (DATE) in rights.license_agreement']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.license_agreement']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.license_agreement']
  sublicensing_allowed_flag boolean [note: 'Indicates whether the licensee is permitted to sublicense the rights to third parties. True = sublicensing allowed, False = sublicensing prohibited. | Column sublicensing_allowed_flag (BOOLEAN) in rights.license_agreement']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the agreement before expiry or renewal. | Column termination_notice_days (INT) in rights.license_agreement']
  territory_scope varchar [note: 'Geographic territories covered by this license agreement. Comma-separated list of ISO 3166-1 alpha-3 country codes or region identifiers (e.g., USA,CAN,MEX or WORLDWIDE or EMEA). | Column territory_scope (STRING) in rights.license_agreement']
  total_license_fee decimal(18,2) [note: 'Total contractual payment obligation for the license rights over the full term of the agreement. Sum of all payment milestones. | Column total_license_fee (DECIMAL(18,2)) in rights.license_agreement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.license_agreement']
  windowing_strategy varchar [note: 'Sequential release strategy defining the order and timing of content availability across distribution channels (theatrical, SVOD, AVOD, TVOD, linear, syndication). Free-text description of the windowing plan. | Column windowing_strategy (STRING) in rights.license_agreement']

  Note: 'Master record for all content licensing, acquisition, and syndication agreements managed in Rightsline. Captures the full contractual relationship between Media Broadcasting and rights grantors or licensees (studios, distributors, music publishers, talent guilds, syndication partners). Stores agreement type (acquisition, co-production, syndication, first-run syndication, off-network syndication, international syndication, music sync, output deal), licensor and licensee identities, effective and expiry dates, territory scope, exclusivity flags, total license fee, payment schedule with milestone detail (advances, minimum guarantees, per-episode fees, annual installments), run count limitations for syndication, governing law jurisdiction, and agreement status (draft, executed, expired, terminated). This is the SSOT for all rights-bearing contracts and the anchor entity for all downstream window, royalty, and clearance records. | Unity Catalog table: media_broadcasting_ecm.rights.license_agreement Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore).'
}

Table rights.grant {
  grant_id varchar [pk, note: 'Unique identifier for the rights grant record. Primary key. | Column grant_id (BIGINT) in rights.grant']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Rights grants must enforce content rating restrictions by territory. Clearance workflow validates that granted rights comply with rating-based distribution restrictions (e.g., TV-MA content on childre | Column compliance_content_rating_id (BIGINT) in compliance.grant']
  license_agreement_id varchar [note: 'Reference to the parent license agreement from which this grant is derived. | Column license_agreement_id (BIGINT) in rights.grant']
  media_asset_id varchar [note: 'Reference to the content asset (film, series, episode, music track) to which this grant applies. | Column media_asset_id (BIGINT) in mediaasset.grant']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Rights grants apply to specific territories. Each rights grant covers one territory. Normalizing to territory reference eliminates redundant territory string storage and enables consistent territory m | Column rights_territory_id (BIGINT) in rights.grant']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.grant']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.grant']
  blackout_applicable boolean [note: 'Indicates whether geographic or temporal blackout restrictions apply to this grant (e.g., sports blackouts, regional restrictions). | Column blackout_applicable (BOOLEAN) in rights.grant']
  carriage_fee_applicable boolean [note: 'Indicates whether a carriage fee (distribution payment) is associated with this grant. | Column carriage_fee_applicable (BOOLEAN) in rights.grant']
  clearance_status varchar [note: 'Current clearance status of the grant. Indicates whether all rights verification and legal clearances have been completed. | Column clearance_status (STRING) in rights.grant']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.grant']
  created_timestamp timestamp [note: 'Timestamp when this rights grant record was first created in the system. | Column created_timestamp (TIMESTAMP) in rights.grant']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for financial amounts in this grant (e.g., USD, GBP, EUR). | Column currency_code (STRING) in rights.grant']
  drm_required boolean [note: 'Indicates whether DRM protection is mandated for content distributed under this grant. | Column drm_required (BOOLEAN) in rights.grant']
  end_date date [note: 'The date on which the rights grant expires and exploitation must cease. Nullable for perpetual grants. | Column end_date (DATE) in rights.grant']
  exclusivity_indicator boolean [note: 'Indicates whether the grant is exclusive (true) or non-exclusive (false). Exclusive grants prevent other parties from exploiting the same rights in the same territory and window. | Column exclusivity_indicator (BOOLEAN) in rights.grant']
  grant_number varchar [note: 'Business identifier for the rights grant, typically a human-readable code used in Rightsline and operational workflows. | Column grant_number (STRING) in rights.grant']
  grant_status varchar [note: 'Current lifecycle status of the rights grant. Reflects whether the grant is currently in force, expired, or otherwise inactive. | Column grant_status (STRING) in rights.grant']
  holdback_applicable boolean [note: 'Indicates whether a holdback period applies to this grant. Holdbacks restrict exploitation during specific windows to protect other distribution channels. | Column holdback_applicable (BOOLEAN) in rights.grant']
  holdback_end_date date [note: 'The end date of the holdback period, after which exploitation may resume. Nullable if no holdback applies. | Column holdback_end_date (DATE) in rights.grant']
  holdback_start_date date [note: 'The start date of any holdback period during which exploitation is restricted. Nullable if no holdback applies. | Column holdback_start_date (DATE) in rights.grant']
  language_version varchar [note: 'Language version of the content covered by this grant (e.g., English, Spanish, French). May reference dubbed, subtitled, or original language versions. | Column language_version (STRING) in rights.grant']
  media_type varchar [note: 'The media format or delivery mechanism covered by this grant (e.g., television, film, digital streaming, audio). | Column media_type (STRING) in rights.grant']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount for this grant, regardless of actual revenue. Nullable if no MG applies. | Column minimum_guarantee_amount (DECIMAL(15,2)) in rights.grant']
  modified_timestamp timestamp [note: 'Timestamp when this rights grant record was last modified. | Column modified_timestamp (TIMESTAMP) in rights.grant']
  music_sync_license_required boolean [note: 'Indicates whether a separate music synchronization license is required for the music tracks embedded in the content. | Column music_sync_license_required (BOOLEAN) in rights.grant']
  notes varchar [note: 'Free-text notes capturing additional terms, conditions, or operational instructions related to this grant. | Column notes (STRING) in rights.grant']
  right_type varchar [note: 'Type of distribution or exploitation right granted. Defines the platform or medium for which the content may be used. [ENUM-REF-CANDIDATE: broadcast|svod|avod|tvod|theatrical|home_video|music_sync|podcast|linear|non_linear|vod — 11 candidates stripped; promote to reference product] | Column right_type (STRING) in rights.grant']
  royalty_rate_percent decimal(5,2) [note: 'Percentage royalty rate applied to revenue generated under this grant. Used for royalty calculations. | Column royalty_rate_percent (DECIMAL(5,2)) in rights.grant']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.grant']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.grant']
  start_date date [note: 'The date on which the rights grant becomes effective and exploitation may begin. | Column start_date (DATE) in rights.grant']
  sublicense_permitted boolean [note: 'Indicates whether the licensee is permitted to sublicense the rights to third parties. | Column sublicense_permitted (BOOLEAN) in rights.grant']
  talent_residuals_applicable boolean [note: 'Indicates whether talent residual payments (reuse payments to actors, directors, writers) are triggered by this grant. | Column talent_residuals_applicable (BOOLEAN) in rights.grant']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.grant']
  window_name varchar [note: 'Named distribution window (e.g., Theatrical, Premium VOD, Pay-TV, Free-TV) that this grant falls within. Used for windowing strategy enforcement. | Column window_name (STRING) in rights.grant']

  Note: 'Granular rights entitlement record derived from a license agreement. Each row represents a specific bundle of rights granted for a content asset — capturing right type (broadcast, SVOD, AVOD, TVOD, theatrical, home video, music sync, podcast), media type, territory or territory group, language version, exclusivity indicator, holdback applicability, and the grant period (start and end dates). Multiple grants can exist per agreement and per content asset. Feeds the availability engine in scheduling and distribution domains. Powered by Rightsline availabilities module. | Unity Catalog table: media_broadcasting_ecm.rights.grant Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore). COPPA child-directed content compliance applicable.'
}

Table rights.rights_content_window {
  rights_content_window_id varchar [pk, note: 'Unique identifier for the content window record. Primary key for the rights content window entity. | Column rights_content_window_id (BIGINT) in rights.rights_content_window']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: Content windows must track closed captioning compliance for each distribution window. Links rights availability to the captioning record that proves FCC accessibility compliance for that window. | Column closed_caption_record_id (BIGINT) in compliance.rights_content_window']
  license_agreement_id varchar [note: 'Reference to the parent rights agreement or license contract that governs this window. Links to the master rights agreement. | Column license_agreement_id (BIGINT) in rights.rights_content_window']
  media_asset_id varchar [note: 'Reference to the specific content asset (film, series, episode, program) to which this window applies. Links to the content master record. | Column media_asset_id (BIGINT) in mediaasset.rights_content_window']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Content windows apply to specific territories. Each window covers one territory. Normalizing to territory reference eliminates redundant territory string storage and enables consistent territory metad | Column rights_territory_id (BIGINT) in rights.rights_content_window']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.rights_content_window']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.rights_content_window']
  active_flag boolean [note: 'Indicates whether this window record is currently active and should be considered in availability calculations. False if the window has been superseded, cancelled, or archived. | Column active_flag (BOOLEAN) in rights.rights_content_window']
  availability_status varchar [note: 'The computed net availability status of the content for this window, considering window dates, holdbacks, and blackouts. Refreshed whenever upstream rights or holdback records change. Directly consumed by scheduling and distribution domains to validate playout eligibility. | Column availability_status (STRING) in rights.rights_content_window']
  blackout_flag boolean [note: 'Indicates whether a geographic or temporal blackout restriction is currently active for this window. True if content is blacked out and cannot be distributed; false otherwise. | Column blackout_flag (BOOLEAN) in rights.rights_content_window']
  blackout_reason varchar [note: 'The business or regulatory reason for the blackout restriction (e.g., sports event local blackout, contractual exclusivity, regulatory compliance). Populated only when blackout_flag is true. | Column blackout_reason (STRING) in rights.rights_content_window']
  clearance_notes varchar [note: 'Free-text notes documenting clearance issues, pending approvals, conditional restrictions, or special instructions related to rights clearance for this window. | Column clearance_notes (STRING) in rights.rights_content_window']
  clearance_status varchar [note: 'The current status of the rights clearance workflow for this window. Indicates whether all necessary rights, music licenses, talent approvals, and regulatory clearances have been obtained to authorize distribution. | Column clearance_status (STRING) in rights.rights_content_window']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.rights_content_window']
  created_by_user varchar [note: 'The username or identifier of the user who created this window record. Audit field for accountability and compliance. | Column created_by_user (STRING) in rights.rights_content_window']
  created_timestamp timestamp [note: 'The timestamp when this window record was first created in the system. Audit field for data lineage and compliance. | Column created_timestamp (TIMESTAMP) in rights.rights_content_window']
  drm_requirement varchar [note: 'The DRM technology or protection scheme required for content distribution during this window. Enforces content protection and anti-piracy requirements specified in the rights agreement. | Column drm_requirement (STRING) in rights.rights_content_window']
  exclusivity_tier varchar [note: 'The level of exclusivity granted for this window. Exclusive windows prevent simultaneous distribution on competing platforms; non-exclusive allows parallel exploitation. First and second window designations indicate priority in the windowing hierarchy. | Column exclusivity_tier (STRING) in rights.rights_content_window']
  geo_blocking_required_flag boolean [note: 'Indicates whether geographic blocking technology must be enforced to restrict access to the specified territory. True if geo-blocking is mandatory; false if not required. | Column geo_blocking_required_flag (BOOLEAN) in rights.rights_content_window']
  holdback_end_date date [note: 'The date when a holdback period ends and distribution is re-authorized. Marks the conclusion of the exclusivity restriction. | Column holdback_end_date (DATE) in rights.rights_content_window']
  holdback_start_date date [note: 'The date when a holdback period begins, temporarily restricting distribution even within an open window. Used to enforce exclusivity periods and prevent simultaneous exploitation across competing platforms. | Column holdback_start_date (DATE) in rights.rights_content_window']
  last_availability_refresh_timestamp timestamp [note: 'The timestamp when the availability_status was last recalculated. Updated whenever upstream rights, holdback, or blackout records change. Used to track data freshness for scheduling and distribution systems. | Column last_availability_refresh_timestamp (TIMESTAMP) in rights.rights_content_window']
  license_fee_amount decimal(18,2) [note: 'The monetary fee paid by the platform or distributor for the rights to exploit the content during this window. May be a flat fee, minimum guarantee, or advance against royalties. | Column license_fee_amount (DECIMAL(18,2)) in rights.rights_content_window']
  license_fee_currency varchar [note: 'The three-letter ISO 4217 currency code for the license fee amount (e.g., USD, GBP, EUR). | Column license_fee_currency (STRING) in rights.rights_content_window']
  minimum_guarantee_amount decimal(18,2) [note: 'The minimum guaranteed payment amount that the distributor or platform must pay regardless of actual revenue or usage. Common in SVOD and licensing deals. | Column minimum_guarantee_amount (DECIMAL(18,2)) in rights.rights_content_window']
  modified_by_user varchar [note: 'The username or identifier of the user who last modified this window record. Audit field for accountability and compliance. | Column modified_by_user (STRING) in rights.rights_content_window']
  modified_timestamp timestamp [note: 'The timestamp when this window record was last modified. Audit field for change tracking and data lineage. | Column modified_timestamp (TIMESTAMP) in rights.rights_content_window']
  platform_scope varchar [note: 'The specific platform, channel, service, or outlet authorized for distribution during this window (e.g., Netflix, HBO Max, ABC Network, theatrical chain). May be a single platform or a platform group. | Column platform_scope (STRING) in rights.rights_content_window']
  revenue_share_percent decimal(5,2) [note: 'The percentage of gross or net revenue that the rights holder receives from exploitation during this window. Common in TVOD, AVOD, and theatrical windows. | Column revenue_share_percent (DECIMAL(5,2)) in rights.rights_content_window']
  royalty_rate_percent decimal(5,2) [note: 'The percentage rate applied to revenue or usage to calculate royalty payments for this window. Used when the window operates under a revenue-sharing or usage-based royalty model. | Column royalty_rate_percent (DECIMAL(5,2)) in rights.rights_content_window']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.rights_content_window']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.rights_content_window']
  sublicense_permitted_flag boolean [note: 'Indicates whether the platform or distributor is authorized to sublicense the content to third parties during this window. True if sublicensing is permitted; false if prohibited. | Column sublicense_permitted_flag (BOOLEAN) in rights.rights_content_window']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.rights_content_window']
  usage_cap_type varchar [note: 'The unit of measure for the usage cap (e.g., streams for SVOD, broadcasts for linear, screenings for theatrical). Defines how usage is counted against the cap. | Column usage_cap_type (STRING) in rights.rights_content_window']
  usage_cap_units varchar [note: 'The maximum number of usage units (streams, downloads, broadcasts, screenings) permitted during this window. Used to enforce contractual usage limits. | Column usage_cap_units (INT) in rights.rights_content_window']
  window_close_date date [note: 'The date when this exploitation window ends and the content is no longer authorized for distribution on the specified platform. End of the availability period. Nullable for perpetual windows. | Column window_close_date (DATE) in rights.rights_content_window']
  window_extension_count varchar [note: 'The number of times this window has been extended beyond its original close date. Tracks amendments and extensions to the original window terms. | Column window_extension_count (INT) in rights.rights_content_window']
  window_open_date date [note: 'The date when this exploitation window becomes active and the content is authorized for distribution on the specified platform. Start of the availability period. | Column window_open_date (DATE) in rights.rights_content_window']
  window_priority varchar [note: 'The numeric priority or sequence order of this window in the overall windowing strategy. Lower numbers indicate earlier windows in the release hierarchy (e.g., 1 for theatrical, 2 for PVOD, 3 for SVOD). Used to enforce windowing hierarchy rules. | Column window_priority (INT) in rights.rights_content_window']
  window_type varchar [note: 'The exploitation window category defining the distribution model and platform type. Determines the sequential release strategy position in the windowing hierarchy. [ENUM-REF-CANDIDATE: theatrical|pvod|tvod|svod|avod|linear|fast|home_video|syndication|vod — 10 candidates stripped; promote to reference product] | Column window_type (STRING) in rights.rights_content_window']

  Note: 'Defines the sequential release window strategy (windowing) for a specific content asset across exploitation platforms, and computes the net availability status. Each record captures the window type (theatrical, PVOD, TVOD, SVOD, AVOD, linear, FAST, home video, syndication), platform or channel scope, window open and close dates, holdback start and end dates, territory, exclusivity tier, and computed availability status (available, held-back, blacked-out, expired). Enforces the windowing hierarchy that prevents simultaneous exploitation across competing platforms. The net availability (considering holdbacks and blackouts) is refreshed whenever upstream rights or holdback records change. Directly consumed by scheduling and distribution domains to validate playout eligibility. Powered by Rightsline Windows module. | Unity Catalog table: media_broadcasting_ecm.rights.rights_content_window Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore).'
}

Table rights.holdback {
  holdback_id varchar [pk, note: 'Unique identifier for the holdback restriction record. Primary key. | Column holdback_id (BIGINT) in rights.holdback']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Holdbacks restrict specific rights grants. Each holdback applies to one rights grant, establishing which exploitation rights are being restricted. This FK enables tracing holdback restrictions back to | Column grant_id (BIGINT) in rights.holdback']
  license_agreement_id varchar [note: 'Reference to the source license agreement that establishes this holdback restriction. | Column license_agreement_id (BIGINT) in rights.holdback']
  media_asset_id varchar [note: 'Reference to the content asset subject to this holdback restriction. | Column media_asset_id (BIGINT) in mediaasset.holdback']
  partner_content_window_id varchar [note: 'Reference to the triggering content window that activates this holdback restriction. | Column partner_content_window_id (BIGINT) in partner.holdback']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Holdbacks apply to specific territories. Each holdback restricts one territory. Normalizing to territory reference eliminates redundant territory string storage and enables consistent territory metada | Column rights_territory_id (BIGINT) in rights.holdback']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.holdback']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.holdback']
  automated_enforcement_flag boolean [note: 'Indicates whether this holdback restriction is automatically enforced by scheduling and distribution systems or requires manual review. | Column automated_enforcement_flag (BOOLEAN) in rights.holdback']
  carriage_negotiation_reference varchar [note: 'Reference identifier to the MVPD or vMVPD carriage negotiation that established this holdback restriction. | Column carriage_negotiation_reference (STRING) in rights.holdback']
  clearance_workflow_status varchar [note: 'Status of the clearance workflow process that validates whether content can be scheduled or distributed despite this holdback restriction. | Column clearance_workflow_status (STRING) in rights.holdback']
  conflict_resolution_notes varchar [note: 'Documentation of any conflicts with other rights, windows, or holdbacks and how they were resolved. | Column conflict_resolution_notes (STRING) in rights.holdback']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.holdback']
  created_timestamp timestamp [note: 'Timestamp when this holdback restriction record was first created in the system. | Column created_timestamp (TIMESTAMP) in rights.holdback']
  duration_days varchar [note: 'Total number of days the holdback restriction is in effect, calculated from start to end date. | Column duration_days (INT) in rights.holdback']
  end_date date [note: 'Date when the holdback restriction expires and the content becomes available for exploitation on the previously restricted platform, territory, channel, or format. | Column end_date (DATE) in rights.holdback']
  enforcement_status varchar [note: 'Current enforcement state of the holdback restriction, indicating whether it is actively blocking content exploitation or has been modified. | Column enforcement_status (STRING) in rights.holdback']
  exclusivity_scope varchar [note: 'Scope of exclusivity granted by this holdback, defining whether the restriction is absolute or allows limited exploitation. | Column exclusivity_scope (STRING) in rights.holdback']
  holdback_code varchar [note: 'Business identifier code for the holdback restriction, used for external reference and clearance workflows. | Column holdback_code (STRING) in rights.holdback']
  last_modified_by varchar [note: 'User or system identifier that last modified this holdback restriction record. | Column last_modified_by (STRING) in rights.holdback']
  last_modified_timestamp timestamp [note: 'Timestamp when this holdback restriction record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in rights.holdback']
  notification_sent_flag boolean [note: 'Indicates whether notification of this holdback restriction has been sent to relevant scheduling, distribution, and operations teams. | Column notification_sent_flag (BOOLEAN) in rights.holdback']
  priority_level varchar [note: 'Business priority assigned to this holdback restriction, indicating its importance in windowing strategy and enforcement. | Column priority_level (STRING) in rights.holdback']
  restricted_channel varchar [note: 'Specific broadcast or distribution channel that is restricted from airing or distributing the content during the holdback period. | Column restricted_channel (STRING) in rights.holdback']
  restricted_format varchar [note: 'Distribution format or delivery method that is restricted during the holdback period, supporting windowing strategies. [ENUM-REF-CANDIDATE: theatrical|linear_tv|svod|avod|tvod|vod|physical_media|syndication|streaming|broadcast — 10 candidates stripped; promote to reference product] | Column restricted_format (STRING) in rights.holdback']
  restricted_platform varchar [note: 'Name or identifier of the platform, distributor, or service that is restricted from exploiting the content during the holdback period. Applies to platform_holdback restriction types. | Column restricted_platform (STRING) in rights.holdback']
  restriction_type varchar [note: 'Classification of the holdback restriction type that defines the nature of the exclusivity period. | Column restriction_type (STRING) in rights.holdback']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.holdback']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.holdback']
  start_date date [note: 'Date when the holdback restriction becomes effective and the content is blocked from the specified platform, territory, channel, or format. | Column start_date (DATE) in rights.holdback']
  triggering_window_type varchar [note: 'Type of content window that triggers or activates this holdback restriction, defining the sequential release strategy. [ENUM-REF-CANDIDATE: theatrical|svod|avod|tvod|linear|syndication|home_video|pay_per_view|free_tv|premium_tv — 10 candidates stripped; promote to reference product] | Column triggering_window_type (STRING) in rights.holdback']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.holdback']
  waiver_approved_by varchar [note: 'Name or identifier of the person or role who authorized the waiver or override of the holdback restriction. | Column waiver_approved_by (STRING) in rights.holdback']
  waiver_approved_date date [note: 'Date when the waiver or override of the holdback restriction was officially approved. | Column waiver_approved_date (DATE) in rights.holdback']
  waiver_reason varchar [note: 'Business justification or explanation for waiving or overriding the holdback restriction, if applicable. | Column waiver_reason (STRING) in rights.holdback']
  windowing_strategy_notes varchar [note: 'Additional notes or context explaining how this holdback fits into the overall content windowing and sequential release strategy. | Column windowing_strategy_notes (STRING) in rights.holdback']
  created_by varchar [note: 'User or system identifier that created this holdback restriction record. | Column created_by (STRING) in rights.holdback']

  Note: 'Records exclusivity holdback restrictions that prevent a content asset from being exploited on a specific platform, territory, or channel during a defined period. Each holdback captures the restriction type (platform holdback, territory holdback, channel holdback, format holdback), the restricted platform or distributor, holdback start and end dates, the triggering window type and source window reference, the source license agreement, and enforcement status (active, expired, waived, overridden). Holdbacks are enforced by the clearance workflow before any scheduling or distribution action is approved. Critical for MVPD carriage negotiations, OTT windowing compliance, and theatrical-to-home-video sequencing. Links to rights_content_window and license_agreement. | Unity Catalog table: media_broadcasting_ecm.rights.holdback Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore). Rightsline rights management integration supported.'
}

Table rights.rights_territory {
  rights_territory_id varchar [pk, note: 'Unique identifier for the geographic territory. Primary key. | Column rights_territory_id (BIGINT) in rights.rights_territory']
  audience_market_coverage_id varchar [note: 'FK added per VREQ']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.rights_territory']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.rights_territory']
  blackout_restricted_flag boolean [note: 'Indicates whether the territory is subject to geographic blackout restrictions for certain content (e.g., sports events, theatrical windows). True if blackouts apply, False otherwise. | Column blackout_restricted_flag (BOOLEAN) in rights.rights_territory']
  broadcast_standard varchar [note: 'Technical broadcast television standard used in the territory (e.g., ATSC for North America, DVB for Europe, ISDB for Japan). Determines encoding and transmission requirements for linear distribution. [ENUM-REF-CANDIDATE: atsc|dvb|isdb|dtmb|ntsc|pal|secam — 7 candidates stripped; promote to reference product] | Column broadcast_standard (STRING) in rights.rights_territory']
  content_rating_system varchar [note: 'Official content classification and rating system used in the territory (e.g., TV-MA/TV-PG for USA, BBFC for UK, FSK for Germany). Governs age-appropriate content labeling and parental controls. | Column content_rating_system (STRING) in rights.rights_territory']
  coppa_applicable_flag boolean [note: 'Indicates whether the territory is subject to COPPA regulations governing children\'s data privacy (USA). True if COPPA applies, False otherwise. Enforces parental consent for children\'s content and data collection. | Column coppa_applicable_flag (BOOLEAN) in rights.rights_territory']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.rights_territory']
  created_timestamp timestamp [note: 'Timestamp when the territory record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column created_timestamp (TIMESTAMP) in rights.rights_territory']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the territory (e.g., USD, GBP, EUR, JPY). Used for royalty calculations, license fee invoicing, and revenue reporting. | Column currency_code (STRING) in rights.rights_territory']
  effective_date date [note: 'Date when the territory record became active and available for rights grants and distribution agreements. Format: yyyy-MM-dd. | Column effective_date (DATE) in rights.rights_territory']
  expiration_date date [note: 'Date when the territory record expires or is no longer valid for new rights grants (nullable for indefinite territories). Format: yyyy-MM-dd. | Column expiration_date (DATE) in rights.rights_territory']
  gdpr_applicable_flag boolean [note: 'Indicates whether the territory is subject to GDPR data privacy regulations (EU member states and EEA). True if GDPR applies, False otherwise. Governs audience data collection and consent management. | Column gdpr_applicable_flag (BOOLEAN) in rights.rights_territory']
  holdback_eligible_flag boolean [note: 'Indicates whether the territory is eligible for holdback periods in windowing strategies (e.g., delaying SVOD release to protect theatrical revenue). True if holdbacks apply, False otherwise. | Column holdback_eligible_flag (BOOLEAN) in rights.rights_territory']
  internet_penetration_percent decimal(5,2) [note: 'Percentage of the population with internet access in the territory (e.g., 95.00 for USA, 60.00 for India). Used for OTT and streaming market opportunity assessment. | Column internet_penetration_percent (DECIMAL(5,2)) in rights.rights_territory']
  iso_alpha_2_code varchar [note: 'Two-letter ISO 3166-1 alpha-2 country code (e.g., US, GB, CA). Used for system integrations and data exchange with distribution platforms. | Column iso_alpha_2_code (STRING) in rights.rights_territory']
  iso_alpha_3_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code (e.g., USA, GBR, CAN). Provides additional clarity for territories with similar two-letter codes. | Column iso_alpha_3_code (STRING) in rights.rights_territory']
  iso_numeric_code varchar [note: 'Three-digit ISO 3166-1 numeric country code (e.g., 840 for USA, 826 for GBR). Language-independent identifier for international systems. | Column iso_numeric_code (STRING) in rights.rights_territory']
  language_primary varchar [note: 'ISO 639-1 or ISO 639-2 code for the primary language spoken in the territory (e.g., en for English, es for Spanish, fr for French). Used for metadata localization and subtitle requirements. | Column language_primary (STRING) in rights.rights_territory']
  language_secondary varchar [note: 'ISO 639-1 or ISO 639-2 code for a secondary or co-official language in the territory (e.g., fr for Canada, ca for Spain). Supports multi-language content delivery and compliance. | Column language_secondary (STRING) in rights.rights_territory']
  notes varchar [note: 'Free-text field for additional territory-specific information, special handling instructions, or regulatory nuances (e.g., \'Requires local dubbing for theatrical release\', \'Subject to military censorship\'). | Column notes (STRING) in rights.rights_territory']
  ott_market_maturity varchar [note: 'Classification of the territory\'s OTT streaming market maturity: mature (high penetration, competitive), developing (growing adoption), emerging (early stage), nascent (minimal infrastructure). Informs distribution strategy and rights pricing. | Column ott_market_maturity (STRING) in rights.rights_territory']
  population varchar [note: 'Total population of the territory. Used for audience reach estimation, market sizing, and rights valuation. | Column population (BIGINT) in rights.rights_territory']
  quota_percentage decimal(5,2) [note: 'Minimum percentage of local or regional content required by regulation in the territory (e.g., 30.00 for EU, 0.00 for territories without quotas). Used for compliance reporting and content acquisition planning. | Column quota_percentage (DECIMAL(5,2)) in rights.rights_territory']
  quota_requirement_flag boolean [note: 'Indicates whether the territory mandates local content quotas for broadcasters and streaming platforms (e.g., EU Audiovisual Media Services Directive requiring 30% European content). True if quotas apply, False otherwise. | Column quota_requirement_flag (BOOLEAN) in rights.rights_territory']
  regulatory_body varchar [note: 'Primary broadcast and media regulatory authority governing the territory (e.g., FCC for USA, Ofcom for UK, CRTC for Canada). Enforces content standards, licensing, and compliance requirements. | Column regulatory_body (STRING) in rights.rights_territory']
  rights_territory_status varchar [note: 'Current operational status of the territory in the rights management system: active (available for licensing), inactive (not currently used), restricted (subject to special clearance), pending (under review for activation). | Column rights_territory_status (STRING) in rights.rights_territory']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.rights_territory']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.rights_territory']
  territory_code varchar [note: 'ISO 3166-1 alpha-2 or alpha-3 country code representing the territory (e.g., US, USA, GB, GBR). Standardized identifier used in rights grants and distribution agreements. | Column territory_code (STRING) in rights.rights_territory']
  territory_group varchar [note: 'Regional grouping of the territory used for rights aggregation and windowing strategies (e.g., EMEA, LATAM, North America, Worldwide, APAC). Enables multi-territory licensing and holdback management. [ENUM-REF-CANDIDATE: worldwide|north_america|latin_america|emea|apac|europe|asia|africa|middle_east|oceania — 10 candidates stripped; promote to reference product] | Column territory_group (STRING) in rights.rights_territory']
  territory_name varchar [note: 'Full official name of the territory (e.g., United States, United Kingdom, Canada). Human-readable identifier used in contracts and reporting. | Column territory_name (STRING) in rights.rights_territory']
  territory_type varchar [note: 'Classification of the territory scope: country (single nation), region (multi-country group), worldwide (global rights), or custom (bespoke territory definition). | Column territory_type (STRING) in rights.rights_territory']
  time_zone varchar [note: 'IANA time zone identifier for the territory (e.g., America/New_York, Europe/London, Asia/Tokyo). Used for scheduling, playout, and live event coordination. | Column time_zone (STRING) in rights.rights_territory']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.rights_territory']
  updated_timestamp timestamp [note: 'Timestamp when the territory record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column updated_timestamp (TIMESTAMP) in rights.rights_territory']
  vat_applicable_flag boolean [note: 'Indicates whether Value-Added Tax (VAT) or Goods and Services Tax (GST) applies to transactions in the territory. True if VAT/GST applies, False otherwise. Used for royalty and subscription billing calculations. | Column vat_applicable_flag (BOOLEAN) in rights.rights_territory']
  vat_rate_percent decimal(5,2) [note: 'Standard VAT or GST rate percentage applicable in the territory (e.g., 20.00 for UK, 19.00 for Germany, 0.00 for territories without VAT). Used for financial reconciliation and revenue recognition. | Column vat_rate_percent (DECIMAL(5,2)) in rights.rights_territory']
  withholding_tax_rate_percent decimal(5,2) [note: 'Standard withholding tax rate percentage applied to royalty payments to rights holders in the territory (e.g., 30.00 for USA non-resident aliens, 0.00 for domestic). Used for talent residuals and royalty calculations. | Column withholding_tax_rate_percent (DECIMAL(5,2)) in rights.rights_territory']

  Note: 'Reference master for geographic territories and territory groups used in rights grants, holdbacks, and royalty calculations. Each record defines a territory by ISO country code, territory name, territory group (e.g., EMEA, LATAM, North America, Worldwide), broadcast regulatory body (FCC, Ofcom, etc.), currency, and whether the territory is subject to blackout restrictions. Provides the standardized territory taxonomy consumed by all rights, scheduling, and distribution products. SSOT for territory definitions in rights management. Sales.sales_territory should reference this. | Unity Catalog table: media_broadcasting_ecm.rights.rights_territory GDPR/CCPA privacy compliance applicable. Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics. Integrates with Rightsline (rights management).'
}

Table rights.royalty_rule {
  royalty_rule_id varchar [pk, note: 'Unique identifier for the royalty calculation rule. Primary key. | Column royalty_rule_id (BIGINT) in rights.royalty_rule']
  composition_id varchar [note: 'FK to composition for music royalty rules']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Royalty rules may apply to specific rights grants. Each rule may apply to one rights grant, defining how royalties are calculated for that grant. This FK enables tracing royalty rules back to the spec | Column grant_id (BIGINT) in rights.royalty_rule']
  license_agreement_id varchar [note: 'Reference to the parent license agreement or rights grant to which this royalty rule applies. Links this rule to the contract context in Rightsline. | Column license_agreement_id (BIGINT) in rights.royalty_rule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.royalty_rule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.royalty_rule']
  approval_status varchar [note: 'Approval status of the royalty rule within the rights management workflow (e.g., pending, approved, rejected). | Column approval_status (STRING) in rights.royalty_rule']
  approved_by varchar [note: 'Name or identifier of the person or role who approved this royalty rule. Nullable if not yet approved. | Column approved_by (STRING) in rights.royalty_rule']
  approved_date date [note: 'Date on which this royalty rule was approved. Nullable if not yet approved. | Column approved_date (DATE) in rights.royalty_rule']
  audit_rights_flag boolean [note: 'Indicates whether the rights holder has audit rights to verify royalty calculations under this rule. True if audit rights are granted, False otherwise. | Column audit_rights_flag (BOOLEAN) in rights.royalty_rule']
  calculation_basis varchar [note: 'The financial or usage metric upon which the royalty calculation is based (e.g., gross revenue, net revenue, subscriber count, stream count, GRP). [ENUM-REF-CANDIDATE: gross_revenue|net_revenue|subscriber_count|stream_count|grp|unit_sales|advertising_revenue — 7 candidates stripped; promote to reference product] | Column calculation_basis (STRING) in rights.royalty_rule']
  content_type varchar [note: 'The type of content to which this royalty rule applies (e.g., film, series, episode, music, documentary, sports, news, short-form). [ENUM-REF-CANDIDATE: film|series|episode|music|documentary|sports|news|short_form — 8 candidates stripped; promote to reference product] | Column content_type (STRING) in rights.royalty_rule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.royalty_rule']
  created_timestamp timestamp [note: 'Timestamp when this royalty rule record was first created in the system. | Column created_timestamp (TIMESTAMP) in rights.royalty_rule']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for monetary amounts in this royalty rule (e.g., USD, GBP, EUR). | Column currency_code (STRING) in rights.royalty_rule']
  deduction_allowed_flag boolean [note: 'Indicates whether deductions (e.g., distribution costs, marketing expenses) are allowed before calculating the royalty. True if deductions are permitted, False otherwise. | Column deduction_allowed_flag (BOOLEAN) in rights.royalty_rule']
  deduction_percentage decimal(5,2) [note: 'The percentage of revenue or basis that may be deducted before applying the royalty rate. Nullable if no deduction applies. | Column deduction_percentage (DECIMAL(5,2)) in rights.royalty_rule']
  effective_end_date date [note: 'The date on which this royalty rule ceases to be active. Nullable for open-ended rules. | Column effective_end_date (DATE) in rights.royalty_rule']
  effective_start_date date [note: 'The date from which this royalty rule becomes active and applicable to royalty calculations. | Column effective_start_date (DATE) in rights.royalty_rule']
  last_modified_timestamp timestamp [note: 'Timestamp when this royalty rule record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in rights.royalty_rule']
  maximum_cap_amount decimal(18,2) [note: 'The maximum royalty payment cap for this rule. Royalty calculations will not exceed this amount. Nullable if no cap applies. | Column maximum_cap_amount (DECIMAL(18,2)) in rights.royalty_rule']
  minimum_guarantee_amount decimal(18,2) [note: 'The minimum guaranteed royalty payment amount for this rule, regardless of calculated royalty. Nullable if no minimum guarantee applies. | Column minimum_guarantee_amount (DECIMAL(18,2)) in rights.royalty_rule']
  notes varchar [note: 'Free-text notes or comments about this royalty rule, including special conditions, exceptions, or clarifications. | Column notes (STRING) in rights.royalty_rule']
  payment_frequency varchar [note: 'The frequency at which royalty payments calculated by this rule are made (e.g., monthly, quarterly, semi-annually, annually, per event, on demand). | Column payment_frequency (STRING) in rights.royalty_rule']
  payment_timing varchar [note: 'The timing of royalty payments relative to the calculation period (e.g., advance, arrears, upon delivery, upon release, milestone-based). | Column payment_timing (STRING) in rights.royalty_rule']
  platform_type varchar [note: 'The distribution platform or exploitation type to which this royalty rule applies (e.g., SVOD, AVOD, TVOD, linear, theatrical, syndication). [ENUM-REF-CANDIDATE: svod|avod|tvod|linear|theatrical|syndication|vod|ott|fast — 9 candidates stripped; promote to reference product] | Column platform_type (STRING) in rights.royalty_rule']
  rate_unit varchar [note: 'The unit of measure for the rate value (e.g., percentage, per stream, per subscriber, per unit, per GRP, flat amount). | Column rate_unit (STRING) in rights.royalty_rule']
  rate_value decimal(18,6) [note: 'The numeric rate or percentage applied in the royalty calculation. For percentage-based royalties, this is the percentage (e.g., 15.5 for 15.5%). For per-unit rates, this is the amount per unit. | Column rate_value (DECIMAL(18,6)) in rights.royalty_rule']
  recoupment_flag boolean [note: 'Indicates whether this royalty rule includes recoupment provisions (e.g., advance payments must be recouped before additional royalties are paid). True if recoupment applies, False otherwise. | Column recoupment_flag (BOOLEAN) in rights.royalty_rule']
  recoupment_threshold decimal(18,2) [note: 'The monetary threshold that must be recouped before additional royalty payments are made. Nullable if no recoupment applies. | Column recoupment_threshold (DECIMAL(18,2)) in rights.royalty_rule']
  residual_formula varchar [note: 'The formula or calculation logic for residual payments to talent (actors, directors, writers) based on reuse, reruns, or secondary exploitation. Nullable if not applicable. | Column residual_formula (STRING) in rights.royalty_rule']
  royalty_rule_status varchar [note: 'Current lifecycle status of the royalty rule (e.g., draft, active, suspended, expired, terminated). | Column royalty_rule_status (STRING) in rights.royalty_rule']
  royalty_type varchar [note: 'The type of royalty calculation method applied by this rule. Determines how the royalty amount is computed. | Column royalty_type (STRING) in rights.royalty_rule']
  rule_code varchar [note: 'Business-assigned unique code or identifier for this royalty rule, used for reference in contracts and reporting. | Column rule_code (STRING) in rights.royalty_rule']
  rule_name varchar [note: 'Human-readable name or title of the royalty rule, describing its purpose or scope (e.g., \'SVOD Revenue Share - Tier 1\', \'Per-Stream Rate - Music Sync\'). | Column rule_name (STRING) in rights.royalty_rule']
  rule_priority varchar [note: 'The priority or precedence of this royalty rule when multiple rules may apply to the same content or transaction. Lower numbers indicate higher priority. | Column rule_priority (INT) in rights.royalty_rule']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.royalty_rule']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.royalty_rule']
  territory_scope varchar [note: 'Geographic territory or territories to which this royalty rule applies. May be a single country code, region, or comma-separated list of territories. | Column territory_scope (STRING) in rights.royalty_rule']
  threshold_unit varchar [note: 'The unit of measure for the threshold value (e.g., revenue, subscriber count, stream count, unit count, GRP). | Column threshold_unit (STRING) in rights.royalty_rule']
  threshold_value decimal(18,2) [note: 'The threshold value that triggers a rate tier change or special calculation logic (e.g., revenue threshold for tiered royalty rates). | Column threshold_value (DECIMAL(18,2)) in rights.royalty_rule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.royalty_rule']

  Note: 'Defines the royalty calculation rules and rate structures associated with a license agreement or rights grant. Captures royalty type (flat fee, revenue share percentage, per-stream rate, per-unit rate, residual formula), calculation basis (gross revenue, net revenue, subscriber count, stream count, GRP), applicable platform or exploitation type, rate tiers and thresholds, minimum guarantee amounts, and effective date range. Serves as the configuration engine for the royalty calculation process in Rightsline. Distinct from actual royalty payment transactions. | Unity Catalog table: media_broadcasting_ecm.rights.royalty_rule Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore).'
}

Table rights.royalty_statement {
  royalty_statement_id varchar [pk, note: 'Unique identifier for the royalty statement. Primary key. | Column royalty_statement_id (BIGINT) in rights.royalty_statement']
  accounts_payable_id varchar [note: 'Foreign key linking to finance.accounts_payable. Business justification: Royalty statements with net amounts due create accounts payable entries for payment to rights holders. Required for vendor payment processing, cash management, financial close, and reconciliation of r | Column accounts_payable_id (BIGINT) in finance.royalty_statement']
  holder_id varchar [note: 'Identifier of the rights holder (licensor, talent guild, music publisher, or syndication partner) to whom this statement is issued. Links to the party receiving royalty payments. | Column holder_id (BIGINT) in rights.royalty_statement']
  journal_entry_id varchar [note: 'Foreign key linking to finance.journal_entry. Business justification: Royalty statements trigger GL postings for royalty expense accrual, payment processing, and advance recoupment. Required for month-end close, royalty expense recognition, and financial audit trail lin | Column journal_entry_id (BIGINT) in finance.royalty_statement']
  license_agreement_id varchar [note: 'Identifier of the underlying rights agreement or contract that governs the royalty terms for this statement. | Column license_agreement_id (BIGINT) in rights.royalty_statement']
  prepared_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Royalty statements require tracking the royalty analyst who prepared the statement for quality control, dispute resolution, and workload management. When rights holders dispute calculations, business  | Column prepared_by_employee_id (BIGINT) in workforce.royalty_statement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.royalty_statement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.royalty_statement']
  adjustment_amount decimal(18,2) [note: 'Net adjustment amount applied to this statement for corrections, credits, or debits from prior periods. | Column adjustment_amount (DECIMAL(18,2)) in rights.royalty_statement']
  advance_recoupment_amount decimal(18,2) [note: 'Amount deducted from gross royalties to recoup advances previously paid to the rights holder under the agreement. | Column advance_recoupment_amount (DECIMAL(18,2)) in rights.royalty_statement']
  approved_by varchar [note: 'Name or identifier of the person or system that approved this royalty statement for payment. | Column approved_by (STRING) in rights.royalty_statement']
  approved_timestamp timestamp [note: 'Date and time when this royalty statement was approved for payment. | Column approved_timestamp (TIMESTAMP) in rights.royalty_statement']
  content_title_breakdown varchar [note: 'Structured breakdown of royalties by content title or asset. Stored as JSON or delimited string for detailed reporting. | Column content_title_breakdown (STRING) in rights.royalty_statement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.royalty_statement']
  created_timestamp timestamp [note: 'Date and time when this royalty statement record was first created in the system. | Column created_timestamp (TIMESTAMP) in rights.royalty_statement']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which royalty amounts are denominated. | Column currency_code (STRING) in rights.royalty_statement']
  dispute_date date [note: 'The date on which the rights holder formally disputed this royalty statement. | Column dispute_date (DATE) in rights.royalty_statement']
  dispute_reason varchar [note: 'Explanation or reason provided by the rights holder if the statement status is disputed. Captures objections to calculations, missing revenues, or contractual interpretation issues. | Column dispute_reason (STRING) in rights.royalty_statement']
  exchange_rate decimal(12,6) [note: 'Exchange rate applied to convert foreign currency revenues to the statement currency, if applicable. Rate is typically the average rate for the statement period. | Column exchange_rate (DECIMAL(12,6)) in rights.royalty_statement']
  exploitation_type_breakdown varchar [note: 'Structured breakdown of royalties by exploitation type (theatrical, SVOD, AVOD, TVOD, linear, syndication, home video, etc.). Stored as JSON or delimited string for detailed reporting. | Column exploitation_type_breakdown (STRING) in rights.royalty_statement']
  gross_royalty_amount decimal(18,2) [note: 'Total royalty amount earned by the rights holder before any deductions, recoupments, or adjustments. | Column gross_royalty_amount (DECIMAL(18,2)) in rights.royalty_statement']
  minimum_guarantee_shortfall decimal(18,2) [note: 'The difference between the contractual minimum guarantee and actual royalties earned for the period. A positive value indicates the rights holder is entitled to a minimum guarantee payment. | Column minimum_guarantee_shortfall (DECIMAL(18,2)) in rights.royalty_statement']
  modified_timestamp timestamp [note: 'Date and time when this royalty statement record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in rights.royalty_statement']
  net_royalty_amount decimal(18,2) [note: 'Final royalty amount payable to the rights holder after all deductions, recoupments, taxes, and adjustments. This is the amount that will be paid. | Column net_royalty_amount (DECIMAL(18,2)) in rights.royalty_statement']
  paid_timestamp timestamp [note: 'Date and time when payment for this royalty statement was successfully processed and remitted to the rights holder. | Column paid_timestamp (TIMESTAMP) in rights.royalty_statement']
  payment_method varchar [note: 'The payment instrument or method that will be used to remit the net royalty amount to the rights holder. | Column payment_method (STRING) in rights.royalty_statement']
  payment_reference_number varchar [note: 'Reference number or transaction identifier for the payment associated with this statement, once payment has been processed. | Column payment_reference_number (STRING) in rights.royalty_statement']
  resolution_date date [note: 'The date on which a disputed statement was resolved and moved to approved or paid status. | Column resolution_date (DATE) in rights.royalty_statement']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.royalty_statement']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.royalty_statement']
  statement_due_date date [note: 'The date by which payment of the royalties on this statement is contractually due to the rights holder. | Column statement_due_date (DATE) in rights.royalty_statement']
  statement_frequency varchar [note: 'The reporting frequency for this royalty statement as defined in the underlying rights agreement. | Column statement_frequency (STRING) in rights.royalty_statement']
  statement_issue_date date [note: 'The date on which this royalty statement was officially issued to the rights holder. | Column statement_issue_date (DATE) in rights.royalty_statement']
  statement_notes varchar [note: 'Free-text notes or comments related to this royalty statement, including explanations of unusual adjustments, special circumstances, or clarifications for the rights holder. | Column statement_notes (STRING) in rights.royalty_statement']
  statement_number varchar [note: 'Externally-known unique business identifier for this royalty statement, used for reference in correspondence and payment processing. | Column statement_number (STRING) in rights.royalty_statement']
  statement_period_end_date date [note: 'The last date of the reporting period covered by this royalty statement. | Column statement_period_end_date (DATE) in rights.royalty_statement']
  statement_period_start_date date [note: 'The first date of the reporting period covered by this royalty statement. | Column statement_period_start_date (DATE) in rights.royalty_statement']
  statement_status varchar [note: 'Current lifecycle status of the royalty statement. Draft statements are under review, approved statements are ready for payment, disputed statements have objections from rights holders, paid statements have been settled, and cancelled statements have been voided. | Column statement_status (STRING) in rights.royalty_statement']
  territory_breakdown varchar [note: 'Structured breakdown of royalties by geographic territory or market. Stored as JSON or delimited string for detailed reporting. | Column territory_breakdown (STRING) in rights.royalty_statement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.royalty_statement']
  withholding_tax_amount decimal(18,2) [note: 'Tax amount withheld from royalty payment as required by applicable tax treaties and regulations. | Column withholding_tax_amount (DECIMAL(18,2)) in rights.royalty_statement']

  Note: 'Periodic royalty statement generated for a rights holder (licensor, talent guild, music publisher, or syndication partner) covering a specific reporting period. Captures statement period (monthly, quarterly, semi-annual), total royalties due, breakdown by exploitation type and territory, advance recoupment amounts, minimum guarantee shortfall, currency, exchange rate applied, and statement status (draft, approved, disputed, paid). The SSOT for royalty obligations owed to external rights holders. Feeds the billing domain for payment processing. | Unity Catalog table: media_broadcasting_ecm.rights.royalty_statement Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore). Rightsline rights management integration supported.'
}

Table rights.royalty_statement_line {
  royalty_statement_line_id varchar [pk, note: 'Unique identifier for the royalty statement line item. Primary key for this entity. | Column royalty_statement_line_id (BIGINT) in rights.royalty_statement_line']
  composition_id varchar [note: 'FK to composition for music royalties']
  holder_id varchar [note: 'Reference to the party (talent, studio, licensor) entitled to receive the royalty payment for this line. Links to the rights holder master data. | Column holder_id (BIGINT) in rights.royalty_statement_line']
  license_agreement_id varchar [note: 'Reference to the underlying rights agreement or contract that governs this royalty calculation. Links to the master rights contract data. | Column license_agreement_id (BIGINT) in rights.royalty_statement_line']
  media_asset_id varchar [note: 'Reference to the specific content asset (program, episode, film, music track) that generated this royalty line. Links to the content master data. | Column media_asset_id (BIGINT) in mediaasset.royalty_statement_line']
  revenue_recognition_event_id varchar [note: 'Foreign key linking to finance.revenue_recognition_event. Business justification: Royalty statement lines represent content exploitation that triggers revenue recognition events when content is sublicensed. Required for ASC 606/IFRS 15 compliance for content licensing revenue and p | Column revenue_recognition_event_id (BIGINT) in finance.royalty_statement_line']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Royalty statement lines track exploitation by territory. Each line relates to one territory. Normalizing to territory reference eliminates redundant territory code storage and enables consistent terri | Column rights_territory_id (BIGINT) in rights.royalty_statement_line']
  royalty_rule_id varchar [note: 'Foreign key linking to rights.royalty_rule. Business justification: Statement lines are calculated using royalty rules. Each line uses one royalty rule that defines the calculation formula. This FK enables tracing royalty calculations back to the authoritative royalty | Column royalty_rule_id (BIGINT) in rights.royalty_statement_line']
  royalty_statement_id varchar [note: 'Reference to the parent royalty statement that contains this line item. Links this line to the header-level statement issued to a rights holder. | Column royalty_statement_id (BIGINT) in rights.royalty_statement_line']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.royalty_statement_line']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.royalty_statement_line']
  adjustments_amount decimal(18,2) [note: 'Additional adjustments applied to the royalty calculation, such as corrections from prior periods, contractual bonuses, penalties, or dispute resolutions. Can be positive or negative. | Column adjustments_amount (DECIMAL(18,2)) in rights.royalty_statement_line']
  advance_recoupment_amount decimal(18,2) [note: 'Portion of the calculated royalty that is applied against outstanding advances previously paid to the rights holder. Reduces the net payable amount. | Column advance_recoupment_amount (DECIMAL(18,2)) in rights.royalty_statement_line']
  audit_trail_reference varchar [note: 'Reference identifier linking this royalty line to source exploitation data, usage reports, or billing records. Enables granular audit trail and dispute resolution. | Column audit_trail_reference (STRING) in rights.royalty_statement_line']
  calculated_royalty_amount decimal(18,2) [note: 'Royalty amount calculated by applying the royalty rate to the net revenue. Represents the gross royalty obligation before advance recoupment or adjustments. | Column calculated_royalty_amount (DECIMAL(18,2)) in rights.royalty_statement_line']
  content_title varchar [note: 'Human-readable title of the content asset for which royalties are being calculated. Denormalized for reporting convenience. | Column content_title (STRING) in rights.royalty_statement_line']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.royalty_statement_line']
  created_timestamp timestamp [note: 'Timestamp when this royalty statement line record was first created in the system. Audit field for data lineage and compliance. | Column created_timestamp (TIMESTAMP) in rights.royalty_statement_line']
  currency_code varchar [note: 'Three-letter ISO currency code for all monetary amounts on this line. All amounts (gross revenue, deductions, royalties, payable) are denominated in this currency. | Column currency_code (STRING) in rights.royalty_statement_line']
  deductions_amount decimal(18,2) [note: 'Total deductions applied to gross revenue before calculating royalty base. May include distribution fees, marketing costs, platform fees, or other contractually allowed deductions. | Column deductions_amount (DECIMAL(18,2)) in rights.royalty_statement_line']
  dispute_status varchar [note: 'Current status of any dispute or query raised by the rights holder regarding this royalty line. Tracks the resolution workflow for contested royalty calculations. | Column dispute_status (STRING) in rights.royalty_statement_line']
  eidr_identifier varchar [note: 'Globally unique identifier for the content asset following EIDR standard format. Used for cross-industry content identification and rights tracking. | Column eidr_identifier (STRING) in rights.royalty_statement_line']
  exploitation_period_end_date date [note: 'End date of the period during which the exploitation activity occurred. Defines the end of the reporting window for this royalty line. | Column exploitation_period_end_date (DATE) in rights.royalty_statement_line']
  exploitation_period_start_date date [note: 'Start date of the period during which the exploitation activity occurred. Defines the beginning of the reporting window for this royalty line. | Column exploitation_period_start_date (DATE) in rights.royalty_statement_line']
  exploitation_type varchar [note: 'Type of content exploitation that generated this royalty. Indicates the distribution channel or business model under which the content was used. [ENUM-REF-CANDIDATE: linear_broadcast|svod|avod|tvod|theatrical|syndication|home_video|digital_download — 8 candidates stripped; promote to reference product] | Column exploitation_type (STRING) in rights.royalty_statement_line']
  gross_revenue_amount decimal(18,2) [note: 'Total gross revenue generated from the exploitation activity before any deductions, adjustments, or royalty calculations. Represents the top-line revenue attributable to this content asset. | Column gross_revenue_amount (DECIMAL(18,2)) in rights.royalty_statement_line']
  holdback_status varchar [note: 'Status of any holdback or exclusivity period applicable to this exploitation. Indicates whether the content was exploited within or outside of contractual holdback restrictions. | Column holdback_status (STRING) in rights.royalty_statement_line']
  isrc_code varchar [note: 'ISRC code for recording identification']
  iswc_code varchar [note: 'ISWC code for composition identification']
  line_number varchar [note: 'Sequential line number within the royalty statement, used for ordering and reference purposes. | Column line_number (INT) in rights.royalty_statement_line']
  net_payable_amount decimal(18,2) [note: 'Final net amount payable to the rights holder for this line item after all deductions, advance recoupment, and adjustments. This is the amount that will be paid out. | Column net_payable_amount (DECIMAL(18,2)) in rights.royalty_statement_line']
  net_revenue_amount decimal(18,2) [note: 'Net revenue after deductions, serving as the base for royalty calculation. Calculated as gross_revenue_amount minus deductions_amount. | Column net_revenue_amount (DECIMAL(18,2)) in rights.royalty_statement_line']
  notes varchar [note: 'Free-text notes or comments regarding this royalty line. May include explanations of adjustments, dispute details, or special calculation circumstances. | Column notes (STRING) in rights.royalty_statement_line']
  payment_date date [note: 'Date on which the royalty payment for this line was or will be disbursed to the rights holder. Null if payment has not yet been scheduled. | Column payment_date (DATE) in rights.royalty_statement_line']
  payment_status varchar [note: 'Current payment status for this royalty line item. Indicates whether the net payable amount has been processed for payment. | Column payment_status (STRING) in rights.royalty_statement_line']
  platform_name varchar [note: 'Name of the distribution platform or service where the content was exploited (e.g., Netflix, Hulu, linear network, theatrical chain). | Column platform_name (STRING) in rights.royalty_statement_line']
  residual_type varchar [note: 'Classification of residual payment type for talent royalties. Indicates the nature of the reuse payment under guild agreements (SAG-AFTRA, WGA, DGA). [ENUM-REF-CANDIDATE: initial_use|rerun|foreign|supplemental|new_media|streaming|not_applicable — 7 candidates stripped; promote to reference product] | Column residual_type (STRING) in rights.royalty_statement_line']
  rights_holder_name varchar [note: 'Name of the rights holder receiving the royalty. Denormalized for reporting and audit trail purposes. | Column rights_holder_name (STRING) in rights.royalty_statement_line']
  royalty_rate_percentage decimal(5,2) [note: 'Percentage rate applied to the royalty base to calculate the royalty amount. Derived from the underlying rights agreement and may vary by territory, platform, and exploitation type. | Column royalty_rate_percentage (DECIMAL(5,2)) in rights.royalty_statement_line']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.royalty_statement_line']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.royalty_statement_line']
  unit_of_measure varchar [note: 'Unit type for the units_exploited field. Clarifies how exploitation volume is measured for this line. | Column unit_of_measure (STRING) in rights.royalty_statement_line']
  units_exploited decimal(18,2) [note: 'Quantity of exploitation units for this line item. Interpretation depends on exploitation type: streams for SVOD/AVOD, broadcasts for linear, downloads for TVOD, tickets for theatrical. | Column units_exploited (DECIMAL(18,2)) in rights.royalty_statement_line']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.royalty_statement_line']
  updated_timestamp timestamp [note: 'Timestamp when this royalty statement line record was last modified. Audit field for tracking changes and dispute resolution history. | Column updated_timestamp (TIMESTAMP) in rights.royalty_statement_line']
  window_type varchar [note: 'Distribution window classification under which this exploitation occurred. Reflects the sequential release strategy and holdback periods defined in the rights agreement. [ENUM-REF-CANDIDATE: theatrical|home_video|pay_per_view|premium_cable|basic_cable|broadcast|svod|avod|free_streaming — 9 candidates stripped; promote to reference product] | Column window_type (STRING) in rights.royalty_statement_line']

  Note: 'Line-item detail within a royalty statement, representing a single exploitation event or aggregated exploitation activity for a specific content asset, territory, platform, and period. Captures content asset reference, exploitation type, territory, platform, units exploited (streams, broadcasts, downloads), gross revenue, applicable royalty rate, calculated royalty amount, advance applied, and net payable. Enables granular royalty audit trails and dispute resolution at the asset and territory level. | Unity Catalog table: media_broadcasting_ecm.rights.royalty_statement_line Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore). Rightsline rights management integration supported.'
}

Table rights.residual {
  residual_id varchar [pk, note: 'Unique identifier for the residual payment obligation record. Primary key. | Column residual_id (BIGINT) in rights.residual']
  contract_id varchar [note: 'Reference to the underlying rights contract or license agreement that governs this residual obligation. | Column contract_id (BIGINT) in talent.residual']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Residuals arise from specific rights grants. Each residual traces to one rights grant that authorized the exploitation triggering the residual. This FK enables tracing residual obligations back to the | Column grant_id (BIGINT) in rights.residual']
  journal_entry_id varchar [note: 'Foreign key linking to finance.journal_entry. Business justification: Residual payments trigger GL postings for expense recognition, liability accrual, and payment clearing. Required for payroll accounting, guild reporting, financial statement preparation, and audit tra | Column journal_entry_id (BIGINT) in finance.residual']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Residual obligations arise from license agreements. Each residual payment traces to one license agreement that defines the residual terms. This FK enables tracing residual obligations back to the sour | Column license_agreement_id (BIGINT) in rights.residual']
  media_asset_id varchar [note: 'Reference to the content asset (program, episode, film) whose exploitation triggered this residual payment. | Column media_asset_id (BIGINT) in mediaasset.residual']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Residuals are calculated by territory. Each residual relates to one territory. Normalizing to territory reference eliminates redundant territory code storage and enables consistent territory metadata  | Column rights_territory_id (BIGINT) in rights.residual']
  royalty_rule_id varchar [note: 'Foreign key linking to rights.royalty_rule. Business justification: Residuals are calculated using royalty rules. Each residual uses one royalty rule that defines the calculation formula. This FK enables tracing residual calculations back to the authoritative royalty  | Column royalty_rule_id (BIGINT) in rights.residual']
  talent_profile_id varchar [note: 'Reference to the talent (actor, writer, director, crew member) entitled to receive this residual payment. | Column talent_profile_id (BIGINT) in talent.residual']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.residual']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.residual']
  backend_revenue_source varchar [note: 'Source of backend revenue for participation calculation']
  calculated_residual_amount decimal(18,2) [note: 'The computed residual payment amount owed to the talent based on the formula type, calculation basis, and applicable rates. | Column calculated_residual_amount (DECIMAL(18,2)) in rights.residual']
  calculation_basis_amount decimal(18,2) [note: 'The base revenue or gross receipts amount used as the input to the residual formula calculation. | Column calculation_basis_amount (DECIMAL(18,2)) in rights.residual']
  calculation_basis_currency varchar [note: 'ISO 4217 three-letter currency code for the calculation basis amount (e.g., USD, GBP, CAD). | Column calculation_basis_currency (STRING) in rights.residual']
  calculation_date date [note: 'The date when the residual amount was calculated by the royalty system. | Column calculation_date (DATE) in rights.residual']
  contract_cycle varchar [note: 'The collective bargaining agreement cycle or contract period under which this residual is calculated (e.g., 2020-2023, 2023-2026). | Column contract_cycle (STRING) in rights.residual']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.residual']
  created_by_user varchar [note: 'The user identifier or system account that created this residual payment record. | Column created_by_user (STRING) in rights.residual']
  created_timestamp timestamp [note: 'The timestamp when this residual payment record was first created in the system. | Column created_timestamp (TIMESTAMP) in rights.residual']
  currency varchar [note: 'ISO 4217 three-letter currency code for the calculated residual amount (e.g., USD, GBP, CAD). | Column currency (STRING) in rights.residual']
  dispute_date date [note: 'The date when the residual payment was flagged as disputed. Nullable if never disputed. | Column dispute_date (DATE) in rights.residual']
  dispute_reason varchar [note: 'Description of the reason for payment dispute if status is DISPUTED (e.g., calculation error, missing exhibition data, contract interpretation disagreement). | Column dispute_reason (STRING) in rights.residual']
  exhibition_count varchar [note: 'The number of times the content was exhibited or broadcast during the residual calculation period, used for per-exhibition or tiered formulas. | Column exhibition_count (INT) in rights.residual']
  exploitation_end_date date [note: 'The date when the content exploitation period that triggered this residual ended. Nullable for ongoing exploitation. | Column exploitation_end_date (DATE) in rights.residual']
  exploitation_start_date date [note: 'The date when the content exploitation period that triggered this residual began (e.g., first streaming availability date, first rerun air date). | Column exploitation_start_date (DATE) in rights.residual']
  exploitation_type varchar [note: 'The type of content reuse or re-exploitation that triggered this residual payment obligation (rerun, streaming, foreign broadcast, home video, SVOD, AVOD, TVOD, syndication, theatrical re-release, clip licensing). [ENUM-REF-CANDIDATE: RERUN|STREAMING|FOREIGN_BROADCAST|HOME_VIDEO|SVOD|AVOD|TVOD|SYNDICATION|THEATRICAL_RERELEASE|CLIP_LICENSING — 10 candidates stripped; promote to reference product] | Column exploitation_type (STRING) in rights.residual']
  formula_type varchar [note: 'The calculation method used to determine the residual amount (fixed amount, percentage of gross receipts, percentage of distributor gross, tiered scale based on exhibition count, per-exhibition fee, minimum guarantee). | Column formula_type (STRING) in rights.residual']
  guild_report_submission_date date [note: 'The date when the residual payment was reported to the guild or union. Nullable if not yet reported. | Column guild_report_submission_date (DATE) in rights.residual']
  guild_report_submitted_flag boolean [note: 'Indicates whether this residual payment has been included in the mandatory guild reporting submission (True/False). | Column guild_report_submitted_flag (BOOLEAN) in rights.residual']
  guild_union_code varchar [note: 'The guild or union governing this residual obligation (SAG-AFTRA for actors, WGA for writers, DGA for directors, IATSE for crew, AFM for musicians, ACTRA for Canadian talent). [ENUM-REF-CANDIDATE: SAG-AFTRA|WGA|DGA|IATSE|AFM|ACTRA|OTHER — 7 candidates stripped; promote to reference product] | Column guild_union_code (STRING) in rights.residual']
  net_payment_amount decimal(18,2) [note: 'The net residual payment amount disbursed to the talent after withholding taxes and any other deductions. | Column net_payment_amount (DECIMAL(18,2)) in rights.residual']
  notes varchar [note: 'Free-text notes or comments regarding this residual payment, including special circumstances, calculation adjustments, or dispute details. | Column notes (STRING) in rights.residual']
  participation_linked_flag boolean [note: 'Indicates if residual is linked to a participation deal']
  payment_date date [note: 'The date when the residual payment was actually disbursed to the talent or guild. Nullable if not yet paid. | Column payment_date (DATE) in rights.residual']
  payment_due_date date [note: 'The date by which the residual payment must be made to the talent or guild, per the collective bargaining agreement payment schedule. | Column payment_due_date (DATE) in rights.residual']
  payment_method varchar [note: 'The method by which the residual payment is disbursed (direct deposit, check, wire transfer, guild trust fund, payroll integration). | Column payment_method (STRING) in rights.residual']
  payment_reference_number varchar [note: 'External payment system reference number or transaction identifier for the disbursed residual payment. | Column payment_reference_number (STRING) in rights.residual']
  payment_status varchar [note: 'Current status of the residual payment obligation (pending calculation approval, approved for payment, paid, disputed by talent or guild, withheld pending resolution, cancelled). | Column payment_status (STRING) in rights.residual']
  percentage decimal(5,4) [note: 'The percentage rate applied to the calculation basis when the formula type is percentage-based (e.g., 0.0350 for 3.5%). | Column percentage (DECIMAL(5,4)) in rights.residual']
  reporting_period varchar [note: 'The financial or royalty reporting period to which this residual obligation belongs (e.g., Q1-2024, 2024-H1), used for guild reporting and financial reconciliation. | Column reporting_period (STRING) in rights.residual']
  resolution_date date [note: 'The date when a disputed residual payment was resolved. Nullable if dispute is unresolved or no dispute occurred. | Column resolution_date (DATE) in rights.residual']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.residual']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.residual']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.residual']
  updated_by_user varchar [note: 'The user identifier or system account that last modified this residual payment record. | Column updated_by_user (STRING) in rights.residual']
  updated_timestamp timestamp [note: 'The timestamp when this residual payment record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in rights.residual']
  withholding_tax_amount decimal(18,2) [note: 'The amount of tax withheld from the residual payment per applicable tax regulations (federal, state, foreign withholding). | Column withholding_tax_amount (DECIMAL(18,2)) in rights.residual']

  Note: 'Tracks talent residual payment obligations arising from the reuse or re-exploitation of content under guild agreements (SAG-AFTRA, WGA, DGA, IATSE). Each record captures the guild or union, contract cycle, content asset, exploitation type triggering the residual (rerun, streaming, foreign broadcast, home video), residual formula type, calculated residual amount, payment due date, and payment status. Residuals are distinct from general royalties — they are talent-specific reuse payments governed by collective bargaining agreements. Feeds talent and billing domains. | Unity Catalog table: media_broadcasting_ecm.rights.residual Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore). Rightsline rights management integration supported.'
}

Table rights.music_sync_license {
  music_sync_license_id varchar [pk, note: 'Unique identifier for the music synchronization license record. Primary key. | Column music_sync_license_id (BIGINT) in rights.music_sync_license']
  accounts_payable_id varchar [note: 'Foreign key linking to finance.accounts_payable. Business justification: Music sync license fees create payables to music rights holders (composers, publishers, PROs). Required for music clearance cost tracking, payment processing, and reconciliation of music licensing obl | Column accounts_payable_id (BIGINT) in finance.music_sync_license']
  cleared_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Music clearance workflows require tracking which music clearance coordinator negotiated and approved each sync license for accountability, performance metrics, and routing follow-up issues. Standard p | Column cleared_by_employee_id (BIGINT) in workforce.music_sync_license']
  composition_id varchar [note: 'FK to composition for sync licensing']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Music sync licenses may derive from broader rights grants. Each sync license may reference one rights grant that authorized the music usage. This FK enables tracing sync licenses back to the authorita | Column grant_id (BIGINT) in rights.music_sync_license']
  license_agreement_id varchar [note: 'Reference to the master rights contract or agreement under which this music synchronization license is granted. | Column license_agreement_id (BIGINT) in rights.music_sync_license']
  master_recording_id varchar [note: 'FK to master recording for sync licensing']
  media_asset_id varchar [note: 'Reference to the content asset (program, episode, film, promo) in which the licensed music is synchronized and embedded. | Column media_asset_id (BIGINT) in mediaasset.music_sync_license']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Music sync licenses apply to specific territories. Each license covers one territory. Normalizing to territory reference eliminates redundant territory string storage and enables consistent territory  | Column rights_territory_id (BIGINT) in rights.music_sync_license']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Music sync licenses require talent approval when performers have contractual rights over music usage in their performances. Real business process: talent approval workflow for music clearances in cont | Column talent_profile_id (BIGINT) in talent.music_sync_license']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.music_sync_license']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.music_sync_license']
  clearance_approved_date date [note: 'Date when the music synchronization license was officially cleared and approved for use. Nullable if not yet approved. | Column clearance_approved_date (DATE) in rights.music_sync_license']
  clearance_notes varchar [note: 'Free-text notes documenting clearance workflow details, restrictions, special conditions, or communications with rights holders during the licensing process. | Column clearance_notes (STRING) in rights.music_sync_license']
  clearance_requested_date date [note: 'Date when the music synchronization license clearance was initially requested from the rights holder or clearance team. | Column clearance_requested_date (DATE) in rights.music_sync_license']
  clearance_status varchar [note: 'Current state of the music synchronization license clearance workflow indicating whether the license has been approved for use in content. | Column clearance_status (STRING) in rights.music_sync_license']
  composer_name varchar [note: 'Name of the composer or songwriter who created the musical composition. | Column composer_name (STRING) in rights.music_sync_license']
  composition_title varchar [note: 'The title of the musical composition or work being licensed for synchronization use. | Column composition_title (STRING) in rights.music_sync_license']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.music_sync_license']
  created_by_user varchar [note: 'Username or identifier of the user who created this music synchronization license record in the rights management system. | Column created_by_user (STRING) in rights.music_sync_license']
  created_timestamp timestamp [note: 'Timestamp when this music synchronization license record was first created in the rights management system. | Column created_timestamp (TIMESTAMP) in rights.music_sync_license']
  cue_sheet_required_flag boolean [note: 'Indicates whether a cue sheet (detailed music usage report) must be filed with performance rights organizations for this license, typically required for broadcast and public performance. | Column cue_sheet_required_flag (BOOLEAN) in rights.music_sync_license']
  duration_seconds varchar [note: 'Length of the music excerpt or cue being licensed, measured in seconds. Used for calculating royalties and determining fair use considerations. | Column duration_seconds (INT) in rights.music_sync_license']
  exclusivity_flag boolean [note: 'Indicates whether this synchronization license grants exclusive rights to use the music in the specified territory and platforms, preventing the rights holder from licensing the same music to competitors during the license period. | Column exclusivity_flag (BOOLEAN) in rights.music_sync_license']
  isrc_code varchar [note: 'International Standard Recording Code uniquely identifying the sound recording being licensed. Format: 2-letter country code + 3-character registrant code + 2-digit year + 5-digit designation. | Column isrc_code (STRING) in rights.music_sync_license']
  iswc_code varchar [note: 'International Standard Musical Work Code uniquely identifying the musical composition being licensed. Format: T-NNNNNNNNN-C where N is digit and C is check digit. | Column iswc_code (STRING) in rights.music_sync_license']
  license_end_date date [note: 'The date when the music synchronization license expires and the right to use the licensed music terminates. Nullable for perpetual licenses. | Column license_end_date (DATE) in rights.music_sync_license']
  license_fee_amount decimal(15,2) [note: 'One-time or upfront fee paid to the rights holder for the synchronization license. Does not include ongoing royalties. | Column license_fee_amount (DECIMAL(15,2)) in rights.music_sync_license']
  license_fee_currency varchar [note: 'Three-letter ISO currency code for the license fee amount (e.g., USD, GBP, EUR). | Column license_fee_currency (STRING) in rights.music_sync_license']
  license_number varchar [note: 'Externally-known unique identifier or reference number for this music synchronization license, typically assigned by the rights management system or licensing authority. | Column license_number (STRING) in rights.music_sync_license']
  license_start_date date [note: 'The date when the music synchronization license becomes effective and the licensed music may be used in the specified content. | Column license_start_date (DATE) in rights.music_sync_license']
  license_type varchar [note: 'Classification of the music synchronization license indicating the scope and nature of rights granted (master use for sound recording, synchronization for composition, blanket for multiple works, per-title for single work, mechanical for reproduction, performance for public performance). | Column license_type (STRING) in rights.music_sync_license']
  licensed_platforms varchar [note: 'Comma-separated list of distribution platforms and channels where the licensed music may be used (e.g., linear broadcast, SVOD, AVOD, TVOD, theatrical, home video, social media). | Column licensed_platforms (STRING) in rights.music_sync_license']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment to the rights holder regardless of actual usage or revenue. Nullable if no minimum guarantee applies. | Column minimum_guarantee_amount (DECIMAL(15,2)) in rights.music_sync_license']
  pro_affiliation varchar [note: 'Name of the Performance Rights Organization (e.g., ASCAP, BMI, SESAC, PRS, SOCAN) with which the composer or publisher is affiliated for performance royalty collection. | Column pro_affiliation (STRING) in rights.music_sync_license']
  restrictions varchar [note: 'Free-text description of any restrictions, limitations, or special conditions attached to this music synchronization license (e.g., no use in advertising, no use with controversial content, limited to specific episodes). | Column restrictions (STRING) in rights.music_sync_license']
  rights_holder_name varchar [note: 'Name of the entity (publisher, record label, production company) that owns or controls the rights to the musical work or sound recording. | Column rights_holder_name (STRING) in rights.music_sync_license']
  rights_holder_type varchar [note: 'Classification of the rights holder entity (publisher for composition rights, record label for master recording rights, PRO for performance rights organization, independent artist for self-owned rights, production company for commissioned works, collective for rights societies). | Column rights_holder_type (STRING) in rights.music_sync_license']
  royalty_basis varchar [note: 'The metric or revenue base upon which ongoing royalties are calculated (gross revenue, net revenue, per-stream count, per-download, per-unit sold, or flat fee with no ongoing royalties). | Column royalty_basis (STRING) in rights.music_sync_license']
  royalty_rate_percent decimal(5,2) [note: 'Percentage rate applied to revenue or usage metrics for calculating ongoing royalty payments to the rights holder. Nullable if license is flat-fee only. | Column royalty_rate_percent (DECIMAL(5,2)) in rights.music_sync_license']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.music_sync_license']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.music_sync_license']
  sublicense_permitted_flag boolean [note: 'Indicates whether the licensee is permitted to sublicense the music synchronization rights to third parties (e.g., for syndication or international distribution partners). | Column sublicense_permitted_flag (BOOLEAN) in rights.music_sync_license']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.music_sync_license']
  updated_by_user varchar [note: 'Username or identifier of the user who last updated this music synchronization license record. | Column updated_by_user (STRING) in rights.music_sync_license']
  updated_timestamp timestamp [note: 'Timestamp when this music synchronization license record was last modified or updated. | Column updated_timestamp (TIMESTAMP) in rights.music_sync_license']
  usage_type varchar [note: 'Classification of how the music is used within the content asset (background music, theme song, featured performance, promotional use, trailer, opening/closing credits). | Column usage_type (STRING) in rights.music_sync_license']

  Note: 'Master record for music synchronization licenses that authorize the use of a specific musical composition or sound recording within a content asset. Captures the music work (composition title, ISRC, ISWC), rights holder (publisher, label, PRO), sync license type (master use, synchronization, blanket, per-title), licensed territory, licensed platforms, license fee, royalty rate, license period, and clearance status. Music sync licenses are a distinct rights category from content licenses and are required for every piece of music embedded in a broadcast or streaming asset. | Unity Catalog table: media_broadcasting_ecm.rights.music_sync_license Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore). Rightsline rights management integration supported.'
}

Table rights.clearance_request {
  clearance_request_id varchar [pk, note: 'Unique identifier for the rights clearance request. Primary key for the clearance request workflow record. | Column clearance_request_id (BIGINT) in rights.clearance_request']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Clearance analysts must verify which broadcast facility will transmit content to assess technical compliance with license terms, geographic blackout rules, and transmission standards. Critical for pre | Column broadcast_facility_id (BIGINT) in technology.clearance_request']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Clearance workflow validates content rating before approving distribution. Analysts check that requested platform/daypart matches rating restrictions (e.g., TV-14 content not cleared for daytime child | Column compliance_content_rating_id (BIGINT) in compliance.clearance_request']
  conflict_id varchar [note: 'Foreign key linking to rights.rights_conflict. Business justification: Clearance requests may be blocked by detected conflicts. Each clearance request may reference one blocking conflict that prevents exploitation. This FK enables tracing clearance denials back to the sp | Column conflict_id (BIGINT) in rights.clearance_request']
  coppa_declaration_id varchar [note: 'Foreign key linking to compliance.coppa_declaration. Business justification: Clearance requests for children\'s content must verify COPPA declaration status before approval. Ensures data collection and advertising practices comply with COPPA before content goes live. | Column coppa_declaration_id (BIGINT) in compliance.clearance_request']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Clearance requests validate against specific rights grants to determine if exploitation is permitted. Each clearance request checks one rights grant for authorization. This FK enables validation of ex | Column grant_id (BIGINT) in rights.clearance_request']
  holdback_id varchar [note: 'Foreign key linking to rights.holdback. Business justification: Clearance requests may be blocked by specific holdbacks. Each clearance request may reference one blocking holdback that prevents exploitation. This FK enables tracing clearance denials back to the sp | Column holdback_id (BIGINT) in rights.clearance_request']
  license_agreement_id varchar [note: 'Reference to the primary licensing agreement that governs the requested exploitation. Links to the contract record in Rightsline that defines available windows, territories, and restrictions. | Column license_agreement_id (BIGINT) in rights.clearance_request']
  media_asset_id varchar [note: 'Reference to the content asset requiring clearance verification before broadcast, streaming, or distribution. Links to the digital asset managed in Dalet Galaxy MAM. | Column media_asset_id (BIGINT) in mediaasset.clearance_request']
  music_sync_license_id varchar [note: 'Foreign key linking to rights.music_sync_license. Business justification: Clearance requests may require music sync licenses. Each request may reference one music sync license that must be validated. This FK enables tracing clearance requirements back to the specific music  | Column music_sync_license_id (BIGINT) in rights.clearance_request']
  opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Clearance requests are triggered by sales opportunities requiring content availability verification before deal closure. Ad sales and content licensing workflows require rights clearance to confirm no | Column opportunity_id (BIGINT) in sales.clearance_request']
  primary_clearance_employee_id varchar [note: 'Identifier of the employee or system user who submitted the clearance request. Enables accountability and follow-up communication. | Column primary_clearance_employee_id (BIGINT) in workforce.clearance_request']
  rights_availability_window_id varchar [note: 'Reference to the specific rights window (theatrical, SVOD, AVOD, linear, etc.) being verified for availability. Links to windowing strategy definitions in Rightsline. | Column rights_availability_window_id (BIGINT) in rights.clearance_request']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Clearance requests are for specific territories. Each request relates to one territory. Normalizing to territory reference eliminates redundant territory code storage and enables consistent territory  | Column rights_territory_id (BIGINT) in rights.clearance_request']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.clearance_request']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.clearance_request']
  analyst_notes varchar [note: 'Free-text notes and observations recorded by the clearance analyst during review. May include references to specific contract clauses, communications with rights holders, or special handling instructions. | Column analyst_notes (STRING) in rights.clearance_request']
  blocking_category varchar [note: 'Classification of the primary reason for clearance denial. Enables reporting on common rights obstacles and process improvement. [ENUM-REF-CANDIDATE: holdback_period|territory_restriction|window_unavailable|rights_expired|music_sync_missing|talent_approval_required|residuals_unpaid|clearance_incomplete — promote to reference product] | Column blocking_category (STRING) in rights.clearance_request']
  blocking_reason varchar [note: 'Detailed explanation of why a clearance request was blocked or denied. May reference specific contract clauses, holdback periods, territorial restrictions, or missing rights. Null if request is cleared. | Column blocking_reason (STRING) in rights.clearance_request']
  clearance_decision varchar [note: 'Final determination made by the clearance analyst regarding whether the content may be exploited as requested. Approved with conditions may require specific usage restrictions or additional payments. | Column clearance_decision (STRING) in rights.clearance_request']
  clearance_status varchar [note: 'Current state of the clearance request workflow. Tracks progression from submission through review to final disposition. Cleared status allows content to proceed to playout; blocked status prevents distribution. [ENUM-REF-CANDIDATE: pending|in_review|cleared|conditionally_cleared|blocked|escalated|expired|cancelled — 8 candidates stripped; promote to reference product] | Column clearance_status (STRING) in rights.clearance_request']
  conditional_requirements varchar [note: 'Specific conditions or restrictions that must be met for conditional clearance approval. May include required credits, usage limitations, geographic blackouts, or additional royalty payments. | Column conditional_requirements (STRING) in rights.clearance_request']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.clearance_request']
  created_timestamp timestamp [note: 'System timestamp when the clearance request record was first created in the database. Part of standard audit trail for data lineage and compliance. | Column created_timestamp (TIMESTAMP) in rights.clearance_request']
  escalation_reason varchar [note: 'Explanation of why the clearance request required escalation beyond standard analyst review. May reference contract ambiguity, conflicting rights claims, or high-value strategic decisions. | Column escalation_reason (STRING) in rights.clearance_request']
  escalation_timestamp timestamp [note: 'Date and time when the clearance request was escalated to senior rights management or legal counsel due to complexity, ambiguity, or high business impact. Null if no escalation occurred. | Column escalation_timestamp (TIMESTAMP) in rights.clearance_request']
  estimated_audience_reach varchar [note: 'Projected number of unique viewers or households expected to access the content in the requested exploitation. Used for royalty calculations and rights holder reporting. | Column estimated_audience_reach (BIGINT) in rights.clearance_request']
  estimated_grp decimal(10,2) [note: 'Projected Gross Rating Point value for the scheduled broadcast or streaming event. GRP represents the sum of ratings achieved by the content and may trigger tiered royalty obligations. | Column estimated_grp (DECIMAL(10,2)) in rights.clearance_request']
  estimated_residuals_amount decimal(15,2) [note: 'Projected total residual payments owed to talent if the clearance is approved and content is distributed. Used for financial planning and budget approval workflows. | Column estimated_residuals_amount (DECIMAL(15,2)) in rights.clearance_request']
  exploitation_type varchar [note: 'The intended method of content distribution or monetization requiring clearance. Defines the rights window and licensing requirements that must be verified (e.g., SVOD - Subscription Video On Demand, AVOD - Advertising-Supported Video On Demand, TVOD - Transactional Video On Demand). [ENUM-REF-CANDIDATE: linear_broadcast|svod|avod|tvod|theatrical|syndication|vod|simulcast|fast|digital_download — 10 candidates stripped; promote to reference product] | Column exploitation_type (STRING) in rights.clearance_request']
  integration_status varchar [note: 'Status of data synchronization between Rightsline clearance system and downstream scheduling and playout systems (Ericsson MediaFirst). Ensures cleared content is automatically released to scheduling workflows. | Column integration_status (STRING) in rights.clearance_request']
  last_modified_timestamp timestamp [note: 'System timestamp of the most recent update to any field in the clearance request record. Enables change tracking and audit trail for compliance and operational monitoring. | Column last_modified_timestamp (TIMESTAMP) in rights.clearance_request']
  music_clearance_required boolean [note: 'Indicates whether separate music synchronization licenses must be verified before content can be cleared for distribution. True if content contains licensed music requiring additional clearance. | Column music_clearance_required (BOOLEAN) in rights.clearance_request']
  platform_channel varchar [note: 'Specific platform, channel, or outlet where the content is intended to be distributed (e.g., HBO Max, NBC Network, YouTube, Hulu). Used to verify platform-specific licensing restrictions. | Column platform_channel (STRING) in rights.clearance_request']
  priority_level varchar [note: 'Business priority assigned to the clearance request based on scheduling urgency, revenue impact, or strategic importance. Urgent requests require expedited review to avoid schedule disruption. | Column priority_level (STRING) in rights.clearance_request']
  request_number varchar [note: 'Human-readable business identifier for the clearance request, typically formatted as CLR-YYYYMMDD sequence for tracking and reference in scheduling and distribution workflows. | Column request_number (STRING) in rights.clearance_request']
  request_submitted_timestamp timestamp [note: 'Date and time when the clearance request was initially submitted into the workflow system. Marks the start of the clearance review lifecycle and SLA clock. | Column request_submitted_timestamp (TIMESTAMP) in rights.clearance_request']
  requested_air_date date [note: 'The target date when the content is scheduled to be broadcast, streamed, or published. Critical for verifying that rights are available within the requested window and that no holdback periods are violated. | Column requested_air_date (DATE) in rights.clearance_request']
  requested_air_time timestamp [note: 'Precise timestamp for the intended broadcast or streaming start time, including time zone. Used for daypart-specific rights verification and scheduling coordination. | Column requested_air_time (TIMESTAMP) in rights.clearance_request']
  requesting_department varchar [note: 'Business unit or department initiating the clearance request. Identifies which operational area needs rights verification before proceeding with content exploitation. | Column requesting_department (STRING) in rights.clearance_request']
  residuals_triggered boolean [note: 'Indicates whether the requested exploitation will trigger residual payments to talent per guild agreements. True if reuse payments are required for this distribution window. | Column residuals_triggered (BOOLEAN) in rights.clearance_request']
  resolution_timestamp timestamp [note: 'Date and time when the clearance request was finalized with a cleared, blocked, or conditionally cleared decision. Marks the end of the clearance workflow and enables SLA compliance measurement. | Column resolution_timestamp (TIMESTAMP) in rights.clearance_request']
  review_started_timestamp timestamp [note: 'Date and time when a clearance analyst began active review of the request. Used to measure queue time and analyst response performance. | Column review_started_timestamp (TIMESTAMP) in rights.clearance_request']
  sla_met boolean [note: 'Indicates whether the clearance request was resolved within the defined SLA target hours. Used for operational performance reporting and process improvement. | Column sla_met (BOOLEAN) in rights.clearance_request']
  sla_target_hours varchar [note: 'Number of business hours within which the clearance request must be resolved per service level agreement. Varies by priority level (urgent requests have shorter SLA targets). | Column sla_target_hours (INT) in rights.clearance_request']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.clearance_request']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.clearance_request']
  talent_approval_required boolean [note: 'Indicates whether talent (actors, directors, producers) approval or notification is contractually required before the requested exploitation. True if talent has approval rights per guild agreements or individual contracts. | Column talent_approval_required (BOOLEAN) in rights.clearance_request']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.clearance_request']

  Note: 'Workflow record capturing a rights clearance request initiated before a content asset is scheduled for broadcast, streaming, or distribution. Tracks the requesting department (scheduling, distribution, production), content asset, intended exploitation type and platform, requested air or publish date, territory, clearance status (pending, cleared, conditionally cleared, blocked, escalated), blocking reason if applicable, assigned clearance analyst, and resolution date. Enforces the clearance gate that prevents unlicensed content from reaching playout or distribution systems. Integrates with Ericsson MediaFirst scheduling and Rightsline availabilities. | Unity Catalog table: media_broadcasting_ecm.rights.clearance_request COPPA child-directed content compliance applicable. Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics.'
}

Table rights.rights_availability_window {
  rights_availability_window_id varchar [pk, note: 'Unique identifier for the computed rights availability window record. Primary key. | Column rights_availability_window_id (BIGINT) in rights.rights_availability_window']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Availability windows must comply with accessibility obligations (captioning, audio description, video description) per platform and content type. Links distribution windows to the specific accessibili | Column accessibility_obligation_id (BIGINT) in compliance.rights_availability_window']
  grant_id varchar [note: 'Reference to the source rights grant record from which this availability window is derived. Links to the upstream rights grant agreement. | Column grant_id (BIGINT) in rights.rights_availability_window']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Availability windows derive from license agreements. Each computed availability window traces back to one license agreement that defines the underlying rights. This FK enables tracing availability bac | Column license_agreement_id (BIGINT) in rights.rights_availability_window']
  media_asset_id varchar [note: 'Reference to the content asset for which this availability window is computed. Links to the content master record. | Column media_asset_id (BIGINT) in mediaasset.rights_availability_window']
  partner_content_window_id varchar [note: 'Reference to the content window record (theatrical, SVOD, AVOD, TVOD, linear) that defines the release strategy for this availability period. | Column partner_content_window_id (BIGINT) in partner.rights_availability_window']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Availability windows apply to specific territories. Each window covers one territory. Normalizing to territory reference eliminates redundant territory code storage and enables consistent territory me | Column rights_territory_id (BIGINT) in rights.rights_availability_window']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.rights_availability_window']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.rights_availability_window']
  advertising_allowed boolean [note: 'Indicates whether advertising insertion (pre-roll, mid-roll, post-roll) is permitted during content playback for this availability window. True = ads allowed, False = ad-free distribution only. | Column advertising_allowed (BOOLEAN) in rights.rights_availability_window']
  availability_end_date date [note: 'The date when the content asset is no longer available for exploitation on the specified platform and territory. Represents the end of the net exploitable window. Nullable for perpetual rights. | Column availability_end_date (DATE) in rights.rights_availability_window']
  availability_start_date date [note: 'The date when the content asset becomes available for exploitation on the specified platform and territory. Represents the beginning of the net exploitable window. | Column availability_start_date (DATE) in rights.rights_availability_window']
  blackout_indicator boolean [note: 'Indicates whether a geographic broadcast restriction (blackout) applies to this availability window. True = blackout in effect, False = no blackout restriction. | Column blackout_indicator (BOOLEAN) in rights.rights_availability_window']
  carriage_fee_applicable boolean [note: 'Indicates whether a carriage fee (distribution payment to the content provider) applies to this availability window. True = carriage fee required, False = no carriage fee. | Column carriage_fee_applicable (BOOLEAN) in rights.rights_availability_window']
  clearance_status varchar [note: 'Rights verification status indicating whether all necessary clearances (music synchronization, talent, third-party IP) have been obtained for broadcast. Cleared = all rights verified, Pending = clearance in progress, Blocked = clearance denied, Conditional = clearance with restrictions. | Column clearance_status (STRING) in rights.rights_availability_window']
  computed_timestamp timestamp [note: 'The timestamp when this availability window record was computed from the intersection of upstream rights grants, holdbacks, and content windows. Represents the calculation execution time. | Column computed_timestamp (TIMESTAMP) in rights.rights_availability_window']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.rights_availability_window']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for financial amounts associated with this availability window (royalties, minimum guarantees). Defines the monetary unit for rights payments. | Column currency_code (STRING) in rights.rights_availability_window']
  dai_enabled boolean [note: 'Indicates whether Dynamic Ad Insertion technology is enabled for this availability window, allowing server-side ad stitching into the content stream. True = DAI enabled, False = DAI not permitted. | Column dai_enabled (BOOLEAN) in rights.rights_availability_window']
  download_to_own_allowed boolean [note: 'Indicates whether permanent download (download-to-own, DTO) is permitted during this availability window. True = DTO allowed, False = streaming-only distribution. | Column download_to_own_allowed (BOOLEAN) in rights.rights_availability_window']
  drm_requirement varchar [note: 'The level of Digital Rights Management protection required for this availability window. None = no DRM, Basic = minimal protection, Standard = industry-standard encryption, Premium = highest security level. | Column drm_requirement (STRING) in rights.rights_availability_window']
  effective_timestamp timestamp [note: 'The timestamp when this availability window record became effective and actionable for scheduling and distribution systems. May differ from computed_timestamp if there is a delay before activation. | Column effective_timestamp (TIMESTAMP) in rights.rights_availability_window']
  exclusivity_flag boolean [note: 'Indicates whether this availability window grants exclusive distribution rights on the specified platform and territory. True = exclusive rights, False = non-exclusive rights. | Column exclusivity_flag (BOOLEAN) in rights.rights_availability_window']
  expiration_notification_sent boolean [note: 'Indicates whether an expiration notification has been sent to scheduling and distribution systems alerting them that this availability window is approaching its end date. True = notification sent, False = not yet notified. | Column expiration_notification_sent (BOOLEAN) in rights.rights_availability_window']
  holdback_period_days varchar [note: 'The number of days representing the holdback exclusivity period during which the content cannot be exploited on other platforms. Used to enforce windowing strategies. | Column holdback_period_days (INT) in rights.rights_availability_window']
  language_code varchar [note: 'Two-letter ISO 639-1 language code representing the primary language for which this availability window is licensed. Defines the audio/subtitle language requirement. | Column language_code (STRING) in rights.rights_availability_window']
  last_verified_timestamp timestamp [note: 'The timestamp when this availability window was last verified against upstream rights and clearance records. Used for audit and compliance tracking. | Column last_verified_timestamp (TIMESTAMP) in rights.rights_availability_window']
  max_resolution varchar [note: 'The maximum video resolution permitted for distribution during this availability window. SD = Standard Definition (480p), HD = High Definition (720p), FHD = Full HD (1080p), UHD = Ultra HD (2160p), 4K = 4K resolution, 8K = 8K resolution. | Column max_resolution (STRING) in rights.rights_availability_window']
  minimum_guarantee_amount decimal(15,2) [note: 'The minimum guaranteed payment amount owed to the rights holder for this availability window, regardless of actual revenue performance. Expressed in the contract currency. | Column minimum_guarantee_amount (DECIMAL(15,2)) in rights.rights_availability_window']
  notes varchar [note: 'Free-text field for additional notes, exceptions, or special conditions related to this availability window. Used for documenting non-standard terms or manual overrides. | Column notes (STRING) in rights.rights_availability_window']
  offline_viewing_allowed boolean [note: 'Indicates whether temporary offline viewing (download for offline playback with expiration) is permitted during this availability window. True = offline viewing allowed, False = online streaming only. | Column offline_viewing_allowed (BOOLEAN) in rights.rights_availability_window']
  platform_type varchar [note: 'The distribution platform type for which this availability window applies. SVOD = Subscription Video On Demand, AVOD = Advertising-Supported Video On Demand, TVOD = Transactional Video On Demand, linear = traditional scheduled broadcasting, FAST = Free Ad-Supported Streaming Television, MVPD = Multichannel Video Programming Distributor. | Column platform_type (STRING) in rights.rights_availability_window']
  royalty_rate_percent decimal(5,2) [note: 'The percentage royalty rate applicable to revenue generated during this availability window. Used for royalty calculations and residuals payments to rights holders and talent. | Column royalty_rate_percent (DECIMAL(5,2)) in rights.rights_availability_window']
  simulcast_allowed boolean [note: 'Indicates whether simultaneous multi-platform broadcast (simulcast) is permitted during this availability window. True = simulcast allowed, False = platform-exclusive distribution only. | Column simulcast_allowed (BOOLEAN) in rights.rights_availability_window']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.rights_availability_window']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.rights_availability_window']
  streaming_protocol varchar [note: 'The technical streaming protocol authorized for content delivery during this availability window. HLS = HTTP Live Streaming, MPEG-DASH = Dynamic Adaptive Streaming over HTTP, RTMP = Real-Time Messaging Protocol, smooth = Microsoft Smooth Streaming, progressive = progressive download. | Column streaming_protocol (STRING) in rights.rights_availability_window']
  subtitle_requirement varchar [note: 'Indicates the subtitle or closed captioning requirement for this availability window. None = no subtitles required, Optional = subtitles available but not mandatory, Mandatory = subtitles must be provided, Closed_caption = closed captioning required for accessibility compliance. | Column subtitle_requirement (STRING) in rights.rights_availability_window']
  syndication_allowed boolean [note: 'Indicates whether the content can be syndicated (resold to multiple outlets) during this availability window. True = syndication permitted, False = syndication prohibited. | Column syndication_allowed (BOOLEAN) in rights.rights_availability_window']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.rights_availability_window']
  window_status varchar [note: 'Current lifecycle status of the availability window. Active = currently exploitable, Pending = future window not yet started, Expired = window has ended, Suspended = temporarily unavailable, Revoked = rights withdrawn, Extended = window duration increased. | Column window_status (STRING) in rights.rights_availability_window']

  Note: 'Computed availability record representing the net exploitable window for a content asset on a specific platform and territory, derived from the intersection of rights grants, holdbacks, and content windows. Captures asset reference, platform type (SVOD, AVOD, TVOD, linear, FAST, MVPD), territory, availability start and end dates, exclusivity flag, blackout indicator, and the source rights grant and window records. This is the actionable availability feed consumed by scheduling and distribution domains to determine what can be programmed or published. Refreshed whenever upstream rights or window records change. | Unity Catalog table: media_broadcasting_ecm.rights.rights_availability_window Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore). Rightsline rights management integration supported.'
}

Table rights.conflict {
  conflict_id varchar [pk, note: 'Unique identifier for the rights conflict record. Primary key. | Column conflict_id (BIGINT) in rights.conflict']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: Rights conflicts (overlapping grants, blackout violations, unauthorized distribution) escalate to compliance incidents when they breach regulatory obligations or trigger FCC complaints. Links rights v | Column compliance_incident_id (BIGINT) in compliance.conflict']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Conflicts arise from overlapping license agreements. Each conflict relates to one primary license agreement that is the source of the conflict. This FK enables tracing conflicts back to the source agr | Column license_agreement_id (BIGINT) in rights.conflict']
  media_asset_id varchar [note: 'Reference to the content asset (film, series, episode) that is subject to the conflicting rights. | Column media_asset_id (BIGINT) in mediaasset.conflict']
  primary_conflict_employee_id varchar [note: 'Reference to the rights analyst or user responsible for reviewing and resolving this conflict. | Column conflict_employee_id (BIGINT) in workforce.conflict']
  primary_rights_grant_id varchar [note: 'Reference to the first rights grant involved in the conflict. | Column primary_rights_grant_id (BIGINT) in rights.conflict']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Conflicts occur in specific territories. Each conflict relates to one territory. Normalizing to territory reference eliminates redundant territory code storage and enables consistent territory metadat | Column rights_territory_id (BIGINT) in rights.conflict']
  tertiary_conflict_resolved_by_analyst_employee_id varchar [note: 'Reference to the rights analyst or user who ultimately resolved or closed the conflict. Null if conflict remains open. | Column conflict_resolved_by_analyst_employee_id (BIGINT) in workforce.conflict']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.conflict']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.conflict']
  affected_distribution_partners varchar [note: 'Comma-separated list of distribution partner names or identifiers affected by this conflict (e.g., streaming platforms, broadcasters, MVPD partners). | Column affected_distribution_partners (STRING) in rights.conflict']
  audit_trail_reference varchar [note: 'Reference identifier linking to detailed audit trail records for all actions taken on this conflict, supporting compliance and legal review requirements. | Column audit_trail_reference (STRING) in rights.conflict']
  business_priority varchar [note: 'Business priority classification for resolving the conflict: critical (blocks major release or high-value content), high (impacts significant revenue or strategic content), medium (standard business impact), or low (minimal business impact). | Column business_priority (STRING) in rights.conflict']
  conflict_type varchar [note: 'Classification of the type of rights conflict detected: territorial overlap (same territory granted to multiple parties), platform overlap (same platform rights conflict), holdback violation (content released during holdback period), window gap (gap between sequential windows), exclusivity breach (non-exclusive grant conflicts with exclusive grant), or duration overlap (time period overlap). | Column conflict_type (STRING) in rights.conflict']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.conflict']
  created_timestamp timestamp [note: 'The date and time when this conflict record was first created in the system. | Column created_timestamp (TIMESTAMP) in rights.conflict']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the financial impact amount (e.g., USD, GBP, EUR). | Column currency_code (STRING) in rights.conflict']
  detected_timestamp timestamp [note: 'The precise date and time when the rights conflict was first detected by the system or identified by a rights analyst. | Column detected_timestamp (TIMESTAMP) in rights.conflict']
  detection_method varchar [note: 'The method by which the conflict was identified: automated system scan (scheduled batch validation), manual review (analyst-identified), contract ingestion (detected during contract entry), scheduling validation (found during program scheduling), distribution check (identified during content delivery preparation), or clearance workflow (discovered during rights clearance process). | Column detection_method (STRING) in rights.conflict']
  end_date date [note: 'The date when the rights conflict period ends, representing the last point of overlap between the conflicting grants. Null if conflict is ongoing or indefinite. | Column end_date (DATE) in rights.conflict']
  financial_impact_amount decimal(15,2) [note: 'Estimated or actual financial impact of the conflict in USD, including potential revenue loss, penalty costs, or settlement amounts. Negative values represent costs; positive values represent avoided losses. | Column financial_impact_amount (DECIMAL(15,2)) in rights.conflict']
  last_modified_timestamp timestamp [note: 'The date and time when this conflict record was most recently updated. | Column last_modified_timestamp (TIMESTAMP) in rights.conflict']
  legal_opinion_summary varchar [note: 'Summary of the legal department\'s assessment and recommendations regarding the conflict. Contains privileged attorney-client communication. | Column legal_opinion_summary (STRING) in rights.conflict']
  legal_review_date date [note: 'The date when legal department completed their review of the conflict. Null if no legal review was performed. | Column legal_review_date (DATE) in rights.conflict']
  legal_review_required_flag boolean [note: 'Indicates whether the conflict requires legal department review before resolution. True if legal review is mandatory, False otherwise. | Column legal_review_required_flag (BOOLEAN) in rights.conflict']
  notification_sent_flag boolean [note: 'Indicates whether stakeholder notifications have been sent regarding this conflict. True if notifications were dispatched, False otherwise. | Column notification_sent_flag (BOOLEAN) in rights.conflict']
  notification_sent_timestamp timestamp [note: 'The date and time when stakeholder notifications were sent. Null if no notifications have been sent. | Column notification_sent_timestamp (TIMESTAMP) in rights.conflict']
  platform_type varchar [note: 'The distribution platform type where the conflict occurs: linear broadcast (traditional scheduled TV), SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), theatrical (cinema release), home video (physical media), syndication (content resale), FAST (Free Ad-Supported Streaming Television), or VOD (Video On Demand generic). [ENUM-REF-CANDIDATE: linear_broadcast|svod|avod|tvod|theatrical|home_video|syndication|fast|vod — 9 candidates stripped; promote to reference product] | Column platform_type (STRING) in rights.conflict']
  reference_number varchar [note: 'Business-facing unique reference number for the conflict, used in communications and reporting. Format: RC-YYYYMMDD-XXXXXX. | Column reference_number (STRING) in rights.conflict']
  resolution_date date [note: 'The date when the conflict was officially resolved, waived, or closed. Null if conflict remains open. | Column resolution_date (DATE) in rights.conflict']
  resolution_method varchar [note: 'The approach used to resolve the conflict: contract amendment (modify existing agreement terms), rights buyback (purchase back conflicting rights), window adjustment (change release timing), territory restriction (limit geographic availability), platform exclusion (remove platform from grant), holdback extension (extend exclusivity period), or negotiated settlement (mutual agreement between parties). [ENUM-REF-CANDIDATE: contract_amendment|rights_buyback|window_adjustment|territory_restriction|platform_exclusion|holdback_extension|negotiated_settlement — 7 candidates stripped; promote to reference product] | Column resolution_method (STRING) in rights.conflict']
  resolution_notes varchar [note: 'Detailed narrative explanation of how the conflict was resolved, including business rationale, stakeholder decisions, and any special conditions or agreements reached. May contain sensitive business information. | Column resolution_notes (STRING) in rights.conflict']
  resolution_status varchar [note: 'Current status of the conflict resolution workflow: open (newly detected, not yet reviewed), under review (being analyzed by rights team), pending legal (requires legal department review), resolved (conflict has been addressed and closed), waived (conflict acknowledged but approved for business reasons), or escalated (elevated to senior management for decision). | Column resolution_status (STRING) in rights.conflict']
  severity varchar [note: 'Severity classification of the conflict: blocking (prevents content distribution, must be resolved before release), warning (potential issue requiring review but not blocking), or informational (noted for awareness, no immediate action required). | Column severity (STRING) in rights.conflict']
  sla_resolution_deadline timestamp [note: 'The target date and time by which the conflict must be resolved according to internal service level agreements, based on business priority and content release schedules. | Column sla_resolution_deadline (TIMESTAMP) in rights.conflict']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.conflict']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.conflict']
  start_date date [note: 'The date when the rights conflict period begins, representing the earliest point of overlap between the conflicting grants. | Column start_date (DATE) in rights.conflict']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.conflict']
  window_type varchar [note: 'The content distribution window type involved in the conflict, representing the sequential release strategy phase. [ENUM-REF-CANDIDATE: theatrical|home_entertainment|pay_per_view|premium_svod|basic_cable|broadcast|syndication|free_streaming — 8 candidates stripped; promote to reference product] | Column window_type (STRING) in rights.conflict']

  Note: 'Records detected conflicts between overlapping rights grants, holdbacks, or content windows for the same content asset, territory, and platform. Captures conflict type (territorial overlap, platform overlap, holdback violation, window gap, exclusivity breach), the two conflicting rights records, detection timestamp, conflict severity (blocking, warning), resolution status (open, resolved, waived), resolution notes, and the analyst who resolved it. Supports the rights conflict resolution workflow and provides an audit trail for compliance and legal review. | Unity Catalog table: media_broadcasting_ecm.rights.conflict Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics. Integrates with Rightsline (rights management).'
}

Table rights.license_amendment {
  license_amendment_id varchar [pk, note: 'Unique identifier for the license amendment record. Primary key. | Column license_amendment_id (BIGINT) in rights.license_amendment']
  created_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Amendments require structured employee tracking (beyond generic created_by_user string) for approval workflows, audit trails, and legal accountability. Business affairs teams need to track who initiat | Column created_by_employee_id (BIGINT) in workforce.license_amendment']
  license_agreement_id varchar [note: 'Reference to the parent license agreement being amended. Links to the original executed agreement in the rights management system. | Column license_agreement_id (BIGINT) in rights.license_amendment']
  license_partner_id varchar [note: 'Reference to the rights holder or content owner party executing this amendment. Typically the same as the original agreement but may change in assignment scenarios. | Column partner_id (BIGINT) in partner.license_amendment']
  licensor_rights_holder_id varchar [note: 'Foreign key linking to rights.rights_holder. Business justification: Amendments track licensor party changes. Each amendment relates to one licensor rights holder. This FK enables tracing amendment parties back to the authoritative rights holder record. Using licensor_ | Column licensor_rights_holder_id (BIGINT) in rights.license_amendment']
  primary_licensee_party_partner_id varchar [note: 'Reference to the content distributor or broadcaster party executing this amendment. Represents the organization acquiring or modifying rights. | Column licensee_party_partner_id (BIGINT) in partner.license_amendment']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Material amendments (ownership changes, territory expansions, fee restructures) require FCC disclosure filings. Tracks which amendments triggered regulatory notification or public inspection file upda | Column regulatory_filing_id (BIGINT) in compliance.license_amendment']
  superseded_by_amendment_license_amendment_id varchar [note: 'Reference to a subsequent amendment that supersedes or replaces this one. Null if this is the current active amendment. | Column superseded_by_amendment_license_amendment_id (BIGINT) in rights.license_amendment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.license_amendment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.license_amendment']
  amended_license_fee_amount decimal(18,2) [note: 'The new total license fee or minimum guarantee amount after this amendment. Null if the amendment does not modify financial terms. | Column amended_license_fee_amount (DECIMAL(18,2)) in rights.license_amendment']
  amended_term_end_date date [note: 'The new license agreement end date after this amendment takes effect. Null if the amendment does not modify term duration. | Column amended_term_end_date (DATE) in rights.license_amendment']
  amendment_number varchar [note: 'Business identifier for the amendment, typically sequential or alphanumeric code (e.g., AMD-001, A1, Amendment-2023-05). Used for external reference and legal documentation. | Column amendment_number (STRING) in rights.license_amendment']
  amendment_reason varchar [note: 'Business justification or trigger for the amendment. Examples: market opportunity, performance renegotiation, rights holder request, regulatory change, strategic partnership expansion. | Column amendment_reason (STRING) in rights.license_amendment']
  amendment_status varchar [note: 'Current lifecycle state of the amendment: draft (being prepared), pending_review (under legal review), pending_approval (awaiting executive sign-off), executed (fully signed and active), rejected (not approved), superseded (replaced by newer amendment). | Column amendment_status (STRING) in rights.license_amendment']
  amendment_type varchar [note: 'Classification of the amendment based on the nature of the change: term extension (extending license duration), territory expansion (adding geographic markets), platform addition (adding distribution channels such as SVOD, AVOD, linear), fee renegotiation (changing financial terms), rights_modification (altering content usage rights), or termination (early contract end). | Column amendment_type (STRING) in rights.license_amendment']
  approval_authority varchar [note: 'Name or title of the executive or committee that approved this amendment (e.g., VP Rights Acquisition, Legal Counsel, CFO, Board of Directors). | Column approval_authority (STRING) in rights.license_amendment']
  changed_terms_summary varchar [note: 'Narrative summary of the specific terms modified by this amendment. Captures key changes for quick reference without requiring full legal document review. Examples: \'Extended term by 24 months\', \'Added AVOD rights for UK territory\', \'Reduced minimum guarantee by 15%\'. | Column changed_terms_summary (STRING) in rights.license_amendment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.license_amendment']
  created_by_user varchar [note: 'Username or identifier of the system user who created this amendment record. Audit trail for accountability. | Column created_by_user (STRING) in rights.license_amendment']
  created_timestamp timestamp [note: 'Timestamp when this amendment record was first created in the system. Audit trail for data lineage. | Column created_timestamp (TIMESTAMP) in rights.license_amendment']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this amendment (e.g., USD, GBP, EUR). | Column currency_code (STRING) in rights.license_amendment']
  effective_date date [note: 'Date when the amendment terms become legally binding and operational. May be retroactive or future-dated depending on negotiation. | Column effective_date (DATE) in rights.license_amendment']
  execution_date date [note: 'Date when all parties signed the amendment, making it legally executed. Distinct from effective_date which may differ based on contract terms. | Column execution_date (DATE) in rights.license_amendment']
  expiration_date date [note: 'Date when the amendment terms expire or sunset, if applicable. Null for amendments that permanently modify the agreement. | Column expiration_date (DATE) in rights.license_amendment']
  fee_adjustment_amount decimal(18,2) [note: 'The incremental change in license fee resulting from this amendment. Positive for increases, negative for reductions. Calculated as amended_license_fee_amount minus original_license_fee_amount. | Column fee_adjustment_amount (DECIMAL(18,2)) in rights.license_amendment']
  holdback_period_change_days varchar [note: 'Change in holdback or exclusivity period measured in days. Positive for extensions, negative for reductions. Null if holdback terms unchanged. | Column holdback_period_change_days (INT) in rights.license_amendment']
  internal_notes varchar [note: 'Confidential internal commentary on the amendment negotiation, business context, or special handling instructions. Not shared with external parties. | Column internal_notes (STRING) in rights.license_amendment']
  last_modified_by_user varchar [note: 'Username or identifier of the system user who last modified this amendment record. Audit trail for accountability. | Column last_modified_by_user (STRING) in rights.license_amendment']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to this amendment record. Audit trail for change tracking. | Column last_modified_timestamp (TIMESTAMP) in rights.license_amendment']
  legal_document_reference varchar [note: 'Reference identifier or file path to the executed legal amendment document stored in the document management system or MAM. | Column legal_document_reference (STRING) in rights.license_amendment']
  original_license_fee_amount decimal(18,2) [note: 'The total license fee or minimum guarantee amount before this amendment. Captured for financial audit and royalty recalculation. | Column original_license_fee_amount (DECIMAL(18,2)) in rights.license_amendment']
  original_term_end_date date [note: 'The license agreement end date before this amendment. Captured for audit trail and to calculate term extension impact. | Column original_term_end_date (DATE) in rights.license_amendment']
  platforms_added varchar [note: 'Comma-separated list of distribution platforms or windows added by this amendment. Examples: SVOD, AVOD, TVOD, Linear, FAST, Theatrical. Empty if no platform expansion. | Column platforms_added (STRING) in rights.license_amendment']
  platforms_removed varchar [note: 'Comma-separated list of distribution platforms or windows removed or restricted by this amendment. Empty if no platform reduction. | Column platforms_removed (STRING) in rights.license_amendment']
  requires_royalty_recalculation boolean [note: 'Indicates whether this amendment triggers retroactive royalty recalculation for past periods. True when financial terms are modified with retroactive effective dates. | Column requires_royalty_recalculation (BOOLEAN) in rights.license_amendment']
  royalty_rate_change_percent decimal(5,2) [note: 'Percentage point change in royalty rate resulting from this amendment. Positive for increases, negative for decreases. Null if royalty terms unchanged. | Column royalty_rate_change_percent (DECIMAL(5,2)) in rights.license_amendment']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.license_amendment']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.license_amendment']
  territories_added varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes for territories added by this amendment. Empty if no territory expansion. | Column territories_added (STRING) in rights.license_amendment']
  territories_removed varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes for territories removed or restricted by this amendment. Empty if no territory reduction. | Column territories_removed (STRING) in rights.license_amendment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.license_amendment']

  Note: 'Tracks formal amendments, modifications, and extensions to executed license agreements. Each record captures the parent agreement reference, amendment number, amendment type (term extension, territory expansion, platform addition, fee renegotiation, termination), effective date of amendment, changed terms summary, amendment status (draft, executed, rejected), and the executing parties. Maintains a complete amendment history for each agreement to support audit, legal review, and royalty recalculation when terms change mid-term. | Unity Catalog table: media_broadcasting_ecm.rights.license_amendment Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics. Integrates with Rightsline (rights management).'
}

Table rights.exploitation_report {
  exploitation_report_id varchar [pk, note: 'Unique identifier for the exploitation report. Primary key for this entity. | Column exploitation_report_id (BIGINT) in rights.exploitation_report']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Exploitation reports submitted to rights holders must identify broadcast channel for royalty calculation, territory compliance verification, and per-channel revenue attribution. Channel is mandatory d | Column channel_id (BIGINT) in scheduling.exploitation_report']
  cross_platform_measurement_id varchar [note: 'Foreign key linking to audience.cross_platform_measurement. Business justification: Modern exploitation reports must account for deduplicated cross-platform viewing (linear + OTT + MVPD) to accurately report total content usage. Rights holders require comprehensive cross-platform met | Column cross_platform_measurement_id (BIGINT) in audience.exploitation_report']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Exploitation reports document usage under specific rights grants. Each report relates to one rights grant that authorized the exploitation. This FK enables tracing reported usage back to the authorita | Column grant_id (BIGINT) in rights.exploitation_report']
  holder_id varchar [note: 'Reference to the rights holder or licensor to whom this exploitation report is being submitted, identifying the recipient of royalty payments. | Column holder_id (BIGINT) in rights.exploitation_report']
  legal_entity_id varchar [note: 'Reference to the organization or business unit that generated and submitted this exploitation report (typically the distributor or platform operator). | Column legal_entity_id (BIGINT) in finance.exploitation_report']
  license_agreement_id varchar [note: 'Reference to the specific license agreement under which this exploitation occurred, linking usage to contractual terms and royalty rates. | Column license_agreement_id (BIGINT) in rights.exploitation_report']
  media_asset_id varchar [note: 'Reference to the content asset (film, series, episode, music track) that was exploited during the reporting period. | Column media_asset_id (BIGINT) in mediaasset.exploitation_report']
  nielsen_rating_id varchar [note: 'Foreign key linking to audience.nielsen_rating. Business justification: Exploitation reports cite Nielsen ratings for broadcast performance metrics in royalty calculations. Rights holders receive exploitation reports showing Nielsen data to validate usage-based payments.  | Column nielsen_rating_id (BIGINT) in audience.exploitation_report']
  ott_platform_id varchar [note: 'Reference to the distribution platform or channel where the content was exploited (e.g., streaming service, broadcast network, theatrical chain). | Column ott_platform_id (BIGINT) in distribution.exploitation_report']
  reach_frequency_report_id varchar [note: 'Foreign key linking to audience.reach_frequency_report. Business justification: Exploitation reports for advertiser-supported content reference reach/frequency reports to demonstrate audience delivery performance. Rights holders use reach/frequency data to validate that content a | Column reach_frequency_report_id (BIGINT) in audience.exploitation_report']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Exploitation reports feed quarterly FCC filings (revenue reports, content distribution disclosures). Links usage data to the regulatory filing it supports for public inspection file compliance. | Column regulatory_filing_id (BIGINT) in compliance.exploitation_report']
  reporting_market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: Exploitation reports break down viewership by DMA (market coverage) for territory-specific license agreements and royalty calculations. Real business process: rights holders receive market-level explo | Column reporting_market_coverage_id (BIGINT) in audience.exploitation_report']
  revenue_recognition_event_id varchar [note: 'Foreign key linking to finance.revenue_recognition_event. Business justification: Exploitation reports from distribution partners provide usage data that triggers revenue recognition events under ASC 606. Required for revenue assurance, performance obligation satisfaction, and fina | Column revenue_recognition_event_id (BIGINT) in finance.exploitation_report']
  rights_content_window_id varchar [note: 'Foreign key linking to rights.rights_content_window. Business justification: Exploitation reports document usage within specific content windows. Each report may relate to one rights content window that defines the exploitation parameters. This FK enables tracing exploitation  | Column rights_content_window_id (BIGINT) in rights.exploitation_report']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Exploitation reports track usage by territory. Each report relates to one territory. Normalizing to territory reference eliminates redundant territory code and name storage and enables consistent terr | Column rights_territory_id (BIGINT) in rights.exploitation_report']
  royalty_statement_id varchar [note: 'Foreign key linking to rights.royalty_statement. Business justification: Exploitation reports feed into royalty statements. Each report may feed one statement, providing the raw usage data for royalty calculation. This FK enables tracing exploitation data to the resulting  | Column royalty_statement_id (BIGINT) in rights.exploitation_report']
  validated_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Exploitation reports from distribution partners require validation by royalty analysts before acceptance for payment processing. Business needs to track who validated each report for quality control,  | Column validated_by_employee_id (BIGINT) in workforce.exploitation_report']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.exploitation_report']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.exploitation_report']
  acceptance_date date [note: 'Date when the rights holder formally accepted the exploitation report, closing the dispute window and confirming the usage data. | Column acceptance_date (DATE) in rights.exploitation_report']
  amendment_notes varchar [note: 'Documentation of changes made to the exploitation report after initial submission, typically in response to disputes or data corrections. | Column amendment_notes (STRING) in rights.exploitation_report']
  audit_reference_number varchar [note: 'External audit identifier linking this exploitation report to a formal rights holder audit request, enabling traceability during royalty audits. | Column audit_reference_number (STRING) in rights.exploitation_report']
  content_title varchar [note: 'The title of the content asset being reported, captured for readability and quick reference without requiring joins to the content master. | Column content_title (STRING) in rights.exploitation_report']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.exploitation_report']
  created_timestamp timestamp [note: 'Timestamp when the exploitation report record was first created in the system, supporting audit trail and data lineage requirements. | Column created_timestamp (TIMESTAMP) in rights.exploitation_report']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this report, ensuring consistent financial interpretation. | Column currency_code (STRING) in rights.exploitation_report']
  data_source_system varchar [note: 'Name of the operational system from which the exploitation usage data was extracted (e.g., Dalet Galaxy, Ericsson MediaFirst, Adobe Experience Platform), supporting data lineage and audit requirements. | Column data_source_system (STRING) in rights.exploitation_report']
  dispute_reason varchar [note: 'Explanation provided by the rights holder when disputing the exploitation report, documenting discrepancies in usage counts, revenue attribution, or territorial compliance. | Column dispute_reason (STRING) in rights.exploitation_report']
  due_date date [note: 'Contractual deadline by which the exploitation report must be submitted to the rights holder, derived from license agreement reporting terms. | Column due_date (DATE) in rights.exploitation_report']
  eidr_identifier varchar [note: 'Universal unique identifier for the audiovisual content asset as registered with EIDR, enabling global content identification across rights holders and distributors. | Column eidr_identifier (STRING) in rights.exploitation_report']
  exploitation_type varchar [note: 'The method by which the content was exploited: linear broadcast (traditional TV), SVOD streaming (subscription video on demand), AVOD streaming (advertising-supported video on demand), TVOD rental (transactional rental), TVOD purchase (transactional purchase), theatrical exhibition, or home video (physical media). [ENUM-REF-CANDIDATE: linear_broadcast|svod_streaming|avod_streaming|tvod_rental|tvod_purchase|theatrical|home_video — 7 candidates stripped; promote to reference product] | Column exploitation_type (STRING) in rights.exploitation_report']
  gross_revenue_amount decimal(18,2) [note: 'Total revenue attributed to the exploitation of this content during the reporting period before any deductions, used as the basis for royalty calculations. | Column gross_revenue_amount (DECIMAL(18,2)) in rights.exploitation_report']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to the exploitation report record, tracking changes through the report lifecycle from draft to final acceptance. | Column last_modified_timestamp (TIMESTAMP) in rights.exploitation_report']
  net_revenue_amount decimal(18,2) [note: 'Revenue after contractually defined deductions (distribution fees, marketing costs, platform fees) that forms the royalty calculation base per the license agreement. | Column net_revenue_amount (DECIMAL(18,2)) in rights.exploitation_report']
  report_format_version varchar [note: 'Version number of the exploitation report template or schema used, ensuring compatibility and correct interpretation of report fields over time. | Column report_format_version (STRING) in rights.exploitation_report']
  report_number varchar [note: 'Business identifier for the exploitation report, typically formatted as EXP-YYYYMMDD-XXXXXX for external reference and audit tracking. | Column report_number (STRING) in rights.exploitation_report']
  report_status varchar [note: 'Current lifecycle status of the exploitation report: draft (in preparation), submitted (sent to rights holder), accepted (acknowledged by rights holder), disputed (under review for discrepancies), amended (revised after dispute), withdrawn (cancelled), or archived (finalized and stored). [ENUM-REF-CANDIDATE: draft|submitted|accepted|disputed|amended|withdrawn|archived — 7 candidates stripped; promote to reference product] | Column report_status (STRING) in rights.exploitation_report']
  report_type varchar [note: 'Classification of the exploitation report indicating its purpose: usage submission to rights holders, usage receipt from distributors, royalty evidence documentation, audit support materials, reconciliation reports, or ad-hoc custom reports. | Column report_type (STRING) in rights.exploitation_report']
  reporting_entity_name varchar [note: 'Name of the organization that submitted the report, captured for audit trail and report header display. | Column reporting_entity_name (STRING) in rights.exploitation_report']
  reporting_period_end_date date [note: 'The last date of the period covered by this exploitation report, defining the end of the usage window being documented. | Column reporting_period_end_date (DATE) in rights.exploitation_report']
  reporting_period_start_date date [note: 'The first date of the period covered by this exploitation report, defining the beginning of the usage window being documented. | Column reporting_period_start_date (DATE) in rights.exploitation_report']
  rights_holder_name varchar [note: 'Name of the rights holder receiving the report, captured for report header and audit purposes. | Column rights_holder_name (STRING) in rights.exploitation_report']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.exploitation_report']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.exploitation_report']
  submission_date date [note: 'Date when the exploitation report was formally submitted to the rights holder, marking the start of the acceptance or dispute period. | Column submission_date (DATE) in rights.exploitation_report']
  total_broadcasts varchar [note: 'Total number of linear broadcast transmissions of the content during the reporting period. Null for on-demand exploitation. | Column total_broadcasts (INT) in rights.exploitation_report']
  total_streams varchar [note: 'Total number of individual stream starts or playback initiations for on-demand content during the reporting period. Null for linear broadcast exploitation. | Column total_streams (BIGINT) in rights.exploitation_report']
  total_viewing_hours decimal(18,2) [note: 'Aggregate number of hours that audiences spent viewing the content during the reporting period, calculated as sum of all viewing durations. | Column total_viewing_hours (DECIMAL(18,2)) in rights.exploitation_report']
  unique_viewers varchar [note: 'Count of distinct individual viewers or households that accessed the content during the reporting period, representing reach metric. | Column unique_viewers (BIGINT) in rights.exploitation_report']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.exploitation_report']

  Note: 'Periodic exploitation usage report submitted to or received from rights holders, documenting actual content usage across platforms and territories for royalty calculation purposes. Captures reporting period, content asset, exploitation type, platform, territory, total streams or broadcasts, total viewing hours, gross revenue attributed, reporting entity, submission date, and report status (draft, submitted, accepted, disputed). Serves as the evidentiary basis for royalty statement generation and licensor audit requests. Distinct from royalty statements — this is the raw usage evidence, not the calculated payment. | Unity Catalog table: media_broadcasting_ecm.rights.exploitation_report Aligned with EBU CCDM Tech 3351 (http://www.ebu.ch/metadata/ontologies/ebucore). Rightsline rights management integration supported.'
}

Table rights.holder {
  holder_id varchar [pk, note: 'Unique identifier for the rights holder entity. Primary key for the rights holder master record. | Column holder_id (BIGINT) in rights.holder']
  partner_id varchar [note: 'FK added per VREQ']
  partner_partner_id varchar [note: 'FK column added per VREQ-055']
  pro_affiliation_id varchar [note: 'FK to PRO affiliation for music rights holders']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.holder']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.holder']
  audit_rights_flag boolean [note: 'Indicates whether this rights holder has contractual audit rights to review revenue reporting and royalty calculations. True requires enhanced documentation retention. | Column audit_rights_flag (BOOLEAN) in rights.holder']
  bank_account_name varchar [note: 'Name on the bank account designated for royalty payments. Must match legal entity name for payment processing compliance. | Column bank_account_name (STRING) in rights.holder']
  bank_account_number varchar [note: 'Bank account number for royalty payment remittance. Encrypted at rest and in transit per PCI DSS requirements. | Column bank_account_number (STRING) in rights.holder']
  bank_routing_number varchar [note: 'Bank routing number or SWIFT/BIC code for international wire transfers. Used for automated royalty payment processing. | Column bank_routing_number (STRING) in rights.holder']
  clearance_priority_level varchar [note: 'Priority level assigned to clearance requests for content from this rights holder. VIP and critical levels receive accelerated processing. | Column clearance_priority_level (STRING) in rights.holder']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.holder']
  created_timestamp timestamp [note: 'Timestamp when this rights holder record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in rights.holder']
  credit_limit_amount decimal(15,2) [note: 'Maximum credit exposure allowed for advance payments or minimum guarantees to this rights holder. Used for financial risk management. | Column credit_limit_amount (DECIMAL(15,2)) in rights.holder']
  default_royalty_rate decimal(5,2) [note: 'Default royalty rate percentage applied to new agreements with this rights holder. Can be overridden at the contract level. | Column default_royalty_rate (DECIMAL(5,2)) in rights.holder']
  entity_type varchar [note: 'Classification of the rights holder by organizational type. Determines applicable contract templates, royalty calculation methods, and clearance workflows. [ENUM-REF-CANDIDATE: film_studio|production_company|music_publisher|performing_rights_organization|talent_guild|record_label|news_agency|individual_creator — 8 candidates stripped; promote to reference product] | Column entity_type (STRING) in rights.holder']
  exclusivity_preference varchar [note: 'Rights holder\'s stated preference for exclusivity terms in licensing agreements. Influences windowing strategy and holdback negotiations. | Column exclusivity_preference (STRING) in rights.holder']
  guild_affiliation varchar [note: 'Name of talent guild or performing rights organization (PRO) that this rights holder is affiliated with. Determines residual payment rules and reporting requirements. [ENUM-REF-CANDIDATE: sag_aftra|wga|dga|afm|ascap|bmi|sesac|gema|prs|socan — promote to reference product] | Column guild_affiliation (STRING) in rights.holder']
  last_modified_by varchar [note: 'User identifier of the person who last modified this rights holder record. Used for audit trail and change accountability. | Column last_modified_by (STRING) in rights.holder']
  last_modified_timestamp timestamp [note: 'Timestamp when this rights holder record was last updated. Used for change tracking and data synchronization. | Column last_modified_timestamp (TIMESTAMP) in rights.holder']
  minimum_guarantee_threshold decimal(15,2) [note: 'Minimum guarantee amount threshold below which this rights holder will not enter licensing agreements. Used for deal structuring and negotiation. | Column minimum_guarantee_threshold (DECIMAL(15,2)) in rights.holder']
  most_favored_nations_flag boolean [note: 'Indicates whether this rights holder has most favored nations clause requiring rate parity with other similar rights holders. True triggers rate comparison workflows. | Column most_favored_nations_flag (BOOLEAN) in rights.holder']
  notes varchar [note: 'Free-text notes capturing special handling instructions, negotiation history, relationship nuances, or other contextual information for this rights holder. | Column notes (STRING) in rights.holder']
  payment_method varchar [note: 'Preferred payment method for royalty disbursements. Determines processing fees and settlement timelines. | Column payment_method (STRING) in rights.holder']
  payment_terms_days varchar [note: 'Standard payment terms in days from invoice date for royalty payments to this rights holder. Typical values include 30, 60, or 90 days net. | Column payment_terms_days (INT) in rights.holder']
  preferred_currency varchar [note: 'Three-letter ISO currency code representing the rights holder\'s preferred currency for royalty payments and contract valuations. | Column preferred_currency (STRING) in rights.holder']
  primary_contact_email varchar [note: 'Primary email address for the rights holder contact. Used for contract notifications, clearance communications, and royalty statements. | Column primary_contact_email (STRING) in rights.holder']
  primary_contact_name varchar [note: 'Full name of the primary business contact at the rights holder organization for licensing negotiations, clearance requests, and royalty inquiries. | Column primary_contact_name (STRING) in rights.holder']
  primary_contact_phone varchar [note: 'Primary telephone number for the rights holder contact. Used for urgent clearance issues and contract negotiations. | Column primary_contact_phone (STRING) in rights.holder']
  registrant_identifier varchar [note: 'The ISAN or ISRC registrant identifier assigned to the rights holder by the respective international registration authority. Used for global rights tracking and content identification. | Column registrant_identifier (STRING) in rights.holder']
  relationship_end_date date [note: 'Date when the business relationship with this rights holder was terminated or suspended. Null for active relationships. | Column relationship_end_date (DATE) in rights.holder']
  relationship_start_date date [note: 'Date when the business relationship with this rights holder was established. Used for historical reporting and relationship tenure analysis. | Column relationship_start_date (DATE) in rights.holder']
  rights_holder_code varchar [note: 'Internal business identifier code assigned to the rights holder for operational reference and system integration across Rightsline and billing systems. | Column rights_holder_code (STRING) in rights.holder']
  rights_holder_name varchar [note: 'The full legal name of the rights holder entity as registered in their territory of incorporation. Used for contract execution and royalty payment identification. | Column rights_holder_name (STRING) in rights.holder']
  rights_holder_status varchar [note: 'Current lifecycle status of the rights holder relationship. Active status is required for new license agreements and royalty payments. | Column rights_holder_status (STRING) in rights.holder']
  royalty_calculation_method varchar [note: 'Standard royalty calculation methodology applied to this rights holder\'s agreements. Determines how residuals and royalties are computed. | Column royalty_calculation_method (STRING) in rights.holder']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.holder']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.holder']
  tax_identification_number varchar [note: 'Tax identification number for the rights holder in their jurisdiction of incorporation. Required for tax reporting and withholding compliance. | Column tax_identification_number (STRING) in rights.holder']
  tax_withholding_classification varchar [note: 'Tax withholding classification for royalty payments. Determines applicable withholding rates based on tax treaties and domestic regulations. | Column tax_withholding_classification (STRING) in rights.holder']
  tax_withholding_rate decimal(5,2) [note: 'Applicable tax withholding rate percentage for royalty payments to this rights holder. Derived from tax treaties and domestic law based on withholding classification. | Column tax_withholding_rate (DECIMAL(5,2)) in rights.holder']
  territory_of_incorporation varchar [note: 'Three-letter ISO country code representing the legal jurisdiction where the rights holder entity is incorporated or registered. Determines applicable tax treaties and withholding requirements. | Column territory_of_incorporation (STRING) in rights.holder']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.holder']
  use_case_fitness_gaps varchar [note: 'Documents analytics use-case fitness gaps requiring A1 (news), A2 (sports), A3 (music) entity additions: Sports right-holder analytics (2-star): A2 sports entities (sports_league, sports_event, sports_team, athlete, event_blackout_rule); Newsroom analytics (2-star): A1 news entities (news_story, wire_ingest, byline_credit, breaking_news_event, editorial_workflow_state); Music label catalog & royalties (2-star): A3 composition/master split (composition, master_recording, release, publisher, pro_affiliation)']
  created_by varchar [note: 'User identifier of the person who created this rights holder record. Used for audit trail and accountability. | Column created_by (STRING) in rights.holder']

  Note: 'Master record for all external entities that hold intellectual property rights licensed to or from Media Broadcasting — including film studios, independent production companies, music publishers, performing rights organizations (PROs), talent guilds, record labels, news agencies, and individual creators. Captures rights holder name, entity type, ISAN or ISRC registrant identifier, primary contact, territory of incorporation, preferred currency, payment terms, and tax withholding classification. This is the SSOT for rights grantor and grantee identity within the rights domain, distinct from the partner domain which manages broader commercial relationships. | Unity Catalog table: media_broadcasting_ecm.rights.holder Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics. Integrates with Rightsline (rights management).'
}

Table rights.rights_blackout_rule {
  rights_blackout_rule_id varchar [pk, note: 'Unique identifier for the blackout rule record. Primary key. | Column rights_blackout_rule_id (BIGINT) in rights.rights_blackout_rule']
  approved_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Blackout rules (especially sports/regulatory) require approval authority tracking for compliance audits and dispute resolution. When blackouts are challenged by distribution partners or regulators, bu | Column approved_by_employee_id (BIGINT) in workforce.rights_blackout_rule']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Geographic blackout enforcement requires identifying which transmission facilities serve restricted DMAs/territories. Essential for sports rights compliance where home-market blackouts must be enforce | Column broadcast_facility_id (BIGINT) in technology.rights_blackout_rule']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Blackout rules restrict specific rights grants. Each blackout rule applies to one rights grant, defining geographic or temporal restrictions on exploitation. This FK enables tracing blackout restricti | Column grant_id (BIGINT) in rights.rights_blackout_rule']
  license_agreement_id varchar [note: 'Reference to the license agreement that mandates this blackout restriction. | Column license_agreement_id (BIGINT) in rights.rights_blackout_rule']
  primary_rights_media_asset_id varchar [note: 'Reference to the specific content asset subject to blackout restriction. | Column primary_rights_media_asset_id (BIGINT) in mediaasset.rights_blackout_rule']
  rights_syndication_deal_id varchar [note: 'Foreign key linking to rights.syndication_deal. Business justification: Blackout rules may arise from syndication deals. Each blackout rule may reference one syndication deal that defines the blackout restrictions. This FK enables tracing blackout rules back to the source | Column rights_syndication_deal_id (BIGINT) in rights.rights_blackout_rule']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Blackout rules apply to specific territories. Each blackout rule restricts one territory. Normalizing to territory reference eliminates redundant territory string storage and enables consistent territ | Column rights_territory_id (BIGINT) in rights.rights_blackout_rule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.rights_blackout_rule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.rights_blackout_rule']
  applicable_platform varchar [note: 'Distribution platform or channel type to which this blackout rule applies: linear (traditional broadcast), OTT (over-the-top streaming), MVPD (multichannel video programming distributor), vMVPD (virtual MVPD), SVOD (subscription video on demand), AVOD (ad-supported video on demand), TVOD (transactional video on demand), FAST (free ad-supported streaming TV), broadcast, cable, satellite, or streaming. [ENUM-REF-CANDIDATE: linear|ott|mvpd|vmvpd|svod|avod|tvod|fast|broadcast|cable|satellite|streaming — 12 candidates stripped; promote to reference product] | Column applicable_platform (STRING) in rights.rights_blackout_rule']
  automated_enforcement_flag boolean [note: 'Indicates whether this blackout rule is enforced automatically by distribution systems (True) or requires manual operator intervention (False). | Column automated_enforcement_flag (BOOLEAN) in rights.rights_blackout_rule']
  blackout_duration_hours decimal(10,2) [note: 'Calculated duration of the blackout period in hours, derived from start and end datetime. Used for reporting and analytics. | Column blackout_duration_hours (DECIMAL(10,2)) in rights.rights_blackout_rule']
  blackout_end_datetime timestamp [note: 'Precise date and time when the blackout restriction expires. Nullable for indefinite blackouts. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column blackout_end_datetime (TIMESTAMP) in rights.rights_blackout_rule']
  blackout_message_text varchar [note: 'Viewer-facing message or notification text to be displayed when content is unavailable due to this blackout restriction. Used for customer communication and transparency. | Column blackout_message_text (STRING) in rights.rights_blackout_rule']
  blackout_rule_code varchar [note: 'Business-assigned unique code identifying this blackout rule for operational reference and reporting. | Column blackout_rule_code (STRING) in rights.rights_blackout_rule']
  blackout_start_datetime timestamp [note: 'Precise date and time when the blackout restriction becomes effective. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column blackout_start_datetime (TIMESTAMP) in rights.rights_blackout_rule']
  blackout_type varchar [note: 'Classification of the blackout restriction: sports local market blackout (home team market protection), affiliate exclusivity blackout (local station rights), regulatory blackout (government-mandated restriction), territorial holdback (geographic windowing), competitive protection (anti-siphoning), or league-imposed (sports league rule). | Column blackout_type (STRING) in rights.rights_blackout_rule']
  conflict_resolution_notes varchar [note: 'Free-text notes documenting how conflicts with other blackout rules, rights grants, or distribution agreements were resolved for this rule. | Column conflict_resolution_notes (STRING) in rights.rights_blackout_rule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.rights_blackout_rule']
  created_timestamp timestamp [note: 'Date and time when this blackout rule record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column created_timestamp (TIMESTAMP) in rights.rights_blackout_rule']
  dma_code varchar [note: 'Nielsen Designated Market Area three-digit code identifying the specific local television market subject to blackout. | Column dma_code (STRING) in rights.rights_blackout_rule']
  enforcement_method varchar [note: 'Technical mechanism used to enforce the blackout: geo-blocking (IP-based restriction), content suppression (removal from catalog), redirect (alternate content substitution), alternate feed (different broadcast signal), or manual override (operator intervention). | Column enforcement_method (STRING) in rights.rights_blackout_rule']
  enforcement_status varchar [note: 'Current operational status of the blackout rule: active (currently enforced), suspended (temporarily disabled), expired (past end datetime), waived (exception granted), pending activation (scheduled future), or overridden (superseded by business decision). | Column enforcement_status (STRING) in rights.rights_blackout_rule']
  home_team_market_flag boolean [note: 'Indicates whether this blackout applies to the home team\'s local market to protect local broadcast rights. True for home market blackouts, False otherwise. Applicable to sports content. | Column home_team_market_flag (BOOLEAN) in rights.rights_blackout_rule']
  last_modified_by varchar [note: 'User identifier or system account that most recently modified this blackout rule record. | Column last_modified_by (STRING) in rights.rights_blackout_rule']
  last_modified_timestamp timestamp [note: 'Date and time when this blackout rule record was most recently updated. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column last_modified_timestamp (TIMESTAMP) in rights.rights_blackout_rule']
  notification_sent_datetime timestamp [note: 'Date and time when automated notifications about this blackout rule were dispatched to downstream systems and stakeholders. Nullable if notifications not yet sent. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column notification_sent_datetime (TIMESTAMP) in rights.rights_blackout_rule']
  notification_sent_flag boolean [note: 'Indicates whether automated notifications have been sent to affected distribution partners, scheduling systems, and stakeholders about this blackout rule. True if notifications dispatched, False otherwise. | Column notification_sent_flag (BOOLEAN) in rights.rights_blackout_rule']
  priority_level varchar [note: 'Business priority assigned to this blackout rule for conflict resolution and enforcement sequencing. Critical rules override lower-priority rules when conflicts occur. | Column priority_level (STRING) in rights.rights_blackout_rule']
  regulatory_authority varchar [note: 'Name of the government or regulatory body that mandates this blackout restriction (e.g., FCC, Ofcom, CRTC). Applicable only for regulatory blackouts. | Column regulatory_authority (STRING) in rights.rights_blackout_rule']
  regulatory_reference_number varchar [note: 'Official reference number, docket number, or citation of the regulatory ruling or statute that mandates this blackout. Applicable only for regulatory blackouts. | Column regulatory_reference_number (STRING) in rights.rights_blackout_rule']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.rights_blackout_rule']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.rights_blackout_rule']
  sports_league_code varchar [note: 'Code identifying the sports league or governing body that mandates this blackout rule (e.g., NFL, NBA, MLB, NHL, MLS, NCAA). Applicable only for sports-related blackouts. | Column sports_league_code (STRING) in rights.rights_blackout_rule']
  triggering_rights_clause varchar [note: 'Reference to the specific contractual clause, section, or provision in the license agreement that mandates this blackout restriction. May include clause number and brief description. | Column triggering_rights_clause (STRING) in rights.rights_blackout_rule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.rights_blackout_rule']
  waiver_approved_by varchar [note: 'Name or identifier of the authorized person who approved the blackout waiver. Nullable if no waiver granted. | Column waiver_approved_by (STRING) in rights.rights_blackout_rule']
  waiver_approved_date date [note: 'Date on which the blackout waiver was officially approved. Nullable if no waiver granted. Format: yyyy-MM-dd. | Column waiver_approved_date (DATE) in rights.rights_blackout_rule']
  waiver_granted_flag boolean [note: 'Indicates whether an exception or waiver has been granted to bypass this blackout rule. True if waiver approved, False otherwise. | Column waiver_granted_flag (BOOLEAN) in rights.rights_blackout_rule']
  waiver_reason varchar [note: 'Business justification or explanation for granting a waiver to this blackout rule. Nullable if no waiver granted. | Column waiver_reason (STRING) in rights.rights_blackout_rule']
  created_by varchar [note: 'User identifier or system account that created this blackout rule record. | Column created_by (STRING) in rights.rights_blackout_rule']

  Note: 'Defines geographic broadcast blackout restrictions for specific content assets, typically driven by sports rights agreements, local affiliate exclusivity, or regulatory requirements. Captures content asset reference, blackout type (sports local market blackout, affiliate exclusivity blackout, regulatory blackout), blacked-out territory or DMA (Designated Market Area), applicable platform (linear, OTT, MVPD), blackout start and end datetime, triggering rights clause, and enforcement status. Consumed by distribution and scheduling domains to suppress or redirect content delivery in restricted zones. SSOT for blackout rule definitions. Scheduling.scheduling_blackout_rule should reference this. | Unity Catalog table: media_broadcasting_ecm.rights.rights_blackout_rule Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics. Integrates with Rightsline (rights management).'
}

Table rights.rights_syndication_deal {
  rights_syndication_deal_id varchar [pk, note: 'Unique identifier for the syndication deal record. Primary key. | Column rights_syndication_deal_id (BIGINT) in rights.rights_syndication_deal']
  deal_executive_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Syndication deals require tracking the syndication sales executive responsible for the deal for commission calculations, territory assignment, renewal routing, and performance management. Standard pra | Column deal_executive_employee_id (BIGINT) in workforce.rights_syndication_deal']
  holder_id varchar [note: 'Foreign key linking to rights.rights_holder. Business justification: Syndication deals involve rights holders as licensees. Each deal involves one rights holder. Normalizing to rights_holder reference eliminates redundant licensee_name storage and enables consistent ri | Column holder_id (BIGINT) in rights.rights_syndication_deal']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Syndication deals are specialized license agreements. Each syndication deal may reference a parent license agreement that defines the underlying rights being syndicated. This FK enables tracing syndic | Column license_agreement_id (BIGINT) in rights.rights_syndication_deal']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Syndication deals apply to specific territories. Each deal covers one territory. Normalizing to territory reference eliminates redundant territory string storage and enables consistent territory metad | Column rights_territory_id (BIGINT) in rights.rights_syndication_deal']
  syndication_partner_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Syndication deals are partner-facing distribution agreements requiring direct FK to identify the syndication partner (licensee). Enables partner-centric syndication reporting, partner performance anal | Column syndication_partner_partner_id (BIGINT) in partner.rights_syndication_deal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.rights_syndication_deal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.rights_syndication_deal']
  auto_renewal_indicator boolean [note: 'Indicates whether the deal automatically renews for an additional term unless either party provides notice (True) or requires explicit renewal negotiation (False). | Column auto_renewal_indicator (BOOLEAN) in rights.rights_syndication_deal']
  blackout_applicable boolean [note: 'Indicates whether geographic or temporal blackout restrictions apply to this syndication deal (True) or not (False). | Column blackout_applicable (BOOLEAN) in rights.rights_syndication_deal']
  blackout_description varchar [note: 'Detailed description of any blackout restrictions, including affected territories, time periods, or triggering events. | Column blackout_description (STRING) in rights.rights_syndication_deal']
  clearance_status varchar [note: 'Status of rights clearance verification for the syndication deal: pending (not yet started), in-progress (clearance checks underway), cleared (all rights verified), blocked (clearance issue identified), conditional (cleared with restrictions). | Column clearance_status (STRING) in rights.rights_syndication_deal']
  content_package_description varchar [note: 'Detailed description of the content included in the syndication deal, including titles, episode counts, and any exclusions. | Column content_package_description (STRING) in rights.rights_syndication_deal']
  content_scope varchar [note: 'Defines whether the deal covers a single title, an entire series, a specific season, a curated package of multiple titles, or a content library. | Column content_scope (STRING) in rights.rights_syndication_deal']
  contract_document_reference varchar [note: 'Reference identifier or file path to the signed syndication contract document stored in the document management system. | Column contract_document_reference (STRING) in rights.rights_syndication_deal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.rights_syndication_deal']
  created_timestamp timestamp [note: 'Timestamp when this syndication deal record was first created in the system. | Column created_timestamp (TIMESTAMP) in rights.rights_syndication_deal']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this deal (e.g., USD, GBP, EUR). | Column currency_code (STRING) in rights.rights_syndication_deal']
  deal_end_date date [note: 'Date on which the syndication rights expire and the licensee must cease distribution. Null indicates an open-ended or perpetual deal. | Column deal_end_date (DATE) in rights.rights_syndication_deal']
  deal_notes varchar [note: 'Free-text field for additional notes, special terms, or contextual information about the syndication deal. | Column deal_notes (STRING) in rights.rights_syndication_deal']
  deal_number varchar [note: 'Externally-known business identifier for the syndication deal, used in contracts and communications with licensees. | Column deal_number (STRING) in rights.rights_syndication_deal']
  deal_start_date date [note: 'Date on which the syndication rights become effective and the licensee may begin distribution. | Column deal_start_date (DATE) in rights.rights_syndication_deal']
  deal_status varchar [note: 'Current lifecycle state of the syndication deal: draft (initial creation), negotiation (under discussion), approved (signed but not yet active), active (currently in effect), suspended (temporarily paused), expired (term ended naturally), terminated (ended early), renewed (extended for additional term). [ENUM-REF-CANDIDATE: draft|negotiation|approved|active|suspended|expired|terminated|renewed — 8 candidates stripped; promote to reference product] | Column deal_status (STRING) in rights.rights_syndication_deal']
  deal_term_months varchar [note: 'Duration of the syndication deal in months, calculated from start date to end date. Facilitates term-based reporting and renewal planning. | Column deal_term_months (INT) in rights.rights_syndication_deal']
  drm_required boolean [note: 'Indicates whether the licensee must implement Digital Rights Management (DRM) technology to protect the content (True) or not (False). | Column drm_required (BOOLEAN) in rights.rights_syndication_deal']
  exclusivity_indicator boolean [note: 'Indicates whether the licensee has exclusive syndication rights in the specified territory (True) or non-exclusive rights (False). | Column exclusivity_indicator (BOOLEAN) in rights.rights_syndication_deal']
  exclusivity_scope varchar [note: 'Detailed description of the exclusivity terms, including any platform-specific, daypart-specific, or window-specific exclusivity conditions. | Column exclusivity_scope (STRING) in rights.rights_syndication_deal']
  fee_structure_type varchar [note: 'Model for syndication compensation: flat fee (single payment for entire deal), per-episode (payment per episode delivered), per-run (payment per broadcast), revenue share (percentage of licensee revenue), barter (ad inventory exchange), or hybrid (combination of models). | Column fee_structure_type (STRING) in rights.rights_syndication_deal']
  flat_fee_amount decimal(18,2) [note: 'Total flat fee amount for the syndication deal, if applicable. Null if fee structure is not flat-fee based. | Column flat_fee_amount (DECIMAL(18,2)) in rights.rights_syndication_deal']
  format_restrictions varchar [note: 'Restrictions on the format or presentation of the content (e.g., no-editing, no-dubbing, original-aspect-ratio-only). | Column format_restrictions (STRING) in rights.rights_syndication_deal']
  last_modified_by varchar [note: 'User identifier or name of the person who last modified this syndication deal record. | Column last_modified_by (STRING) in rights.rights_syndication_deal']
  last_modified_timestamp timestamp [note: 'Timestamp when this syndication deal record was last updated. | Column last_modified_timestamp (TIMESTAMP) in rights.rights_syndication_deal']
  licensee_type varchar [note: 'Classification of the licensee organization: broadcast station (local terrestrial), cable network, streaming platform (OTT/SVOD/AVOD), digital publisher, MVPD (Multichannel Video Programming Distributor), vMVPD (Virtual MVPD), or international broadcaster. [ENUM-REF-CANDIDATE: broadcast-station|cable-network|streaming-platform|digital-publisher|mvpd|vmvpd|international-broadcaster — 7 candidates stripped; promote to reference product] | Column licensee_type (STRING) in rights.rights_syndication_deal']
  minimum_guarantee_amount decimal(18,2) [note: 'Minimum guaranteed payment amount that the licensee must pay regardless of actual usage or revenue. Null if no minimum guarantee applies. | Column minimum_guarantee_amount (DECIMAL(18,2)) in rights.rights_syndication_deal']
  music_sync_license_required boolean [note: 'Indicates whether separate music synchronization licenses must be secured for the syndicated content (True) or music rights are already cleared (False). | Column music_sync_license_required (BOOLEAN) in rights.rights_syndication_deal']
  notice_period_days varchar [note: 'Number of days advance notice required for termination or non-renewal of the syndication deal. Null if not applicable. | Column notice_period_days (INT) in rights.rights_syndication_deal']
  per_episode_fee_amount decimal(18,2) [note: 'Fee amount charged per episode, if applicable. Null if fee structure is not per-episode based. | Column per_episode_fee_amount (DECIMAL(18,2)) in rights.rights_syndication_deal']
  platform_restrictions varchar [note: 'Comma-separated list of platforms or distribution channels where the licensee is restricted from distributing the content (e.g., linear-only, no-streaming, no-mobile). | Column platform_restrictions (STRING) in rights.rights_syndication_deal']
  revenue_share_percent decimal(5,2) [note: 'Percentage of licensee revenue shared with Media Broadcasting under a revenue-share fee structure. Null if not applicable. | Column revenue_share_percent (DECIMAL(5,2)) in rights.rights_syndication_deal']
  run_limit varchar [note: 'Maximum number of times the licensee is permitted to broadcast each episode or title under this syndication deal. Null indicates unlimited runs. | Column run_limit (INT) in rights.rights_syndication_deal']
  runs_used varchar [note: 'Cumulative count of runs (broadcasts) executed by the licensee to date. Used to track compliance with run limits. | Column runs_used (INT) in rights.rights_syndication_deal']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.rights_syndication_deal']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.rights_syndication_deal']
  sublicense_permitted boolean [note: 'Indicates whether the licensee is permitted to sublicense the content to other distributors (True) or must distribute directly (False). | Column sublicense_permitted (BOOLEAN) in rights.rights_syndication_deal']
  syndication_type varchar [note: 'Classification of the syndication arrangement: first-run syndication (original content distributed directly to local stations), off-network syndication (previously aired network content), international syndication (cross-border distribution), digital syndication (online/streaming platforms), barter (ad inventory exchange), or cash-plus-barter (hybrid model). | Column syndication_type (STRING) in rights.rights_syndication_deal']
  talent_residuals_applicable boolean [note: 'Indicates whether talent residual payments (reuse payments to actors, writers, directors) are triggered by this syndication deal (True) or not (False). | Column talent_residuals_applicable (BOOLEAN) in rights.rights_syndication_deal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.rights_syndication_deal']
  created_by varchar [note: 'User identifier or name of the person who created this syndication deal record. | Column created_by (STRING) in rights.rights_syndication_deal']

  Note: 'Master record for content syndication agreements under which Media Broadcasting licenses content to third-party broadcasters, streaming platforms, or digital publishers for redistribution. Captures syndication type (first-run syndication, off-network syndication, international syndication, digital syndication), licensee identity, content package or individual title scope, territory, syndication fee structure (flat fee, per-episode, revenue share), run limitations (number of permitted broadcasts), exclusivity, deal start and end dates, and deal status. Distinct from general license agreements — syndication deals have specific run-count and redistribution mechanics. | Unity Catalog table: media_broadcasting_ecm.rights.rights_syndication_deal Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics. Integrates with Rightsline (rights management).'
}

Table rights.license_fee_schedule {
  license_fee_schedule_id varchar [pk, note: 'Unique identifier for the license fee schedule entry. Primary key. | Column license_fee_schedule_id (BIGINT) in rights.license_fee_schedule']
  accounts_payable_id varchar [note: 'Foreign key linking to finance.accounts_payable. Business justification: Scheduled license fee payments create accounts payable entries when invoices are received from rights holders. Required for cash flow forecasting, payment processing, vendor management, and reconcilia | Column accounts_payable_id (BIGINT) in finance.license_fee_schedule']
  license_agreement_id varchar [note: 'Reference to the parent license agreement under which this payment schedule is defined. | Column license_agreement_id (BIGINT) in rights.license_fee_schedule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.license_fee_schedule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.license_fee_schedule']
  accounting_period varchar [note: 'The financial accounting period (e.g., 2024-Q1, 2024-03) to which this payment obligation is allocated for budgeting and forecasting purposes. | Column accounting_period (STRING) in rights.license_fee_schedule']
  actual_payment_date date [note: 'The date on which the payment was actually made to the licensor. Null if payment has not yet been completed. | Column actual_payment_date (DATE) in rights.license_fee_schedule']
  approved_by varchar [note: 'Name or identifier of the person who approved the payment for execution. Null if not yet approved. | Column approved_by (STRING) in rights.license_fee_schedule']
  approved_date date [note: 'Date on which the payment was approved for execution. Null if not yet approved. | Column approved_date (DATE) in rights.license_fee_schedule']
  cost_center varchar [note: 'The organizational cost center or department responsible for this payment obligation. | Column cost_center (STRING) in rights.license_fee_schedule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.license_fee_schedule']
  created_timestamp timestamp [note: 'Timestamp when this license fee schedule record was first created in the system. | Column created_timestamp (TIMESTAMP) in rights.license_fee_schedule']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the payment amount (e.g., USD, GBP, EUR). | Column currency_code (STRING) in rights.license_fee_schedule']
  general_ledger_account varchar [note: 'The general ledger account code to which this payment expense is posted. | Column general_ledger_account (STRING) in rights.license_fee_schedule']
  grace_period_days varchar [note: 'Number of days after the scheduled payment date before the payment is considered overdue. | Column grace_period_days (INT) in rights.license_fee_schedule']
  installment_number varchar [note: 'Sequential installment number for multi-installment payment schedules (e.g., 1 of 4, 2 of 4). Null for single payments. | Column installment_number (INT) in rights.license_fee_schedule']
  invoice_number varchar [note: 'Reference to the invoice document generated for this payment obligation. Null if not yet invoiced. | Column invoice_number (STRING) in rights.license_fee_schedule']
  last_modified_by varchar [note: 'User or system identifier that last modified this license fee schedule record. | Column last_modified_by (STRING) in rights.license_fee_schedule']
  last_modified_timestamp timestamp [note: 'Timestamp when this license fee schedule record was last updated. | Column last_modified_timestamp (TIMESTAMP) in rights.license_fee_schedule']
  late_fee_applicable boolean [note: 'Indicates whether late fees or penalties apply if payment is not made by the scheduled date. | Column late_fee_applicable (BOOLEAN) in rights.license_fee_schedule']
  late_fee_percentage decimal(5,2) [note: 'Percentage rate applied to the payment amount for late payment penalties. Null if late fees are not applicable. | Column late_fee_percentage (DECIMAL(5,2)) in rights.license_fee_schedule']
  milestone_description varchar [note: 'Detailed description of the payment milestone or trigger event, such as contract signing, delivery of content, broadcast commencement, or anniversary date. | Column milestone_description (STRING) in rights.license_fee_schedule']
  net_payment_amount decimal(18,2) [note: 'Net amount paid to the licensor after deducting withholding tax and any other adjustments. | Column net_payment_amount (DECIMAL(18,2)) in rights.license_fee_schedule']
  payment_amount decimal(18,2) [note: 'The monetary value of the scheduled payment obligation. | Column payment_amount (DECIMAL(18,2)) in rights.license_fee_schedule']
  payment_approval_status varchar [note: 'Internal approval workflow status for the payment: pending approval (awaiting authorization), approved (cleared for payment), or rejected (payment denied). | Column payment_approval_status (STRING) in rights.license_fee_schedule']
  payment_method varchar [note: 'The instrument or mechanism used to execute the payment: wire transfer, check, ACH (Automated Clearing House), credit card, PayPal, or other. | Column payment_method (STRING) in rights.license_fee_schedule']
  payment_notes varchar [note: 'Free-text notes or comments regarding the payment schedule entry, including special instructions, dispute details, or waiver justifications. | Column payment_notes (STRING) in rights.license_fee_schedule']
  payment_reference_number varchar [note: 'External payment transaction reference or confirmation number from the payment system or bank. Null if payment not yet executed. | Column payment_reference_number (STRING) in rights.license_fee_schedule']
  payment_status varchar [note: 'Current lifecycle status of the payment: scheduled (not yet due), invoiced (invoice generated), paid (payment completed), overdue (past due date), waived (obligation forgiven), or disputed (under review). | Column payment_status (STRING) in rights.license_fee_schedule']
  payment_type varchar [note: 'Classification of the payment obligation: advance (upfront payment), minimum guarantee installment (periodic MG payment), per-episode fee (unit-based payment), annual license fee (recurring annual payment), milestone payment (event-triggered payment), or royalty payment (revenue-share payment). | Column payment_type (STRING) in rights.license_fee_schedule']
  schedule_number varchar [note: 'Business identifier for the payment schedule entry, typically a sequential or hierarchical code within the agreement. | Column schedule_number (STRING) in rights.license_fee_schedule']
  scheduled_payment_date date [note: 'The contractually agreed date on which the payment is due to the licensor. | Column scheduled_payment_date (DATE) in rights.license_fee_schedule']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.license_fee_schedule']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.license_fee_schedule']
  total_installments varchar [note: 'Total number of installments in the payment schedule. Null for single payments. | Column total_installments (INT) in rights.license_fee_schedule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.license_fee_schedule']
  withholding_tax_amount decimal(18,2) [note: 'Calculated withholding tax amount deducted from the payment. Null if no withholding applies. | Column withholding_tax_amount (DECIMAL(18,2)) in rights.license_fee_schedule']
  withholding_tax_rate decimal(5,2) [note: 'Percentage of the payment amount subject to withholding tax as required by jurisdiction or treaty. Null if no withholding applies. | Column withholding_tax_rate (DECIMAL(5,2)) in rights.license_fee_schedule']
  created_by varchar [note: 'User or system identifier that created this license fee schedule record. | Column created_by (STRING) in rights.license_fee_schedule']

  Note: 'Defines the structured payment schedule for license fees owed under a license agreement, including upfront advances, milestone payments, and periodic installments. Captures the parent agreement reference, payment milestone description, scheduled payment date, payment amount, currency, payment type (advance, minimum guarantee installment, per-episode fee, annual license fee), payment status (scheduled, invoiced, paid, overdue), and actual payment date. Enables cash flow forecasting for rights expenditure and feeds the billing domain for invoice generation. | Unity Catalog table: media_broadcasting_ecm.rights.license_fee_schedule Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics. Integrates with Rightsline (rights management).'
}

Table rights.rights_audit_event {
  rights_audit_event_id varchar [pk, note: 'Unique identifier for the rights audit event record. Primary key. | Column rights_audit_event_id (BIGINT) in rights.rights_audit_event']
  approver_user_employee_id varchar [note: 'The system user identifier of the person who approved the rights change. NULL if approval not required or still pending. | Column approver_user_employee_id (BIGINT) in workforce.rights_audit_event']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Rights audit events (unauthorized fee changes, missing clearances, contract breaches) trigger compliance audit findings. Links rights system changes to formal audit findings for SOX and regulatory rev | Column audit_finding_id (BIGINT) in compliance.rights_audit_event']
  media_asset_id varchar [note: 'Identifier of the content asset affected by this rights change. Links to the content domain for cross-domain audit trail analysis. | Column media_asset_id (BIGINT) in mediaasset.rights_audit_event']
  primary_rights_employee_id varchar [note: 'The system user identifier of the person or service account that initiated the rights change. May reference an employee ID, service account, or external system identifier. | Column primary_rights_employee_id (BIGINT) in workforce.rights_audit_event']
  rights_audit_session_id varchar [note: 'Unique identifier for the user session or API session during which the rights change occurred. Supports forensic analysis of user activity patterns. | Column session_id (BIGINT) in rights.rights_audit_event']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in rights.rights_audit_event']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.rights_audit_event']
  affected_entity_business_key varchar [note: 'The human-readable business identifier of the affected entity (e.g., agreement number, grant number, window name) for easier audit trail interpretation. | Column affected_entity_business_key (STRING) in rights.rights_audit_event']
  affected_entity_reference varchar [note: 'The unique identifier of the specific rights domain entity that was modified (e.g., the rights_grant_id, license_agreement_id, or holdback_id). | Column affected_entity_reference (BIGINT) in rights.rights_audit_event']
  affected_entity_type varchar [note: 'The type of rights domain entity that was modified by this audit event (e.g., rights grant, license agreement, content window, holdback record). | Column affected_entity_type (STRING) in rights.rights_audit_event']
  approval_reference_number varchar [note: 'Unique reference number or workflow ticket ID associated with the approval process for cross-system traceability. | Column approval_reference_number (STRING) in rights.rights_audit_event']
  approval_required_flag boolean [note: 'Indicates whether the rights change required formal approval before being committed. True if approval workflow was triggered, False otherwise. | Column approval_required_flag (BOOLEAN) in rights.rights_audit_event']
  approval_status varchar [note: 'Current approval status of the rights change event. Tracks whether the change has been reviewed and authorized per governance policies. | Column approval_status (STRING) in rights.rights_audit_event']
  approval_timestamp timestamp [note: 'Date and time when the rights change was formally approved. NULL if approval not required or still pending. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX | Column approval_timestamp (TIMESTAMP) in rights.rights_audit_event']
  approver_user_name varchar [note: 'The full name or display name of the approver for human-readable audit trail reporting. NULL if approval not required or still pending. | Column approver_user_name (STRING) in rights.rights_audit_event']
  audit_retention_period_days varchar [note: 'Number of days this audit record must be retained per regulatory or legal requirements. Drives data lifecycle management policies. | Column audit_retention_period_days (INT) in rights.rights_audit_event']
  change_reason_code varchar [note: 'Standardized code indicating the business reason for the rights change. [ENUM-REF-CANDIDATE: contract_amendment|rights_expiration|territory_expansion|territory_restriction|holdback_negotiation|clearance_issue|royalty_adjustment|windowing_strategy_update|compliance_requirement|legal_dispute|system_correction|data_migration — promote to reference product] | Column change_reason_code (STRING) in rights.rights_audit_event']
  change_reason_description varchar [note: 'Free-text explanation providing additional context and business justification for the rights change event. | Column change_reason_description (STRING) in rights.rights_audit_event']
  changed_field_name varchar [note: 'The name of the specific attribute or field within the affected entity that was modified (e.g., grant_end_date, holdback_start_date, royalty_rate_percent). | Column changed_field_name (STRING) in rights.rights_audit_event']
  compliance_framework varchar [note: 'The regulatory or compliance framework that mandates audit logging of this rights change event (e.g., SOX for financial controls, FCC for broadcast licensing, Ofcom for UK broadcasting standards). | Column compliance_framework (STRING) in rights.rights_audit_event']
  content_title varchar [note: 'Human-readable title of the content asset affected by this rights change, denormalized for audit report readability. | Column content_title (STRING) in rights.rights_audit_event']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.rights_audit_event']
  created_timestamp timestamp [note: 'Date and time when this audit event record was created in the lakehouse. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Distinct from event_timestamp which captures the source system event time. | Column created_timestamp (TIMESTAMP) in rights.rights_audit_event']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the financial impact amount (e.g., USD, GBP, EUR). NULL if no financial impact. | Column currency_code (STRING) in rights.rights_audit_event']
  dispute_flag boolean [note: 'Indicates whether this rights change is associated with a legal dispute or rights conflict. True if dispute exists, False otherwise. | Column dispute_flag (BOOLEAN) in rights.rights_audit_event']
  dispute_reference_number varchar [note: 'Reference number or case identifier for any legal dispute or rights conflict associated with this change. NULL if no dispute exists. | Column dispute_reference_number (STRING) in rights.rights_audit_event']
  event_timestamp timestamp [note: 'Precise date and time when the rights change event occurred in the source system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX | Column event_timestamp (TIMESTAMP) in rights.rights_audit_event']
  event_type varchar [note: 'Classification of the audit event indicating the nature of the change to the rights domain entity. [ENUM-REF-CANDIDATE: rights_grant_created|rights_grant_modified|rights_grant_terminated|window_created|window_modified|window_deleted|holdback_added|holdback_modified|holdback_removed|agreement_created|agreement_amended|agreement_terminated|clearance_overridden|royalty_adjusted|territory_restriction_added|territory_restriction_removed|exclusivity_changed|sublicense_granted|run_limit_modified — promote to reference product] | Column event_type (STRING) in rights.rights_audit_event']
  financial_impact_amount decimal(18,2) [note: 'Estimated monetary impact of the rights change in the agreement currency. Positive for revenue increases, negative for decreases. NULL if no direct financial impact. | Column financial_impact_amount (DECIMAL(18,2)) in rights.rights_audit_event']
  financial_impact_flag boolean [note: 'Indicates whether this rights change has direct financial implications (e.g., royalty rate change, license fee adjustment, minimum guarantee modification). True if financial impact exists, False otherwise. | Column financial_impact_flag (BOOLEAN) in rights.rights_audit_event']
  initiating_system varchar [note: 'The source system or application that generated the rights change event (e.g., Rightsline, SAP, manual entry, API integration). | Column initiating_system (STRING) in rights.rights_audit_event']
  initiating_user_name varchar [note: 'The full name or display name of the user who initiated the rights change, for human-readable audit trail reporting. | Column initiating_user_name (STRING) in rights.rights_audit_event']
  ip_address varchar [note: 'The IP address from which the rights change was initiated. Supports security audit and geographic access analysis. May be IPv4 or IPv6 format. | Column ip_address (STRING) in rights.rights_audit_event']
  new_value decimal(18,2) [note: 'The value of the changed field after the modification occurred. Stored as string representation to accommodate all data types. NULL for deletion events. | Column new_value (DECIMAL(18,2)) in rights.rights_audit_event']
  previous_value decimal(18,2) [note: 'The value of the changed field before the modification occurred. Stored as string representation to accommodate all data types. NULL for new record creation events. | Column previous_value (DECIMAL(18,2)) in rights.rights_audit_event']
  record_hash varchar [note: 'Cryptographic hash (e.g., SHA-256) of the audit event record to ensure immutability and detect tampering. Supports forensic integrity verification. | Column record_hash (STRING) in rights.rights_audit_event']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in rights.rights_audit_event']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in rights.rights_audit_event']
  territory_affected varchar [note: 'Geographic territory or market affected by the rights change (e.g., USA, GBR, Worldwide). Uses three-letter ISO 3166-1 alpha-3 country codes or territory groupings. | Column territory_affected (STRING) in rights.rights_audit_event']
  transaction_reference varchar [note: 'Unique identifier for the database transaction or batch operation that committed this change. Enables grouping of related audit events within a single transaction. | Column transaction_reference (STRING) in rights.rights_audit_event']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in rights.rights_audit_event']
  window_type_affected varchar [note: 'The content distribution window type affected by this rights change (e.g., theatrical, SVOD, AVOD, TVOD, linear broadcast, syndication). NULL if change does not affect windowing. [ENUM-REF-CANDIDATE: theatrical|SVOD|AVOD|TVOD|linear|syndication|home_video — 7 candidates stripped; promote to reference product] | Column window_type_affected (STRING) in rights.rights_audit_event']

  Note: 'Immutable audit log of all material changes to rights grants, license agreements, content windows, and holdback records within the rights domain. Captures event type (rights grant created, window modified, holdback added, agreement terminated, clearance overridden), the affected entity type and ID, previous and new values of changed fields, change timestamp, initiating user or system, change reason, and approval reference if applicable. Supports regulatory compliance (FCC, Ofcom), legal dispute resolution, and SOX financial audit trails for rights expenditure. | Unity Catalog table: media_broadcasting_ecm.rights.rights_audit_event Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics. Integrates with Rightsline (rights management).'
}

Table rights.rights_audit_session {
