    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attachmentFileNames rdf:type rdf:Property ;
    rdfs:label 'Attachment File Names' ;
    rdfs:comment 'Comma-separated list of file names attached to the notification.' ;
    rdfs:domain ind:AuthNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Notification Source System' ;
    rdfs:comment 'Name of the system that generated and sent the notification (e.g., Pegasystems, QNXT).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageId rdf:type rdf:Property ;
    rdfs:label 'Message Id' ;
    rdfs:comment 'Unique message identifier assigned by the communication platform for tracking.' ;
