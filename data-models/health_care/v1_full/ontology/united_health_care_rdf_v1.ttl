    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationRule .

ind:allocationRuleName rdf:type rdf:Property ;
    rdfs:label 'Allocation Rule Name' ;
    rdfs:comment 'Descriptive name of the allocation rule applied.' ;
