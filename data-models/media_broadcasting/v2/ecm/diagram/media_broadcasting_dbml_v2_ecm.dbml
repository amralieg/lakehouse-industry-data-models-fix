  created_at timestamp [note: 'Record creation timestamp']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  date_of_birth date [note: 'Athlete\'s date of birth.']
  display_name varchar [note: 'Name displayed on broadcasts and graphics.']
  draft_pick varchar [note: 'Overall pick number in the draft.']
  draft_round varchar [note: 'Round in which the athlete was drafted.']
  draft_year varchar [note: 'Year the athlete was drafted (if applicable).']
  first_name varchar [note: 'Athlete\'s first name.']
  headshot_url varchar [note: 'URL to the athlete\'s official headshot image.']
  height_cm varchar [note: 'Athlete\'s height in centimeters.']
  jersey_number varchar [note: 'Current jersey number worn by the athlete.']
  last_name varchar [note: 'Athlete\'s last name.']
  likeness_rights_flag boolean [note: 'Indicates if likeness rights are cleared for promotional use.']
  nationality varchar [note: 'Athlete\'s nationality or country of citizenship.']
  performance_rights_flag boolean [note: 'Indicates if performance rights are cleared for broadcast use of athlete likeness.']
  position varchar [note: 'Playing position (e.g., QB, PG, GK).']
  roster_status varchar [note: 'Current roster status (active, injured reserve, practice squad, etc.).']
  updated_at timestamp [note: 'Record last update timestamp']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']
  weight_kg decimal(5,2) [note: 'Athlete\'s weight in kilograms.']
  years_pro varchar [note: 'Number of years in professional leagues.']

  Note: 'Athlete entity for roster management with jersey number and performance rights tracking'
}

Table sales.ad_order {
  ad_order_id varchar [pk, note: 'Unique identifier for the advertising sales order. Primary key. System-generated surrogate key for the ad order record. | Column ad_order_id (BIGINT) in sales.ad_order']
  advertiser_id varchar [note: 'Reference to the advertiser (brand or company) placing the advertising order. Links to advertiser master record in Salesforce Media Cloud. | Column advertiser_id (BIGINT) in sales.ad_order']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Normalize campaign reference from STRING name to proper FK. Ad order should be linked to campaign master record for rollup reporting and campaign management. Currently denormalized as campaign_name ST | Column campaign_id (BIGINT) in sales.ad_order']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Ad orders are sold by sales teams organized into cost centers. Commission calculation, sales performance analysis, and cost center P&L attribution require linking orders to the responsible cost center | Column cost_center_id (BIGINT) in finance.ad_order']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Ad orders target specific Nielsen demographic segments (A18-49, W25-54, etc.) for campaign planning, rate card pricing, and GRP/TRP guarantees. Core to media buying operations and upfront/scatter deal | Column demographic_segment_id (BIGINT) in audience.ad_order']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Ad orders must verify content rights before booking. Sales teams check license windows daily to ensure spots can legally air during contracted periods. Critical for revenue recognition and compliance. | Column license_agreement_id (BIGINT) in rights.ad_order']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Ad orders often involve content partners (studios, syndicators) whose programming forms the inventory being sold. Real business process: integrated sales where content acquisition and ad sales are coo | Column partner_id (BIGINT) in partner.ad_order']
  primary_ad_employee_id varchar [note: 'Reference to the sales representative responsible for this advertising order. Links to employee/user master record. | Column primary_ad_employee_id (BIGINT) in workforce.ad_order']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Ad orders contribute to profit center performance. Segment EBITDA reporting and business unit P&L require linking orders to profit centers for accurate segment performance measurement and management r | Column profit_center_id (BIGINT) in finance.ad_order']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Ad orders generate revenue that must be classified for ASC 606 revenue recognition and EBITDA reporting. Monthly close process requires linking orders to revenue stream classification for proper finan | Column revenue_stream_id (BIGINT) in finance.ad_order']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser. Nullable if direct advertiser purchase. Links to agency master record. | Column sales_agency_id (BIGINT) in sales.ad_order']
  salesforce_opportunity_id varchar [note: 'External reference to the originating sales opportunity in Salesforce Media Cloud CRM. 15 or 18 character Salesforce record ID. | Column salesforce_opportunity_id (BIGINT) in sales.ad_order']
  subscriber_id varchar [note: 'Foreign key linking to subscriber.subscriber. Business justification: Direct-sold addressable TV ad orders target specific subscribers for personalized advertising. Critical for programmatic guaranteed deals and advanced advertising attribution in streaming platforms. E | Column subscriber_id (BIGINT) in subscriber.ad_order']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.ad_order']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.ad_order']
  affidavit_required_flag boolean [note: 'Indicates whether proof of broadcast affidavits must be provided to the advertiser. True = affidavits required; False = not required. Affidavits document actual air times and are often required for political advertising. | Column affidavit_required_flag (BOOLEAN) in sales.ad_order']
  billing_cycle varchar [note: 'Frequency and timing of invoice generation for this order. Weekly = invoiced every week; Monthly = invoiced monthly; End of Flight = single invoice after campaign completion; Milestone = invoiced at defined campaign milestones. | Column billing_cycle (STRING) in sales.ad_order']
  commission_rate decimal(5,2) [note: 'Agency commission rate as a percentage of gross order value. Standard industry rate is 15%. Applied to calculate net revenue. | Column commission_rate (DECIMAL(5,2)) in sales.ad_order']
  confirmed_timestamp timestamp [note: 'Date and time when the advertising order was confirmed by the advertiser or agency. Marks transition from pending to confirmed status. | Column confirmed_timestamp (TIMESTAMP) in sales.ad_order']
  contracted_cpm decimal(10,2) [note: 'Contracted Cost Per Mille (cost per thousand impressions) for this advertising order. Key pricing metric for media buying. | Column contracted_cpm (DECIMAL(10,2)) in sales.ad_order']
  contracted_cprp decimal(10,2) [note: 'Contracted Cost Per Rating Point. Pricing metric calculated as total cost divided by GRP. Used for market efficiency comparison. | Column contracted_cprp (DECIMAL(10,2)) in sales.ad_order']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.ad_order']
  created_timestamp timestamp [note: 'Date and time when this advertising order record was first created in the system. Audit trail field. | Column created_timestamp (TIMESTAMP) in sales.ad_order']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this order (e.g., USD, GBP, EUR). | Column currency_code (STRING) in sales.ad_order']
  daypart_mix varchar [note: 'Distribution of advertising spots across broadcast dayparts (time segments of broadcast day). Examples: Prime (8pm-11pm), Early Morning (6am-9am), Late Night (11pm-2am). Stored as comma-separated daypart allocations. | Column daypart_mix (STRING) in sales.ad_order']
  discount_percentage decimal(5,2) [note: 'Total discount percentage applied to this order. May include volume discounts, promotional discounts, or negotiated rate reductions. | Column discount_percentage (DECIMAL(5,2)) in sales.ad_order']
  flight_end_date date [note: 'Last date the advertising campaign is scheduled to air. End of the contracted broadcast period. | Column flight_end_date (DATE) in sales.ad_order']
  flight_start_date date [note: 'First date the advertising campaign is scheduled to air. Beginning of the contracted broadcast period. | Column flight_start_date (DATE) in sales.ad_order']
  last_modified_timestamp timestamp [note: 'Date and time when this advertising order record was last updated. Audit trail field for change tracking. | Column last_modified_timestamp (TIMESTAMP) in sales.ad_order']
  makegood_policy varchar [note: 'Policy for providing compensatory ad spots (makegoods) if contracted delivery is not met. Standard = industry-standard makegood terms; Guaranteed = full delivery guarantee; No Makegood = no compensation; Custom = special negotiated terms. | Column makegood_policy (STRING) in sales.ad_order']
  market_code varchar [note: 'Designated Market Area (DMA) or geographic market code where the advertising will air. Used for Nielsen ratings alignment and regional pricing. | Column market_code (STRING) in sales.ad_order']
  mmm_adstock_decay_rate decimal(5,4) [note: 'Rate at which advertising effect decays over time for MMM calculations']
  mmm_channel_contribution decimal(10,4) [note: 'Marketing Mix Model estimated contribution of this channel to conversions']
  mmm_saturation_point decimal(18,2) [note: 'Estimated spend level at which diminishing returns begin for this channel']
  net_order_value decimal(18,2) [note: 'Net revenue value after agency commissions, discounts, and adjustments. Amount recognized for revenue reporting. | Column net_order_value (DECIMAL(18,2)) in sales.ad_order']
  order_notes varchar [note: 'Free-text notes and special instructions for this advertising order. May include trafficking instructions, creative specifications, or client preferences. | Column order_notes (STRING) in sales.ad_order']
  order_number varchar [note: 'Business identifier for the advertising order. Externally-known unique order number used in Wide Orbit traffic system and client communications. Also called broadcast order number or traffic order number. | Column order_number (STRING) in sales.ad_order']
  order_status varchar [note: 'Current lifecycle status of the advertising order. Draft = initial entry; Pending = awaiting approval; Confirmed = accepted by advertiser; Active = currently running; Completed = flight finished; Cancelled = terminated; Invoiced = billed. [ENUM-REF-CANDIDATE: draft|pending|confirmed|active|completed|cancelled|invoiced — 7 candidates stripped; promote to reference product] | Column order_status (STRING) in sales.ad_order']
  order_type varchar [note: 'Classification of the advertising order based on sales method. Upfront = advance advertising sales event; Scatter = last-minute ad inventory sales; Direct = direct advertiser purchase; Programmatic = automated bidding; Sponsorship = integrated brand partnership; Barter = trade arrangement. | Column order_type (STRING) in sales.ad_order']
  payment_terms varchar [note: 'Contractual payment terms for this order (e.g., Net 30, Net 60, Due on Receipt). Defines when payment is due after invoice date. | Column payment_terms (STRING) in sales.ad_order']
  political_ad_flag boolean [note: 'Indicates whether this order contains political advertising content. True = political advertising; False = commercial advertising. Political ads have special FCC disclosure and equal-time requirements. | Column political_ad_flag (BOOLEAN) in sales.ad_order']
  product_category varchar [note: 'Industry classification of the advertised product or service (e.g., automotive, pharmaceutical, retail, financial services). Used for content clearance and regulatory compliance. | Column product_category (STRING) in sales.ad_order']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.ad_order']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.ad_order']
  target_demographic varchar [note: 'Primary audience demographic segment targeted by this advertising order (e.g., Adults 18-49, Women 25-54, Men 18-34). Used for TRP calculation and spot placement. | Column target_demographic (STRING) in sales.ad_order']
  target_grp decimal(10,2) [note: 'Target Gross Rating Points contracted for this order. GRP = Reach × Frequency, measuring total audience delivery weight. Used for campaign performance evaluation. | Column target_grp (DECIMAL(10,2)) in sales.ad_order']
  target_trp decimal(10,2) [note: 'Target Rating Points for specific demographic audience. TRP measures delivery against a defined target audience segment rather than total audience. | Column target_trp (DECIMAL(10,2)) in sales.ad_order']
  total_contracted_value decimal(18,2) [note: 'Total monetary value of the advertising order across all spots and placements. Gross revenue before agency commissions and discounts. | Column total_contracted_value (DECIMAL(18,2)) in sales.ad_order']
  total_spot_count varchar [note: 'Total number of advertising spots (commercial airings) contracted in this order across all placements and dayparts. | Column total_spot_count (INT) in sales.ad_order']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.ad_order']
  wide_orbit_order_reference varchar [note: 'External reference to the corresponding order record in Wide Orbit traffic and billing system. Used for cross-system reconciliation and affidavit generation. | Column wide_orbit_order_reference (STRING) in sales.ad_order']

  Note: 'Master record for an advertising sales order (also called a broadcast order or traffic order) placed by an advertiser or agency. Captures the commercial agreement for a campaign buy including order number, advertiser, agency, account executive, total contracted value, currency, order status (pending, confirmed, cancelled, invoiced), order type (upfront, scatter, direct, programmatic), market, daypart mix, flight dates, billing instructions, Wide Orbit order reference, and Salesforce opportunity linkage. SSOT for the advertising order lifecycle. | Unity Catalog table: media_broadcasting_ecm.sales.ad_order Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.ad_order_line {
  ad_order_line_id varchar [pk, note: 'Unique identifier for the advertising order line item. Primary key. | Column ad_order_line_id (BIGINT) in sales.ad_order_line']
  ad_order_id varchar [note: 'Reference to the parent advertising order header. Links this line item to its containing order. | Column ad_order_id (BIGINT) in sales.ad_order_line']
  channel_id varchar [note: 'Reference to the broadcast network or channel where this ad line will air. Determines distribution outlet. | Column channel_id (BIGINT) in scheduling.ad_order_line']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Each line item specifies demographic target for GRP/TRP delivery guarantees, CPM/CPRP pricing, and makegood determination. Essential for trafficking, billing reconciliation, and audience guarantee com | Column demographic_segment_id (BIGINT) in audience.ad_order_line']
  isci_creative_id varchar [note: 'Foreign key linking to sales.isci_creative. Business justification: Normalize creative reference from STRING business key to proper FK. Order line specifies which creative asset to use for the buy. Currently denormalized as isci_code STRING; should FK to isci_creative | Column isci_creative_id (BIGINT) in sales.ad_order_line']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Line-level rights verification for specific content/daypart combinations. Trafficking requires granular clearance to prevent airing spots during holdback periods or outside licensed windows. Operation | Column license_agreement_id (BIGINT) in rights.ad_order_line']
  makegood_for_line_id varchar [note: 'Reference to the original ad order line that this line is compensating for (if this is a makegood spot). Null if not a makegood. | Column makegood_for_line_id (BIGINT) in sales.ad_order_line']
  scheduling_daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Order lines target specific dayparts for inventory allocation and pricing. Fulfillment tracking, avail matching, and rate card application require linking lines to master daypart definitions. Removes  | Column scheduling_daypart_id (BIGINT) in scheduling.ad_order_line']
  title_id varchar [note: 'Reference to the specific program or show during which the ad spot will air. Used for program-specific targeting. | Column title_id (BIGINT) in content.ad_order_line']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.ad_order_line']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.ad_order_line']
  actual_grp_delivered decimal(10,2) [note: 'Actual Gross Rating Points (GRP) delivered based on Nielsen measurement. Used for campaign performance analysis and makegood calculation. | Column actual_grp_delivered (DECIMAL(10,2)) in sales.ad_order_line']
  actual_impressions_delivered varchar [note: 'Actual number of impressions delivered for this line. Sourced from DAI (Dynamic Ad Insertion) systems or CDN (Content Delivery Network) logs for digital campaigns. | Column actual_impressions_delivered (BIGINT) in sales.ad_order_line']
  actual_spots_aired varchar [note: 'Actual number of spots that successfully aired for this line. Populated from affidavit reconciliation. Used for billing and makegood determination. | Column actual_spots_aired (INT) in sales.ad_order_line']
  attribution_model_type varchar [note: 'Type of attribution model applied (first-touch, last-touch, linear, time-decay, position-based, data-driven)']
  attribution_weight decimal(5,4) [note: 'Fractional credit assigned to this touchpoint in multi-touch attribution']
  competitive_separation_category varchar [note: 'Product or industry category for competitive adjacency restrictions. Prevents competing advertisers from airing in the same pod. | Column competitive_separation_category (STRING) in sales.ad_order_line']
  contracted_grp decimal(10,2) [note: 'Target Gross Rating Points (GRP) contracted for this line. GRP measures total audience reach multiplied by frequency. | Column contracted_grp (DECIMAL(10,2)) in sales.ad_order_line']
  contracted_impressions varchar [note: 'Total number of impressions (individual ad views) contracted for this line item. Used for digital and OTT (Over-The-Top) campaigns. | Column contracted_impressions (BIGINT) in sales.ad_order_line']
  contracted_spots varchar [note: 'Total number of ad spots contracted for this line item. Represents the quantity commitment. | Column contracted_spots (INT) in sales.ad_order_line']
  contracted_trp decimal(10,2) [note: 'Target Rating Points (TRP) contracted for this line. TRP measures reach within a specific demographic target. | Column contracted_trp (DECIMAL(10,2)) in sales.ad_order_line']
  conversion_path_position varchar [note: 'Position of this touchpoint in the customer conversion path']
  copy_split_rule varchar [note: 'Rules defining how multiple creative versions should be split across the contracted spots (e.g., 50/50, 70/30). Used for A/B testing or creative variation. | Column copy_split_rule (STRING) in sales.ad_order_line']
  cpm decimal(10,2) [note: 'Cost Per Mille (CPM) - the cost per thousand impressions. Key pricing metric for advertising efficiency. | Column cpm (DECIMAL(10,2)) in sales.ad_order_line']
  cprp decimal(10,2) [note: 'Cost Per Rating Point (CPRP) - the cost to achieve one rating point. Used to compare efficiency across dayparts and programs. | Column cprp (DECIMAL(10,2)) in sales.ad_order_line']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.ad_order_line']
  created_timestamp timestamp [note: 'Timestamp when this ad order line record was first created in the system. Audit trail for record creation. | Column created_timestamp (TIMESTAMP) in sales.ad_order_line']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values on this line (e.g., USD, GBP, EUR). | Column currency_code (STRING) in sales.ad_order_line']
  discount_percentage decimal(5,2) [note: 'Percentage discount applied to this line (e.g., volume discount, agency commission). Expressed as a percentage (e.g., 15.00 for 15%). | Column discount_percentage (DECIMAL(5,2)) in sales.ad_order_line']
  flight_end_date date [note: 'End date of the advertising flight window for this line item. Defines when spots must complete airing. | Column flight_end_date (DATE) in sales.ad_order_line']
  flight_start_date date [note: 'Start date of the advertising flight window for this line item. Defines when spots can begin airing. | Column flight_start_date (DATE) in sales.ad_order_line']
  inventory_type varchar [note: 'Classification of ad inventory purchase type. Upfront is advance commitment; scatter is last-minute; preemptible can be bumped; makegood compensates for missed spots. | Column inventory_type (STRING) in sales.ad_order_line']
  last_modified_timestamp timestamp [note: 'Timestamp when this ad order line record was last updated. Audit trail for record changes. | Column last_modified_timestamp (TIMESTAMP) in sales.ad_order_line']
  line_number varchar [note: 'Sequential line number within the parent ad order. Determines ordering and display sequence of line items. | Column line_number (INT) in sales.ad_order_line']
  line_status varchar [note: 'Current lifecycle status of the ad order line. Tracks progression from booking through execution and reconciliation. [ENUM-REF-CANDIDATE: booked|confirmed|scheduled|aired|preempted|makegooded|cancelled|expired — 8 candidates stripped; promote to reference product] | Column line_status (STRING) in sales.ad_order_line']
  line_total_amount decimal(15,2) [note: 'Total revenue amount for this line item (unit rate × contracted spots). Base amount before discounts or adjustments. | Column line_total_amount (DECIMAL(15,2)) in sales.ad_order_line']
  net_amount decimal(15,2) [note: 'Net revenue amount after discounts and before taxes. Used for revenue recognition and financial reporting. | Column net_amount (DECIMAL(15,2)) in sales.ad_order_line']
  position_preference varchar [note: 'Preferred position within the ad pod (group of ads in a break). Premium positions command higher rates. | Column position_preference (STRING) in sales.ad_order_line']
  preemption_priority varchar [note: 'Priority level for preemption protection (1=highest, 10=lowest). Lower-priority spots may be bumped for higher-value inventory. | Column preemption_priority (INT) in sales.ad_order_line']
  revenue_recognition_date date [note: 'Date on which revenue for this line is recognized for financial reporting. Typically aligned with air date or campaign completion. | Column revenue_recognition_date (DATE) in sales.ad_order_line']
  rotation_instructions varchar [note: 'Instructions for rotating multiple creatives within this line (e.g., even rotation, weighted rotation, sequential). Guides playout system behavior. | Column rotation_instructions (STRING) in sales.ad_order_line']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.ad_order_line']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.ad_order_line']
  special_handling_notes varchar [note: 'Free-text instructions for special handling requirements (e.g., live read, sponsorship billboard, product integration). Communicated to playout operators. | Column special_handling_notes (STRING) in sales.ad_order_line']
  spot_length_seconds varchar [note: 'Duration of the advertising spot in seconds. Standard lengths are 15, 30, 60, or 120 seconds. | Column spot_length_seconds (INT) in sales.ad_order_line']
  touchpoint_sequence_code varchar [note: 'Identifier linking touchpoints in a conversion path for attribution analysis']
  trafficking_notes varchar [note: 'Internal notes for trafficking team regarding execution details, creative delivery status, or special coordination requirements. | Column trafficking_notes (STRING) in sales.ad_order_line']
  unit_rate decimal(15,2) [note: 'Price per individual ad spot or unit. Base rate before volume discounts or adjustments. | Column unit_rate (DECIMAL(15,2)) in sales.ad_order_line']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.ad_order_line']

  Note: 'Individual line item within an advertising order representing a specific buy unit — a combination of network/channel, daypart, program, spot length, unit rate, contracted GRP/TRP/impression target, and flight window. Each line maps to a specific inventory unit and carries its own status (booked, preempted, makegooded, cancelled). Includes trafficking execution details: assigned ISCI creative(s), rotation instructions, copy split rules, position preferences, competitive adjacency restrictions, and special handling notes for the playout system (Wide Orbit). Sourced from Wide Orbit order line detail. Supports revenue recognition at the line level and feeds affidavit reconciliation. | Unity Catalog table: media_broadcasting_ecm.sales.ad_order_line Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.sales_campaign {
  sales_campaign_id varchar [pk, note: 'Unique identifier for the advertising campaign. Primary key. | Column campaign_id (BIGINT) in sales.campaign']
  advertiser_id varchar [note: 'Reference to the advertiser organization that owns this campaign. | Column advertiser_id (BIGINT) in sales.campaign']
  coppa_declaration_id varchar [note: 'Foreign key linking to compliance.coppa_declaration. Business justification: Campaigns targeting children under 13 require COPPA declarations for data collection and privacy compliance. Broadcasters must link campaigns to declarations documenting parental consent mechanisms, d | Column coppa_declaration_id (BIGINT) in compliance.campaign']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Campaigns are managed by sales teams within cost centers. Campaign ROI analysis and sales team performance measurement require linking campaigns to the responsible cost center for accurate profitabili | Column cost_center_id (BIGINT) in finance.campaign']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Campaigns define primary demographic targets that drive all downstream planning, buying, measurement, and guarantee reconciliation. Core to upfront deals, scatter buying, and Nielsen ratings analysis. | Column demographic_segment_id (BIGINT) in audience.campaign']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Campaign planning depends on content availability windows. Media buyers negotiate campaign flights around rights constraints, especially for premium content. Enables \'available inventory by rights win | Column license_agreement_id (BIGINT) in rights.campaign']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Campaigns frequently involve co-marketing partnerships with content providers, integrated sponsorships, or campaigns tied to partner-supplied content blocks. Real business process: partnership marketi | Column partner_id (BIGINT) in partner.campaign']
  primary_campaign_approved_by_user_employee_id varchar [note: 'Reference to the user who approved the campaign for activation. | Column campaign_approved_by_user_employee_id (BIGINT) in workforce.campaign']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Campaigns represent revenue-generating activities requiring financial classification. ASC 606 performance obligations often align with campaigns. Revenue recognition and contract accounting processes  | Column revenue_stream_id (BIGINT) in finance.campaign']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser for this campaign. Nullable if direct advertiser relationship. | Column sales_agency_id (BIGINT) in sales.campaign']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Brand ambassador and celebrity spokesperson campaigns must track featured talent for exclusivity enforcement, usage rights validation, residual calculations, and clearance verification across all camp | Column talent_profile_id (BIGINT) in talent.campaign']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.campaign']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.campaign']
  approved_timestamp timestamp [note: 'Timestamp when the campaign was approved and moved from draft or proposed status to active status. | Column approved_timestamp (TIMESTAMP) in sales.campaign']
  attribution_model_type varchar [note: 'Type of attribution model applied (first-touch, last-touch, linear, time-decay, position-based, data-driven)']
  attribution_weight decimal(5,4) [note: 'Fractional credit assigned to this touchpoint in multi-touch attribution']
  campaign_code varchar [note: 'External business identifier or code for the campaign used in trafficking and billing systems. | Column campaign_code (STRING) in sales.campaign']
  campaign_name varchar [note: 'Business name of the advertising campaign used for identification and reporting. | Column campaign_name (STRING) in sales.campaign']
  campaign_status varchar [note: 'Current lifecycle status of the advertising campaign. [ENUM-REF-CANDIDATE: draft|proposed|approved|active|paused|completed|cancelled — 7 candidates stripped; promote to reference product] | Column campaign_status (STRING) in sales.campaign']
  campaign_type varchar [note: 'Classification of the campaign objective and strategy. | Column campaign_type (STRING) in sales.campaign']
  conversion_path_position varchar [note: 'Position of this touchpoint in the customer conversion path']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.campaign']
  created_timestamp timestamp [note: 'Timestamp when this campaign record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.campaign']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this campaign. | Column currency_code (STRING) in sales.campaign']
  end_date date [note: 'The date when the campaign is scheduled to end. Nullable for ongoing campaigns. | Column end_date (DATE) in sales.campaign']
  makegood_eligible_flag boolean [note: 'Indicates whether this campaign is eligible for makegood compensatory ad spots if contracted delivery targets are not met. | Column makegood_eligible_flag (BOOLEAN) in sales.campaign']
  market_type varchar [note: 'Geographic market scope classification for the campaign. | Column market_type (STRING) in sales.campaign']
  mmm_adstock_decay_rate decimal(5,4) [note: 'Rate at which advertising effect decays over time for MMM calculations']
  mmm_channel_contribution decimal(10,4) [note: 'Marketing Mix Model estimated contribution of this channel to conversions']
  mmm_saturation_point decimal(18,2) [note: 'Estimated spend level at which diminishing returns begin for this channel']
  modified_timestamp timestamp [note: 'Timestamp when this campaign record was last modified. | Column modified_timestamp (TIMESTAMP) in sales.campaign']
  notes varchar [note: 'Free-form text field for additional campaign instructions, special requirements, or internal notes. | Column notes (STRING) in sales.campaign']
  priority_level varchar [note: 'Priority classification for ad inventory allocation and scheduling conflicts. | Column priority_level (STRING) in sales.campaign']
  product_brand varchar [note: 'The product, service, or brand being advertised in this campaign. | Column product_brand (STRING) in sales.campaign']
  programmatic_enabled_flag boolean [note: 'Flag indicating programmatic campaign']
  sales_channel varchar [note: 'The sales channel through which the campaign was sold (upfront advance sales, scatter last-minute, programmatic automated, direct negotiated, or sponsorship). | Column sales_channel (STRING) in sales.campaign']
  salesforce_campaign_reference varchar [note: 'External reference identifier linking to the campaign record in Salesforce Media Cloud CRM system. | Column salesforce_campaign_reference (STRING) in sales.campaign']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.campaign']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.campaign']
  start_date date [note: 'The date when the campaign is scheduled to begin airing or serving ads. | Column start_date (DATE) in sales.campaign']
  target_cpm decimal(10,2) [note: 'Contracted target Cost Per Mille representing the cost per thousand impressions. | Column target_cpm (DECIMAL(10,2)) in sales.campaign']
  target_cprp decimal(10,2) [note: 'Contracted target Cost Per Rating Point representing the cost to achieve one rating point. | Column target_cprp (DECIMAL(10,2)) in sales.campaign']
  target_frequency decimal(5,2) [note: 'Contracted average number of times each unique audience member should be exposed to the campaign. | Column target_frequency (DECIMAL(5,2)) in sales.campaign']
  target_grp decimal(10,2) [note: 'Contracted target Gross Rating Points representing the total audience reach multiplied by frequency goal for the campaign. | Column target_grp (DECIMAL(10,2)) in sales.campaign']
  target_impressions varchar [note: 'Contracted total number of ad impressions to be delivered across the campaign. | Column target_impressions (BIGINT) in sales.campaign']
  target_reach_percent decimal(5,2) [note: 'Contracted percentage of unique audience members to be reached by the campaign. | Column target_reach_percent (DECIMAL(5,2)) in sales.campaign']
  target_sov_percent decimal(5,2) [note: 'Contracted target Share of Voice representing the percentage of total advertising impressions in the category or daypart. | Column target_sov_percent (DECIMAL(5,2)) in sales.campaign']
  target_trp decimal(10,2) [note: 'Contracted target Target Rating Points representing reach and frequency goals for a specific demographic segment. | Column target_trp (DECIMAL(10,2)) in sales.campaign']
  total_budget_amount decimal(18,2) [note: 'The total contracted budget amount for the entire campaign across all flights and orders. | Column total_budget_amount (DECIMAL(18,2)) in sales.campaign']
  touchpoint_sequence_code varchar [note: 'Identifier linking touchpoints in a conversion path for attribution analysis']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.campaign']

  Note: 'Advertising campaign master record representing the strategic grouping of ad orders and flights for a single advertiser objective. Tracks campaign name, advertiser, product/brand being advertised, campaign type (brand awareness, direct response, political, sponsorship), total budget, contracted reach and frequency targets, GRP/TRP goals, SOV targets, campaign status, start and end dates, and Salesforce Media Cloud campaign reference. Parent entity above ad orders and flights. | Unity Catalog table: media_broadcasting_ecm.sales.campaign'
}

Table sales.advertiser {
  advertiser_id varchar [pk, note: 'Unique identifier for the advertiser record. Primary key. | Column advertiser_id (BIGINT) in sales.advertiser']
  primary_advertiser_created_by_user_employee_id varchar [note: 'The user identifier of the person who created this advertiser record. | Column advertiser_created_by_user_employee_id (BIGINT) in workforce.advertiser']
  sales_account_id varchar [note: 'The Salesforce Media Cloud account reference linking this advertiser to CRM opportunities, campaigns, and proposals. | Column sales_account_id (BIGINT) in sales.advertiser']
  sales_agency_id varchar [note: 'The identifier of the advertising agency that places media buys on behalf of this advertiser, if applicable. Null if the advertiser buys direct. | Column sales_agency_id (BIGINT) in sales.advertiser']
  tertiary_advertiser_updated_by_user_employee_id varchar [note: 'The user identifier of the person who last modified this advertiser record. | Column advertiser_updated_by_user_employee_id (BIGINT) in workforce.advertiser']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.advertiser']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.advertiser']
  account_status varchar [note: 'Current lifecycle status of the advertiser account indicating whether the advertiser is actively purchasing inventory. | Column account_status (STRING) in sales.advertiser']
  annual_spend_tier varchar [note: 'The classification tier based on annual advertising spend volume, used for pricing, service level, and upfront negotiation priority. | Column annual_spend_tier (STRING) in sales.advertiser']
  billing_address_line1 varchar [note: 'The primary street address line for billing and invoice delivery. | Column billing_address_line1 (STRING) in sales.advertiser']
  billing_address_line2 varchar [note: 'The secondary address line for suite, floor, or building information. | Column billing_address_line2 (STRING) in sales.advertiser']
  billing_city varchar [note: 'The city or municipality for the billing address. | Column billing_city (STRING) in sales.advertiser']
  billing_country_code varchar [note: 'The three-letter ISO country code for the billing address (e.g., USA, CAN, GBR). | Column billing_country_code (STRING) in sales.advertiser']
  billing_postal_code varchar [note: 'The postal or ZIP code for the billing address. | Column billing_postal_code (STRING) in sales.advertiser']
  billing_state_province varchar [note: 'The state, province, or region for the billing address. | Column billing_state_province (STRING) in sales.advertiser']
  contract_end_date date [note: 'The expiration date of the current master advertising services agreement or upfront deal, if applicable. | Column contract_end_date (DATE) in sales.advertiser']
  contract_start_date date [note: 'The effective start date of the current master advertising services agreement or upfront deal. | Column contract_start_date (DATE) in sales.advertiser']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.advertiser']
  created_timestamp timestamp [note: 'The timestamp when this advertiser record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.advertiser']
  credit_limit_amount decimal(15,2) [note: 'The maximum outstanding balance allowed for this advertiser before credit hold is applied, in USD. | Column credit_limit_amount (DECIMAL(15,2)) in sales.advertiser']
  credit_status varchar [note: 'The credit approval status indicating whether the advertiser is authorized to purchase advertising on credit terms. | Column credit_status (STRING) in sales.advertiser']
  industry_category varchar [note: 'The Interactive Advertising Bureau (IAB) taxonomy category classifying the advertiser\'s primary business vertical (e.g., Automotive, Financial Services, Consumer Packaged Goods). | Column industry_category (STRING) in sales.advertiser']
  is_political_advertiser boolean [note: 'Boolean flag indicating whether this advertiser is a political candidate, party, or issue advocacy group subject to FCC political advertising disclosure requirements. | Column is_political_advertiser (BOOLEAN) in sales.advertiser']
  legal_name varchar [note: 'The full legal registered name of the advertising client or brand as it appears on contracts and invoices. | Column legal_name (STRING) in sales.advertiser']
  notes varchar [note: 'Free-text field for internal notes regarding special handling instructions, account history, or relationship management details. | Column notes (STRING) in sales.advertiser']
  parent_company_name varchar [note: 'The name of the parent or holding company if the advertiser is a subsidiary or brand within a larger corporate structure. | Column parent_company_name (STRING) in sales.advertiser']
  payment_terms varchar [note: 'The contractual payment terms specifying when payment is due after invoice date (e.g., Net 30, Net 60). | Column payment_terms (STRING) in sales.advertiser']
  preferred_currency_code varchar [note: 'The three-letter ISO currency code for invoicing and financial reporting (e.g., USD, EUR, GBP). | Column preferred_currency_code (STRING) in sales.advertiser']
  primary_contact_email varchar [note: 'The email address of the primary business contact for campaign communications and invoice delivery. | Column primary_contact_email (STRING) in sales.advertiser']
  primary_contact_name varchar [note: 'The full name of the primary business contact at the advertiser organization for campaign coordination and billing inquiries. | Column primary_contact_name (STRING) in sales.advertiser']
  primary_contact_phone varchar [note: 'The business phone number of the primary contact for urgent campaign or billing matters. | Column primary_contact_phone (STRING) in sales.advertiser']
  requires_ad_clearance boolean [note: 'Boolean flag indicating whether this advertiser\'s creative content requires pre-broadcast clearance review due to industry category (e.g., pharmaceuticals, alcohol, financial services). | Column requires_ad_clearance (BOOLEAN) in sales.advertiser']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.advertiser']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.advertiser']
  tax_identifier varchar [note: 'The advertiser\'s federal tax identification number (EIN in USA, VAT number in EU) used for tax reporting and invoicing. | Column tax_identifier (STRING) in sales.advertiser']
  trade_name varchar [note: 'The doing-business-as (DBA) or brand name used in advertising campaigns and public-facing materials. | Column trade_name (STRING) in sales.advertiser']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.advertiser']
  updated_timestamp timestamp [note: 'The timestamp when this advertiser record was last modified. | Column updated_timestamp (TIMESTAMP) in sales.advertiser']
  website_url varchar [note: 'The primary website URL of the advertiser for brand reference and campaign landing page validation. | Column website_url (STRING) in sales.advertiser']
  wide_orbit_advertiser_code varchar [note: 'The unique advertiser identifier in the Wide Orbit traffic and billing system, used for ad scheduling, sales orders, and invoicing. | Column wide_orbit_advertiser_code (STRING) in sales.advertiser']

  Note: 'Master record for an advertising client (brand or direct advertiser) purchasing airtime or digital inventory. Captures advertiser legal name, trade name, industry category (IAB taxonomy), parent company, billing address, credit limit, credit status, payment terms, tax ID, Salesforce account reference, Wide Orbit advertiser code, and account manager assignment. Distinct from the agency that places buys on behalf of the advertiser. SSOT for advertiser identity within the advertising domain. | Unity Catalog table: media_broadcasting_ecm.sales.advertiser Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.sales_agency {
  sales_agency_id varchar [pk, note: 'Unique identifier for the advertising agency or media buying firm. Primary key. | Column sales_agency_id (BIGINT) in sales.sales_agency']
  sales_account_id varchar [note: 'Reference identifier linking this agency to its corresponding account record in Salesforce Media Cloud CRM for tracking opportunities, campaigns, and proposals. | Column sales_account_id (BIGINT) in sales.sales_agency']
  sales_talent_agency_id varchar [note: 'Foreign key to SSOT talent.talent_agency']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sales_agency']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sales_agency']
  accreditation_date date [note: 'Date when the agency was granted accreditation status by the broadcaster or industry body. | Column accreditation_date (DATE) in sales.sales_agency']
  accreditation_expiry_date date [note: 'Date when the current accreditation status expires and requires renewal. Nullable for indefinite accreditation. | Column accreditation_expiry_date (DATE) in sales.sales_agency']
  accreditation_status varchar [note: 'Current accreditation status of the agency with industry bodies or the broadcaster, indicating creditworthiness and eligibility for commission-based billing. | Column accreditation_status (STRING) in sales.sales_agency']
  agency_type varchar [note: 'Classification of the agency based on its primary service offering and operational model. | Column agency_type (STRING) in sales.sales_agency']
  billing_address_line1 varchar [note: 'First line of the agency\'s billing address where invoices and financial correspondence should be sent. | Column billing_address_line1 (STRING) in sales.sales_agency']
  billing_address_line2 varchar [note: 'Second line of the agency\'s billing address (suite, floor, building name). Nullable. | Column billing_address_line2 (STRING) in sales.sales_agency']
  billing_city varchar [note: 'City name for the agency\'s billing address. | Column billing_city (STRING) in sales.sales_agency']
  billing_country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the agency\'s billing address (e.g., USA, CAN, GBR). | Column billing_country_code (STRING) in sales.sales_agency']
  billing_model varchar [note: 'Billing methodology used for this agency. Gross: agency bills advertiser full amount and remits net to broadcaster. Net: broadcaster bills agency net amount. Hybrid: mixed approach. | Column billing_model (STRING) in sales.sales_agency']
  billing_postal_code varchar [note: 'Postal or ZIP code for the agency\'s billing address. | Column billing_postal_code (STRING) in sales.sales_agency']
  billing_state_province varchar [note: 'State or province code for the agency\'s billing address (e.g., NY, CA, ON). | Column billing_state_province (STRING) in sales.sales_agency']
  commission_rate decimal(5,4) [note: 'Standard commission percentage rate applied to media buys placed by this agency, expressed as a decimal (e.g., 0.1500 for 15%). Used for commission calculation and billing split. | Column commission_rate (DECIMAL(5,4)) in sales.sales_agency']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sales_agency']
  created_timestamp timestamp [note: 'Timestamp when this agency record was first created in the system. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column created_timestamp (TIMESTAMP) in sales.sales_agency']
  credit_limit decimal(15,2) [note: 'Maximum credit amount (in base currency) extended to the agency for outstanding ad orders before payment is required. Used for credit risk management. | Column credit_limit (DECIMAL(15,2)) in sales.sales_agency']
  holding_company_group varchar [note: 'Name of the parent holding company or agency network to which this agency belongs (e.g., WPP, Omnicom, Publicis, IPG, Dentsu). Null if independent. | Column holding_company_group (STRING) in sales.sales_agency']
  modified_by varchar [note: 'User identifier or system account that last modified this agency record. Used for audit trail and change tracking. | Column modified_by (STRING) in sales.sales_agency']
  modified_timestamp timestamp [note: 'Timestamp when this agency record was last modified. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column modified_timestamp (TIMESTAMP) in sales.sales_agency']
  notes varchar [note: 'Free-form text field for additional notes, special instructions, or historical context about the agency relationship. | Column notes (STRING) in sales.sales_agency']
  onboarding_date date [note: 'Date when the agency was first onboarded and approved to place advertising orders with the broadcaster. | Column onboarding_date (DATE) in sales.sales_agency']
  payment_terms_days varchar [note: 'Standard number of days allowed for payment after invoice date (e.g., 30, 60, 90). Used for accounts receivable and cash flow forecasting. | Column payment_terms_days (INT) in sales.sales_agency']
  preferred_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the agency\'s preferred billing currency (e.g., USD, CAD, GBP, EUR). | Column preferred_currency_code (STRING) in sales.sales_agency']
  primary_contact_email varchar [note: 'Email address of the primary business contact at the agency for order confirmations, affidavits, and campaign communications. | Column primary_contact_email (STRING) in sales.sales_agency']
  primary_contact_name varchar [note: 'Full name of the primary business contact or account executive at the agency responsible for media buying and campaign coordination. | Column primary_contact_name (STRING) in sales.sales_agency']
  primary_contact_phone varchar [note: 'Primary telephone number for the agency contact, used for urgent campaign coordination and makegood processing. | Column primary_contact_phone (STRING) in sales.sales_agency']
  sales_agency_name varchar [note: 'Full legal or trade name of the advertising agency or media buying firm. | Column sales_agency_name (STRING) in sales.sales_agency']
  sales_agency_status varchar [note: 'Current operational status of the agency relationship. Active agencies can place orders; inactive/suspended/terminated agencies cannot. | Column sales_agency_status (STRING) in sales.sales_agency']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sales_agency']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sales_agency']
  status_reason varchar [note: 'Explanation or business reason for the current status, particularly for inactive, suspended, or terminated statuses (e.g., credit issues, contract expiration, voluntary closure). | Column status_reason (STRING) in sales.sales_agency']
  tax_identifier varchar [note: 'Government-issued tax identification number for the agency (e.g., EIN in USA, VAT number in EU) used for tax reporting and compliance. | Column tax_identifier (STRING) in sales.sales_agency']
  termination_date date [note: 'Date when the agency relationship was terminated or the agency ceased operations. Nullable for active agencies. | Column termination_date (DATE) in sales.sales_agency']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sales_agency']
  website_url varchar [note: 'Official website URL of the advertising agency for reference and verification purposes. | Column website_url (STRING) in sales.sales_agency']
  wide_orbit_agency_code varchar [note: 'Unique agency identifier code used in the Wide Orbit traffic and billing system for ad scheduling, sales orders, and invoicing. | Column wide_orbit_agency_code (STRING) in sales.sales_agency']
  created_by varchar [note: 'User identifier or system account that created this agency record. Used for audit trail and data lineage. | Column created_by (STRING) in sales.sales_agency']

  Note: 'Master record for an advertising agency or media buying firm that places ad orders on behalf of advertisers. Captures agency name, agency type (full-service, media buying, digital, programmatic), holding company group, commission rate, billing model (gross/net), contact details, Wide Orbit agency code, Salesforce account reference, and accreditation status. Tracks the agency-advertiser relationship for commission calculation and billing split. | Unity Catalog table: media_broadcasting_ecm.sales.sales_agency Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.ad_spot {
  ad_spot_id varchar [pk, note: 'Unique identifier for the individual advertisement spot placement. Primary key for the ad spot entity. | Column ad_spot_id (BIGINT) in sales.ad_spot']
  abr_profile_id varchar [note: 'Foreign key linking to distribution.abr_profile. Business justification: ABR profile determines video quality for ad creative delivery. Broadcasters track which profile was used per spot to verify creative rendering quality, troubleshoot playback issues, and optimize ad en | Column abr_profile_id (BIGINT) in distribution.ad_spot']
  ad_order_line_id varchar [note: 'Reference to the parent ad order line that booked this spot. Links the spot to the commercial agreement and campaign. | Column ad_order_line_id (BIGINT) in sales.ad_spot']
  ad_pod_id varchar [note: 'Identifier for the ad pod (commercial break) containing this spot. Groups all spots that aired in the same break. | Column ad_pod_id (BIGINT) in sales.ad_spot']
  advertiser_id varchar [note: 'Identifier for the advertiser (brand or company) whose creative aired in this spot. Links to advertiser master data. | Column advertiser_id (BIGINT) in sales.ad_spot']
  campaign_id varchar [note: 'Identifier for the advertising campaign this spot belongs to. Groups related spots for performance analysis and reporting. | Column campaign_id (BIGINT) in sales.ad_spot']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: Individual ad spot airings require closed caption compliance tracking for FCC accessibility regulations. Broadcasters must document caption accuracy, completeness, and synchronization for each aired s | Column closed_caption_record_id (BIGINT) in compliance.ad_spot']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Individual spots are trafficked and measured against specific demographic targets for GRP/TRP delivery, makegood determination, and affidavit reconciliation. Essential for Nielsen ratings matching and | Column demographic_segment_id (BIGINT) in audience.ad_spot']
  device_type_id varchar [note: 'Foreign key linking to distribution.device_type. Business justification: Ad delivery systems track device type per spot to verify creative compatibility (resolution, codec, DRM), measure device-specific performance, and support device-targeted campaigns. Critical for devic | Column device_type_id (BIGINT) in distribution.ad_spot']
  isci_creative_id varchar [note: 'Foreign key linking to sales.isci_creative. Business justification: Normalize creative reference from STRING business key (isci_code) to proper FK. Ad spot must reference the creative asset that aired. Currently denormalized as isci_code STRING; should FK to isci_crea | Column isci_creative_id (BIGINT) in sales.ad_spot']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Spot-level rights validation at playout prevents airing content outside licensed windows. Playout systems check license_agreement status in real-time. Required for affidavit generation and rights hold | Column license_agreement_id (BIGINT) in rights.ad_spot']
  original_spot_ad_spot_id varchar [note: 'Reference to the original ad spot that this makegood spot is compensating for. Populated only when makegood_flag is true. | Column original_spot_ad_spot_id (BIGINT) in sales.ad_spot']
  revenue_recognition_event_id varchar [note: 'Foreign key linking to finance.revenue_recognition_event. Business justification: Each aired spot triggers revenue recognition under ASC 606. Daily revenue recognition close and billing reconciliation require linking spots to recognition events for accurate revenue accounting and a | Column revenue_recognition_event_id (BIGINT) in finance.ad_spot']
  sales_agency_id varchar [note: 'Identifier for the advertising agency that placed this spot on behalf of the advertiser. May be null for direct advertiser buys. | Column sales_agency_id (BIGINT) in sales.ad_spot']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: Spots air within specific schedule slots. Affidavit generation, as-run reconciliation, and delivery verification require linking each spot to the exact slot it occupied. No existing column fits; creat | Column schedule_slot_id (BIGINT) in scheduling.ad_spot']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: Ad spots in OTT/FAST environments are delivered through specific streaming endpoints. Broadcasters track endpoint-per-spot for delivery verification, QoS monitoring, CDN cost allocation, and billing r | Column streaming_endpoint_id (BIGINT) in distribution.ad_spot']
  subscriber_id varchar [note: 'Foreign key linking to subscriber.subscriber. Business justification: Addressable ad spot delivery tracking links each aired spot to the subscriber who viewed it. Essential for frequency capping, attribution, personalized ad delivery, and subscriber-level impression rec | Column subscriber_id (BIGINT) in subscriber.ad_spot']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Ad spots air during specific titles. Business process: traffic logs, affidavits, program-level ad performance analysis, Nielsen C3/C7 ratings reconciliation, content adjacency compliance. | Column title_id (BIGINT) in content.ad_spot']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.ad_spot']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.ad_spot']
  actual_air_time timestamp [note: 'The actual date and time when this ad spot aired, as recorded in the broadcast affidavit. Used for proof of performance and billing reconciliation. | Column actual_air_time (TIMESTAMP) in sales.ad_spot']
  ad_pod_position varchar [note: 'Sequential position of this spot within the ad pod (group of ads in a commercial break). Position 1 is the first ad in the break. Pod position affects viewer attention and pricing. | Column ad_pod_position (INT) in sales.ad_spot']
  affidavit_reference varchar [note: 'Reference to the broadcast affidavit (proof of performance document) that certifies this spot aired as scheduled. Required for billing and advertiser verification. | Column affidavit_reference (STRING) in sales.ad_spot']
  attribution_model_type varchar [note: 'Type of attribution model applied (first-touch, last-touch, linear, time-decay, position-based, data-driven)']
  attribution_weight decimal(5,4) [note: 'Fractional credit assigned to this touchpoint in multi-touch attribution']
  billing_status varchar [note: 'Current billing status of this spot. Tracks the spot through the billing lifecycle from unbilled through payment or dispute resolution. | Column billing_status (STRING) in sales.ad_spot']
  bonus_spot_flag boolean [note: 'Indicates whether this spot was provided as a bonus (added value) to the advertiser at no additional charge. Used for revenue recognition and campaign value calculation. | Column bonus_spot_flag (BOOLEAN) in sales.ad_spot']
  channel_code varchar [note: 'Code identifying the broadcast channel or network where the spot aired (e.g., ABC, NBC, ESPN). Links to channel master data. | Column channel_code (STRING) in sales.ad_spot']
  conversion_path_position varchar [note: 'Position of this touchpoint in the customer conversion path']
  cpm_amount decimal(10,2) [note: 'Cost per thousand impressions for this spot. Key pricing metric in advertising sales used to compare efficiency across different placements. | Column cpm_amount (DECIMAL(10,2)) in sales.ad_spot']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.ad_spot']
  created_timestamp timestamp [note: 'Date and time when this ad spot record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in sales.ad_spot']
  dai_flag boolean [note: 'Indicates whether this spot was delivered via Dynamic Ad Insertion technology, allowing personalized ad delivery to different viewers or platforms. | Column dai_flag (BOOLEAN) in sales.ad_spot']
  daypart varchar [note: 'Time segment of the broadcast day when the spot aired. Dayparts are used for pricing, audience targeting, and inventory management. Standard dayparts include early morning (6-9am), daytime (9am-4pm), early fringe (4-6pm), prime access (6-8pm), prime time (8-11pm), late fringe (11pm-12am), late night (12-2am), and overnight (2-6am). [ENUM-REF-CANDIDATE: early_morning|daytime|early_fringe|prime_access|prime_time|late_fringe|late_night|overnight — 8 candidates stripped; promote to reference product] | Column daypart (STRING) in sales.ad_spot']
  delivery_platform varchar [note: 'Platform through which the ad spot was delivered. Distinguishes between linear broadcast, OTT (Over-The-Top), VOD (Video On Demand), SVOD (Subscription VOD), AVOD (Ad-Supported VOD), TVOD (Transactional VOD), FAST (Free Ad-Supported Streaming TV), and simulcast delivery. [ENUM-REF-CANDIDATE: linear|ott|vod|svod|avod|tvod|fast|simulcast — 8 candidates stripped; promote to reference product] | Column delivery_platform (STRING) in sales.ad_spot']
  grp_value decimal(8,2) [note: 'Gross Rating Point value delivered by this spot. Measures the size of the audience reached relative to the total market population. Sum of all rating points across the campaign. | Column grp_value (DECIMAL(8,2)) in sales.ad_spot']
  impressions_delivered varchar [note: 'Total number of impressions (views) delivered by this spot. Used for performance measurement and billing reconciliation. | Column impressions_delivered (BIGINT) in sales.ad_spot']
  makegood_flag boolean [note: 'Indicates whether this spot is a makegood (compensatory ad spot provided to an advertiser due to a previous preemption or underdelivery). | Column makegood_flag (BOOLEAN) in sales.ad_spot']
  market_code varchar [note: 'Designated Market Area (DMA) or geographic market code where the spot aired. Used for regional campaign tracking and market-specific pricing. | Column market_code (STRING) in sales.ad_spot']
  modified_timestamp timestamp [note: 'Date and time when this ad spot record was last modified. Tracks changes to scheduling, status, or other attributes. | Column modified_timestamp (TIMESTAMP) in sales.ad_spot']
  preempted_flag boolean [note: 'Indicates whether this spot was preempted (bumped from its scheduled time slot). Preempted spots typically require makegood compensation. | Column preempted_flag (BOOLEAN) in sales.ad_spot']
  preemption_reason varchar [note: 'Explanation for why the spot was preempted, if applicable. Common reasons include breaking news, technical issues, programming overrun, or higher-priority advertiser. | Column preemption_reason (STRING) in sales.ad_spot']
  rotation_pattern varchar [note: 'Describes the rotation or sequencing pattern for this spot within the campaign (e.g., ROS - Run of Schedule, fixed position, alternating). Used for inventory management and fulfillment. | Column rotation_pattern (STRING) in sales.ad_spot']
  scheduled_air_date date [note: 'The date on which this ad spot was scheduled to air. Used for planning and inventory management. | Column scheduled_air_date (DATE) in sales.ad_spot']
  scheduled_air_time timestamp [note: 'The precise date and time when this ad spot was scheduled to air. Includes timezone information for accurate cross-platform scheduling. | Column scheduled_air_time (TIMESTAMP) in sales.ad_spot']
  separation_requirement varchar [note: 'Specifies any separation rules for this spot (e.g., competitive separation, minimum time between airings). Ensures advertiser requirements are met. | Column separation_requirement (STRING) in sales.ad_spot']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.ad_spot']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.ad_spot']
  spot_length_seconds varchar [note: 'Duration of the advertisement spot in seconds. Common values include 15, 30, 60, 90, and 120 seconds. | Column spot_length_seconds (INT) in sales.ad_spot']
  spot_rate_amount decimal(15,2) [note: 'The rate charged for this individual spot placement. May differ from the order line rate due to daypart, program, or inventory adjustments. | Column spot_rate_amount (DECIMAL(15,2)) in sales.ad_spot']
  spot_rate_currency varchar [note: 'Three-letter ISO 4217 currency code for the spot rate amount (e.g., USD, GBP, EUR). | Column spot_rate_currency (STRING) in sales.ad_spot']
  spot_status varchar [note: 'Current lifecycle status of the ad spot. Tracks whether the spot was scheduled, successfully aired, preempted, cancelled, or requires makegood processing. | Column spot_status (STRING) in sales.ad_spot']
  touchpoint_sequence_code varchar [note: 'Identifier linking touchpoints in a conversion path for attribution analysis']
  traffic_log_reference varchar [note: 'Reference identifier to the Wide Orbit traffic log entry that scheduled and tracked this spot. Used for audit trail and reconciliation. | Column traffic_log_reference (STRING) in sales.ad_spot']
  trp_value decimal(8,2) [note: 'Target Rating Point value delivered by this spot. Measures audience reach within a specific demographic target segment, more precise than GRP. | Column trp_value (DECIMAL(8,2)) in sales.ad_spot']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.ad_spot']

  Note: 'Individual scheduled advertisement placement (spot) within a broadcast or digital break. Represents the atomic unit of ad delivery — a single commercial airing with ISCI code, spot length (seconds), scheduled air date and time, channel/network, program, daypart, pod position, actual air time (from affidavit), preemption flag, makegoood flag, DAI flag, and Wide Orbit traffic log reference. Links to the ad order line that booked it and the creative (isci) that aired. | Unity Catalog table: media_broadcasting_ecm.sales.ad_spot Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.isci_creative {
  isci_creative_id varchar [pk, note: 'Unique identifier for the advertising creative asset record. Primary key for the ISCI creative entity. | Column isci_creative_id (BIGINT) in sales.isci_creative']
  advertiser_id varchar [note: 'Reference to the advertiser (client company) that owns this creative asset. Links to the advertiser master record in the advertising domain. | Column advertiser_id (BIGINT) in sales.isci_creative']
  brand_id varchar [note: 'Reference to the specific brand or product line being promoted in this creative. Links to the brand master record. | Column brand_id (BIGINT) in sales.isci_creative']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Creative content requires age-appropriate ratings for daypart placement and regulatory compliance. Broadcasters must verify ratings match target demographics and time slots, ensuring children\'s progra | Column compliance_content_rating_id (BIGINT) in compliance.isci_creative']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: ISCI creatives must reference the master media asset containing the actual ad content file for trafficking, playout, and compliance verification. Core operational link between ad clearance and media a | Column media_asset_id (BIGINT) in mediaasset.isci_creative']
  previous_version_isci_creative_id varchar [note: 'Reference to the immediately preceding version of this creative, if this is a revision. Null for the original version. Enables version lineage tracking. | Column previous_version_isci_creative_id (BIGINT) in sales.isci_creative']
  primary_isci_employee_id varchar [note: 'Reference to the user who created this creative record in the system. Used for audit trail and accountability. | Column primary_isci_employee_id (BIGINT) in workforce.isci_creative']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Creative assets featuring talent require direct linkage for clearance status verification, usage rights validation, residual payment trigger calculation when spots air, and exclusivity conflict detect | Column talent_profile_id (BIGINT) in talent.isci_creative']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.isci_creative']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.isci_creative']
  ad_standards_clearance_id varchar [note: 'Foreign key linking to compliance.ad_standards_clearance. Business justification: Creative assets must pass ad standards clearance before airing. Broadcasters track clearance approval status, rejection reasons, and certificate numbers for each ISCI code to ensure only approved cont | Column ad_standards_clearance_id (BIGINT) in sales.isci_creative']
  approval_status varchar [note: 'Current state of the creative in the internal approval workflow. Tracks progression from draft through review to final approval or rejection. Only approved creatives can be trafficked for broadcast. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|revision_required|expired — 7 candidates stripped; promote to reference product] | Column approval_status (STRING) in sales.isci_creative']
  aspect_ratio varchar [note: 'The proportional relationship between width and height of the video creative. Standard ratios include 16:9 (HD/widescreen), 4:3 (SD), 1:1 (square/social), 9:16 (vertical/mobile), and 21:9 (cinematic). | Column aspect_ratio (NUMERIC) in sales.isci_creative']
  audio_standard varchar [note: 'The audio encoding and channel configuration standard used in the creative. Includes stereo, surround sound formats (Dolby Digital, Dolby Atmos, DTS), and codec specifications (AAC). | Column audio_standard (STRING) in sales.isci_creative']
  checksum_md5 varchar [note: 'MD5 hash of the creative asset file used for integrity verification during transfer and playout. Ensures the file has not been corrupted or tampered with. | Column checksum_md5 (STRING) in sales.isci_creative']
  closed_caption_available boolean [note: 'Indicates whether closed captioning (subtitles for the deaf and hard of hearing) is embedded or available for this creative. Required for FCC compliance on broadcast television. | Column closed_caption_available (BOOLEAN) in sales.isci_creative']
  codec varchar [note: 'The video compression codec used to encode the creative. Common codecs include H.264 (AVC), H.265 (HEVC), ProRes, DNxHD, MPEG-2, VP9, and AV1. Impacts file size, quality, and playback compatibility. [ENUM-REF-CANDIDATE: h264|h265|prores|dnxhd|mpeg2|vp9|av1 — 7 candidates stripped; promote to reference product] | Column codec (STRING) in sales.isci_creative']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.isci_creative']
  created_timestamp timestamp [note: 'The date and time when this creative record was first created in the system. Immutable audit field. | Column created_timestamp (TIMESTAMP) in sales.isci_creative']
  creative_description varchar [note: 'Detailed narrative description of the creative content, messaging, and visual elements. Used for trafficking, clearance review, and internal reference. | Column creative_description (STRING) in sales.isci_creative']
  creative_format varchar [note: 'The media format and delivery channel for which this creative is designed. Determines playout system routing and technical specifications. [ENUM-REF-CANDIDATE: linear_tv|digital_pre_roll|digital_mid_roll|digital_post_roll|audio_radio|audio_podcast|ott_streaming|social_media|display_banner — 9 candidates stripped; promote to reference product] | Column creative_format (STRING) in sales.isci_creative']
  creative_title varchar [note: 'The human-readable name or title of the advertising creative, typically describing the campaign theme or message (e.g., \'Summer Sale 2024\', \'New Product Launch\'). | Column creative_title (STRING) in sales.isci_creative']
  dalet_asset_reference varchar [note: 'Reference identifier linking this ISCI creative record to the corresponding digital asset file stored in the Dalet Galaxy Media Asset Management system. Used for asset retrieval and playout automation. | Column dalet_asset_reference (STRING) in sales.isci_creative']
  effective_end_date date [note: 'The date after which this creative is no longer authorized to air or be distributed. Enforces campaign end dates, product discontinuations, and time-sensitive offers. Null for open-ended creatives. | Column effective_end_date (DATE) in sales.isci_creative']
  effective_start_date date [note: 'The date from which this creative is authorized to air or be distributed. Enforces campaign timing and seasonal restrictions. | Column effective_start_date (DATE) in sales.isci_creative']
  expiry_date date [note: 'The date on which the creative record and associated clearances expire and must be renewed or retired. Distinct from effective_end_date; this represents the end of the creative\'s lifecycle validity. | Column expiry_date (DATE) in sales.isci_creative']
  file_format varchar [note: 'The digital container format of the creative asset file. Common video formats include MP4, MOV, MXF, AVI; audio formats include MP3, WAV, AAC. Determines compatibility with playout and MAM systems. [ENUM-REF-CANDIDATE: mp4|mov|mxf|avi|wmv|mpg|mp3|wav|aac — 9 candidates stripped; promote to reference product] | Column file_format (STRING) in sales.isci_creative']
  file_size_mb decimal(10,2) [note: 'The size of the creative asset file in megabytes. Used for storage planning, bandwidth estimation, and delivery optimization. | Column file_size_mb (DECIMAL(10,2)) in sales.isci_creative']
  frame_rate decimal(18,2) [note: 'The number of frames per second (fps) in the video creative. Standard rates include 23.976/24 (film), 25 (PAL), 29.97/30 (NTSC), and 50/60 (high frame rate). Must match broadcast or streaming platform requirements. | Column frame_rate (DECIMAL(18,2)) in sales.isci_creative']
  is_active boolean [note: 'Indicates whether this creative record is currently active and available for trafficking and playout. Inactive creatives are retained for historical reference but cannot be scheduled. | Column is_active (BOOLEAN) in sales.isci_creative']
  isci_code varchar [note: 'The standardized 12-character alphanumeric code uniquely identifying a commercial creative in the advertising industry. Format: 4-character advertiser code + 4-character brand code + 1-character media type (H=TV, M=Radio, V=Digital) + 3-digit sequence. This is the externally-known business identifier used across trafficking, playout, and affidavit systems. | Column isci_code (STRING) in sales.isci_creative']
  language_code varchar [note: 'The primary language of the creative audio and text content, expressed as ISO 639-1 two-letter code (e.g., \'en\' for English, \'es\' for Spanish) with optional ISO 3166-1 country code (e.g., \'en-US\', \'es-MX\'). | Column language_code (STRING) in sales.isci_creative']
  last_modified_timestamp timestamp [note: 'The date and time when this creative record was most recently modified. Updated on every change for audit trail. | Column last_modified_timestamp (TIMESTAMP) in sales.isci_creative']
  political_ad_indicator boolean [note: 'Indicates whether this creative is a political advertisement subject to FCC political advertising disclosure and equal time requirements. Triggers mandatory public inspection file documentation. | Column political_ad_indicator (BOOLEAN) in sales.isci_creative']
  product_category varchar [note: 'The industry classification of the product or service being advertised (e.g., automotive, pharmaceuticals, financial services, food and beverage). Used for competitive separation and regulatory compliance. | Column product_category (STRING) in sales.isci_creative']
  restricted_content_flags varchar [note: 'Comma-separated list of content restriction flags indicating special handling requirements (e.g., \'alcohol\', \'gambling\', \'political\', \'pharmaceutical\', \'tobacco\'). Triggers daypart restrictions and disclosure requirements. | Column restricted_content_flags (STRING) in sales.isci_creative']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.isci_creative']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.isci_creative']
  spot_length_seconds varchar [note: 'Duration of the commercial spot in seconds. Standard broadcast lengths include 15, 30, 60, 90, and 120 seconds. Critical for ad pod scheduling and inventory management. | Column spot_length_seconds (INT) in sales.isci_creative']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.isci_creative']
  version_number varchar [note: 'Sequential version number for this creative. Increments when revisions are made to the creative content or metadata. Supports version history and rollback. | Column version_number (INT) in sales.isci_creative']
  video_resolution varchar [note: 'The pixel resolution of the video creative. Standard resolutions include SD (480p), HD (720p/1080p), and UHD (4K/8K). Determines quality tier and bandwidth requirements. | Column video_resolution (STRING) in sales.isci_creative']

  Note: 'Master record for an advertising creative asset identified by its ISCI (Industry Standard Commercial Identification) code. Captures ISCI code, advertiser, brand, creative title, spot length, creative format (linear TV, digital pre-roll, audio, OTT), aspect ratio, audio standard, approval status, clearance status, expiry date, and Dalet Galaxy asset reference. SSOT for creative identity and clearance within the advertising workflow. Distinct from the digital asset file managed in the digitalasset domain. | Unity Catalog table: media_broadcasting_ecm.sales.isci_creative Wide Orbit traffic system integration supported. Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.ad_pod {
  ad_pod_id varchar [pk, note: 'Unique identifier for the advertising pod. Primary key. | Column ad_pod_id (BIGINT) in sales.ad_pod']
  ad_program_title_id varchar [note: 'Reference to the program or content episode during which this ad pod airs. | Column program_title_id (BIGINT) in content.ad_pod']
  ad_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Ad pods are embedded within title airings. Business process: dynamic ad insertion planning, SCTE-35 cue point management, break placement optimization, pod-level inventory forecasting by title. | Column title_id (BIGINT) in content.ad_pod']
  channel_id varchar [note: 'Reference to the broadcast or streaming channel where this ad pod is scheduled. | Column channel_id (BIGINT) in scheduling.ad_pod']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: Ad pods within programming require caption compliance verification for FCC accessibility obligations. Broadcasters track caption delivery, accuracy scores, and exemption status at the pod level to ens | Column closed_caption_record_id (BIGINT) in compliance.ad_pod']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Pod placement within licensed content requires rights verification. Ad ops checks license status before scheduling pods into programs. Prevents selling inventory in content with expired or restricted  | Column license_agreement_id (BIGINT) in rights.ad_pod']
  program_schedule_id varchar [note: 'Reference to the program schedule entry that contains this ad pod. | Column schedule_id (BIGINT) in scheduling.ad_pod']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.ad_pod']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.ad_pod']
  actual_end_time timestamp [note: 'Actual date and time when the ad pod concluded airing, used for billing reconciliation and performance verification. | Column actual_end_time (TIMESTAMP) in sales.ad_pod']
  actual_start_time timestamp [note: 'Actual date and time when the ad pod began airing, captured from playout automation for affidavit generation and makegood processing. | Column actual_start_time (TIMESTAMP) in sales.ad_pod']
  alcohol_ad_allowed_flag boolean [note: 'Indicates whether alcohol advertising is permitted within this ad pod, based on daypart restrictions and content adjacency policies. | Column alcohol_ad_allowed_flag (BOOLEAN) in sales.ad_pod']
  audience_target_demo varchar [note: 'Primary demographic audience segment targeted by this ad pod, typically expressed in age-gender format (e.g., A18-49, W25-54, M18-34) per Nielsen measurement standards. | Column audience_target_demo (STRING) in sales.ad_pod']
  blackout_flag boolean [note: 'Indicates whether this ad pod is subject to geographic broadcast restrictions or blackout rules, preventing distribution in certain markets. | Column blackout_flag (BOOLEAN) in sales.ad_pod']
  break_position varchar [note: 'Position of the ad break within the program content flow. Pre-roll occurs before content starts, mid-roll during content, post-roll after content ends, interstitial between segments, bumper as short transition, and outro at program conclusion. | Column break_position (STRING) in sales.ad_pod']
  content_rating varchar [note: 'TV Parental Guidelines rating of the program content surrounding this ad pod, used to ensure advertiser suitability and compliance with content adjacency requirements. | Column content_rating (STRING) in sales.ad_pod']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.ad_pod']
  created_timestamp timestamp [note: 'Date and time when this ad pod record was first created in the system, used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in sales.ad_pod']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values associated with this ad pod (e.g., USD, GBP, EUR). | Column currency_code (STRING) in sales.ad_pod']
  dai_enabled_flag boolean [note: 'Indicates whether this ad pod supports Dynamic Ad Insertion for personalized, server-side ad stitching in streaming environments. | Column dai_enabled_flag (BOOLEAN) in sales.ad_pod']
  daypart varchar [note: 'Time segment of the broadcast day during which this ad pod airs, used for audience targeting and pricing. Early morning (6-9 AM), daytime (9 AM-4 PM), early fringe (4-6 PM), prime access (6-8 PM), prime time (8-11 PM), late fringe (11 PM-midnight), late night (midnight-2 AM), overnight (2-6 AM). [ENUM-REF-CANDIDATE: early_morning|daytime|early_fringe|prime_access|prime_time|late_fringe|late_night|overnight — 8 candidates stripped; promote to reference product] | Column daypart (STRING) in sales.ad_pod']
  estimated_grp decimal(10,2) [note: 'Projected Gross Rating Points for this ad pod, representing the sum of all rating points delivered across all spots within the pod. | Column estimated_grp (DECIMAL(10,2)) in sales.ad_pod']
  estimated_reach varchar [note: 'Projected unique audience count (in thousands) expected to view this ad pod, based on historical ratings and program performance. | Column estimated_reach (INT) in sales.ad_pod']
  geographic_market_code varchar [note: 'Nielsen Designated Market Area (DMA) code or equivalent geographic market identifier where this ad pod airs, used for regional targeting and blackout enforcement. | Column geographic_market_code (STRING) in sales.ad_pod']
  inventory_class varchar [note: 'Classification of the ad pod inventory by pricing tier and sales priority. Premium for high-demand slots, standard for regular inventory, remnant for unsold last-minute inventory, bonus for value-added makegoods. | Column inventory_class (STRING) in sales.ad_pod']
  last_modified_timestamp timestamp [note: 'Date and time when this ad pod record was most recently updated, used for change tracking and reconciliation. | Column last_modified_timestamp (TIMESTAMP) in sales.ad_pod']
  max_spot_count varchar [note: 'Maximum number of individual ad spots that can be scheduled within this pod, governing inventory capacity. | Column max_spot_count (INT) in sales.ad_pod']
  notes varchar [note: 'Free-form text field for additional comments, special instructions, or operational notes related to this ad pod. | Column notes (STRING) in sales.ad_pod']
  platform_type varchar [note: 'Distribution platform type for this ad pod. Linear for traditional scheduled broadcast, VOD (Video On Demand) for on-demand viewing, SVOD (Subscription Video On Demand) for subscription services, AVOD (Advertising-Supported Video On Demand) for ad-supported streaming, TVOD (Transactional Video On Demand) for pay-per-view, OTT (Over-The-Top) for internet delivery, FAST (Free Ad-Supported Streaming Television) for linear streaming channels. [ENUM-REF-CANDIDATE: linear|vod|svod|avod|tvod|ott|fast — 7 candidates stripped; promote to reference product] | Column platform_type (STRING) in sales.ad_pod']
  pod_code varchar [note: 'Unique business identifier or code for the ad pod used in trafficking and billing systems. | Column pod_code (STRING) in sales.ad_pod']
  pod_duration_seconds varchar [note: 'Total duration of the ad pod in seconds, representing the maximum time allocated for all ad spots within this break. | Column pod_duration_seconds (INT) in sales.ad_pod']
  pod_name varchar [note: 'Human-readable name or label for the ad pod, often used for internal identification and trafficking purposes. | Column pod_name (STRING) in sales.ad_pod']
  pod_rate_card_cpm decimal(12,2) [note: 'Standard rate card Cost Per Mille (cost per thousand impressions) for this ad pod, used as the baseline pricing for inventory sales negotiations. | Column pod_rate_card_cpm (DECIMAL(12,2)) in sales.ad_pod']
  pod_status varchar [note: 'Current lifecycle status of the ad pod. Scheduled indicates planned but not locked, confirmed indicates inventory committed, aired indicates successfully broadcast, preempted indicates replaced by higher-priority content, cancelled indicates removed from schedule, makegoods_required indicates compensatory spots needed due to delivery issues. | Column pod_status (STRING) in sales.ad_pod']
  pod_type varchar [note: 'Classification of the ad pod by content purpose. Commercial for paid advertising, promotional for network self-promotion, PSA (Public Service Announcement) for non-profit messaging, network for national inventory, affiliate for station-level inventory, local for regional inventory. | Column pod_type (STRING) in sales.ad_pod']
  political_ad_allowed_flag boolean [note: 'Indicates whether political advertising is permitted within this ad pod, subject to FCC equal time and disclosure requirements. | Column political_ad_allowed_flag (BOOLEAN) in sales.ad_pod']
  sales_market varchar [note: 'Market channel through which the ad pod inventory was sold. Upfront for advance commitment sales, scatter for last-minute inventory sales, programmatic for automated bidding platforms, direct for one-on-one advertiser deals. | Column sales_market (STRING) in sales.ad_pod']
  scheduled_end_time timestamp [note: 'Planned date and time when the ad pod is scheduled to conclude, calculated from start time plus pod duration. | Column scheduled_end_time (TIMESTAMP) in sales.ad_pod']
  scheduled_start_time timestamp [note: 'Planned date and time when the ad pod is scheduled to begin airing, in ISO 8601 format with timezone. | Column scheduled_start_time (TIMESTAMP) in sales.ad_pod']
  scte35_cue_point_reference varchar [note: 'Reference identifier for the SCTE-35 (Society of Cable Telecommunications Engineers) cue point that triggers this ad pod insertion in the broadcast stream. | Column scte35_cue_point_reference (STRING) in sales.ad_pod']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.ad_pod']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.ad_pod']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.ad_pod']

  Note: 'Definition of an advertising break pod within a program or channel schedule — the container that holds a sequence of ad spots. Captures pod ID, channel, program, break position (pre-roll, mid-roll, post-roll, interstitial), pod duration (seconds), maximum spot count, pod type (commercial, promotional, PSA), SCTE-35 cue point reference, and DAI-enabled flag. Governs inventory capacity and break structure for trafficking and DAI systems. | Unity Catalog table: media_broadcasting_ecm.sales.ad_pod Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.affidavit {
  affidavit_id varchar [pk, note: 'Primary key for affidavit | Column affidavit_id (BIGINT) in sales.affidavit']
  ad_sales_order_id varchar [note: 'Reference to the sales order that authorized this ad spot placement. | Column ad_sales_order_id (BIGINT) in sales.affidavit']
  ad_spot_id varchar [note: 'Reference to the contracted advertising spot that this affidavit confirms aired. | Column ad_spot_id (BIGINT) in sales.affidavit']
  advertiser_id varchar [note: 'Reference to the advertiser (client) who purchased the ad spot and to whom this affidavit is issued. | Column advertiser_id (BIGINT) in sales.affidavit']
  advertising_makegood_id varchar [note: 'Reference to the makegood order created to compensate for this discrepancy, if applicable. | Column advertising_makegood_id (BIGINT) in sales.affidavit']
  campaign_id varchar [note: 'Reference to the advertising campaign under which this spot was scheduled and aired. | Column campaign_id (BIGINT) in sales.affidavit']
  channel_id varchar [note: 'Reference to the broadcast channel or network on which the ad spot aired. | Column channel_id (BIGINT) in scheduling.affidavit']
  employee_id varchar [note: 'Reference to the user who verified and approved this affidavit for billing purposes. | Column employee_id (BIGINT) in workforce.affidavit']
  invoice_id varchar [note: 'Reference to the invoice on which this affidavit was included for billing purposes. | Column invoice_id (BIGINT) in billing.affidavit']
  isci_creative_id varchar [note: 'Foreign key linking to sales.isci_creative. Business justification: Normalize creative reference in proof-of-broadcast record. Affidavit confirms which creative actually aired. Currently denormalized as isci_code STRING; should FK to isci_creative master for referenti | Column isci_creative_id (BIGINT) in sales.affidavit']
  public_inspection_file_id varchar [note: 'Foreign key linking to compliance.public_inspection_file. Business justification: Political advertising affidavits must be maintained in the public inspection file per FCC rules. Broadcasters link affidavits to public file entries documenting actual air dates, times, and rates char | Column public_inspection_file_id (BIGINT) in compliance.affidavit']
  revenue_recognition_event_id varchar [note: 'Foreign key linking to finance.revenue_recognition_event. Business justification: Affidavits provide proof of performance for ASC 606 revenue recognition. Revenue assurance and external audit processes require linking affidavits to recognition events for compliance and audit trail  | Column revenue_recognition_event_id (BIGINT) in finance.affidavit']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser, if applicable. | Column sales_agency_id (BIGINT) in sales.affidavit']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: Affidavits verify spot delivery within specific schedule slots. Already links to channel, but slot-level granularity is required for accurate as-run verification and makegood determination. Creating n | Column schedule_slot_id (BIGINT) in scheduling.affidavit']
  title_id varchar [note: 'Reference to the program during which the ad spot aired. | Column title_id (BIGINT) in content.affidavit']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.affidavit']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.affidavit']
  actual_air_date date [note: 'The date the ad spot actually aired as confirmed by playout system logs. | Column actual_air_date (DATE) in sales.affidavit']
  actual_air_time timestamp [note: 'The precise date and time the ad spot actually aired as confirmed by playout system logs. This is the principal business event timestamp for the affidavit. | Column actual_air_time (TIMESTAMP) in sales.affidavit']
  actual_spot_length_seconds varchar [note: 'The actual duration in seconds that the ad spot aired as measured by playout system. | Column actual_spot_length_seconds (INT) in sales.affidavit']
  ad_pod_position varchar [note: 'Position of this ad spot within the ad pod (group of ads in a commercial break). First position is 1. | Column ad_pod_position (INT) in sales.affidavit']
  affidavit_number varchar [note: 'Business identifier for the affidavit document. Externally-known unique reference number used for billing finalization and compliance documentation. | Column affidavit_number (STRING) in sales.affidavit']
  billing_amount decimal(15,2) [note: 'The amount billed for this ad spot as documented in this affidavit. Used for revenue recognition and reconciliation. | Column billing_amount (DECIMAL(15,2)) in sales.affidavit']
  compliance_flag boolean [note: 'Indicates whether this affidavit meets all regulatory and contractual compliance requirements for FCC documentation and audit purposes. | Column compliance_flag (BOOLEAN) in sales.affidavit']
  contracted_spot_length_seconds varchar [note: 'The duration in seconds that was contracted and paid for in the sales order. | Column contracted_spot_length_seconds (INT) in sales.affidavit']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.affidavit']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the billing amount. | Column currency_code (STRING) in sales.affidavit']
  daypart varchar [note: 'Time segment of the broadcast day during which the ad aired. Used for pricing and audience targeting analysis. [ENUM-REF-CANDIDATE: early_morning|morning|daytime|early_fringe|prime_access|prime_time|late_fringe|overnight — 8 candidates stripped; promote to reference product] | Column daypart (STRING) in sales.affidavit']
  delivery_method varchar [note: 'Method by which the affidavit document was delivered to the advertiser or agency. | Column delivery_method (STRING) in sales.affidavit']
  delivery_timestamp timestamp [note: 'Date and time when the affidavit was delivered to the advertiser or agency. | Column delivery_timestamp (TIMESTAMP) in sales.affidavit']
  discrepancy_description varchar [note: 'Detailed explanation of the discrepancy, including root cause and impact. Used for makegood processing and client communication. | Column discrepancy_description (STRING) in sales.affidavit']
  discrepancy_flag boolean [note: 'Indicates whether there was any discrepancy between the contracted spot parameters and what actually aired. True if discrepancy exists, False if spot aired as contracted. | Column discrepancy_flag (BOOLEAN) in sales.affidavit']
  discrepancy_type varchar [note: 'Classification of the type of discrepancy if one occurred. None indicates spot aired exactly as contracted. [ENUM-REF-CANDIDATE: wrong_time|wrong_length|preempted|wrong_creative|wrong_channel|missed|none — 7 candidates stripped; promote to reference product] | Column discrepancy_type (STRING) in sales.affidavit']
  generation_timestamp timestamp [note: 'Date and time when this affidavit record was first generated by the traffic system. This is the record audit created timestamp. | Column generation_timestamp (TIMESTAMP) in sales.affidavit']
  last_modified_timestamp timestamp [note: 'Date and time when this affidavit record was last updated. Used for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in sales.affidavit']
  makegood_required_flag boolean [note: 'Indicates whether a compensatory ad spot (makegood) must be scheduled due to the discrepancy. True triggers makegood workflow. | Column makegood_required_flag (BOOLEAN) in sales.affidavit']
  notes varchar [note: 'Additional notes or comments regarding this affidavit, including special circumstances, client communications, or internal annotations. | Column notes (STRING) in sales.affidavit']
  playout_system_log_reference varchar [note: 'Reference to the playout automation system log entry that provides technical proof of broadcast. | Column playout_system_log_reference (STRING) in sales.affidavit']
  preemption_reason varchar [note: 'Explanation for why the ad spot was preempted if applicable. Common reasons include breaking news, emergency alerts, or programming overruns. | Column preemption_reason (STRING) in sales.affidavit']
  reconciliation_status varchar [note: 'Current status of the affidavit in the billing reconciliation workflow. Approved status enables invoice finalization. | Column reconciliation_status (STRING) in sales.affidavit']
  scheduled_air_date date [note: 'The date the ad spot was originally contracted and scheduled to air. | Column scheduled_air_date (DATE) in sales.affidavit']
  scheduled_air_time timestamp [note: 'The precise date and time the ad spot was originally contracted and scheduled to air. | Column scheduled_air_time (TIMESTAMP) in sales.affidavit']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.affidavit']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.affidavit']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.affidavit']
  verification_method varchar [note: 'Method used to verify that the ad spot aired as documented in this affidavit. | Column verification_method (STRING) in sales.affidavit']
  verification_timestamp timestamp [note: 'Date and time when the affidavit was verified and approved for billing. | Column verification_timestamp (TIMESTAMP) in sales.affidavit']
  wide_orbit_affidavit_reference varchar [note: 'External reference identifier from the Wide Orbit traffic and billing system for cross-system reconciliation. | Column wide_orbit_affidavit_reference (STRING) in sales.affidavit']

  Note: 'Proof-of-broadcast affidavit record confirming that a contracted ad spot actually aired as scheduled. Captures affidavit number, ad spot reference, actual air date and time, channel, program, ISCI code, spot length, discrepancy flag (aired vs. contracted), discrepancy type (wrong time, wrong length, preempted, wrong creative), Wide Orbit affidavit reference, and reconciliation status. Required for billing finalization, makegood triggering, and FCC compliance documentation. | Unity Catalog table: media_broadcasting_ecm.sales.affidavit Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.makegood {
  makegood_id varchar [pk, note: 'Primary key for makegood | Column makegood_id (BIGINT) in sales.makegood']
  ad_order_id varchar [note: 'Reference to the parent advertising order under which the original spot was booked. | Column ad_order_id (BIGINT) in sales.makegood']
  advertiser_id varchar [note: 'Reference to the advertiser who purchased the original ad spot and is entitled to the makegood. | Column advertiser_id (BIGINT) in sales.makegood']
  approved_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Makegood resolution requires approval by operations manager or account executive to authorize replacement inventory and confirm advertiser acceptance. Replaces text \'approved_by\' field with proper FK  | Column approved_by_employee_id (BIGINT) in workforce.makegood']
  cost_allocation_id varchar [note: 'Foreign key linking to finance.cost_allocation. Business justification: Makegoods represent cost of service delivery failures. Cost of quality reporting and operational cost allocation require linking makegoods to cost allocation records for accurate cost center accountab | Column cost_allocation_id (BIGINT) in finance.makegood']
  original_ad_spot_id varchar [note: 'Reference to the original ad spot that failed to air as scheduled and triggered this makegood. | Column original_ad_spot_id (BIGINT) in sales.makegood']
  original_isci_creative_id varchar [note: 'Foreign key linking to sales.isci_creative. Business justification: Normalize creative reference for the original spot being made good. Makegood record needs to reference which creative was supposed to air originally. Currently denormalized as original_isci_code STRIN | Column original_isci_creative_id (BIGINT) in sales.makegood']
  primary_makegood_original_channel_id varchar [note: 'Reference to the channel on which the original ad spot was scheduled to air. | Column makegood_original_channel_id (BIGINT) in scheduling.makegood']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser in the makegood negotiation, if applicable. | Column sales_agency_id (BIGINT) in sales.makegood']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.makegood']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.makegood']
  actual_air_date date [note: 'The date on which the makegood replacement spot actually aired, confirming fulfillment. | Column actual_air_date (DATE) in sales.makegood']
  actual_air_time timestamp [note: 'The precise timestamp at which the makegood replacement spot actually aired. | Column actual_air_time (TIMESTAMP) in sales.makegood']
  affidavit_date date [note: 'The date on which the affidavit for the makegood spot was generated and issued. | Column affidavit_date (DATE) in sales.makegood']
  affidavit_generated_flag boolean [note: 'Indicates whether a proof-of-broadcast affidavit has been generated for the aired makegood spot. | Column affidavit_generated_flag (BOOLEAN) in sales.makegood']
  approval_date date [note: 'The date on which the advertiser or agency approved the makegood proposal. | Column approval_date (DATE) in sales.makegood']
  approval_status varchar [note: 'Current status of the makegood proposal in the advertiser/agency approval workflow. | Column approval_status (STRING) in sales.makegood']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.makegood']
  created_timestamp timestamp [note: 'The timestamp when this makegood record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.makegood']
  last_modified_timestamp timestamp [note: 'The timestamp when this makegood record was last updated. | Column last_modified_timestamp (TIMESTAMP) in sales.makegood']
  makegood_number varchar [note: 'Business identifier for the makegood record, used in external communications and affidavits. | Column makegood_number (STRING) in sales.makegood']
  notes varchar [note: 'Free-form text field for additional comments, negotiation history, or special instructions related to the makegood. | Column notes (STRING) in sales.makegood']
  original_actual_grp decimal(10,2) [note: 'The actual GRP delivered by the original spot if it aired but underperformed, triggering a ratings shortfall makegood. | Column original_actual_grp (DECIMAL(10,2)) in sales.makegood']
  original_contracted_grp decimal(10,2) [note: 'The GRP value that was contracted for the original ad spot, used to assess audience underdelivery. | Column original_contracted_grp (DECIMAL(10,2)) in sales.makegood']
  original_daypart varchar [note: 'The broadcast daypart (time segment) in which the original spot was scheduled, such as Prime, Early Fringe, Late Night. | Column original_daypart (STRING) in sales.makegood']
  original_program_name varchar [note: 'The name of the program during which the original ad spot was scheduled to air. | Column original_program_name (STRING) in sales.makegood']
  original_scheduled_date date [note: 'The date on which the original ad spot was scheduled to air before the failure occurred. | Column original_scheduled_date (DATE) in sales.makegood']
  original_scheduled_time timestamp [note: 'The precise timestamp at which the original ad spot was scheduled to air. | Column original_scheduled_time (TIMESTAMP) in sales.makegood']
  original_spot_length_seconds varchar [note: 'The duration in seconds of the original ad spot that failed to air. | Column original_spot_length_seconds (INT) in sales.makegood']
  original_spot_rate decimal(15,2) [note: 'The contracted rate (in USD) for the original ad spot that failed to air. | Column original_spot_rate (DECIMAL(15,2)) in sales.makegood']
  proposed_daypart varchar [note: 'The broadcast daypart proposed for the makegood replacement spot. | Column proposed_daypart (STRING) in sales.makegood']
  proposed_estimated_grp decimal(10,2) [note: 'The estimated GRP that the proposed makegood replacement spot is expected to deliver. | Column proposed_estimated_grp (DECIMAL(10,2)) in sales.makegood']
  proposed_program_name varchar [note: 'The name of the program during which the makegood replacement spot is proposed to air. | Column proposed_program_name (STRING) in sales.makegood']
  proposed_replacement_date date [note: 'The date proposed by the broadcaster for airing the makegood replacement spot. | Column proposed_replacement_date (DATE) in sales.makegood']
  proposed_replacement_time timestamp [note: 'The precise timestamp proposed for airing the makegood replacement spot. | Column proposed_replacement_time (TIMESTAMP) in sales.makegood']
  proposed_spot_length_seconds varchar [note: 'The duration in seconds of the proposed makegood replacement spot. | Column proposed_spot_length_seconds (INT) in sales.makegood']
  reason_code varchar [note: 'Categorical code indicating why the original spot failed to air and a makegood was issued. | Column reason_code (STRING) in sales.makegood']
  reason_description varchar [note: 'Detailed narrative explanation of the circumstances that led to the makegood issuance. | Column reason_description (STRING) in sales.makegood']
  rejection_reason varchar [note: 'Explanation provided by the advertiser or agency if the makegood proposal was rejected. | Column rejection_reason (STRING) in sales.makegood']
  resolution_status varchar [note: 'Current lifecycle status of the makegood record, tracking whether it has been fulfilled or remains outstanding. | Column resolution_status (STRING) in sales.makegood']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.makegood']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.makegood']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.makegood']

  Note: 'Compensatory ad spot record issued when a contracted spot fails to air as scheduled (due to preemption, technical failure, or audience underdelivery). Captures makegood ID, original ad spot reference, reason code (preemption, technical, ratings shortfall), proposed replacement spot details (channel, date, time, daypart, program), advertiser/agency approval status, approval date, and resolution status. Tracks the full makegood negotiation and fulfillment lifecycle. | Unity Catalog table: media_broadcasting_ecm.sales.makegood Wide Orbit traffic system integration supported. Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.sales_proposal {
  sales_proposal_id varchar [pk, note: 'Unique identifier for the sales proposal. Primary key for this entity. | Column sales_proposal_id (BIGINT) in sales.sales_proposal']
  advertiser_id varchar [note: 'Reference to the advertiser organization to whom this proposal is being submitted. The ultimate client purchasing the advertising inventory. | Column advertiser_id (BIGINT) in sales.sales_proposal']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Proposals are submitted to billing accounts for contract execution. Proposal approval workflows, contract management, and proposal-to-invoice conversion tracking require direct linkage to the billing  | Column billing_account_id (BIGINT) in billing.sales_proposal']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Proposals for facility-dependent services (studio rental, satellite uplink, transmission services) must reference the specific facility for accurate costing, availability confirmation, and SLA definit | Column broadcast_facility_id (BIGINT) in technology.sales_proposal']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Proposals specify primary channel for inventory offering. Sales teams build proposals around channel audience profiles and ratings. Business process: proposal generation, inventory packaging, channel- | Column channel_id (BIGINT) in scheduling.sales_proposal']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Proposals are prepared against cost center budgets for resource allocation and approval workflows. Enables budget availability checks and cost center-based approval routing in media sales operations. | Column cost_center_id (BIGINT) in finance.sales_proposal']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Proposals specify demographic targets for reach/frequency planning, GRP/TRP projections, and CPM/CPRP pricing. Essential for sales process, rate card application, and client presentation. Replaces den | Column demographic_segment_id (BIGINT) in audience.sales_proposal']
  employee_id varchar [note: 'Reference to the sales representative or account executive responsible for this proposal. | Column employee_id (BIGINT) in workforce.sales_proposal']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Proposals must reference available content rights. Sales cannot propose inventory in content without valid licenses. Enables \'proposable inventory by rights window\' validation before client presentati | Column license_agreement_id (BIGINT) in rights.sales_proposal']
  primary_sales_rep_id varchar [note: 'Reference to the sales account executive responsible for this proposal and the advertiser relationship. | Column primary_sales_rep_id (BIGINT) in sales.sales_proposal']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Proposals must be tagged to profit centers for segment-level pipeline visibility and revenue planning. Supports quarterly business review by segment and profit center revenue forecasting processes. | Column profit_center_id (BIGINT) in finance.sales_proposal']
  rate_card_id varchar [note: 'Reference to the primary rate card used as the pricing basis for this proposal. | Column rate_card_id (BIGINT) in advertising.sales_proposal']
  rfp_id varchar [note: 'Foreign key linking to sales.rfp. Business justification: Proposals are often created in response to RFPs. This FK enables tracing proposals back to the RFP they respond to. N:1 relationship (one proposal per RFP in the context of a single seller responding) | Column rfp_id (BIGINT) in sales.sales_proposal']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser in this proposal negotiation. Nullable if the advertiser is buying direct. | Column sales_agency_id (BIGINT) in sales.sales_proposal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sales_proposal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sales_proposal']
  accepted_timestamp timestamp [note: 'Timestamp when the proposal was accepted by the advertiser or agency. Null if not yet accepted or if rejected. | Column accepted_timestamp (TIMESTAMP) in sales.sales_proposal']
  agency_commission_percentage decimal(5,2) [note: 'Agency commission percentage to be paid to the agency from the gross proposal value. Typically 15% in the industry. Null if direct advertiser buy. | Column agency_commission_percentage (DECIMAL(5,2)) in sales.sales_proposal']
  approved_timestamp timestamp [note: 'Date and time when this proposal was internally approved for submission to the client. | Column approved_timestamp (TIMESTAMP) in sales.sales_proposal']
  audience_guarantee_flag boolean [note: 'Indicates whether the proposal includes an audience delivery guarantee with makegood provisions if targets are not met. | Column audience_guarantee_flag (BOOLEAN) in sales.sales_proposal']
  campaign_end_date date [note: 'Proposed end date for the advertising campaign covered by this proposal. | Column campaign_end_date (DATE) in sales.sales_proposal']
  campaign_start_date date [note: 'Proposed start date for the advertising campaign covered by this proposal. | Column campaign_start_date (DATE) in sales.sales_proposal']
  cancellation_terms varchar [note: 'Terms and conditions for cancellation of the proposal or resulting order, including notice periods and penalties. | Column cancellation_terms (STRING) in sales.sales_proposal']
  channel_mix_summary varchar [note: 'High-level summary of the proposed channel distribution (e.g., 60% Linear TV, 30% OTT, 10% Digital). Detailed channel breakdown is in proposal line items. | Column channel_mix_summary (STRING) in sales.sales_proposal']
  competitive_situation varchar [note: 'Internal notes on competitive dynamics, other bidders, and strategic positioning for this proposal. | Column competitive_situation (STRING) in sales.sales_proposal']
  content_adjacency_preferences varchar [note: 'Client-specified preferences or restrictions for content types adjacent to ad placements (e.g., sports, news, drama, avoid violent content). | Column content_adjacency_preferences (STRING) in sales.sales_proposal']
  cpm decimal(10,2) [note: 'Proposed Cost Per Mille (CPM) - the cost per thousand impressions. Key pricing metric for advertising inventory. | Column cpm (DECIMAL(10,2)) in sales.sales_proposal']
  cprp decimal(10,2) [note: 'Proposed Cost Per Rating Point (CPRP) - the cost to achieve one rating point in the target demographic. Key pricing metric for broadcast advertising. | Column cprp (DECIMAL(10,2)) in sales.sales_proposal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sales_proposal']
  created_timestamp timestamp [note: 'Date and time when this proposal record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.sales_proposal']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this proposal (e.g., USD, GBP, EUR). | Column currency_code (STRING) in sales.sales_proposal']
  daypart_mix varchar [note: 'Distribution of proposed ad spots across broadcast dayparts (e.g., Prime Time, Early Morning, Late Night, Weekend), expressed as percentages or spot counts per daypart. | Column daypart_mix (STRING) in sales.sales_proposal']
  daypart_mix_summary varchar [note: 'High-level summary of the proposed daypart distribution (e.g., 40% Prime, 30% Early Fringe, 20% Late Night, 10% Weekend). Detailed daypart breakdown is in proposal line items. | Column daypart_mix_summary (STRING) in sales.sales_proposal']
  demographic_target varchar [note: 'Primary audience demographic segment targeted by this proposal, expressed in standard Nielsen notation (e.g., Adults 25-54, Women 18-49). | Column demographic_target (STRING) in sales.sales_proposal']
  discount_amount decimal(18,2) [note: 'Total discount or price reduction offered in the proposal, applied to the total proposed value. | Column discount_amount (DECIMAL(18,2)) in sales.sales_proposal']
  discount_percentage decimal(5,2) [note: 'Overall discount percentage applied to the proposal (e.g., volume discount, upfront commitment discount). Null if no discount applied. | Column discount_percentage (DECIMAL(5,2)) in sales.sales_proposal']
  expiry_date date [note: 'Date when the proposal expires and is no longer valid for acceptance. After this date, pricing and inventory availability must be re-confirmed. | Column expiry_date (DATE) in sales.sales_proposal']
  flight_end_date date [note: 'Proposed end date for the advertising campaign or content delivery period covered by this proposal. | Column flight_end_date (DATE) in sales.sales_proposal']
  flight_start_date date [note: 'Proposed start date for the advertising campaign or content delivery period covered by this proposal. | Column flight_start_date (DATE) in sales.sales_proposal']
  guaranteed_impressions varchar [note: 'Minimum number of impressions contractually guaranteed to be delivered, triggering makegood obligations if underdelivered. | Column guaranteed_impressions (BIGINT) in sales.sales_proposal']
  last_modified_timestamp timestamp [note: 'Date and time when this proposal record was last updated or revised. | Column last_modified_timestamp (TIMESTAMP) in sales.sales_proposal']
  makegood_policy varchar [note: 'Description of the makegood policy for this proposal - the terms under which compensatory ad spots will be provided if delivery guarantees are not met. | Column makegood_policy (STRING) in sales.sales_proposal']
  market_type varchar [note: 'Sales market context for this proposal: upfront (advance commitment sales event), scatter (last-minute inventory sales), programmatic (automated bidding), or direct (one-to-one negotiation). | Column market_type (STRING) in sales.sales_proposal']
  net_proposed_value decimal(18,2) [note: 'Net revenue value of the proposal after discounts and agency commissions. This is the expected revenue to the broadcaster. | Column net_proposed_value (DECIMAL(18,2)) in sales.sales_proposal']
  notes varchar [note: 'Free-form notes and comments about the proposal, including special terms, negotiation history, or client-specific requirements. | Column notes (STRING) in sales.sales_proposal']
  platform_mix varchar [note: 'Distribution of proposed inventory across delivery platforms: linear (traditional broadcast), OTT (over-the-top streaming), FAST (free ad-supported streaming TV), AVOD (advertising video on demand), SVOD (subscription video on demand). | Column platform_mix (STRING) in sales.sales_proposal']
  proposal_date date [note: 'Date when the proposal was created and issued to the advertiser or agency. | Column proposal_date (DATE) in sales.sales_proposal']
  proposal_description varchar [note: 'Detailed narrative description of the proposal, including campaign objectives, creative strategy, and value proposition. | Column proposal_description (STRING) in sales.sales_proposal']
  proposal_name varchar [note: 'Descriptive name or title of the proposal, typically reflecting the campaign or client name. | Column proposal_name (STRING) in sales.sales_proposal']
  proposal_number varchar [note: 'Externally-visible unique business identifier for the proposal, used in client communications and internal tracking. | Column proposal_number (STRING) in sales.sales_proposal']
  proposal_source varchar [note: 'Origin or trigger for this proposal: response to RFP (request for proposal), proactive sales pitch, contract renewal, upsell to existing client, or cross-sell of additional services. | Column proposal_source (STRING) in sales.sales_proposal']
  proposal_status varchar [note: 'Current lifecycle status of the advertising proposal in the sales workflow. | Column proposal_status (STRING) in sales.sales_proposal']
  proposal_type varchar [note: 'Category of commercial offer: advertising (spot sales), content licensing (rights acquisition), syndication (content resale), distribution (carriage agreements), sponsorship (branded integration), or upfront (advance commitment). | Column proposal_type (STRING) in sales.sales_proposal']
  proposed_frequency decimal(10,2) [note: 'Proposed average frequency (number of times) that each reached individual in the target audience will be exposed to the campaign. Frequency = GRP / Reach. | Column proposed_frequency (DECIMAL(10,2)) in sales.sales_proposal']
  proposed_grp decimal(10,2) [note: 'Total Gross Rating Points (GRP) proposed to be delivered across all dayparts and channels. GRP measures the total exposure weight of the campaign. | Column proposed_grp (DECIMAL(10,2)) in sales.sales_proposal']
  proposed_impressions varchar [note: 'Total number of impressions (ad views) proposed to be delivered across all channels and platforms in this campaign. | Column proposed_impressions (BIGINT) in sales.sales_proposal']
  proposed_reach decimal(10,2) [note: 'Proposed reach as a percentage of the target audience that will be exposed to the campaign at least once. Reach measures unique audience coverage. | Column proposed_reach (DECIMAL(10,2)) in sales.sales_proposal']
  proposed_trp decimal(10,2) [note: 'Total Target Rating Points (TRP) proposed to be delivered to the specific demographic target audience. TRP measures exposure within the target demo only. | Column proposed_trp (DECIMAL(10,2)) in sales.sales_proposal']
  rejected_timestamp timestamp [note: 'Timestamp when the proposal was rejected by the advertiser or agency. Null if not rejected. | Column rejected_timestamp (TIMESTAMP) in sales.sales_proposal']
  response_due_date date [note: 'Requested or required date by which the client should provide a decision or response to the proposal. | Column response_due_date (DATE) in sales.sales_proposal']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sales_proposal']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sales_proposal']
  spot_length_mix_summary varchar [note: 'High-level summary of the proposed spot length distribution (e.g., 80% :30s, 15% :15s, 5% :60s). Detailed spot length breakdown is in proposal line items. | Column spot_length_mix_summary (STRING) in sales.sales_proposal']
  submitted_date date [note: 'Date when the proposal was formally submitted to the client or agency for review. | Column submitted_date (DATE) in sales.sales_proposal']
  submitted_timestamp timestamp [note: 'Timestamp when the proposal was formally submitted to the advertiser or agency. Null if still in draft status. | Column submitted_timestamp (TIMESTAMP) in sales.sales_proposal']
  target_cpm decimal(10,2) [note: 'Proposed cost per thousand impressions, a key pricing metric for advertising proposals. | Column target_cpm (DECIMAL(10,2)) in sales.sales_proposal']
  target_grp decimal(10,2) [note: 'Proposed total gross rating points representing reach multiplied by frequency, a standard broadcast audience metric. | Column target_grp (DECIMAL(10,2)) in sales.sales_proposal']
  target_impressions varchar [note: 'Total number of ad impressions or exposures proposed to be delivered across all platforms and dayparts. | Column target_impressions (BIGINT) in sales.sales_proposal']
  terms_and_conditions varchar [note: 'Legal and commercial terms governing the proposal, including payment terms, cancellation policies, makegood provisions, and liability clauses. | Column terms_and_conditions (STRING) in sales.sales_proposal']
  total_proposed_value decimal(18,2) [note: 'Total gross revenue value of the proposal in the base currency, before any discounts or agency commissions. Sum of all proposed line items. | Column total_proposed_value (DECIMAL(18,2)) in sales.sales_proposal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sales_proposal']
  version_number varchar [note: 'Sequential version number tracking revisions and iterations of the proposal in response to client feedback or negotiation. | Column version_number (INT) in sales.sales_proposal']
  win_probability_percent decimal(5,2) [note: 'Sales team estimated probability of winning this proposal, expressed as a percentage (0-100). | Column win_probability_percent (DECIMAL(5,2)) in sales.sales_proposal']

  Note: 'Pre-sale advertising proposal submitted to an advertiser or agency in response to an RFP or upfront/scatter negotiation. Captures proposal number, advertiser, agency, account executive, proposal date, expiry date, total proposed value, proposed GRP/TRP/impression delivery, channel mix, daypart mix, spot length mix, CPM/CPRP, audience demographic targets, proposal status (draft, submitted, negotiating, accepted, rejected), and Salesforce opportunity reference. Precedes the formal ad order. | Unity Catalog table: media_broadcasting_ecm.sales.sales_proposal Integrates with Wide Orbit (traffic) and Salesforce Media Cloud (sales CRM) for realistic demos.'
}

Table sales.upfront_deal {
  upfront_deal_id varchar [pk, note: 'Unique identifier for the upfront advertising deal negotiation record. Primary key. Role: MASTER_AGREEMENT. | Column upfront_deal_id (BIGINT) in sales.upfront_deal']
  advertiser_id varchar [note: 'Reference to the advertiser organization purchasing the advertising inventory under this deal. Links to the advertiser master record. | Column advertiser_id (BIGINT) in sales.upfront_deal']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Upfront deals commit annual inventory against specific demographic guarantees (e.g., A18-49 GRP at negotiated CPM). Core to annual negotiation cycle, audience guarantee structuring, and scatter conver | Column demographic_segment_id (BIGINT) in audience.upfront_deal']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Upfront commitments tied to specific content rights portfolios. Multi-year upfront deals depend on multi-year content licenses. Sales executives negotiate upfronts around confirmed rights renewals for | Column license_agreement_id (BIGINT) in rights.upfront_deal']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Upfront deals in broadcasting often involve content distribution partners (networks, studios) providing programming blocks or inventory commitments. Real business process: upfront negotiation tracking | Column partner_id (BIGINT) in partner.upfront_deal']
  primary_upfront_employee_id varchar [note: 'Reference to the sales account executive responsible for negotiating and managing this upfront deal. Links to the employee/user master record. | Column primary_upfront_employee_id (BIGINT) in workforce.upfront_deal']
  private_marketplace_deal_id varchar [note: 'FK to private marketplace deal for programmatic-direct']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Upfront deals establish multi-year revenue commitments requiring financial classification. Contract accounting and multi-year revenue forecasting require linking deals to revenue streams for proper co | Column revenue_stream_id (BIGINT) in finance.upfront_deal']
  sales_agency_id varchar [note: 'Reference to the media buying agency representing the advertiser in this deal negotiation. Nullable for direct advertiser deals. Links to the agency master record. | Column sales_agency_id (BIGINT) in sales.upfront_deal']
  tertiary_upfront_modified_by_user_employee_id varchar [note: 'Reference to the user who last modified this deal record. Links to the employee/user master record for audit and accountability. | Column tertiary_upfront_modified_by_user_employee_id (BIGINT) in workforce.upfront_deal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.upfront_deal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.upfront_deal']
  audience_guarantee_grp decimal(10,2) [note: 'Total Gross Rating Points (GRP) guaranteed to the advertiser across all flights and dayparts in this deal. GRP = Reach × Frequency, representing the total audience delivery commitment. | Column audience_guarantee_grp (DECIMAL(10,2)) in sales.upfront_deal']
  audience_guarantee_impressions varchar [note: 'Total number of ad impressions guaranteed to the advertiser. Alternative or complementary metric to GRP, especially for digital and cross-platform deals. | Column audience_guarantee_impressions (BIGINT) in sales.upfront_deal']
  cancellation_option_window_days varchar [note: 'Number of days before flight start date within which the advertiser may cancel or reduce the commitment without penalty. Common in upfront deals to provide flexibility. | Column cancellation_option_window_days (INT) in sales.upfront_deal']
  channel_mix varchar [note: 'Comma-separated list or description of broadcast channels, networks, or platforms included in this deal (e.g., Network Prime, Cable Bundle, OTT Streaming). Defines the inventory scope. | Column channel_mix (STRING) in sales.upfront_deal']
  commitment_date date [note: 'Date when the advertiser or agency verbally or formally committed to the deal terms. Nullable until commitment is secured. | Column commitment_date (DATE) in sales.upfront_deal']
  cpm_rate decimal(10,2) [note: 'Cost per thousand impressions for CPM-based deals. Nullable if pricing basis is not CPM. Represents the unit price for audience delivery. | Column cpm_rate (DECIMAL(10,2)) in sales.upfront_deal']
  cprp_rate decimal(10,2) [note: 'Cost per rating point for CPRP-based deals. Nullable if pricing basis is not CPRP. Represents the unit price per GRP delivered. | Column cprp_rate (DECIMAL(10,2)) in sales.upfront_deal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.upfront_deal']
  created_timestamp timestamp [note: 'Timestamp when this upfront deal record was first created in the system. Audit trail for record lifecycle tracking. | Column created_timestamp (TIMESTAMP) in sales.upfront_deal']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this deal. Typically USD for US-based broadcasters. | Column currency_code (STRING) in sales.upfront_deal']
  daypart_mix varchar [note: 'Comma-separated list or description of dayparts included in this deal (e.g., Prime Time, Early Morning, Late Night, Weekend). Daypart = time segment of broadcast day with distinct audience characteristics. | Column daypart_mix (STRING) in sales.upfront_deal']
  deal_number varchar [note: 'Externally-known unique business identifier for the upfront deal, typically formatted as prefix-year-sequence (e.g., UF-2024-000123). Used in all client-facing communications and internal references. | Column deal_number (STRING) in sales.upfront_deal']
  deal_status varchar [note: 'Current lifecycle state of the upfront deal. Draft = initial creation; Submitted = sent to client; Negotiating = active discussions; Committed = verbal agreement; Executed = signed contract; Cancelled = deal terminated; Expired = proposal lapsed without commitment. [ENUM-REF-CANDIDATE: draft|submitted|negotiating|committed|executed|cancelled|expired — 7 candidates stripped; promote to reference product] | Column deal_status (STRING) in sales.upfront_deal']
  deal_type varchar [note: 'Classification of the advertising deal based on sales method and timing. Upfront = annual advance commitment during upfront season; Scatter = short-term last-minute inventory; Direct = negotiated one-off; Programmatic = automated auction-based; Sponsorship = integrated content partnership; Barter = trade arrangement. | Column deal_type (STRING) in sales.upfront_deal']
  deal_year varchar [note: 'Broadcast year for which this upfront deal applies, typically representing the September-to-August broadcast season (e.g., 2024 for 2024-2025 season). Critical for upfront planning and inventory allocation. | Column deal_year (INT) in sales.upfront_deal']
  execution_date date [note: 'Date when the deal contract was fully executed (signed by all parties). Nullable until contract is finalized. | Column execution_date (DATE) in sales.upfront_deal']
  makegood_provision_flag boolean [note: 'Indicates whether the deal includes makegood provisions for audience delivery shortfalls. True = makegoods required if guaranteed audience is not delivered; False = no makegood obligation. | Column makegood_provision_flag (BOOLEAN) in sales.upfront_deal']
  mmm_adstock_decay_rate decimal(5,4) [note: 'Rate at which advertising effect decays over time for MMM calculations']
  mmm_channel_contribution decimal(10,4) [note: 'Marketing Mix Model estimated contribution of this channel to conversions']
  mmm_saturation_point decimal(18,2) [note: 'Estimated spend level at which diminishing returns begin for this channel']
  modified_timestamp timestamp [note: 'Timestamp when this upfront deal record was last modified. Audit trail for change tracking and data lineage. | Column modified_timestamp (TIMESTAMP) in sales.upfront_deal']
  negotiation_round_count varchar [note: 'Number of formal negotiation rounds or proposal revisions submitted during the deal lifecycle. Tracks negotiation complexity and sales effort. | Column negotiation_round_count (INT) in sales.upfront_deal']
  notes varchar [note: 'Free-text field for capturing additional deal terms, special conditions, negotiation history, or internal comments not captured in structured fields. Used by account executives for context and handoff. | Column notes (STRING) in sales.upfront_deal']
  option_exercise_deadline date [note: 'Final date by which the advertiser must exercise any options included in the deal (e.g., additional quarters, scatter conversion, renewal). Nullable if no options are included. | Column option_exercise_deadline (DATE) in sales.upfront_deal']
  pricing_basis varchar [note: 'Pricing model used for this deal. CPM (Cost Per Mille) = cost per thousand impressions; CPRP (Cost Per Rating Point) = cost per GRP point; Flat Rate = fixed fee regardless of delivery; Performance = outcome-based pricing. | Column pricing_basis (STRING) in sales.upfront_deal']
  proposal_date date [note: 'Date when the initial deal proposal was formally submitted to the advertiser or agency. Marks the start of the negotiation lifecycle. | Column proposal_date (DATE) in sales.upfront_deal']
  salesforce_opportunity_reference varchar [note: 'External reference to the corresponding Salesforce Media Cloud Opportunity record. Enables cross-system traceability between the deal negotiation (Salesforce) and trafficking/billing (Wide Orbit). | Column salesforce_opportunity_reference (STRING) in sales.upfront_deal']
  scatter_conversion_rights boolean [note: 'Indicates whether the advertiser has the right to convert unused upfront commitment into scatter market inventory at preferential rates. True = conversion allowed; False = no conversion rights. | Column scatter_conversion_rights (BOOLEAN) in sales.upfront_deal']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.upfront_deal']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.upfront_deal']
  total_committed_spend decimal(18,2) [note: 'Total dollar value of advertising spend committed by the advertiser after negotiation. Nullable until commitment is secured. This is the final agreed revenue amount. | Column total_committed_spend (DECIMAL(18,2)) in sales.upfront_deal']
  total_proposed_spend decimal(18,2) [note: 'Total dollar value of advertising spend proposed in the initial deal submission. Represents the gross revenue opportunity before negotiation adjustments. | Column total_proposed_spend (DECIMAL(18,2)) in sales.upfront_deal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.upfront_deal']

  Note: 'Master record for an advertising deal negotiation and commitment — covering the full lifecycle from initial proposal/RFP response through negotiation rounds to final commitment. Encompasses upfront bulk buys negotiated during the annual upfront sales event as well as significant scatter and direct deals requiring formal proposal stages. Captures deal ID, advertiser, agency, account executive, deal year, proposal date, total proposed/committed spend, audience guarantee (GRP/TRP/impression), audience demographic, channel/daypart mix, cancellation option windows, scatter conversion rights, pricing basis (CPM or CPRP), deal status (draft, submitted, negotiating, committed, executed, cancelled), option exercise deadlines, and Salesforce opportunity reference. SSOT for the pre-order deal negotiation lifecycle. | Unity Catalog table: media_broadcasting_ecm.sales.upfront_deal Integrates with Wide Orbit (traffic) and Salesforce Media Cloud (sales CRM) for realistic demos.'
}

Table sales.advertising_audience_guarantee {
  advertising_audience_guarantee_id varchar [pk, note: 'Unique identifier for the audience delivery guarantee record. | Column advertising_audience_guarantee_id (BIGINT) in sales.advertising_audience_guarantee']
  ad_order_id varchar [note: 'Reference to the advertising order associated with this guarantee. | Column ad_order_id (BIGINT) in sales.advertising_audience_guarantee']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Audience guarantees can be associated at campaign level (not just order or deal level). This FK enables campaign-level audience guarantee tracking. Nullable because guarantees may be order-specific or | Column campaign_id (BIGINT) in sales.advertising_audience_guarantee']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Audience guarantees are contractually bound to specific Nielsen demographic segments for GRP/TRP delivery measurement and makegood triggers. Core to upfront deals and scatter order compliance. Replace | Column demographic_segment_id (BIGINT) in audience.advertising_audience_guarantee']
  upfront_deal_id varchar [note: 'Reference to the upfront deal if this guarantee is part of an advance advertising sales commitment. | Column upfront_deal_id (BIGINT) in sales.advertising_audience_guarantee']
  verified_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Audience guarantee verification requires sign-off by revenue assurance analyst or audience measurement employee to confirm delivery metrics and trigger makegood/credit processes. Critical for revenue  | Column verified_by_employee_id (BIGINT) in workforce.advertising_audience_guarantee']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.advertising_audience_guarantee']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.advertising_audience_guarantee']
  contracted_grp decimal(12,2) [note: 'The guaranteed Gross Rating Point (GRP) delivery target contractually committed to the advertiser for the specified demographic. | Column contracted_grp (DECIMAL(12,2)) in sales.advertising_audience_guarantee']
  contracted_impressions varchar [note: 'The guaranteed number of impressions committed to the advertiser for the campaign period. | Column contracted_impressions (BIGINT) in sales.advertising_audience_guarantee']
  contracted_trp decimal(12,2) [note: 'The guaranteed Target Rating Point (TRP) delivery target for the specific demographic audience segment. | Column contracted_trp (DECIMAL(12,2)) in sales.advertising_audience_guarantee']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.advertising_audience_guarantee']
  created_timestamp timestamp [note: 'The date and time when this audience guarantee record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.advertising_audience_guarantee']
  credit_amount decimal(15,2) [note: 'The monetary credit amount owed to the advertiser if makegoods are not provided for underdelivery. | Column credit_amount (DECIMAL(15,2)) in sales.advertising_audience_guarantee']
  daypart varchar [note: 'The time segment of the broadcast day during which the guarantee applies (e.g., Prime Time, Early Morning, Late Fringe). | Column daypart (STRING) in sales.advertising_audience_guarantee']
  delivered_grp decimal(12,2) [note: 'The actual Gross Rating Point (GRP) delivered to date as measured by Nielsen or other audience measurement provider. | Column delivered_grp (DECIMAL(12,2)) in sales.advertising_audience_guarantee']
  delivered_impressions varchar [note: 'The actual number of impressions delivered to date as measured by the audience measurement system. | Column delivered_impressions (BIGINT) in sales.advertising_audience_guarantee']
  delivered_trp decimal(12,2) [note: 'The actual Target Rating Point (TRP) delivered to date for the specified demographic segment. | Column delivered_trp (DECIMAL(12,2)) in sales.advertising_audience_guarantee']
  delivery_percentage decimal(5,2) [note: 'The percentage of the contracted guarantee that has been delivered, calculated as (delivered / contracted) * 100. | Column delivery_percentage (DECIMAL(5,2)) in sales.advertising_audience_guarantee']
  delivery_variance_grp decimal(12,2) [note: 'The difference between contracted and delivered GRP, calculated as delivered minus contracted (negative indicates underdelivery). | Column delivery_variance_grp (DECIMAL(12,2)) in sales.advertising_audience_guarantee']
  guarantee_number varchar [note: 'Business identifier for the audience guarantee, used for tracking and reporting purposes. | Column guarantee_number (STRING) in sales.advertising_audience_guarantee']
  guarantee_period_end_date date [note: 'The end date of the period during which the audience guarantee applies. | Column guarantee_period_end_date (DATE) in sales.advertising_audience_guarantee']
  guarantee_period_start_date date [note: 'The start date of the period during which the audience guarantee applies. | Column guarantee_period_start_date (DATE) in sales.advertising_audience_guarantee']
  guarantee_status varchar [note: 'Current status of the audience guarantee: on_track (meeting targets), at_risk (trending toward underdelivery), underdelivered (below threshold), fulfilled (completed successfully), cancelled (guarantee voided). | Column guarantee_status (STRING) in sales.advertising_audience_guarantee']
  last_measurement_date date [note: 'The date of the most recent audience measurement update used to calculate delivery performance. | Column last_measurement_date (DATE) in sales.advertising_audience_guarantee']
  last_updated_timestamp timestamp [note: 'The date and time when this audience guarantee record was most recently updated. | Column last_updated_timestamp (TIMESTAMP) in sales.advertising_audience_guarantee']
  makegood_grp_owed decimal(12,2) [note: 'The amount of GRP that must be delivered through makegood spots to fulfill the guarantee obligation. | Column makegood_grp_owed (DECIMAL(12,2)) in sales.advertising_audience_guarantee']
  makegood_required_flag boolean [note: 'Indicates whether makegood spots are required due to underdelivery against the guarantee. | Column makegood_required_flag (BOOLEAN) in sales.advertising_audience_guarantee']
  market_code varchar [note: 'The designated market area (DMA) or geographic market code where the audience guarantee applies. | Column market_code (STRING) in sales.advertising_audience_guarantee']
  measurement_methodology varchar [note: 'The specific measurement methodology or panel used for audience tracking (e.g., Nielsen C3, C7, Live+Same Day). | Column measurement_methodology (STRING) in sales.advertising_audience_guarantee']
  measurement_source varchar [note: 'The audience measurement provider or system used to track delivery against the guarantee (e.g., Nielsen, Comscore). | Column measurement_source (STRING) in sales.advertising_audience_guarantee']
  network_station_code varchar [note: 'The broadcast network or station identifier where the guaranteed audience delivery is measured. | Column network_station_code (STRING) in sales.advertising_audience_guarantee']
  next_evaluation_date date [note: 'The scheduled date for the next evaluation of guarantee delivery performance. | Column next_evaluation_date (DATE) in sales.advertising_audience_guarantee']
  notes varchar [note: 'Free-form notes regarding the guarantee, including special conditions, adjustments, or client communications. | Column notes (STRING) in sales.advertising_audience_guarantee']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.advertising_audience_guarantee']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.advertising_audience_guarantee']
  underdelivery_threshold_percentage decimal(5,2) [note: 'The contractual threshold percentage below which underdelivery triggers makegood or credit obligations (e.g., 95% means delivery below 95% triggers makegoods). | Column underdelivery_threshold_percentage (DECIMAL(5,2)) in sales.advertising_audience_guarantee']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.advertising_audience_guarantee']

  Note: 'Audience delivery guarantee record associated with an ad order or upfront deal, specifying the contracted GRP/TRP/impression target and tracking actual delivery against that target. Captures guarantee ID, order or deal reference, audience demographic (age/gender cell), contracted GRP, delivered GRP, delivery variance, delivery percentage, underdelivery threshold, guarantee period, Nielsen measurement source, and guarantee status (on-track, at-risk, underdelivered, fulfilled). Triggers makegood or credit processes on underdelivery. | Unity Catalog table: media_broadcasting_ecm.sales.advertising_audience_guarantee Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.dai_event {
  dai_event_id varchar [pk, note: 'Unique identifier for the dynamic ad insertion event record. Primary key. | Column dai_event_id (BIGINT) in sales.dai_event']
  ad_spot_id varchar [note: 'Foreign key linking to sales.ad_spot. Business justification: DAI (Dynamic Ad Insertion) events fulfill contracted ad spots in streaming/OTT environments. This FK links the real-time insertion event back to the ad spot it delivered, enabling reconciliation betwe | Column ad_spot_id (BIGINT) in sales.dai_event']
  advertiser_id varchar [note: 'Reference to the advertiser organization that owns the inserted ad creative. | Column advertiser_id (BIGINT) in sales.dai_event']
  campaign_id varchar [note: 'Reference to the advertising campaign under which this ad insertion was executed. | Column campaign_id (BIGINT) in sales.dai_event']
  dai_media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Dynamic ad insertion events must track which specific media asset file was served to the viewer for billing reconciliation, QC audits, and content delivery verification. Essential for programmatic ad  | Column media_asset_id (BIGINT) in mediaasset.dai_event']
  device_type_id varchar [note: 'Foreign key linking to distribution.device_type. Business justification: DAI systems track device type per insertion event to select device-compatible creatives, measure device-specific fill rates, and support device targeting. Essential for device-level DAI analytics and  | Column device_type_id (BIGINT) in distribution.dai_event']
  isci_creative_id varchar [note: 'Foreign key linking to sales.isci_creative. Business justification: Normalize creative reference in dynamic ad insertion event. DAI event tracks which creative was inserted in real-time. Currently denormalized as isci_code STRING; should FK to isci_creative master to  | Column isci_creative_id (BIGINT) in sales.dai_event']
  media_asset_id varchar [note: 'Reference to the content asset (program, episode, or video) during which the ad was inserted. | Column content_asset_id (BIGINT) in mediaasset.dai_event']
  playback_session_id varchar [note: 'Unique identifier for the streaming session in which this ad insertion occurred. Links to the viewer\'s active playback session. | Column stream_session_id (STRING) in distribution.dai_event']
  scte_marker_id varchar [note: 'SCTE-35 cue point identifier that triggered the dynamic ad insertion opportunity. | Column scte_marker_id (STRING) in scheduling.dai_event']
  segment_id varchar [note: 'Reference to the audience segment used for targeting this ad insertion. Represents the viewer demographic or behavioral profile. | Column segment_id (BIGINT) in audience.dai_event']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: DAI insertion events occur at specific streaming endpoints. DAI systems track which endpoint handled each insertion for delivery confirmation, latency monitoring, CDN cost allocation, and infrastructu | Column streaming_endpoint_id (BIGINT) in distribution.dai_event']
  subscriber_id varchar [note: 'Foreign key linking to subscriber.subscriber. Business justification: Every dynamic ad insertion event occurs within an authenticated subscriber streaming session. Subscriber identity is required for addressable advertising decisioning, personalization, frequency manage | Column subscriber_id (BIGINT) in subscriber.dai_event']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.dai_event']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.dai_event']
  ad_decision_timestamp timestamp [note: 'Precise timestamp when the DAI platform made the ad selection decision for this insertion opportunity. | Column ad_decision_timestamp (TIMESTAMP) in sales.dai_event']
  ad_duration_seconds varchar [note: 'Duration of the inserted ad creative in seconds (e.g., 15, 30, 60 seconds). | Column ad_duration_seconds (INT) in sales.dai_event']
  ad_pod_position varchar [note: 'Sequential position of this ad within the ad pod (group of ads in a break). Position 1 is the first ad in the pod. | Column ad_pod_position (INT) in sales.dai_event']
  ad_server_transaction_reference varchar [note: 'Transaction identifier from the upstream ad server (e.g., Wide Orbit, FreeWheel) that authorized this ad insertion. | Column ad_server_transaction_reference (STRING) in sales.dai_event']
  attribution_model_type varchar [note: 'Type of attribution model applied (first-touch, last-touch, linear, time-decay, position-based, data-driven)']
  attribution_weight decimal(5,4) [note: 'Fractional credit assigned to this touchpoint in multi-touch attribution']
  bid_price_cpm decimal(10,4) [note: 'Winning bid price in CPM (cost per thousand impressions) for this ad insertion in programmatic auction scenarios. | Column bid_price_cpm (DECIMAL(10,4)) in sales.dai_event']
  cdn_node_reference varchar [note: 'Identifier of the CDN edge node that delivered the ad content to the viewer. Used for delivery performance tracking. | Column cdn_node_reference (STRING) in sales.dai_event']
  click_through_url varchar [note: 'Destination URL if the viewer clicked on the ad. Used for engagement tracking and attribution. | Column click_through_url (STRING) in sales.dai_event']
  completion_rate_percent decimal(5,2) [note: 'Percentage of the ad duration that was actually viewed by the user before skipping or abandoning (0.00 to 100.00). | Column completion_rate_percent (DECIMAL(5,2)) in sales.dai_event']
  conversion_path_position varchar [note: 'Position of this touchpoint in the customer conversion path']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.dai_event']
  created_timestamp timestamp [note: 'Timestamp when this DAI event record was first created in the data platform. | Column created_timestamp (TIMESTAMP) in sales.dai_event']
  currency_code varchar [note: 'Three-letter ISO currency code for revenue and bid price amounts (e.g., USD, EUR, GBP). | Column currency_code (STRING) in sales.dai_event']
  dai_platform_name varchar [note: 'Name of the DAI platform that executed this ad insertion (e.g., Google DAI, FreeWheel, Adobe Primetime). | Column dai_platform_name (STRING) in sales.dai_event']
  dai_platform_version varchar [note: 'Version identifier of the DAI platform software used for this insertion event. | Column dai_platform_version (STRING) in sales.dai_event']
  delivery_confirmed_flag boolean [note: 'Boolean flag indicating whether the CDN confirmed successful delivery of the ad content to the viewer\'s device. | Column delivery_confirmed_flag (BOOLEAN) in sales.dai_event']
  device_type varchar [note: 'Type of device on which the ad was inserted and viewed (e.g., smart TV, mobile phone, tablet, desktop, set-top box, gaming console). | Column device_type (STRING) in sales.dai_event']
  fallback_reason varchar [note: 'Reason code or description explaining why a fallback ad was used instead of the primary targeted ad (e.g., targeting mismatch, inventory unavailable, technical constraint). | Column fallback_reason (STRING) in sales.dai_event']
  geo_location_code varchar [note: 'Geographic location code (DMA, postal code, or country code) of the viewer at the time of ad insertion, used for geo-targeting. | Column geo_location_code (STRING) in sales.dai_event']
  impression_fired_flag boolean [note: 'Boolean flag indicating whether the impression tracking URL was successfully fired and acknowledged. | Column impression_fired_flag (BOOLEAN) in sales.dai_event']
  impression_fired_timestamp timestamp [note: 'Timestamp when the impression tracking beacon was fired, marking the billable impression event. | Column impression_fired_timestamp (TIMESTAMP) in sales.dai_event']
  impression_tracking_url varchar [note: 'URL fired to record the ad impression event. Used for third-party verification and billing reconciliation. | Column impression_tracking_url (STRING) in sales.dai_event']
  insertion_point_timecode varchar [note: 'Timecode within the content stream where the ad insertion was triggered, typically corresponding to an SCTE-35 cue marker. | Column insertion_point_timecode (STRING) in sales.dai_event']
  insertion_status varchar [note: 'Status outcome of the ad insertion attempt: inserted (successful), fallback (backup ad used), no-fill (no ad available), error (technical failure), or skipped (viewer action). | Column insertion_status (STRING) in sales.dai_event']
  modified_timestamp timestamp [note: 'Timestamp when this DAI event record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in sales.dai_event']
  platform_type varchar [note: 'Delivery platform type for the ad insertion: OTT (Over-The-Top), linear broadcast, VOD (Video On Demand), or FAST (Free Ad-Supported Streaming Television). | Column platform_type (STRING) in sales.dai_event']
  privacy_signal varchar [note: 'Privacy signal or consent string passed from the viewer\'s device (e.g., IAB TCF consent string, US Privacy string). | Column privacy_signal (STRING) in sales.dai_event']
  quartile_reached varchar [note: 'Highest quartile milestone reached during ad playback: start, first quartile (25%), midpoint (50%), third quartile (75%), complete (100%), or none. | Column quartile_reached (STRING) in sales.dai_event']
  revenue_amount decimal(12,4) [note: 'Revenue amount attributed to this ad insertion event, calculated based on CPM, impressions, and contract terms. | Column revenue_amount (DECIMAL(12,4)) in sales.dai_event']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.dai_event']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.dai_event']
  source_system_name varchar [note: 'Name of the source system that generated this DAI event record (e.g., Google DAI API, FreeWheel event stream). | Column source_system_name (STRING) in sales.dai_event']
  touchpoint_sequence_code varchar [note: 'Identifier linking touchpoints in a conversion path for attribution analysis']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.dai_event']
  user_consent_status varchar [note: 'Privacy consent status of the viewer for personalized ad targeting: granted, denied, not required (non-EU), or unknown. | Column user_consent_status (STRING) in sales.dai_event']
  user_interaction_type varchar [note: 'Type of user interaction with the ad during playback: none, click-through, skip, pause, mute, or expand. | Column user_interaction_type (STRING) in sales.dai_event']
  viewability_status varchar [note: 'Viewability measurement status indicating whether the ad met viewability criteria (e.g., 50% of pixels visible for 2+ seconds per IAB standards). | Column viewability_status (STRING) in sales.dai_event']

  Note: 'Dynamic Ad Insertion event record capturing a real-time ad decision and insertion for OTT/streaming delivery. Captures DAI event ID, stream session reference, content asset, insertion point (SCTE-35 cue), ad decision timestamp, selected ISCI creative, advertiser, campaign, targeting parameters applied (audience segment, geo, device type), insertion status (inserted, fallback, no-fill), CDN delivery confirmation, and impression tracking URL fired. Sourced from the DAI platform (e.g., Google DAI, FreeWheel). Distinct from linear broadcast spot trafficking. | Unity Catalog table: media_broadcasting_ecm.sales.dai_event Surfaced to MVM for FAST channel monetisation use-case fitness. Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.impression_delivery {
  impression_delivery_id varchar [pk, note: 'Unique identifier for the digital or streaming advertising impression delivery record. | Column impression_delivery_id (BIGINT) in sales.impression_delivery']
  ad_order_line_id varchar [note: 'Reference to the specific ad order line item that this impression fulfills. | Column ad_order_line_id (BIGINT) in sales.impression_delivery']
  ad_spot_id varchar [note: 'Foreign key linking to sales.ad_spot. Business justification: Impression delivery records track the actual delivery of ad impressions. This FK links delivery metrics back to the specific ad spot that was aired/streamed, enabling performance tracking and billing  | Column ad_spot_id (BIGINT) in sales.impression_delivery']
  campaign_id varchar [note: 'Reference to the advertising campaign under which this impression was delivered. | Column campaign_id (BIGINT) in sales.impression_delivery']
  device_type_id varchar [note: 'Foreign key linking to distribution.device_type. Business justification: Impression delivery systems track device type for viewability measurement, creative compatibility verification, and device-targeted campaign reporting. Essential for device-level impression analytics  | Column device_type_id (BIGINT) in distribution.impression_delivery']
  isci_creative_id varchar [note: 'Foreign key linking to sales.isci_creative. Business justification: Normalize creative reference in digital impression delivery record. Impression delivery tracks which creative was served across streaming platforms. Currently denormalized as isci_code STRING; should  | Column isci_creative_id (BIGINT) in sales.impression_delivery']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Impression delivery records must reference the actual media asset served for accurate measurement, third-party verification, and discrepancy resolution. Critical for Nielsen/Comscore certification and | Column media_asset_id (BIGINT) in mediaasset.impression_delivery']
  playback_session_id varchar [note: 'Unique identifier for the streaming session during which the impression was delivered. | Column stream_session_id (STRING) in distribution.impression_delivery']
  revenue_recognition_event_id varchar [note: 'Foreign key linking to finance.revenue_recognition_event. Business justification: Impression delivery is the performance obligation for digital advertising under ASC 606. Digital advertising revenue recognition and performance-based billing require linking delivered impressions to  | Column revenue_recognition_event_id (BIGINT) in finance.impression_delivery']
  scte_marker_id varchar [note: 'SCTE-35 cue point identifier that triggered the Dynamic Ad Insertion event, if applicable. | Column scte_marker_id (STRING) in scheduling.impression_delivery']
  segment_id varchar [note: 'Reference to the audience segment targeted for this impression delivery. | Column segment_id (BIGINT) in audience.impression_delivery']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: Impression delivery records track where ads were served. In OTT/streaming, impressions are delivered through specific endpoints. Linking enables join to CDN infrastructure, latency analysis, geographi | Column streaming_endpoint_id (BIGINT) in distribution.impression_delivery']
  subscriber_id varchar [note: 'Foreign key linking to subscriber.subscriber. Business justification: Impression delivery tracking requires subscriber identity for addressable advertising attribution, cross-device frequency capping, reach/frequency reporting, and subscriber-level ad exposure analysis. | Column subscriber_id (BIGINT) in subscriber.impression_delivery']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.impression_delivery']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.impression_delivery']
  ad_pod_position varchar [note: 'Sequential position of this ad within the ad pod (group of ads in a break). | Column ad_pod_position (INT) in sales.impression_delivery']
  attribution_model_type varchar [note: 'Type of attribution model applied (first-touch, last-touch, linear, time-decay, position-based, data-driven)']
  attribution_weight decimal(5,4) [note: 'Fractional credit assigned to this touchpoint in multi-touch attribution']
  browser_type varchar [note: 'Web browser used to view the impression, if applicable. | Column browser_type (STRING) in sales.impression_delivery']
  cdn_delivery_confirmed_flag boolean [note: 'Boolean flag indicating whether the CDN confirmed successful delivery of the impression. | Column cdn_delivery_confirmed_flag (BOOLEAN) in sales.impression_delivery']
  cdn_node_reference varchar [note: 'Identifier of the CDN edge node that delivered the impression. | Column cdn_node_reference (STRING) in sales.impression_delivery']
  channel_name varchar [note: 'Name of the streaming channel or digital property where the impression was served. | Column channel_name (STRING) in sales.impression_delivery']
  click_through_rate_percent decimal(5,2) [note: 'Percentage of impressions that resulted in a click-through, calculated as click-throughs divided by total impressions served. | Column click_through_rate_percent (DECIMAL(5,2)) in sales.impression_delivery']
  click_throughs varchar [note: 'Number of times viewers clicked on the ad to visit the advertiser\'s destination. | Column click_throughs (BIGINT) in sales.impression_delivery']
  completed_views varchar [note: 'Number of impressions where the viewer watched the ad to completion. | Column completed_views (BIGINT) in sales.impression_delivery']
  completion_rate_percent decimal(5,2) [note: 'Percentage of impressions that were viewed to completion, calculated as completed views divided by total impressions served. | Column completion_rate_percent (DECIMAL(5,2)) in sales.impression_delivery']
  content_genre varchar [note: 'Genre of the content during which the ad impression was served. | Column content_genre (STRING) in sales.impression_delivery']
  content_rating varchar [note: 'Age-appropriateness rating of the content during which the ad was served. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA — 10 candidates stripped; promote to reference product] | Column content_rating (STRING) in sales.impression_delivery']
  conversion_path_position varchar [note: 'Position of this touchpoint in the customer conversion path']
  cpm_realized decimal(15,4) [note: 'Actual cost per thousand impressions realized for this delivery event. | Column cpm_realized (DECIMAL(15,4)) in sales.impression_delivery']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.impression_delivery']
  created_timestamp timestamp [note: 'Timestamp when this impression delivery record was first created in the system. | Column created_timestamp (TIMESTAMP) in sales.impression_delivery']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the revenue amount. | Column currency_code (STRING) in sales.impression_delivery']
  daypart varchar [note: 'Time segment of the broadcast day during which the impression was delivered. | Column daypart (STRING) in sales.impression_delivery']
  delivery_date date [note: 'Calendar date on which the impression was delivered, used for daily aggregation and reporting. | Column delivery_date (DATE) in sales.impression_delivery']
  delivery_timestamp timestamp [note: 'Exact date and time when the impression was delivered to the viewer. | Column delivery_timestamp (TIMESTAMP) in sales.impression_delivery']
  device_type varchar [note: 'Type of device on which the impression was delivered. [ENUM-REF-CANDIDATE: CTV|Mobile|Tablet|Desktop|Smart TV|Gaming Console|Set-Top Box — 7 candidates stripped; promote to reference product] | Column device_type (STRING) in sales.impression_delivery']
  geo_target_code varchar [note: 'ISO country or region code representing the geographic targeting applied to this impression. | Column geo_target_code (STRING) in sales.impression_delivery']
  impression_tracking_url varchar [note: 'URL used to track and verify the impression delivery event. | Column impression_tracking_url (STRING) in sales.impression_delivery']
  insertion_status varchar [note: 'Status indicating whether the ad was successfully inserted, a fallback was used, or no ad was available. | Column insertion_status (STRING) in sales.impression_delivery']
  insertion_type varchar [note: 'Technical method used to insert the ad into the content stream or page. [ENUM-REF-CANDIDATE: DAI|SCTE-35|Server-Side|Client-Side|Display|Pre-Roll|Mid-Roll|Post-Roll — 8 candidates stripped; promote to reference product] | Column insertion_type (STRING) in sales.impression_delivery']
  modified_timestamp timestamp [note: 'Timestamp when this impression delivery record was last modified. | Column modified_timestamp (TIMESTAMP) in sales.impression_delivery']
  operating_system varchar [note: 'Operating system of the device that received the impression. | Column operating_system (STRING) in sales.impression_delivery']
  platform_type varchar [note: 'Type of digital platform where the impression was delivered. | Column platform_type (STRING) in sales.impression_delivery']
  revenue_amount decimal(15,2) [note: 'Total revenue generated from this impression delivery event. | Column revenue_amount (DECIMAL(15,2)) in sales.impression_delivery']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.impression_delivery']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.impression_delivery']
  third_party_verification_source varchar [note: 'Name of the third-party verification service that validated this impression delivery. | Column third_party_verification_source (STRING) in sales.impression_delivery']
  total_impressions_served varchar [note: 'Total number of impressions delivered in this event. | Column total_impressions_served (BIGINT) in sales.impression_delivery']
  touchpoint_sequence_code varchar [note: 'Identifier linking touchpoints in a conversion path for attribution analysis']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.impression_delivery']
  verification_status varchar [note: 'Status of third-party verification for this impression. | Column verification_status (STRING) in sales.impression_delivery']
  viewability_rate_percent decimal(5,2) [note: 'Percentage of impressions that met viewability standards, calculated as viewable impressions divided by total impressions served. | Column viewability_rate_percent (DECIMAL(5,2)) in sales.impression_delivery']
  viewable_impressions varchar [note: 'Number of impressions that met the IAB viewability standard (50% of pixels in view for 2+ seconds for display, 50% for 2+ seconds for video). | Column viewable_impressions (BIGINT) in sales.impression_delivery']

  Note: 'Digital and streaming advertising delivery record tracking served impressions and ad insertions across OTT, AVOD, FAST, and digital display campaigns. Covers both Dynamic Ad Insertion (DAI) events triggered by SCTE-35 cues in streaming and standard digital impression serving. Captures delivery date, channel/platform, campaign, ad order line, ISCI creative, insertion type (DAI/SCTE-35, server-side, client-side, display), targeting parameters applied (audience segment, geo, device type), total impressions served, viewable impressions, completed views, click-throughs, CPM realized, insertion status (inserted, fallback, no-fill), CDN delivery confirmation, impression tracking URL, stream session reference, and third-party verification source (IAS, DoubleVerify, Nielsen DAR). Feeds digital billing reconciliation, campaign pacing, and DAI platform reporting. | Unity Catalog table: media_broadcasting_ecm.sales.impression_delivery Integrates with Salesforce Media Cloud (sales CRM).'
}

Table sales.sales_scatter_order {
  sales_scatter_order_id varchar [pk, note: 'Unique identifier for the scatter market advertising order. Primary key for the sales scatter order entity. | Column sales_scatter_order_id (BIGINT) in sales.sales_scatter_order']
  advertiser_id varchar [note: 'Reference to the advertiser placing the scatter market order. Links to the advertiser master record. | Column advertiser_id (BIGINT) in sales.sales_scatter_order']
  campaign_id varchar [note: 'Reference to the parent advertising campaign this scatter order belongs to. Links scatter buys to broader campaign strategy. | Column campaign_id (BIGINT) in sales.sales_scatter_order']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Scatter orders specify channel for spot placement. Business process: scatter market inventory allocation, last-minute inventory sales, channel-specific scatter pricing. | Column channel_id (BIGINT) in scheduling.sales_scatter_order']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Scatter orders specify daypart for purchased inventory. Business process: scatter pricing by daypart, daypart fulfillment tracking. Replaces denormalized daypart text field with proper FK. | Column daypart_id (BIGINT) in scheduling.sales_scatter_order']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Scatter orders target specific demographics for short-term inventory buys with demographic-specific CPM pricing and GRP/TRP delivery expectations. Core to scatter market operations and yield managemen | Column demographic_segment_id (BIGINT) in audience.sales_scatter_order']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Scatter orders may source inventory from affiliate partners or syndicated content blocks requiring partner tracking for inventory sourcing and revenue allocation. Real business process: scatter invent | Column partner_id (BIGINT) in partner.sales_scatter_order']
  primary_sales_employee_id varchar [note: 'Reference to the sales account executive responsible for this scatter order. Used for commission calculation and performance tracking. | Column primary_sales_employee_id (BIGINT) in workforce.sales_scatter_order']
  primary_salesforce_opportunity_id varchar [note: 'External identifier linking this scatter order to the originating sales opportunity in Salesforce Media Cloud. Enables CRM integration and sales pipeline tracking. | Column primary_salesforce_opportunity_id (BIGINT) in sales.sales_scatter_order']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Scatter orders generate spot revenue requiring classification for financial reporting. Revenue recognition and yield management reporting require linking scatter orders to revenue stream classificatio | Column revenue_stream_id (BIGINT) in finance.sales_scatter_order']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser for this scatter order. Nullable if direct advertiser buy. | Column sales_agency_id (BIGINT) in sales.sales_scatter_order']
  sales_rep_id varchar [note: 'Reference to the sales representative who negotiated and closed this scatter order. | Column sales_rep_id (BIGINT) in sales.sales_scatter_order']
  scatter_order_id varchar [note: 'Foreign key linking to sales.scatter_order. Business justification: sales_scatter_order and scatter_order appear to represent the same business entity at different lifecycle stages (proposal vs. confirmed). Linking them tracks the progression from scatter order reques | Column scatter_order_id (BIGINT) in sales.sales_scatter_order']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in sales.sales_scatter_order']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in sales.sales_scatter_order']
  agency_commission_rate decimal(5,2) [note: 'Agency commission rate percentage deducted from the gross order value. Standard agency commission is typically 15% in the advertising industry. | Column agency_commission_rate (DECIMAL(5,2)) in sales.sales_scatter_order']
  audience_guarantee_flag boolean [note: 'Boolean flag indicating whether this scatter order includes an audience delivery guarantee. If true, makegoods may be required if delivery falls short. | Column audience_guarantee_flag (BOOLEAN) in sales.sales_scatter_order']
  cancellation_deadline_date date [note: 'Last date by which the advertiser may cancel this scatter order without penalty. After this date, cancellation fees may apply. | Column cancellation_deadline_date (DATE) in sales.sales_scatter_order']
  commission_rate decimal(5,2) [note: 'Commission rate percentage applied to this scatter order for sales representative compensation. Expressed as a percentage (e.g., 15.00 for 15%). | Column commission_rate (DECIMAL(5,2)) in sales.sales_scatter_order']
  confirmed_timestamp timestamp [note: 'Timestamp when the scatter order was confirmed by the advertiser or agency. Represents commitment to the buy and triggers inventory allocation. | Column confirmed_timestamp (TIMESTAMP) in sales.sales_scatter_order']
  contract_terms varchar [note: 'Free-text field capturing special contractual terms, conditions, or notes specific to this scatter order. May include payment terms, delivery guarantees, or custom provisions. | Column contract_terms (STRING) in sales.sales_scatter_order']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in sales.sales_scatter_order']
  created_timestamp timestamp [note: 'Timestamp when the scatter order record was first created in the system. Audit trail for order lifecycle tracking. | Column created_timestamp (TIMESTAMP) in sales.sales_scatter_order']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this scatter order. Supports multi-currency advertising sales. | Column currency_code (STRING) in sales.sales_scatter_order']
  daypart varchar [note: 'Time segment of the broadcast day targeted for scatter spot placement. Critical for audience targeting and pricing. Daypart represents the time-of-day classification used in broadcast scheduling. [ENUM-REF-CANDIDATE: early_morning|daytime|early_fringe|prime_access|prime_time|late_fringe|late_night|overnight|weekend — 9 candidates stripped; promote to reference product] | Column daypart (STRING) in sales.sales_scatter_order']
  delivered_grps decimal(10,2) [note: 'Actual Gross Rating Points (GRPs) delivered for linear broadcast inventory. Compared against requested GRPs to assess fulfillment. | Column delivered_grps (DECIMAL(10,2)) in sales.sales_scatter_order']
  delivered_impressions varchar [note: 'Actual number of advertising impressions delivered for this scatter order. Compared against requested impressions to assess fulfillment. | Column delivered_impressions (BIGINT) in sales.sales_scatter_order']
  discount_amount decimal(15,2) [note: 'Total discount amount applied to the scatter order, if any. May include volume discounts or promotional adjustments. | Column discount_amount (DECIMAL(15,2)) in sales.sales_scatter_order']
  discount_percent decimal(5,2) [note: 'Percentage discount applied to the scatter order total. May reflect volume discounts, promotional pricing, or negotiated rate adjustments. | Column discount_percent (DECIMAL(5,2)) in sales.sales_scatter_order']
  flight_end_date date [note: 'Last date of the advertising campaign flight period when spots may air. | Column flight_end_date (DATE) in sales.sales_scatter_order']
  flight_start_date date [note: 'First date of the advertising campaign flight period when spots may air. | Column flight_start_date (DATE) in sales.sales_scatter_order']
  fulfillment_status varchar [note: 'Current fulfillment status of the scatter order. Tracks whether requested impressions or GRPs have been delivered as scheduled. | Column fulfillment_status (STRING) in sales.sales_scatter_order']
  inventory_type varchar [note: 'Type of advertising inventory being purchased in the scatter market. Indicates the delivery platform or format. | Column inventory_type (STRING) in sales.sales_scatter_order']
  makegood_eligible_flag boolean [note: 'Indicates whether this scatter order is eligible for makegood spots if original spots are preempted or underdeliver. Makegoods are compensatory ad spots provided when contracted delivery is not met. | Column makegood_eligible_flag (BOOLEAN) in sales.sales_scatter_order']
  market_type varchar [note: 'Geographic market scope for the scatter order. Determines pricing, inventory availability, and audience measurement methodology. | Column market_type (STRING) in sales.sales_scatter_order']
  mmm_adstock_decay_rate decimal(5,4) [note: 'Rate at which advertising effect decays over time for MMM calculations']
  mmm_channel_contribution decimal(10,4) [note: 'Marketing Mix Model estimated contribution of this channel to conversions']
  mmm_saturation_point decimal(18,2) [note: 'Estimated spend level at which diminishing returns begin for this channel']
  modified_timestamp timestamp [note: 'Timestamp of the most recent modification to the scatter order record. Tracks order changes and updates throughout the lifecycle. | Column modified_timestamp (TIMESTAMP) in sales.sales_scatter_order']
  negotiated_cpm decimal(12,2) [note: 'Negotiated Cost Per Mille (CPM) rate for this scatter order. Represents the cost per thousand impressions. Scatter market CPM is typically at a premium to upfront rates. | Column negotiated_cpm (DECIMAL(12,2)) in sales.sales_scatter_order']
  negotiated_cprp decimal(12,2) [note: 'Negotiated Cost Per Rating Point (CPRP) for linear broadcast inventory. Represents the cost per single rating point. | Column negotiated_cprp (DECIMAL(12,2)) in sales.sales_scatter_order']
  net_order_amount decimal(15,2) [note: 'Final order amount after discounts and adjustments. Represents the actual revenue expected from this scatter order. | Column net_order_amount (DECIMAL(15,2)) in sales.sales_scatter_order']
  net_order_value decimal(15,2) [note: 'Net monetary value of the scatter order after discounts and before agency commission. Represents the revenue to the broadcaster. | Column net_order_value (DECIMAL(15,2)) in sales.sales_scatter_order']
  notes varchar [note: 'Free-text notes or comments related to this scatter order. May include special instructions, scheduling preferences, or internal coordination details. | Column notes (STRING) in sales.sales_scatter_order']
  order_date date [note: 'Date the scatter order was placed. Represents the business event timestamp when the advertiser or agency committed to the scatter buy. | Column order_date (DATE) in sales.sales_scatter_order']
  order_number varchar [note: 'Business identifier for the scatter order, typically generated by the sales or traffic system. Used for external communication and tracking. | Column order_number (STRING) in sales.sales_scatter_order']
  order_status varchar [note: 'Current lifecycle status of the scatter order. Tracks progression from draft through fulfillment or cancellation. Preempted status indicates the order was bumped by higher-priority inventory. [ENUM-REF-CANDIDATE: draft|submitted|confirmed|scheduled|in_flight|completed|cancelled|preempted — 8 candidates stripped; promote to reference product] | Column order_status (STRING) in sales.sales_scatter_order']
  platform varchar [note: 'Distribution platform where the advertising will be delivered. Supports multi-platform scatter buying. | Column platform (STRING) in sales.sales_scatter_order']
  political_ad_flag boolean [note: 'Indicates whether this scatter order is for political advertising. Political ads have special regulatory requirements including disclosure, equal time provisions, and public file obligations. | Column political_ad_flag (BOOLEAN) in sales.sales_scatter_order']
  preemptibility_class varchar [note: 'Classification of whether and how scatter spots can be preempted by higher-value inventory. Non-preemptible spots are guaranteed to air; preemptible spots may be bumped for higher-paying advertisers. Critical distinction from upfront deals. | Column preemptibility_class (STRING) in sales.sales_scatter_order']
  preemption_protection_level varchar [note: 'Numeric priority level for preemption protection (1-10, where 10 is highest protection). Determines which orders are preempted first when inventory conflicts arise. | Column preemption_protection_level (INT) in sales.sales_scatter_order']
  preemption_risk_flag boolean [note: 'Boolean flag indicating whether this scatter order is subject to preemption by higher-rated inventory. True indicates the order may be bumped if higher-priority demand emerges. | Column preemption_risk_flag (BOOLEAN) in sales.sales_scatter_order']
  priority_level varchar [note: 'Priority level assigned to this scatter order. Determines preemption risk and scheduling preference. Higher priority orders are less likely to be preempted. | Column priority_level (STRING) in sales.sales_scatter_order']
  product_category varchar [note: 'Industry category of the advertised product or service. Used for competitive separation, content adjacency rules, and regulatory compliance. | Column product_category (STRING) in sales.sales_scatter_order']
  requested_air_end_date date [note: 'Last date of the requested air window for scatter market spots. Defines the flight period for the scatter campaign. | Column requested_air_end_date (DATE) in sales.sales_scatter_order']
  requested_air_start_date date [note: 'First date of the requested air window for scatter market spots. Typically 4-12 weeks from order date, distinguishing scatter from upfront buys. | Column requested_air_start_date (DATE) in sales.sales_scatter_order']
  requested_grps decimal(10,2) [note: 'Total Gross Rating Points (GRPs) requested for linear broadcast inventory. Represents reach multiplied by frequency. | Column requested_grps (DECIMAL(10,2)) in sales.sales_scatter_order']
  requested_impressions varchar [note: 'Total number of advertising impressions requested by the advertiser for this scatter order. Used for digital and streaming inventory. | Column requested_impressions (BIGINT) in sales.sales_scatter_order']
  requested_spots varchar [note: 'Number of individual advertising spots or units requested in this scatter order. | Column requested_spots (INT) in sales.sales_scatter_order']
  requires_clearance_flag boolean [note: 'Indicates whether advertising creative requires legal or standards clearance before airing. Common for political ads, pharmaceutical products, and sensitive content. | Column requires_clearance_flag (BOOLEAN) in sales.sales_scatter_order']
  sales_channel varchar [note: 'Channel through which the scatter order was sold. Affects commission structure, pricing, and order processing workflow. | Column sales_channel (STRING) in sales.sales_scatter_order']
  scatter_cpm_amount decimal(12,2) [note: 'Cost per thousand impressions for this scatter order. Typically at a premium to upfront CPM due to short lead time and market conditions. CPM is the standard pricing metric in broadcast advertising. | Column scatter_cpm_amount (DECIMAL(12,2)) in sales.sales_scatter_order']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in sales.sales_scatter_order']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in sales.sales_scatter_order']
  spot_length_seconds varchar [note: 'Duration of each advertising spot in seconds. Standard lengths are 15, 30, or 60 seconds. Affects pricing and inventory allocation. | Column spot_length_seconds (INT) in sales.sales_scatter_order']
  target_demographic varchar [note: 'Primary demographic audience segment targeted by this scatter order (e.g., Adults 18-49, Women 25-54). Used for audience guarantee and measurement. | Column target_demographic (STRING) in sales.sales_scatter_order']
  target_frequency decimal(5,2) [note: 'Target average number of times each individual in the target audience will be exposed to the advertising. Frequency complements reach in campaign effectiveness measurement. | Column target_frequency (DECIMAL(5,2)) in sales.sales_scatter_order']
  target_grp decimal(8,2) [note: 'Target Gross Rating Points for the scatter order. GRP measures the total exposure of the campaign across the target audience, calculated as reach multiplied by frequency. | Column target_grp (DECIMAL(8,2)) in sales.sales_scatter_order']
  target_reach_percent decimal(5,2) [note: 'Target percentage of unique individuals in the target demographic to be reached by this scatter campaign. Reach represents unduplicated audience exposure. | Column target_reach_percent (DECIMAL(5,2)) in sales.sales_scatter_order']
  target_trp decimal(8,2) [note: 'Target Rating Points for the specific demographic segment. TRP is similar to GRP but focuses on a specific target audience rather than total audience. | Column target_trp (DECIMAL(8,2)) in sales.sales_scatter_order']
  total_order_amount decimal(15,2) [note: 'Total monetary value of the scatter order before discounts or adjustments. Calculated from spot count, CPM, and estimated impressions. | Column total_order_amount (DECIMAL(15,2)) in sales.sales_scatter_order']
  total_order_value decimal(15,2) [note: 'Total monetary value of the scatter order before any adjustments. Calculated based on negotiated rates and requested volume. | Column total_order_value (DECIMAL(15,2)) in sales.sales_scatter_order']
  total_spots_ordered varchar [note: 'Total number of advertising spots purchased in this scatter order. Represents the quantity of impressions the advertiser is buying. | Column total_spots_ordered (INT) in sales.sales_scatter_order']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in sales.sales_scatter_order']
  updated_timestamp timestamp [note: 'Timestamp when this scatter order record was last modified. Audit trail for record updates. | Column updated_timestamp (TIMESTAMP) in sales.sales_scatter_order']
  wide_orbit_order_number varchar [note: 'External order number assigned by Wide Orbit traffic and billing system for scatter market buys. Used for cross-system reconciliation and affidavit tracking. | Column wide_orbit_order_number (STRING) in sales.sales_scatter_order']

  Note: 'Ad order record for scatter market buys — short-notice advertising purchases made outside the upfront window, typically 4-12 weeks before air. Captures scatter order ID, advertiser, agency, order date, requested air window, channel, daypart, spot length, scatter CPM (typically at premium to upfront), audience target, preemptibility class (non-preemptible, preemptible at rate, immediately preemptible), and order status. Distinct from upfront deals due to different pricing, lead time, and preemption rules. | Unity Catalog table: media_broadcasting_ecm.sales.sales_scatter_order Integrates with Wide Orbit (traffic) and Salesforce Media Cloud (sales CRM) for realistic demos.'
}

Table sales.sponsorship {
