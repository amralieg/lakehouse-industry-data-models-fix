ind:maximumWaitTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Maximum Wait Time Seconds' ;
    rdfs:comment 'Maximum allowable wait time in seconds before an interaction is escalated, transferred, or offered callback.' ;
    rdfs:domain ind:Queue ;
