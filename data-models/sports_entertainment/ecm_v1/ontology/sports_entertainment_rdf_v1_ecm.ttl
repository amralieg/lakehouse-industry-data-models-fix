    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geolocationVerificationEnabled rdf:type rdf:Property ;
    rdfs:label 'Geolocation Verification Enabled' ;
    rdfs:comment 'Indicates whether the operator uses geolocation technology to verify player location for regulatory compliance.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:headquartersAddress rdf:type rdf:Property ;
    rdfs:label 'Headquarters Address' ;
    rdfs:comment 'Physical street address of the operator\'s corporate headquarters or principal place of business.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'License Expiration Date' ;
    rdfs:comment 'Date when the current gaming license expires and requires renewal for continued operations.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseIssueDate rdf:type rdf:Property ;
    rdfs:label 'License Issue Date' ;
    rdfs:comment 'Date when the gaming license was originally issued to the operator by the regulatory authority.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:liveBettingSupported rdf:type rdf:Property ;
    rdfs:label 'Live Betting Supported' ;
    rdfs:comment 'Indicates whether the operator supports in-play or live betting on sporting events.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumAgeRequirement rdf:type rdf:Property ;
    rdfs:label 'Minimum Age Requirement' ;
    rdfs:comment 'Minimum legal age required for customers to participate in gaming activities with this operator.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mobileAppAvailable rdf:type rdf:Property ;
    rdfs:label 'Mobile App Available' ;
    rdfs:comment 'Indicates whether the operator offers a dedicated mobile application for gaming activities.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:multiCurrencySupport rdf:type rdf:Property ;
    rdfs:label 'Multi Currency Support' ;
    rdfs:comment 'Indicates whether the operator supports transactions in multiple currencies beyond the primary operating currency.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatingCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Operating Currency Code' ;
    rdfs:comment 'Primary three-letter ISO currency code used for the operator\'s gaming transactions and financial reporting.' ;
