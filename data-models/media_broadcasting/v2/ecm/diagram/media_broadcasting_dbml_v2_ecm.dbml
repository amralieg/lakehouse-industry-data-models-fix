  Note: 'Formal disputes raised by or against partners regarding agreement terms, payment discrepancies, content delivery failures, ratings shortfalls, or carriage fee calculations. Tracks dispute type, disputed amount, supporting evidence, escalation path, legal hold status, and resolution outcome. Feeds financial reconciliation and legal compliance workflows. | Unity Catalog table: media_broadcasting_ecm.partner.partner_dispute'
}

Table partner.partner_content_window {
  partner_content_window_id varchar [pk, note: 'Unique identifier for the content window record. Primary key. | Column partner_content_window_id (BIGINT) in partner.partner_content_window']
  acquisition_deal_id varchar [note: 'Reference to the acquisition, distribution, or syndication agreement under which this window is granted. | Column acquisition_deal_id (BIGINT) in partner.partner_content_window']
  business_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Windowing strategies require business owner tracking for activation decisions, performance monitoring, and renewal negotiations. Critical for accountability in SVOD/AVOD/TVOD window management and rev | Column business_owner_employee_id (BIGINT) in workforce.partner_content_window']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Distribution windows (theatrical, premium cable, broadcast, SVOD) have different rating requirements and standards. Theatrical windows use MPAA ratings; broadcast windows use TV Parental Guidelines. W | Column compliance_content_rating_id (BIGINT) in compliance.partner_content_window']
  content_title_id varchar [note: 'Reference to the specific content title (film, series, episode, or program) to which this window applies. | Column content_title_id (BIGINT) in content.partner_content_window']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: Windowing plans specify which technical version (theatrical cut vs streaming edit, language dub, HDR format) is available in each distribution window. Platform delivery orchestration, DRM policy appli | Column content_version_id (BIGINT) in content.partner_content_window']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Content windows are often structured around demographic appeal (e.g., theatrical window targets broader demos, SVOD window targets younger demos). Essential for windowing strategy optimization and rev | Column demographic_segment_id (BIGINT) in audience.partner_content_window']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Windows define when/where specific assets can be exploited (SVOD window, linear window, international window). Direct asset link required for automated compliance checks in playout systems, preventing | Column media_asset_id (BIGINT) in mediaasset.partner_content_window']
  partner_id varchar [note: 'Reference to the internal employee or team responsible for managing and monitoring this content window (e.g., rights manager, distribution coordinator). | Column partner_id (BIGINT) in partner.partner_content_window']
  partner_rights_content_window_id varchar [note: 'FK to canonical rights content window | Column rights_content_window_id (BIGINT) in rights.partner_content_window']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.partner_content_window']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.partner_content_window']
  activation_date date [note: 'The actual date on which the content was made available on the platform, which may differ from the planned window_start_date due to operational delays or early releases. | Column activation_date (DATE) in partner.partner_content_window']
  content_format varchar [note: 'The technical video format or resolution standard required for delivery in this window (e.g., SD, HD, 4K, 8K, HDR, Dolby Vision). | Column content_format (STRING) in partner.partner_content_window']
  contract_reference_number varchar [note: 'External reference number or identifier for the legal contract or agreement document that governs this window. Used for audit and compliance traceability. | Column contract_reference_number (STRING) in partner.partner_content_window']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.partner_content_window']
  created_timestamp timestamp [note: 'The date and time when this content window record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in partner.partner_content_window']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this window record (e.g., USD, EUR, GBP). | Column currency_code (STRING) in partner.partner_content_window']
  deactivation_date date [note: 'The actual date on which the content was removed from the platform, which may differ from the planned window_end_date due to early termination or extensions. | Column deactivation_date (DATE) in partner.partner_content_window']
  drm_requirement varchar [note: 'The DRM technology required to protect the content during this window (e.g., Widevine, FairPlay, PlayReady, Multi-DRM, or none for unprotected distribution). | Column drm_requirement (STRING) in partner.partner_content_window']
  exclusivity_flag boolean [note: 'Indicates whether this window grants exclusive distribution rights to the platform (True) or allows concurrent distribution on other platforms (False). | Column exclusivity_flag (BOOLEAN) in partner.partner_content_window']
  exclusivity_scope varchar [note: 'Defines the boundaries of exclusivity (e.g., platform-exclusive, territory-exclusive, window-type-exclusive, non-exclusive). Provides context when exclusivity_flag is True. | Column exclusivity_scope (STRING) in partner.partner_content_window']
  holdback_period_days varchar [note: 'The mandatory waiting period (in days) between the end of the previous window and the start of this window, ensuring sequential exclusivity and protecting prior windows. | Column holdback_period_days (INT) in partner.partner_content_window']
  language_availability varchar [note: 'Languages in which the content must be made available during this window (e.g., English, Spanish, French). Comma-separated list of ISO 639-1 language codes. | Column language_availability (STRING) in partner.partner_content_window']
  last_modified_by varchar [note: 'Username or identifier of the user or system process that last modified this record. Used for audit and accountability. | Column last_modified_by (STRING) in partner.partner_content_window']
  last_modified_timestamp timestamp [note: 'The date and time when this content window record was most recently updated. Used for audit trail and change tracking. | Column last_modified_timestamp (TIMESTAMP) in partner.partner_content_window']
  marketing_rights_included_flag boolean [note: 'Indicates whether the platform has rights to use promotional materials, trailers, and marketing assets for this window (True) or must obtain separate clearance (False). | Column marketing_rights_included_flag (BOOLEAN) in partner.partner_content_window']
  minimum_guarantee_amount decimal(15,2) [note: 'The minimum payment guaranteed to the content provider for this window, regardless of actual revenue performance. Expressed in the deal currency. | Column minimum_guarantee_amount (DECIMAL(15,2)) in partner.partner_content_window']
  monetization_model varchar [note: 'The revenue model associated with this window (e.g., subscription-based SVOD, advertising-supported AVOD, transactional TVOD, free, or hybrid). | Column monetization_model (STRING) in partner.partner_content_window']
  notes varchar [note: 'Free-text field for additional context, special conditions, or operational notes related to this window (e.g., blackout restrictions, co-exclusive arrangements, partner-specific requirements). | Column notes (STRING) in partner.partner_content_window']
  performance_guarantee_description varchar [note: 'Free-text description of any performance commitments tied to this window (e.g., minimum viewership targets, promotional spend requirements, platform placement guarantees). | Column performance_guarantee_description (STRING) in partner.partner_content_window']
  platform_name varchar [note: 'Name of the specific distribution platform, service, or channel authorized for this window (e.g., Netflix, Hulu, HBO Max, ABC Network). | Column platform_name (STRING) in partner.partner_content_window']
  renewal_option_flag boolean [note: 'Indicates whether the platform has an option to renew or extend this window under predefined terms (True) or the window is non-renewable (False). | Column renewal_option_flag (BOOLEAN) in partner.partner_content_window']
  renewal_terms varchar [note: 'Free-text description of the terms under which this window may be renewed (e.g., pricing adjustments, duration, notice period). Populated when renewal_option_flag is True. | Column renewal_terms (STRING) in partner.partner_content_window']
  revenue_share_percentage decimal(5,2) [note: 'The percentage of revenue generated during this window that is shared with the content provider or partner, as defined in the acquisition deal. | Column revenue_share_percentage (DECIMAL(5,2)) in partner.partner_content_window']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.partner_content_window']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.partner_content_window']
  sublicensing_allowed_flag boolean [note: 'Indicates whether the platform is permitted to sublicense the content to third parties during this window (True) or must distribute directly (False). | Column sublicensing_allowed_flag (BOOLEAN) in partner.partner_content_window']
  subtitle_requirement varchar [note: 'Specifies subtitle languages required for this window to meet accessibility and localization obligations. Comma-separated list of ISO 639-1 language codes. | Column subtitle_requirement (STRING) in partner.partner_content_window']
  territory_coverage varchar [note: 'Geographic territories or markets where this window is valid (e.g., USA, CAN, GBR, Worldwide, North America). May be comma-separated list of ISO 3166-1 alpha-3 country codes or region names. | Column territory_coverage (STRING) in partner.partner_content_window']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.partner_content_window']
  window_duration_days varchar [note: 'The total length of the distribution window in days, calculated from start to end date. Used for planning and compliance tracking. | Column window_duration_days (INT) in partner.partner_content_window']
  window_end_date date [note: 'The date on which this distribution window expires and the content must be removed from the platform or the rights revert. Nullable for perpetual windows. | Column window_end_date (DATE) in partner.partner_content_window']
  window_sequence_number varchar [note: 'Ordinal position of this window in the sequential release strategy (e.g., 1 for theatrical, 2 for SVOD, 3 for AVOD). Defines the chronological order of windowing. | Column window_sequence_number (INT) in partner.partner_content_window']
  window_start_date date [note: 'The date on which this distribution window becomes active and the content may be released on the specified platform. | Column window_start_date (DATE) in partner.partner_content_window']
  window_status varchar [note: 'Current lifecycle status of the content window (e.g., planned, active, expired, terminated early, suspended, or extended beyond original end date). | Column window_status (STRING) in partner.partner_content_window']
  window_type varchar [note: 'The distribution model or platform type for this release window (e.g., theatrical, SVOD, AVOD, TVOD, linear broadcast, syndication). [ENUM-REF-CANDIDATE: theatrical|svod|avod|tvod|linear|syndication|vod|fast|free_to_air|pay_per_view — 10 candidates stripped; promote to reference product] | Column window_type (STRING) in partner.partner_content_window']

  Note: 'Defines the sequential release windows (theatrical, SVOD, AVOD, TVOD, linear, syndication) granted to or from partners for specific content titles under acquisition, distribution, or syndication agreements. Tracks window type, platform exclusivity, start and end dates, holdback periods, and window sequencing order. Authoritative source for windowing strategy within the partner domain, complementing the rights domain\'s rights window records. | Unity Catalog table: media_broadcasting_ecm.partner.partner_content_window'
}

Table partner.renewal {
  renewal_id varchar [pk, note: 'Unique identifier for the partner renewal record. Primary key for tracking renewal lifecycle events across acquisition deals, distribution agreements, affiliate agreements, and syndication contracts. | Column renewal_id (BIGINT) in partner.renewal']
  partner_agreement_id varchar [note: 'Reference to the specific partner agreement being renewed. May link to acquisition deals, distribution agreements, affiliate agreements, syndication contracts, or co-production arrangements depending on agreement type. | Column agreement_id (BIGINT) in partner.renewal']
  partner_id varchar [note: 'Reference to the partner organization whose agreement is up for renewal. Links to the partner master record for studios, syndicators, content providers, MVPDs, and third-party distribution partners. | Column partner_id (BIGINT) in partner.renewal']
  primary_renewal_employee_id varchar [note: 'Reference to the employee responsible for managing this partner relationship and driving the renewal process. Typically a content acquisition manager, distribution director, or partnership manager. | Column renewal_employee_id (BIGINT) in workforce.renewal']
  quaternary_renewal_legal_reviewer_employee_id varchar [note: 'Reference to the legal counsel assigned to review renewal terms, assess risk, and ensure compliance with regulatory requirements and corporate policies. | Column renewal_legal_reviewer_employee_id (BIGINT) in workforce.renewal']
  tertiary_renewal_finance_approver_employee_id varchar [note: 'Reference to the finance executive responsible for budget approval and financial impact assessment. Required approval level varies based on deal value thresholds. | Column renewal_finance_approver_employee_id (BIGINT) in workforce.renewal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.renewal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.renewal']
  agreement_type varchar [note: 'Classification of the partner agreement being renewed. Determines which business rules, approval workflows, and financial terms apply to the renewal process. | Column agreement_type (STRING) in partner.renewal']
  approval_workflow_stage varchar [note: 'Current stage in the multi-level approval process. Workflow stages and required approvers vary based on deal value thresholds, strategic importance, and organizational governance policies. [ENUM-REF-CANDIDATE: business_owner_review|legal_review|finance_review|executive_review|board_approval|final_approval|completed — 7 candidates stripped; promote to reference product] | Column approval_workflow_stage (STRING) in partner.renewal']
  auto_renewal_clause_flag boolean [note: 'Indicates whether the original agreement contains an automatic renewal provision. When true, agreement renews automatically unless explicit non-renewal notice is provided by the decision due date. | Column auto_renewal_clause_flag (BOOLEAN) in partner.renewal']
  auto_renewal_terms varchar [note: 'Detailed description of automatic renewal provisions including renewal term length, rate escalation clauses, and conditions under which auto-renewal applies. Critical for preventing unintended contract extensions. | Column auto_renewal_terms (STRING) in partner.renewal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.renewal']
  created_timestamp timestamp [note: 'System timestamp when this renewal record was first created in the system. Typically corresponds to renewal trigger date when automated workflow initiates the renewal evaluation process. | Column created_timestamp (TIMESTAMP) in partner.renewal']
  decision_due_date date [note: 'Deadline by which the organization must communicate renewal decision to the partner. Failure to meet this date may trigger auto-renewal clauses or result in unintended agreement lapse. | Column decision_due_date (DATE) in partner.renewal']
  key_terms_summary varchar [note: 'Executive summary of material changes and key provisions in the proposed renewal including pricing adjustments, rights modifications, performance guarantees, and strategic commitments. | Column key_terms_summary (STRING) in partner.renewal']
  last_modified_timestamp timestamp [note: 'System timestamp of the most recent update to this renewal record. Tracks progression through workflow stages, term modifications, and status changes throughout the renewal lifecycle. | Column last_modified_timestamp (TIMESTAMP) in partner.renewal']
  non_renewal_reason varchar [note: 'Detailed explanation when renewal outcome is not_renewed or terminated. Captures business rationale such as poor content performance, unfavorable terms, strategic realignment, or partner performance issues. | Column non_renewal_reason (STRING) in partner.renewal']
  notes varchar [note: 'Free-form text field for capturing negotiation history, stakeholder feedback, special considerations, and contextual information relevant to the renewal decision and process. | Column notes (STRING) in partner.renewal']
  original_agreement_end_date date [note: 'Expiration date of the current agreement term. Triggers renewal workflow initiation based on advance notice requirements specified in the contract. | Column original_agreement_end_date (DATE) in partner.renewal']
  original_agreement_start_date date [note: 'Effective start date of the current agreement term being renewed. Provides historical context for relationship duration and performance evaluation. | Column original_agreement_start_date (DATE) in partner.renewal']
  original_deal_value_amount decimal(18,2) [note: 'Total financial value of the current agreement term being renewed. Provides baseline for evaluating proposed renewal terms and calculating value change percentage. | Column original_deal_value_amount (DECIMAL(18,2)) in partner.renewal']
  outcome varchar [note: 'Final disposition of the renewal process. Renewed indicates acceptance of proposed terms; renegotiated indicates material changes from original proposal; not_renewed or terminated indicates relationship conclusion. | Column outcome (STRING) in partner.renewal']
  outcome_date date [note: 'Date when final renewal decision was communicated to the partner. Critical for audit trail, compliance verification, and preventing disputes over notice timing. | Column outcome_date (DATE) in partner.renewal']
  partner_performance_rating varchar [note: 'Overall assessment of partner performance during the current agreement term. Evaluates content quality, delivery timeliness, audience performance, rights compliance, and relationship collaboration. Key input to renewal decision. | Column partner_performance_rating (STRING) in partner.renewal']
  proposed_deal_value_amount decimal(18,2) [note: 'Total financial value of the proposed renewed agreement over its full term. Used for budget planning, financial forecasting, and executive approval thresholds. | Column proposed_deal_value_amount (DECIMAL(18,2)) in partner.renewal']
  proposed_deal_value_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the proposed deal value. Essential for multi-currency contract management and financial consolidation. | Column proposed_deal_value_currency_code (STRING) in partner.renewal']
  proposed_end_date date [note: 'Intended expiration date for the renewed agreement. Calculated from proposed start date plus proposed term length. | Column proposed_end_date (DATE) in partner.renewal']
  proposed_payment_terms varchar [note: 'Detailed payment schedule and terms for the renewed agreement including payment frequency, milestone-based payments, minimum guarantees, revenue share percentages, and payment methods. | Column proposed_payment_terms (STRING) in partner.renewal']
  proposed_renewal_term_months varchar [note: 'Duration in months for the proposed renewed agreement. May differ from original term based on negotiation outcomes, market conditions, or strategic relationship objectives. | Column proposed_renewal_term_months (INT) in partner.renewal']
  proposed_rights_scope varchar [note: 'Description of content rights, distribution territories, platform exclusivity, windowing strategies, and sublicensing provisions proposed for the renewed agreement. Critical for rights management and content strategy alignment. | Column proposed_rights_scope (STRING) in partner.renewal']
  proposed_start_date date [note: 'Intended effective date for the renewed agreement. Typically aligns with original agreement end date to ensure continuity, but may include gap or overlap periods based on negotiation. | Column proposed_start_date (DATE) in partner.renewal']
  renegotiation_priority varchar [note: 'Business priority level for renegotiation efforts. Critical priority indicates strategic partnerships requiring executive involvement; low priority may allow standard renewal terms. | Column renegotiation_priority (STRING) in partner.renewal']
  renegotiation_required_flag boolean [note: 'Indicates whether material terms must be renegotiated rather than simply renewed under existing terms. Set to true when market conditions, partner performance, or strategic priorities require substantive changes. | Column renegotiation_required_flag (BOOLEAN) in partner.renewal']
  renewal_number varchar [note: 'Business identifier for this renewal instance. Typically follows a pattern incorporating the original agreement number plus renewal sequence (e.g., ACQ-2023-001-R02 for second renewal). | Column renewal_number (STRING) in partner.renewal']
  renewal_status varchar [note: 'Current lifecycle state of the renewal process. Tracks progression through review, negotiation, approval workflow stages, and final outcome determination. [ENUM-REF-CANDIDATE: pending_review|under_negotiation|legal_review|finance_approval|executive_approval|approved|declined|expired|cancelled — 9 candidates stripped; promote to reference product] | Column renewal_status (STRING) in partner.renewal']
  risk_assessment varchar [note: 'Evaluation of risks associated with renewal including financial exposure, rights clearance issues, regulatory compliance concerns, partner stability, and competitive threats. Informs approval requirements and contract protections. | Column risk_assessment (STRING) in partner.renewal']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.renewal']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.renewal']
  strategic_importance varchar [note: 'Assessment of the partners strategic value to the organizations content strategy, audience reach, and competitive positioning. Critical and high importance partners receive priority attention in renewal negotiations. | Column strategic_importance (STRING) in partner.renewal']
  trigger_date date [note: 'Date when the renewal evaluation process was initiated. Typically calculated based on original agreement end date minus advance notice period (e.g., 90 days, 180 days) specified in contract terms. | Column trigger_date (DATE) in partner.renewal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.renewal']
  value_change_percentage decimal(5,2) [note: 'Percentage change between original deal value and proposed renewal value. Positive values indicate cost increases; negative values indicate cost reductions. Critical metric for financial impact assessment. | Column value_change_percentage (DECIMAL(5,2)) in partner.renewal']

  Note: 'Tracks the renewal lifecycle for expiring partner agreements — acquisition deals, distribution agreements, affiliate agreements, and syndication contracts. Captures renewal trigger date, auto-renewal clause status, renegotiation flag, proposed new terms, approval workflow stage, and renewal outcome. Enables proactive deal management and prevents unintended agreement lapses. | Unity Catalog table: media_broadcasting_ecm.partner.renewal'
}

Table partner.partner_deal_approval {
  partner_deal_approval_id varchar [pk, note: 'Unique identifier for the deal approval record. Primary key for the deal approval workflow entity. | Column partner_deal_approval_id (BIGINT) in partner.partner_deal_approval']
  acquisition_deal_id varchar [note: 'Reference to the acquisition deal requiring approval. Links to the acquisition deal being evaluated for sign-off. | Column acquisition_deal_id (BIGINT) in partner.partner_deal_approval']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: deal_approval should support affiliate_agreement approvals. New FK: affiliate_agreement_id → affiliate_agreement.affiliate_agreement_id. Nullable (only populated when approving affiliate agreements). | Column affiliate_agreement_id (BIGINT) in partner.partner_deal_approval']
  coproduction_agreement_id varchar [note: 'Reference to the co-production agreement requiring approval. Nullable when approval is for acquisition deals or distribution agreements. | Column coproduction_agreement_id (BIGINT) in partner.partner_deal_approval']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Deal approvals require cost center budget authority validation and spend authorization. Essential for SOX compliance, budget control, and approval workflow routing based on departmental spending limit | Column cost_center_id (BIGINT) in finance.partner_deal_approval']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: deal_approval currently supports acquisition_deal and coproduction_agreement approvals. Should also support distribution_agreement approvals. New FK: distribution_agreement_id → distribution_agreement | Column distribution_agreement_id (BIGINT) in partner.partner_deal_approval']
  partner_sales_deal_approval_id varchar [note: 'Foreign key to SSOT sales.sales_deal_approval']
  partner_sales_sales_deal_approval_id varchar [note: 'FK to SSOT sales.sales_deal_approval']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Deal approvals validate profit center P&L impact and strategic alignment. Critical for segment-level investment decisions, EBITDA covenant compliance, and business unit accountability in content inves | Column profit_center_id (BIGINT) in finance.partner_deal_approval']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: High-value deal approvals (especially license transfers, ownership changes, foreign ownership increases, or control transfers) require concurrent FCC regulatory filings. Approval workflows must verify | Column regulatory_filing_id (BIGINT) in compliance.partner_deal_approval']
  sox_control_id varchar [note: 'Reference to the SOX internal control that governs this approval workflow. Links to the authorization control framework for audit and compliance reporting. | Column sox_control_id (BIGINT) in compliance.partner_deal_approval']
  submitted_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Approval workflow requires structured submitter tracking for audit trail and workload reporting. Has approver_employee_id FK but submitter is text fields - need FK for submission volume by employee, a | Column submitted_by_employee_id (BIGINT) in workforce.partner_deal_approval']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: deal_approval should support syndication_agreement approvals. New FK: syndication_agreement_id → syndication_agreement.syndication_agreement_id. Nullable (only populated when approving syndication agr | Column syndication_agreement_id (BIGINT) in partner.partner_deal_approval']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.partner_deal_approval']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.partner_deal_approval']
  approval_conditions varchar [note: 'Stipulations or requirements that must be satisfied before deal execution. Examples include legal review completion, budget reallocation, or third-party consent. | Column approval_conditions (STRING) in partner.partner_deal_approval']
  approval_decision varchar [note: 'Final determination rendered by the approver. Conditional approvals require fulfillment of specified conditions before execution. | Column approval_decision (STRING) in partner.partner_deal_approval']
  approval_expiration_date date [note: 'Date after which the approval is no longer valid and must be resubmitted. Ensures approvals reflect current business conditions and deal terms. | Column approval_expiration_date (DATE) in partner.partner_deal_approval']
  approval_level varchar [note: 'Organizational tier required for sign-off. Escalation level determined by deal value, risk profile, and strategic impact. | Column approval_level (STRING) in partner.partner_deal_approval']
  approval_request_number varchar [note: 'Business identifier for the approval request. Human-readable reference number used in communications and audit trails. | Column approval_request_number (STRING) in partner.partner_deal_approval']
  approval_status varchar [note: 'Current state of the approval workflow. Tracks progression through the sign-off process from submission to final decision. [ENUM-REF-CANDIDATE: pending|in_review|approved|rejected|conditional|withdrawn|expired — 7 candidates stripped; promote to reference product] | Column approval_status (STRING) in partner.partner_deal_approval']
  approval_threshold_exceeded_flag boolean [note: 'Indicates whether the deal value exceeds the monetary threshold requiring elevated approval. True triggers escalation to CFO or board per SOX authorization controls. | Column approval_threshold_exceeded_flag (BOOLEAN) in partner.partner_deal_approval']
  approver_email varchar [note: 'Email address of the approver for notification and audit purposes. Used for workflow routing and decision confirmation. | Column approver_email (STRING) in partner.partner_deal_approval']
  approver_name varchar [note: 'Full name of the individual who rendered the approval decision. Confidential for audit trail and accountability purposes. | Column approver_name (STRING) in partner.partner_deal_approval']
  approver_role varchar [note: 'Functional role of the individual or committee authorized to approve. Examples include VP Content Acquisition, General Counsel, Chief Financial Officer (CFO), Board of Directors. | Column approver_role (STRING) in partner.partner_deal_approval']
  audit_trail_notes varchar [note: 'Free-text field for additional context, clarifications, or audit annotations. Supports SOX compliance documentation and internal control testing. | Column audit_trail_notes (STRING) in partner.partner_deal_approval']
  carriage_fee_commitment_amount decimal(18,2) [note: 'Distribution payment obligation to Multichannel Video Programming Distributors (MVPD) or virtual Multichannel Video Programming Distributors (vMVPD). Material carriage fee agreements require CFO sign-off. | Column carriage_fee_commitment_amount (DECIMAL(18,2)) in partner.partner_deal_approval']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.partner_deal_approval']
  created_timestamp timestamp [note: 'Date and time when the approval record was first created in the system. Audit field for data lineage and record lifecycle tracking. | Column created_timestamp (TIMESTAMP) in partner.partner_deal_approval']
  deal_type varchar [note: 'Category of partner deal requiring approval. Determines the approval workflow path and required sign-off levels. | Column deal_type (STRING) in partner.partner_deal_approval']
  deal_value_amount decimal(18,2) [note: 'Total financial commitment of the deal requiring approval. Includes minimum guarantees (MG), license fees, and revenue share commitments. Used to determine approval threshold. | Column deal_value_amount (DECIMAL(18,2)) in partner.partner_deal_approval']
  deal_value_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the deal value. Required for multi-currency deal portfolio management. | Column deal_value_currency_code (STRING) in partner.partner_deal_approval']
  decision_timestamp timestamp [note: 'Date and time when the approval decision was rendered. Critical for SOX audit trails and time-sensitive deal execution. | Column decision_timestamp (TIMESTAMP) in partner.partner_deal_approval']
  escalation_count varchar [note: 'Number of times the approval request has been escalated to a higher authority. Tracks workflow complexity and decision-making bottlenecks. | Column escalation_count (INT) in partner.partner_deal_approval']
  finance_review_completed_date date [note: 'Date when finance department completed their review and cleared the deal for approval. Nullable if finance review is not required or still pending. | Column finance_review_completed_date (DATE) in partner.partner_deal_approval']
  finance_review_required_flag boolean [note: 'Indicates whether finance department review is mandatory before approval. True for deals with material budget impact or complex payment structures. | Column finance_review_required_flag (BOOLEAN) in partner.partner_deal_approval']
  ip_ownership_percentage decimal(5,2) [note: 'Percentage of intellectual property rights retained or acquired in co-production arrangements. IP ownership implications require legal and executive approval. | Column ip_ownership_percentage (DECIMAL(5,2)) in partner.partner_deal_approval']
  last_modified_by varchar [note: 'Identifier of the user or system process that last modified the approval record. Supports audit trail and change management. | Column last_modified_by (STRING) in partner.partner_deal_approval']
  last_modified_timestamp timestamp [note: 'Date and time when the approval record was last updated. Tracks changes to approval status, conditions, or decision outcomes. | Column last_modified_timestamp (TIMESTAMP) in partner.partner_deal_approval']
  legal_review_completed_date date [note: 'Date when legal counsel completed their review and cleared the deal for approval. Nullable if legal review is not required or still pending. | Column legal_review_completed_date (DATE) in partner.partner_deal_approval']
  legal_review_required_flag boolean [note: 'Indicates whether legal counsel review is mandatory before approval. True for deals with IP ownership, exclusivity, or complex rights structures. | Column legal_review_required_flag (BOOLEAN) in partner.partner_deal_approval']
  minimum_guarantee_amount decimal(18,2) [note: 'Upfront or guaranteed payment commitment in the deal. Acquisition deals above MG thresholds trigger mandatory CFO or board approval per SOX controls. | Column minimum_guarantee_amount (DECIMAL(18,2)) in partner.partner_deal_approval']
  rejection_reason varchar [note: 'Explanation provided when approval is denied. Documents business rationale for audit and learning purposes. | Column rejection_reason (STRING) in partner.partner_deal_approval']
  risk_tier varchar [note: 'Risk classification of the deal based on financial exposure, partner creditworthiness, and strategic impact. High and critical tiers require elevated approval levels. | Column risk_tier (STRING) in partner.partner_deal_approval']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.partner_deal_approval']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.partner_deal_approval']
  strategic_importance varchar [note: 'Business significance of the deal to corporate objectives. Transformational deals require board-level approval regardless of financial threshold. | Column strategic_importance (STRING) in partner.partner_deal_approval']
  submission_timestamp timestamp [note: 'Date and time when the approval request was submitted into the workflow. Marks the start of the approval lifecycle for Service Level Agreement (SLA) tracking. | Column submission_timestamp (TIMESTAMP) in partner.partner_deal_approval']
  supporting_document_reference varchar [note: 'Reference identifier or URI to supporting documentation attached to the approval request. Includes deal summaries, financial models, and legal memos. | Column supporting_document_reference (STRING) in partner.partner_deal_approval']
  target_execution_date date [note: 'Desired date for deal execution and contract signing. Used to prioritize approval workflow and ensure timely decision-making. | Column target_execution_date (DATE) in partner.partner_deal_approval']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.partner_deal_approval']

  Note: 'Approval workflow records for partner deals requiring internal sign-off before execution — acquisition deals above MG thresholds, distribution agreements with carriage fee commitments, and co-production arrangements with IP ownership implications. Tracks approver role, approval level (business unit, legal, CFO, board), decision, conditions, and timestamp. Supports SOX-compliant deal authorization controls. | Unity Catalog table: media_broadcasting_ecm.partner.partner_deal_approval'
}

Table partner.license_ownership {
  license_ownership_id varchar [pk, note: 'Unique identifier for this ownership relationship record. Primary key for the license_ownership association. | Column license_ownership_id (BIGINT) in partner.license_ownership']
  broadcast_license_id varchar [note: 'Foreign key linking to the broadcast license in which the partner holds an attributable interest | Column broadcast_license_id (BIGINT) in compliance.license_ownership']
  partner_id varchar [note: 'Foreign key linking to the partner entity that holds an attributable interest in the broadcast license | Column partner_id (BIGINT) in partner.license_ownership']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.license_ownership']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.license_ownership']
  attribution_status varchar [note: 'Regulatory classification indicating whether this ownership interest is attributable under FCC rules (typically interests above 5% for voting stock, 33% for limited partnerships, or any officer/director position). Values: Attributable, Non-Attributable, Pending Review, Exempt. | Column attribution_status (STRING) in partner.license_ownership']
  control_relationship_type varchar [note: 'Nature of the control or ownership relationship between the partner and the licensed entity. Values: Equity Owner, Parent Company, Officer, Director, General Partner, Limited Partner, Creditor, Other. | Column control_relationship_type (STRING) in partner.license_ownership']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.license_ownership']
  disclosure_required boolean [note: 'Indicates whether this ownership interest must be disclosed on FCC Form 323 or equivalent regulatory filings. True if the interest meets attribution thresholds or involves officers/directors. | Column disclosure_required (BOOLEAN) in partner.license_ownership']
  effective_date date [note: 'Date when this ownership or control relationship became effective. Used for tracking ownership changes over time and determining applicable regulatory filing deadlines. | Column effective_date (DATE) in partner.license_ownership']
  filing_reference varchar [note: 'Reference number or identifier for the regulatory filing (FCC Form 323, license transfer application, etc.) that documents this ownership relationship. Used for audit trail and compliance verification. | Column filing_reference (STRING) in partner.license_ownership']
  notes varchar [note: 'Free-text field for additional context about the ownership relationship, including special arrangements, regulatory waivers, or pending ownership changes. | Column notes (STRING) in partner.license_ownership']
  ownership_percentage decimal(5,2) [note: 'Percentage of equity or voting interest that the partner holds in the licensed entity. Used to determine attributable interest under FCC ownership rules. Values range from 0.01 to 100.00. | Column ownership_percentage (DECIMAL(5,2)) in partner.license_ownership']
  position_title varchar [note: 'Official title or position held by the partner representative in the licensed entity (e.g., CEO, Board Member, General Partner). Applicable when control_relationship_type is Officer, Director, or General Partner. | Column position_title (STRING) in partner.license_ownership']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.license_ownership']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.license_ownership']
  termination_date date [note: 'Date when this ownership or control relationship was terminated or transferred. Null if the relationship is currently active. | Column termination_date (DATE) in partner.license_ownership']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.license_ownership']
  voting_rights_percentage decimal(5,2) [note: 'Percentage of voting rights held by the partner, which may differ from equity ownership percentage in cases of dual-class stock or special voting arrangements. Critical for FCC attribution analysis. | Column voting_rights_percentage (DECIMAL(5,2)) in partner.license_ownership']

  Note: 'This association product represents the ownership and control relationship between partners and broadcast licenses. It captures the attributable interest that partners (equity investors, parent companies, affiliated entities) hold in licensed broadcast stations, including ownership percentages, control relationships, and regulatory disclosure requirements for FCC Form 323 and license transfer applications. Each record links one partner to one broadcast license with attributes that exist only in the context of this ownership relationship.. Existence Justification: In media broadcasting, partners (equity investors, parent companies, affiliated entities) can hold ownership or control interests in multiple broadcast licenses, and each broadcast license can have multiple attributable partners with varying ownership percentages and control relationships. The FCC and other regulatory bodies require detailed tracking of these ownership relationships for Form 323 filings, license transfers, and compliance with ownership concentration rules. This is an operational relationship that broadcasters actively manage for regulatory compliance. | Unity Catalog table: media_broadcasting_ecm.partner.license_ownership'
}

Table partner.deal_compliance_obligation {
  deal_compliance_obligation_id varchar [pk, note: 'Unique identifier for this deal-specific compliance obligation record. Primary key. | Column deal_compliance_obligation_id (BIGINT) in partner.deal_compliance_obligation']
  acquisition_deal_id varchar [note: 'Foreign key linking to the content acquisition deal that triggers this compliance obligation | Column acquisition_deal_id (BIGINT) in partner.deal_compliance_obligation']
  distribution_agreement_id varchar [note: 'Associated distribution agreement']
  regulatory_obligation_id varchar [note: 'Foreign key linking to the regulatory obligation applicable to this acquisition deal | Column regulatory_obligation_id (BIGINT) in compliance.deal_compliance_obligation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.deal_compliance_obligation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.deal_compliance_obligation']
  audit_trail_reference varchar [note: 'Reference identifier to the audit trail, documentation, or evidence supporting compliance verification for this deal-obligation pairing | Column audit_trail_reference (STRING) in partner.deal_compliance_obligation']
  certification_required boolean [note: 'Indicates whether formal certification or attestation is required for this deal-obligation combination | Column certification_required (BOOLEAN) in partner.deal_compliance_obligation']
  completion_date date [note: 'Date obligation was completed']
  compliance_status varchar [note: 'Current compliance status for this deal-obligation pairing: pending (awaiting verification), verified (compliant), non_compliant (violation identified), waived (exemption granted), not_applicable (obligation does not apply to this specific deal) | Column compliance_status (STRING) in partner.deal_compliance_obligation']
  compliance_verification_date date [note: 'Date when compliance with this specific obligation was verified for this acquisition deal | Column compliance_verification_date (DATE) in partner.deal_compliance_obligation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.deal_compliance_obligation']
  created_timestamp timestamp [note: 'Record creation timestamp']
  due_date date [note: 'Due date for compliance']
  escalation_contact_email varchar [note: 'Contact email for escalation']
  escalation_contact_name varchar [note: 'Contact name for escalation']
  evidence_document_url varchar [note: 'URL to compliance evidence document']
  last_verified_date date
  next_review_date date [note: 'Scheduled date for the next compliance review or re-verification of this obligation for this deal | Column next_review_date (DATE) in partner.deal_compliance_obligation']
  notes varchar [note: 'Free-text notes documenting special circumstances, exemptions, or additional context for this deal-obligation compliance relationship | Column notes (STRING) in partner.deal_compliance_obligation']
  obligation_description varchar [note: 'Detailed description of the obligation']
  obligation_triggered_date date [note: 'Date when this regulatory obligation was triggered or became applicable to this acquisition deal, typically aligned with deal execution or content delivery | Column obligation_triggered_date (DATE) in partner.deal_compliance_obligation']
  obligation_type varchar [note: 'Type of compliance obligation']
  penalty_amount decimal(18,2) [note: 'Penalty amount for non-compliance']
  penalty_currency varchar [note: 'Currency of penalty amount']
  penalty_currency_code varchar [note: 'Currency code for penalty amount']
  responsible_party varchar [note: 'Name or identifier of the individual or team responsible for ensuring compliance with this obligation for this specific deal | Column responsible_party (STRING) in partner.deal_compliance_obligation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.deal_compliance_obligation']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.deal_compliance_obligation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.deal_compliance_obligation']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  verification_method varchar
  waiver_expiration_date date [note: 'Expiration date of waiver']
  waiver_flag boolean [note: 'Whether a waiver was granted']
  waiver_reason varchar [note: 'Reason for waiver if granted']

  Note: 'This association product represents the compliance relationship between acquisition deals and regulatory obligations. It captures the specific regulatory obligations triggered by each content acquisition deal, tracking compliance verification status, responsible parties, and certification requirements. Each record links one acquisition deal to one regulatory obligation with attributes that exist only in the context of this deal-specific compliance requirement.. Existence Justification: In media broadcasting operations, a single acquisition deal can trigger multiple distinct regulatory obligations (content rating certification, COPPA compliance for kids content, closed captioning requirements, political disclosure rules, territorial licensing restrictions), and each regulatory obligation applies to multiple acquisition deals across the content portfolio. Compliance teams actively manage these deal-obligation pairings, tracking verification status, responsible parties, certification requirements, and audit trails for each combination. This is an operational compliance management process, not an analytical correlation. | Unity Catalog table: media_broadcasting_ecm.partner.deal_compliance_obligation'
}

Table partner.vendor {
