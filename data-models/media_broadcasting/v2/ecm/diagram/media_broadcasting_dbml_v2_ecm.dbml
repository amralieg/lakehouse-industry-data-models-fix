  blackout_credit_amount decimal(18,2) [note: 'Credit amount applied for geographic broadcast blackout periods where channel was unavailable to MVPD subscribers. | Column blackout_credit_amount (DECIMAL(18,2)) in billing.billing_carriage_fee_invoice']
  channel_lineup_description varchar [note: 'Description of the channel lineup or package included in this carriage fee invoice. | Column channel_lineup_description (STRING) in billing.billing_carriage_fee_invoice']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in billing.billing_carriage_fee_invoice']
