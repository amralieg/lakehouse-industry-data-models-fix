ind:mortalityReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Mortality Review Status' ;
    rdfs:comment 'Current lifecycle state of the mortality review.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventability rdf:type rdf:Property ;
    rdfs:label 'Preventability' ;
    rdfs:comment 'Determination of whether the death was potentially preventable.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMetricFlag rdf:type rdf:Property ;
