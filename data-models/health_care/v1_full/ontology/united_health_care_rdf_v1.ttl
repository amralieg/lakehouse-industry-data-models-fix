    rdfs:comment 'Flag indicating whether the member is eligible for both Medicare and Medicaid, qualifying for special dual eligible plans and benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subsidyIndicator rdf:type rdf:Property ;
    rdfs:label 'Subsidy Indicator' ;
    rdfs:comment 'Flag indicating whether the member receives premium subsidies or cost-sharing reductions through the health insurance marketplace.' ;
    rdfs:domain ind:History ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costSharingReductionLevel rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Reduction Level' ;
    rdfs:comment 'The actuarial value level of cost-sharing reductions provided to eligible marketplace enrollees, expressed as a percentage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profileId rdf:type rdf:Property ;
