    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutAvailable rdf:type rdf:Property ;
    rdfs:label 'Opt Out Available' ;
    rdfs:comment 'Indicates whether the notification includes instructions for opting out of future communications.' ;
