    rdfs:range xsd:string .

ind:streamingPlatform rdf:type rdf:Property ;
    rdfs:label 'Streaming Platform' ;
    rdfs:comment 'Primary digital streaming service where brand content is distributed to fans.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagline rdf:type rdf:Property ;
    rdfs:label 'Tagline' ;
    rdfs:comment 'Official marketing tagline or slogan associated with the brand for promotional and fan engagement purposes.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trademarkExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Trademark Expiry Date' ;
    rdfs:comment 'Date when the current trademark registration expires and requires renewal to maintain legal protection.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trademarkRegistrationDate rdf:type rdf:Property ;
    rdfs:label 'Trademark Registration Date' ;
    rdfs:comment 'Date when the brand trademark was officially registered with the relevant intellectual property authority.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trademarkRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Trademark Registration Number' ;
    rdfs:comment 'Official registration number assigned by the trademark authority for legal protection of the brand name and identity.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountCategory rdf:type rdf:Property ;
    rdfs:label 'Account Category' ;
    rdfs:comment 'The sub-classification within the account type that provides additional granularity for financial statement presentation and analysis (e.g., current vs. fixed assets, operating vs. non-operating revenue).' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountGroup rdf:type rdf:Property ;
    rdfs:label 'Account Group' ;
    rdfs:comment 'The grouping code used to aggregate similar accounts for reporting and analysis purposes. Used in SAP S/4HANA for account determination and financial statement version assignment.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByUser rdf:type rdf:Property ;
    rdfs:label 'Approved By User' ;
    rdfs:comment 'The user ID of the approver who authorized the creation or modification of this chart of accounts entry. Required for SOX compliance and segregation of duties controls.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrRelevant rdf:type rdf:Property ;
    rdfs:label 'Arr Relevant' ;
    rdfs:comment 'Indicates whether revenue posted to this account contributes to Annual Recurring Revenue (ARR) calculations for subscription-based business model tracking and investor reporting.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:balanceSheetClassification rdf:type rdf:Property ;
    rdfs:label 'Balance Sheet Classification' ;
    rdfs:comment 'Indicates whether the account is classified as current (within 12 months) or non-current (beyond 12 months) on the balance sheet, or not applicable for income statement accounts.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetTrackingEnabled rdf:type rdf:Property ;
    rdfs:label 'Budget Tracking Enabled' ;
    rdfs:comment 'Indicates whether budget vs. actual tracking is enabled for this account in the financial planning and analysis (FP&A) system for variance analysis and budget control.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cashFlowClassification rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Classification' ;
    rdfs:comment 'The classification of this account for cash flow statement presentation: operating activities, investing activities, financing activities, or not applicable for non-cash accounts.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consolidationAccount rdf:type rdf:Property ;
    rdfs:label 'Consolidation Account' ;
    rdfs:comment 'The corresponding account number in the corporate consolidation chart of accounts used for group-level financial consolidation and elimination of intercompany transactions.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costElement rdf:type rdf:Property ;
    rdfs:label 'Cost Element' ;
    rdfs:comment 'The cost element code in SAP Controlling (CO) module that links this general ledger account to cost accounting for expense allocation, cost center assignment, and profitability analysis.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ebitdaClassification rdf:type rdf:Property ;
    rdfs:label 'Ebitda Classification' ;
    rdfs:comment 'Indicates whether this account is included in or excluded from EBITDA calculations for management reporting and investor relations. Depreciation, amortization, interest, and tax accounts are excluded.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementLine rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Line' ;
    rdfs:comment 'The specific line item on the financial statement (balance sheet, income statement, cash flow statement) where this account balance is reported for external financial reporting.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:normalBalance rdf:type rdf:Property ;
    rdfs:label 'Normal Balance' ;
    rdfs:comment 'Indicates whether the account normally carries a debit or credit balance based on its account type. Assets and expenses have debit balances; liabilities, equity, and revenue have credit balances.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingAllowed rdf:type rdf:Property ;
    rdfs:label 'Posting Allowed' ;
    rdfs:comment 'Boolean flag indicating whether direct transaction postings are allowed to this account. Some accounts may be used only for consolidation or reporting purposes and do not accept direct postings.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationAccount rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Account' ;
    rdfs:comment 'Indicates whether this is a reconciliation account that is automatically updated from subsidiary ledgers (accounts receivable, accounts payable, fixed assets) and cannot be posted to directly.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedByUserId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Id' ;
    rdfs:comment 'Identifier of the user who approved the payment program for activation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditTrailRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Required Flag' ;
    rdfs:comment 'Indicates whether detailed audit trails must be maintained for all payments processed under this program.' ;
    rdfs:domain ind:PaymentProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baseRate rdf:type rdf:Property ;
    rdfs:label 'Base Rate' ;
    rdfs:comment 'Base payment rate or percentage used as the foundation for calculating payments under this program.' ;
    rdfs:domain ind:PaymentProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:createdByUserId rdf:type rdf:Property ;
    rdfs:label 'Created By User Id' ;
    rdfs:comment 'Identifier of the user who created the payment program record.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastModifiedByUserId rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User Id' ;
    rdfs:comment 'Identifier of the user who last modified the payment program record.' ;
    rdfs:domain ind:PaymentProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lateFeePercentage rdf:type rdf:Property ;
    rdfs:label 'Late Fee Percentage' ;
    rdfs:comment 'Percentage fee applied to late payments under this program after the grace period expires.' ;
    rdfs:domain ind:PaymentProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Payment Amount' ;
    rdfs:comment 'Maximum payment cap that limits the amount that can be paid in a single payment cycle under this program.' ;
    rdfs:domain ind:PaymentProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Payment Amount' ;
    rdfs:comment 'Minimum payment threshold that must be met for a payment to be processed under this program.' ;
    rdfs:domain ind:PaymentProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Program Owner Employee Id' ;
    rdfs:comment 'Identifier of the employee responsible for managing and overseeing this payment program.' ;
    rdfs:domain ind:PaymentProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxTreatmentCode rdf:type rdf:Property ;
    rdfs:label 'Tax Treatment Code' ;
    rdfs:comment 'Code indicating the tax treatment classification for payments under this program for compliance and reporting purposes.' ;
    rdfs:domain ind:PaymentProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentProposalId rdf:type rdf:Property ;
    rdfs:label 'Payment Proposal Id' ;
    rdfs:comment 'Primary key for payment_proposal' ;
    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:discountDueDate rdf:type rdf:Property ;
