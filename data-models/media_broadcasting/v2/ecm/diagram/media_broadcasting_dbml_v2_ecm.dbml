  created_timestamp timestamp [note: 'Timestamp when the dispute record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.partner_dispute']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the original disputed amount if different from USD. | Column currency_code (STRING) in partner.partner_dispute']
  dispute_category varchar [note: 'High-level category grouping disputes by functional area for reporting and routing purposes. | Column dispute_category (STRING) in partner.partner_dispute']
  dispute_description varchar [note: 'Detailed narrative description of the dispute, including the nature of the disagreement, relevant facts, and partner claims. | Column dispute_description (STRING) in partner.partner_dispute']
  dispute_number varchar [note: 'Externally-visible unique reference number assigned to the dispute for tracking and communication purposes. | Column dispute_number (STRING) in partner.partner_dispute']
  dispute_status varchar [note: 'Current lifecycle state of the dispute. Tracks progression from initiation through resolution or closure. [ENUM-REF-CANDIDATE: open|under_review|escalated|pending_evidence|negotiation|mediation|arbitration|resolved|closed|withdrawn — 10 candidates stripped; promote to reference product] | Column dispute_status (STRING) in partner.partner_dispute']
  dispute_type varchar [note: 'Classification of the dispute by its primary subject matter. Determines escalation path and resolution workflow. | Column dispute_type (STRING) in partner.partner_dispute']
  disputed_amount_usd decimal(18,2) [note: 'The monetary value in dispute, expressed in USD. Represents the financial exposure or claim amount. | Column disputed_amount_usd (DECIMAL(18,2)) in partner.partner_dispute']
  disputed_period_end_date date [note: 'End date of the time period to which the dispute relates. | Column disputed_period_end_date (DATE) in partner.partner_dispute']
  disputed_period_start_date date [note: 'Start date of the time period to which the dispute relates (e.g., billing cycle, content delivery window). | Column disputed_period_start_date (DATE) in partner.partner_dispute']
  escalation_level varchar [note: 'Current escalation tier within the dispute resolution hierarchy, from operational to executive or legal levels. | Column escalation_level (STRING) in partner.partner_dispute']
  evidence_submitted_date date [note: 'Date on which supporting evidence was submitted by the disputing party. | Column evidence_submitted_date (DATE) in partner.partner_dispute']
  filed_date date [note: 'Date on which the dispute was formally filed or raised by either party. | Column filed_date (DATE) in partner.partner_dispute']
  initiated_by varchar [note: 'Indicates whether the dispute was raised by the partner or by the internal organization. | Column initiated_by (STRING) in partner.partner_dispute']
  legal_hold_date date [note: 'Date on which the legal hold was initiated for this dispute. | Column legal_hold_date (DATE) in partner.partner_dispute']
  legal_hold_status boolean [note: 'Indicates whether a legal hold has been placed on records and communications related to this dispute for litigation preservation. | Column legal_hold_status (BOOLEAN) in partner.partner_dispute']
  mediation_required boolean [note: 'Indicates whether the dispute requires or has entered formal mediation per contractual dispute resolution clauses. | Column mediation_required (BOOLEAN) in partner.partner_dispute']
