  intercompany_flag boolean [note: 'Flag indicating whether this recurring entry template generates intercompany transactions requiring elimination during consolidation. | Column intercompany_flag (BOOLEAN) in finance.recurring_entry_template']
  last_execution_date date [note: 'Date when a journal entry was most recently generated from this recurring entry template. | Column last_execution_date (DATE) in finance.recurring_entry_template']
