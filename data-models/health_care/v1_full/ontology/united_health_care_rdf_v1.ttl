    rdfs:range xsd:string .

ind:benefitTypeName rdf:type rdf:Property ;
    rdfs:label 'Benefit Type Name' ;
    rdfs:comment 'Human-readable name of the benefit type (e.g., Inpatient Hospital, Outpatient Surgery, Prescription Drugs, Primary Care Visit).' ;
    rdfs:domain ind:CostSharing ;
    rdf:type owl:DatatypeProperty ;
