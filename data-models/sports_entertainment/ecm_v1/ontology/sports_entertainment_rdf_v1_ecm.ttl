ind:parentCategoryId rdf:type rdf:Property ;
    rdfs:label 'Parent Category Id' ;
    rdfs:comment 'Reference to parent content category for hierarchical taxonomy structure. Null for top-level categories. Enables multi-level content classification trees.' ;
