    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContractTermination .

ind:noticeDate rdf:type rdf:Property ;
    rdfs:label 'Notice Date' ;
    rdfs:comment 'Date on which formal written notice of termination was provided to the affected party, as required by contract terms.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:runOutPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Run Out Period End Date' ;
    rdfs:comment 'Date through which claims for services rendered prior to termination effective date will continue to be processed and paid under the terminated contract terms.' ;
    rdfs:domain ind:ContractTermination ;
    rdf:type owl:DatatypeProperty ;
