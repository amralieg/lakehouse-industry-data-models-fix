    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peerReferencesStatus rdf:type rdf:Property ;
    rdfs:label 'Peer References Status' ;
    rdfs:comment 'Status indicating whether the required number of peer references have been obtained and verified.' ;
    rdfs:domain ind:CredentialingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationCompleteDate rdf:type rdf:Property ;
    rdfs:label 'Application Complete Date' ;
    rdfs:comment 'Date when the credentialing application was deemed complete with all required documentation.' ;
