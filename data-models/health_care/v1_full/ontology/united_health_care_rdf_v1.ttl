ind:abandonmentRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Abandonment Rate Percentage' ;
    rdfs:comment 'Percentage of interactions that are abandoned by members before completion, indicating channel performance and member satisfaction.' ;
    rdfs:domain ind:ServiceChannel ;
