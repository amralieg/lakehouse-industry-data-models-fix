    rdfs:domain ind:ServiceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fcrTargetPercentage rdf:type rdf:Property ;
    rdfs:label 'Fcr Target Percentage' ;
    rdfs:comment 'Target percentage for first call resolution on this channel, representing the goal for resolving member inquiries on the first contact.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityLimit rdf:type rdf:Property ;
    rdfs:label 'Capacity Limit' ;
    rdfs:comment 'Maximum number of concurrent interactions that can be handled through this channel at any given time.' ;
