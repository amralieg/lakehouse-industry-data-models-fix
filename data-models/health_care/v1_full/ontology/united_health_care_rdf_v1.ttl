    rdfs:comment 'Indicates whether this care event type contributes to Medicare Stars quality rating measures.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:starsMeasure rdf:type rdf:Property ;
    rdfs:label 'Stars Measure' ;
    rdfs:comment 'The specific Medicare Stars measure code(s) that this care event type supports, if applicable.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isHccRelevant rdf:type rdf:Property ;
    rdfs:label 'Is Hcc Relevant' ;
    rdfs:comment 'Indicates whether this care event type is relevant for HCC risk adjustment and documentation.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:typicalDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Typical Duration Minutes' ;
    rdfs:comment 'The typical or expected duration of this care event type in minutes, used for scheduling and resource planning.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Minimum Duration Minutes' ;
    rdfs:comment 'The minimum duration required for this care event type to meet clinical or billing requirements, in minutes.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Maximum Duration Minutes' ;
    rdfs:comment 'The maximum allowable duration for this care event type, in minutes, beyond which additional authorization may be required.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyLimitPerPeriod rdf:type rdf:Property ;
    rdfs:label 'Frequency Limit Per Period' ;
    rdfs:comment 'The maximum number of times this care event type can be conducted within a specified time period (e.g., per month, per year).' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyPeriod rdf:type rdf:Property ;
    rdfs:label 'Frequency Period' ;
    rdfs:comment 'The time period over which the frequency limit applies (e.g., day, week, month, quarter, year).' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerTypeRequired rdf:type rdf:Property ;
    rdfs:label 'Provider Type Required' ;
    rdfs:comment 'The type of healthcare provider required to conduct this care event (e.g., RN, LPN, Social Worker, Care Manager, Physician, NP, PA).' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerCredentialRequired rdf:type rdf:Property ;
    rdfs:label 'Provider Credential Required' ;
    rdfs:comment 'Specific credentials or certifications required for the provider conducting this care event type (e.g., CCM, CDMS, CHC).' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationTemplate rdf:type rdf:Property ;
    rdfs:label 'Documentation Template' ;
    rdfs:comment 'The name or identifier of the standard documentation template used for this care event type.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeTrackingRequired rdf:type rdf:Property ;
    rdfs:label 'Outcome Tracking Required' ;
    rdfs:comment 'Indicates whether outcome tracking and measurement is required for this care event type.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberSatisfactionSurvey rdf:type rdf:Property ;
    rdfs:label 'Member Satisfaction Survey' ;
    rdfs:comment 'Indicates whether a member satisfaction survey (e.g., CAHPS) should be conducted following this care event type.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskStratificationTier rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Tier' ;
    rdfs:comment 'The member risk stratification tier typically associated with this care event type (e.g., low, medium, high, very high risk members).' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isChronicCare rdf:type rdf:Property ;
    rdfs:label 'Is Chronic Care' ;
    rdfs:comment 'Indicates whether this care event type is part of chronic care management services.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTransitionalCare rdf:type rdf:Property ;
    rdfs:label 'Is Transitional Care' ;
    rdfs:comment 'Indicates whether this care event type is part of transitional care management (e.g., post-discharge follow-up).' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBehavioralHealth rdf:type rdf:Property ;
    rdfs:label 'Is Behavioral Health' ;
    rdfs:comment 'Indicates whether this care event type is a behavioral health or mental health service.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRemoteMonitoring rdf:type rdf:Property ;
    rdfs:label 'Is Remote Monitoring' ;
    rdfs:comment 'Indicates whether this care event type involves remote patient monitoring technology and services.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costPerEvent rdf:type rdf:Property ;
    rdfs:label 'Cost Per Event' ;
    rdfs:comment 'The average cost to the health plan for conducting this care event type, used for budgeting and ROI analysis.' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roiCategory rdf:type rdf:Property ;
    rdfs:label 'Roi Category' ;
    rdfs:comment 'The primary ROI category that this care event type contributes to (e.g., cost avoidance, quality improvement, readmission reduction).' ;
    rdfs:domain ind:EventType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealDecisionId rdf:type rdf:Property ;
    rdfs:label 'Appeal Decision Id' ;
    rdfs:comment 'System generated unique identifier for each appeal decision record.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appealId rdf:type rdf:Property ;
    rdfs:label 'Appeal Id' ;
    rdfs:comment 'Unique identifier assigned to the appeal request.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Appeal .

ind:originalDecisionId rdf:type rdf:Property ;
    rdfs:label 'Original Decision Id' ;
    rdfs:comment 'Identifier of the original claim or authorization decision that is being appealed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Decision .

ind:memberDob rdf:type rdf:Property ;
    rdfs:label 'Member Dob' ;
    rdfs:comment 'Date of birth of the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealSource rdf:type rdf:Property ;
    rdfs:label 'Appeal Source' ;
    rdfs:comment 'Origin of the appeal request.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Submission Date' ;
    rdfs:comment 'Date the appeal was submitted to the system.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealSubmissionMethod rdf:type rdf:Property ;
    rdfs:label 'Appeal Submission Method' ;
    rdfs:comment 'Channel used to submit the appeal.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Decision Effective Date' ;
    rdfs:comment 'Date from which the appeal decision is applied to the member\'s benefits.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Decision Expiration Date' ;
    rdfs:comment 'Date after which the appeal decision is no longer valid, if applicable.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionAmount rdf:type rdf:Property ;
    rdfs:label 'Decision Amount' ;
    rdfs:comment 'Financial amount associated with the decision (e.g., reimbursement reversal).' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewerName rdf:type rdf:Property ;
    rdfs:label 'Reviewer Name' ;
    rdfs:comment 'Legal name of the reviewer.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalGuidelineResult rdf:type rdf:Property ;
    rdfs:label 'Clinical Guideline Result' ;
    rdfs:comment 'Outcome of the clinical guideline evaluation.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealEscalationFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Escalation Flag' ;
    rdfs:comment 'True if the appeal was escalated beyond the initial reviewer.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealEscalationLevel rdf:type rdf:Property ;
    rdfs:label 'Appeal Escalation Level' ;
    rdfs:comment 'Numeric level indicating depth of escalation (e.g., 1 = first level, 2 = senior reviewer).' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appealReviewCycle rdf:type rdf:Property ;
    rdfs:label 'Appeal Review Cycle' ;
    rdfs:comment 'Number of review cycles the appeal has undergone.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditTrailFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Flag' ;
    rdfs:comment 'True if an audit trail entry exists for this decision.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benefitCategory rdf:type rdf:Property ;
    rdfs:label 'Benefit Category' ;
    rdfs:comment 'Category of benefit affected by the appeal.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10Code rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code' ;
    rdfs:comment 'Diagnosis code associated with the claim.' ;
    rdfs:domain ind:AppealDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachContactId rdf:type rdf:Property ;
    rdfs:label 'Outreach Contact Id' ;
    rdfs:comment 'Unique surrogate key for each outreach interaction record.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Member Date Of Birth' ;
    rdfs:comment 'Member\'s birth date, used for age-based eligibility and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Member Phone Number' ;
    rdfs:comment 'Primary telephone number for the member (including area code).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberEmailAddress rdf:type rdf:Property ;
    rdfs:label 'Member Email Address' ;
    rdfs:comment 'Primary email address for electronic communications with the member.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberPlanType rdf:type rdf:Property ;
    rdfs:label 'Member Plan Type' ;
    rdfs:comment 'Type of health insurance product covering the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberStatus rdf:type rdf:Property ;
    rdfs:label 'Member Status' ;
    rdfs:comment 'Current enrollment status of the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachPurpose rdf:type rdf:Property ;
    rdfs:label 'Outreach Purpose' ;
    rdfs:comment 'Business reason for initiating the outreach.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachOutcome rdf:type rdf:Property ;
    rdfs:label 'Outreach Outcome' ;
    rdfs:comment 'Result of the outreach attempt.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactTimestamp rdf:type rdf:Property ;
    rdfs:label 'Contact Timestamp' ;
    rdfs:comment 'Date and time when the outreach interaction occurred.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Timestamp' ;
    rdfs:comment 'Planned date and time for a future outreach (if applicable).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contactDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Contact Duration Seconds' ;
    rdfs:comment 'Length of the interaction measured in seconds.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalContactAttempts rdf:type rdf:Property ;
    rdfs:label 'Total Contact Attempts' ;
    rdfs:comment 'Total number of attempts made for this outreach purpose before resolution.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contactAgentId rdf:type rdf:Property ;
    rdfs:label 'Contact Agent Id' ;
    rdfs:comment 'Unique identifier of the staff member who performed the outreach.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:contactAgentName rdf:type rdf:Property ;
    rdfs:label 'Contact Agent Name' ;
    rdfs:comment 'Full name of the staff member who made the contact.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactAgentRole rdf:type rdf:Property ;
    rdfs:label 'Contact Agent Role' ;
    rdfs:comment 'Job role of the staff member handling the outreach.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactAgentTeam rdf:type rdf:Property ;
    rdfs:label 'Contact Agent Team' ;
    rdfs:comment 'Team or department to which the outreach agent belongs.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactLanguage rdf:type rdf:Property ;
    rdfs:label 'Contact Language' ;
    rdfs:comment 'Language used during the outreach (e.g., en, es, fr).' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactNotes rdf:type rdf:Property ;
    rdfs:label 'Contact Notes' ;
    rdfs:comment 'Free-form notes captured by the agent about the interaction.' ;
    rdfs:domain ind:OutreachContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpDueDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Due Date' ;
    rdfs:comment 'Date by which the required follow-up must be completed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contactPriority rdf:type rdf:Property ;
    rdfs:label 'Contact Priority' ;
    rdfs:comment 'Priority level assigned to the outreach based on business rules.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScoreTypeId rdf:type rdf:Property ;
    rdfs:label 'Risk Score Type Id' ;
    rdfs:comment 'Unique identifier for the risk score type. Primary key for the risk score type reference table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskScoreType .

ind:populationSegment rdf:type rdf:Property ;
    rdfs:label 'Population Segment' ;
    rdfs:comment 'Member population segment for which this risk score type is designed (e.g., community, institutional, new enrollee, continuing enrollee, aged, disabled, ESRD, dual eligible). Used to ensure appropriate risk adjustment model application.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationFrequency rdf:type rdf:Property ;
    rdfs:label 'Calculation Frequency' ;
    rdfs:comment 'How often risk scores of this type are calculated or updated (e.g., annual for CMS-HCC, quarterly for care management programs, real-time for predictive models).' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccModelIndicator rdf:type rdf:Property ;
    rdfs:label 'Hcc Model Indicator' ;
    rdfs:comment 'Flag indicating whether this risk score type is based on the CMS Hierarchical Condition Category (HCC) risk adjustment model. True for CMS-HCC, RxHCC, and HHS-HCC models.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prospectiveIndicator rdf:type rdf:Property ;
    rdfs:label 'Prospective Indicator' ;
    rdfs:comment 'Flag indicating whether this risk score type is used for prospective (forward-looking) risk adjustment and payment calculations, as opposed to concurrent or retrospective scoring.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:normalizationFactor rdf:type rdf:Property ;
    rdfs:label 'Normalization Factor' ;
    rdfs:comment 'Numeric factor used to normalize or calibrate risk scores to a standard baseline (typically 1.0 represents average population risk). Applied by CMS annually to ensure budget neutrality.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumScore rdf:type rdf:Property ;
    rdfs:label 'Minimum Score' ;
    rdfs:comment 'Minimum allowable risk score value for this score type. Used for validation and to identify data quality issues or outliers.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumScore rdf:type rdf:Property ;
    rdfs:label 'Maximum Score' ;
    rdfs:comment 'Maximum allowable risk score value for this score type. Used for validation and to identify data quality issues or outliers.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageScore rdf:type rdf:Property ;
    rdfs:label 'Average Score' ;
    rdfs:comment 'Average or mean risk score value across the applicable population for this score type. Used as a benchmark for comparison and population health analytics.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentYear rdf:type rdf:Property ;
    rdfs:label 'Payment Year' ;
    rdfs:comment 'Calendar year for which risk scores of this type are used to determine capitated payments or reimbursement rates. Critical for Medicare Advantage and Medicaid managed care payment reconciliation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:diagnosisYear rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Year' ;
    rdfs:comment 'Calendar year from which diagnosis data is collected and used to calculate risk scores of this type. Typically one year prior to payment year for prospective models.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cmsModelIndicator rdf:type rdf:Property ;
    rdfs:label 'Cms Model Indicator' ;
    rdfs:comment 'Flag indicating whether this risk score type is an official CMS-published risk adjustment model (e.g., CMS-HCC, RxHCC) versus a proprietary or custom model developed internally or by a third party.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vbcProgramIndicator rdf:type rdf:Property ;
    rdfs:label 'Vbc Program Indicator' ;
    rdfs:comment 'Flag indicating whether this risk score type is used in value-based care programs, alternative payment models (APMs), or quality-based reimbursement arrangements.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedisMeasureAlignment rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Alignment' ;
    rdfs:comment 'HEDIS quality measures or domains that this risk score type supports or aligns with (e.g., Comprehensive Diabetes Care, Controlling High Blood Pressure, Care for Older Adults). Used to link risk stratification with quality improvement initiatives.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starRatingImpact rdf:type rdf:Property ;
    rdfs:label 'Star Rating Impact' ;
    rdfs:comment 'Indicates whether this risk score type directly or indirectly impacts CMS Star Ratings for Medicare Advantage plans. Direct impact means the score is used in Star Rating calculations; indirect means it supports quality measures that affect ratings.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careManagementUseCase rdf:type rdf:Property ;
    rdfs:label 'Care Management Use Case' ;
    rdfs:comment 'Specific care management or disease management program use cases for this risk score type (e.g., chronic condition identification, high-risk member stratification, care gap closure, transitional care management, preventive care outreach).' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predictiveModelType rdf:type rdf:Property ;
    rdfs:label 'Predictive Model Type' ;
    rdfs:comment 'Type of predictive modeling or statistical methodology used to generate risk scores of this type (e.g., regression analysis, machine learning, actuarial methods, clinical algorithms, hybrid approaches). Applicable for predictive risk scores.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStratificationTiers rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Tiers' ;
    rdfs:comment 'Number of risk stratification tiers or levels defined for this risk score type (e.g., 3 tiers: low/medium/high, or 5 tiers: very low/low/moderate/high/very high). Used for care management program assignment and resource allocation.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatorySubmissionRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Submission Required' ;
    rdfs:comment 'Flag indicating whether risk scores of this type must be submitted to regulatory agencies (e.g., CMS RAPS/EDPS submissions for Medicare Advantage, state Medicaid agencies for managed care). Critical for compliance and payment reconciliation.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Audit Risk Level' ;
    rdfs:comment 'Level of audit scrutiny or regulatory oversight associated with this risk score type. High or critical levels indicate scores subject to frequent CMS audits, RADV (Risk Adjustment Data Validation) reviews, or fraud/waste/abuse investigations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coefficientCount rdf:type rdf:Property ;
    rdfs:label 'Coefficient Count' ;
    rdfs:comment 'Number of coefficients, condition categories, or variables included in the risk score calculation model. Indicates model complexity and granularity.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interactionTermsIncluded rdf:type rdf:Property ;
    rdfs:label 'Interaction Terms Included' ;
    rdfs:comment 'Flag indicating whether the risk score model includes interaction terms that account for the combined effect of multiple conditions or demographic factors (e.g., diabetes + congestive heart failure interaction in CMS-HCC models).' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:demographicFactorsIncluded rdf:type rdf:Property ;
    rdfs:label 'Demographic Factors Included' ;
    rdfs:comment 'Flag indicating whether demographic factors (age, gender, Medicaid/disability status, institutional status) are incorporated into the risk score calculation for this score type.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyDataRequired rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Data Required' ;
    rdfs:comment 'Flag indicating whether pharmacy claims or prescription drug data is required as input for calculating risk scores of this type (e.g., true for RxHCC models, false for medical-only HCC models).' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:labDataRequired rdf:type rdf:Property ;
    rdfs:label 'Lab Data Required' ;
    rdfs:comment 'Flag indicating whether laboratory test results or clinical measurements are required as input for calculating risk scores of this type. Applicable for clinical risk scores and predictive models.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assessmentDataRequired rdf:type rdf:Property ;
    rdfs:label 'Assessment Data Required' ;
    rdfs:comment 'Flag indicating whether health risk assessment (HRA) or member survey data is required as input for calculating risk scores of this type. Common for care management and population health risk scores.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recaptureEligible rdf:type rdf:Property ;
    rdfs:label 'Recapture Eligible' ;
    rdfs:comment 'Flag indicating whether diagnoses contributing to this risk score type must be recaptured annually through face-to-face encounters to remain valid for payment year risk adjustment. True for CMS-HCC prospective models.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hierarchicalLogicApplied rdf:type rdf:Property ;
    rdfs:label 'Hierarchical Logic Applied' ;
    rdfs:comment 'Flag indicating whether hierarchical logic is applied in the risk score calculation, where more severe conditions supersede less severe conditions within the same disease category (e.g., severe diabetes supersedes uncomplicated diabetes in HCC models).' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalVendor rdf:type rdf:Property ;
    rdfs:label 'External Vendor' ;
    rdfs:comment 'Name of external vendor or third-party organization that developed or maintains this risk score type, if applicable (e.g., Optum, Milliman, Johns Hopkins ACG System). Null for internally developed or CMS-published models.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationDate rdf:type rdf:Property ;
    rdfs:label 'Implementation Date' ;
    rdfs:comment 'Date when this risk score type was first implemented in production systems at UnitedHealthcare. Used for tracking model adoption and version history.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:technicalDocumentationUrl rdf:type rdf:Property ;
    rdfs:label 'Technical Documentation Url' ;
    rdfs:comment 'URL or hyperlink to detailed technical documentation, model specifications, or reference materials for this risk score type. Supports user self-service and knowledge management.' ;
    rdfs:domain ind:RiskScoreType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionId rdf:type rdf:Property ;
    rdfs:label 'Decision Id' ;
    rdfs:comment 'Unique identifier for the authorization decision record. Primary key for the decision entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Decision .

ind:approvedQuantity rdf:type rdf:Property ;
    rdfs:label 'Approved Quantity' ;
    rdfs:comment 'Quantity of services, units, visits, or days approved for the authorization. May differ from requested quantity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedQuantityUnit rdf:type rdf:Property ;
    rdfs:label 'Approved Quantity Unit' ;
    rdfs:comment 'Unit of measure for the approved quantity (e.g., visits, days, units, procedures).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedQuantity rdf:type rdf:Property ;
    rdfs:label 'Requested Quantity' ;
    rdfs:comment 'Original quantity of services requested in the authorization request for comparison with approved quantity.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestedQuantityUnit rdf:type rdf:Property ;
    rdfs:label 'Requested Quantity Unit' ;
    rdfs:comment 'Unit of measure for the requested quantity from the original authorization request.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerCredential rdf:type rdf:Property ;
    rdfs:label 'Reviewer Credential' ;
    rdfs:comment 'Professional credential or license type of the reviewer (e.g., MD, RN, PharmD) indicating their qualification to make clinical decisions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerSpecialty rdf:type rdf:Property ;
    rdfs:label 'Reviewer Specialty' ;
    rdfs:comment 'Clinical specialty or area of expertise of the reviewer (e.g., cardiology, orthopedics, behavioral health).' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalNecessityMet rdf:type rdf:Property ;
    rdfs:label 'Medical Necessity Met' ;
    rdfs:comment 'Indicator of whether the requested service met the clinical guidelines for medical necessity. True if criteria met, false otherwise.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificationTypeCode rdf:type rdf:Property ;
    rdfs:label 'Certification Type Code' ;
    rdfs:comment 'Code indicating the type of certification or authorization granted (e.g., initial certification, recertification, extension).' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureDescription rdf:type rdf:Property ;
    rdfs:label 'Procedure Description' ;
    rdfs:comment 'Text description of the procedure or service authorized corresponding to the procedure code.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisDescription rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Description' ;
    rdfs:comment 'Text description of the diagnosis corresponding to the ICD-10 code.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:levelOfCare rdf:type rdf:Property ;
    rdfs:label 'Level Of Care' ;
    rdfs:comment 'Clinical level of care authorized for the service (e.g., acute inpatient, skilled nursing, outpatient).' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnaroundTimeHours rdf:type rdf:Property ;
    rdfs:label 'Turnaround Time Hours' ;
    rdfs:comment 'Number of hours elapsed from request submission to decision completion, used to measure compliance with regulatory timeframes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryTimeframeMet rdf:type rdf:Property ;
    rdfs:label 'Regulatory Timeframe Met' ;
    rdfs:comment 'Indicator of whether the decision was made within the regulatory required timeframe (e.g., 72 hours for standard, 24 hours for expedited).' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealEligible rdf:type rdf:Property ;
    rdfs:label 'Appeal Eligible' ;
    rdfs:comment 'Indicator of whether the decision is eligible for member or provider appeal under plan rules and regulations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Peer Review Required' ;
    rdfs:comment 'Indicator of whether a physician peer review was required or conducted for this authorization decision, typically for denials.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Requesting Provider Npi' ;
    rdfs:comment 'Ten-digit NPI of the healthcare provider who submitted the authorization request.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingProviderName rdf:type rdf:Property ;
    rdfs:label 'Requesting Provider Name' ;
    rdfs:comment 'Name of the healthcare provider or facility that requested the authorization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingProviderSpecialty rdf:type rdf:Property ;
    rdfs:label 'Requesting Provider Specialty' ;
    rdfs:comment 'Clinical specialty of the provider requesting the authorization (e.g., cardiology, orthopedics).' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Servicing Provider Npi' ;
    rdfs:comment 'Ten-digit NPI of the healthcare provider who will render the authorized service, may differ from requesting provider.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicingProviderName rdf:type rdf:Property ;
    rdfs:label 'Servicing Provider Name' ;
    rdfs:comment 'Name of the healthcare provider or facility that will perform the authorized service.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepTherapyApplied rdf:type rdf:Property ;
    rdfs:label 'Step Therapy Applied' ;
    rdfs:comment 'Indicator of whether step therapy protocols were applied in the authorization decision (typically for pharmacy or specialty services).' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideReason rdf:type rdf:Property ;
    rdfs:label 'Override Reason' ;
    rdfs:comment 'Reason documented if the decision overrode automated system recommendations or standard guidelines.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Override Approved By' ;
    rdfs:comment 'Name or identifier of the supervisor or medical director who approved an override of standard decision logic.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuationOfPreviousAuth rdf:type rdf:Property ;
    rdfs:label 'Continuation Of Previous Auth' ;
    rdfs:comment 'Indicator of whether this authorization is a continuation or extension of a previously approved authorization.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:previousAuthorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Previous Authorization Number' ;
    rdfs:comment 'Authorization number of the previous authorization if this is a continuation or extension.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconsiderationCount rdf:type rdf:Property ;
    rdfs:label 'Reconsideration Count' ;
    rdfs:comment 'Number of times this authorization request has been reconsidered or resubmitted with additional information.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expeditedReview rdf:type rdf:Property ;
    rdfs:label 'Expedited Review' ;
    rdfs:comment 'Indicator of whether the authorization was processed under expedited review timeframes due to urgency or member condition.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concurrentReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Concurrent Review Required' ;
    rdfs:comment 'Indicator of whether ongoing concurrent review is required during service delivery to maintain authorization.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dischargePlanningRequired rdf:type rdf:Property ;
    rdfs:label 'Discharge Planning Required' ;
    rdfs:comment 'Indicator of whether discharge planning coordination is required as part of the authorization (typically for inpatient stays).' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseManagementAssigned rdf:type rdf:Property ;
    rdfs:label 'Case Management Assigned' ;
    rdfs:comment 'Indicator of whether a case manager has been assigned to coordinate care for this authorization.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseManagerAgentId rdf:type rdf:Property ;
    rdfs:label 'Case Manager Agent Id' ;
    rdfs:comment 'Identifier of the case manager assigned to coordinate care and services for this authorization.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:qualityReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Review Flag' ;
    rdfs:comment 'Indicator of whether this decision has been flagged for quality assurance review or audit.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemSource rdf:type rdf:Property ;
    rdfs:label 'System Source' ;
    rdfs:comment 'Name of the source system that generated or recorded the authorization decision (e.g., Pegasystems, QNXT, Facets).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidedFlag rdf:type rdf:Property ;
    rdfs:label 'Voided Flag' ;
    rdfs:comment 'Indicator of whether this authorization decision has been voided or cancelled after initial issuance.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voidReason rdf:type rdf:Property ;
    rdfs:label 'Void Reason' ;
    rdfs:comment 'Reason documented for voiding or cancelling the authorization decision after issuance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedServiceDate rdf:type rdf:Property ;
    rdfs:label 'Requested Service Date' ;
    rdfs:comment 'Date when the requested service is scheduled to be performed.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestedStartDate rdf:type rdf:Property ;
    rdfs:label 'Requested Start Date' ;
    rdfs:comment 'Start date for services requiring authorization over a date range.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestedEndDate rdf:type rdf:Property ;
    rdfs:label 'Requested End Date' ;
    rdfs:comment 'End date for services requiring authorization over a date range.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestedUnits rdf:type rdf:Property ;
    rdfs:label 'Requested Units' ;
    rdfs:comment 'Number of service units requested for authorization (visits, days, procedures).' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:admissionType rdf:type rdf:Property ;
    rdfs:label 'Admission Type' ;
    rdfs:comment 'Type of hospital admission for inpatient authorization requests.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:admissionSource rdf:type rdf:Property ;
    rdfs:label 'Admission Source' ;
    rdfs:comment 'Source from which the patient was admitted for inpatient services.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalJustification rdf:type rdf:Property ;
    rdfs:label 'Clinical Justification' ;
    rdfs:comment 'Detailed clinical rationale and medical necessity justification for the requested service.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentationIndicator rdf:type rdf:Property ;
    rdfs:label 'Supporting Documentation Indicator' ;
    rdfs:comment 'Indicates whether clinical documentation was attached to support the authorization request.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attachmentControlNumber rdf:type rdf:Property ;
    rdfs:label 'Attachment Control Number' ;
    rdfs:comment 'Control number linking the authorization request to supporting clinical documentation.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Decision Timestamp' ;
    rdfs:comment 'Precise timestamp when the authorization determination was finalized.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approvedUnits rdf:type rdf:Property ;
    rdfs:label 'Approved Units' ;
    rdfs:comment 'Number of service units approved by the health plan for the authorization.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedStartDate rdf:type rdf:Property ;
    rdfs:label 'Approved Start Date' ;
    rdfs:comment 'Start date of the approved authorization period.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedEndDate rdf:type rdf:Property ;
    rdfs:label 'Approved End Date' ;
    rdfs:comment 'End date of the approved authorization period.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewerType rdf:type rdf:Property ;
    rdfs:label 'Reviewer Type' ;
    rdfs:comment 'Type of clinical professional or system that reviewed the authorization request.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDetermination rdf:type rdf:Property ;
    rdfs:label 'Review Determination' ;
    rdfs:comment 'Final determination made by the clinical reviewer on the authorization request.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalNecessityMetIndicator rdf:type rdf:Property ;
    rdfs:label 'Medical Necessity Met Indicator' ;
    rdfs:comment 'Indicates whether the requested service met medical necessity criteria.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReviewRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Peer Review Required Indicator' ;
    rdfs:comment 'Indicates whether physician peer-to-peer review is required for the authorization.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReviewCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Peer Review Completed Date' ;
    rdfs:comment 'Date when physician peer-to-peer review was completed.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expeditedReviewIndicator rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Indicator' ;
    rdfs:comment 'Indicates whether the authorization request qualifies for expedited review.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost' ;
    rdfs:comment 'Estimated total cost of the requested service for financial impact assessment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedAllowedAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Allowed Amount' ;
    rdfs:comment 'Estimated allowed amount the health plan will pay for the authorized service.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationSentIndicator rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Indicator' ;
    rdfs:comment 'Indicates whether authorization decision notification was sent to member and provider.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseManagementIndicator rdf:type rdf:Property ;
    rdfs:label 'Case Management Indicator' ;
    rdfs:comment 'Indicates whether the authorization request triggered case management referral.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diseaseManagementProgram rdf:type rdf:Property ;
    rdfs:label 'Disease Management Program' ;
    rdfs:comment 'Disease management program associated with the authorization request.' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuationOfPreviousAuthIndicator rdf:type rdf:Property ;
    rdfs:label 'Continuation Of Previous Auth Indicator' ;
    rdfs:comment 'Indicates whether this request is a continuation of a previously approved authorization.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modificationIndicator rdf:type rdf:Property ;
    rdfs:label 'Modification Indicator' ;
    rdfs:comment 'Indicates whether the authorization request is a modification of an existing authorization.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalRequestId rdf:type rdf:Property ;
    rdfs:label 'Original Request Id' ;
    rdfs:comment 'Identifier of the original authorization request being modified.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:extensionRequestedIndicator rdf:type rdf:Property ;
    rdfs:label 'Extension Requested Indicator' ;
    rdfs:comment 'Indicates whether an extension of the authorization period has been requested.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concurrentReviewDate rdf:type rdf:Property ;
    rdfs:label 'Concurrent Review Date' ;
    rdfs:comment 'Date when concurrent review was performed for ongoing authorization.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retrospectiveReviewIndicator rdf:type rdf:Property ;
    rdfs:label 'Retrospective Review Indicator' ;
    rdfs:comment 'Indicates whether the authorization request is for retrospective review of services already rendered.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyServicesIndicator rdf:type rdf:Property ;
    rdfs:label 'Emergency Services Indicator' ;
    rdfs:comment 'Indicates whether the authorization request is for emergency services.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfAreaServicesIndicator rdf:type rdf:Property ;
    rdfs:label 'Out Of Area Services Indicator' ;
    rdfs:comment 'Indicates whether the requested services are being provided outside the member\'s service area.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transplantIndicator rdf:type rdf:Property ;
    rdfs:label 'Transplant Indicator' ;
    rdfs:comment 'Indicates whether the authorization request is for organ or tissue transplant services.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:experimentalTreatmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Experimental Treatment Indicator' ;
    rdfs:comment 'Indicates whether the requested service is considered experimental or investigational.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalTrialIndicator rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Indicator' ;
    rdfs:comment 'Indicates whether the authorization request is related to participation in a clinical trial.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondOpinionRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Second Opinion Required Indicator' ;
    rdfs:comment 'Indicates whether a second medical opinion is required for the authorization.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondOpinionObtainedDate rdf:type rdf:Property ;
    rdfs:label 'Second Opinion Obtained Date' ;
    rdfs:comment 'Date when the required second medical opinion was obtained.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coordinationOfBenefitsIndicator rdf:type rdf:Property ;
    rdfs:label 'Coordination Of Benefits Indicator' ;
    rdfs:comment 'Indicates whether coordination of benefits with another payer is required for the authorization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workersCompensationIndicator rdf:type rdf:Property ;
    rdfs:label 'Workers Compensation Indicator' ;
    rdfs:comment 'Indicates whether the authorization is related to a workers compensation claim.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoAccidentIndicator rdf:type rdf:Property ;
    rdfs:label 'Auto Accident Indicator' ;
    rdfs:comment 'Indicates whether the authorization is related to an automobile accident.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:otherAccidentIndicator rdf:type rdf:Property ;
    rdfs:label 'Other Accident Indicator' ;
    rdfs:comment 'Indicates whether the authorization is related to another type of accident.' ;
    rdfs:domain ind:Request ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineItemId rdf:type rdf:Property ;
    rdfs:label 'Line Item Id' ;
    rdfs:comment 'Unique identifier for each authorization request line item. Primary key for granular service-level tracking within multi-service authorization requests.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LineItem .

ind:authorizationRequestId rdf:type rdf:Property ;
    rdfs:label 'Authorization Request Id' ;
    rdfs:comment 'Identifier of the parent authorization request to which this line item belongs. Links line items to their parent authorization case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Request .

ind:deniedQuantity rdf:type rdf:Property ;
    rdfs:label 'Denied Quantity' ;
    rdfs:comment 'Number of service units denied by the utilization management review.' ;
    rdfs:domain ind:LineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityUnit rdf:type rdf:Property ;
    rdfs:label 'Quantity Unit' ;
    rdfs:comment 'Unit of measure for the service quantity (e.g., visits, days, units, procedures).' ;
    rdfs:domain ind:UnitedHealthCare ;
