ind:performanceMetricType rdf:type rdf:Property ;
    rdfs:label 'Performance Metric Type' ;
    rdfs:comment 'Primary performance metric used to measure and report effectiveness of this inventory category (e.g., CPM, GRP, engagement rate, brand lift, ROI). [ENUM-REF-CANDIDATE: cpm|grp|reach|frequency|engagement_rate|click_through_rate|brand_lift|conversion_rate|roi — promote to reference product]' ;
    rdfs:domain ind:InventoryCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typicalContractTermMonths rdf:type rdf:Property ;
