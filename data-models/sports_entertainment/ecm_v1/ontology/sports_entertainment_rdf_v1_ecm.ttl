    rdfs:range xsd:decimal .

ind:desiredSalaryMin rdf:type rdf:Property ;
    rdfs:label 'Desired Salary Min' ;
    rdfs:comment 'Minimum salary expectation stated by the candidate.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Disability Status' ;
    rdfs:comment 'Self-disclosed disability status for Equal Employment Opportunity (EEO) and affirmative action compliance.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugTestDate rdf:type rdf:Property ;
    rdfs:label 'Drug Test Date' ;
    rdfs:comment 'Date when the drug screening test was completed.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:drugTestStatus rdf:type rdf:Property ;
    rdfs:label 'Drug Test Status' ;
    rdfs:comment 'Current status of the candidate\'s drug screening test.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethnicity rdf:type rdf:Property ;
    rdfs:label 'Ethnicity' ;
    rdfs:comment 'Self-identified ethnicity or race of the candidate for Equal Employment Opportunity (EEO) reporting. [ENUM-REF-CANDIDATE: hispanic_latino|white|black_african_american|asian|native_american|pacific_islander|two_or_more|decline_to_answer — promote to reference product]' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highestEducationLevel rdf:type rdf:Property ;
    rdfs:label 'Highest Education Level' ;
    rdfs:comment 'The highest level of education attained by the candidate.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interviewCount rdf:type rdf:Property ;
    rdfs:label 'Interview Count' ;
    rdfs:comment 'Total number of interviews conducted with this candidate.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastInterviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Interview Date' ;
    rdfs:comment 'Date of the most recent interview with the candidate.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preferredLocation rdf:type rdf:Property ;
    rdfs:label 'Preferred Location' ;
    rdfs:comment 'Candidate\'s preferred geographic location or city for work.' ;
    rdfs:domain ind:Candidate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resumeText rdf:type rdf:Property ;
    rdfs:label 'Resume Text' ;
    rdfs:comment 'Full text content of the candidate\'s resume or curriculum vitae.' ;
    rdfs:domain ind:Candidate ;
