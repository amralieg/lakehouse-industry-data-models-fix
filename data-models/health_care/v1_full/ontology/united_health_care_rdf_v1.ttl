    rdfs:comment 'Indicates whether a Business Associate Agreement (BAA) or data sharing agreement is required for this lead source due to Protected Health Information (PHI) or Personally Identifiable Information (PII) handling.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadQualityScore rdf:type rdf:Property ;
    rdfs:label 'Lead Quality Score' ;
    rdfs:comment 'Calculated quality score for leads from this source on a scale of 0.00 to 5.00. Based on historical conversion rates, engagement levels, and member retention.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageTimeToConversionDays rdf:type rdf:Property ;
    rdfs:label 'Average Time To Conversion Days' ;
    rdfs:comment 'Average number of days from lead creation to enrollment conversion for this source. Used for sales cycle forecasting and resource planning.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadRoutingRule rdf:type rdf:Property ;
    rdfs:label 'Lead Routing Rule' ;
    rdfs:comment 'Automated routing rule that determines how leads from this source are distributed to sales representatives or brokers.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoAssignmentEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Assignment Enabled' ;
    rdfs:comment 'Indicates whether leads from this source are automatically assigned to sales representatives or require manual assignment.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactConsentObtained rdf:type rdf:Property ;
