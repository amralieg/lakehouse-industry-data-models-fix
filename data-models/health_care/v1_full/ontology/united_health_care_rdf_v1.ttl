    rdfs:range xsd:string .

ind:claimAdjustmentGroupCode rdf:type rdf:Property ;
    rdfs:label 'Claim Adjustment Group Code' ;
    rdfs:comment 'Group code indicating financial responsibility party for this cost sharing type: PR (Patient Responsibility), CO (Contractual Obligation), OA (Other Adjustment), PI (Payer Initiated), CR (Correction).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
