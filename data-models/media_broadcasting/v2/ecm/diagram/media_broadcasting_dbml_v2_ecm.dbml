  substantiation_required_flag boolean [note: 'Indicates whether the ad creative makes claims requiring documented substantiation (e.g., scientific evidence, test results, endorsements). | Column substantiation_required_flag (BOOLEAN) in compliance.ad_standards_clearance']
  target_audience varchar [note: 'Intended demographic audience for the ad creative, critical for applying age-appropriate content standards and children\'s advertising rules. | Column target_audience (STRING) in compliance.ad_standards_clearance']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.ad_standards_clearance']

  Note: 'Compliance clearance record for advertising content reviewed against broadcast standards, FCC rules, and industry codes (NAB Code, IAB standards, CARU guidelines for children\'s advertising). Captures ad creative identifier, advertiser, product category, clearance type (pre-clearance, post-air review), standards body, review outcome (approved, approved with edits, rejected), rejection reason, and clearance date. Ensures all aired advertising meets regulatory and self-regulatory standards. | Unity Catalog table: media_broadcasting_ecm.compliance.ad_standards_clearance'
}

Table compliance.technical_standard_cert {
