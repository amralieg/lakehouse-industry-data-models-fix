  approval_status varchar [note: 'The approval status of the source document indicating whether it has been reviewed and approved per SOX-compliant financial controls. | Column approval_status (STRING) in finance.source_document']
  approved_by varchar [note: 'The name or identifier of the person who approved this source document for posting. | Column approved_by (STRING) in finance.source_document']
  attachment_count varchar [note: 'The number of supporting documents or attachments linked to this source document (e.g., scanned invoices, contracts, receipts). | Column attachment_count (INT) in finance.source_document']
  company_code varchar [note: 'The company code representing the legal entity within the enterprise to which this source document belongs. | Column company_code (STRING) in finance.source_document']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in finance.source_document']
  created_timestamp timestamp [note: 'The date and time when this source document record was first created in the system. | Column created_timestamp (TIMESTAMP) in finance.source_document']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency in which the source document amounts are denominated. | Column currency_code (STRING) in finance.source_document']
  document_amount decimal(18,2) [note: 'The total gross amount of the source document in the document currency before any adjustments or taxes. | Column document_amount (DECIMAL(18,2)) in finance.source_document']
  document_date date [note: 'The date the source document was created or issued by the originating party. This is the business event date that determines the accounting period assignment. | Column document_date (DATE) in finance.source_document']
  document_number varchar [note: 'The externally-known unique business identifier or reference number assigned to the source document (e.g., invoice number, contract number, purchase order number). | Column document_number (STRING) in finance.source_document']
  document_status varchar [note: 'Current lifecycle status of the source document indicating its processing state (e.g., draft, pending approval, approved, posted, cancelled, archived). | Column document_status (STRING) in finance.source_document']
  document_type varchar [note: 'Classification of the source document indicating its purpose and nature within the financial system (e.g., invoice, purchase order, contract, receipt, credit memo, journal entry). | Column document_type (STRING) in finance.source_document']
