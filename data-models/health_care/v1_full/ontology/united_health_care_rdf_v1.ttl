ind:preventiveCareServices rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Services' ;
    rdfs:comment 'Indicates whether the practice location provides preventive care services such as wellness visits, screenings, and immunizations.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:labServicesOnsite rdf:type rdf:Property ;
    rdfs:label 'Lab Services Onsite' ;
    rdfs:comment 'Indicates whether the practice location has on-site laboratory services for diagnostic testing.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:imagingServicesOnsite rdf:type rdf:Property ;
    rdfs:label 'Imaging Services Onsite' ;
    rdfs:comment 'Indicates whether the practice location has on-site imaging services such as X-ray, ultrasound, or MRI.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyOnsite rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Onsite' ;
    rdfs:comment 'Indicates whether the practice location has an on-site pharmacy for prescription dispensing.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientPortalAvailable rdf:type rdf:Property ;
    rdfs:label 'Patient Portal Available' ;
    rdfs:comment 'Indicates whether the practice location offers an online patient portal for appointment scheduling, medical records access, and secure messaging.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ehrSystemName rdf:type rdf:Property ;
    rdfs:label 'Ehr System Name' ;
    rdfs:comment 'The name of the Electronic Health Record system used at the practice location for clinical documentation.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediCapability rdf:type rdf:Property ;
    rdfs:label 'Edi Capability' ;
    rdfs:comment 'Indicates whether the practice location has the capability to submit claims and receive remittances electronically via EDI.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityRating rdf:type rdf:Property ;
    rdfs:label 'Quality Rating' ;
    rdfs:comment 'The overall quality rating score for the practice location based on HEDIS measures, patient satisfaction, and clinical outcomes (scale 0.00 to 5.00).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientSatisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Patient Satisfaction Score' ;
    rdfs:comment 'The patient satisfaction score for the practice location based on CAHPS surveys and member feedback (scale 0.00 to 100.00).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pcmhRecognized rdf:type rdf:Property ;
    rdfs:label 'Pcmh Recognized' ;
    rdfs:comment 'Indicates whether the practice location has achieved NCQA Patient-Centered Medical Home recognition.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acoParticipant rdf:type rdf:Property ;
    rdfs:label 'Aco Participant' ;
    rdfs:comment 'Indicates whether the practice location participates in an Accountable Care Organization for value-based care arrangements.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueBasedContract rdf:type rdf:Property ;
    rdfs:label 'Value Based Contract' ;
    rdfs:comment 'Indicates whether the practice location operates under a value-based care contract with quality and cost performance incentives.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskArrangementType rdf:type rdf:Property ;
    rdfs:label 'Risk Arrangement Type' ;
    rdfs:comment 'The type of financial risk arrangement between UnitedHealthcare and the practice location.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidAccepted rdf:type rdf:Property ;
    rdfs:label 'Medicaid Accepted' ;
    rdfs:comment 'Indicates whether the practice location accepts Medicaid patients and participates in state Medicaid programs.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareAccepted rdf:type rdf:Property ;
    rdfs:label 'Medicare Accepted' ;
    rdfs:comment 'Indicates whether the practice location accepts Medicare patients and participates in Medicare programs.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareAdvantageAccepted rdf:type rdf:Property ;
    rdfs:label 'Medicare Advantage Accepted' ;
    rdfs:comment 'Indicates whether the practice location accepts Medicare Advantage plan members.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialInsuranceAccepted rdf:type rdf:Property ;
    rdfs:label 'Commercial Insurance Accepted' ;
    rdfs:comment 'Indicates whether the practice location accepts commercial health insurance plans.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:selfPayAccepted rdf:type rdf:Property ;
    rdfs:label 'Self Pay Accepted' ;
    rdfs:comment 'Indicates whether the practice location accepts self-pay patients without insurance coverage.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slidingFeeScale rdf:type rdf:Property ;
    rdfs:label 'Sliding Fee Scale' ;
    rdfs:comment 'Indicates whether the practice location offers a sliding fee scale based on patient income for uninsured or underinsured patients.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fqhcDesignation rdf:type rdf:Property ;
    rdfs:label 'Fqhc Designation' ;
    rdfs:comment 'Indicates whether the practice location is designated as a Federally Qualified Health Center.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ruralHealthClinic rdf:type rdf:Property ;
    rdfs:label 'Rural Health Clinic' ;
    rdfs:comment 'Indicates whether the practice location is certified as a Rural Health Clinic serving underserved rural areas.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:teachingFacility rdf:type rdf:Property ;
    rdfs:label 'Teaching Facility' ;
    rdfs:comment 'Indicates whether the practice location serves as a teaching facility for medical residents, fellows, or students.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Last Verified Date' ;
    rdfs:comment 'The date when the practice location information was last verified for accuracy in the provider directory.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:directoryListingStatus rdf:type rdf:Property ;
    rdfs:label 'Directory Listing Status' ;
    rdfs:comment 'The publication status of the practice location in the member-facing provider directory.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyFipsCode rdf:type rdf:Property ;
    rdfs:label 'County Fips Code' ;
    rdfs:comment 'Five-digit FIPS code uniquely identifying the county within the United States.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cityName rdf:type rdf:Property ;
    rdfs:label 'City Name' ;
    rdfs:comment 'Name of the city or municipality included in the service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metropolitanStatisticalArea rdf:type rdf:Property ;
    rdfs:label 'Metropolitan Statistical Area' ;
    rdfs:comment 'Name of the Metropolitan Statistical Area as defined by the US Census Bureau, used for urban service area classification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:msaCode rdf:type rdf:Property ;
    rdfs:label 'Msa Code' ;
    rdfs:comment 'Five-digit code uniquely identifying the Metropolitan Statistical Area.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbsaCode rdf:type rdf:Property ;
    rdfs:label 'Cbsa Code' ;
    rdfs:comment 'Five-digit code identifying the Core Based Statistical Area, which includes both metropolitan and micropolitan areas.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionName rdf:type rdf:Property ;
    rdfs:label 'Region Name' ;
    rdfs:comment 'Name of the internal business region or market area (e.g., \'Northeast Region\', \'Pacific Northwest\').' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketName rdf:type rdf:Property ;
    rdfs:label 'Market Name' ;
    rdfs:comment 'Name of the commercial market or service market within which the provider operates.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationStatus rdf:type rdf:Property ;
    rdfs:label 'Participation Status' ;
    rdfs:comment 'Current status of the provider\'s participation in the service area: active, inactive, pending, suspended, terminated, or excluded.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acceptingNewPatientsFlag rdf:type rdf:Property ;
    rdfs:label 'Accepting New Patients Flag' ;
    rdfs:comment 'Indicates whether the provider is currently accepting new patients within this service area.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Telehealth Enabled Flag' ;
    rdfs:comment 'Indicates whether the provider offers telehealth or virtual care services within this service area.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:afterHoursCareFlag rdf:type rdf:Property ;
    rdfs:label 'After Hours Care Flag' ;
    rdfs:comment 'Indicates whether the provider offers after-hours care services within this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weekendAvailabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Weekend Availability Flag' ;
    rdfs:comment 'Indicates whether the provider offers services on weekends within this service area.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageServicesAvailable rdf:type rdf:Property ;
    rdfs:label 'Language Services Available' ;
    rdfs:comment 'Comma-separated list of languages in which the provider offers services within this service area (e.g., \'English,Spanish,Mandarin\').' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibilityCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Accessibility Compliant Flag' ;
    rdfs:comment 'Indicates whether the provider\'s facilities within this service area are compliant with Americans with Disabilities Act (ADA) accessibility requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:travelDistanceMiles rdf:type rdf:Property ;
    rdfs:label 'Travel Distance Miles' ;
    rdfs:comment 'Maximum travel distance in miles from the service area boundary to the provider location, used for network adequacy calculations.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:travelTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Travel Time Minutes' ;
    rdfs:comment 'Maximum travel time in minutes from the service area boundary to the provider location, used for network adequacy calculations.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:urbanRuralDesignation rdf:type rdf:Property ;
    rdfs:label 'Urban Rural Designation' ;
    rdfs:comment 'Classification of the service area as urban, suburban, rural, or frontier based on population density and geographic characteristics.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicallyUnderservedAreaFlag rdf:type rdf:Property ;
    rdfs:label 'Medically Underserved Area Flag' ;
    rdfs:comment 'Indicates whether the service area is designated as a Medically Underserved Area by HRSA.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:healthProfessionalShortageAreaFlag rdf:type rdf:Property ;
    rdfs:label 'Health Professional Shortage Area Flag' ;
    rdfs:comment 'Indicates whether the service area is designated as a Health Professional Shortage Area by HRSA.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkAdequacyCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Compliant Flag' ;
    rdfs:comment 'Indicates whether the service area meets CMS and state regulatory network adequacy requirements for provider access.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberToProviderRatio rdf:type rdf:Property ;
    rdfs:label 'Member To Provider Ratio' ;
    rdfs:comment 'Ratio of members to providers within this service area, used for network adequacy and capacity planning.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityStatus rdf:type rdf:Property ;
    rdfs:label 'Capacity Status' ;
    rdfs:comment 'Current capacity status of the provider within this service area: available, limited, at capacity, or over capacity.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentAvailabilityDays rdf:type rdf:Property ;
    rdfs:label 'Appointment Availability Days' ;
    rdfs:comment 'Average number of days until the next available appointment with the provider in this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractId rdf:type rdf:Property ;
    rdfs:label 'Contract Id' ;
    rdfs:comment 'Identifier for the provider contract governing services within this service area.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contract .

ind:contractEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Contract Effective Date' ;
    rdfs:comment 'Date when the provider contract for this service area became effective.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Contract Termination Date' ;
    rdfs:comment 'Date when the provider contract for this service area terminates or terminated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Contract Renewal Date' ;
    rdfs:comment 'Date when the provider contract for this service area is scheduled for renewal.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeScheduleId rdf:type rdf:Property ;
    rdfs:label 'Fee Schedule Id' ;
    rdfs:comment 'Identifier for the fee schedule applicable to services provided within this service area.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FeeSchedule .

ind:tierLevel rdf:type rdf:Property ;
    rdfs:label 'Tier Level' ;
    rdfs:comment 'Provider tier level within the network for this service area, affecting member cost-sharing: tier 1, tier 2, tier 3, tier 4, preferred, standard, or out-of-network.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityTierDesignation rdf:type rdf:Property ;
    rdfs:label 'Quality Tier Designation' ;
    rdfs:comment 'Quality-based tier designation for the provider within this service area based on performance metrics.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:centerOfExcellenceFlag rdf:type rdf:Property ;
    rdfs:label 'Center Of Excellence Flag' ;
    rdfs:comment 'Indicates whether the provider is designated as a Center of Excellence for specialized services within this service area.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientCenteredMedicalHomeFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Centered Medical Home Flag' ;
    rdfs:comment 'Indicates whether the provider is recognized as a Patient Centered Medical Home within this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acoParticipantFlag rdf:type rdf:Property ;
    rdfs:label 'Aco Participant Flag' ;
    rdfs:comment 'Indicates whether the provider participates in an Accountable Care Organization within this service area.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueBasedContractFlag rdf:type rdf:Property ;
    rdfs:label 'Value Based Contract Flag' ;
    rdfs:comment 'Indicates whether the provider has a value-based care contract for services within this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Exclusion Status' ;
    rdfs:comment 'Status indicating whether the provider is excluded from federal healthcare programs: not excluded, excluded, or pending review.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionCheckDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion Check Date' ;
    rdfs:comment 'Date when the provider was last checked against federal exclusion lists.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:directoryListingFlag rdf:type rdf:Property ;
    rdfs:label 'Directory Listing Flag' ;
    rdfs:comment 'Indicates whether the provider is listed in the member-facing provider directory for this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:directoryLastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Directory Last Updated Date' ;
    rdfs:comment 'Date when the provider directory information for this service area was last updated.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pcpAssignmentAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Pcp Assignment Allowed Flag' ;
    rdfs:comment 'Indicates whether members can select this provider as their Primary Care Physician within this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryComplianceId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Id' ;
    rdfs:comment 'Unique surrogate key for each regulatory compliance record.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acaMinEssentialCoverage rdf:type rdf:Property ;
    rdfs:label 'Aca Min Essential Coverage' ;
    rdfs:comment 'Flag indicating compliance with ACA minimum essential coverage requirement.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaQualifiedHealthPlan rdf:type rdf:Property ;
    rdfs:label 'Aca Qualified Health Plan' ;
    rdfs:comment 'Indicates if the plan qualifies as a Qualified Health Plan under ACA.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaBenchmarkPlan rdf:type rdf:Property ;
    rdfs:label 'Aca Benchmark Plan' ;
    rdfs:comment 'Indicates if the plan is designated as a benchmark plan for ACA rating.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsHedisReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Cms Hedis Reporting Required' ;
    rdfs:comment 'Flag indicating if the plan must report HEDIS metrics to CMS.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
