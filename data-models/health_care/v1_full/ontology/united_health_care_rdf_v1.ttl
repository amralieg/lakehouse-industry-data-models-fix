    rdfs:comment 'HEDIS or Star Ratings quality measures associated with this HCC category for integrated quality and risk management.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careGapIndicator rdf:type rdf:Property ;
    rdfs:label 'Care Gap Indicator' ;
    rdfs:comment 'Indicates whether this HCC category is commonly associated with care gaps requiring clinical intervention.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberHccAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Member Hcc Assignment Id' ;
    rdfs:comment 'Unique identifier for the member HCC assignment record. Primary key for tracking individual HCC assignments to members.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberHccAssignment .

ind:hccCategoryVersion rdf:type rdf:Property ;
    rdfs:label 'Hcc Category Version' ;
    rdfs:comment 'The version of the CMS HCC risk adjustment model used for this assignment (e.g., V24, V28).' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccCoefficient rdf:type rdf:Property ;
    rdfs:label 'Hcc Coefficient' ;
    rdfs:comment 'The risk score coefficient associated with this HCC code, used in calculating the member\'s total Risk Adjustment Factor (RAF) score.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isHierarchicalOverride rdf:type rdf:Property ;
    rdfs:label 'Is Hierarchical Override' ;
    rdfs:comment 'Indicates whether this HCC was overridden by a higher-severity HCC in the same hierarchy per CMS hierarchical rules.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overriddenByHccCode rdf:type rdf:Property ;
    rdfs:label 'Overridden By Hcc Code' ;
    rdfs:comment 'The HCC code that overrode this HCC assignment due to hierarchical rules, if applicable.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chartReviewId rdf:type rdf:Property ;
    rdfs:label 'Chart Review Id' ;
    rdfs:comment 'The unique identifier of the chart review activity that validated or captured this HCC assignment, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartReview .

ind:validationResult rdf:type rdf:Property ;
    rdfs:label 'Validation Result' ;
    rdfs:comment 'The outcome of the chart review validation process for this HCC assignment.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invalidationReason rdf:type rdf:Property ;
    rdfs:label 'Invalidation Reason' ;
    rdfs:comment 'The reason why this HCC assignment was invalidated during chart review, if applicable.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSuspect rdf:type rdf:Property ;
    rdfs:label 'Is Suspect' ;
    rdfs:comment 'Indicates whether this HCC assignment is flagged as a suspect diagnosis requiring additional validation or documentation.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suspectReason rdf:type rdf:Property ;
    rdfs:label 'Suspect Reason' ;
    rdfs:comment 'The reason why this HCC assignment was flagged as suspect (e.g., lack of supporting documentation, coding pattern anomaly).' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRecaptured rdf:type rdf:Property ;
    rdfs:label 'Is Recaptured' ;
    rdfs:comment 'Indicates whether this HCC represents a chronic condition that was recaptured from a prior year.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorYearHccCode rdf:type rdf:Property ;
    rdfs:label 'Prior Year Hcc Code' ;
    rdfs:comment 'The HCC code assigned to this member in the prior measurement year, used for recapture tracking.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisPriority rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Priority' ;
    rdfs:comment 'The priority or sequence number of the diagnosis on the claim (1=primary, 2=secondary, etc.).' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskModelType rdf:type rdf:Property ;
    rdfs:label 'Risk Model Type' ;
    rdfs:comment 'The specific CMS risk adjustment model applied for this HCC assignment (CMS-HCC, RxHCC, ESRD, Institutional, New Enrollee).' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberAgeAtService rdf:type rdf:Property ;
    rdfs:label 'Member Age At Service' ;
    rdfs:comment 'The age of the member at the time of the service date when the diagnosis was captured.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalReasonForEntitlement rdf:type rdf:Property ;
    rdfs:label 'Original Reason For Entitlement' ;
    rdfs:comment 'The original reason for Medicare entitlement, used in risk adjustment model selection (OASI=Old Age, DIB=Disability, ESRD=End Stage Renal Disease).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isNewEnrollee rdf:type rdf:Property ;
    rdfs:label 'Is New Enrollee' ;
    rdfs:comment 'Indicates whether the member was a new enrollee in the measurement year, affecting which risk model is applied.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monthsEnrolled rdf:type rdf:Property ;
    rdfs:label 'Months Enrolled' ;
    rdfs:comment 'The number of months the member was enrolled in the plan during the measurement year.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentAmountImpact rdf:type rdf:Property ;
    rdfs:label 'Payment Amount Impact' ;
    rdfs:comment 'The estimated dollar impact of this HCC assignment on the plan\'s risk-adjusted payment from CMS.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateCell rdf:type rdf:Property ;
    rdfs:label 'Rate Cell' ;
    rdfs:comment 'The rate cell classification used for payment calculation, combining demographic and enrollment factors.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCaptureMethod rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Capture Method' ;
    rdfs:comment 'The method by which the diagnosis was captured for risk adjustment purposes.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSupplementalDiagnosis rdf:type rdf:Property ;
    rdfs:label 'Is Supplemental Diagnosis' ;
    rdfs:comment 'Indicates whether this diagnosis was captured through supplemental data collection efforts rather than standard claims.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:healthAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Health Assessment Id' ;
    rdfs:comment 'The unique identifier of the health risk assessment that captured this diagnosis, if applicable.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Assessment .

ind:codingAccuracyScore rdf:type rdf:Property ;
    rdfs:label 'Coding Accuracy Score' ;
    rdfs:comment 'A quality score indicating the accuracy and completeness of the diagnosis coding for this HCC assignment.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAuditSelected rdf:type rdf:Property ;
    rdfs:label 'Is Audit Selected' ;
    rdfs:comment 'Indicates whether this HCC assignment was selected for CMS RADV audit review.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditYear rdf:type rdf:Property ;
    rdfs:label 'Audit Year' ;
    rdfs:comment 'The year in which this HCC assignment was audited by CMS or internal auditors.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:errorRateImpact rdf:type rdf:Property ;
    rdfs:label 'Error Rate Impact' ;
    rdfs:comment 'The percentage impact of this HCC assignment on the overall contract error rate if invalidated during audit.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correctionDate rdf:type rdf:Property ;
    rdfs:label 'Correction Date' ;
    rdfs:comment 'The date when a correction was made to this HCC assignment, if applicable.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deletionReason rdf:type rdf:Property ;
    rdfs:label 'Deletion Reason' ;
    rdfs:comment 'The reason why this HCC assignment was deleted from the risk adjustment submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chartSource rdf:type rdf:Property ;
    rdfs:label 'Chart Source' ;
    rdfs:comment 'The format or medium from which the medical chart was obtained for review.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chartRetrievalDate rdf:type rdf:Property ;
    rdfs:label 'Chart Retrieval Date' ;
    rdfs:comment 'The date on which the medical chart was retrieved from the provider or medical records system.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chartPagesReviewed rdf:type rdf:Property ;
    rdfs:label 'Chart Pages Reviewed' ;
    rdfs:comment 'The total number of pages in the medical chart that were reviewed during the chart review activity.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalHccCount rdf:type rdf:Property ;
    rdfs:label 'Original Hcc Count' ;
    rdfs:comment 'The number of HCC codes originally submitted for the member prior to the chart review.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validatedHccCount rdf:type rdf:Property ;
    rdfs:label 'Validated Hcc Count' ;
    rdfs:comment 'The number of HCC codes validated and confirmed as supported by medical record documentation after the chart review.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:addedHccCount rdf:type rdf:Property ;
    rdfs:label 'Added Hcc Count' ;
    rdfs:comment 'The number of new HCC codes identified and added as a result of the chart review that were not originally submitted.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deletedHccCount rdf:type rdf:Property ;
    rdfs:label 'Deleted Hcc Count' ;
    rdfs:comment 'The number of originally submitted HCC codes that were invalidated and removed as a result of the chart review due to insufficient documentation.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalRafScore rdf:type rdf:Property ;
    rdfs:label 'Original Raf Score' ;
    rdfs:comment 'The member\'s risk adjustment factor score prior to the chart review, used to calculate Medicare Advantage capitation payments.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validatedRafScore rdf:type rdf:Property ;
    rdfs:label 'Validated Raf Score' ;
    rdfs:comment 'The member\'s risk adjustment factor score after the chart review validation, reflecting only HCCs supported by medical documentation.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rafScoreVariance rdf:type rdf:Property ;
    rdfs:label 'Raf Score Variance' ;
    rdfs:comment 'The difference between the original RAF score and the validated RAF score, indicating the impact of the chart review on risk score.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discrepancyFoundFlag rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Found Flag' ;
    rdfs:comment 'Indicator of whether any discrepancies were identified between originally submitted HCC codes and medical record documentation.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:discrepancyType rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Type' ;
    rdfs:comment 'Classification of the type of discrepancy identified during the chart review process.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discrepancyDescription rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Description' ;
    rdfs:comment 'Detailed narrative description of the discrepancy identified during the chart review, including specific documentation issues.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditSampleFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Sample Flag' ;
    rdfs:comment 'Indicator of whether this chart review was selected as part of a CMS RADV audit sample.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resubmissionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Resubmission Required Flag' ;
    rdfs:comment 'Indicator of whether risk adjustment data must be resubmitted to CMS based on the chart review findings.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Resubmission Date' ;
    rdfs:comment 'The date on which corrected risk adjustment data was resubmitted to CMS following the chart review.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Impact Amount' ;
    rdfs:comment 'The estimated financial impact on Medicare Advantage capitation payments resulting from the chart review findings, expressed in US dollars.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Review Duration Minutes' ;
    rdfs:comment 'The total time in minutes spent conducting the chart review activity from start to completion.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:codingGuidelinesVersion rdf:type rdf:Property ;
    rdfs:label 'Coding Guidelines Version' ;
    rdfs:comment 'The version of ICD-10-CM coding guidelines and CMS HCC model used during the chart review.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisorReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Supervisor Review Required Flag' ;
    rdfs:comment 'Indicator of whether the chart review findings require secondary review and approval by a supervisor or senior coder.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supervisorTeamMemberId rdf:type rdf:Property ;
    rdfs:label 'Supervisor Team Member Id' ;
    rdfs:comment 'Unique identifier for the supervisor who performed secondary review of the chart review findings.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TeamMember .

ind:supervisorApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Supervisor Approval Date' ;
    rdfs:comment 'The date on which the supervisor approved the chart review findings.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:educationOpportunityFlag rdf:type rdf:Property ;
    rdfs:label 'Education Opportunity Flag' ;
    rdfs:comment 'Indicator of whether the chart review findings identified an opportunity for provider education on documentation or coding practices.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:educationTopic rdf:type rdf:Property ;
    rdfs:label 'Education Topic' ;
    rdfs:comment 'The specific documentation or coding topic identified for provider education based on chart review findings.' ;
    rdfs:domain ind:ChartReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Record Source System' ;
    rdfs:comment 'The name of the source system or application from which the chart review record was captured.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Adjustment Submission Id' ;
    rdfs:comment 'Unique identifier for each risk adjustment data submission record to CMS.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AdjustmentSubmission .

ind:submissionFileName rdf:type rdf:Property ;
    rdfs:label 'Submission File Name' ;
    rdfs:comment 'Name of the data file submitted to CMS containing risk adjustment records.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionBatchId rdf:type rdf:Property ;
    rdfs:label 'Submission Batch Id' ;
    rdfs:comment 'Internal batch identifier grouping multiple submissions processed together for transmission to CMS.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Batch .

ind:recordCount rdf:type rdf:Property ;
    rdfs:label 'Record Count' ;
    rdfs:comment 'Total number of individual risk adjustment records (member-diagnosis combinations) included in the submission file.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fileFormatVersion rdf:type rdf:Property ;
    rdfs:label 'File Format Version' ;
    rdfs:comment 'Version number of the CMS file layout specification used for the submission (e.g., RAPS v5.0, EDPS v2.1).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionMethod rdf:type rdf:Property ;
    rdfs:label 'Transmission Method' ;
    rdfs:comment 'Technical method used to transmit the submission file to CMS systems.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsAcknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Cms Acknowledgment Date' ;
    rdfs:comment 'Date when CMS acknowledged receipt of the submission file.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsAcknowledgmentNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Acknowledgment Number' ;
    rdfs:comment 'Unique tracking number assigned by CMS upon receipt of the submission file.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsProcessingDate rdf:type rdf:Property ;
    rdfs:label 'Cms Processing Date' ;
    rdfs:comment 'Date when CMS completed processing and validation of the submitted risk adjustment data.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:acceptedRecordCount rdf:type rdf:Property ;
    rdfs:label 'Accepted Record Count' ;
    rdfs:comment 'Number of records from the submission that were accepted by CMS and will be used for risk score calculation.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rejectedRecordCount rdf:type rdf:Property ;
    rdfs:label 'Rejected Record Count' ;
    rdfs:comment 'Number of records from the submission that were rejected by CMS due to validation errors or data quality issues.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acceptanceRatePercent rdf:type rdf:Property ;
    rdfs:label 'Acceptance Rate Percent' ;
    rdfs:comment 'Percentage of submitted records accepted by CMS, calculated as (accepted_record_count / record_count) * 100.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:errorFileName rdf:type rdf:Property ;
    rdfs:label 'Error File Name' ;
    rdfs:comment 'Name of the error report file returned by CMS detailing rejected records and validation failures.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorFileReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Error File Received Date' ;
    rdfs:comment 'Date when the CMS error report file was received and available for review.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryErrorCategory rdf:type rdf:Property ;
    rdfs:label 'Primary Error Category' ;
    rdfs:comment 'Most common category of errors identified by CMS in rejected records from this submission.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resubmissionDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Resubmission Deadline Date' ;
    rdfs:comment 'Final date by which corrected records must be resubmitted to CMS to be included in the measurement year risk scores.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chartReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Chart Review Flag' ;
    rdfs:comment 'Indicator whether this submission includes diagnoses captured through retrospective chart review activities.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supplementalDataFlag rdf:type rdf:Property ;
    rdfs:label 'Supplemental Data Flag' ;
    rdfs:comment 'Indicator whether this submission contains supplemental diagnosis data beyond standard claims and encounters.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionWindow rdf:type rdf:Property ;
    rdfs:label 'Submission Window' ;
    rdfs:comment 'Designated CMS submission period during which this file was transmitted (initial, mid-year, final, or sweep).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionPriority rdf:type rdf:Property ;
    rdfs:label 'Submission Priority' ;
    rdfs:comment 'Internal priority level assigned to the submission based on deadline proximity or business criticality.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Submitter Organization Name' ;
    rdfs:comment 'Name of the organization submitting the risk adjustment data (typically UnitedHealthcare or a delegated entity).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterContactEmail rdf:type rdf:Property ;
    rdfs:label 'Submitter Contact Email' ;
    rdfs:comment 'Email address of the individual responsible for the submission.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterContactPhone rdf:type rdf:Property ;
    rdfs:label 'Submitter Contact Phone' ;
    rdfs:comment 'Phone number of the individual responsible for the submission.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsResponseCode rdf:type rdf:Property ;
    rdfs:label 'Cms Response Code' ;
    rdfs:comment 'Standardized code returned by CMS indicating the overall processing result of the submission.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsResponseDescription rdf:type rdf:Property ;
    rdfs:label 'Cms Response Description' ;
    rdfs:comment 'Detailed text description of the CMS processing result and any issues encountered.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discrepancyCount rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Count' ;
    rdfs:comment 'Number of discrepancies identified during reconciliation between internal records and CMS acceptance reports.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedRafImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Raf Impact' ;
    rdfs:comment 'Estimated aggregate RAF score impact from the diagnoses included in this submission.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedRevenueImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Revenue Impact Amount' ;
    rdfs:comment 'Estimated financial impact in dollars from the risk scores generated by this submission.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deleteIndicatorFlag rdf:type rdf:Property ;
    rdfs:label 'Delete Indicator Flag' ;
    rdfs:comment 'Indicator whether this submission contains delete transactions to remove previously submitted diagnoses from CMS records.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctionFlag rdf:type rdf:Property ;
    rdfs:label 'Correction Flag' ;
    rdfs:comment 'Indicator whether this submission corrects or replaces data from a previous submission.' ;
    rdfs:domain ind:AdjustmentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:edpsSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Edps Submission Id' ;
    rdfs:comment 'Unique identifier for each EDPS submission record sent to CMS for Medicare Advantage risk adjustment processing.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceYear rdf:type rdf:Property ;
    rdfs:label 'Service Year' ;
    rdfs:comment 'Calendar year during which the healthcare services documented in this EDPS submission were provided to members.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Data Period Start Date' ;
    rdfs:comment 'Beginning date of the service period covered by encounters included in this EDPS submission.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Data Period End Date' ;
    rdfs:comment 'Ending date of the service period covered by encounters included in this EDPS submission.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalEncounterCount rdf:type rdf:Property ;
    rdfs:label 'Total Encounter Count' ;
    rdfs:comment 'Total number of individual encounter records included in this EDPS submission file.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acceptedEncounterCount rdf:type rdf:Property ;
    rdfs:label 'Accepted Encounter Count' ;
    rdfs:comment 'Number of encounter records from this submission that were accepted by CMS EDPS processing.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rejectedEncounterCount rdf:type rdf:Property ;
    rdfs:label 'Rejected Encounter Count' ;
    rdfs:comment 'Number of encounter records from this submission that were rejected by CMS EDPS processing due to validation errors.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalDiagnosisCount rdf:type rdf:Property ;
    rdfs:label 'Total Diagnosis Count' ;
    rdfs:comment 'Total number of diagnosis codes submitted across all encounters in this EDPS file for risk adjustment consideration.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hccEligibleDiagnosisCount rdf:type rdf:Property ;
    rdfs:label 'Hcc Eligible Diagnosis Count' ;
    rdfs:comment 'Number of diagnosis codes in this submission that map to valid HCC categories for risk score calculation.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cmsAcknowledgmentId rdf:type rdf:Property ;
    rdfs:label 'Cms Acknowledgment Id' ;
    rdfs:comment 'Unique acknowledgment identifier returned by CMS upon receipt of the EDPS submission file.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsResponseFileName rdf:type rdf:Property ;
    rdfs:label 'Cms Response File Name' ;
    rdfs:comment 'Name of the response file returned by CMS containing acceptance/rejection details for this EDPS submission.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsResponseReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Cms Response Received Date' ;
    rdfs:comment 'Date when UnitedHealthcare received the CMS response file for this EDPS submission.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Submission Deadline Date' ;
    rdfs:comment 'CMS deadline date by which this EDPS submission must be completed for the applicable submission window.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isTimelySubmitted rdf:type rdf:Property ;
    rdfs:label 'Is Timely Submitted' ;
    rdfs:comment 'Indicator of whether this EDPS submission was completed before the CMS deadline for the applicable submission window.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Submission Source System' ;
    rdfs:comment 'Name of the internal UnitedHealthcare system that generated and prepared this EDPS submission file.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileGenerationDate rdf:type rdf:Property ;
    rdfs:label 'File Generation Date' ;
    rdfs:comment 'Date when the EDPS submission file was generated and prepared for transmission to CMS.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskAdjustmentModelVersion rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Model Version' ;
    rdfs:comment 'Version of the CMS HCC risk adjustment model applicable to the payment year for this EDPS submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encounterDataType rdf:type rdf:Property ;
    rdfs:label 'Encounter Data Type' ;
    rdfs:comment 'Type of healthcare encounter data included in this EDPS submission (professional, institutional, pharmacy, or durable medical equipment).' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalMemberCount rdf:type rdf:Property ;
    rdfs:label 'Total Member Count' ;
    rdfs:comment 'Total number of unique Medicare Advantage members represented in the encounters within this EDPS submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalProviderCount rdf:type rdf:Property ;
    rdfs:label 'Total Provider Count' ;
    rdfs:comment 'Total number of unique healthcare providers represented in the encounters within this EDPS submission.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:checksumValue rdf:type rdf:Property ;
    rdfs:label 'Checksum Value' ;
    rdfs:comment 'Cryptographic checksum or hash value of the EDPS submission file used to verify file integrity during transmission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compressionMethod rdf:type rdf:Property ;
    rdfs:label 'Compression Method' ;
    rdfs:comment 'Compression method applied to the EDPS submission file before transmission.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionNotes rdf:type rdf:Property ;
    rdfs:label 'Submission Notes' ;
    rdfs:comment 'Free-text notes documenting special circumstances, issues, or context related to this EDPS submission.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsFeedbackSummary rdf:type rdf:Property ;
    rdfs:label 'Cms Feedback Summary' ;
    rdfs:comment 'Summary of key feedback, errors, or issues reported by CMS in response to this EDPS submission.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectedRafImpact rdf:type rdf:Property ;
    rdfs:label 'Projected Raf Impact' ;
    rdfs:comment 'Estimated impact on overall plan Risk Adjustment Factor score from diagnoses included in this EDPS submission.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedPaymentImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Payment Impact' ;
    rdfs:comment 'Estimated financial impact in dollars on Medicare Advantage payments resulting from this EDPS submission.' ;
    rdfs:domain ind:EdpsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acceptanceRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Acceptance Rate Percentage' ;
    rdfs:comment 'Percentage of encounter records from this submission that were accepted by CMS without errors.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastRetryDate rdf:type rdf:Property ;
    rdfs:label 'Last Retry Date' ;
    rdfs:comment 'Date of the most recent retry attempt for this EDPS submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rapsSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Raps Submission Id' ;
    rdfs:comment 'Unique identifier for each RAPS submission record sent to CMS for Medicare Advantage risk adjustment processing.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataCollectionPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Data Collection Period Start Date' ;
    rdfs:comment 'Beginning date of the service period for diagnoses included in this RAPS submission.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataCollectionPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Data Collection Period End Date' ;
    rdfs:comment 'Ending date of the service period for diagnoses included in this RAPS submission.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalRecordsSubmitted rdf:type rdf:Property ;
    rdfs:label 'Total Records Submitted' ;
    rdfs:comment 'Total number of individual diagnosis records included in this RAPS submission file.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalMembersSubmitted rdf:type rdf:Property ;
    rdfs:label 'Total Members Submitted' ;
    rdfs:comment 'Total number of unique Medicare Advantage members represented in this RAPS submission.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalHccRecords rdf:type rdf:Property ;
    rdfs:label 'Total Hcc Records' ;
    rdfs:comment 'Total number of diagnosis records that map to valid HCC categories in this submission.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acceptedRecordsCount rdf:type rdf:Property ;
    rdfs:label 'Accepted Records Count' ;
    rdfs:comment 'Number of diagnosis records from this submission that were accepted by CMS for risk adjustment calculation.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rejectedRecordsCount rdf:type rdf:Property ;
    rdfs:label 'Rejected Records Count' ;
    rdfs:comment 'Number of diagnosis records from this submission that were rejected by CMS due to validation errors or data quality issues.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:submissionFormat rdf:type rdf:Property ;
    rdfs:label 'Submission Format' ;
    rdfs:comment 'Data format of the RAPS submission file as specified by CMS requirements.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelYear rdf:type rdf:Property ;
    rdfs:label 'Model Year' ;
    rdfs:comment 'Year of the risk adjustment model used for HCC mapping and RAF score calculation in this submission.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isInitialSubmission rdf:type rdf:Property ;
    rdfs:label 'Is Initial Submission' ;
    rdfs:comment 'Boolean flag indicating whether this is the first submission of risk adjustment data for the specified payment year and contract.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSweepSubmission rdf:type rdf:Property ;
    rdfs:label 'Is Sweep Submission' ;
    rdfs:comment 'Boolean flag indicating whether this submission is part of a final data sweep period before the submission deadline.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCorrectionSubmission rdf:type rdf:Property ;
    rdfs:label 'Is Correction Submission' ;
    rdfs:comment 'Boolean flag indicating whether this submission corrects previously submitted RAPS data.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resubmissionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Resubmission Reason Code' ;
    rdfs:comment 'Code indicating the reason for resubmitting or correcting previously submitted RAPS data.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resubmissionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Resubmission Reason Description' ;
    rdfs:comment 'Detailed description of why the RAPS data was resubmitted or corrected.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsErrorCode rdf:type rdf:Property ;
    rdfs:label 'Cms Error Code' ;
    rdfs:comment 'Error code returned by CMS if the submission was rejected or partially rejected.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsErrorDescription rdf:type rdf:Property ;
    rdfs:label 'Cms Error Description' ;
    rdfs:comment 'Detailed description of the error returned by CMS for rejected submissions.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedRafScoreImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Raf Score Impact' ;
    rdfs:comment 'Estimated aggregate RAF score impact from the diagnoses included in this RAPS submission.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chartReviewVendorName rdf:type rdf:Property ;
    rdfs:label 'Chart Review Vendor Name' ;
    rdfs:comment 'Name of the third-party vendor that conducted chart reviews if the RAPS data includes chart-reviewed diagnoses.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:includesChartReviewData rdf:type rdf:Property ;
    rdfs:label 'Includes Chart Review Data' ;
    rdfs:comment 'Boolean flag indicating whether this RAPS submission includes diagnoses obtained through medical chart reviews.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesTelehealthEncounters rdf:type rdf:Property ;
    rdfs:label 'Includes Telehealth Encounters' ;
    rdfs:comment 'Boolean flag indicating whether this RAPS submission includes diagnoses from telehealth encounters.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionQuarter rdf:type rdf:Property ;
    rdfs:label 'Submission Quarter' ;
    rdfs:comment 'Calendar quarter in which this RAPS submission was made, used for tracking submission patterns and deadlines.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionMonth rdf:type rdf:Property ;
    rdfs:label 'Submission Month' ;
    rdfs:comment 'Calendar month (1-12) in which this RAPS submission was made.' ;
    rdfs:domain ind:RapsSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'Unique identifier for each risk-adjusted payment transaction record received from CMS.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:month rdf:type rdf:Property ;
    rdfs:label 'Month' ;
    rdfs:comment 'Month within the payment year for which the risk-adjusted payment was received (1-12).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:communityRafScore rdf:type rdf:Property ;
    rdfs:label 'Community Raf Score' ;
    rdfs:comment 'RAF score component for community-dwelling (non-institutionalized) beneficiaries.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:institutionalRafScore rdf:type rdf:Property ;
    rdfs:label 'Institutional Raf Score' ;
    rdfs:comment 'RAF score component for institutionalized beneficiaries (nursing home residents).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esrdRafScore rdf:type rdf:Property ;
    rdfs:label 'Esrd Raf Score' ;
    rdfs:comment 'RAF score component for beneficiaries with End Stage Renal Disease.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:codingIntensityAdjustment rdf:type rdf:Property ;
    rdfs:label 'Coding Intensity Adjustment' ;
    rdfs:comment 'CMS adjustment factor applied to account for differences in diagnostic coding practices between MA and Fee-for-Service.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseRate rdf:type rdf:Property ;
    rdfs:label 'Base Rate' ;
    rdfs:comment 'CMS county-level base payment rate before risk adjustment, reflecting local healthcare costs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demographicFactor rdf:type rdf:Property ;
    rdfs:label 'Demographic Factor' ;
    rdfs:comment 'Risk score component based on member age, gender, and Medicaid eligibility status.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diseaseFactor rdf:type rdf:Property ;
    rdfs:label 'Disease Factor' ;
    rdfs:comment 'Risk score component based on diagnosed Hierarchical Condition Categories (HCCs).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basePaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Base Payment Amount' ;
    rdfs:comment 'Payment amount before risk adjustment (base rate only).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskAdjustedAmount rdf:type rdf:Property ;
    rdfs:label 'Risk Adjusted Amount' ;
    rdfs:comment 'Incremental payment amount attributable to risk adjustment (RAF score application).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partAPayment rdf:type rdf:Property ;
    rdfs:label 'Part A Payment' ;
    rdfs:comment 'Portion of payment attributable to Medicare Part A (hospital insurance) benefits.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partBPayment rdf:type rdf:Property ;
    rdfs:label 'Part B Payment' ;
    rdfs:comment 'Portion of payment attributable to Medicare Part B (medical insurance) benefits.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partDPayment rdf:type rdf:Property ;
    rdfs:label 'Part D Payment' ;
    rdfs:comment 'Portion of payment attributable to Medicare Part D (prescription drug) benefits if applicable.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebateAmount rdf:type rdf:Property ;
    rdfs:label 'Rebate Amount' ;
    rdfs:comment 'Rebate amount earned by the plan based on bid performance relative to benchmark.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sequestrationAmount rdf:type rdf:Property ;
    rdfs:label 'Sequestration Amount' ;
    rdfs:comment 'Payment reduction amount applied due to federal budget sequestration requirements.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'Final net payment amount after all adjustments, rebates, and deductions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diagnosisDataYear rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Data Year' ;
    rdfs:comment 'Year from which diagnosis data was collected for risk score calculation.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dualEligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Dual Eligibility Status' ;
    rdfs:comment 'Member eligibility status for both Medicare and Medicaid benefits (full dual, partial dual, non-dual).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidStatusCode rdf:type rdf:Property ;
    rdfs:label 'Medicaid Status Code' ;
    rdfs:comment 'Two-digit code indicating the member\'s Medicaid eligibility status for risk adjustment.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalReasonEntitlementCode rdf:type rdf:Property ;
    rdfs:label 'Original Reason Entitlement Code' ;
    rdfs:comment 'Code indicating the original reason for Medicare entitlement (0=OASDI, 1=DIB, 2=ESRD, 3=Both DIB and ESRD).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disabledStatus rdf:type rdf:Property ;
    rdfs:label 'Disabled Status' ;
    rdfs:comment 'Indicator of whether the member is entitled to Medicare due to disability.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospiceStatus rdf:type rdf:Property ;
    rdfs:label 'Hospice Status' ;
    rdfs:comment 'Indicator of whether the member was enrolled in hospice during the payment period.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newEnrolleeStatus rdf:type rdf:Property ;
    rdfs:label 'New Enrollee Status' ;
    rdfs:comment 'Indicator of whether the member is a new enrollee with insufficient diagnosis history for full risk adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationYear rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Year' ;
    rdfs:comment 'Year in which payment reconciliation was performed for this payment record.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:radvSampleFlag rdf:type rdf:Property ;
    rdfs:label 'Radv Sample Flag' ;
    rdfs:comment 'Indicator of whether this member was selected for CMS RADV audit sample.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsTransactionId rdf:type rdf:Property ;
    rdfs:label 'Cms Transaction Id' ;
    rdfs:comment 'Unique CMS-assigned identifier for the payment transaction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transaction .

ind:routingNumber rdf:type rdf:Property ;
    rdfs:label 'Routing Number' ;
    rdfs:comment 'Bank routing number for the account receiving the payment.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'Currency exchange rate applied if payment involves currency conversion.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkAmount rdf:type rdf:Property ;
    rdfs:label 'Benchmark Amount' ;
    rdfs:comment 'CMS benchmark payment amount for the county used in bid comparison.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bidAmount rdf:type rdf:Property ;
    rdfs:label 'Bid Amount' ;
    rdfs:comment 'Plan bid amount submitted to CMS for the contract year.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:processedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processed Timestamp' ;
    rdfs:comment 'Date and time when the payment was processed and reconciled in the plan\'s financial system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reconciledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reconciled Timestamp' ;
    rdfs:comment 'Date and time when the payment was fully reconciled and finalized.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ruleId rdf:type rdf:Property ;
    rdfs:label 'Rule Id' ;
    rdfs:comment 'Unique identifier for the risk adjustment rule definition. Primary key for the risk rule reference table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnitedHealthCare .

ind:rafCoefficient rdf:type rdf:Property ;
    rdfs:label 'Raf Coefficient' ;
    rdfs:comment 'The numeric coefficient value applied in RAF score calculation for this rule. Represents the relative cost weight for the condition or demographic factor.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coefficientType rdf:type rdf:Property ;
    rdfs:label 'Coefficient Type' ;
    rdfs:comment 'Classification of the RAF coefficient indicating whether it represents a disease burden, demographic factor, interaction term, or payment adjustment.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10CodePattern rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code Pattern' ;
    rdfs:comment 'The ICD-10 diagnosis code or code range pattern that triggers this risk adjustment rule. May include wildcards for code ranges.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisHierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Hierarchy Level' ;
    rdfs:comment 'The hierarchical level of this diagnosis within the HCC hierarchy. Higher severity diagnoses supersede lower severity diagnoses in the same hierarchy.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersedingHccCodes rdf:type rdf:Property ;
    rdfs:label 'Superseding Hcc Codes' ;
    rdfs:comment 'Comma-separated list of HCC codes that supersede this HCC in the diagnosis hierarchy. Used to prevent double-counting of related conditions.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionHccCodes rdf:type rdf:Property ;
    rdfs:label 'Interaction Hcc Codes' ;
    rdfs:comment 'Comma-separated list of HCC codes that must co-occur for this interaction rule to apply. Interaction terms capture additional risk from multiple conditions.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisPositionRequirement rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Position Requirement' ;
    rdfs:comment 'Specifies whether the diagnosis must appear in a specific position on the claim (primary, secondary, or any) to qualify for this rule.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumDiagnosisCount rdf:type rdf:Property ;
    rdfs:label 'Minimum Diagnosis Count' ;
    rdfs:comment 'The minimum number of times a diagnosis must appear during the data collection period for this rule to apply. Used to ensure diagnosis validity.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationRuleLogic rdf:type rdf:Property ;
    rdfs:label 'Validation Rule Logic' ;
    rdfs:comment 'Detailed technical specification of the validation logic applied to determine if this rule should be triggered. May include complex conditional expressions.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsFinalRuleReference rdf:type rdf:Property ;
    rdfs:label 'Cms Final Rule Reference' ;
    rdfs:comment 'Citation reference to the CMS final rule document that established or modified this risk adjustment rule.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radvEligible rdf:type rdf:Property ;
    rdfs:label 'Radv Eligible' ;
    rdfs:comment 'Indicates whether diagnoses captured under this rule are eligible for inclusion in CMS Risk Adjustment Data Validation audits.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chartReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Chart Review Required' ;
    rdfs:comment 'Indicates whether medical chart documentation review is required to validate diagnoses captured under this rule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentImpactCategory rdf:type rdf:Property ;
    rdfs:label 'Payment Impact Category' ;
    rdfs:comment 'Classification of the financial impact this rule has on risk-adjusted payments. High-impact rules receive additional scrutiny.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedPmpmImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Pmpm Impact' ;
    rdfs:comment 'The estimated average per member per month payment impact when this rule is triggered. Used for financial forecasting and analysis.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityMeasureAlignment rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Alignment' ;
    rdfs:comment 'Comma-separated list of HEDIS or Star Ratings measures that are related to or impacted by this risk adjustment rule.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspectingLogic rdf:type rdf:Property ;
    rdfs:label 'Suspecting Logic' ;
    rdfs:comment 'Description of the logic used to identify members who may have this condition but lack current year diagnosis documentation. Used for gap closure programs.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerEducationRequired rdf:type rdf:Property ;
    rdfs:label 'Provider Education Required' ;
    rdfs:comment 'Indicates whether this rule requires special provider education due to complexity, frequent coding errors, or high audit risk.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:codingGuidanceUrl rdf:type rdf:Property ;
    rdfs:label 'Coding Guidance Url' ;
    rdfs:comment 'URL link to detailed coding guidance, documentation requirements, or educational materials for this risk adjustment rule.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predecessorRuleCode rdf:type rdf:Property ;
    rdfs:label 'Predecessor Rule Code' ;
    rdfs:comment 'The rule code of the previous version of this rule that this version replaces or supersedes. Used for historical tracking.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successorRuleCode rdf:type rdf:Property ;
    rdfs:label 'Successor Rule Code' ;
    rdfs:comment 'The rule code of the next version of this rule that will replace this version. Used for transition planning.' ;
    rdfs:domain ind:Rule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorId rdf:type rdf:Property ;
    rdfs:label 'Factor Id' ;
    rdfs:comment 'Unique identifier for the risk factor record. Primary key for the risk factor reference table.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:demographicCategory rdf:type rdf:Property ;
    rdfs:label 'Demographic Category' ;
    rdfs:comment 'Demographic classification for this factor: age_gender for standard age/sex combinations, medicaid for dual eligible status, disability for disabled beneficiaries, institutional for nursing home residents, ltimcaid for long-term institutional Medicaid, origds for originally disabled, new_enrollee for first-year enrollees. Null for pure HCC factors.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageRange rdf:type rdf:Property ;
    rdfs:label 'Age Range' ;
    rdfs:comment 'Age range bracket for demographic factors. CMS uses specific age bands for risk adjustment. Null for non-demographic factors.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionComponent1 rdf:type rdf:Property ;
    rdfs:label 'Interaction Component 1' ;
    rdfs:comment 'First component of an interaction factor (e.g., HCC code or demographic category). Interaction factors apply when multiple conditions or characteristics co-occur, capturing additional risk beyond additive effects.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionComponent2 rdf:type rdf:Property ;
    rdfs:label 'Interaction Component 2' ;
    rdfs:comment 'Second component of an interaction factor. Null for non-interaction factors.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionComponent3 rdf:type rdf:Property ;
    rdfs:label 'Interaction Component 3' ;
    rdfs:comment 'Third component of an interaction factor for three-way interactions. Null for two-way interactions or non-interaction factors.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diseaseHierarchyParent rdf:type rdf:Property ;
    rdfs:label 'Disease Hierarchy Parent' ;
    rdfs:comment 'Parent HCC in the disease hierarchy. When a more severe condition (child) is present, less severe conditions (parent) are suppressed and their factors are not counted. Implements the hierarchical nature of HCC model.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diseaseHierarchyChild rdf:type rdf:Property ;
    rdfs:label 'Disease Hierarchy Child' ;
    rdfs:comment 'Child HCC in the disease hierarchy. Represents the more severe condition that suppresses the parent HCC.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelSegment rdf:type rdf:Property ;
    rdfs:label 'Model Segment' ;
    rdfs:comment 'CMS model segment to which this factor applies: CNA (Community Non-dual Aged), CND (Community Non-dual Disabled), CFA (Community Full-benefit dual Aged), CFD (Community Full-benefit dual Disabled), CPA (Community Partial-benefit dual Aged), CPD (Community Partial-benefit dual Disabled), INS (Institutional), NE (New Enrollee), SNPNE (SNP New Enrollee). Each segment has distinct factor values.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10MappingCount rdf:type rdf:Property ;
    rdfs:label 'Icd10 Mapping Count' ;
    rdfs:comment 'Number of ICD-10 diagnosis codes that map to this HCC. Provides indication of the breadth of diagnoses included in the condition category. Null for demographic factors.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageIncrementalCost rdf:type rdf:Property ;
    rdfs:label 'Average Incremental Cost' ;
    rdfs:comment 'Average incremental annual cost (in dollars) associated with this factor, based on CMS regression analysis. Represents the additional expected cost beyond the baseline for a beneficiary with this factor.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recaptureEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Recapture Eligible Indicator' ;
    rdfs:comment 'Indicates whether this HCC is eligible for recapture in chart review programs. Some HCCs are prioritized for retrospective documentation and coding review to ensure complete risk capture.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:radvAuditFrequency rdf:type rdf:Property ;
    rdfs:label 'Radv Audit Frequency' ;
    rdfs:comment 'Relative frequency with which this HCC is selected for RADV audits by CMS: high for frequently audited HCCs (high-value, high-risk), medium for moderately audited, low for rarely audited. Null for demographic factors.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maOnlyIndicator rdf:type rdf:Property ;
    rdfs:label 'Ma Only Indicator' ;
    rdfs:comment 'Indicates whether this factor applies only to Medicare Advantage plans and not to other CMS programs (e.g., ACA marketplace risk adjustment uses different factors).' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partCIndicator rdf:type rdf:Property ;
    rdfs:label 'Part C Indicator' ;
    rdfs:comment 'Indicates whether this factor applies to Medicare Part C (Medical) risk adjustment.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaIndicator rdf:type rdf:Property ;
    rdfs:label 'Aca Indicator' ;
    rdfs:comment 'Indicates whether this factor applies to ACA marketplace risk adjustment. ACA uses HHS-HCC model which differs from CMS-HCC model for Medicare Advantage.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hhsHccCode rdf:type rdf:Property ;
    rdfs:label 'Hhs Hcc Code' ;
    rdfs:comment 'The HHS-HCC code for ACA marketplace risk adjustment. HHS-HCC categories differ from CMS-HCC categories. Null for Medicare factors.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adultModelIndicator rdf:type rdf:Property ;
    rdfs:label 'Adult Model Indicator' ;
    rdfs:comment 'Indicates whether this factor applies to the adult risk adjustment model (age 21+). CMS uses separate models for adults, children, and infants.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:childModelIndicator rdf:type rdf:Property ;
    rdfs:label 'Child Model Indicator' ;
    rdfs:comment 'Indicates whether this factor applies to the child risk adjustment model (age 2-20). Child models have different factors reflecting pediatric conditions.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:infantModelIndicator rdf:type rdf:Property ;
    rdfs:label 'Infant Model Indicator' ;
    rdfs:comment 'Indicates whether this factor applies to the infant risk adjustment model (age 0-1). Infant models include factors for birth complications and congenital conditions.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maturityAdjustment rdf:type rdf:Property ;
    rdfs:label 'Maturity Adjustment' ;
    rdfs:comment 'Adjustment factor for new or low-enrollment plans to account for incomplete diagnosis capture. Applied as a multiplier to RAF scores for plans below maturity thresholds.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkCountyRate rdf:type rdf:Property ;
    rdfs:label 'Benchmark County Rate' ;
    rdfs:comment 'Average county-level benchmark rate (in dollars) used with this factor for payment calculations. CMS sets county-specific benchmarks that are multiplied by RAF scores to determine plan payments.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedisMeasureLinkage rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Linkage' ;
    rdfs:comment 'HEDIS quality measures associated with this HCC (e.g., \'CDC-Diabetes Care\', \'CBP-Controlling High Blood Pressure\'). Links risk adjustment to quality reporting requirements.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careManagementProgramEligibility rdf:type rdf:Property ;
    rdfs:label 'Care Management Program Eligibility' ;
    rdfs:comment 'Care management or disease management programs for which members with this HCC are typically eligible (e.g., \'Diabetes Management\', \'Heart Failure Program\', \'Complex Case Management\').' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthorizationIndicator rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Indicator' ;
    rdfs:comment 'Indicates whether services related to this condition typically require prior authorization. Used to link risk adjustment to utilization management processes.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyCostImpact rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Cost Impact' ;
    rdfs:comment 'Relative impact of this condition on pharmacy costs: high for conditions requiring expensive medications, medium for moderate pharmacy utilization, low for minimal pharmacy impact, none for no pharmacy component.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inpatientCostImpact rdf:type rdf:Property ;
    rdfs:label 'Inpatient Cost Impact' ;
    rdfs:comment 'Relative impact of this condition on inpatient hospitalization costs: high for conditions with frequent or expensive hospitalizations, medium for moderate inpatient utilization, low for minimal inpatient impact, none for no inpatient component.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outpatientCostImpact rdf:type rdf:Property ;
    rdfs:label 'Outpatient Cost Impact' ;
    rdfs:comment 'Relative impact of this condition on outpatient and professional services costs: high for conditions requiring frequent specialist visits or procedures, medium for moderate outpatient utilization, low for minimal outpatient impact, none for no outpatient component.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionNotes rdf:type rdf:Property ;
    rdfs:label 'Version Notes' ;
    rdfs:comment 'Free-text notes describing changes to this factor in the current model version compared to prior versions. Documents CMS rationale for coefficient changes, new factors, or retired factors.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsPublicationDate rdf:type rdf:Property ;
    rdfs:label 'Cms Publication Date' ;
    rdfs:comment 'Date when CMS officially published this factor in the rate notice or model documentation. Establishes regulatory effective date.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicCommentPeriodIndicator rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period Indicator' ;
    rdfs:comment 'Indicates whether this factor is currently in public comment period (proposed but not finalized). CMS releases draft rate notices for public comment before finalizing.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:finalRuleIndicator rdf:type rdf:Property ;
    rdfs:label 'Final Rule Indicator' ;
    rdfs:comment 'Indicates whether this factor has been finalized in a CMS final rule and is ready for operational use. False for proposed factors still under review.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modelVersionId rdf:type rdf:Property ;
    rdfs:label 'Model Version Id' ;
    rdfs:comment 'Unique identifier for each version of the CMS risk adjustment model. Primary key for the model version reference table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ModelVersion .

ind:modelType rdf:type rdf:Property ;
    rdfs:label 'Model Type' ;
    rdfs:comment 'The type of risk adjustment model. Indicates which CMS risk adjustment methodology is used for calculating risk scores and payments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionName rdf:type rdf:Property ;
    rdfs:label 'Version Name' ;
    rdfs:comment 'The descriptive name or label for this model version, often including the year and model type for easy reference.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsAnnouncementNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Announcement Number' ;
    rdfs:comment 'The official CMS announcement or memorandum number associated with the release of this model version.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateAnnouncementReference rdf:type rdf:Property ;
    rdfs:label 'Rate Announcement Reference' ;
    rdfs:comment 'Reference to the CMS Rate Announcement document that contains the payment parameters and coefficients for this model version.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisMappingVersion rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Mapping Version' ;
    rdfs:comment 'The version identifier for the ICD-10 to HCC diagnosis mapping used in this model. Critical for accurate diagnosis capture and risk score calculation.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icdVersion rdf:type rdf:Property ;
    rdfs:label 'Icd Version' ;
    rdfs:comment 'The version of the ICD coding system used by this model version. Indicates whether ICD-9 or ICD-10 diagnosis codes are expected.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demographicModelFlag rdf:type rdf:Property ;
    rdfs:label 'Demographic Model Flag' ;
    rdfs:comment 'Indicates whether this model version includes demographic-only risk scores for members without diagnosis data. Used for new enrollees.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diseaseInteractionFlag rdf:type rdf:Property ;
    rdfs:label 'Disease Interaction Flag' ;
    rdfs:comment 'Indicates whether this model version includes disease interaction terms that increase risk scores when specific combinations of conditions are present.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disabledModelSegmentFlag rdf:type rdf:Property ;
    rdfs:label 'Disabled Model Segment Flag' ;
    rdfs:comment 'Indicates whether this model version includes a separate risk model segment for disabled beneficiaries under age 65.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esrdModelSegmentFlag rdf:type rdf:Property ;
    rdfs:label 'Esrd Model Segment Flag' ;
    rdfs:comment 'Indicates whether this model version includes a separate risk model segment for beneficiaries with End Stage Renal Disease.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:institutionalModelSegmentFlag rdf:type rdf:Property ;
    rdfs:label 'Institutional Model Segment Flag' ;
    rdfs:comment 'Indicates whether this model version includes a separate risk model segment for beneficiaries residing in long-term care or institutional settings.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newEnrolleeModelFlag rdf:type rdf:Property ;
    rdfs:label 'New Enrollee Model Flag' ;
    rdfs:comment 'Indicates whether this model version includes a separate new enrollee model for members without prior diagnosis history.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partialYearAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Partial Year Adjustment Flag' ;
    rdfs:comment 'Indicates whether this model version includes adjustments for members enrolled for less than a full year.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frailtyIndicatorFlag rdf:type rdf:Property ;
    rdfs:label 'Frailty Indicator Flag' ;
    rdfs:comment 'Indicates whether this model version includes frailty indicators or adjustments for institutionalized or frail beneficiaries.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prescriptionDrugModelFlag rdf:type rdf:Property ;
    rdfs:label 'Prescription Drug Model Flag' ;
    rdfs:comment 'Indicates whether this model version includes RxHCC categories for Medicare Part D prescription drug risk adjustment.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:softwareVersion rdf:type rdf:Property ;
    rdfs:label 'Software Version' ;
    rdfs:comment 'The version identifier for the CMS risk adjustment software or calculation engine that implements this model version.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coefficientFileName rdf:type rdf:Property ;
    rdfs:label 'Coefficient File Name' ;
    rdfs:comment 'The name of the coefficient file containing the risk weights and parameters for this model version. Used for risk score calculation.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coefficientFileLocation rdf:type rdf:Property ;
    rdfs:label 'Coefficient File Location' ;
    rdfs:comment 'The storage location or path where the coefficient file for this model version is maintained.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mappingFileName rdf:type rdf:Property ;
    rdfs:label 'Mapping File Name' ;
    rdfs:comment 'The name of the ICD-10 to HCC mapping file used by this model version for diagnosis code translation.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mappingFileLocation rdf:type rdf:Property ;
    rdfs:label 'Mapping File Location' ;
    rdfs:comment 'The storage location or path where the diagnosis mapping file for this model version is maintained.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationGuideReference rdf:type rdf:Property ;
    rdfs:label 'Implementation Guide Reference' ;
    rdfs:comment 'Reference to the implementation guide document that provides instructions for adopting and using this model version.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:majorChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Major Change Flag' ;
    rdfs:comment 'Indicates whether this model version represents a major revision with significant structural changes versus a minor update or recalibration.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recalibrationFlag rdf:type rdf:Property ;
    rdfs:label 'Recalibration Flag' ;
    rdfs:comment 'Indicates whether this model version includes recalibrated coefficients based on updated claims and cost data.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baselineDataYear rdf:type rdf:Property ;
    rdfs:label 'Baseline Data Year' ;
    rdfs:comment 'The year of the claims and cost data used to calibrate the coefficients in this model version.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

