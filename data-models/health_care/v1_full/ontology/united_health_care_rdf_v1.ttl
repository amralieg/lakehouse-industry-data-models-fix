    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concurrentReview rdf:type rdf:Property ;
    rdfs:label 'Concurrent Review' ;
    rdfs:comment 'Indicates whether the notification relates to a concurrent review of ongoing services.' ;
    rdfs:domain ind:AuthNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retrospectiveReview rdf:type rdf:Property ;
    rdfs:label 'Retrospective Review' ;
    rdfs:comment 'Indicates whether the notification relates to a retrospective review of completed services.' ;
