genomics,variant_analysis,variant_interpretation,associated_condition,associated_condition,,STRING,,,"restricted,pii_health",,,"Primary clinical condition or disease phenotype associated with the interpreted variant (e.g., Hereditary Breast and Ovarian Cancer Syndrome).",
genomics,variant_analysis,variant_interpretation,chromosome,chromosome,,STRING,,,"restricted,pii_health",,,"Chromosome on which the variant is located (e.g., chr17, chrX).",
genomics,variant_analysis,variant_interpretation,clia_lab_number,clia_lab_number,,STRING,,,,,,"CLIA certification number of the performing laboratory, required for regulatory compliance of clinical genomic testing.",
genomics,variant_analysis,variant_interpretation,clinical_significance_summary,clinical_significance_summary,,STRING,,,"restricted,pii_health",,,Free-text narrative summarizing the clinical significance of the variant in the context of the patient's phenotype and family history.,
genomics,variant_analysis,variant_interpretation,clinvar_accession,clinvar_accession,,STRING,,,,,,ClinVar submission accession number linking this interpretation to the NCBI ClinVar public archive of variant-disease relationships.,
genomics,variant_analysis,variant_interpretation,computational_score,computational_score,,"DECIMAL(6,4)",,,,,,"Numeric pathogenicity score from the primary computational prediction tool used (e.g., CADD PHRED score, REVEL score).",
genomics,variant_analysis,variant_interpretation,computational_tool_used,computational_tool_used,,STRING,,,,,,"Name and version of the primary computational prediction tool used to generate the pathogenicity score (e.g., CADD v1.6, REVEL, AlphaMissense).",
genomics,variant_analysis,variant_interpretation,cosmic_accession,cosmic_accession,,STRING,,,,,,"COSMIC identifier for somatic variants found in cancer genomes, applicable to tumor-related interpretations.",
genomics,variant_analysis,variant_interpretation,dbsnp_rsid,dbsnp_rsid,,STRING,,,,,,"dbSNP reference SNP cluster identifier (rsID) for the variant, enabling cross-referencing with public genomic databases.",
genomics,variant_analysis,variant_interpretation,evidence_criteria_applied,evidence_criteria_applied,,STRING,,,,,,"Comma-separated list of ACMG/AMP evidence criteria codes applied to reach the classification (e.g., PVS1, PM2, PP3).",
genomics,variant_analysis,variant_interpretation,family_segregation_data,family_segregation_data,,STRING,,,"restricted,pii_health",,,Summary of family segregation analysis data indicating whether the variant co-segregates with disease in affected family members.,
genomics,variant_analysis,variant_interpretation,functional_impact_prediction,functional_impact_prediction,,STRING,,,,,,"Consensus in silico prediction of functional impact from computational tools such as SIFT, PolyPhen-2, CADD, or REVEL.",
genomics,variant_analysis,variant_interpretation,gene_symbol,gene_symbol,,STRING,,,"restricted,pii_health",,,"Official HGNC-approved gene symbol for the gene in which the variant was identified (e.g., BRCA1, TP53, EGFR).",
genomics,variant_analysis,variant_interpretation,genetic_counseling_recommended,genetic_counseling_recommended,,BOOLEAN,,,,,,Indicates whether genetic counseling is recommended for the patient and/or family members based on this interpretation.,
genomics,variant_analysis,variant_interpretation,genomic_position,genomic_position,,BIGINT,,,"restricted,pii_health",,,Genomic coordinate position of the variant on the reference genome assembly.,
genomics,variant_analysis,variant_interpretation,hgvs_coding_notation,hgvs_coding_notation,,STRING,,,"restricted,pii_health",,,"HGVS-formatted coding DNA sequence notation describing the variant at the nucleotide level (e.g., c.5266dupC).",
genomics,variant_analysis,variant_interpretation,hgvs_protein_notation,hgvs_protein_notation,,STRING,,,"restricted,pii_health",,,"HGVS-formatted protein-level notation describing the predicted amino acid change (e.g., p.Gln1756ProfsTer74).",
genomics,variant_analysis,variant_interpretation,inheritance_pattern,inheritance_pattern,,STRING,,,"restricted,pii_health",,,Mode of inheritance for the condition associated with the variant.,
genomics,variant_analysis,variant_interpretation,interpretation_date,interpretation_date,,DATE,,,,,,Date on which the clinical variant interpretation was completed and signed by the interpreting provider.,
genomics,variant_analysis,variant_interpretation,interpretation_status,interpretation_status,,STRING,,,,,,Current state of the variant interpretation report in its clinical workflow lifecycle.,
genomics,variant_analysis,variant_interpretation,interpretation_type,interpretation_type,,STRING,,,,,,"Classification of the type of genomic variant interpretation being performed (germline hereditary, somatic tumor, pharmacogenomic, prenatal, or carrier screening).",
genomics,variant_analysis,variant_interpretation,is_actionable,is_actionable,,BOOLEAN,,,,,,"Indicates whether the variant interpretation has direct clinical actionability (e.g., changes management, qualifies for targeted therapy, or triggers surveillance recommendations).",
genomics,variant_analysis,variant_interpretation,is_reportable,is_reportable,,BOOLEAN,,,,,,"Indicates whether this variant meets criteria for inclusion in the clinical report to the ordering provider (true = reportable, false = not reported).",
genomics,variant_analysis,variant_interpretation,is_secondary_finding,is_secondary_finding,,BOOLEAN,,,,,,Indicates whether this variant represents an ACMG-recommended secondary finding unrelated to the primary test indication.,
genomics,variant_analysis,variant_interpretation,performing_laboratory_name,performing_laboratory_name,,STRING,,,,,,Name of the CLIA-certified laboratory that performed the genomic sequencing and initial variant calling.,
genomics,variant_analysis,variant_interpretation,population_database_source,population_database_source,,STRING,,,,,,Reference population database from which the allele frequency was obtained.,
genomics,variant_analysis,variant_interpretation,read_depth,read_depth,,INT,,,,,,"Total number of sequencing reads covering the variant position, indicating confidence in the variant call.",
genomics,variant_analysis,variant_interpretation,reference_genome_build,reference_genome_build,,STRING,,,,,,Human reference genome assembly version used for variant coordinate mapping.,
genomics,variant_analysis,variant_interpretation,report_issued_timestamp,report_issued_timestamp,,TIMESTAMP,,,,,,Timestamp when the finalized variant interpretation report was officially issued and made available to the ordering provider.,
genomics,variant_analysis,variant_interpretation,report_number,report_number,,STRING,,,,,,Externally-known unique report number assigned to this variant interpretation report for clinical tracking and communication.,
genomics,variant_analysis,variant_interpretation,review_notes,review_notes,,STRING,,,,,,Internal notes from the variant review board or molecular tumor board discussion regarding this interpretation.,
genomics,variant_analysis,variant_interpretation,specimen_type,specimen_type,,STRING,,,,,,Type of biological specimen from which the genomic DNA was extracted for sequencing.,
genomics,variant_analysis,variant_interpretation,test_methodology,test_methodology,,STRING,,,,,,"Laboratory methodology used to detect the variant (whole genome sequencing, whole exome sequencing, targeted gene panel, single gene test, FISH, or array CGH). [ENUM-REF-CANDIDATE: WGS|WES|targeted_panel|single_gene|FISH|array_CGH|RNA_seq — promote to reference product]",
genomics,variant_analysis,variant_interpretation,test_panel_name,test_panel_name,,STRING,,,,,,"Name of the specific gene panel or test assay used (e.g., Comprehensive Cancer Panel, Hereditary Cardiac Panel).",
genomics,variant_analysis,variant_interpretation,therapeutic_implication,therapeutic_implication,,STRING,,,"restricted,pii_health",,,"Summary of therapeutic implications including targeted therapy eligibility, drug sensitivity or resistance, and clinical trial candidacy based on the variant.",
genomics,variant_analysis,variant_interpretation,tier_classification,tier_classification,,STRING,,,"restricted,pii_health",,,Four-tier classification for somatic variants per AMP/ASCO/CAP guidelines indicating level of clinical evidence for actionability. [ENUM-REF-CANDIDATE: tier_I_A|tier_I_B|tier_II_C|tier_II_D|tier_III|tier_IV — promote to reference product],
genomics,variant_analysis,variant_interpretation,tumor_mutational_burden,tumor_mutational_burden,,"DECIMAL(8,2)",,,"restricted,pii_health",,,"Tumor mutational burden measured in mutations per megabase, relevant for somatic variant interpretations and immunotherapy eligibility assessment.",
genomics,variant_analysis,variant_interpretation,variant_allele_fraction,variant_allele_fraction,,"DECIMAL(5,4)",,,"restricted,pii_health",,,"Proportion of sequencing reads supporting the variant allele at this position, indicating clonality in somatic contexts or confirming zygosity in germline contexts.",
genomics,variant_analysis,variant_interpretation,variant_class,variant_class,,STRING,,,"restricted,pii_health",,,"Structural classification of the genomic variant (single nucleotide variant, insertion, deletion, indel, copy number variant, or structural variant).",
genomics,variant_analysis,variant_interpretation,zygosity,zygosity,,STRING,,,"restricted,pii_health",,,"Zygosity state of the variant in the patient (heterozygous, homozygous, hemizygous, or compound heterozygous).",
insurance,member_operations,accumulator,accumulator_id,accumulator_id,Accumulator Identifier (ID),BIGINT,Y,,,,transactional_data,Unique identifier for the accumulator record. Primary key for tracking member benefit accumulation.,
