    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageRestrictionMaximum rdf:type rdf:Property ;
    rdfs:label 'Age Restriction Maximum' ;
    rdfs:comment 'Maximum member age in years for which this service type is typically authorized, based on clinical appropriateness.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualifyingDiagnosisCodes rdf:type rdf:Property ;
