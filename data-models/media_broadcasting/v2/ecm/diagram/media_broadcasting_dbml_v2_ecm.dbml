  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Pension and health contributions are calculated per production title for guild fund remittance, cost allocation, and regulatory compliance reporting. Required for guild audit and financial reconciliat | Column title_id (BIGINT) in content.pension_health_contribution']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.pension_health_contribution']
