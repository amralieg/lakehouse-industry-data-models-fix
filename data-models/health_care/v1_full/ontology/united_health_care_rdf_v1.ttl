    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicarePartBEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Medicare Part B Effective Date' ;
    rdfs:comment 'The date when the member\'s Medicare Part B medical insurance coverage became effective.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicaidIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicaid Indicator' ;
    rdfs:comment 'Flag indicating whether the member has Medicaid coverage, affecting dual eligibility determination and coordination of benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dualEligibleIndicator rdf:type rdf:Property ;
