  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in content.genre_buy_agreement']
  agreement_status varchar [note: 'Current lifecycle status of this genre buy agreement (active, pending, expired, suspended, terminated). Tracks the operational state of the commercial relationship. | Column agreement_status (STRING) in content.genre_buy_agreement']
  category_exclusivity_flag boolean [note: 'Indicates whether this advertiser has purchased category exclusivity within this genre, preventing direct competitors from advertising in the same genre during the contract period. Explicitly identified in detection phase relationship data. | Column category_exclusivity_flag (BOOLEAN) in content.genre_buy_agreement']
  contract_end_date date [note: 'The expiration date when this advertiser-genre buy agreement terminates and the negotiated terms no longer apply. Null indicates an evergreen agreement. Explicitly identified in detection phase relationship data. | Column contract_end_date (DATE) in content.genre_buy_agreement']
  contract_start_date date [note: 'The effective start date when this advertiser-genre buy agreement becomes active and the negotiated terms apply. Explicitly identified in detection phase relationship data. | Column contract_start_date (DATE) in content.genre_buy_agreement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in content.genre_buy_agreement']
  created_timestamp timestamp [note: 'Timestamp when this genre buy agreement record was first created in the system. | Column created_timestamp (TIMESTAMP) in content.genre_buy_agreement']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  genre_cpm_premium_percent decimal(5,2) [note: 'The percentage premium (or discount if negative) applied to the base CPM rate for this advertiser when buying inventory within this specific genre. Reflects negotiated pricing that varies by advertiser-genre combination. Explicitly identified in detection phase relationship data. | Column genre_cpm_premium_percent (DECIMAL(5,2)) in content.genre_buy_agreement']
  last_modified_timestamp timestamp [note: 'Timestamp when this genre buy agreement record was last updated. Used for change tracking and audit. | Column last_modified_timestamp (TIMESTAMP) in content.genre_buy_agreement']
  minimum_spend_commitment decimal(15,2) [note: 'The contractually committed minimum advertising spend amount for this advertiser within this genre over the contract period. Used for upfront deal tracking and revenue forecasting. Explicitly identified in detection phase relationship data. | Column minimum_spend_commitment (DECIMAL(15,2)) in content.genre_buy_agreement']
  preferred_genre_flag boolean [note: 'Indicates whether this genre has been designated as a preferred or priority genre for this advertiser, typically resulting in preferential ad placement, first-right-of-refusal on premium inventory, or priority scheduling. Explicitly identified in detection phase relationship data. | Column preferred_genre_flag (BOOLEAN) in content.genre_buy_agreement']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in content.genre_buy_agreement']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in content.genre_buy_agreement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in content.genre_buy_agreement']

  Note: 'This association product represents the contractual agreement between an advertiser and specific content genres for media buying. It captures advertiser-specific pricing premiums, exclusivity arrangements, spend commitments, and preferred genre status that exist only in the context of this advertiser-genre relationship. Each record links one advertiser to one genre with commercial terms negotiated for that specific combination.. Existence Justification: In media broadcasting advertising sales, advertisers negotiate commercial terms for buying inventory across multiple genres (e.g., an automotive advertiser buys sports, news, and drama), and each genre attracts multiple advertisers with different negotiated terms. The relationship represents a Genre Buy Agreement—a recognized commercial contract that captures advertiser-specific pricing premiums, category exclusivity deals, preferred genre status, and minimum spend commitments that vary by advertiser-genre combination. | Unity Catalog table: media_broadcasting_ecm.content.genre_buy_agreement Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics.'
}

Table content.package_inclusion {
  package_inclusion_id varchar [pk, note: 'Unique identifier for this package inclusion record. Primary key. | Column package_inclusion_id (BIGINT) in content.package_inclusion']
  content_package_id varchar [note: 'Foreign key to content.package. Identifies which package this inclusion belongs to. | Column content_package_id (BIGINT) in content.package_inclusion']
  title_id varchar [note: 'Foreign key to content.title. Identifies which title is included in the package. | Column title_id (BIGINT) in content.package_inclusion']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in content.package_inclusion']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in content.package_inclusion']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in content.package_inclusion']
  created_timestamp timestamp [note: 'The date and time when this inclusion record was first created in the system. Used for audit and change tracking. | Column created_timestamp (TIMESTAMP) in content.package_inclusion']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  effective_date date [note: 'The date from which this title becomes available within the package for distribution. May differ from package-level effective date to support phased content rollouts or rights windows. | Column effective_date (DATE) in content.package_inclusion']
  exclusivity_flag boolean [note: 'Indicates whether this specific title is offered on an exclusive basis within this package context. Title-level exclusivity may differ from package-level exclusivity terms. | Column exclusivity_flag (BOOLEAN) in content.package_inclusion']
  expiry_date date [note: 'The date on which this title is removed from the package or its inclusion expires. Used for rights window management and automatic package composition updates. | Column expiry_date (DATE) in content.package_inclusion']
  inclusion_date date [note: 'The date when this title was added to the package. Used for tracking package evolution and audit purposes. | Column inclusion_date (DATE) in content.package_inclusion']
  inclusion_status varchar [note: 'Current lifecycle status of this title within the package: active (currently included), pending (scheduled for inclusion), expired (inclusion window ended), removed (manually removed), suspended (temporarily unavailable). | Column inclusion_status (STRING) in content.package_inclusion']
  license_fee_allocated_usd decimal(15,2) [note: 'The portion of the package license fee allocated to this specific title. Used for revenue allocation, royalty calculations, and content valuation within package deals. | Column license_fee_allocated_usd (DECIMAL(15,2)) in content.package_inclusion']
  modified_by varchar [note: 'The username or identifier of the user or system that last modified this inclusion record. Used for audit and accountability. | Column modified_by (STRING) in content.package_inclusion']
  modified_timestamp timestamp [note: 'The date and time when this inclusion record was last modified. Used for change tracking and synchronization. | Column modified_timestamp (TIMESTAMP) in content.package_inclusion']
  priority_rank varchar [note: 'The promotional or commercial priority of this title within the package. Used to determine featured content, hero placement, and marketing emphasis. Lower numbers indicate higher priority. | Column priority_rank (INT) in content.package_inclusion']
  sequence_number varchar [note: 'The ordinal position of this title within the package for display purposes in EPG, catalog listings, or playlists. Used for FAST channel lineups and syndication package ordering. | Column sequence_number (INT) in content.package_inclusion']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in content.package_inclusion']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in content.package_inclusion']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in content.package_inclusion']

  Note: 'This association product represents the inclusion of a title within a content package. It captures the business rules and metadata governing how each title is positioned within a package for distribution or licensing purposes. Each record links one package to one title with attributes that exist only in the context of this relationship, such as sequencing for EPG display, exclusivity terms, effective windows, and priority ranking for promotional purposes.. Existence Justification: In media broadcasting, content packages are curated bundles assembled for distribution deals (SVOD libraries, syndication packages, FAST channel lineups, MVPD carriage bundles). A single package contains many titles (films, episodes, clips), and a single title can be included in multiple packages simultaneously (e.g., a popular film appears in both a premium SVOD package and a syndication package for international markets). Content operations teams actively manage package composition, adjusting title inclusions based on rights windows, commercial priorities, and distribution requirements. | Unity Catalog table: media_broadcasting_ecm.content.package_inclusion Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics.'
}

Table content.series_crew_assignment {
  series_crew_assignment_id varchar [pk, note: 'Unique identifier for this series crew assignment record. Primary key for the association. | Column series_crew_assignment_id (BIGINT) in content.series_crew_assignment']
  employee_id varchar [note: 'Foreign key linking to the employee master record. Identifies which internal employee is assigned to this series production role. | Column employee_id (BIGINT) in workforce.series_crew_assignment']
  series_id varchar [note: 'Foreign key linking to the series master record. Identifies which series this crew assignment is for. | Column series_id (BIGINT) in content.series_crew_assignment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in content.series_crew_assignment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in content.series_crew_assignment']
  assignment_end_date date [note: 'Date when the crew member completed or left this series assignment. Null for ongoing assignments. Used for crew availability and historical tracking. | Column assignment_end_date (DATE) in content.series_crew_assignment']
  assignment_start_date date [note: 'Date when the crew member began work on this series assignment. Used for scheduling, availability tracking, and contract compliance. | Column assignment_start_date (DATE) in content.series_crew_assignment']
  assignment_status varchar [note: 'Current lifecycle status of this crew assignment. Indicates whether the crew member is actively working, has completed their work, or the assignment is paused/terminated. | Column assignment_status (STRING) in content.series_crew_assignment']
  compensation_structure varchar [note: 'The payment model for this crew assignment. Determines how the employee is compensated for their work on this series. Critical for payroll processing and residuals calculation. Explicitly identified in detection reasoning. | Column compensation_structure (STRING) in content.series_crew_assignment']
  contract_type varchar [note: 'Classification of the employment contract structure for this crew assignment. Determines payment schedule, exclusivity terms, and renewal options. Critical for union compliance and residuals calculation. Explicitly identified in detection reasoning. | Column contract_type (STRING) in content.series_crew_assignment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in content.series_crew_assignment']
  credit_name varchar [note: 'The name to be used in on-screen credits for this crew member on this series. May differ from legal name per union rules or professional preference. | Column credit_name (STRING) in content.series_crew_assignment']
  credit_position varchar [note: 'The order/position of this crew member\'s credit within their role category. Determines credit sequence in opening/closing titles per union rules. | Column credit_position (INT) in content.series_crew_assignment']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  episode_range_end varchar [note: 'Ending episode number within the season scope for this crew assignment. Null if assignment covers entire season or is ongoing. Used for episodic directors, writers, and guest crew. Explicitly identified in detection reasoning. | Column episode_range_end (INT) in content.series_crew_assignment']
  episode_range_start varchar [note: 'Starting episode number within the season scope for this crew assignment. Null if assignment covers entire season. Used for episodic directors, writers, and guest crew. Explicitly identified in detection reasoning. | Column episode_range_start (INT) in content.series_crew_assignment']
  residuals_eligible boolean [note: 'Indicates whether this crew assignment qualifies for residual payments based on contract type, union rules, and distribution windows. Critical for long-term compensation tracking. | Column residuals_eligible (BOOLEAN) in content.series_crew_assignment']
  role_type varchar [note: 'The specific production role the employee performs on this series. Determines union jurisdiction, credit placement, and compensation structure. Explicitly identified in detection reasoning. | Column role_type (STRING) in content.series_crew_assignment']
  season_scope varchar [note: 'Identifies which season(s) this crew assignment applies to. May be \'all\', a specific season number, or a range (e.g., \'S1-S3\'). Critical for tracking crew continuity and contract scope. Explicitly identified in detection reasoning. | Column season_scope (STRING) in content.series_crew_assignment']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in content.series_crew_assignment']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in content.series_crew_assignment']
  union_affiliation varchar [note: 'The labor union governing this crew assignment. Determines contract terms, minimum compensation, working conditions, and residuals eligibility. | Column union_affiliation (STRING) in content.series_crew_assignment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in content.series_crew_assignment']

  Note: 'This association product represents the assignment relationship between series and employee. It captures the operational reality that production crew members (showrunners, producers, editors, directors, writers) work on multiple series throughout their careers, and each series employs multiple crew members across different roles and time periods. Each record links one series to one employee with attributes that exist only in the context of this specific assignment: the role they performed, the scope of their work (which seasons/episodes), contract terms, and compensation structure. This is critical for union contract compliance, residuals calculation, production scheduling, and crew availability management.. Existence Justification: In media broadcasting production operations, series crew assignments represent a genuine operational many-to-many relationship. Production crew members (showrunners, producers, directors, editors, writers) work on multiple series throughout their careers, and each series employs multiple crew members across different roles, seasons, and episode ranges. The business actively manages these assignments with role-specific data (role_type, season_scope, episode_range), contract terms (contract_type, compensation_structure), and credit information. This is not a derived correlation but an operational entity that production coordinators create, update, and query daily for scheduling, union compliance, and residuals calculation. | Unity Catalog table: media_broadcasting_ecm.content.series_crew_assignment Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics.'
}

Table content.distribution_package {
  distribution_package_id varchar [pk, note: 'Unique identifier for each title-partner distribution package record. Primary key for the association. | Column distribution_package_id (BIGINT) in content.distribution_package']
  partner_id varchar [note: 'Foreign key linking to the distribution partner receiving this content package | Column partner_id (BIGINT) in partner.distribution_package']
  title_id varchar [note: 'Foreign key linking to the content title included in this distribution package | Column title_id (BIGINT) in content.distribution_package']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in content.distribution_package']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in content.distribution_package']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in content.distribution_package']
  created_timestamp timestamp [note: 'System timestamp when this package record was created. Used for audit trail and package composition tracking. | Column created_timestamp (TIMESTAMP) in content.distribution_package']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  exclusion_date date [note: 'Date when this title was removed from the distribution package for this partner. Null indicates the title is currently active in the package. Used for windowing strategy and rights expiration tracking. | Column exclusion_date (DATE) in content.distribution_package']
  format_rights varchar [note: 'Distribution format rights granted to the partner for this title. Defines whether the partner can distribute via linear broadcast, video-on-demand, streaming, download, or multiple formats. | Column format_rights (STRING) in content.distribution_package']
  inclusion_date date [note: 'Date when this title was added to the distribution package for this partner. Used for tracking package composition history and effective date of distribution rights. | Column inclusion_date (DATE) in content.distribution_package']
  package_status varchar [note: 'Current lifecycle status of this title-partner package relationship. Determines whether the title is currently available for distribution to this partner. | Column package_status (STRING) in content.distribution_package']
  pricing_tier varchar [note: 'Pricing tier classification for this title within the partner package. Determines royalty rates, licensing fees, and revenue share terms specific to this title-partner combination. | Column pricing_tier (STRING) in content.distribution_package']
  priority_rank varchar [note: 'Numeric ranking indicating the priority or prominence of this title within the partner-specific package. Used for featured content positioning, promotional planning, and partner-specific merchandising strategies. | Column priority_rank (INT) in content.distribution_package']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in content.distribution_package']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in content.distribution_package']
  territory_scope varchar [note: 'Geographic territories or markets where this title is licensed to this partner. Comma-separated ISO country codes or region identifiers. Supports territory-specific bundling and rights management. | Column territory_scope (STRING) in content.distribution_package']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in content.distribution_package']
  updated_timestamp timestamp [note: 'System timestamp when this package record was last modified. Used for change tracking and synchronization with downstream distribution systems. | Column updated_timestamp (TIMESTAMP) in content.distribution_package']

  Note: 'This association product represents the packaging relationship between titles and distribution partners in the media broadcasting ecosystem. It captures how content assets are bundled, priced, and scoped for distribution to external partners including studios, syndicators, MVPDs, vMVPDs, and FAST channel operators. Each record links one title to one partner with attributes that define the commercial and territorial terms of that specific title-partner distribution arrangement.. Existence Justification: In media broadcasting operations, a single content title (film, series episode, music track) is distributed to multiple partners through different package configurations (theatrical package, streaming package, international syndication package), and each distribution partner receives multiple titles in their content packages. The business actively manages these distribution packages with partner-specific pricing tiers, territory scopes, format rights, and inclusion/exclusion dates as part of content licensing and syndication operations. | Unity Catalog table: media_broadcasting_ecm.content.distribution_package Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics.'
}

Table content.episode_transmission {
  episode_transmission_id varchar [pk, note: 'Unique identifier for this specific transmission event. Primary key for the episode_transmission association. | Column episode_transmission_id (BIGINT) in content.episode_transmission']
  content_episode_id varchar [note: 'Foreign key linking to the episode that was transmitted in this broadcast event | Column content_episode_id (BIGINT) in content.episode_transmission']
  episode_broadcast_channel_id varchar [note: 'FK to the channel on which the episode was transmitted']
  episode_channel_id varchar [note: 'Channel on which the episode was transmitted']
  transmission_equipment_id varchar [note: 'Foreign key linking to the transmission equipment that broadcast this episode | Column transmission_equipment_id (BIGINT) in technology.episode_transmission']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in content.episode_transmission']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in content.episode_transmission']
  actual_end_time timestamp [note: 'Actual end time of transmission']
  actual_start_time timestamp [note: 'Actual start time of transmission']
  affiliate_call_sign varchar [note: 'Call sign of the affiliate station']
  affiliate_station_call_sign varchar [note: 'Call sign of the affiliate station']
  air_date date [note: 'The calendar date when this episode was transmitted via this equipment. Critical for as-run logs and regulatory compliance reporting. | Column air_date (DATE) in content.episode_transmission']
  air_time timestamp [note: 'The precise timestamp when this episode transmission began. Used for FCC as-run logs, program schedule verification, and audience measurement correlation. | Column air_time (TIMESTAMP) in content.episode_transmission']
  audience_estimate decimal(10,2)
  audio_description_transmitted_flag boolean [note: 'Whether audio description was transmitted']
  audio_format varchar [note: 'Audio format used (stereo, 5.1, Atmos)']
  audio_language varchar [note: 'Primary audio language of the transmission']
  blackout_applied_flag boolean [note: 'Whether a blackout rule was applied']
  blackout_override_flag boolean [note: 'Whether blackout rules were overridden']
  broadcast_network varchar [note: 'Network on which the episode was transmitted']
  closed_caption_flag boolean [note: 'Whether closed captions were transmitted']
  closed_caption_transmitted_flag boolean [note: 'Whether closed captions were transmitted']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in content.episode_transmission']
  created_timestamp timestamp [note: 'Record creation timestamp']
  delay_seconds varchar [note: 'Delay from scheduled start in seconds']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  duration_seconds varchar
  feed_source varchar [note: 'Source feed identifier for the transmission']
  hd_flag boolean [note: 'Whether transmission was in HD']
  market_code varchar [note: 'DMA or market code for the transmission']
  nielsen_program_code varchar [note: 'Nielsen program identification code']
  notes varchar
  preemption_flag boolean [note: 'Whether the scheduled content was preempted']
  preemption_reason varchar [note: 'Reason for preemption if applicable']
  sap_audio_flag boolean [note: 'Whether SAP audio track was available']
  scheduled_end_time timestamp [note: 'Originally scheduled end time']
  scheduled_start_time timestamp [note: 'Originally scheduled start time']
  signal_strength_dbm decimal(10,3) [note: 'Measured signal strength in dBm for this transmission event. Technical performance metric used for coverage analysis and equipment health monitoring. | Column signal_strength_dbm (DECIMAL(10,3)) in content.episode_transmission']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in content.episode_transmission']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in content.episode_transmission']
  subtitle_language varchar [note: 'Subtitle language if available']
  technical_issues_flag boolean [note: 'Flag indicating whether technical issues occurred during this transmission event (signal loss, quality degradation, interruption). Triggers incident investigation and maintenance review. | Column technical_issues_flag (BOOLEAN) in content.episode_transmission']
  territory_code varchar [note: 'Territory/region code for the transmission']
  transmission_date date
  transmission_duration_seconds varchar [note: 'Actual duration of this transmission event in seconds. May differ from episode runtime due to technical issues or scheduling adjustments. Used for as-run log reconciliation. | Column transmission_duration_seconds (INT) in content.episode_transmission']
  transmission_quality varchar [note: 'Quality assessment of this specific transmission event based on signal strength, error rates, and technical monitoring. Used for performance analysis and maintenance planning. | Column transmission_quality (STRING) in content.episode_transmission']
  transmission_status varchar [note: 'Final status of this transmission event. Used for as-run log completion verification and incident tracking. | Column transmission_status (STRING) in content.episode_transmission']
  transmission_time timestamp
  transmission_type varchar [note: 'Type of transmission (live, delayed, repeat)']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in content.episode_transmission']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  viewer_count varchar [note: 'Estimated or measured viewer count for this specific transmission event. Used for audience measurement, advertising rate justification, and content performance analysis. | Column viewer_count (BIGINT) in content.episode_transmission']

  Note: 'This association product represents the transmission event between content_episode and transmission_equipment. It captures each instance when a specific episode is broadcast via specific transmission equipment, recording air date/time, transmission quality metrics, viewer counts, and technical issues. Each record links one content_episode to one transmission_equipment with attributes that exist only in the context of this specific broadcast transmission event.. Existence Justification: In broadcast operations, a single episode is transmitted via multiple equipment instances across different times, channels, and geographic regions (multi-channel broadcast, regional transmitters, redundancy failover, rerun schedules). Conversely, each transmission equipment asset broadcasts thousands of different episodes over its operational lifetime. Broadcasters actively manage and track each transmission event as a distinct operational record for FCC as-run logs, regulatory compliance, technical performance monitoring, and audience measurement. | Unity Catalog table: media_broadcasting_ecm.content.episode_transmission Aligned with EBU CCDM (Tech 3351) Class Conceptual Data Model semantics.'
}

Table content.taxonomy {
  taxonomy_id varchar [pk, note: 'Primary key for taxonomy | Column taxonomy_id (BIGINT) in content.taxonomy']
