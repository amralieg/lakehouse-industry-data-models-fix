ind:wacUnitPrice rdf:type rdf:Property ;
    rdfs:label 'Wac Unit Price' ;
    rdfs:comment 'The Wholesale Acquisition Cost per unit of the specialty drug, representing the manufacturer\'s list price to wholesalers.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
